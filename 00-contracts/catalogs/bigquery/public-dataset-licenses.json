{
  "$schema": "https://etzhayyim.com/schemas/bigquery-public-dataset-licenses.schema.json",
  "version": "2026-05-10",
  "description": "Curated SSoT mapping BigQuery public-dataset names to license / terms / category / training guess. Consumed by 70-tools/scripts/bigquery-public-dataset-license-enrich.mjs. Per ADR 2605092700 §P0 these are GUESSES (catalog.allowed_for_train_guess); actual training authorization lives in edge_dataset_allowed_for_training_task and remains default-deny until explicit review.",
  "providers": {
    "bigquery-public-data": {
      "default": {
        "license": null,
        "license_decision": "review",
        "category": "uncategorized",
        "terms_url": "https://cloud.google.com/bigquery/public-data",
        "allowed_for_train_guess": "false",
        "allowed_for_embedding_guess": "false",
        "rationale": "no automatic match; human review required"
      },
      "patterns": [
        { "match": "^noaa_",                              "license": "US-Public-Domain",       "terms_url": "https://www.weather.gov/disclaimer",                                            "category": "weather",        "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "NOAA = US Government work, no copyright (17 USC §105)" },
        { "match": "^census_bureau_",                     "license": "US-Public-Domain",       "terms_url": "https://www.census.gov/about/policies/citation.html",                            "category": "demographics",   "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "US Census = US Government work" },
        { "match": "^bls(_|$)",                           "license": "US-Public-Domain",       "terms_url": "https://www.bls.gov/bls/linksite.htm",                                          "category": "labor",          "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "US BLS = US Government work" },
        { "match": "^cfpb_",                              "license": "US-Public-Domain",       "terms_url": "https://www.consumerfinance.gov/about-us/the-bureau/policies/copyright/",         "category": "finance",        "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "US CFPB = US Government work" },
        { "match": "^cms_",                               "license": "US-Public-Domain",       "terms_url": "https://www.cms.gov/About-CMS/Agency-Information/Aboutwebsite/Linking",          "category": "healthcare",     "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "US CMS Medicare = US Government work" },
        { "match": "^medicare_",                          "license": "US-Public-Domain",       "terms_url": "https://www.cms.gov/About-CMS/Agency-Information/Aboutwebsite/Linking",          "category": "healthcare",     "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "US CMS Medicare = US Government work" },
        { "match": "^fda_",                               "license": "US-Public-Domain",       "terms_url": "https://www.fda.gov/about-fda/about-website/website-policies",                  "category": "healthcare",     "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "US FDA = US Government work" },
        { "match": "^nih_",                               "license": "US-Public-Domain",       "terms_url": "https://www.nih.gov/about-nih/about-website/copyright",                          "category": "healthcare",     "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "US NIH = US Government work" },
        { "match": "^nlm_",                               "license": "US-Public-Domain",       "terms_url": "https://www.nlm.nih.gov/copyright.html",                                        "category": "healthcare",     "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "US NLM = US Government work" },
        { "match": "^ncbi_",                              "license": "US-Public-Domain",       "terms_url": "https://www.ncbi.nlm.nih.gov/home/about/policies/",                              "category": "bioinformatics", "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "US NCBI dataset; per-record license still varies (review)" },
        { "match": "^pmc_",                               "license": "varies-OA",              "terms_url": "https://www.ncbi.nlm.nih.gov/pmc/about/copyright/",                              "category": "bioinformatics", "allowed_for_train_guess": "false", "allowed_for_embedding_guess": "false", "rationale": "PubMed Central = mixed (OA subset CC-BY/CC0; paywalled subset NOT redistributable)" },
        { "match": "^nhtsa_",                             "license": "US-Public-Domain",       "terms_url": "https://www.nhtsa.gov/about-nhtsa/website-policies",                            "category": "transport",      "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "NHTSA = US Government work" },
        { "match": "^faa_",                               "license": "US-Public-Domain",       "terms_url": "https://www.faa.gov/web_policies",                                              "category": "transport",      "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "FAA = US Government work" },
        { "match": "^usda_",                              "license": "US-Public-Domain",       "terms_url": "https://www.usda.gov/policies-and-links",                                       "category": "agriculture",    "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "USDA = US Government work" },
        { "match": "^usfs_",                              "license": "US-Public-Domain",       "terms_url": "https://www.fs.usda.gov/main/r10/about/notices",                                "category": "environment",    "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "USFS = US Government work" },
        { "match": "^epa_",                               "license": "US-Public-Domain",       "terms_url": "https://www.epa.gov/web-policies-and-procedures",                               "category": "environment",    "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "US EPA = US Government work" },
        { "match": "^geo_us_",                            "license": "US-Public-Domain",       "terms_url": "https://www.census.gov/programs-surveys/geography.html",                        "category": "geo",            "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "US Census TIGER / public boundaries" },
        { "match": "^utility_(us|eu)$",                   "license": "Google-BQ-Public-TOS",   "terms_url": "https://cloud.google.com/bigquery/public-data#footnote_2",                       "category": "geo-utility",    "allowed_for_train_guess": "false", "allowed_for_embedding_guess": "false", "rationale": "Google utility tables; Google BigQuery Public Datasets TOS (review)" },
        { "match": "^iowa_liquor_sales",                  "license": "Iowa-Open-Data",         "terms_url": "https://data.iowa.gov/about",                                                   "category": "commerce",       "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "Iowa state open data, attribution requested" },
        { "match": "^chicago_(taxi_trips|crime|residential_sales)", "license": "Chicago-Open-Data", "terms_url": "https://www.chicago.gov/city/en/narr/foia/data_disclaimer.html",          "category": "civic",          "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "City of Chicago open data with disclaimer" },
        { "match": "^austin_",                            "license": "Austin-Open-Data",       "terms_url": "https://data.austintexas.gov/widgets/qjfp-cvuv",                                 "category": "civic",          "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "City of Austin open data" },
        { "match": "^new_york_(taxi_trips|trees|citibike|subway|mv_collisions)", "license": "NYC-Open-Data", "terms_url": "https://www1.nyc.gov/home/terms-of-use.page",                       "category": "civic",          "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "NYC OpenData terms (review re sensitive subsets)" },
        { "match": "^san_francisco_",                     "license": "SF-Open-Data",           "terms_url": "https://datasf.org/opendata/",                                                  "category": "civic",          "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "City and County of San Francisco open data" },
        { "match": "^baltimore_",                         "license": "Baltimore-Open-Data",    "terms_url": "https://data.baltimorecity.gov/",                                               "category": "civic",          "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "Baltimore open data" },
        { "match": "^seattle_",                           "license": "Seattle-Open-Data",      "terms_url": "https://data.seattle.gov/",                                                     "category": "civic",          "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "Seattle open data" },
        { "match": "^bitcoin_blockchain$|^crypto_|^blockchain_|^goog_blockchain_", "license": "Public-Chain-No-Copyright", "terms_url": "https://cloud.google.com/bigquery/public-data",          "category": "blockchain",     "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "Public blockchain data (no copyright on raw on-chain bytes; review smart-contract code separately)" },
        { "match": "^idc_",                               "license": "CC-BY-4.0",              "terms_url": "https://learn.canceridc.dev/data/data-licensing",                               "category": "medical-imaging","allowed_for_train_guess": "false", "allowed_for_embedding_guess": "false", "rationale": "Imaging Data Commons CC-BY-4.0; PII review for clinical metadata" },
        { "match": "^covid19_jhu_csse",                   "license": "CC-BY-4.0",              "terms_url": "https://github.com/CSSEGISandData/COVID-19/blob/master/README.md",              "category": "covid19",        "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "JHU CSSE CC-BY-4.0" },
        { "match": "^covid19_ecdc",                       "license": "ECDC-Attribution",       "terms_url": "https://www.ecdc.europa.eu/en/copyright",                                        "category": "covid19",        "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "ECDC attribution-required reuse" },
        { "match": "^covid19_govt_response",              "license": "CC-BY-4.0",              "terms_url": "https://github.com/OxCGRT/covid-policy-tracker/blob/master/LICENSE.txt",         "category": "covid19",        "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "Oxford OxCGRT CC-BY-4.0" },
        { "match": "^covid19_nyt",                        "license": "NYT-Custom",             "terms_url": "https://github.com/nytimes/covid-19-data#license-and-attribution",              "category": "covid19",        "allowed_for_train_guess": "false", "allowed_for_embedding_guess": "false", "rationale": "NYT custom license — attribution + non-commercial restriction; training disallowed without legal review" },
        { "match": "^covid19_google_mobility|^covid19_geotab_", "license": "Google-Custom-CC-BY", "terms_url": "https://policies.google.com/terms",                                            "category": "covid19",        "allowed_for_train_guess": "false", "allowed_for_embedding_guess": "false", "rationale": "Google COVID-19 mobility datasets; review per Google TOS" },
        { "match": "^covid19_italy",                      "license": "CC-BY-4.0",              "terms_url": "https://github.com/pcm-dpc/COVID-19/blob/master/LICENSE",                       "category": "covid19",        "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "Italy DPC CC-BY-4.0" },
        { "match": "^covid19_open_data",                  "license": "CC-BY-4.0",              "terms_url": "https://github.com/GoogleCloudPlatform/covid-19-open-data#license",             "category": "covid19",        "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "Google COVID-19 Open Data CC-BY-4.0 (review per-source)" },
        { "match": "^covid19_aha|^covid19_covidtracking|^covid19_jhu_csse_eu|^covid19_ecdc_eu", "license": "varies", "terms_url": "https://cloud.google.com/bigquery/public-data",                "category": "covid19",        "allowed_for_train_guess": "false", "allowed_for_embedding_guess": "false", "rationale": "various sources; review per-source" },
        { "match": "^worldbank_|^world_bank_",            "license": "CC-BY-4.0",              "terms_url": "https://datacatalog.worldbank.org/public-licenses#cc-by",                        "category": "economics",      "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "World Bank Open Data CC-BY-4.0" },
        { "match": "^who_",                               "license": "CC-BY-NC-SA-3.0-IGO",    "terms_url": "https://www.who.int/publishing/copyright",                                      "category": "healthcare",     "allowed_for_train_guess": "false", "allowed_for_embedding_guess": "false", "rationale": "WHO content non-commercial; training prohibited without express permission" },
        { "match": "^un_|^unctad_|^undp_",                "license": "UN-Attribution",         "terms_url": "https://www.un.org/en/about-us/terms-of-use",                                   "category": "policy",         "allowed_for_train_guess": "false", "allowed_for_embedding_guess": "false", "rationale": "UN agencies; per-document license varies, review" },
        { "match": "^bbc_news",                           "license": "BBC-Custom",             "terms_url": "https://www.bbc.co.uk/usingthebbc/terms/",                                       "category": "news",           "allowed_for_train_guess": "false", "allowed_for_embedding_guess": "false", "rationale": "BBC News content not licensed for redistribution / training" },
        { "match": "^stackoverflow",                      "license": "CC-BY-SA-4.0",           "terms_url": "https://stackoverflow.com/help/licensing",                                      "category": "qa",             "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "Stack Overflow user content CC-BY-SA-4.0; ShareAlike obligation" },
        { "match": "^github_repos",                       "license": "Per-Repo-OSS",           "terms_url": "https://docs.github.com/en/site-policy/github-terms/github-terms-of-service",   "category": "code",           "allowed_for_train_guess": "false", "allowed_for_embedding_guess": "false", "rationale": "Per-repo OSS license varies (MIT/Apache/GPL/proprietary). License field is per-row; aggregate training requires per-license filter" },
        { "match": "^github_archive|^githubarchive",      "license": "GH-Archive-CC-BY-3.0",   "terms_url": "https://www.gharchive.org/",                                                    "category": "code",           "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "GH Archive event stream CC-BY-3.0" },
        { "match": "^wikipedia$",                         "license": "CC-BY-SA-3.0",           "terms_url": "https://en.wikipedia.org/wiki/Wikipedia:Reusing_Wikipedia_content",              "category": "encyclopedia",   "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "Wikipedia text CC-BY-SA-3.0; ShareAlike obligation" },
        { "match": "^wikidata",                           "license": "CC0-1.0",                "terms_url": "https://www.wikidata.org/wiki/Wikidata:Licensing",                              "category": "knowledge-graph","allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "Wikidata CC0" },
        { "match": "^hacker_news",                        "license": "Y-Combinator-Custom",    "terms_url": "https://news.ycombinator.com/legal.html",                                       "category": "qa",             "allowed_for_train_guess": "false", "allowed_for_embedding_guess": "false", "rationale": "User content; YC TOS does not grant training rights explicitly" },
        { "match": "^pypi$|^pypi_",                       "license": "PyPI-Index-Public",      "terms_url": "https://pypi.org/policy/terms-of-use/",                                         "category": "package-metadata","allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "Public PyPI metadata; package payloads carry per-package license" },
        { "match": "^deps_dev_v1",                        "license": "CC-BY-4.0",              "terms_url": "https://deps.dev/about",                                                        "category": "package-metadata","allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "Google deps.dev CC-BY-4.0" },
        { "match": "^open_targets_",                      "license": "CC0-1.0",                "terms_url": "https://platform-docs.opentargets.org/licence",                                  "category": "bioinformatics", "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "Open Targets CC0" },
        { "match": "^clinvar",                            "license": "NLM-Public-Domain",      "terms_url": "https://www.ncbi.nlm.nih.gov/home/about/policies/",                              "category": "bioinformatics", "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "NLM ClinVar US Public Domain" },
        { "match": "^chembl",                             "license": "CC-BY-SA-3.0",           "terms_url": "https://chembl.gitbook.io/chembl-interface-documentation/about",                 "category": "bioinformatics", "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "EBI ChEMBL CC-BY-SA-3.0" },
        { "match": "^ebi_chembl|^ebi_surechembl",         "license": "CC-BY-SA-3.0",           "terms_url": "https://www.ebi.ac.uk/about/terms-of-use",                                       "category": "bioinformatics", "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "EBI CC-BY-SA-3.0 family" },
        { "match": "^samples$",                           "license": "Google-BQ-Samples-TOS",  "terms_url": "https://cloud.google.com/bigquery/public-data#bigquery_samples_dataset",         "category": "training-fixture","allowed_for_train_guess": "false", "allowed_for_embedding_guess": "false", "rationale": "Google BQ samples; mixed third-party content (review)" },
        { "match": "^baseball|^bigqueryml_ncaa|^ncaa_",   "license": "Sports-Public",          "terms_url": "https://cloud.google.com/bigquery/public-data",                                  "category": "sports",         "allowed_for_train_guess": "false", "allowed_for_embedding_guess": "false", "rationale": "Sports stats; broadcaster + association rights vary" },
        { "match": "^google_books_ngrams_2020",           "license": "Google-NGrams-CC-BY-3.0", "terms_url": "https://books.google.com/ngrams/info",                                          "category": "ngram",          "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "Google Books Ngram CC-BY-3.0" },
        { "match": "^google_analytics_sample",            "license": "Google-Sample-Synthetic","terms_url": "https://support.google.com/analytics/answer/7586738",                            "category": "analytics",      "allowed_for_train_guess": "false", "allowed_for_embedding_guess": "false", "rationale": "Google Merchandise Store sample data; demo only" },
        { "match": "^google_trends",                      "license": "Google-Trends-TOS",      "terms_url": "https://policies.google.com/terms",                                             "category": "search-trends",  "allowed_for_train_guess": "false", "allowed_for_embedding_guess": "false", "rationale": "Google Trends TOS limits redistribution + AI training" },
        { "match": "^google_political_ads",               "license": "Google-Custom",          "terms_url": "https://transparencyreport.google.com/political-ads/region/US",                  "category": "ads-transparency","allowed_for_train_guess": "false", "allowed_for_embedding_guess": "false", "rationale": "Google Political Ads transparency, custom TOS" },
        { "match": "^iowa_liquor",                        "license": "Iowa-Open-Data",         "terms_url": "https://data.iowa.gov/about",                                                   "category": "commerce",       "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "Iowa Open Data" },
        { "match": "^cloud_storage_geo_index",            "license": "Google-Sample",          "terms_url": "https://cloud.google.com/bigquery/public-data",                                  "category": "geo-sample",     "allowed_for_train_guess": "false", "allowed_for_embedding_guess": "false", "rationale": "Google sample (review)" },
        { "match": "^ml_datasets",                        "license": "Google-Sample-Mixed",    "terms_url": "https://cloud.google.com/bigquery/public-data",                                  "category": "ml-fixture",     "allowed_for_train_guess": "false", "allowed_for_embedding_guess": "false", "rationale": "Mixed; per-row license review required" },
        { "match": "^austin_311|^austin_crime|^austin_incidents|^austin_waste|^austin_bikeshare", "license": "Austin-Open-Data", "terms_url": "https://data.austintexas.gov/", "category": "civic", "allowed_for_train_guess": "true", "allowed_for_embedding_guess": "true", "rationale": "City of Austin open data" },
        { "match": "^cms_synthetic",                      "license": "CMS-Synthetic-Public",   "terms_url": "https://www.cms.gov/About-CMS/Agency-Information/Aboutwebsite/Linking",          "category": "healthcare",     "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "CMS synthetic patient data; safe to use" },
        { "match": "^covid19_genome",                     "license": "GISAID-Custom",          "terms_url": "https://www.gisaid.org/registration/terms-of-use/",                              "category": "covid19",        "allowed_for_train_guess": "false", "allowed_for_embedding_guess": "false", "rationale": "Genome data potentially under GISAID terms; review required" },
        { "match": "^cfe_mexico_electricity",             "license": "Mexico-Open-Data",       "terms_url": "https://datos.gob.mx/libreusomx",                                               "category": "energy",         "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "Mexican gov't open data, Libre Uso MX" },
        { "match": "^libraries_io",                       "license": "CC-BY-SA-4.0",           "terms_url": "https://libraries.io/data",                                                     "category": "package-metadata","allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "Libraries.io CC-BY-SA-4.0" },
        { "match": "^breathe$",                           "license": "Breathe-Custom",         "terms_url": "https://cloud.google.com/bigquery/public-data",                                  "category": "air-quality",    "allowed_for_train_guess": "false", "allowed_for_embedding_guess": "false", "rationale": "Per Google BQ TOS; review" },
        { "match": "^openaq$",                            "license": "OpenAQ-CC-BY-4.0",       "terms_url": "https://docs.openaq.org/about/about",                                           "category": "air-quality",    "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "OpenAQ CC-BY-4.0" },
        { "match": "^country_codes$",                     "license": "ISO-3166-Public",        "terms_url": "https://www.iso.org/iso-3166-country-codes.html",                               "category": "reference",      "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "ISO country codes; effectively public reference" },

        { "match": "^patents$|^patents_cpc|^patents_dsep|^patents_view|^labeled_patents|^uspto_oce_|^uspto_ptab", "license": "US-Public-Domain", "terms_url": "https://www.uspto.gov/terms-use-uspto-websites", "category": "patents", "allowed_for_train_guess": "true",  "allowed_for_embedding_guess": "true",  "rationale": "USPTO disclosures = US Government work, no copyright" },
        { "match": "^google_patents_research",            "license": "Google-Patents-Custom",  "terms_url": "https://policies.google.com/terms",                                             "category": "patents",        "allowed_for_train_guess": "false", "allowed_for_embedding_guess": "false", "rationale": "Google Patents enrichment (translations, embeddings) — Google TOS, review" },
        { "match": "^marec$",                              "license": "marec-Custom",           "terms_url": "https://researchstudio.at/marec/",                                              "category": "patents",        "allowed_for_train_guess": "false", "allowed_for_embedding_guess": "false", "rationale": "MAREC patent research corpus; academic research dataset, review" },
