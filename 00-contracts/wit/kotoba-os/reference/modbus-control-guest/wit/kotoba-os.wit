/// kotoba:os — kotoba-os device + control WIT surface (ADR-2606031600)
///
/// The OT/PLC device worlds named in ADR-2606031600 §D3. A content-addressed
/// WASM Component-Model control program imports ONLY the interfaces its genesis
/// manifest granted (capability-scoped, no ambient authority), runs a scan
/// cycle, and the host records each cycle as an immutable Datom transaction
/// (Datomic preserved — ADR-2605312345; machine state IS the Datom log).
///
/// Package layout note: the ADR refers to `kotoba:io/*` and `kotoba:fieldbus/*`
/// world families. WIT resolves one package per directory, so they are realized
/// here as interfaces `io-digital` / `io-analog` / `io-gpio` and
/// `fieldbus-modbus` / `fieldbus-opcua` / `fieldbus-ethercat` / `fieldbus-canopen`
/// within the single `kotoba:os` package. The host (L2 kotoba-os kernel device
/// shim) implements these; the L5 control program imports a capability-scoped
/// subset. This is an R0 DRAFT: no live actuation (N3), soft-RT only (N2).
package kotoba:os@0.1.0;

/// Discrete (boolean) field I/O. `kotoba:io/digital` in ADR terms.
interface io-digital {
    /// A discrete I/O channel address (rack/slot/point or fieldbus coil index),
    /// opaque to the guest; the host resolves it against the granted capability set.
    type channel = u32;

    /// Read a discrete input. Errors if the channel is not in the granted
    /// capability set or the underlying bus is faulted.
    read-input: func(ch: channel) -> result<bool, string>;

    /// Stage a discrete output for this scan cycle. The write is NOT applied to
    /// the bus until `commit-cycle` (see world `plc-control`); staging keeps the
    /// read→compute→write→commit phases of the scan cycle ordered and auditable.
    /// R0: staging + simulation only; live actuation is N3 (operator+Council gate).
    write-output: func(ch: channel, value: bool) -> result<_, string>;
}

/// Continuous (scaled integer / float) field I/O. `kotoba:io/analog`.
interface io-analog {
    type channel = u32;

    /// Engineering-unit-scaled analog reading (host applies the calibration
    /// named in the genesis manifest; raw counts never cross the membrane).
    read-input: func(ch: channel) -> result<f32, string>;

    /// Stage an analog output (engineering units). Same defer-to-commit + N3
    /// no-live-actuation discipline as io-digital.
    write-output: func(ch: channel, value: f32) -> result<_, string>;
}

/// Direct SoC GPIO for constrained field devices. `kotoba:io/gpio`.
interface io-gpio {
    type pin = u8;
    enum direction { input, output }

    configure: func(p: pin, dir: direction) -> result<_, string>;
    read: func(p: pin) -> result<bool, string>;
    /// Stage a GPIO level (deferred to commit-cycle; N3 no live actuation at R0).
    write: func(p: pin, level: bool) -> result<_, string>;
}

/// Modbus TCP/RTU register access. `kotoba:fieldbus/modbus`.
interface fieldbus-modbus {
    /// Read holding registers [addr, addr+count). count is bounded by the host.
    read-holding: func(unit: u8, addr: u16, count: u16) -> result<list<u16>, string>;
    /// Stage a holding-register write (deferred to commit-cycle; N3).
    write-holding: func(unit: u8, addr: u16, values: list<u16>) -> result<_, string>;
    read-coils: func(unit: u8, addr: u16, count: u16) -> result<list<bool>, string>;
}

/// OPC UA node read/write (industrial interop). `kotoba:fieldbus/opcua`.
interface fieldbus-opcua {
    /// Opaque OPC UA NodeId string (ns=…;i=… / s=…), validated against capabilities.
    read-node: func(node-id: string) -> result<list<u8>, string>;   // CBOR-encoded value
    /// Stage an OPC UA write (deferred to commit-cycle; N3).
    write-node: func(node-id: string, value-cbor: list<u8>) -> result<_, string>;
}

/// EtherCAT process-data-object slice (cyclic I/O). `kotoba:fieldbus/ethercat`.
interface fieldbus-ethercat {
    /// Read the input PDO image for a slave. R0 read-only.
    read-pdo: func(slave: u16) -> result<list<u8>, string>;
    /// Stage an output PDO image (deferred to commit-cycle; N3).
    write-pdo: func(slave: u16, image: list<u8>) -> result<_, string>;
}

/// CANopen SDO/PDO access for motion/drive nodes. `kotoba:fieldbus/canopen`.
interface fieldbus-canopen {
    read-sdo: func(node: u8, index: u16, sub: u8) -> result<list<u8>, string>;
    /// Stage a CANopen SDO write (deferred to commit-cycle; N3).
    write-sdo: func(node: u8, index: u16, sub: u8, data: list<u8>) -> result<_, string>;
}

/// The Datom transaction surface a scan cycle commits to. This is the kotoba
/// substrate (L3) reached from L5 — a thin projection of `kotoba:kais` kqe, kept
/// here so a control program needs only one import for state. Every staged
/// output + the input snapshot become Datoms with T = the cycle index.
interface datom {
    /// One Datom assertion in legacy-quad projection (host assigns CID + Added).
    record fact {
        graph: string,
        entity: string,
        attribute: string,
        /// CBOR-encoded value (Cid/Integer/Float/Text/Bytes/...)
        value-cbor: list<u8>,
    }

    /// Append facts as part of the current cycle's transaction. Buffered until
    /// commit-cycle so a faulted cycle commits atomically or not at all.
    assert-facts: func(facts: list<fact>) -> result<_, string>;
}

/// L5 PLC control program (WASM-as-PLC, IEC 61131-3 logic compiles to this).
/// The host drives `scan` once per cycle; the guest reads granted inputs,
/// computes, stages outputs, asserts facts; the host then atomically commits
/// the staged outputs + facts as one Datom transaction (read→compute→write→
/// commit). Civilian producing actors only (N1: no weapons/fire-control).
world plc-control {
    /// Per-cycle audit summary the host folds into the cycle's Datom transaction.
    record scan-report {
        cycle: u64,
        inputs-read: u32,
        outputs-staged: u32,
        facts-asserted: u32,
        /// Host-measured cycle duration (microseconds) — for soft-RT jitter
        /// characterization (N2: soft-RT only, no hard-RT/SIL claim at R0).
        duration-us: u64,
    }

    import io-digital;
    import io-analog;
    import io-gpio;
    import fieldbus-modbus;
    import fieldbus-opcua;
    import fieldbus-ethercat;
    import fieldbus-canopen;
    import datom;

    /// Run one scan cycle. The host supplies the monotonic cycle index (= Datom T).
    export scan: func(cycle: u64) -> result<scan-report, string>;
}

/// L5 mesh agent (non-control): a Holochain-style agent over the Datom log.
/// Its source chain IS its local Datom-log segment (ADR §D5). No device imports.
world mesh-agent {
    import datom;
    export step: func() -> result<u32, string>;   // facts asserted this step
}
