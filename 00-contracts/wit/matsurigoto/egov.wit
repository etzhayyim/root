/// matsurigoto:egov — COFOG e-Government service module WIT surface (ADR-2606052300, R1.A)
///
/// The kotoba-wasm component contract for matsurigoto's executable service modules
/// (R0 reference impls in 20-actors/matsurigoto/methods/modules/<id>.py). A module is
/// componentize-py-compiled to a WASM Component, content-addressed on IPFS, and run in a
/// donated node (ameno / e7m / kotoba pod, ADR-2606012100/14600).
///
/// STRUCTURAL CHARTER INVARIANTS encoded in the surface itself:
///   G1 no-operator-master-key — NO module world exports a `sign` function. Every artifact is
///      returned UNSIGNED (`unsigned-artifact.proof` is always `none`); the governing organ
///      (Council 5-of-7 Safe for principal A | the adopting state's own key for principal B)
///      signs it through a SEPARATE capability the module never holds (ADR-2605231525).
///   G2 spec-derived-only — each function mirrors a public spec (JP 速算表 / UN CRVS /
///      ISO 17442 LEI / ICAO 9303 MRZ); no proprietary vendor surface.
///   G3 authority-bearing — `authority-mode` names who governs a deployment; the module is pure
///      and never asserts it (the host/profile supplies it).
///
/// R1 DRAFT: pure compute only. Live record-write + signing is host-side, operator+Council gated
/// (principal A: Council Lv7+; principal B: adopting-state authority). Validated with wasm-tools.
package matsurigoto:egov@0.1.0;

/// Shared types across every service module.
interface types {
    /// Who governs a deployment (G3). Pure modules never assert this; the host/profile does.
    enum authority-mode {
        /// principal A — the Kingdom of God governs its covenant-members (Council + 1 SBT=1 vote).
        sovereign-governance,
        /// principal B — an existing nation-state runs the module on its OWN keys.
        supplied-to-state,
    }

    /// An UNSIGNED receipt / certificate. A module ALWAYS returns `proof = none` (G1); the
    /// governing organ signs it externally. The presence of this type with no `sign` export
    /// is the structural no-operator-master-key guarantee.
    record unsigned-artifact {
        kind: string,
        subject: string,
        record-id: string,
        /// always `none` from a module — the external signer fills it.
        proof: option<string>,
        /// "assessed-unsigned" | "issued-unsigned"
        status: string,
    }
}

/// Taxation — `tax-assess`. Progressive marginal-bracket income/corporate tax + VAT.
interface tax {
    use types.{unsigned-artifact};

    record bracket-line { lower: u64, rate: f64, tax-in-bracket: f64 }

    record assessment {
        taxable-income: f64,
        liability: f64,
        effective-rate: f64,
        currency: string,
        rate-table: string,
        brackets: list<bracket-line>,
        receipt: unsigned-artifact,
    }

    record vat-assessment {
        net-vat-due: f64,
        refund-due: f64,
        currency: string,
        receipt: unsigned-artifact,
    }

    /// Assess income/corporate tax from a return (gross − deductions → taxable), localized by
    /// `table-key` (the jurisdiction's bracket table). Errors on unknown table / negative income.
    assess-income: func(gross: f64, deductions: f64, table-key: string) -> result<assessment, string>;

    /// Net VAT = output − input (EN 16931 / SAF-T aggregates).
    assess-vat: func(output-vat: f64, input-vat: f64, currency: string) -> result<vat-assessment, string>;
}

/// Civil registration & vital statistics — `civil-registry` (UN CRVS, append-only).
interface civil {
    use types.{unsigned-artifact};

    record vital-record {
        record-id: string,
        vital-kind: string,    // "birth" | "death" | "marriage" | "residency"
        occurred-at: string,   // ISO-8601
        immutable: bool,       // always true (G5 append-only)
    }

    record registration { entry: vital-record, certificate: unsigned-artifact }

    /// Register a birth (requires child + ≥1 parent + place + non-future occurrence).
    register-birth: func(record-id: string, child: string, parents: list<string>,
                         place: string, occurred-at: string, now: string) -> result<registration, string>;

    /// Register a death (requires decedent + place + non-future occurrence).
    register-death: func(record-id: string, decedent: string, place: string,
                        occurred-at: string, now: string, cause: option<string>) -> result<registration, string>;

    /// Register a marriage (requires two distinct, unmarried partners).
    register-marriage: func(record-id: string, partner-a: string, partner-b: string,
                           place: string, occurred-at: string, now: string) -> result<registration, string>;

    /// Register a residence move-in (転入届; append-only — prior address retained, 非終末論).
    register-residency: func(record-id: string, person: string, new-address: string,
                            occurred-at: string, now: string, prior-address: option<string>) -> result<registration, string>;
}

/// Corporate registry — `corp-registry` (ISO 17442 LEI / ISO 7064 MOD 97-10).
interface corp {
    use types.{unsigned-artifact};

    record incorporation {
        registry-number: string,
        lei: string,           // ISO 17442, MOD 97-10 valid
        immutable: bool,
        certificate: unsigned-artifact,
    }

    /// Validate + register a company incorporation; assigns a registry number + a valid LEI.
    register-incorporation: func(entity-name: string, officers: list<string>, capital: f64,
                                articles: string, address: string, jurisdiction: string,
                                sequence: u32) -> result<incorporation, string>;

    /// ISO 7064 MOD 97-10 LEI validity check.
    validate-lei: func(lei: string) -> bool;
}

/// Credential / travel document — `credential-issue` (ICAO Doc 9303 MRTD).
interface credential {
    use types.{unsigned-artifact};

    record mrz { line1: string, line2: string }

    /// The document is UNSIGNED: `document.sod` / `proof` are filled by the issuing state's
    /// ICAO-PKD key, never by this module (G1).
    record passport { mrz: mrz, document: unsigned-artifact }

    /// Assemble an ICAO 9303 TD3 passport MRZ with all 7-3-1 check digits. Unsigned (G1).
    issue-passport: func(doc-number: string, issuing-state: string, nationality: string,
                        surname: string, given-names: string, dob: string, sex: string,
                        expiry: string, subject-did: string, personal-number: string) -> result<passport, string>;

    /// ICAO 9303 TD3 MRZ line-2 check-digit validation.
    validate-mrz: func(line2: string) -> bool;
}

/// One world per module — each exports ONLY its service interface. None exports `sign` (G1).
world tax-assess { export tax; }
world civil-registry { export civil; }
world corp-registry { export corp; }
world credential-issue { export credential; }
