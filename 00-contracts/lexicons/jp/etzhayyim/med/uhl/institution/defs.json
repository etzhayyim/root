{
  "lexicon": 1,
  "id": "jp.etzhayyim.med.uhl.institution.defs",
  "description": "UHL-R medical institution registry shared definitions (authoritative per ADR-2605181040).",
  "defs": {
    "capabilityKind": {
      "type": "string",
      "description": "Capability taxonomy. Mirrors schemas/institution.py CapabilityKind enum.",
      "knownValues": [
        "GENETIC_TEST",
        "PED_CI",
        "CND_CI",
        "ABI",
        "GENE_TX_OTOF",
        "OPTO_CI_TRIAL",
        "NEURAL_REGEN_RESEARCH",
        "CONSULT_HUB"
      ]
    },
    "reimbursement": {
      "type": "string",
      "knownValues": ["hoken", "self_pay", "trial", "unknown"]
    },
    "procedureRecord": {
      "type": "object",
      "required": ["evidenceUrl", "reimbursement"],
      "properties": {
        "cumulativeCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Public cumulative case count. Omit when not disclosed."
        },
        "countAsOf": {
          "type": "string",
          "format": "datetime",
          "description": "Date the cumulativeCount was current. Omit when count omitted."
        },
        "evidenceUrl": {
          "type": "string",
          "format": "uri",
          "description": "Public source URL — academic journal, official institutional site, peer-reviewed paper, or regulatory body (FDA/PMDA/EMA). SNS and personal blogs are not acceptable sources."
        },
        "reimbursement": {
          "type": "ref",
          "ref": "#reimbursement"
        },
        "notesJa": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "capability": {
      "type": "object",
      "required": ["kind", "procedureRecord"],
      "properties": {
        "kind": {
          "type": "ref",
          "ref": "#capabilityKind"
        },
        "procedureRecord": {
          "type": "ref",
          "ref": "#procedureRecord"
        }
      }
    },
    "referralPathRef": {
      "type": "object",
      "required": ["pathId"],
      "properties": {
        "pathId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "description": "Slug of a named referral path defined in ADR-2605181050."
        }
      }
    },
    "institution": {
      "type": "object",
      "required": [
        "id",
        "nameJa",
        "nameEn",
        "country",
        "locale",
        "website",
        "capabilities",
        "lastVerifiedAt",
        "verifiedBy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable slug, lowercase, country-prefixed (e.g. jp-shinshu-u-orl)."
        },
        "did": {
          "type": "string",
          "format": "did",
          "description": "Optional DID when the institution participates in the substrate."
        },
        "nameJa": {"type": "string", "minLength": 1, "maxLength": 200},
        "nameEn": {"type": "string", "minLength": 1, "maxLength": 200},
        "country": {
          "type": "string",
          "description": "ISO 3166-1 alpha-2."
        },
        "locale": {"type": "string", "minLength": 1, "maxLength": 200},
        "website": {"type": "string", "format": "uri"},
        "capabilities": {
          "type": "array",
          "minLength": 1,
          "items": {"type": "ref", "ref": "#capability"}
        },
        "referralPaths": {
          "type": "array",
          "items": {"type": "ref", "ref": "#referralPathRef"}
        },
        "lastVerifiedAt": {
          "type": "string",
          "format": "datetime",
          "description": "Verification date. Staleness window = 180 days (ADR-2605181040)."
        },
        "verifiedBy": {
          "type": "string",
          "description": "Verifier ops email. Public ops contact only — no individual clinician PII."
        }
      }
    },
    "substrateClass": {
      "type": "string",
      "description": "4-way + indeterminate output of V06 substrate classifier (ADR-2605181000).",
      "knownValues": [
        "sgn_present_hc_loss",
        "sgn_degenerating_nerve_present",
        "sgn_absent_nerve_present",
        "nerve_aplasia",
        "indeterminate"
      ]
    }
  }
}
