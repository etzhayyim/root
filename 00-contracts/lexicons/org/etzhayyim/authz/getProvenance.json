{
  "lexicon": 1,
  "id": "org.etzhayyim.authz.getProvenance",
  "defs": {
    "main": {
      "type": "query",
      "description": "Return the full provenance chain of an etzhayyim root identity — the active key + all historical key rotations, plus the vendor predecessor link if any. Read directly from EtzhayyimAuthz events on Base L2; clients SHOULD NOT trust off-chain caches without on-chain receipt cross-check. Per ADR-2605212030 §D4.",
      "parameters": {
        "type": "params",
        "required": ["rootId"],
        "properties": {
          "rootId": {
            "type": "string",
            "description": "0x-prefixed 32-byte rootId."
          },
          "chainId": {
            "type": "integer",
            "description": "Optional. Default Base mainnet (8453)."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["rootId", "did", "dwebDid", "current", "rotations"],
          "properties": {
            "rootId": {"type": "string"},
            "did": {"type": "string"},
            "dwebDid": {"type": "string"},
            "current": {
              "type": "ref",
              "ref": "#provenanceState",
              "description": "Latest state of the root."
            },
            "rotations": {
              "type": "array",
              "description": "All RootKeyRotated events in chronological order (earliest first).",
              "items": {"type": "ref", "ref": "#rotationEntry"}
            },
            "vendorPredecessor": {
              "type": "ref",
              "ref": "#vendorPredecessor",
              "description": "Present iff this root was created via mirrorVendorRoot."
            }
          }
        }
      },
      "errors": [
        {"name": "NotFound", "description": "No root with the supplied rootId exists on the target chain."}
      ]
    },
    "provenanceState": {
      "type": "object",
      "required": ["activeKey", "active", "createdBlock", "lastRotatedBlock"],
      "properties": {
        "activeKey": {"type": "string"},
        "active": {"type": "boolean"},
        "createdBlock": {"type": "integer"},
        "lastRotatedBlock": {"type": "integer"}
      }
    },
    "rotationEntry": {
      "type": "object",
      "required": ["block", "txHash", "oldKey", "newKey"],
      "properties": {
        "block": {"type": "integer"},
        "txHash": {"type": "string"},
        "oldKey": {"type": "string"},
        "newKey": {"type": "string"}
      }
    },
    "vendorPredecessor": {
      "type": "object",
      "required": ["vendorRootHash", "vendorAddr"],
      "properties": {
        "vendorRootHash": {"type": "string"},
        "vendorAddr": {"type": "string"},
        "mirroredAtBlock": {"type": "integer"},
        "mirrorTxHash": {"type": "string"}
      }
    }
  }
}
