{
  "lexicon": 1,
  "id": "ai.gftd.apps.bengoshi.registerLawyer",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a licensed lawyer/attorney (IBA + ABA + 日弁連 + national bar associations). Path-based DID: did:web:bengoshi.gftd.ai:{iso3}:{barId}.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["jurisdiction", "fullName", "barAssociation"],
          "properties": {
            "jurisdiction": { "type": "string", "description": "ISO 3166-1 alpha-3" },
            "fullName": { "type": "string" },
            "fullNameLocal": { "type": "string" },
            "barAssociation": { "type": "string", "description": "弁護士会 / state bar / IBA member" },
            "barNumber": { "type": "string" },
            "admittedAt": { "type": "string", "format": "datetime" },
            "specializations": { "type": "array", "items": { "type": "string" }, "description": "tax/IP/criminal/family/corporate/etc" },
            "lawfirmDid": { "type": "string", "format": "did", "description": "associated lawfirm if any" },
            "status": { "type": "string", "enum": ["active", "suspended", "disbarred", "inactive", "deceased"] }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did", "uri"],
          "properties": {
            "did": { "type": "string", "format": "did" },
            "uri": { "type": "string", "format": "at-uri" },
            "cid": { "type": "string", "format": "cid" }
          }
        }
      }
    }
  }
}
