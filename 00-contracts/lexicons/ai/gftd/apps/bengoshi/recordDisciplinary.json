{
  "lexicon": 1,
  "id": "ai.gftd.apps.bengoshi.recordDisciplinary",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a disciplinary action against a lawyer (bar association sanction, suspension, disbarment).",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["lawyerDid", "actionType", "occurredAt"],
          "properties": {
            "lawyerDid": { "type": "string", "format": "did" },
            "actionType": { "type": "string", "enum": ["reprimand", "fine", "suspension", "disbarment", "reinstatement"] },
            "occurredAt": { "type": "string", "format": "datetime" },
            "issuingBody": { "type": "string", "description": "bar association DID or name" },
            "reasonCode": { "type": "string" },
            "narrative": { "type": "string" },
            "sourceUri": { "type": "string", "format": "uri" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri"],
          "properties": {
            "uri": { "type": "string", "format": "at-uri" },
            "cid": { "type": "string", "format": "cid" }
          }
        }
      }
    }
  }
}
