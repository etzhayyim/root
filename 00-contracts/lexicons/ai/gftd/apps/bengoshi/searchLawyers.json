{
  "lexicon": 1,
  "id": "ai.gftd.apps.bengoshi.searchLawyers",
  "defs": {
    "main": {
      "type": "query",
      "description": "Search lawyers by jurisdiction, specialization, or bar association. Returns active lawyers by default.",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "properties": {
          "jurisdiction": { "type": "string" },
          "specialization": { "type": "string" },
          "barAssociation": { "type": "string" },
          "lawfirmDid": { "type": "string", "format": "did" },
          "status": { "type": "string", "enum": ["active", "suspended", "disbarred", "inactive", "deceased"], "default": "active" },
          "q": { "type": "string", "description": "name match (exact only — SQL CONTAINS prohibited)" },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["lawyers", "total", "offset", "limit"],
          "properties": {
            "lawyers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "did": { "type": "string", "format": "did" },
                  "fullName": { "type": "string" },
                  "jurisdiction": { "type": "string" },
                  "barAssociation": { "type": "string" },
                  "specializations": { "type": "array", "items": { "type": "string" } },
                  "status": { "type": "string" }
                }
              }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
