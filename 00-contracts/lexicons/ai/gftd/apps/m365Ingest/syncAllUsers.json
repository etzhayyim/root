{
  "lexicon": 1,
  "id": "ai.gftd.apps.m365Ingest.syncAllUsers",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Delta sync across all tracked tenant users (@gftd.co.jp). Default cron trigger every 15 min.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "upnDomainSuffix": { "type": "string", "default": "@gftd.co.jp" },
            "maxConcurrency": { "type": "integer", "default": 4, "minimum": 1, "maximum": 8 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "usersEnumerated": { "type": "integer" },
            "usersSynced": { "type": "integer" },
            "totalInserted": { "type": "integer" },
            "totalYabai": { "type": "integer" },
            "errors": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["usersEnumerated", "usersSynced", "totalInserted"]
        }
      }
    }
  }
}
