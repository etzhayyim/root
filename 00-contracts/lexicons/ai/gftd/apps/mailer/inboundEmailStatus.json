{
  "lexicon": 1,
  "id": "ai.gftd.apps.mailer.inboundEmailStatus",
  "defs": {
    "main": {
      "type": "record",
      "description": "Delivery outcome for an inbound email. `status` = `delivered` (convo created and message posted) or `partial` (convo creation failed).",
      "record": {
        "type": "object",
        "properties": {
          "messageId": { "type": "string" },
          "status": { "type": "string" },
          "senderDid": { "type": "string" },
          "recipientDid": { "type": "string" },
          "convoId": { "type": "string" },
          "deliveredAtMs": { "type": "integer" },
          "orgId": { "type": "string" },
          "userId": { "type": "string" },
          "actorId": { "type": "string" }
        },
        "required": ["messageId", "status", "deliveredAtMs"]
      }
    }
  }
}
