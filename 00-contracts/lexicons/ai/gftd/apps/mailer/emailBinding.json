{
  "lexicon": 1,
  "id": "ai.gftd.apps.mailer.emailBinding",
  "defs": {
    "main": {
      "type": "record",
      "description": "Email address \u2194 DID binding. `direction` = `inbound` (auto-created for unknown senders), `outbound`, or `both` (registered user address).",
      "record": {
        "type": "object",
        "properties": {
          "email": { "type": "string" },
          "did": { "type": "string" },
          "direction": { "type": "string" },
          "verified": { "type": "boolean" },
          "createdAtMs": { "type": "integer" },
          "orgId": { "type": "string" },
          "userId": { "type": "string" },
          "actorId": { "type": "string" },
          "purpose": {
            "type": "string",
            "description": "Free-text label for ops auditability (e.g. \"USPTO ODP signup\"). Set by ai.gftd.apps.mailer.provisionMailbox callers."
          }
        },
        "required": ["email", "did", "direction"]
      }
    }
  }
}
