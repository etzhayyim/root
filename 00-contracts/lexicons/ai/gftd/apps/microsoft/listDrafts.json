{
  "lexicon": 1,
  "id": "ai.gftd.apps.microsoft.listDrafts",
  "defs": {
    "main": {
      "type": "query",
      "description": "List pending drafts (newest first) from the Outlook Drafts folder of the given mailbox. Used to review queued-for-approval emails before calling sendDraft.",
      "parameters": {
        "type": "params",
        "properties": {
          "fromUpn": { "type": "string", "description": "Mailbox UPN. Defaults to env DEFAULT_SENDER_UPN when omitted." },
          "top": { "type": "integer", "default": 25, "minimum": 1, "maximum": 100 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "fromUpn": { "type": "string" },
            "drafts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "subject": { "type": "string" },
                  "toRecipients": { "type": "array", "items": { "type": "string" } },
                  "createdDateTime": { "type": "string" },
                  "lastModifiedDateTime": { "type": "string" },
                  "webLink": { "type": "string" }
                }
              }
            }
          },
          "required": ["fromUpn", "drafts"]
        }
      }
    }
  }
}
