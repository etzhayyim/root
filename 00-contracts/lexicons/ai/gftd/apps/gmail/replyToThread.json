{
  "lexicon": 1,
  "id": "ai.gftd.apps.gmail.replyToThread",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Reply to an existing Gmail thread.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "accountEmail": { "type": "string" },
            "threadId": { "type": "string" },
            "inReplyTo": { "type": "string" },
            "body": { "type": "string" },
            "bodyHtml": { "type": "string" }
          },
          "required": ["threadId", "body"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "error": { "type": "string" },
            "outboundId": { "type": "string" },
            "gmailMessageId": { "type": "string" },
            "threadId": { "type": "string" },
            "status": { "type": "string" }
          },
          "required": []
        }
      }
    }
  }
}
