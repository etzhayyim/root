{
  "lexicon": 1,
  "id": "ai.gftd.apps.gmail.listAccounts",
  "defs": {
    "main": {
      "type": "query",
      "description": "List Gmail accounts connected by the caller.",
      "parameters": {
        "type": "params",
        "properties": {}
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "accounts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "displayName": { "type": "string" },
                  "status": { "type": "string" },
                  "scope": { "type": "string" },
                  "historyId": { "type": "string" },
                  "lastSyncAt": { "type": "string" },
                  "connectedAt": { "type": "string" }
                }
              }
            },
            "total": { "type": "integer" }
          },
          "required": ["accounts", "total"]
        }
      }
    }
  }
}
