{
  "lexicon": 1,
  "id": "ai.gftd.apps.ameno.cardHome",
  "defs": {
    "main": {
      "type": "query",
      "description": "Protocol canvas card for ameno.gftd.ai. Returns the home card metadata (title, description, model picker, recent history snippet). Pure compute on CF Worker edge — no DB access.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["title", "description", "embedUrl"],
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "embedUrl": { "type": "string", "format": "uri" },
            "defaultModelId": { "type": "string" },
            "availableModels": { "type": "array", "items": { "type": "string" } },
            "webgpuRequired": { "type": "boolean" },
            "tagline": { "type": "string" }
          }
        }
      }
    }
  }
}
