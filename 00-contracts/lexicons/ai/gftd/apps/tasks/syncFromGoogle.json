{
  "lexicon": 1,
  "id": "ai.gftd.apps.tasks.syncFromGoogle",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Sync a Google tasks account into the graph.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": { "type": "object", "required":["email"], "properties": { "email":{"type":"string"} } }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": { "jobId":{"type":"string"}, "synced":{"type":"integer"}, "status":{"type":"string"}, "error":{"type":"string"} } }
      }
    }
  }
}
