{
  "lexicon": 1,
  "id": "ai.gftd.apps.hubspot.getSyncStatus",
  "defs": {
    "main": {
      "type": "query",
      "description": "Return the current vertex_hubspot_sync_cursor state for one or all object types — last cursor watermark, last run timestamp, last run row count, last error.",
      "parameters": {
        "type": "params",
        "properties": {
          "objectType": { "type": "string", "description": "Filter to one object type. Omit to return all." },
          "portalId": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "cursors": {
              "type": "array",
              "items": { "type": "ref", "ref": "#cursorRow" }
            }
          },
          "required": ["cursors"]
        }
      }
    },
    "cursorRow": {
      "type": "object",
      "properties": {
        "objectType": { "type": "string" },
        "portalId": { "type": "string" },
        "lastModifiedCursor": { "type": "string" },
        "lastRunAt": { "type": "string" },
        "lastRunStatus": { "type": "string" },
        "lastRunCount": { "type": "integer" },
        "lastError": { "type": "string" }
      },
      "required": ["objectType"]
    }
  }
}
