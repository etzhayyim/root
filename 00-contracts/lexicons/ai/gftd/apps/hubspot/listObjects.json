{
  "lexicon": 1,
  "id": "ai.gftd.apps.hubspot.listObjects",
  "defs": {
    "main": {
      "type": "query",
      "description": "List ingested HubSpot CRM objects of a given type from vertex_hubspot_{objectType}. Read-side projection over Hyperdrive (ADR-0036). For full property fanout retrieve `propertiesJson` and parse client-side.",
      "parameters": {
        "type": "params",
        "properties": {
          "objectType": {
            "type": "string",
            "enum": ["contact", "company", "deal", "ticket", "owner", "engagement", "lineItem", "product"]
          },
          "modifiedSince": { "type": "string", "description": "ISO 8601 — filter hs_lastmodified_at >= modifiedSince." },
          "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 },
          "offset": { "type": "integer", "minimum": 0, "default": 0 }
        },
        "required": ["objectType"]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "objectType": { "type": "string" },
            "objects": {
              "type": "array",
              "items": { "type": "ref", "ref": "#objectRow" }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          },
          "required": ["objectType", "objects", "total", "offset", "limit"]
        }
      }
    },
    "objectRow": {
      "type": "object",
      "properties": {
        "vertexId": { "type": "string" },
        "hubspotId": { "type": "string" },
        "portalId": { "type": "string" },
        "hsObjectId": { "type": "string" },
        "hsCreatedAt": { "type": "string" },
        "hsLastmodifiedAt": { "type": "string" },
        "archived": { "type": "integer" },
        "propertiesJson": { "type": "string" }
      },
      "required": ["vertexId", "hubspotId"]
    }
  }
}
