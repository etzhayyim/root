{
  "lexicon": 1,
  "id": "ai.gftd.apps.datacenter.startOperation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0055. Start a datacenter operation workflow instance for a facility request.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "facilityId": { "type": "string" },
            "orgId": { "type": "string" },
            "operatorDid": { "type": "string" },
            "requestId": { "type": "string" },
            "kind": { "type": "string", "enum": ["incident", "maintenance", "capacity", "access"] },
            "summary": { "type": "string" },
            "riskClass": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
            "requiresApproval": { "type": "boolean" },
            "windowStart": { "type": "string" },
            "windowEnd": { "type": "string" }
          },
          "required": ["facilityId", "orgId", "requestId", "kind", "summary", "riskClass", "requiresApproval"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "requestId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
