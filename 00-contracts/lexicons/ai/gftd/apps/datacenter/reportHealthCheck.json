{
  "lexicon": 1,
  "id": "ai.gftd.apps.datacenter.reportHealthCheck",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0055. Record post-change or post-incident health validation for a facility.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "requestId": { "type": "string" },
            "status": { "type": "string", "enum": ["ok", "degraded", "failed"] },
            "metricRef": { "type": "string" },
            "checkedAt": { "type": "string" }
          },
          "required": ["requestId", "status", "checkedAt"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "nextAction": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
