{
  "lexicon": 1,
  "id": "ai.gftd.apps.datacenter.getMyAccessRequest",
  "defs": {
    "main": {
      "type": "query",
      "description": "ADR-0055. Fetch one access request visible to the requester.",
      "parameters": {
        "type": "params",
        "required": ["requestId"],
        "properties": {
          "requestId": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "requestId": { "type": "string" },
            "facilityId": { "type": "string" },
            "status": { "type": "string" },
            "accessScope": { "type": "string" },
            "visitStart": { "type": "string" },
            "visitEnd": { "type": "string" }
          }
        }
      }
    }
  }
}
