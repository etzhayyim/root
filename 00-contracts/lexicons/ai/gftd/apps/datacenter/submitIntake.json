{
  "lexicon": 1,
  "id": "ai.gftd.apps.datacenter.submitIntake",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0055. Persist or update the intake payload for a datacenter operation before routing.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "requestId": { "type": "string" },
            "facilityId": { "type": "string" },
            "operation": {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "enum": ["incident", "maintenance", "capacity", "access"] },
                "summary": { "type": "string" },
                "riskClass": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
                "requiresApproval": { "type": "boolean" },
                "windowStart": { "type": "string" },
                "windowEnd": { "type": "string" },
                "customerImpact": { "type": "string", "enum": ["none", "degraded", "partial-outage", "full-outage"] }
              },
              "required": ["kind", "summary", "riskClass", "requiresApproval"]
            }
          },
          "required": ["requestId", "facilityId", "operation"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "newStatus": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
