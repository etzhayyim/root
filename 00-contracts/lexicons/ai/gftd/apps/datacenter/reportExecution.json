{
  "lexicon": 1,
  "id": "ai.gftd.apps.datacenter.reportExecution",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0055. Submit execution results for a planned or emergency datacenter action.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "requestId": { "type": "string" },
            "status": { "type": "string", "enum": ["completed", "rolledBack", "degraded"] },
            "changeSteps": { "type": "string" },
            "notes": { "type": "string" },
            "startedAt": { "type": "string" },
            "endedAt": { "type": "string" }
          },
          "required": ["requestId", "status", "startedAt", "endedAt"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "newStatus": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
