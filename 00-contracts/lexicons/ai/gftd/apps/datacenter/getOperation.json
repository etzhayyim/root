        "type": "params",
        "required": ["requestId"],
        "properties": {
          "requestId": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "requestId": { "type": "string" },
            "facilityId": { "type": "string" },
            "operationKind": { "type": "string" },
            "riskClass": { "type": "string" },
            "status": { "type": "string" },
            "metricRef": { "type": "string" },
            "approvedAt": { "type": "string" },
            "completedAt": { "type": "string" }
          }
        }
      }
    }
  }
