{
  "lexicon": 1,
  "id": "ai.gftd.apps.datacenter.submitAccessDraft",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0055. Save Tier 3 access request payload before security review.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "requestId": { "type": "string" },
            "facilityId": { "type": "string" },
            "visitorPayload": { "type": "string" },
            "employerPayload": { "type": "string" },
            "badgePayload": { "type": "string" },
            "safetyPayload": { "type": "string" }
          },
          "required": ["requestId", "facilityId", "visitorPayload"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "newStatus": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
