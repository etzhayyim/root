{
  "lexicon": 1,
  "id": "ai.gftd.apps.datacenter.reviewAccess",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0055. Security verdict on a physical access request.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "requestId": { "type": "string" },
            "decision": { "type": "string", "enum": ["approve", "reject"] },
            "badgeId": { "type": "string" },
            "comment": { "type": "string" }
          },
          "required": ["requestId", "decision"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "newStatus": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
