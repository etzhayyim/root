{
  "lexicon": 1,
  "id": "ai.gftd.apps.datacenter.stabilizeIncident",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0055. Submit a stabilization action for a degraded or failed datacenter incident.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "requestId": { "type": "string" },
            "actionTaken": { "type": "string" },
            "nextHypothesis": { "type": "string" },
            "vendorEscalated": { "type": "boolean" },
            "stabilizedAt": { "type": "string" }
          },
          "required": ["requestId", "actionTaken", "stabilizedAt"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "newStatus": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
