{
  "lexicon": 1,
  "id": "ai.gftd.apps.cloudflareBrowserRender.closeSession",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Close a session (terminates the Durable Object chromium instance).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sessionId"],
          "properties": { "sessionId": { "type": "string" } }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": { "sessionId": { "type": "string" }, "closed": { "type": "boolean" }, "error": { "type": "string" } } }
      }
    }
  }
}
