{
  "lexicon": 1,
  "id": "ai.gftd.apps.jpCorpFinance.backfillKanpo",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Start a bounded Kanpo kessan-koukoku backfill by publication date range.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["dateFrom", "dateTo"],
          "properties": {
            "dateFrom": { "type": "string", "format": "date" },
            "dateTo": { "type": "string", "format": "date" },
            "limitIssues": { "type": "integer", "minimum": 1 },
            "dryRun": { "type": "boolean" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["runId"],
          "properties": {
            "runId": { "type": "string" },
            "processInstanceKey": { "type": "string" }
          }
        }
      }
    }
  }
}
