{
  "lexicon": 1,
  "id": "ai.gftd.apps.legal-corpus.getDocument",
  "defs": {
    "main": {
      "type": "query",
      "description": "Fetch single legal corpus document by vertexId or canonicalUri. ADR-0049.",
      "parameters": {
        "type": "params",
        "properties": {
          "vertexId":     { "type": "string" },
          "canonicalUri": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "vertexId":     { "type": "string" },
            "sourceId":     { "type": "string" },
            "canonicalUri": { "type": "string" },
            "documentType": { "type": "string" },
            "jurisdiction": { "type": "string" },
            "court":        { "type": "string" },
            "languageCode": { "type": "string" },
            "title":        { "type": "string" },
            "citation":     { "type": "string" },
            "decidedAt":    { "type": "string" },
            "publishedAt":  { "type": "string" },
            "fetchedAt":    { "type": "string" },
            "bodyText":     { "type": "string" },
            "bodyUri":      { "type": "string" },
            "topicTags":    { "type": "array", "items": { "type": "string" } },
            "embeddingDim": { "type": "integer" }
          }
        }
      },
      "errors": [
        { "name": "NotFound" }
      ]
    }
  }
}
