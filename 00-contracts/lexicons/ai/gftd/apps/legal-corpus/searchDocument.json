{
  "lexicon": 1,
  "id": "ai.gftd.apps.legal-corpus.searchDocument",
  "defs": {
    "main": {
      "type": "query",
      "description": "Vector similarity + lexical filter search over vertex_legal_corpus_document. Cosine distance via IVF index. ADR-0049 D3.",
      "parameters": {
        "type": "params",
        "required": ["queryText"],
        "properties": {
          "queryText":      { "type": "string", "maxLength": 4096 },
          "jurisdiction":   { "type": "string", "description": "Filter ISO 3166-1 alpha-3" },
          "documentType":   { "type": "string" },
          "languageCode":   { "type": "string" },
          "decidedAfter":   { "type": "string", "format": "datetime" },
          "decidedBefore":  { "type": "string", "format": "datetime" },
          "limit":          { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["hits"],
          "properties": {
            "hits": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["vertexId", "canonicalUri", "title", "score"],
                "properties": {
                  "vertexId":     { "type": "string" },
                  "canonicalUri": { "type": "string" },
                  "title":        { "type": "string" },
                  "court":        { "type": "string" },
                  "jurisdiction": { "type": "string" },
                  "decidedAt":    { "type": "string" },
                  "score":        { "type": "number", "description": "1 - cosine_distance, higher = more similar" }
                }
              }
            }
          }
        }
      }
    }
  }
}
