{
  "lexicon": 1,
  "id": "ai.gftd.apps.keihi.expense",
  "defs": {
    "main": {
      "type": "record",
      "description": "Employee expense claim with receipt CID and approval status.",
      "record": {
        "type": "object",
        "required": ["employeeDid", "expenseDate", "amount", "currency", "status"],
        "properties": {
          "employeeDid": { "type": "string", "format": "did" },
          "projectDid": { "type": "string", "format": "did" },
          "vendorName": { "type": "string" },
          "expenseDate": { "type": "string", "format": "datetime" },
          "amount": { "type": "number" },
          "currency": { "type": "string", "default": "JPY" },
          "taxRate": { "type": "number", "default": 0 },
          "category": { "type": "string" },
          "receiptCid": { "type": "string" },
          "status": { "type": "string", "enum": ["submitted", "approved", "rejected", "paid"] }
        }
      }
    }
  }
}
