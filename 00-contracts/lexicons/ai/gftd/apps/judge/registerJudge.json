{
  "lexicon": 1,
  "id": "ai.gftd.apps.judge.registerJudge",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a judge profile (CEPEJ + ABA + 最高裁人事 + national judicial councils). Path-based DID: did:web:judge.gftd.ai:{iso3}:{slug}.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["jurisdiction", "fullName"],
          "properties": {
            "jurisdiction": { "type": "string", "description": "ISO 3166-1 alpha-3" },
            "fullName": { "type": "string" },
            "fullNameLocal": { "type": "string" },
            "courtDid": { "type": "string", "format": "did" },
            "courtLevel": { "type": "string", "description": "supreme/high/district/family/specialized" },
            "appointedAt": { "type": "string", "format": "datetime" },
            "retiredAt": { "type": "string", "format": "datetime" },
            "specializations": { "type": "array", "items": { "type": "string" } },
            "biographyUri": { "type": "string", "format": "uri" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did", "uri"],
          "properties": {
            "did": { "type": "string", "format": "did" },
            "uri": { "type": "string", "format": "at-uri" },
            "cid": { "type": "string", "format": "cid" }
          }
        }
      }
    }
  }
}
