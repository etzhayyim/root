{
  "lexicon": 1,
  "id": "ai.gftd.apps.judge.listJudges",
  "defs": {
    "main": {
      "type": "query",
      "description": "List judges with offset/limit pagination, optional jurisdiction filter.",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "properties": {
          "jurisdiction": { "type": "string" },
          "courtLevel": { "type": "string" },
          "activeOnly": { "type": "boolean", "default": true },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["judges", "total", "offset", "limit"],
          "properties": {
            "judges": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "did": { "type": "string", "format": "did" },
                  "fullName": { "type": "string" },
                  "jurisdiction": { "type": "string" },
                  "courtLevel": { "type": "string" }
                }
              }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
