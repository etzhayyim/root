{
  "lexicon": 1,
  "id": "ai.gftd.apps.pachinko.distributor",
  "defs": {
    "main": {
      "type": "record",
      "description": "Regional distributor (販社) (ADR-0038 pattern C record).",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["id", "path", "name"],
        "properties": {
          "id":            { "type": "string", "description": "Canonical maker id, e.g. maker-sanyo" },
          "path":          { "type": "string", "description": "DID path suffix, e.g. maker:sanyo" },
          "name":          { "type": "string" },
          "nameEn":        { "type": "string" },
          "subType":       { "type": "string" },
          "description":   { "type": "string" },
          "url":           { "type": "string", "format": "uri" },
          "telephone":     { "type": "string" },
          "address":       { "type": "ref", "ref": "#address" },
          "geo":           { "type": "ref", "ref": "#geo" },
          "foundedYear":   { "type": "integer" },
          "parent":        { "type": "string", "description": "Parent corporation name (if any)" },
          "stockCode":     { "type": "string" },
          "upstreamOf":    { "type": "string", "description": "DID path of upstream regulator/association" },
          "createdAt":     { "type": "string", "format": "datetime" },
          "orgId":         { "type": "string", "default": "pachinko" },
          "userId":        { "type": "string" },
          "actorId":       { "type": "string" }
        }
      }
    },
    "address": {
      "type": "object",
      "required": ["addressCountry"],
      "properties": {
        "addressCountry":  { "type": "string" },
        "addressRegion":   { "type": "string" },
        "addressLocality": { "type": "string" },
        "streetAddress":   { "type": "string" },
        "postalCode":      { "type": "string" }
      }
    },
    "geo": {
      "type": "object",
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude":  { "type": "integer", "description": "WGS84 × 1e6 (AT Lexicon has no float). Divide by 1e6 for decimal." },
        "longitude": { "type": "integer", "description": "WGS84 × 1e6" }
      }
    },
    "x-gftd-project": {
      "type": "object",
      "description": "ADR-0038 schema-driven projection metadata. External AT Protocol validators ignore unknown defs. gftd tooling reads this to (a) generate Kysely migration, (b) emit derived records in PDS commit pipeline, (c) generate Svelte typed XRPC client.",
      "properties": {
        "projection": {
          "type": "object",
          "description": "Kysely table projection. Generated by `gftd schema-gen kysely-migration`.",
          "properties": {
            "table":   { "type": "string", "default": "vertex_pachinko_distributor" },
            "rlsCols": { "type": "array", "items": { "type": "string" }, "default": ["org_id", "user_id", "actor_id"] }
          }
        },
        "derive": {
          "type": "array",
          "description": "Downstream records auto-emitted by PDS commit pipeline on write.",
          "items": { "type": "ref", "ref": "#deriveRule" }
        },
        "social": {
          "type": "object",
          "description": "Optional app.bsky.feed.post template. Mustache-style {{field}} placeholders.",
          "properties": {
            "text": { "type": "string", "default": "新規 distributor : {{name}} を登録" }
          }
        }
      }
    },
    "deriveRule": {
      "type": "object",
      "required": ["collection", "when"],
      "properties": {
        "collection": { "type": "string", "description": "Target NSID to emit" },
        "when":       { "type": "string", "enum": ["create", "update", "delete"] },
        "template":   { "type": "string", "description": "JSON template with {{field}} placeholders" }
      }
    }
  }
}
