{
  "lexicon": 1,
  "id": "ai.gftd.apps.etzhayyim.yobel.enrollDebtor",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "債務者が rite に opt-in し、eligibility proof を提出する。rite type 別の eligibility 条件 (shmita = 共同体員、tokusei = jurisdictionMatch 等) は verifyEligibility で評価。",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "riteId",
            "debtorDid"
          ],
          "properties": {
            "riteId": {
              "type": "string"
            },
            "debtorDid": {
              "type": "string"
            },
            "eligibilityProof": {
              "type": "string",
              "description": "Free-text or signed claim supporting eligibility (community membership card, residence cert, trust kyu/dan ref)",
              "maxLength": 2000
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "enrollmentId": {
              "type": "string"
            },
            "eligible": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
