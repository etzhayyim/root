{
  "lexicon": 1,
  "id": "ai.gftd.apps.arms.checkInFirearm",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Return a checked-out firearm. Firearm status transitions from 'checked_out' back to 'active'. No auth session required for check-in (holder identity is resolved from the custody chain).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["firearmVid", "holderDid"],
          "properties": {
            "firearmVid":   { "type": "string" },
            "holderDid":    { "type": "string", "format": "did" },
            "locationCode": { "type": "string" },
            "notes":        { "type": "string", "description": "Optional post-mission notes" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "eventVid", "firearmVid", "holderDid", "status", "occurredAt"],
          "properties": {
            "ok":         { "type": "boolean" },
            "eventVid":   { "type": "string" },
            "firearmVid": { "type": "string" },
            "holderDid":  { "type": "string", "format": "did" },
            "status":     { "type": "string", "enum": ["active"] },
            "occurredAt": { "type": "string", "format": "datetime" }
          }
        }
      }
    }
  }
}
