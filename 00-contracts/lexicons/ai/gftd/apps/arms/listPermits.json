{
  "lexicon": 1,
  "id": "ai.gftd.apps.arms.listPermits",
  "defs": {
    "main": {
      "type": "query",
      "description": "List permits for a holder DID. Returns permit metadata (permit number hash, not plaintext). Filter by permitType or status.",
      "parameters": {
        "type": "params",
        "required": ["holderDid"],
        "properties": {
          "holderDid":  { "type": "string", "description": "Holder DID to query permits for" },
          "permitType": { "type": "string", "description": "acquisition|possession|carry|military|law_enforcement|export|research" },
          "status":     { "type": "string", "enum": ["active", "suspended", "revoked", "expired"] },
          "limit":      { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
          "offset":     { "type": "integer", "minimum": 0, "default": 0 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["permits", "limit", "offset"],
          "properties": {
            "permits": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "vertex_id":           { "type": "string" },
                  "holder_did":          { "type": "string" },
                  "permit_type":         { "type": "string" },
                  "permit_number_hash":  { "type": "string" },
                  "category_allowed":    { "type": "string" },
                  "issuer_did":          { "type": "string" },
                  "issued_at":           { "type": "string" },
                  "expires_at":          { "type": "string" },
                  "status":              { "type": "string" }
                }
              }
            },
            "limit":  { "type": "integer" },
            "offset": { "type": "integer" }
          }
        }
      }
    }
  }
}
