{
  "lexicon": 1,
  "id": "ai.gftd.apps.arms.listFirearms",
  "defs": {
    "main": {
      "type": "query",
      "description": "List firearms in the registry. Filter by holderDid (current holder via edge), category, or status. Returns public fields only (no serial number).",
      "parameters": {
        "type": "params",
        "properties": {
          "holderDid": { "type": "string", "description": "Filter by current holder DID" },
          "category":  { "type": "string", "description": "pistol|rifle|shotgun|smg|hmg|..." },
          "status":    { "type": "string", "enum": ["active", "checked_out", "stolen", "lost", "destroyed", "exported"] },
          "limit":     { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 },
          "offset":    { "type": "integer", "minimum": 0, "default": 0 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["firearms", "limit", "offset"],
          "properties": {
            "firearms": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "vertex_id":          { "type": "string" },
                  "serial_number_hash": { "type": "string" },
                  "make":               { "type": "string" },
                  "model":              { "type": "string" },
                  "caliber":            { "type": "string" },
                  "category":           { "type": "string" },
                  "status":             { "type": "string" },
                  "registered_at":      { "type": "string" }
                }
              }
            },
            "limit":  { "type": "integer" },
            "offset": { "type": "integer" }
          }
        }
      }
    }
  }
}
