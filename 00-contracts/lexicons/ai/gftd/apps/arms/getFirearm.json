{
  "lexicon": 1,
  "id": "ai.gftd.apps.arms.getFirearm",
  "defs": {
    "main": {
      "type": "query",
      "description": "Retrieve a single firearm record by serialHash or firearmVid. Returns public fields only (serial number is NOT returned — Tier 3 PII). Includes currentHolderDid from edge_arms_firearm_to_holder.",
      "parameters": {
        "type": "params",
        "properties": {
          "serialHash": { "type": "string", "description": "SHA-256 hex of the serial number" },
          "firearmVid": { "type": "string", "description": "at:// URI of the firearm vertex" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "vertex_id":         { "type": "string" },
            "serial_number_hash":{ "type": "string" },
            "make":              { "type": "string" },
            "model":             { "type": "string" },
            "caliber":           { "type": "string" },
            "category":          { "type": "string" },
            "status":            { "type": "string" },
            "registered_at":     { "type": "string" },
            "owner_did":         { "type": "string" },
            "currentHolderDid":  { "type": "string" }
          }
        }
      }
    }
  }
}
