{
  "lexicon": 1,
  "id": "ai.gftd.apps.arms.reportIncident",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Report a firearm incident (theft, loss, unauthorized discharge, export violation, tampering). Theft and loss update firearm status. All incidents emit to vertex_open_defence_event with severity=critical (theft/unauthorized_discharge) or high (others). Notifies 銃砲刀剣類所持等取締法 enforcement chain.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["firearmVid", "incidentType"],
          "properties": {
            "firearmVid":    { "type": "string" },
            "incidentType":  { "type": "string", "enum": ["theft", "loss", "unauthorized_discharge", "export_violation", "tampering"] },
            "description":   { "type": "string" },
            "locationCode":  { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "eventVid", "defenceEventVid", "firearmVid", "incidentType", "newStatus", "occurredAt"],
          "properties": {
            "ok":              { "type": "boolean" },
            "eventVid":        { "type": "string" },
            "defenceEventVid": { "type": "string", "description": "vertex_open_defence_event VID for cross-cluster tracking" },
            "firearmVid":      { "type": "string" },
            "incidentType":    { "type": "string" },
            "newStatus":       { "type": "string" },
            "occurredAt":      { "type": "string", "format": "datetime" }
          }
        }
      }
    }
  }
}
