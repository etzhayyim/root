{
  "lexicon": 1,
  "id": "ai.gftd.apps.arms.verifyAuthChallenge",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Verify a holder's DID challenge response. The holder must sign the challenge string (returned by authenticateHolder) with their DID private key and submit the hex-encoded signature. On success, auth session status transitions to 'passed' and can be used for checkOutFirearm or transferCustody.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sessionVid", "signatureHex"],
          "properties": {
            "sessionVid":    { "type": "string", "description": "sessionVid from authenticateHolder response" },
            "signatureHex":  { "type": "string", "description": "Hex-encoded ES256 or Ed25519 signature of the challenge string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sessionVid", "authStatus"],
          "properties": {
            "sessionVid":    { "type": "string" },
            "authStatus":    { "type": "string", "enum": ["passed", "failed", "expired"] },
            "completedAt":   { "type": "string", "format": "datetime" },
            "holderDid":     { "type": "string", "format": "did" },
            "firearmVid":    { "type": "string" }
          }
        }
      }
    }
  }
}
