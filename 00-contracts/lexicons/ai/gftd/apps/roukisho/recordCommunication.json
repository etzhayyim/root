{
  "lexicon": 1,
  "id": "ai.gftd.apps.roukisho.recordCommunication",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a communication (inbound notice, outbound response, phone call, on-site visit) with a 労働基準監督署. Creates ai.gftd.apps.roukisho.communication record scoped by caseId.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["direction", "channel", "officeId"],
          "properties": {
            "direction": { "type": "string", "enum": ["inbound", "outbound"] },
            "channel": { "type": "string", "enum": ["phone", "fax", "mail", "email", "visit", "online"] },
            "officeId": { "type": "string" },
            "officeDid": { "type": "string", "format": "did" },
            "divisionNumber": { "type": "integer", "description": "方面番号" },
            "inspector": { "type": "string", "description": "監督官 name (if known)" },
            "caseId": { "type": "string", "description": "Internal business case id (e.g. matsuoka-2504)" },
            "subject": { "type": "string" },
            "summary": { "type": "string" },
            "documentBlobKey": { "type": "string", "description": "B2 blob SHA-256 hex for attachment (e.g. response letter PDF)" },
            "faxTxId": { "type": "string", "description": "Related fax actor txId if channel=fax" },
            "occurredAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "recordId": { "type": "string" },
            "uri": { "type": "string", "format": "at-uri" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
