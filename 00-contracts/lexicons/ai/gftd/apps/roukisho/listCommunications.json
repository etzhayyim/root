{
  "lexicon": 1,
  "id": "ai.gftd.apps.roukisho.listCommunications",
  "defs": {
    "main": {
      "type": "query",
      "description": "List communications with 労働基準監督署 (optionally filtered by caseId / officeId / channel).",
      "parameters": {
        "type": "params",
        "required": [],
        "properties": {
          "caseId": { "type": "string" },
          "officeId": { "type": "string" },
          "channel": { "type": "string", "enum": ["phone", "fax", "mail", "email", "visit", "online"] },
          "direction": { "type": "string", "enum": ["inbound", "outbound"] },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
          "offset": { "type": "integer", "minimum": 0, "default": 0 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "communications", "total", "offset", "limit"],
          "properties": {
            "ok": { "type": "boolean" },
            "communications": { "type": "array", "items": { "type": "unknown" } },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
