{
  "lexicon": 1,
  "id": "ai.gftd.apps.roukisho.getOffice",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get detailed 労働基準監督署 info by officeId or DID.",
      "parameters": {
        "type": "params",
        "required": [],
        "properties": {
          "officeId": { "type": "string" },
          "did": { "type": "string", "format": "did" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "office": {
              "type": "object",
              "required": ["officeId", "did", "name"],
              "properties": {
                "officeId": { "type": "string" },
                "did": { "type": "string", "format": "did" },
                "name": { "type": "string" },
                "prefecture": { "type": "string" },
                "bureau": { "type": "string" },
                "address": { "type": "string" },
                "postalCode": { "type": "string" },
                "tel": { "type": "string" },
                "fax": { "type": "string" },
                "url": { "type": "string", "format": "uri" },
                "jurisdiction": { "type": "array", "items": { "type": "string" } },
                "divisions": {
                  "type": "array",
                  "description": "方面 (Divisions/sections within the office)",
                  "items": {
                    "type": "object",
                    "properties": {
                      "number": { "type": "integer", "description": "方面番号 (1,2,3...)" },
                      "focus": { "type": "string", "description": "担当分野" }
                    }
                  }
                }
              }
            },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
