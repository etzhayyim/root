{
  "lexicon": 1,
  "id": "ai.gftd.apps.malak.queryScene",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Open-vocabulary scene search. Input is a Japanese natural-language scene descriptor (e.g. '赤い帽子・黒バックパックの男性、自転車'). No person identification. Per COMPLIANCE-MEMO Q3 this is a non-warrant path; transition to person re-identification requires queryPerson with warrant.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "sceneText",
            "requesterDid"
          ],
          "properties": {
            "sceneText": {
              "type": "string",
              "description": "JP scene descriptor. Will be parsed by LLM (qwen3-30b) and expanded to garment/colour/object/action attributes."
            },
            "requesterDid": {
              "type": "string",
              "description": "Operator DID. Must have role malak:surveillance:operator."
            },
            "cameraIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Limit search to these cameras. Empty = all permitted cameras for the requester's jurisdiction."
            },
            "timeRange": {
              "type": "ref",
              "ref": "#timeRange"
            },
            "topK": {
              "type": "integer",
              "description": "Max ranked clips to return. Server clamps to 200 max."
            },
            "minScorePermille": {
              "type": "integer",
              "description": "Min similarity score × 1000 (integer, per AT Lexicon float restriction). Default 250."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "queryId": {
              "type": "string"
            },
            "expandedDescriptors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "results": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#sceneHit"
              }
            },
            "pegelTick": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    },
    "timeRange": {
      "type": "object",
      "properties": {
        "fromTs": {
          "type": "string",
          "description": "ISO-8601 UTC"
        },
        "toTs": {
          "type": "string"
        }
      }
    },
    "sceneHit": {
      "type": "object",
      "properties": {
        "clipId": {
          "type": "string"
        },
        "cameraId": {
          "type": "string"
        },
        "tsOffsetMs": {
          "type": "integer"
        },
        "scorePermille": {
          "type": "integer",
          "description": "Similarity × 1000."
        },
        "thumbnailR2Key": {
          "type": "string",
          "description": "Faces in this thumbnail are pre-blurred by the pipeline."
        },
        "matchedAttrs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
