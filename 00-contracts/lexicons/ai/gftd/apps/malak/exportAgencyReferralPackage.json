{
  "lexicon": 1,
  "id": "ai.gftd.apps.malak.exportAgencyReferralPackage",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Generate a signed export package for an approved Malak agency referral draft without transmitting it.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["referralId"],
          "properties": {
            "referralId": { "type": "string" },
            "format": {
              "type": "string",
              "knownValues": ["json", "stix"]
            },
            "includeReviews": { "type": "boolean" },
            "includeEvidenceIds": { "type": "boolean" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "referralId": { "type": "string" },
            "packageId": { "type": "string" },
            "format": { "type": "string" },
            "payloadHash": { "type": "string" },
            "package": { "type": "unknown" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
