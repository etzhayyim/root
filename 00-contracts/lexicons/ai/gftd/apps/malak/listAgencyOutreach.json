{
  "lexicon": 1,
  "id": "ai.gftd.apps.malak.listAgencyOutreach",
  "defs": {
    "main": {
      "type": "query",
      "description": "Outreach funnel visibility for sales managers. Aggregates vertex_malak_surveillance_outreach by prefecture / addresseeRole / stage. Addressee names are returned only as ciphertext + kid (caller must unwrap via vault if authorised).",
      "parameters": {
        "type": "params",
        "properties": {
          "requesterDid": {
            "type": "string"
          },
          "prefecture": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "knownValues": [
              "registered",
              "drafted",
              "approved",
              "sent",
              "replied",
              "unsubscribed",
              "all"
            ]
          },
          "tierFilter": {
            "type": "string",
            "knownValues": [
              "S",
              "A",
              "B",
              "C",
              "all"
            ],
            "description": "Lead-pipeline tier from LEAD-PIPELINE-SEED §1."
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "outreaches": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#outreachSummary"
              }
            },
            "stageCounts": {
              "type": "ref",
              "ref": "#stageCounts"
            },
            "cursor": {
              "type": "string"
            },
            "offset": {
              "type": "integer"
            },
            "limit": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    },
    "outreachSummary": {
      "type": "object",
      "properties": {
        "outreachId": {
          "type": "string"
        },
        "prefecture": {
          "type": "string"
        },
        "addresseeRole": {
          "type": "string"
        },
        "addresseeCipher": {
          "type": "string"
        },
        "kid": {
          "type": "string"
        },
        "tier": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "lastEventAt": {
          "type": "string"
        },
        "optInSource": {
          "type": "string"
        }
      }
    },
    "stageCounts": {
      "type": "object",
      "properties": {
        "registered": {
          "type": "integer"
        },
        "drafted": {
          "type": "integer"
        },
        "approved": {
          "type": "integer"
        },
        "sent": {
          "type": "integer"
        },
        "replied": {
          "type": "integer"
        },
        "unsubscribed": {
          "type": "integer"
        }
      }
    }
  }
}
