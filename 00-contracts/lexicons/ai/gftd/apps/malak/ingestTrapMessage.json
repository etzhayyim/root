{
  "lexicon": 1,
  "id": "ai.gftd.apps.malak.ingestTrapMessage",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Ingest an inbound-only email or SMS trap message as Malak evidence.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["trapKind", "recipient", "provider", "sender", "bodyPreview"],
          "properties": {
            "trapId": { "type": "string" },
            "trapKind": {
              "type": "string",
              "knownValues": ["email", "sms"]
            },
            "recipient": { "type": "string" },
            "provider": { "type": "string" },
            "providerMessageId": { "type": "string" },
            "sender": { "type": "string" },
            "subject": { "type": "string" },
            "bodyPreview": { "type": "string" },
            "rawPayloadHash": { "type": "string" },
            "receivedAt": { "type": "string" },
            "headersJson": { "type": "string" },
            "urls": { "type": "array", "items": { "type": "string" } },
            "tlp": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "messageId": { "type": "string" },
            "evidenceId": { "type": "string" },
            "payloadHash": { "type": "string" },
            "urlCount": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
