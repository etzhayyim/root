{
  "lexicon": 1,
  "id": "ai.gftd.apps.malak.buildAgencyReferralEvidenceBundle",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Resolve and hash evidence referenced by a Malak agency referral draft without fetching new external material.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["referralId"],
          "properties": {
            "referralId": { "type": "string" },
            "requireComplete": { "type": "boolean" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "referralId": { "type": "string" },
            "bundleId": { "type": "string" },
            "bundleHash": { "type": "string" },
            "complete": { "type": "boolean" },
            "evidenceCount": { "type": "integer" },
            "missingEvidenceIds": { "type": "array", "items": { "type": "string" } },
            "evidenceBundle": { "type": "unknown" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
