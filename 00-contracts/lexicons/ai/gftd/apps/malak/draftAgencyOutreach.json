{
  "lexicon": 1,
  "id": "ai.gftd.apps.malak.draftAgencyOutreach",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Draft an outbound sales email for a registered prospect. Runs the sales_outreach LangGraph through enrich_prefecture → draft_email_jp → safety_review. Returns the draft only — sending requires reviewSalesEmail + sendSalesEmail. SAFETY_GATES (COMPLIANCE-MEMO §6) block gift offers, exaggerated claims, false authority claims, and missing unsubscribeUrl.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "prospectId",
            "drafterDid"
          ],
          "properties": {
            "prospectId": {
              "type": "string"
            },
            "drafterDid": {
              "type": "string",
              "description": "Must have role malak:agency_outreach:operator."
            },
            "templateKey": {
              "type": "string",
              "knownValues": [
                "v1_intro",
                "v1_followup",
                "v1_reinvite",
                "v1_intro_en",
                "v1_followup_en",
                "v1_reinvite_en",
                "v1_intro_en_interpol",
                "v1_intro_en_continental_eu"
              ]
            },
            "ragHints": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Optional extra hints (recent 通達, recent 入札情報) for RAG enrichment."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "draftId": {
              "type": "string"
            },
            "subject": {
              "type": "string"
            },
            "bodyMarkdown": {
              "type": "string",
              "description": "Operator-facing draft text. Includes unsubscribeUrl placeholder which sendSalesEmail materialises."
            },
            "safetyFlags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "List of SAFETY_GATES that triggered rewrite or abort."
            },
            "blockedReason": {
              "type": "string",
              "description": "Non-empty if the draft was aborted."
            },
            "pegelTick": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
