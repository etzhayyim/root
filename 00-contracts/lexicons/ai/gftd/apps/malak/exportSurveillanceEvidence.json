{
  "lexicon": 1,
  "id": "ai.gftd.apps.malak.exportSurveillanceEvidence",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Generate a JP-police evidence packet (監視カメラ捜査報告書 / 証拠資料目録 / 送致書 / chain_of_custody.yaml). Mirrors ai.gftd.apps.malak.draftPoliceReport: renders markdown documents, fires PEGEL ticks (vertex_malak_surveillance_investigation_tick) per document, persists to outputDir. Per zero-knowledge invariant the response contains sha256 hashes — never raw document bodies.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "queryId",
            "supervisorDid",
            "sectionChiefDid"
          ],
          "properties": {
            "queryId": {
              "type": "string"
            },
            "supervisorDid": {
              "type": "string"
            },
            "sectionChiefDid": {
              "type": "string",
              "description": "Must have role malak:surveillance:section_chief. Two-stage approval per DESIGN §6 RBAC matrix."
            },
            "outputDir": {
              "type": "string",
              "description": "Absolute path on the export pod. Empty = in-memory only."
            },
            "docTypes": {
              "type": "array",
              "items": {
                "type": "string",
                "knownValues": [
                  "kanshi_houkokusho",
                  "shouko_mokuroku",
                  "souchi_sho",
                  "chain_of_custody"
                ]
              }
            },
            "caseNo": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "caseNo": {
              "type": "string"
            },
            "files": {
              "type": "ref",
              "ref": "#filesMap"
            },
            "documentSha256": {
              "type": "ref",
              "ref": "#shaMap"
            },
            "pegelTicks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    },
    "filesMap": {
      "type": "object",
      "properties": {
        "kanshi_houkokusho": {
          "type": "string"
        },
        "shouko_mokuroku": {
          "type": "string"
        },
        "souchi_sho": {
          "type": "string"
        },
        "chain_of_custody": {
          "type": "string"
        }
      }
    },
    "shaMap": {
      "type": "object",
      "properties": {
        "kanshi_houkokusho": {
          "type": "string"
        },
        "shouko_mokuroku": {
          "type": "string"
        },
        "souchi_sho": {
          "type": "string"
        },
        "chain_of_custody": {
          "type": "string"
        }
      }
    }
  }
}
