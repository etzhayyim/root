{
  "lexicon": 1,
  "id": "ai.gftd.apps.malak.registerPhishingTrapInbox",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register an owned inbound-only spamtrap mailbox or SMS number for Malak evidence collection.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["trapKind", "address", "provider", "legalBasis"],
          "properties": {
            "trapKind": {
              "type": "string",
              "knownValues": ["email", "sms"]
            },
            "address": { "type": "string" },
            "provider": { "type": "string" },
            "label": { "type": "string" },
            "legalBasis": { "type": "string" },
            "retentionPolicy": { "type": "string" },
            "status": {
              "type": "string",
              "knownValues": ["active", "paused", "retired"]
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "trapId": { "type": "string" },
            "trapKind": { "type": "string" },
            "address": { "type": "string" },
            "status": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
