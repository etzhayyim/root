{
  "lexicon": 1,
  "id": "ai.gftd.apps.malak.queryPerson",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Person re-identification from a reference photo. HARD-GATED: requires warrantRef OR enquiryRef (捜査関係事項照会書 番号) AND supervisor approval. The reference photo is consumed in-pipeline (extract face template → encrypt → vector search) and the raw bytes are never persisted. Output never contains face bytes — faces in returned thumbnails are blurred until reviewMatches records human assessment.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "requesterDid",
            "referencePhotoR2Key",
            "legalBasis"
          ],
          "properties": {
            "requesterDid": {
              "type": "string",
              "description": "Must have role malak:surveillance:investigator."
            },
            "supervisorDid": {
              "type": "string",
              "description": "Must have role malak:surveillance:supervisor. Filled in when the approval gate clears."
            },
            "referencePhotoR2Key": {
              "type": "string",
              "description": "Short-lived R2 key (<15min TTL) of the reference photo. The pipeline reads once, extracts face template in murakumo on-prem, then schedules R2 object deletion."
            },
            "legalBasis": {
              "type": "ref",
              "ref": "#legalBasis"
            },
            "caseNo": {
              "type": "string",
              "description": "Police case number."
            },
            "cameraIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "timeRange": {
              "type": "ref",
              "ref": "#timeRange"
            },
            "topK": {
              "type": "integer",
              "description": "Default 50. Clamped to 200."
            },
            "minFaceScorePermille": {
              "type": "integer",
              "description": "Min face cosine × 1000."
            },
            "useReidFusion": {
              "type": "boolean",
              "description": "Augment with body-ReID embedding. Default true."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "queryId": {
              "type": "string"
            },
            "approvalId": {
              "type": "string",
              "description": "Consent helper request id; result is pending until supervisor approves."
            },
            "status": {
              "type": "string",
              "knownValues": [
                "pendingApproval",
                "denied",
                "completed",
                "error"
              ]
            },
            "results": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#personHit"
              },
              "description": "Empty until status=completed AND reviewMatches stage is recorded."
            },
            "pegelTick": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    },
    "legalBasis": {
      "type": "object",
      "description": "At least one of warrantRef or enquiryRef must be present and non-empty.",
      "properties": {
        "warrantRef": {
          "type": "string",
          "description": "捜索差押許可状 / その他令状 reference"
        },
        "enquiryRef": {
          "type": "string",
          "description": "捜査関係事項照会書 番号"
        },
        "issuedAt": {
          "type": "string"
        },
        "issuingAuthority": {
          "type": "string",
          "description": "発令裁判所 or 発出長"
        },
        "scope": {
          "type": "string",
          "description": "対象事件・対象期間"
        }
      }
    },
    "timeRange": {
      "type": "object",
      "properties": {
        "fromTs": {
          "type": "string"
        },
        "toTs": {
          "type": "string"
        }
      }
    },
    "personHit": {
      "type": "object",
      "properties": {
        "clipId": {
          "type": "string"
        },
        "cameraId": {
          "type": "string"
        },
        "tsOffsetMs": {
          "type": "integer"
        },
        "faceScorePermille": {
          "type": "integer"
        },
        "reidScorePermille": {
          "type": "integer"
        },
        "fusedScorePermille": {
          "type": "integer"
        },
        "thumbnailR2Key": {
          "type": "string",
          "description": "Face is blurred by default; un-blur is granted only after reviewMatches records human assessment."
        }
      }
    }
  }
}
