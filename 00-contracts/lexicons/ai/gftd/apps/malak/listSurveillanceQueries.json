{
  "lexicon": 1,
  "id": "ai.gftd.apps.malak.listSurveillanceQueries",
  "defs": {
    "main": {
      "type": "query",
      "description": "List queries executed by the requesting agency, with RBAC scoping. Operators see their own queries; supervisors see all queries in their section; auditors see jurisdictional aggregates without PII.",
      "parameters": {
        "type": "params",
        "properties": {
          "requesterDid": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "knownValues": [
              "self",
              "section",
              "agency",
              "audit"
            ]
          },
          "queryKind": {
            "type": "string",
            "knownValues": [
              "scene",
              "person",
              "all"
            ]
          },
          "fromTs": {
            "type": "string"
          },
          "toTs": {
            "type": "string"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "queries": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#querySummary"
              }
            },
            "cursor": {
              "type": "string"
            },
            "offset": {
              "type": "integer"
            },
            "limit": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    },
    "querySummary": {
      "type": "object",
      "properties": {
        "queryId": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "knownValues": [
            "scene",
            "person"
          ]
        },
        "startedAt": {
          "type": "string"
        },
        "completedAt": {
          "type": "string"
        },
        "approverDid": {
          "type": "string"
        },
        "resultCount": {
          "type": "integer"
        },
        "reviewed": {
          "type": "boolean"
        }
      }
    }
  }
}
