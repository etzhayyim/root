{
  "lexicon": 1,
  "id": "ai.gftd.apps.malak.unsubscribeAgencyOutreach",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Honour an opt-out request. Per 特電法 §3 the response is mandatory and timely. Sets vertex_malak_surveillance_outreach.lead_status = unsubscribed AND vertex_malak_surveillance_send.unsubscribed_at AND deletes the prospect's addressee ciphertext + wrapped key (hard delete, no soft-delete per CLAUDE.md root rule).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "token"
          ],
          "properties": {
            "token": {
              "type": "string",
              "description": "Single-use opt-out token embedded in the email's unsubscribeUrl."
            },
            "reason": {
              "type": "string",
              "description": "Optional self-reported reason; not stored if it contains PII."
            },
            "userAgent": {
              "type": "string"
            },
            "ip": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "knownValues": [
                "unsubscribed",
                "tokenInvalid",
                "tokenExpired",
                "alreadyUnsubscribed"
              ]
            },
            "unsubscribedAt": {
              "type": "string"
            },
            "pegelTick": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
