{
  "lexicon": 1,
  "id": "ai.gftd.apps.malak.registerAgencyProspect",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register an outbound sales prospect. Opt-in source is mandatory and must be one of the four allowed values (展示会名簿 / 講演主催者経由 / 紹介 / inbound 問合せ). Outside this whitelist, drafting is hard-blocked at the SAFETY_GATES layer (COMPLIANCE-MEMO §6).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "prefecture",
            "addresseeRole",
            "addresseeCipher",
            "optInSource",
            "optInAt"
          ],
          "properties": {
            "prefecture": {
              "type": "string",
              "description": "都道府県 code, e.g. JP-14 or 'NPA' for 警察庁 or 'JC3'."
            },
            "addresseeRole": {
              "type": "string",
              "description": "Role code from LEAD-PIPELINE-SEED §2, e.g. pref.seian.cyber."
            },
            "addresseeCipher": {
              "type": "string",
              "description": "AES-256-GCM ciphertext of the addressee name (vault wrapped key). Plaintext never enters the Worker."
            },
            "wrappedKey": {
              "type": "string"
            },
            "kid": {
              "type": "string",
              "description": "Vault key id used to wrap."
            },
            "optInSource": {
              "type": "string",
              "knownValues": [
                "exhibition_list",
                "lecture_host",
                "referral",
                "inbound"
              ]
            },
            "optInAt": {
              "type": "string",
              "description": "ISO-8601 UTC when opt-in was obtained."
            },
            "optInEvidence": {
              "type": "string",
              "description": "Reference to opt-in proof (event id, referrer DID, inbound form submission id)."
            },
            "useCasePitch": {
              "type": "string",
              "knownValues": [
                "fraud",
                "missingPerson",
                "streetCrime"
              ],
              "description": "Pitch angle to use when drafting."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "prospectId": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "knownValues": [
                "registered",
                "rejectedOptInMissing",
                "rejectedOptInSource"
              ]
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
