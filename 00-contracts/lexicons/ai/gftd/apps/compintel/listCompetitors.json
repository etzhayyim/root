{
  "lexicon": 1,
  "id": "ai.gftd.apps.compintel.listCompetitors",
  "defs": {
    "main": {
      "type": "query",
      "description": "List tracked competitors with optional industry filter.",
      "parameters": {
        "type": "params",
        "properties": {
          "industry": { "type": "string" },
          "minThreatScore": { "type": "number" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 },
          "offset": { "type": "integer", "minimum": 0, "default": 0 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["competitors", "total", "offset", "limit"],
          "properties": {
            "competitors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "competitorId": { "type": "string" },
                  "competitorName": { "type": "string" },
                  "industry": { "type": "string" },
                  "threatScore": { "type": "number" },
                  "lastRefreshedAt": { "type": "string" }
                }
              }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
