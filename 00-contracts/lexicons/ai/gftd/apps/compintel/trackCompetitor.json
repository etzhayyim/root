{
  "lexicon": 1,
  "id": "ai.gftd.apps.compintel.trackCompetitor",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Add a competitor to the tracking list. Triggers initial LangGraph research loop via POD-side LangServer.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["competitorName", "website"],
          "properties": {
            "competitorName": { "type": "string", "maxLength": 200 },
            "website": { "type": "string", "maxLength": 500 },
            "industry": { "type": "string", "maxLength": 100 },
            "trackingDimensions": {
              "type": "array",
              "items": { "type": "string" },
              "description": "pricing|product|hiring|funding|press",
              "default": ["pricing", "product", "hiring"]
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["competitorId", "status"],
          "properties": {
            "competitorId": { "type": "string" },
            "status": { "type": "string" }
          }
        }
      }
    }
  }
}
