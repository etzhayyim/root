{
  "lexicon": 1,
  "id": "ai.gftd.apps.compintel.getSnapshot",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get latest intelligence snapshot for a competitor.",
      "parameters": {
        "type": "params",
        "required": ["competitorId"],
        "properties": {
          "competitorId": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["competitorId", "competitorName"],
          "properties": {
            "competitorId": { "type": "string" },
            "competitorName": { "type": "string" },
            "website": { "type": "string" },
            "industry": { "type": "string" },
            "latestSummary": { "type": "string" },
            "pricingSignals": { "type": "string" },
            "productSignals": { "type": "string" },
            "hiringSignals": { "type": "string" },
            "fundingSignals": { "type": "string" },
            "threatScore": { "type": "number" },
            "lastRefreshedAt": { "type": "string" },
            "createdAt": { "type": "string" }
          }
        }
      }
    }
  }
}
