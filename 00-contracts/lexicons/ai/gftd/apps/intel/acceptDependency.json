{
  "lexicon": 1,
  "id": "ai.gftd.apps.intel.acceptDependency",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Promote a reviewed dependency candidate to an active graph edge.",
      "x-permissionSet": "intel:review",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "edgeId": { "type": "string" },
            "reviewerDid": { "type": "string" },
            "note": { "type": "string" }
          },
          "required": ["edgeId"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "edgeId": { "type": "string" },
            "status": { "type": "string" }
          },
          "required": ["edgeId", "status"]
        }
      }
    }
  }
}
