{
  "lexicon": 1,
  "id": "ai.gftd.apps.intel.inferCoverage",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "subjectName": { "type": "string" },
            "sourceText": { "type": "string" },
            "sourceUrl": { "type": "string", "format": "uri" },
            "industry": { "type": "string" }
          },
          "required": ["subjectName", "sourceText"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "chainId": { "type": "string" },
            "cohortsGenerated": { "type": "integer" },
            "industry": { "type": "string" }
          },
          "required": ["chainId", "cohortsGenerated"]
        }
      }
    }
  }
}
