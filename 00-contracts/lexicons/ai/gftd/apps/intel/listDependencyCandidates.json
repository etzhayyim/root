{
  "lexicon": 1,
  "id": "ai.gftd.apps.intel.listDependencyCandidates",
  "defs": {
    "main": {
      "type": "query",
      "description": "List inferred dependency candidates awaiting review or recently materialized by the intel graph worker.",
      "x-permissionSet": "intel:read",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["candidate", "active", "rejected", "superseded"],
              "default": "candidate"
            },
            "predicate": { "type": "string" },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "items": { "type": "array", "items": { "type": "object" } },
            "limit": { "type": "integer" },
            "offset": { "type": "integer" }
          },
          "required": ["items", "limit", "offset"]
        }
      }
    }
  }
}
