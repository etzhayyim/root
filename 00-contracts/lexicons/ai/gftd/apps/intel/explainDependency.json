{
  "lexicon": 1,
  "id": "ai.gftd.apps.intel.explainDependency",
  "defs": {
    "main": {
      "type": "query",
      "description": "Explain a dependency edge with evidence, confidence, sources, and validation state.",
      "x-permissionSet": "intel:read",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "edgeId": { "type": "string" },
            "fromVertexId": { "type": "string" },
            "toVertexId": { "type": "string" },
            "predicate": { "type": "string" }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "edgeId": { "type": "string" },
            "status": { "type": "string" },
            "confidence": { "type": "number" },
            "evidence": { "type": "array", "items": { "type": "object" } },
            "explanation": { "type": "string" }
          },
          "required": []
        }
      }
    }
  }
}
