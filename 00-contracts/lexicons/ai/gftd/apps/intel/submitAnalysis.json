      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "sourceText": { "type": "string" },
            "sourceFamily": { "type": "string" },
            "collectionMethod": { "type": "string" },
            "analyticLens": { "type": "string" }
          },
          "required": ["title", "sourceText"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "status": { "type": "string" },
            "classification": { "type": "string" },
            "entityCount": { "type": "integer" }
          },
          "required": ["id", "status"]
        }
      }
    }
  }
}
