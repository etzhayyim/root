{
  "lexicon": 1,
  "id": "ai.gftd.apps.intel.report",
  "defs": {
    "main": {
      "type": "record",
      "record": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "classification": { "type": "string" },
          "sourceFamily": { "type": "string" },
          "collectionMethod": { "type": "string" },
          "analyticLens": { "type": "string" },
          "entities": { "type": "array", "items": { "type": "object" } },
          "facts": { "type": "array", "items": { "type": "string" } },
          "findings": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string" },
          "orgId": { "type": "string" },
          "userId": { "type": "string" },
          "actorId": { "type": "string" },
          "createdAt": { "type": "string", "format": "datetime" }
        },
        "required": ["title", "classification", "status"]
      }
    }
  }
}
