{
  "lexicon": 1,
  "id": "ai.gftd.apps.intel.inferDependencies",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Infer graph dependencies across spatial assets, owners, LEI entities, listed companies, contracts, invoices, suppliers, and risk evidence. Long-running execution is routed to BPMN/LangServer.",
      "x-permissionSet": "intel:write",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "object",
              "description": "Optional graph scope. Examples: {buildingVertexId}, {legalEntityVertexId}, {lei}, {bbox}, {ownerDid}."
            },
            "triggerKind": {
              "type": "string",
              "enum": ["manual", "graph_delta", "scheduled", "mcp_call"],
              "default": "manual"
            },
            "maxCandidates": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000,
              "default": 500
            },
            "dryRun": {
              "type": "boolean",
              "default": false
            }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "runId": { "type": "string" },
            "candidateCount": { "type": "integer" },
            "activeCount": { "type": "integer" },
            "reviewCount": { "type": "integer" },
            "dryRun": { "type": "boolean" }
          },
          "required": ["runId"]
        }
      }
    }
  }
}
