{
  "lexicon": 1,
  "id": "ai.gftd.apps.intel.resolveEntity",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Resolve an ambiguous organization, building, owner, supplier, or registry identifier into canonical graph vertices using deterministic keys, OWL/SHACL constraints, and LangGraph candidate scoring.",
      "x-permissionSet": "intel:write",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "query": { "type": "string" },
            "entityKind": {
              "type": "string",
              "enum": ["building", "parcel", "legal_entity", "listed_company", "supplier", "contract", "unknown"],
              "default": "unknown"
            },
            "hints": { "type": "object" },
            "maxCandidates": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          },
          "required": ["query"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "runId": { "type": "string" },
            "candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "vertexId": { "type": "string" },
                  "entityKind": { "type": "string" },
                  "score": { "type": "number" },
                  "reason": { "type": "string" }
                },
                "required": ["vertexId", "score"]
              }
            }
          },
          "required": ["runId", "candidates"]
        }
      }
    }
  }
}
