{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaikei.account",
  "defs": {
    "main": {
      "type": "record",
      "description": "Chart-of-accounts master. One per accountCode per owner_did (firm DID). accountType drives sign convention in journal entries and P/L vs B/S rollup.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["ownerDid", "accountCode", "accountName", "accountType", "createdAt"],
        "properties": {
          "ownerDid":         { "type": "string", "format": "did" },
          "accountCode":      { "type": "string", "description": "Firm-local code, e.g. '1110', '4000'" },
          "accountName":      { "type": "string" },
          "accountType":      { "type": "string", "enum": ["asset","liability","equity","revenue","expense"] },
          "parentAccountDid": { "type": "string", "format": "did" },
          "taxCode":          { "type": "string", "description": "e.g. 'taxable10','taxable8','nonTaxable','exempt'" },
          "isArchived":       { "type": "boolean", "default": false },
          "createdAt":        { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
