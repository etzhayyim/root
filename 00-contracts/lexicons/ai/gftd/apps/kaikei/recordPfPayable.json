{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaikei.recordPfPayable",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0052/ADR-0054 EPFO/ESIC propagation. Posts a summary journal entry for India PF/ESI contribution payable. Phase 1 = one summary line; Phase 2 = full split (per-account).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "employerOrgId": { "type": "string", "description": "Employer org_id; used as owner_did via OWNER_MAP." },
            "establishmentPfCode": { "type": "string" },
            "wageMonth": { "type": "string", "description": "YYYY-MM" },
            "totalEmployerPfInrPaise": { "type": "integer" },
            "totalEmployeePfInrPaise": { "type": "integer" },
            "totalAdminInrPaise": { "type": "integer" },
            "triggerVertexId": { "type": "string" },
            "triggerSource": { "type": "string", "description": "e.g. ai.gftd.apps.epfo.finalize" },
            "trrn": { "type": "string" }
          },
          "required": ["employerOrgId", "wageMonth"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "totalAmountInrPaise": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
