{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaikei.recordAdvanceTax",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0055 ITR-1 propagation. Posts a summary journal entry for India advance tax / self-assessment tax payment. Optional — taxpayers without business books can skip.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "taxpayerPanHash": { "type": "string" },
            "assessmentYear": { "type": "string" },
            "totalTaxPaidInrPaise": { "type": "integer" },
            "tdsClaimedInrPaise": { "type": "integer" },
            "advanceTaxPaidInrPaise": { "type": "integer" },
            "selfAssessmentTaxInrPaise": { "type": "integer" },
            "ackNumber": { "type": "string" },
            "triggerVertexId": { "type": "string" },
            "triggerSource": { "type": "string" }
          },
          "required": ["taxpayerPanHash", "assessmentYear"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "totalAmountInrPaise": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
