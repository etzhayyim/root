{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaikei.listJournalEntries",
  "defs": {
    "main": {
      "type": "query",
      "description": "Paginated journal entry listing with filters. Driven by idx_kaikei_je_period (ownerDid, periodYm, postedAt) for efficient period-scoped reads.",
      "parameters": {
        "type": "params",
        "properties": {
          "periodYm":        { "type": "string" },
          "accountDid":      { "type": "string", "format": "did", "description": "Matches either debit or credit side" },
          "sourceType":      { "type": "string", "enum": ["manual","invoice","expense","payroll","bank","contract","reverse","depreciation"] },
          "includeReversed": { "type": "boolean", "default": true },
          "limit":           { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 },
          "cursor":          { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["entries"],
          "properties": {
            "entries": { "type": "array", "items": { "type": "object" } },
            "cursor":  { "type": "string" }
          }
        }
      }
    }
  }
}
