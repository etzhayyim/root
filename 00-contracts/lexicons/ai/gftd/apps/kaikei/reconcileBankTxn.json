{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaikei.reconcileBankTxn",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Mark a bankTransaction as reconciled against a specific journalEntry. Server updates matchedJeDid and reconcileStatus='matched'. Can also be invoked with reconcileStatus='ignored' to drop noise rows from the review queue.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["bankTransactionDid", "action"],
          "properties": {
            "bankTransactionDid": { "type": "string", "format": "did" },
            "action":             { "type": "string", "enum": ["match","ignore","manualReview"] },
            "journalEntryDid":    { "type": "string", "format": "did", "description": "Required when action='match'" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["reconcileStatus"],
          "properties": {
            "reconcileStatus": { "type": "string", "enum": ["matched","ignored","manualReview"] }
          }
        }
      }
    }
  }
}
