{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaikei.payApBill",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record payment of an approved apBill. Server updates status='paid', paidAt, paymentRef. Derive rule emits settlement journalEntry (debit=accounts payable, credit=cash/bank).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["apBillDid", "paidAt", "cashAccountDid"],
          "properties": {
            "apBillDid":       { "type": "string", "format": "did" },
            "paidAt":          { "type": "string", "format": "datetime" },
            "paymentRef":      { "type": "string", "description": "Bank remittance ID or check number" },
            "cashAccountDid":  { "type": "string", "format": "did" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["apBillDid", "status", "journalEntryDid"],
          "properties": {
            "apBillDid":        { "type": "string", "format": "did" },
            "status":           { "type": "string", "enum": ["paid"] },
            "journalEntryDid":  { "type": "string", "format": "did" }
          }
        }
      },
      "errors": [
        { "name": "InvalidTransition", "description": "apBill is not in 'approved' state" }
      ]
    }
  }
}
