{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaikei.listAccounts",
  "defs": {
    "main": {
      "type": "query",
      "description": "List chart-of-accounts for the caller's firm. Filters by accountType, parent hierarchy, and archived flag.",
      "parameters": {
        "type": "params",
        "properties": {
          "accountType":      { "type": "string", "enum": ["asset","liability","equity","revenue","expense"] },
          "parentAccountDid": { "type": "string", "format": "did" },
          "includeArchived":  { "type": "boolean", "default": false },
          "limit":            { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 },
          "cursor":           { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["accounts"],
          "properties": {
            "accounts": { "type": "array", "items": { "type": "object" } },
            "cursor":   { "type": "string" }
          }
        }
      }
    }
  }
}
