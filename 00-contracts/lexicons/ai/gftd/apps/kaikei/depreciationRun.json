{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaikei.depreciationRun",
  "defs": {
    "main": {
      "type": "record",
      "description": "Monthly depreciation execution log. Written once per periodYm when runDepreciation is invoked. Each run derives journalEntry records (sourceType='depreciation') via magatama.jsonld derive rule and edge_asset_to_depreciation rows.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["ownerDid", "periodYm", "executedAt", "assetCount", "totalAmount", "currency", "createdAt"],
        "properties": {
          "ownerDid":    { "type": "string", "format": "did" },
          "periodYm":    { "type": "string" },
          "executedAt":  { "type": "string", "format": "datetime" },
          "assetCount":  { "type": "integer" },
          "totalAmount": { "type": "number" },
          "currency":    { "type": "string", "default": "JPY" },
          "createdAt":   { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
