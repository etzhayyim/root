{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaikei.createJournalEntry",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Post a single-transaction journal entry. Server (1) checks periodClose for (ownerDid, periodYm) → reject if closed, (2) validates both accounts exist and share ownerDid, (3) writes the record. Derive sources fill sourceType/sourceDid; manual calls set sourceType='manual'.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["periodYm", "postedAt", "debitAccountDid", "creditAccountDid", "amount"],
          "properties": {
            "periodYm":         { "type": "string" },
            "postedAt":         { "type": "string", "format": "datetime" },
            "debitAccountDid":  { "type": "string", "format": "did" },
            "creditAccountDid": { "type": "string", "format": "did" },
            "amount":           { "type": "number" },
            "currency":         { "type": "string", "default": "JPY" },
            "taxCode":          { "type": "string" },
            "memo":             { "type": "string" },
            "sourceType":       { "type": "string", "enum": ["manual","invoice","expense","payroll","bank","contract","reverse","depreciation"], "default": "manual" },
            "sourceDid":        { "type": "string", "format": "did" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["journalEntryDid", "uri"],
          "properties": {
            "journalEntryDid": { "type": "string", "format": "did" },
            "uri":             { "type": "string", "format": "at-uri" }
          }
        }
      },
      "errors": [
        { "name": "PeriodClosed",   "description": "periodClose record exists; reopen or use a later period" },
        { "name": "AccountNotFound","description": "debit or credit account does not exist" },
        { "name": "TenantMismatch", "description": "debit and credit accounts do not share ownerDid with caller" }
      ]
    }
  }
}
