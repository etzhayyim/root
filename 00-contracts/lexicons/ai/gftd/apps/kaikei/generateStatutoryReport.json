{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaikei.generateStatutoryReport",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create a statutory report ledger row for P/L, B/S, cashflow, invoice-tax, or fixed-asset reports.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["reportType", "periodFrom", "periodTo"],
          "properties": {
            "owner": { "type": "string" },
            "reportType": { "type": "string", "enum": ["pl", "bs", "cashflow", "invoiceTax", "fixedAsset", "yearEnd"] },
            "periodFrom": { "type": "string", "format": "datetime" },
            "periodTo": { "type": "string", "format": "datetime" },
            "artifactCid": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "reportDid", "status"],
          "properties": {
            "ok": { "type": "boolean" },
            "reportDid": { "type": "string" },
            "status": { "type": "string" }
          }
        }
      }
    }
  }
}
