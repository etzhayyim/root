{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaikei.journalEntry",
  "defs": {
    "main": {
      "type": "record",
      "description": "Single-transaction journal entry (仕訳). Append-only: corrections must use reverseJournalEntry to post an offsetting entry; reversedByDid points to the reversing entry. sourceType identifies upstream emitter for derive lineage.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["ownerDid", "periodYm", "postedAt", "debitAccountDid", "creditAccountDid", "amount", "currency", "sourceType", "createdAt"],
        "properties": {
          "ownerDid":         { "type": "string", "format": "did" },
          "periodYm":         { "type": "string", "description": "YYYY-MM. Rejected if period is closed (see periodClose record)" },
          "postedAt":         { "type": "string", "format": "datetime" },
          "debitAccountDid":  { "type": "string", "format": "did" },
          "creditAccountDid": { "type": "string", "format": "did" },
          "amount":           { "type": "number" },
          "currency":         { "type": "string", "default": "JPY" },
          "taxCode":          { "type": "string" },
          "memo":             { "type": "string" },
          "sourceType":       { "type": "string", "enum": ["manual","invoice","expense","payroll","bank","contract","reverse","depreciation"] },
          "sourceDid":        { "type": "string", "format": "did" },
          "reversedByDid":    { "type": "string", "format": "did", "description": "Set on the original JE when a reverse is posted. Points to the reversing JE." },
          "createdAt":        { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
