{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaikei.approveApBill",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Transition an apBill from status='pending' to 'approved'. Derive rule on approval emits journalEntry (debit=expense account, credit=accounts payable).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["apBillDid", "expenseAccountDid", "payableAccountDid"],
          "properties": {
            "apBillDid":          { "type": "string", "format": "did" },
            "expenseAccountDid":  { "type": "string", "format": "did" },
            "payableAccountDid":  { "type": "string", "format": "did" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["apBillDid", "status", "journalEntryDid"],
          "properties": {
            "apBillDid":        { "type": "string", "format": "did" },
            "status":           { "type": "string", "enum": ["approved"] },
            "journalEntryDid":  { "type": "string", "format": "did" }
          }
        }
      },
      "errors": [
        { "name": "InvalidTransition", "description": "apBill is not in 'pending' state" },
        { "name": "Forbidden",         "description": "caller lacks approval role" }
      ]
    }
  }
}
