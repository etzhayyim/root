{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaikei.reverseJournalEntry",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Post an offsetting (reversing) journal entry. Server writes a new journalEntry with debit/credit swapped and sourceType='reverse', then updates the original JE's reversedByDid pointer. Original entry is never mutated.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["originalJournalEntryDid", "reason"],
          "properties": {
            "originalJournalEntryDid": { "type": "string", "format": "did" },
            "reason":                  { "type": "string" },
            "postedAt":                { "type": "string", "format": "datetime", "description": "Defaults to now()" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["reversingJournalEntryDid", "uri"],
          "properties": {
            "reversingJournalEntryDid": { "type": "string", "format": "did" },
            "uri":                      { "type": "string", "format": "at-uri" }
          }
        }
      },
      "errors": [
        { "name": "OriginalNotFound",  "description": "originalJournalEntryDid not found or not owned by caller" },
        { "name": "AlreadyReversed",   "description": "original entry already has reversedByDid set" },
        { "name": "PeriodClosed",      "description": "target posting period is closed" }
      ]
    }
  }
}
