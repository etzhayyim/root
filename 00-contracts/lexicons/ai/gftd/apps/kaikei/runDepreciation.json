{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaikei.runDepreciation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Execute monthly depreciation for all active fixedAsset rows. Server iterates, computes period amount per asset, writes a depreciationRun record, and derive-emits journalEntry rows (sourceType='depreciation') + edge_asset_to_depreciation edges. Idempotent per (ownerDid, periodYm).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["periodYm"],
          "properties": {
            "periodYm":      { "type": "string" },
            "expenseAccountDid": { "type": "string", "format": "did", "description": "Default: firm-configured depreciation expense account" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["depreciationRunDid", "assetCount", "totalAmount"],
          "properties": {
            "depreciationRunDid": { "type": "string", "format": "did" },
            "assetCount":         { "type": "integer" },
            "totalAmount":        { "type": "number" }
          }
        }
      },
      "errors": [
        { "name": "AlreadyRun",    "description": "depreciationRun already exists for this period" },
        { "name": "PeriodClosed",  "description": "target period is closed" }
      ]
    }
  }
}
