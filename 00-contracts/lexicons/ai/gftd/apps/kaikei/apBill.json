{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaikei.apBill",
  "defs": {
    "main": {
      "type": "record",
      "description": "Accounts-payable (AP) bill from a vendor. Status lifecycle: pending → approved → paid (or void). paymentRef stores bank remittance ID. Posting to GL is derived: on approved → accrue AP, on paid → settle AP from cash.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["ownerDid", "vendorDid", "billNumber", "issuedAt", "dueAt", "amount", "status", "createdAt"],
        "properties": {
          "ownerDid":    { "type": "string", "format": "did" },
          "vendorDid":   { "type": "string", "format": "did" },
          "billNumber":  { "type": "string" },
          "issuedAt":    { "type": "string", "format": "datetime" },
          "dueAt":       { "type": "string", "format": "datetime" },
          "amount":      { "type": "number" },
          "taxAmount":   { "type": "number" },
          "status":      { "type": "string", "enum": ["pending","approved","paid","void"] },
          "approvedAt":  { "type": "string", "format": "datetime" },
          "paidAt":      { "type": "string", "format": "datetime" },
          "paymentRef":  { "type": "string" },
          "createdAt":   { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
