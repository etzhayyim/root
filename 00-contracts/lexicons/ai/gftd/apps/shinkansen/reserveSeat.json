{
  "lexicon": 1,
  "id": "ai.gftd.apps.shinkansen.reserveSeat",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "新幹線座席予約 (3 sources unified). Reservation PII (name/payment/seat) stored as Tier 3 Preferences only — never AT Repo.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["userDid", "trainNumber", "departureDate", "fromStation", "toStation"],
          "properties": {
            "userDid": { "type": "string", "format": "did" },
            "trainNumber": { "type": "string" },
            "departureDate": { "type": "string", "format": "date" },
            "fromStation": { "type": "string" },
            "toStation": { "type": "string" },
            "seatClass": { "type": "string", "enum": ["ordinary", "green", "gran-class", "ordinary-non-reserved"] },
            "seatNumber": { "type": "string", "description": "preferred seat (e.g. 5-A); auto-assigned if omitted" },
            "passengerCount": { "type": "integer", "minimum": 1, "default": 1 },
            "source": { "type": "string", "enum": ["smart-ex", "ex-yoyaku", "ekinet"] },
            "paymentMethod": { "type": "string", "description": "stored as Tier 3 Preferences only" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["reservationId", "status"],
          "properties": {
            "reservationId": { "type": "string" },
            "status": { "type": "string", "enum": ["confirmed", "waitlist", "rejected"] },
            "fareYen": { "type": "integer" },
            "seatNumber": { "type": "string" },
            "publicReceiptUri": { "type": "string", "format": "at-uri", "description": "anonymized fare comparison record (Tier 1)" }
          }
        }
      }
    }
  }
}
