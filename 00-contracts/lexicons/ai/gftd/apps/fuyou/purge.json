{
  "lexicon": 1,
  "id": "ai.gftd.apps.fuyou.purge",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0051. System cron entry point. Hard-deletes Tier 3 PII rows whose retention_until < now() (7 years per 所得税基本通達 196-1). Tier 1 metadata is kept with status=purged for audit chain integrity.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "asOf": { "type": "string", "description": "Override 'now' (ISO 8601). Test/dry-run only." },
            "dryRun": { "type": "boolean", "default": false }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "purgedCount": { "type": "integer" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          },
          "required": []
        }
      }
    }
  }
}
