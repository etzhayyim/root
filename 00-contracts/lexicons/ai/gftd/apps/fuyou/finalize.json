{
  "lexicon": 1,
  "id": "ai.gftd.apps.fuyou.finalize",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0051. Commit an approved declaration and propagate to kaikei recomputeWithholding. Normally invoked automatically by the BPMN process; exposed separately for manual re-finalize.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "vertexId": { "type": "string" },
            "effectiveFromMonth": { "type": "string", "description": "YYYY-MM. Defaults to current month." }
          },
          "required": ["vertexId"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "deductionUnits": { "type": "number", "description": "Weighted dependent-unit equivalent used by kaikei." },
            "propagatedToKaikei": { "type": "boolean" },
            "error": { "type": "string" }
          },
          "required": []
        }
      }
    }
  }
}
