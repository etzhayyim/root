{
  "lexicon": 1,
  "id": "ai.gftd.apps.fuyou.amendDeclaration",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0051. File an amendment (異動申告) against an approved declaration. Starts BPMN process fuyou_amend.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "employeeDid": { "type": "string" },
            "employerOrgId": { "type": "string" },
            "taxYear": { "type": "integer" },
            "amendmentDate": { "type": "string", "description": "ISO 8601 date when the change took effect." },
            "amendmentReason": {
              "type": "string",
              "enum": ["marriage", "divorce", "birth", "death", "incomeChange", "statusChange"]
            },
            "amendmentDescription": { "type": "string" },
            "amendmentPayload": { "type": "string", "description": "signal:v1: encrypted JSON of the changed sub-fields (only deltas)." }
          },
          "required": ["employerOrgId", "taxYear", "amendmentDate", "amendmentReason"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "approvalRequired": { "type": "boolean" },
            "effectiveFromMonth": { "type": "string" },
            "error": { "type": "string" }
          },
          "required": []
        }
      }
    }
  }
}
