{
  "lexicon": 1,
  "id": "ai.gftd.apps.fuyou.review",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0051. HR-officer verdict on a declaration or amendment. Completes the corresponding BPMN UserTask.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "vertexId": { "type": "string" },
            "verdict": { "type": "string", "enum": ["approve", "reject"] },
            "comment": { "type": "string", "description": "HR comment, surfaced to employee on reject." }
          },
          "required": ["vertexId", "verdict"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "newStatus": { "type": "string", "description": "approved|rejected|amended" },
            "error": { "type": "string" }
          },
          "required": []
        }
      }
    }
  }
}
