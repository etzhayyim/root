{
  "lexicon": 1,
  "id": "ai.gftd.apps.seikyu.sendInvoice",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Flip invoice status from 'draft' to 'sent' and dispatch PDF. pdfCid is generated server-side (vault-encrypted). Optional deliveryChannel controls email/peppol/both.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["invoiceDid"],
          "properties": {
            "invoiceDid":      { "type": "string", "format": "did" },
            "deliveryChannel": { "type": "string", "enum": ["email","peppol","both","manual"], "default": "email" },
            "recipientEmail":  { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["invoiceDid", "status", "pdfCid", "sentAt"],
          "properties": {
            "invoiceDid":       { "type": "string", "format": "did" },
            "status":           { "type": "string", "enum": ["sent"] },
            "pdfCid":           { "type": "string" },
            "sentAt":           { "type": "string", "format": "datetime" },
            "peppolMessageId":  { "type": "string" }
          }
        }
      }
    }
  }
}
