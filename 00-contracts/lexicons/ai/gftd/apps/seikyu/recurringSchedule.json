{
  "lexicon": 1,
  "id": "ai.gftd.apps.seikyu.recurringSchedule",
  "defs": {
    "main": {
      "type": "record",
      "description": "Recurring invoice schedule derived from a signed keiyaku.agreement. Scheduler emits invoice records on each occurrence. frequency = monthly | quarterly | yearly.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["ownerDid", "agreementDid", "customerDid", "amount", "currency", "frequency", "nextIssueAt", "status", "createdAt"],
        "properties": {
          "ownerDid":     { "type": "string", "format": "did" },
          "agreementDid": { "type": "string", "format": "did" },
          "customerDid":  { "type": "string", "format": "did" },
          "amount":       { "type": "number" },
          "currency":     { "type": "string" },
          "frequency":    { "type": "string", "enum": ["monthly","quarterly","yearly"] },
          "nextIssueAt":  { "type": "string", "format": "datetime" },
          "lastIssuedAt": { "type": "string", "format": "datetime" },
          "status":       { "type": "string", "enum": ["active","paused","ended"] },
          "createdAt":    { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
