{
  "lexicon": 1,
  "id": "ai.gftd.apps.seikyu.listInvoices",
  "defs": {
    "main": {
      "type": "query",
      "description": "Paginated invoice list. Uses idx_seikyu_invoice_due (ownerDid, status, due_at) or idx_seikyu_invoice_cust (customerDid, issued_at DESC) depending on filters.",
      "parameters": {
        "type": "params",
        "properties": {
          "customerDid": { "type": "string", "format": "did" },
          "projectDid":  { "type": "string", "format": "did" },
          "status":      { "type": "string", "enum": ["draft","sent","partiallyPaid","paid","overdue","void"] },
          "issuedFrom":  { "type": "string", "format": "datetime" },
          "issuedTo":    { "type": "string", "format": "datetime" },
          "limit":       { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 },
          "cursor":      { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["invoices"],
          "properties": {
            "invoices": { "type": "array", "items": { "type": "object" } },
            "cursor":   { "type": "string" }
          }
        }
      }
    }
  }
}
