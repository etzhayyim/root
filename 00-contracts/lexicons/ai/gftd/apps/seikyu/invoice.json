{
  "lexicon": 1,
  "id": "ai.gftd.apps.seikyu.invoice",
  "defs": {
    "main": {
      "type": "record",
      "description": "Outbound invoice. lineItems kind enum supports time-entry billing (from kousuu), flat fees, expenses, and adjustments. Status lifecycle: draft → sent → (partiallyPaid) → paid | overdue | void. Qualified-invoice (インボイス) fields (taxRate, taxAmount, issuer taxId from customer.ownerDid firm) enable 電帳法/Peppol compliance.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["ownerDid", "customerDid", "invoiceNumber", "issuedAt", "dueAt", "lineItems", "subtotal", "taxRate", "taxAmount", "total", "currency", "status", "createdAt"],
        "properties": {
          "ownerDid":     { "type": "string", "format": "did" },
          "customerDid":  { "type": "string", "format": "did" },
          "projectDid":   { "type": "string", "format": "did", "description": "Optional link to kousuu.project" },
          "agreementDid": { "type": "string", "format": "did", "description": "Optional link to keiyaku.agreement for recurring billing" },
          "invoiceNumber":{ "type": "string" },
          "period": {
            "type": "object",
            "properties": {
              "from": { "type": "string", "format": "datetime" },
              "to":   { "type": "string", "format": "datetime" }
            }
          },
          "lineItems": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["description", "amount"],
              "properties": {
                "kind":         { "type": "string", "enum": ["time","flatFee","expense","adjustment"] },
                "timeEntryRef": { "type": "string", "format": "at-uri" },
                "description":  { "type": "string" },
                "quantity":     { "type": "number" },
                "unitRate":     { "type": "number" },
                "amount":       { "type": "number" }
              }
            }
          },
          "subtotal":        { "type": "number" },
          "taxRate":         { "type": "number", "description": "Decimal; 0.10 = 10%" },
          "taxAmount":       { "type": "number" },
          "discountAmount":  { "type": "number" },
          "total":           { "type": "number" },
          "currency":        { "type": "string" },
          "pdfCid":          { "type": "string", "description": "SHA-256 of vault-encrypted invoice PDF" },
          "peppolMessageId": { "type": "string" },
          "issuedAt":        { "type": "string", "format": "datetime" },
          "dueAt":           { "type": "string", "format": "datetime" },
          "sentAt":          { "type": "string", "format": "datetime" },
          "paidAt":          { "type": "string", "format": "datetime" },
          "status":          { "type": "string", "enum": ["draft","sent","partiallyPaid","paid","overdue","void"] },
          "createdAt":       { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
