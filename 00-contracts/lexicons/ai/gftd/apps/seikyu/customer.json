{
  "lexicon": 1,
  "id": "ai.gftd.apps.seikyu.customer",
  "defs": {
    "main": {
      "type": "record",
      "description": "Customer (得意先) master for AR billing. taxId is the 13-digit qualified-invoice registration number (T+13桁, インボイス制度). billingAddress is plaintext for federation; PII beyond this is kept server-side only.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["ownerDid", "customerName", "paymentTermsDays", "defaultCurrency", "createdAt"],
        "properties": {
          "ownerDid":         { "type": "string", "format": "did" },
          "customerName":     { "type": "string" },
          "taxId":            { "type": "string", "description": "Qualified-invoice registration number, e.g. 'T1234567890123'" },
          "billingAddress":   { "type": "string" },
          "paymentTermsDays": { "type": "integer", "default": 30 },
          "defaultCurrency":  { "type": "string", "default": "JPY" },
          "createdAt":        { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
