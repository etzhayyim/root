{
  "lexicon": 1,
  "id": "ai.gftd.apps.seikyu.recordPaymentReceived",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a payment received against one or more invoices. Writes paymentReceived record; derive rule flips invoice.status (partiallyPaid | paid) based on remaining balance and emits cash-side journalEntry.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["invoiceDids", "amount", "currency", "receivedAt", "bankDid"],
          "properties": {
            "invoiceDids": { "type": "array", "items": { "type": "string", "format": "did" } },
            "amount":      { "type": "number" },
            "currency":    { "type": "string" },
            "receivedAt":  { "type": "string", "format": "datetime" },
            "paymentRef":  { "type": "string" },
            "bankDid":     { "type": "string", "format": "did" },
            "memo":        { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["paymentReceivedDid", "affectedInvoices"],
          "properties": {
            "paymentReceivedDid": { "type": "string", "format": "did" },
            "affectedInvoices": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "invoiceDid": { "type": "string", "format": "did" },
                  "newStatus":  { "type": "string", "enum": ["partiallyPaid","paid"] }
                }
              }
            },
            "journalEntryDid": { "type": "string", "format": "did" }
          }
        }
      }
    }
  }
}
