{
  "lexicon": 1,
  "id": "ai.gftd.apps.seikyu.submitPeppol",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Submit a qualified invoice (インボイス制度) through the Peppol network. Server validates issuer taxId, signs the UBL payload, relays via Access Point, and stores peppolMessageId on the invoice. Requires the firm to be Peppol-onboarded.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["invoiceDid"],
          "properties": {
            "invoiceDid":  { "type": "string", "format": "did" },
            "recipientId": { "type": "string", "description": "Peppol participant identifier (e.g. 0188:...)" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["invoiceDid", "peppolMessageId", "submittedAt"],
          "properties": {
            "invoiceDid":      { "type": "string", "format": "did" },
            "peppolMessageId": { "type": "string" },
            "submittedAt":     { "type": "string", "format": "datetime" }
          }
        }
      },
      "errors": [
        { "name": "NotOnboarded",  "description": "firm is not registered with Peppol" },
        { "name": "MissingTaxId",  "description": "firm.taxId is required for qualified invoice" }
      ]
    }
  }
}
