{
  "lexicon": 1,
  "id": "ai.gftd.apps.seikyu.creditNote",
  "defs": {
    "main": {
      "type": "record",
      "description": "Credit note (値引 / 返品) against an issued invoice. Total is always negative relative to the originating invoice. Deriving rule emits a reversing journalEntry on the revenue and AR accounts.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["ownerDid", "invoiceDid", "creditNoteNumber", "issuedAt", "amount", "currency", "reason", "createdAt"],
        "properties": {
          "ownerDid":         { "type": "string", "format": "did" },
          "invoiceDid":       { "type": "string", "format": "did" },
          "creditNoteNumber": { "type": "string" },
          "issuedAt":         { "type": "string", "format": "datetime" },
          "amount":           { "type": "number", "description": "Positive value; sign is implied (credit)" },
          "taxAmount":        { "type": "number" },
          "currency":         { "type": "string" },
          "reason":           { "type": "string", "enum": ["returnOfGoods","priceAdjustment","writeOff","error"] },
          "pdfCid":           { "type": "string" },
          "createdAt":        { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
