{
  "lexicon": 1,
  "id": "ai.gftd.apps.judgeRapporteur.flagBiasConcern",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Rapporteur recusal / bias / nationality concern (bridges agOpinion.flagDivergenceFromCourt + judicial-influence + ethics-disclosure)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "assignmentVid",
            "concernKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "assignmentVid": {
              "type": "string",
              "description": "bridges recordAssignment"
            },
            "concernKind": {
              "type": "string",
              "enum": [
                "nationality_bias",
                "prior_employment",
                "family_relation",
                "public_statement",
                "political_affiliation",
                "conflict_of_interest",
                "specialization_mismatch",
                "over_assignment",
                "backlog_distortion",
                "language_skew"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}