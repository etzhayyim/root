{
  "lexicon": 1,
  "id": "ai.gftd.apps.judgeRapporteur.recordAssignment",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "CJEU / national supreme court judge-rapporteur assignment (bridges agOpinion.flagDivergenceFromCourt + grand-chamber-ruling + amicus-brief)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "assignmentId",
            "courtName",
            "rapporteurName",
            "caseClass",
            "specialization",
            "assignedAt"
          ],
          "properties": {
            "assignmentId": {
              "type": "string"
            },
            "courtName": {
              "type": "string"
            },
            "rapporteurName": {
              "type": "string"
            },
            "caseClass": {
              "type": "string",
              "enum": [
                "c_t",
                "c_p",
                "c_advocate_general",
                "action_for_annulment",
                "appeal",
                "preliminary_ref",
                "direct_action",
                "staff_dispute",
                "cross_appeal"
              ]
            },
            "specialization": {
              "type": "string",
              "enum": [
                "competition",
                "ip",
                "tax",
                "public_procurement",
                "data_prot",
                "environment",
                "social_security",
                "competition_law",
                "trade_remedy",
                "external_relations"
              ]
            },
            "agDivergenceVid": {
              "type": "string",
              "description": "bridges agOpinion.flagDivergenceFromCourt"
            },
            "assignedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}