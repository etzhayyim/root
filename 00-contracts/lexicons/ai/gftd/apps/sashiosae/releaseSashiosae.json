{
  "lexicon": 1,
  "id": "ai.gftd.apps.sashiosae.releaseSashiosae",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "差押解除を記録する (国税徴収法 §79). Server: (1) authorityDid == caller JWT sub 検証、(2) noticeId が active であること、(3) sashiosaeRelease record を write、(4) choushuuCase.status を kaijo or closed に更新、(5) derive rule で債務者本人 Signal DM 通知。",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["noticeId", "reason"],
          "properties": {
            "noticeId": { "type": "string" },
            "reason":   { "type": "string", "enum": ["kannou","muzaisan","shikkou-teishi","choushuu-teishi","jidai-koukyo","suspension-agreement","judicial-injunction","other"] },
            "memo":     { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["releaseId", "uri"],
          "properties": {
            "releaseId": { "type": "string" },
            "uri":       { "type": "string", "format": "at-uri" }
          }
        }
      },
      "errors": [
        { "name": "NoticeNotFound",    "description": "noticeId 存在しない" },
        { "name": "AlreadyReleased",   "description": "既に解除済み" },
        { "name": "AuthorityMismatch", "description": "caller が noticeId の authorityDid と不一致" }
      ]
    }
  }
}
