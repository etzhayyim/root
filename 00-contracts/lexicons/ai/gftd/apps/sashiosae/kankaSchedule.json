{
  "lexicon": 1,
  "id": "ai.gftd.apps.sashiosae.kankaSchedule",
  "defs": {
    "main": {
      "type": "query",
      "description": "公売期日一覧 (国税庁・都道府県・市町村)。Tier 1 public。kankaResult{status=scheduled|open} を scheduledAt 昇順で返す。",
      "parameters": {
        "type": "params",
        "properties": {
          "authorityDid":   { "type": "string", "format": "did" },
          "propertyType":   { "type": "string", "enum": ["deposit","salary","pension","receivable","realEstate","movable","securities","crypto","other"] },
          "kankaMethod":    { "type": "string", "enum": ["public-auction","bid-auction","private-contract","collection"] },
          "scheduledFrom":  { "type": "string", "format": "datetime" },
          "scheduledTo":    { "type": "string", "format": "datetime" },
          "limit":          { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
          "cursor":         { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["schedules"],
          "properties": {
            "schedules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["kankaId", "authorityDid", "kankaMethod", "scheduledAt", "status"],
                "properties": {
                  "kankaId":        { "type": "string" },
                  "authorityDid":   { "type": "string", "format": "did" },
                  "kankaMethod":    { "type": "string" },
                  "auctionId":      { "type": "string" },
                  "propertyType":   { "type": "string" },
                  "estimatedValue": { "type": "number" },
                  "scheduledAt":    { "type": "string", "format": "datetime" },
                  "venueUrl":       { "type": "string", "format": "uri" },
                  "status":         { "type": "string" }
                }
              }
            },
            "cursor": { "type": "string" }
          }
        }
      }
    }
  }
}
