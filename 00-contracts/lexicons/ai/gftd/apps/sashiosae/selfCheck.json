{
  "lexicon": 1,
  "id": "ai.gftd.apps.sashiosae.selfCheck",
  "defs": {
    "main": {
      "type": "query",
      "description": "自己の差押状況確認 (debtor JWT required). caller DID == target debtorDid を PDS auth で検証。戻り値 = active noticeId 数 + 法域別 amountBucket + 解除予定の有無。第三者照会不能。",
      "parameters": {
        "type": "params",
        "properties": {
          "caseType": { "type": "string", "enum": ["kokuzei","chihozei","kokuho","shaho","rousai","koyou","minji-shikkou","sousa-sashiosae","mokkai-hozen","other"] }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["hasActiveCase", "checkedAt"],
          "properties": {
            "hasActiveCase": { "type": "boolean" },
            "summary": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["caseType", "activeNoticeCount"],
                "properties": {
                  "caseType":          { "type": "string" },
                  "authorityDid":      { "type": "string", "format": "did" },
                  "activeNoticeCount": { "type": "integer" },
                  "amountBucket":      { "type": "string" },
                  "earliestKankaAt":   { "type": "string", "format": "datetime" }
                }
              }
            },
            "checkedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "errors": [
        { "name": "AuthRequired", "description": "caller DID JWT 未提示" }
      ]
    }
  }
}
