{
  "lexicon": 1,
  "id": "ai.gftd.apps.sashiosae.listByAuthority",
  "defs": {
    "main": {
      "type": "query",
      "description": "権限主体別の公開事案一覧 (Tier 1/2 only). debtor PII は返さない。公売公告連動 kankaResult + 統計粒度 choushuuCase のみ。",
      "parameters": {
        "type": "params",
        "required": ["authorityDid"],
        "properties": {
          "authorityDid": { "type": "string", "format": "did" },
          "caseType":     { "type": "string", "enum": ["kokuzei","chihozei","kokuho","shaho","rousai","koyou","minji-shikkou","sousa-sashiosae","mokkai-hozen","other"] },
          "status":       { "type": "string", "enum": ["sashiosae","kanka","haitou","kaijo","closed"] },
          "periodYmFrom": { "type": "string", "description": "YYYY-MM inclusive" },
          "periodYmTo":   { "type": "string", "description": "YYYY-MM inclusive" },
          "limit":        { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
          "cursor":       { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["cases"],
          "properties": {
            "cases":  { "type": "array", "items": { "type": "object" } },
            "cursor": { "type": "string" }
          }
        }
      }
    }
  }
}
