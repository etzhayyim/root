{
  "lexicon": 1,
  "id": "ai.gftd.apps.sashiosae.kankaResult",
  "defs": {
    "main": {
      "type": "record",
      "description": "換価結果 (公売 / 随意契約 / 取立). 国税庁公売公告 + 結果公告の公開データ。公売期日・売却予定価額は Tier 1 public (既に政府公開)、落札者 DID は Tier 3。",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["kankaId", "noticeId", "caseId", "authorityDid", "kankaMethod", "auctionId", "scheduledAt", "status", "createdAt"],
        "properties": {
          "kankaId":         { "type": "string" },
          "noticeId":        { "type": "string" },
          "caseId":          { "type": "string" },
          "authorityDid":    { "type": "string", "format": "did" },
          "kankaMethod":     { "type": "string", "enum": ["public-auction","bid-auction","private-contract","collection","return"] },
          "auctionId":       { "type": "string", "description": "国税庁公売番号 or 自治体公売番号" },
          "propertyType":    { "type": "string", "enum": ["deposit","salary","pension","receivable","realEstate","movable","securities","crypto","other"] },
          "estimatedValue":  { "type": "number", "description": "売却予定価額 (円, 公開情報)" },
          "scheduledAt":     { "type": "string", "format": "datetime", "description": "公売期日" },
          "venueUrl":        { "type": "string", "format": "uri", "description": "公売公告 URL (e.g. https://www.koubai.nta.go.jp/...)" },
          "closedAt":        { "type": "string", "format": "datetime" },
          "clearingBucket":  { "type": "string", "enum": ["zero","under-50p","50-80p","80-100p","over-estimate","withdrawn"], "description": "落札率帯 (匿名化)" },
          "status":          { "type": "string", "enum": ["scheduled","open","closed","cancelled","withdrawn"] },
          "createdAt":       { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
