{
  "lexicon": 1,
  "id": "ai.gftd.apps.sashiosae.choushuuCase",
  "defs": {
    "main": {
      "type": "record",
      "description": "徴収事案 (taino collection case). Tier 1/2 envelope of a delinquency case under 国税徴収法. PII (debtorDid/name/address/bankAccount) は Tier 3 server-side Preferences に格納し、ここには書かない。caseId = SHA-256(debtorDid + authorityDid + periodYm) の先頭 16 chars で匿名化。",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["caseId", "authorityDid", "caseType", "status", "amountBucket", "periodYm", "createdAt"],
        "properties": {
          "caseId":       { "type": "string", "description": "Anonymized case id (16-char hex)" },
          "authorityDid": { "type": "string", "format": "did", "description": "権限主体 DID (e.g. did:web:jpn-state.gftd.ai:mof:nta:taxoffice:01101)" },
          "caseType":     { "type": "string", "enum": ["kokuzei","chihozei","kokuho","shaho","rousai","koyou","minji-shikkou","sousa-sashiosae","mokkai-hozen","other"] },
          "status":       { "type": "string", "enum": ["toku-tokurei","sokutatsu","sashiosae-yokoku","sashiosae","kanka","haitou","kanfu","kaijo","closed"] },
          "amountBucket": { "type": "string", "enum": ["under-1m","1m-10m","10m-100m","100m-1b","over-1b"], "description": "金額帯 (bucketed for Tier 1/2 safety)" },
          "periodYm":     { "type": "string", "description": "対象期 YYYY-MM (課税年度ではなく事案開始月)" },
          "taxKind":      { "type": "string", "description": "税目 e.g. 所得税・法人税・消費税・住民税・固定資産税" },
          "createdAt":    { "type": "string", "format": "datetime" },
          "closedAt":     { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
