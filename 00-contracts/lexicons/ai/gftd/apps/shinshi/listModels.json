{
  "lexicon": 1,
  "id": "ai.gftd.apps.shinshi.listModels",
  "defs": {
    "main": {
      "type": "query",
      "description": "List all registered cosplay model DIDs under the shinshi primary DID.",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": { "type": "integer" }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "dids": { "type": "array", "items": { "type": "object" } }
          },
          "required": ["dids"]
        }
      }
    }
  }
}
