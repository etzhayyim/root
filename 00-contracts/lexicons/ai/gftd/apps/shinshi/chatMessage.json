{
  "lexicon": 1,
  "id": "ai.gftd.apps.shinshi.chatMessage",
  "defs": {
    "main": {
      "type": "record",
      "description": "One message in a 1:1 chat between a user DID and a model DID. Stored under the shinshi primary DID repo (not the user repo) so that balance/history is never federated out of shinshi's control.",
      "record": {
        "type": "object",
        "properties": {
          "convoId": { "type": "string" },
          "modelDid": { "type": "string", "format": "did" },
          "userDid": { "type": "string", "format": "did" },
          "role": { "type": "string", "enum": ["user", "assistant", "system"] },
          "content": { "type": "string" },
          "inReplyTo": { "type": "string" },
          "orgId": { "type": "string" },
          "userId": { "type": "string" },
          "actorId": { "type": "string" },
          "createdAt": { "type": "string", "format": "datetime" }
        },
        "required": ["convoId", "modelDid", "userDid", "role", "content", "createdAt"]
      }
    }
  }
}
