{
  "lexicon": 1,
  "id": "ai.gftd.apps.shinshi.seedScenesWithImages",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "For each slug: generate 5 scene images via llm.generateImage, uploadBlob, createRecord app.bsky.feed.post with app.bsky.embed.images. Idempotent via skipIfExisting.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "slugs": { "type": "array", "items": { "type": "string" }, "maxLength": 3 },
            "sceneType": { "type": "string", "enum": ["thumb", "standard", "hires"] },
            "skipIfExisting": { "type": "boolean" },
            "sceneIndices": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 4 }, "maxLength": 5 }
          },
          "required": ["slugs"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slug": { "type": "string" },
                  "did": { "type": "string" },
                  "scenesPosted": { "type": "integer" },
                  "blobKeys": { "type": "array", "items": { "type": "string" } },
                  "skipped": { "type": "boolean" },
                  "error": { "type": "string" }
                }
              }
            },
            "totalActresses": { "type": "integer" },
            "totalPosted": { "type": "integer" },
            "totalSkipped": { "type": "integer" }
          }
        }
      }
    }
  }
}
