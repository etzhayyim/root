{
  "lexicon": 1,
  "id": "ai.gftd.apps.shinshi.batchIngestThumbnails",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Legacy bulk ingestion: register model DIDs + post pre-generated scene thumbnails from a manifest.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["models"],
          "properties": {
            "models": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "folder": { "type": "string" },
                  "charName": { "type": "string" },
                  "series": { "type": "string" },
                  "name": { "type": "string" },
                  "category": { "type": "string" },
                  "scenes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": { "type": "string" },
                        "blobKey": { "type": "string" },
                        "sizeBytes": { "type": "integer" }
                      }
                    }
                  }
                },
                "required": ["folder", "charName", "series"]
              }
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "models": { "type": "array", "items": { "type": "object" } },
            "total": { "type": "integer" },
            "totalScenes": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
