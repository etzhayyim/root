{
  "lexicon": 1,
  "id": "ai.gftd.apps.shinshi.seedScenesWithVideo",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "For each slug: take the latest image post as i2v source, generate ~1s LTX-Video animated WebP clip, uploadBlob, post as app.bsky.feed.post with embedded animated image. Pod 85q7hno6n60xxk.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "slugs": { "type": "array", "items": { "type": "string" }, "maxLength": 3 }
          },
          "required": ["slugs"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slug": { "type": "string" },
                  "did": { "type": "string" },
                  "videoBlobKey": { "type": "string" },
                  "error": { "type": "string" }
                }
              }
            },
            "totalActresses": { "type": "integer" },
            "totalPosted": { "type": "integer" }
          }
        }
      }
    }
  }
}
