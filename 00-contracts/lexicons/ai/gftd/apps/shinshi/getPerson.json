{
  "lexicon": 1,
  "id": "ai.gftd.apps.shinshi.getPerson",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a 紳士録 public person profile by DID.",
      "x-bootstrap": true,
      "parameters": { "type": "params", "required": ["did"], "properties": { "did": { "type": "string", "format": "did" } } },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "fullName": { "type": "string" }, "fullNameLocal": { "type": "string" }, "role": { "type": "string", "enum": ["politician", "executive", "celebrity", "academic", "journalist"] }, "country": { "type": "string" }, "affiliations": { "type": "array", "items": { "type": "object", "properties": { "affiliationType": { "type": "string" }, "entityDid": { "type": "string", "format": "did" }, "role": { "type": "string" }, "startedAt": { "type": "string", "format": "datetime" }, "endedAt": { "type": "string", "format": "datetime" } } } }, "sourceUris": { "type": "array", "items": { "type": "string", "format": "uri" } }, "wikidataId": { "type": "string" }, "corrections": { "type": "array", "items": { "type": "object", "description": "Right of Reply records" } } } } }
    }
  }
}
