{
  "lexicon": 1,
  "id": "ai.gftd.apps.shinshi.getModelProfile",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get the public taxonomy for a model DID.",
      "parameters": {
        "type": "params",
        "required": ["modelDid"],
        "properties": { "modelDid": { "type": "string", "format": "did" } }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["modelDid"],
          "properties": {
            "modelDid": { "type": "string" },
            "charName": { "type": "string" },
            "series": { "type": "string" },
            "ageLook": { "type": "integer" },
            "bodyType": { "type": "string" },
            "ethnicityLook": { "type": "string" },
            "language": { "type": "array", "items": { "type": "string" } },
            "relationshipRole": { "type": "string" },
            "occupation": { "type": "string" },
            "hobbies": { "type": "array", "items": { "type": "string" } },
            "personality": { "type": "array", "items": { "type": "string" } },
            "promptStyle": { "type": "string" },
            "externalUri": { "type": "string" },
            "createdAt": { "type": "string" },
            "latencyMs": { "type": "integer" },
            "assistantId": { "type": "string", "const": "get_model_profile" },
            "error": { "type": "string" },
            "errorDetail": { "type": "string" }
          }
        }
      }
    }
  }
}
