{
  "lexicon": 1,
  "id": "ai.gftd.apps.shinshi.seedScenes",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Seed 5 placeholder scene posts per actress (no image blob, text-only). For demo UI while real image gen is deferred.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "slugs": { "type": "array", "items": { "type": "string" }, "maxLength": 50 }
          },
          "required": ["slugs"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slug": { "type": "string" },
                  "posted": { "type": "integer" }
                }
              }
            },
            "totalActresses": { "type": "integer" },
            "totalPosted": { "type": "integer" }
          }
        }
      }
    }
  }
}
