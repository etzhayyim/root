{
  "lexicon": 1,
  "id": "ai.gftd.apps.shinshi.sendChat",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Send a user message to a model DID convo. Deducts 1 token (or consumes free quota), calls Murakumo LLM with the model persona, persists both user + assistant chatMessage records, and returns the assistant reply.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["convoId", "text"],
          "properties": {
            "convoId": { "type": "string" },
            "text": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "convoId": { "type": "string" },
            "reply": { "type": "string" },
            "messageId": { "type": "string" },
            "tokensSpent": { "type": "integer" },
            "freeQuotaUsed": { "type": "integer" },
            "balanceAfter": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
