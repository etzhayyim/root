{
  "lexicon": 1,
  "id": "ai.gftd.apps.shinshi.listAuthorFeed",
  "defs": {
    "main": {
      "type": "query",
      "description": "List one Shinshi model author feed from the pod-side repo projection.",
      "parameters": {
        "type": "params",
        "required": ["did"],
        "properties": {
          "did": { "type": "string", "format": "did" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did", "limit", "scenes", "total", "latencyMs", "assistantId"],
          "properties": {
            "did": { "type": "string" },
            "limit": { "type": "integer" },
            "scenes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["uri", "rkey", "text", "thumbUrl", "fullUrl", "createdAt", "labels"],
                "properties": {
                  "uri": { "type": "string" },
                  "rkey": { "type": "string" },
                  "text": { "type": "string" },
                  "thumbUrl": { "type": ["string", "null"] },
                  "fullUrl": { "type": ["string", "null"] },
                  "alt": { "type": "string" },
                  "createdAt": { "type": "string" },
                  "labels": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "total": { "type": "integer" },
            "latencyMs": { "type": "integer" },
            "assistantId": { "type": "string", "const": "list_author_feed" },
            "error": { "type": "string" },
            "errorDetail": { "type": "string" }
          }
        }
      }
    }
  }
}
