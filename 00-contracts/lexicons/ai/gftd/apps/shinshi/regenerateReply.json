{
  "lexicon": 1,
  "id": "ai.gftd.apps.shinshi.regenerateReply",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Ask the model DID to produce an alternate reply to the last user message in a convo. Costs 1 token. History is not mutated; a new message is appended with inReplyTo set to the previous reply.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["convoId"],
          "properties": { "convoId": { "type": "string" } }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "convoId": { "type": "string" },
            "messageId": { "type": "string" },
            "tokensSpent": { "type": "integer" },
            "balanceAfter": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
