{
  "lexicon": 1,
  "id": "ai.gftd.apps.shinshi.tokenLedger",
  "defs": {
    "main": {
      "type": "record",
      "description": "Per-user token balance ledger for shinshi. Stored under the shinshi primary DID (not the user DID) to keep balance within shinshi's control and prevent federation. Only shinshi processes read/mutate this record.",
      "record": {
        "type": "object",
        "properties": {
          "userDid": { "type": "string", "format": "did" },
          "balance": { "type": "integer", "minimum": 0 },
          "granted": { "type": "integer", "minimum": 0 },
          "purchased": { "type": "integer", "minimum": 0 },
          "spent": { "type": "integer", "minimum": 0 },
          "freeQuotaUsed": { "type": "integer", "minimum": 0 },
          "freeQuotaResetAt": { "type": "string", "format": "datetime" },
          "tier": { "type": "string", "enum": ["free", "premium"] },
          "orgId": { "type": "string" },
          "userId": { "type": "string" },
          "actorId": { "type": "string" },
          "createdAt": { "type": "string", "format": "datetime" },
          "updatedAt": { "type": "string", "format": "datetime" }
        },
        "required": ["userDid", "balance", "tier", "updatedAt"]
      }
    }
  }
}
