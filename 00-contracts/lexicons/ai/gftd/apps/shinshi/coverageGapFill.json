{
  "lexicon": 1,
  "id": "ai.gftd.apps.shinshi.coverageGapFill",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Trigger Shinshi coverage gap-fill rendering for incomplete characters.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "perFire": { "type": "integer", "minimum": 1, "maximum": 10 },
            "sceneType": { "type": "string" },
            "style": { "type": "string", "enum": ["anime", "photoreal"] },
            "ckpt": { "type": "string" },
            "appDid": { "type": "string", "default": "did:web:sh1n5h1x.gftd.ai" }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["latencyMs", "assistantId"],
          "properties": {
            "incompleteSlugs": { "type": "array", "items": { "type": "string" } },
            "totalIncompleteSeen": { "type": "integer" },
            "dispatched": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slug": { "type": "string" },
                  "scenesPosted": { "type": "integer" },
                  "scenesSkipped": { "type": "integer" },
                  "error": { "type": "string" }
                }
              }
            },
            "totalPosted": { "type": "integer" },
            "totalSkipped": { "type": "integer" },
            "latencyMs": { "type": "integer" },
            "assistantId": { "type": "string", "const": "coverage_gap_fill" },
            "error": { "type": "string" },
            "errorDetail": { "type": "string" }
          }
        }
      }
    }
  }
}
