{
  "lexicon": 1,
  "id": "ai.gftd.apps.shinshi.creditTokens",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Credit tokens to a user's Preferences ledger. Internal-trust only (requires Service Auth JWT scoped lxm=ai.gftd.apps.shinshi.creditTokens). vaultRef must reference a Vault receipt that survives audit.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["userDid", "amount", "vaultRef", "reason"],
          "properties": {
            "userDid": { "type": "string", "format": "did" },
            "amount": { "type": "integer", "minimum": 1 },
            "vaultRef": { "type": "string" },
            "reason": { "type": "string", "enum": ["purchase", "grant", "refund", "promo"] }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "userDid": { "type": "string" },
            "balanceAfter": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
