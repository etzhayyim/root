{
  "lexicon": 1,
  "id": "ai.gftd.apps.shinshi.createDid",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a cosplay model character as a sub-DID actor with full bootstrap (DID document, profile, follow, tools, knowledge graph).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "folder": { "type": "string" },
            "charName": { "type": "string" },
            "series": { "type": "string" },
            "name": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } },
            "sensitivity": { "type": "string" }
          },
          "required": ["folder", "charName", "series"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "did": { "type": "string" },
            "rkey": { "type": "string" },
            "folder": { "type": "string" },
            "charName": { "type": "string" },
            "series": { "type": "string" },
            "error": { "type": "string" }
          },
          "required": []
        }
      }
    }
  }
}
