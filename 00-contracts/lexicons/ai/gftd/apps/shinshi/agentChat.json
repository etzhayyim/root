{
  "lexicon": 1,
  "id": "ai.gftd.apps.shinshi.agentChat",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Single-turn Shinshi persona chat backed by the k8s LangGraph pod.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["message"],
          "properties": {
            "slug": { "type": "string" },
            "actorDid": { "type": "string" },
            "userDid": { "type": "string" },
            "message": { "type": "string", "maxLength": 4000 },
            "history": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["role", "content"],
                "properties": {
                  "role": { "type": "string", "enum": ["user", "assistant"] },
                  "content": { "type": "string" }
                }
              }
            },
            "maxTokens": { "type": "integer", "default": 384 },
            "temperature": { "type": "number", "default": 0.85 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["latencyMs", "assistantId"],
          "properties": {
            "slug": { "type": "string" },
            "actorDid": { "type": "string" },
            "userDid": { "type": "string" },
            "message": { "type": "string" },
            "reply": { "type": "string" },
            "model": { "type": "string" },
            "promptTokens": { "type": "integer" },
            "completionTokens": { "type": "integer" },
            "totalTokens": { "type": "integer" },
            "latencyMs": { "type": "integer" },
            "assistantId": { "type": "string", "const": "agent_chat" },
            "error": { "type": "string" },
            "errorDetail": { "type": "string" }
          }
        }
      }
    }
  }
}
