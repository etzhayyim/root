{
  "lexicon": 1,
  "id": "ai.gftd.apps.shinshi.requestScene",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Generate an on-demand scene image for a model DID using the Murakumo image fleet. Deducts tokens from caller's Preferences ledger and posts as the model DID (same gallery path as batch ingest).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["modelDid", "prompt"],
          "properties": {
            "modelDid": { "type": "string", "format": "did" },
            "prompt": { "type": "string" },
            "sceneType": { "type": "string", "enum": ["thumb", "standard", "hires"], "default": "standard" },
            "visibility": { "type": "string", "enum": ["public", "private"], "default": "public" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "postUri": { "type": "string" },
            "blobKey": { "type": "string" },
            "cid": { "type": "string" },
            "tokensSpent": { "type": "integer" },
            "balanceAfter": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
