{
  "lexicon": 1,
  "id": "ai.gftd.apps.jpnInvoice.registerInvoiceIssuer",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "国税庁 インボイス登録",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "registrationNumber",
            "nameJa",
            "issuerType",
            "registrationDate"
          ],
          "properties": {
            "registrationNumber": {
              "type": "string",
              "description": "T + 13 桁"
            },
            "nameJa": {
              "type": "string"
            },
            "issuerType": {
              "type": "string",
              "enum": [
                "corporation",
                "sole-proprietor",
                "partnership"
              ]
            },
            "corporateNumber": {
              "type": "string"
            },
            "registeredAddress": {
              "type": "string"
            },
            "registrationDate": {
              "type": "string",
              "format": "date"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
