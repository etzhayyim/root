{
  "lexicon": 1,
  "id": "ai.gftd.apps.adsk.ingestDataset",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Ingest a single HuggingFace dataset (slug = 'org/name') into vertex_hf_dataset_record. Phase 1 supports parquet + zip(text). 3D / voxel binary blobs are out of scope. No XRPC entry — invoked via bpmn-dispatcher ClusterIP only.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["slug"],
          "properties": {
            "slug": {"type": "string", "description": "HF dataset id, e.g. 'ADSKAILab/Zero-To-CAD-100k'"},
            "split": {"type": "string", "description": "train/validation/test; default = first available"},
            "limit": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "textColumns": {"type": "array", "items": {"type": "string"}, "description": "explicit columns to concatenate as text_for_training; if omitted, primitive picks heuristically"},
            "force": {"type": "boolean", "default": false, "description": "re-ingest even if last_synced_at within 7d"}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": {"type": "boolean"},
            "slug": {"type": "string"},
            "rows": {"type": "integer"},
            "skipped": {"type": "integer"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
