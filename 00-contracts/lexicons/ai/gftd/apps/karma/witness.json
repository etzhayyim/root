{
  "lexicon": 1,
  "id": "ai.gftd.apps.karma.witness",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Sign and persist a third-organism attestation about a karma edge. Witnesses are independent IPFS objects; multiple witnesses can be added post-edge-creation without mutating the edge itself (immutability invariant). Witness DID must not be source nor target of the edge.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["edgeId", "attestationKind", "signature", "signatureAlg"],
          "properties": {
            "edgeId": {"type": "string"},
            "attestationKind": {
              "type": "string",
              "enum": ["confirms", "disputes", "contextualizes", "addsEvidence"]
            },
            "signature": {"type": "string"},
            "signatureAlg": {"type": "string", "enum": ["es256", "ed25519"], "default": "es256"},
            "witnessOrganismCid": {"type": "string"},
            "tsMs": {"type": "integer"}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": {"type": "boolean"},
            "witnessId": {"type": "string"},
            "ipfsCid": {"type": "string"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
