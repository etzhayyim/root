{
  "lexicon": 1,
  "id": "ai.gftd.apps.karma.recordDependency",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a karma dependency edge between two organisms. Edge is content-addressed (ADR-0041), persisted to RisingWave (L0) and asynchronously lifted to AT repo (L1) + IPFS (L2/L3) + blockchain anchor (L4). Floor violations (Tier=Floor + Direction=harm) are rejected at this XRPC boundary; the protocol refuses to mint inadmissible edges. Children-harming actions (vul ≥ 2.0 + Vita/Vinculum/Venturum + harm) auto-classify as Tier=Floor per Karma.lean child_floor_axiom.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sourceDid", "axis", "tier", "magnitude", "direction", "victimVul", "tsMs"],
          "properties": {
            "sourceDid": {"type": "string", "format": "did"},
            "targetDid": {"type": "string", "format": "did"},
            "axis": {
              "type": "string",
              "enum": ["vita", "vivere", "veritas", "vinculum", "venturum"],
              "description": "五行 — 命 / 業 / 語 / 縁 / 世"
            },
            "tier": {
              "type": "string",
              "enum": ["floor", "high", "mid", "low"]
            },
            "magnitude": {"type": "number", "minimum": 0},
            "direction": {
              "type": "string",
              "enum": ["harm", "help", "witness"]
            },
            "victimVul": {"type": "number", "minimum": 1.0},
            "vulnerabilityAgeAlpha": {"type": "number"},
            "vulnerabilityFrailtyPhi": {"type": "number"},
            "vulnerabilityScarcitySigma": {"type": "number"},
            "futureHorizonYears": {"type": "integer", "minimum": 0},
            "irreversible": {"type": "boolean", "default": false},
            "tsMs": {"type": "integer"},
            "contextCid": {"type": "string"},
            "proofCid": {"type": "string"},
            "proofEncrypted": {"type": "boolean", "default": false},
            "prevEdgeInContextCid": {"type": "string"}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": {"type": "boolean"},
            "edgeId": {"type": "string"},
            "vertexId": {"type": "string"},
            "tier": {"type": "string"},
            "signedWeight": {"type": "number"},
            "ipfsCid": {"type": "string"},
            "atrepoUri": {"type": "string"},
            "rejectedReason": {
              "type": "string",
              "description": "When ok=false: 'floor-violation' | 'child-floor-auto' | 'invalid-input' | 'organism-dissolved'"
            },
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
