{
  "lexicon": 1,
  "id": "ai.gftd.apps.karma.evaluate",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Karma evaluation agent (LangGraph state machine + Pregel-style graph propagation + actor mailbox). Takes a candidate edge or existing edge_id, runs through validate → vulnerability_assess → tier_classify (LLM) → axiom_verify → witness_search (Pregel BFS over edge_karma_dependency) → recommend. Returns signed recommendation: admit | floor-violation | require-witness | escalate-dao. Pure read path (no mutation); admit recommendation can be followed by a recordDependency call if caller agrees.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "edgeId": {
              "type": "string",
              "description": "Evaluate an already-recorded edge. Mutually exclusive with the candidate fields below."
            },
            "candidate": {
              "type": "ref",
              "ref": "#candidate",
              "description": "Evaluate a candidate edge before recording it."
            },
            "witnessHops": {
              "type": "integer",
              "default": 2,
              "minimum": 1,
              "maximum": 4,
              "description": "Pregel BFS hop limit for witness search (1-hop = direct cohort, 4-hop = extended community)"
            },
            "agentTier": {
              "type": "string",
              "enum": ["fast", "balanced", "deep", "reasoning"],
              "default": "balanced",
              "description": "LLM tier for tier classification + recommendation synthesis"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "recommendation"],
          "properties": {
            "ok": {"type": "boolean"},
            "recommendation": {
              "type": "string",
              "enum": ["admit", "floor-violation", "require-witness", "escalate-dao"]
            },
            "resolvedTier": {"type": "string"},
            "signedWeight": {"type": "number"},
            "vulnerabilityNote": {"type": "string"},
            "axiomCheck": {
              "type": "object",
              "properties": {
                "admissible": {"type": "boolean"},
                "axiomD": {"type": "boolean", "description": "floor_violation_inadmissible"},
                "axiomE": {"type": "boolean", "description": "child_floor_axiom auto-classification fired"}
              }
            },
            "witnessCandidates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "did": {"type": "string"},
                  "hopDistance": {"type": "integer"},
                  "edgeOverlap": {"type": "integer"}
                }
              }
            },
            "rationale": {"type": "string"},
            "supersteps": {"type": "integer"},
            "llmTokensUsed": {"type": "integer"},
            "error": {"type": "string"}
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "required": ["sourceDid", "axis", "tier", "magnitude", "direction", "victimVul"],
      "properties": {
        "sourceDid": {"type": "string", "format": "did"},
        "targetDid": {"type": "string", "format": "did"},
        "axis": {"type": "string", "enum": ["vita", "vivere", "veritas", "vinculum", "venturum"]},
        "tier": {"type": "string", "enum": ["floor", "high", "mid", "low"]},
        "magnitude": {"type": "number"},
        "direction": {"type": "string", "enum": ["harm", "help", "witness"]},
        "victimVul": {"type": "number"},
        "futureHorizonYears": {"type": "integer"},
        "irreversible": {"type": "boolean"}
      }
    }
  }
}
