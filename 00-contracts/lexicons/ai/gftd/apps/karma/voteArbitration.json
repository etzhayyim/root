{
  "lexicon": 1,
  "id": "ai.gftd.apps.karma.voteArbitration",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Cast a 覚者 vote on an open karma arbitration. Voter DID must be in the arbitration's invitedVoters set. Position is one of (admit, floor, dismiss, abstain). Signature attests voter's commitment per Karma.lean N3 anatman (signature alone, no continuity claim against past votes).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["arbitrationId", "voterDid", "position", "signature", "signatureAlg"],
          "properties": {
            "arbitrationId": {"type": "string"},
            "voterDid": {"type": "string", "format": "did"},
            "position": {
              "type": "string",
              "enum": ["admit", "floor", "dismiss", "abstain"],
              "description": "admit = candidate is admissible / floor = floor-violation / dismiss = arbitration is groundless / abstain = no opinion (counts toward quorum but not majority)"
            },
            "signature": {"type": "string"},
            "signatureAlg": {"type": "string", "enum": ["es256", "ed25519"], "default": "es256"},
            "rationaleCid": {
              "type": "string",
              "description": "Optional encrypted rationale CID (vault.gftd.ai)"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": {"type": "boolean"},
            "voteId": {"type": "string"},
            "tally": {
              "type": "object",
              "properties": {
                "admit": {"type": "integer"},
                "floor": {"type": "integer"},
                "dismiss": {"type": "integer"},
                "abstain": {"type": "integer"},
                "total": {"type": "integer"}
              }
            },
            "rejectedReason": {
              "type": "string",
              "description": "When ok=false: 'arbitration-not-open' | 'voter-not-invited' | 'already-voted' | 'window-closed'"
            },
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
