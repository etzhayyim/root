{
  "lexicon": 1,
  "id": "ai.gftd.apps.karma.coverage",
  "defs": {
    "main": {
      "type": "query",
      "description": "Coverage snapshot — total edges, organisms (active / dissolved), pin completeness across 5 layers, last anchor timestamp.",
      "parameters": {
        "type": "params",
        "properties": {
          "asOf": {"type": "string", "format": "datetime"}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["asOf", "edgesTotal", "organismsActive", "organismsDissolved", "pinComplete", "pinPartial", "floorViolations24h", "lastAnchorAtMs"],
          "properties": {
            "asOf": {"type": "string", "format": "datetime"},
            "edgesTotal": {"type": "integer"},
            "edgesLast24h": {"type": "integer"},
            "organismsActive": {"type": "integer"},
            "organismsDissolved": {"type": "integer"},
            "pinComplete": {"type": "integer", "description": "edges with all 5 layers pinned"},
            "pinPartial": {"type": "integer", "description": "edges with 1-4 layers pinned"},
            "pinUnstarted": {"type": "integer", "description": "edges with 0 layers pinned"},
            "floorViolations24h": {"type": "integer"},
            "lastAnchorAtMs": {"type": "integer"},
            "lastAnchorTxHash": {"type": "string"},
            "axes": {
              "type": "object",
              "description": "edge counts per axis × tier",
              "properties": {
                "vita": {"type": "integer"},
                "vivere": {"type": "integer"},
                "veritas": {"type": "integer"},
                "vinculum": {"type": "integer"},
                "venturum": {"type": "integer"}
              }
            }
          }
        }
      }
    }
  }
}
