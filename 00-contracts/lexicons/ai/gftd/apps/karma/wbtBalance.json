{
  "lexicon": 1,
  "id": "ai.gftd.apps.karma.wbtBalance",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get the current WBT balance for an organism DID, plus aggregate inflow / outflow / tx count. Returns zero balance for never-seen DIDs (silent default — does not error).",
      "parameters": {
        "type": "params",
        "required": ["did"],
        "properties": {
          "did": {"type": "string", "format": "did"}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did", "balance"],
          "properties": {
            "did": {"type": "string"},
            "balance": {"type": "number"},
            "totalInflow": {"type": "number"},
            "totalOutflow": {"type": "number"},
            "txCount": {"type": "integer"},
            "lastTxTsMs": {"type": "integer"},
            "lastTxId": {"type": "string"},
            "isCommons": {"type": "boolean"}
          }
        }
      }
    }
  }
}
