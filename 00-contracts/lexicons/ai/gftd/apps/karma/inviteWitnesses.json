{
  "lexicon": 1,
  "id": "ai.gftd.apps.karma.inviteWitnesses",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Invite candidate organisms (typically discovered by `karma.evaluate`'s Pregel witness search) to attest to a karma edge. Fans out per-invitee `vertex_karma_witness_invitation` rows. Each invitee can respond via `respondToInvitation` (accept → produces vertex_karma_witness row; decline → records decline). Pending invitations expire automatically via the inviteSweep R/PT1H BPMN.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["inviterDid", "inviteeDids"],
          "properties": {
            "edgeId": {"type": "string"},
            "candidate": {
              "type": "ref",
              "ref": "ai.gftd.apps.karma.evaluate#candidate"
            },
            "inviterDid": {"type": "string", "format": "did"},
            "inviteeDids": {
              "type": "array",
              "items": {"type": "string", "format": "did"},
              "minLength": 1,
              "maxLength": 50
            },
            "message": {"type": "string", "maxLength": 1000},
            "expiresInDays": {
              "type": "integer",
              "default": 14,
              "minimum": 1,
              "maximum": 90
            },
            "rationaleCid": {
              "type": "string",
              "description": "Optional encrypted rationale CID (vault.gftd.ai)"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "invitationIds", "inviteCount"],
          "properties": {
            "ok": {"type": "boolean"},
            "invitationIds": {"type": "array", "items": {"type": "string"}},
            "inviteCount": {"type": "integer"},
            "expiresAtMs": {"type": "integer"},
            "rejectedReason": {
              "type": "string",
              "description": "When ok=false: 'invalid-input' | 'edge-not-found' | 'invitee-already-witnessed' | 'too-many-pending'"
            },
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
