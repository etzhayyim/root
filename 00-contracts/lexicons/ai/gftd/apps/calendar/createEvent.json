{
  "lexicon": 1,
  "id": "ai.gftd.apps.calendar.createEvent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create a calendar event. Path-based DID: did:web:calendar.gftd.ai:event:{slug}. iCalendar RFC 5545 compatible.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["summary", "startsAt"],
          "properties": {
            "summary": { "type": "string", "description": "event title" },
            "description": { "type": "string" },
            "startsAt": { "type": "string", "format": "datetime" },
            "endsAt": { "type": "string", "format": "datetime" },
            "allDay": { "type": "boolean", "default": false },
            "timezone": { "type": "string", "description": "IANA TZ (e.g. Asia/Tokyo)" },
            "location": { "type": "string" },
            "url": { "type": "string", "format": "uri" },
            "attendeeDids": { "type": "array", "items": { "type": "string", "format": "did" } },
            "rrule": { "type": "string", "description": "RFC 5545 RRULE for recurrence" },
            "reminders": { "type": "array", "items": { "type": "object", "properties": { "minutesBefore": { "type": "integer" }, "method": { "type": "string", "enum": ["email", "push", "popup"] } } } },
            "visibility": { "type": "string", "enum": ["public", "private", "confidential"], "default": "private" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did", "uri"],
          "properties": {
            "did": { "type": "string", "format": "did" },
            "uri": { "type": "string", "format": "at-uri" },
            "icalendarUid": { "type": "string", "description": "RFC 5545 UID" }
          }
        }
      }
    }
  }
}
