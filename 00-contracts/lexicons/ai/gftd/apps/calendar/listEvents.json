{
  "lexicon": 1,
  "id": "ai.gftd.apps.calendar.listEvents",
  "defs": {
    "main": {
      "type": "query",
      "description": "List calendar events with optional time-range/attendee filter.",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "properties": {
          "ownerDid": { "type": "string", "format": "did" },
          "attendeeDid": { "type": "string", "format": "did" },
          "startsAfter": { "type": "string", "format": "datetime" },
          "startsBefore": { "type": "string", "format": "datetime" },
          "visibility": { "type": "string", "enum": ["public", "private", "confidential"] },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["events", "total", "offset", "limit"],
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "did": { "type": "string", "format": "did" },
                  "summary": { "type": "string" },
                  "startsAt": { "type": "string", "format": "datetime" },
                  "endsAt": { "type": "string", "format": "datetime" },
                  "location": { "type": "string" },
                  "visibility": { "type": "string" }
                }
              }
            },
            "total": { "type": "integer" }, "offset": { "type": "integer" }, "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
