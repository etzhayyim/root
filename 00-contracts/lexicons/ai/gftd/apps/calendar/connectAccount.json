{
  "lexicon": 1,
  "id": "ai.gftd.apps.calendar.connectAccount",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Start Google Calendar OAuth2 connect flow. Returns authorization URL.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "accountDid": { "type": "string", "format": "did" },
            "email": { "type": "string", "description": "login_hint" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "status": { "type": "string" },
            "oauthUrl": { "type": "string", "format": "uri" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
