{
  "lexicon": 1,
  "id": "ai.gftd.apps.calendar.syncFromGoogle",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Sync a Google Calendar account into the graph (events.list with syncToken).",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["email"],
          "properties": {
            "email": { "type": "string", "description": "account email previously connected" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "jobId": { "type": "string" },
            "synced": { "type": "integer" },
            "syncToken": { "type": "string" },
            "status": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
