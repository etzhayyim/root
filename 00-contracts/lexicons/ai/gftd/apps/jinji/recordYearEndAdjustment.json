{
  "lexicon": 1,
  "id": "ai.gftd.apps.jinji.recordYearEndAdjustment",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a year-end adjustment declaration hash and encrypted artifact pointer.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["employeeDid", "taxYear", "declarationHash"],
          "properties": {
            "owner": { "type": "string" },
            "employeeDid": { "type": "string", "format": "did" },
            "taxYear": { "type": "integer" },
            "declarationHash": { "type": "string" },
            "artifactCid": { "type": "string" },
            "status": { "type": "string", "default": "submitted" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "yearEndAdjustmentDid"],
          "properties": {
            "ok": { "type": "boolean" },
            "yearEndAdjustmentDid": { "type": "string" }
          }
        }
      }
    }
  }
}
