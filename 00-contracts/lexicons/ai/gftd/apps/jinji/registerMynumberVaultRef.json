{
  "lexicon": 1,
  "id": "ai.gftd.apps.jinji.registerMynumberVaultRef",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register an encrypted My Number vault reference. The number itself is never stored in RisingWave.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["employeeDid", "vaultRefEncrypted", "declarationHash"],
          "properties": {
            "owner": { "type": "string" },
            "employeeDid": { "type": "string", "format": "did" },
            "vaultRefEncrypted": { "type": "string" },
            "declarationHash": { "type": "string" },
            "status": { "type": "string", "default": "active" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "vaultRefDid"],
          "properties": {
            "ok": { "type": "boolean" },
            "vaultRefDid": { "type": "string" }
          }
        }
      }
    }
  }
}
