{
  "lexicon": 1,
  "id": "ai.gftd.apps.jinji.upsertEmployee",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create or update the encrypted employee master record.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["employeeDid", "displayNameEncrypted", "employmentStatus"],
          "properties": {
            "owner": { "type": "string" },
            "employeeDid": { "type": "string", "format": "did" },
            "displayNameEncrypted": { "type": "string" },
            "employmentStatus": { "type": "string" },
            "joinedOn": { "type": "string", "format": "datetime" },
            "leftOn": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "employeeVertexId"],
          "properties": {
            "ok": { "type": "boolean" },
            "employeeVertexId": { "type": "string" }
          }
        }
      }
    }
  }
}
