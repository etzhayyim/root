{
  "lexicon": 1,
  "id": "ai.gftd.apps.smishing.commitPipelineResult",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Thin edge write boundary for LangServer-generated smishing pipeline records and social posts.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "analysisId": { "type": "string" },
            "label": { "type": "string" },
            "score": { "type": "integer" },
            "publish": { "type": "boolean" },
            "records": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "collection": { "type": "string" },
                  "record": { "type": "object" }
                },
                "required": ["collection", "record"]
              }
            },
            "posts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "did": { "type": "string" },
                  "text": { "type": "string" }
                },
                "required": ["text"]
              }
            }
          },
          "required": ["records"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "analysisId": { "type": "string" },
            "score": { "type": "integer" },
            "label": { "type": "string" },
            "written": { "type": "array", "items": { "type": "object" } },
            "posted": { "type": "integer" }
          },
          "required": ["ok"]
        }
      }
    }
  }
}
