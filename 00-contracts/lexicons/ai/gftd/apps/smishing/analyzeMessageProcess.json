{
  "lexicon": 1,
  "id": "ai.gftd.apps.smishing.analyzeMessageProcess",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Start the LangServer smishing analysis pipeline.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "smsId": { "type": "string" },
            "senderAddress": { "type": "string" },
            "body": { "type": "string" },
            "timestamp": { "type": "integer" },
            "publish": { "type": "boolean" }
          },
          "required": ["body"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "result": { "type": "object" },
            "auditRkey": { "type": "string" }
          },
          "required": []
        }
      }
    }
  }
}
