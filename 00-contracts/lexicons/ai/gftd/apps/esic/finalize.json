{
  "lexicon": 1,
  "id": "ai.gftd.apps.esic.finalize",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0054. Commit a reviewed contribution, capture portal challan reference, propagate to kaikei.recordEsiPayable.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "vertexId": { "type": "string" },
            "challanReference": { "type": "string", "description": "Bank challan reference for the ESIC payment." },
            "challanPaidAt": { "type": "string", "description": "ISO 8601 timestamp of challan payment." }
          },
          "required": ["vertexId"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "challanReference": { "type": "string" },
            "propagatedToKaikei": { "type": "boolean" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
