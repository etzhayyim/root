{
  "lexicon": 1,
  "id": "ai.gftd.apps.esic.amend",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0054. File an amendment (joining/leaving member, wage revision, IP No correction). Starts BPMN process esic_amend.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "employerOrgId": { "type": "string" },
            "establishmentEsiCode": { "type": "string" },
            "wageMonth": { "type": "string" },
            "amendmentDate": { "type": "string" },
            "amendmentReason": {
              "type": "string",
              "enum": ["joinedMember", "leftMember", "wageRevision", "ipCorrection", "wageBoundaryToggle", "rateOverride"]
            },
            "memberIpNumber": { "type": "string" },
            "amendmentDescription": { "type": "string" },
            "amendmentPayload": { "type": "string", "description": "signal:v1: encrypted delta payload" }
          },
          "required": ["establishmentEsiCode", "wageMonth", "amendmentDate", "amendmentReason"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "approvalRequired": { "type": "boolean" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
