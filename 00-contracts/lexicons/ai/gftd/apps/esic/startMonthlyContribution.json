{
  "lexicon": 1,
  "id": "ai.gftd.apps.esic.startMonthlyContribution",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0054. Begin a new ESIC monthly contribution filing for a wage month.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "employerOrgId": { "type": "string" },
            "establishmentEsiCode": { "type": "string", "description": "17-digit ESIC code, e.g. 41000123450001000" },
            "wageMonth": { "type": "string", "description": "YYYY-MM" },
            "filerDid": { "type": "string" }
          },
          "required": ["employerOrgId", "establishmentEsiCode", "wageMonth"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
