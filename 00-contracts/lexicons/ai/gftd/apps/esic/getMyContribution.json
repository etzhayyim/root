{
  "lexicon": 1,
  "id": "ai.gftd.apps.esic.getMyContribution",
  "defs": {
    "main": {
      "type": "query",
      "description": "ADR-0054. Self-only read for an employee with an IP Number. Returns the slice of the encrypted roster the caller is entitled to.",
      "parameters": {
        "type": "params",
        "properties": {
          "wageMonth": { "type": "string", "description": "YYYY-MM" },
          "establishmentEsiCode": { "type": "string" }
        },
        "required": ["wageMonth"]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "vertexId": { "type": "string" },
            "status": { "type": "string" },
            "wageMonth": { "type": "string" },
            "challanReference": { "type": "string" },
            "memberSlicePayload": { "type": "string", "description": "signal:v1: ciphertext of caller's row." },
            "submittedAt": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
