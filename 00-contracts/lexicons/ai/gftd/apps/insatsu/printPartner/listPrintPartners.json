{
  "lexicon": 1,
  "id": "ai.gftd.apps.insatsu.printPartner.listPrintPartners",
  "defs": {
    "main": {
      "type": "query",
      "description": "List cloud print partners with optional region and capability filters.",
      "parameters": {
        "type": "params",
        "properties": {
          "region": { "type": "string" },
          "country": { "type": "string" },
          "print_method": { "type": "string" },
          "mail_class": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "items": { "type": "array", "items": { "type": "unknown" } },
            "total": { "type": "integer" },
            "limit": { "type": "integer" }
          },
          "required": ["items", "total", "limit"]
        }
      }
    }
  }
}
