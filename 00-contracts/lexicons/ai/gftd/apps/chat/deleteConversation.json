{
  "lexicon": 1,
  "id": "ai.gftd.apps.chat.deleteConversation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Soft-delete a conversation (status='deleted'). Hard delete + B2 artifact GC happens via chat_artifact_gc BPMN cron.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["convId"],
          "properties": {
            "convId": {"type": "string"},
            "purgeNow": {"type": "boolean", "default": false, "description": "If true, schedule immediate B2 deletion of artifacts (still soft-delete for record retention)."}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": {"type": "boolean"},
            "messagesAffected": {"type": "integer"},
            "artifactsScheduledForGc": {"type": "integer"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
