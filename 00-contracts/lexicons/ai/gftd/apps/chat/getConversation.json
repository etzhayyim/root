{
  "lexicon": 1,
  "id": "ai.gftd.apps.chat.getConversation",
  "defs": {
    "main": {
      "type": "query",
      "description": "Fetch a single conversation including all messages, tool invocations, and artifact references.",
      "parameters": {
        "type": "params",
        "required": ["convId"],
        "properties": {
          "convId": {"type": "string"},
          "limit": {"type": "integer", "default": 200, "minimum": 1, "maximum": 1000},
          "includeArtifacts": {"type": "boolean", "default": true},
          "includeToolInvocations": {"type": "boolean", "default": true}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["convId", "messages"],
          "properties": {
            "convId": {"type": "string"},
            "title": {"type": "string"},
            "agentDid": {"type": "string"},
            "modelHint": {"type": "string"},
            "messageCount": {"type": "integer"},
            "lastMessageAt": {"type": "string", "format": "datetime"},
            "messages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["msgId", "role", "tsMs"],
                "properties": {
                  "msgId": {"type": "string"},
                  "role": {"type": "string"},
                  "content": {"type": "string"},
                  "tsMs": {"type": "integer"},
                  "modelUsed": {"type": "string"},
                  "totalTokens": {"type": "integer"},
                  "toolCallsJson": {"type": "string"},
                  "toolCallId": {"type": "string"}
                }
              }
            },
            "artifacts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "artifactId": {"type": "string"},
                  "kind": {"type": "string"},
                  "mimeType": {"type": "string"},
                  "byteSize": {"type": "integer"},
                  "title": {"type": "string"},
                  "url": {"type": "string"}
                }
              }
            },
            "toolInvocations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "toolName": {"type": "string"},
                  "msgId": {"type": "string"},
                  "argsJson": {"type": "string"},
                  "resultSummary": {"type": "string"},
                  "durationMs": {"type": "integer"},
                  "status": {"type": "string"}
                }
              }
            },
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
