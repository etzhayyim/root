{
  "lexicon": 1,
  "id": "ai.gftd.apps.chat.listConversations",
  "defs": {
    "main": {
      "type": "query",
      "description": "List the caller's conversations, ordered by last_message_at desc.",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": {"type": "integer", "default": 50, "minimum": 1, "maximum": 200},
          "status": {"type": "string", "enum": ["active", "archived", "all"], "default": "active"},
          "before": {"type": "string", "format": "datetime", "description": "Pagination cursor (last_message_at)."}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["conversations"],
          "properties": {
            "conversations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["convId", "title", "messageCount", "lastMessageAt", "status"],
                "properties": {
                  "convId": {"type": "string"},
                  "title": {"type": "string"},
                  "messageCount": {"type": "integer"},
                  "lastMessageAt": {"type": "string", "format": "datetime"},
                  "status": {"type": "string"},
                  "agentDid": {"type": "string"},
                  "modelHint": {"type": "string"},
                  "pinned": {"type": "boolean"}
                }
              }
            },
            "nextCursor": {"type": "string", "format": "datetime"}
          }
        }
      }
    }
  }
}
