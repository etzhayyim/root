{
  "lexicon": 1,
  "id": "ai.gftd.apps.chat.agentLoop",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Run a single user turn through the LangGraph agent loop with tool calling (code_exec, image_gen, file_save, rag_search, web_search). Non-streaming (returns final assistant message after all tool steps). For streaming use POST gftd.ai/api/chat (SSE).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "convId": {"type": "string"},
            "text": {"type": "string", "maxLength": 32000},
            "tools": {
              "type": "array",
              "description": "Whitelist of tool names; if absent, all enabled tools are available.",
              "items": {"type": "string", "enum": ["code_exec", "image_gen", "file_save", "rag_search", "web_search"]}
            },
            "modelHint": {"type": "string"},
            "tier": {"type": "string", "enum": ["fast", "balanced", "reasoning"], "default": "balanced"},
            "maxIterations": {"type": "integer", "default": 8, "maximum": 16, "description": "Max LLM ↔ tool round trips."}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "convId", "finalMsgId", "content"],
          "properties": {
            "ok": {"type": "boolean"},
            "convId": {"type": "string"},
            "finalMsgId": {"type": "string"},
            "content": {"type": "string"},
            "iterations": {"type": "integer"},
            "toolCalls": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "tool": {"type": "string"},
                  "args": {"type": "string"},
                  "summary": {"type": "string"},
                  "ok": {"type": "boolean"}
                }
              }
            },
            "artifactsCreated": {"type": "array", "items": {"type": "string"}},
            "model": {"type": "string"},
            "totalTokens": {"type": "integer"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
