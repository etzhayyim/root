{
  "lexicon": 1,
  "id": "ai.gftd.apps.chat.sendMessage",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Send a single user message and get the assistant's response (non-streaming, single-shot). For streaming use POST gftd.ai/api/chat (SSE). For multi-turn tool-calling agent loops use ai.gftd.apps.chat.agentLoop.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "convId": {"type": "string", "description": "If absent, a new conversation is created."},
            "text": {"type": "string", "maxLength": 32000},
            "modelHint": {"type": "string", "description": "Optional: 'gemma-4-e4b-it', 'qwen3-30b', etc. Resolved through llm-model-registry."},
            "tier": {"type": "string", "enum": ["fast", "balanced", "reasoning"], "default": "fast"},
            "maxTokens": {"type": "integer", "default": 1024, "maximum": 8192},
            "temperature": {"type": "number", "default": 0.3, "minimum": 0, "maximum": 2}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "convId", "msgId", "role", "content"],
          "properties": {
            "ok": {"type": "boolean"},
            "convId": {"type": "string"},
            "msgId": {"type": "string"},
            "role": {"type": "string"},
            "content": {"type": "string"},
            "model": {"type": "string"},
            "promptTokens": {"type": "integer"},
            "completionTokens": {"type": "integer"},
            "finishReason": {"type": "string"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
