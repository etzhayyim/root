{
  "lexicon": 1,
  "id": "ai.gftd.apps.chat.coverage",
  "defs": {
    "main": {
      "type": "query",
      "description": "Coverage snapshot — total conversations / messages / artifacts / active 24h.",
      "parameters": {
        "type": "params",
        "properties": {
          "asOf": {"type": "string", "format": "datetime"}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["asOf", "conversations", "messages", "artifacts", "active24h"],
          "properties": {
            "asOf": {"type": "string", "format": "datetime"},
            "conversations": {"type": "integer"},
            "messages": {"type": "integer"},
            "artifacts": {"type": "integer"},
            "active24h": {"type": "integer"},
            "totalArtifactBytes": {"type": "integer"}
          }
        }
      }
    }
  }
}
