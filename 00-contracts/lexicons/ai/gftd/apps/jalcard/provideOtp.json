{
  "lexicon": 1,
  "id": "ai.gftd.apps.jalcard.provideOtp",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Resume a paused payoffRevolving process by delivering a 2FA OTP. Publishes LangServer signal 'ai.gftd.apps.jalcard.otpReceived' with correlationKey=processInstanceKey and variable {otp}.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["processInstanceKey", "otp"],
          "properties": {
            "processInstanceKey": { "type": "string" },
            "otp": { "type": "string", "minLength": 4, "maxLength": 12 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "messageKey": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
