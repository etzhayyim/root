{
  "lexicon": 1,
  "id": "ai.gftd.apps.jalcard.payoffRevolving",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Trigger MUFG Nicos JAL card revolving (Raku-Pay) payoff via headless browser. mode='balanceOnly' (read-only) | 'switchAllCourse' (next-cycle full balance) | 'extraPayment' (immediate full payoff). Process pauses at 2FA via ai.gftd.apps.jalcard.provideOtp and at final commit via ai.gftd.apps.jalcard.confirmPayoff (correlationKey = processInstanceKey).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["balanceOnly", "switchAllCourse", "extraPayment"]
            },
            "vaultPath": {
              "type": "string",
              "default": "vault://jalcard/mufg-nicos",
              "description": "Vault prefix; resolves {prefix}/userId, {prefix}/password, optional {prefix}/totp"
            },
            "browserTarget": {
              "type": "string",
              "enum": ["local", "cf-browser"],
              "default": "local"
            },
            "approvalTimeout": {
              "type": "string",
              "default": "PT15M",
              "description": "ISO-8601 duration to wait for confirmPayoff message"
            },
            "otpTimeout": {
              "type": "string",
              "default": "PT5M",
              "description": "ISO-8601 duration to wait for provideOtp message"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "processInstanceKey": { "type": "string" },
            "status": {
              "type": "string",
              "enum": ["started", "balanceOnlyDone", "noBalance", "awaitingOtp", "awaitingApproval", "committed", "canceled", "error"]
            },
            "balanceJpy": { "type": "integer" },
            "snapshotVertexId": { "type": "string" },
            "payoffVertexId": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
