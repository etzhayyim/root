{
  "lexicon": 1,
  "id": "ai.gftd.apps.shosha.agentLoop",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Path F unified agent loop entry. Pulls recent intel + market view + open exposure, runs LLM with shosha system prompt, returns response text. No state mutation. (ADR 260413 agent loop unification)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["prompt"],
          "properties": {
            "prompt": {"type": "string", "maxLength": 4000},
            "tier": {"type": "string", "enum": ["reasoning", "frontier"], "default": "reasoning"},
            "commodityFocus": {"type": "string"},
            "maxTokens": {"type": "integer", "default": 1500, "minimum": 50, "maximum": 4000}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "content", "model"],
          "properties": {
            "ok": {"type": "boolean"},
            "content": {"type": "string"},
            "model": {"type": "string"},
            "latencyMs": {"type": "integer"},
            "intelRowsUsed": {"type": "integer"},
            "marketViewRowsUsed": {"type": "integer"},
            "exposureRowsUsed": {"type": "integer"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
