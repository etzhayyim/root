{
  "lexicon": 1,
  "id": "ai.gftd.apps.shosha.listTrades",
  "defs": {
    "main": {
      "type": "query",
      "description": "List trades with optional filters by side / commodity / counterparty / status / desk.",
      "parameters": {
        "type": "params",
        "properties": {
          "side": {"type": "string", "enum": ["buy", "sell"]},
          "commodity": {"type": "string"},
          "counterpartyVid": {"type": "string"},
          "desk": {"type": "string", "enum": ["procure", "trade", "hedge"]},
          "status": {"type": "string", "enum": ["open", "closed", "cancelled"]},
          "approvalState": {"type": "string", "enum": ["pending", "approved", "rejected"]},
          "openOnly": {"type": "boolean", "default": false},
          "offset": {"type": "integer", "default": 0, "minimum": 0},
          "limit": {"type": "integer", "default": 50, "minimum": 1, "maximum": 200}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items", "offset", "limit", "total"],
          "properties": {
            "items": {"type": "array", "items": {"type": "unknown"}},
            "offset": {"type": "integer"},
            "limit": {"type": "integer"},
            "total": {"type": "integer"}
          }
        }
      }
    }
  }
}
