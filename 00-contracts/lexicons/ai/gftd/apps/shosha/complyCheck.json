{
  "lexicon": 1,
  "id": "ai.gftd.apps.shosha.complyCheck",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Sanctions / compliance check against curated OFAC + EU + JP MOFA + UN lists. Phase 1: static jurisdiction + name-substring + LLM heuristic; Phase 2: live OFAC SDN refresh.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["counterparty"],
          "properties": {
            "counterparty": {"type": "string"},
            "country": {"type": "string", "description": "ISO 3166-1 alpha-2 / alpha-3"},
            "commodity": {"type": "string"},
            "amountUsd": {"type": "number"}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "complyOk", "flags"],
          "properties": {
            "ok": {"type": "boolean"},
            "complyOk": {"type": "boolean"},
            "flags": {"type": "array", "items": {"type": "string"}},
            "rationale": {"type": "string"},
            "checkedLists": {"type": "array", "items": {"type": "string"}},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
