{
  "lexicon": 1,
  "id": "ai.gftd.apps.shosha.getExposure",
  "defs": {
    "main": {
      "type": "query",
      "description": "Aggregated exposure snapshot — net long/short, hedged/unhedged, top counterparty concentration.",
      "parameters": {
        "type": "params",
        "properties": {
          "groupBy": {"type": "string", "enum": ["commodity", "currency", "counterparty", "desk"], "default": "commodity"},
          "openOnly": {"type": "boolean", "default": true}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["asOf", "groupBy", "items"],
          "properties": {
            "asOf": {"type": "string", "format": "datetime"},
            "groupBy": {"type": "string"},
            "items": {"type": "array", "items": {"type": "unknown"}}
          }
        }
      }
    }
  }
}
