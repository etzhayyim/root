{
  "lexicon": 1,
  "id": "ai.gftd.apps.shosha.getMarketView",
  "defs": {
    "main": {
      "type": "query",
      "description": "Latest LLM-synthesized market view per commodity (direction / confidence / price target / rationale).",
      "parameters": {
        "type": "params",
        "properties": {
          "commodity": {"type": "string"},
          "asOfDate": {"type": "string", "format": "date"},
          "limit": {"type": "integer", "default": 20, "minimum": 1, "maximum": 100}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items"],
          "properties": {
            "items": {"type": "array", "items": {"type": "unknown"}}
          }
        }
      }
    }
  }
}
