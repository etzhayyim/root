{
  "lexicon": 1,
  "id": "ai.gftd.apps.shosha.approveTrade",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Approve a pending trade. Validates approval_state='pending', records the decision in vertex_shosha_approval, transitions trade.approval_state to 'approved'. Trade then becomes settle-eligible. Phase 3.4 two-tier routing: required approverRole depends on amount_usd: <$1M any role, $1M-$10M desk-head+, $10M-$50M cro+, >=$50M board.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["tradeId", "approverDid"],
          "properties": {
            "tradeId": {"type": "string"},
            "approverDid": {"type": "string", "description": "DID of the human or agent approving"},
            "approverRole": {"type": "string", "default": "trader", "description": "Authority tier: trader (level 1) / desk-head (2) / cro|risk-officer (3) / board|ceo (4). Phase 3.4 enforces level >= bracket for amount_usd."},
            "rationale": {"type": "string", "maxLength": 2000}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": {"type": "boolean"},
            "approvalId": {"type": "string"},
            "vertexId": {"type": "string"},
            "tradeId": {"type": "string"},
            "approvalState": {"type": "string", "description": "Post-decision state"},
            "decidedAt": {"type": "string", "format": "datetime"},
            "amountUsd": {"type": "number"},
            "requiredRole": {"type": "string", "description": "Set on tier-rejection (Phase 3.4)"},
            "requiredLevel": {"type": "integer", "description": "Set on tier-rejection (Phase 3.4)"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
