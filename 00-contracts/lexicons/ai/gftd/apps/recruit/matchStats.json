{
  "lexicon": 1,
  "id": "ai.gftd.apps.recruit.matchStats",
  "defs": {
    "main": {
      "type": "query",
      "description": "Return cohort-first recruit matching operational counts.",
      "parameters": {
        "type": "params",
        "properties": {
          "iscoCode": { "type": "string" },
          "country": { "type": "string" },
          "minScore": { "type": "number", "minimum": 0, "maximum": 100, "default": 50 }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["candidateCount", "proposalsByState", "decisionEventCount", "privacyMode"],
          "properties": {
            "candidateCount": { "type": "integer" },
            "proposalsByState": {
              "type": "array",
              "items": { "type": "ref", "ref": "#proposalStateCount" }
            },
            "decisionEventCount": { "type": "integer" },
            "privacyMode": { "type": "string", "const": "cohort-first" }
          }
        }
      }
    },
    "proposalStateCount": {
      "type": "object",
      "required": ["proposalState", "count"],
      "properties": {
        "proposalState": { "type": "string" },
        "count": { "type": "integer" }
      }
    }
  }
}
