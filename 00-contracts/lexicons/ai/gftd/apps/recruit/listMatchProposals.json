{
  "lexicon": 1,
  "id": "ai.gftd.apps.recruit.listMatchProposals",
  "defs": {
    "main": {
      "type": "query",
      "description": "List persisted cohort-first recruit match proposals.",
      "parameters": {
        "type": "params",
        "properties": {
          "postingId": { "type": "string" },
          "iscoCode": { "type": "string" },
          "country": { "type": "string" },
          "proposalState": { "type": "string", "enum": ["proposed", "accepted", "rejected", "expired"] },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
          "offset": { "type": "integer", "minimum": 0, "default": 0 }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items", "total", "offset", "limit", "privacyMode"],
          "properties": {
            "items": {
              "type": "array",
              "items": { "type": "ref", "ref": "#proposal" }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" },
            "privacyMode": { "type": "string", "const": "cohort-first" }
          }
        }
      }
    },
    "proposal": {
      "type": "object",
      "required": ["proposalId", "postingId", "iscoCode", "country", "matchScore", "proposalState"],
      "properties": {
        "proposalId": { "type": "string" },
        "postingId": { "type": "string" },
        "postingVid": { "type": "string" },
        "cohortVid": { "type": "string" },
        "iscoCode": { "type": "string" },
        "country": { "type": "string" },
        "matchScore": { "type": "number" },
        "rationale": { "type": "string" },
        "proposalState": { "type": "string" },
        "decisionReason": { "type": "string" },
        "createdAt": { "type": "string", "format": "datetime" },
        "decidedAt": { "type": "string", "format": "datetime" },
        "props": { "type": "unknown" }
      }
    }
  }
}
