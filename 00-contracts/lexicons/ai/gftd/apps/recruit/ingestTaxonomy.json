{
  "lexicon": 1,
  "id": "ai.gftd.apps.recruit.ingestTaxonomy",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Ingest occupation taxonomy batch from public source (ESCO / O*NET / ISCO). Source is gated by governance.dataSources.allowed — commercial sources rejected.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "source": { "type": "string", "enum": ["isco", "esco", "onet"] },
            "sourceLicense": { "type": "string", "description": "e.g. CC-BY-4.0, CC-BY-3.0-IGO, public-domain" },
            "batch": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": { "type": "string" },
                  "iscoCode": { "type": "string" },
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "skills": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["code", "name"]
              }
            }
          },
          "required": ["source", "sourceLicense", "batch"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ingested": { "type": "integer" },
            "skipped": { "type": "integer" },
            "errors": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["ingested", "skipped"]
        }
      }
    }
  }
}
