{
  "lexicon": 1,
  "id": "ai.gftd.apps.recruit.proposeCohortMatch",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Persist a cohort-first match proposal for a job posting. The payload must not contain individual candidate PII.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["postingId", "postingVid", "cohortVid", "iscoCode", "country", "matchScore"],
          "properties": {
            "proposalId": { "type": "string", "description": "Optional caller-provided stable id. Server may derive one when absent." },
            "postingId": { "type": "string" },
            "postingVid": { "type": "string" },
            "cohortVid": { "type": "string" },
            "iscoCode": { "type": "string" },
            "country": { "type": "string" },
            "matchScore": { "type": "number", "minimum": 0, "maximum": 100 },
            "rationale": { "type": "string", "maxLength": 4000 },
            "props": { "type": "unknown", "description": "PII-free evidence bundle, usually copied from recommendCohorts output." }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["proposalId", "proposalState", "privacyMode"],
          "properties": {
            "proposalId": { "type": "string" },
            "proposalState": { "type": "string", "enum": ["proposed", "accepted", "rejected", "expired"] },
            "privacyMode": { "type": "string", "const": "cohort-first" }
          }
        }
      }
    }
  }
}
