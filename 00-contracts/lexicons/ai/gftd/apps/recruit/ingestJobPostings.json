{
  "lexicon": 1,
  "id": "ai.gftd.apps.recruit.ingestJobPostings",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Ingest real public job postings from allowlisted public ATS boards into vertex_job_posting.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "platform": { "type": "string", "enum": ["all", "greenhouse", "lever", "ashby"], "default": "all" },
            "limit": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 5000 },
            "batchSize": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 200 },
            "allowUnanchored": { "type": "boolean", "default": false },
            "ignoreCheckpoint": { "type": "boolean", "default": false },
            "dryRun": { "type": "boolean", "default": false }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["platform", "fetched", "inserted", "skipped", "privacyMode"],
          "properties": {
            "platform": { "type": "string" },
            "fetched": { "type": "integer" },
            "inserted": { "type": "integer" },
            "skipped": { "type": "integer" },
            "dryRun": { "type": "boolean" },
            "allowUnanchored": { "type": "boolean" },
            "ignoreCheckpoint": { "type": "boolean" },
            "privacyMode": { "type": "string", "const": "public-postings-only" }
          }
        }
      }
    }
  }
}
