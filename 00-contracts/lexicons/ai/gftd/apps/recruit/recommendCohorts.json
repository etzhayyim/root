{
  "lexicon": 1,
  "id": "ai.gftd.apps.recruit.recommendCohorts",
  "defs": {
    "main": {
      "type": "query",
      "description": "Recommend aggregate talent cohorts for public job postings. Cohort-first only: no individual candidate PII is read or returned.",
      "parameters": {
        "type": "params",
        "properties": {
          "postingId": { "type": "string", "description": "Optional source_id or vertex-derived posting id." },
          "iscoCode": { "type": "string", "description": "ISCO-08 code." },
          "country": { "type": "string", "description": "ISO-3166-1 alpha-3." },
          "minScore": { "type": "number", "minimum": 0, "maximum": 100, "default": 50 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
          "offset": { "type": "integer", "minimum": 0, "default": 0 }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items", "total", "offset", "limit", "privacyMode"],
          "properties": {
            "items": {
              "type": "array",
              "items": { "type": "ref", "ref": "#recommendation" }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" },
            "privacyMode": { "type": "string", "const": "cohort-first" }
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "required": ["postingId", "iscoCode", "country", "matchScore"],
      "properties": {
        "postingId": { "type": "string" },
        "postingVid": { "type": "string" },
        "title": { "type": "string" },
        "employerDid": { "type": "string" },
        "employerName": { "type": "string" },
        "source": { "type": "string" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "iscoCode": { "type": "string" },
        "country": { "type": "string" },
        "location": { "type": "string" },
        "cohortVid": { "type": "string" },
        "supplySizeThousands": { "type": "number" },
        "demandScore": { "type": "number" },
        "pressSignalCount": { "type": "integer" },
        "demandPostingCount": { "type": "integer" },
        "typicalSalary": { "type": "number" },
        "salaryCurrency": { "type": "string" },
        "topSkills": { "type": "string" },
        "matchScore": { "type": "number" }
      }
    }
  }
}
