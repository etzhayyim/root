{
  "lexicon": 1,
  "id": "ai.gftd.apps.recruit.getPosting",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a single job posting with legal-entity JOIN.",
      "parameters": {
        "type": "params",
        "properties": {
          "id": { "type": "string" }
        },
        "required": ["id"]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "posting": { "type": "ref", "ref": "ai.gftd.apps.recruit.listPostings#posting" },
            "employer": {
              "type": "object",
              "properties": {
                "did": { "type": "string" },
                "name": { "type": "string" },
                "lei": { "type": "string" },
                "jurisdiction": { "type": "string" },
                "registryId": { "type": "string" }
              }
            }
          },
          "required": ["posting"]
        }
      }
    }
  }
}
