            "employers": { "type": "integer" },
            "countries": { "type": "integer" },
            "bySource": {
              "type": "object",
              "properties": {
                "esco": { "type": "integer" },
                "onet": { "type": "integer" },
                "eures": { "type": "integer" },
                "hellowork": { "type": "integer" },
                "usajobs": { "type": "integer" },
                "jobbank": { "type": "integer" }
              }
