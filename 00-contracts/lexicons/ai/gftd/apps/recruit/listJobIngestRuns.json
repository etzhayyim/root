{
  "lexicon": 1,
  "id": "ai.gftd.apps.recruit.listJobIngestRuns",
  "defs": {
    "main": {
      "type": "query",
      "description": "List recent public job posting ingest runs for recruit operations.",
      "parameters": {
        "type": "params",
        "properties": {
          "platform": { "type": "string", "enum": ["all", "greenhouse", "lever", "ashby"] },
          "status": { "type": "string", "enum": ["succeeded", "failed"] },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
          "offset": { "type": "integer", "minimum": 0, "default": 0 }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items", "offset", "limit", "privacyMode"],
          "properties": {
            "items": {
              "type": "array",
              "items": { "type": "ref", "ref": "#run" }
            },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" },
            "privacyMode": { "type": "string", "const": "public-postings-only" }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "required": ["runId", "platform", "status", "startedAt"],
      "properties": {
        "runId": { "type": "string" },
        "platform": { "type": "string" },
        "status": { "type": "string" },
        "fetched": { "type": "integer" },
        "inserted": { "type": "integer" },
        "skipped": { "type": "integer" },
        "limit": { "type": "integer" },
        "batchSize": { "type": "integer" },
        "startedAt": { "type": "string", "format": "datetime" },
        "finishedAt": { "type": "string", "format": "datetime" },
        "durationMs": { "type": "integer" },
        "error": { "type": "string" }
      }
    }
  }
}
