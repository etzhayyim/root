{
  "lexicon": 1,
  "id": "ai.gftd.apps.crm.reviewLei",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Verify or reject a candidate CRM to GLEIF LEI match. Updates edge_crm_open_lei_match and synchronizes the source CRM lei_* columns.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["action"],
          "properties": {
            "edgeId": { "type": "string" },
            "crmSystem": { "type": "string", "enum": ["lawfirm", "hubspot"] },
            "entityType": { "type": "string", "enum": ["lead", "tenant", "company"] },
            "crmSourceId": { "type": "string" },
            "lei": { "type": "string" },
            "action": { "type": "string", "enum": ["verify", "reject"] },
            "actorDid": { "type": "string" },
            "evidenceNote": { "type": "string" },
            "dryRun": { "type": "boolean", "default": false }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "edgeId": { "type": "string" },
            "crmSystem": { "type": "string" },
            "entityType": { "type": "string" },
            "crmSourceId": { "type": "string" },
            "lei": { "type": "string" },
            "matchStatus": { "type": "string" },
            "verifiedAt": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
