{
  "lexicon": 1,
  "id": "ai.gftd.apps.crm.listLeiPending",
  "defs": {
    "main": {
      "type": "query",
      "description": "List CRM records that still need LEI resolution from view_crm_lei_pending_resolution.",
      "parameters": {
        "type": "params",
        "properties": {
          "crmSystem": { "type": "string", "enum": ["lawfirm", "hubspot"] },
          "entityType": { "type": "string", "enum": ["lead", "tenant", "company"] },
          "country": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 },
          "offset": { "type": "integer", "minimum": 0, "default": 0 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["records", "limit", "offset"],
          "properties": {
            "records": {
              "type": "array",
              "items": { "type": "ref", "ref": "#pendingRecord" }
            },
            "limit": { "type": "integer" },
            "offset": { "type": "integer" }
          }
        }
      }
    },
    "pendingRecord": {
      "type": "object",
      "properties": {
        "crmSystem": { "type": "string" },
        "entityType": { "type": "string" },
        "crmVertexId": { "type": "string" },
        "crmSourceId": { "type": "string" },
        "legalName": { "type": "string" },
        "country": { "type": "string" },
        "lei": { "type": "string" },
        "leiMatchStatus": { "type": "string" },
        "lastSeenAt": { "type": "string" }
      },
      "required": ["crmSystem", "entityType", "crmVertexId"]
    }
  }
}
