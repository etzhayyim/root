{
  "lexicon": 1,
  "id": "ai.gftd.apps.crm.listLeiLinks",
  "defs": {
    "main": {
      "type": "query",
      "description": "List verified or candidate CRM to GLEIF LEI links from view_crm_lei_linked_entity.",
      "parameters": {
        "type": "params",
        "properties": {
          "crmSystem": { "type": "string", "enum": ["lawfirm", "hubspot"] },
          "entityType": { "type": "string", "enum": ["lead", "tenant", "company"] },
          "matchStatus": { "type": "string", "enum": ["candidate", "verified", "rejected", "stale"] },
          "lei": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 },
          "offset": { "type": "integer", "minimum": 0, "default": 0 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["links", "limit", "offset"],
          "properties": {
            "links": {
              "type": "array",
              "items": { "type": "ref", "ref": "#leiLink" }
            },
            "limit": { "type": "integer" },
            "offset": { "type": "integer" }
          }
        }
      }
    },
    "leiLink": {
      "type": "object",
      "properties": {
        "edgeId": { "type": "string" },
        "crmSystem": { "type": "string" },
        "entityType": { "type": "string" },
        "crmSourceId": { "type": "string" },
        "crmVertexId": { "type": "string" },
        "leiVertexId": { "type": "string" },
        "lei": { "type": "string" },
        "matchMethod": { "type": "string" },
        "matchStatus": { "type": "string" },
        "confidencePermille": { "type": "integer" },
        "crmLegalName": { "type": "string" },
        "gleifLegalName": { "type": "string" },
        "registrationStatus": { "type": "string" },
        "verifiedAt": { "type": "string" }
      },
      "required": ["edgeId", "crmSystem", "entityType", "crmVertexId", "lei"]
    }
  }
}
