{
  "lexicon": 1,
  "id": "ai.gftd.apps.crm.resolveLei",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Resolve a CRM lead, tenant, or HubSpot company to a GLEIF LEI entity. Writes edge_crm_open_lei_match and updates the source row's lei_* columns as verified or candidate.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["crmSystem", "entityType", "crmVertexId"],
          "properties": {
            "crmSystem": { "type": "string", "enum": ["lawfirm", "hubspot"] },
            "entityType": { "type": "string", "enum": ["lead", "tenant", "company"] },
            "crmVertexId": { "type": "string" },
            "crmSourceId": { "type": "string" },
            "legalName": { "type": "string" },
            "country": { "type": "string", "description": "ISO country code from CRM, if known." },
            "lei": { "type": "string", "description": "Known candidate LEI. If absent, resolver searches vertex_open_lei_entity by name/country." },
            "matchMethod": {
              "type": "string",
              "enum": [
                "exact_lei",
                "exact_name_country",
                "normalized_exact_name_country",
                "normalized_name_country",
                "token_subset_country",
                "fuzzy_name_country",
                "manual",
                "agent_candidate"
              ],
              "default": "agent_candidate"
            },
            "confidencePermille": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 0 },
            "verify": { "type": "boolean", "default": false },
            "evidenceUri": { "type": "string" },
            "evidenceNote": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "edgeId": { "type": "string" },
            "crmVertexId": { "type": "string" },
            "leiVertexId": { "type": "string" },
            "lei": { "type": "string" },
            "matchStatus": { "type": "string" },
            "confidencePermille": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
