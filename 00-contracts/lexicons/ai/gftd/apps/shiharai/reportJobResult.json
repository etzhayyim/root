{
  "lexicon": 1,
  "id": "ai.gftd.apps.shiharai.reportJobResult",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Local daemon reports Playwright run outcome. outcome ∈ {awaiting-confirm, committed, failed}. Never includes credential material.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["jobId", "outcome"],
          "properties": {
            "jobId": { "type": "string" },
            "outcome": { "type": "string", "enum": ["awaiting-confirm", "committed", "failed"] },
            "pageSnapshotCid": { "type": "string", "description": "CID of sanitized HTML snapshot in B2/IPFS (no PII/creds)" },
            "resultTxId": { "type": "string", "description": "biller-assigned transaction id (if any)" },
            "errorMessage": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "jobId": { "type": "string" },
            "outcome": { "type": "string" },
            "accepted": { "type": "boolean" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
