{
  "lexicon": 1,
  "id": "ai.gftd.apps.shiharai.extractBill",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Parse a bill from a raw email body: issuer, amount (JPY), due date, customer number, pay URL. Emits ai.gftd.apps.shiharai.bill record.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["emailBody"],
          "properties": {
            "emailBody": { "type": "string" },
            "emailSubject": { "type": "string" },
            "emailFrom": { "type": "string" },
            "sourceEmailId": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "billId": { "type": "string" },
            "vertexId": { "type": "string" },
            "bill": { "type": "unknown" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
