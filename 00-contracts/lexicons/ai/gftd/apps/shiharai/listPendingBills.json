{
  "lexicon": 1,
  "id": "ai.gftd.apps.shiharai.listPendingBills",
  "defs": {
    "main": {
      "type": "query",
      "description": "List pending bills (state=due or overdue), optionally filtered by billerHandle.",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
          "billerHandle": { "type": "string" },
          "includeOverdue": { "type": "boolean", "default": true }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "bills": { "type": "array", "items": { "type": "unknown" } },
            "sql": { "type": "string" },
            "limit": { "type": "integer" },
            "billerHandle": { "type": "string" },
            "includeOverdue": { "type": "boolean" }
          }
        }
      }
    }
  }
}
