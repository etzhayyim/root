{
  "lexicon": 1,
  "id": "ai.gftd.apps.shiharai.dequeueJob",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Local Playwright daemon long-polls: atomically claim one pending job matching allowed billerHandles.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["daemonId"],
          "properties": {
            "daemonId": { "type": "string" },
            "billerHandles": { "type": "array", "items": { "type": "string" } },
            "longPollSeconds": { "type": "integer", "minimum": 0, "maximum": 60, "default": 15 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "job": { "type": "unknown" },
            "sql": { "type": "string" },
            "daemonId": { "type": "string" },
            "note": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
