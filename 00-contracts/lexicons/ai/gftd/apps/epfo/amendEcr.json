{
  "lexicon": 1,
  "id": "ai.gftd.apps.epfo.amendEcr",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0052. File an amendment against a monthly ECR. Starts BPMN process epfo_amend_ecr.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "vertexId": { "type": "string" },
            "employerOrgId": { "type": "string" },
            "establishmentPfCode": { "type": "string" },
            "wageMonth": { "type": "string", "description": "YYYY-MM wage month being corrected." },
            "amendmentDate": { "type": "string", "description": "ISO 8601 date when the correction took effect." },
            "amendmentReason": {
              "type": "string",
              "enum": ["joinedMember", "leftMember", "wageRevision", "uanCorrection", "rateOverride"]
            },
            "memberUan": { "type": "string", "description": "Optional UAN directly affected by the amendment." },
            "amendmentDescription": { "type": "string" },
            "amendmentPayload": { "type": "string", "description": "signal:v1: encrypted JSON delta payload." }
          },
          "required": ["establishmentPfCode", "wageMonth", "amendmentDate", "amendmentReason"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "approvalRequired": { "type": "boolean" },
            "effectiveWageMonth": { "type": "string" },
            "error": { "type": "string" }
          },
          "required": []
        }
      }
    }
  }
}
