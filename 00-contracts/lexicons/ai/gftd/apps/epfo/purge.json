{
  "lexicon": 1,
  "id": "ai.gftd.apps.epfo.purge",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0052. System cron entry point. Hard-deletes Tier 3 EPFO roster payloads older than 7 years while retaining Tier 1 audit metadata with status=purged.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "asOf": { "type": "string", "description": "Override 'now' (ISO 8601). Test/dry-run only." },
            "dryRun": { "type": "boolean", "default": false }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "purgedCount": { "type": "integer" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          },
          "required": []
        }
      }
    }
  }
}
