{
  "lexicon": 1,
  "id": "ai.gftd.apps.epfo.review",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0052. Finance-controller verdict on a monthly ECR or amendment.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "vertexId": { "type": "string" },
            "verdict": { "type": "string", "enum": ["approve", "reject"] },
            "comment": { "type": "string", "description": "Finance review comment surfaced back to payroll on reject." }
          },
          "required": ["vertexId", "verdict"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "newStatus": { "type": "string", "description": "submitted|rejected|amended" },
            "error": { "type": "string" }
          },
          "required": []
        }
      }
    }
  }
}
