{
  "lexicon": 1,
  "id": "ai.gftd.apps.talent.registerSelf",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Self-sovereign talent profile registration. caller.did MUST equal subject. Identifying fields are Signal E2E encrypted before storage (ADR-0018, signal:v1:{ciphertext}).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "iscoCode": { "type": "string" },
            "country": { "type": "string", "description": "ISO-3166-1 alpha-3" },
            "experienceBand": { "type": "string", "enum": ["entry", "mid", "senior", "lead"] },
            "skillsPublic": { "type": "array", "items": { "type": "string" }, "description": "Public skill tags (ESCO skill IDs preferred)" },
            "identifyingFields": {
              "type": "object",
              "description": "Will be Signal E2E encrypted before storage. Server MUST reject plaintext.",
              "properties": {
                "fullName": { "type": "string" },
                "email": { "type": "string" },
                "phone": { "type": "string" },
                "address": { "type": "string" },
                "dateOfBirth": { "type": "string" },
                "governmentId": { "type": "string" }
              }
            },
            "consentRecordUri": { "type": "string", "description": "AT URI of the consent record (ai.gftd.consent.grant)" }
          },
          "required": ["iscoCode", "country", "experienceBand", "consentRecordUri"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "profileUri": { "type": "string", "format": "at-uri" },
            "cohortCode": { "type": "string" }
          },
          "required": ["profileUri"]
        }
      }
    }
  }
}
