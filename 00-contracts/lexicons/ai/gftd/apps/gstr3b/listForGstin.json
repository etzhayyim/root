{
  "lexicon": 1,
  "id": "ai.gftd.apps.gstr3b.listForGstin",
  "defs": {
    "main": {
      "type": "query",
      "description": "ADR-0056. List GSTR-3B returns for one GSTIN. Tier 1 metadata only.",
      "parameters": {
        "type": "params",
        "properties": {
          "gstinHash": { "type": "string" },
          "fromTaxPeriod": { "type": "string" },
          "toTaxPeriod": { "type": "string" },
          "status": { "type": "string", "description": "Optional filter: draft|submitted|reviewed|rejected|filed|amended|purged" },
          "limit": { "type": "integer", "default": 24, "minimum": 1, "maximum": 120 },
          "cursor": { "type": "string" }
        },
        "required": ["gstinHash"]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "vertexId": { "type": "string" },
                  "taxPeriod": { "type": "string" },
                  "status": { "type": "string" },
                  "arn": { "type": "string" },
                  "totalOutwardTaxInrPaise": { "type": "integer" },
                  "totalInwardItcInrPaise": { "type": "integer" },
                  "totalNetTaxInrPaise": { "type": "integer" },
                  "filedAt": { "type": "string" }
                }
              }
            },
            "cursor": { "type": "string" },
            "error": { "type": "string" }
          },
          "required": ["items"]
        }
      }
    }
  }
}
