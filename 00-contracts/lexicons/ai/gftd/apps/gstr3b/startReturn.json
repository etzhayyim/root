{
  "lexicon": 1,
  "id": "ai.gftd.apps.gstr3b.startReturn",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0056. Begin a new GSTR-3B monthly return for a {GSTIN, taxPeriod}.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "gstinHash": { "type": "string", "description": "sha256(GSTIN). Raw GSTIN only in Tier 3." },
            "taxPeriod": { "type": "string", "description": "YYYY-MM" },
            "filerDid": { "type": "string" }
          },
          "required": ["gstinHash", "taxPeriod"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
