{
  "lexicon": 1,
  "id": "ai.gftd.apps.gstr3b.fileReturn",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0056. Final-file GSTR-3B with portal ARN. Phase 1: ARN entered manually after gst.gov.in submit.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "vertexId": { "type": "string" },
            "arn": { "type": "string", "description": "Acknowledgement Reference Number from gst.gov.in" },
            "filedVia": { "type": "string", "enum": ["evc", "dsc"] },
            "filedAt": { "type": "string" }
          },
          "required": ["vertexId", "arn", "filedVia"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "arn": { "type": "string" },
            "newStatus": { "type": "string" },
            "kaikeiPropagated": { "type": "boolean" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
