{
  "lexicon": 1,
  "id": "ai.gftd.apps.kabi.extendHypha",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Extend a hypha (nutrient flow channel) from one agent to another. Creates or strengthens an edge_kabi_hypha directed connection. High-η connections grow; low-η connections are candidate for pruning.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "srcAgentDid": { "type": "string", "description": "Source agent DID" },
            "dstAgentDid": { "type": "string", "description": "Destination agent DID" },
            "eta": { "type": "number", "description": "Shannon η score of source agent [0,1]" },
            "flow": { "type": "number", "description": "Initial nutrient flow value" }
          },
          "required": ["srcAgentDid", "dstAgentDid", "eta"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "edgeId": { "type": "string" },
            "status": { "type": "string" },
            "error": { "type": "string" }
          },
          "required": ["edgeId", "status"]
        }
      }
    }
  }
}
