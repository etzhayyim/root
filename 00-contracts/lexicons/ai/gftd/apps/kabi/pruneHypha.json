{
  "lexicon": 1,
  "id": "ai.gftd.apps.kabi.pruneHypha",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Prune (soft-delete) a hypha when η drops below threshold. Sets pruned_at on edge_kabi_hypha. Pruned hyphae remain in history but are excluded from mv_kabi_nutrient_flow.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "edgeId": { "type": "string", "description": "edge_kabi_hypha edge_id to prune" },
            "reason": { "type": "string", "description": "Reason for pruning (low-η / stress / anastomosis-fail)" }
          },
          "required": ["edgeId"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "edgeId": { "type": "string" },
            "prunedAt": { "type": "string" },
            "error": { "type": "string" }
          },
          "required": ["edgeId", "prunedAt"]
        }
      }
    }
  }
}
