{
  "lexicon": 1,
  "id": "ai.gftd.apps.kabi.getNetwork",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get the kabi network summary for a root agent DID. Returns vertex_kabi_network stats and active hypha count from mv_kabi_nutrient_flow.",
      "parameters": {
        "type": "params",
        "properties": {
          "rootAgentDid": { "type": "string", "description": "Root agent DID of the kabi network" }
        },
        "required": ["rootAgentDid"]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "vertexId": { "type": "string" },
            "rootAgentDid": { "type": "string" },
            "hyphaCount": { "type": "integer" },
            "totalFlow": { "type": "number" },
            "agentCount": { "type": "integer" },
            "error": { "type": "string" }
          },
          "required": ["rootAgentDid"]
        }
      }
    }
  }
}
