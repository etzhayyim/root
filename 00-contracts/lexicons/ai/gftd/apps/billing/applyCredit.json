{
  "lexicon": 1,
  "id": "ai.gftd.apps.billing.applyCredit",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Apply a one-time credit (refund / startup credit / migration credit / churn save) to an org's next invoice. Records `vertex_billing_credit` row; the next `generateInvoice` BPMN consumes outstanding credits in FIFO order until exhausted.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["orgDid", "amountJpyMicro", "kind", "approver"],
          "properties": {
            "orgDid": {"type": "string"},
            "amountJpyMicro": {"type": "integer", "minimum": 1, "description": "Credit amount in JPY-micro. Goodwill / startup credits typically ¥10,000 - ¥1,000,000."},
            "kind": {"type": "string", "enum": ["refund", "startup_credit", "migration_credit", "churn_save", "service_credit", "promotional"]},
            "approver": {"type": "string"},
            "approverRole": {"type": "string", "enum": ["sales-rep", "csm", "cfo", "ceo"]},
            "rationale": {"type": "string", "maxLength": 2000},
            "expiresAt": {"type": "string", "format": "datetime", "description": "Credit expiry (defaults to +90 days)."}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "creditId", "orgDid", "remainingBalanceJpyMicro"],
          "properties": {
            "ok": {"type": "boolean"},
            "creditId": {"type": "string"},
            "orgDid": {"type": "string"},
            "amountJpyMicro": {"type": "integer"},
            "remainingBalanceJpyMicro": {"type": "integer", "description": "Sum of all unconsumed credits for the org after this insert."},
            "expiresAt": {"type": "string", "format": "datetime"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
