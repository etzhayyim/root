{
  "lexicon": 1,
  "id": "ai.gftd.apps.billing.coverage",
  "defs": {
    "main": {
      "type": "query",
      "description": "Coverage snapshot — counts of paying orgs / events ingested last 24h / margin actuals / overage alerts. Used by `RemoteTrigger` soak monitor and CFO dashboard.",
      "parameters": {
        "type": "params",
        "properties": {
          "asOf": {"type": "string", "format": "datetime"}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["asOf", "orgsTotal", "orgsFree", "orgsPaying", "eventsLast24h", "openInvoices", "overageAlerts", "marginActualPct"],
          "properties": {
            "asOf": {"type": "string", "format": "datetime"},
            "orgsTotal": {"type": "integer"},
            "orgsFree": {"type": "integer"},
            "orgsPaying": {"type": "integer", "description": "starter + developer + team + business + enterprise"},
            "eventsLast24h": {"type": "integer"},
            "openInvoices": {"type": "integer", "description": "status IN (draft, issued, overdue)"},
            "overageAlerts": {"type": "integer", "description": "rows in mv_billing_quota_breach with alertLevel != ok"},
            "marginActualPct": {"type": "number", "description": "Trailing 30d realized gross margin from mv_billing_margin_actual."},
            "billedLast24hJpyMicro": {"type": "integer"}
          }
        }
      }
    }
  }
}
