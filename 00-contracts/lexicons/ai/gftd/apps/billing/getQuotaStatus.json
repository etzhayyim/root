{
  "lexicon": 1,
  "id": "ai.gftd.apps.billing.getQuotaStatus",
  "defs": {
    "main": {
      "type": "query",
      "description": "Per-org quota utilization across all plan limits. Reads `mv_billing_quota_breach` (streaming MV — utilization >= 80% / 100% / 150%). Used by client dashboards and `detectOverage` BPMN.",
      "parameters": {
        "type": "params",
        "required": ["orgDid"],
        "properties": {
          "orgDid": {"type": "string"}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["orgDid", "plan", "rows"],
          "properties": {
            "orgDid": {"type": "string"},
            "plan": {"type": "string", "enum": ["free", "starter", "developer", "team", "business", "enterprise"]},
            "billingPeriodStart": {"type": "string", "format": "date"},
            "billingPeriodEnd": {"type": "string", "format": "date"},
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["metric", "product", "included", "consumed", "utilizationPct", "alertLevel"],
                "properties": {
                  "metric": {"type": "string"},
                  "product": {"type": "string"},
                  "included": {"type": "number", "description": "Plan-included quota in metric unit."},
                  "consumed": {"type": "number"},
                  "utilizationPct": {"type": "number"},
                  "overageQty": {"type": "number"},
                  "overageBilledJpyMicro": {"type": "integer"},
                  "alertLevel": {"type": "string", "enum": ["ok", "warn80", "exceeded", "critical150"]}
                }
              }
            }
          }
        }
      }
    }
  }
}
