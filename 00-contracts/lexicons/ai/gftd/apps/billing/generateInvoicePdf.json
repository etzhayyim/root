{
  "lexicon": 1,
  "id": "ai.gftd.apps.billing.generateInvoicePdf",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Render the 適格請求書 (qualified invoice) PDF for a single invoice. Caller MUST be admin or the owning org. Reads invoice + line items, composes Japanese-tax-law-compliant PDF (T9007028460042 invoice number, 適格請求書発行事業者 wording, internal-tax breakdown), and uploads to B2 `gftd-billing-archive` bucket via `yata.storage.put`.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["invoiceId"],
          "properties": {
            "invoiceId": {"type": "string"},
            "lang":      {"type": "string", "enum": ["ja", "en"], "default": "ja"},
            "force":     {"type": "boolean", "default": false, "description": "Re-render even if a PDF already exists."}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "invoiceId", "b2Key"],
          "properties": {
            "ok": {"type": "boolean"},
            "invoiceId": {"type": "string"},
            "b2Key": {"type": "string"},
            "sha256": {"type": "string"},
            "sizeBytes": {"type": "integer"},
            "renderedAt": {"type": "string", "format": "datetime"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
