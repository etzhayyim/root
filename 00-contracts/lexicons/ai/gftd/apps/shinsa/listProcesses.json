{
  "lexicon": 1,
  "id": "ai.gftd.apps.shinsa.listProcesses",
  "defs": {
    "main": {
      "type": "query",
      "description": "List 審査 review processes with optional type/stage filter.",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "properties": {
          "processType": { "type": "string" },
          "issuingAuthorityDid": { "type": "string", "format": "did" },
          "applicantDid": { "type": "string", "format": "did" },
          "domain": { "type": "string" },
          "stage": { "type": "string" },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "required": ["processes", "total", "offset", "limit"], "properties": { "processes": { "type": "array", "items": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "processType": { "type": "string" }, "issuingAuthorityDid": { "type": "string", "format": "did" }, "stage": { "type": "string" }, "submittedAt": { "type": "string", "format": "datetime" } } } }, "total": { "type": "integer" }, "offset": { "type": "integer" }, "limit": { "type": "integer" } } } }
    }
  }
}
