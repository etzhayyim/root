{
  "lexicon": 1,
  "id": "ai.gftd.apps.news.socialArbitrageIntel",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Start the LangServer social-arbitrage intel pipeline for news.etzhayyim.com.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "seedUrls": { "type": "array", "items": { "type": "object" } },
            "topic": { "type": "string" },
            "region": { "type": "string" },
            "publish": { "type": "boolean" }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "draft": { "type": "object" },
            "intelReport": { "type": "object" },
            "auditRkey": { "type": "string" }
          },
          "required": []
        }
      }
    }
  }
}
