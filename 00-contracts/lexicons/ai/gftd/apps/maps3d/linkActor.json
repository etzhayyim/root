{
  "lexicon": 1,
  "id": "ai.gftd.apps.maps3d.linkActor",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "LangGraph actor disambiguation. For each VisionResult detection, search Wikidata SPARQL + GLEIF + OSM operator/owner tags + Murakumo LLM disambiguator → emit a candidate `did:web:maps.gftd.ai:registry:*:{code}` plus confidence. Strong matches get an `Operates` / `OwnsProperty` edge to the host Building vertex; weak matches stay as VisionResult-only. Per ADR-0036 the worker writes vertex / edge rows directly via Hyperdrive, no PDS round-trip.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["tileH3", "detections"],
          "properties": {
            "tileH3": { "type": "string" },
            "detections": { "type": "array", "items": { "type": "unknown" } },
            "minConfidence": { "type": "number", "description": "Skip emitting an edge below this confidence (default 0.7)." }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["tileH3", "links"],
          "properties": {
            "tileH3": { "type": "string" },
            "links": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["detectionId", "actorDid", "confidence", "source"],
                "properties": {
                  "detectionId": { "type": "string" },
                  "actorDid": { "type": "string", "description": "Resolved registry-aliased DID, e.g. did:web:maps.gftd.ai:registry:wikidata:Q38076." },
                  "actorLabel": { "type": "string" },
                  "edgeKind": { "type": "string", "description": "Operates | OwnsProperty | RegisteredAt | Manages | (skip)." },
                  "buildingVertexId": { "type": "string", "description": "vertex_id of the linked Building, when known." },
                  "confidence": { "type": "number" },
                  "source": { "type": "string", "description": "wikidata | gleif | osm | llm-disambiguate." },
                  "evidenceJson": { "type": "string", "description": "Compact JSON of the disambiguation trace for audit." }
                }
              }
            }
          }
        }
      }
    }
  }
}
