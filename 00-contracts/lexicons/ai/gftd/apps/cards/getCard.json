{
  "lexicon": 1,
  "id": "ai.gftd.apps.cards.getCard",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get details of an issued card.",
      "parameters": {
        "type": "params",
        "required": ["userId", "cardId"],
        "properties": {
          "userId": { "type": "string" },
          "cardId": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "status": { "type": "string" },
            "cardType": { "type": "string" },
            "last4": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
