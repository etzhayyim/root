{
  "lexicon": 1,
  "id": "ai.gftd.apps.cards.summarize",
  "defs": {
    "main": {
      "type": "query",
      "description": "Return a summary of the cards account: balance, cardholder count, active cards, recent authorizations.",
      "parameters": {
        "type": "params",
        "properties": {
          "userId": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "balance": { "type": "object" },
            "totalCardholders": { "type": "integer" },
            "totalCards": { "type": "integer" },
            "totalAuthorizations": { "type": "integer" },
            "recentAuthorizations": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    }
  }
}
