{
  "lexicon": 1,
  "id": "ai.gftd.apps.cards.createCardholder",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create a Stripe Issuing cardholder (individual or company).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["userId", "name", "email"],
          "properties": {
            "userId": { "type": "string" },
            "name": { "type": "string" },
            "email": { "type": "string" },
            "phone": { "type": "string" },
            "billingAddress": { "type": "object", "properties": { "line1": { "type": "string" }, "line2": { "type": "string" }, "city": { "type": "string" }, "state": { "type": "string" }, "postalCode": { "type": "string" }, "country": { "type": "string" } } }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "status": { "type": "string" },
            "cardholder": { "type": "object" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
