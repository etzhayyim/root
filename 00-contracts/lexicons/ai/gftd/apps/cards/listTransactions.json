{
  "lexicon": 1,
  "id": "ai.gftd.apps.cards.listTransactions",
  "defs": {
    "main": {
      "type": "query",
      "description": "List Stripe Issuing transactions for a user, optionally filtered by card.",
      "parameters": {
        "type": "params",
        "required": ["userId"],
        "properties": {
          "userId": { "type": "string" },
          "cardId": { "type": "string" },
          "limit": { "type": "integer" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "items": { "type": "array", "items": { "type": "object" } },
            "total": { "type": "integer" }
          }
        }
      }
    }
  }
}
