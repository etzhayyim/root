{
  "lexicon": 1,
  "id": "ai.gftd.apps.cards.createDispute",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "File a dispute for a Stripe Issuing transaction.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["transactionId", "reason"],
          "properties": {
            "transactionId": { "type": "string" },
            "reason": { "type": "string", "description": "fraudulent | other | duplicate | merchandise_not_as_described | not_received | service_not_as_described" },
            "explanation": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "disputeId": { "type": "string" },
            "status": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
