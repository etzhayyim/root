{
  "lexicon": 1,
  "id": "ai.gftd.apps.cards.topUp",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Add funds to the Stripe Issuing balance.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["amount", "currency"],
          "properties": {
            "amount": { "type": "integer" },
            "currency": { "type": "string" },
            "description": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "topupId": { "type": "string" },
            "amount": { "type": "integer" },
            "currency": { "type": "string" },
            "status": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
