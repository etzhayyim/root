{
  "lexicon": 1,
  "id": "ai.gftd.apps.cards.freezeCard",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Temporarily freeze (set inactive) an issued card.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["userId", "cardId"],
          "properties": {
            "userId": { "type": "string" },
            "cardId": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "status": { "type": "string" },
            "cardId": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
