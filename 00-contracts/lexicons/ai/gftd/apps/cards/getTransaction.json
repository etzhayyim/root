{
  "lexicon": 1,
  "id": "ai.gftd.apps.cards.getTransaction",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get details of a Stripe Issuing transaction.",
      "parameters": {
        "type": "params",
        "required": ["userId", "transactionId"],
        "properties": {
          "userId": { "type": "string" },
          "transactionId": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "amount": { "type": "integer" },
            "currency": { "type": "string" },
            "type": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
