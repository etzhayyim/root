{
  "lexicon": 1,
  "id": "ai.gftd.apps.cards.issueCard",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Issue a virtual or physical Stripe Issuing card for a cardholder.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["userId"],
          "properties": {
            "userId": { "type": "string" },
            "cardType": { "type": "string", "description": "virtual | physical" },
            "currency": { "type": "string" },
            "spendingLimitAmount": { "type": "integer" },
            "spendingLimitInterval": { "type": "string" },
            "initialCreditAllocation": { "type": "integer" },
            "destinationId": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "status": { "type": "string" },
            "card": { "type": "object" },
            "allocation": { "type": "object" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
