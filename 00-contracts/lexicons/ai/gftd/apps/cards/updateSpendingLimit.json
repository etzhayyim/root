{
  "lexicon": 1,
  "id": "ai.gftd.apps.cards.updateSpendingLimit",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Update per-card spending controls (amount + interval).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["userId", "cardId", "amount"],
          "properties": {
            "userId": { "type": "string" },
            "cardId": { "type": "string" },
            "amount": { "type": "integer" },
            "interval": { "type": "string", "description": "per_authorization | daily | weekly | monthly | yearly | all_time" },
            "categories": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "status": { "type": "string" },
            "cardId": { "type": "string" },
            "amount": { "type": "integer" },
            "interval": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
