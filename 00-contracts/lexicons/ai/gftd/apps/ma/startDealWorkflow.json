{
  "lexicon": 1,
  "id": "ai.gftd.apps.ma.startDealWorkflow",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Start the actor-oriented global M&A brokerage workflow for sell-side or buy-side deal orchestration.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "dealId": { "type": "string" },
            "side": {
              "type": "string",
              "description": "sell-side or buy-side"
            },
            "clientName": { "type": "string" },
            "targetName": { "type": "string" },
            "sector": { "type": "string" },
            "jurisdiction": { "type": "string" },
            "expectedValueUsd": { "type": "float" },
            "confidentialityTier": { "type": "integer", "minimum": 1, "maximum": 4 },
            "operatorDid": { "type": "string" }
          },
          "required": ["side", "clientName", "sector"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "dealId": { "type": "string" },
            "status": { "type": "string" },
            "screeningScore": { "type": "float" },
            "valuationRangeLowUsd": { "type": "float" },
            "valuationRangeHighUsd": { "type": "float" },
            "matchedBuyerCount": { "type": "integer" },
            "closingStage": { "type": "string" },
            "pmiHandoffId": { "type": "string" }
          },
          "required": ["dealId", "status"]
        }
      }
    }
  }
}
