{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaisya.debt.lookupRealEstateRegistry",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Fetch real estate registry (不動産登記) by 地番 or 家屋番号 via 法務省 登記情報提供サービス. Used to locate 債務者所有不動産 for 強制競売申立 (民執法 43 条) or detect post-judgment disposal (詐害行為 424 条). Supports both 土地 (land parcel) and 建物 (building).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["searchMode"],
          "properties": {
            "searchMode": {
              "type": "string",
              "enum": ["byChiban", "byKaokuBango", "byOwnerName"],
              "description": "地番検索 / 家屋番号検索 / 所有者氏名検索. byOwnerName は 法務省オンラインでは不可 — municipality 固定資産課税台帳経由 (民執法 205 で代替)"
            },
            "prefecture":  { "type": "string", "description": "都道府県 (例: 神奈川県)" },
            "municipality": { "type": "string", "description": "市区町村 (例: 相模原市緑区)" },
            "chiban":       { "type": "string", "description": "地番 (例: 橋本 8-11-13-303) — byChiban で必須" },
            "kaokuBango":   { "type": "string", "description": "家屋番号 — byKaokuBango で必須" },
            "kind": {
              "type": "string",
              "enum": ["fullCertificate", "currentSection", "closedSection", "gloss"],
              "default": "fullCertificate",
              "description": "全部事項証明 / 現在事項 / 閉鎖事項 / 要約"
            },
            "caseCode": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["registryR2Key", "fetchedAt"],
          "properties": {
            "registryR2Key": { "type": "string" },
            "sha256":        { "type": "string" },
            "fetchedAt":     { "type": "string", "format": "datetime" },
            "feeJpy":        { "type": "integer", "description": "1 通 332 円 (オンライン)" },
            "extracted": {
              "type": "object",
              "properties": {
                "parcelNumber":   { "type": "string" },
                "landCategory":   { "type": "string", "description": "地目 (宅地/雑種地/田/畑/...)" },
                "landAreaSqm":    { "type": "number" },
                "buildingNumber": { "type": "string" },
                "structure":      { "type": "string" },
                "floorAreaSqm":   { "type": "number" },
                "owners": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name":         { "type": "string" },
                      "address":      { "type": "string" },
                      "share":        { "type": "string" },
                      "acquisitionDate":   { "type": "string", "format": "date" },
                      "acquisitionCause":  { "type": "string", "description": "売買/相続/贈与等" }
                    }
                  }
                },
                "mortgages": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind":      { "type": "string", "enum": ["mortgage", "rootMortgage", "lien"] },
                      "creditor":  { "type": "string" },
                      "principal": { "type": "integer" },
                      "registeredAt": { "type": "string", "format": "date" }
                    }
                  }
                },
                "otherBurdens": { "type": "array", "items": { "type": "string" } }
              }
            },
            "executableEquityJpy": { "type": "integer", "description": "推定 超過担保部分 (実勢価格 − 先順位担保額). 競売申立可否判断用" }
          }
        }
      },
      "errors": [
        { "name": "ParcelNotFound",     "description": "該当地番・家屋番号が登記なし" },
        { "name": "ServiceUnavailable", "description": "登記情報提供サービス 障害" }
      ]
    }
  }
}
