{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaisya.debt.compileEvidencePacket",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Compile evidence packet for a debt collection case: OCR all PDFs under R2 legal-cases/{caseCode}/, extract monetary amounts + dates + parties + clauses, build JSON index + chronological timeline, and render a submission-ready summary PDF. Also links 25 email threads from vertex_email_message by conversation_id to the case.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["caseCode"],
          "properties": {
            "caseCode": { "type": "string" },
            "includeR2Prefixes": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["judgments", "evidence", "filings", "orders", "responses"],
              "description": "Sub-prefixes under legal-cases/{caseCode}/ to scan"
            },
            "linkEmailConversationIds": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Microsoft Graph conversation IDs to link as edge_in_project"
            },
            "ocrLanguage": { "type": "string", "default": "jpn+eng" },
            "extractEntities": {
              "type": "boolean",
              "default": true,
              "description": "LLM-based extract of parties / amounts / dates / clauses"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["caseCode", "packetR2Key", "indexR2Key", "documentCount"],
          "properties": {
            "caseCode":    { "type": "string" },
            "packetR2Key": { "type": "string", "description": "Rendered summary PDF key" },
            "indexR2Key":  { "type": "string", "description": "index.json key (chronological + by-kind tree)" },
            "documentCount": { "type": "integer" },
            "totalBytes":    { "type": "integer" },
            "timeline": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date":      { "type": "string", "format": "date" },
                  "kind":      { "type": "string" },
                  "summary":   { "type": "string" },
                  "sourceR2Key": { "type": "string" }
                }
              }
            },
            "linkedEmailCount": { "type": "integer", "description": "vertex_email_message rows linked via edge_in_project" },
            "totalAmountsFoundJpy": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "amount":  { "type": "integer" },
                  "context": { "type": "string" },
                  "sourceR2Key": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "errors": [
        { "name": "CaseNotFound",    "description": "vertex_business_case.case_code が存在しない" },
        { "name": "NoDocumentsFound", "description": "R2 prefix 配下に 1 件も PDF なし" },
        { "name": "OcrFailed",        "description": "OCR サービス (Cloud Vision / Textract) 障害" }
      ]
    }
  }
}
