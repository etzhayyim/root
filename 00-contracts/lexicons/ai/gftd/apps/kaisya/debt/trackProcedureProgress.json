{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaisya.debt.trackProcedureProgress",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record progress of a collection procedure (execution clause grant / proof of service / third-party info query / seizure / auction). Writes to vertex_collection_procedure. Used by kaisya-portal /legal screen to render a per-case board of enforcement actions.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["caseCode", "procedureKind", "status"],
          "properties": {
            "caseCode":      { "type": "string" },
            "procedureKind": {
              "type": "string",
              "enum": [
                "executionClause", "proofOfService", "finalityCertificate",
                "financialDisclosure",
                "thirdPartyInfoBank", "thirdPartyInfoRealEstate", "thirdPartyInfoSalary", "thirdPartyInfoStock",
                "seizureDeposit", "seizureReceivable", "seizureSalary",
                "realEstateAuction",
                "collectionSuit",
                "fraudulentConveyanceSuit",
                "directorLiabilitySuit",
                "bankruptcyPetition"
              ]
            },
            "target": { "type": "string", "description": "対象 (銀行名・取引先名・不動産・勤務先)" },
            "court":  { "type": "string" },
            "courtCaseNumber": { "type": "string", "description": "執行事件の事件番号" },
            "filedAt":      { "type": "string", "format": "datetime" },
            "orderedAt":    { "type": "string", "format": "datetime" },
            "servedAt":     { "type": "string", "format": "datetime" },
            "completedAt":  { "type": "string", "format": "datetime" },
            "status": {
              "type": "string",
              "enum": ["draft", "filed", "ordered", "served", "responded", "collected", "failed", "withdrawn"]
            },
            "recoveredJpy":   { "type": "integer", "description": "この手続による回収額" },
            "filingDocR2Key":  { "type": "string" },
            "orderDocR2Key":   { "type": "string" },
            "responseDocR2Key": { "type": "string" },
            "notes":           { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["vertexId", "caseCode", "totalRecoveredJpy", "remainingJpy"],
          "properties": {
            "vertexId":          { "type": "string", "description": "vertex_collection_procedure.vertex_id" },
            "caseCode":          { "type": "string" },
            "totalRecoveredJpy": { "type": "integer" },
            "remainingJpy":      { "type": "integer", "description": "認容額 + 遅延損害金 − 回収済" },
            "accruedInterestJpy": { "type": "integer", "description": "このレスポンス時点の遅延損害金試算" }
          }
        }
      },
      "errors": [
        { "name": "CaseNotFound",       "description": "case_code 不明" },
        { "name": "InvalidTransition",  "description": "status 遷移が不正 (例: filed → collected を直接)" }
      ]
    }
  }
}
