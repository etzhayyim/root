{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaisya.debt.draftSeizureOrder",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Draft 民事執行法 143 条 債権差押命令申立書. Generates 1 main filing + 4 別紙 (当事者目録 / 請求債権目録 / 差押債権目録 / 第三債務者目録). 預金/売掛/給与/報酬 all supported via seizureKind. Amount to seize = judgment awarded + accrued 遅延損害金 computed to filing date.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["caseCode", "seizureKind", "thirdParty", "seizureAmount"],
          "properties": {
            "caseCode":    { "type": "string" },
            "seizureKind": {
              "type": "string",
              "enum": ["bankDeposit", "accountsReceivable", "salary", "fee"],
              "description": "差押対象債権の種類"
            },
            "thirdParty": {
              "type": "object",
              "required": ["name", "address"],
              "properties": {
                "name":    { "type": "string", "description": "第三債務者の正式商号" },
                "address": { "type": "string" },
                "representative": { "type": "string" },
                "branchName":    { "type": "string", "description": "預金差押で対象支店 (例: 三菱UFJ新宿支店)" },
                "branchAddress": { "type": "string", "description": "送達場所となる支店住所" }
              }
            },
            "seizureAmount": {
              "type": "integer",
              "description": "差押金額 (円). 通常は awarded + accrued 遅延損害金 + 執行費用. Upper bound is 差押禁止 (給与は 1/4 等)."
            },
            "infoQueryCaseNumber": {
              "type": "string",
              "description": "根拠となった 第三者情報取得手続 の事件番号 (bankDeposit 推奨). Traceability 用."
            },
            "executionClauseDate": { "type": "string", "format": "date", "description": "執行文付与日" },
            "servedDate":          { "type": "string", "format": "date", "description": "判決送達日" },
            "filingDate":          { "type": "string", "format": "date" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["caseCode", "filingR2Key", "revenueStampJpy", "postageJpy"],
          "properties": {
            "caseCode":        { "type": "string" },
            "filingR2Key":     { "type": "string" },
            "appendixKeys": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind":  { "type": "string", "enum": ["parties", "claim", "seizure", "thirdParty"] },
                  "r2Key": { "type": "string" }
                }
              }
            },
            "revenueStampJpy": { "type": "integer", "description": "4,000 円 × 第三債務者数 (判決債務名義)" },
            "postageJpy":      { "type": "integer" },
            "expectedOrderDays":     { "type": "integer", "description": "申立から差押命令発令までの目安 (7-14 日)" },
            "expectedServiceDays":   { "type": "integer", "description": "発令から第三債務者送達まで (~7 日)" },
            "collectionAvailableAt": { "type": "string", "format": "date", "description": "取立権発生日 (債務者送達日 + 7 日)" }
          }
        }
      },
      "errors": [
        { "name": "MissingExecutionClause", "description": "執行文未付与" },
        { "name": "MissingServiceProof",    "description": "送達証明書未取得" },
        { "name": "InvalidSeizureAmount",   "description": "seizureAmount が差押禁止範囲を超える / 請求債権額を超える" }
      ]
    }
  }
}
