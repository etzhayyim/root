{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaisya.listOrgSnapshots",
  "defs": {
    "main": {
      "type": "query",
      "description": "Returns recent org objective-function snapshots for trend analysis.",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": { "type": "integer" },
          "offset": { "type": "integer" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["snapshots", "total"],
          "properties": {
            "snapshots": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "snapshotAt": { "type": "string" },
                  "omega": { "type": "number" },
                  "etaValue": { "type": "number" },
                  "uTotal": { "type": "number" },
                  "spiritScore": { "type": "number" },
                  "wellbecomingScore": { "type": "number" },
                  "feelingScore": { "type": "number" },
                  "bufferScore": { "type": "number" },
                  "separationDelta": { "type": "number" },
                  "floorViolated": { "type": "boolean" },
                  "actionsExecuted": { "type": "integer" },
                  "tasksCreated": { "type": "integer" }
                }
              }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
