{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaisya.approveTask",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "AI agent が生成した vertex_kaisya_task を承認する。status を 'pending' → 'approved' に遷移させ、BPMN LangServer signal correlation を発行する。",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["taskId"],
          "properties": {
            "taskId": {
              "type": "string",
              "description": "vertex_kaisya_task.vertex_id"
            },
            "note": {
              "type": "string",
              "description": "承認コメント (任意)"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["taskId", "status", "resolvedAt"],
          "properties": {
            "taskId":     { "type": "string" },
            "status":     { "type": "string" },
            "resolvedAt": { "type": "string" }
          }
        }
      }
    }
  }
}
