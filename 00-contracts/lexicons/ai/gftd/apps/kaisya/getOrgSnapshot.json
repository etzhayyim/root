{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaisya.getOrgSnapshot",
  "defs": {
    "main": {
      "type": "query",
      "description": "Returns the latest org objective-function snapshot (Ω(t) = Shannon_η × U_total).",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["snapshot"],
          "properties": {
            "snapshot": {
              "type": "object",
              "properties": {
                "snapshotAt": { "type": "string" },
                "omega": { "type": "number" },
                "etaValue": { "type": "number" },
                "uTotal": { "type": "number" },
                "spiritScore": { "type": "number" },
                "wellbecomingScore": { "type": "number" },
                "feelingScore": { "type": "number" },
                "bufferScore": { "type": "number" },
                "separationDelta": { "type": "number" },
                "decisionsJson": { "type": "string" },
                "actionsExecuted": { "type": "integer" },
                "tasksCreated": { "type": "integer" },
                "agentRuns24h": { "type": "integer" },
                "pendingTasks": { "type": "integer" },
                "atRiskCallers": { "type": "integer" },
                "openLegalCases": { "type": "integer" },
                "floorViolated": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
