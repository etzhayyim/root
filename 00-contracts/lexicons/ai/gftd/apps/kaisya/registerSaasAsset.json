{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaisya.registerSaasAsset",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a Box/Admina-style SaaS asset or account into the kaisya ops inventory.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["provider", "assetType", "externalId", "displayName"],
          "properties": {
            "owner": { "type": "string" },
            "provider": { "type": "string", "enum": ["box", "admina", "googleWorkspace", "m365", "other"] },
            "assetType": { "type": "string" },
            "externalId": { "type": "string" },
            "displayName": { "type": "string" },
            "assigneeDid": { "type": "string", "format": "did" },
            "metadata": { "type": "object" },
            "status": { "type": "string", "default": "active" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "assetDid"],
          "properties": {
            "ok": { "type": "boolean" },
            "assetDid": { "type": "string" }
          }
        }
      }
    }
  }
}
