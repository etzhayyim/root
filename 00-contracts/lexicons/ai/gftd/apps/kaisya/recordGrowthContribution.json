{
  "lexicon": 1,
  "id": "ai.gftd.apps.kaisya.recordGrowthContribution",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "メンバーの BPMN タスク完了後に成長貢献を AT Repo に記録する。yoro.gftd.ai の derive rule がこの AT Record を受け取り feed.post を自動生成する。「フォームを送信するだけで yoro に実績が積まれる」仕組みの中核。",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["processInstanceId", "step", "contributionType", "actorDid"],
          "properties": {
            "processInstanceId": {
              "type": "string",
              "description": "BPMN プロセスインスタンス ID"
            },
            "step": {
              "type": "string",
              "description": "BPMN ステップ識別子 (例: A, B, C, E, F, G, H, I, J, K, L)"
            },
            "contributionType": {
              "type": "string",
              "description": "貢献種別 (strategy / intake / contract / security / branding / creative / tech / engineering / legal / delivery / approval / kpi)"
            },
            "actorDid": {
              "type": "string",
              "description": "貢献者の DID (例: did:web:kaisya.gftd.ai:member:j-kawasaki)"
            },
            "projectName": {
              "type": "string",
              "description": "案件名"
            },
            "summary": {
              "type": "string",
              "description": "貢献内容サマリー (yoro フィード投稿テキストに使用)"
            },
            "kpiData": {
              "type": "unknown",
              "description": "KPI データ (contributionType=kpi 時のみ: { newProjects, closedDeals, mrr })"
            },
            "publishToYoro": {
              "type": "boolean",
              "description": "yoro フィードに公開投稿するか (デフォルト: true)"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["rkey", "status"],
          "properties": {
            "rkey":              { "type": "string" },
            "collection":       { "type": "string" },
            "processInstanceId":{ "type": "string" },
            "yoroPostUri":      { "type": "string" },
            "status":           { "type": "string" }
          }
        }
      }
    }
  }
}
