{
  "lexicon": 1,
  "id": "ai.gftd.apps.jpnEdinet.recordMaterialEvent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "金融庁 臨時報告書 (material event)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "eventId",
            "edinetCode",
            "eventType",
            "occurredAt",
            "reportedAt"
          ],
          "properties": {
            "eventId": {
              "type": "string"
            },
            "edinetCode": {
              "type": "string"
            },
            "issuerName": {
              "type": "string"
            },
            "eventType": {
              "type": "string",
              "enum": [
                "merger",
                "subsidiary-change",
                "management-change",
                "financial-restatement",
                "litigation",
                "tob",
                "delisting",
                "insider-trading"
              ]
            },
            "narrative": {
              "type": "string"
            },
            "occurredAt": {
              "type": "string",
              "format": "datetime"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            "requireTradingHalt": {
              "type": "boolean"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
