{
  "lexicon": 1,
  "id": "ai.gftd.apps.jpnEdinet.submitSecuritiesFiling",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "金融庁 EDINET 有価証券報告書",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "docId",
            "edinetCode",
            "docTypeCode",
            "submittedAt"
          ],
          "properties": {
            "docId": {
              "type": "string",
              "description": "EDINET doc ID"
            },
            "edinetCode": {
              "type": "string",
              "description": "E + 5 digits"
            },
            "issuerName": {
              "type": "string"
            },
            "docTypeCode": {
              "type": "string",
              "description": "120=有報, 160=四半期, 140=半期, 130=臨報 等"
            },
            "docDescription": {
              "type": "string"
            },
            "fiscalYearEnd": {
              "type": "string",
              "format": "date"
            },
            "submittedAt": {
              "type": "string",
              "format": "datetime"
            },
            "periodCovered": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "disclosureTier": {
              "type": "string",
              "enum": [
                "routine",
                "periodic",
                "extraordinary"
              ]
            },
            "requireMarketNotice": {
              "type": "boolean"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
