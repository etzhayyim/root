{
  "lexicon": 1,
  "id": "ai.gftd.apps.credits.listLedgerEntries",
  "defs": {
    "main": {
      "type": "query",
      "description": "List credit ledger entries with optional account/currency/reason filter.",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "properties": {
          "accountDid": { "type": "string", "format": "did", "description": "matches debit OR credit account" },
          "currency": { "type": "string" },
          "reason": { "type": "string" },
          "occurredAfter": { "type": "string", "format": "datetime" },
          "occurredBefore": { "type": "string", "format": "datetime" },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "required": ["entries", "total", "offset", "limit"], "properties": { "entries": { "type": "array", "items": { "type": "object", "properties": { "uri": { "type": "string", "format": "at-uri" }, "ledgerEntryId": { "type": "string" }, "debitAccountDid": { "type": "string", "format": "did" }, "creditAccountDid": { "type": "string", "format": "did" }, "amount": { "type": "number" }, "currency": { "type": "string" }, "reason": { "type": "string" }, "occurredAt": { "type": "string", "format": "datetime" } } } }, "total": { "type": "integer" }, "offset": { "type": "integer" }, "limit": { "type": "integer" } } } }
    }
  }
}
