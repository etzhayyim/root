{
  "lexicon": 1,
  "id": "ai.gftd.apps.credits.postLedger",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Post a credit ledger entry (double-entry: debit + credit). Anti-fraud + HC/murakumo reward integration + public fund routing.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["debitAccountDid", "creditAccountDid", "amount", "currency", "reason"],
          "properties": {
            "debitAccountDid": { "type": "string", "format": "did" },
            "creditAccountDid": { "type": "string", "format": "did" },
            "amount": { "type": "number", "minimum": 0 },
            "currency": { "type": "string", "description": "ISO 4217 or HC for HC credit" },
            "reason": { "type": "string", "enum": ["earn-hc-reward", "earn-murakumo-reward", "spend-llm-inference", "spend-storage", "spend-bandwidth", "transfer-p2p", "public-fund-grant", "refund", "anti-fraud-reversal"] },
            "referenceUri": { "type": "string", "format": "at-uri", "description": "linked AT record (job/PR/donation)" },
            "antiFraudScore": { "type": "number", "minimum": 0, "maximum": 1 },
            "occurredAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "uri": { "type": "string", "format": "at-uri" }, "ledgerEntryId": { "type": "string" } } } }
    }
  }
}
