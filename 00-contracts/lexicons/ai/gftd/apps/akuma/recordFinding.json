{
  "lexicon": 1,
  "id": "ai.gftd.apps.akuma.recordFinding",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Append a finding produced by a completed probe. Raw finding payload is ciphertext-stored in vault.gftd.ai; only metadata is held in the graph (zero-knowledge invariant).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "scopeId",
            "probeUri",
            "target",
            "severity",
            "summary",
            "vaultCiphertextCid"
          ],
          "properties": {
            "scopeId": { "type": "string" },
            "probeUri": { "type": "string" },
            "target": { "type": "string" },
            "severity": {
              "type": "string",
              "enum": ["info", "low", "medium", "high", "critical"]
            },
            "summary": {
              "type": "string",
              "description": "Short, non-sensitive summary suitable for graph-side surfacing."
            },
            "cveIds": {
              "type": "array",
              "items": { "type": "string" }
            },
            "cvssScoreCentile": {
              "type": "integer",
              "description": "CVSS base score scaled x10 (0-100) so it fits Lexicon integer constraint. e.g. CVSS 7.5 -> 75."
            },
            "vaultCiphertextCid": {
              "type": "string",
              "description": "vault.gftd.ai CID for the encrypted full finding (raw tool output, screenshots, payloads)."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["findingUri", "status"],
          "properties": {
            "findingUri": { "type": "string" },
            "status": {
              "type": "string",
              "enum": ["open", "duplicate"]
            },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
