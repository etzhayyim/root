{
  "lexicon": 1,
  "id": "ai.gftd.apps.akuma.closeFinding",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Owner attests remediation of a finding. Akuma re-runs the same probe to verify before status transitions to closed.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "findingId",
            "ownerDid",
            "ownerSignature",
            "remediationNote"
          ],
          "properties": {
            "findingId": { "type": "string" },
            "ownerDid": { "type": "string" },
            "ownerSignature": {
              "type": "string",
              "description": "Detached signature over findingId + remediationNote by ownerDid."
            },
            "remediationNote": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["findingUri", "status"],
          "properties": {
            "findingUri": { "type": "string" },
            "status": {
              "type": "string",
              "enum": ["pending-verify", "closed", "still-open"]
            },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
