{
  "lexicon": 1,
  "id": "ai.gftd.apps.akuma.getScope",
  "defs": {
    "main": {
      "type": "query",
      "description": "Read a single scope contract by id. Returns metadata only; signatures and legalBasis CID are returned but raw legal documents stay in vault.",
      "parameters": {
        "type": "params",
        "required": ["scopeId"],
        "properties": {
          "scopeId": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "scopeUri": { "type": "string" },
            "ownerDid": { "type": "string" },
            "authorityDid": { "type": "string" },
            "targetKind": { "type": "string" },
            "targets": { "type": "array", "items": { "type": "string" } },
            "excludedTargets": { "type": "array", "items": { "type": "string" } },
            "allowedPorts": { "type": "array", "items": { "type": "integer" } },
            "allowedPaths": { "type": "array", "items": { "type": "string" } },
            "intrusivenessTier": { "type": "string" },
            "validFromMs": { "type": "integer" },
            "validUntilMs": { "type": "integer" },
            "rateLimitRps": { "type": "integer" },
            "status": { "type": "string" },
            "legalBasis": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
