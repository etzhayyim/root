{
  "lexicon": 1,
  "id": "ai.gftd.apps.abuse.registerTarget",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register new abuse contact (registrar / hosting / brand / cert).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "targetType": {
              "type": "string",
              "enum": [
                "registrar",
                "hosting",
                "brand",
                "cert"
              ]
            },
            "email": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "jurisdiction": {
              "type": "string"
            },
            "phone": {
              "type": "string"
            }
          },
          "required": [
            "targetType",
            "email",
            "name"
          ]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "did": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}