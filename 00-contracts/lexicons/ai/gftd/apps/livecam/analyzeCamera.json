{
  "lexicon": 1,
  "id": "ai.gftd.apps.livecam.analyzeCamera",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Start the LangServer livecam vision analysis pipeline. The edge worker only returns workflow metadata and exposes commitAnalysis for actor-generated records.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "cameraSlug": {
              "type": "string"
            },
            "imageUrl": {
              "type": "string"
            },
            "zoneSlug": {
              "type": "string"
            },
            "country": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "imageBase64": {
              "type": "string"
            }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            },
            "movedToPOD-side LangServer": {
              "type": "boolean"
            },
            "processId": {
              "type": "string"
            },
            "taskTypes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "variables": {
              "type": "object"
            },
            "commitCommand": {
              "type": "string"
            }
          },
          "required": []
        }
      }
    }
  }
}
