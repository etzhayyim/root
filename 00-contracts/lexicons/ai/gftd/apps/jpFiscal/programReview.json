{
  "lexicon": 1,
  "id": "ai.gftd.apps.jpFiscal.programReview",
  "defs": {
    "main": {
      "type": "record",
      "description": "行政事業レビューシート record. L5 ministry が annual で発行.",
      "record": {
        "type": "object",
        "required": ["programCode", "fiscalYear", "ministryDid", "createdAt"],
        "properties": {
          "programCode": { "type": "string" },
          "programName": { "type": "string" },
          "ministryDid": { "type": "string", "format": "did" },
          "fiscalYear": { "type": "integer" },
          "reviewRating": { "type": "string", "enum": ["A", "B", "C", "D", "廃止", "抜本改善", "一部改善", "現状通り"] },
          "recommendedAction": { "type": "string" },
          "spentJpy": { "type": "integer", "minimum": 0 },
          "sheetUrl": { "type": "string", "format": "uri" },
          "sheetCid": { "type": "string" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
