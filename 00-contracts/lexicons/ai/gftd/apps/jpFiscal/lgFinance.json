{
  "lexicon": 1,
  "id": "ai.gftd.apps.jpFiscal.lgFinance",
  "defs": {
    "main": {
      "type": "record",
      "description": "地方財政状況調査 (総務省) に基づく都道府県 / 市町村 の annual finance record.",
      "record": {
        "type": "object",
        "required": ["teamCode", "fiscalYear", "revenueJpy", "expenseJpy", "createdAt"],
        "properties": {
          "teamCode": { "type": "string", "description": "全国地方公共団体コード 6 digits" },
          "teamName": { "type": "string" },
          "level": { "type": "string", "enum": ["prefecture", "designated-city", "core-city", "special-city", "city", "town", "village", "special-ward"] },
          "fiscalYear": { "type": "integer" },
          "revenueJpy": { "type": "integer", "minimum": 0 },
          "expenseJpy": { "type": "integer", "minimum": 0 },
          "localTaxJpy": { "type": "integer", "minimum": 0 },
          "kofuzeiJpy": { "type": "integer", "minimum": 0 },
          "kokkoShishutsukinJpy": { "type": "integer", "minimum": 0 },
          "debtStockJpy": { "type": "integer", "minimum": 0 },
          "genericRatio": { "type": "number", "description": "経常収支比率" },
          "sourceUrl": { "type": "string", "format": "uri" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
