{
  "lexicon": 1,
  "id": "ai.gftd.apps.jpFiscal.subsidyGrant",
  "defs": {
    "main": {
      "type": "record",
      "description": "補助金交付決定 record。source (L2/L3/L4) から recipient (L0 or L1 contractor) へ。",
      "record": {
        "type": "object",
        "required": ["sourceDid", "recipientDid", "program", "amountJpy", "decisionDate", "createdAt"],
        "properties": {
          "sourceDid": { "type": "string", "format": "did" },
          "recipientDid": { "type": "string", "format": "did", "description": "法人=legalEntity DID / 個人事業主=Tier 3 cohort DID" },
          "program": { "type": "string" },
          "programCode": { "type": "string" },
          "amountJpy": { "type": "integer", "minimum": 0 },
          "decisionDate": { "type": "string", "format": "date" },
          "kofuYokou": { "type": "string", "description": "交付要綱 URL" },
          "publicationUrl": { "type": "string", "format": "uri" },
          "piiTier": { "type": "integer", "enum": [1, 3] },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
