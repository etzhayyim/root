{
  "lexicon": 1,
  "id": "ai.gftd.apps.jpFiscal.budgetExecution",
  "defs": {
    "main": {
      "type": "record",
      "description": "L5 ministry が発行する四半期ベース予算執行 record。appropriation を source に derive される集計。",
      "record": {
        "type": "object",
        "required": ["programCode", "fiscalYear", "quarter", "executedJpy", "createdAt"],
        "properties": {
          "programCode": { "type": "string" },
          "fiscalYear": { "type": "integer" },
          "quarter": { "type": "integer", "minimum": 1, "maximum": 4 },
          "appropriatedJpy": { "type": "integer", "minimum": 0 },
          "executedJpy": { "type": "integer", "minimum": 0 },
          "remainingJpy": { "type": "integer", "minimum": 0 },
          "derivationStage": { "type": "string", "enum": ["L5"] },
          "sourceUrl": { "type": "string", "format": "uri" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
