{
  "lexicon": 1,
  "id": "ai.gftd.apps.jpFiscal.incorpFinance",
  "defs": {
    "main": {
      "type": "record",
      "description": "独立行政法人 / 特殊法人 / 認可法人 の annual finance record. 国からの交付金額を抽出.",
      "record": {
        "type": "object",
        "required": ["incorpDid", "fiscalYear", "createdAt"],
        "properties": {
          "incorpDid": { "type": "string", "format": "did" },
          "incorpJcn": { "type": "string" },
          "incorpType": { "type": "string", "enum": ["dokuritsu-gyosei", "tokushu-hojin", "ninka-hojin", "national-university", "other"] },
          "fiscalYear": { "type": "integer" },
          "subsidyFromDid": { "type": "string", "format": "did", "description": "交付金供出 ministry DID" },
          "subsidyJpy": { "type": "integer", "minimum": 0 },
          "totalRevenueJpy": { "type": "integer", "minimum": 0 },
          "totalExpenseJpy": { "type": "integer", "minimum": 0 },
          "xbrlCid": { "type": "string" },
          "sourceUrl": { "type": "string", "format": "uri" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
