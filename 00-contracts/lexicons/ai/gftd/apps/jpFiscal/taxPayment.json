{
  "lexicon": 1,
  "id": "ai.gftd.apps.jpFiscal.taxPayment",
  "defs": {
    "main": {
      "type": "record",
      "description": "L7 taxpayer cohort → L6 collector 税収納付。個人納税者は ADR-0026 cohort DID で集約、法人は JCN 個別で可。",
      "record": {
        "type": "object",
        "required": ["payerCohortDid", "receiverDid", "taxCode", "amountJpy", "periodIso", "createdAt"],
        "properties": {
          "payerCohortDid": { "type": "string", "format": "did", "description": "did:web:gov.gftd.ai:country:jpn:taxpayer:cohort:* or legalEntity JCN DID" },
          "receiverDid": { "type": "string", "format": "did", "description": "L6 nta / customs / prefecture-tax collector DID" },
          "taxCode": { "type": "string", "description": "所得税/法人税/消費税/固定資産税/関税/... (JP NTA code)" },
          "amountJpy": { "type": "integer", "minimum": 0 },
          "periodIso": { "type": "string", "description": "YYYY or YYYY-MM or YYYY-Qn" },
          "piiTier": { "type": "integer", "enum": [1, 3] },
          "sourceUrl": { "type": "string", "format": "uri" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
