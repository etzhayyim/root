{
  "lexicon": 1,
  "id": "ai.gftd.apps.jpFiscal.contract",
  "defs": {
    "main": {
      "type": "record",
      "description": "会計法 29 条 / 地方自治法 234 条 に基づく公表契約 record。",
      "record": {
        "type": "object",
        "required": ["issuerDid", "contractorDid", "method", "amountJpy", "signedDate", "createdAt"],
        "properties": {
          "issuerDid": { "type": "string", "format": "did", "description": "発注元 agency/prefecture/municipality DID" },
          "contractorDid": { "type": "string", "format": "did", "description": "受注者 legalEntity DID (JCN)" },
          "contractorJcn": { "type": "string", "description": "法人番号 13 digits" },
          "contractNo": { "type": "string" },
          "method": { "type": "string", "enum": ["zuikei-random", "general-tender", "select-tender", "negotiated", "sole-source", "framework"] },
          "amountJpy": { "type": "integer", "minimum": 0 },
          "signedDate": { "type": "string", "format": "date" },
          "deliverable": { "type": "string", "maxLength": 500 },
          "kaikeihoArticle": { "type": "string", "description": "会計法根拠条文 (29-1 / 29-3 / ...)" },
          "programCode": { "type": "string", "description": "執行 program コード (逆参照用)" },
          "tenderDid": { "type": "string", "format": "did", "description": "対応する procurementBid record URI" },
          "publicationUrl": { "type": "string", "format": "uri" },
          "supersedesUri": { "type": "string", "format": "at-uri", "description": "変更契約の場合 原契約 URI" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
