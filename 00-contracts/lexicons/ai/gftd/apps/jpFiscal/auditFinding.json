{
  "lexicon": 1,
  "id": "ai.gftd.apps.jpFiscal.auditFinding",
  "defs": {
    "main": {
      "type": "record",
      "description": "会計検査院 (Board of Audit) 検査報告に基づく指摘事項。category=不当/意見/是正/処置要求/処置済.",
      "record": {
        "type": "object",
        "required": ["targetDid", "fiscalYear", "category", "paragraphRef", "createdAt"],
        "properties": {
          "targetDid": { "type": "string", "format": "did" },
          "fiscalYear": { "type": "integer" },
          "category": { "type": "string", "enum": ["futou", "iken", "zesei", "shochi-youkyuu", "shochi-zumi", "other"] },
          "subCategory": { "type": "string" },
          "amountJpy": { "type": "integer", "minimum": 0 },
          "paragraphRef": { "type": "string", "description": "検査報告 項番号 (e.g., 第3章第2節第1款)" },
          "summary": { "type": "string", "maxLength": 1000 },
          "sourceUrl": { "type": "string", "format": "uri" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
