{
  "lexicon": 1,
  "id": "ai.gftd.apps.itr1.fileReturn",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0055. Final-file an ITR-1 return. Phase 1: portal e-File done manually, ack number entered here. Phase 2: e-File API.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "vertexId": { "type": "string" },
            "ackNumber": { "type": "string", "description": "15-digit Acknowledgement Number issued by e-Filing portal." },
            "filedVia": { "type": "string", "enum": ["evc", "aadhaarOtp", "dsc", "paper"] },
            "filedAt": { "type": "string", "description": "ISO 8601 timestamp." }
          },
          "required": ["vertexId", "ackNumber", "filedVia"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "ackNumber": { "type": "string" },
            "newStatus": { "type": "string", "description": "filed" },
            "kaikeiPropagated": { "type": "boolean" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
