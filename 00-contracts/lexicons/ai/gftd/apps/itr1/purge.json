{
  "lexicon": 1,
  "id": "ai.gftd.apps.itr1.purge",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0055. Cron / manual purge of Tier 3 ITR-1 PII older than 7 years (IT Act §44AA + DPDP §8(7)).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "asOf": { "type": "string" },
            "dryRun": { "type": "boolean", "default": false }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "purgedCount": { "type": "integer" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
