{
  "lexicon": 1,
  "id": "ai.gftd.apps.itr1.requestCaReview",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-0055. Optional CA / TRP review request before filing. Phase 2: integrates with CA marketplace.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "vertexId": { "type": "string" },
            "caDid": { "type": "string", "description": "CA / TRP DID. Optional — leave blank for self-file." },
            "scope": { "type": "string", "enum": ["sanityCheck", "fullReview", "filingDelegation"] }
          },
          "required": ["vertexId"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "newStatus": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
