{
  "lexicon": 1,
  "id": "ai.gftd.apps.keiyaku.signAgreement",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a signature on the signingFlow. When all required signers have signed, derive rule flips the parent agreement to signingStatus='signed' and emits downstream records (seikyu.recurringSchedule for customer contracts, kaikei accrual for vendor/lease, etc).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["signingFlowDid", "signerDid", "signatureCid"],
          "properties": {
            "signingFlowDid": { "type": "string", "format": "did" },
            "signerDid":      { "type": "string", "format": "did" },
            "signatureCid":   { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["signingFlowDid", "allSignersComplete"],
          "properties": {
            "signingFlowDid":      { "type": "string", "format": "did" },
            "allSignersComplete":  { "type": "boolean" },
            "agreementSignedAt":   { "type": "string", "format": "datetime" }
          }
        }
      },
      "errors": [
        { "name": "NotASigner",   "description": "caller DID is not in signingFlow.signers" },
        { "name": "AlreadySigned","description": "signer has already signed" }
      ]
    }
  }
}
