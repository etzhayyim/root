{
  "lexicon": 1,
  "id": "ai.gftd.apps.keiyaku.counterparty",
  "defs": {
    "main": {
      "type": "record",
      "description": "Contract counterparty master. PII fields (address, contact) are signal:v1 field-encrypted (Tier 2) to avoid federated leakage while keeping legal-entity metadata (corporate number, jurisdiction) plaintext for due-diligence queries.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["ownerDid", "displayName", "kind", "createdAt"],
        "properties": {
          "ownerDid":            { "type": "string", "format": "did" },
          "displayName":         { "type": "string" },
          "kind":                { "type": "string", "enum": ["corporate","individual","publicEntity"] },
          "corporateNumber":     { "type": "string", "description": "法人番号 (13桁, Japan)" },
          "jurisdiction":        { "type": "string", "description": "ISO 3166-1 alpha-2" },
          "addressEncrypted":    { "type": "string", "description": "signal:v1:{ciphertext}" },
          "contactEmailEncrypted":{ "type": "string", "description": "signal:v1:{ciphertext}" },
          "contactPhoneEncrypted":{ "type": "string", "description": "signal:v1:{ciphertext}" },
          "createdAt":           { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
