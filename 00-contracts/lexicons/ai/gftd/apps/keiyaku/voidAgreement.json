{
  "lexicon": 1,
  "id": "ai.gftd.apps.keiyaku.voidAgreement",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Terminate or void an agreement. terminatedAt is recorded on the agreement; dependent recurringSchedule rows are flipped to status='ended' via derive rule.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["agreementDid", "reason"],
          "properties": {
            "agreementDid":  { "type": "string", "format": "did" },
            "action":        { "type": "string", "enum": ["terminate","void"], "default": "terminate" },
            "effectiveAt":   { "type": "string", "format": "datetime" },
            "reason":        { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["agreementDid", "signingStatus"],
          "properties": {
            "agreementDid":                { "type": "string", "format": "did" },
            "signingStatus":               { "type": "string", "enum": ["terminated","void"] },
            "endedRecurringScheduleDids":  { "type": "array", "items": { "type": "string", "format": "did" } }
          }
        }
      }
    }
  }
}
