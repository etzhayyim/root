{
  "lexicon": 1,
  "id": "ai.gftd.apps.keiyaku.amendment",
  "defs": {
    "main": {
      "type": "record",
      "description": "Amendment (覚書) to an existing agreement. Does not mutate the parent; instead forms a lineage chain via parentAgreementDid and materialHashProof. The active contract state is the fold of (agreement + all amendments up to now).",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["ownerDid", "parentAgreementDid", "title", "effectiveFrom", "changes", "signingStatus", "createdAt"],
        "properties": {
          "ownerDid":            { "type": "string", "format": "did" },
          "parentAgreementDid":  { "type": "string", "format": "did" },
          "title":               { "type": "string" },
          "effectiveFrom":       { "type": "string", "format": "datetime" },
          "changes": {
            "type": "array",
            "description": "JSON-pointer-style diff of parent agreement fields",
            "items": {
              "type": "object",
              "required": ["path", "newValue"],
              "properties": {
                "path":     { "type": "string" },
                "newValue": { "type": "string" }
              }
            }
          },
          "pdfCid":              { "type": "string" },
          "signingStatus":       { "type": "string", "enum": ["drafted","sent","signed","void"] },
          "signedAt":            { "type": "string", "format": "datetime" },
          "materialHashProof":   { "type": "string" },
          "createdAt":           { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
