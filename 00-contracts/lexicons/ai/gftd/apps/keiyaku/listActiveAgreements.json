{
  "lexicon": 1,
  "id": "ai.gftd.apps.keiyaku.listActiveAgreements",
  "defs": {
    "main": {
      "type": "query",
      "description": "List currently active agreements. Reads view_keiyaku_active_agreements (plain VIEW) which filters signingStatus='signed' AND terminatedAt IS NULL and computes expiresAt from termMonths.",
      "parameters": {
        "type": "params",
        "properties": {
          "agreementType":   { "type": "string", "enum": ["nda","msa","sow","employment","lease","vendor","customer","license","other"] },
          "counterpartyDid": { "type": "string", "format": "did" },
          "expiringWithinDays": { "type": "integer", "description": "If set, filter to agreements whose expiresAt is within N days" },
          "limit":           { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 },
          "cursor":          { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["agreements"],
          "properties": {
            "agreements": { "type": "array", "items": { "type": "object" } },
            "cursor":     { "type": "string" }
          }
        }
      }
    }
  }
}
