{
  "lexicon": 1,
  "id": "ai.gftd.apps.keiyaku.signingFlow",
  "defs": {
    "main": {
      "type": "record",
      "description": "E-signature workflow state for an agreement. Each signer produces a progress entry. When all required signers complete, the parent agreement flips to signingStatus='signed' via derive rule.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["ownerDid", "agreementDid", "signers", "createdAt"],
        "properties": {
          "ownerDid":     { "type": "string", "format": "did" },
          "agreementDid": { "type": "string", "format": "did" },
          "provider":     { "type": "string", "enum": ["docusign","cloudsign","adobeSign","internal"], "default": "internal" },
          "externalId":   { "type": "string" },
          "signers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["did", "role"],
              "properties": {
                "did":        { "type": "string", "format": "did" },
                "role":       { "type": "string", "enum": ["representative","witness","counterparty","internal"] },
                "signedAt":   { "type": "string", "format": "datetime" },
                "signatureCid":{ "type": "string" }
              }
            }
          },
          "completedAt":  { "type": "string", "format": "datetime" },
          "createdAt":    { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
