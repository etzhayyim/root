{
  "lexicon": 1,
  "id": "ai.gftd.apps.keiyaku.agreement",
  "defs": {
    "main": {
      "type": "record",
      "description": "Internal signed agreement (社内契約). PDF is vault-encrypted, referenced by pdfCid. agreementType drives downstream behavior: 'vendor' → AP accrual; 'customer' → AR recurring schedule; 'employment' → HR onboarding hook; 'nda' → no financial derive. NSID intentionally differs from ai.gftd.apps.keiyaku.contract (which is external government-procurement observation).",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["ownerDid", "counterpartyDid", "title", "agreementType", "effectiveFrom", "pdfCid", "signingStatus", "createdAt"],
        "properties": {
          "ownerDid":         { "type": "string", "format": "did" },
          "counterpartyDid":  { "type": "string", "format": "did" },
          "title":            { "type": "string" },
          "agreementType":    { "type": "string", "enum": ["nda","msa","sow","employment","lease","vendor","customer","license","other"] },
          "effectiveFrom":    { "type": "string", "format": "datetime" },
          "termMonths":       { "type": "integer", "description": "null = perpetual" },
          "autoRenew":        { "type": "boolean", "default": false },
          "totalAmount":      { "type": "number" },
          "currency":         { "type": "string" },
          "recurringAmount":  { "type": "number", "description": "If present, seikyu.recurringSchedule is derived" },
          "recurringFrequency":{ "type": "string", "enum": ["monthly","quarterly","yearly"] },
          "pdfCid":           { "type": "string", "description": "SHA-256 of vault-encrypted PDF" },
          "signingStatus":    { "type": "string", "enum": ["drafted","sent","partiallySigned","signed","terminated","void"] },
          "signedAt":         { "type": "string", "format": "datetime" },
          "terminatedAt":     { "type": "string", "format": "datetime" },
          "materialHashProof":{ "type": "string", "description": "ADR-0029 hex material bytes for recursive DID lineage (agreement → amendment)" },
          "createdAt":        { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
