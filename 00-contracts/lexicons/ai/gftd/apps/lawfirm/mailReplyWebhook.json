{
  "lexicon": 1,
  "id": "ai.gftd.apps.lawfirm.mailReplyWebhook",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Microsoft Graph subscription webhook for incoming mail replies. Matches reply against vertex_lawfirm_outreach_event by Message-ID / In-Reply-To / Subject thread, persists inbound event, advances lead stage if first reply.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["from_email", "subject"],
          "properties": {
            "message_id":      { "type": "string", "description": "RFC 5322 Message-ID" },
            "in_reply_to":     { "type": "string", "description": "RFC 5322 In-Reply-To header" },
            "from_email":      { "type": "string" },
            "from_name":       { "type": "string" },
            "to_emails":       { "type": "array", "items": { "type": "string" } },
            "subject":         { "type": "string" },
            "body_preview":    { "type": "string", "description": "First 500 chars, plaintext" },
            "received_at":     { "type": "string", "format": "datetime" },
            "graph_event_id":  { "type": "string", "description": "Microsoft Graph event id (idempotency)" },
            "raw_headers":     { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok":              { "type": "boolean" },
            "matched_lead_id": { "type": "string" },
            "outreach_event_uri": { "type": "string" },
            "stage_advanced":  { "type": "boolean" },
            "new_stage":       { "type": "string" },
            "error":           { "type": "string" }
          }
        }
      }
    }
  }
}
