{
  "lexicon": 1,
  "id": "ai.gftd.apps.lawfirm.legalDocument",
  "defs": {
    "main": {
      "type": "record",
      "description": "Legal document (pleading / brief / motion / evidence / contract / letter). Content is vault-encrypted (ADR root rules §Vault Zero-Knowledge Invariant). DID is content-addressed under the matter (did:gftd:{firm}:{matter}:{doc}); docCid is the SHA-256 of vault ciphertext. Drafts generated by AI must have approverBengoshiDid (ISCO-2611) set before filing (actor-manifest RULE-003).",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["matterDid", "documentDid", "docType", "cid", "status", "materialHashProof"],
        "properties": {
          "matterDid":            { "type": "string", "format": "did" },
          "documentDid":          { "type": "string", "format": "did" },
          "docType":              { "type": "string", "enum": ["pleading","motion","brief","evidence","contract","memo","letter","opinion","filing","correspondence","other"] },
          "title":                { "type": "string" },
          "cid":                  { "type": "string", "description": "SHA-256 hex of vault-encrypted ciphertext (blob addressed)" },
          "version":              { "type": "integer", "minimum": 1 },
          "supersedesDocumentDid":{ "type": "string", "format": "did" },
          "authorDid":            { "type": "string", "format": "did" },
          "approverBengoshiDid":  { "type": "string", "format": "did", "description": "ISCO-2611 lawyer approval for AI-generated drafts (RULE-003)" },
          "approvedAt":           { "type": "string", "format": "datetime" },
          "privileged":           { "type": "boolean", "default": true },
          "filedWithCourt":       { "type": "string", "format": "at-uri", "description": "saiban trialEvent ref when filed" },
          "filedAt":              { "type": "string", "format": "datetime" },
          "materialHashProof":    { "type": "string" },
          "status":               { "type": "string", "enum": ["draft","pendingReview","approved","filed","superseded","withdrawn"] },
          "createdAt":            { "type": "string", "format": "datetime" },
          "updatedAt":            { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
