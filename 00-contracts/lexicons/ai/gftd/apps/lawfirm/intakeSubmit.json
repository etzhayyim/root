{
  "lexicon": 1,
  "id": "ai.gftd.apps.lawfirm.intakeSubmit",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Public multilingual client intake form. Persists to vertex_lawfirm_intake with field-level encryption on privileged content. DPDP § 5/6 consent captured; cross-border transfer notice in privacy notice. Returns intake_id for client tracking.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["client_name", "client_email", "summary", "consent_status"],
          "properties": {
            "tenant_id":         { "type": "string", "description": "Default 'production'; demo tenants 'demo-{slug}'" },
            "lang":              { "type": "string", "default": "en", "description": "ISO 639-1 (en/hi/ta/te/bn/...) or BCP 47" },
            "client_name":       { "type": "string", "description": "App layer encrypts to signal:v1: before persist" },
            "client_email":      { "type": "string" },
            "client_phone":      { "type": "string", "description": "App layer encrypts" },
            "client_country":    { "type": "string", "default": "IN", "description": "ISO 3166-1 alpha-2" },
            "matter_type_hint":  { "type": "string", "description": "Free-form; LLM auto-classifies" },
            "jurisdiction_hint": { "type": "string", "description": "ISO 3166-1 alpha-3 or list" },
            "cross_border_flag": { "type": "boolean", "default": false },
            "summary":           { "type": "string", "description": "App layer encrypts; advocate-client privileged" },
            "consent_status":    { "type": "string", "enum": ["accepted", "declined"], "description": "DPDP § 6 consent" },
            "source_url":        { "type": "string" },
            "ip_country":        { "type": "string", "description": "GeoIP-derived (not from IP itself); for audit only" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok":         { "type": "boolean" },
            "intake_id":  { "type": "string" },
            "intake_uri": { "type": "string" },
            "next_steps_message": { "type": "string", "description": "Localized message in client's lang" },
            "estimated_response_hours": { "type": "integer" },
            "error":      { "type": "string" }
          }
        }
      }
    }
  }
}
