{
  "lexicon": 1,
  "id": "ai.gftd.apps.lawfirm.translateFromLang",
  "defs": {
    "main": {
      "type": "query",
      "description": "Translate a regional-language text into en (court of record) or hi. Inverse of translateToLang.",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "required": ["text", "sourceLang"],
        "properties": {
          "text": { "type": "string" },
          "sourceLang": { "type": "string" },
          "targetLang": { "type": "string", "default": "en", "description": "en | hi" },
          "domain": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["text", "targetLang"],
          "properties": {
            "text": { "type": "string" },
            "targetLang": { "type": "string" },
            "sourceLang": { "type": "string" },
            "modelId": { "type": "string" }
          }
        }
      }
    }
  }
}
