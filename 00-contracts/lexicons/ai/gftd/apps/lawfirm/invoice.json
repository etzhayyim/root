{
  "lexicon": 1,
  "id": "ai.gftd.apps.lawfirm.invoice",
  "defs": {
    "main": {
      "type": "record",
      "description": "Invoice for billable work on a matter. Generated by issueInvoice from approved timeEntry records + flat fees + expenses. PDF stored in vault by cid. Status transitions: draft → sent → paid (or void).",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["matterDid", "invoiceDid", "clientDid", "period", "lineItems", "subtotal", "total", "currency", "status", "issuedAt", "materialHashProof"],
        "properties": {
          "matterDid":         { "type": "string", "format": "did" },
          "invoiceDid":        { "type": "string", "format": "did" },
          "firmDid":           { "type": "string", "format": "did" },
          "clientDid":         { "type": "string", "format": "did" },
          "invoiceNumber":     { "type": "string" },
          "period": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string", "format": "datetime" },
              "to":   { "type": "string", "format": "datetime" }
            }
          },
          "lineItems": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["description", "amount"],
              "properties": {
                "kind":        { "type": "string", "enum": ["time","flatFee","expense","adjustment"] },
                "timeEntryRef":{ "type": "string", "format": "at-uri" },
                "description": { "type": "string" },
                "quantity":    { "type": "number" },
                "unitRate":    { "type": "number" },
                "amount":      { "type": "number" }
              }
            }
          },
          "subtotal":          { "type": "number" },
          "taxRate":           { "type": "number", "description": "Decimal, e.g. 0.10 = 10%" },
          "taxAmount":         { "type": "number" },
          "discountAmount":    { "type": "number" },
          "total":             { "type": "number" },
          "currency":          { "type": "string" },
          "pdfCid":            { "type": "string", "description": "SHA-256 of vault-encrypted invoice PDF" },
          "issuedAt":          { "type": "string", "format": "datetime" },
          "dueAt":             { "type": "string", "format": "datetime" },
          "sentAt":            { "type": "string", "format": "datetime" },
          "paidAt":            { "type": "string", "format": "datetime" },
          "paymentRef":        { "type": "string" },
          "status":            { "type": "string", "enum": ["draft","sent","partiallyPaid","paid","overdue","void"] },
          "materialHashProof": { "type": "string" }
        }
      }
    }
  }
}
