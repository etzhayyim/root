{
  "lexicon": 1,
  "id": "ai.gftd.apps.lawfirm.hearing",
  "defs": {
    "main": {
      "type": "record",
      "description": "Court hearing / procedural event, mirrored from saiban.gftd.ai via service sync. Matter-scoped DID under ADR-0029 (did:gftd:{firm}:{matter}:{hearing}).",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["matterDid", "hearingDid", "hearingType", "scheduledAt", "status", "materialHashProof"],
        "properties": {
          "matterDid":        { "type": "string", "format": "did" },
          "hearingDid":       { "type": "string", "format": "did" },
          "saibanJikenRef":   { "type": "string", "format": "at-uri", "description": "Service ref to saiban.gftd.ai case record (ai.gftd.apps.saiban.jiken)" },
          "courtId":          { "type": "string", "description": "saiban court identifier" },
          "judgeDid":         { "type": "string", "format": "did" },
          "hearingType":      { "type": "string", "enum": ["firstAppearance","oral","evidentiary","conciliation","mediation","sentencing","appellate","procedural"] },
          "scheduledAt":      { "type": "string", "format": "datetime" },
          "durationMin":      { "type": "integer" },
          "location":         { "type": "string" },
          "attendees":        { "type": "array", "items": { "type": "string", "format": "did" } },
          "agenda":           { "type": "string" },
          "outcome":          { "type": "string" },
          "minutesCid":       { "type": "string", "description": "Vault-encrypted minutes blob CID" },
          "materialHashProof":{ "type": "string" },
          "status":           { "type": "string", "enum": ["scheduled","inProgress","completed","postponed","cancelled"] },
          "createdAt":        { "type": "string", "format": "datetime" },
          "updatedAt":        { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
