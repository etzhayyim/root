{
  "lexicon": 1,
  "id": "ai.gftd.apps.lawfirm.engagement",
  "defs": {
    "main": {
      "type": "record",
      "description": "Client engagement letter + retainer agreement for a matter. Created alongside createMatter (or attached later). engagementLetterCid points to a vault-encrypted blob (ADR root §Vault Zero-Knowledge Invariant).",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["matterDid", "engagementDid", "clientDid", "status", "createdAt", "materialHashProof"],
        "properties": {
          "matterDid":            { "type": "string", "format": "did" },
          "engagementDid":        { "type": "string", "format": "did" },
          "clientDid":            { "type": "string", "format": "did" },
          "firmDid":              { "type": "string", "format": "did" },
          "engagementLetterCid":  { "type": "string", "description": "SHA-256 hex of vault-encrypted engagement letter PDF" },
          "scopeOfWork":          { "type": "string" },
          "retainerAmount":       { "type": "number" },
          "retainerCurrency":     { "type": "string", "description": "ISO 4217" },
          "hourlyRateDefault":    { "type": "number" },
          "feeStructure":         { "type": "string", "enum": ["hourly","fixed","contingency","retainer","pro-bono"] },
          "contingencyPct":       { "type": "number", "description": "When feeStructure=contingency" },
          "signedByClientAt":     { "type": "string", "format": "datetime" },
          "signedByFirmAt":       { "type": "string", "format": "datetime" },
          "effectiveAt":          { "type": "string", "format": "datetime" },
          "terminatedAt":         { "type": "string", "format": "datetime" },
          "status":               { "type": "string", "enum": ["draft","pendingSignature","active","suspended","terminated"] },
          "materialHashProof":    { "type": "string" },
          "createdAt":            { "type": "string", "format": "datetime" },
          "updatedAt":            { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
