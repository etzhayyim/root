{
  "lexicon": 1,
  "id": "ai.gftd.apps.lawfirm.timeEntry",
  "defs": {
    "main": {
      "type": "record",
      "description": "Billable time entry. Written by recordTimeEntry procedure. rkey = TID (not DID-bound — high-frequency, low-identity entity). Status transitions: draft → submitted → approved → billed (linked to invoiceRef).",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["matterDid", "bengoshiDid", "hours", "rate", "currency", "category", "status", "loggedAt"],
        "properties": {
          "matterDid":    { "type": "string", "format": "did" },
          "bengoshiDid":  { "type": "string", "format": "did" },
          "activityRef":  { "type": "string", "format": "at-uri", "description": "Optional link to ai.gftd.apps.lawfirm.activity record" },
          "hours":        { "type": "number", "minimum": 0 },
          "rate":         { "type": "number", "minimum": 0 },
          "currency":     { "type": "string", "description": "ISO 4217" },
          "category":     { "type": "string", "enum": ["research","draft","review","call","meeting","court","travel","admin","general"] },
          "note":         { "type": "string" },
          "occurredAt":   { "type": "string", "format": "datetime" },
          "loggedAt":     { "type": "string", "format": "datetime" },
          "approvedBy":   { "type": "string", "format": "did", "description": "Firm admin or leadBengoshi DID" },
          "approvedAt":   { "type": "string", "format": "datetime" },
          "invoiceRef":   { "type": "string", "format": "at-uri", "description": "at:// invoice record once billed" },
          "status":       { "type": "string", "enum": ["draft","submitted","approved","billed","writeOff"] }
        }
      }
    }
  }
}
