{
  "lexicon": 1,
  "id": "ai.gftd.apps.lawfirm.inviteExternalCounsel",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Invite an external bengoshi (possibly from a different firm) to collaborate on a specific matter. Server: (1) runs conflict scan against matter counterparties, (2) mints a grant DID via ai.gftd.auth.mintChildDid under matterDid, (3) writes externalCounselGrant record in 'invited' status, (4) sends W Protocol DM with consent.request card. Ethical wall enforced at hash-prefix level (ADR-0029).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["matterDid", "granteeDid", "role", "capabilities", "expiresAt"],
          "properties": {
            "matterDid":    { "type": "string", "format": "did" },
            "granteeDid":   { "type": "string", "format": "did" },
            "granteeHandle":{ "type": "string" },
            "role":         { "type": "string", "enum": ["coCounsel","local","advisory","reviewer"] },
            "capabilities": {
              "type": "array",
              "items": { "type": "string", "enum": ["read","comment","uploadDocument","propose","sign","scheduleHearing"] }
            },
            "expiresAt":    { "type": "string", "format": "datetime" },
            "message":      { "type": "string", "description": "Optional message included in consent.request DM" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["grantDid", "grantUri"],
          "properties": {
            "grantDid":          { "type": "string", "description": "did:gftd:{firm}:{matter}:{grant}" },
            "grantUri":          { "type": "string", "format": "at-uri" },
            "conflictCheckPassed":{ "type": "boolean" },
            "materialHashProof": { "type": "string" }
          }
        }
      },
      "errors": [
        { "name": "Forbidden",      "description": "caller lacks leadBengoshi/firm-admin on matter" },
        { "name": "ConflictDetected","description": "grantee org overlaps with matter counterparties" },
        { "name": "ParentRevoked",  "description": "matter already revoked/closed" },
        { "name": "DepthLimit",     "description": "matter already at max did:gftd depth (6)" }
      ]
    }
  }
}
