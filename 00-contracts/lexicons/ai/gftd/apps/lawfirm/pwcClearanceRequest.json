{
  "lexicon": 1,
  "id": "ai.gftd.apps.lawfirm.pwcClearanceRequest",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Issue a PwC India compliance clearance request for a new matter. Routes to lawfirm_pwc_clearance BPMN; CEO HITL approve/deny within 72h SLA. Implements CEO decision D4 (2026-05-08).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["matter_uri", "client_name"],
          "properties": {
            "matter_uri":     { "type": "string" },
            "client_name":    { "type": "string" },
            "matter_summary": { "type": "string" },
            "requested_by_did": { "type": "string", "format": "did" },
            "pwc_contact":    { "type": "string", "description": "PwC India compliance contact email/name" },
            "sla_hours":      { "type": "integer", "default": 72 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok":               { "type": "boolean" },
            "clearance_uri":    { "type": "string" },
            "clearance_status": { "type": "string", "enum": ["pending", "no_conflict", "conflict", "need_more_info"] },
            "sla_deadline":     { "type": "string", "format": "datetime" },
            "error":            { "type": "string" }
          }
        }
      }
    }
  }
}
