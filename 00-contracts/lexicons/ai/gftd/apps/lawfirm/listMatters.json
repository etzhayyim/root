{
  "lexicon": 1,
  "id": "ai.gftd.apps.lawfirm.listMatters",
  "defs": {
    "main": {
      "type": "query",
      "description": "List law firm matters with offset/limit pagination, optional filters.",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "properties": {
          "matterType": { "type": "string" },
          "leadLawyerDid": { "type": "string", "format": "did" },
          "clientDid": { "type": "string", "format": "did" },
          "status": { "type": "string", "enum": ["open", "active", "stayed", "closed", "withdrawn"] },
          "jurisdiction": { "type": "string" },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["matters", "total", "offset", "limit"],
          "properties": {
            "matters": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "did": { "type": "string", "format": "did" },
                  "matterType": { "type": "string" },
                  "matterNumber": { "type": "string" },
                  "leadLawyerDid": { "type": "string", "format": "did" },
                  "status": { "type": "string" },
                  "openedAt": { "type": "string", "format": "datetime" }
                }
              }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
