{
  "lexicon": 1,
  "id": "ai.gftd.apps.lawfirm.eSignRequest",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Issue an e-signature request for an Engagement Letter / SOW / NDA. Provider-agnostic (DocuSign primary, Adobe Sign + RazorpaySign IN fallback). Persists vertex_lawfirm_esign_request and emits webhook listener config.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["document_kind", "matter_uri", "recipients"],
          "properties": {
            "document_kind": {
              "type": "string",
              "enum": ["engagementLetter", "pilotSOW", "saasSubscription", "nda", "amendment"]
            },
            "matter_uri":     { "type": "string", "description": "AT URI of the matter or contract record" },
            "recipients":     {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["email", "name", "role"],
                "properties": {
                  "email": { "type": "string" },
                  "name":  { "type": "string" },
                  "role":  { "type": "string", "enum": ["client", "advocate", "witness", "cc"] },
                  "did":   { "type": "string", "format": "did" }
                }
              }
            },
            "document_pdf_b64": { "type": "string", "description": "Base64-encoded PDF body (or templated)" },
            "template_id":      { "type": "string", "description": "DocuSign template ID (alternative to document_pdf_b64)" },
            "template_vars":    { "type": "string", "description": "JSON of template field substitutions" },
            "provider":         { "type": "string", "enum": ["docusign", "adobesign", "razorpaysign"], "default": "docusign" },
            "expires_in_days":  { "type": "integer", "default": 14 },
            "callback_url":     { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok":            { "type": "boolean" },
            "envelope_id":   { "type": "string" },
            "signing_urls":  { "type": "array", "items": { "type": "string" } },
            "expires_at":    { "type": "string", "format": "datetime" },
            "error":         { "type": "string" }
          }
        }
      }
    }
  }
}
