{
  "lexicon": 1,
  "id": "ai.gftd.signal.authEncryption",
  "description": "Encryption & Signal Protocol permissions. GFTD-only (no official AT Protocol equivalent). Includes com.atproto.server.getServiceAuth for key exchange bootstrapping.",
  "defs": {
    "main": {
      "type": "permission-set",
      "title": "Encryption & Signal Protocol",
      "title:lang": {
        "ja": "暗号化・Signal Protocol"
      },
      "detail": "Manage encryption devices, prekeys, identity verification, and group key rotation for end-to-end encrypted communication. Includes official service auth for key exchange bootstrapping.",
      "detail:lang": {
        "ja": "E2E暗号化通信のためのデバイス管理、プリキー、ID検証、グループキーローテーション。鍵交換ブートストラップのため公式サービス認証を含む"
      },
      "permissions": [
        {
          "type": "permission",
          "resource": "rpc",
          "description": "Official com.atproto RPCs used for key exchange bootstrapping",
          "lxm": [
            "com.atproto.server.getServiceAuth",
            "com.atproto.identity.resolveIdentity",
            "com.atproto.identity.getRecommendedDidCredentials"
          ]
        },
        {
          "type": "permission",
          "resource": "repo",
          "description": "GFTD signal record collections",
          "collection": ["ai.gftd.signal.*"],
          "action": ["create", "update", "delete"]
        },
        {
          "type": "permission",
          "resource": "rpc",
          "description": "GFTD signal extension RPCs",
          "lxm": [
            "ai.gftd.signal.listDevices",
            "ai.gftd.signal.getIdentityFingerprint",
            "ai.gftd.signal.getPrekeyBundle",
            "ai.gftd.signal.getPrekeyBundles",
            "ai.gftd.signal.setEncryption",
            "ai.gftd.signal.ensureDevice",
            "ai.gftd.signal.revokeDevice",
            "ai.gftd.signal.renameDevice",
            "ai.gftd.signal.verifyIdentity",
            "ai.gftd.signal.registerPrekeys",
            "ai.gftd.signal.replenishOtpks",
            "ai.gftd.signal.rotateGroupKey"
          ]
        }
      ]
    }
  }
}
