{
  "lexicon": 1,
  "id": "ai.gftd.signal.ensureDevice",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "deviceId": {
              "type": "string"
            },
            "deviceName": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "deviceId": {
              "type": "string"
            },
            "did": {
              "type": "string"
            },
            "provisioned": {
              "type": "boolean"
            }
          },
          "required": [
            "deviceId",
            "did",
            "provisioned"
          ]
        }
      }
    }
  }
}
