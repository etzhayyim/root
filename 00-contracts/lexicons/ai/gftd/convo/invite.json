{
  "lexicon": 1,
  "id": "ai.gftd.convo.invite",
  "description": "GFTD extension: conversation invite record. No official chat.bsky equivalent.",
  "defs": {
    "main": {
      "type": "record",
      "record": {
        "type": "object",
        "properties": {
          "convoId": {
            "type": "string"
          },
          "invitedDid": {
            "type": "string",
            "format": "did"
          },
          "invitedAt": {
            "type": "string",
            "format": "datetime"
          }
        },
        "required": [
          "convoId",
          "invitedDid",
          "invitedAt"
        ]
      }
    }
  }
}
