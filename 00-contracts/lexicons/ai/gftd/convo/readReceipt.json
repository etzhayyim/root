{
  "lexicon": 1,
  "id": "ai.gftd.convo.readReceipt",
  "description": "GFTD extension: explicit read receipt record. Official chat.bsky uses updateRead RPC instead.",
  "defs": {
    "main": {
      "type": "record",
      "record": {
        "type": "object",
        "properties": {
          "convoId": {
            "type": "string"
          },
          "readAt": {
            "type": "string",
            "format": "datetime"
          }
        },
        "required": [
          "convoId",
          "readAt"
        ]
      }
    }
  }
}
