{
  "lexicon": 1,
  "id": "ai.gftd.convo.authConversation",
  "description": "Conversation permissions. Superset of chat.bsky.authFullChatClient — includes all official chat.bsky RPCs/collections plus GFTD extensions (edit, pin, forward, presence, encryption).",
  "defs": {
    "main": {
      "type": "permission-set",
      "title": "Conversations",
      "title:lang": {
        "ja": "会話機能"
      },
      "detail": "Create, send, and manage conversations. Includes all official chat.bsky features plus GFTD extensions: message editing, pinning, forwarding, presence tracking, and E2E encryption.",
      "detail:lang": {
        "ja": "会話の作成・送信・管理。公式chat.bsky全機能に加え、メッセージ編集・ピン・転送・プレゼンス・E2E暗号化などGFTD拡張を含む"
      },
      "permissions": [
        {
          "type": "permission",
          "resource": "repo",
          "description": "Official chat.bsky record collections",
          "collection": ["chat.bsky.actor.declaration"],
          "action": ["create", "update", "delete"]
        },
        {
          "type": "permission",
          "resource": "rpc",
          "description": "Official chat.bsky RPCs (from chat.bsky.authFullChatClient)",
          "inheritAud": true,
          "lxm": [
            "chat.bsky.actor.deleteAccount",
            "chat.bsky.actor.exportAccountData",
            "chat.bsky.convo.acceptConvo",
            "chat.bsky.convo.addReaction",
            "chat.bsky.convo.deleteMessageForSelf",
            "chat.bsky.convo.getConvo",
            "chat.bsky.convo.getConvoAvailability",
            "chat.bsky.convo.getConvoForMembers",
            "chat.bsky.convo.getLog",
            "chat.bsky.convo.getMessages",
            "chat.bsky.convo.leaveConvo",
            "chat.bsky.convo.listConvos",
            "chat.bsky.convo.muteConvo",
            "chat.bsky.convo.removeReaction",
            "chat.bsky.convo.sendMessage",
            "chat.bsky.convo.sendMessageBatch",
            "chat.bsky.convo.unmuteConvo",
            "chat.bsky.convo.updateAllRead",
            "chat.bsky.convo.updateRead"
          ]
        },
        {
          "type": "permission",
          "resource": "repo",
          "description": "GFTD extension record collections",
          "collection": ["ai.gftd.convo.*"],
          "action": ["create", "update", "delete"]
        },
        {
          "type": "permission",
          "resource": "rpc",
          "description": "GFTD extension RPCs",
          "lxm": [
            "ai.gftd.convo.createConvo",
            "ai.gftd.convo.send",
            "ai.gftd.convo.edit",
            "ai.gftd.convo.getThread",
            "ai.gftd.convo.search",
            "ai.gftd.convo.listMembers",
            "ai.gftd.convo.getUnread",
            "ai.gftd.convo.listPresence",
            "ai.gftd.convo.listPublicConvos",
            "ai.gftd.convo.getProfile",
            "ai.gftd.convo.diff",
            "ai.gftd.convo.fetchBlocks",
            "ai.gftd.convo.joinConvo",
            "ai.gftd.convo.updateConvo",
            "ai.gftd.convo.archiveConvo",
            "ai.gftd.convo.inviteMember",
            "ai.gftd.convo.updateMemberRole",
            "ai.gftd.convo.updatePresence",
            "ai.gftd.convo.sendTyping",
            "ai.gftd.convo.setProfile",
            "ai.gftd.convo.pinMessage",
            "ai.gftd.convo.unpinMessage",
            "ai.gftd.convo.forwardMessage",
            "ai.gftd.convo.setEncryption"
          ]
        }
      ]
    }
  }
}
