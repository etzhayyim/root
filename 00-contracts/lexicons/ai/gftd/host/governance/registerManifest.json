        "schema": {
          "type": "object",
          "properties": {
            "manifestJson": {
              "type": "string"
            }
          },
          "required": [
            "manifestJson"
          ]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            }
          },
          "required": [
            "ok"
          ]
        }
      }
    }
  }
}
