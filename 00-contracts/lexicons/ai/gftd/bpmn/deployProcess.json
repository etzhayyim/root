{
  "lexicon": 1,
  "id": "ai.gftd.bpmn.deployProcess",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Deploy a BPMN 2.0 XML process definition. Compiles to ActorManifest pipeline and decomposes into graph (BpmnProcess, BpmnElement, EdgeSequenceFlow).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "did": { "type": "string", "description": "Target actor DID" },
            "name": { "type": "string", "description": "Actor name" },
            "nanoid": { "type": "string", "description": "Actor nanoid" },
            "bpmnXml": { "type": "string", "description": "BPMN 2.0 XML string" },
            "dmnXml": { "type": "string", "description": "Optional DMN 1.3 XML for BusinessRuleTask" },
            "formSchemas": { "type": "object", "description": "Optional form schemas keyed by formId" }
          },
          "required": ["did", "bpmnXml"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "deployed": { "type": "boolean" },
            "did": { "type": "string" },
            "runtime": { "type": "string", "knownValues": ["k8s-langserver"] },
            "edge": { "type": "string", "knownValues": ["sveltekit-proxy"] },
            "legacyExecutionTier": { "type": "string", "knownValues": ["T1", "T2", "T3"] },
            "stepsCount": { "type": "integer" },
            "capabilities": { "type": "array", "items": { "type": "string" } },
            "warnings": { "type": "array", "items": { "type": "string" } },
            "graph": {
              "type": "object",
              "properties": {
                "processVid": { "type": "string" },
                "elements": { "type": "integer" },
                "flows": { "type": "integer" },
                "errors": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "required": ["deployed", "did"]
        }
      }
    }
  }
}
