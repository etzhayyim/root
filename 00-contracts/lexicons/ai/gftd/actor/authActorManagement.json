{
  "lexicon": 1,
  "id": "ai.gftd.actor.authActorManagement",
  "description": "Actor management permissions. Superset — includes official app.bsky.actor profile/preferences RPCs plus GFTD actor lifecycle, tool grants, and BPMN/DMN operations.",
  "defs": {
    "main": {
      "type": "permission-set",
      "title": "Actor Management",
      "title:lang": {
        "ja": "Actor管理"
      },
      "detail": "Create, update, and manage actors. Includes official profile and preferences management, plus GFTD-specific actor lifecycle, tool grants, pipeline execution, and BPMN/DMN operations.",
      "detail:lang": {
        "ja": "Actorの作成・更新・管理。公式プロフィール/プリファレンス管理に加え、GFTDのActorライフサイクル、ツール付与、パイプライン実行、BPMN/DMN操作を含む"
      },
      "permissions": [
        {
          "type": "permission",
          "resource": "repo",
          "description": "Official app.bsky actor record collections",
          "collection": [
            "app.bsky.actor.profile",
            "app.bsky.actor.status"
          ],
          "action": ["create", "update", "delete"]
        },
        {
          "type": "permission",
          "resource": "rpc",
          "description": "Official app.bsky actor RPCs",
          "lxm": [
            "app.bsky.actor.getPreferences",
            "app.bsky.actor.getProfile",
            "app.bsky.actor.getProfiles",
            "app.bsky.actor.putPreferences",
            "app.bsky.actor.searchActors",
            "app.bsky.actor.searchActorsTypeahead"
          ]
        },
        {
          "type": "permission",
          "resource": "repo",
          "description": "GFTD actor record collections",
          "collection": ["ai.gftd.actor.*"],
          "action": ["create", "update", "delete"]
        },
        {
          "type": "permission",
          "resource": "rpc",
          "description": "GFTD actor extension RPCs",
          "lxm": [
            "ai.gftd.actor.get",
            "ai.gftd.actor.list",
            "ai.gftd.actor.listTools",
            "ai.gftd.actor.create",
            "ai.gftd.actor.update",
            "ai.gftd.actor.delete",
            "ai.gftd.actor.setStatus",
            "ai.gftd.actor.heartbeatBatch",
            "ai.gftd.actor.grantTool",
            "ai.gftd.actor.revokeTool",
            "ai.gftd.actor.executePipeline",
            "ai.gftd.actor.registerManifest",
            "ai.gftd.actor.getManifest",
            "ai.gftd.actor.validateManifest",
            "ai.gftd.actor.compileBpmn",
            "ai.gftd.actor.deployProcess",
            "ai.gftd.dmn.evaluate",
            "ai.gftd.form.submit"
          ]
        }
      ]
    }
  }
}
