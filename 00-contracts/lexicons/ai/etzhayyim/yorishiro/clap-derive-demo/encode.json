{
  "lexicon": 1,
  "id": "ai.etzhayyim.yorishiro.clap-derive-demo.encode",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Demo clap derive-style CLI used by the yorishiro fixture.",
      "x-yorishiro-external": true,
      "x-yorishiro-kami": "bin:clap-derive-demo",
      "x-yorishiro-transport": "binary-cli",
      "x-yorishiro-binary": {
        "binary": "clap-derive-demo",
        "argv": [
          {
            "kind": "flag",
            "name": "verbose",
            "flag": "--verbose",
            "type": "boolean",
            "description": "Enable verbose logging across all subcommands."
          },
          {
            "kind": "flag",
            "name": "config",
            "flag": "--config",
            "type": "string",
            "default": "/etc/derive.conf",
            "description": "Path to config file."
          },
          {
            "kind": "positional",
            "name": "input_path",
            "position": 0,
            "required": true,
            "type": "string"
          },
          {
            "kind": "flag",
            "name": "bitrate",
            "flag": "--bitrate",
            "type": "integer",
            "default": 192
          },
          {
            "kind": "flag",
            "name": "lossless",
            "flag": "--lossless",
            "type": "boolean"
          }
        ],
        "stdout_capture": true,
        "stderr_capture": true,
        "exit_code_ok": [
          0
        ],
        "timeout_seconds": 300
      },
      "x-charter-purpose": [
        "grant"
      ],
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "input_path"
          ],
          "properties": {
            "verbose": {
              "type": "boolean",
              "description": "Enable verbose logging across all subcommands."
            },
            "config": {
              "type": "string",
              "description": "Path to config file.",
              "default": "/etc/derive.conf"
            },
            "input_path": {
              "type": "string"
            },
            "bitrate": {
              "type": "integer",
              "default": 192
            },
            "lossless": {
              "type": "boolean"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "exitCode"
          ],
          "properties": {
            "exitCode": {
              "type": "integer",
              "description": "Exit code of the binary."
            },
            "stdout": {
              "type": "string",
              "description": "Captured stdout (UTF-8 best-effort)."
            },
            "stderr": {
              "type": "string",
              "description": "Captured stderr (UTF-8 best-effort)."
            },
            "error": {
              "type": "string",
              "description": "Set when the binary could not be launched at all."
            }
          }
        }
      }
    }
  }
}
