{
  "lexicon": 1,
  "id": "ai.etzhayyim.yorishiro.argparse-demo.main",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Demo argparse CLI used by the yorishiro source-repo fixture.",
      "x-yorishiro-external": true,
      "x-yorishiro-kami": "bin:argparse-demo",
      "x-yorishiro-transport": "binary-cli",
      "x-yorishiro-binary": {
        "binary": "argparse-demo",
        "argv": [
          {
            "kind": "positional",
            "name": "source_path",
            "position": 0,
            "required": true,
            "type": "string",
            "description": "Path to read from."
          },
          {
            "kind": "positional",
            "name": "output_path",
            "position": 1,
            "required": false,
            "type": "string",
            "default": "-",
            "description": "Output path; '-' for stdout."
          },
          {
            "kind": "flag",
            "name": "max_rows",
            "flag": "--max-rows",
            "type": "integer",
            "default": 100,
            "description": "Maximum rows to emit."
          },
          {
            "kind": "flag",
            "name": "encoding",
            "flag": "--encoding",
            "type": "string",
            "default": "utf-8",
            "description": "Output encoding."
          },
          {
            "kind": "flag",
            "name": "verbose",
            "flag": "--verbose",
            "type": "boolean",
            "description": "Enable verbose logging."
          },
          {
            "kind": "flag",
            "name": "dry_run",
            "flag": "--dry-run",
            "type": "boolean",
            "description": "Plan without writing."
          }
        ],
        "stdout_capture": true,
        "stderr_capture": true,
        "exit_code_ok": [
          0
        ],
        "timeout_seconds": 300
      },
      "x-charter-purpose": [
        "grant"
      ],
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "source_path"
          ],
          "properties": {
            "source_path": {
              "type": "string",
              "description": "Path to read from."
            },
            "output_path": {
              "type": "string",
              "description": "Output path; '-' for stdout.",
              "default": "-"
            },
            "max_rows": {
              "type": "integer",
              "description": "Maximum rows to emit.",
              "default": 100
            },
            "encoding": {
              "type": "string",
              "description": "Output encoding.",
              "default": "utf-8"
            },
            "verbose": {
              "type": "boolean",
              "description": "Enable verbose logging."
            },
            "dry_run": {
              "type": "boolean",
              "description": "Plan without writing."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "exitCode"
          ],
          "properties": {
            "exitCode": {
              "type": "integer",
              "description": "Exit code of the binary."
            },
            "stdout": {
              "type": "string",
              "description": "Captured stdout (UTF-8 best-effort)."
            },
            "stderr": {
              "type": "string",
              "description": "Captured stderr (UTF-8 best-effort)."
            },
            "error": {
              "type": "string",
              "description": "Set when the binary could not be launched at all."
            }
          }
        }
      }
    }
  }
}
