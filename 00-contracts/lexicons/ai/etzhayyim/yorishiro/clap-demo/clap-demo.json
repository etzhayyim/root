{
  "lexicon": 1,
  "id": "ai.etzhayyim.yorishiro.clap-demo.clap-demo",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Longer description of the clap demo CLI for the source-repo extractor.",
      "x-yorishiro-external": true,
      "x-yorishiro-kami": "bin:clap-demo",
      "x-yorishiro-transport": "binary-cli",
      "x-yorishiro-binary": {
        "binary": "clap-demo",
        "argv": [
          {
            "kind": "positional",
            "name": "input_path",
            "position": 0,
            "required": true,
            "type": "string",
            "description": "Source path to read."
          },
          {
            "kind": "positional",
            "name": "output_path",
            "position": 1,
            "required": false,
            "type": "string",
            "description": "Output path; '-' for stdout."
          },
          {
            "kind": "flag",
            "name": "max_rows",
            "flag": "--max-rows",
            "type": "integer",
            "default": 100,
            "description": "Maximum rows to emit."
          },
          {
            "kind": "flag",
            "name": "encoding",
            "flag": "--encoding",
            "type": "string",
            "default": "utf-8",
            "description": "Output encoding."
          },
          {
            "kind": "flag",
            "name": "verbose",
            "flag": "--verbose",
            "type": "boolean",
            "description": "Enable verbose logging."
          }
        ],
        "stdout_capture": true,
        "stderr_capture": true,
        "exit_code_ok": [
          0
        ],
        "timeout_seconds": 300
      },
      "x-charter-purpose": [
        "grant"
      ],
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "input_path"
          ],
          "properties": {
            "input_path": {
              "type": "string",
              "description": "Source path to read."
            },
            "output_path": {
              "type": "string",
              "description": "Output path; '-' for stdout."
            },
            "max_rows": {
              "type": "integer",
              "description": "Maximum rows to emit.",
              "default": 100
            },
            "encoding": {
              "type": "string",
              "description": "Output encoding.",
              "default": "utf-8"
            },
            "verbose": {
              "type": "boolean",
              "description": "Enable verbose logging."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "exitCode"
          ],
          "properties": {
            "exitCode": {
              "type": "integer",
              "description": "Exit code of the binary."
            },
            "stdout": {
              "type": "string",
              "description": "Captured stdout (UTF-8 best-effort)."
            },
            "stderr": {
              "type": "string",
              "description": "Captured stderr (UTF-8 best-effort)."
            },
            "error": {
              "type": "string",
              "description": "Set when the binary could not be launched at all."
            }
          }
        }
      }
    }
  }
}
