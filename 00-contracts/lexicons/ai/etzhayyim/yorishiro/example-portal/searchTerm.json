{
  "lexicon": 1,
  "id": "ai.etzhayyim.yorishiro.example-portal.searchTerm",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Hypothetical flow exercising fill + click + scroll + multi-extract — the page itself does NOT have a real search box, but the kami manifest is shaped this way to validate the L1 emitter's required-input derivation.",
      "x-yorishiro-external": true,
      "x-yorishiro-kami": "browser:example-portal",
      "x-yorishiro-transport": "browser-only",
      "x-yorishiro-browser": {
        "base_url": "https://example.com",
        "auth_hint": "none",
        "steps": [
          {
            "kind": "goto",
            "url_template": "https://example.com/search"
          },
          {
            "kind": "wait_for",
            "selector": "input[name=q]",
            "timeout_ms": 5000
          },
          {
            "kind": "fill",
            "selector": "input[name=q]",
            "value_input_key": "query"
          },
          {
            "kind": "click",
            "selector": "button[type=submit]"
          },
          {
            "kind": "wait_for",
            "selector": ".result",
            "timeout_ms": 8000
          },
          {
            "kind": "scroll_to",
            "selector": ".result:last-child"
          }
        ],
        "extract": [
          {
            "output_key": "result_titles",
            "selector": ".result h2",
            "multiple": true
          },
          {
            "output_key": "result_count_label",
            "selector": ".result-count"
          }
        ]
      },
      "x-charter-purpose": [
        "grant"
      ],
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "query"
          ],
          "properties": {
            "query": {
              "type": "string",
              "description": "Value bound to a DOM step input."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "ok"
          ],
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "error": {
              "type": "string"
            },
            "result_titles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "DOM extract .result h2"
            },
            "result_count_label": {
              "type": "string",
              "description": "DOM extract .result-count"
            }
          }
        }
      }
    }
  }
}
