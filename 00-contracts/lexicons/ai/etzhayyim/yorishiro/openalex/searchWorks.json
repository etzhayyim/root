{
  "lexicon": 1,
  "id": "ai.etzhayyim.yorishiro.openalex.searchWorks",
  "defs": {
    "main": {
      "type": "query",
      "description": "Full-text + structured search over the OpenAlex works index.",
      "x-yorishiro-external": true,
      "x-yorishiro-kami": "api.openalex.org",
      "x-yorishiro-transport": "openapi-v3",
      "x-yorishiro-http": {
        "method": "GET",
        "pathTemplate": "/works",
        "responseContentType": "application/json",
        "pathParams": [],
        "queryParams": [
          "search",
          "filter",
          "sort",
          "per_page",
          "page"
        ],
        "bodyParams": []
      },
      "x-charter-purpose": [
        "grant",
        "kisha"
      ],
      "parameters": {
        "type": "params",
        "required": [],
        "properties": {
          "search": {
            "type": "string",
            "maxLength": 1024,
            "description": "Free-text query."
          },
          "filter": {
            "type": "string",
            "maxLength": 2048,
            "description": "OpenAlex filter expression (e.g. `concepts.id:C41008148,publication_year:>2020`)."
          },
          "sort": {
            "type": "string",
            "maxLength": 128,
            "description": "Sort field (e.g. `cited_by_count:desc`)."
          },
          "per_page": {
            "type": "integer",
            "default": 25,
            "minimum": 1,
            "maximum": 200,
            "description": "Results per page (rename of `per-page` for valid JSON key)."
          },
          "page": {
            "type": "integer",
            "default": 1,
            "minimum": 1,
            "description": "1-based page index."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "httpStatus"
          ],
          "properties": {
            "httpStatus": {
              "type": "integer"
            },
            "json": {
              "type": "object",
              "description": "{ meta, results, group_by }."
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
