{
  "lexicon": 1,
  "id": "ai.etzhayyim.yorishiro.huggingface-inference.extractFeatures",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "POST text to the configured model and receive its hidden-state vector representation. Used by mst-projector embedders. The API key is supplied via Authorization: Bearer <key> by the caller and is NOT part of this lexicon — yorishiri never store credentials.",
      "x-yorishiro-external": true,
      "x-yorishiro-kami": "api-inference.huggingface.co",
      "x-yorishiro-transport": "openapi-v3",
      "x-yorishiro-http": {
        "method": "POST",
        "pathTemplate": "/pipeline/feature-extraction/{model_id}",
        "responseContentType": "application/json",
        "pathParams": [
          "model_id"
        ],
        "queryParams": [],
        "bodyParams": [
          "inputs",
          "wait_for_model"
        ]
      },
      "x-charter-purpose": [
        "grant"
      ],
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "model_id",
            "inputs"
          ],
          "properties": {
            "model_id": {
              "type": "string",
              "minLength": 3,
              "maxLength": 256,
              "description": "Model id on the Hub (e.g. `sentence-transformers/all-MiniLM-L6-v2`)."
            },
            "inputs": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768,
              "description": "Text to embed (single string or batched). Phase 1: single only."
            },
            "wait_for_model": {
              "type": "boolean",
              "default": true,
              "description": "Wait for cold-start instead of returning 503."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "httpStatus"
          ],
          "properties": {
            "httpStatus": {
              "type": "integer"
            },
            "json": {
              "type": "object",
              "description": "number[][] (or number[]) depending on model output shape."
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
