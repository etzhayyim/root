{
  "lexicon": 1,
  "id": "ai.etzhayyim.yorishiro.bls.fetchTimeseries",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "POST a list of BLS series ids and an inclusive year range. Returns the requested observations keyed by series id under `Results.series[]`. Unauthenticated calls are rate-limited to 25/day per IP and to a 10-year max range; authenticated calls (with `registrationkey`) extend to 500/day and 20 years.",
      "x-yorishiro-external": true,
      "x-yorishiro-kami": "api.bls.gov",
      "x-yorishiro-transport": "openapi-v3",
      "x-yorishiro-http": {
        "method": "POST",
        "pathTemplate": "/publicAPI/v2/timeseries/data/",
        "responseContentType": "application/json",
        "pathParams": [],
        "queryParams": [],
        "bodyParams": [
          "seriesid",
          "startyear",
          "endyear",
          "registrationkey",
          "catalog",
          "calculations",
          "annualaverage"
        ]
      },
      "x-charter-purpose": [
        "grant"
      ],
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "seriesid"
          ],
          "properties": {
            "seriesid": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "description": "BLS series ids (e.g. `CES0000000001`, `LNS14000000`)."
            },
            "startyear": {
              "type": "string",
              "description": "Inclusive lower bound (4-digit year, string form per BLS contract)."
            },
            "endyear": {
              "type": "string",
              "description": "Inclusive upper bound."
            },
            "registrationkey": {
              "type": "string",
              "description": "Optional BLS API registration key (extends quota)."
            },
            "catalog": {
              "type": "boolean",
              "description": "If true, includes series metadata catalog in the response."
            },
            "calculations": {
              "type": "boolean",
              "description": "If true, includes 1/3/6/12-month percent change calculations."
            },
            "annualaverage": {
              "type": "boolean",
              "description": "If true, includes annual averages."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "httpStatus"
          ],
          "properties": {
            "httpStatus": {
              "type": "integer"
            },
            "json": {
              "type": "object",
              "description": "{ status, responseTime, message, Results: { series: [{ seriesID, data: [{year, period, periodName, value, footnotes }, …] }] } }."
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
