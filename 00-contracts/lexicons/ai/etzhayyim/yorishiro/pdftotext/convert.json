{
  "lexicon": 1,
  "id": "ai.etzhayyim.yorishiro.pdftotext.convert",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Invoke `pdftotext [flags] <pdf_file> [text_file]`. When `text_file` is '-' (default) the result lands on stdout; the cell captures stdout and returns it in the response.",
      "x-yorishiro-external": true,
      "x-yorishiro-kami": "bin:pdftotext",
      "x-yorishiro-transport": "binary-cli",
      "x-yorishiro-binary": {
        "binary": "pdftotext",
        "argv": [
          {
            "kind": "flag",
            "name": "first_page",
            "flag": "-f",
            "type": "integer",
            "description": "First page to convert (1-based)."
          },
          {
            "kind": "flag",
            "name": "last_page",
            "flag": "-l",
            "type": "integer",
            "description": "Last page to convert (inclusive)."
          },
          {
            "kind": "flag",
            "name": "layout",
            "flag": "-layout",
            "type": "boolean",
            "description": "Maintain (as best as possible) original physical layout."
          },
          {
            "kind": "flag",
            "name": "raw",
            "flag": "-raw",
            "type": "boolean",
            "description": "Keep strings in content stream order."
          },
          {
            "kind": "flag",
            "name": "encoding",
            "flag": "-enc",
            "type": "string",
            "default": "UTF-8",
            "description": "Output text encoding name (e.g. UTF-8, Latin1)."
          },
          {
            "kind": "positional",
            "name": "pdf_file",
            "position": 0,
            "required": true,
            "type": "string",
            "description": "Input PDF path on the cell runtime filesystem."
          },
          {
            "kind": "positional",
            "name": "text_file",
            "position": 1,
            "required": false,
            "type": "string",
            "default": "-",
            "description": "Output text path; '-' (default) sends to stdout, which the cell captures."
          }
        ],
        "stdout_capture": true,
        "stderr_capture": true,
        "exit_code_ok": [
          0
        ],
        "timeout_seconds": 60
      },
      "x-charter-purpose": [
        "grant"
      ],
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "pdf_file"
          ],
          "properties": {
            "first_page": {
              "type": "integer",
              "description": "First page to convert (1-based)."
            },
            "last_page": {
              "type": "integer",
              "description": "Last page to convert (inclusive)."
            },
            "layout": {
              "type": "boolean",
              "description": "Maintain (as best as possible) original physical layout."
            },
            "raw": {
              "type": "boolean",
              "description": "Keep strings in content stream order."
            },
            "encoding": {
              "type": "string",
              "description": "Output text encoding name (e.g. UTF-8, Latin1).",
              "default": "UTF-8"
            },
            "pdf_file": {
              "type": "string",
              "description": "Input PDF path on the cell runtime filesystem."
            },
            "text_file": {
              "type": "string",
              "description": "Output text path; '-' (default) sends to stdout, which the cell captures.",
              "default": "-"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "exitCode"
          ],
          "properties": {
            "exitCode": {
              "type": "integer",
              "description": "Exit code of the binary."
            },
            "stdout": {
              "type": "string",
              "description": "Captured stdout (UTF-8 best-effort)."
            },
            "stderr": {
              "type": "string",
              "description": "Captured stderr (UTF-8 best-effort)."
            },
            "error": {
              "type": "string",
              "description": "Set when the binary could not be launched at all."
            }
          }
        }
      }
    }
  }
}
