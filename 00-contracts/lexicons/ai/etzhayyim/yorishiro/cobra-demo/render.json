{
  "lexicon": 1,
  "id": "ai.etzhayyim.yorishiro.cobra-demo.render",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Render output to file or stdout.",
      "x-yorishiro-external": true,
      "x-yorishiro-kami": "bin:cobra-demo",
      "x-yorishiro-transport": "binary-cli",
      "x-yorishiro-binary": {
        "binary": "cobra-demo",
        "argv": [
          {
            "kind": "flag",
            "name": "verbose",
            "flag": "--verbose",
            "type": "boolean",
            "default": false,
            "description": "Enable verbose logging."
          },
          {
            "kind": "flag",
            "name": "config",
            "flag": "--config",
            "type": "string",
            "default": "/etc/cobra-demo.yaml",
            "description": "Path to config file."
          },
          {
            "kind": "flag",
            "name": "max_rows",
            "flag": "--max-rows",
            "type": "integer",
            "default": 100,
            "description": "Maximum rows."
          },
          {
            "kind": "flag",
            "name": "quality",
            "flag": "--quality",
            "type": "number",
            "default": 0.9,
            "description": "Quality multiplier."
          },
          {
            "kind": "positional",
            "name": "arg0",
            "position": 0,
            "required": true,
            "type": "string",
            "description": "Positional argument 0 (cobra MinimumNArgs)."
          }
        ],
        "stdout_capture": true,
        "stderr_capture": true,
        "exit_code_ok": [
          0
        ],
        "timeout_seconds": 300
      },
      "x-charter-purpose": [
        "grant"
      ],
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "arg0"
          ],
          "properties": {
            "verbose": {
              "type": "boolean",
              "description": "Enable verbose logging.",
              "default": false
            },
            "config": {
              "type": "string",
              "description": "Path to config file.",
              "default": "/etc/cobra-demo.yaml"
            },
            "max_rows": {
              "type": "integer",
              "description": "Maximum rows.",
              "default": 100
            },
            "quality": {
              "type": "number",
              "description": "Quality multiplier.",
              "default": 0.9
            },
            "arg0": {
              "type": "string",
              "description": "Positional argument 0 (cobra MinimumNArgs)."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "exitCode"
          ],
          "properties": {
            "exitCode": {
              "type": "integer",
              "description": "Exit code of the binary."
            },
            "stdout": {
              "type": "string",
              "description": "Captured stdout (UTF-8 best-effort)."
            },
            "stderr": {
              "type": "string",
              "description": "Captured stderr (UTF-8 best-effort)."
            },
            "error": {
              "type": "string",
              "description": "Set when the binary could not be launched at all."
            }
          }
        }
      }
    }
  }
}
