{
  "lexicon": 1,
  "id": "app.etzhayyim.apps.publicMalak.getCampaignCluster",
  "defs": {
    "main": {
      "type": "query",
      "description": "Fetch one public ad campaign cluster, linked creatives, and recent intel analyses for those creatives.",
      "parameters": {
        "type": "params",
        "properties": {
          "vertexId": { "type": "string" },
          "campaignKey": { "type": "string" },
          "creativeLimit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
          "analysisLimit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["cluster"],
          "properties": {
            "cluster": { "type": "ref", "ref": "app.etzhayyim.apps.publicMalak.listCampaignClusters#campaignClusterView" },
            "creatives": {
              "type": "array",
              "items": { "type": "ref", "ref": "app.etzhayyim.apps.publicMalak.listCampaignClusters#clusterCreativeView" }
            },
            "analyses": {
              "type": "array",
              "items": { "type": "ref", "ref": "app.etzhayyim.apps.publicMalak.listAnalyses#analysisView" }
            },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
