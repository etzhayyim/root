{
  "lexicon": 1,
  "id": "com.etzhayyim.kagami.graph.query",
  "defs": {
    "main": {
      "type": "query",
      "description": "Legacy graph query endpoint (v2.2 era). Prefer com.etzhayyim.kagami.sql for new code. Accepts raw SQL via the `statement` field.",
      "parameters": {
        "type": "params",
        "properties": {
          "statement": { "type": "string" },
          "query": { "type": "string" },
          "parameters": { "type": "object" },
          "timeoutMs": { "type": "integer" },
          "maxRows": { "type": "integer" },
          "limit": { "type": "integer" },
          "offset": { "type": "integer" },
          "namespace": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "rows": { "type": "array", "items": { "type": "object" } }
          },
          "required": ["rows"]
        }
      }
    }
  }
}
