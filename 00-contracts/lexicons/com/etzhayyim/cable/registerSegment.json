{
  "lexicon": 1,
  "id": "com.etzhayyim.cable.registerSegment",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Assert a cable's landing sequence into the kotoba Datom log: emits the bipartite incidence edges (:cable.link/* — cable lands at each station) AND the station-to-station segment edges (:cable.seg/* — with the chokepoints each segment traverses). Replaces the implicit routeSegmentId of the legacy etzhayyim lexicons with first-class edges.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["cableId", "landingSequence", "sourcing", "observedAt"],
          "properties": {
            "cableId": { "type": "string", "description": ":cable/id (must already be registered)" },
            "landingSequence": {
              "type": "array",
              "items": { "type": "string" },
              "description": "ordered :station/id list along the cable; consecutive pairs become :cable.seg edges"
            },
            "segmentTraversals": {
              "type": "array",
              "items": { "type": "ref", "ref": "#segmentTraversal" },
              "description": "optional per-segment chokepoint tags (resilience signal; NOT a route-to-cut, G2)"
            },
            "sourcing": { "type": "string", "enum": ["authoritative", "representative", "synthesized"] },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "cableId": { "type": "string" },
            "linkCount": { "type": "integer", "description": "# :cable.link edges asserted" },
            "segmentCount": { "type": "integer", "description": "# :cable.seg edges asserted" },
            "txCid": { "type": "string" },
            "datomCount": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    },
    "segmentTraversal": {
      "type": "object",
      "description": "one station-to-station segment and the named maritime chokepoints it traverses",
      "properties": {
        "fromStationId": { "type": "string" },
        "toStationId": { "type": "string" },
        "traverses": {
          "type": "array",
          "items": { "type": "string", "enum": ["luzon-strait", "malacca", "suez-red-sea", "south-china-sea", "gibraltar", "hormuz", "bab-el-mandeb", "sunda", "lombok", "taiwan-strait"] }
        }
      }
    }
  }
}
