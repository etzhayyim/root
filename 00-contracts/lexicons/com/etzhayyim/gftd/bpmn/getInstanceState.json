{
  "lexicon": 1,
  "id": "com.etzhayyim.bpmn.getInstanceState",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get full instance state (variables + current token + recent events).",
      "parameters": {
        "type": "params",
        "required": ["instanceId"],
        "properties": { "instanceId": { "type": "string" } }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "instanceId": { "type": "string" },
            "instance": { "type": "unknown" },
            "events": { "type": "array", "items": { "type": "unknown" } }
          }
        }
      }
    }
  }
}
