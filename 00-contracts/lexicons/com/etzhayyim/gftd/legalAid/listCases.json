{
  "lexicon": 1,
  "id": "com.etzhayyim.legalAid.listCases",
  "defs": {
    "main": {
      "type": "query",
      "description": "List legal aid cases with offset/limit pagination, optional filters.",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "properties": {
          "jurisdiction": { "type": "string" },
          "matter": { "type": "string" },
          "status": { "type": "string", "enum": ["pending-means-test", "approved", "in-progress", "closed", "denied"] },
          "lawyerDid": { "type": "string", "format": "did" },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["cases", "total", "offset", "limit"],
          "properties": {
            "cases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "did": { "type": "string", "format": "did" },
                  "jurisdiction": { "type": "string" },
                  "matter": { "type": "string" },
                  "status": { "type": "string" },
                  "filedAt": { "type": "string", "format": "datetime" }
                }
              }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
