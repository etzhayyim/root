{
  "lexicon": 1,
  "id": "com.etzhayyim.legalAid.assignDefender",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Assign a public defender / panel attorney to a legal aid case.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["caseDid", "lawyerDid", "assignedAt"],
          "properties": {
            "caseDid": { "type": "string", "format": "did" },
            "lawyerDid": { "type": "string", "format": "did", "description": "bengoshi.etzhayyim.com DID" },
            "assignedAt": { "type": "string", "format": "datetime" },
            "role": { "type": "string", "enum": ["lead", "associate", "duty-counsel"] },
            "feeStructure": { "type": "string", "enum": ["pro-bono", "panel-rate", "subsidized"] }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri"],
          "properties": {
            "uri": { "type": "string", "format": "at-uri" }
          }
        }
      }
    }
  }
}
