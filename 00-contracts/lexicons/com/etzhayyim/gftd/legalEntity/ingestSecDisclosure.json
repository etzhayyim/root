{
  "lexicon": 1,
  "id": "com.etzhayyim.legalEntity.ingestSecDisclosure",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Dispatch SEC EDGAR submissions and companyfacts ingest for one issuer to the Zeebe Python collector.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ticker": { "type": "string", "description": "Listed ticker symbol. Used to resolve the SEC CIK when cik is omitted." },
            "cik": { "type": "string", "description": "SEC Central Index Key. Digits only or zero-padded 10-digit form." },
            "filingLimit": { "type": "integer", "description": "Max filing records to emit (default 20, max 100)." },
            "factsLimit": { "type": "integer", "description": "Max company fact records to emit (default 50, max 200)." }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "movedToZeebe": { "type": "boolean" },
            "processId": { "type": "string" },
            "taskTypes": { "type": "array", "items": { "type": "string" } },
            "variables": { "type": "object" },
            "commitCommand": { "type": "string" },
            "error": { "type": "string" },
            "ts": { "type": "string", "format": "datetime" }
          }
        }
      }
    }
  }
}
