{
  "lexicon": 1,
  "id": "com.etzhayyim.legalEntity.collectGlobal",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Collect GLEIF LEI records (global corporate registry). Paginated bulk ingest.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "pages": { "type": "integer", "description": "Number of pages to fetch (default 5, max 50)" },
            "pageSize": { "type": "integer", "description": "Records per page (max 200)" },
            "startPage": { "type": "integer", "description": "Starting page number (default 1)" }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "movedToZeebe": { "type": "boolean" },
            "processId": { "type": "string" },
            "taskTypes": { "type": "array", "items": { "type": "string" } },
            "variables": { "type": "object" },
            "commitCommand": { "type": "string" },
            "source": { "type": "string" },
            "pagesProcessed": { "type": "integer" },
            "totalInserted": { "type": "integer" },
            "totalSkipped": { "type": "integer" },
            "apiTotal": { "type": "integer" }
          }
        }
      }
    }
  }
}
