{
  "lexicon": 1,
  "id": "com.etzhayyim.otakiage.coverage",
  "defs": {
    "main": {
      "type": "query",
      "description": "platform-wide coverage 状況。mv_otakiage_items_by_state を返す。reuse / ritual の流量モニタ用。",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["totalItems", "byState", "byCategory", "upcomingMatsuri", "lifetimeRitualizedCount", "lifetimeHandedOverCount"],
          "properties": {
            "totalItems": {"type": "integer"},
            "byState": {"type": "string", "description": "JSON {state: count}"},
            "byCategory": {"type": "string", "description": "JSON {category: count}"},
            "upcomingMatsuri": {"type": "integer", "description": "scheduled_date > now() AND < now() + 90 days の件数"},
            "lifetimeRitualizedCount": {"type": "integer"},
            "lifetimeHandedOverCount": {"type": "integer"},
            "asOf": {"type": "string", "format": "date-time"}
          }
        }
      }
    }
  }
}
