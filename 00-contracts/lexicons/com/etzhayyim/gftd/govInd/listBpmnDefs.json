{
  "lexicon": 1,
  "id": "com.etzhayyim.govInd.listBpmnDefs",
  "defs": {
    "main": {
      "type": "query",
      "description": "List Government of India BPMN definitions from the bundled administrative process index.",
      "parameters": {
        "type": "params",
        "properties": {
          "q": { "type": "string", "description": "Search process id, name, or BPMN reference." },
          "kind": { "type": "string", "description": "Optional process bucket such as district, state, ministry, ut, health, finance." },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["processes", "total", "offset", "limit"],
          "properties": {
            "processes": { "type": "array", "items": { "type": "unknown" } },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
