{
  "lexicon": 1,
  "id": "com.etzhayyim.form.getForm",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a Camunda form definition by form key. Returns form schema, components, and variable mappings.",
      "parameters": {
        "type": "params",
        "properties": {
          "formKey": { "type": "string", "description": "Form key (maps to FormTask.form_key)" },
          "did": { "type": "string", "description": "Actor DID scope" }
        },
        "required": ["formKey"]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "formKey": { "type": "string" },
            "name": { "type": "string" },
            "formType": { "type": "string", "description": "camunda, embedded, external" },
            "schemaVersion": { "type": "integer" },
            "componentsJson": { "type": "string", "description": "Form components array (JSON)" },
            "variableMappingsJson": { "type": "string" },
            "status": { "type": "string" }
          },
          "required": ["formKey", "status"]
        }
      }
    }
  }
}
