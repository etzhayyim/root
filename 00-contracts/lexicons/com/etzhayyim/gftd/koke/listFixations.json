{
  "lexicon": 1,
  "id": "com.etzhayyim.koke.listFixations",
  "defs": {
    "main": {
      "type": "query",
      "description": "List fixations, optionally filtered by status or classification.",
      "parameters": {
        "type": "params",
        "properties": {
          "status": { "type": "string", "description": "Filter by status: fixed | released | handedOff" },
          "classification": { "type": "string", "description": "Filter by classification label" },
          "limit": { "type": "integer", "description": "Max rows to return (default 20)" },
          "offset": { "type": "integer", "description": "Pagination offset" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "fixations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "fixationId": { "type": "string" },
                  "inputKind": { "type": "string" },
                  "classification": { "type": "string" },
                  "status": { "type": "string" },
                  "fixedAt": { "type": "string" }
                }
              }
            },
            "total": { "type": "integer" },
            "limit": { "type": "integer" },
            "offset": { "type": "integer" }
          },
          "required": ["fixations", "total", "limit", "offset"]
        }
      }
    }
  }
}
