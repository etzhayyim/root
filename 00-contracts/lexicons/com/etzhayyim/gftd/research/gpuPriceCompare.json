{
  "lexicon": 1,
  "id": "com.etzhayyim.research.gpuPriceCompare",
  "defs": {
    "main": {
      "type": "query",
      "description": "Cross-provider GPU $/hr comparison. Returns price per GPU and per-provider cheapest from the research dataset (Vultr Cloud/BM, RunPod Secure, DigitalOcean). SSoT = public.mv_research_gpu_price_compare (ADR-2605110227).",
      "parameters": {
        "type": "params",
        "properties": {
          "model": { "type": "string", "description": "Filter by GPU model name (case-insensitive substring), e.g. 'L40S', 'MI300X', 'H100'." },
          "vendor": { "type": "string", "description": "Filter by vendor, 'nvidia' or 'amd'." },
          "vramMinGb": { "type": "integer", "minimum": 1, "description": "Filter to GPUs with at least this much VRAM (full card)." },
          "fp8Native": { "type": "boolean", "description": "If true, return only FP8-native GPUs." },
          "generation": { "type": "string", "description": "Filter by GPU generation, e.g. 'ada', 'hopper', 'blackwell', 'cdna3', 'cdna4'." },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "gpuDid": { "type": "string" },
                  "vendor": { "type": "string" },
                  "model": { "type": "string" },
                  "vramGbFull": { "type": "integer" },
                  "generation": { "type": "string" },
                  "fp8Native": { "type": "boolean" },
                  "vultrCloudHr": { "type": "number" },
                  "vultrBmHr": { "type": "number" },
                  "runpodSecureHr": { "type": "number" },
                  "digitaloceanHr": { "type": "number" }
                },
                "required": ["gpuDid", "model", "vramGbFull"]
              }
            },
            "total": { "type": "integer" }
          },
          "required": ["rows", "total"]
        }
      }
    }
  }
}
