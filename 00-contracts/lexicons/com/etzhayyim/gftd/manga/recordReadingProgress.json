{
  "lexicon": 1,
  "id": "com.etzhayyim.manga.recordReadingProgress",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record or update user reading progress",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["user_id", "title_id", "chapter_id"],
          "properties": {
            "user_id": { "type": "string" },
            "title_id": { "type": "string" },
            "chapter_id": { "type": "string" },
            "page_num": { "type": "integer" },
            "org_id": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string" }
          }
        }
      }
    }
  }
}
