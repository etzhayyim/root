{
  "lexicon": 1,
  "id": "com.etzhayyim.gameka.generateGame",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "specId": {
              "type": "string",
              "description": "spec_id of a vertex_gameka_spec row produced by proposeGame."
            }
          },
          "required": ["specId"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string"
            },
            "uri": {
              "type": "string"
            },
            "wasmCid": {
              "type": "string",
              "description": "CIDv1-shape content hash of the kami-app source tree (P2). Becomes the wasm binary CID once the wasm-pack runner lands (P3)."
            },
            "wasmSize": {
              "type": "integer"
            },
            "buildStatus": {
              "type": "string",
              "description": "sources_ready (P2) | building | built | failed."
            }
          },
          "required": ["artifactId", "uri", "wasmCid", "buildStatus"]
        }
      }
    }
  }
}
