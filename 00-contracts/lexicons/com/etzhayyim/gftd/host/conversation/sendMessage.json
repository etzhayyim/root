      "x-hostImportsMethod": "conversationSendMessage",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string"
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "sessionId",
            "content"
          ]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "envelopeJson": {
              "type": "string"
            }
          },
          "required": [
            "envelopeJson"
          ]
        }
      }
    }
  }
}
