      "parameters": {
        "type": "params",
        "properties": {
          "nanoid": {
            "type": "string"
          }
        },
        "required": [
          "nanoid"
        ]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "did": {
              "type": "string"
            }
          },
          "required": []
        }
      }
    }
  }
}
