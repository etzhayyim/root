{
  "lexicon": 1,
  "id": "com.etzhayyim.host.m365.enumerateUsers",
  "defs": {
    "main": {
      "type": "query",
      "description": "Enumerate tenant users matching a UPN domain filter. Uses ConsistencyLevel=eventual for advanced filters.",
      "x-hostImportsMethod": "m365EnumerateUsers",
      "parameters": {
        "type": "params",
        "properties": {
          "token": { "type": "string", "description": "App-only Graph access token" },
          "upnDomainSuffix": { "type": "string", "description": "Filter: endsWith(userPrincipalName, suffix), e.g. '@etzhayyim.com'" },
          "top": { "type": "integer", "default": 999, "minimum": 1, "maximum": 999 }
        },
        "required": ["token"]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "users": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "userPrincipalName": { "type": "string" },
                  "mail": { "type": "string" },
                  "displayName": { "type": "string" },
                  "accountEnabled": { "type": "boolean" }
                }
              }
            }
          },
          "required": ["users"]
        }
      }
    }
  }
}
