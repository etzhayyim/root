{
  "lexicon": 1,
  "id": "com.etzhayyim.host.m365.fetchMessagesPage",
  "defs": {
    "main": {
      "type": "query",
      "description": "Fetch one page of /users/{upn}/messages. Pagination via nextLink. Classification (folder → signal_class, sender_kind) is caller responsibility.",
      "x-hostImportsMethod": "m365FetchMessagesPage",
      "parameters": {
        "type": "params",
        "properties": {
          "token": { "type": "string" },
          "upn": { "type": "string" },
          "since": { "type": "string", "description": "ISO8601: receivedDateTime >= since. Omit for full sync." },
          "top": { "type": "integer", "default": 999, "minimum": 1, "maximum": 999 },
          "nextLink": { "type": "string", "description": "OData @odata.nextLink for pagination" }
        },
        "required": ["token", "upn"]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "messages": {
              "type": "array",
              "items": { "type": "unknown", "description": "Raw Graph message JSON" }
            },
            "nextLink": { "type": "string", "description": "null/empty when no more pages" }
          },
          "required": ["messages"]
        }
      }
    }
  }
}
