{
  "lexicon": 1,
  "id": "com.etzhayyim.host.ipfs.publish",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Publish bytes to IPFS (S3/R2-backed). Returns CIDv1.",
      "x-hostImportsMethod": "ipfsPublish",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "data": {
              "type": "string",
              "description": "base64-encoded bytes"
            },
            "contentType": {
              "type": "string"
            }
          },
          "required": [
            "data",
            "contentType"
          ]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "cid": {
              "type": "string"
            }
          },
          "required": [
            "cid"
          ]
        }
      }
    }
  }
}
