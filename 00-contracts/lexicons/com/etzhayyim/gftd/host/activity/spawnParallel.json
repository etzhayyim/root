{
  "lexicon": 1,
  "id": "com.etzhayyim.host.activity.spawnParallel",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Fan out a batch of activities for parallel execution. Returns batch ID.",
      "x-hostImportsMethod": "activitySpawnParallel",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "activitiesJson": {
              "type": "string"
            }
          },
          "required": [
            "activitiesJson"
          ]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "batchId": {
              "type": "string"
            }
          },
          "required": [
            "batchId"
          ]
        }
      }
    }
  }
}
