{
  "lexicon": 1,
  "id": "com.etzhayyim.host.authn.verifyToken",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Verify a bearer token and return its claims (base64 bytes).",
      "x-hostImportsMethod": "authnVerifyToken",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "token": {
              "type": "string"
            }
          },
          "required": [
            "token"
          ]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "claims": {
              "type": "string",
              "description": "base64-encoded bytes"
            }
          },
          "required": [
            "claims"
          ]
        }
      }
    }
  }
}
