{
  "lexicon": 1,
  "id": "com.etzhayyim.host.cdn.upload",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Upload bytes to the CDN under a subdomain/path.",
      "x-hostImportsMethod": "cdnUpload",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "subdomain": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "data": {
              "type": "string",
              "description": "base64-encoded bytes"
            },
            "contentType": {
              "type": "string"
            }
          },
          "required": [
            "subdomain",
            "path",
            "data",
            "contentType"
          ]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            }
          },
          "required": [
            "url"
          ]
        }
      }
    }
  }
}
