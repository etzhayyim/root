{
  "lexicon": 1,
  "id": "com.etzhayyim.houbun.ingestTreatyUn",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Crawl international treaties from the UN Treaty Collection (https://treaties.un.org/). Writes to vertex_houbun_treaty. Phase 2 contract surface is fixed; the parser lands in a later PR — currently a polite-crawl scaffold.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "unRegNo": {
              "type": "string",
              "description": "UN Treaty Registration Number. Mutually exclusive with since."
            },
            "since": {
              "type": "string",
              "description": "ISO 8601 date — fetch treaties registered after this cutoff."
            },
            "limit": {
              "type": "integer",
              "description": "Max treaties per call (default 50, max 500)."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "source": { "type": "string" },
            "treatiesFetched": { "type": "integer" },
            "treatiesInserted": { "type": "integer" },
            "errors": { "type": "integer" }
          }
        }
      }
    }
  }
}
