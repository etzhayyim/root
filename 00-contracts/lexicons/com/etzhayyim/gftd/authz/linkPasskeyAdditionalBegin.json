{
  "lexicon": 1,
  "id": "com.etzhayyim.authz.linkPasskeyAdditionalBegin",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Begin WebAuthn registration for an additional passkey on the caller's existing account. Caller must already hold a valid session (the primary passkey already authenticated this session). The new credential is bound to the same DID, so future signins via either passkey resolve to the same account. Used for multi-device passkey enrolment (e.g. iPhone + MacBook + YubiKey).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "label": { "type": "string", "description": "Optional human-readable label for the new device (e.g. \"iPhone 15\")" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["challenge", "rp", "user", "pubKeyCredParams", "timeout", "authenticatorSelection", "attestation", "userId"],
          "properties": {
            "challenge": { "type": "string" },
            "rp": { "type": "object" },
            "user": { "type": "object" },
            "pubKeyCredParams": { "type": "array" },
            "timeout": { "type": "integer" },
            "authenticatorSelection": { "type": "object" },
            "attestation": { "type": "string" },
            "userId": { "type": "string" }
          }
        }
      },
      "errors": [
        { "name": "AuthRequired" },
        { "name": "ConfigError" }
      ]
    }
  }
}
