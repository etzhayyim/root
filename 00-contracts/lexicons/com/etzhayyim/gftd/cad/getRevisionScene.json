{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.cad.getRevisionScene",
  "defs": {
    "main": {
      "type": "query",
      "description": "Return a scene-graph projection of a specific revision, consumable by kami-app-cad (run_cad_v2) or any Threlte client. Includes parts tree, tessellated meshes (or blob refs), materials, camera, bounds, and selectable topology ids for anchored comments.",
      "parameters": {
        "type": "params",
        "required": ["revisionId"],
        "properties": {
          "revisionId": { "type": "string" },
          "representation": {
            "type": "string",
            "enum": ["shaded", "wireframe", "exploded", "section"],
            "default": "shaded"
          },
          "lod": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "default": "medium"
          },
          "includeMeshBlobRefs": {
            "type": "boolean",
            "default": true,
            "description": "if true, large meshes are returned as `blobKey` refs instead of inline triangles"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["revisionId", "units", "bounds", "camera", "partsTree", "items"],
          "properties": {
            "revisionId": { "type": "string" },
            "modelId": { "type": "string" },
            "units": {
              "type": "string",
              "enum": ["metre", "millimetre", "centimetre", "inch", "foot"]
            },
            "bounds": {
              "type": "object",
              "description": "world AABB in model units",
              "properties": {
                "min": { "type": "array", "items": { "type": "number" }, "minLength": 3, "maxLength": 3 },
                "max": { "type": "array", "items": { "type": "number" }, "minLength": 3, "maxLength": 3 }
              }
            },
            "camera": {
              "type": "object",
              "properties": {
                "target": { "type": "array", "items": { "type": "number" }, "minLength": 3, "maxLength": 3 },
                "distance": { "type": "number" },
                "yaw": { "type": "number" },
                "pitch": { "type": "number" }
              }
            },
            "partsTree": {
              "type": "unknown",
              "description": "rooted assembly tree with occurrence paths (part_occurrence_path)"
            },
            "items": {
              "type": "array",
              "description": "renderable mesh / axis / blob-ref entries with topo ids for picking",
              "items": { "type": "unknown" }
            },
            "materials": {
              "type": "array",
              "items": { "type": "unknown" }
            },
            "selectionIds": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      },
      "errors": [
        { "name": "RevisionNotFound" },
        { "name": "NotReady", "description": "tessellation job still running — retry after `status=ready`" }
      ]
    }
  }
}
