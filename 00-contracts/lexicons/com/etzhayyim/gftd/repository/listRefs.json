{
  "lexicon": 1,
  "id": "com.etzhayyim.repository.listRefs",
  "defs": {
    "main": {
      "type": "query",
      "description": "List refs owned by a single DID, or by all DIDs in a path-DID subtree (ADR-0019). Subtree mode gives Project/App-level 'repo view' without a Repository container.",
      "parameters": {
        "type": "params",
        "properties": {
          "ownerDid": {
            "type": "string",
            "format": "did",
            "description": "Exact DID scope. Mutually exclusive with subtreeRootDid."
          },
          "subtreeRootDid": {
            "type": "string",
            "format": "did",
            "description": "Traverse edge_path_child* from this DID. Returns refs for the root and all descendants. Mutually exclusive with ownerDid."
          },
          "kind": {
            "type": "string",
            "knownValues": ["branch", "tag", "head"]
          },
          "namePrefix": {
            "type": "string",
            "description": "Filter by ref name prefix (e.g. 'feat/')."
          },
          "limit": { "type": "integer", "default": 100, "maximum": 500 },
          "offset": { "type": "integer", "default": 0 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["refs", "total", "offset", "limit"],
          "properties": {
            "refs": {
              "type": "array",
              "items": { "type": "ref", "ref": "#refView" }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    },
    "refView": {
      "type": "object",
      "required": ["ownerDid", "refName", "kind", "headCommitHash"],
      "properties": {
        "ownerDid": { "type": "string", "format": "did" },
        "refName": { "type": "string" },
        "kind": { "type": "string" },
        "headCommitHash": { "type": "string" },
        "headCommitMessage": { "type": "string" },
        "headCommitAuthor": { "type": "string", "format": "did" },
        "updatedAt": { "type": "string", "format": "datetime" }
      }
    }
  }
}
