{
  "lexicon": 1,
  "id": "com.etzhayyim.claim.postStakedAttestation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-2604261717 Phase 1 — submit a staked claim. Caller must already hold a passkey-bearer session (ADR-0023 / ADR-0074 Phase 1) AND have approved ClaimStakeEscrow to transfer `bond` GCC. The handler builds a sealer-funded tx that calls ClaimStakeEscrow.postClaim(claimId, didHash, atRecordCid, bond, challengePeriodSec) and (TODO Phase 2) writes the AT Record + vertex_claim_stake row.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["claim", "bond"],
          "properties": {
            "claim":              { "type": "string", "maxLength": 4096 },
            "claimType":          { "type": "string" },
            "bond":               { "type": "string", "description": "GCC wei (uint256 decimal string). Caller must have called gcc.approve(escrow, bond) first" },
            "challengePeriodSec": { "type": "integer", "minimum": 60, "maximum": 7776000, "description": "default 604800 (7 days). hard cap 90 days" },
            "arbiter":            { "type": "string", "description": "default dmn:claim_dispute_v1" },
            "evidence":           { "type": "array", "items": { "type": "string" } },
            "atRecordCid":        { "type": "string", "description": "0x-prefixed 32-byte CIDv1 sha256 of the canonical AT Record bytes (caller-computed). Phase 1: arbitrary 32-byte tag" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "claimId", "txHash", "didHash", "escrowAddr", "chainId", "challengePeriodSec"],
          "properties": {
            "ok":                 { "type": "boolean" },
            "claimId":            { "type": "string" },
            "txHash":             { "type": "string" },
            "didHash":            { "type": "string" },
            "escrowAddr":         { "type": "string" },
            "chainId":            { "type": "integer" },
            "challengePeriodSec": { "type": "integer" },
            "receiptStatus":      { "type": "string" }
          }
        }
      },
      "errors": [
        { "name": "AuthRequired" },
        { "name": "ConfigError" },
        { "name": "InsufficientApproval", "description": "Escrow lacks ERC-20 allowance for the requested bond" },
        { "name": "BondTooSmall" },
        { "name": "TxRevert" },
        { "name": "RpcError" }
      ]
    }
  }
}
