{
  "lexicon": 1,
  "id": "com.etzhayyim.wellBecoming.skillClaim",
  "defs": {
    "main": {
      "type": "record",
      "description": "Tranche F stub — user-self-asserted skill at a kyū/dan rank in a named domain. Lives on the user's own PDS. Full schema pending Phase 3.",
      "key": "tid",
      "record": {
        "type": "object",
        "properties": {
          "$type": { "type": "string", "const": "com.etzhayyim.wellBecoming.skillClaim" },
          "domain": {
            "type": "string",
            "description": "Skill domain (e.g. 'kendo', 'piano', 'kintsugi', 'shinto-norito')",
            "minLength": 1,
            "maxLength": 128
          },
          "rankSystem": {
            "type": "string",
            "knownValues": ["kyu-dan", "level-numeric"]
          },
          "rankValue": {
            "type": "integer",
            "description": "For kyu-dan: negative = kyū (-10..-1), positive = dan (1..10). For level-numeric: 1..N."
          },
          "claimedAt": { "type": "string", "format": "datetime" },
          "note": { "type": "string", "maxLength": 1024 }
        },
        "required": ["$type", "domain", "rankSystem", "rankValue", "claimedAt"]
      }
    }
  }
}
