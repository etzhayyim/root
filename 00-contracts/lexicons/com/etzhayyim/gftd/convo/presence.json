{
  "lexicon": 1,
  "id": "com.etzhayyim.convo.presence",
  "description": "etzhayyim extension: online presence tracking. No official chat.bsky equivalent.",
  "defs": {
    "main": {
      "type": "record",
      "record": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "knownValues": ["online", "away", "dnd", "offline"]
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        },
        "required": [
          "status",
          "updatedAt"
        ]
      }
    }
  }
}
