{
  "lexicon": 1,
  "id": "com.etzhayyim.convo.search",
  "description": "etzhayyim extension: search messages across conversations. Results contain chat.bsky.convo.defs#messageView compatible objects.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "q": {
            "type": "string"
          },
          "convoId": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25
          },
          "cursor": {
            "type": "string"
          }
        },
        "required": [
          "q"
        ]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "results": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "chat.bsky.convo.defs#messageView"
              }
            },
            "cursor": {
              "type": "string"
            }
          },
          "required": [
            "results"
          ]
        }
      }
    }
  }
}
