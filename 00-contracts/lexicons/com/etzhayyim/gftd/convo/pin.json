{
  "lexicon": 1,
  "id": "com.etzhayyim.convo.pin",
  "description": "etzhayyim extension: pinned message record. No official chat.bsky equivalent.",
  "defs": {
    "main": {
      "type": "record",
      "record": {
        "type": "object",
        "properties": {
          "convoId": {
            "type": "string"
          },
          "messageId": {
            "type": "string"
          },
          "pinnedAt": {
            "type": "string",
            "format": "datetime"
          }
        },
        "required": [
          "convoId",
          "messageId",
          "pinnedAt"
        ]
      }
    }
  }
}
