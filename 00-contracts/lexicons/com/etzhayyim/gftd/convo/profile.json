{
  "lexicon": 1,
  "id": "com.etzhayyim.convo.profile",
  "description": "Conversation-scoped profile. Extends chat.bsky.actor.defs#profileViewBasic with per-convo overrides.",
  "defs": {
    "main": {
      "type": "record",
      "record": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "maxGraphemes": 64,
            "maxLength": 640
          },
          "description": {
            "type": "string",
            "maxGraphemes": 256,
            "maxLength": 2560
          },
          "avatar": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": []
      }
    }
  }
}
