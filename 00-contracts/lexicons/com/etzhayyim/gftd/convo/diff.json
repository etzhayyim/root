{
  "lexicon": 1,
  "id": "com.etzhayyim.convo.diff",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["convoId", "oldRootCid", "newRootCid"],
          "properties": {
            "convoId": { "type": "string" },
            "oldRootCid": { "type": "string" },
            "newRootCid": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "addedEnvelopeCids",
            "removedEnvelopeCids",
            "addedMemberCids",
            "removedMemberCids",
            "addedKinds",
            "removedKinds",
            "channelChanged"
          ],
          "properties": {
            "addedEnvelopeCids": { "type": "array", "items": { "type": "string" } },
            "removedEnvelopeCids": { "type": "array", "items": { "type": "string" } },
            "addedMemberCids": { "type": "array", "items": { "type": "string" } },
            "removedMemberCids": { "type": "array", "items": { "type": "string" } },
            "addedKinds": { "type": "array", "items": { "type": "string" } },
            "removedKinds": { "type": "array", "items": { "type": "string" } },
            "channelChanged": { "type": "boolean" }
          }
        }
      }
    }
  }
}
