{
  "lexicon": 1,
  "id": "com.etzhayyim.kyber.inbox.documentSignal",
  "defs": {
    "main": {
      "type": "record",
      "description": "An Office document (Excel/Word/PowerPoint/PDF) from OneDrive/SharePoint, classified and routed to a kyber department. Filename/content encrypted; path/size/author are routing metadata.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["driveItemIdHash", "accountDid", "extension", "kyberDept", "signalClass"],
        "properties": {
          "driveItemIdHash": { "type": "string" },
          "accountDid":      { "type": "string", "format": "did" },
          "pathHash":        { "type": "string" },
          "nameEnc":         { "type": "string" },
          "nameHash":        { "type": "string" },
          "extension":       { "type": "string", "enum": ["xlsx", "xlsm", "docx", "pptx", "pdf", "txt", "csv", "md", "other"] },
          "mimeType":        { "type": "string" },
          "sizeBytes":       { "type": "integer", "minimum": 0 },
          "createdAt":       { "type": "string", "format": "datetime" },
          "modifiedAt":      { "type": "string", "format": "datetime" },
          "authorAddress":   { "type": "string" },
          "lastModifiedBy":  { "type": "string" },
          "sheetCount":      { "type": "integer", "minimum": 0 },
          "pageCount":       { "type": "integer", "minimum": 0 },
          "wordCount":       { "type": "integer", "minimum": 0 },
          "extracted":       { "type": "boolean" },
          "extractEngine":   { "type": "string" },
          "kyberDept":       { "type": "string", "enum": ["accounting", "hr", "procurement", "inventory", "sales", "it", "strategy"] },
          "kyberDeptDid":    { "type": "string", "format": "did" },
          "signalClass":     { "type": "string", "enum": ["signal", "noise"] },
          "noiseScore":      { "type": "number", "minimum": 0, "maximum": 1 },
          "sensitivityOrd":  { "type": "integer", "minimum": 0, "maximum": 3 }
        }
      }
    }
  }
}
