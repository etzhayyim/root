{
  "lexicon": 1,
  "id": "com.etzhayyim.kyber.projector.listActivities",
  "defs": {
    "main": {
      "type": "query",
      "description": "Compatibility query for APQC activities. In kyber-projector, an activity maps to one emitted OCEL event.",
      "parameters": {
        "type": "params",
        "properties": {
          "groupId": { "type": "string", "description": "Alias of apqcCode" },
          "apqcCode": { "type": "string" },
          "processId": { "type": "string", "description": "Alias of taskId" },
          "taskId": { "type": "string" },
          "caseId": { "type": "string" },
          "eventType": { "type": "string" },
          "offset": { "type": "integer", "default": 0 },
          "limit": { "type": "integer", "default": 100 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "activities": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "activityId": { "type": "string" },
                  "ocelEventId": { "type": "string" },
                  "processId": { "type": "string" },
                  "taskId": { "type": "string" },
                  "groupId": { "type": "string" },
                  "apqcCode": { "type": "string" },
                  "actorDid": { "type": "string" },
                  "name": { "type": "string" },
                  "eventType": { "type": "string" },
                  "caseId": { "type": "string" },
                  "timestamp": { "type": "string" },
                  "status": { "type": "string" },
                  "objects": { "type": "array" },
                  "attributes": { "type": "object" }
                },
                "required": ["activityId", "groupId", "eventType", "timestamp"]
              }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          },
          "required": ["ok", "activities", "total", "offset", "limit"]
        }
      }
    }
  }
}
