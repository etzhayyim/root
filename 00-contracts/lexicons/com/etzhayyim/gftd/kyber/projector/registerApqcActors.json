{
  "lexicon": 1,
  "id": "com.etzhayyim.kyber.projector.registerApqcActors",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Bulk-register 13 APQC L1 path-based DIDs under did:web:kyber-projector.etzhayyim.com. Idempotent: re-invocation returns existing DIDs unchanged.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "scope": { "type": "string", "description": "all | l1-only | { apqcCode: '9.0' } for single L1" },
            "apqcCode": { "type": "string", "description": "Single L1 code (e.g. 9.0) when scope != all" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "registered": { "type": "integer" },
            "skipped": { "type": "integer" },
            "actors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "did": { "type": "string" },
                  "apqcCode": { "type": "string" },
                  "name": { "type": "string" },
                  "subProcesses": { "type": "integer" },
                  "status": { "type": "string" }
                },
                "required": ["did", "apqcCode", "name", "status"]
              }
            }
          },
          "required": ["ok", "registered", "actors"]
        }
      }
    }
  }
}
