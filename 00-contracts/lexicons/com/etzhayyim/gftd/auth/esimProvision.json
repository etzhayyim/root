{
  "lexicon": 1,
  "id": "com.etzhayyim.auth.esimProvision",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Provision a Telnyx eSIM for Telecom tier members. Creates SIM card, DID, and AT Protocol session. Requires Stripe payment verification.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["phone"],
          "properties": {
            "phone": { "type": "string", "description": "Phone number for eSIM association" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["iccid", "msisdn", "activationCode", "qrCodeData", "did", "sessionTokens"],
          "properties": {
            "iccid": { "type": "string", "description": "SIM ICCID" },
            "msisdn": { "type": "string", "description": "Assigned phone number" },
            "activationCode": { "type": "string", "description": "LPA activation code for eSIM download" },
            "qrCodeData": { "type": "string", "description": "QR code data string for eSIM activation" },
            "did": { "type": "string" },
            "sessionTokens": { "type": "object" }
          }
        }
      },
      "errors": [
        { "name": "ServiceUnavailable", "description": "eSIM provisioning not configured" },
        { "name": "TelnyxError", "description": "Telnyx API call failed" }
      ]
    }
  }
}
