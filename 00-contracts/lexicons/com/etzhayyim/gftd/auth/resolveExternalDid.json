{
  "lexicon": 1,
  "id": "com.etzhayyim.auth.resolveExternalDid",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Resolve an external DID (did:plc via PLC Directory, did:web via .well-known). Used for AT Protocol federation.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did"],
          "properties": {
            "did": { "type": "string", "description": "DID to resolve (did:plc or did:web)" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did", "didDocument", "source"],
          "properties": {
            "did": { "type": "string" },
            "didDocument": { "type": "object", "description": "Resolved DID Document" },
            "source": { "type": "string", "description": "Resolution source: plcDirectory | wellKnown" }
          }
        }
      },
      "errors": [
        { "name": "NotFound", "description": "DID not found" },
        { "name": "UnsupportedDID", "description": "Only did:plc and did:web are supported" }
      ]
    }
  }
}
