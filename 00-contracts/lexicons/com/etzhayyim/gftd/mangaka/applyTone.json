{
  "lexicon": 1,
  "id": "com.etzhayyim.mangaka.applyTone",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Stage 5/8 — Screentone + effects pass (トーン貼り). ComfyUI halftone postprocess on the inked panel. Writes one vertex_mangaka row (kind=tonedPanel).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["panelUri"],
          "properties": {
            "panelUri": { "type": "string", "format": "at-uri", "description": "Inked panel from Stage 4." },
            "toneStyle": { "type": "string", "enum": ["shonen", "seinen", "shojo", "gekiga"], "default": "shonen" },
            "speedLines": { "type": "boolean", "default": false },
            "focusLines": { "type": "boolean", "default": false }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "tonedVertexId": { "type": "string", "format": "at-uri" },
            "blobCid": { "type": "string" },
            "renderMs": { "type": "integer" }
          }
        }
      }
    }
  }
}
