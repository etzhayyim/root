{
  "lexicon": 1,
  "id": "com.etzhayyim.oauth.getAuthorizationServer",
  "defs": {
    "main": {
      "type": "query",
      "description": "Tranche F stub — DID-aware OAuth 2.1 / RFC 8414 authorization server discovery document. Wire-format fields are snake_case per ADR-2604231821. Full schema pending Phase 3.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "#discoveryDoc"
        }
      }
    },
    "discoveryDoc": {
      "type": "object",
      "description": "Subset of RFC 8414 fields relevant to DID-bound flow.",
      "properties": {
        "issuer": { "type": "string", "format": "uri" },
        "authorization_endpoint": { "type": "string", "format": "uri" },
        "token_endpoint": { "type": "string", "format": "uri" },
        "revocation_endpoint": { "type": "string", "format": "uri" },
        "introspection_endpoint": { "type": "string", "format": "uri" },
        "dpop_signing_alg_values_supported": {
          "type": "array",
          "items": { "type": "string" }
        },
        "did_methods_supported": {
          "type": "array",
          "description": "DID methods accepted in the `client_id` / `sub` claim",
          "items": { "type": "string" }
        }
      },
      "required": ["issuer", "authorization_endpoint", "token_endpoint", "dpop_signing_alg_values_supported"]
    }
  }
}
