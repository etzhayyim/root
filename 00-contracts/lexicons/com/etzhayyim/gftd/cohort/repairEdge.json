{
  "lexicon": 1,
  "id": "com.etzhayyim.cohort.repairEdge",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "individualDid": { "type": "string" },
            "limit": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 100 },
            "dryRun": { "type": "boolean", "default": false }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "repaired": { "type": "integer" },
            "skipped": { "type": "integer" },
            "errors": { "type": "integer" },
            "dryRun": { "type": "boolean" }
          },
          "required": ["repaired", "skipped", "errors", "dryRun"]
        }
      }
    }
  }
}
