{
  "lexicon": 1,
  "id": "com.etzhayyim.cohort.emitEvidence",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "cohortDid": { "type": "string" },
            "signalKind": { "type": "string" },
            "evidencePayload": { "type": "string" },
            "posterior": { "type": "number", "minimum": 0, "maximum": 1 },
            "judgeAgreement": { "type": "boolean" }
          },
          "required": ["cohortDid", "signalKind", "evidencePayload"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "evidenceHash": { "type": "string" },
            "cohortDid": { "type": "string" },
            "observedAt": { "type": "string" }
          },
          "required": ["evidenceHash", "cohortDid", "observedAt"]
        }
      }
    }
  }
}
