{
  "lexicon": 1,
  "id": "com.etzhayyim.yoro.graph.getFollowers",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get followers of an actor. Yoro AppView endpoint.",
      "parameters": {
        "type": "params",
        "required": ["actor"],
        "properties": {
          "actor": { "type": "string", "format": "at-identifier" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["followers"],
          "properties": {
            "subject": { "type": "ref", "ref": "com.etzhayyim.yoro.actor.getProfile#defs/profileViewDetailed" },
            "followers": { "type": "array", "items": { "type": "ref", "ref": "com.etzhayyim.yoro.actor.getProfile#defs/profileViewDetailed" } },
            "cursor": { "type": "string" }
          }
        }
      }
    }
  }
}
