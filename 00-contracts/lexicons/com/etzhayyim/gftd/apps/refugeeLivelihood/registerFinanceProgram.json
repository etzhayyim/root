{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.refugeeLivelihood.registerFinanceProgram",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Refugee livelihood / financial inclusion program (bridges refugee-unhcr + ocha-funding + migrant-worker-welfare + uasc-protection)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "programId",
            "hostIso3",
            "financialProduct",
            "launchedAt"
          ],
          "properties": {
            "programId": {
              "type": "string"
            },
            "sponsorLei": {
              "type": "string"
            },
            "hostIso3": {
              "type": "string"
            },
            "financialProduct": {
              "type": "string",
              "enum": [
                "microloan",
                "savings",
                "remittance",
                "cash_assistance",
                "agriculture_voucher",
                "cash_plus",
                "digital_wallet",
                "insurance"
              ]
            },
            "beneficiariesCount": {
              "type": "integer"
            },
            "avgLoanUsd": {
              "type": "number"
            },
            "digitalIdLinked": {
              "type": "boolean",
              "description": "bridges open-digital-identity"
            },
            "launchedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}