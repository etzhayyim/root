{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.jpnJma.issueWeatherWarning",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "JMA 気象警報",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "warningCode",
            "warningType",
            "areaCode",
            "effectiveFrom"
          ],
          "properties": {
            "warningCode": {
              "type": "string"
            },
            "warningType": {
              "type": "string",
              "enum": [
                "special-warning",
                "warning",
                "advisory"
              ]
            },
            "areaCode": {
              "type": "string"
            },
            "areaName": {
              "type": "string"
            },
            "effectiveFrom": {
              "type": "string",
              "format": "datetime"
            },
            "effectiveUntil": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            "requireBroadcast": {
              "type": "boolean"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
