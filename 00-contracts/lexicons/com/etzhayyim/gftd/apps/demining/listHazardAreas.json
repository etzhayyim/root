{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.demining.listHazardAreas",
  "defs": {
    "main": {
      "type": "query",
      "description": "List hazard areas. Geometry omitted unless caller has `demining.viewCoordinates` capability. Released polygons are always public.",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "properties": {
          "status": { "type": "string" },
          "adminAreaDid": { "type": "string" },
          "contaminationType": { "type": "string" },
          "offset": { "type": "integer", "default": 0 },
          "limit": { "type": "integer", "default": 50 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "areas": { "type": "array", "items": { "type": "string" } },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
