{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.credentialPortability.registerCredentialWallet",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Europass / Credential Engine / EUDI wallet credential (bridges digital-identity + language-preservation + labour-mobility)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "walletId",
            "credentialKind",
            "issuingCountryIso3",
            "issuedAt"
          ],
          "properties": {
            "walletId": {
              "type": "string"
            },
            "holderOrcid": {
              "type": "string"
            },
            "credentialKind": {
              "type": "string",
              "enum": [
                "diploma",
                "microcredential",
                "badge",
                "apprenticeship",
                "license",
                "occupational"
              ]
            },
            "issuingBodyLei": {
              "type": "string"
            },
            "issuingCountryIso3": {
              "type": "string"
            },
            "framework": {
              "type": "string",
              "enum": [
                "eqf",
                "nqf",
                "isced",
                "eqavet",
                "escf",
                "wqf_jp",
                "knwq_kr"
              ]
            },
            "level": {
              "type": "integer"
            },
            "issuedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}