{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.pensionsDc.flagInadequacy",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Replacement-rate / adequacy shortfall (bridges migrant-worker-welfare + housing-affordability + energy-poverty)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "reportId",
            "countryIso3",
            "reportingYear",
            "reportedAt"
          ],
          "properties": {
            "reportId": {
              "type": "string"
            },
            "fundVid": {
              "type": "string",
              "description": "bridges recordFundMetric"
            },
            "countryIso3": {
              "type": "string"
            },
            "grossReplacementRatePct": {
              "type": "number"
            },
            "netReplacementRatePct": {
              "type": "number"
            },
            "oldAgePovertyRatePct": {
              "type": "number"
            },
            "genderGapPensionPct": {
              "type": "number"
            },
            "reportingYear": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "adequacyTier": {
              "type": "string",
              "enum": [
                "inadequate",
                "marginal",
                "adequate"
              ]
            }
          }
        }
      }
    }
  }
}