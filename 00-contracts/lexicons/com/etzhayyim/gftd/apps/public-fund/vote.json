{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.public-fund.vote",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "Individual Adherent SBT vote on a Public Fund proposal. 1 SBT = 1 vote. Active SBT holders only (Charter compliance gate applied on-chain). Per ADR-2605192145 §2.",
      "record": {
        "type": "object",
        "required": ["proposalUri", "sbtTokenId", "voterDid", "choice", "votedAt", "voterSignature"],
        "properties": {
          "proposalUri": { "type": "string", "format": "at-uri" },
          "onchainProposalId": { "type": "string" },
          "sbtTokenId": { "type": "integer", "minimum": 1 },
          "voterDid": { "type": "string" },
          "choice": {
            "type": "string",
            "enum": ["for", "against", "abstain"]
          },
          "rationale": {
            "type": "string",
            "maxLength": 2000,
            "description": "Optional public rationale. PII-free."
          },
          "voterSignature": { "type": "string" },
          "votedAt": { "type": "string", "format": "datetime" },
          "txHash": {
            "type": "string",
            "description": "PublicFundGovernance.vote() tx hash on Base L2."
          }
        }
      }
    }
  }
}
