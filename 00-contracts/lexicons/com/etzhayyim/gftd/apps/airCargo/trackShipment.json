{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airCargo.trackShipment",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Track and update the status of a cargo shipment.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["awb_no", "status"],
          "properties": {
            "awb_no": { "type": "string" },
            "status": { "type": "string" },
            "location": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
