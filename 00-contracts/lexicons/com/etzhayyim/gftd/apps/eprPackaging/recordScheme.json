{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.eprPackaging.recordScheme",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Extended Producer Responsibility packaging scheme (bridges marineLitter.flagLiabilityGap + plastic-treaty + weee-ewaste)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "schemeId",
            "prokindKind",
            "materialStream",
            "countryIso3",
            "effectiveAt"
          ],
          "properties": {
            "schemeId": {
              "type": "string"
            },
            "prokindKind": {
              "type": "string",
              "enum": [
                "eu_ppwr",
                "fr_loi_agec",
                "de_vverpackg",
                "jp_recycle",
                "ca_province",
                "us_state",
                "chile_rep",
                "colombia_refd",
                "india_epr",
                "korea_epr",
                "thailand_epr"
              ]
            },
            "materialStream": {
              "type": "string",
              "enum": [
                "pet_bottle",
                "hdpe",
                "pp",
                "multilayer",
                "aluminium_can",
                "steel_can",
                "glass",
                "paper_fibre",
                "composite",
                "textile",
                "electronics",
                "battery",
                "tire"
              ]
            },
            "countryIso3": {
              "type": "string"
            },
            "producerFeeEurTonne": {
              "type": "number"
            },
            "eprLiabilityVid": {
              "type": "string",
              "description": "bridges marineLitter.flagLiabilityGap"
            },
            "effectiveAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}