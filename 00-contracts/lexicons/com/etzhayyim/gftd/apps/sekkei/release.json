{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.sekkei.release",
  "description": "設計図の製造リリース記録。approved 図面を量産・試作に正式リリース。releaseType=production で tsukuru 製造オーダーへの図面参照を有効化。",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["drawingId", "revNo", "releaseType", "releasedByDid", "releasedAt"],
        "properties": {
          "drawingId": { "type": "string" },
          "revNo": { "type": "string" },
          "releaseType": {
            "type": "string",
            "enum": ["prototype", "pilot", "production", "service"],
            "description": "試作/パイロット/量産/サービス部品"
          },
          "releasedByDid": { "type": "string" },
          "releasedAt": { "type": "string", "format": "date-time" },
          "targetProductCode": { "type": "string", "description": "対象製品コード (tsukuru 側)" },
          "effectiveDate": { "type": "string", "format": "date", "description": "有効開始日 (在庫移行等)" },
          "obsoletesDrawingId": { "type": "string", "description": "この release で obsolete となる旧図番" },
          "distributionList": {
            "type": "array",
            "items": { "type": "string" },
            "description": "配布先 DID 一覧 (製造/購買/品質)"
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
