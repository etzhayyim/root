{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.c2paContentCred.recordManifest",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "C2PA Content Credentials manifest (bridges satelliteEvidence.flagAuthenticationConcern + cyber-vuln-cve + ai-governance)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "manifestId",
            "assetKind",
            "manifestKind",
            "signedAt"
          ],
          "properties": {
            "manifestId": {
              "type": "string"
            },
            "assetKind": {
              "type": "string",
              "enum": [
                "news_image",
                "journalism_video",
                "forensic_imagery",
                "generative_image",
                "generative_video",
                "scientific",
                "political_ad",
                "commercial_ad",
                "stock",
                "ux_screenshot",
                "corporate"
              ]
            },
            "publisherLei": {
              "type": "string"
            },
            "manifestKind": {
              "type": "string",
              "enum": [
                "origin_action",
                "ai_action",
                "placement_action",
                "produced_action",
                "redacted_action",
                "metadata_only",
                "training_data_attestation",
                "provenance_chain",
                "derivation"
              ]
            },
            "authConcernVid": {
              "type": "string",
              "description": "bridges satelliteEvidence.flagAuthenticationConcern"
            },
            "signedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}