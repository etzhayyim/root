{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.aiGovernance.registerModel",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "AI model risk register (EU AI Act / NIST AI RMF / ISO 42001 — bridges cyber-compliance + esg-risk-rating + lei)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "modelId",
            "euAiActRiskClass",
            "registeredAt"
          ],
          "properties": {
            "modelId": {
              "type": "string"
            },
            "developerLei": {
              "type": "string",
              "description": "bridges open-lei"
            },
            "euAiActRiskClass": {
              "type": "string",
              "enum": [
                "minimal",
                "limited",
                "high",
                "unacceptable",
                "general_purpose"
              ]
            },
            "nistCategory": {
              "type": "string",
              "enum": [
                "narrow",
                "foundation",
                "agentic",
                "gai"
              ]
            },
            "cyberComplianceVid": {
              "type": "string",
              "description": "bridges open-cyber-compliance"
            },
            "esgRatingVid": {
              "type": "string",
              "description": "bridges open-esg-risk-rating"
            },
            "trainingDatasetDisclosed": {
              "type": "boolean"
            },
            "registeredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "gateTier": {
              "type": "string",
              "enum": [
                "exempt",
                "transparency_only",
                "conformity_assessment",
                "banned"
              ]
            }
          }
        }
      }
    }
  }
}