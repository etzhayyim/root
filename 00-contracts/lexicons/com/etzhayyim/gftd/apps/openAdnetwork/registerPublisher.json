{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openAdnetwork.registerPublisher",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Publisher（媒体社）を登録し、広告枠の収益化設定を行う。Starts BPMN process open_adnetwork_register_publisher.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["publisherId", "domain"],
          "properties": {
            "publisherId":      { "type": "string", "description": "Publisher unique identifier" },
            "domain":           { "type": "string", "description": "Publisher domain (e.g. example.com)" },
            "ownerDid":         { "type": "string", "description": "DID of the publisher owner" },
            "floorCpmUsd":      { "type": "number", "description": "Floor CPM in USD (default 0.5)" },
            "contentCategory":  { "type": "string", "description": "IAB content category code" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["vertexId"],
          "properties": {
            "vertexId": { "type": "string" },
            "status":   { "type": "string" }
          }
        }
      }
    }
  }
}
