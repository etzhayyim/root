{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openAdnetwork.getCampaignFunnel",
  "defs": {
    "main": {
      "type": "query",
      "description": "Campaign のファネル指標（impressions / clicks / conversions / CTR / CVR / spend）を返す。mv_open_adnetwork_campaign_funnel を参照。",
      "parameters": {
        "type": "params",
        "properties": {
          "campaignId": { "type": "string", "description": "Campaign identifier" }
        },
        "required": ["campaignId"]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["campaignId", "impressions", "clicks", "conversions", "ctrPct", "cvrPct", "totalSpendUsd"],
          "properties": {
            "campaignId":    { "type": "string" },
            "impressions":   { "type": "integer" },
            "clicks":        { "type": "integer" },
            "conversions":   { "type": "integer" },
            "ctrPct":        { "type": "number", "description": "Click-through rate (%)" },
            "cvrPct":        { "type": "number", "description": "Conversion rate (%)" },
            "totalSpendUsd": { "type": "number", "description": "Total spend in USD" }
          }
        }
      }
    }
  }
}
