{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yata.listBuckets",
  "defs": {
    "main": {
      "type": "query",
      "description": "List all buckets owned by the caller's org_did.",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": {"type": "integer", "minimum": 1, "maximum": 200, "default": 50},
          "cursor": {"type": "string"}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["buckets"],
          "properties": {
            "buckets": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["bucketName", "region", "createdAt"],
                "properties": {
                  "bucketId": {"type": "string"},
                  "bucketName": {"type": "string"},
                  "region": {"type": "string"},
                  "encryption": {"type": "string"},
                  "tierPolicy": {"type": "string"},
                  "versioningEnabled": {"type": "boolean"},
                  "publicRead": {"type": "boolean"},
                  "blobCount": {"type": "integer"},
                  "totalBytes": {"type": "integer"},
                  "createdAt": {"type": "string", "format": "datetime"}
                }
              }
            },
            "nextCursor": {"type": "string"}
          }
        }
      }
    }
  }
}
