{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yata.bmcListHypotheses",
  "defs": {
    "main": {
      "type": "query",
      "description": "List hypotheses for the caller's org with current status joined from mv_bmc_hypothesis_status. Threshold and baseline are returned as decimal strings (AT Lexicon does not support float).",
      "parameters": {
        "type": "params",
        "properties": {
          "status":  {"type": "string", "knownValues": ["pending", "active", "completed", "killed"]},
          "block":   {"type": "string", "knownValues": ["customerSegments", "valuePropositions", "channels", "customerRelationships", "revenueStreams", "keyResources", "keyActivities", "keyPartnerships", "costStructure"]},
          "offset":  {"type": "integer", "minimum": 0, "default": 0},
          "limit":   {"type": "integer", "minimum": 1, "maximum": 200, "default": 50}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["hypotheses", "offset", "limit", "total"],
          "properties": {
            "hypotheses": {"type": "array", "items": {"type": "ref", "ref": "#hypothesisItem"}},
            "offset":     {"type": "integer"},
            "limit":      {"type": "integer"},
            "total":      {"type": "integer"}
          }
        }
      }
    },
    "hypothesisItem": {
      "type": "object",
      "required": ["vertexId", "slug", "block", "statement", "metric", "metricQuery", "threshold", "baseline", "deadlineIso", "minSample", "status", "createdAt"],
      "properties": {
        "vertexId":       {"type": "string"},
        "slug":           {"type": "string"},
        "block":          {"type": "string"},
        "statement":      {"type": "string"},
        "metric":         {"type": "string"},
        "metricQuery":    {"type": "string"},
        "threshold":      {"type": "string", "description": "decimal string"},
        "baseline":       {"type": "string", "description": "decimal string"},
        "deadlineIso":    {"type": "string", "format": "datetime"},
        "minSample":      {"type": "integer", "minimum": 0},
        "authoredBy":     {"type": "string"},
        "autoApplyPivot": {"type": "boolean"},
        "status":         {"type": "string", "knownValues": ["pending", "active", "completed", "killed"]},
        "statusAt":       {"type": "string", "format": "datetime"},
        "createdAt":      {"type": "string", "format": "datetime"}
      }
    }
  }
}
