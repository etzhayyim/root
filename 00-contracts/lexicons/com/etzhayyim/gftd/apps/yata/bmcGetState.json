{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yata.bmcGetState",
  "defs": {
    "main": {
      "type": "query",
      "description": "Return the current Business Model Canvas head row for the caller's org (mv_bmc_state_head). canvasJson is JSON-serialized {customerSegments,valuePropositions,channels,customerRelationships,revenueStreams,keyResources,keyActivities,keyPartnerships,costStructure} -> {bullets[], notes?}.",
      "parameters": {
        "type": "params",
        "properties": {
          "orgDid": {"type": "string", "description": "Override the implicit org_did derived from the API key. Operator/admin only."}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["version", "canvasJson", "source", "createdBy", "createdAt"],
          "properties": {
            "vertexId":   {"type": "string"},
            "version":    {"type": "integer", "minimum": 0},
            "canvasJson": {"type": "string", "maxLength": 65536},
            "rationale":  {"type": "string", "maxLength": 4096},
            "source":     {"type": "string", "maxLength": 128},
            "createdBy":  {"type": "string", "maxLength": 256},
            "createdAt":  {"type": "string", "format": "datetime"}
          }
        }
      }
    }
  }
}
