{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.universalJurisdiction.recordUjCase",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Universal jurisdiction prosecution (bridges pocIhl.flagAccountabilityGap + legal-document + federal-court-docket)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "caseId",
            "prosecutingCountryIso3",
            "crimeKind",
            "legalBasis",
            "chargedAt"
          ],
          "properties": {
            "caseId": {
              "type": "string"
            },
            "prosecutingCountryIso3": {
              "type": "string"
            },
            "defendantNationalityIso3": {
              "type": "string"
            },
            "crimeKind": {
              "type": "string",
              "enum": [
                "genocide",
                "crimes_against_humanity",
                "war_crimes",
                "torture",
                "enforced_disappearance",
                "apartheid",
                "aggression",
                "piracy",
                "hijacking",
                "terror_financing",
                "slave_trade"
              ]
            },
            "legalBasis": {
              "type": "string",
              "enum": [
                "absolute_uj",
                "conditional_uj",
                "treaty_based",
                "domestic_transpose",
                "icc_complementarity",
                "aut_dedere",
                "self_referred",
                "flag_state_extension"
              ]
            },
            "accountabilityGapVid": {
              "type": "string",
              "description": "bridges pocIhl.flagAccountabilityGap"
            },
            "chargedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}