{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kouza.financialAccount",
  "defs": {
    "main": {
      "type": "record",
      "description": "External financial account discovered from a read-only institution connection. Full identifiers stay in vault; this record stores masked identifiers and kaikei mapping hints.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["ownerDid", "connectionDid", "externalAccountIdHash", "accountKind", "currency", "status", "createdAt"],
        "properties": {
          "ownerDid": { "type": "string", "format": "did" },
          "connectionDid": { "type": "string", "format": "did" },
          "externalAccountIdHash": { "type": "string", "description": "Hash of provider account id for dedupe" },
          "maskedAccountNumber": { "type": "string", "description": "Masked display form only, e.g. ****1234" },
          "displayName": { "type": "string" },
          "accountKind": { "type": "string", "enum": ["checking", "savings", "termDeposit", "securities", "creditCard", "loan", "custody", "emoney", "other"] },
          "currency": { "type": "string", "description": "ISO 4217" },
          "currentBalanceMinor": { "type": "integer", "description": "Balance in currency minor units, e.g. JPY yen or USD cents" },
          "balanceAsOf": { "type": "string", "format": "datetime" },
          "kaikeiAccountDid": { "type": "string", "format": "did", "description": "Mapped chart-of-accounts DID used when deriving kaikei.bankTransaction rows" },
          "status": { "type": "string", "enum": ["active", "closed", "hidden", "error"] },
          "createdAt": { "type": "string", "format": "datetime" },
          "updatedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
