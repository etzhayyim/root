{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.osMessaging.registerBridge",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register an OS messaging bridge (Discord/Telegram/Slack/LINE/WhatsApp ↔ etzhayyim agent network). Path F Phase 3.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["platform", "channelId", "ownerDid"],
          "properties": {
            "platform": { "type": "string", "enum": ["discord", "telegram", "slack", "line", "whatsapp", "matrix", "ms-teams", "wechat", "kakao"] },
            "channelId": { "type": "string", "description": "platform-native channel/server/room id" },
            "channelName": { "type": "string" },
            "ownerDid": { "type": "string", "format": "did", "description": "etzhayyim agent DID that bridges this channel" },
            "bridgeMode": { "type": "string", "enum": ["read-only", "read-write", "agent-only", "human-only", "fully-bridged"] },
            "convoDid": { "type": "string", "format": "did", "description": "linked W Protocol convo DID" },
            "e2eMode": { "type": "string", "enum": ["client-signal", "server-assisted", "platform-native", "plaintext"], "description": "platform may not support E2E" }
          }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "uri": { "type": "string", "format": "at-uri" } } } }
    }
  }
}
