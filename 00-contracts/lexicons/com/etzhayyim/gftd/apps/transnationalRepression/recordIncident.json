{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.transnationalRepression.recordIncident",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Transnational repression / diaspora targeting (bridges interpolRedabuse.flagAbusivePattern + refugee-unhcr + press-freedom)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "incidentId",
            "originCountryIso3",
            "hostCountryIso3",
            "targetCategory",
            "tacticKind",
            "occurredAt"
          ],
          "properties": {
            "incidentId": {
              "type": "string"
            },
            "originCountryIso3": {
              "type": "string"
            },
            "hostCountryIso3": {
              "type": "string"
            },
            "targetCategory": {
              "type": "string",
              "enum": [
                "journalist",
                "dissident",
                "activist",
                "lawyer",
                "academic",
                "religious",
                "minority",
                "ngo_worker",
                "lgbtq",
                "artist",
                "family_member",
                "double_national"
              ]
            },
            "tacticKind": {
              "type": "string",
              "enum": [
                "assassination",
                "abduction",
                "physical_assault",
                "renditions",
                "coerced_return",
                "diaspora_surveillance",
                "digital_harassment",
                "family_intimidation",
                "property_seizure",
                "freeze_remittance",
                "defamation",
                "frivolous_lawsuit",
                "asylum_revoke_demand"
              ]
            },
            "redNoticeAbuseVid": {
              "type": "string",
              "description": "bridges interpolRedabuse.flagAbusivePattern"
            },
            "occurredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}