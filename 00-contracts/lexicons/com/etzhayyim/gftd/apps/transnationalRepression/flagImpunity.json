{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.transnationalRepression.flagImpunity",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Impunity / host-state indifference / extradition-requested retaliation (bridges interpolRedabuse.flagAbusivePattern + press-freedom + civil-liability)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "incidentVid",
            "impunityKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "incidentVid": {
              "type": "string",
              "description": "bridges recordIncident"
            },
            "impunityKind": {
              "type": "string",
              "enum": [
                "host_state_inaction",
                "investigation_abandoned",
                "prosecution_declined",
                "visa_leverage",
                "economic_leverage",
                "intelligence_cooperation",
                "diplomatic_assurances_ignored",
                "perp_escape",
                "family_in_origin",
                "hostage_diplomacy"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}