{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.portOfCallRoster.recordCall",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Vessel port call roster (carrier-schedule+biosecurity+customs+crew bridge)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "callId",
            "imo",
            "portVid",
            "arrivedAt"
          ],
          "properties": {
            "callId": {
              "type": "string"
            },
            "carrierScheduleVid": {
              "type": "string",
              "description": "bridges open-carrier-schedule"
            },
            "biosecurityInspectionVid": {
              "type": "string",
              "description": "bridges open-biosecurity"
            },
            "customsClearanceVid": {
              "type": "string",
              "description": "bridges open-customs-clearance"
            },
            "imo": {
              "type": "string",
              "description": "vessel IMO"
            },
            "portVid": {
              "type": "string"
            },
            "arrivedAt": {
              "type": "string",
              "format": "datetime"
            },
            "departedAt": {
              "type": "string",
              "format": "datetime"
            },
            "cargoOperation": {
              "type": "string",
              "enum": [
                "load",
                "discharge",
                "transit",
                "bunker"
              ]
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}