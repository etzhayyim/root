{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.portOfCallRoster.logCrewChange",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Crew sign-on / sign-off at port call",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "crewChangeId",
            "callVid",
            "direction",
            "changedAt"
          ],
          "properties": {
            "crewChangeId": {
              "type": "string"
            },
            "callVid": {
              "type": "string",
              "description": "bridges recordCall"
            },
            "seafarerVid": {
              "type": "string",
              "description": "bridges open-crew-welfare"
            },
            "direction": {
              "type": "string",
              "enum": [
                "sign_on",
                "sign_off",
                "transfer"
              ]
            },
            "changedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}