{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.biosecurity.issueQuarantineOrder",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Quarantine order bridging to maritime-incident",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "orderId",
            "inspectionVid",
            "quarantineDurationHours",
            "reason",
            "issuedAt"
          ],
          "properties": {
            "orderId": {
              "type": "string"
            },
            "inspectionVid": {
              "type": "string",
              "description": "bridges inspectVessel"
            },
            "maritimeIncidentVid": {
              "type": "string",
              "description": "bridges open-hormuz-incident"
            },
            "quarantineDurationHours": {
              "type": "integer"
            },
            "reason": {
              "type": "string"
            },
            "issuedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}