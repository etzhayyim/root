{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.genderPayGap.reportEmployerMetric",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Pay transparency metric (EU Pay Transparency Directive / UK GPG / DE EntgTranspG / AU WGEA — bridges esg-risk-rating + forced-labor)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "reportId",
            "regime",
            "reportingYear",
            "submittedAt"
          ],
          "properties": {
            "reportId": {
              "type": "string"
            },
            "employerLei": {
              "type": "string"
            },
            "regime": {
              "type": "string",
              "enum": [
                "eu_ptd",
                "uk_gpg",
                "de_entgttranspg",
                "au_wgea",
                "fr_regulation",
                "is_equal_pay"
              ]
            },
            "reportingYear": {
              "type": "integer"
            },
            "hourlyMeanGapPct": {
              "type": "number"
            },
            "hourlyMedianGapPct": {
              "type": "number"
            },
            "bonusMeanGapPct": {
              "type": "number"
            },
            "womenUpperQuartilePct": {
              "type": "number"
            },
            "womenLowerQuartilePct": {
              "type": "number"
            },
            "employeeCount": {
              "type": "integer"
            },
            "submittedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "gapTier": {
              "type": "string",
              "enum": [
                "parity",
                "moderate",
                "significant",
                "severe"
              ]
            }
          }
        }
      }
    }
  }
}