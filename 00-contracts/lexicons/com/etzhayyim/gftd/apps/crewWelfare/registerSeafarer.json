{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.crewWelfare.registerSeafarer",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Seafarer MLC registration (orcid+isco+carrier bridge)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "seafarerId",
            "rank",
            "embarkedAt"
          ],
          "properties": {
            "seafarerId": {
              "type": "string"
            },
            "orcid": {
              "type": "string",
              "description": "bridges open-orcid"
            },
            "iscoCode": {
              "type": "string",
              "description": "ISCO occupation, bridges open-isco"
            },
            "carrierFleetVid": {
              "type": "string",
              "description": "vessel IMO, bridges open-carrier-fleet"
            },
            "rank": {
              "type": "string",
              "enum": [
                "master",
                "officer",
                "rating",
                "cadet"
              ]
            },
            "flagState": {
              "type": "string"
            },
            "embarkedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}