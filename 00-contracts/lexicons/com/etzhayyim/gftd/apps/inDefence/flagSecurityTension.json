            "actionVid",
            "tensionKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "actionVid": {
              "type": "string",
              "description": "bridges recordDefenceAction"
            },
            "tensionKind": {
              "type": "string",
              "enum": [
                "lac_china_galwan",
                "arunachal_china_claim",
                "pakistan_loc",
                "kashmir_internal",
                "indian_ocean_china",
                "quad_friction",
                "afghanistan_taliban",
                "myanmar_border",
                "nepal_border_strip",
                "sri_lanka_china",
                "caatsa_pressure",
                "russia_oil_payments",
                "s400_friction"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}