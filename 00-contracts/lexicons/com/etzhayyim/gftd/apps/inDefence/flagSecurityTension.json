{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.inDefence.flagSecurityTension",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Security tension / LAC standoff / Pakistan / Indo-Pacific (bridges transnationalRepression + universalJurisdiction + criticalMinerals)",
