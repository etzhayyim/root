{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.foodFraud.recordIncident",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Food fraud / adulteration / mislabelling incident (bridges isotopeTraceability.flagOriginMismatch + rasff-food-safety + residue-mrl)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "incidentId",
            "productCategory",
            "fraudKind",
            "countryDetectedIso3",
            "detectedAt"
          ],
          "properties": {
            "incidentId": {
              "type": "string"
            },
            "productCategory": {
              "type": "string",
              "enum": [
                "olive_oil",
                "honey",
                "seafood",
                "spice",
                "dairy",
                "meat",
                "juice",
                "coffee",
                "cocoa",
                "fish_oil",
                "baby_formula",
                "tea",
                "wine",
                "alcohol"
              ]
            },
            "fraudKind": {
              "type": "string",
              "enum": [
                "dilution",
                "substitution",
                "concealment",
                "unapproved_additive",
                "mislabelling",
                "counterfeit",
                "overstating_origin",
                "overstating_organic",
                "species_swap",
                "off_spec_blending",
                "gray_market",
                "past_shelflife"
              ]
            },
            "countryDetectedIso3": {
              "type": "string"
            },
            "mismatchVid": {
              "type": "string",
              "description": "bridges isotopeTraceability.flagOriginMismatch"
            },
            "detectedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}