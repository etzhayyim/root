{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.remittanceCorridor.flagCorridorStress",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Corridor stress / consolidation / humanitarian shutdown (bridges correspondentBanking.flagDerisking + refugee-unhcr + humanitarian)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "snapshotVid",
            "stressKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "snapshotVid": {
              "type": "string",
              "description": "bridges recordCorridorCost"
            },
            "stressKind": {
              "type": "string",
              "enum": [
                "last_provider_exit",
                "crypto_off_ramp_cut",
                "humanitarian_freeze",
                "sanctions_spillover",
                "mto_concentration",
                "high_cost_sustained",
                "cbr_exit",
                "fraud_surge",
                "license_revocation",
                "fatf_grey_list"
              ]
            },
            "affectedPersonsMillions": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}