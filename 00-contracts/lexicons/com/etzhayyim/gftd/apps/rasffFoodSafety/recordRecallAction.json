{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.rasffFoodSafety.recordRecallAction",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Recall / withdrawal action (bridges gigWorker + pharma-supply + icpen-consumer)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "recallId",
            "alertVid",
            "actionClass",
            "issuedAt"
          ],
          "properties": {
            "recallId": {
              "type": "string"
            },
            "alertVid": {
              "type": "string",
              "description": "bridges recordAlert"
            },
            "operatorLei": {
              "type": "string"
            },
            "scopeCountries": {
              "type": "string",
              "description": "ISO3 comma"
            },
            "affectedUnits": {
              "type": "integer"
            },
            "actionClass": {
              "type": "string",
              "enum": [
                "class_i",
                "class_ii",
                "class_iii"
              ],
              "description": "FDA recall class"
            },
            "issuedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "minor",
                "severe",
                "critical"
              ]
            }
          }
        }
      }
    }
  }
}