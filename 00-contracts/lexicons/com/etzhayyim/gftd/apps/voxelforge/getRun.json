{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.voxelforge.getRun",
  "defs": {
    "main": {
      "type": "query",
      "description": "Fetch the current status of a voxelforge LangGraph run (artifact URIs once completed). Per ADR-2605080700.",
      "parameters": {
        "type": "params",
        "required": ["runId"],
        "properties": {
          "runId": {
            "type": "string",
            "description": "LangGraph run_id returned by com.etzhayyim.apps.voxelforge.generate."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["runId", "designId", "status", "startedAt", "artifacts"],
          "properties": {
            "runId": { "type": "string" },
            "designId": { "type": "string" },
            "status": {
              "type": "string",
              "enum": ["pending", "running", "completed", "failed", "interrupted"]
            },
            "currentNode": {
              "type": "string",
              "description": "Active StateGraph node name (parse_input | route_generator | generate_trellis | generate_comfy3d | exec_cadquery | post_process_mesh | voxelize | export_artifacts | register_artifact)."
            },
            "errorText": { "type": "string" },
            "startedAt": { "type": "string", "format": "datetime" },
            "finishedAt": { "type": "string", "format": "datetime" },
            "costJpyMicro": {
              "type": "integer",
              "description": "Aggregated cost in JPY-micro (1 JPY = 1_000_000 micro). Includes RunPod GPU seconds + LLM tokens + storage egress."
            },
            "artifacts": {
              "type": "array",
              "description": "Materialized artifacts to date. Empty until export_artifacts node completes.",
              "items": {
                "type": "object",
                "required": ["format", "b2Bucket", "b2Key", "sha256Hex", "byteSize"],
                "properties": {
                  "format": { "type": "string", "enum": ["glb", "vox", "voxel_grid_json", "manifest_json"] },
                  "b2Bucket": { "type": "string" },
                  "b2Key": { "type": "string" },
                  "sha256Hex": { "type": "string" },
                  "byteSize": { "type": "integer" },
                  "voxelDim": { "type": "integer" },
                  "polygonCount": { "type": "integer" },
                  "generatedBy": { "type": "string", "enum": ["trellis", "comfy3d", "cadquery"] },
                  "presignedUrl": {
                    "type": "string",
                    "format": "uri",
                    "description": "Optional 5-minute presigned download URL minted at query time."
                  }
                }
              }
            }
          }
        }
      },
      "errors": [
        { "name": "NotFound", "description": "Run id unknown or already pruned (TTL 90d)." },
        { "name": "Forbidden", "description": "Caller actor_did does not match run.actor_did." }
      ]
    }
  }
}
