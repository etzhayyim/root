{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.cdrVerification.flagReversalRisk",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Reversal risk signal (fire / permafrost / leakage — bridges extreme-weather-attribution + geoengineering-registry)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "riskId",
            "eventVid",
            "reversalCause",
            "reportedAt"
          ],
          "properties": {
            "riskId": {
              "type": "string"
            },
            "eventVid": {
              "type": "string",
              "description": "bridges recordRemovalEvent"
            },
            "reversalCause": {
              "type": "string",
              "enum": [
                "fire",
                "flood",
                "drought",
                "disease",
                "harvest",
                "seepage",
                "saturation",
                "permafrost"
              ]
            },
            "tonnesReversed": {
              "type": "number"
            },
            "bufferPoolClaimed": {
              "type": "boolean"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}