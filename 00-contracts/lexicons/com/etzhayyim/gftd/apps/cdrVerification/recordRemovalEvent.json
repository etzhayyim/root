{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.cdrVerification.recordRemovalEvent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Carbon removal verification (ERW / DAC / BECCS — bridges climate-carbon-market + geoengineering-registry + climate-value-chain)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "eventId",
            "technologyClass",
            "tonnesCo2eGross",
            "storageDurability",
            "verifiedAt"
          ],
          "properties": {
            "eventId": {
              "type": "string"
            },
            "operatorLei": {
              "type": "string"
            },
            "technologyClass": {
              "type": "string",
              "enum": [
                "DAC",
                "BECCS",
                "ERW",
                "OAF",
                "ocean_alkalinity",
                "biochar",
                "reforestation",
                "DACCS",
                "mineralization"
              ]
            },
            "tonnesCo2eGross": {
              "type": "number"
            },
            "verifierLei": {
              "type": "string"
            },
            "mrvMethodology": {
              "type": "string",
              "enum": [
                "puro_earth",
                "isometric",
                "verra_vm0044",
                "gs_soils",
                "cdr_fi_v0"
              ]
            },
            "storageDurability": {
              "type": "string",
              "enum": [
                "geologic_1000yr",
                "mineral_10000yr",
                "biological_100yr",
                "biological_30yr"
              ]
            },
            "verifiedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "durabilityTier": {
              "type": "string",
              "enum": [
                "short_term",
                "long_term",
                "durable"
              ]
            }
          }
        }
      }
    }
  }
}