{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airCrew.assessFatigue",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Assess crew fatigue risk against Flight Time Limitations (FTL).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["crew_did", "pairing_did"],
          "properties": {
            "crew_did": { "type": "string" },
            "pairing_did": { "type": "string" },
            "ftl_margin_pct": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
