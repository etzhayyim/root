{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airCrew.notifyCrew",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Send a notification to a crew member regarding roster or operational change.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["crew_did", "message_type", "message"],
          "properties": {
            "crew_did": { "type": "string" },
            "message_type": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
