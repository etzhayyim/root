{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airCrew.assignCrew",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Assign a crew member to a pairing with a specific role.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["pairing_did", "crew_did", "role"],
          "properties": {
            "pairing_did": { "type": "string" },
            "crew_did": { "type": "string" },
            "role": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
