{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.cbamEmbedded.recordEmbeddedEmission",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "CBAM embedded emission declaration (bridges euDpp.flagDppInconsistency + climate-value-chain + imo-emissions)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "declarationId",
            "sectorKind",
            "originCountryIso3",
            "embeddedTco2e",
            "declaredAt"
          ],
          "properties": {
            "declarationId": {
              "type": "string"
            },
            "importerLei": {
              "type": "string"
            },
            "sectorKind": {
              "type": "string",
              "enum": [
                "cement",
                "iron_steel",
                "aluminium",
                "fertilizer",
                "electricity",
                "hydrogen",
                "downstream_iron",
                "chemical_precursor",
                "refined_steel",
                "plastics_precursor"
              ]
            },
            "originCountryIso3": {
              "type": "string"
            },
            "embeddedTco2e": {
              "type": "number"
            },
            "benchmarkTco2e": {
              "type": "number"
            },
            "dppVid": {
              "type": "string",
              "description": "bridges euDpp.flagDppInconsistency"
            },
            "declaredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}