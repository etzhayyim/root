{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.councilPresidency.flagPriorityShift",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Mid-presidency priority shift / national interest tilt (bridges euTrilogue.flagDeadlock + judicial-review-gdpr + esma-convergence)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "priorityVid",
            "shiftKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "priorityVid": {
              "type": "string",
              "description": "bridges recordPriority"
            },
            "shiftKind": {
              "type": "string",
              "enum": [
                "national_interest_tilt",
                "emergency_diversion",
                "external_event",
                "ec_pushback",
                "commission_disagreement",
                "ep_resistance",
                "cohesion_concern",
                "budget_battle",
                "summit_outcome"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}