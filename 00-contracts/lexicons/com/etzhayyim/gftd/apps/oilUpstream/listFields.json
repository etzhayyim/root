{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.oilUpstream.listFields",
  "defs": {
    "main": {
      "type": "query",
      "description": "List oil/gas upstream fields with offset/limit pagination, optional filters.",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "properties": {
          "country": { "type": "string" },
          "basin": { "type": "string" },
          "operatorDid": { "type": "string", "format": "did" },
          "fieldType": { "type": "string" },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "required": ["fields", "total", "offset", "limit"], "properties": { "fields": { "type": "array", "items": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "name": { "type": "string" }, "basin": { "type": "string" }, "country": { "type": "string" }, "fieldType": { "type": "string" }, "currentProductionBopd": { "type": "number" } } } }, "total": { "type": "integer" }, "offset": { "type": "integer" }, "limit": { "type": "integer" } } } }
    }
  }
}
