{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.genocideConvention.flagProvisionalMeasure",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Provisional measures / irreparable harm / non-compliance (bridges minorityRights.flagBacklash + poc-ihl + civil-liability)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "procedureVid",
            "measureKind",
            "orderedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "procedureVid": {
              "type": "string",
              "description": "bridges recordProcedure"
            },
            "measureKind": {
              "type": "string",
              "enum": [
                "prevent_genocide",
                "halt_military",
                "allow_humanitarian",
                "preserve_evidence",
                "protect_witnesses",
                "stop_destruction",
                "inform_court",
                "reporting_obligation",
                "ordered_compliance",
                "non_compliance"
              ]
            },
            "orderedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}