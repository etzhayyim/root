{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.treasuryMarketStress.flagFedIntervention",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Fed intervention / standing repo / emergency dealer lending (bridges marginCall.flagFailure + liquidity-facility + bank-resolution)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "eventVid",
            "interventionKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "eventVid": {
              "type": "string",
              "description": "bridges recordStressEvent"
            },
            "interventionKind": {
              "type": "string",
              "enum": [
                "srf",
                "pdcf_emergency",
                "open_market_purchases",
                "qe_restart",
                "dealer_lending",
                "term_auction",
                "money_market_guarantee",
                "fhl_expansion",
                "fima_repo",
                "swap_line_activation",
                "direct_lending_nbfi"
              ]
            },
            "notionalBusd": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}