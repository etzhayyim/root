{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.forestryMrv.registerForestProject",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "REDD+/ARR/IFM project with MRV (Verra VCS / ART-TREES / Plan Vivo / GCF — bridges nature-markets.registerBiodiversityCredit + land-tenure + blue-carbon-mrv)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "projectId",
            "registryKind",
            "projectKind",
            "countryIso3",
            "registeredAt"
          ],
          "properties": {
            "projectId": {
              "type": "string"
            },
            "registryKind": {
              "type": "string",
              "enum": [
                "verra_vcs",
                "art_trees",
                "gold_standard",
                "plan_vivo",
                "accu",
                "jcm",
                "gcf",
                "national_redd"
              ]
            },
            "projectKind": {
              "type": "string",
              "enum": [
                "redd_plus",
                "arr",
                "ifm",
                "wrc",
                "agroforestry",
                "mangrove_restore",
                "peatland_rewetting",
                "urban_forest"
              ]
            },
            "countryIso3": {
              "type": "string"
            },
            "areaHectares": {
              "type": "number"
            },
            "expectedTco2eYearly": {
              "type": "number"
            },
            "biodiversityCreditVid": {
              "type": "string",
              "description": "bridges nature-markets.registerBiodiversityCredit"
            },
            "indigenousTitleHolder": {
              "type": "string"
            },
            "registeredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}