{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.forestryMrv.recordCoverChange",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Global Forest Watch / FAO FRA / CTrees forest-cover change (bridges climate-carbon-market + biodiversity-gbf + indigenous-rights + soil-carbon)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "measurementId",
            "countryIso3",
            "measurementYear",
            "recordedAt"
          ],
          "properties": {
            "measurementId": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "adminRegion": {
              "type": "string"
            },
            "hectaresLost": {
              "type": "number"
            },
            "hectaresGained": {
              "type": "number"
            },
            "primaryForestHaLost": {
              "type": "number"
            },
            "driverDominant": {
              "type": "string",
              "enum": [
                "commodity_permanent",
                "commodity_shifting",
                "forestry",
                "wildfire",
                "urbanization",
                "other"
              ]
            },
            "measurementYear": {
              "type": "integer"
            },
            "dataSource": {
              "type": "string",
              "enum": [
                "hansen",
                "jaxa_alos",
                "sentinel",
                "planet",
                "modis_vcf",
                "ctrees_jurisdictional"
              ]
            },
            "recordedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "degradationTier": {
              "type": "string",
              "enum": [
                "moderate",
                "significant",
                "severe"
              ]
            }
          }
        }
      }
    }
  }
}