{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.registerNetworkAsset",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a physical network asset (router / fiber / antenna / battery) with serial# tracking.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["serialNumber", "assetKind"],
          "properties": {
            "assetId": { "type": "string" },
            "serialNumber": { "type": "string" },
            "assetKind": { "type": "string", "enum": ["router", "switch", "antenna", "fiber_cable", "battery", "rectifier", "shelter", "transport_radio"] },
            "vendor": { "type": "string" },
            "model": { "type": "string" },
            "installedSiteId": { "type": "string" },
            "installedNodeId": { "type": "string" },
            "installedAt": { "type": "string", "format": "datetime" },
            "warrantyUntil": { "type": "string", "format": "date" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "assetId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
