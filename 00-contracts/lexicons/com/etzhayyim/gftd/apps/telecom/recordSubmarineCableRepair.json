{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.recordSubmarineCableRepair",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a submarine cable fault or repair dispatch event, including ROV/vessel references when available.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["cableSystemId", "faultKind", "status"],
          "properties": {
            "repairId": { "type": "string" },
            "cableSystemId": { "type": "string" },
            "routeSegmentId": { "type": "string" },
            "faultKind": { "type": "string", "enum": ["shunt_fault", "fiber_cut", "repeater_fault", "power_feed_fault", "planned_maintenance", "unknown"] },
            "faultLatitude": { "type": "number" },
            "faultLongitude": { "type": "number" },
            "vesselRef": { "type": "string" },
            "rovAssetRef": { "type": "string" },
            "dispatchedAt": { "type": "string", "format": "datetime" },
            "completedAt": { "type": "string", "format": "datetime" },
            "status": { "type": "string", "enum": ["detected", "triaged", "dispatched", "repairing", "completed", "cancelled"] }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "repairId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
