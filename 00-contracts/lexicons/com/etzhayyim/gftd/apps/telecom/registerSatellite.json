{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.registerSatellite",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "NTN — register a satellite asset. NORAD ID + International Designator are public catalog identifiers (no PII). Phase 14 satellite plane.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["operatorOrgId", "displayName", "orbitClass", "frequencyBands", "serviceModes", "launchedAt", "observedAt"],
          "properties": {
            "satelliteId": { "type": "string" },
            "operatorOrgId": { "type": "string" },
            "displayName": { "type": "string" },
            "orbitClass": { "type": "string", "enum": ["leo", "meo", "geo", "heo", "molniya"] },
            "noradId": { "type": "string" },
            "intlDesignator": { "type": "string" },
            "frequencyBands": { "type": "array", "items": { "type": "string" } },
            "serviceModes": { "type": "array", "items": { "type": "string", "enum": ["transparent", "regenerative", "iot_ntn", "broadband_ntn", "messaging_only"] } },
            "launchedAt": { "type": "string", "format": "date" },
            "eolAt": { "type": "string", "format": "date" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "satelliteId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
