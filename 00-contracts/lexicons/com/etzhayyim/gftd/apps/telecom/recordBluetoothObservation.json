{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.recordBluetoothObservation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a Bluetooth/BLE scan observation from a robot or field sensor. Advertisement payloads and service UUID lists are persisted as hashes.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["observerAssetId", "addressHash", "advertisementHash", "observedAt"],
          "properties": {
            "observationId": { "type": "string" },
            "observerAssetId": { "type": "string" },
            "deviceId": { "type": "string" },
            "addressHash": { "type": "string" },
            "rssiDbm": { "type": "number" },
            "txPowerDbm": { "type": "number" },
            "serviceUuidHashes": { "type": "array", "items": { "type": "string" } },
            "advertisementHash": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "observationId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
