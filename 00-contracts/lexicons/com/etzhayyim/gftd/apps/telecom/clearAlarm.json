{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.clearAlarm",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "OSS NOC — clear an alarm and compute MTTR (mean time to repair) from raised_at to cleared_at. Mutates the alarm row in place.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["alarmId", "clearKind", "clearedBy", "clearedAt"],
          "properties": {
            "alarmId": { "type": "string" },
            "clearKind": { "type": "string", "enum": ["operator", "auto", "expired", "duplicate", "false_positive"] },
            "clearedBy": { "type": "string" },
            "clearedAt": { "type": "string", "format": "datetime" },
            "resolutionRef": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "alarmId": { "type": "string" },
          "mttrSeconds": { "type": "number" },
          "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
