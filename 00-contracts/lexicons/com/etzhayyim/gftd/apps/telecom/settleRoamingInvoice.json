{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.settleRoamingInvoice",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Aggregate inbound + outbound TAP files for a partner over a period and emit a net settlement invoice. Designed for timer-start (R/P1M).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["partnerId", "periodStart", "periodEnd", "direction"],
          "properties": {
            "invoiceId": { "type": "string" },
            "partnerId": { "type": "string" },
            "periodStart": { "type": "string", "format": "date" },
            "periodEnd": { "type": "string", "format": "date" },
            "direction": { "type": "string", "enum": ["receivable", "payable", "net"] },
            "currency": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "invoiceId": { "type": "string" }, "netAmount": { "type": "number" },
          "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
