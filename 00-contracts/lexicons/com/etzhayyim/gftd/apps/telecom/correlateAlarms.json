{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.correlateAlarms",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "OSS NOC — correlate child alarms under a parent (root cause), suppressing storm. ruleRef points to a DMN rule (com.etzhayyim.dmn.*) or a vault://rule pointer.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["parentAlarmId", "childAlarmIds", "correlationKind", "observedAt"],
          "properties": {
            "correlationId": { "type": "string" },
            "parentAlarmId": { "type": "string" },
            "childAlarmIds": { "type": "array", "items": { "type": "string" } },
            "correlationKind": { "type": "string", "enum": ["root_cause", "topology", "temporal", "rule_engine", "ml_clustering"] },
            "ruleRef": { "type": "string" },
            "confidence": { "type": "number" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "correlationId": { "type": "string" },
          "childCount": { "type": "integer" },
          "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
