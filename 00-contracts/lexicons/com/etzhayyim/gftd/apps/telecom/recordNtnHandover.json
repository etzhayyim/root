{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.recordNtnHandover",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "NTN — record a handover event between NTN cells / satellites or between NTN ↔ terrestrial. Doppler offset + one-way propagation delay captured for QoS audit.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["profileId", "handoverKind", "sourceCellId", "targetCellId", "triggerKind", "observedAt"],
          "properties": {
            "handoverId": { "type": "string" },
            "profileId": { "type": "string" },
            "handoverKind": { "type": "string", "enum": ["intra_satellite", "inter_satellite", "ntn_to_tn", "tn_to_ntn", "constellation_handoff"] },
            "sourceCellId": { "type": "string" },
            "targetCellId": { "type": "string" },
            "sourceSatelliteId": { "type": "string" },
            "targetSatelliteId": { "type": "string" },
            "triggerKind": { "type": "string", "enum": ["beam_sweep", "elevation_min", "load_balance", "cell_pattern_change", "terrestrial_coverage", "operator_request"] },
            "dopplerOffsetHz": { "type": "number" },
            "oneWayDelayMs": { "type": "number" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "handoverId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
