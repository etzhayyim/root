{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.bridgeAndspToCellular",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ANDSP / ATSSS handoff bridge — record a Wi-Fi ↔ 5G cellular transition for a UE. andspPolicyRef must be vault://. Links Phase 13 wlan_session to Phase 4 PDU session.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sessionId", "profileId", "atsssMode", "transitionKind", "observedAt"],
          "properties": {
            "bridgeId": { "type": "string" },
            "sessionId": { "type": "string" },
            "profileId": { "type": "string" },
            "atsssMode": { "type": "string", "enum": ["mptcp", "mpquic", "atsss-ll", "switch_only"] },
            "andspPolicyHash": { "type": "string" },
            "andspPolicyRef": { "type": "string" },
            "targetSnssai": { "type": "string" },
            "targetDnn": { "type": "string" },
            "targetPduSessionId": { "type": "string" },
            "transitionKind": { "type": "string", "enum": ["wifi_to_5g", "5g_to_wifi", "concurrent_steering", "active_active"] },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "bridgeId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
