{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.subscribeE2Service",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "O-RAN E2 — xApp subscribes to an E2 service (KPM / RC / NI / CCC) on an E2 Node with event trigger + action definition.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["xappId", "e2NodeId", "ranFunctionId", "serviceModel", "eventTriggerKind", "actionKind", "observedAt"],
          "properties": {
            "subscriptionId": { "type": "string" },
            "xappId": { "type": "string" },
            "e2NodeId": { "type": "string" },
            "ranFunctionId": { "type": "string" },
            "serviceModel": { "type": "string", "enum": ["e2sm-kpm", "e2sm-rc", "e2sm-ni", "e2sm-ccc"] },
            "eventTriggerKind": { "type": "string", "enum": ["periodic", "ueid", "cell", "upon_change"] },
            "actionKind": { "type": "string", "enum": ["report", "insert", "policy", "control"] },
            "reportingPeriodMs": { "type": "integer" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "subscriptionId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
