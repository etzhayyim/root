{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.registerWlanRcoi",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "WBA OpenRoaming / Hotspot 2.0 — register a Roaming Consortium Organization Identifier (RCOI). Phase 13 Wi-Fi convergence.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["oiHex", "federation", "identityProviderOrgId", "profileKind", "validFrom", "validUntil", "observedAt"],
          "properties": {
            "rcoiId": { "type": "string" },
            "oiHex": { "type": "string" },
            "federation": { "type": "string", "enum": ["wba_openroaming", "eduroam", "cityroam", "private", "regional"] },
            "identityProviderOrgId": { "type": "string" },
            "agreementId": { "type": "string" },
            "profileKind": { "type": "string", "enum": ["settled", "settlement_free", "private"] },
            "validFrom": { "type": "string", "format": "datetime" },
            "validUntil": { "type": "string", "format": "datetime" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "rcoiId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
