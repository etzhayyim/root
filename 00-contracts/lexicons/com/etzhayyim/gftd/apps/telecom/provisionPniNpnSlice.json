{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.provisionPniNpnSlice",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "NPN — provision a Public-Network-Integrated NPN slice (PNI-NPN). Slice runs on hosting PLMN with optional CAG access restriction + tenant isolation.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["enterpriseOrgId", "hostingPlmnId", "snssai", "dnn", "isolationKind", "slaTier", "validUntil", "observedAt"],
          "properties": {
            "pniId": { "type": "string" },
            "enterpriseOrgId": { "type": "string" },
            "hostingPlmnId": { "type": "string" },
            "snssai": { "type": "string" },
            "dnn": { "type": "string" },
            "cagId": { "type": "string" },
            "isolationKind": { "type": "string", "enum": ["dedicated_dnn", "dedicated_slice", "shared_dnn_with_qos"] },
            "slaTier": { "type": "string", "enum": ["bronze", "silver", "gold", "platinum"] },
            "validUntil": { "type": "string", "format": "datetime" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "pniId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
