{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.registerWlanMeshLink",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register or update a WLAN mesh node link, covering 802.11s/HWMP-style field mesh telemetry without implementing the radio stack.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sourceMeshNodeId", "targetMeshNodeId", "metricKind", "observedAt"],
          "properties": {
            "linkId": { "type": "string" },
            "sourceMeshNodeId": { "type": "string" },
            "targetMeshNodeId": { "type": "string" },
            "metricKind": { "type": "string", "enum": ["airtime", "rssi", "manual", "controller"] },
            "airtimeLinkMetric": { "type": "number" },
            "rssiDbm": { "type": "number" },
            "txRateMbps": { "type": "number" },
            "rxRateMbps": { "type": "number" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "linkId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
