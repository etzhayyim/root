{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.auditInterceptAccess",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "LICF audit — record any operator-side access to LI warrants / targets / deliveries (read, query, export). Required by ETSI TS 102 232-1 for tamper-evident audit trail.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["accessKind", "accessor", "accessorRole", "recordKind", "recordVid", "observedAt"],
          "properties": {
            "auditId": { "type": "string" },
            "warrantId": { "type": "string" },
            "targetId": { "type": "string" },
            "accessKind": { "type": "string", "enum": ["read", "query", "export", "modify", "delete"] },
            "accessor": { "type": "string" },
            "accessorRole": { "type": "string", "enum": ["li_admin", "li_operator", "compliance_officer", "regulator", "system"] },
            "justification": { "type": "string" },
            "recordKind": { "type": "string", "enum": ["warrant", "target", "iri", "cc", "ack"] },
            "recordVid": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "auditId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
