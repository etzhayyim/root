{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.recordStreamSlaBreach",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a TSN stream SLA breach (latency / jitter / frame loss). Auto-mints a ticketId for downstream Phase 7 alarm correlation.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["streamId", "breachKind", "severity", "witnessBridgeId", "observedAt"],
          "properties": {
            "breachId": { "type": "string" },
            "streamId": { "type": "string" },
            "breachKind": { "type": "string", "enum": ["latency", "jitter", "frame_loss", "gate_violation", "shaper_overrun", "sync_loss"] },
            "severity": { "type": "string", "enum": ["minor", "major", "critical"] },
            "observedLatencyNs": { "type": "integer" },
            "slaLatencyNs": { "type": "integer" },
            "observedJitterNs": { "type": "integer" },
            "observedFrameLossPpm": { "type": "integer" },
            "witnessBridgeId": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "breachId": { "type": "string" },
          "ticketId": { "type": "string" },
          "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
