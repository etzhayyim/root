{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.humanitarianCorridor.recordCorridor",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Humanitarian corridor / UN OCHA access (bridges remittanceCorridor.flagCorridorStress + refugee-unhcr + ocha-funding)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "corridorId",
            "theater",
            "mechanism",
            "leadAgency",
            "openedAt"
          ],
          "properties": {
            "corridorId": {
              "type": "string"
            },
            "theater": {
              "type": "string",
              "enum": [
                "gaza_strip",
                "lebanon",
                "syria",
                "yemen",
                "sudan",
                "ethiopia",
                "somalia",
                "dr_congo",
                "mozambique",
                "myanmar",
                "ukraine",
                "haiti",
                "afghanistan",
                "sahel",
                "venezuela"
              ]
            },
            "mechanism": {
              "type": "string",
              "enum": [
                "cross_border",
                "cross_line",
                "humanitarian_pause",
                "deconfliction",
                "safe_passage",
                "evacuation",
                "airdrop",
                "sea_corridor",
                "civil_military"
              ]
            },
            "leadAgency": {
              "type": "string",
              "enum": [
                "ocha",
                "wfp",
                "unhcr",
                "unicef",
                "icrc",
                "msf",
                "red_crescent",
                "savethechildren",
                "care",
                "mercy_corps"
              ]
            },
            "remittanceStressVid": {
              "type": "string",
              "description": "bridges remittanceCorridor.flagCorridorStress"
            },
            "openedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}