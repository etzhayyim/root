{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.crcChildrenDigital.recordComplianceReport",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "UN CRC General Comment 25 digital environment (bridges digital-identity + misinformation-observatory + icpen-consumer + ai-governance)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "reportId",
            "countryIso3",
            "reportingCycle",
            "pillar",
            "submittedAt"
          ],
          "properties": {
            "reportId": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "reportingCycle": {
              "type": "string",
              "description": "CRC periodic review cycle"
            },
            "pillar": {
              "type": "string",
              "enum": [
                "access",
                "non_discrimination",
                "best_interests",
                "life_survival",
                "right_to_be_heard",
                "privacy",
                "protection_from_harm",
                "education",
                "culture",
                "health",
                "identity"
              ]
            },
            "indicatorScore": {
              "type": "integer"
            },
            "evidenceUrl": {
              "type": "string"
            },
            "submittedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}