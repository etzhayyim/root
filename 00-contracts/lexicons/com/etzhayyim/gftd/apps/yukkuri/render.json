{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yukkuri.render",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Trigger final video render for an assembled yukkuri project. Routes to Mac render pool (DEFAULT) or CF Browser Rendering (Phase 1). Output is an mp4/webm blob attached to the video record via blobKey.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["videoUri"],
          "properties": {
            "videoUri": { "type": "string" },
            "container": { "type": "string", "enum": ["mp4", "webm"], "default": "mp4" },
            "videoCodec": { "type": "string", "enum": ["h264", "vp9", "av1"], "default": "h264" },
            "audioCodec": { "type": "string", "enum": ["aac", "opus"], "default": "aac" },
            "resolution": { "type": "string", "enum": ["720p", "1080p", "1440p"] },
            "fps": { "type": "integer", "enum": [24, 30, 60] },
            "loudnessLufs": { "type": "number", "default": -14.0 },
            "watermark": { "type": "boolean", "default": true },
            "backend": { "type": "string", "enum": ["mac-pool", "cf-browser", "auto"], "default": "auto" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["videoUri", "status"],
          "properties": {
            "videoUri": { "type": "string" },
            "status": { "type": "string" },
            "blobKey": { "type": "string" },
            "durationSec": { "type": "integer" },
            "estimatedSec": { "type": "integer" }
          }
        }
      }
    }
  }
}
