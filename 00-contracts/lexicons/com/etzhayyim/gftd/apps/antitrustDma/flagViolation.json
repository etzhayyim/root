{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.antitrustDma.flagViolation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Interop / self-preferencing / tying violation + fines",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "violationId",
            "designationVid",
            "obligationBreached",
            "issuedAt"
          ],
          "properties": {
            "violationId": {
              "type": "string"
            },
            "designationVid": {
              "type": "string",
              "description": "bridges designateGatekeeper"
            },
            "obligationBreached": {
              "type": "string",
              "enum": [
                "interop",
                "tying",
                "self_preferencing",
                "data_portability",
                "no_moat_ads",
                "no_auto_switch",
                "third_party_app_store",
                "ai_bundling"
              ]
            },
            "fineEur": {
              "type": "number"
            },
            "resolutionType": {
              "type": "string",
              "enum": [
                "commitment",
                "formal_prohibition",
                "behavioral_remedy",
                "structural_remedy",
                "appealed"
              ]
            },
            "issuedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "impactTier": {
              "type": "string",
              "enum": [
                "notice",
                "significant",
                "record"
              ]
            }
          }
        }
      }
    }
  }
}