{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.resourceFlow.getSankey",
  "defs": {
    "main": {
      "type": "query",
      "description": "Sankey-ready edge list for one of the 3 private-sector flow classes (currency / service / personnel). Reads mv_resource_flow_sankey_* materialized views. ADR-0028. PII Tier 1 — aggregate-only, no individual DID.",
      "parameters": {
        "type": "params",
        "required": ["flowClass"],
        "properties": {
          "flowClass":     { "type": "string", "enum": ["currency", "service", "personnel"] },
          "domain":        { "type": "string", "description": "Cluster filter — e.g. 'hospitality' resolves to industry_code IN ('I5510','I5520','N7911')" },
          "industryCode":  { "type": "string", "description": "ISIC rev4 filter; takes precedence over domain" },
          "sourceDid":     { "type": "string", "format": "did" },
          "fiscalPeriod":  { "type": "string", "description": "ISO 8601 period (YYYY-MM / YYYY-Qn / YYYY)" },
          "limit":         { "type": "integer", "minimum": 1, "maximum": 1000, "default": 200 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["flowClass", "edges"],
          "properties": {
            "flowClass": { "type": "string" },
            "edges":     { "type": "array", "items": { "type": "object" } },
            "nodes":     { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    }
  }
}
