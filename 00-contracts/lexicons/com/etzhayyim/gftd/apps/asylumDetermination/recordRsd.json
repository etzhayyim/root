{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.asylumDetermination.recordRsd",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Refugee status determination / Convention grounds adjudication (bridges transnationalRepression.flagImpunity + refugee-unhcr + fpic-consent)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "determinationId",
            "hostCountryIso3",
            "originCountryIso3",
            "forum",
            "convGrounds",
            "decidedAt"
          ],
          "properties": {
            "determinationId": {
              "type": "string"
            },
            "hostCountryIso3": {
              "type": "string"
            },
            "originCountryIso3": {
              "type": "string"
            },
            "forum": {
              "type": "string",
              "enum": [
                "unhcr",
                "national_ria",
                "uk_home_office",
                "us_uscis",
                "eu_ejus",
                "ca_irb",
                "au_rrt",
                "de_bamf",
                "fr_ofpra",
                "jp_moj",
                "mex_comar",
                "safeguard_aboriginal"
              ]
            },
            "convGrounds": {
              "type": "string",
              "enum": [
                "race",
                "religion",
                "nationality",
                "political",
                "social_group",
                "gender",
                "sexual_orientation",
                "humanitarian_stay",
                "subsidiary_protection",
                "complementary",
                "bilateral_prima_facie"
              ]
            },
            "repressionVid": {
              "type": "string",
              "description": "bridges transnationalRepression.flagImpunity"
            },
            "decidedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}