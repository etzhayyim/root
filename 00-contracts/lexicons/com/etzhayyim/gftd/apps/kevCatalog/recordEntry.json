{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kevCatalog.recordEntry",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "CISA KEV / BOD 22-01 known exploited vulnerability entry (bridges cveCna.flagDisclosureGap + cyber-vuln-cve + cyber-vuln-patch)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "entryId",
            "cveId",
            "productCategory",
            "exploitationMaturity",
            "dueDate",
            "addedAt"
          ],
          "properties": {
            "entryId": {
              "type": "string"
            },
            "cveId": {
              "type": "string"
            },
            "productCategory": {
              "type": "string"
            },
            "exploitationMaturity": {
              "type": "string",
              "enum": [
                "poc_public",
                "itw_active",
                "targeted",
                "widespread",
                "ransomware_used",
                "apt_used",
                "criminal_campaign",
                "botnet_worm"
              ]
            },
            "disclosureGapVid": {
              "type": "string",
              "description": "bridges cveCna.flagDisclosureGap"
            },
            "dueDate": {
              "type": "string"
            },
            "addedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}