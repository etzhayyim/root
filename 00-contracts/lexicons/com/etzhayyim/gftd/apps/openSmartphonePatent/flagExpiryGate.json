{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openSmartphonePatent.flagExpiryGate",
  "defs": {
    "main": {
      "type": "query",
      "description": "List SEPs expiring within N months — the 'free zone' for open implementation",
      "parameters": {
        "type": "params",
        "properties": {
          "withinMonths": { "type": "integer", "default": 24, "description": "Patents expiring within N months" },
          "standard": { "type": "string", "knownValues": ["4g-lte", "5g-nr", "wifi6", "wifi7", "bluetooth", "gnss", "other"] },
          "limit": { "type": "integer", "default": 100, "maximum": 500 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["expiring", "total"],
          "properties": {
            "expiring": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["vertexId", "patentNo", "rat", "expiryDate"],
                "properties": {
                  "vertexId": { "type": "string" },
                  "patentNo": { "type": "string" },
                  "holderDid": { "type": "string" },
                  "rat": { "type": "string" },
                  "expiryDate": { "type": "string" },
                  "frandDeclared": { "type": "boolean" }
                }
              }
            },
            "total": { "type": "integer" }
          }
        }
      }
    }
  }
}
