{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kami.ketsuGorilla.getLeaderboard",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get the Goriketsu Dash leaderboard.",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "properties": {
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 },
          "offset": { "type": "integer", "minimum": 0, "default": 0 }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "entries": { "type": "array", "items": { "type": "object" } },
            "limit": { "type": "integer" },
            "offset": { "type": "integer" }
          },
          "required": ["entries"]
        }
      }
    }
  }
}
