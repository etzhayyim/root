{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.socialMediaInfluenceOp.recordOperation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Social media influence operation / CIB takedown (bridges constituencyPressure.flagAstroturf + transnational-repression + press-freedom)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "operationId",
            "attribution",
            "targetCountryIso3",
            "methodKind",
            "detectedAt"
          ],
          "properties": {
            "operationId": {
              "type": "string"
            },
            "attribution": {
              "type": "string",
              "enum": [
                "state_actor",
                "commercial_pr",
                "spamouflage",
                "doppelganger",
                "secondary_infektion",
                "internet_research_agency",
                "front_org",
                "politically_motivated",
                "crime_for_hire",
                "extremist_movement",
                "unknown"
              ]
            },
            "targetCountryIso3": {
              "type": "string"
            },
            "methodKind": {
              "type": "string",
              "enum": [
                "bot_amplification",
                "fake_accounts",
                "ai_generated_personas",
                "deepfake_video",
                "cloned_news",
                "cross_platform",
                "payment_to_influencers",
                "ad_targeting",
                "narrative_seeding",
                "brigading",
                "coordinated_review_fraud",
                "mass_reporting"
              ]
            },
            "astroturfVid": {
              "type": "string",
              "description": "bridges constituencyPressure.flagAstroturf"
            },
            "detectedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}