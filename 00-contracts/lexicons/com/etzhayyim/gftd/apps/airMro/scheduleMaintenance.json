{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airMro.scheduleMaintenance",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Schedule a maintenance check for an aircraft.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["tail_number", "maintenance_type", "scheduled_date"],
          "properties": {
            "tail_number": { "type": "string" },
            "maintenance_type": { "type": "string" },
            "scheduled_date": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
