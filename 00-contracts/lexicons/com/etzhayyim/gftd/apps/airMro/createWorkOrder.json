        "schema": {
          "type": "object",
          "required": ["tail_number", "ata_chapter", "task_description"],
          "properties": {
            "tail_number": { "type": "string" },
            "ata_chapter": { "type": "string" },
            "task_description": { "type": "string" },
            "priority": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
