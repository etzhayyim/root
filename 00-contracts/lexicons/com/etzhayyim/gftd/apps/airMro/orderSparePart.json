{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airMro.orderSparePart",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Order a spare part for aircraft maintenance.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["part_no", "quantity", "urgency"],
          "properties": {
            "part_no": { "type": "string" },
            "quantity": { "type": "integer" },
            "urgency": { "type": "string" },
            "supplier": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
