{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.climateCarbonMarket.retireCarbonCredit",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Credit retirement against commodity-trade settlement or esg compliance",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "retirementId",
            "creditVid",
            "retiredBy",
            "purpose",
            "retiredAt"
          ],
          "properties": {
            "retirementId": {
              "type": "string"
            },
            "creditVid": {
              "type": "string",
              "description": "bridges issueCarbonCredit"
            },
            "retiredBy": {
              "type": "string",
              "description": "LEI retiring entity"
            },
            "settlementVid": {
              "type": "string",
              "description": "bridges open-commodity-trade settleContract"
            },
            "esgRatingVid": {
              "type": "string",
              "description": "bridges open-esg-risk-rating"
            },
            "purpose": {
              "type": "string",
              "enum": [
                "compliance",
                "voluntary_neutrality",
                "offset_product",
                "insetting"
              ]
            },
            "retiredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}