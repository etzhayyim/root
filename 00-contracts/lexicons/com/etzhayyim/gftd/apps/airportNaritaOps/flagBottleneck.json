{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airportNaritaOps.flagBottleneck",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Bottleneck / cargo bridge collapse / customs queue / slot waste (bridges airplane-airport + customs-declaration + airline-jal-ops)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "opsVid",
            "bottleneckKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "opsVid": {
              "type": "string",
              "description": "bridges recordTerminalOps"
            },
            "bottleneckKind": {
              "type": "string",
              "enum": [
                "customs_queue",
                "cargo_bridge",
                "baggage_belt",
                "passport_slow",
                "biometric_offline",
                "apron_full",
                "fuel_pipeline",
                "ground_handling_strike",
                "cargo_perishable_delay",
                "arrival_late_evening",
                "departure_early_morning",
                "slot_waste",
                "aircraft_disabled_blocking",
                "atc_radar_outage"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}