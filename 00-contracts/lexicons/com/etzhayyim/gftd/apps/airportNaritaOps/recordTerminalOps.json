{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airportNaritaOps.recordTerminalOps",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Narita NRT terminal operations / cargo / cross-border (bridges airplane-airport + customs-declaration + iata-codeshare)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "opsId",
            "terminalKind",
            "opsKind",
            "recordedAt"
          ],
          "properties": {
            "opsId": {
              "type": "string"
            },
            "terminalKind": {
              "type": "string",
              "enum": [
                "t1_north",
                "t1_south",
                "t2",
                "t3_lcc",
                "cargo_north",
                "cargo_south",
                "sat_a",
                "sat_b",
                "general_aviation_apron",
                "disabled_apron",
                "fuel_apron",
                "fence_perimeter"
              ]
            },
            "opsKind": {
              "type": "string",
              "enum": [
                "cargo_freighter",
                "int_pax",
                "lcc_dom",
                "int_codeshare",
                "customs_inbound",
                "customs_outbound",
                "customs_quarantine",
                "afis_passport",
                "biometric_face",
                "slot_full",
                "seasonal_charter",
                "crisis_evacuation"
              ]
            },
            "carrierLei": {
              "type": "string"
            },
            "flightVid": {
              "type": "string",
              "description": "bridges airplane-flight"
            },
            "recordedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}