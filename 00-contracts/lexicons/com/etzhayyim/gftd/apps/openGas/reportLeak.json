{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openGas.reportLeak",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Report a gas leak on a pipe segment. DOT-aligned classification: class 1 (hazardous, immediate), class 2 (non-hazardous but repair within 6mo), class 3 (non-hazardous, monitor). Starts BPMN process open_gas_report_leak.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["utilityOrgId", "segmentVertexId", "concentrationLelPct", "nearIgnition", "reportedAt"],
          "properties": {
            "utilityOrgId":        { "type": "string" },
            "segmentVertexId":     { "type": "string" },
            "latitude":            { "type": "number" },
            "longitude":           { "type": "number" },
            "concentrationLelPct": { "type": "number", "description": "% of Lower Explosive Limit" },
            "nearIgnition":        { "type": "boolean" },
            "reportedAt":          { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "leakClass": { "type": "integer", "description": "1/2/3" },
            "requirePublicNotice": { "type": "boolean" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
