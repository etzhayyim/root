{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openGas.definePipeSegment",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a gas pipe segment (regulator → service area). Starts BPMN process open_gas_define_pipe_segment.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["utilityOrgId", "fromVertexId", "toVertexId", "diameterMm", "material", "lengthM"],
          "properties": {
            "utilityOrgId":  { "type": "string" },
            "fromVertexId":  { "type": "string" },
            "toVertexId":    { "type": "string" },
            "diameterMm":    { "type": "integer" },
            "material":      { "type": "string" },
            "lengthM":       { "type": "number" },
            "maopKpa":       { "type": "number", "description": "Max Allowable Operating Pressure" },
            "installedAt":   { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
