{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.unispsc.health",
  "defs": {
    "main": {
      "type": "query",
      "description": "UNSPSC LangServer health probe. Returns registry warmth + LLM model availability.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["status", "registryReady", "agentCount"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["healthy", "degraded", "starting", "unhealthy"]
            },
            "registryReady": {"type": "boolean"},
            "agentCount": {"type": "integer", "description": "Total agents discoverable in registry."},
            "warmAgents": {"type": "integer", "description": "Agents currently in LRU cache."},
            "modelsAvailable": {
              "type": "array",
              "items": {"type": "string"}
            },
            "uptimeMs": {"type": "integer"}
          }
        }
      }
    }
  }
}
