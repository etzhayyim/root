{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.bisTriennial.flagShift",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Structural shift / dedollarization / yuan rise (bridges fedSwapUsage.flagPolicyTradeoff + stablecoin-reserves + digital-euro-brics)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "surveyVid",
            "shiftKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "surveyVid": {
              "type": "string",
              "description": "bridges recordSurveyPoint"
            },
            "shiftKind": {
              "type": "string",
              "enum": [
                "dedollarization",
                "yuan_internationalization",
                "euro_stabilization",
                "yen_swap_drop",
                "offshore_cny",
                "onshore_cny",
                "rupee_internationalization",
                "crypto_ramp",
                "asian_clearing_union",
                "gulf_settlement_diversion"
              ]
            },
            "magnitudeDeltaPct": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}