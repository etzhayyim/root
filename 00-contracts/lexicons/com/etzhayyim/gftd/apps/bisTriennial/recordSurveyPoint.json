{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.bisTriennial.recordSurveyPoint",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "BIS Triennial Central Bank Survey data point (bridges fedSwapUsage.flagPolicyTradeoff + fx-swap-lines + commodity-trade)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "surveyId",
            "year",
            "instrumentKind",
            "currencyPair",
            "reportedAt"
          ],
          "properties": {
            "surveyId": {
              "type": "string"
            },
            "year": {
              "type": "integer"
            },
            "instrumentKind": {
              "type": "string",
              "enum": [
                "spot",
                "outright_forward",
                "fx_swap",
                "xccy_swap",
                "options",
                "ndf",
                "fx_futures",
                "otc_ir",
                "otc_equity",
                "otc_commodity",
                "otc_credit",
                "dealer_to_dealer",
                "dealer_to_customer"
              ]
            },
            "currencyPair": {
              "type": "string"
            },
            "adtvBusd": {
              "type": "number",
              "description": "Average Daily Turnover"
            },
            "swapUsageVid": {
              "type": "string",
              "description": "bridges fedSwapUsage.flagPolicyTradeoff"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}