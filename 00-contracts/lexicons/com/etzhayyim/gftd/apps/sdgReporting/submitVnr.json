{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.sdgReporting.submitVnr",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Voluntary National Review (UN HLPF — bridges biodiversity-gbf + universal-health-coverage + climate-adaptation-finance + cofog)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "vnrId",
            "countryIso3",
            "submissionYear",
            "submittedAt"
          ],
          "properties": {
            "vnrId": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "submissionYear": {
              "type": "integer"
            },
            "hlpfSession": {
              "type": "string"
            },
            "indicatorsCovered": {
              "type": "integer",
              "description": "count of SDG indicators reported"
            },
            "dataGapsCount": {
              "type": "integer"
            },
            "leaveNoOneBehindFocus": {
              "type": "boolean"
            },
            "submittedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}