{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.landRestitution.flagRestitutionObstacle",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Restitution process obstacle / competing claim / state delay (bridges fpicConsent.flagFpicViolation + indigenous-rights + worker-grievance)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "claimVid",
            "obstacleKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "claimVid": {
              "type": "string",
              "description": "bridges recordClaim"
            },
            "obstacleKind": {
              "type": "string",
              "enum": [
                "state_delay",
                "competing_claim",
                "overlapping_title",
                "third_party_interest",
                "resource_concession",
                "legal_fee_barrier",
                "evidentiary_burden",
                "statute_of_limitations",
                "non_enforcement",
                "intimidation"
              ]
            },
            "yearsPending": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}