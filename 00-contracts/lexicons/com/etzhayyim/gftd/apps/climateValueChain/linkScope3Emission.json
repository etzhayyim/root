{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.climateValueChain.linkScope3Emission",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Scope 3 emissions trace (commodity-trade → asia-refinery → carbon-market)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "linkId",
            "tonnesCo2eGross",
            "reportedAt"
          ],
          "properties": {
            "linkId": {
              "type": "string"
            },
            "commodityTradeVid": {
              "type": "string",
              "description": "bridges open-commodity-trade"
            },
            "refineryReceiptVid": {
              "type": "string",
              "description": "bridges open-asia-refinery"
            },
            "carbonCreditVid": {
              "type": "string",
              "description": "bridges open-climate-carbon-market"
            },
            "reportingLei": {
              "type": "string"
            },
            "tonnesCo2eGross": {
              "type": "number"
            },
            "tonnesCo2eOffset": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "mitigationTier": {
              "type": "string",
              "enum": [
                "unoffset",
                "partial_offset",
                "net_zero"
              ]
            }
          }
        }
      }
    }
  }
}