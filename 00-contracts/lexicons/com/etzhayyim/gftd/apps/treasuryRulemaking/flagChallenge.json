{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.treasuryRulemaking.flagChallenge",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "APA challenge / Chevron step-2 / West Virginia v EPA major questions (bridges iraTaxCredit.flagFeocDisqualification + climate-litigation + wto-dispute)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "ruleVid",
            "challengeKind",
            "filedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "ruleVid": {
              "type": "string",
              "description": "bridges recordRule"
            },
            "challengeKind": {
              "type": "string",
              "enum": [
                "apa_arbitrary_capricious",
                "major_questions_doctrine",
                "chevron_overturned",
                "statutory_ultra_vires",
                "constitutional_takings",
                "equal_protection",
                "preemption",
                "retroactivity"
              ]
            },
            "plaintiffCategory": {
              "type": "string",
              "enum": [
                "industry",
                "state_ag",
                "ngo",
                "individual",
                "foreign_entity",
                "trade_association"
              ]
            },
            "filedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}