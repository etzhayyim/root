{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ongakuka.compose",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Enqueue a music composition job. Returns trackUri immediately; pipeline runs reactively (lyricist→composer→vocalist‖arranger→mixer→critic). Final published surface is a derived AppBskyFeedPost.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["lyrics", "style"],
          "properties": {
            "title": { "type": "string", "maxLength": 200 },
            "lyrics": { "type": "string" },
            "style": { "type": "string" },
            "styleRefUri": { "type": "string" },
            "language": { "type": "string" },
            "bpm": { "type": "integer" },
            "durationSec": { "type": "integer", "minimum": 5, "maximum": 600, "default": 90 },
            "modelId": { "type": "string" },
            "seed": { "type": "integer" },
            "stems": { "type": "boolean", "default": false, "description": "Also produce vocal/inst/drum/bass stems" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["trackUri", "projectId", "status"],
          "properties": {
            "trackUri": { "type": "string" },
            "projectId": { "type": "string" },
            "status": { "type": "string" },
            "estimatedSec": { "type": "integer" }
          }
        }
      }
    }
  }
}
