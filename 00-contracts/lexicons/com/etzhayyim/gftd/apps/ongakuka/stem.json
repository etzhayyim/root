{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ongakuka.stem",
  "description": "Per-stem audio (vocal / drums / bass / other / instrumental). Child of a track.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["trackUri", "kind", "blobKey", "mimeType"],
        "properties": {
          "trackUri": { "type": "string", "description": "at://... of parent com.etzhayyim.apps.ongakuka.track" },
          "kind": {
            "type": "string",
            "enum": ["vocal", "chorus", "drums", "bass", "guitar", "keys", "synth", "strings", "fx", "other", "instrumental", "fullmix"]
          },
          "blobKey": { "type": "string" },
          "mimeType": { "type": "string" },
          "durationSec": { "type": "integer" },
          "loudnessLufs": { "type": "number", "description": "Integrated LUFS (target -14 for streaming)" },
          "actorDid": { "type": "string", "description": "path-based actor DID that produced this stem (vocalist/arranger/...)" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
