{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.sovereignGuarantee.flagCallEvent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Guarantee call / trigger event / cross-default (bridges soeBalanceSheet.flagContingentRisk + sovereign-debt + imf-article-iv)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "guaranteeVid",
            "triggerKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "guaranteeVid": {
              "type": "string",
              "description": "bridges recordGuarantee"
            },
            "triggerKind": {
              "type": "string",
              "enum": [
                "default_beneficiary",
                "acceleration",
                "rating_downgrade",
                "material_adverse_change",
                "covenant_breach",
                "insolvency_event",
                "currency_event",
                "political_event"
              ]
            },
            "calledBusd": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}