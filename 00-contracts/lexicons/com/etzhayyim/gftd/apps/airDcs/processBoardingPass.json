{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airDcs.processBoardingPass",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Issue a boarding pass for a checked-in passenger.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["checkin_vid", "seat_no", "gate_code"],
          "properties": {
            "checkin_vid": { "type": "string" },
            "seat_no": { "type": "string" },
            "gate_code": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
