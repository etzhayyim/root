{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.frugalFourCoalition.recordPosition",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Frugal Four / New Hanseatic / fiscal-rules coalition position (bridges eurogroupDecision.flagPoliticalRift + euTrilogue + euSummitConclusion)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "positionId",
            "coalition",
            "memberStateIso3",
            "dossier",
            "expressedAt"
          ],
          "properties": {
            "positionId": {
              "type": "string"
            },
            "coalition": {
              "type": "string",
              "enum": [
                "frugal_four",
                "new_hanseatic",
                "mediterranean",
                "sgp_reform_block",
                "esm_block",
                "banking_union_block",
                "capital_markets_block",
                "carbon_border_pro",
                "carbon_border_skeptic",
                "ngeu_redirection_block",
                "grants_to_loans_swap"
              ]
            },
            "memberStateIso3": {
              "type": "string"
            },
            "dossier": {
              "type": "string",
              "enum": [
                "mff_2028",
                "sgp_reform",
                "banking_union",
                "capital_markets",
                "ngeu_review",
                "esm_treaty",
                "tpi",
                "fiscal_capacity",
                "crisis_facility",
                "financial_stability"
              ]
            },
            "riftVid": {
              "type": "string",
              "description": "bridges eurogroupDecision.flagPoliticalRift"
            },
            "expressedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}