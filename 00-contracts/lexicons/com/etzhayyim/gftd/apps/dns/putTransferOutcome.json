{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.dns.putTransferOutcome",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Server-side INSERT of a transferOutcome row into vertex_dns_transferOutcome (ADR-2605111200). Final terminal state of the Squarespace → Cloudflare transfer workflow.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["rkey", "transferRequestUri", "domain", "result", "completedAt"],
          "properties": {
            "rkey": { "type": "string" },
            "transferRequestUri": { "type": "string" },
            "domain": { "type": "string" },
            "result": { "type": "string", "enum": ["success", "failure", "aborted"] },
            "zoneDid": { "type": "string" },
            "cloudflareZoneId": { "type": "string" },
            "failureReason": { "type": "string", "maxLength": 2048 },
            "completedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" }
          }
        }
      }
    }
  }
}
