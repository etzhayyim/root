{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.redseaIncident.reportHouthiAttack",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Houthi 攻撃事件",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "attackId",
            "weaponType",
            "impact",
            "occurredAt"
          ],
          "properties": {
            "attackId": {
              "type": "string"
            },
            "imo": {
              "type": "string"
            },
            "vesselName": {
              "type": "string"
            },
            "flag": {
              "type": "string"
            },
            "weaponType": {
              "type": "string",
              "enum": [
                "anti-ship-missile",
                "drone",
                "usv",
                "boarding-rhib",
                "limpet-mine"
              ]
            },
            "impact": {
              "type": "string",
              "enum": [
                "miss",
                "near-miss",
                "damage",
                "sunk",
                "hijack"
              ]
            },
            "lat": {
              "type": "number"
            },
            "lon": {
              "type": "number"
            },
            "narrative": {
              "type": "string"
            },
            "casualties": {
              "type": "integer"
            },
            "vesselDamaged": {
              "type": "boolean"
            },
            "vesselSunk": {
              "type": "boolean"
            },
            "occurredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "severity": {
              "type": "string",
              "enum": [
                "minor",
                "moderate",
                "major",
                "critical"
              ]
            },
            "requireInternationalNotice": {
              "type": "boolean"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
