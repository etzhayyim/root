{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.batteryPassport.logSecondLifeTransfer",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Second-life / recycle transfer (bridges chemicals-management + textile-circularity)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "transferId",
            "passportVid",
            "useCase",
            "transferredAt"
          ],
          "properties": {
            "transferId": {
              "type": "string"
            },
            "passportVid": {
              "type": "string",
              "description": "bridges registerPassport"
            },
            "recipientLei": {
              "type": "string"
            },
            "useCase": {
              "type": "string",
              "enum": [
                "second_life_stationary",
                "second_life_bulk",
                "recycling",
                "disposal"
              ]
            },
            "stateOfHealthPct": {
              "type": "number"
            },
            "transferredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}