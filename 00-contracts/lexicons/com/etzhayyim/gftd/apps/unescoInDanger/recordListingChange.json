{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.unescoInDanger.recordListingChange",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "UNESCO World Heritage In-Danger / delisting / reactive monitoring (bridges heritageAccessibility.flagConservationConflict + cultural-heritage + biodiversity-gbf)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "changeId",
            "siteId",
            "siteKind",
            "actionKind",
            "countryIso3",
            "effectiveAt"
          ],
          "properties": {
            "changeId": {
              "type": "string"
            },
            "siteId": {
              "type": "string"
            },
            "siteKind": {
              "type": "string",
              "enum": [
                "cultural",
                "natural",
                "mixed",
                "intangible_urgent",
                "tentative",
                "transboundary",
                "serial"
              ]
            },
            "actionKind": {
              "type": "string",
              "enum": [
                "added_to_in_danger",
                "removed_from_in_danger",
                "reactive_monitoring",
                "delisted",
                "world_heritage_removed",
                "emergency_budget",
                "advisory_mission",
                "state_of_conservation_report"
              ]
            },
            "countryIso3": {
              "type": "string"
            },
            "heritageAccessVid": {
              "type": "string",
              "description": "bridges heritageAccessibility.flagConservationConflict"
            },
            "effectiveAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}