{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.fpicConsent.recordConsentEvent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "FPIC (Free Prior Informed Consent) / UNDRIP / ILO C169 event (bridges soyMoratorium.flagMoratoriumBreach + indigenous-rights + land-tenure)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "eventId",
            "communityName",
            "countryIso3",
            "projectType",
            "consentStage",
            "reportedAt"
          ],
          "properties": {
            "eventId": {
              "type": "string"
            },
            "communityName": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "projectType": {
              "type": "string",
              "enum": [
                "mining",
                "oil_gas",
                "hydro",
                "wind",
                "solar_utility",
                "agribusiness",
                "logging",
                "reservoir",
                "transmission_line",
                "pipeline",
                "rail_corridor",
                "tourism_resort",
                "carbon_credit",
                "redd_plus",
                "defense_installation"
              ]
            },
            "consentStage": {
              "type": "string",
              "enum": [
                "pre_consultation",
                "agreement_reached",
                "ongoing_process",
                "refused",
                "withdrawn",
                "legal_challenge",
                "not_sought"
              ]
            },
            "moratoriumBreachVid": {
              "type": "string",
              "description": "bridges soyMoratorium.flagMoratoriumBreach"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}