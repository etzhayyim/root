{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.digitalAccessibility.recordConformance",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "WCAG 2.2 / EN 301 549 / Section 508 / EAA conformance audit (bridges antitrust-dma + ai-governance + misinformation-observatory)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "auditId",
            "standard",
            "conformanceLevel",
            "auditedAt"
          ],
          "properties": {
            "auditId": {
              "type": "string"
            },
            "productLei": {
              "type": "string"
            },
            "standard": {
              "type": "string",
              "enum": [
                "wcag_2_1",
                "wcag_2_2",
                "wcag_3",
                "en_301_549",
                "section_508",
                "eaa",
                "jis_x_8341",
                "gb_t_37668"
              ]
            },
            "conformanceLevel": {
              "type": "string",
              "enum": [
                "a",
                "aa",
                "aaa",
                "not_compliant"
              ]
            },
            "criteriaPassed": {
              "type": "integer"
            },
            "criteriaFailed": {
              "type": "integer"
            },
            "auditMethod": {
              "type": "string",
              "enum": [
                "automated",
                "manual_expert",
                "user_testing",
                "hybrid"
              ]
            },
            "auditedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "complianceTier": {
              "type": "string",
              "enum": [
                "non_compliant",
                "partial",
                "compliant",
                "exemplary"
              ]
            }
          }
        }
      }
    }
  }
}