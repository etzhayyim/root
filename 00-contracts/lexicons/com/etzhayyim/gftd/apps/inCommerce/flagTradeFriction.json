{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.inCommerce.flagTradeFriction",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Trade friction / FTA stall / WTO dispute (bridges tradeRemedy + wtoTradeCbam + ustrSection301)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "actionVid",
            "frictionKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "actionVid": {
              "type": "string",
              "description": "bridges recordTradeAction"
            },
            "frictionKind": {
              "type": "string",
              "enum": [
                "fta_uk_stall",
                "fta_eu_stall",
                "fta_canada_stall",
                "apec_join_stall",
                "russia_oil_workaround",
                "caatsa_concern",
                "gsp_lapsed_us",
                "section_301_review",
                "poultry_dispute_us",
                "steel_232_dispute",
                "sugar_subsidy_wto",
                "ip_evergreening",
                "data_localization_dispute"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}