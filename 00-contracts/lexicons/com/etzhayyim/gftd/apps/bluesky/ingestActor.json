{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.bluesky.ingestActor",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Start the LangServer Bluesky public AppView ingest for one actor. Writes profile/post/opt-out/tombstone rows into vertex_bluesky_*.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["actor"],
          "properties": {
            "actor": { "type": "string", "description": "Bluesky handle or DID" },
            "appview": { "type": "string", "default": "https://public.api.bsky.app" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "actorDid": { "type": "string" },
            "handle": { "type": "string" },
            "ingested": { "type": "integer" },
            "tombstoned": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
