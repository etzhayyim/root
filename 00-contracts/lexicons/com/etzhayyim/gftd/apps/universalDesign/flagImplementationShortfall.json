{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.universalDesign.flagImplementationShortfall",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Implementation shortfall / legacy building / accessibility retrofit (bridges assistiveTechProcure.flagSupplyGap + crpd-disability + land-tenure)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "standardVid",
            "shortfallKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "standardVid": {
              "type": "string",
              "description": "bridges recordStandard"
            },
            "shortfallKind": {
              "type": "string",
              "enum": [
                "legacy_building",
                "retrofit_cost",
                "historic_bldg_exemption",
                "rural_budget",
                "public_transit_gap",
                "private_sector_uncovered",
                "accessible_housing_shortage",
                "wayfinding_absent",
                "enforcement_weak",
                "exemptions_abused",
                "certification_fraud"
              ]
            },
            "coverageRatePct": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}