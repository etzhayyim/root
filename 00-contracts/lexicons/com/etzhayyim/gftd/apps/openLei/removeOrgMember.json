{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openLei.removeOrgMember",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "End a person's membership in an org unit by setting the until date.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["orgUnitVid", "personDid"],
          "properties": {
            "orgUnitVid": { "type": "string" },
            "personDid":  { "type": "string" },
            "until":      { "type": "string", "format": "date", "description": "End date. Defaults to today." },
            "dryRun":     { "type": "boolean", "default": false }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok":      { "type": "boolean" },
            "dryRun":  { "type": "boolean" },
            "error":   { "type": "string" }
          }
        }
      }
    }
  }
}
