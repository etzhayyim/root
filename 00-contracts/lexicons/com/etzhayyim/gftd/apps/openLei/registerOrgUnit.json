{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openLei.registerOrgUnit",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register or upsert an org unit (department, project, committee, team, etc.) under a legal entity. Starts BPMN open_lei_register_org_unit. Path and level are computed automatically from parent context.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["lei", "leiVertexId", "orgType", "name"],
          "properties": {
            "lei":              { "type": "string", "description": "LEI code of the parent legal entity." },
            "leiVertexId":     { "type": "string", "description": "vertex_id of the parent vertex_lei_entity row." },
            "orgType":         { "type": "string", "enum": ["division","department","project","committee","team","board","task_force","workgroup","office","bureau"] },
            "name":            { "type": "string" },
            "nameEn":          { "type": "string" },
            "parentOrgVid":    { "type": "string", "description": "vertex_id of the parent org unit. Omit for root-level units." },
            "code":            { "type": "string", "description": "Short unique code within LEI scope (e.g. DEPT-001). Auto-generated if omitted." },
            "purpose":         { "type": "string" },
            "url":             { "type": "string" },
            "validFrom":       { "type": "string", "format": "date" },
            "props":           { "type": "object" },
            "dryRun":          { "type": "boolean", "default": false }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok":        { "type": "boolean" },
            "vertexId":  { "type": "string" },
            "code":      { "type": "string" },
            "path":      { "type": "string" },
            "level":     { "type": "integer" },
            "dryRun":    { "type": "boolean" },
            "error":     { "type": "string" }
          }
        }
      }
    }
  }
}
