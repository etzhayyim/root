{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.culturalHeritage.listProperty",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "UNESCO WHL / Intangible Heritage / Memory of the World (bridges disaster-response + water-scarcity)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "propertyId",
            "listType",
            "countryIso3",
            "inscribedAt"
          ],
          "properties": {
            "propertyId": {
              "type": "string"
            },
            "listType": {
              "type": "string",
              "enum": [
                "whc_cultural",
                "whc_natural",
                "whc_mixed",
                "ich",
                "mow",
                "geopark"
              ]
            },
            "countryIso3": {
              "type": "string"
            },
            "inscribedYear": {
              "type": "integer"
            },
            "criteria": {
              "type": "string",
              "description": "WHC criterion letters i-x"
            },
            "areaHectares": {
              "type": "number"
            },
            "inscribedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}