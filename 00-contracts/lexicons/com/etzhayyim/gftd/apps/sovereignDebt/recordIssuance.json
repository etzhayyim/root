{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.sovereignDebt.recordIssuance",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Sovereign bond issuance (IMF IFS / World Bank DRS — bridges banking + commodity-trade)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "issuanceId",
            "issuerIso3",
            "instrumentType",
            "currency",
            "amountFacial",
            "tenorYears",
            "issuedAt",
            "maturesAt"
          ],
          "properties": {
            "issuanceId": {
              "type": "string"
            },
            "issuerIso3": {
              "type": "string"
            },
            "instrumentType": {
              "type": "string",
              "enum": [
                "eurobond",
                "domestic",
                "sukuk",
                "linker",
                "brady",
                "panda",
                "samurai",
                "green",
                "social",
                "sdg"
              ]
            },
            "currency": {
              "type": "string",
              "description": "ISO 4217"
            },
            "amountFacial": {
              "type": "number"
            },
            "couponPct": {
              "type": "number"
            },
            "tenorYears": {
              "type": "number"
            },
            "yieldAtIssuancePct": {
              "type": "number"
            },
            "issuedAt": {
              "type": "string",
              "format": "datetime"
            },
            "maturesAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "stressTier": {
              "type": "string",
              "enum": [
                "normal",
                "elevated",
                "distressed"
              ]
            }
          }
        }
      }
    }
  }
}