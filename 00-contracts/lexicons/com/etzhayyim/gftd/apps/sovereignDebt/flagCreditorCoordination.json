{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.sovereignDebt.flagCreditorCoordination",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Creditor coordination concern (bridges digital-euro-brics.recordCorridor + ofac-sanctions + antitrust-dma)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "concernId",
            "restructureVid",
            "issueKind",
            "reportedAt"
          ],
          "properties": {
            "concernId": {
              "type": "string"
            },
            "restructureVid": {
              "type": "string",
              "description": "bridges recordDebtRestructure"
            },
            "corridorVid": {
              "type": "string",
              "description": "bridges digital-euro-brics.recordCorridor"
            },
            "issueKind": {
              "type": "string",
              "enum": [
                "holdout_creditor",
                "comparability_of_treatment",
                "collateralized_swap",
                "hidden_debt",
                "non_paris_bilateral",
                "cross_default_trigger",
                "transparency_gap"
              ]
            },
            "intensityTier": {
              "type": "string",
              "enum": [
                "watch",
                "elevated",
                "severe"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}