{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.revolvingDoor.recordTransition",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Government-to-industry / industry-to-government transition (bridges lobbyingDisclosure.flagFaraUnderreport + ethics-disclosure + judicial-influence)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "transitionId",
            "directionKind",
            "jurisdictionIso3",
            "effectiveAt"
          ],
          "properties": {
            "transitionId": {
              "type": "string"
            },
            "personDid": {
              "type": "string"
            },
            "directionKind": {
              "type": "string",
              "enum": [
                "gov_to_industry",
                "industry_to_gov",
                "gov_to_lobby",
                "gov_to_consulting",
                "gov_to_nonprofit",
                "gov_to_academia",
                "gov_to_startup",
                "agency_to_regulated",
                "alumni_donor_pipe",
                "board_revolving"
              ]
            },
            "jurisdictionIso3": {
              "type": "string"
            },
            "coolingOffMonths": {
              "type": "integer"
            },
            "faraUnderreportVid": {
              "type": "string",
              "description": "bridges lobbyingDisclosure.flagFaraUnderreport"
            },
            "effectiveAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}