{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.autonomousVehicleSafety.registerOdd",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "AV Operational Design Domain registration (SAE J3016 — bridges ai-governance + ustr-section-301 + urban-mobility)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "oddId",
            "sdvClass",
            "domain",
            "locationIso3",
            "certifiedAt"
          ],
          "properties": {
            "oddId": {
              "type": "string"
            },
            "operatorLei": {
              "type": "string"
            },
            "sdvClass": {
              "type": "string",
              "enum": [
                "L0",
                "L1",
                "L2",
                "L3",
                "L4",
                "L5"
              ]
            },
            "domain": {
              "type": "string",
              "enum": [
                "highway",
                "urban",
                "suburban",
                "geofenced",
                "parking",
                "last_mile",
                "mining",
                "port",
                "farm"
              ]
            },
            "modelVid": {
              "type": "string",
              "description": "bridges open-ai-governance"
            },
            "locationIso3": {
              "type": "string"
            },
            "fleetSize": {
              "type": "integer"
            },
            "maxSpeedKph": {
              "type": "integer"
            },
            "certifiedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "autonomyTier": {
              "type": "string",
              "enum": [
                "adas",
                "conditional",
                "high_autonomy"
              ]
            }
          }
        }
      }
    }
  }
}