{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openPatent.collectExpiredDrugPatentBacklog",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Collect pharmaceutical patent records whose estimated term has expired into an auditable backlog for generic / biosimilar review.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "asOf": { "type": "string", "format": "date" },
            "limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "jurisdiction": { "type": "string" },
            "dryRun": { "type": "boolean" },
            "rows": {
              "type": "array",
              "items": { "type": "object" }
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "runVertexId": { "type": "string" },
            "asOf": { "type": "string", "format": "date" },
            "scannedCount": { "type": "integer" },
            "candidateCount": { "type": "integer" },
            "insertedCount": { "type": "integer" },
            "candidates": {
              "type": "array",
              "items": { "type": "object" }
            },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
