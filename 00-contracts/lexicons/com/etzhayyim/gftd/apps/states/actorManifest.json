{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.states.actorManifest",
  "defs": {
    "main": {
      "type": "record",
      "description": "Actor manifest / profile record written per path-based DID when a govOrg is first registered. Captures displayName / description / performerType / isBot flag.",
      "x-bootstrap": true,
      "key": "any",
      "record": {
        "type": "object",
        "required": ["displayName"],
        "properties": {
          "displayName": { "type": "string" },
          "description": { "type": "string" },
          "performerType": { "type": "string", "enum": ["service", "bot", "human", "agent"] },
          "isBot": { "type": "boolean" },
          "agentType": { "type": "string", "enum": ["autonomous", "semi-autonomous", "reactive"] },
          "country": { "type": "string", "description": "ISO-3166 alpha-3 lower" },
          "path": { "type": "string" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
