{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.states.govCoverageGap",
  "defs": {
    "main": {
      "type": "record",
      "description": "Detected coverage gap for a government actor (missing source / failed fetch / low OCR / etc.).",
      "x-bootstrap": true,
      "key": "any",
      "record": {
        "type": "object",
        "required": [],
        "properties": {
          "actorDid": { "type": "string" },
          "actorPath": { "type": "string" },
          "actorName": { "type": "string" },
          "gapType": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "nextAction": { "type": "string" },
          "coverageKind": { "type": "string", "enum": ["canonical", "entity", "source", "document", "knowledge"] },
          "scoreBefore": { "type": "number" },
          "targetScore": { "type": "number" },
          "dueAt": { "type": "string", "format": "datetime" },
          "status": { "type": "string" }
        }
      }
    }
  }
}
