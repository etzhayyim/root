{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.vaccineEquity.recordAllocation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Vaccine / medical countermeasure allocation (COVAX / Gavi / CEPI / PAHO Revolving — bridges pandemicPrep.flagCoverageGap + lmic-access + cold-chain)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "allocationId",
            "mechanism",
            "recipientCountryIso3",
            "productClass",
            "dosesAllocated",
            "deliveredAt"
          ],
          "properties": {
            "allocationId": {
              "type": "string"
            },
            "mechanism": {
              "type": "string",
              "enum": [
                "covax",
                "gavi",
                "afro_avat",
                "paho_revolving",
                "bilateral",
                "national_buy",
                "donation",
                "swap"
              ]
            },
            "recipientCountryIso3": {
              "type": "string"
            },
            "manufacturerLei": {
              "type": "string"
            },
            "productClass": {
              "type": "string",
              "enum": [
                "mrna",
                "viral_vector",
                "protein_subunit",
                "inactivated",
                "live_attenuated",
                "monoclonal_ab",
                "antiviral",
                "diagnostic"
              ]
            },
            "dosesAllocated": {
              "type": "integer"
            },
            "deliveredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}