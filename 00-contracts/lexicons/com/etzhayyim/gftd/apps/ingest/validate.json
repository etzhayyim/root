{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ingest.validate",
  "defs": {
    "main": {
      "type": "query",
      "description": "Validate an ingest run or source by checking visibility, counts, cursor state, and optional source hashes.",
      "parameters": {
        "type": "params",
        "properties": {
          "runId": { "type": "string" },
          "ingestFamily": { "type": "string" },
          "sourceId": { "type": "string" },
          "strict": { "type": "boolean" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "status": { "type": "string" },
            "checks": { "type": "array", "items": { "type": "unknown" } },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
