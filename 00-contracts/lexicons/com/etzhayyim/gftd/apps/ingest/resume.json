{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ingest.resume",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Resume a paused ingest run or source cursor and allow workers to continue shard acquisition.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "runId": { "type": "string" },
            "ingestFamily": { "type": "string" },
            "sourceId": { "type": "string" },
            "requestedBy": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "resumed": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
