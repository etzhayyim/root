{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.globalTax.flagProfitShifting",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "BEPS profit-shifting pattern (Action 5/8-10/13 — bridges ofac-sanctions + lei)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "reportVid",
            "pattern",
            "flaggedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "reportVid": {
              "type": "string",
              "description": "bridges reportPillar2Liability"
            },
            "pattern": {
              "type": "string",
              "enum": [
                "harmful_preferential",
                "tp_intangible",
                "cost_contribution",
                "hybrid_mismatch",
                "digital_pe",
                "treaty_shopping",
                "interest_deduction"
              ]
            },
            "relatedPartyLei": {
              "type": "string"
            },
            "estimatedShiftedUsd": {
              "type": "number"
            },
            "flaggedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}