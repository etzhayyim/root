{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.aidesk.getDesignJob",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get the current state of a design job by jobId.",
      "parameters": {
        "type": "params",
        "required": ["jobId"],
        "properties": {
          "jobId": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "vertexId":    { "type": "string" },
            "jobId":       { "type": "string" },
            "actorDid":    { "type": "string" },
            "orgDid":      { "type": "string" },
            "inputType":   { "type": "string" },
            "modelId":     { "type": "string" },
            "licenseTier": { "type": "string" },
            "status":      { "type": "string", "enum": ["queued", "running", "done", "failed"] },
            "inputB2Keys": { "type": "array", "items": { "type": "string" } },
            "errorMessage": { "type": "string" },
            "createdAt":   { "type": "string" }
          }
        }
      }
    }
  }
}
