{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.aidesk.designJob",
  "defs": {
    "main": {
      "type": "record",
      "description": "A CAD synthesis job record. One job per submitDesignJob call. IMMUTABLE after creation except status and errorMessage.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["jobId", "inputType", "modelId", "licenseTier", "status", "inputB2Keys", "createdAt"],
        "properties": {
          "jobId":        { "type": "string" },
          "actorDid":     { "type": "string" },
          "orgDid":       { "type": "string" },
          "atDid":        { "type": "string" },
          "inputType":    { "type": "string", "enum": ["multi-view", "single-view"] },
          "modelId":      { "type": "string", "description": "e.g. ADSKAILab/Zero-To-CAD-Qwen3-VL-2B" },
          "licenseTier":  { "type": "string", "enum": ["apache2", "adsk-noncommercial"] },
          "status":       { "type": "string", "enum": ["queued", "running", "done", "failed"] },
          "inputB2Keys":  { "type": "array", "items": { "type": "string" } },
          "errorMessage": { "type": "string" },
          "createdAt":    { "type": "string" }
        }
      }
    }
  }
}
