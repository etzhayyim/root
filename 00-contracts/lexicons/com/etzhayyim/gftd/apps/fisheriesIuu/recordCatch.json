{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.fisheriesIuu.recordCatch",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "RFMO catch documentation (MSC/CDS — bridges hs + commodity-trade)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "catchId",
            "speciesAsfis",
            "tonnesLanded",
            "landedAt"
          ],
          "properties": {
            "catchId": {
              "type": "string"
            },
            "imo": {
              "type": "string"
            },
            "speciesAsfis": {
              "type": "string",
              "description": "FAO ASFIS 3-alpha species, bridges open-asfis"
            },
            "hsCode": {
              "type": "string"
            },
            "catchAreaFao": {
              "type": "string",
              "description": "FAO major fishing area"
            },
            "gearType": {
              "type": "string",
              "enum": [
                "longline",
                "purse_seine",
                "trawl",
                "gillnet",
                "troll",
                "pole_line",
                "dredge"
              ]
            },
            "tonnesLanded": {
              "type": "number"
            },
            "landedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}