{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.jpMof.flagInterAgencyTension",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "MOF inter-agency tension / 内閣府 vs 財務省 / 経産省 vs 財務省 (bridges treasury-rulemaking + judicial-influence + bepsPillar)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "actionVid",
            "tensionKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "actionVid": {
              "type": "string",
              "description": "bridges recordAction"
            },
            "tensionKind": {
              "type": "string",
              "enum": [
                "naikakufu_vs_mof",
                "meti_vs_mof",
                "mext_vs_mof",
                "mhlw_vs_mof",
                "mlit_vs_mof",
                "jdg_vs_mof",
                "mof_vs_boj",
                "kantei_override",
                "fiscal_council_vote",
                "tax_committee_kacho",
                "ldp_zaiseichoukan",
                "ldp_seimuchoukai",
                "komeito_block",
                "yatou_block"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}