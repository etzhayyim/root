{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ransomwatch.seedGroup",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Enqueue a ransomware group .onion URL for the BPMN-contract crawlRansomwareGroups worker.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["groupSlug", "onionUrl"],
          "properties": {
            "groupSlug":  { "type": "string" },
            "onionUrl":   { "type": "string" },
            "displayName": { "type": "string" },
            "parserId":   { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["seeded", "groupSlug"],
          "properties": {
            "seeded":    { "type": "boolean" },
            "groupSlug": { "type": "string" },
            "note":      { "type": "string" }
          }
        }
      }
    }
  }
}
