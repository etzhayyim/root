{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.malaccaIncident.reportPiracy",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ReCAAP 海賊事件",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "incidentId",
            "recaapCategory",
            "occurredAt"
          ],
          "properties": {
            "incidentId": {
              "type": "string"
            },
            "imo": {
              "type": "string"
            },
            "vesselName": {
              "type": "string"
            },
            "flag": {
              "type": "string"
            },
            "recaapCategory": {
              "type": "string",
              "enum": [
                "cat-1",
                "cat-2",
                "cat-3",
                "cat-4"
              ]
            },
            "lat": {
              "type": "number"
            },
            "lon": {
              "type": "number"
            },
            "narrative": {
              "type": "string"
            },
            "casualties": {
              "type": "integer"
            },
            "cargoStolenUsd": {
              "type": "number"
            },
            "occurredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "severity": {
              "type": "string",
              "enum": [
                "minor",
                "moderate",
                "major",
                "critical"
              ]
            },
            "requireRecaapNotice": {
              "type": "boolean"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
