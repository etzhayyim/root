{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.meetingRecorder.leaveMeeting",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Instruct the recorder bot to leave the meeting, flush remaining chunks to B2, finalize the session record, and (if requested) kick off post-meeting transcription.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sessionId"],
          "properties": {
            "sessionId": {"type": "string"},
            "reason": {
              "type": "string",
              "enum": ["user_requested", "meeting_ended", "consent_revoked", "host_removed", "error"],
              "default": "user_requested"
            },
            "purgeChunks": {
              "type": "boolean",
              "description": "If true, delete already-written B2 chunks (e.g. organizer rejected recording). Default false.",
              "default": false
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sessionId", "status"],
          "properties": {
            "sessionId": {"type": "string"},
            "status": {"type": "string", "enum": ["left", "not_found", "already_left", "failed"]},
            "endedAt": {"type": "string"},
            "chunksWritten": {"type": "integer"},
            "durationMs": {"type": "integer"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
