{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.sox404Icfr.flagWeaknessRemediation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Material weakness remediation / repeat issue / benchmark (bridges restatementEvent.flagStockImpact + audit-firm-oversight + enforcement-action)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "attestationVid",
            "issueKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "attestationVid": {
              "type": "string",
              "description": "bridges recordAttestation"
            },
            "issueKind": {
              "type": "string",
              "enum": [
                "segregation_duties",
                "inadequate_controls",
                "inventory_valuation",
                "revenue_recognition",
                "tax_provision",
                "itgc",
                "access_controls",
                "change_mgmt",
                "data_backup",
                "complex_transactions",
                "m_a_integration",
                "crypto_custody"
              ]
            },
            "consecutiveYears": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}