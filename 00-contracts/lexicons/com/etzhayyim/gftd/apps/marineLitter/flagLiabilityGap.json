{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.marineLitter.flagLiabilityGap",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Plastic treaty / EPR liability gap / ALDFG funding shortfall (bridges maritimeSpill.flagClcInadequacy + plastic-treaty + chemicals-management)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "eventVid",
            "gapKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "eventVid": {
              "type": "string",
              "description": "bridges recordLitterEvent"
            },
            "gapKind": {
              "type": "string",
              "enum": [
                "no_producer_responsibility",
                "orphan_gear",
                "treaty_text_gap",
                "monitoring_sparse",
                "financial_mechanism_missing",
                "traceability_obligation",
                "polluter_pays_failure",
                "recycling_infra_absent",
                "transboundary_flow_unclear",
                "upstream_waste"
              ]
            },
            "unrecoveredBusd": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}