{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openUnispsc.supplier",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a supplier for a UNSPSC commodity. FEEL KYC screening: blocked (sanctioned country), manual-review (quality<0.5 or unknown KYC), approved (quality>=0.7 and kyc=true). Starts BPMN open_unispsc_supplier.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["supplierDid","commodityCode","country","kycCleared","qualityScore","registeredAt"],
          "properties": {
            "supplierDid":   { "type": "string" },
            "commodityCode": { "type": "string" },
            "legalName":     { "type": "string" },
            "country":       { "type": "string", "description": "ISO 3166-1 alpha-3" },
            "kycCleared":    { "type": "boolean" },
            "qualityScore":  { "type": "number", "minimum": 0, "maximum": 1 },
            "registeredAt":  { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
            "riskTier": { "type": "string", "enum": ["approved","manual-review","blocked"] },
            "requireManualKyc": { "type": "boolean" },
            "instanceKey": { "type": "integer" }, "error": { "type": "string" }
          }
        }
      }
    }
  }
}
