{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openUnispsc.commodity",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Resolve a UNSPSC 8-digit commodity as executable procurement business logic with hierarchy, approval, and risk policy.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["code"],
          "properties": {
            "code": { "type": "string", "description": "UNSPSC 8-digit commodity code" },
            "name": { "type": "string" },
            "quantity": { "type": "number" },
            "unitPrice": { "type": "number" },
            "currency": { "type": "string" },
            "dangerousGoods": { "type": "boolean" },
            "sanctionsCheck": { "type": "string" },
            "dryRun": { "type": "boolean" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object" }
      }
    }
  }
}
