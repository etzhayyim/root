{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ungpNap.recordNap",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "UN Guiding Principles National Action Plan / OECD MNE NCP (bridges workerGrievance.flagRemedyFailure + ilo-labor-rights + indigenous-rights)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "napId",
            "countryIso3",
            "napKind",
            "scope",
            "publishedAt"
          ],
          "properties": {
            "napId": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "napKind": {
              "type": "string",
              "enum": [
                "national_action_plan",
                "oecd_ncp_framework",
                "business_human_rights_law",
                "mandatory_due_diligence",
                "voluntary_code",
                "sector_specific",
                "indigenous_frbrco"
              ]
            },
            "scope": {
              "type": "string",
              "enum": [
                "full_business_human_rights",
                "mhrdd_only",
                "supply_chain",
                "conflict_minerals",
                "forced_labor",
                "child_labor",
                "indigenous",
                "environmental"
              ]
            },
            "remedyFailureVid": {
              "type": "string",
              "description": "bridges workerGrievance.flagRemedyFailure"
            },
            "publishedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}