{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.permafrostThaw.flagInfrastructureRisk",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Infrastructure at-risk from thaw (bridges power-grid-interconnect + rail-cross-border + telecom-infra + disaster-response)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "riskId",
            "siteVid",
            "assetKind",
            "countryIso3",
            "reportedAt"
          ],
          "properties": {
            "riskId": {
              "type": "string"
            },
            "siteVid": {
              "type": "string",
              "description": "bridges recordMonitoringSite"
            },
            "assetKind": {
              "type": "string",
              "enum": [
                "road",
                "rail",
                "pipeline",
                "building",
                "airport",
                "tower",
                "powerline",
                "fiber",
                "port"
              ]
            },
            "countryIso3": {
              "type": "string"
            },
            "criticalPopulation": {
              "type": "integer"
            },
            "estimatedDamageUsd": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}