{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.mineralRoyalty.recordRegime",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Mineral royalty / production-share / fiscal-regime (bridges resourceBackedLoan.flagPledgeStress + critical-minerals + sovereign-debt)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "regimeId",
            "hostCountryIso3",
            "regimeKind",
            "mineralCategory",
            "introducedAt"
          ],
          "properties": {
            "regimeId": {
              "type": "string"
            },
            "hostCountryIso3": {
              "type": "string"
            },
            "regimeKind": {
              "type": "string",
              "enum": [
                "royalty_unit",
                "royalty_advalorem",
                "sliding_scale",
                "windfall_tax",
                "resource_rent_tax",
                "equity_share",
                "production_sharing",
                "tax_concession",
                "carry_interest",
                "gold_special_concentrate",
                "oil_psa",
                "gas_concession",
                "mining_code_2024"
              ]
            },
            "mineralCategory": {
              "type": "string",
              "enum": [
                "copper",
                "cobalt",
                "lithium",
                "nickel",
                "gold",
                "tin",
                "tungsten",
                "graphite",
                "rare_earth",
                "iron_ore",
                "coal",
                "oil",
                "gas",
                "diamond",
                "uranium",
                "manganese",
                "bauxite"
              ]
            },
            "pledgeStressVid": {
              "type": "string",
              "description": "bridges resourceBackedLoan.flagPledgeStress"
            },
            "introducedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}