{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.coralReefBleaching.recordBleachingEvent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Coral bleaching / DHW event (NOAA CRW / GCRMN / AIMS / CORDAP — bridges blueCarbonMrv.flagSeaLevelReversal + ocean-acidification + mpa-effectiveness)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "eventId",
            "reefSystem",
            "countryIso3",
            "bleachingAlertLevel",
            "observedAt"
          ],
          "properties": {
            "eventId": {
              "type": "string"
            },
            "reefSystem": {
              "type": "string",
              "enum": [
                "great_barrier",
                "coral_triangle",
                "mesoamerican",
                "red_sea",
                "western_indian",
                "persian_gulf",
                "caribbean",
                "pacific_remote",
                "andaman_nicobar"
              ]
            },
            "countryIso3": {
              "type": "string"
            },
            "dhwPeakC": {
              "type": "number",
              "description": "Degree Heating Weeks peak"
            },
            "bleachingAlertLevel": {
              "type": "string",
              "enum": [
                "no_stress",
                "watch",
                "warning",
                "alert_1",
                "alert_2"
              ]
            },
            "affectedAreaHectares": {
              "type": "number"
            },
            "observedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}