{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.trademark.list",
  "defs": {
    "main": {
      "type": "query",
      "description": "List trademarks filtered by jurisdiction and/or Nice class.",
      "parameters": {
        "type": "params",
        "properties": {
          "jurisdiction": {"type": "string"},
          "niceClass": {"type": "integer", "minimum": 1, "maximum": 45},
          "offset": {"type": "integer", "default": 0, "minimum": 0},
          "limit": {"type": "integer", "default": 50, "minimum": 1, "maximum": 200}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items", "offset", "limit", "total"],
          "properties": {
            "items": {"type": "array", "items": {"type": "unknown"}},
            "offset": {"type": "integer"},
            "limit": {"type": "integer"},
            "total": {"type": "integer"}
          }
        }
      }
    }
  }
}
