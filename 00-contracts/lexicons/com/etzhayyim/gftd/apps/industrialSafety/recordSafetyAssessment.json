{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.industrialSafety.recordSafetyAssessment",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ISO 45001 + ILO OSH + Seveso III / IV assessment (bridges chemicals-management + forced-labor + labour-mobility + disaster-response)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "assessmentId",
            "locationIso3",
            "scheme",
            "conductedAt"
          ],
          "properties": {
            "assessmentId": {
              "type": "string"
            },
            "facilityLei": {
              "type": "string"
            },
            "locationIso3": {
              "type": "string"
            },
            "scheme": {
              "type": "string",
              "enum": [
                "iso_45001",
                "ilo_iso_lg_189",
                "seveso_iii",
                "seveso_iv",
                "ohsas_18001",
                "cs_code",
                "osha_vpp"
              ]
            },
            "hazardTier": {
              "type": "string",
              "enum": [
                "lower",
                "upper",
                "none"
              ],
              "description": "Seveso hazard tier"
            },
            "surveillanceFindings": {
              "type": "integer"
            },
            "conductedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}