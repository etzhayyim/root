{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.gov.submitConsult",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Submit a public services consultation (healthcare, welfare, education, housing, employment).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["requesterDid", "domain", "query"],
          "properties": {
            "requesterDid": { "type": "string" },
            "domain": { "type": "string", "description": "healthcare|welfare|education|housing|employment|child_family" },
            "category": { "type": "string" },
            "query": { "type": "string" },
            "municipalityCode": { "type": "string" },
            "priority": { "type": "string", "description": "normal|urgent" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "status": { "type": "string" }
          }
        }
      }
    }
  }
}
