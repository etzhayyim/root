{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.gov.getAgency",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a government agency by ID including its current officials.",
      "parameters": {
        "type": "params",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "agency": { "type": "object" },
            "officials": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    }
  }
}
