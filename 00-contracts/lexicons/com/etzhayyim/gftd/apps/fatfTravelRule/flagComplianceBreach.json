{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.fatfTravelRule.flagComplianceBreach",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Travel rule compliance breach (bridges ofac-sanctions + mica-crypto + antitrust-dma)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "breachId",
            "transferVid",
            "breachKind",
            "actedAt"
          ],
          "properties": {
            "breachId": {
              "type": "string"
            },
            "transferVid": {
              "type": "string",
              "description": "bridges recordVaspTransfer"
            },
            "breachKind": {
              "type": "string",
              "enum": [
                "missing_originator",
                "missing_beneficiary",
                "sanctions_screening_fail",
                "data_privacy",
                "jurisdiction_mismatch",
                "counterparty_due_diligence"
              ]
            },
            "penaltyUsd": {
              "type": "number"
            },
            "enforcer": {
              "type": "string",
              "enum": [
                "fincen",
                "fca",
                "bafin",
                "jfsa",
                "masc",
                "finma",
                "mica_authority"
              ]
            },
            "actedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}