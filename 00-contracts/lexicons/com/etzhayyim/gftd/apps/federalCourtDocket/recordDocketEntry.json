{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.federalCourtDocket.recordDocketEntry",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "US federal court docket entry (PACER / CourtListener — bridges treasuryRulemaking.flagChallenge + climate-litigation + apa)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "docketId",
            "court",
            "caseNumber",
            "caseCategory",
            "filedAt"
          ],
          "properties": {
            "docketId": {
              "type": "string"
            },
            "court": {
              "type": "string",
              "enum": [
                "scotus",
                "ca_fed",
                "ca_1",
                "ca_2",
                "ca_3",
                "ca_4",
                "ca_5",
                "ca_6",
                "ca_7",
                "ca_8",
                "ca_9",
                "ca_10",
                "ca_11",
                "ca_dc",
                "dc_dc",
                "ed_tx",
                "ed_va",
                "nd_ca",
                "sd_ny",
                "other_district"
              ]
            },
            "caseNumber": {
              "type": "string"
            },
            "caseCategory": {
              "type": "string",
              "enum": [
                "apa_review",
                "antitrust",
                "ip",
                "tax",
                "immigration",
                "environmental",
                "labor",
                "constitutional",
                "criminal",
                "bankruptcy",
                "financial"
              ]
            },
            "ruleChallengeVid": {
              "type": "string",
              "description": "bridges treasuryRulemaking.flagChallenge"
            },
            "filedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}