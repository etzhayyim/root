{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.webya.coverage",
  "defs": {
    "main": {
      "type": "query",
      "description": "webya actor の coverage 統計を返す。profession_kind × status サイト数、SSL pending 件数、生成キュー件数。",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "totalSites":      { "type": "integer" },
            "publishedSites":  { "type": "integer" },
            "generatingSites": { "type": "integer" },
            "sslPending":      { "type": "integer" },
            "generationQueue": { "type": "integer" },
            "byProfession": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "professionKind": { "type": "string" },
                  "status":         { "type": "string" },
                  "siteCount":      { "type": "integer" }
                }
              }
            }
          }
        }
      }
    }
  }
}
