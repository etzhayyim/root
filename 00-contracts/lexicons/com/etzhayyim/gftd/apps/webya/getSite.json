{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.webya.getSite",
  "defs": {
    "main": {
      "type": "query",
      "description": "サイトの状態・ページ一覧・ドメイン情報を取得する。",
      "parameters": {
        "type": "params",
        "required": ["siteId"],
        "properties": {
          "siteId": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "site"],
          "properties": {
            "ok": { "type": "boolean" },
            "site": {
              "type": "object",
              "properties": {
                "siteId":       { "type": "string" },
                "siteName":     { "type": "string" },
                "professionKind":{ "type": "string" },
                "status":       { "type": "string" },
                "subdomain":    { "type": "string" },
                "customDomain": { "type": "string" },
                "sslStatus":    { "type": "string" },
                "publishedAt":  { "type": "string" },
                "pages": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "slug":   { "type": "string" },
                      "title":  { "type": "string" },
                      "status": { "type": "string" }
                    }
                  }
                },
                "latestJobId":     { "type": "string" },
                "latestJobStatus": { "type": "string" }
              }
            },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
