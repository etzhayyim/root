{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.apps.getAppListing",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a single app listing by listingId or appDid.",
      "parameters": { "type": "params", "properties": { "listingId": { "type": "string" }, "appDid": { "type": "string" } } },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "listing": { "type": "object" } } } }
    }
  }
}
