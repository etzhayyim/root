{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.crossBorderTransfer.recordTransferMechanism",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Cross-border data transfer mechanism (SCC / BCR / adequacy decision — bridges dataLocalization.flagFragmentation + data-adequacy + cross-border-data)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "mechanismId",
            "senderCountryIso3",
            "receiverCountryIso3",
            "mechanismKind",
            "effectiveAt"
          ],
          "properties": {
            "mechanismId": {
              "type": "string"
            },
            "senderCountryIso3": {
              "type": "string"
            },
            "receiverCountryIso3": {
              "type": "string"
            },
            "mechanismKind": {
              "type": "string",
              "enum": [
                "adequacy_eu",
                "scc_2021",
                "bcr",
                "codes_of_conduct",
                "certification",
                "tia_transfer_impact",
                "derogation",
                "strictly_necessary",
                "schrems_ii_remedies",
                "local_safeguard",
                "apec_cbpr",
                "global_cbpr",
                "prc_outbound_assessment",
                "india_dpdpa"
              ]
            },
            "fragmentationVid": {
              "type": "string",
              "description": "bridges dataLocalization.flagFragmentation"
            },
            "effectiveAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}