{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.oilShipping.listTankers",
  "defs": {
    "main": {
      "type": "query",
      "description": "List tankers with optional class/flag/dark-fleet filter.",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "properties": {
          "tankerClass": { "type": "string" },
          "flagState": { "type": "string" },
          "operatorDid": { "type": "string", "format": "did" },
          "darkFleetSuspect": { "type": "boolean" },
          "sanctionsScreening": { "type": "string", "enum": ["clear", "flagged", "blocked"] },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "required": ["tankers", "total", "offset", "limit"], "properties": { "tankers": { "type": "array", "items": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "imo": { "type": "string" }, "name": { "type": "string" }, "tankerClass": { "type": "string" }, "flagState": { "type": "string" }, "darkFleetSuspect": { "type": "boolean" }, "sanctionsScreening": { "type": "string" } } } }, "total": { "type": "integer" }, "offset": { "type": "integer" }, "limit": { "type": "integer" } } } }
    }
  }
}
