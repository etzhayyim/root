{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.supplyChainFinance.issueLetterOfCredit",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "L/C issuance (banking+swift+customs+carrier bridge)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "lcId",
            "lcType",
            "amountUsd",
            "expiryDate"
          ],
          "properties": {
            "lcId": {
              "type": "string"
            },
            "bankingAccountVid": {
              "type": "string",
              "description": "bridges open-banking"
            },
            "swiftUetr": {
              "type": "string",
              "description": "bridges open-swift"
            },
            "carrierFleetVid": {
              "type": "string",
              "description": "bridges open-carrier-fleet (vessel IMO)"
            },
            "customsClearanceVid": {
              "type": "string",
              "description": "bridges open-customs-clearance"
            },
            "lcType": {
              "type": "string",
              "enum": [
                "sight",
                "usance",
                "standby"
              ]
            },
            "amountUsd": {
              "type": "number"
            },
            "buyerLei": {
              "type": "string"
            },
            "sellerLei": {
              "type": "string"
            },
            "expiryDate": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "amountTier": {
              "type": "string",
              "enum": [
                "jumbo",
                "large",
                "standard"
              ]
            }
          }
        }
      }
    }
  }
}