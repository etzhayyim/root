{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openDenki.listReadings",
  "defs": {
    "main": {
      "type": "query",
      "description": "List meter readings for a smart meter. meterDid is required.",
      "parameters": {
        "type": "params",
        "properties": {
          "meterDid": { "type": "string" },
          "since":    { "type": "string", "format": "datetime" },
          "limit":    { "type": "integer", "minimum": 1, "maximum": 500 },
          "offset":   { "type": "integer", "minimum": 0 }
        },
        "required": ["meterDid"]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["readings","total","offset","limit"],
          "properties": {
            "readings": { "type": "array", "items": { "type": "object" } },
            "total":    { "type": "integer" },
            "offset":   { "type": "integer" },
            "limit":    { "type": "integer" }
          }
        }
      }
    }
  }
}
