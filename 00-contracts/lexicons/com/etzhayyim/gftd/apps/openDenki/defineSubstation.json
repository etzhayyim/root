{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openDenki.defineSubstation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Declare an HV/MV/LV transformer substation node. Returns a path-based DID.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["subCode", "name", "voltageKv", "operatorDid"],
          "properties": {
            "subCode":     { "type": "string", "description": "Unique code (A-Z0-9-, 2..32)" },
            "name":        { "type": "string" },
            "voltageKv":   { "type": "number", "description": "Nominal voltage in kV" },
            "operatorDid": { "type": "string", "description": "DID of operating entity" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "subDid":      { "type": "string" },
            "subCode":     { "type": "string" },
            "name":        { "type": "string" },
            "voltageKv":   { "type": "number" },
            "operatorDid": { "type": "string" },
            "definedAt":   { "type": "string", "format": "datetime" },
            "error":       { "type": "string" }
          }
        }
      }
    }
  }
}
