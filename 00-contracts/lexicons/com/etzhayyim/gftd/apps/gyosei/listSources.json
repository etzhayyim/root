{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.gyosei.listSources",
  "defs": {
    "main": {
      "type": "query",
      "description": "List official legal and agency guidance sources available for gyosei review and precedent memo workflows.",
      "parameters": {
        "type": "params",
        "properties": {
          "category": { "type": "string" },
          "status": { "type": "string" },
          "limit": { "type": "integer" }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sourceId": { "type": "string" },
                  "title": { "type": "string" },
                  "issuer": { "type": "string" },
                  "category": { "type": "string" },
                  "sourceDate": { "type": "string", "format": "date" },
                  "capturedAt": { "type": "string", "format": "datetime" },
                  "status": { "type": "string" }
                }
              }
            },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
