{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.gyosei.requestHearing",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Request hearing / statement opportunity before an adverse administrative disposition.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "caseId": { "type": "string" },
            "hearingRequested": { "type": "boolean" },
            "statementSummary": { "type": "string" }
          },
          "required": ["caseId", "hearingRequested"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "scheduledAt": { "type": "string", "format": "datetime" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
