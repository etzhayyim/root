{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.malaccaCargo.recordContainerFlow",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "コンテナ TEU 記録",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flowId",
            "terminalCode",
            "imo",
            "teuIn",
            "teuOut",
            "callDate"
          ],
          "properties": {
            "flowId": {
              "type": "string"
            },
            "terminalCode": {
              "type": "string",
              "description": "PSA-PPT (Pasir Panjang), PSA-TPS (Tuas), PTP (Port of Tanjung Pelepas)"
            },
            "imo": {
              "type": "string"
            },
            "teuIn": {
              "type": "integer"
            },
            "teuOut": {
              "type": "integer"
            },
            "callDate": {
              "type": "string",
              "format": "date"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
