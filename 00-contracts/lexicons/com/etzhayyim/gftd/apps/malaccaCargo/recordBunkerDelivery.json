{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.malaccaCargo.recordBunkerDelivery",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Bunker 給油",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "deliveryId",
            "imo",
            "bunkerType",
            "volumeTonnes",
            "deliveredAt"
          ],
          "properties": {
            "deliveryId": {
              "type": "string"
            },
            "imo": {
              "type": "string"
            },
            "bunkerType": {
              "type": "string",
              "enum": [
                "vlsfo",
                "hsfo",
                "mgo",
                "lng",
                "methanol",
                "biofuel"
              ]
            },
            "volumeTonnes": {
              "type": "number"
            },
            "priceUsdTonne": {
              "type": "number"
            },
            "supplier": {
              "type": "string"
            },
            "deliveredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
