{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.agriFoodSecurity.flagPriceCrisis",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "FAO Food Price Index crisis flag (trade-finance-factoring / commodity-trade bridge)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "crisisId",
            "indexValue",
            "flaggedAt"
          ],
          "properties": {
            "crisisId": {
              "type": "string"
            },
            "harvestVid": {
              "type": "string",
              "description": "bridges recordHarvest"
            },
            "commodityTradeVid": {
              "type": "string",
              "description": "bridges open-commodity-trade"
            },
            "indexValue": {
              "type": "number",
              "description": "FAO FPI 2014-2016=100"
            },
            "yoyChangePct": {
              "type": "number"
            },
            "driver": {
              "type": "string",
              "enum": [
                "drought",
                "war",
                "export_ban",
                "currency",
                "pandemic",
                "locust",
                "flood"
              ]
            },
            "flaggedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "normal",
                "elevated",
                "severe"
              ]
            }
          }
        }
      }
    }
  }
}