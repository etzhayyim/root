{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.auditFirmOversight.flagDeficiency",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Audit deficiency / restatement / violation (bridges spsStandardIso.flagCertificationSleight + enforcementAction + securities-investor)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "inspectionVid",
            "deficiencyKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "inspectionVid": {
              "type": "string",
              "description": "bridges recordInspection"
            },
            "deficiencyKind": {
              "type": "string",
              "enum": [
                "engagement_partner_independence",
                "icfr_gap",
                "critical_matters_not_addressed",
                "audit_trail_lost",
                "evidence_insufficient",
                "scope_limitation",
                "opinion_shopping",
                "rotation_violation",
                "non_audit_service",
                "overseas_referral_weak",
                "client_pressure"
              ]
            },
            "restatementRequired": {
              "type": "boolean"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}