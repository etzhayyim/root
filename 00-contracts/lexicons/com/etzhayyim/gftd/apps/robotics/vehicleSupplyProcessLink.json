{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.robotics.vehicle.supply.process.link",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Connect automotive material procurement, processing, intermediate manufacturing, responsible parties, legal entities, people/craft workers, and patent evidence into the vehicle manufacturing package graph.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["packageId", "links"],
          "properties": {
            "requestId": { "type": "string" },
            "packageId": { "type": "string" },
            "vehicleProgram": { "type": "string" },
            "links": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "linkKind": {
                    "type": "string",
                    "enum": [
                      "package_requires_material",
                      "material_supplied_by_legal_entity",
                      "process_uses_material",
                      "process_produces_intermediate",
                      "intermediate_feeds_process",
                      "responsible_party",
                      "process_performed_by_person",
                      "package_references_patent"
                    ]
                  },
                  "srcVid": { "type": "string" },
                  "dstVid": { "type": "string" },
                  "materialId": { "type": "string" },
                  "processId": { "type": "string" },
                  "intermediateId": { "type": "string" },
                  "lei": { "type": "string" },
                  "personVid": { "type": "string" },
                  "patentPubNumber": { "type": "string" },
                  "role": { "type": "string" },
                  "evidenceUrl": { "type": "string" }
                }
              }
            },
            "dryRun": { "type": "boolean" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "dryRun": { "type": "boolean" },
            "createdEdgeCount": { "type": "integer" },
            "blockedLinks": { "type": "array", "items": { "type": "string" } },
            "auditRefs": { "type": "array", "items": { "type": "string" } },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
