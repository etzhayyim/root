{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.robotics.workflow.plan",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Design a BPMN-based robotics workflow across sales, engineering, manufacturing, quality, warehouse, transport, service, and finance.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "requestId": { "type": "string" },
            "processes": { "type": "array", "items": { "type": "string" } },
            "assetKind": { "type": "string" },
            "customerId": { "type": "string" },
            "itemOrService": { "type": "string" },
            "quantity": { "type": "number" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "roboticsWorkflowPlan": { "type": "unknown" },
            "roboticsKamiScene": { "type": "unknown" },
            "dependencies": { "type": "array", "items": { "type": "unknown" } },
            "missingPrerequisites": { "type": "array", "items": { "type": "unknown" } }
          }
        }
      }
    }
  }
}
