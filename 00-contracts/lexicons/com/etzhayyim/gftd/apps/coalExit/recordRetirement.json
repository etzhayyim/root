{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.coalExit.recordRetirement",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Coal plant retirement / JETP milestone (bridges exportCreditAgency.flagClimateCarveout + just-transition + power-node)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "retirementId",
            "countryIso3",
            "capacityMw",
            "coalType",
            "mechanism",
            "retiredAt"
          ],
          "properties": {
            "retirementId": {
              "type": "string"
            },
            "plantOperatorLei": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "capacityMw": {
              "type": "number"
            },
            "coalType": {
              "type": "string",
              "enum": [
                "lignite",
                "bituminous",
                "subbituminous",
                "anthracite",
                "peat"
              ]
            },
            "mechanism": {
              "type": "string",
              "enum": [
                "jetp",
                "ctap",
                "pepi",
                "direct_close",
                "repower_gas",
                "repower_renewable",
                "bankruptcy",
                "economic",
                "end_of_life",
                "early_retire_fund"
              ]
            },
            "climateCarveoutVid": {
              "type": "string",
              "description": "bridges exportCreditAgency.flagClimateCarveout"
            },
            "retiredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}