{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.digitalPublicGoods.certifyStandard",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "DPGA / GovStack / DIAL DPG certification (bridges digital-accessibility + ai-governance + digital-identity)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "certificationId",
            "productName",
            "dpgIndicator",
            "category",
            "certifiedAt"
          ],
          "properties": {
            "certificationId": {
              "type": "string"
            },
            "productName": {
              "type": "string"
            },
            "stewardLei": {
              "type": "string"
            },
            "dpgIndicator": {
              "type": "string",
              "description": "comma: relevance,open_license,clear_ownership,platform_independence,documentation,non_pii,privacy_laws,standards_best_practices,do_no_harm"
            },
            "category": {
              "type": "string",
              "enum": [
                "open_software",
                "open_data",
                "open_ai_model",
                "open_content",
                "open_standard"
              ]
            },
            "licenseSpdx": {
              "type": "string"
            },
            "sdgAlignment": {
              "type": "string",
              "description": "comma: SDG1..SDG17"
            },
            "certifiedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}