{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.agent.evaluateViability",
  "defs": {
    "main": {
      "type": "query",
      "description": "Evaluate current homeostasis into normal, conserve, repair, hibernate, or halted.",
      "parameters": {
        "type": "params",
        "required": ["agentDid"],
        "properties": {
          "agentDid": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "viabilityState": { "type": "string" },
            "blockers": { "type": "array", "items": { "type": "string" } },
            "nextActions": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
