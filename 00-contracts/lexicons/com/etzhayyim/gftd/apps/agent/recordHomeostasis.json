{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.agent.recordHomeostasis",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record agent homeostasis and viability state.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["agentDid"],
          "properties": {
            "agentDid": { "type": "string" },
            "computeBudgetRemaining": { "type": "number" },
            "storagePressure": { "type": "number" },
            "leaseSecondsRemaining": { "type": "integer" },
            "errorRate1h": { "type": "number" },
            "toolSuccessRate1h": { "type": "number" },
            "energyOrCostProxy": { "type": "number" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "homeostasis": { "type": "unknown" }
          }
        }
      }
    }
  }
}
