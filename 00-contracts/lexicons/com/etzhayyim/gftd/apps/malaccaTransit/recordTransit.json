{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.malaccaTransit.recordTransit",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "マラッカ VTS gate 通過",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "imo",
            "vtsGate",
            "direction",
            "observedAt"
          ],
          "properties": {
            "imo": {
              "type": "string"
            },
            "vesselName": {
              "type": "string"
            },
            "flag": {
              "type": "string"
            },
            "vtsGate": {
              "type": "string",
              "enum": [
                "one-fathom",
                "port-dickson",
                "klang",
                "singapore-strait",
                "horsburgh"
              ]
            },
            "direction": {
              "type": "string",
              "enum": [
                "eastbound",
                "westbound"
              ]
            },
            "lat": {
              "type": "number"
            },
            "lon": {
              "type": "number"
            },
            "sogKnots": {
              "type": "number"
            },
            "cargoType": {
              "type": "string"
            },
            "laden": {
              "type": "boolean"
            },
            "observedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
