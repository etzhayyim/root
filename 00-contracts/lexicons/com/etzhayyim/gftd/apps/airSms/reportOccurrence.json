{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airSms.reportOccurrence",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Report a safety occurrence for a flight.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["occurrence_type", "tail_number", "description"],
          "properties": {
            "occurrence_type": { "type": "string" },
            "tail_number": { "type": "string" },
            "flight_no": { "type": "string" },
            "dep_date": { "type": "string" },
            "description": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
