{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.aquacultureCert.recordCertification",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ASC / BAP / GlobalG.A.P. aquaculture certification (bridges spsNotification.flagComment + seafood-traceability + fisheries-iuu)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "certId",
            "schemeKind",
            "speciesGroup",
            "countryIso3",
            "certifiedAt"
          ],
          "properties": {
            "certId": {
              "type": "string"
            },
            "facilityLei": {
              "type": "string"
            },
            "schemeKind": {
              "type": "string",
              "enum": [
                "asc",
                "bap_4star",
                "bap_3star",
                "bap_2star",
                "globalgap",
                "naturland",
                "label_rouge",
                "best_seafood",
                "fos_friend_sea"
              ]
            },
            "speciesGroup": {
              "type": "string",
              "enum": [
                "salmon",
                "shrimp",
                "tilapia",
                "pangasius",
                "seabass",
                "sea_bream",
                "oyster",
                "mussel",
                "abalone",
                "carp",
                "trout",
                "seaweed"
              ]
            },
            "countryIso3": {
              "type": "string"
            },
            "productionTonnesYearly": {
              "type": "number"
            },
            "spsCommentVid": {
              "type": "string",
              "description": "bridges spsNotification.flagComment"
            },
            "certifiedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}