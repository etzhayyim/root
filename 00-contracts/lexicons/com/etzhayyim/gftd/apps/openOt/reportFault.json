{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openOt.reportFault",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Report an OT fault. Severity is DMN-evaluated (1 = info, 2 = warning, 3 = alarm, 4 = critical). May link to an open-denki CIM fault for cross-domain correlation.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["faultCode", "severity", "detectedAt", "message"],
          "properties": {
            "deviceDid":    { "type": "string" },
            "loopDid":      { "type": "string" },
            "cellDid":      { "type": "string" },
            "signalDid":    { "type": "string" },
            "faultCode":    { "type": "string" },
            "severity":     { "type": "integer", "minimum": 1, "maximum": 4 },
            "detectedAt":   { "type": "string", "format": "datetime" },
            "message":      { "type": "string" },
            "dmnInputsJson":{ "type": "string", "description": "Opaque JSON of DMN evaluation inputs for audit" },
            "cimFaultDid":  { "type": "string", "description": "Optional cross-link to com.etzhayyim.apps.openDenki.reportFault record" },
            "publicNotice": { "type": "boolean", "default": false }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "faultDid":   { "type": "string" },
            "severity":   { "type": "integer" },
            "reportedAt": { "type": "string", "format": "datetime" },
            "error":      { "type": "string" }
          }
        }
      }
    }
  }
}
