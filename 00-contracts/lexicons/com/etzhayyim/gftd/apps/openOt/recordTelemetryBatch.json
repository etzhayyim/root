{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openOt.recordTelemetryBatch",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Pod-side ingest from a Zenoh aggregator. Telemetry is NOT atproto records — it is bulk-INSERTed into vertex_open_ot_reading via SQLAlchemy on the LangServer pod. Bulk ingest uses SET dml_rate_limit per CLAUDE.md rw-bulk-insert-throttle.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["aggregatorDid", "samples"],
          "properties": {
            "aggregatorDid": { "type": "string", "description": "DID of the Zenoh aggregator pod that produced this batch" },
            "batchSeq":      { "type": "integer", "minimum": 0, "description": "Monotonic batch sequence per aggregator (gap detection)" },
            "samples":       { "type": "array", "items": { "type": "ref", "ref": "#sample" }, "minLength": 1, "maxLength": 10000 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "receivedCount":  { "type": "integer" },
            "persistedCount": { "type": "integer" },
            "rejectedCount":  { "type": "integer" },
            "ingestedAt":     { "type": "string", "format": "datetime" },
            "error":          { "type": "string" }
          }
        }
      }
    },
    "sample": {
      "type": "object",
      "required": ["signalDid", "ts", "valueMicroUnit", "quality"],
      "properties": {
        "signalDid":      { "type": "string" },
        "ts":             { "type": "string", "format": "datetime" },
        "valueMicroUnit": { "type": "integer", "description": "Reading value in micro-units (1e-6) of the signal's unitCode" },
        "quality":        { "type": "string", "enum": ["good", "uncertain", "bad", "stale"] }
      }
    }
  }
}
