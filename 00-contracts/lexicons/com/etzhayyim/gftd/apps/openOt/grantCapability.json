{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openOt.grantCapability",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Grant a host capability to a cell. Capabilities are capability-string-keyed (e.g. io:{signalDid}:read, peer:{cellDid}:msg, time:cycle, log:event).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["cellDid", "capability", "grantedByDid", "validFrom"],
          "properties": {
            "cellDid":      { "type": "string" },
            "capability":   { "type": "string", "description": "Capability string per SPEC §7" },
            "grantedByDid": { "type": "string" },
            "validFrom":    { "type": "string", "format": "datetime" },
            "validUntil":   { "type": "string", "format": "datetime", "description": "Optional expiry (omit for indefinite)" },
            "reason":       { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "grantDid":  { "type": "string" },
            "grantedAt": { "type": "string", "format": "datetime" },
            "error":     { "type": "string" }
          }
        }
      }
    }
  }
}
