{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openOt.listFaults",
  "defs": {
    "main": {
      "type": "query",
      "description": "List faults filtered by device, loop, time window, or minimum severity.",
      "parameters": {
        "type": "params",
        "properties": {
          "deviceDid":   { "type": "string" },
          "loopDid":     { "type": "string" },
          "since":       { "type": "string", "format": "datetime" },
          "minSeverity": { "type": "integer", "minimum": 1, "maximum": 4 },
          "openOnly":    { "type": "boolean", "default": false },
          "limit":       { "type": "integer", "minimum": 1, "maximum": 500 },
          "offset":      { "type": "integer", "minimum": 0 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["faults", "total", "offset", "limit"],
          "properties": {
            "faults": { "type": "array", "items": { "type": "ref", "ref": "#faultRow" } },
            "total":  { "type": "integer" },
            "offset": { "type": "integer" },
            "limit":  { "type": "integer" }
          }
        }
      }
    },
    "faultRow": {
      "type": "object",
      "required": ["faultDid", "faultCode", "severity", "detectedAt"],
      "properties": {
        "faultDid":    { "type": "string" },
        "deviceDid":   { "type": "string" },
        "loopDid":     { "type": "string" },
        "cellDid":     { "type": "string" },
        "signalDid":   { "type": "string" },
        "faultCode":   { "type": "string" },
        "severity":    { "type": "integer" },
        "detectedAt":  { "type": "string", "format": "datetime" },
        "resolvedAt":  { "type": "string", "format": "datetime" },
        "message":     { "type": "string" },
        "cimFaultDid": { "type": "string" }
      }
    }
  }
}
