{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openOt.getCell",
  "defs": {
    "main": {
      "type": "query",
      "description": "Fetch cell detail including pinned module, capability grants, current ECC state, and last super-step.",
      "parameters": {
        "type": "params",
        "required": ["cellDid"],
        "properties": {
          "cellDid": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "cellDid":             { "type": "string" },
            "cellCode":            { "type": "string" },
            "name":                { "type": "string" },
            "deviceDid":           { "type": "string" },
            "fbKind":              { "type": "string" },
            "iec61499Fbtype":      { "type": "string" },
            "modulePinDid":        { "type": "string" },
            "moduleCid":           { "type": "string" },
            "cyclePeriodMs":       { "type": "integer" },
            "deadlineMs":          { "type": "integer" },
            "safetyClass":         { "type": "string" },
            "currentEccState":     { "type": "string" },
            "lastSuperStep":       { "type": "integer" },
            "lastTickAt":          { "type": "string", "format": "datetime" },
            "capabilityGrants":    { "type": "array", "items": { "type": "string" } },
            "cohortLoopDids":      { "type": "array", "items": { "type": "string" } },
            "definedAt":           { "type": "string", "format": "datetime" },
            "error":               { "type": "string" }
          }
        }
      }
    }
  }
}
