{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openOt.listReadings",
  "defs": {
    "main": {
      "type": "query",
      "description": "List telemetry readings for a signal, ordered by ts descending. Backed by vertex_open_ot_reading; subject to dml_rate_limit on bulk historical queries.",
      "parameters": {
        "type": "params",
        "required": ["signalDid"],
        "properties": {
          "signalDid":  { "type": "string" },
          "since":      { "type": "string", "format": "datetime" },
          "until":      { "type": "string", "format": "datetime" },
          "minQuality": { "type": "string", "enum": ["good", "uncertain", "bad", "stale"] },
          "limit":      { "type": "integer", "minimum": 1, "maximum": 5000 },
          "offset":     { "type": "integer", "minimum": 0 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["readings", "total", "offset", "limit"],
          "properties": {
            "readings": { "type": "array", "items": { "type": "ref", "ref": "#readingRow" } },
            "total":    { "type": "integer" },
            "offset":   { "type": "integer" },
            "limit":    { "type": "integer" }
          }
        }
      }
    },
    "readingRow": {
      "type": "object",
      "required": ["signalDid", "ts", "valueMicroUnit", "quality"],
      "properties": {
        "signalDid":      { "type": "string" },
        "ts":             { "type": "string", "format": "datetime" },
        "valueMicroUnit": { "type": "integer" },
        "quality":        { "type": "string" },
        "aggregatorDid":  { "type": "string" }
      }
    }
  }
}
