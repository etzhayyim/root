{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openOt.defineDevice",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a physical OT device (RTU / actuator / edge controller). Returns a path-based DID.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["deviceCode", "name", "deviceClass", "operatorDid"],
          "properties": {
            "deviceCode":      { "type": "string", "description": "Unique uppercase alphanumeric code (A-Z0-9-, 2..32)" },
            "name":            { "type": "string" },
            "deviceClass":     { "type": "string", "enum": ["giemonMimi", "giemonTe", "giemonAtama", "thirdPartyRtu", "thirdPartyEdge", "other"] },
            "manufacturer":    { "type": "string" },
            "model":           { "type": "string" },
            "serialNumber":    { "type": "string" },
            "firmwareVersion": { "type": "string" },
            "locationCode":    { "type": "string", "description": "Site/cabinet/slot identifier" },
            "operatorDid":     { "type": "string", "description": "DID of operating entity" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "deviceDid":  { "type": "string" },
            "deviceCode": { "type": "string" },
            "definedAt":  { "type": "string", "format": "datetime" },
            "error":      { "type": "string" }
          }
        }
      }
    }
  }
}
