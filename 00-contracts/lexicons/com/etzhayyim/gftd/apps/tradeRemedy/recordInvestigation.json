{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.tradeRemedy.recordInvestigation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Antidumping (AD) / countervailing duty (CVD) / safeguard investigation (bridges wtoTradeCbam.flagDisputeEscalation + commodity-trade + ustr-section-301)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "investigationId",
            "initiatingCountryIso3",
            "subjectCountryIso3",
            "remedyKind",
            "productCategory",
            "initiatedAt"
          ],
          "properties": {
            "investigationId": {
              "type": "string"
            },
            "initiatingCountryIso3": {
              "type": "string"
            },
            "subjectCountryIso3": {
              "type": "string"
            },
            "remedyKind": {
              "type": "string",
              "enum": [
                "ad",
                "cvd",
                "safeguard",
                "circumvention",
                "sunset_review",
                "scope_ruling",
                "evasion",
                "article_xix",
                "special_china_sg",
                "public_interest"
              ]
            },
            "productCategory": {
              "type": "string",
              "enum": [
                "steel",
                "aluminium",
                "solar_module",
                "ev",
                "chemicals",
                "textile",
                "lumber",
                "agriculture",
                "semiconductor",
                "wind_turbine",
                "lithium_battery",
                "cap_factoring",
                "pharma_api",
                "glass",
                "seafood"
              ]
            },
            "disputeVid": {
              "type": "string",
              "description": "bridges wtoTradeCbam.flagDisputeEscalation"
            },
            "initiatedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}