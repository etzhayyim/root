{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.xrdXrf.identifyPhase",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Identify crystalline phase from XRD pattern or elemental composition from XRF. Auto-generated stub (coverage expansion 2026-04-17).",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["technique"],
          "properties": {
            "technique": { "type": "string", "enum": ["XRD", "XRF"] },
            "xrdPeaks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "twoTheta": { "type": "number" },
                  "intensity": { "type": "number" }
                }
              }
            },
            "xrfElements": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "element": { "type": "string" },
                  "weightPercent": { "type": "number" }
                }
              }
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "phases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "formula": { "type": "string" },
                  "score": { "type": "number" }
                }
              }
            }
          }
        }
      }
    }
  }
}
