{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airSched.publishSchedule",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Publish a carrier schedule for a season.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["carrier_code", "season", "effective_date"],
          "properties": {
            "carrier_code": { "type": "string" },
            "season": { "type": "string" },
            "effective_date": { "type": "string" },
            "end_date": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
