{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airSched.assignFleet",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Assign fleet (tail number and aircraft type) to a scheduled flight.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["flight_no", "dep_date", "tail_number"],
          "properties": {
            "flight_no": { "type": "string" },
            "dep_date": { "type": "string" },
            "tail_number": { "type": "string" },
            "aircraft_type": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
