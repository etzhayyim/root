{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airSched.allocateSlot",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Allocate an airport slot to a flight.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["slot_ref", "airport", "flight_no"],
          "properties": {
            "slot_ref": { "type": "string" },
            "airport": { "type": "string" },
            "flight_no": { "type": "string" },
            "allocated_time": { "type": "string" },
            "coordinator": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
