{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airSched.registerCodeshare",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a codeshare agreement between operating and marketing carriers.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["operating_carrier", "marketing_carrier", "operating_flight_no"],
          "properties": {
            "operating_carrier": { "type": "string" },
            "marketing_carrier": { "type": "string" },
            "operating_flight_no": { "type": "string" },
            "marketing_flight_no": { "type": "string" },
            "effective_date": { "type": "string" },
            "end_date": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
