{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.arcticNsr.recordCommercialViability",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Per-transit commercial viability vs alternate (Suez / Panama / Cape)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "viabilityId",
            "transitVid",
            "alternateRoute",
            "assessedAt"
          ],
          "properties": {
            "viabilityId": {
              "type": "string"
            },
            "transitVid": {
              "type": "string",
              "description": "bridges recordTransit"
            },
            "alternateRoute": {
              "type": "string",
              "enum": [
                "SUEZ",
                "PANAMA",
                "CAPE_HORN",
                "CAPE_GOOD_HOPE"
              ]
            },
            "alternateTransitVid": {
              "type": "string",
              "description": "bridges open-panama-transit / open-redsea-suez"
            },
            "nsrDistanceNm": {
              "type": "number"
            },
            "alternateDistanceNm": {
              "type": "number"
            },
            "nsrCostUsd": {
              "type": "number"
            },
            "alternateCostUsd": {
              "type": "number"
            },
            "savingsPct": {
              "type": "number"
            },
            "assessedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "viabilityTier": {
              "type": "string",
              "enum": [
                "uneconomic",
                "marginal",
                "strongly_favored"
              ]
            }
          }
        }
      }
    }
  }
}