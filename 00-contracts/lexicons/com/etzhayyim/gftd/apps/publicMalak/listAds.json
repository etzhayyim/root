{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.publicMalak.listAds",
  "defs": {
    "main": {
      "type": "query",
      "description": "List ad creatives observed by the scraper. Reads vertex_ads_creative joined with vertex_ads_advertiser. All fields are DSA-public data.",
      "parameters": {
        "type": "params",
        "properties": {
          "platform": { "type": "string", "knownValues": ["meta", "facebook", "instagram", "whatsapp", "google", "linkedin", "tiktok", "x", "line", "telegram"] },
          "advertiserVertexId": { "type": "string", "description": "vertex_ads_advertiser.vertex_id filter" },
          "country": { "type": "string", "description": "ISO 3166-1 alpha-2 delivery country filter" },
          "isPolitical": { "type": "boolean" },
          "isActive": { "type": "boolean" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 50 },
          "cursor": { "type": "string" }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ads": {
              "type": "array",
              "items": { "type": "ref", "ref": "#creativeView" }
            },
            "total": { "type": "integer" },
            "cursor": { "type": "string" }
          },
          "required": ["ads"]
        }
      }
    },
    "creativeView": {
      "type": "object",
      "required": ["vertexId", "platform", "platformAdId"],
      "properties": {
        "vertexId": { "type": "string" },
        "platform": { "type": "string" },
        "platformAdId": { "type": "string" },
        "advertiserVertexId": { "type": "string" },
        "advertiserName": { "type": "string" },
        "creativeType": { "type": "string", "knownValues": ["image", "video", "carousel", "text", "collection"] },
        "headline": { "type": "string" },
        "bodyText": { "type": "string" },
        "ctaText": { "type": "string" },
        "landingUrl": { "type": "string" },
        "displayUrl": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaCid": { "type": "string" },
        "thumbnailCid": { "type": "string" },
        "languages": { "type": "string" },
        "currency": { "type": "string" },
        "impressionsMin": { "type": "integer" },
        "impressionsMax": { "type": "integer" },
        "spendMinPermille": { "type": "integer", "description": "spend_min × 1000 (AT Lexicon has no float)" },
        "spendMaxPermille": { "type": "integer" },
        "reachMin": { "type": "integer" },
        "reachMax": { "type": "integer" },
        "isPolitical": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "adDeliveryStartDate": { "type": "string" },
        "adDeliveryStopDate": { "type": "string" },
        "firstSeenAt": { "type": "string" },
        "lastSeenAt": { "type": "string" },
        "sourceUrl": { "type": "string" }
      }
    }
  }
}
