{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.publicMalak.getAdvertiser",
  "defs": {
    "main": {
      "type": "query",
      "description": "Fetch one advertiser by platform + platformAdvertiserId, or by vertexId. Returns vertex_ads_advertiser columns plus optional GLEIF legal-entity linkage.",
      "parameters": {
        "type": "params",
        "properties": {
          "vertexId": { "type": "string" },
          "platform": { "type": "string", "knownValues": ["meta", "facebook", "instagram", "whatsapp", "google", "linkedin", "tiktok", "x", "line", "telegram"] },
          "platformAdvertiserId": { "type": "string" }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["advertiser"],
          "properties": {
            "advertiser": { "type": "ref", "ref": "#advertiserView" }
          }
        }
      }
    },
    "advertiserView": {
      "type": "object",
      "required": ["vertexId", "platform", "platformAdvertiserId"],
      "properties": {
        "vertexId": { "type": "string" },
        "platform": { "type": "string" },
        "platformAdvertiserId": { "type": "string" },
        "name": { "type": "string" },
        "verifiedName": { "type": "string" },
        "legalName": { "type": "string" },
        "pageUrl": { "type": "string" },
        "pageCategory": { "type": "string" },
        "country": { "type": "string" },
        "fundingEntity": { "type": "string" },
        "isPolitical": { "type": "boolean" },
        "legalEntityDid": { "type": "string" },
        "firstSeenAt": { "type": "string" },
        "lastSeenAt": { "type": "string" }
      }
    }
  }
}
