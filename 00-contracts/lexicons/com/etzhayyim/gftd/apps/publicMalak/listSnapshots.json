{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.publicMalak.listSnapshots",
  "defs": {
    "main": {
      "type": "query",
      "description": "List append-only scraper snapshots for a given creative. Each snapshot captures the ad's state at scrape time plus CIDs for archived HTML / screenshot / HAR in B2.",
      "parameters": {
        "type": "params",
        "properties": {
          "creativeVertexId": { "type": "string" },
          "platform": { "type": "string", "knownValues": ["meta", "facebook", "instagram", "whatsapp", "google", "linkedin", "tiktok", "x", "line", "telegram"] },
          "platformAdId": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 50 },
          "cursor": { "type": "string" }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["snapshots"],
          "properties": {
            "snapshots": {
              "type": "array",
              "items": { "type": "ref", "ref": "#snapshotView" }
            },
            "cursor": { "type": "string" }
          }
        }
      }
    },
    "snapshotView": {
      "type": "object",
      "required": ["vertexId", "creativeVertexId", "scrapedAt"],
      "properties": {
        "vertexId": { "type": "string" },
        "creativeVertexId": { "type": "string" },
        "platform": { "type": "string" },
        "platformAdId": { "type": "string" },
        "scraper": { "type": "string" },
        "scraperRunId": { "type": "string" },
        "scrapedAt": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "httpStatus": { "type": "integer" },
        "htmlCid": { "type": "string" },
        "screenshotCid": { "type": "string" },
        "harCid": { "type": "string" },
        "observedIsActive": { "type": "boolean" },
        "observedImpressionsMin": { "type": "integer" },
        "observedImpressionsMax": { "type": "integer" },
        "observedSpendMinPermille": { "type": "integer" },
        "observedSpendMaxPermille": { "type": "integer" },
        "parserVersion": { "type": "string" },
        "parseOk": { "type": "boolean" },
        "parseError": { "type": "string" }
      }
    }
  }
}
