{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.publicMalak.analyzeAd",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Run public-malak intel analysis on one ad creative — competitive intelligence, adversarial campaign detection, claim extraction. Writes vertex_ads_analysis keyed by creativeVertexId.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["creativeVertexId"],
          "properties": {
            "creativeVertexId": { "type": "string" },
            "analysisKind": { "type": "string", "knownValues": ["competitive", "adversarial", "claim", "sentiment", "targeting"], "default": "competitive" },
            "modelId": { "type": "string", "description": "Optional override; defaults to MURAKUMO_DEFAULT_MODEL" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "error": { "type": "string" },
            "analysisVertexId": { "type": "string" },
            "creativeVertexId": { "type": "string" },
            "analysisKind": { "type": "string" },
            "status": { "type": "string", "knownValues": ["queued", "running", "completed", "failed"] },
            "summary": { "type": "string" },
            "riskScorePermille": { "type": "integer", "description": "0-1000 permille (AT Lexicon has no float)" }
          },
          "required": []
        }
      }
    }
  }
}
