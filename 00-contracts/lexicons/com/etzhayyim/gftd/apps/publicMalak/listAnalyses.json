{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.publicMalak.listAnalyses",
  "defs": {
    "main": {
      "type": "query",
      "description": "List public-malak intel analysis rows for observed ad creatives. Reads vertex_ads_analysis.",
      "parameters": {
        "type": "params",
        "properties": {
          "creativeVertexId": { "type": "string" },
          "platform": { "type": "string", "knownValues": ["meta", "facebook", "instagram", "whatsapp", "google", "linkedin", "tiktok", "x", "line", "telegram"] },
          "platformAdId": { "type": "string" },
          "analysisKind": { "type": "string", "knownValues": ["competitive", "adversarial", "claim", "sentiment", "targeting"] },
          "status": { "type": "string", "knownValues": ["queued", "running", "completed", "failed"] },
          "minRiskScorePermille": { "type": "integer", "minimum": 0, "maximum": 1000 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 50 },
          "cursor": { "type": "string" }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["analyses"],
          "properties": {
            "analyses": { "type": "array", "items": { "type": "ref", "ref": "#analysisView" } },
            "total": { "type": "integer" },
            "cursor": { "type": "string" }
          }
        }
      }
    },
    "analysisView": {
      "type": "object",
      "required": ["vertexId", "creativeVertexId", "analysisKind"],
      "properties": {
        "vertexId": { "type": "string" },
        "creativeVertexId": { "type": "string" },
        "platform": { "type": "string" },
        "platformAdId": { "type": "string" },
        "analysisKind": { "type": "string" },
        "modelId": { "type": "string" },
        "status": { "type": "string" },
        "summary": { "type": "string" },
        "riskScorePermille": { "type": "integer" },
        "claimJson": { "type": "string" },
        "targetingJson": { "type": "string" },
        "signalsJson": { "type": "string" },
        "sourceSnapshotId": { "type": "string" },
        "analyzedAt": { "type": "string" }
      }
    }
  }
}
