{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.usStateDept.flagInterAgencyConflict",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "State Dept inter-agency / DOD vs State / NSC override (bridges treasury-rulemaking + transnational-repression + civil-liability)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "actionVid",
            "conflictKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "actionVid": {
              "type": "string",
              "description": "bridges recordAction"
            },
            "conflictKind": {
              "type": "string",
              "enum": [
                "dod_vs_state",
                "cia_vs_state",
                "treasury_sanctions_vs_state",
                "nsc_override",
                "white_house_freelance",
                "staffer_diss",
                "ambassador_recall",
                "whistleblower_diss",
                "public_servant_diss_act",
                "witness_at_congress",
                "unauthorized_engagement"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}