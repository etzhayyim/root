{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.bunker.registerSupply",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a marine bunker fuel supply event (HFO/MGO/VLSFO/LNG). MARPOL Annex VI sulphur compliance tracking. Path-based DID: did:web:bunker.etzhayyim.com:supply:{slug}.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["vesselDid", "portDid", "fuelGrade", "tonnes", "deliveredAt"],
          "properties": {
            "vesselDid": { "type": "string", "format": "did" },
            "portDid": { "type": "string", "format": "did" },
            "supplierDid": { "type": "string", "format": "did", "description": "legal-entity DID" },
            "fuelGrade": { "type": "string", "enum": ["hfo-380", "hfo-180", "vlsfo", "ulsfo", "mgo-dmA", "mdo-dmB", "lng", "methanol", "ammonia", "biofuel-b30"] },
            "sulphurPct": { "type": "number", "description": "must be ≤0.50% outside SECA, ≤0.10% inside SECA per MARPOL Annex VI" },
            "tonnes": { "type": "number" },
            "deliveredAt": { "type": "string", "format": "datetime" },
            "bdnReference": { "type": "string", "description": "Bunker Delivery Note ref" },
            "secaZone": { "type": "boolean", "description": "delivered inside ECA/SECA" },
            "co2EmissionsTonnes": { "type": "number" }
          }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "uri": { "type": "string", "format": "at-uri" } } } }
    }
  }
}
