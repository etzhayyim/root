{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.bunker.listSupplies",
  "defs": {
    "main": {
      "type": "query",
      "description": "List bunker fuel supply events with optional vessel/port/grade filter.",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "properties": {
          "vesselDid": { "type": "string", "format": "did" },
          "portDid": { "type": "string", "format": "did" },
          "fuelGrade": { "type": "string" },
          "secaZone": { "type": "boolean" },
          "deliveredAfter": { "type": "string", "format": "datetime" },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "required": ["supplies", "total", "offset", "limit"], "properties": { "supplies": { "type": "array", "items": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "vesselDid": { "type": "string", "format": "did" }, "portDid": { "type": "string", "format": "did" }, "fuelGrade": { "type": "string" }, "tonnes": { "type": "number" }, "sulphurPct": { "type": "number" }, "deliveredAt": { "type": "string", "format": "datetime" } } } }, "total": { "type": "integer" }, "offset": { "type": "integer" }, "limit": { "type": "integer" } } } }
    }
  }
}
