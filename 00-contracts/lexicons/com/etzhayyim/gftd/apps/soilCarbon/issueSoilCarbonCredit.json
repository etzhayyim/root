{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.soilCarbon.issueSoilCarbonCredit",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Soil carbon credit issuance (Verra VM0042 / Gold Standard / ACCU)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "creditId",
            "stockVid",
            "methodologyCode",
            "deltaSocTonnesPerHa",
            "tonnesCo2e",
            "issuedAt"
          ],
          "properties": {
            "creditId": {
              "type": "string"
            },
            "stockVid": {
              "type": "string",
              "description": "bridges recordStock"
            },
            "carbonCreditVid": {
              "type": "string",
              "description": "bridges open-climate-carbon-market"
            },
            "methodologyCode": {
              "type": "string",
              "enum": [
                "VM0042",
                "VM0032",
                "CDM_AR",
                "GS_SOC",
                "ACCU_SCM",
                "MRV_CIF"
              ]
            },
            "deltaSocTonnesPerHa": {
              "type": "number"
            },
            "tonnesCo2e": {
              "type": "number"
            },
            "permanenceYears": {
              "type": "integer"
            },
            "issuedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}