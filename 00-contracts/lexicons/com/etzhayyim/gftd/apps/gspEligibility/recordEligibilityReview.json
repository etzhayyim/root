{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.gspEligibility.recordEligibilityReview",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "US/EU/UK GSP trade preference eligibility review (bridges tripsWaiver.flagRetaliationRisk + ustr-section-301 + wto-dispute)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "reviewId",
            "programKind",
            "beneficiaryCountryIso3",
            "reviewTrigger",
            "initiatedAt"
          ],
          "properties": {
            "reviewId": {
              "type": "string"
            },
            "programKind": {
              "type": "string",
              "enum": [
                "us_gsp",
                "eu_gsp_plus",
                "eu_ebe",
                "uk_dcts",
                "japan_gsp",
                "canada_gpt",
                "australia_dcs",
                "china_ldc"
              ]
            },
            "beneficiaryCountryIso3": {
              "type": "string"
            },
            "reviewTrigger": {
              "type": "string",
              "enum": [
                "petition",
                "self_initiated",
                "annual",
                "statutory_graduation",
                "labor_rights",
                "ip_protection",
                "market_access"
              ]
            },
            "retaliationVid": {
              "type": "string",
              "description": "bridges tripsWaiver.flagRetaliationRisk"
            },
            "initiatedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}