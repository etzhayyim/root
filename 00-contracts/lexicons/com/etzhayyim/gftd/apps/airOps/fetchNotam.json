{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airOps.fetchNotam",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Fetch NOTAMs for an airport.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["airport"],
          "properties": {
            "airport": { "type": "string" },
            "notam_type": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
