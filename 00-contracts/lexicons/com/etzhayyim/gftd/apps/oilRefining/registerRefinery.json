{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.oilRefining.registerRefinery",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register an oil refinery. Path-based DID: did:web:oil-refining.etzhayyim.com:refinery:{iso3}:{slug}. Tracks unit configuration, throughput, outage, product yield.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["name", "country", "capacityBopd"],
          "properties": {
            "name": { "type": "string" },
            "country": { "type": "string" },
            "operatorDid": { "type": "string", "format": "did" },
            "capacityBopd": { "type": "number", "description": "nameplate crude distillation capacity" },
            "complexity": { "type": "number", "description": "Nelson Complexity Index" },
            "units": { "type": "array", "items": { "type": "string", "enum": ["cdu", "vdu", "fcc", "hcu", "ckr", "alky", "isom", "ref", "hdt", "vrh"] } },
            "primaryFeedstock": { "type": "string", "enum": ["light-sweet", "medium", "heavy-sour", "extra-heavy", "condensate", "mixed"] },
            "operatingStatus": { "type": "string", "enum": ["operational", "turnaround", "outage", "mothballed", "decommissioned"] }
          }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "uri": { "type": "string", "format": "at-uri" } } } }
    }
  }
}
