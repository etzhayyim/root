{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.oilRefining.getRefinery",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a refinery by DID.",
      "x-bootstrap": true,
      "parameters": { "type": "params", "required": ["did"], "properties": { "did": { "type": "string", "format": "did" } } },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "name": { "type": "string" }, "country": { "type": "string" }, "operatorDid": { "type": "string", "format": "did" }, "capacityBopd": { "type": "number" }, "complexity": { "type": "number", "description": "Nelson Complexity Index" }, "units": { "type": "array", "items": { "type": "string" } }, "primaryFeedstock": { "type": "string" }, "operatingStatus": { "type": "string" } } } }
    }
  }
}
