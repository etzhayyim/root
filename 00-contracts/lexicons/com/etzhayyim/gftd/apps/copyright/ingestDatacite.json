{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.copyright.ingestDatacite",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Trigger a DataCite REST API ingest batch into vertex_work. Cursor-based pagination.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "pageSize": {"type": "integer", "default": 100, "minimum": 1, "maximum": 1000},
            "maxPages": {"type": "integer", "default": 5, "minimum": 1, "maximum": 50},
            "fromYear": {"type": "integer", "default": 2020}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "rowsIngested", "registry"],
          "properties": {
            "ok": {"type": "boolean"},
            "rowsIngested": {"type": "integer"},
            "nextCursor": {"type": "string"},
            "registry": {"type": "string"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
