{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openAirplane.reportIncident",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a safety incident on an aircraft. Severity classification: fatal/serious/minor based on injuries + category. Starts BPMN process open_airplane_report_incident.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "operatorOrgId": { "type": "string" },
            "aircraftVid":   { "type": "string" },
            "flightVid":     { "type": "string" },
            "category":      { "type": "string", "description": "ICAO category (runway-excursion, bird-strike, turbulence, ...)" },
            "narrative":     { "type": "string" },
            "injuries":      { "type": "integer" },
            "reportedAt":    { "type": "string", "format": "datetime" }
          },
          "required": ["operatorOrgId", "aircraftVid", "category", "injuries", "reportedAt"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok":                  { "type": "boolean" },
            "vertexId":            { "type": "string" },
            "severity":            { "type": "string", "enum": ["minor", "serious", "fatal"] },
            "requirePublicNotice": { "type": "boolean" },
            "instanceKey":         { "type": "integer" },
            "error":               { "type": "string" }
          }
        }
      }
    }
  }
}
