{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.news.ingest",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Request RSS ingestion. The heavy RSS pipeline runs in LangServer workers; this edge command returns the process contract.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "sourceId": {
              "type": "string"
            }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "movedToPOD-side LangServer": {
              "type": "boolean"
            },
            "processId": {
              "type": "string"
            },
            "taskTypes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "results": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ts": {
              "type": "string"
            }
          },
          "required": []
        }
      }
    }
  }
}
