{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.news.publishIntel",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Publish a prepared intel brief as an attributed news.etzhayyim.com writer DID post.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "title": { "type": "string" },
            "summary": { "type": "string" },
            "url": { "type": "string" },
            "sourceId": { "type": "string" },
            "writerDid": { "type": "string" },
            "socialPost": { "type": "string" }
          },
          "required": ["title", "url"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "published": { "type": "boolean" },
            "writerDid": { "type": "string" },
            "postText": { "type": "string" },
            "error": { "type": "string" }
          },
          "required": ["ok", "published"]
        }
      }
    }
  }
}
