{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.news.liveAudioScheduleState",
  "defs": {
    "main": {
      "type": "record",
      "description": "Scheduler state for a registered live audio source.",
      "key": "any",
      "record": {
        "type": "object",
        "properties": {
          "sourceId": { "type": "string" },
          "lastScheduledAt": { "type": "string", "format": "datetime" },
          "lastDispatchOk": { "type": "boolean" },
          "lastDispatchError": { "type": "string" },
          "lastInstanceKey": { "type": "string" },
          "consecutiveFailures": { "type": "integer", "minimum": 0 },
          "nextEligibleAt": { "type": "string", "format": "datetime" },
          "updatedAt": { "type": "string", "format": "datetime" }
        },
        "required": ["sourceId", "updatedAt"]
      }
    }
  }
}
