{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.news.scheduleLiveAudioIngest",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Scan registered live audio sources and dispatch due active sources to the live audio ingest BPMN process.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "sourceId": { "type": "string" },
            "region": { "type": "string" },
            "topic": { "type": "string" },
            "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
            "maxLaunches": { "type": "integer", "minimum": 1, "maximum": 25 },
            "dryRun": { "type": "boolean" },
            "force": { "type": "boolean" }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "checked": { "type": "integer" },
            "launched": { "type": "integer" },
            "skipped": { "type": "integer" },
            "policySummary": { "type": "object" },
            "items": { "type": "array", "items": { "type": "object" } },
            "error": { "type": "string" }
          },
          "required": ["ok"]
        }
      }
    }
  }
}
