{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.mbridgeSettlement.recordTransaction",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Project mBridge / Agora multi-CBDC settlement (bridges offshoreRmb.flagPolicyDivergence + digital-euro-brics + fx-swap-lines)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "transactionId",
            "participatingCbs",
            "currencyPair",
            "settlementKind",
            "settledAt"
          ],
          "properties": {
            "transactionId": {
              "type": "string"
            },
            "participatingCbs": {
              "type": "string"
            },
            "currencyPair": {
              "type": "string",
              "enum": [
                "cny_hkd",
                "cny_aed",
                "cny_thb",
                "hkd_thb",
                "aed_thb",
                "rmb_brl",
                "rmb_sar",
                "rmb_inr",
                "cny_rub",
                "cbdc_agora",
                "cbdc_onyx",
                "cbdc_cedar",
                "jade_singapore"
              ]
            },
            "settlementKind": {
              "type": "string",
              "enum": [
                "instant_atomic",
                "two_leg",
                "htlc",
                "intraday_liquidity_savings",
                "netting_pooled",
                "corridor_specific",
                "oil_settle_yuan",
                "trade_finance_bank_to_bank"
              ]
            },
            "policyDivergenceVid": {
              "type": "string",
              "description": "bridges offshoreRmb.flagPolicyDivergence"
            },
            "notionalBusd": {
              "type": "number"
            },
            "settledAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}