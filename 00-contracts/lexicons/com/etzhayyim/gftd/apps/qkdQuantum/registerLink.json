{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.qkdQuantum.registerLink",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Quantum key distribution link (ETSI QKD 014 / CEN CENELEC / IEEE P1913 — bridges quantum-safe-crypto + telecom-infra + cable-repair-fleet + space-traffic)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "linkId",
            "linkKind",
            "endpointACountryIso3",
            "endpointBCountryIso3",
            "commissionedAt"
          ],
          "properties": {
            "linkId": {
              "type": "string"
            },
            "operatorLei": {
              "type": "string"
            },
            "linkKind": {
              "type": "string",
              "enum": [
                "terrestrial_fiber",
                "free_space",
                "satellite_downlink",
                "satellite_interlink",
                "underwater_cable",
                "hybrid"
              ]
            },
            "endpointACountryIso3": {
              "type": "string"
            },
            "endpointBCountryIso3": {
              "type": "string"
            },
            "distanceKm": {
              "type": "number"
            },
            "qberEstimatePct": {
              "type": "number",
              "description": "Quantum Bit Error Rate"
            },
            "secureKeyRateKbps": {
              "type": "number"
            },
            "protocolFamily": {
              "type": "string",
              "enum": [
                "bb84",
                "e91",
                "mdi_qkd",
                "twin_field",
                "cv_qkd"
              ]
            },
            "commissionedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "robustnessTier": {
              "type": "string",
              "enum": [
                "experimental",
                "operational",
                "production"
              ]
            }
          }
        }
      }
    }
  }
}