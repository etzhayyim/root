{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.hatsubai.partnerAccount",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["partnerId", "platformCode", "legalEntityDid", "vettingStatus", "createdAt"],
        "properties": {
          "partnerId":          { "type": "string", "description": "Vendor-issued partner id (NDPP id / DevNet id / MS partner id / Steamworks partner id)." },
          "platformCode":       { "type": "string" },
          "legalEntityDid":     { "type": "string", "description": "DID for the contracting legal entity (vertex_legal_entity)." },
          "vettingStatus": {
            "type": "string",
            "description": "applied / nda_signed / vetted / approved / suspended / terminated.",
            "knownValues": ["applied", "nda_signed", "vetted", "approved", "suspended", "terminated"]
          },
          "ndaSignedAt":         { "type": "string", "format": "datetime" },
          "approvedAt":          { "type": "string", "format": "datetime" },
          "primaryContactEmail": { "type": "string" },
          "regionIso3166":       { "type": "string", "description": "ISO 3166-1 alpha-2 country code of the legal entity HQ." },
          "createdAt":           { "type": "string", "format": "datetime" },
          "updatedAt":           { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
