{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.completer.getAuditReport",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get the latest compliance audit report for an actor DID or a specific audit ID.",
      "parameters": {
        "type": "params",
        "properties": {
          "actor_did": { "type": "string" },
          "audit_id": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "audit": { "type": "object" },
            "findings": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    }
  }
}
