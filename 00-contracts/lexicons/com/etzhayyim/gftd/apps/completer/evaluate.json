{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.completer.evaluate",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Run compliance evaluation for a single actor DID and persist audit + findings.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["actor_did"],
          "properties": {
            "actor_did": { "type": "string" },
            "actor_name": { "type": "string" },
            "jurisdictions": { "type": "array", "items": { "type": "string" } },
            "sector_codes": { "type": "array", "items": { "type": "string" } },
            "org_id": { "type": "string" },
            "user_id": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "audit_id": { "type": "string" },
            "score": { "type": "integer" },
            "effect": { "type": "string" },
            "total_findings": { "type": "integer" }
          }
        }
      }
    }
  }
}
