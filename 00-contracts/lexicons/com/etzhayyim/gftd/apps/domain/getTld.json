{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.domain.getTld",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get full policy detail for a single TLD: operator, eligibility summary, full policy excerpt URL, accepted regulators, and supporting registrars.",
      "parameters": {
        "type": "params",
        "required": ["tld"],
        "properties": {
          "tld": {"type": "string", "description": "Including the dot, e.g. '.law'."}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["tld", "operator", "restricted", "registrars", "regulators"],
          "properties": {
            "tld": {"type": "string"},
            "operator": {"type": "string"},
            "restricted": {"type": "boolean"},
            "verificationRequired": {"type": "boolean"},
            "eligibilitySummary": {"type": "string"},
            "eligibilityPolicyUrl": {"type": "string"},
            "typicalUses": {"type": "string"},
            "notes": {"type": "string"},
            "registrars": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["slug", "name"],
                "properties": {
                  "slug": {"type": "string"},
                  "name": {"type": "string"},
                  "homepageUrl": {"type": "string"},
                  "handlesVerification": {"type": "boolean"},
                  "jpFriendly": {"type": "boolean"},
                  "notes": {"type": "string"}
                }
              }
            },
            "regulators": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["slug", "name", "jurisdiction"],
                "properties": {
                  "slug": {"type": "string"},
                  "name": {"type": "string"},
                  "jurisdiction": {"type": "string"},
                  "kind": {"type": "string"},
                  "publicRegisterUrl": {"type": "string"},
                  "basis": {"type": "string"}
                }
              }
            }
          }
        }
      }
    }
  }
}
