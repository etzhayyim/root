{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.securitiesInvestor.recordDisbursement",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "SEC Fair Fund / SIPC / investor recovery disbursement (bridges soxBounty.flagAwardDispute + enforcementAction + class-settlement)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "disbursementId",
            "fundKind",
            "underlyingCaseKind",
            "finalizedAt"
          ],
          "properties": {
            "disbursementId": {
              "type": "string"
            },
            "fundKind": {
              "type": "string",
              "enum": [
                "sec_fair_fund",
                "sec_disgorgement",
                "sipc",
                "fdic_receiver",
                "occ_restitution",
                "fca_redress",
                "bafin_investor",
                "jfsa_restitution",
                "mas_investor",
                "iosco_cross_border",
                "private_fund_compensation"
              ]
            },
            "underlyingCaseKind": {
              "type": "string",
              "enum": [
                "ponzi",
                "insider",
                "market_manip",
                "accounting_fraud",
                "misrepresentation",
                "unauthorized_trading",
                "fiduciary",
                "theft",
                "late_trading",
                "bitrate_trading",
                "cybersecurity_disclosure"
              ]
            },
            "awardDisputeVid": {
              "type": "string",
              "description": "bridges soxBounty.flagAwardDispute"
            },
            "payoutMusd": {
              "type": "number"
            },
            "finalizedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}