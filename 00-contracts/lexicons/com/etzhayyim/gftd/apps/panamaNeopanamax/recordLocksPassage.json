{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.panamaNeopanamax.recordLocksPassage",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Neopanamax 閘門通過",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "passageId",
            "imo",
            "locks",
            "vesselClass",
            "startedAt"
          ],
          "properties": {
            "passageId": {
              "type": "string"
            },
            "imo": {
              "type": "string"
            },
            "locks": {
              "type": "string",
              "enum": [
                "miraflores",
                "pedro-miguel",
                "gatun",
                "agua-clara",
                "cocoli"
              ]
            },
            "vesselClass": {
              "type": "string",
              "enum": [
                "panamax",
                "neopanamax",
                "post-panamax"
              ]
            },
            "beamMeters": {
              "type": "number"
            },
            "loaMeters": {
              "type": "number"
            },
            "startedAt": {
              "type": "string",
              "format": "datetime"
            },
            "completedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
