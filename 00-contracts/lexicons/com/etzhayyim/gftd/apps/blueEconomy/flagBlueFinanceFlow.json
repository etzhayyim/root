{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.blueEconomy.flagBlueFinanceFlow",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Blue bond / blue finance instrument (bridges sovereign-debt + climate-adaptation-finance + cat-bond-ils)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flowId",
            "instrument",
            "principalUsd",
            "issuedAt"
          ],
          "properties": {
            "flowId": {
              "type": "string"
            },
            "instrument": {
              "type": "string",
              "enum": [
                "blue_bond",
                "blue_loan",
                "blue_equity",
                "parametric_reef",
                "debt_for_ocean_swap"
              ]
            },
            "issuerLei": {
              "type": "string"
            },
            "principalUsd": {
              "type": "number"
            },
            "useOfProceeds": {
              "type": "string",
              "description": "comma: fisheries_sustainability,coastal_resilience,mpa_management,plastic_reduction,sustainable_shipping"
            },
            "sovereignIso3": {
              "type": "string"
            },
            "catBondVid": {
              "type": "string",
              "description": "bridges open-cat-bond-ils"
            },
            "issuedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}