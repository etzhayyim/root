{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.blueEconomy.recordSectorIndicator",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "OECD Blue Economy / SDG 14 indicator (bridges fisheries-iuu + coastal-slr + bbnj-highseas + maritime-piracy)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "indicatorId",
            "countryIso3",
            "sector",
            "metricName",
            "reportingYear",
            "reportedAt"
          ],
          "properties": {
            "indicatorId": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "sector": {
              "type": "string",
              "enum": [
                "fisheries",
                "aquaculture",
                "shipping",
                "tourism",
                "offshore_energy",
                "biotech",
                "seabed_mining",
                "coastal_protection"
              ]
            },
            "metricName": {
              "type": "string"
            },
            "valueNumeric": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            },
            "reportingYear": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}