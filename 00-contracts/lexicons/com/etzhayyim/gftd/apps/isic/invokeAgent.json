{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.isic.invokeAgent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Invoke a specific ISIC class agent by 4-digit class code. Dispatches to the lazy-loaded LangGraph Pregel agent at langgraph_graphs.isic_agents.c{classCode}.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["classCode", "payload"],
          "properties": {
            "classCode": {
              "type": "string",
              "description": "4-digit ISIC Rev. 4 class code.",
              "minLength": 4,
              "maxLength": 4
            },
            "payload": {
              "type": "object",
              "description": "Agent input state."
            },
            "modelHint": {
              "type": "string",
              "enum": ["haiku-4.5", "sonnet-4.6", "auto"],
              "default": "auto"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 25000,
              "default": 10000
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": {"type": "boolean"},
            "result": {"type": "object"},
            "modelUsed": {"type": "string"},
            "elapsedMs": {"type": "integer"},
            "error": {"type": "string"}
          }
        }
      },
      "errors": [
        {"name": "AgentNotFound"},
        {"name": "AgentLoadFailed"},
        {"name": "InvocationFailed"},
        {"name": "Timeout"}
      ]
    }
  }
}
