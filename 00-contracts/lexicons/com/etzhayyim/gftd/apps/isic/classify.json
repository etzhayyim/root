{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.isic.classify",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Classify an entity description into an ISIC Rev. 4 class. Single-level (leaf) result. Bulk path uses Haiku 4.5 with embedding pre-filter.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["description"],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "description": "Free-text description of an economic-activity entity."
            },
            "topK": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 5
            },
            "modelHint": {
              "type": "string",
              "enum": ["haiku-4.5", "sonnet-4.6", "auto"],
              "default": "auto"
            },
            "confidenceThreshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.7
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["candidates", "modelUsed", "elapsedMs"],
          "properties": {
            "candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["classCode", "confidence", "title"],
                "properties": {
                  "classCode": {
                    "type": "string",
                    "description": "4-digit ISIC Rev. 4 class code."
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "title": {"type": "string"},
                  "reasoning": {"type": "string"}
                }
              }
            },
            "modelUsed": {"type": "string"},
            "escalated": {"type": "boolean", "default": false},
            "elapsedMs": {"type": "integer"}
          }
        }
      },
      "errors": [
        {"name": "DescriptionEmpty"},
        {"name": "ModelUnavailable"},
        {"name": "RegistryNotReady"}
      ]
    }
  }
}
