{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.nmrSpec.predictShift",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Predict NMR chemical shifts (1H/13C/2D) from structure. Auto-generated stub (coverage expansion 2026-04-17).",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["smiles", "nucleus"],
          "properties": {
            "smiles": { "type": "string" },
            "nucleus": { "type": "string", "enum": ["1H", "13C", "31P", "19F"] },
            "solvent": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "shifts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "atomIndex": { "type": "integer" },
                  "ppm": { "type": "number" },
                  "multiplicity": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
