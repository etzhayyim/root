{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.outreach.addProspect",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a sales prospect. Email/title/company are Tier 3 PII (ADR-0018, sensitivity_ord=3). Cohort-first: cohortName is required for targeting.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["email", "cohortName"],
          "properties": {
            "email": { "type": "string", "format": "email", "description": "Prospect email (Tier 3 PII)" },
            "prospectName": { "type": "string", "maxLength": 200, "description": "Full name (Tier 3 PII)" },
            "title": { "type": "string", "maxLength": 200, "description": "Job title (Tier 3 PII)" },
            "company": { "type": "string", "maxLength": 200, "description": "Company name (Tier 3 PII)" },
            "cohortName": { "type": "string", "maxLength": 100, "description": "Cohort for targeting (required, ADR-0018)" },
            "linkedinUrl": { "type": "string", "maxLength": 500 },
            "companyWebsite": { "type": "string", "maxLength": 500 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["prospectId"],
          "properties": {
            "prospectId": { "type": "string" },
            "dnc": { "type": "boolean", "description": "true if prospect is on DNC list" }
          }
        }
      }
    }
  }
}
