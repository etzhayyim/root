{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.wtoTradeCbam.flagDisputeEscalation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Panel request / retaliation list / safeguard (bridges cbamEmbedded.flagLeakage + wto-dispute + ustr-section-301)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "stcVid",
            "escalationKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "stcVid": {
              "type": "string",
              "description": "bridges recordSpecificTradeConcern"
            },
            "escalationKind": {
              "type": "string",
              "enum": [
                "panel_request",
                "consultations",
                "authorized_retaliation",
                "suspension_concessions",
                "compliance_panel",
                "article_xxi_invocation",
                "interim_measures",
                "sanctions_secondary",
                "mpia_appeal",
                "review_22_6"
              ]
            },
            "affectedTradeBusd": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}