{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openRoad.reportIncident",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Report a road incident. FEEL severity: major (injuries >= 1 OR category=accident with closure OR delay >= 60min), moderate (delay 15-59min or construction), minor. Starts BPMN open_road_report_incident.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["authorityOrgId","roadVertexId","category","reportedAt"],
          "properties": {
            "authorityOrgId":      { "type": "string" },
            "roadVertexId":        { "type": "string" },
            "category":            { "type": "string", "enum": ["accident","closure","construction","weather","hazard","event"] },
            "narrative":           { "type": "string" },
            "injuries":            { "type": "integer" },
            "affectedLaneCount":   { "type": "integer" },
            "estimatedDelayMinutes":{ "type": "integer" },
            "reportedAt":          { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
            "severity": { "type": "string", "enum": ["minor","moderate","major"] },
            "requirePublicNotice": { "type": "boolean" },
            "instanceKey": { "type": "integer" }, "error": { "type": "string" }
          }
        }
      }
    }
  }
}
