{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.saikin.transferSignal",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Copy a signal horizontally to another actor's fixation space. Analogous to bacterial plasmid conjugation — source retains signal, target receives a copy via edge_saikin_transfer.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "signalId": { "type": "string", "description": "ID of the signal to transfer" },
            "targetActorDid": { "type": "string", "description": "DID of the target actor's fixation space" }
          },
          "required": ["signalId", "targetActorDid"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "transferId": { "type": "string" },
            "status": { "type": "string" },
            "error": { "type": "string" }
          },
          "required": ["transferId", "status"]
        }
      }
    }
  }
}
