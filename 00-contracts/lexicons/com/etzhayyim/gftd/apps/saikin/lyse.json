{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.saikin.lyse",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Decompose and release a fully-processed signal. Analogous to bacterial lysis — the signal's component assertions are released directly into the graph.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "signalId": { "type": "string", "description": "ID of the signal to lyse" },
            "reason": { "type": "string", "description": "Reason for lysis (e.g. fully-transferred, enriched, expired)" }
          },
          "required": ["signalId", "reason"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "lysed": { "type": "boolean" },
            "releasedAt": { "type": "string", "description": "ISO 8601 timestamp of lysis" },
            "error": { "type": "string" }
          },
          "required": ["lysed", "releasedAt"]
        }
      }
    }
  }
}
