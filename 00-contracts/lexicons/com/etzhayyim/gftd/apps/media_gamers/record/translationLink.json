{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.media_gamers.record.translationLink",
  "defs": {
    "main": {
      "type": "record",
      "description": "Social-layer linkage between an original AT post and one translated sibling AT post (one record per (sourceUri, lang) pair). yoro post detail uses this to render lang-switch tabs without breaking AT URI semantics. ADR-0034.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["sourceUri", "sourceLang", "translatedUri", "lang", "source", "createdAt"],
        "properties": {
          "sourceUri": {
            "type": "string",
            "format": "at-uri",
            "description": "Original (canonical) post URI: at://did/app.bsky.feed.post/{rkey}"
          },
          "sourceLang": {
            "type": "string",
            "description": "BCP-47 lang code of the original post"
          },
          "translatedUri": {
            "type": "string",
            "format": "at-uri",
            "description": "Translated sibling post URI"
          },
          "lang": {
            "type": "string",
            "description": "BCP-47 lang code of the translated post"
          },
          "source": {
            "type": "string",
            "enum": ["human", "llm-qwen3", "llm-other", "i18n-tm"],
            "description": "Provenance of the translation"
          },
          "qualityScore": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "default": 0,
            "description": "COMET back-translation score × 100 (0-100 integer). AT Protocol Lexicon has no float type; callers writing COMET floats must `Math.round(f * 100)`."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "org_id": { "type": "string", "default": "anon" },
          "user_id": { "type": "string", "default": "anon" },
          "actor_id": { "type": "string", "default": "" }
        }
      }
    }
  }
}
