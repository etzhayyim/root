{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.media_gamers.record.itemRecipe",
  "defs": {
    "main": {
      "type": "record",
      "description": "Crafting / cooking recipe that transforms input items into an output item.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["id", "slug", "game_slug", "output_item_id", "ingredients", "lang"],
        "properties": {
          "id": { "type": "string", "description": "Canonical recipe id, e.g. recipe:pokemon-pokopia:frying-pan-craft" },
          "slug": { "type": "string" },
          "game_slug": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "output_item_id": { "type": "string", "description": "FK to gameItem.id" },
          "output_quantity": { "type": "integer", "default": 1 },
          "ingredients": {
            "type": "array",
            "description": "Each entry is an ingredient ref.",
            "items": { "type": "ref", "ref": "#ingredient" }
          },
          "station": { "type": "string", "description": "Crafting station / tool required, e.g. frying-pan" },
          "unlock_condition": { "type": "string" },
          "lang": { "type": "string", "default": "en" },
          "sources": {
            "type": "array",
            "items": { "type": "string", "format": "uri" }
          },
          "org_id": { "type": "string", "default": "anon" },
          "user_id": { "type": "string", "default": "anon" },
          "actor_id": { "type": "string" },
          "created_at": { "type": "string", "format": "datetime" }
        }
      }
    },
    "ingredient": {
      "type": "object",
      "required": ["item_id", "quantity"],
      "properties": {
        "item_id": { "type": "string", "description": "FK to gameItem.id" },
        "quantity": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
