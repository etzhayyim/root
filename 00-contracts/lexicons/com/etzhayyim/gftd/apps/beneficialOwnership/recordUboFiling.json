{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.beneficialOwnership.recordUboFiling",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "UBO register filing (5AMLD / 6AMLD / US CTA / UK PSC — bridges debarmentList.flagPhoenixEntity + ofac-sanctions-sdn + lei-ownership)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "filingId",
            "registryKind",
            "filedAt"
          ],
          "properties": {
            "filingId": {
              "type": "string"
            },
            "legalEntityLei": {
              "type": "string"
            },
            "registryKind": {
              "type": "string",
              "enum": [
                "eu_5amld",
                "eu_6amld",
                "us_cta_fincen",
                "uk_psc",
                "ca_cbca",
                "au_dibo",
                "nz_bo_act",
                "sg_register",
                "hk_scr",
                "offshore_sos",
                "fatf_guidance"
              ]
            },
            "uboShareholdingPct": {
              "type": "number"
            },
            "uboJurisdictionIso3": {
              "type": "string"
            },
            "uboPepFlag": {
              "type": "boolean",
              "description": "PEP = politically exposed person"
            },
            "phoenixEntityVid": {
              "type": "string",
              "description": "bridges debarmentList.flagPhoenixEntity"
            },
            "filedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}