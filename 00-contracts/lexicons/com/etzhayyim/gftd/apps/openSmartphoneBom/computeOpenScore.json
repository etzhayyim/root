{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openSmartphoneBom.computeOpenScore",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Compute an LLM-assisted open-source score for a smartphone BOM",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["bomDid"],
          "properties": {
            "bomDid": { "type": "string", "format": "did" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["openScorePct", "keyClosedRisks", "recommendations"],
          "properties": {
            "openScorePct": { "type": "number", "description": "Open-source score 0-100" },
            "keyClosedRisks": { "type": "array", "items": { "type": "string" } },
            "recommendations": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
