{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.asiaRefinery.recordReceipt",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "アジア refinery crude 受入",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "receiptId",
            "refineryCode",
            "country",
            "imo",
            "crudeGrade",
            "volumeTonnes",
            "dischargedAt"
          ],
          "properties": {
            "receiptId": {
              "type": "string"
            },
            "refineryCode": {
              "type": "string",
              "description": "JPCHB (千葉), JPKAW (川崎), INJAM (Jamnagar), CNDAQ (大慶) 等"
            },
            "refineryName": {
              "type": "string"
            },
            "country": {
              "type": "string"
            },
            "imo": {
              "type": "string"
            },
            "vesselName": {
              "type": "string"
            },
            "manifestVid": {
              "type": "string",
              "description": "open-hormuz-cargo manifest ref"
            },
            "crudeGrade": {
              "type": "string"
            },
            "volumeTonnes": {
              "type": "number"
            },
            "dischargedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
