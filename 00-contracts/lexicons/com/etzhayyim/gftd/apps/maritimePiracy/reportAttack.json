{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maritimePiracy.reportAttack",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "IMB PRC / UKMTO / MSCHOA piracy report (bridges carrier-fleet + ofac-sanctions + forced-labor)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "attackId",
            "locationLat",
            "locationLon",
            "zone",
            "attackType",
            "reportedAt"
          ],
          "properties": {
            "attackId": {
              "type": "string"
            },
            "imo": {
              "type": "string",
              "description": "target vessel IMO"
            },
            "carrierFleetVid": {
              "type": "string",
              "description": "bridges open-carrier-fleet"
            },
            "locationLat": {
              "type": "number"
            },
            "locationLon": {
              "type": "number"
            },
            "zone": {
              "type": "string",
              "enum": [
                "GoA",
                "GoG",
                "Malacca",
                "SCS",
                "Caribbean",
                "Arabian_Sea",
                "Somali_Basin",
                "Nigeria_offshore"
              ]
            },
            "attackType": {
              "type": "string",
              "enum": [
                "boarding",
                "hijacking",
                "kidnap_for_ransom",
                "armed_robbery",
                "attempted",
                "suspicious_approach"
              ]
            },
            "weaponsUsed": {
              "type": "boolean"
            },
            "crewTaken": {
              "type": "integer"
            },
            "ransomUsd": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "threatTier": {
              "type": "string",
              "enum": [
                "moderate",
                "high",
                "critical"
              ]
            }
          }
        }
      }
    }
  }
}