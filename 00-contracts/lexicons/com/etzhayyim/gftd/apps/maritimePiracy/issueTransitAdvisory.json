{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maritimePiracy.issueTransitAdvisory",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "High-risk area transit advisory (JWC / Lloyd's / IBF)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "advisoryId",
            "zone",
            "issuer",
            "effectiveFrom"
          ],
          "properties": {
            "advisoryId": {
              "type": "string"
            },
            "attackVid": {
              "type": "string",
              "description": "bridges reportAttack"
            },
            "zone": {
              "type": "string"
            },
            "issuer": {
              "type": "string",
              "enum": [
                "JWC",
                "LLOYDS_JWC",
                "IBF",
                "UKMTO",
                "MSCHOA",
                "CMFATLANTA"
              ]
            },
            "warRiskPremiumPct": {
              "type": "number"
            },
            "recommendedTransit": {
              "type": "string",
              "enum": [
                "convoy",
                "day_only",
                "avoid",
                "standard_bmp"
              ]
            },
            "effectiveFrom": {
              "type": "string"
            },
            "effectiveUntil": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}