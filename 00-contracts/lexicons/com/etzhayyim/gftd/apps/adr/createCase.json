{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.adr.createCase",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create an ADR case (mediation/arbitration/conciliation). Sources: ICC + JCAA + AAA + UNCITRAL + national ADR centers.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["caseType", "jurisdiction", "filedAt"],
          "properties": {
            "caseType": { "type": "string", "enum": ["mediation", "arbitration", "conciliation", "expert-determination", "adjudication"] },
            "jurisdiction": { "type": "string", "description": "ISO 3166-1 alpha-3" },
            "filedAt": { "type": "string", "format": "datetime" },
            "institutionDid": { "type": "string", "format": "did", "description": "ICC/JCAA/AAA/SIAC/etc DID" },
            "claimantDids": { "type": "array", "items": { "type": "string", "format": "did" } },
            "respondentDids": { "type": "array", "items": { "type": "string", "format": "did" } },
            "subjectMatter": { "type": "string", "enum": ["commercial", "investment", "labor", "consumer", "family", "construction", "ip", "sports"] },
            "amountInDispute": { "type": "number" },
            "currency": { "type": "string" },
            "language": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did", "uri"],
          "properties": {
            "did": { "type": "string", "format": "did" },
            "uri": { "type": "string", "format": "at-uri" },
            "caseNumber": { "type": "string" }
          }
        }
      }
    }
  }
}
