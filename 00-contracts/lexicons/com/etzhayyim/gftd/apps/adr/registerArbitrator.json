{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.adr.registerArbitrator",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a mediator/arbitrator. Path-based DID: did:web:adr.etzhayyim.com:arb:{iso3}:{slug}.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["fullName", "role"],
          "properties": {
            "fullName": { "type": "string" },
            "role": { "type": "string", "enum": ["mediator", "arbitrator", "conciliator", "expert", "adjudicator"] },
            "institutionDid": { "type": "string", "format": "did" },
            "jurisdiction": { "type": "string" },
            "specializations": { "type": "array", "items": { "type": "string" } },
            "languages": { "type": "array", "items": { "type": "string" } },
            "appointedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did", "uri"],
          "properties": {
            "did": { "type": "string", "format": "did" },
            "uri": { "type": "string", "format": "at-uri" }
          }
        }
      }
    }
  }
}
