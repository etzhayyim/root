{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.tradeFinanceFactoring.recordRepayment",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Buyer repayment against factored invoice",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "repaymentId",
            "factoringVid",
            "amountUsd",
            "paidAt"
          ],
          "properties": {
            "repaymentId": {
              "type": "string"
            },
            "factoringVid": {
              "type": "string",
              "description": "bridges purchaseInvoice"
            },
            "amountUsd": {
              "type": "number"
            },
            "daysLate": {
              "type": "integer"
            },
            "paidAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "performanceTier": {
              "type": "string",
              "enum": [
                "on_time",
                "delayed",
                "default"
              ]
            }
          }
        }
      }
    }
  }
}