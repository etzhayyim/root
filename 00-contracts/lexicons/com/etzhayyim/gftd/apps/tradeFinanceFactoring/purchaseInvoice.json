{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.tradeFinanceFactoring.purchaseInvoice",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Invoice factoring (supply-chain-finance+customs+banking bridge)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "factoringId",
            "invoiceFaceValueUsd",
            "advanceRatePct",
            "tenorDays",
            "purchasedAt"
          ],
          "properties": {
            "factoringId": {
              "type": "string"
            },
            "lcVid": {
              "type": "string",
              "description": "bridges open-supply-chain-finance L/C"
            },
            "customsDeclarationVid": {
              "type": "string",
              "description": "bridges open-customs-clearance"
            },
            "bankingAccountVid": {
              "type": "string",
              "description": "bridges open-banking"
            },
            "swiftUetr": {
              "type": "string",
              "description": "bridges open-swift"
            },
            "invoiceFaceValueUsd": {
              "type": "number"
            },
            "advanceRatePct": {
              "type": "number"
            },
            "tenorDays": {
              "type": "integer"
            },
            "sellerLei": {
              "type": "string"
            },
            "buyerLei": {
              "type": "string"
            },
            "purchasedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "riskTier": {
              "type": "string",
              "enum": [
                "standard",
                "high_advance",
                "long_tail"
              ]
            }
          }
        }
      }
    }
  }
}