{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.animeka.scene",
  "defs": {
    "main": {
      "type": "record",
      "description": "Tier 2 domain record for a scene (シーン) within an episode. Auto-created by the `script-ready-scene-split` derive rule. On status=ready, the `scene-ready-storyboard` rule invokes the storyboarder actor to generate 3 cut-breakdown candidates.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["episodeRef", "sceneNum", "createdAt"],
        "properties": {
          "episodeRef": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "scriptRef": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef",
            "description": "Originating script record."
          },
          "sceneNum": {
            "type": "integer",
            "description": "Scene number within the episode (1-indexed)."
          },
          "headingJP": {
            "type": "string",
            "description": "Scene heading (e.g. 'S#12 / 夜 / 校舎屋上')."
          },
          "location": {
            "type": "string"
          },
          "timeOfDay": {
            "type": "string",
            "enum": ["dawn", "morning", "day", "evening", "night", "unspecified"]
          },
          "mood": {
            "type": "string",
            "description": "Emotional tone (tense / calm / heroic / melancholy ...). Used by bgArtist lighting design."
          },
          "charactersAppearing": {
            "type": "array",
            "items": {
              "type": "ref",
              "ref": "#characterAppearance"
            }
          },
          "estimatedDurationSec": {
            "type": "number"
          },
          "cutCount": {
            "type": "integer",
            "description": "Realized cut count (set after cut breakdown)."
          },
          "status": {
            "type": "string",
            "enum": ["draft", "ready", "storyboarding", "locked"],
            "description": "'ready' triggers storyboarder invocation."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    },
    "characterAppearance": {
      "type": "object",
      "required": ["slug"],
      "properties": {
        "slug": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" }
      }
    }
  }
}
