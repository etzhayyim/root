{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.animeka.generateKeyframe",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Stage 5/12 — Generate a single anime keyframe (Animagine XL + ControlNet-pose + IPAdapter character ref). Caller fanouts per key pose. Backed by BPMN animeka_generate_keyframe (ADR-2604231328).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["cutId", "layoutUri", "frameNum", "poseDescription"],
          "properties": {
            "cutId": { "type": "string" },
            "layoutUri": { "type": "string", "format": "at-uri" },
            "frameNum": { "type": "integer" },
            "poseDescription": { "type": "string" },
            "characterRefCid": { "type": "string", "format": "cid" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "blobCid": { "type": "string" },
            "renderMs": { "type": "integer" }
          }
        }
      }
    }
  }
}
