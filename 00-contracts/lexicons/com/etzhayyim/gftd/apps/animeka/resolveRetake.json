{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.animeka.resolveRetake",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Mark a retake resolved by pointing at the new record that addresses it. Un-flips cut.priority if no open retakes remain.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["retakeId", "status"],
          "properties": {
            "retakeId": { "type": "string", "format": "at-uri" },
            "status": {
              "type": "string",
              "enum": ["acknowledged", "inProgress", "resolved", "wontFix"]
            },
            "resolvedByUri": { "type": "string", "format": "at-uri" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["retakeId", "status"],
          "properties": {
            "retakeId": { "type": "string" },
            "status": { "type": "string" },
            "cutPriority": { "type": "string" }
          }
        }
      }
    }
  }
}
