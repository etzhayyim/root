{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.edpbBinding.flagNationalResistance",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Member state resistance / cjeu referral / sovereignty (bridges dpaAuthority.flagCrossBorderGap + federal-court-docket + schrems-challenge)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "decisionVid",
            "resistanceKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "decisionVid": {
              "type": "string",
              "description": "bridges recordBindingDecision"
            },
            "resistanceKind": {
              "type": "string",
              "enum": [
                "cjeu_annulment",
                "sovereign_override",
                "dpa_non_compliance",
                "legislative_pushback",
                "constitutional_challenge",
                "national_security_carveout",
                "right_to_privacy_constitutional",
                "home_authority_stall"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}