{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.edpbBinding.recordBindingDecision",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "EDPB Art 65 binding decision / consistency (bridges dpaAuthority.flagCrossBorderGap + data-adequacy + schrems-challenge)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "decisionId",
            "lsaLead",
            "triggerKind",
            "adoptedAt"
          ],
          "properties": {
            "decisionId": {
              "type": "string"
            },
            "lsaLead": {
              "type": "string"
            },
            "coSupervisors": {
              "type": "string"
            },
            "triggerKind": {
              "type": "string",
              "enum": [
                "art_65_1a_draft",
                "art_65_1b_mutual_assistance",
                "art_65_1c_representative",
                "art_66_urgency",
                "consistency_opinion",
                "internal_review",
                "complaint_redirect"
              ]
            },
            "subjectRespondent": {
              "type": "string"
            },
            "crossBorderGapVid": {
              "type": "string",
              "description": "bridges dpaAuthority.flagCrossBorderGap"
            },
            "adoptedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}