{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.karute.listMedications",
  "defs": {
    "main": {
      "type": "query",
      "description": "List MedicationRequests for a patient (public meta only). status=active filter for current med list.",
      "parameters": {
        "type": "params",
        "required": ["patientDid"],
        "properties": {
          "patientDid": {"type": "string"},
          "status": {"type": "string"},
          "prescriberDid": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 200, "default": 50},
          "offset": {"type": "integer", "minimum": 0, "default": 0}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "rkey": {"type": "string"},
                  "encryptedCid": {"type": "string"},
                  "encounterDid": {"type": "string"},
                  "prescriberDid": {"type": "string"},
                  "status": {"type": "string"},
                  "rxnormSummary": {"type": "string"},
                  "yjCodeSummary": {"type": "string"},
                  "interactionSeverityMax": {"type": "string"},
                  "authoredOn": {"type": "string", "format": "datetime"}
                }
              }
            },
            "offset": {"type": "integer"},
            "limit": {"type": "integer"}
          }
        }
      }
    }
  }
}
