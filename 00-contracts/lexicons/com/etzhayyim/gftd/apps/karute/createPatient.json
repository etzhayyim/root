{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.karute.createPatient",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Encrypted-write a new Patient record. record body must conform to com.etzhayyim.karute.patient; persisted inside com.etzhayyim.encrypted.record envelope.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["record", "recipientDids", "publicMeta"],
          "properties": {
            "record": {"type": "unknown", "description": "Inner Patient record (FHIR R5). MUST match com.etzhayyim.karute.patient."},
            "recipientDids": {
              "type": "array",
              "items": {"type": "string"},
              "description": "DIDs that get a Signal-wrapped key-wrap: patient self + treating clinicians + practice"
            },
            "publicMeta": {
              "type": "object",
              "required": ["patientDid"],
              "properties": {
                "patientDid": {"type": "string"},
                "registeredAt": {"type": "string", "format": "datetime"},
                "facilityDid": {"type": "string"}
              }
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "rkey": {"type": "string"},
            "encryptedCid": {"type": "string"},
            "patientDid": {"type": "string"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
