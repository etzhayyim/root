{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.karute.listHomeVisits",
  "defs": {
    "main": {
      "type": "query",
      "description": "List home visits for a patient (public meta only).",
      "parameters": {
        "type": "params",
        "required": ["patientDid"],
        "properties": {
          "patientDid": {"type": "string"},
          "episodeDid": {"type": "string"},
          "visitorDid": {"type": "string"},
          "visitType": {"type": "string"},
          "fromDate": {"type": "string", "format": "datetime"},
          "toDate": {"type": "string", "format": "datetime"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 200, "default": 50},
          "offset": {"type": "integer", "minimum": 0, "default": 0}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "items": {"type": "array", "items": {"type": "ref", "ref": "#visitRow"}},
            "offset": {"type": "integer"},
            "limit": {"type": "integer"}
          }
        }
      }
    },
    "visitRow": {
      "type": "object",
      "properties": {
        "rkey": {"type": "string"},
        "encryptedCid": {"type": "string"},
        "patientDid": {"type": "string"},
        "episodeDid": {"type": "string"},
        "visitorDid": {"type": "string"},
        "visitType": {"type": "string"},
        "occurredAt": {"type": "string", "format": "datetime"},
        "endedAt": {"type": "string", "format": "datetime"},
        "lengthMinutes": {"type": "integer"},
        "escalationType": {"type": "string"}
      }
    }
  }
}
