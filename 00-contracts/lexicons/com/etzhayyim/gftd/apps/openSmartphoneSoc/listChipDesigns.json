{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openSmartphoneSoc.listChipDesigns",
  "defs": {
    "main": {
      "type": "query",
      "description": "List registered open smartphone chip designs",
      "parameters": {
        "type": "params",
        "properties": {
          "isa": { "type": "string", "knownValues": ["riscv", "arm", "mips", "other"] },
          "openSourceRtl": { "type": "boolean" },
          "maxProcessNodeNm": { "type": "integer" },
          "limit": { "type": "integer", "default": 50, "maximum": 200 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["designs", "total"],
          "properties": {
            "designs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["vertexId", "chipId", "chipName", "isa", "openSourceRtl"],
                "properties": {
                  "vertexId": { "type": "string" },
                  "chipId": { "type": "string" },
                  "chipName": { "type": "string" },
                  "isa": { "type": "string" },
                  "processNodeNm": { "type": "integer" },
                  "openSourceRtl": { "type": "boolean" },
                  "status": { "type": "string" }
                }
              }
            },
            "total": { "type": "integer" }
          }
        }
      }
    }
  }
}
