{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.flightOffer.listWatch",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "List rows from vertex_flight_offer_watch. Procedure type chosen so it can be triggered by a BPMN binding identical to other watchlist commands; use the underlying view for high-throughput reads.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "description": "Filter by status (e.g. active, archived). Empty returns all (default 'active')." },
            "limit":  { "type": "integer", "minimum": 1, "maximum": 500 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok":     { "type": "boolean" },
            "count":  { "type": "integer" },
            "items":  { "type": "array", "items": { "type": "object" } },
            "error":  { "type": "string" }
          }
        }
      }
    }
  }
}
