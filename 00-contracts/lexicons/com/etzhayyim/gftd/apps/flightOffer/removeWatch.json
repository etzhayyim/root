{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.flightOffer.removeWatch",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Mark a watchlist row as archived (default) or hard-delete it from vertex_flight_offer_watch.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["originIata", "destinationIata", "outboundDate"],
          "properties": {
            "originIata":      { "type": "string", "minLength": 3, "maxLength": 3 },
            "destinationIata": { "type": "string", "minLength": 3, "maxLength": 3 },
            "outboundDate":    { "type": "string", "format": "datetime" },
            "currency":        { "type": "string", "minLength": 3, "maxLength": 3 },
            "hard":            { "type": "boolean", "description": "If true, DELETE; otherwise UPDATE status='archived' (default false)." }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok":       { "type": "boolean" },
            "removed":  { "type": "boolean" },
            "vertexId": { "type": "string" },
            "hard":     { "type": "boolean" },
            "error":    { "type": "string" }
          }
        }
      }
    }
  }
}
