{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.flightOffer.listAirlines",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "List rows from vertex_airline. Optional countryCode (ISO 3166-1 alpha-2) and alliance (Star Alliance | OneWorld | SkyTeam) filters.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "countryCode": { "type": "string", "minLength": 2, "maxLength": 2 },
            "alliance":    { "type": "string" },
            "limit":       { "type": "integer", "minimum": 1, "maximum": 1000 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok":    { "type": "boolean" },
            "count": { "type": "integer" },
            "items": { "type": "array", "items": { "type": "object" } },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
