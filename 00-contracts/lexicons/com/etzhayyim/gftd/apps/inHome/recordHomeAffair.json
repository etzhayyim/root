{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.inHome.recordHomeAffair",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "India Ministry of Home Affairs (MHA) action (bridges asylumDetermination + extraditionTreaty + judicialAppointment)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "actionId",
            "departmentKind",
            "actionKind",
            "issuedAt"
          ],
          "properties": {
            "actionId": {
              "type": "string"
            },
            "departmentKind": {
              "type": "string",
              "enum": [
                "minister_office",
                "internal_security",
                "border_management",
                "police_modernisation",
                "disaster_management",
                "jamar_kashmir",
                "union_territories",
                "censuses",
                "foreigners_division",
                "judicial_division",
                "centre_state",
                "official_language",
                "fcra_div",
                "cbi_central_bureau",
                "nia_national_investigation",
                "ed_enforcement_directorate",
                "intelligence_bureau"
              ]
            },
            "actionKind": {
              "type": "string",
              "enum": [
                "fcra_amendment",
                "caa_implementation",
                "npr_npr",
                "upa_act_2019",
                "passport_act_amend",
                "fcra_license_revoke",
                "ngo_clamp",
                "internet_shutdown_authorize",
                "afspa_extension",
                "bsf_jurisdiction_extend",
                "crpf_deployment",
                "cbi_consent_state",
                "supreme_court_collegium_battle"
              ]
            },
            "relatedActorVid": {
              "type": "string",
              "description": "bridges asylumDetermination / extraditionTreaty"
            },
            "issuedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}