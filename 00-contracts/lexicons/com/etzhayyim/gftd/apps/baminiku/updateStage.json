{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.baminiku.updateStage",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Update KAMI LiveStage lighting, camera, backdrop, or scene entities for an active stream.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["streamId"],
          "properties": {
            "streamId": { "type": "string" },
            "lighting": { "type": "object" },
            "camera": { "type": "object" },
            "backdrop": { "type": "object" },
            "entities": { "type": "array", "items": { "type": "object" } }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["streamId", "kamiCommand"],
          "properties": {
            "streamId": { "type": "string" },
            "kamiCommand": { "type": "object" }
          }
        }
      }
    }
  }
}
