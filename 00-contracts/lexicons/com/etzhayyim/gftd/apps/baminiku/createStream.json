{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.baminiku.createStream",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create a KAMI Island social live-stream session with stage scene JSON-LD and KNP room metadata.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["agentDid"],
          "properties": {
            "agentDid": { "type": "string" },
            "title": { "type": "string" },
            "stagePreset": { "type": "string" },
            "visibility": { "type": "string", "enum": ["public", "unlisted", "private"] },
            "scheduledAt": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["streamId", "scene", "knpRoom"],
          "properties": {
            "streamId": { "type": "string" },
            "scene": { "type": "object" },
            "knpRoom": { "type": "string" },
            "kamiCommands": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    }
  }
}
