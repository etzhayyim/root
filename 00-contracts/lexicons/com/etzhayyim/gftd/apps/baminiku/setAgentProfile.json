{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.baminiku.setAgentProfile",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Set the AI liver profile used by KAMI Engine LiveStage: CharacterAppearance, voice, personality, and moderation posture.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["agentDid"],
          "properties": {
            "agentDid": { "type": "string" },
            "displayName": { "type": "string" },
            "voicePreset": { "type": "string" },
            "personality": { "type": "string" },
            "appearance": { "type": "object" },
            "moderationPolicy": { "type": "object" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["profileId", "kamiCommand"],
          "properties": {
            "profileId": { "type": "string" },
            "agentDid": { "type": "string" },
            "kamiCommand": { "type": "object" }
          }
        }
      }
    }
  }
}
