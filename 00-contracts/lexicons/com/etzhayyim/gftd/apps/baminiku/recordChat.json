{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.baminiku.recordChat",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a viewer chat message and produce a KAMI text-bubble command plus an agent-response planning envelope.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["streamId", "viewerDid", "text"],
          "properties": {
            "streamId": { "type": "string" },
            "viewerDid": { "type": "string" },
            "text": { "type": "string" },
            "convoId": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["chatId", "kamiCommand", "agentCue"],
          "properties": {
            "chatId": { "type": "string" },
            "kamiCommand": { "type": "object" },
            "agentCue": { "type": "object" }
          }
        }
      }
    }
  }
}
