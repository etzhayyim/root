{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.indigenousRights.flagFpicViolation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Free Prior Informed Consent violation (bridges forced-labor + mining)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "violationId",
            "territoryVid",
            "violationType",
            "reportedAt"
          ],
          "properties": {
            "violationId": {
              "type": "string"
            },
            "territoryVid": {
              "type": "string",
              "description": "bridges registerTerritory"
            },
            "actorLei": {
              "type": "string"
            },
            "violationType": {
              "type": "string",
              "enum": [
                "no_consultation",
                "coerced_consent",
                "misrepresentation",
                "excluded_benefits",
                "retaliation",
                "forced_displacement"
              ]
            },
            "miningVid": {
              "type": "string",
              "description": "bridges open-mining-operation"
            },
            "forcedLaborVid": {
              "type": "string",
              "description": "bridges open-forced-labor"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "moderate",
                "strong",
                "severe"
              ]
            }
          }
        }
      }
    }
  }
}