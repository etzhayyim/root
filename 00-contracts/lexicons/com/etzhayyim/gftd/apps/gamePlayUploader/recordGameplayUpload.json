{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.gamePlayUploader.recordGameplayUpload",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a completed gameplay video upload with duration and object metadata.",
      "input": { "encoding": "application/json", "schema": { "type": "object", "required": ["sessionId", "objectUri", "durationSec"], "properties": { "sessionId": { "type": "string" }, "objectUri": { "type": "string" }, "durationSec": { "type": "integer" }, "sha256": { "type": "string" }, "metadata": { "type": "object" } } } },
      "output": { "encoding": "application/json", "schema": { "type": "object", "required": ["uploadId", "status"], "properties": { "uploadId": { "type": "string" }, "status": { "type": "string" } } } }
    }
  }
}
