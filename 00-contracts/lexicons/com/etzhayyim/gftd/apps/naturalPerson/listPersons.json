{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.naturalPerson.listPersons",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "vitalStatus": { "type": "string" },
          "country": { "type": "string" },
          "era": { "type": "string" },
          "gender": { "type": "string" },
          "sourceApp": { "type": "string" },
          "limit": { "type": "integer", "default": 50 },
          "offset": { "type": "integer", "default": 0 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "persons": { "type": "array", "items": { "type": "object" } },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          },
          "required": ["persons", "total", "offset", "limit"]
        }
      }
    }
  }
}
