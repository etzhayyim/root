{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openSeiyaku.finalizeBatch",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Finalize a reviewed batch as released or rejected.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "vertexId": { "type": "string" },
            "status": { "type": "string", "enum": ["released", "rejected"] }
          },
          "required": ["vertexId", "status"]
        }
      }
    }
  }
}
