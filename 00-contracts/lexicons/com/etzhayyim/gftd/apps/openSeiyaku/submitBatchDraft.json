{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openSeiyaku.submitBatchDraft",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Save an encrypted batch draft payload for open-seiyaku.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "vertexId": { "type": "string" },
            "batchRecordPayload": { "type": "string" },
            "qualityPayload": { "type": "string" },
            "deviationPayload": { "type": "string" }
          },
          "required": ["vertexId"]
        }
      }
    }
  }
}
