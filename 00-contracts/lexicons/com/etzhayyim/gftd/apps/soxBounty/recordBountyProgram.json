{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.soxBounty.recordBountyProgram",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "SEC OWB / CFTC WPO / IRS WBO / FinCEN WBP / AMLA / NHTSA bounty (bridges whistleblowerProtect.flagRetaliation + enforcementAction + securities)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "programId",
            "agency",
            "qualifyingViolation",
            "programLaunchedAt"
          ],
          "properties": {
            "programId": {
              "type": "string"
            },
            "agency": {
              "type": "string",
              "enum": [
                "sec_owb",
                "cftc_wpo",
                "irs_wbo",
                "fincen_wbp",
                "amla_fincen",
                "ctr_usdoj",
                "nhtsa",
                "ftc",
                "consumer_fin_protect",
                "ois_afl",
                "fcc_wb",
                "faa",
                "fda"
              ]
            },
            "qualifyingViolation": {
              "type": "string",
              "enum": [
                "fraud_secur",
                "manipulation_market",
                "insider_trading",
                "fcpa",
                "aml",
                "tax_evasion",
                "automotive_safety",
                "unsecured_consumer",
                "telecom",
                "airline_safety",
                "drug"
              ]
            },
            "retaliationVid": {
              "type": "string",
              "description": "bridges whistleblowerProtect.flagRetaliation"
            },
            "programLaunchedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}