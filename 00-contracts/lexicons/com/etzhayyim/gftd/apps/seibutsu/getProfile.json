{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.seibutsu.getProfile",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["did"],
        "properties": {
          "did": { "type": "string", "description": "Taxon actor DID." }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["taxon", "lineage"],
          "properties": {
            "taxon": { "type": "object" },
            "traits": { "type": "object" },
            "lineage": { "type": "array", "items": { "type": "object" }, "description": "Parent chain root → self." }
          }
        }
      }
    }
  }
}
