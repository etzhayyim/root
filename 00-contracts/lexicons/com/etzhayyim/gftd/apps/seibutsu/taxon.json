{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.seibutsu.taxon",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["did", "rank", "scientificName"],
        "properties": {
          "did": { "type": "string", "description": "Canonical actor DID for this taxon (did:plc preferred)." },
          "rank": { "type": "string", "enum": ["domain", "kingdom", "phylum", "class", "order", "family", "genus", "species", "subspecies"] },
          "scientificName": { "type": "string", "description": "Latin binomial or higher-rank name." },
          "authority": { "type": "string", "description": "Naming authority (e.g. 'L.', 'Linnaeus 1753')." },
          "commonName": { "type": "string" },
          "parentDid": { "type": "string", "description": "Immediate parent taxon DID." },
          "gbifId": { "type": "string" },
          "ncbiTaxonId": { "type": "string" },
          "wikidataQid": { "type": "string" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
