{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.enforcementAction.recordAction",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "SEC / DOJ / FTC / CFTC / FinCEN enforcement action (bridges federalCourtDocket.flagInjunction + antitrust-dma + sanctions-screening)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "actionId",
            "agency",
            "violationKind",
            "announcedAt"
          ],
          "properties": {
            "actionId": {
              "type": "string"
            },
            "agency": {
              "type": "string",
              "enum": [
                "sec",
                "doj_fraud",
                "doj_antitrust",
                "ftc",
                "cftc",
                "fincen",
                "occ",
                "ofac",
                "cfpb",
                "federal_reserve",
                "fdic",
                "fbi",
                "irs_ci"
              ]
            },
            "respondentLei": {
              "type": "string"
            },
            "violationKind": {
              "type": "string",
              "enum": [
                "securities_fraud",
                "insider_trading",
                "market_manipulation",
                "fcpa",
                "antitrust",
                "consumer_protection",
                "aml_bsa",
                "sanctions",
                "wire_fraud",
                "tax_evasion",
                "false_claims",
                "cybersecurity_disclosure"
              ]
            },
            "dispositionKind": {
              "type": "string",
              "enum": [
                "settlement",
                "admin_order",
                "consent_decree",
                "deferred_prosecution",
                "non_prosecution",
                "guilty_plea",
                "conviction",
                "dismissal",
                "indictment"
              ]
            },
            "injunctionVid": {
              "type": "string",
              "description": "bridges federalCourtDocket.flagInjunction"
            },
            "monetaryPenaltyMusd": {
              "type": "number"
            },
            "announcedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}