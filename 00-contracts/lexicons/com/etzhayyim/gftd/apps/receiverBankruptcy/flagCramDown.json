{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.receiverBankruptcy.flagCramDown",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Cramdown / equity conversion / avoidance / preference (bridges securitiesInvestor.flagLowRecovery + enforcement-action + sovereign-debt)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "proceedingVid",
            "issueKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "proceedingVid": {
              "type": "string",
              "description": "bridges recordProceeding"
            },
            "issueKind": {
              "type": "string",
              "enum": [
                "cramdown_dissent",
                "unfair_discrimination",
                "preference_payment",
                "fraudulent_transfer",
                "veil_pierce",
                "non_consensual_plan",
                "gifting_doctrine",
                "absolute_priority",
                "new_value",
                "non_debtor_release",
                "third_party_release"
              ]
            },
            "affectedClaimBusd": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}