            "tensionKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "actionVid": {
              "type": "string",
              "description": "bridges recordExecutiveAction"
            },
            "tensionKind": {
              "type": "string",
              "enum": [
                "provincial_resist",
                "local_government_debt",
                "mega_city_overrule",
                "sez_pushback",
                "autonomous_region",
                "village_level_implementation_gap",
                "party_state_sep",
                "propaganda_drift",
                "censorship_inconsistent",
                "one_country_two_systems_drift",
                "macau_carveout"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
