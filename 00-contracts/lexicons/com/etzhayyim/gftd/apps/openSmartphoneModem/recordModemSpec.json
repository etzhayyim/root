{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openSmartphoneModem.recordModemSpec",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a smartphone modem/baseband specification",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["modemId", "chipName", "ratSupport", "openSourceFw"],
          "properties": {
            "modemId": { "type": "string" },
            "chipName": { "type": "string" },
            "ratSupport": { "type": "array", "items": { "type": "string", "knownValues": ["2g", "3g", "4g-lte", "5g-nr", "wifi6", "wifi7", "bt53", "gnss"] } },
            "basebandChip": { "type": "string" },
            "openSourceFw": { "type": "boolean" },
            "fwLicense": { "type": "string" },
            "maxDlMbps": { "type": "number" },
            "maxUlMbps": { "type": "number" },
            "releaseYear": { "type": "integer" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["vertexId"],
          "properties": { "vertexId": { "type": "string" } }
        }
      }
    }
  }
}
