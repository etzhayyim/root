{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.fax.uploadDocument",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Upload an arbitrary document (PDF/image) to CDN_R2. Content-addressed: blobKey = SHA-256 hex of bytes; uploads are deduped (HEAD-then-PUT). Returns blobKey for use by com.etzhayyim.apps.fax.send. Use this when you already have a finished PDF and only need transmission.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["contentBase64", "contentType"],
          "properties": {
            "contentBase64": { "type": "string", "description": "Document bytes base64-encoded" },
            "contentType": { "type": "string", "description": "MIME type (application/pdf, image/png, etc.)" },
            "filename": { "type": "string", "description": "Original filename (for logging only)" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "blobKey": { "type": "string" },
            "publicUrl": { "type": "string", "format": "uri" },
            "byteSize": { "type": "integer" },
            "deduped": { "type": "boolean" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
