{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.fax.confirmManualSend",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Mark a manual-handoff faxTx (status='needs_human') as completed once the operator has sent the FAX via the Dropbox Fax UI (or alternative). Updates faxTxUpdate record and triggers cross-actor recordCommunication on roukisho if officeId was provided in the original composeAndSend call.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["txId"],
          "properties": {
            "txId": { "type": "string" },
            "providerFaxId": { "type": "string", "description": "Provider-side id (e.g. Dropbox Fax transmission id) if known" },
            "sentAt": { "type": "string", "format": "datetime" },
            "deliveredAt": { "type": "string", "format": "datetime" },
            "officeId": { "type": "string", "description": "roukisho officeId (for cross-actor recordCommunication)" },
            "officeDid": { "type": "string", "format": "did" },
            "divisionNumber": { "type": "integer" },
            "inspector": { "type": "string" },
            "caseId": { "type": "string" },
            "summary": { "type": "string", "description": "Free-form note for the audit log" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "txId": { "type": "string" },
            "status": { "type": "string" },
            "roukishoCommunicationId": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
