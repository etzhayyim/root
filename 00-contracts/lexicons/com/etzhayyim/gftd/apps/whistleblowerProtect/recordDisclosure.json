{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.whistleblowerProtect.recordDisclosure",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Whistleblower protected disclosure (EU Directive 2019/1937 / Dodd-Frank / Sarbanes-Oxley — bridges genderInclusion.flagHarassment + enforcementAction + ilo-labor-rights)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "disclosureId",
            "jurisdictionIso3",
            "regime",
            "disclosureTopic",
            "disclosedAt"
          ],
          "properties": {
            "disclosureId": {
              "type": "string"
            },
            "jurisdictionIso3": {
              "type": "string"
            },
            "regime": {
              "type": "string",
              "enum": [
                "eu_2019_1937",
                "us_dodd_frank",
                "us_sarbanes_oxley",
                "uk_pida",
                "au_pid",
                "fr_sapin2",
                "de_hinschg",
                "jp_whistleblower_act",
                "ca_wpaa",
                "brazil_lei_da_delacao"
              ]
            },
            "disclosureTopic": {
              "type": "string",
              "enum": [
                "fraud",
                "financial_misconduct",
                "bribery_corruption",
                "environmental",
                "occupational_safety",
                "sexual_harassment",
                "sanctions_violation",
                "antitrust",
                "data_privacy",
                "consumer_protection",
                "money_laundering"
              ]
            },
            "harassmentVid": {
              "type": "string",
              "description": "bridges genderInclusion.flagHarassment"
            },
            "disclosedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}