{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.training.runBaienMultimodalGraft",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Train a Baien multimodal projector (image / audio-speech / audio-env) on top of a frozen BitNet trunk and a frozen off-the-shelf encoder (SigLIP-So400m / Whisper-tiny CTC / YAMNet). ADR 2605092350. Trunk weights are NOT updated; only the 1.58-bit projector is. Recorded as kind='baien-multimodal-graft' in vertex_training_run.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["modality", "encoderModel", "datasetName"],
          "properties": {
            "runId": {"type": "string"},
            "modality": {"type": "string", "knownValues": ["image", "audio-speech", "audio-env"]},
            "baseModel": {"type": "string", "description": "BitNet trunk; defaults to microsoft/bitnet-b1.58-2B-4T-bf16."},
            "baseModelRevision": {"type": "string"},
            "encoderModel": {"type": "string", "description": "HF id of the frozen encoder (e.g. google/siglip-so400m-patch14-384, openai/whisper-tiny, google/yamnet)."},
            "encoderRevision": {"type": "string"},
            "datasetName": {"type": "string"},
            "datasetLabel": {"type": "string"},
            "datasetRevision": {"type": "string"},
            "hyperparams": {
              "type": "object",
              "properties": {
                "epochs": {"type": "number"},
                "learningRate": {"type": "number"},
                "batchSize": {"type": "integer"},
                "projectorTokens": {"type": "integer", "description": "Number of latent tokens emitted by the projector (image=64, audio-speech=32, audio-env=16)."},
                "saveStepInterval": {"type": "integer"}
              }
            },
            "gpuTarget": {"type": "string"},
            "seed": {"type": "integer"},
            "rationale": {"type": "string", "maxLength": 2000}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "runId"],
          "properties": {
            "ok": {"type": "boolean"},
            "runId": {"type": "string"},
            "runVertexId": {"type": "string"},
            "datasetSnapshotId": {"type": "string"},
            "finalCheckpointId": {"type": "string"},
            "finalCheckpointVertexId": {"type": "string"},
            "modality": {"type": "string"},
            "projectorTokens": {"type": "integer"},
            "evalSummary": {"type": "string"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
