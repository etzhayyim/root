{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.training.runDistill",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Start a distillation run (teacher → student). The teacher is identified by either a prior training run (runId) or by an actor DID whose Murakumo-served weights produce the labels. For LLM teachers we bulk-infer logits over the dataset and persist them as Hume-style artifacts (ADR-2604300135) before running the student fine-tune. edge_training_distilled_from is written on success.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["studentBaseModel", "datasetName", "teacherKind"],
          "properties": {
            "runId": {"type": "string"},
            "studentBaseModel": {"type": "string"},
            "studentBaseModelRevision": {"type": "string"},
            "datasetName": {"type": "string"},
            "datasetLabel": {"type": "string"},
            "datasetRevision": {"type": "string"},
            "teacherKind": {"type": "string", "enum": ["run", "actor", "artifact"], "description": "run = prior vertex_training_run; actor = serving DID (Murakumo etc); artifact = vertex_ingest_artifact (Hume / external)."},
            "teacherRunId": {"type": "string"},
            "teacherActorDid": {"type": "string"},
            "teacherArtifactRunId": {"type": "string"},
            "distillMethod": {"type": "string", "enum": ["hard-label", "soft-logits", "feature-match"], "default": "soft-logits"},
            "temperature": {"type": "number"},
            "hyperparams": {
              "type": "object",
              "properties": {
                "epochs": {"type": "number"},
                "learningRate": {"type": "number"},
                "batchSize": {"type": "integer"},
                "alpha": {"type": "number", "description": "Mix between distill loss and ground-truth loss."},
                "maxSeqLen": {"type": "integer"},
                "saveStepInterval": {"type": "integer"}
              }
            },
            "evalBenches": {"type": "array", "items": {"type": "string"}},
            "gpuTarget": {"type": "string"},
            "seed": {"type": "integer"},
            "rationale": {"type": "string", "maxLength": 2000}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "runId"],
          "properties": {
            "ok": {"type": "boolean"},
            "runId": {"type": "string"},
            "runVertexId": {"type": "string"},
            "datasetSnapshotId": {"type": "string"},
            "teacherLabelArtifactRunId": {"type": "string"},
            "finalCheckpointId": {"type": "string"},
            "finalCheckpointVertexId": {"type": "string"},
            "distilledFromEdgeId": {"type": "string"},
            "evalSummary": {"type": "string"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
