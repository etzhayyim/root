{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.webmk.listProposals",
  "defs": {
    "main": {
      "type": "query",
      "description": "List marketing proposals with optional status filter.",
      "parameters": {
        "type": "params",
        "properties": {
          "status": { "type": "string", "description": "Filter by status: queued|running|delivered|failed" },
          "limit":  { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
          "offset": { "type": "integer", "minimum": 0, "default": 0 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["proposals", "total", "offset", "limit"],
          "properties": {
            "proposals": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["proposalId", "clientName", "status", "createdAt"],
                "properties": {
                  "proposalId":   { "type": "string" },
                  "clientName":   { "type": "string" },
                  "websiteUrl":   { "type": "string" },
                  "industry":     { "type": "string" },
                  "status":       { "type": "string" },
                  "qualityScore": { "type": "number" },
                  "campaignId":   { "type": "string" },
                  "deliveredAt":  { "type": "string" },
                  "createdAt":    { "type": "string" }
                }
              }
            },
            "total":  { "type": "integer" },
            "offset": { "type": "integer" },
            "limit":  { "type": "integer" }
          }
        }
      }
    }
  }
}
