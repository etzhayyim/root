{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yardOps.checkInTrailer",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Gate-in a trailer arriving at the yard.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["trailerPlate", "carrierDid"],
          "properties": {
            "trailerPlate": { "type": "string" },
            "carrierDid": { "type": "string" },
            "appointmentId": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "yardSlotCode": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
