{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.iraTaxCredit.flagFeocDisqualification",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "FEOC / transfer of credit / recapture risk (bridges evSupplyChain.flagFeocRisk + critical-minerals.flagExportControlRisk + treasury-rulemaking)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "claimVid",
            "issueKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "claimVid": {
              "type": "string",
              "description": "bridges recordCreditClaim"
            },
            "feocRiskVid": {
              "type": "string",
              "description": "bridges evSupplyChain.flagFeocRisk"
            },
            "issueKind": {
              "type": "string",
              "enum": [
                "feoc_ownership",
                "material_feoc_input",
                "transferee_ineligible",
                "recapture_trigger",
                "labor_wage_shortfall",
                "apprenticeship_shortfall",
                "domestic_content_short"
              ]
            },
            "recaptureMusd": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}