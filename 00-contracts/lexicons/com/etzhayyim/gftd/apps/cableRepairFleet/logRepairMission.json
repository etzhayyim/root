{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.cableRepairFleet.logRepairMission",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Cable fault repair mission (bridges telecom-infra flagCableFault)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "missionId",
            "vesselVid",
            "missionOutcome"
          ],
          "properties": {
            "missionId": {
              "type": "string"
            },
            "vesselVid": {
              "type": "string",
              "description": "bridges registerRepairVessel"
            },
            "faultVid": {
              "type": "string",
              "description": "bridges open-telecom-infra flagCableFault"
            },
            "mobilizationDays": {
              "type": "number"
            },
            "onSiteDays": {
              "type": "number"
            },
            "restoreDays": {
              "type": "number"
            },
            "conditions": {
              "type": "string",
              "enum": [
                "calm",
                "rough",
                "storm",
                "ice",
                "tropical"
              ]
            },
            "missionOutcome": {
              "type": "string",
              "enum": [
                "full_repair",
                "partial_repair",
                "survey_only",
                "aborted"
              ]
            },
            "completedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "efficiencyTier": {
              "type": "string",
              "enum": [
                "prolonged",
                "standard",
                "rapid"
              ]
            }
          }
        }
      }
    }
  }
}