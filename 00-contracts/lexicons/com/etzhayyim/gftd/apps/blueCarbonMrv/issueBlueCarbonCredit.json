{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.blueCarbonMrv.issueBlueCarbonCredit",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Blue carbon credit issuance (bridges climate-carbon-market + cdr-verification + indigenous-rights)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "creditId",
            "estimateVid",
            "methodologyCode",
            "tonnesCo2e",
            "issuedAt"
          ],
          "properties": {
            "creditId": {
              "type": "string"
            },
            "estimateVid": {
              "type": "string",
              "description": "bridges recordStockEstimate"
            },
            "methodologyCode": {
              "type": "string"
            },
            "tonnesCo2e": {
              "type": "number"
            },
            "permanenceYears": {
              "type": "integer"
            },
            "communityBenefitSharingPct": {
              "type": "number"
            },
            "indigenousTerritoryVid": {
              "type": "string",
              "description": "bridges open-indigenous-rights"
            },
            "issuedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "integrityTier": {
              "type": "string",
              "enum": [
                "low",
                "moderate",
                "high"
              ]
            }
          }
        }
      }
    }
  }
}