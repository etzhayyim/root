{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.blueCarbonMrv.registerBlueCarbonProject",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Mangrove / seagrass / saltmarsh blue carbon project (Verra VM0033 / Plan Vivo / GEF Blue Economy — bridges forestryMrv.registerForestProject + natureMarkets.registerBiodiversityCredit)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "projectId",
            "registryKind",
            "ecosystem",
            "countryIso3",
            "registeredAt"
          ],
          "properties": {
            "projectId": {
              "type": "string"
            },
            "registryKind": {
              "type": "string",
              "enum": [
                "verra_vm0033",
                "verra_vm0007",
                "plan_vivo",
                "gold_standard",
                "art_trees",
                "ocean_based",
                "gcf_blue"
              ]
            },
            "ecosystem": {
              "type": "string",
              "enum": [
                "mangrove",
                "seagrass",
                "saltmarsh",
                "kelp",
                "macroalgae",
                "tidal_flat",
                "estuary"
              ]
            },
            "countryIso3": {
              "type": "string"
            },
            "areaHectares": {
              "type": "number"
            },
            "sequestrationTco2eYearly": {
              "type": "number"
            },
            "forestProjectVid": {
              "type": "string",
              "description": "bridges forestryMrv.registerForestProject"
            },
            "indigenousTenurePct": {
              "type": "number"
            },
            "registeredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}