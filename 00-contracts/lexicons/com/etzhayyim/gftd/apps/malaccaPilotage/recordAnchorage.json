{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.malaccaPilotage.recordAnchorage",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "錨地滞留",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "anchorageId",
            "imo",
            "anchorageZone",
            "arrivedAt"
          ],
          "properties": {
            "anchorageId": {
              "type": "string"
            },
            "imo": {
              "type": "string"
            },
            "anchorageZone": {
              "type": "string",
              "enum": [
                "EOPL",
                "WOPL",
                "SERA",
                "CWPA"
              ]
            },
            "arrivedAt": {
              "type": "string",
              "format": "datetime"
            },
            "departedAt": {
              "type": "string",
              "format": "datetime"
            },
            "dwellHours": {
              "type": "number"
            },
            "purpose": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
