{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.cyberResilienceStress.reportResilienceGap",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Resilience gap finding (bridges cyber-incident + quantum-safe-crypto)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "gapId",
            "testVid",
            "gapCategory",
            "severity",
            "reportedAt"
          ],
          "properties": {
            "gapId": {
              "type": "string"
            },
            "testVid": {
              "type": "string",
              "description": "bridges recordStressTest"
            },
            "gapCategory": {
              "type": "string",
              "enum": [
                "detection",
                "containment",
                "recovery",
                "communication",
                "third_party",
                "identity",
                "cryptographic"
              ]
            },
            "severity": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            "mitigationDueAt": {
              "type": "string",
              "format": "datetime"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "rpoRtoTier": {
              "type": "string",
              "enum": [
                "rto_flexible",
                "rto_same_day",
                "rpo_zero"
              ]
            }
          }
        }
      }
    }
  }
}