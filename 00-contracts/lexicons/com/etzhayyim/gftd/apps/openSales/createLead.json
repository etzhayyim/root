{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openSales.createLead",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create a new sales lead. Starts BPMN open_sales_create_lead which saves to vertex_open_sales_lead and emits audit.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["fullName"],
          "properties": {
            "leadId":      { "type": "string" },
            "fullName":    { "type": "string" },
            "email":       { "type": "string" },
            "company":     { "type": "string" },
            "source":      { "type": "string", "knownValues": ["inbound", "outbound", "referral", "partner", "event", "other"] },
            "assignedDid": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["vertexId"],
          "properties": {
            "vertexId":    { "type": "string" },
            "status":      { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error":       { "type": "string" }
          }
        }
      }
    }
  }
}
