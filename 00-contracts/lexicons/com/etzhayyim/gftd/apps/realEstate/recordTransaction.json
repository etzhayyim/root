{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.realEstate.recordTransaction",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a real-estate sale, rental contract, land transfer, lease, or auction transaction. Starts BPMN real_estate_record_transaction.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["transactionId", "transactionKind", "countryIso2"],
          "properties": {
            "transactionId": { "type": "string" },
            "propertyVid": { "type": "string" },
            "listingVid": { "type": "string" },
            "transactionKind": { "type": "string", "enum": ["sale", "rent_contract", "land_sale", "lease", "auction_result", "title_transfer"] },
            "countryIso2": { "type": "string" },
            "currency": { "type": "string" },
            "amount": { "type": "number" },
            "rentPeriod": { "type": "string", "enum": ["day", "week", "month", "year"] },
            "contractStartDate": { "type": "string", "format": "date" },
            "contractEndDate": { "type": "string", "format": "date" },
            "signedAt": { "type": "string", "format": "datetime" },
            "registeredAt": { "type": "string", "format": "datetime" },
            "sourceId": { "type": "string" },
            "sourceUrl": { "type": "string", "format": "uri" },
            "buyerPartyVid": { "type": "string" },
            "sellerPartyVid": { "type": "string" },
            "tenantPartyVid": { "type": "string" },
            "landlordPartyVid": { "type": "string" },
            "brokerPartyVid": { "type": "string" },
            "confidence": { "type": "number" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
