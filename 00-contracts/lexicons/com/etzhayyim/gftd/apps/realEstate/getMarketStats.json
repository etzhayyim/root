{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.realEstate.getMarketStats",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get active listing market rollups by country, city, listing kind, and currency.",
      "parameters": {
        "type": "params",
        "properties": {
          "countryIso2": { "type": "string" },
          "city": { "type": "string" },
          "listingKind": { "type": "string", "enum": ["sale", "rent", "land_sale", "auction", "lease_assignment"] },
          "currency": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "items": { "type": "array", "items": { "type": "object" } },
            "count": { "type": "integer" }
          },
          "required": ["items", "count"]
        }
      }
    }
  }
}
