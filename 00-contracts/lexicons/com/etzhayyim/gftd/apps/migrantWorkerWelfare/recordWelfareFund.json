{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.migrantWorkerWelfare.recordWelfareFund",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Migrant worker welfare fund registry (GCC Wage Protection / Kafala reform / MoU — bridges labour-mobility + forced-labor + crew-welfare)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "fundId",
            "hostIso3",
            "mechanism",
            "establishedAt"
          ],
          "properties": {
            "fundId": {
              "type": "string"
            },
            "hostIso3": {
              "type": "string"
            },
            "originIso3": {
              "type": "string"
            },
            "mechanism": {
              "type": "string",
              "enum": [
                "wps",
                "welfare_fund",
                "grievance_platform",
                "bla_escrow",
                "insurance_pool"
              ]
            },
            "annualContributionsUsd": {
              "type": "number"
            },
            "coveredWorkersCount": {
              "type": "integer"
            },
            "labourCorridorVid": {
              "type": "string",
              "description": "bridges open-labour-mobility"
            },
            "establishedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}