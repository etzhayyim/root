{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.gameka.gameQa",
  "defs": {
    "main": {
      "type": "record",
      "record": {
        "type": "object",
        "properties": {
          "qaId": { "type": "string" },
          "specId": { "type": "string" },
          "artifactId": { "type": "string" },
          "iteration": { "type": "integer" },
          "screenshotCidsJson": {
            "type": "string",
            "description": "JSON array of B2 screenshot CIDs captured at frame timestamps."
          },
          "consoleErrorCount": { "type": "integer" },
          "fpsP50": { "type": "number" },
          "fpsP95": { "type": "number" },
          "sceneLoadMs": { "type": "integer" },
          "visualScore": { "type": "number" },
          "perfScore": { "type": "number" },
          "combinedScore": { "type": "number" },
          "publish": { "type": "boolean" },
          "outcome": { "type": "string" },
          "issuesJson": {
            "type": "string",
            "description": "JSON array of {category, severity, description} feeding the next revise iteration."
          },
          "criticModelId": { "type": "string" },
          "createdAt": { "type": "string", "format": "datetime" }
