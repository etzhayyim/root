{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airFfp.redeemReward",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Redeem miles for a reward benefit.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["member_did", "reward_type", "miles_cost"],
          "properties": {
            "member_did": { "type": "string" },
            "reward_type": { "type": "string" },
            "miles_cost": { "type": "integer" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
