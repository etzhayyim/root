{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airFfp.enrollMember",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Enroll a new member in the frequent flyer program.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["passenger_name", "email"],
          "properties": {
            "passenger_name": { "type": "string" },
            "email": { "type": "string" },
            "tier": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
