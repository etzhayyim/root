{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airFfp.updateTier",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Update a frequent flyer member's tier status.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["member_did", "new_tier"],
          "properties": {
            "member_did": { "type": "string" },
            "new_tier": { "type": "string" },
            "qualifying_miles": { "type": "integer" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
