{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airFfp.accruePoints",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Accrue frequent flyer miles for a member after a flight.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["member_did", "flight_no", "dep_date", "miles_earned"],
          "properties": {
            "member_did": { "type": "string" },
            "flight_no": { "type": "string" },
            "dep_date": { "type": "string" },
            "miles_earned": { "type": "integer" },
            "bonus_pct": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
