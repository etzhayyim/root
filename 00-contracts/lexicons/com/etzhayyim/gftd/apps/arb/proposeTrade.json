{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.arb.proposeTrade",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Persist an arbitrage proposal. EDUCATIONAL ONLY — no execution. `executed` MUST be false (server-enforced). Tier-2 domain write to vertex_arb_proposal via Hyperdrive.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["assetClass", "legA", "legB", "spreadBps", "edgeBps"],
          "properties": {
            "assetClass": { "type": "string", "enum": ["eq", "fut", "fx", "com", "re", "cr"] },
            "legA":       { "type": "string", "description": "venue:symbol of long leg" },
            "legB":       { "type": "string", "description": "venue:symbol of short leg" },
            "spreadBps":  { "type": "integer" },
            "edgeBps":    { "type": "integer", "description": "edge after estimated frictions (fee + borrow + fx)" },
            "confidence": { "type": "number",  "minimum": 0, "maximum": 1, "default": 0.5 },
            "rationale":  { "type": "string" },
            "expiresAt":  { "type": "string", "format": "datetime" },
            "executed":   { "type": "boolean", "const": false }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "proposalId": { "type": "string" },
            "uri":        { "type": "string" },
            "disclaimer": { "type": "string" }
          }
        }
      }
    }
  }
}
