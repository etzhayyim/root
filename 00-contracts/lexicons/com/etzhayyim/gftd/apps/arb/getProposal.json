{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.arb.getProposal",
  "defs": {
    "main": {
      "type": "query",
      "description": "Fetch a single arbitrage proposal with its score and publication metadata.",
      "parameters": {
        "type": "params",
        "required": ["proposalId"],
        "properties": {
          "proposalId": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "proposal":    { "type": "object" },
            "score":       { "type": "object" },
            "publication": { "type": "object" }
          }
        }
      }
    }
  }
}
