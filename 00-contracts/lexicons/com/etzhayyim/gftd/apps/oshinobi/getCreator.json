{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.oshinobi.getCreator",
  "defs": {
    "main": {
      "type": "query",
      "description": "Public profile view. Returns creator metadata + active tier list + tier-locked post count. Never returns PII / payout state.",
      "parameters": {
        "type": "params",
        "required": ["creatorDid"],
        "properties": {
          "creatorDid": { "type": "string", "format": "did" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["creatorDid", "displayName", "contentPolicy", "tiers"],
          "properties": {
            "creatorDid":    { "type": "string", "format": "did" },
            "displayName":   { "type": "string" },
            "bio":           { "type": "string" },
            "contentPolicy": { "type": "string" },
            "verified":      { "type": "boolean" },
            "createdAt":     { "type": "string", "format": "datetime" },
            "tiers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["tierId", "name", "priceUsdCents", "billingPeriod"],
                "properties": {
                  "tierId":         { "type": "string" },
                  "name":           { "type": "string" },
                  "priceUsdCents":  { "type": "integer" },
                  "billingPeriod":  { "type": "string", "enum": ["monthly", "quarterly", "yearly"] },
                  "benefits":       { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    }
  }
}
