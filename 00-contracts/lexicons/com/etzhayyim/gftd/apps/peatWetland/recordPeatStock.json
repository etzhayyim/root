{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.peatWetland.recordPeatStock",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Peat / wetland carbon stock (Ramsar / Global Peatlands Initiative — bridges soil-carbon + forestry-mrv + biodiversity-gbf + coastal-slr)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "stockId",
            "siteName",
            "countryIso3",
            "wetlandType",
            "areaHectares",
            "recordedAt"
          ],
          "properties": {
            "stockId": {
              "type": "string"
            },
            "siteName": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "wetlandType": {
              "type": "string",
              "enum": [
                "bog",
                "fen",
                "mire",
                "mangrove",
                "tidal_marsh",
                "swamp_forest",
                "seagrass",
                "floodplain"
              ]
            },
            "areaHectares": {
              "type": "number"
            },
            "peatDepthM": {
              "type": "number"
            },
            "carbonStockTonnesHa": {
              "type": "number"
            },
            "ramsarListed": {
              "type": "boolean"
            },
            "recordedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "conservationPriorityTier": {
              "type": "string",
              "enum": [
                "standard",
                "blue_carbon",
                "international"
              ]
            }
          }
        }
      }
    }
  }
}