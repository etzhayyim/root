{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.bpmn.deployProcess",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Deploy a BPMN process (JSON subset or XML). Stores XML to B2 + metadata to D1 + graph projection.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "json": { "type": "unknown" },
            "xml": { "type": "string" },
            "name": { "type": "string" },
            "version": { "type": "integer", "default": 1 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "processId": { "type": "string" },
            "name": { "type": "string" },
            "version": { "type": "integer" },
            "xmlR2Key": { "type": "string" },
            "jsonR2Key": { "type": "string" },
            "deployedAt": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
