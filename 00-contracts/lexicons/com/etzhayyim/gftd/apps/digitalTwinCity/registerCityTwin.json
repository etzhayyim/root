{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.digitalTwinCity.registerCityTwin",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Smart-city digital twin (NIST SCF / ISO 37120 / ETSI OCF — bridges urban-heat + urban-mobility + coastal-slr + otel-observability)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "twinId",
            "cityUnlocode",
            "standard",
            "commissionedAt"
          ],
          "properties": {
            "twinId": {
              "type": "string"
            },
            "operatorLei": {
              "type": "string"
            },
            "cityUnlocode": {
              "type": "string"
            },
            "standard": {
              "type": "string",
              "enum": [
                "nist_scf",
                "iso_37120",
                "etsi_ocf",
                "city_protocol",
                "ogc_city_gml"
              ]
            },
            "scopeDomains": {
              "type": "string",
              "description": "comma: energy,water,mobility,buildings,environment,public_safety,waste,health"
            },
            "dataSovereigntyModel": {
              "type": "string",
              "enum": [
                "municipal",
                "national",
                "federated",
                "vendor_locked",
                "open_data_trust"
              ]
            },
            "sensorCount": {
              "type": "integer"
            },
            "commissionedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}