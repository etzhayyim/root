{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.dataBrokerRegistry.flagEnforcement",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Data broker enforcement action (CPPA / CFPB / FTC / EDPB)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "actionId",
            "brokerVid",
            "enforcer",
            "violation",
            "actedAt"
          ],
          "properties": {
            "actionId": {
              "type": "string"
            },
            "brokerVid": {
              "type": "string",
              "description": "bridges registerBroker"
            },
            "enforcer": {
              "type": "string",
              "enum": [
                "cppa",
                "cfpb",
                "ftc",
                "edpb",
                "doj",
                "state_ag",
                "dma_compliance"
              ]
            },
            "violation": {
              "type": "string"
            },
            "fineUsd": {
              "type": "number"
            },
            "remedyRequired": {
              "type": "string"
            },
            "actedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}