{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.minorityRights.recordReportFinding",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "CERD / CCPR / UN minority rights report (bridges bilingualEducation.flagOutcomeGap + indigenous-rights + crpd-disability)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "findingId",
            "countryIso3",
            "treatyBody",
            "minorityKind",
            "concludedAt"
          ],
          "properties": {
            "findingId": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "treatyBody": {
              "type": "string",
              "enum": [
                "cerd",
                "ccpr",
                "cescr",
                "cedaw",
                "crc",
                "crpd",
                "cat",
                "un_minority",
                "undrip_mandate",
                "oas_iachr",
                "echr",
                "af_commission",
                "osce_mins"
              ]
            },
            "minorityKind": {
              "type": "string",
              "enum": [
                "ethnic",
                "religious",
                "linguistic",
                "indigenous",
                "national_minority",
                "migrant",
                "stateless_descendant",
                "caste_based",
                "lgbtqi",
                "disability",
                "women",
                "children"
              ]
            },
            "outcomeGapVid": {
              "type": "string",
              "description": "bridges bilingualEducation.flagOutcomeGap"
            },
            "concludedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}