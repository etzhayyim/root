{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.oilMidstream.listAssets",
  "defs": {
    "main": {
      "type": "query",
      "description": "List midstream pipeline / storage / terminal assets with optional chokepoint filter.",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "properties": {
          "assetType": { "type": "string" },
          "operatorDid": { "type": "string", "format": "did" },
          "originCountry": { "type": "string" },
          "destinationCountry": { "type": "string" },
          "chokepoint": { "type": "string", "enum": ["hormuz", "malacca", "bab-el-mandeb", "suez", "panama", "bosphorus", "danish-straits"] },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "required": ["assets", "total", "offset", "limit"], "properties": { "assets": { "type": "array", "items": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "name": { "type": "string" }, "assetType": { "type": "string" }, "capacityBopd": { "type": "number" }, "chokepointExposure": { "type": "array", "items": { "type": "string" } } } } }, "total": { "type": "integer" }, "offset": { "type": "integer" }, "limit": { "type": "integer" } } } }
    }
  }
}
