{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.nokyo.farm",
  "description": "組合員が耕作する圃場。筆単位 (parcel) で登記。田/畑/樹園/牧草地/施設園芸。",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["farmId", "memberId", "landUse", "areaM2"],
        "properties": {
          "farmId": { "type": "string", "description": "圃場 ID (coop 内一意)" },
          "memberId": { "type": "string" },
          "landUse": { "type": "string", "enum": ["paddy", "field", "orchard", "pasture", "greenhouse"], "description": "田/畑/樹園/牧草地/施設園芸" },
          "areaM2": { "type": "number", "description": "面積 (㎡)" },
          "prefCode": { "type": "string" },
          "cityCode": { "type": "string", "description": "JIS X 0402 市区町村コード" },
          "parcelNumber": { "type": "string", "description": "地番" },
          "latitude": { "type": "number" },
          "longitude": { "type": "number" },
          "soilType": { "type": "string" }
        }
      }
    }
  }
}
