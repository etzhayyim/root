{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.nokyo.cropPlan",
  "description": "作付計画。JA 営農指導員のレビュー対象。submit 時に subscribeRepos → advisoryNote 自動生成 (農薬取締法 / 輪作 / 気候適性 AI 審査)。",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["cropPlanId", "memberId", "farmId", "cropName", "season"],
        "properties": {
          "cropPlanId": { "type": "string" },
          "memberId": { "type": "string" },
          "farmId": { "type": "string" },
          "coopPath": { "type": "string" },
          "prefCode": { "type": "string" },
          "cropName": { "type": "string", "description": "作物名 (例 コシヒカリ / キャベツ / いちご)" },
          "cropCategory": { "type": "string", "enum": ["rice", "vegetable", "fruit", "grain", "flower", "livestock", "other"] },
          "season": { "type": "string", "description": "作期 (例 2026-spring)" },
          "plantingDate": { "type": "string", "format": "date" },
          "harvestDate": { "type": "string", "format": "date" },
          "expectedYieldKg": { "type": "number" },
          "fertilizerPlan": { "type": "string", "description": "施肥計画 JSON" },
          "pesticidePlan": { "type": "string", "description": "防除計画 JSON (農薬登録番号含む)" },
          "quotaKg": { "type": "number", "description": "共販出荷数量目安" }
        }
      }
    }
  }
}
