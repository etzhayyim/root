{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.nokyo.listMembers",
  "defs": {
    "main": {
      "type": "query",
      "description": "List JA members scoped by coopPath / prefCode / memberType.",
      "parameters": {
        "type": "params",
        "properties": {
          "coopPath": { "type": "string" },
          "prefCode": { "type": "string" },
          "memberType": { "type": "string", "enum": ["regular", "associate", "corporate"] },
          "limit": { "type": "integer", "default": 50, "maximum": 500 },
          "offset": { "type": "integer", "default": 0 }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "members": { "type": "array", "items": { "type": "unknown" } },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          },
          "required": ["members"]
        }
      }
    }
  }
}
