{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.playwright.waitFor",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Wait for a selector or a page load state.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sessionId"],
          "properties": {
            "sessionId": { "type": "string" },
            "selector": { "type": "string" },
            "state": { "type": "string", "enum": ["load", "domcontentloaded", "networkidle", "visible", "hidden"] },
            "timeout": { "type": "integer", "default": 30000, "maximum": 120000 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "error": { "type": "string" } } }
      }
    }
  }
}
