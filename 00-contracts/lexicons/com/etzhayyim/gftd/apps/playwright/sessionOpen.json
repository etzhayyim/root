{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.playwright.sessionOpen",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Open a Playwright browser session. Target selects execution substrate.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "target": { "type": "string", "enum": ["local", "cf-browser"], "default": "local" },
            "userAgent": { "type": "string" },
            "locale": { "type": "string" },
            "viewport": {
              "type": "object",
              "properties": { "width": { "type": "integer" }, "height": { "type": "integer" } }
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "sessionId": { "type": "string" },
            "target": { "type": "string" },
            "expiresAt": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
