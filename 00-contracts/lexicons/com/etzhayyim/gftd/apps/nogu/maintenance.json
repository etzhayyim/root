{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.nogu.maintenance",
  "description": "農具・農機具の修理・整備記録。部品交換・オイル交換・刃研磨等を記録。tsukuru メーカーへの修理依頼と連携可。",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["itemId", "maintenanceType", "performedAt", "performerDid"],
        "properties": {
          "itemId": { "type": "string" },
          "triggerInspectionRkey": { "type": "string", "description": "起因した inspection レコードの rkey" },
          "maintenanceType": {
            "type": "string",
            "enum": ["repair", "part-replacement", "oil-change", "blade-sharpening", "cleaning", "overhaul", "other"],
            "description": "修理/部品交換/オイル交換/刃研磨/清掃/オーバーホール/その他"
          },
          "performedAt": { "type": "string", "format": "date" },
          "performerDid": { "type": "string", "description": "整備者 DID (農協整備士または外部業者)" },
          "partsUsed": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["partName", "quantity"],
              "properties": {
                "partName": { "type": "string" },
                "partNumber": { "type": "string" },
                "quantity": { "type": "number" },
                "unitPriceJpy": { "type": "number" }
              }
            }
          },
          "laborCostJpy": { "type": "number" },
          "totalCostJpy": { "type": "number" },
          "status": { "type": "string", "enum": ["completed", "in-progress", "pending-parts"] },
          "completedAt": { "type": "string", "format": "date" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
