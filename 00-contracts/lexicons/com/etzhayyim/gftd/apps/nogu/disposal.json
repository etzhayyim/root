{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.nogu.disposal",
  "description": "農具・農機具の廃棄記録。農機リサイクル法対応。廃棄後は item.status=retired に更新。",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["itemId", "disposedAt", "disposalMethod", "authorizedByDid"],
        "properties": {
          "itemId": { "type": "string" },
          "disposedAt": { "type": "string", "format": "date" },
          "disposalMethod": {
            "type": "string",
            "enum": ["recycler", "sold-used", "scrapped", "donated", "returned-to-maker"],
            "description": "リサイクル業者/中古売却/解体廃棄/寄贈/メーカー返却"
          },
          "authorizedByDid": { "type": "string" },
          "recyclerName": { "type": "string" },
          "recyclerLicenseNo": { "type": "string", "description": "農機リサイクル法登録番号" },
          "salvageValueJpy": { "type": "number" },
          "disposalCostJpy": { "type": "number" },
          "certificateId": { "type": "string", "description": "廃棄証明書番号" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
