{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.codexStandard.flagNonHarmonization",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Non-harmonization / national deviation / transition period (bridges foodFraud.flagNetwork + wto-trade-cbam + rasff-food-safety)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "adoptionVid",
            "issueKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "adoptionVid": {
              "type": "string",
              "description": "bridges recordStandardAdoption"
            },
            "issueKind": {
              "type": "string",
              "enum": [
                "stricter_national",
                "weaker_national",
                "transition_delay",
                "private_standard_super",
                "regional_divergence",
                "eu_vs_fda",
                "multi_sector_conflict",
                "jurisdiction_gap",
                "enforcement_divergence",
                "data_gap_lmics"
              ]
            },
            "affectedCountriesCount": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}