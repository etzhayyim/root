{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.impeachmentTrial.flagPartisanVote",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Partisan vote pattern / threshold gaming (bridges judicialMisconductBoard.flagOutcomeBias + transnational-repression + civil-liability)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "trialVid",
            "votePatternKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "trialVid": {
              "type": "string",
              "description": "bridges recordTrial"
            },
            "votePatternKind": {
              "type": "string",
              "enum": [
                "near_unanimous",
                "strict_party_line",
                "threshold_2_3",
                "threshold_3_4",
                "absent_strategic",
                "cross_party_few",
                "resignation_pre_vote",
                "censure_only",
                "witness_blocked",
                "subpoena_quashed",
                "public_hearing_denied"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}