{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.eResidency.recordProgram",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "e-residency / digital nomad / RBI program (EE / UAE / PRT D7 / CR / JP — bridges digital-identity + credential-portability + tax-transparency + migrant-worker-welfare)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "programId",
            "countryIso3",
            "programKind",
            "launchedAt"
          ],
          "properties": {
            "programId": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "programKind": {
              "type": "string",
              "enum": [
                "e_residency",
                "digital_nomad",
                "golden_visa",
                "rbi",
                "cbi",
                "digital_nomad_family",
                "startup_visa"
              ]
            },
            "eligibilityMinIncomeUsd": {
              "type": "number"
            },
            "taxTreatment": {
              "type": "string",
              "enum": [
                "territorial",
                "residence_based",
                "flat_rate",
                "exempt",
                "worldwide"
              ]
            },
            "issuingAgencyLei": {
              "type": "string"
            },
            "launchedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}