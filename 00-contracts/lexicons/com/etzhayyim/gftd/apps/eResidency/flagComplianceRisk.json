{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.eResidency.flagComplianceRisk",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "AML / sanctions / tax risk in residency scheme (bridges ofac-sanctions + tax-transparency + fatf-travel-rule + antitrust-dma)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "riskId",
            "programVid",
            "concern",
            "reportedAt"
          ],
          "properties": {
            "riskId": {
              "type": "string"
            },
            "programVid": {
              "type": "string",
              "description": "bridges recordProgram"
            },
            "concern": {
              "type": "string",
              "enum": [
                "money_laundering",
                "sanctions_evasion",
                "tax_evasion",
                "pep_exposure",
                "security_risk",
                "reputation"
              ]
            },
            "authorityAction": {
              "type": "string",
              "enum": [
                "review_ordered",
                "visa_suspension",
                "program_frozen",
                "individual_revocation",
                "diplomatic_downgrade"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}