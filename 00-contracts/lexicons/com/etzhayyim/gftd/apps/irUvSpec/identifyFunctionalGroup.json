{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.irUvSpec.identifyFunctionalGroup",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Identify functional groups from IR spectrum or electronic transitions from UV-Vis. Auto-generated stub (coverage expansion 2026-04-17).",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["technique", "peaks"],
          "properties": {
            "technique": { "type": "string", "enum": ["FTIR", "ATR", "UV-Vis"] },
            "peaks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "wavenumberOrNm": { "type": "number" },
                  "intensity": { "type": "number" }
                }
              }
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "functionalGroups": { "type": "array", "items": { "type": "string" } },
            "transitions": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
