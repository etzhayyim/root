{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.correspondentBanking.recordNostroRelation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Correspondent / Nostro-Vostro banking relation (bridges kycOnboarding.flagSuspiciousActivity + swift-institution + fatf-travel-rule)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "relationId",
            "respondentCountryIso3",
            "relationKind",
            "onboardedAt"
          ],
          "properties": {
            "relationId": {
              "type": "string"
            },
            "correspondentLei": {
              "type": "string"
            },
            "respondentLei": {
              "type": "string"
            },
            "respondentCountryIso3": {
              "type": "string"
            },
            "relationKind": {
              "type": "string",
              "enum": [
                "nostro",
                "vostro",
                "payable_through",
                "cpa",
                "rentabilization",
                "nested",
                "fx_clearing",
                "trade_finance",
                "securities_settle"
              ]
            },
            "sarVid": {
              "type": "string",
              "description": "bridges kycOnboarding.flagSuspiciousActivity"
            },
            "onboardedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}