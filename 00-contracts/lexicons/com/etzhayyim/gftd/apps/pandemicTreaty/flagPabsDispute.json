{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.pandemicTreaty.flagPabsDispute",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "PABS (Pathogen Access & Benefit-Sharing) dispute (bridges itpgrfa-seeds + pharma-supply + bbnj-highseas)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "disputeId",
            "pathogen",
            "originIso3",
            "issueKind",
            "reportedAt"
          ],
          "properties": {
            "disputeId": {
              "type": "string"
            },
            "commitmentVid": {
              "type": "string",
              "description": "bridges recordCommitment"
            },
            "pathogen": {
              "type": "string"
            },
            "originIso3": {
              "type": "string"
            },
            "recipientLei": {
              "type": "string"
            },
            "issueKind": {
              "type": "string",
              "enum": [
                "access_denial",
                "benefit_sharing",
                "sequencing_leak",
                "ipr_claim",
                "timeline_delay",
                "data_sharing_refusal"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}