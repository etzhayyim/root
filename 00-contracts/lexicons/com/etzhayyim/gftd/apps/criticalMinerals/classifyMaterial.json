{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.criticalMinerals.classifyMaterial",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Critical raw material classification (USGS 2022 / EU CRMA / China / Japan — bridges open-hs + commodity-trade)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "classificationId",
            "hsCode",
            "materialName",
            "usgsCritical",
            "euStrategic",
            "classifiedAt"
          ],
          "properties": {
            "classificationId": {
              "type": "string"
            },
            "hsCode": {
              "type": "string",
              "description": "bridges open-hs"
            },
            "materialName": {
              "type": "string"
            },
            "usgsCritical": {
              "type": "boolean",
              "description": "USGS 2022 critical list"
            },
            "euStrategic": {
              "type": "boolean",
              "description": "EU CRMA 2023 strategic"
            },
            "jpStockpiled": {
              "type": "boolean",
              "description": "JOGMEC stockpile list"
            },
            "chinaControlled": {
              "type": "boolean",
              "description": "China export control"
            },
            "primaryUseSector": {
              "type": "string",
              "enum": [
                "evs",
                "semiconductors",
                "defense",
                "renewables",
                "electronics",
                "aerospace",
                "medical"
              ]
            },
            "classifiedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "riskTier": {
              "type": "string",
              "enum": [
                "low",
                "moderate",
                "high",
                "extreme"
              ]
            }
          }
        }
      }
    }
  }
}