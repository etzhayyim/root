{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.spaceTraffic.flagConjunction",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Conjunction data message (CDM) against two tracked objects",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "conjunctionId",
            "primaryObjectVid",
            "secondaryObjectVid",
            "tcaUtc",
            "missDistanceM",
            "assessedAt"
          ],
          "properties": {
            "conjunctionId": {
              "type": "string"
            },
            "primaryObjectVid": {
              "type": "string",
              "description": "bridges catalogObject"
            },
            "secondaryObjectVid": {
              "type": "string",
              "description": "bridges catalogObject"
            },
            "tcaUtc": {
              "type": "string",
              "description": "time of closest approach"
            },
            "missDistanceM": {
              "type": "number"
            },
            "probabilityCollision": {
              "type": "number"
            },
            "assessedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "riskTier": {
              "type": "string",
              "enum": [
                "monitor",
                "high_interest",
                "emergency_maneuver"
              ]
            }
          }
        }
      }
    }
  }
}