{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.carrierCapacity.recordBlankedSailing",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Blanked sailing",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "blankedId",
            "carrierCode",
            "stringCode",
            "skippedWeeks",
            "effectiveFrom"
          ],
          "properties": {
            "blankedId": {
              "type": "string"
            },
            "carrierCode": {
              "type": "string"
            },
            "stringCode": {
              "type": "string"
            },
            "skippedWeeks": {
              "type": "integer"
            },
            "teuRemovedTotal": {
              "type": "number"
            },
            "reason": {
              "type": "string",
              "enum": [
                "demand-weakness",
                "drydock",
                "strike",
                "weather",
                "port-congestion",
                "holiday"
              ]
            },
            "effectiveFrom": {
              "type": "string",
              "format": "date"
            },
            "effectiveUntil": {
              "type": "string",
              "format": "date"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "impactTier": {
              "type": "string",
              "enum": [
                "minor",
                "moderate",
                "major"
              ]
            },
            "requireShipperNotice": {
              "type": "boolean"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
