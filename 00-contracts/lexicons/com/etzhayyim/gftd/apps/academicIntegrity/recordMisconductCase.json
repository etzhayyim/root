{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.academicIntegrity.recordMisconductCase",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Research misconduct case (ORI / UKRIO / JSPS — bridges ai-governance + precision-medicine + misinformation-observatory + press-freedom)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "caseId",
            "jurisdictionIso3",
            "misconductKind",
            "investigationStage",
            "openedAt"
          ],
          "properties": {
            "caseId": {
              "type": "string"
            },
            "subjectOrcid": {
              "type": "string"
            },
            "institutionLei": {
              "type": "string"
            },
            "jurisdictionIso3": {
              "type": "string"
            },
            "misconductKind": {
              "type": "string",
              "enum": [
                "fabrication",
                "falsification",
                "plagiarism",
                "image_manipulation",
                "ai_undisclosed",
                "authorship_abuse",
                "peer_review_manipulation",
                "data_retention_failure",
                "ethics_violation"
              ]
            },
            "investigationStage": {
              "type": "string",
              "enum": [
                "inquiry",
                "investigation",
                "finding",
                "appeal",
                "closed"
              ]
            },
            "retractionsCount": {
              "type": "integer"
            },
            "openedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}