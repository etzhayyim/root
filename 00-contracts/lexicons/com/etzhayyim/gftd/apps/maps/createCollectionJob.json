{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.createCollectionJob",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create a maps collection job, including street-chunk reconstruction pipelines derived from Mapillary sequences.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "sourceId": { "type": "string" },
            "datasetType": { "type": "string" },
            "priority": { "type": "string" },
            "region": { "type": "string" },
            "pipelineType": { "type": "string", "enum": ["street_chunk", "poi_import", "satellite_scene", "vision_analysis"] },
            "stage": {
              "type": "string",
              "enum": ["sequence_select", "frame_admit", "chunk_assign", "coverage_score", "reconstruct", "bake", "publish"]
            },
            "sequenceId": { "type": "string" },
            "chunkKey": { "type": "string" },
            "chunkSizeMeters": { "type": "integer", "enum": [25, 50, 100] },
            "bbox": { "type": "object" },
            "coverageThresholdRatio": { "type": "number" },
            "headingThresholdDeg": { "type": "number" },
            "frameThresholdCount": { "type": "integer" }
          },
          "required": [
            "sourceId"
          ]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            },
            "jobId": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "stage": {
              "type": "string"
            },
            "pipelineType": {
              "type": "string"
            },
            "chunkSizeMeters": {
              "type": "integer"
            },
            "sequenceId": {
              "type": "string"
            },
            "chunkKey": {
              "type": "string"
            }
          },
          "required": []
        }
      }
    }
  }
}
