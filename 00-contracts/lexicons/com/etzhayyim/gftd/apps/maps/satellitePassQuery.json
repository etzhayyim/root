{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.satellitePassQuery",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Query upcoming satellite passes for an arbitrary observer location and time window. If the observer cell has pre-computed passes (vertex_satellite_pass), they are returned from cache; otherwise the BPMN dispatcher invokes satellite.pass.compute on demand (SGP4).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["lat", "lon", "windowH"],
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 },
            "windowH": { "type": "integer", "minimum": 1, "maximum": 168, "default": 24 },
            "minElevationDeg": { "type": "number", "default": 10, "minimum": 0, "maximum": 90 },
            "noradIds": { "type": "array", "items": { "type": "integer" }, "description": "Filter to specific NORAD catalog numbers; defaults to active group." },
            "catalogGroup": { "type": "string", "default": "active" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["passes", "count", "computedAtMs"],
          "properties": {
            "passes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "noradId": { "type": "integer" },
                  "name": { "type": "string" },
                  "aosMs": { "type": "integer" },
                  "losMs": { "type": "integer" },
                  "tcaMs": { "type": "integer" },
                  "maxElevationDeg": { "type": "number" },
                  "peakAzimuthDeg": { "type": "number" },
                  "visibleAtNight": { "type": "boolean" },
                  "magnitude": { "type": "number" }
                }
              }
            },
            "count": { "type": "integer" },
            "computedAtMs": { "type": "integer" },
            "fromCache": { "type": "boolean" }
          }
        }
      }
    }
  }
}
