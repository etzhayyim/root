{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.latentWorldModelRun",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Run maps Bayesian latent world-model inference over digital twin, sensor, and spatial event rows. Produces WorldBelief, TwinState, Forecast, and WorldModelRun records.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "entityId": { "type": "string" },
            "entityType": { "type": "string" },
            "targetArea": { "type": "string" },
            "hypothesis": { "type": "string" },
            "prior": { "type": "number", "minimum": 0, "maximum": 1 },
            "likelihood": { "type": "number", "minimum": 0, "maximum": 1 },
            "horizonSeconds": { "type": "integer", "minimum": 1 },
            "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
            "modelVersion": { "type": "string" }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "error": { "type": "string" },
            "runId": { "type": "string" },
            "modelVersion": { "type": "string" },
            "hypothesis": { "type": "string" },
            "updates": {
              "type": "array",
              "items": { "type": "unknown" }
            },
            "status": { "type": "string" }
          },
          "required": []
        }
      }
    }
  }
}
