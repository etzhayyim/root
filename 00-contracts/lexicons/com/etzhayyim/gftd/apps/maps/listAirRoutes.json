{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.listAirRoutes",
  "defs": {
    "main": {
      "type": "query",
      "description": "List air routes with optional airport/operator filters.",
      "parameters": {
        "type": "params",
        "properties": {
          "routeDid": {
            "type": "string"
          },
          "originAirportDid": {
            "type": "string",
            "format": "did"
          },
          "destinationAirportDid": {
            "type": "string",
            "format": "did"
          },
          "operatorDid": {
            "type": "string",
            "format": "did"
          },
          "flightNumber": {
            "type": "string"
          },
          "limit": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["routes", "total", "offset", "limit"],
          "properties": {
            "routes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "routeDid": { "type": "string", "format": "did" },
                  "name": { "type": "string" },
                  "flightNumber": { "type": "string" },
                  "originAirportDid": { "type": "string", "format": "did" },
                  "destinationAirportDid": { "type": "string", "format": "did" },
                  "operatorDid": { "type": "string", "format": "did" },
                  "distanceKm": { "type": "number" },
                  "scheduledDurationMin": { "type": "integer" },
                  "serviceType": { "type": "string" }
                }
              }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
