{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.seedAllKnownVariations",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Auto-expand frontier with all known (source × label) combinations declared in the Worker: every WIKIDATA_PROFILES entry, STAC collection, and OVERPASS_LABEL_FILTER label. Idempotent — existing rows skipped.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "dryRun": { "type": "boolean", "default": false }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "candidateCount": { "type": "integer" },
            "inserted": { "type": "integer" },
            "skippedExisting": { "type": "integer" },
            "byKind": {
              "type": "object",
              "properties": {
                "wikidata": { "type": "integer" },
                "stac": { "type": "integer" },
                "overpass": { "type": "integer" }
              }
            },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
