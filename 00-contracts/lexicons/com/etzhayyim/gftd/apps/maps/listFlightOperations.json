{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.listFlightOperations",
  "defs": {
    "main": {
      "type": "query",
      "description": "List flight operation snapshots by aircraft/flight/operator with delay and occupancy filters.",
      "parameters": {
        "type": "params",
        "properties": {
          "aircraftDid": { "type": "string", "format": "did" },
          "flightNumber": { "type": "string" },
          "operatorDid": { "type": "string", "format": "did" },
          "status": { "type": "string" },
          "minDelayMinutes": { "type": "integer" },
          "maxDelayMinutes": { "type": "integer" },
          "minOccupancyRate": { "type": "number" },
          "asOfFrom": { "type": "string", "format": "datetime" },
          "asOfTo": { "type": "string", "format": "datetime" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 },
          "offset": { "type": "integer", "minimum": 0, "default": 0 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["operations", "total", "offset", "limit"],
          "properties": {
            "operations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "flightDid": { "type": "string", "format": "did" },
                  "flightNumber": { "type": "string" },
                  "aircraftDid": { "type": "string", "format": "did" },
                  "operatorDid": { "type": "string", "format": "did" },
                  "status": { "type": "string" },
                  "delayMinutes": { "type": "integer" },
                  "occupancyRate": { "type": "number" },
                  "revenue": { "type": "number" },
                  "cost": { "type": "number" },
                  "profit": { "type": "number" },
                  "currency": { "type": "string" },
                  "asOf": { "type": "string", "format": "datetime" }
                }
              }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
