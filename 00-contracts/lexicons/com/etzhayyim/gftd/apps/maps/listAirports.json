{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.listAirports",
  "defs": {
    "main": {
      "type": "query",
      "description": "List airports with optional country/operator filters.",
      "parameters": {
        "type": "params",
        "properties": {
          "country": {
            "type": "string"
          },
          "operatorDid": {
            "type": "string",
            "format": "did"
          },
          "q": {
            "type": "string",
            "description": "Name/ICAO/IATA prefix query."
          },
          "limit": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["airports", "total", "offset", "limit"],
          "properties": {
            "airports": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "airportDid": { "type": "string", "format": "did" },
                  "name": { "type": "string" },
                  "icao": { "type": "string" },
                  "iata": { "type": "string" },
                  "country": { "type": "string" },
                  "city": { "type": "string" },
                  "operatorDid": { "type": "string", "format": "did" },
                  "lat": { "type": "number" },
                  "lng": { "type": "number" }
                }
              }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
