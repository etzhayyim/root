{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.batchCoverageCycle",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Run one full coverage cycle in a single call: advance N gaps → run all jobs in parallel → optional refresh. Reduces heartbeat HTTP overhead from 3 round-trips to 1.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "advanceLimit": { "type": "integer", "minimum": 1, "maximum": 10, "default": 5 },
            "maxRecordsPerJob": { "type": "integer", "minimum": 1, "maximum": 500, "default": 60 },
            "refresh": { "type": "boolean", "default": false, "description": "Run refreshCoverageStats at end of cycle" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "advanced": { "type": "integer" },
            "ran": { "type": "integer" },
            "totalRowsWritten": { "type": "integer" },
            "runs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "jobId": { "type": "string" },
                  "sourceDid": { "type": "string" },
                  "label": { "type": "string" },
                  "dispatchKind": { "type": "string" },
                  "status": { "type": "string" },
                  "recordsWritten": { "type": "integer" },
                  "error": { "type": "string" }
                }
              }
            },
            "refreshUpdated": { "type": "integer" },
            "totalCollected": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
