{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.iryo.agentLoop",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Path F unified agent loop entry (ADR 260413). Pulls bed occupancy + 30d admission counts + recent DRG P&L + WHO/OECD KPI context, runs LLM with iryo hospital-ops system prompt, returns response. No state mutation.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["prompt"],
          "properties": {
            "prompt": {"type": "string", "maxLength": 4000},
            "tier": {"type": "string", "enum": ["fast", "balanced", "reasoning", "frontier"], "default": "reasoning"},
            "deptFocus": {"type": "string"},
            "maxTokens": {"type": "integer", "default": 1500, "minimum": 50, "maximum": 4000}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "content", "model"],
          "properties": {
            "ok": {"type": "boolean"},
            "content": {"type": "string"},
            "model": {"type": "string"},
            "latencyMs": {"type": "integer"},
            "occupancyRowsUsed": {"type": "integer"},
            "admissionRowsUsed": {"type": "integer"},
            "drgPnlRowsUsed": {"type": "integer"},
            "kpiRowsUsed": {"type": "integer"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
