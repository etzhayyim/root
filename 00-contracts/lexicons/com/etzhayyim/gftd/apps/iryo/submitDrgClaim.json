{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.iryo.submitDrgClaim",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Finalize a DRG claim: status draft→submitted. Coder/auditor records package_points + tariff_system. Phase 1 has no payer adapter, so submitted claims simply settle in the iryo graph. Phase 2 adds payer integration + denial reactive flow.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["claimId", "packagePoints", "tariffSystem"],
          "properties": {
            "claimId": {"type": "string"},
            "drgCode": {"type": "string"},
            "packagePoints": {"type": "number", "description": "DRG package points × tariff multiplier. JP DPC=pt; US MS-DRG=relative-weight × base-rate."},
            "tariffSystem": {"type": "string", "enum": ["JP_DPC", "US_MS_DRG", "EU_AR_DRG", "AU_AR_DRG", "OTHER"]},
            "auditorDid": {"type": "string"}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": {"type": "boolean"},
            "claimId": {"type": "string"},
            "status": {"type": "string"},
            "submittedAtMs": {"type": "integer"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
