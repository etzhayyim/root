{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.barAssociationRecall.recordRecall",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Bar / law-society professional discipline (bridges judicialAppointment.flagPoliticization + ethics-disclosure + judge-rapporteur)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "recallId",
            "barJurisdiction",
            "respondentRole",
            "violationKind",
            "filedAt"
          ],
          "properties": {
            "recallId": {
              "type": "string"
            },
            "barJurisdiction": {
              "type": "string"
            },
            "respondentRole": {
              "type": "string",
              "enum": [
                "practicing_lawyer",
                "judge",
                "prosecutor",
                "public_defender",
                "corporate_counsel",
                "government_lawyer",
                "bar_committee",
                "former_judge",
                "retired",
                "disbarred_seeking_reinstatement"
              ]
            },
            "violationKind": {
              "type": "string",
              "enum": [
                "misappropriation",
                "ethics_violation",
                "conflict_of_interest",
                "filing_false",
                "frivolous_litigation",
                "abuse_of_process",
                "client_abandon",
                "mandatory_reporting_fail",
                "false_advertising",
                "gross_negligence",
                "insurrection",
                "pro_hac_vice"
              ]
            },
            "politicizationVid": {
              "type": "string",
              "description": "bridges judicialAppointment.flagPoliticization"
            },
            "filedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}