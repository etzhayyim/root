{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.energyPoverty.recordHouseholdMetric",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Energy poverty / access (SDG 7.1 / IEA Access / EU EPAH — bridges universal-health-coverage + housing-affordability + urban-heat + climate-adaptation-finance)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "metricId",
            "countryIso3",
            "indicator",
            "reportingYear",
            "reportedAt"
          ],
          "properties": {
            "metricId": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "indicator": {
              "type": "string",
              "enum": [
                "electricity_access_pct",
                "clean_cooking_access_pct",
                "energy_expenditure_pct_income",
                "tier_of_access",
                "arrears_on_utility_bills_pct",
                "unable_to_keep_home_warm_pct",
                "unable_to_cool_home_pct"
              ]
            },
            "valueNumeric": {
              "type": "number"
            },
            "reportingYear": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}