{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.pressFreedom.flagJournalistIncident",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Journalist attack / arrest / killing (bridges ofac-sanctions + indigenous-rights + forced-labor)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "incidentId",
            "incidentType",
            "affectedCount",
            "locationIso3",
            "reportedAt"
          ],
          "properties": {
            "incidentId": {
              "type": "string"
            },
            "indexRecordVid": {
              "type": "string",
              "description": "bridges recordIndex"
            },
            "incidentType": {
              "type": "string",
              "enum": [
                "killed",
                "imprisoned",
                "harassed",
                "surveilled",
                "exiled",
                "legal_prosecution",
                "online_attack",
                "physical_attack",
                "equipment_seizure"
              ]
            },
            "affectedCount": {
              "type": "integer"
            },
            "locationIso3": {
              "type": "string"
            },
            "perpetratorCategory": {
              "type": "string",
              "enum": [
                "state",
                "non_state",
                "organized_crime",
                "political_actor",
                "unknown"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "serious",
                "severe",
                "fatal"
              ]
            }
          }
        }
      }
    }
  }
}