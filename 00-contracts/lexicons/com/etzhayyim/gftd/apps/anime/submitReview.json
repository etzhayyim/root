{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.anime.submitReview",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Submit a viewer review for an anime title.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["title_id"],
          "properties": {
            "title_id": { "type": "string" },
            "reviewer_did": { "type": "string" },
            "rating": { "type": "integer" },
            "body": { "type": "string" },
            "org_id": { "type": "string" },
            "user_id": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": { "id": { "type": "string" } } }
      }
    }
  }
}
