{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.anime.listEpisodes",
  "defs": {
    "main": {
      "type": "query",
      "description": "List episodes for a season.",
      "parameters": {
        "type": "params",
        "required": ["season_id"],
        "properties": {
          "season_id": { "type": "string" },
          "limit": { "type": "integer" },
          "offset": { "type": "integer" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "episodes": { "type": "array", "items": { "type": "object" } },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
