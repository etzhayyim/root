{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.precisionMedicine.flagSecondaryUse",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Secondary-use request / denial / misuse (bridges data-adequacy + itpgrfa-seeds + cyber-compliance)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "requestId",
            "trustVid",
            "intendedUse",
            "decision",
            "decidedAt"
          ],
          "properties": {
            "requestId": {
              "type": "string"
            },
            "trustVid": {
              "type": "string",
              "description": "bridges registerDataTrust"
            },
            "requesterLei": {
              "type": "string"
            },
            "intendedUse": {
              "type": "string",
              "enum": [
                "research",
                "commercial",
                "insurance",
                "law_enforcement",
                "population_screening",
                "ancestry",
                "ml_training"
              ]
            },
            "decision": {
              "type": "string",
              "enum": [
                "approved",
                "approved_with_conditions",
                "denied",
                "withdrawn",
                "under_review"
              ]
            },
            "reviewBody": {
              "type": "string",
              "enum": [
                "irb",
                "data_access_committee",
                "ethics_board",
                "indigenous_council",
                "regulator"
              ]
            },
            "decidedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "sensitivityTier": {
              "type": "string",
              "enum": [
                "standard",
                "elevated",
                "high"
              ]
            }
          }
        }
      }
    }
  }
}