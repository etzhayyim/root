{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.natureMarkets.flagDoubleClaim",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Double-claim / greenwashing / stacking concern (bridges climate-value-chain + cdr-verification + esg-risk-rating)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "creditVid",
            "issueKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "creditVid": {
              "type": "string",
              "description": "bridges registerBiodiversityCredit"
            },
            "issueKind": {
              "type": "string",
              "enum": [
                "double_claim",
                "carbon_nature_stack",
                "no_additionality",
                "baseline_manipulation",
                "leakage",
                "permanence"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "moderate",
                "significant",
                "severe"
              ]
            }
          }
        }
      }
    }
  }
}