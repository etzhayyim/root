{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.etzhayyim.yobel.listRites",
  "defs": {
    "main": {
      "type": "query",
      "description": "Rite 一覧 (riteType / status / issuer / period filter)。pagination 必須 (limit/offset)。",
      "parameters": {
        "type": "params",
        "properties": {
          "riteType": {
            "type": "string",
            "enum": [
              "shmita_7yr",
              "yobel_50yr",
              "tokusei_rei",
              "religious_jubilee",
              "political_amnesty"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "declared",
              "active",
              "completed",
              "cancelled",
              "superseded"
            ]
          },
          "issuerDid": {
            "type": "string"
          },
          "effectiveFrom": {
            "type": "string",
            "format": "datetime"
          },
          "effectiveTo": {
            "type": "string",
            "format": "datetime"
          },
          "limit": {
            "type": "integer",
            "default": 50,
            "minimum": 1,
            "maximum": 200
          },
          "offset": {
            "type": "integer",
            "default": 0,
            "minimum": 0
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "rites",
            "total",
            "offset",
            "limit"
          ],
          "properties": {
            "rites": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#riteSummary"
              }
            },
            "total": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            },
            "limit": {
              "type": "integer"
            }
          }
        }
      }
    },
    "riteSummary": {
      "type": "object",
      "required": [
        "riteId",
        "riteType",
        "scope",
        "effectiveDate",
        "status",
        "issuerDid"
      ],
      "properties": {
        "riteId": {
          "type": "string"
        },
        "riteType": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "effectiveDate": {
          "type": "string",
          "format": "datetime"
        },
        "expiryDate": {
          "type": "string",
          "format": "datetime"
        },
        "status": {
          "type": "string"
        },
        "issuerDid": {
          "type": "string"
        },
        "enrolledCreditors": {
          "type": "integer"
        },
        "enrolledDebtors": {
          "type": "integer"
        },
        "totalReleasedMicroUsdc": {
          "type": "integer"
        }
      }
    }
  }
}
