{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.etzhayyim.land-biodiversity",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "Annual biodiversity census record. Linked from land-attestation. Per ADR-2605192245 §5.1. Required annually as religious stewardship duty integrating §1.9 multi-generational priority.",
      "record": {
        "type": "object",
        "required": ["landId", "censusYear", "habitatType", "stewardDid", "recordedAt"],
        "properties": {
          "landId": { "type": "integer", "minimum": 1 },
          "censusYear": { "type": "integer", "minimum": 2026 },
          "habitatType": {
            "type": "string",
            "maxLength": 200,
            "description": "Habitat classification (e.g., 'temperate deciduous forest', 'riparian wetland')."
          },
          "speciesObserved": {
            "type": "array",
            "maxLength": 1000,
            "items": {
              "type": "object",
              "required": ["scientificName"],
              "properties": {
                "scientificName": { "type": "string", "maxLength": 200 },
                "commonName": { "type": "string", "maxLength": 200 },
                "kingdom": {
                  "type": "string",
                  "enum": ["Animalia", "Plantae", "Fungi", "Protista", "Monera", "Archaea", "Bacteria"]
                },
                "iucnStatus": {
                  "type": "string",
                  "enum": ["LC", "NT", "VU", "EN", "CR", "EW", "EX", "DD", "NE"],
                  "description": "IUCN Red List status."
                },
                "evidenceUri": {
                  "type": "string",
                  "description": "Photo / audio / iNaturalist URL."
                }
              }
            }
          },
          "satelliteImageryCid": {
            "type": "string",
            "description": "IPFS CID of the year's satellite imagery snapshot (compared against donation baseline + prior years)."
          },
          "ndviChange": {
            "type": "integer",
            "description": "NDVI vegetation change index vs prior year, scaled by 10000 (e.g., +500 = +5% green cover)."
          },
          "stewardDid": { "type": "string" },
          "councilEcologistCoSigners": {
            "type": "array",
            "maxLength": 5,
            "items": { "type": "string" },
            "description": "Optional Council-recognized ecologist co-signers for high-confidence attestations."
          },
          "stewardSignature": { "type": "string" },
          "recordedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
