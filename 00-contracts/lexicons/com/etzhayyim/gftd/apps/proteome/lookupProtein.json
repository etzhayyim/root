{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.proteome.lookupProtein",
  "defs": {
    "main": {
      "type": "query",
      "description": "Lookup protein via UniProt/PDB/AlphaFold DB. Auto-generated stub (coverage expansion 2026-04-17).",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "properties": {
          "uniprotId": { "type": "string" },
          "pdbId": { "type": "string" },
          "geneSymbol": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "uniprotId": { "type": "string" },
            "name": { "type": "string" },
            "sequence": { "type": "string" },
            "length": { "type": "integer" },
            "domains": { "type": "array", "items": { "type": "string" } },
            "alphaFoldUrl": { "type": "string", "format": "uri" }
          }
        }
      }
    }
  }
}
