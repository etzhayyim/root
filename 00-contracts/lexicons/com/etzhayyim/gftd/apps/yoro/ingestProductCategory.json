{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yoro.ingestProductCategory",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Generic product/price ingest from public retailers (Amazon JP, Rakuten, IKEA, FlexiSpot, Yodobashi, Kagu365). Triggers LangGraph yoro_product_ingest.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "query": { "type": "string", "description": "Search keyword, e.g. 'スタンディングデスク'" },
            "category": { "type": "string", "description": "Optional category tag, e.g. 'office.desk.standing'" },
            "retailers": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Subset of: amazon-jp, rakuten, ikea-jp, flexispot-jp, yodobashi, kagu365. Empty = all enabled."
            },
            "maxItemsPerRetailer": { "type": "integer", "minimum": 1, "maximum": 100 },
            "actorPath": { "type": "string", "description": "yoro path-DID suffix, default 'research:product'" }
          },
          "required": ["query"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "jobId": { "type": "string" },
            "status": { "type": "string" },
            "researchVertexId": { "type": "string" }
          },
          "required": ["jobId", "status"]
        }
      }
    }
  }
}
