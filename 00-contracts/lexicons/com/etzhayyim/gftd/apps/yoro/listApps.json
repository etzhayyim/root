{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yoro.listApps",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "List platform apps from vertex_app registry (replaces hand-curated apps.ts).",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "limit": { "type": "integer" },
            "cursor": { "type": "string" }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "shortName": { "type": "string" },
                  "href": { "type": "string" },
                  "icon": { "type": "string" },
                  "category": { "type": "string" },
                  "description": { "type": "string" }
                },
                "required": ["id", "name", "href", "icon", "category"]
              }
            },
            "total": { "type": "integer" }
          },
          "required": []
        }
      }
    }
  }
}
