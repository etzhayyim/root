{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.contentModerationAppeal.recordAppeal",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "DSA Article 17 / DSC complaint / out-of-court dispute (bridges trustedFlagger.flagAbuseConcern + dsa-vlop + dpa-authority)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "appealId",
            "platform",
            "forum",
            "complainantCategory",
            "filedAt"
          ],
          "properties": {
            "appealId": {
              "type": "string"
            },
            "platform": {
              "type": "string"
            },
            "forum": {
              "type": "string",
              "enum": [
                "internal_review",
                "oversight_board_meta",
                "court_independent",
                "dsc_designated",
                "article_21_dispute_body",
                "national_court",
                "trusted_arbitrator",
                "ngo_mediator",
                "oosc_oversight"
              ]
            },
            "complainantCategory": {
              "type": "string",
              "enum": [
                "user_creator",
                "brand",
                "political_party",
                "ngo",
                "journalist",
                "lawyer_pro_bono",
                "trade_assoc",
                "government_entity"
              ]
            },
            "abuseConcernVid": {
              "type": "string",
              "description": "bridges trustedFlagger.flagAbuseConcern"
            },
            "filedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}