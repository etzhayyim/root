{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maritimeComplianceDashboard.issueChartererAlert",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Alert chartering party (broker-charter) re vessel compliance",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "alertId",
            "scoreVid",
            "alertReason",
            "alertedAt"
          ],
          "properties": {
            "alertId": {
              "type": "string"
            },
            "scoreVid": {
              "type": "string",
              "description": "bridges scoreVessel"
            },
            "charterVid": {
              "type": "string",
              "description": "bridges open-broker-charter"
            },
            "chartererLei": {
              "type": "string"
            },
            "alertReason": {
              "type": "string",
              "enum": [
                "detention",
                "welfare",
                "forced_labor",
                "cert_expiry",
                "multi"
              ]
            },
            "alertedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}