{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.malaccaEmission.recordEmissionReport",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "MARPOL Annex VI 排出",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "reportId",
            "imo",
            "co2Tonnes",
            "periodStart",
            "periodEnd"
          ],
          "properties": {
            "reportId": {
              "type": "string"
            },
            "imo": {
              "type": "string"
            },
            "fuelType": {
              "type": "string"
            },
            "co2Tonnes": {
              "type": "number"
            },
            "noxTonnes": {
              "type": "number"
            },
            "soxTonnes": {
              "type": "number"
            },
            "periodStart": {
              "type": "string",
              "format": "date"
            },
            "periodEnd": {
              "type": "string",
              "format": "date"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
