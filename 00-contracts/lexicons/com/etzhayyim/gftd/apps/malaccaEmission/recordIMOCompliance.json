{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.malaccaEmission.recordIMOCompliance",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "IMO CII/EEXI rating",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "complianceId",
            "imo",
            "metric",
            "rating",
            "measuredPeriod",
            "reportedAt"
          ],
          "properties": {
            "complianceId": {
              "type": "string"
            },
            "imo": {
              "type": "string"
            },
            "metric": {
              "type": "string",
              "enum": [
                "CII",
                "EEXI",
                "EEDI"
              ]
            },
            "rating": {
              "type": "string",
              "description": "A/B/C/D/E for CII"
            },
            "numericValue": {
              "type": "number"
            },
            "measuredPeriod": {
              "type": "string"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "complianceTier": {
              "type": "string",
              "enum": [
                "excellent",
                "satisfactory",
                "inferior",
                "non-compliant"
              ]
            },
            "requireAction": {
              "type": "boolean"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
