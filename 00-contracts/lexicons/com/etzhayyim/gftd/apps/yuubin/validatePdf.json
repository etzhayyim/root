{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yuubin.validatePdf",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Validate PDF for Web ゆうびん / e内容証明 submission. Checks page size is A4 (MediaBox ~595.28x841.89pt) for all pages. Returns pages count, isA4 flag, sampleSize. Heuristic MediaBox parsing (not a full PDF parser) — passes pandoc+xelatex output, rejects Chrome headless non-A4 output.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["blobKey"],
          "properties": {
            "blobKey": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "SHA-256 hex blobKey of the PDF in CDN_R2"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok":         { "type": "boolean" },
            "blobKey":    { "type": "string" },
            "pages":      { "type": "integer", "description": "Heuristic /Type /Page count" },
            "isA4":       { "type": "boolean", "description": "All MediaBoxes within A4 tolerance (±5pt)" },
            "sampleSize": { "type": "array", "items": { "type": "number" }, "description": "[width, height] in points from first page" },
            "byteSize":   { "type": "integer" },
            "warning":    { "type": "string", "description": "If non-A4, remediation hint" },
            "error":      { "type": "string" }
          }
        }
      },
      "errors": [
        { "name": "BlobNotFound", "description": "B2 object not found for blobKey" }
      ]
    }
  }
}
