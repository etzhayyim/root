{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.fusionEnergy.registerProject",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Fusion energy project (ITER / SPARC / STEP / KSTAR / EAST / CFETR — bridges iaea-safeguards + hydrogen-economy + critical-minerals + power-grid-interconnect)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "projectId",
            "projectName",
            "approach",
            "countryIso3",
            "announcedAt"
          ],
          "properties": {
            "projectId": {
              "type": "string"
            },
            "operatorLei": {
              "type": "string"
            },
            "projectName": {
              "type": "string"
            },
            "approach": {
              "type": "string",
              "enum": [
                "tokamak",
                "stellarator",
                "inertial",
                "magneto_inertial",
                "field_reversed",
                "spheromak",
                "z_pinch"
              ]
            },
            "countryIso3": {
              "type": "string"
            },
            "targetQ": {
              "type": "number",
              "description": "target gain"
            },
            "targetNetMw": {
              "type": "number"
            },
            "milestoneYear": {
              "type": "integer"
            },
            "announcedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}