{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.petPrivacy.registerDeployment",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Privacy-enhancing technology deployment (ENISA PETs / UKICO / NIST — bridges data-adequacy + precision-medicine + fhir-health-data + quantum-safe-crypto)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "deploymentId",
            "jurisdictionIso3",
            "petFamily",
            "registeredAt"
          ],
          "properties": {
            "deploymentId": {
              "type": "string"
            },
            "operatorLei": {
              "type": "string"
            },
            "jurisdictionIso3": {
              "type": "string"
            },
            "petFamily": {
              "type": "string",
              "enum": [
                "differential_privacy",
                "federated_learning",
                "homomorphic_encryption",
                "secure_multiparty_computation",
                "zero_knowledge_proof",
                "trusted_execution",
                "k_anonymity",
                "synthetic_data"
              ]
            },
            "useCase": {
              "type": "string",
              "enum": [
                "health",
                "finance",
                "advertising",
                "census",
                "government",
                "telecom",
                "cross_border"
              ]
            },
            "epsilonBudget": {
              "type": "number",
              "description": "DP epsilon"
            },
            "registeredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}