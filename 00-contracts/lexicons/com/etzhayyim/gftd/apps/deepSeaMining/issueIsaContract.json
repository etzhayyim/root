{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.deepSeaMining.issueIsaContract",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ISA exploration/exploitation contract (bridges critical-minerals + biodiversity-gbf + forced-labor)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "contractId",
            "sponsoringStateIso3",
            "area",
            "resource",
            "phase",
            "issuedAt"
          ],
          "properties": {
            "contractId": {
              "type": "string"
            },
            "sponsoringStateIso3": {
              "type": "string"
            },
            "contractorLei": {
              "type": "string"
            },
            "area": {
              "type": "string",
              "enum": [
                "CCZ",
                "MAR",
                "indian_ocean",
                "south_atlantic",
                "south_pacific",
                "reserved_area",
                "APEI"
              ]
            },
            "resource": {
              "type": "string",
              "enum": [
                "polymetallic_nodules",
                "polymetallic_sulphides",
                "cobalt_crusts"
              ]
            },
            "criticalMineralVid": {
              "type": "string",
              "description": "bridges open-critical-minerals"
            },
            "phase": {
              "type": "string",
              "enum": [
                "exploration",
                "development",
                "exploitation",
                "suspended"
              ]
            },
            "areaKm2": {
              "type": "number"
            },
            "issuedAt": {
              "type": "string",
              "format": "datetime"
            },
            "expiresAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "sensitivityTier": {
              "type": "string",
              "enum": [
                "contested",
                "contested_high",
                "protected"
              ]
            }
          }
        }
      }
    }
  }
}