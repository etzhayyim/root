{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.coworkGraph.filesList",
  "defs": {
    "main": {
      "type": "query",
      "description": "OneDrive/SharePoint のファイル・フォルダ一覧を取得する。userId か driveId のいずれかを指定。",
      "parameters": {
        "type": "params",
        "properties": {
          "userId": {
            "type": "string",
            "description": "ユーザー UPN または Graph API user ID (指定時はそのユーザーの OneDrive を参照)"
          },
          "driveId": {
            "type": "string",
            "description": "Drive ID (SharePoint ドキュメントライブラリ等)"
          },
          "itemId": {
            "type": "string",
            "description": "フォルダ item ID (省略時は root)"
          },
          "top": {
            "type": "integer",
            "description": "取得件数 (最大 100)",
            "default": 30
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "value": {
              "type": "array",
              "items": { "type": "unknown" }
            }
          }
        }
      }
    }
  }
}
