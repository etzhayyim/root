{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.apqc.materializeSubprocessDid",
  "defs": {
    "main": {
      "type": "query",
      "description": "Return the deterministic APQC subprocess DID for SQL/UDF callers.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["apqcCode", "subprocessCode"],
          "properties": {
            "apqcCode": { "type": "string" },
            "subprocessCode": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "apqcCode": { "type": "string" },
            "subprocessCode": { "type": "string" },
            "did": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
