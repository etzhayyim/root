{
  "lexicon": 1,
  "id": "com.etzhayyim.animeka.layout",
  "defs": {
    "main": {
      "type": "record",
      "description": "Tier 2 domain record for a layout (レイアウト). Precise per-cut composition with character positioning, prop placement, and background reference. Approval triggers parallel `layout-approve-keyAnim` (keyAnimator invoke) and `layout-approve-bg` (bgArtist invoke) derive rules.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["cutRef", "layoutCid", "createdAt"],
        "properties": {
          "cutRef": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "storyboardRef": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef",
            "description": "Approved storyboard this layout is based on."
          },
          "layoutCid": {
            "type": "string",
            "format": "cid",
            "description": "Blob CID of the layout drawing (KAMI layered format preferred)."
          },
          "bgRef": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef",
            "description": "Background reference, if pre-assigned."
          },
          "charPositions": {
            "type": "array",
            "description": "Character positions within the layout frame.",
            "items": { "type": "ref", "ref": "#charPosition" }
          },
          "cameraFrame": {
            "type": "ref",
            "ref": "#cameraFrame",
            "description": "Initial + final camera frame within the layout (for PAN/TU/TB cuts)."
          },
          "lightingDirection": {
            "type": "string",
            "description": "Lighting direction note for finishers (e.g. '上手 45°', 'モノトーン')."
          },
          "author": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["draft", "review", "approved", "rejected"]
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    },
    "charPosition": {
      "type": "object",
      "required": ["slug", "x", "y"],
      "properties": {
        "slug": { "type": "string" },
        "x": { "type": "number", "description": "Normalized [0,1] layout coord." },
        "y": { "type": "number" },
        "scale": { "type": "number" },
        "pose": { "type": "string", "description": "Pose descriptor (standing / sitting / running ...)." }
      }
    },
    "cameraFrame": {
      "type": "object",
      "properties": {
        "startRect": {
          "type": "array",
          "items": { "type": "number" },
          "description": "[x, y, w, h] in normalized layout coords, start frame."
        },
        "endRect": {
          "type": "array",
          "items": { "type": "number" },
          "description": "[x, y, w, h], end frame. Same as startRect for still cuts."
        }
      }
    }
  }
}
