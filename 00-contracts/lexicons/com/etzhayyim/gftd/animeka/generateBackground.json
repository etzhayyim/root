{
  "lexicon": 1,
  "id": "com.etzhayyim.animeka.generateBackground",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Stage 9/12 — Generate a painterly anime background (FLUX.1-dev, 1920x1080). Derive rule fires on layout.status=approved in parallel with keyframe gen. Backed by BPMN animeka_generate_background (ADR-2604231328).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["cutId", "layoutUri", "location", "timeOfDay", "lightingMood"],
          "properties": {
            "cutId": { "type": "string" },
            "layoutUri": { "type": "string", "format": "at-uri" },
            "location": { "type": "string" },
            "timeOfDay": { "type": "string" },
            "lightingMood": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "blobCid": { "type": "string" },
            "bgPrompt": { "type": "string" }
          }
        }
      }
    }
  }
}
