{
  "lexicon": 1,
  "id": "com.etzhayyim.animeka.listWorks",
  "defs": {
    "main": {
      "type": "query",
      "description": "List anime works (series).",
      "parameters": {
        "type": "params",
        "properties": {
          "status": { "type": "string", "enum": ["planning", "production", "airing", "completed", "archived"] },
          "limit": { "type": "integer" },
          "offset": { "type": "integer" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items", "total"],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "uri": { "type": "string", "format": "at-uri" },
                  "did": { "type": "string" },
                  "title": { "type": "string" },
                  "status": { "type": "string" },
                  "episodeCount": { "type": "integer" },
                  "coverCid": { "type": "string", "format": "cid" }
                }
              }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
