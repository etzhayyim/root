{
  "lexicon": 1,
  "id": "com.etzhayyim.apqc.getProcess",
  "defs": {
    "main": {
      "type": "query",
      "description": "Tranche F stub — fetch one APQC PCF process by ID. Full schema pending Phase 3 content copy.",
      "parameters": {
        "type": "params",
        "properties": {
          "processId": {
            "type": "string",
            "description": "APQC PCF process identifier (e.g. '1.0.0' for 'Develop Vision and Strategy')"
          }
        },
        "required": ["processId"]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "#process"
        }
      }
    },
    "process": {
      "type": "object",
      "description": "APQC PCF process node. Schema is a stub; full PCF columns added in Phase 3.",
      "properties": {
        "processId": { "type": "string" },
        "name": { "type": "string" },
        "level": { "type": "integer", "minimum": 1, "maximum": 5 },
        "parentProcessId": { "type": "string" }
      },
      "required": ["processId", "name", "level"]
    }
  }
}
