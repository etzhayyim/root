{
  "lexicon": 1,
  "id": "com.etzhayyim.seigyo.scadaProjectAttestation",
  "description": "CID attestation of an L2 SCADA project file (FUXA / Rapid SCADA / OpenSCADA — open-source only per the commercial vendor prohibition) after Charter Rider §2 audit. A site running an unattested project is flagged like a runtime-hash mismatch. Per ADR-2606111000 §1 + §2 + §6.",
  "defs": {
    "main": {
      "type": "record",
      "record": {
        "type": "object",
        "properties": {
          "siteId": { "type": "string" },
          "scadaStack": { "type": "string", "knownValues": ["fuxa", "rapid-scada", "openscada"] },
          "projectVersion": { "type": "integer" },
          "projectCid": { "type": "string" },
          "charterRiderAuditResult": { "type": "string", "knownValues": ["pass", "pass-with-conditions", "fail"] },
          "charterRiderAuditCid": { "type": "string" },
          "engineerDid": { "type": "string" },
          "attestedAt": { "type": "string" },
          "councilAttestationRef": { "type": "string" },
          "supersedesProjectVersion": { "type": "integer" }
        },
        "required": ["siteId", "scadaStack", "projectVersion", "projectCid", "charterRiderAuditResult", "engineerDid", "attestedAt"]
      }
    }
  }
}
