{
  "lexicon": 1,
  "id": "com.etzhayyim.seigyo.interlockVerificationRecord",
  "description": "Physical verification record for hardwired L1S safety interlocks (E-stop, over-pressure, over-temperature, gas detection, light curtains, LOTO) at commissioning and annual re-verification. The record ATTESTS the safety layer; no software is ever IN it — a safety function must complete with the site network cable cut. Per ADR-2606111000 §3.5 + ADR-2606111100 §4.9.",
  "defs": {
    "main": {
      "type": "record",
      "record": {
        "type": "object",
        "properties": {
          "siteId": { "type": "string" },
          "verificationType": { "type": "string", "knownValues": ["commissioning", "annual", "post-modification"] },
          "verifiedAt": { "type": "string" },
          "engineerDid": { "type": "string" },
          "interlocks": {
            "type": "array",
            "items": { "type": "ref", "ref": "#interlockVerification" }
          },
          "nextVerificationDue": { "type": "string" }
        },
        "required": ["siteId", "verificationType", "verifiedAt", "engineerDid", "interlocks"]
      }
    },
    "interlockVerification": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "interlockType": {
          "type": "string",
          "knownValues": ["estop", "over-pressure", "over-temperature", "gas-detection", "light-curtain", "loto", "thermal-fuse", "other"]
        },
        "implementation": { "type": "string", "description": "hardwired relay / safety relay / non-resettable fuse — NEVER software" },
        "physicallyVerified": { "type": "boolean" },
        "networkCutVerified": { "type": "boolean", "description": "verified to complete with the controller network cable disconnected (ADR §3.2)" },
        "measurementEvidenceCids": { "type": "array", "items": { "type": "string" } },
        "photoEvidenceCids": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["name", "interlockType", "implementation", "physicallyVerified"]
    }
  }
}
