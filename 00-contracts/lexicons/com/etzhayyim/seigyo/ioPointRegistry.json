{
  "lexicon": 1,
  "id": "com.etzhayyim.seigyo.ioPointRegistry",
  "description": "Per-site I/O point map for the seigyo control layer (ISA-95 L0). Tag, unit, range, and trust class per point; points behind embedded third-party proprietary controllers are trust class untrusted-external. Per ADR-2606111000 §1 + §2.",
  "defs": {
    "main": {
      "type": "record",
      "record": {
        "type": "object",
        "properties": {
          "siteId": { "type": "string" },
          "controllerId": { "type": "string" },
          "registryVersion": { "type": "integer" },
          "updatedAt": { "type": "string" },
          "points": {
            "type": "array",
            "items": { "type": "ref", "ref": "#ioPoint" }
          },
          "engineerDid": { "type": "string" }
        },
        "required": ["siteId", "controllerId", "registryVersion", "points", "engineerDid"]
      }
    },
    "ioPoint": {
      "type": "object",
      "properties": {
        "tag": { "type": "string" },
        "address": { "type": "string", "description": "IEC 61131-3 direct address, e.g. %IW0, %QX0.0" },
        "direction": { "type": "string", "knownValues": ["input", "output"] },
        "signalType": { "type": "string", "knownValues": ["digital", "analog", "counter"] },
        "unit": { "type": "string" },
        "rangeMinMilli": { "type": "integer", "description": "range minimum in 1/1000 of unit (implied milli-units)" },
        "rangeMaxMilli": { "type": "integer", "description": "range maximum in 1/1000 of unit (implied milli-units)" },
        "trustClass": {
          "type": "string",
          "knownValues": ["attested", "untrusted-external", "safety-mirror-readonly"],
          "description": "safety-mirror-readonly = read-only status mirror of a hardwired L1S interlock per ADR-2606111000 §3"
        },
        "description": { "type": "string" }
      },
      "required": ["tag", "address", "direction", "signalType", "trustClass"]
    }
  }
}
