{
  "lexicon": 1,
  "id": "com.etzhayyim.yadori.registrarQuote",
  "description": "Registrar selection + TLD price as DATA ONLY. Cloudflare is the default (G3); affiliateStripped is const true (mirrors okaimono strip_affiliate). yadori is never the payer (G2).",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["fqdn", "registrar", "pricing", "createdAt"],
        "properties": {
          "fqdn": {"type": "string"},
          "registrar": {"type": "string"},
          "pricing": {"type": "string", "knownValues": ["at-cost", "low-markup", "markup"]},
          "councilGated": {"type": "boolean"},
          "affiliateStripped": {"type": "boolean", "const": true},
          "priceUsdMillis": {"type": "integer", "minimum": 0},
          "createdAt": {"type": "string", "format": "datetime"}
        }
      }
    }
  }
}
