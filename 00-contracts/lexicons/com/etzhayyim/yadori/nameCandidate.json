{
  "lexicon": 1,
  "id": "com.etzhayyim.yadori.nameCandidate",
  "description": "A surfaced domain-name candidate. G6 invariants: charterClean and squatClear are const true — a candidate is only emitted after passing the Charter-Rider §2(a)-(h) scan and the held-trademark/confusable + no-speculation screen.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["fqdn", "charterClean", "squatClear", "createdAt"],
        "properties": {
          "fqdn": {"type": "string"},
          "brief": {"type": "string"},
          "charterClean": {"type": "boolean", "const": true},
          "squatClear": {"type": "boolean", "const": true},
          "availability": {"type": "string", "knownValues": ["available", "registered", "unknown"]},
          "rank": {"type": "integer", "minimum": 0},
          "createdAt": {"type": "string", "format": "datetime"}
        }
      }
    }
  }
}
