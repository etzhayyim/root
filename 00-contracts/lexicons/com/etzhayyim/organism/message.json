{
  "lexicon": 1,
  "id": "com.etzhayyim.organism.message",
  "defs": {
    "main": {
      "type": "record",
      "description": "An encrypted inter-organism message payload over AT Protocol.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["recipientDid", "senderDid", "encryptedPayload", "createdAt"],
        "properties": {
          "recipientDid": {
            "type": "string",
            "format": "did",
            "description": "The destination organism's DID."
          },
          "senderDid": {
            "type": "string",
            "format": "did",
            "description": "The source organism's DID."
          },
          "encryptedPayload": {
            "type": "string",
            "description": "The Signal-keywrap encrypted envelope containing the inner JSON payload."
          },
          "threadId": {
            "type": "string",
            "description": "Optional correlation ID for conversation threads."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "The timestamp when the message was constructed."
          }
        }
      }
    }
  }
}
