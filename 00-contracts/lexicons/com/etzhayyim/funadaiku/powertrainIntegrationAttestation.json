{
  "lexicon": 1,
  "id": "com.etzhayyim.funadaiku.powertrainIntegrationAttestation",
  "description": "L4 zero-emission powertrain integration attestation (G13) — wind-assist rig + solar array + H2 PEM fuel cell + LFP battery + electric azimuth pods + autonomous GNC. NO fossil engine. Per ADR-2606013400.",
  "defs": {
    "main": {
      "type": "record",
      "record": {
        "type": "object",
        "properties": {
          "vesselId": {
            "type": "string"
          },
          "vesselClass": {
            "type": "string"
          },
          "recordedAt": {
            "type": "string",
            "format": "datetime"
          },
          "windAssistUnits": {
            "type": "integer"
          },
          "solarKwp": {
            "type": "integer"
          },
          "fuelCellKw": {
            "type": "integer"
          },
          "batteryKwh": {
            "type": "integer"
          },
          "drivePodKw": {
            "type": "integer"
          },
          "fossilEngine": {
            "type": "boolean",
            "description": "MUST be false (G13/N5)"
          },
          "greenH2CocCid": {
            "type": "string",
            "description": "green-hydrogen chain-of-custody attestation CID (G14)"
          },
          "massDegree": {
            "type": "integer",
            "description": "IMO MASS autonomy degree (<=3, G7)"
          },
          "gncFirmwareCid": {
            "type": "string",
            "description": "open-source GNC firmware CID (G1)"
          },
          "attestingRobots": {
            "type": "array",
            "items": {
              "type": "ref",
              "ref": "#robotSignature"
            },
            "description": "Ed25519 robot witness quorum (>=2 distinct robots, G4)"
          }
        },
        "required": [
          "vesselId",
          "fossilEngine",
          "fuelCellKw",
          "massDegree",
          "recordedAt"
        ]
      }
    },
    "robotSignature": {
      "type": "object",
      "properties": {
        "robotDid": {
          "type": "string",
          "format": "did"
        },
        "role": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "datetime"
        }
      },
      "required": [
        "robotDid",
        "signature"
      ]
    }
  }
}
