{
  "lexicon": 1,
  "id": "com.etzhayyim.tsutae.pcbAttestation",
  "description": "SMT PCB lot attestation. Component sourcing + AOI pass + ECN traceability + binary blob audit. Per ADR-2605261300 G1 + G7.",
  "defs": {
    "main": {
      "type": "record",
      "record": {
        "type": "object",
        "properties": {
          "lotId": {"type": "string"},
          "pcbDesignCid": {"type": "string", "description": "G1: PCB Gerbers + KiCad/FreeCAD source CID Apache 2.0 + Charter Rider"},
          "ecnRevision": {"type": "string"},
          "boardCount": {"type": "integer"},
          "componentLotIds": {"type": "array", "items": {"type": "string"}, "description": "Per-component DID chain"},
          "binaryBlobAudit": {
            "type": "object",
            "properties": {
              "totalFirmwareMassBytes": {"type": "integer"},
              "blobMassBytes": {"type": "integer"},
              "blobRatioPercent": {"type": "number", "description": "G7: ≤5% invariant"},
              "blobs": {"type": "array", "items": {"type": "string"}, "description": "Per-blob: vendor + reason + replacement-effort + Council waiver CID"}
            },
            "required": ["totalFirmwareMassBytes", "blobMassBytes", "blobRatioPercent"]
          },
          "smtProfile": {
            "type": "object",
            "properties": {
              "solderPaste": {"type": "string", "knownValues": ["SAC305-leadfree", "SnCu0.7-leadfree"]},
              "reflowPeakC": {"type": "integer", "description": "240-260°C typical lead-free"},
              "reflowDurationSec": {"type": "integer"}
            }
          },
          "aoiResult": {
            "type": "object",
            "properties": {
              "passCount": {"type": "integer"},
              "rejectCount": {"type": "integer"},
              "reworkCount": {"type": "integer"},
              "falsePositiveRatePercent": {"type": "number", "description": "Target <1%"}
            }
          },
          "xrayVoidMaxPercent": {"type": "number", "description": "BGA/QFN joint void per IPC-A-610 Class 3"},
          "witnessRobotDids": {"type": "array", "items": {"type": "string"}, "minItems": 2, "description": "G4: Mimi AOI + Otete handling Ed25519"}
        },
        "required": ["lotId", "pcbDesignCid", "boardCount", "componentLotIds", "binaryBlobAudit", "witnessRobotDids"]
      }
    }
  }
}
