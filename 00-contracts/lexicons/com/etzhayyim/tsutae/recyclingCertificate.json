{
  "lexicon": 1,
  "id": "com.etzhayyim.tsutae.recyclingCertificate",
  "description": "EOL device take-back attestation. Secure wipe + per-material dismantling log + kanayama Al routing. Per ADR-2605261300 G10 + G6 + §2(c) post-EOL privacy.",
  "defs": {
    "main": {
      "type": "record",
      "record": {
        "type": "object",
        "properties": {
          "recyclingId": {"type": "string"},
          "retiredDeviceDid": {"type": "string"},
          "intakeDate": {"type": "string"},
          "secureWipeAttestation": {
            "type": "object",
            "properties": {
              "cryptoEraseCompleted": {"type": "boolean", "description": "G6 + §2(c): bootloader-unlock + crypto erase before dismantling"},
              "userAttestationDid": {"type": "string", "description": "Adherent attestation of wipe before take-back"},
              "wipeMethod": {"type": "string", "knownValues": ["bootloader-unlock-crypto-erase", "factory-reset-plus-luks-key-destroy", "physical-storage-removal"]}
            },
            "required": ["cryptoEraseCompleted", "userAttestationDid", "wipeMethod"]
          },
          "materialBalance": {
            "type": "object",
            "properties": {
              "aluminumChassisGrams": {"type": "number", "description": "Routed to kanayama"},
              "batteryGrams": {"type": "number", "description": "Routed to Li-ion recycling"},
              "pcbGrams": {"type": "number"},
              "displayPanelGrams": {"type": "number"},
              "miscPlasticGrams": {"type": "number"},
              "miscMetalGrams": {"type": "number"},
              "componentReusedForRepairStockGrams": {"type": "number", "description": "Per-component harvest for repair shop stock"},
              "totalDeviceGrams": {"type": "number"},
              "recoveryRatio": {"type": "number", "description": "G10: ≥0.80 by R3 invariant"}
            },
            "required": ["aluminumChassisGrams", "batteryGrams", "totalDeviceGrams", "recoveryRatio"]
          },
          "kanayamaIntakeCid": {"type": "string", "description": "Cross-actor routing CID to kanayama.intake_qa"},
          "batteryRecyclingRoutingCid": {"type": "string"},
          "operatorDid": {"type": "string", "description": "G10 + G11: Li-ion recycling operator DID"},
          "witnessRobotDids": {"type": "array", "items": {"type": "string"}, "minItems": 2}
        },
        "required": ["recyclingId", "retiredDeviceDid", "intakeDate", "secureWipeAttestation", "materialBalance", "operatorDid", "witnessRobotDids"]
      }
    }
  }
}
