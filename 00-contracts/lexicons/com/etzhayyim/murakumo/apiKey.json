{
  "lexicon": 1,
  "id": "com.etzhayyim.murakumo.apiKey",
  "description": "Platform API key for sk_live_*/sk_test_* murakumo access. rkey = lowercase hex SHA-256 of the raw key. Per ADR-2605191358 (kotoba rewrite).",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["ownerDid", "status", "createdTsMs"],
        "properties": {
          "ownerDid": {
            "type": "string",
            "format": "did",
            "description": "DID that owns this key. Used for billing/scoping."
          },
          "scopes": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Scope tokens, e.g. 'murakumo:inference', '*'. Empty means default 'read'."
          },
          "status": {
            "type": "string",
            "enum": ["active", "revoked"]
          },
          "createdTsMs": { "type": "integer" },
          "revokedTsMs": { "type": "integer" },
          "note": { "type": "string", "maxLength": 256 }
        }
      }
    }
  }
}
