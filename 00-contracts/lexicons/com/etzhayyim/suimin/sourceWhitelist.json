{
  "lexicon": 1,
  "id": "com.etzhayyim.suimin.sourceWhitelist",
  "description": "Council-ratified registry of source CLASSES that suimin may treat as evidence (G1 SSoT). Every evidenceRecord / treatmentSynthesis claim MUST reference a sourceClass present here AND carry a verifiable provenance id. Additions require silenSuiminReview scope 'source-whitelist-baseline' (Council Lv6+ ≥3). Per ADR-2606072800 §Decision 2.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["v", "sourceClasses", "ratifiedReviewCid", "ratifiedAt"],
        "properties": {
          "v": { "type": "integer", "minimum": 1, "maximum": 1 },
          "sourceClasses": {
            "type": "array",
            "minLength": 1,
            "items": { "type": "ref", "ref": "#sourceClass" },
            "description": "Allowed evidence source classes. Whitelist-only (G1)."
          },
          "ratifiedReviewCid": {
            "type": "string",
            "description": "com.etzhayyim.suimin.silenSuiminReview CID (scope source-whitelist-baseline, verdict=approve)."
          },
          "ratifiedAt": { "type": "string", "format": "datetime" }
        }
      }
    },
    "sourceClass": {
      "type": "object",
      "required": ["id", "displayName", "maxDefaultGrade", "provenanceIdKind"],
      "properties": {
        "id": {
          "type": "string",
          "knownValues": [
            "cochrane-systematic-review",
            "pubmed-rct",
            "pubmed-systematic-review",
            "aasm-practice-guideline",
            "icsd-3",
            "icd-11",
            "pubmed-cohort",
            "pubmed-preprint",
            "jp-sleep-society-guideline"
          ]
        },
        "displayName": { "type": "string", "maxLength": 200 },
        "maxDefaultGrade": {
          "type": "string",
          "knownValues": ["high", "moderate", "low", "very-low", "classification-only"],
          "description": "Upper bound of evidenceGrade for this class. icsd-3/icd-11 = classification-only (condition anchor, never treatment evidence). pubmed-preprint = low."
        },
        "provenanceIdKind": {
          "type": "string",
          "knownValues": ["pmid", "doi", "cochrane-cd-id", "guideline-id", "icsd3-code", "icd11-code"],
          "description": "The verifiable provenance identifier kind required for claims of this class (G1)."
        },
        "peerReviewed": { "type": "boolean", "description": "false for pubmed-preprint (must be labeled preprint, G12)." }
      }
    }
  }
}
