{
  "lexicon": 1,
  "id": "com.etzhayyim.mizuho.wastewaterDischargeAttestation",
  "description": "Per-discharge attestation. G9 STRUCTURAL: jurisdictionalPermitCid REQUIRED. Outflow quality MUST meet jurisdictional discharge permit standard. Sludge cycling cross-link to mitsuho when sludge quality permits.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "createdAt",
          "treatmentFacilityCid",
          "dischargeWindowStartUtc",
          "dischargeWindowEndUtc",
          "outflowVolumeLiters",
          "outflowQualityParameters",
          "jurisdictionalPermitCid",
          "permitCompliant",
          "attestingCellDid"
        ],
        "properties": {
          "createdAt": {"type": "string", "format": "datetime"},
          "treatmentFacilityCid": {
            "type": "string",
            "description": "Treatment facility identifier (cross-link to waterSupplySourceRegistry treatment facility record OR clinicFacilityAttestation when co-located)"
          },
          "dischargeWindowStartUtc": {"type": "string", "format": "datetime"},
          "dischargeWindowEndUtc": {"type": "string", "format": "datetime"},
          "outflowVolumeLiters": {
            "type": "integer",
            "minimum": 0,
            "description": "Outflow volume in liters (integer; for cm² convention sibling)"
          },
          "outflowQualityParameters": {
            "type": "array",
            "items": {"type": "ref", "ref": "#dischargeParameter"}
          },
          "jurisdictionalPermitCid": {
            "type": "string",
            "description": "G9 REQUIRED: jurisdictional discharge permit CID (Council-attested in jurisdiction registry)"
          },
          "permitCompliant": {"type": "boolean"},
          "permitDeviationDetailCid": {
            "type": "string",
            "description": "If permitCompliant=false, encrypted detail report CID; triggers waterContaminationIncident emit"
          },
          "sludgeCyclingDestination": {
            "type": "string",
            "knownValues": ["composting-mitsuho-agricultural", "constructed-wetland-retention", "specialized-disposal", "n-a"],
            "description": "Sludge cycling cross-link to mitsuho when sludge quality permits"
          },
          "sludgeQualityAttestationCid": {"type": "string"},
          "kotobaDatomicAttestationCid": {"type": "string"},
          "attestingCellDid": {"type": "string"}
        }
      }
    },
    "dischargeParameter": {
      "type": "object",
      "required": ["parameterCode", "measuredValueIntegerHundredths", "unitCode", "permitLimitIntegerHundredths", "passes"],
      "properties": {
        "parameterCode": {
          "type": "string",
          "description": "BOD5 / COD / TSS / NH3-N / TP / fecal-coliform / etc."
        },
        "measuredValueIntegerHundredths": {"type": "integer"},
        "unitCode": {
          "type": "string",
          "knownValues": ["mg-per-L", "ug-per-L", "cfu-per-100mL"]
        },
        "permitLimitIntegerHundredths": {"type": "integer"},
        "passes": {"type": "boolean"}
      }
    }
  }
}
