{
  "lexicon": 1,
  "id": "com.etzhayyim.mizuho.waterQualityAttestation",
  "description": "Per-source / per-period water quality test attestation. WHO Drinking Water Guidelines: microbiological + chemical + radiological + physical. G8 STRUCTURAL: lastQualityTestUtc field enforces minimum cadence per parameter class (microbiological weekly / chemical monthly / radiological annual). Result detail uses $ref pattern for nested parameter results.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "createdAt",
          "sourceRegistryCid",
          "supplyGrade",
          "testPeriodStartUtc",
          "testPeriodEndUtc",
          "parameterResults",
          "overallComplianceStatus",
          "attestingCellDid"
        ],
        "properties": {
          "createdAt": {"type": "string", "format": "datetime"},
          "sourceRegistryCid": {
            "type": "string",
            "description": "Cross-link to waterSupplySourceRegistry record CID"
          },
          "supplyGrade": {
            "type": "string",
            "knownValues": [
              "potable",
              "irrigation",
              "clinical-grade",
              "wfi-feed",
              "greywater-recycled-non-potable",
              "stormwater-captured"
            ]
          },
          "testPeriodStartUtc": {"type": "string", "format": "datetime"},
          "testPeriodEndUtc": {"type": "string", "format": "datetime"},
          "parameterResults": {
            "type": "array",
            "items": {"type": "ref", "ref": "#parameterResult"},
            "description": "Per-parameter test results (microbiological / chemical / radiological / physical)"
          },
          "overallComplianceStatus": {
            "type": "string",
            "knownValues": [
              "compliant-who-guidelines",
              "compliant-jurisdictional-only",
              "non-compliant-warning",
              "non-compliant-critical-halt"
            ]
          },
          "naturalFluorideMgPerLiter": {
            "type": "integer",
            "description": "Natural fluoride concentration in micrograms per liter (NOT added; G6 no mandatory fluoridation; report for member consent transparency)"
          },
          "treatmentMethodsApplied": {
            "type": "array",
            "items": {
              "type": "string",
              "knownValues": ["filtration-sand", "filtration-membrane-mf", "filtration-membrane-uf", "filtration-membrane-ro", "uv-disinfection", "ozone", "residual-chlorination", "biological-treatment-constructed-wetland", "biological-treatment-mbr"]
            }
          },
          "labCertificationCid": {
            "type": "string",
            "description": "Third-party lab certification CID (Council-attested)"
          },
          "lastQualityTestUtc": {"type": "string", "format": "datetime"},
          "nextTestDueAtUtc": {"type": "string", "format": "datetime"},
          "kotobaDatomicAttestationCid": {"type": "string"},
          "attestingCellDid": {"type": "string"}
        }
      }
    },
    "parameterResult": {
      "type": "object",
      "required": ["parameterCode", "parameterClass", "measuredValueIntegerHundredths", "unitCode", "whoLimitIntegerHundredths", "passes"],
      "properties": {
        "parameterCode": {
          "type": "string",
          "description": "WHO/jurisdictional parameter code (e.g., E.coli, total-coliform, lead, arsenic, pH, turbidity)"
        },
        "parameterClass": {
          "type": "string",
          "knownValues": ["microbiological", "chemical-inorganic", "chemical-organic", "radiological", "physical", "disinfectant-residual"]
        },
        "measuredValueIntegerHundredths": {
          "type": "integer",
          "description": "Measured value × 100 (integer; e.g., 0.05 mg/L = 5)"
        },
        "unitCode": {
          "type": "string",
          "knownValues": ["mg-per-L", "ug-per-L", "ntu", "ph-unit", "cfu-per-100mL", "bq-per-L"]
        },
        "whoLimitIntegerHundredths": {"type": "integer"},
        "jurisdictionalLimitIntegerHundredths": {"type": "integer"},
        "passes": {"type": "boolean"}
      }
    }
  }
}
