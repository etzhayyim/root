{
  "lexicon": 1,
  "id": "com.etzhayyim.mizuho.waterContaminationIncident",
  "description": "Water contamination anomaly / incident. Severity enum constrains routing. critical = halt source cell + immediate notification cross-actor to iyashi (clinical-grade affected) + hagukumi (daily-living affected) + mitsuho (irrigation affected) + chigiri.disputeMediation escalation. Pattern extends iyashi G10 emergency-keyword discipline to infrastructure layer.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "createdAt",
          "sourceRegistryCid",
          "incidentCategory",
          "severity",
          "description",
          "affectedSupplyGrades"
        ],
        "properties": {
          "createdAt": {"type": "string", "format": "datetime"},
          "sourceRegistryCid": {"type": "string"},
          "incidentCategory": {
            "type": "string",
            "knownValues": [
              "microbiological-exceedance",
              "chemical-exceedance",
              "radiological-exceedance",
              "physical-exceedance",
              "treatment-pipeline-failure",
              "distribution-leak",
              "wastewater-permit-violation",
              "source-yield-collapse",
              "natural-disaster-event"
            ]
          },
          "severity": {
            "type": "string",
            "knownValues": ["info", "warning", "critical"],
            "description": "critical = halt source cell + immediate cross-actor notification + chigiri.disputeMediation escalation"
          },
          "description": {"type": "string", "maxLength": 2000},
          "affectedSupplyGrades": {
            "type": "array",
            "items": {
              "type": "string",
              "knownValues": ["potable", "irrigation", "clinical-grade", "wfi-feed", "greywater-recycled-non-potable", "stormwater-captured"]
            }
          },
          "affectedHouseholdCount": {"type": "integer"},
          "crossActorNotificationCids": {
            "type": "array",
            "items": {"type": "ref", "ref": "#crossActorNotification"}
          },
          "councilEscalationCid": {
            "type": "string",
            "description": "If severity=critical, the chigiri.disputeMediation record CID"
          },
          "remediationActionTakenAtUtc": {"type": "string", "format": "datetime"},
          "remediationActionDescription": {"type": "string"},
          "resolvedAt": {"type": "string", "format": "datetime"}
        }
      }
    },
    "crossActorNotification": {
      "type": "object",
      "required": ["actorDid", "notifiedAtUtc"],
      "properties": {
        "actorDid": {
          "type": "string",
          "knownValues": [
            "did:web:iyashi.etzhayyim.com",
            "did:web:hagukumi.etzhayyim.com",
            "did:web:mitsuho.etzhayyim.com",
            "did:web:yakushi.etzhayyim.com",
            "did:web:kazaori.etzhayyim.com"
          ]
        },
        "notifiedAtUtc": {"type": "string", "format": "datetime"},
        "acknowledgedAtUtc": {"type": "string", "format": "datetime"}
      }
    }
  }
}
