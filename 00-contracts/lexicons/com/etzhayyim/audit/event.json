{
  "lexicon": 1,
  "id": "com.etzhayyim.audit.event",
  "defs": {
    "main": {
      "type": "record",
      "description": "Audit event — substrate-level emission for any operation that touches encrypted records, consent capabilities, or tombstones. Stored in the audit subject's PDS (the actor designated as `auditWebhookDid`). Public record by design — auditability is the constitutional invariant; the event carries no PHI because it only references CIDs and DIDs. Per ADR-2605231700.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["version", "eventType", "subjectDid", "actorDid", "occurredAt", "signature"],
        "properties": {
          "version": {"type": "integer", "const": 1},
          "eventType": {
            "type": "string",
            "enum": [
              "consent.granted",
              "consent.revoked",
              "consent.invoked",
              "consent.expired",
              "encrypted.write",
              "encrypted.read",
              "encrypted.keyWrap.issued",
              "encrypted.keyWrap.refused",
              "tombstone.rekey",
              "tombstone.redact",
              "tombstone.sealed",
              "billing.requested",
              "billing.claim.statusChanged",
              "phi.guard.violation"
            ]
          },
          "subjectDid": {"type": "string", "description": "Whose data — usually patientDid"},
          "actorDid": {"type": "string", "description": "Who performed the action (clinician / agent / pharmacy / iryo)"},
          "granteeDid": {"type": "string", "description": "For consent events"},
          "capabilityUri": {"type": "string", "description": "For consent events"},
          "envelopeCid": {"type": "string", "description": "For encrypted/tombstone events"},
          "tombstoneCid": {"type": "string"},
          "purpose": {"type": "string", "description": "Stated purpose if consent-related"},
          "reason": {"type": "string"},
          "occurredAt": {"type": "string", "format": "datetime"},
          "outcome": {"type": "string", "enum": ["ok", "denied", "error"]},
          "errorCode": {"type": "string"},
          "context": {
            "type": "object",
            "description": "Optional non-PHI structured context (e.g. iryoClaimRef, ipAddressHash, sessionId hash)",
            "properties": {
              "iryoClaimRef": {"type": "string"},
              "sessionIdHash": {"type": "string"},
              "ipPrefixHash": {"type": "string", "description": "First-3-octets hash, NOT full IP — avoids tracking, gives ASN-class info"}
            }
          },
          "auditChainPrev": {"type": "string", "description": "CID of the previous audit.event from the same auditor — forms a hash-chain"},
          "signature": {
            "type": "object",
            "required": ["alg", "value", "keyId"],
            "properties": {
              "alg": {"type": "string", "const": "ed25519"},
              "value": {"type": "string"},
              "keyId": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
