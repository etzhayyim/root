{
  "lexicon": 1,
  "id": "com.etzhayyim.gov.dataset.budgetRecord",
  "description": "Per-jurisdiction budget appropriation / obligation / outlay / subaward attestation. R0 skeleton per ADR-2605263900 §3 (GovBudgetSensor). Authored by `kotodama.organism.sensors.gov.gov_budget_sensor` after passive-only fetch of USAspending / EU Financial Transparency System / national budget publications. Cross-links to `com.etzhayyim.corp.leiReference` when recipient is a legal entity with a GLEIF LEI; used by toritate (ADR-2605262900) for recipient-vendor anti-related-party checks. Recipient names pass-through (transparency-regime reason for publication).",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "createdAt",
          "jurisdiction",
          "recordKind",
          "recordId",
          "programName",
          "amountLocal",
          "currencyIso4217",
          "fiscalYear",
          "payloadCid",
          "sourceSensor",
          "datasetPinAt",
          "tier",
          "license",
          "attestingDid"
        ],
        "properties": {
          "createdAt": {"type": "string", "format": "datetime"},
          "jurisdiction": {"type": "string", "maxLength": 8},
          "recordKind": {
            "type": "string",
            "knownValues": ["appropriation", "obligation", "outlay", "subaward"]
          },
          "recordId": {"type": "string"},
          "programName": {"type": "string", "maxLength": 512},
          "programCode": {"type": "string"},
          "amountLocal": {
            "type": "integer",
            "description": "Local currency minor units (for example cents or yen)."
          },
          "currencyIso4217": {"type": "string", "maxLength": 3, "minLength": 3},
          "fiscalYear": {"type": "integer", "minimum": 1900, "maximum": 2200},
          "recipientName": {"type": "string", "maxLength": 512},
          "recipientLocalId": {
            "type": "string",
            "description": "Per-jurisdiction recipient ID (SAM.gov UEI / EU PIC / JP 法人番号)."
          },
          "recipientLei": {
            "type": "string",
            "description": "Cross-link to com.etzhayyim.corp.leiReference when LEI-bearing.",
            "maxLength": 20
          },
          "awardDateUtc": {"type": "string", "format": "datetime"},
          "payloadCid": {"type": "string"},
          "sourceSensor": {
            "type": "string",
            "knownValues": [
              "us_usaspending",
              "eu_financial_transparency",
              "uk_treasury_oscar",
              "jp_yosan"
            ]
          },
          "datasetPinAt": {"type": "string", "format": "at-uri"},
          "tier": {"type": "string", "knownValues": ["A"]},
          "license": {"type": "string"},
          "stateAlignedFlag": {"type": "boolean", "default": false},
          "attestingDid": {"type": "string", "format": "did"}
        }
      }
    }
  }
}
