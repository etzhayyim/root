{
  "lexicon": 1,
  "id": "com.etzhayyim.masago.datasetSourceAttestation",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["sourceId", "license", "openVerified"],
        "properties": {
          "sourceId": {
            "type": "string",
            "description": "→ open-materials-ontology :mat/id (a :dataset-source node), e.g. src.omat24"
          },
          "license": {
            "type": "string",
            "enum": ["CC-BY-4.0", "CC-BY-3.0", "CC-BY-SA-4.0", "CC0-1.0", "open"],
            "description": "G4 INVARIANT — OPEN licenses only; proprietary / vendor / all-rights-reserved are NOT enum members (rejected before a record exists)"
          },
          "doi": {
            "type": "string",
            "description": "G5 — DOI / arXiv id of the dataset release"
          },
          "url": {
            "type": "string",
            "description": "canonical public URL of the dataset"
          },
          "openVerified": {
            "type": "boolean",
            "const": true,
            "description": "G4 — record only exists after the open-license screen passes"
          }
        }
      }
    }
  }
}
