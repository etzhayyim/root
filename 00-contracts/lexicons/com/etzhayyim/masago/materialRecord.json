{
  "lexicon": 1,
  "id": "com.etzhayyim.masago.materialRecord",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["matId", "formula", "sourcing", "screened"],
        "properties": {
          "matId": {
            "type": "string",
            "description": "→ open-materials-ontology :mat/id (a :material node)"
          },
          "formula": {
            "type": "string",
            "description": "reduced/pretty formula, e.g. \"LiFePO4\""
          },
          "spacegroup": {
            "type": "string",
            "description": "Hermann-Mauguin space-group symbol (public crystal structure)"
          },
          "crystalSystem": {
            "type": "string",
            "enum": ["cubic", "tetragonal", "orthorhombic", "hexagonal", "trigonal", "monoclinic", "triclinic"],
            "description": "G2 — computed structure facet only"
          },
          "sourceId": {
            "type": "string",
            "description": "id in the open source, e.g. \"mp-19017\" (G5 provenance)"
          },
          "sourcing": {
            "type": "string",
            "enum": ["authoritative", "representative"],
            "description": "G5 — disclosed-in-source vs bounded hand-seed"
          },
          "screened": {
            "type": "boolean",
            "const": true,
            "description": "G1 INVARIANT — a record only exists after the no-synthesis-route screen passes; there is NO synthesis/precursor/enrichment/processing field on a material record (those keys are unrepresentable)"
          }
        }
      }
    }
  }
}
