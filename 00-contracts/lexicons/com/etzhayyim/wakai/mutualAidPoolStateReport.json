{
  "lexicon": 1,
  "id": "com.etzhayyim.wakai.mutualAidPoolStateReport",
  "description": "Per-period aggregate pool state report. NO individual member-contribution amounts public (aggregate only). G6 STRUCTURAL: poolAssetClass const 'usdc-stable-only'; defiYieldFarmingActiveCount const 0. G10 publicFundBackstopActivationsCount tracks backstop usage. Council Lv6+ ≥3 attestation required.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "createdAt",
          "reportPeriodStartUtc",
          "reportPeriodEndUtc",
          "totalPoolBalanceUsdMillicents",
          "totalContributionsUsdMillicents",
          "totalDistributionsUsdMillicents",
          "poolAssetClass",
          "defiYieldFarmingActiveCount",
          "councilAttestations"
        ],
        "properties": {
          "createdAt": {"type": "string", "format": "datetime"},
          "reportPeriodStartUtc": {"type": "string", "format": "datetime"},
          "reportPeriodEndUtc": {"type": "string", "format": "datetime"},
          "totalPoolBalanceUsdMillicents": {
            "type": "integer",
            "minimum": 0,
            "description": "Pool balance in USD millicents (USD × 100000); aggregate only"
          },
          "totalContributionsUsdMillicents": {"type": "integer", "minimum": 0},
          "totalDistributionsUsdMillicents": {"type": "integer", "minimum": 0},
          "contributorCount": {"type": "integer", "minimum": 0},
          "distributionRecipientCount": {"type": "integer", "minimum": 0},
          "averageContributionUsdMillicents": {
            "type": "integer",
            "description": "Aggregate average; individual amounts encrypted"
          },
          "distributionsByNeedCategory": {
            "type": "array",
            "items": {"type": "ref", "ref": "#distributionByCategory"}
          },
          "poolAssetClass": {
            "type": "string",
            "const": "usdc-stable-only",
            "description": "G6 STRUCTURAL: const 'usdc-stable-only'; no DeFi yield farming; no token speculation"
          },
          "defiYieldFarmingActiveCount": {
            "type": "integer",
            "const": 0,
            "description": "G6 STRUCTURAL: const 0; no Aave / Compound / Curve / Uniswap LP positions"
          },
          "tokenSpeculationActiveCount": {
            "type": "integer",
            "const": 0,
            "description": "G6 STRUCTURAL: const 0"
          },
          "publicFundBackstopActivationsCount": {
            "type": "integer",
            "description": "Number of times Public Fund backstop was activated this period (G10 audit signal)"
          },
          "publicFundBackstopTotalUsdMillicents": {
            "type": "integer",
            "description": "Total backstop disbursement this period (cross-actor toritate accounting)"
          },
          "communityDiscernmentEventsCount": {
            "type": "integer",
            "description": "Total community discernment events (G9 invariant audit)"
          },
          "councilAttestations": {
            "type": "array",
            "items": {"type": "string"},
            "minLength": 3
          },
          "publishedAtMstUri": {"type": "string"},
          "ipfsPinCid": {"type": "string"}
        }
      }
    },
    "distributionByCategory": {
      "type": "object",
      "required": ["needCategory", "distributionCount", "totalAmountUsdMillicents"],
      "properties": {
        "needCategory": {
          "type": "string",
          "knownValues": ["health-event", "disability", "death-of-breadwinner", "unemployment", "disaster-emergency", "subsistence-gap", "child-education", "elder-care-gap", "other-community-discerned"]
        },
        "distributionCount": {"type": "integer"},
        "totalAmountUsdMillicents": {"type": "integer"}
      }
    }
  }
}
