{
  "lexicon": 1,
  "id": "com.etzhayyim.musubi.communityWitnessAttestation",
  "description": "Per-ceremony witnesses. G10 STRUCTURAL: multi-generational invariant; witnessCohortMix MUST include witnesses across age cohorts where ceremony category allows (marriage / naming / funeral / vocation-vow encouraged to include children + elders). Witness DIDs MUST be Adherent SBT holders (cross-actor chigiri verification).",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "createdAt",
          "ceremonyPerformanceAttestationCid",
          "witnessDids",
          "witnessCohortMix",
          "ceremonyTypeCategory"
        ],
        "properties": {
          "createdAt": {"type": "string", "format": "datetime"},
          "ceremonyPerformanceAttestationCid": {
            "type": "string",
            "description": "Back-reference to ceremonyPerformanceAttestation CID"
          },
          "witnessDids": {
            "type": "array",
            "items": {"type": "string"},
            "minLength": 1,
            "description": "Witness DIDs (MUST be Adherent SBT holders; chigiri verification at cell level)"
          },
          "witnessCohortMix": {
            "type": "object",
            "required": ["under18Count", "adultCount", "over65Count"],
            "properties": {
              "under18Count": {"type": "integer", "minimum": 0},
              "adultCount": {"type": "integer", "minimum": 0},
              "over65Count": {"type": "integer", "minimum": 0},
              "totalWitnesses": {"type": "integer", "minimum": 0}
            },
            "description": "G10 STRUCTURAL: multi-gen witness mix per Charter §1.7"
          },
          "ceremonyTypeCategory": {
            "type": "string",
            "knownValues": ["marriage", "naming", "funeral", "vocation-vow", "rededication", "covenant-restoration", "seasonal-communal"]
          },
          "witnessSignatures": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Per-witness DID-bound signatures attesting presence"
          },
          "kotobaDatomicAttestationCid": {"type": "string"}
        }
      }
    }
  }
}
