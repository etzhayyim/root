{
  "lexicon": 1,
  "id": "com.etzhayyim.tatekata.safetyIncidentReport",
  "description": "On-site safety incident log. Per ADR-2605250715 gate G13.",
  "defs": {
    "main": {
      "type": "record",
      "record": {
        "type": "object",
        "properties": {
          "projectId": {"type": "string"},
          "incidentDate": {"type": "string"},
          "reportDate": {"type": "string"},
          "incidentType": {"type": "string", "enum": ["fall", "electrical_shock", "struck_by", "equipment_failure", "near_miss", "property_damage", "other"]},
          "severity": {"type": "string", "enum": ["near_miss", "minor_injury", "serious_injury", "fatality"]},
          "description": {"type": "string"},
          "rootCause": {"type": "string"},
          "correctiveActions": {"type": "array", "items": {"type": "string"}},
          "escalation": {"type": "string", "enum": ["none", "site_supervisor", "safety_officer", "regulatory_authority"]}
        },
        "required": ["projectId", "incidentDate", "reportDate", "incidentType", "severity", "description"]
      }
    }
  }
}
