{
  "lexicon": 1,
  "id": "com.etzhayyim.tatekata.siteAttestation",
  "description": "Site survey attestation. Geotechnical analysis, utilities, hazards. Per ADR-2605250715.",
  "defs": {
    "main": {
      "type": "record",
      "record": {
        "type": "object",
        "properties": {
          "siteId": {"type": "string"},
          "surveyDate": {"type": "string"},
          "soilClassification": {"type": "string"},
          "bearingCapacityKpa": {"type": "integer"},
          "waterTableMeters": {"type": "integer"},
          "existingUtilities": {"type": "array", "items": {"type": "string"}},
          "hazards": {"type": "array", "items": {"type": "string"}},
          "estimatedVolumeM3": {"type": "integer"},
          "attestingRobots": {"type": "array", "items": {"type": "string"}, "minItems": 2}
        },
        "required": ["siteId", "surveyDate", "soilClassification", "attestingRobots"]
      }
    }
  }
}
