{
  "lexicon": 1,
  "id": "com.etzhayyim.tatekata.constructionProgressRecord",
  "description": "Construction phase boundary record. Progress %, CIDs, anomalies. Per ADR-2605250715.",
  "defs": {
    "main": {
      "type": "record",
      "record": {
        "type": "object",
        "properties": {
          "projectId": {"type": "string"},
          "phase": {"type": "string", "enum": ["foundation_excavation", "structural_assembly", "mep_installation", "finishing_handoff", "commissioning"]},
          "completionPct": {"type": "integer", "minimum": 0, "maximum": 100},
          "recordedDate": {"type": "string"},
          "photoCid": {"type": "string"},
          "depthMapCid": {"type": "string"},
          "anomalyFlags": {"type": "array", "items": {"type": "string"}},
          "attestingRobots": {"type": "array", "items": {"type": "string"}, "minItems": 2}
        },
        "required": ["projectId", "phase", "completionPct", "recordedDate", "attestingRobots"]
      }
    }
  }
}
