{
  "lexicon": 1,
  "id": "com.etzhayyim.tatekata.materialAttestation",
  "description": "Material delivery & QA attestation. Charter Rider §2(g) supply chain compliance. Per ADR-2605250715.",
  "defs": {
    "main": {
      "type": "record",
      "record": {
        "type": "object",
        "properties": {
          "projectId": {"type": "string"},
          "batchId": {"type": "string"},
          "batchCid": {"type": "string"},
          "materialType": {"type": "string", "enum": ["concrete", "steel_rebar", "steel_structural", "drywall", "paint", "insulation", "roofing", "hvac_duct", "electrical_conduit", "plumbing_pipe", "fasteners", "other"]},
          "grade": {"type": "string"},
          "standard": {"type": "string"},
          "quantityValue": {"type": "integer"},
          "quantityUnit": {"type": "string", "enum": ["m3", "kg", "sheets", "meters_linear", "liters", "gallons", "items"]},
          "deliveryDate": {"type": "string"},
          "supplierName": {"type": "string"},
          "countryOfOrigin": {"type": "string"},
          "conflictMineralAudit": {"type": "boolean"},
          "rareEarthFree": {"type": "boolean"},
          "qcResult": {"type": "string", "enum": ["pass", "conditional", "fail"]},
          "attestingRobots": {"type": "array", "items": {"type": "string"}, "minItems": 2}
        },
        "required": ["projectId", "batchId", "materialType", "grade", "standard", "quantityValue", "quantityUnit", "deliveryDate", "supplierName", "qcResult", "attestingRobots"]
      }
    }
  }
}
