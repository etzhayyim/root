{
  "lexicon": 1,
  "id": "com.etzhayyim.toritate.financialAttestation",
  "description": "Per-period (daily / monthly / quarterly / annual) summary attestation. Emitted by tithe_accounting / public_fund_accounting / council_compensation / steward_subsistence_accounting cells. G10 structural: publishedDonorPii enum DELIBERATELY excludes 'verbatim-donor-names' value. R0 = schema skeleton; R1 = additionalProperties=false + required-field enforcement.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "createdAt",
          "periodKind",
          "periodStartUtc",
          "periodEndUtc",
          "scope",
          "publishedDonorPii",
          "attestingCellDid"
        ],
        "properties": {
          "createdAt": {"type": "string", "format": "datetime"},
          "periodKind": {
            "type": "string",
            "knownValues": ["daily", "monthly", "quarterly", "annual"]
          },
          "periodStartUtc": {"type": "string", "format": "datetime"},
          "periodEndUtc": {"type": "string", "format": "datetime"},
          "scope": {
            "type": "string",
            "knownValues": [
              "tithe-income",
              "public-fund-disbursement",
              "council-operational-expense",
              "steward-subsistence-flow",
              "external-counsel-engagement",
              "aggregate-multi-scope"
            ]
          },
          "totalAmountUsdMillicents": {
            "type": "integer",
            "minimum": 0,
            "description": "USD millicents (USD × 100000)"
          },
          "transactionCount": {"type": "integer", "minimum": 0},
          "publishedDonorPii": {
            "type": "string",
            "knownValues": ["none", "aggregated-only", "opt-in-explicit"],
            "description": "G10 STRUCTURAL: 'verbatim-donor-names' is NOT a valid value. Default = aggregated-only."
          },
          "supportingLedgerEntryCids": {
            "type": "array",
            "items": {"type": "string"},
            "description": "IPFS CIDs of underlying ledgerEntry records for audit trail."
          },
          "charterRiderScanPass": {"type": "boolean"},
          "charterRiderScanRunCid": {"type": "string"},
          "kotobaDatomicAttestationCid": {"type": "string"},
          "attestingCellDid": {
            "type": "string",
            "description": "DID of the toritate cell emitting this attestation"
          }
        }
      }
    }
  }
}
