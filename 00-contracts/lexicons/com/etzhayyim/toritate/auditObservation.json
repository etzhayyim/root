{
  "lexicon": 1,
  "id": "com.etzhayyim.toritate.auditObservation",
  "description": "Audit anomaly / finding emitted by any toritate cell. Critical findings (e.g., Tithe split mismatch / unrecognized counterparty repeated / amount delta > threshold) route to chigiri.disputeMediation cell escalation. Severity enum constrains routing path; routing decisions are CELL logic, schema only declares the observation.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "createdAt",
          "sourceCellDid",
          "observationCategory",
          "severity",
          "description"
        ],
        "properties": {
          "createdAt": {"type": "string", "format": "datetime"},
          "sourceCellDid": {
            "type": "string",
            "description": "DID of the cell that observed the anomaly"
          },
          "observationCategory": {
            "type": "string",
            "knownValues": [
              "tithe-split-mismatch",
              "unrecognized-counterparty",
              "amount-delta-exceeds-threshold",
              "unusual-frequency",
              "missing-supporting-document",
              "lexicon-validation-fail",
              "charter-rider-scan-fail",
              "subsistence-flow-classification-drift",
              "external-counsel-engagement-without-council",
              "fiat-leak-attempt",
              "commercial-accounting-software-integration-attempt"
            ]
          },
          "severity": {
            "type": "string",
            "knownValues": ["info", "warning", "critical"],
            "description": "critical = halt cell + escalate to Council Lv6+ via chigiri.disputeMediation cell"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "description": "Human-readable description; passes through PII filter"
          },
          "relatedTxCids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "relatedLedgerEntryCids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "councilEscalationCid": {
            "type": "string",
            "description": "If severity=critical, the chigiri.disputeMediation record CID created from this observation"
          },
          "remediationActionTakenAtUtc": {"type": "string", "format": "datetime"},
          "remediationActionDescription": {"type": "string"},
          "resolvedAt": {"type": "string", "format": "datetime"}
        }
      }
    }
  }
}
