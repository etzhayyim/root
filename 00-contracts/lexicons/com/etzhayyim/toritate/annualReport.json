{
  "lexicon": 1,
  "id": "com.etzhayyim.toritate.annualReport",
  "description": "Annual transparency report (calendar year basis). G6 STRUCTURAL: councilAttestations MUST contain ≥3 distinct Council Lv6+ DIDs. Published to MST + IPFS pin (G9 replicationMin: 2). Public access via toritate XRPC getAnnualReport.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "createdAt",
          "reportYearUtc",
          "summary",
          "totalIncomeUsdMillicents",
          "totalDisbursementUsdMillicents",
          "tithePublicFundContributionUsdMillicents",
          "councilAttestations",
          "publishedAtMstUri",
          "ipfsPinCid"
        ],
        "properties": {
          "createdAt": {"type": "string", "format": "datetime"},
          "reportYearUtc": {
            "type": "string",
            "description": "Calendar year (ISO 8601 year, e.g., '2026')"
          },
          "summary": {
            "type": "string",
            "maxLength": 4000,
            "description": "Human-readable executive summary. Passes through Charter Rider §2 scan + PII filter."
          },
          "totalIncomeUsdMillicents": {"type": "integer", "minimum": 0},
          "totalDisbursementUsdMillicents": {"type": "integer", "minimum": 0},
          "tithePublicFundContributionUsdMillicents": {
            "type": "integer",
            "minimum": 0,
            "description": "10% Tithe auto-split contribution to Public Fund per ADR-2605192130"
          },
          "incomeSourceBreakdown": {
            "type": "array",
            "items": {"type": "ref", "ref": "#incomeSourceEntry"}
          },
          "disbursementBreakdown": {
            "type": "array",
            "items": {"type": "ref", "ref": "#disbursementEntry"}
          },
          "landTrustAcquisitions": {
            "type": "array",
            "items": {"type": "ref", "ref": "#landAcquisitionEntry"},
            "description": "Square-meterage + donor + date only (N12 — no market valuation; inalienable per ADR-2605192245)"
          },
          "stewardLAdvancement": {
            "type": "object",
            "properties": {
              "totalSteward": {"type": "integer"},
              "byLevel": {
                "type": "object",
                "properties": {
                  "L0": {"type": "integer"},
                  "L1": {"type": "integer"},
                  "L2": {"type": "integer"},
                  "L3": {"type": "integer"},
                  "L4": {"type": "integer"},
                  "L5": {"type": "integer"},
                  "L6": {"type": "integer"}
                }
              }
            },
            "description": "Liberation Ladder L0..L6 progression (year-end snapshot)"
          },
          "councilAttestations": {
            "type": "array",
            "items": {"type": "string"},
            "minLength": 3,
            "description": "≥3 distinct Council Lv6+ DIDs (G6)"
          },
          "publishedAtMstUri": {"type": "string"},
          "ipfsPinCid": {"type": "string"},
          "externalAuditorOpinionCid": {
            "type": "string",
            "description": "If external auditor opinion was procured (R3+), the opinion document CID"
          },
          "publicCommentPeriodOpenAtUtc": {"type": "string", "format": "datetime"},
          "publicCommentPeriodEndsAtUtc": {"type": "string", "format": "datetime"},
          "publicCommentSummaryCid": {
            "type": "string",
            "description": "After comment period close, aggregated comments summary CID"
          },
          "attestingDid": {"type": "string"}
        }
      }
    },
    "incomeSourceEntry": {
      "type": "object",
      "properties": {
        "category": {"type": "string", "knownValues": ["donation-income", "kisha-income", "grant-income"]},
        "amountUsdMillicents": {"type": "integer"},
        "transactionCount": {"type": "integer"}
      }
    },
    "disbursementEntry": {
      "type": "object",
      "properties": {
        "category": {"type": "string"},
        "amountUsdMillicents": {"type": "integer"},
        "transactionCount": {"type": "integer"}
      }
    },
    "landAcquisitionEntry": {
      "type": "object",
      "properties": {
        "landRegistryCid": {"type": "string"},
        "squareCentimeters": {"type": "integer", "minimum": 0, "description": "Area in cm² (1 m² = 10,000)."},
        "donorDid": {"type": "string"},
        "acquisitionDateUtc": {"type": "string", "format": "datetime"}
      }
    }
  }
}
