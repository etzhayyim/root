{
  "lexicon": 1,
  "id": "com.etzhayyim.kabuto.registerCompany",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Assert a PUBLIC (exchange-listed) company into the kotoba Datom log (:company/* + optional :company.address/* + :company.contact/*). Public-record data only — name, ticker, exchange, LEI/ISIN, registered HQ address, published IR contact, sector (kabuto G1). NEVER personal PII or non-public commercial terms.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["companyId", "name", "exchange", "country", "sector", "status", "sourcing", "observedAt"],
          "properties": {
            "companyId": { "type": "string", "description": ":company/id, reuses tsumugi org space, e.g. \"org.corp.tw.tsmc\"" },
            "name": { "type": "string" },
            "ticker": { "type": "string", "description": "primary listing ticker, e.g. \"2330.TW\"" },
            "exchange": { "type": "string", "description": ":company/exchange keyword without colon, e.g. \"tse\", \"nasdaq\", \"krx\"" },
            "lei": { "type": "string", "description": "GLEIF Legal Entity Identifier (20 chars), if public" },
            "isin": { "type": "string" },
            "country": { "type": "string", "description": "ISO 3166-1 alpha-2 of domicile" },
            "sector": { "type": "string", "enum": ["semiconductors", "automotive", "electronics", "energy", "pharma", "shipping", "materials", "industrials", "consumer", "financials", "telecom", "software", "utilities", "healthcare", "real_estate"] },
            "industry": { "type": "string" },
            "status": { "type": "string", "enum": ["listed", "delisted", "acquired", "private"] },
            "marketCapMusd": { "type": "integer", "description": "approx market cap in MILLION USD (integer, implied units); :representative snapshot, NOT a live quote" },
            "address": {
              "type": "object",
              "description": "optional registered HQ address (public record)",
              "properties": {
                "kind": { "type": "string", "enum": ["hq", "registered", "ir", "plant"] },
                "street": { "type": "string" },
                "city": { "type": "string" },
                "region": { "type": "string" },
                "country": { "type": "string" },
                "postal": { "type": "string" },
                "latE6": { "type": "integer", "description": "latitude in micro-degrees (degrees × 1e6, integer implied units)" },
                "lonE6": { "type": "integer", "description": "longitude in micro-degrees (degrees × 1e6, integer implied units)" }
              }
            },
            "contact": {
              "type": "object",
              "description": "optional PUBLIC corporate contact (never personal PII)",
              "properties": {
                "website": { "type": "string" },
                "irUrl": { "type": "string" },
                "irEmail": { "type": "string", "description": "published corporate / IR email only" },
                "irPhone": { "type": "string" }
              }
            },
            "sourcing": { "type": "string", "enum": ["authoritative", "representative", "synthesized"], "description": "kabuto G5 sourcing honesty" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "companyId": { "type": "string" },
            "txCid": { "type": "string", "description": "kotoba transaction CID (content-addressed Datom log; ADR-2605312345)" },
            "datomCount": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
