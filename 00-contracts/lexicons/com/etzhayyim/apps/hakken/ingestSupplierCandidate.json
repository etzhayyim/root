{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.hakken.ingestSupplierCandidate",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Ingest an OEM/supplier candidate (AliExpress / Alibaba / 1688 listing) into the kotoba product knowledge graph as an on-chain com.etzhayyim.apps.hakken.supplierCandidate record, optionally linked to the branded product it is equivalent to. Idempotent: re-ingesting the same itemId upserts. Weight is carried in grams (integer) because AT Lexicon has no float type.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["itemId", "platform", "name", "priceJpy", "weightG", "ratingMilli", "reviewCount", "supplierCountryIso3"],
          "properties": {
            "itemId": { "type": "string", "description": "Marketplace item id, used as record key." },
            "platform": { "type": "string", "knownValues": ["aliexpress", "alibaba", "1688"] },
            "name": { "type": "string" },
            "url": { "type": "string" },
            "priceJpy": { "type": "integer" },
            "weightG": { "type": "integer", "description": "Item weight in grams (integer; vendor's weight_kg float × 1000)." },
            "ratingMilli": { "type": "integer", "description": "Rating × 1000, 0-5000 (vendor's rating float × 1000)." },
            "reviewCount": { "type": "integer" },
            "material": { "type": "string" },
            "thicknessCm": { "type": "integer" },
            "washable": { "type": "boolean" },
            "leadDays": { "type": "integer" },
            "minOrder": { "type": "integer" },
            "supplierCountryIso3": { "type": "string" },
            "equivalentOfSlug": { "type": "string", "description": "productSlug of the branded product this candidate is an OEM equivalent of." }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["status", "itemId"],
          "properties": {
            "status": { "type": "string", "knownValues": ["ingested", "upserted", "rejected"] },
            "itemId": { "type": "string" },
            "uri": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
