{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.hakken.listSupplierCandidates",
  "defs": {
    "main": {
      "type": "query",
      "description": "List ingested OEM/supplier candidates, optionally filtered by platform or by the branded product they are equivalent to. Paginated.",
      "parameters": {
        "type": "params",
        "properties": {
          "platform": { "type": "string", "knownValues": ["aliexpress", "alibaba", "1688"] },
          "equivalentOfSlug": { "type": "string" },
          "cursor": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items", "limit"],
          "properties": {
            "items": {
              "type": "array",
              "items": { "type": "ref", "ref": "#candidateView" }
            },
            "cursor": { "type": "string" },
            "limit": { "type": "integer" }
          }
        }
      }
    },
    "candidateView": {
      "type": "object",
      "required": ["itemId", "platform", "name", "priceJpy", "weightG", "ratingMilli", "reviewCount", "supplierCountryIso3", "uri"],
      "properties": {
        "itemId": { "type": "string" },
        "platform": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string" },
        "priceJpy": { "type": "integer" },
        "weightG": { "type": "integer" },
        "ratingMilli": { "type": "integer" },
        "reviewCount": { "type": "integer" },
        "material": { "type": "string" },
        "thicknessCm": { "type": "integer" },
        "washable": { "type": "boolean" },
        "leadDays": { "type": "integer" },
        "minOrder": { "type": "integer" },
        "supplierCountryIso3": { "type": "string" },
        "equivalentOfSlug": { "type": "string" },
        "uri": { "type": "string" }
      }
    }
  }
}
