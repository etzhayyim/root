{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.hakken.listProducts",
  "defs": {
    "main": {
      "type": "query",
      "description": "List ingested branded reference products, optionally filtered by category. Paginated.",
      "parameters": {
        "type": "params",
        "properties": {
          "category": { "type": "string" },
          "cursor": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items", "limit"],
          "properties": {
            "items": {
              "type": "array",
              "items": { "type": "ref", "ref": "#productView" }
            },
            "cursor": { "type": "string" },
            "limit": { "type": "integer" }
          }
        }
      }
    },
    "productView": {
      "type": "object",
      "required": ["productSlug", "name", "brand", "category", "priceJpy", "uri"],
      "properties": {
        "productSlug": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "category": { "type": "string" },
        "priceJpy": { "type": "integer" },
        "url": { "type": "string" },
        "material": { "type": "string" },
        "uri": { "type": "string" }
      }
    }
  }
}
