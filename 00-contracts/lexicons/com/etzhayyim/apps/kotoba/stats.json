{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kotoba.stats",
  "defs": {
    "main": {
      "type": "query",
      "description": "Publish-outcome counters for a graph, tallied atomically by the authoritative-head Durable Object (which serializes every advance / conflict / rate-limited attempt). Public, no PII — an operability/monitoring surface for publish health, conflict rate, and abuse.",
      "parameters": {
        "type": "params",
        "required": [],
        "properties": {
          "graph": { "type": "string", "description": "Graph id (default yoro-social-v1)." }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["graph"],
          "properties": {
            "graph": { "type": "string" },
            "advances": { "type": "integer", "description": "Successful head advances." },
            "conflicts": { "type": "integer", "description": "409 rebase-required outcomes." },
            "rateLimited": { "type": "integer", "description": "429 token-bucket rejections." },
            "lastAdvanceAt": { "type": "string", "format": "datetime" },
            "root": { "type": "string", "description": "Current head CID." }
          }
        }
      }
    }
  }
}
