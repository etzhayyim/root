{
  "lexicon": 1,
  "id": "com.etzhayyim.pharma.silenPharmaReview",
  "description": "Council Lv6+ ≥ 3 multisig attestation that a yakushi commit / lot / new API / new dosage form / new jurisdictional launch / safety-class-HIGH raw material intake / aggregation algorithm change / etc. has been reviewed. Mirrors silen-force-review (com.etzhayyim.silicon.silenForceReview) for pharmaceutical scope. Per ADR-2605250500 §Decision 3 G3 + ADR-2605250515 §Decision 6 (per-trigger list) + ADR-2605250530 §Decision 7 + ADR-2605250545 §Decision 7.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "v",
          "scope",
          "scopeUri",
          "riskClass",
          "designIntentNarrative",
          "councilAttestors",
          "verdict",
          "attestedAt"
        ],
        "properties": {
          "v": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1
          },
          "scope": {
            "type": "string",
            "knownValues": [
              "charter-baseline",
              "new-api-addition",
              "synthesis-route-change",
              "cwc-schedule-3-intake",
              "australia-group-intake",
              "high-safety-raw-material-intake",
              "impurity-profile-deviation",
              "ich-m7-pgi-deviation",
              "new-dosage-form",
              "container-material-change",
              "preservative-reintroduction",
              "media-fill-non-conformance",
              "single-use-unit-dose-migration",
              "annex-1-facility-attestation",
              "label-content-template-baseline",
              "qc-analyst-registry",
              "ae-sealed-recipient-registry",
              "ae-aggregation-algorithm-baseline",
              "ae-aggregation-algorithm-change",
              "patient-privacy-cipher-registry",
              "gdp-baseline",
              "qp-equivalent-registry",
              "dangerous-goods-officer-registry",
              "opcw-declaration-channel",
              "jurisdictional-launch",
              "wave-1-launch-pmda",
              "wave-1-launch-fda",
              "wave-1-launch-ema",
              "post-market-signal-escalation",
              "wave-1b-api-addition",
              "wave-1b-dosage-form-tablet-attestation",
              "wave-1b-dosage-form-topical-attestation",
              "tablet-press-equipment-qualification",
              "topical-mixer-equipment-qualification",
              "non-sterile-microbial-limit-baseline",
              "wave-1b-launch-pmda",
              "wave-1b-launch-fda",
              "wave-1b-launch-ema",
              "wave-1c-chiral-resolution-baseline",
              "wave-1c-laxative-formulation-baseline",
              "wave-1c-cough-syrup-formulation-baseline",
              "wave-1c-benzonatate-jp-marginal",
              "cross-actor-ae-aggregation-baseline",
              "ae-dedupe-event",
              "label-warning-update-naphazoline"
            ]
          },
          "scopeUri": {
            "type": "string",
            "format": "uri",
            "description": "Git commit SHA URL, lot-id, AT URI, IPFS CID, or registry CID being reviewed."
          },
          "riskClass": {
            "type": "string",
            "knownValues": [
              "HIGH-2a-weapons-dual-use",
              "HIGH-2c-surveillance",
              "HIGH-2e-gatekeeping",
              "HIGH-2f-multi-gen-harm",
              "HIGH-2h-wellbecoming",
              "HIGH-safety-fire-class-3",
              "HIGH-safety-high-pressure-gas",
              "HIGH-impurity-pgi",
              "HIGH-sterility",
              "MEDIUM-2a",
              "MEDIUM-2c",
              "MEDIUM-2f",
              "MEDIUM-safety",
              "LOW"
            ]
          },
          "designIntentNarrative": {
            "type": "string",
            "maxLength": 8000,
            "description": "Human-authored narrative explaining the intended use, expected misuse vectors, and mitigations. Required for all HIGH risk classes."
          },
          "councilAttestors": {
            "type": "array",
            "minLength": 3,
            "maxLength": 7,
            "items": {
              "type": "string",
              "format": "did"
            },
            "description": "DIDs of Council Lv6+ members who attested. Must be ≥ 3 per master charter §Decision 3 G3."
          },
          "qpEquivalentCoSignDid": {
            "type": "string",
            "format": "did",
            "description": "Required when scope = 'new-api-addition' / 'new-dosage-form' / 'jurisdictional-launch' / 'wave-1-launch-*'."
          },
          "safetyOfficerCoSignDid": {
            "type": "string",
            "format": "did",
            "description": "Required when scope = 'cwc-schedule-3-intake' / 'high-safety-raw-material-intake' / 'media-fill-non-conformance'."
          },
          "verdict": {
            "type": "string",
            "knownValues": [
              "approve",
              "approve-with-conditions",
              "deny",
              "defer-30day-objection",
              "defer-60day-objection"
            ]
          },
          "verdictConditions": {
            "type": "string",
            "maxLength": 4000
          },
          "objectionPeriodEndsAt": {
            "type": "string",
            "format": "datetime"
          },
          "supersedesUri": {
            "type": "string",
            "format": "at-uri"
          },
          "attestedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
