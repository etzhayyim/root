{
  "lexicon": 1,
  "id": "com.etzhayyim.legalEntity.collectNld",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Collect Dutch corporate data from KVK (Kamer van Koophandel) Handelsregister API. KVK number as primary key.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "pages": { "type": "integer", "description": "Number of pages to fetch (default 5, max 50)" },
            "pageSize": { "type": "integer", "description": "Records per page (max 100)" },
            "startPage": { "type": "integer", "description": "Starting page number (default 0)" },
            "type": { "type": "string", "description": "Filter: hoofdvestiging, nevenvestiging, rechtspersoon" }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "source": { "type": "string" },
            "pagesProcessed": { "type": "integer" },
            "totalInserted": { "type": "integer" },
            "totalSkipped": { "type": "integer" },
            "apiTotal": { "type": "integer" }
          }
        }
      }
    }
  }
}
