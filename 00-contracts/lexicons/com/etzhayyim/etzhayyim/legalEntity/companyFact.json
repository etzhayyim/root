{
  "lexicon": 1,
  "id": "com.etzhayyim.legalEntity.companyFact",
  "description": "Normalized public-company fact extracted from filings or disclosure feeds. Supports numeric and text values plus reporting period metadata.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "companyDid",
          "factNamespace",
          "factName",
          "sourceMethod",
          "createdAt"
        ],
        "properties": {
          "companyDid": { "type": "string" },
          "filingDid": { "type": "string" },
          "factNamespace": { "type": "string" },
          "factName": { "type": "string" },
          "factValueNum": { "type": "number" },
          "factValueText": { "type": "string" },
          "unit": { "type": "string" },
          "currency": { "type": "string" },
          "periodStart": { "type": "string", "format": "date" },
          "periodEnd": { "type": "string", "format": "date" },
          "asOfDate": { "type": "string", "format": "date" },
          "fiscalYear": { "type": "integer" },
          "fiscalQuarter": { "type": "integer" },
          "sourceUrl": { "type": "string", "format": "uri" },
          "sourceMethod": { "type": "string" },
          "confidence": { "type": "number" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
