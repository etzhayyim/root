{
  "lexicon": 1,
  "id": "com.etzhayyim.legalEntity.collectFra",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Collect French corporate data from INSEE SIRENE API. SIREN/SIRET as primary key.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "pages": { "type": "integer", "description": "Number of pages to fetch (default 5, max 50)" },
            "pageSize": { "type": "integer", "description": "Records per page (max 1000, SIRENE default 20)" },
            "cursor": { "type": "string", "description": "Cursor for pagination (from previous response)" },
            "activesOnly": { "type": "boolean", "description": "Filter active entities only (default true)" },
            "departement": { "type": "string", "description": "Filter by departement code (01-95, 2A, 2B, 971-976)" }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "source": { "type": "string" },
            "pagesProcessed": { "type": "integer" },
            "totalInserted": { "type": "integer" },
            "totalSkipped": { "type": "integer" },
            "apiTotal": { "type": "integer" }
          }
        }
      }
    }
  }
}
