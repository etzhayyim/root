{
  "lexicon": 1,
  "id": "com.etzhayyim.legalEntity.commitSecDisclosure",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Thin edge write boundary for Zeebe-collected SEC company filing and company fact records.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "source": { "type": "string" },
            "cik": { "type": "string" },
            "ticker": { "type": "string" },
            "companyDid": { "type": "string" },
            "filings": { "type": "array", "items": { "type": "object" } },
            "facts": { "type": "array", "items": { "type": "object" } }
          },
          "required": ["filings", "facts"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "source": { "type": "string" },
            "cik": { "type": "string" },
            "ticker": { "type": "string" },
            "companyDid": { "type": "string" },
            "filingsInserted": { "type": "integer" },
            "factsInserted": { "type": "integer" },
            "filingsSkipped": { "type": "integer" },
            "factsSkipped": { "type": "integer" },
            "firstError": { "type": "string" },
            "ts": { "type": "string", "format": "datetime" }
          },
          "required": ["ok"]
        }
      }
    }
  }
}
