{
  "lexicon": 1,
  "id": "com.etzhayyim.legalEntity.entityRelation",
  "description": "Relationship edge between legal entities with explicit statement provenance and optional commercial metadata.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "edgeId",
          "relationshipType",
          "sourceLicense",
          "confidence",
          "linkedAt",
          "createdAt"
        ],
        "properties": {
          "edgeId": { "type": "string" },
          "statementId": { "type": "string" },
          "srcVertexId": { "type": "string" },
          "srcLei": { "type": "string" },
          "srcSource": { "type": "string" },
          "srcSourceRecordId": { "type": "string" },
          "srcName": { "type": "string" },
          "srcCountry": { "type": "string" },
          "dstVertexId": { "type": "string" },
          "dstLei": { "type": "string" },
          "dstSource": { "type": "string" },
          "dstSourceRecordId": { "type": "string" },
          "dstName": { "type": "string" },
          "dstCountry": { "type": "string" },
          "relationshipType": { "type": "string" },
          "relationScope": { "type": "string" },
          "amount": { "type": "number" },
          "amountCurrency": { "type": "string" },
          "periodStart": { "type": "string", "format": "date" },
          "periodEnd": { "type": "string", "format": "date" },
          "sourceUrl": { "type": "string", "format": "uri" },
          "sourceLicense": { "type": "string" },
          "confidence": { "type": "number" },
          "linkedAt": { "type": "string", "format": "datetime" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
