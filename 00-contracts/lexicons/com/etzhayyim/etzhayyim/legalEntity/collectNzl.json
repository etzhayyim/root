{
  "lexicon": 1,
  "id": "com.etzhayyim.legalEntity.collectNzl",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Collect New Zealand corporate data from Companies Office (MBIE). NZ Company Number (NZBN) as primary key.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "pages": { "type": "integer", "description": "Number of pages to fetch (default 5, max 50)" },
            "pageSize": { "type": "integer", "description": "Records per page (max 50)" },
            "startPage": { "type": "integer", "description": "Starting page number (default 0)" },
            "entityType": { "type": "string", "description": "Filter: NZ Limited Company, NZ Unlimited Company, Overseas ASIC Company, etc." },
            "entityStatus": { "type": "string", "description": "Filter: Registered, Removed, etc." }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "source": { "type": "string" },
            "pagesProcessed": { "type": "integer" },
            "totalInserted": { "type": "integer" },
            "totalSkipped": { "type": "integer" },
            "apiTotal": { "type": "integer" }
          }
        }
      }
    }
  }
}
