{
  "lexicon": 1,
  "id": "com.etzhayyim.legalEntity.commitEntities",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Thin edge write boundary for Zeebe-collected legal entity records.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "source": { "type": "string" },
            "page": { "type": "integer" },
            "records": { "type": "array", "items": { "type": "object" } }
          },
          "required": ["records"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "source": { "type": "string" },
            "page": { "type": "integer" },
            "inserted": { "type": "integer" },
            "skipped": { "type": "integer" },
            "error": { "type": "string" },
            "ts": { "type": "string" }
          },
          "required": ["ok"]
        }
      }
    }
  }
}
