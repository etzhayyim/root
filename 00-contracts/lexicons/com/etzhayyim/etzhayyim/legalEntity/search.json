{
  "lexicon": 1,
  "id": "com.etzhayyim.legalEntity.search",
  "defs": {
    "main": {
      "type": "query",
      "description": "Search legal entities by exact name match.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "query": { "type": "string" },
            "limit": { "type": "integer" }
          },
          "required": ["query"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "items": { "type": "array" },
            "count": { "type": "integer" }
          }
        }
      }
    }
  }
}
