{
  "lexicon": 1,
  "id": "com.etzhayyim.plc.resolveDid",
  "defs": {
    "main": {
      "type": "query",
      "description": "Proxy for plc.etzhayyim.com GET /{did} — returns the current W3C DID document by replaying the signed op log. Caller-side alternative: fetch plc.etzhayyim.com directly (no PDS auth required for public DIDs).",
      "parameters": {
        "type": "params",
        "required": ["did"],
        "properties": {
          "did": {
            "type": "string",
            "format": "did"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did", "document"],
          "properties": {
            "did": { "type": "string", "format": "did" },
            "document": {
              "type": "unknown",
              "description": "W3C DID document (JSON-LD) derived from op log"
            },
            "source": {
              "type": "string",
              "enum": ["plc.etzhayyim.com", "did:web", "cache"],
              "description": "which resolver satisfied the query"
            },
            "resolvedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "errors": [
        { "name": "DidNotFound" },
        { "name": "DidDeactivated", "description": "DID has been tombstoned" },
        { "name": "PlcDirectoryUnreachable" }
      ]
    }
  }
}
