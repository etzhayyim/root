{
  "lexicon": 1,
  "id": "com.etzhayyim.identity.resolve",
  "description": "Resolve identity. Superset of com.atproto.identity.resolveHandle / resolveDid — returns full identityInfo including didDoc.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "did": {
            "type": "string",
            "format": "did"
          },
          "handle": {
            "type": "string",
            "format": "handle"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "description": "Returns official com.atproto.identity.defs#identityInfo (did, handle, didDoc).",
          "ref": "com.atproto.identity.defs#identityInfo"
        }
      }
    }
  }
}
