{
  "lexicon": 1,
  "id": "com.etzhayyim.bpmn.executePipeline",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Execute a T1/T2 actor pipeline by DID and pipeline index.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "did": { "type": "string", "description": "Actor DID" },
            "pipelineIndex": { "type": "integer", "default": 0 },
            "input": { "type": "object", "description": "Trigger input data" }
          },
          "required": ["did"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "outputs": { "type": "array", "items": { "type": "object" } },
            "success": { "type": "boolean" },
            "error": { "type": "string" }
          },
          "required": ["outputs", "success"]
        }
      }
    }
  }
}
