{
  "lexicon": 1,
  "id": "com.etzhayyim.bpmn.compileBpmn",
  "defs": {
    "main": {
      "type": "query",
      "description": "Compile BPMN 2.0 XML to ActorManifest pipeline without deployment (validation only).",
      "parameters": {
        "type": "params",
        "properties": {
          "did": { "type": "string", "description": "Target actor DID" },
          "name": { "type": "string" },
          "nanoid": { "type": "string" },
          "bpmnXml": { "type": "string", "description": "BPMN 2.0 XML" },
          "dmnXml": { "type": "string" },
          "formSchemas": { "type": "string", "description": "JSON-encoded form schemas" }
        },
        "required": ["did", "bpmnXml"]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "manifest": { "type": "object" },
            "errors": { "type": "array", "items": { "type": "string" } },
            "warnings": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["success", "errors", "warnings"]
        }
      }
    }
  }
}
