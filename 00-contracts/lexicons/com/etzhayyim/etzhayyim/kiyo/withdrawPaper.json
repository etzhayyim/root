{
  "lexicon": 1,
  "id": "com.etzhayyim.kiyo.withdrawPaper",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Withdraw a paper (sets status=withdrawn). Content remains on IPFS (content-addressed — immutable). Caller must be owner_did.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "paperId": { "type": "string" },
            "reason":  { "type": "string" }
          },
          "required": ["paperId"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "withdrawn": { "type": "boolean" }
          },
          "required": ["withdrawn"]
        }
      }
    }
  }
}
