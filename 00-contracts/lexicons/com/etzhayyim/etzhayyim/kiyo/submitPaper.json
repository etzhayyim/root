{
  "lexicon": 1,
  "id": "com.etzhayyim.kiyo.submitPaper",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Submit a new preprint to kiyo.etzhayyim.com. The PDF (and optionally LaTeX source) must be supplied as base64. A CIDv1 is assigned via ipfs.etzhayyim.com and stored in vertex_kiyo_paper. Triggers submitPaper.bpmn.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "title":           { "type": "string" },
            "abstract":        { "type": "string" },
            "subject":         { "type": "array",  "items": { "type": "string" } },
            "authors":         { "type": "array",  "items": { "type": "string", "description": "AT DID of each author" } },
            "authorType":      { "type": "string",  "description": "human | llm-assisted | llm" },
            "fileBase64":      { "type": "string",  "description": "Base64-encoded PDF" },
            "fileContentType": { "type": "string",  "default": "application/pdf" },
            "sourceBase64":    { "type": "string",  "description": "Base64-encoded LaTeX tarball (optional)" }
          },
          "required": ["title", "abstract", "subject", "authors", "fileBase64"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "accepted":  { "type": "boolean" },
            "paperId":   { "type": "string" },
            "ipfsCid":   { "type": "string" },
            "vertexId":  { "type": "string" }
          },
          "required": ["accepted"]
        }
      }
    }
  }
}
