{
  "lexicon": 1,
  "id": "com.etzhayyim.kiyo.getCitationGraph",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get inbound and outbound citation edges for a paper from edge_kiyo_cites. Resolved DOIs linked via bunken.",
      "parameters": {
        "type": "params",
        "properties": {
          "paperId": { "type": "string" },
          "depth":   { "type": "integer", "default": 1, "description": "1 = direct edges only" }
        },
        "required": ["paperId"]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "paperId":  { "type": "string" },
            "citing": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "srcPaperId":    { "type": "string" },
                  "refLabel":      { "type": "string" },
                  "confidence":    { "type": "integer" }
                }
              }
            },
            "cited": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "dstPaperId":   { "type": "string" },
                  "resolvedDoi":  { "type": "string" },
                  "refLabel":     { "type": "string" },
                  "confidence":   { "type": "integer" }
                }
              }
            }
          },
          "required": ["paperId", "citing", "cited"]
        }
      }
    }
  }
}
