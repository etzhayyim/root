{
  "lexicon": 1,
  "id": "com.etzhayyim.animeka.generateSoundCue",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Stage 11/12 — Generate one sound cue (dialogue via Style-Bert-VITS2 JP / SFX via Stable Audio Open / BGM via MusicGen medium). Caller fanouts per cue. Backed by BPMN animeka_generate_sound_cue (ADR-2604231328).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["cutId", "trackType", "voiceOrPrompt", "durationSec"],
          "properties": {
            "cutId": { "type": "string" },
            "trackType": { "type": "string", "enum": ["dialogue", "sfx", "bgm"] },
            "text": { "type": "string", "description": "Dialogue text (trackType=dialogue). Empty for sfx/bgm." },
            "voiceOrPrompt": { "type": "string", "description": "Voice name for dialogue; prompt for sfx/bgm." },
            "durationSec": { "type": "number" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "blobCid": { "type": "string" }
          }
        }
      }
    }
  }
}
