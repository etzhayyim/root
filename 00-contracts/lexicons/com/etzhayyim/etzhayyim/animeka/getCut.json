{
  "lexicon": 1,
  "id": "com.etzhayyim.animeka.getCut",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a cut with its full layer tree (storyboard, layout, keyframes, inbetweens, colorTrace, background, composite, soundCue, retakes). Drives the Cut Detail view.",
      "parameters": {
        "type": "params",
        "properties": {
          "cutId": { "type": "string" }
        },
        "required": ["cutId"]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "cut": { "type": "unknown" },
            "storyboards": { "type": "array", "items": { "type": "unknown" } },
            "layouts": { "type": "array", "items": { "type": "unknown" } },
            "keyframes": { "type": "array", "items": { "type": "unknown" } },
            "inbetweens": { "type": "array", "items": { "type": "unknown" } },
            "colorTraces": { "type": "array", "items": { "type": "unknown" } },
            "backgrounds": { "type": "array", "items": { "type": "unknown" } },
            "composites": { "type": "array", "items": { "type": "unknown" } },
            "soundCues": { "type": "array", "items": { "type": "unknown" } },
            "retakes": { "type": "array", "items": { "type": "unknown" } }
          }
        }
      }
    }
  }
}
