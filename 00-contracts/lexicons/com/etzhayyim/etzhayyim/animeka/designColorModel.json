{
  "lexicon": 1,
  "id": "com.etzhayyim.animeka.designColorModel",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Stage 7/12 — Design a color model (palette + character color chart) for a character. Typically invoked once per character. Backed by BPMN animeka_design_color_model (ADR-2604231328).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["characterId", "characterDescription"],
          "properties": {
            "characterId": { "type": "string" },
            "characterDescription": { "type": "string" },
            "referenceCid": { "type": "string", "format": "cid" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "blobCid": { "type": "string" },
            "palette": { "type": "unknown" }
          }
        }
      }
    }
  }
}
