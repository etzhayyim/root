{
  "lexicon": 1,
  "id": "com.etzhayyim.animeka.publishEpisode",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Publish or update an episode. Transitions status (typically 'review' → 'delivered' → 'published') and sets masterCid. Transition to 'published' fires the `episode-published-social` derive rule to emit Tier 1 social post (AppBskyFeedPost) authored by the work's path-based DID.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["episodeId"],
          "properties": {
            "episodeId": { "type": "string", "format": "at-uri" },
            "titleJP": { "type": "string" },
            "titleEN": { "type": "string" },
            "status": {
              "type": "string",
              "enum": ["planning", "scripting", "storyboarding", "layout", "keyAnim", "inbetween", "color", "composite", "review", "delivered", "published", "archived"]
            },
            "airDate": { "type": "string", "format": "datetime" },
            "masterCid": { "type": "string", "format": "cid" },
            "thumbCid": { "type": "string", "format": "cid" },
            "announcementText": {
              "type": "string",
              "description": "Optional override for the derived social post body."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["episodeId", "status"],
          "properties": {
            "episodeId": { "type": "string" },
            "status": { "type": "string" },
            "emitted": { "type": "integer" },
            "postUri": { "type": "string", "format": "at-uri" }
          }
        }
      }
    }
  }
}
