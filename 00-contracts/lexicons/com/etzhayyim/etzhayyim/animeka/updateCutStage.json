{
  "lexicon": 1,
  "id": "com.etzhayyim.animeka.updateCutStage",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Update cut.stageStatus and/or cut.assignees for a single pipeline stage. Drives the Pipeline Board kanban. Stage transition to 'approved' may cascade via derive rules (e.g. storyboard→layout, layout→keyAnim+bg).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["cutId", "stage"],
          "properties": {
            "cutId": { "type": "string", "format": "at-uri" },
            "stage": {
              "type": "string",
              "enum": ["script", "storyboard", "layout", "keyAnim", "inbetween", "colorDesign", "finish", "background", "composite", "edit", "sound", "delivery"]
            },
            "status": {
              "type": "string",
              "enum": ["none", "pending", "in_progress", "review", "approved", "retake"]
            },
            "assigneeDid": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["cutId"],
          "properties": {
            "cutId": { "type": "string" },
            "stage": { "type": "string" },
            "status": { "type": "string" },
            "derivedCount": { "type": "integer", "description": "Number of derive rules fired." }
          }
        }
      }
    }
  }
}
