{
  "lexicon": 1,
  "id": "com.etzhayyim.animeka.generateLayout",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Stage 4/12 — Generate a layout paper from an approved storyboard (ControlNet-depth + Animagine 1024x1024). HITL: produces status=draft, director approves downstream. Backed by BPMN animeka_generate_layout (ADR-2604231328).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["cutId", "storyboardUri", "cutSummary"],
          "properties": {
            "cutId": { "type": "string" },
            "storyboardUri": { "type": "string", "format": "at-uri" },
            "cutSummary": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "blobCid": { "type": "string" },
            "layoutPlan": { "type": "unknown" },
            "renderMs": { "type": "integer" }
          }
        }
      }
    }
  }
}
