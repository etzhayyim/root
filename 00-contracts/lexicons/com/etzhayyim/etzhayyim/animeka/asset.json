{
  "lexicon": 1,
  "id": "com.etzhayyim.animeka.asset",
  "defs": {
    "main": {
      "type": "record",
      "description": "Tier 2 domain record for a reusable asset (素材) — effects, ref sheets, LUTs, brushes, screentone-equivalent patterns, etc. Scoped per work (or global if workRef omitted).",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["kind", "name", "blobCid", "createdAt"],
        "properties": {
          "workRef": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef",
            "description": "Optional work scope. Omitted = studio-global asset."
          },
          "kind": {
            "type": "string",
            "enum": ["effect", "refSheet", "lut", "brush", "bgLibrary", "soundLibrary", "template", "styleGuide"]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "blobCid": {
            "type": "string",
            "format": "cid"
          },
          "mimeType": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "author": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
