{
  "lexicon": 1,
  "id": "com.etzhayyim.animeka.renderComposite",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Invoke the compositor AI actor to render the final composite for a cut. Combines colorTrace frames + background + fxStack + camera move into outputCid. Creates com.etzhayyim.apps.animeka.composite record.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["cutId"],
          "properties": {
            "cutId": { "type": "string", "format": "at-uri" },
            "outputFormat": {
              "type": "string",
              "enum": ["mp4", "mov", "pngSeq", "exrSeq"]
            },
            "previewOnly": {
              "type": "boolean",
              "description": "If true, renders low-res preview and sets status='draft'."
            },
            "videoBackend": {
              "type": "string",
              "enum": ["seedance2", "wan5b", "animatediff"],
              "default": "seedance2",
              "description": "Video backend on the RunPod GPU pod (ADR-2604231328). Default seedance2 for faithful camera-move rendering."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri"],
          "properties": {
            "uri": { "type": "string", "format": "at-uri" },
            "outputCid": { "type": "string", "format": "cid" },
            "renderSeconds": { "type": "number" }
          }
        }
      }
    }
  }
}
