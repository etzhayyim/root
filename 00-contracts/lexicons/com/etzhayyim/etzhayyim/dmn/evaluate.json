{
  "lexicon": 1,
  "id": "com.etzhayyim.dmn.evaluate",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Evaluate a DMN 1.3 decision table. Supports hit policies: UNIQUE, FIRST, ANY, COLLECT, RULE_ORDER. Uses FEEL expression evaluation for conditions.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "did": { "type": "string", "description": "Actor DID (optional, for graph lookup scope)" },
            "decisionId": { "type": "string", "description": "Decision key (maps to DmnModel.decision_key)" },
            "inputs": { "type": "object", "description": "Input variables keyed by input column label" },
            "dmnXml": { "type": "string", "description": "Optional inline DMN XML (bypasses graph lookup)" }
          },
          "required": ["decisionId"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "data": {
              "type": "object",
              "properties": {
                "outputs": { "type": "array", "items": { "type": "object" }, "description": "Matched rule outputs" },
                "hitPolicy": { "type": "string" },
                "decisionId": { "type": "string" }
              }
            },
            "error": { "type": "string" }
          },
          "required": ["ok"]
        }
      }
    }
  }
}
