{
  "lexicon": 1,
  "id": "com.etzhayyim.agent.spawnChildOrg",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ADR-2604301200 governed child-org spawn request for a contract-DID autonomous agent.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["parentRootDid", "childName", "childKind", "budgetPolicyCid", "runtimePolicyCid"],
          "properties": {
            "parentRootDid": {
              "type": "string"
            },
            "childName": {
              "type": "string"
            },
            "childKind": {
              "type": "string",
              "description": "org | product | worker | media | service | research"
            },
            "budgetPolicyCid": {
              "type": "string"
            },
            "runtimePolicyCid": {
              "type": "string"
            },
            "reproductionBondWei": {
              "type": "string"
            },
            "initialFundingWei": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {
              "type": "string"
            },
            "childRootDid": {
              "type": "string"
            },
            "childAgentDid": {
              "type": "string"
            },
            "lineageVertexId": {
              "type": "string"
            },
            "approvalRequired": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
