{
  "lexicon": 1,
  "id": "com.etzhayyim.agent.economyProfile",
  "defs": {
    "main": {
      "type": "record",
      "description": "ADR-2604301200 public economy profile for a contract-DID autonomous agent.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["rootDid", "agentDid", "economyMode", "status", "createdAt"],
        "properties": {
          "rootDid": {
            "type": "string",
            "description": "Contract DID, e.g. did:erc725:etzhayyim:260425:0x..."
          },
          "agentDid": {
            "type": "string",
            "description": "atproto facade DID used by the agent socially."
          },
          "smartAccount": {
            "type": "string",
            "description": "0x-prefixed ERC-4337 smart account address."
          },
          "erc8004AgentId": {
            "type": "string",
            "description": "ERC-8004-shaped etzhayyimAgentRegistry token id."
          },
          "economyMode": {
            "type": "string",
            "description": "guarded-social | bonded-compute | sovereign-replicating"
          },
          "policyCid": {
            "type": "string"
          },
          "runtimePolicyCid": {
            "type": "string"
          },
          "slashPolicyCid": {
            "type": "string"
          },
          "treasuryAddr": {
            "type": "string"
          },
          "parentRootDid": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "active | conserve | hibernated | suspended"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
