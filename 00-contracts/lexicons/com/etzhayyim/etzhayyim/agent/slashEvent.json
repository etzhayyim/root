{
  "lexicon": 1,
  "id": "com.etzhayyim.agent.slashEvent",
  "defs": {
    "main": {
      "type": "record",
      "description": "ADR-2604301200 slashing or penalty event against a runtime resource bond.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["slashId", "rootDid", "agentDid", "violationType", "amountGccWei", "status", "occurredAt"],
        "properties": {
          "slashId": {
            "type": "string"
          },
          "leaseId": {
            "type": "string"
          },
          "rootDid": {
            "type": "string"
          },
          "agentDid": {
            "type": "string"
          },
          "violationType": {
            "type": "string",
            "description": "runtime-no-show | false-receipt | resource-overuse | social-spam | fraudulent-claim | child-org-abuse"
          },
          "reasonHash": {
            "type": "string"
          },
          "amountGccWei": {
            "type": "string"
          },
          "beneficiaryAddr": {
            "type": "string"
          },
          "txHash": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "recorded | submitted | settled | appealed | reversed"
          },
          "occurredAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
