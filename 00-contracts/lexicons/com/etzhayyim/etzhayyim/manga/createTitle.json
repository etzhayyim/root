{
  "lexicon": 1,
  "id": "com.etzhayyim.manga.createTitle",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create a manga series/title",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "genre": { "type": "string" },
            "thumbnail_key": { "type": "string" },
            "coin_price": { "type": "integer" },
            "wait_free_hours": { "type": "integer" },
            "user_id": { "type": "string" },
            "org_id": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string" },
            "series_id": { "type": "string" }
          }
        }
      }
    }
  }
}
