{
  "lexicon": 1,
  "id": "com.etzhayyim.manga.submitFromNarou",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Import title and chapter from narou.etzhayyim.com",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["narou_title_id"],
          "properties": {
            "narou_title_id": { "type": "string" },
            "narou_chapter_id": { "type": "string" },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "genre": { "type": "string" },
            "episode_title": { "type": "string" },
            "asset_manifest_uri": { "type": "string" },
            "page_count": { "type": "integer" },
            "thumbnail_key": { "type": "string" },
            "user_id": { "type": "string" },
            "org_id": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["title_id"],
          "properties": {
            "title_id": { "type": "string" },
            "chapter_id": { "type": "string" }
          }
        }
      }
    }
  }
}
