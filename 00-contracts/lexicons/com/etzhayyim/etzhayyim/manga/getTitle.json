{
  "lexicon": 1,
  "id": "com.etzhayyim.manga.getTitle",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a manga title by ID",
      "parameters": {
        "type": "params",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "series_id": { "type": "string" },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "genre": { "type": "string" },
            "status": { "type": "string" },
            "thumbnail_key": { "type": "string" },
            "coin_price": { "type": "integer" },
            "wait_free_hours": { "type": "integer" },
            "chapter_count": { "type": "integer" },
            "created_at": { "type": "string" }
          }
        }
      }
    }
  }
}
