{
  "lexicon": 1,
  "id": "com.etzhayyim.manga.createChapter",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create a chapter under a manga title",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["title_id", "chapter_num", "episode_title"],
          "properties": {
            "title_id": { "type": "string" },
            "chapter_num": { "type": "integer" },
            "episode_title": { "type": "string" },
            "asset_manifest_uri": { "type": "string" },
            "page_count": { "type": "integer" },
            "user_id": { "type": "string" },
            "org_id": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string" }
          }
        }
      }
    }
  }
}
