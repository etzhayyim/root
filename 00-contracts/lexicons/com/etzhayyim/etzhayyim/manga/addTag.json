{
  "lexicon": 1,
  "id": "com.etzhayyim.manga.addTag",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Add a tag to a manga title",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["title_id", "tag"],
          "properties": {
            "title_id": { "type": "string" },
            "tag": { "type": "string" },
            "user_id": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["title_id", "tag"],
          "properties": {
            "title_id": { "type": "string" },
            "tag": { "type": "string" }
          }
        }
      }
    }
  }
}
