{
  "lexicon": 1,
  "id": "com.etzhayyim.manga.listTitles",
  "defs": {
    "main": {
      "type": "query",
      "description": "List manga titles",
      "parameters": {
        "type": "params",
        "properties": {
          "genre": { "type": "string" },
          "status": { "type": "string" },
          "user_id": { "type": "string" },
          "offset": { "type": "integer" },
          "limit": { "type": "integer" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["titles", "total", "offset", "limit"],
          "properties": {
            "titles": { "type": "array", "items": { "type": "object" } },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
