{
  "lexicon": 1,
  "id": "com.etzhayyim.govVen.listOrgs",
  "defs": {
    "main": {
      "type": "query",
      "description": "List Venezuela government organization graph records.",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "q": {
            "type": "string"
          }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "orgs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "did": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "website": {
                    "type": "string"
                  }
                },
                "required": []
              }
            },
            "total": {
              "type": "integer"
            }
          },
          "required": []
        }
      }
    }
  }
}
