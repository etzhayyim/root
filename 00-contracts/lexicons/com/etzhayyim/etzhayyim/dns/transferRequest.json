{
  "lexicon": 1,
  "id": "com.etzhayyim.dns.transferRequest",
  "defs": {
    "main": {
      "type": "record",
      "description": "Domain transfer request record. Created by cfRegistrar actor on user-initiated transfer (ClassA 3 signers required). sqExporter follows this collection and starts browser automation on commit. transferId = rkey = project convoId.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["domain", "fromRegistrar", "toRegistrar", "requesterDid", "status", "requestedAt"],
        "properties": {
          "domain": { "type": "string", "description": "FQDN being transferred (e.g. example.com)" },
          "fromRegistrar": { "type": "string", "enum": ["squarespace"], "description": "Source registrar (only squarespace supported in v1)" },
          "toRegistrar": { "type": "string", "enum": ["cloudflare"] },
          "requesterDid": { "type": "string", "description": "DID of user who initiated the transfer" },
          "cfRegistrarDid": { "type": "string", "description": "did:web:scndu0rf.etzhayyim.com:actor:cfRegistrar" },
          "sqExporterDid": { "type": "string", "description": "did:web:sqddf3sp.etzhayyim.com:actor:sqExporter" },
          "projectConvoId": { "type": "string", "description": "Convo room scoping all transferStep records" },
          "status": { "type": "string", "enum": ["requested", "approved", "in-progress", "completed", "failed", "rolled-back"] },
          "approvals": {
            "type": "array",
            "description": "ClassA 3-signer approval records",
            "items": { "type": "string" },
            "maxLength": 8
          },
          "requestedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
