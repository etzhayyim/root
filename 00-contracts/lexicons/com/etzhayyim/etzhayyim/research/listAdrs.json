{
  "lexicon": 1,
  "id": "com.etzhayyim.research.listAdrs",
  "defs": {
    "main": {
      "type": "query",
      "description": "List repository ADRs from the parsed-frontmatter graph (public.vertex_research_adr). Returned rows include id, title, status, topic, last_verified, related_count, supersedes_count. SSoT = public.mv_research_adr_graph (ADR-2605110227 §3.1; ingested via 70-tools/scripts/research/extract-adr-frontmatter.py).",
      "parameters": {
        "type": "params",
        "properties": {
          "status": { "type": "string", "description": "Filter by status, e.g. 'active', 'deprecated', 'blocked-by-vultr-vke-gpu-unlock'." },
          "topic": { "type": "string", "description": "Filter by topic (substring match)." },
          "q": { "type": "string", "description": "Free-text substring match against title." },
          "authoritativeOnly": { "type": "boolean", "description": "If true, only return ADRs flagged authoritative:true." },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
          "offset": { "type": "integer", "minimum": 0, "default": 0 }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "adrs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "didPath": { "type": "string" },
                  "adrId": { "type": "string" },
                  "title": { "type": "string" },
                  "status": { "type": "string" },
                  "topic": { "type": "string" },
                  "authoritative": { "type": "boolean" },
                  "lastVerified": { "type": "string" },
                  "relatedCount": { "type": "integer" },
                  "supersedesCount": { "type": "integer" },
                  "supersededByCount": { "type": "integer" }
                },
                "required": ["didPath", "adrId", "title", "status"]
              }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          },
          "required": ["adrs", "total", "offset", "limit"]
        }
      }
    }
  }
}
