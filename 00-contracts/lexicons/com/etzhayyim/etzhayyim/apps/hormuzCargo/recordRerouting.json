{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.hormuzCargo.recordRerouting",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "代替ルート決定 (Cape of Good Hope等)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "reroutingId",
            "originalRoute",
            "newRoute",
            "reason",
            "decidedAt"
          ],
          "properties": {
            "reroutingId": {
              "type": "string"
            },
            "manifestVid": {
              "type": "string"
            },
            "originalRoute": {
              "type": "string",
              "enum": [
                "hormuz"
              ]
            },
            "newRoute": {
              "type": "string",
              "enum": [
                "cape-of-good-hope",
                "suez-only",
                "cancelled"
              ]
            },
            "reason": {
              "type": "string",
              "enum": [
                "military-risk",
                "insurance-exclusion",
                "sanctions",
                "owner-directive"
              ]
            },
            "additionalDays": {
              "type": "number"
            },
            "additionalCostUsd": {
              "type": "number"
            },
            "bunkerFuelExtraTonnes": {
              "type": "number"
            },
            "decidedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "impactTier": {
              "type": "string",
              "enum": [
                "minor",
                "moderate",
                "major"
              ]
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
