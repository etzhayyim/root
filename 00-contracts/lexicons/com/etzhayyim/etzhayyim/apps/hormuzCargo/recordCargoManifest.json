{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.hormuzCargo.recordCargoManifest",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "貨物マニフェスト (crude/LNG/refined)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "manifestId",
            "imo",
            "cargoCategory",
            "volumeTonnes",
            "declaredAt"
          ],
          "properties": {
            "manifestId": {
              "type": "string"
            },
            "imo": {
              "type": "string"
            },
            "voyageId": {
              "type": "string"
            },
            "cargoCategory": {
              "type": "string",
              "enum": [
                "crude",
                "lng",
                "refined-light",
                "refined-heavy",
                "chemical",
                "container",
                "bulk"
              ]
            },
            "hsCode": {
              "type": "string"
            },
            "originPortLocode": {
              "type": "string"
            },
            "destinationPortLocode": {
              "type": "string"
            },
            "volumeTonnes": {
              "type": "number"
            },
            "valueUsd": {
              "type": "number"
            },
            "consignorLei": {
              "type": "string"
            },
            "consigneeLei": {
              "type": "string"
            },
            "declaredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
