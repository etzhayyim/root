{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ameno.listModels",
  "defs": {
    "main": {
      "type": "query",
      "description": "List ONNX models available for browser-side WebGPU inference (Gemma 4 E2B / E4B / future BitNet variants). Returns model id, parameter count, context window, modalities, min VRAM, and quantization profile.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["models"],
          "properties": {
            "models": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "displayName", "params", "context", "minVramMb", "quantization"],
                "properties": {
                  "id": { "type": "string", "description": "Engine model id (matches inference.ts MODEL_ID enum)" },
                  "displayName": { "type": "string" },
                  "huggingfaceModel": { "type": "string", "description": "transformers.js model repo" },
                  "params": { "type": "string", "description": "e.g. 2.3B effective / 5.1B total" },
                  "context": { "type": "integer", "description": "context window tokens" },
                  "modalities": { "type": "array", "items": { "type": "string" } },
                  "minVramMb": { "type": "integer" },
                  "quantization": { "type": "string", "description": "q4f16 / q4 / bf16 / ternary" },
                  "available": { "type": "boolean" },
                  "kernel": { "type": "string", "description": "webgpu / wasm-ternary / mediapipe-gpu" }
                }
              }
            }
          }
        }
      }
    }
  }
}
