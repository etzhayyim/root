{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.chemicalsManagement.listChemical",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Rotterdam / Stockholm / Minamata / Basel / SAICM chemical listing (bridges pharma-supply + water-scarcity + critical-minerals)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "listingId",
            "chemicalName",
            "convention",
            "effectiveFrom"
          ],
          "properties": {
            "listingId": {
              "type": "string"
            },
            "chemicalName": {
              "type": "string"
            },
            "casNumber": {
              "type": "string"
            },
            "convention": {
              "type": "string",
              "enum": [
                "rotterdam",
                "stockholm",
                "minamata",
                "basel",
                "saicm",
                "reach_svhc",
                "epa_toxics_release"
              ]
            },
            "annex": {
              "type": "string"
            },
            "useCategory": {
              "type": "string",
              "enum": [
                "pesticide",
                "industrial",
                "pharma",
                "mining",
                "processing",
                "consumer",
                "cosmetic"
              ]
            },
            "listedYear": {
              "type": "integer"
            },
            "effectiveFrom": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}