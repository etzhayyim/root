{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.urbanAirMobility.logOperationalMetric",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "eVTOL operational metric (bridges power-grid-interconnect + aviation-safety)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "metricId",
            "vertiportVid",
            "periodMonth",
            "recordedAt"
          ],
          "properties": {
            "metricId": {
              "type": "string"
            },
            "vertiportVid": {
              "type": "string",
              "description": "bridges registerVertiport"
            },
            "periodMonth": {
              "type": "string"
            },
            "flightsCount": {
              "type": "integer"
            },
            "paxCount": {
              "type": "integer"
            },
            "avgTurnMinutes": {
              "type": "number"
            },
            "incidentRatePerMille": {
              "type": "number"
            },
            "avgDistanceKm": {
              "type": "number"
            },
            "recordedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "utilizationTier": {
              "type": "string",
              "enum": [
                "low",
                "moderate",
                "high"
              ]
            }
          }
        }
      }
    }
  }
}