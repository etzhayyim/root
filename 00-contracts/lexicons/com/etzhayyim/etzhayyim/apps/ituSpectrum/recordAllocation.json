{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ituSpectrum.recordAllocation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ITU WRC radio spectrum allocation (bridges telecom-infra + space-traffic + aviation-safety + uas-traffic-management)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "allocationId",
            "bandName",
            "freqStartMhz",
            "freqEndMhz",
            "serviceCategory",
            "decidedAt"
          ],
          "properties": {
            "allocationId": {
              "type": "string"
            },
            "bandName": {
              "type": "string",
              "description": "e.g. C-band / Ku / Ka / mmWave / 6G"
            },
            "freqStartMhz": {
              "type": "number"
            },
            "freqEndMhz": {
              "type": "number"
            },
            "serviceCategory": {
              "type": "string",
              "enum": [
                "mobile",
                "fixed",
                "broadcasting",
                "broadcasting_satellite",
                "radiolocation",
                "earth_exploration",
                "space_operation",
                "amateur",
                "radionavigation",
                "aeronautical_radionavigation",
                "maritime_radionavigation",
                "iss"
              ]
            },
            "wrcDecision": {
              "type": "string",
              "description": "WRC-23 / WRC-27 agenda item"
            },
            "regionItu": {
              "type": "string",
              "enum": [
                "1",
                "2",
                "3",
                "worldwide"
              ]
            },
            "decidedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}