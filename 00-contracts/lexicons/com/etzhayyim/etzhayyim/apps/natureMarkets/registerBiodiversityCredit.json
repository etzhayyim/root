{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.natureMarkets.registerBiodiversityCredit",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Biodiversity / nature credit issuance (IAPB / Verra Nature Framework / Plan Vivo — bridges biodiversity-gbf + forestry-mrv + blue-carbon-mrv + land-tenure)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "creditId",
            "methodology",
            "metricBasis",
            "unitsIssued",
            "issuedAt"
          ],
          "properties": {
            "creditId": {
              "type": "string"
            },
            "issuerLei": {
              "type": "string"
            },
            "methodology": {
              "type": "string",
              "enum": [
                "iapb_framework",
                "verra_nature_framework",
                "plan_vivo",
                "gef_2030",
                "mangrove_carbon_plus",
                "accu_biodiversity"
              ]
            },
            "metricBasis": {
              "type": "string",
              "enum": [
                "mean_species_abundance",
                "habitat_hectares",
                "condition",
                "extinction_risk",
                "cop15_indicator"
              ]
            },
            "unitsIssued": {
              "type": "integer"
            },
            "indigenousBenefitSharingPct": {
              "type": "number"
            },
            "issuedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}