{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.businessPerson.registerPerson",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a public business person profile (corporate officer, board member, executive). Sources: corporate registries + XBRL filings + Wikipedia + official disclosures. Path-based DID: did:web:business-person.etzhayyim.com:bp:{slug}.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["fullName", "jurisdiction"],
          "properties": {
            "fullName": { "type": "string" },
            "fullNameLocal": { "type": "string" },
            "jurisdiction": { "type": "string", "description": "ISO 3166-1 alpha-3" },
            "primaryRole": { "type": "string", "enum": ["ceo", "cfo", "coo", "cto", "chairman", "president", "vice-president", "director", "founder", "secretary", "treasurer"] },
            "primaryEntityDid": { "type": "string", "format": "did", "description": "legal-entity DID where person holds primary role" },
            "appointedAt": { "type": "string", "format": "datetime" },
            "naturalPersonDid": { "type": "string", "format": "did", "description": "linked natural-person.etzhayyim.com DID for PII Tier 3" },
            "linkedinUri": { "type": "string", "format": "uri" },
            "wikidataId": { "type": "string", "description": "Q-identifier" }
          }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "uri": { "type": "string", "format": "at-uri" } } } }
    }
  }
}
