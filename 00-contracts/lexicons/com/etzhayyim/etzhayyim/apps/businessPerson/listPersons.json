{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.businessPerson.listPersons",
  "defs": {
    "main": {
      "type": "query",
      "description": "List business persons with offset/limit pagination, optional filters.",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "properties": {
          "jurisdiction": { "type": "string" },
          "primaryRole": { "type": "string" },
          "primaryEntityDid": { "type": "string", "format": "did" },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["persons", "total", "offset", "limit"],
          "properties": {
            "persons": { "type": "array", "items": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "fullName": { "type": "string" }, "primaryRole": { "type": "string" }, "primaryEntityDid": { "type": "string", "format": "did" } } } },
            "total": { "type": "integer" }, "offset": { "type": "integer" }, "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
