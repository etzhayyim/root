{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.crawlFlightPrices",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Queue a flight-fare crawler job (Skyscanner-like metasearch). Returns source URL so UI can open/search directly.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["originIata", "destinationIata", "outboundDate"],
          "properties": {
            "provider": { "type": "string", "description": "e.g. skyscanner, kiwi, google-flights" },
            "originIata": { "type": "string" },
            "destinationIata": { "type": "string" },
            "outboundDate": { "type": "string", "description": "YYYY-MM-DD" },
            "returnDate": { "type": "string", "description": "YYYY-MM-DD" },
            "adults": { "type": "integer" },
            "children": { "type": "integer" },
            "cabinClass": { "type": "string", "enum": ["economy", "premium-economy", "business", "first"] },
            "currency": { "type": "string" },
            "locale": { "type": "string" },
            "market": { "type": "string" },
            "sourceUrl": { "type": "string", "format": "uri", "description": "Override provider URL when using custom crawler endpoint." }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["crawlId", "status", "sourceUrl"],
          "properties": {
            "crawlId": { "type": "string" },
            "status": { "type": "string" },
            "sourceUrl": { "type": "string", "format": "uri" }
          }
        }
      }
    }
  }
}
