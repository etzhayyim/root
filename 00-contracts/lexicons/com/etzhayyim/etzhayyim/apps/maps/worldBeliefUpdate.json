{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.worldBeliefUpdate",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Bayesian latent world-model belief update for one maps entity. Reads the latest prior WorldBelief when prior is omitted, applies a single posterior update, and mirrors the result into TwinState.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "entityId": { "type": "string" },
            "entityType": { "type": "string" },
            "hypothesis": { "type": "string" },
            "prior": { "type": "number", "minimum": 0, "maximum": 1 },
            "likelihood": { "type": "number", "minimum": 0, "maximum": 1 },
            "evidenceConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "evidenceJson": { "type": "string" },
            "stateVectorJson": { "type": "string" },
            "sourceEventId": { "type": "string" },
            "modelVersion": { "type": "string" }
          },
          "required": ["entityId", "hypothesis"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "error": { "type": "string" },
            "nodeId": { "type": "string" },
            "entityId": { "type": "string" },
            "hypothesis": { "type": "string" },
            "prior": { "type": "number" },
            "likelihood": { "type": "number" },
            "posterior": { "type": "number" },
            "uncertainty": { "type": "number" },
            "status": { "type": "string" }
          },
          "required": []
        }
      }
    }
  }
}
