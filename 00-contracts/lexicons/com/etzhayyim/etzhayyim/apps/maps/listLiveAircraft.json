{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.listLiveAircraft",
  "defs": {
    "main": {
      "type": "query",
      "description": "List currently airborne aircraft (Flightradar24-equivalent). Sourced from OpenSky /states/all polled every 10s.",
      "parameters": {
        "type": "params",
        "properties": {
          "minLat": { "type": "number", "description": "Bounding box south latitude." },
          "maxLat": { "type": "number" },
          "minLon": { "type": "number" },
          "maxLon": { "type": "number" },
          "maxAgeSec": { "type": "integer", "default": 90, "minimum": 30, "maximum": 600 },
          "limit": { "type": "integer", "default": 200, "minimum": 1, "maximum": 2000 },
          "country": { "type": "string", "description": "Filter by ISO origin country." }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["aircraft", "count", "asOfMs"],
          "properties": {
            "aircraft": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "icao24": { "type": "string" },
                  "callsign": { "type": "string" },
                  "lat": { "type": "number" },
                  "lon": { "type": "number" },
                  "baroAltitudeM": { "type": "number" },
                  "velocityMs": { "type": "number" },
                  "headingDeg": { "type": "number" },
                  "verticalRateMs": { "type": "number" },
                  "originCountry": { "type": "string" },
                  "source": { "type": "string" },
                  "tsMs": { "type": "integer" }
                }
              }
            },
            "count": { "type": "integer" },
            "asOfMs": { "type": "integer" }
          }
        }
      }
    }
  }
}
