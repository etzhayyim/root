{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.tileGeoJson",
  "defs": {
    "main": {
      "type": "query",
      "description": "RisingWave-native vector layer source. Returns per-label GeoJSON FeatureCollections for a viewport bbox, directly from vertex_spatial. Replaces external MVT tile dependency.",
      "parameters": {
        "type": "params",
        "properties": {
          "west": { "type": "number", "description": "Bounding box west lng (WGS84)." },
          "south": { "type": "number", "description": "Bounding box south lat (WGS84)." },
          "east": { "type": "number", "description": "Bounding box east lng (WGS84)." },
          "north": { "type": "number", "description": "Bounding box north lat (WGS84)." },
          "labels": {
            "type": "array",
            "description": "Graph node labels to fetch (e.g. Place, Road, Building, AdminArea).",
            "items": { "type": "string" },
            "maxLength": 32
          },
          "zoom": { "type": "integer", "description": "Current map zoom (for server-side decimation)." },
          "limit": { "type": "integer", "description": "Max features per label (default 500, max 5000)." }
        },
        "required": ["west", "south", "east", "north"]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["layers"],
          "properties": {
            "layers": {
              "type": "unknown",
              "description": "{ [label]: GeoJSON FeatureCollection } — one entry per requested label with matching features."
            },
            "bbox": {
              "type": "array",
              "items": { "type": "number" },
              "description": "Echoed bbox [w,s,e,n]."
            },
            "total": { "type": "integer" }
          }
        }
      }
    }
  }
}
