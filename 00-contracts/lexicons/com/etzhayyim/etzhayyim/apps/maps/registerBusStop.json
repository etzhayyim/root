{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.registerBusStop",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register or update a bus stop for route and operation management.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "stopId": { "type": "string", "description": "Existing stop id for update. Omit for create." },
            "stopCode": { "type": "string", "description": "Operator/local stop code." },
            "name": { "type": "string" },
            "operator": { "type": "string" },
            "lat": { "type": "number" },
            "lon": { "type": "number" },
            "city": { "type": "string" },
            "ward": { "type": "string" },
            "prefecture": { "type": "string" },
            "status": {
              "type": "string",
              "enum": ["active", "temporarily-closed", "removed"]
            },
            "orgId": { "type": "string" },
            "userId": { "type": "string" }
          },
          "required": [
            "name",
            "operator"
          ]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "stopId": { "type": "string" },
            "status": { "type": "string", "enum": ["created", "updated"] }
          },
          "required": ["stopId", "status"]
        }
      }
    }
  }
}
