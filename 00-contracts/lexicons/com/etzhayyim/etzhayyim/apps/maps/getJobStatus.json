{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.getJobStatus",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get maps collection job status, including current stage and street-chunk coverage metrics when available.",
      "parameters": {
        "type": "params",
        "properties": {
          "jobId": {
            "type": "string"
          }
        },
        "required": [
          "jobId"
        ]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            },
            "jobId": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "stage": {
              "type": "string"
            },
            "progressPct": {
              "type": "number"
            },
            "frameCount": {
              "type": "integer"
            },
            "coverageRatio": {
              "type": "number"
            },
            "headingSpanDeg": {
              "type": "number"
            },
            "viewClusterCount": {
              "type": "integer"
            },
            "occlusionRisk": {
              "type": "number"
            },
            "dynamicObjectRisk": {
              "type": "number"
            },
            "recommendedChunkClass": {
              "type": "string"
            },
            "unavailable": {
              "type": "string"
            }
          },
          "required": []
        }
      }
    }
  }
}
