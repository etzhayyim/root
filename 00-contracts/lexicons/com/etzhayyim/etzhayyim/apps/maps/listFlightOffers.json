{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.listFlightOffers",
  "defs": {
    "main": {
      "type": "query",
      "description": "List flight fare offers sorted by cheapest first. Includes booking/deeplink URLs.",
      "parameters": {
        "type": "params",
        "properties": {
          "originIata": { "type": "string" },
          "destinationIata": { "type": "string" },
          "outboundDate": { "type": "string" },
          "returnDate": { "type": "string" },
          "provider": { "type": "string" },
          "currency": { "type": "string" },
          "maxTotalPrice": { "type": "number" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 },
          "offset": { "type": "integer", "minimum": 0, "default": 0 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["offers", "total", "offset", "limit"],
          "properties": {
            "offers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "offerId": { "type": "string" },
                  "provider": { "type": "string" },
                  "airline": { "type": "string" },
                  "flightNumber": { "type": "string" },
                  "originIata": { "type": "string" },
                  "destinationIata": { "type": "string" },
                  "outboundDate": { "type": "string" },
                  "returnDate": { "type": "string" },
                  "basePrice": { "type": "number" },
                  "taxes": { "type": "number" },
                  "totalPrice": { "type": "number" },
                  "currency": { "type": "string" },
                  "bookingUrl": { "type": "string", "format": "uri" },
                  "deeplinkUrl": { "type": "string", "format": "uri" },
                  "observedAt": { "type": "string", "format": "datetime" }
                }
              }
            },
            "cheapest": { "type": "object" },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
