{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.trainGsplatFromMapillary",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Enqueue a Mapillary→COLMAP→3DGS training job for the given lat/lng. Worker fetches Mapillary image sequences in radius, runs COLMAP SfM on a Vultr/RunPod GPU pod, trains a Gaussian splat (`gsplat`/nerfstudio), uploads the PLY to B2, and inserts a `vertex_maps_gsplat_asset` row keyed by the H3 cell. Returns the job id synchronously; training takes 10-20 min per scene. ADR-2605092800.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["lat", "lng"],
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "radiusM": { "type": "integer", "minimum": 5, "maximum": 200, "default": 50 },
            "tileH3": { "type": "string" },
            "h3Resolution": { "type": "integer", "minimum": 8, "maximum": 14, "default": 12 },
            "mapillaryImageIds": { "type": "array", "items": { "type": "string" }, "maxLength": 400 },
            "maxImages": { "type": "integer", "minimum": 8, "maximum": 400, "default": 80 },
            "priority": { "type": "string", "knownValues": ["low", "normal", "high"], "default": "normal" },
            "force": {
              "type": "boolean",
              "description": "Bypass the per-tile lifetime spend cap (`MAPS_GSPLAT_LIFETIME_CAP_USD`, default $10). Default false.",
              "default": false
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["trainJobId", "queuedAt", "tileH3"],
          "properties": {
            "trainJobId": { "type": "string" },
            "tileH3": { "type": "string" },
            "queuedAt": { "type": "string", "format": "datetime" },
            "estimatedDurationSec": { "type": "integer" }
          }
        }
      }
    }
  }
}
