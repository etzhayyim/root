{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.expandFrontier",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Declaratively seed vertex_maps_coverage_target rows. Existing vertex_ids are skipped (idempotent). Replaces the migration/psql path for ad-hoc frontier expansion.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "targets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sourceDid": { "type": "string" },
                  "label": { "type": "string" },
                  "worldTotal": { "type": "integer", "minimum": 1 },
                  "priorityWeight": { "type": "number", "minimum": 0, "maximum": 1 },
                  "ttlHours": { "type": "number", "minimum": 0.1 }
                },
                "required": ["sourceDid", "label", "worldTotal"]
              }
            }
          },
          "required": ["targets"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "requested": { "type": "integer" },
            "inserted": { "type": "integer" },
            "skippedExisting": { "type": "integer" },
            "added": { "type": "array", "items": { "type": "string" } },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
