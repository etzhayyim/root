{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.listGsplatJobs",
  "defs": {
    "main": {
      "type": "query",
      "description": "List the latest state of gsplat train / bake jobs, optionally filtered by tile (H3), kind, or status. Standard `{offset,limit,total}` envelope.",
      "parameters": {
        "type": "params",
        "properties": {
          "tileH3":  { "type": "string" },
          "jobKind": { "type": "string", "knownValues": ["train", "bake"] },
          "status":  { "type": "string", "knownValues": ["queued", "running", "completed", "failed"] },
          "offset":  { "type": "integer", "minimum": 0, "default": 0 },
          "limit":   { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["jobs", "total", "offset", "limit"],
          "properties": {
            "jobs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["jobId", "jobKind", "status"],
                "properties": {
                  "jobId":         { "type": "string" },
                  "jobKind":       { "type": "string" },
                  "tileH3":        { "type": "string" },
                  "status":        { "type": "string" },
                  "phase":         { "type": "string" },
                  "message":       { "type": "string" },
                  "splatCount":    { "type": "integer" },
                  "triangleCount": { "type": "integer" },
                  "byteSize":      { "type": "integer" },
                  "runtimeMs":     { "type": "integer" },
                  "ts":            { "type": "string", "format": "datetime" }
                }
              }
            },
            "total":  { "type": "integer" },
            "offset": { "type": "integer" },
            "limit":  { "type": "integer" }
          }
        }
      }
    }
  }
}
