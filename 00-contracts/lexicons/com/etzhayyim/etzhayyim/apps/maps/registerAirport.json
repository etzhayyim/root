{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.registerAirport",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register or upsert an airport node (ICAO/IATA, geo, operator DID). Public infrastructure metadata only.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "airportDid": {
              "type": "string",
              "format": "did",
              "description": "Canonical airport DID when already assigned."
            },
            "name": {
              "type": "string"
            },
            "icao": {
              "type": "string"
            },
            "iata": {
              "type": "string"
            },
            "country": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "lat": {
              "type": "number"
            },
            "lng": {
              "type": "number"
            },
            "timezone": {
              "type": "string"
            },
            "operatorDid": {
              "type": "string",
              "format": "did"
            },
            "sourceUrl": {
              "type": "string",
              "format": "uri"
            },
            "sourceLicense": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "nodeId": {
              "type": "string"
            },
            "airportDid": {
              "type": "string",
              "format": "did"
            },
            "status": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
