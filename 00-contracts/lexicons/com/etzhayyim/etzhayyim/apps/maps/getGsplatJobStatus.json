{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.getGsplatJobStatus",
  "defs": {
    "main": {
      "type": "query",
      "description": "Latest state of a single gsplat train / bake job by `jobId`. Reads `mv_maps_gsplat_job_latest` for sub-ms response.",
      "parameters": {
        "type": "params",
        "properties": {
          "jobId": { "type": "string" }
        },
        "required": ["jobId"]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["jobId", "jobKind", "status"],
          "properties": {
            "jobId":         { "type": "string" },
            "jobKind":       { "type": "string", "knownValues": ["train", "bake"] },
            "tileH3":        { "type": "string" },
            "status":        { "type": "string", "knownValues": ["queued", "running", "completed", "failed"] },
            "phase":         { "type": "string" },
            "message":       { "type": "string" },
            "splatCount":    { "type": "integer" },
            "triangleCount": { "type": "integer" },
            "byteSize":      { "type": "integer" },
            "runtimeMs":     { "type": "integer" },
            "ts":            { "type": "string", "format": "datetime" }
          }
        }
      }
    }
  }
}
