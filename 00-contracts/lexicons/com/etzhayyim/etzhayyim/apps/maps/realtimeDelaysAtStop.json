{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.realtimeDelaysAtStop",
  "defs": {
    "main": {
      "type": "query",
      "description": "Next departures at a Station / BusStop with GTFS-RT delays applied. LEFT JOINs vertex_maps_stop_time × vertex_maps_trip × mv_maps_recent_trip_update — when no RT row exists for a (trip, stop), returns the static schedule unchanged. Active alerts affecting the stop / route / trip are returned in a parallel field. Read path is unaffected when the RT pipeline is offline (gated; Phase 3).",
      "parameters": {
        "type": "params",
        "properties": {
          "stopId":   { "type": "string", "description": "Same stop_id form as nextDeparturesAtStop: gtfsjp-{feed_id}-{gtfs_stop_id}." },
          "fromTime": { "type": "string" },
          "limit":    { "type": "integer", "default": 30, "minimum": 1, "maximum": 200 },
          "offset":   { "type": "integer", "default": 0,  "minimum": 0 }
        },
        "required": ["stopId"]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "stopId":   { "type": "string" },
            "fromTime": { "type": "string" },
            "departures": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "feedId":              { "type": "string" },
                  "tripId":              { "type": "string" },
                  "stopSequence":        { "type": "integer" },
                  "scheduledDeparture":  { "type": "string" },
                  "scheduledArrival":    { "type": "string" },
                  "headsign":            { "type": "string" },
                  "routeId":             { "type": "string" },
                  "routeShortName":      { "type": "string" },
                  "routeLabel":          { "type": "string" },
                  "agency":              { "type": "string" },
                  "scheduleRelationship": { "type": "string", "description": "SCHEDULED | SKIPPED | NO_DATA | null" },
                  "departureDelaySec":   { "type": "integer", "description": "positive = late, negative = early; null when no RT row" },
                  "arrivalDelaySec":     { "type": "integer" },
                  "predictedDeparture":  { "type": "string" },
                  "predictedArrival":    { "type": "string" },
                  "rtAt":                { "type": "string", "description": "RT row timestamp; null when no RT" }
                }
              }
            },
            "alerts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "alertId":     { "type": "string" },
                  "cause":       { "type": "string" },
                  "effect":      { "type": "string" },
                  "severity":    { "type": "string" },
                  "headerText":  { "type": "string" },
                  "description": { "type": "string" },
                  "url":         { "type": "string" },
                  "activeFrom":  { "type": "string" },
                  "activeUntil": { "type": "string" }
                }
              }
            },
            "rtAvailable": { "type": "boolean", "description": "false when the RT pipeline appears offline (no recent rows for the feed)." },
            "total":       { "type": "integer" },
            "offset":      { "type": "integer" },
            "limit":       { "type": "integer" }
          },
          "required": ["stopId", "departures", "alerts", "rtAvailable", "offset", "limit"]
        }
      }
    }
  }
}
