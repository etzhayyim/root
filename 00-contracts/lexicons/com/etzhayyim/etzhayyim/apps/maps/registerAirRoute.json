{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.registerAirRoute",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register or upsert an air route between airports. Supports operating carrier and distance metadata.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "routeDid": {
              "type": "string",
              "format": "did"
            },
            "name": {
              "type": "string"
            },
            "flightNumber": {
              "type": "string"
            },
            "originAirportDid": {
              "type": "string",
              "format": "did"
            },
            "destinationAirportDid": {
              "type": "string",
              "format": "did"
            },
            "operatorDid": {
              "type": "string",
              "format": "did"
            },
            "marketingCarrierDid": {
              "type": "string",
              "format": "did"
            },
            "distanceKm": {
              "type": "number"
            },
            "scheduledDurationMin": {
              "type": "integer"
            },
            "serviceType": {
              "type": "string",
              "enum": ["passenger", "cargo", "mixed", "ferry", "positioning"]
            },
            "sourceUrl": {
              "type": "string",
              "format": "uri"
            },
            "sourceLicense": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "nodeId": {
              "type": "string"
            },
            "routeDid": {
              "type": "string",
              "format": "did"
            },
            "status": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
