{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.registerBusRoute",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register or update a bus route for operation management. Supports route metadata, service window, and live operation status snapshot.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "routeId": { "type": "string", "description": "Existing route id for update. Omit for create." },
            "routeCode": { "type": "string", "description": "Operator route code (e.g. 都01)." },
            "name": { "type": "string", "description": "Human readable route name." },
            "operator": { "type": "string", "description": "Bus operator name." },
            "originStopId": { "type": "string" },
            "originStopName": { "type": "string" },
            "destinationStopId": { "type": "string" },
            "destinationStopName": { "type": "string" },
            "serviceStartTime": { "type": "string", "description": "HH:MM first bus" },
            "serviceEndTime": { "type": "string", "description": "HH:MM last bus" },
            "headwayMinutes": { "type": "integer", "minimum": 1 },
            "operationStatus": {
              "type": "string",
              "enum": ["normal", "delayed", "suspended", "partial-suspension", "detour"]
            },
            "delayMinutes": { "type": "integer", "minimum": 0 },
            "alertMessage": { "type": "string" },
            "orgId": { "type": "string" },
            "userId": { "type": "string" }
          },
          "required": [
            "name",
            "operator"
          ]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "routeId": { "type": "string" },
            "status": { "type": "string", "enum": ["created", "updated"] },
            "operationStatus": { "type": "string" },
            "delayMinutes": { "type": "integer" }
          },
          "required": ["routeId", "status"]
        }
      }
    }
  }
}
