{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.seedBuildings",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Seed building footprints + heights from OSM Overpass for a bbox/center.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["lat", "lng"],
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "radiusM": { "type": "integer", "minimum": 100, "maximum": 5000 },
            "maxBuildings": { "type": "integer", "minimum": 1, "maximum": 2000 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["written"],
          "properties": { "written": { "type": "integer" } }
        }
      }
    }
  }
}
