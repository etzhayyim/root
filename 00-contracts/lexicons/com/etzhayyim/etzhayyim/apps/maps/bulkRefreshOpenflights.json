{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.bulkRefreshOpenflights",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Trigger the maps-bulk-ingest-openflights K8s pod to (re)ingest OpenFlights airports.dat / routes.dat / airlines.dat into vertex_spatial as Airport / AirRoute. Usually fired by the timer-start BPMN of the same name (R/P7D). ODbL.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "airportsUrl": { "type": "string" },
            "routesUrl":   { "type": "string" },
            "airlinesUrl": { "type": "string" }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "accepted":  { "type": "boolean" },
            "startedAt": { "type": "string" },
            "podStatus": { "type": "integer" }
          },
          "required": ["accepted"]
        }
      }
    }
  }
}
