{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.nextDeparturesAtStop",
  "defs": {
    "main": {
      "type": "query",
      "description": "Next scheduled departures at a Station / BusStop. Reads vertex_maps_stop_time JOIN vertex_maps_trip JOIN vertex_spatial(label IN ('Railway','BusRoute')); filters by stop_id, departure_time >= fromTime, optional service_id day-pattern. Append-only schedule view (Phase 2 of bus/train ingest). GTFS-RT delays are NOT applied here — see com.etzhayyim.apps.maps.realtimeDelaysAtStop (Phase 3, gated on ODPT key).",
      "parameters": {
        "type": "params",
        "properties": {
          "stopId": {
            "type": "string",
            "description": "vertex_maps_stop_time.stop_id (form: gtfsjp-{feed_id}-{gtfs_stop_id}). Find with com.etzhayyim.apps.maps.listStations or listBusStops first."
          },
          "fromTime": {
            "type": "string",
            "description": "HH:MM:SS lower bound (defaults to current UTC HH:MM:SS in the stop's timezone — server-resolved). GTFS allows >24:00:00 for past-midnight trips."
          },
          "limit":   { "type": "integer", "default": 30, "minimum": 1, "maximum": 200 },
          "offset":  { "type": "integer", "default": 0,  "minimum": 0 }
        },
        "required": ["stopId"]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "stopId":       { "type": "string" },
            "fromTime":     { "type": "string" },
            "departures":   {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "feedId":         { "type": "string" },
                  "tripId":         { "type": "string" },
                  "stopSequence":   { "type": "integer" },
                  "departureTime":  { "type": "string" },
                  "arrivalTime":    { "type": "string" },
                  "headsign":       { "type": "string" },
                  "routeId":        { "type": "string" },
                  "routeShortName": { "type": "string" },
                  "routeLongName":  { "type": "string" },
                  "routeLabel":     { "type": "string", "description": "Railway | BusRoute" },
                  "agency":         { "type": "string" },
                  "directionId":    { "type": "integer" }
                }
              }
            },
            "total":  { "type": "integer" },
            "offset": { "type": "integer" },
            "limit":  { "type": "integer" }
          },
          "required": ["stopId", "departures", "offset", "limit"]
        }
      }
    }
  }
}
