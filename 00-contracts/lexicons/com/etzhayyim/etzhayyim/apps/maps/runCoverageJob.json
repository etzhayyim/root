{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.runCoverageJob",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Execute a pending MapsJob — fetch from the external source (Overpass / GLEIF / Wikidata / STAC), parse, write to vertex_spatial, advance the job. Source selection is dispatched via the SQL UDF maps_source_dispatch_kind(source_did, label). Called by orgs/etzhayyim/com-etzhayyim-maps/wire/bpmn/maps/runPendingCoverageJobs.bpmn multi-instance loop every 3 minutes.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "jobId": { "type": "string" },
            "maxRecords": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 }
          },
          "required": ["jobId"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "jobId": { "type": "string" },
            "status": { "type": "string", "description": "running | done | error | skipped" },
            "dispatchKind": { "type": "string", "description": "overpass | gleif | wikidata | stac | unsupported" },
            "recordsWritten": { "type": "integer" },
            "sourceDid": { "type": "string" },
            "label": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
