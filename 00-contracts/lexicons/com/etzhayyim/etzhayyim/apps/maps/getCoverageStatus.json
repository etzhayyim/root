{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps.getCoverageStatus",
  "defs": {
    "main": {
      "type": "query",
      "description": "Live snapshot of the maps coverage frontier — leaderboard of (source_did, label, collected_count, gap_score) plus recent-job throughput stats. Intended for UI / agent polling. Read-only; no writes.",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
          "minCollected": { "type": "integer", "minimum": 0, "description": "Filter: only frontier rows with collected_count >= N" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "frontier": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sourceDid": { "type": "string" },
                  "label": { "type": "string" },
                  "collectedCount": { "type": "integer" },
                  "worldTotal": { "type": "integer" },
                  "coveragePct": { "type": "number" },
                  "gapScore": { "type": "number" },
                  "hoursSinceLastFetch": { "type": "number" }
                }
              }
            },
            "totals": {
              "type": "object",
              "properties": {
                "activeTargets": { "type": "integer" },
                "totalTargets": { "type": "integer" },
                "totalCollected": { "type": "integer" },
                "recentJobs1h": { "type": "integer" },
                "recentJobsDone1h": { "type": "integer" }
              }
            },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
