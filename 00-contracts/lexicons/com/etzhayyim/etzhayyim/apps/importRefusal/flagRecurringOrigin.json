{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.importRefusal.flagRecurringOrigin",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Recurring origin-country refusal pattern (bridges residueMrl.flagMrlBreach + trade-sanitary + wto-dispute)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "patternId",
            "refusalVid",
            "concernKind",
            "reportedAt"
          ],
          "properties": {
            "patternId": {
              "type": "string"
            },
            "refusalVid": {
              "type": "string",
              "description": "bridges recordRefusal"
            },
            "refusalsLast12mo": {
              "type": "integer"
            },
            "concernKind": {
              "type": "string",
              "enum": [
                "systemic_origin",
                "producer_cluster",
                "single_violator",
                "seasonal",
                "climate_related",
                "emerging_compound",
                "sanitary_phytosanitary"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}