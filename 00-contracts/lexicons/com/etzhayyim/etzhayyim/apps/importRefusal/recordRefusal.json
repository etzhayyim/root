{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.importRefusal.recordRefusal",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "FDA import refusal / EU RASFF rejection / CBP hold (bridges residueMrl.flagMrlBreach + rasff-food-safety + fda-adufa)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "refusalId",
            "borderAgency",
            "originCountryIso3",
            "destinationCountryIso3",
            "productCategory",
            "violationKind",
            "refusedAt"
          ],
          "properties": {
            "refusalId": {
              "type": "string"
            },
            "borderAgency": {
              "type": "string",
              "enum": [
                "fda",
                "usda_fsis",
                "cbp",
                "eu_rasff",
                "cfia_canada",
                "jma_japan",
                "mhlw_japan",
                "aqsiq_china",
                "fssai_india"
              ]
            },
            "originCountryIso3": {
              "type": "string"
            },
            "destinationCountryIso3": {
              "type": "string"
            },
            "productCategory": {
              "type": "string",
              "enum": [
                "seafood",
                "fresh_produce",
                "meat_poultry",
                "dairy",
                "dietary_supplement",
                "spice",
                "processed",
                "beverage",
                "infant_formula",
                "medical_device"
              ]
            },
            "violationKind": {
              "type": "string",
              "enum": [
                "pesticide_residue",
                "veterinary_residue",
                "microbial",
                "heavy_metal",
                "aflatoxin",
                "adulteration",
                "unapproved_additive",
                "labeling",
                "allergen",
                "radiological"
              ]
            },
            "mrlBreachVid": {
              "type": "string",
              "description": "bridges residueMrl.flagMrlBreach"
            },
            "shipmentValueUsd": {
              "type": "number"
            },
            "refusedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            }
          }
        }
      }
    }
  }
}