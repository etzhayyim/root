{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.comfyui.editImage",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Start the LangServer ComfyUI OpenAI-compatible image edit pipeline.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "image": { "type": "string" },
            "prompt": { "type": "string" },
            "negative_prompt": { "type": "string" },
            "strength": { "type": "number" },
            "steps": { "type": "integer" },
            "cfg_scale": { "type": "number" },
            "seed": { "type": "integer" },
            "sampler": { "type": "string" },
            "scheduler": { "type": "string" },
            "model": { "type": "string" }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "accepted": { "type": "boolean" },
            "movedToPOD-side LangServer": { "type": "boolean" },
            "processId": { "type": "string" },
            "taskTypes": { "type": "array", "items": { "type": "string" } },
            "variables": { "type": "object" },
            "status": { "type": "string" }
          },
          "required": []
        }
      }
    }
  }
}
