{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.climateLitigation.fileCase",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Sabin Center climate case filing (bridges esg-risk-rating + sovereign-debt + commodity-trade)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "caseId",
            "jurisdictionIso3",
            "court",
            "claimantType",
            "defendantType",
            "claimBasis",
            "filedAt"
          ],
          "properties": {
            "caseId": {
              "type": "string"
            },
            "jurisdictionIso3": {
              "type": "string"
            },
            "court": {
              "type": "string"
            },
            "claimantType": {
              "type": "string",
              "enum": [
                "individual",
                "ngo",
                "indigenous",
                "youth",
                "shareholder",
                "investor",
                "municipality",
                "subnational",
                "sovereign"
              ]
            },
            "defendantType": {
              "type": "string",
              "enum": [
                "sovereign",
                "corporation",
                "subnational",
                "investor",
                "public_authority"
              ]
            },
            "defendantLei": {
              "type": "string"
            },
            "claimBasis": {
              "type": "string",
              "enum": [
                "human_rights",
                "constitutional",
                "public_trust",
                "tort",
                "consumer_protection",
                "securities_disclosure",
                "administrative",
                "tax_subsidy"
              ]
            },
            "reliefSought": {
              "type": "string",
              "enum": [
                "mitigation_order",
                "adaptation_order",
                "damages",
                "disclosure",
                "injunction",
                "permit_revocation",
                "price_subsidy"
              ]
            },
            "filedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "impactTier": {
              "type": "string",
              "enum": [
                "commercial",
                "strategic",
                "precedent_setting"
              ]
            }
          }
        }
      }
    }
  }
}