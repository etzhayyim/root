{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.climateLitigation.recordRuling",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Litigation ruling outcome + appeal path",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "rulingId",
            "caseVid",
            "outcome",
            "ruledAt"
          ],
          "properties": {
            "rulingId": {
              "type": "string"
            },
            "caseVid": {
              "type": "string",
              "description": "bridges fileCase"
            },
            "outcome": {
              "type": "string",
              "enum": [
                "claimant_win",
                "claimant_partial",
                "defendant_win",
                "settled",
                "withdrawn",
                "dismissed"
              ]
            },
            "damagesAwardedUsd": {
              "type": "number"
            },
            "precedentCited": {
              "type": "string"
            },
            "appealFiled": {
              "type": "boolean"
            },
            "ruledAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}