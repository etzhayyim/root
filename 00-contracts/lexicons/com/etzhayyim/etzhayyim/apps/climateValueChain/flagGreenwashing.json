{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.climateValueChain.flagGreenwashing",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Flag potential greenwashing (offset quality mismatch)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "linkVid",
            "claimedNeutrality",
            "flaggedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "linkVid": {
              "type": "string",
              "description": "bridges linkScope3Emission"
            },
            "esgRatingVid": {
              "type": "string",
              "description": "bridges open-esg-risk-rating"
            },
            "creditQualityTier": {
              "type": "string",
              "enum": [
                "tier_1",
                "tier_2",
                "tier_3"
              ]
            },
            "claimedNeutrality": {
              "type": "boolean"
            },
            "flaggedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "riskTier": {
              "type": "string",
              "enum": [
                "low",
                "moderate",
                "high"
              ]
            }
          }
        }
      }
    }
  }
}