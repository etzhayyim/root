{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.rareEarthCoverage.getSegment",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a rare earth supply chain segment by DID.",
      "x-bootstrap": true,
      "parameters": { "type": "params", "required": ["did"], "properties": { "did": { "type": "string", "format": "did" } } },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "segment": { "type": "string" }, "country": { "type": "string" }, "operatorDid": { "type": "string", "format": "did" }, "elements": { "type": "array", "items": { "type": "string" } }, "annualCapacityTonnes": { "type": "number" }, "annualOutputTonnes": { "type": "number" }, "policyConstraints": { "type": "array", "items": { "type": "string" } } } } }
    }
  }
}
