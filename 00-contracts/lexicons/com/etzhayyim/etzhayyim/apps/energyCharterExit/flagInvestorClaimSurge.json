{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.energyCharterExit.flagInvestorClaimSurge",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Investor claim surge / sunset 20-year tail / fossil-asset litigation (bridges bilateralInvestmentTreaty.flagSurvivalClause + mineralRoyalty.flagInvestorClaim + climate-value-chain)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "noticeVid",
            "issueKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "noticeVid": {
              "type": "string",
              "description": "bridges recordExitNotice"
            },
            "issueKind": {
              "type": "string",
              "enum": [
                "fossil_asset_loss",
                "carbon_levy_dispute",
                "grandfathering",
                "unilateral_treaty_termination_litigation",
                "arbitration_seat_change",
                "escape_via_holding",
                "investor_circumvention",
                "national_court_only",
                "umbrella_clause"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}