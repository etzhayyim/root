{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.energyCharterExit.recordExitNotice",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Energy Charter Treaty (ECT) modernization / exit notice (bridges bilateralInvestmentTreaty.flagSurvivalClause + climate-litigation + just-transition)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "noticeId",
            "memberStateIso3",
            "noticeKind",
            "noticedAt"
          ],
          "properties": {
            "noticeId": {
              "type": "string"
            },
            "memberStateIso3": {
              "type": "string"
            },
            "noticeKind": {
              "type": "string",
              "enum": [
                "unilateral_withdrawal",
                "coordinated_eu",
                "stay_in_modernized",
                "carve_out_negotiated",
                "carbon_carve_out",
                "article_47_exit",
                "sunset_clause_concern",
                "investor_state_clause_strip",
                "amf_french_modify",
                "modernised_join",
                "amendment_only"
              ]
            },
            "survivalVid": {
              "type": "string",
              "description": "bridges bilateralInvestmentTreaty.flagSurvivalClause"
            },
            "noticedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}