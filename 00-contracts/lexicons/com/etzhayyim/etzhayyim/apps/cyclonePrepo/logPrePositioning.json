{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.cyclonePrepo.logPrePositioning",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Pre-positioning of relief supplies (OCHA / IFRC / USAID BHA)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "logId",
            "forecastVid",
            "supplyCategory",
            "unitsDeployed",
            "recordedAt"
          ],
          "properties": {
            "logId": {
              "type": "string"
            },
            "forecastVid": {
              "type": "string",
              "description": "bridges issueForecast"
            },
            "operatorLei": {
              "type": "string"
            },
            "supplyCategory": {
              "type": "string",
              "enum": [
                "wash",
                "shelter",
                "food",
                "medical",
                "power",
                "telecom",
                "fuel"
              ]
            },
            "unitsDeployed": {
              "type": "integer"
            },
            "stagingPortVid": {
              "type": "string",
              "description": "bridges open-ports"
            },
            "recordedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}