{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.fiataFreight.flagLiabilityClaim",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Forwarder liability claim (CMR/CIM/Hague-Visby/Montreal/COGSA — bridges insurance-guarantee + cat-bond-ils + customs-clearance)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "claimId",
            "documentVid",
            "lossKind",
            "filedAt"
          ],
          "properties": {
            "claimId": {
              "type": "string"
            },
            "documentVid": {
              "type": "string",
              "description": "bridges issueFbl"
            },
            "lossKind": {
              "type": "string",
              "enum": [
                "damage",
                "shortage",
                "delay",
                "contamination",
                "theft",
                "mislabelling",
                "force_majeure"
              ]
            },
            "claimAmountUsd": {
              "type": "number"
            },
            "conventionApplicable": {
              "type": "string",
              "enum": [
                "cmr",
                "cim",
                "hague_visby",
                "hamburg",
                "rotterdam",
                "montreal",
                "warsaw",
                "cogsa"
              ]
            },
            "resolutionStatus": {
              "type": "string",
              "enum": [
                "pending",
                "settled",
                "denied",
                "arbitration",
                "court"
              ]
            },
            "filedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "minor",
                "significant",
                "major"
              ]
            }
          }
        }
      }
    }
  }
}