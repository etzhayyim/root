{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kousuu.timeEntry",
  "defs": {
    "main": {
      "type": "record",
      "description": "Time entry (工数) — hours logged by a member against a project (and optionally a task). approvalStatus lifecycle: draft → submitted → approved | rejected. Once approved and billable=true, derive rule can attach the entry to a seikyu.invoice lineItem and stamp invoiceLineitemCid back.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["ownerDid", "memberDid", "projectDid", "entryDate", "hours", "billable", "approvalStatus", "createdAt"],
        "properties": {
          "ownerDid":           { "type": "string", "format": "did" },
          "memberDid":          { "type": "string", "format": "did", "description": "Employee DID (jinji.employee once Phase 3)" },
          "projectDid":         { "type": "string", "format": "did" },
          "taskDid":            { "type": "string", "format": "did" },
          "entryDate":          { "type": "string", "format": "datetime" },
          "hours":              { "type": "number", "description": "Quantized to 0.25 (15-minute increments)" },
          "description":        { "type": "string" },
          "billable":           { "type": "boolean" },
          "invoiceLineitemCid": { "type": "string", "description": "Set once this entry has been billed" },
          "approvalStatus":     { "type": "string", "enum": ["draft","submitted","approved","rejected","billed"] },
          "approvedByDid":      { "type": "string", "format": "did" },
          "approvedAt":         { "type": "string", "format": "datetime" },
          "createdAt":          { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
