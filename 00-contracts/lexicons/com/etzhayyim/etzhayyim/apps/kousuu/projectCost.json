{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kousuu.projectCost",
  "defs": {
    "main": {
      "type": "record",
      "description": "Projected / actual cost snapshot for a project per period. Written by getProjectBurn derive or manual closeMonth. Source of truth for live queries is mv_kousuu_project_burn; this record is an immutable monthly snapshot for auditing.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["ownerDid", "projectDid", "periodMonth", "actualHours", "billableHours", "actualCostJpy", "createdAt"],
        "properties": {
          "ownerDid":      { "type": "string", "format": "did" },
          "projectDid":    { "type": "string", "format": "did" },
          "periodMonth":   { "type": "string", "description": "YYYY-MM" },
          "actualHours":   { "type": "number" },
          "billableHours": { "type": "number" },
          "actualCostJpy": { "type": "number" },
          "budgetHours":   { "type": "number" },
          "percentComplete":{ "type": "number" },
          "createdAt":     { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
