{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kousuu.createProject",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create a project in status='active'. projectCode must be unique per ownerDid.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["projectCode", "projectName", "startDate"],
          "properties": {
            "customerDid":   { "type": "string", "format": "did" },
            "projectCode":   { "type": "string" },
            "projectName":   { "type": "string" },
            "budgetHours":   { "type": "number" },
            "budgetCostJpy": { "type": "number" },
            "startDate":     { "type": "string", "format": "datetime" },
            "endDate":       { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["projectDid", "uri"],
          "properties": {
            "projectDid": { "type": "string", "format": "did" },
            "uri":        { "type": "string", "format": "at-uri" }
          }
        }
      },
      "errors": [
        { "name": "DuplicateCode", "description": "projectCode already exists for ownerDid" }
      ]
    }
  }
}
