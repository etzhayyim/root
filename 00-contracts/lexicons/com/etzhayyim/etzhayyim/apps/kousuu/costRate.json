{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kousuu.costRate",
  "defs": {
    "main": {
      "type": "record",
      "description": "Per-member hourly cost rate (円/h). Treated as PII Tier 3 (payroll-derived); hourlyCostEncrypted is signal:v1 field-encrypted. Effective-dated (effectiveFrom) so history is preserved; readers use the latest entry where effectiveFrom <= entryDate.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["ownerDid", "memberDid", "effectiveFrom", "hourlyCostEncrypted", "createdAt"],
        "properties": {
          "ownerDid":             { "type": "string", "format": "did" },
          "memberDid":            { "type": "string", "format": "did" },
          "effectiveFrom":        { "type": "string", "format": "datetime" },
          "hourlyCostEncrypted":  { "type": "string", "description": "signal:v1:{ciphertext of JPY value}" },
          "createdAt":            { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
