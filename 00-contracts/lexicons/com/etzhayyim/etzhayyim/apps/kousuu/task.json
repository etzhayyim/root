{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kousuu.task",
  "defs": {
    "main": {
      "type": "record",
      "description": "Work-breakdown-structure (WBS) task under a project. timeEntry rows reference a task for granular cost attribution. Nesting is expressed via parentTaskDid.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["ownerDid", "projectDid", "taskCode", "taskName", "status", "createdAt"],
        "properties": {
          "ownerDid":      { "type": "string", "format": "did" },
          "projectDid":    { "type": "string", "format": "did" },
          "parentTaskDid": { "type": "string", "format": "did" },
          "taskCode":      { "type": "string" },
          "taskName":      { "type": "string" },
          "plannedHours":  { "type": "number" },
          "defaultBillable":{ "type": "boolean", "default": true },
          "status":        { "type": "string", "enum": ["open","inProgress","done","cancelled"] },
          "createdAt":     { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
