{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kousuu.recordTimeEntry",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a single time entry. Server validates hours is a multiple of 0.25, the project is active, and (if taskDid given) the task belongs to the project. Status starts as 'draft' unless submit=true.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["projectDid", "entryDate", "hours", "billable"],
          "properties": {
            "projectDid":   { "type": "string", "format": "did" },
            "taskDid":      { "type": "string", "format": "did" },
            "entryDate":    { "type": "string", "format": "datetime" },
            "hours":        { "type": "number" },
            "description":  { "type": "string" },
            "billable":     { "type": "boolean" },
            "submit":       { "type": "boolean", "default": false, "description": "If true, start status at 'submitted' instead of 'draft'" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["timeEntryDid", "approvalStatus"],
          "properties": {
            "timeEntryDid":   { "type": "string", "format": "did" },
            "approvalStatus": { "type": "string", "enum": ["draft","submitted"] }
          }
        }
      },
      "errors": [
        { "name": "InvalidHours",     "description": "hours is not a positive multiple of 0.25" },
        { "name": "ProjectInactive",  "description": "project is not in 'active' status" }
      ]
    }
  }
}
