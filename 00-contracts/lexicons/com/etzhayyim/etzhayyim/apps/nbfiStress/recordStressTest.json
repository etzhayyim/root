{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.nbfiStress.recordStressTest",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Non-bank financial intermediary stress test (FSB NBFI / ESRB / SEC — bridges liquidityFacility.flagStigmaEffect + bank-resolution + sovereign-debt)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "testId",
            "nbfiKind",
            "stressScenario",
            "testedAt"
          ],
          "properties": {
            "testId": {
              "type": "string"
            },
            "nbfiKind": {
              "type": "string",
              "enum": [
                "money_market",
                "hedge_fund",
                "open_ended_fund",
                "pe_fund",
                "insurer_life",
                "pension_db",
                "ccp",
                "broker_dealer",
                "finance_company",
                "fintech_neobank",
                "crypto_exchange",
                "commodity_fund",
                "securitizer",
                "uk_ltlip",
                "repoer"
              ]
            },
            "stressScenario": {
              "type": "string",
              "enum": [
                "dash_for_cash",
                "redemption_run",
                "margin_spiral",
                "ltcm_like",
                "covid_march_2020",
                "gilt_crisis",
                "arm_spike",
                "dollar_shortage",
                "commodity_spike",
                "sovereign_stress",
                "stablecoin_run",
                "crypto_meltdown",
                "repo_spike"
              ]
            },
            "stigmaVid": {
              "type": "string",
              "description": "bridges liquidityFacility.flagStigmaEffect"
            },
            "testedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}