{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.nbfiStress.flagResolutionGap",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "NBFI resolution / transparent unwinding gap (bridges liquidityFacility.flagStigmaEffect + bank-resolution + sovereign-debt)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "testVid",
            "gapKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "testVid": {
              "type": "string",
              "description": "bridges recordStressTest"
            },
            "gapKind": {
              "type": "string",
              "enum": [
                "no_lolr",
                "resolution_framework_missing",
                "collateral_taker_unclear",
                "margin_asymmetry",
                "intermediary_chains",
                "central_clearing_risk",
                "prime_broker_concentration",
                "daily_liquidity_mismatch",
                "gating_enforcement",
                "swing_pricing_weak",
                "reporting_opacity"
              ]
            },
            "potentialLossBusd": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}