{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.cnNdrc.flagImplementationGap",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Local plan implementation gap / energy intensity overshoot (bridges climateAdaptationFinance + just-transition + euDgClima)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "actionVid",
            "gapKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "actionVid": {
              "type": "string",
              "description": "bridges recordPlanAction"
            },
            "gapKind": {
              "type": "string",
              "enum": [
                "provincial_lag",
                "energy_intensity_overshoot",
                "carbon_dual_breach",
                "rebalancing_uneven",
                "local_govt_debt_drag",
                "real_estate_drag",
                "capital_outflow",
                "yuan_pressure",
                "steel_relapse",
                "coal_addback",
                "crash_program_blackout"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}