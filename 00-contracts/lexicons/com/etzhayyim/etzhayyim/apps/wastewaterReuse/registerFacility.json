{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.wastewaterReuse.registerFacility",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Water reuse / desalination facility (ISO 20760 / AWWA / WHO — bridges water-scarcity + chemicals-management + agri-food-security + urban-heat)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "facilityId",
            "countryIso3",
            "treatmentTier",
            "capacityM3Day",
            "endUse",
            "commissionedAt"
          ],
          "properties": {
            "facilityId": {
              "type": "string"
            },
            "operatorLei": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "treatmentTier": {
              "type": "string",
              "enum": [
                "primary",
                "secondary",
                "tertiary",
                "advanced_oxidation",
                "membrane_mbr",
                "reverse_osmosis",
                "uv",
                "ozone",
                "nature_based"
              ]
            },
            "capacityM3Day": {
              "type": "number"
            },
            "endUse": {
              "type": "string",
              "enum": [
                "potable_direct",
                "potable_indirect",
                "irrigation",
                "industrial",
                "environmental",
                "groundwater_recharge"
              ]
            },
            "commissionedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}