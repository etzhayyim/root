{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.payment.escrowOpened",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "Gnosis Safe 2-of-3 escrow opened (user / recipient / etzhayyim-arbiter). Per ADR-2605172100.",
      "record": {
        "type": "object",
        "required": ["to", "amountUsdcMicros", "tokenContract", "chainId", "safeAddress", "arbiter", "dueDate", "purpose", "openedAt"],
        "properties": {
          "to": { "type": "string" },
          "amountUsdcMicros": { "type": "integer", "minimum": 1 },
          "tokenContract": { "type": "string" },
          "chainId": { "type": "integer" },
          "safeAddress": { "type": "string", "description": "0x-prefixed Safe contract address." },
          "arbiter": { "type": "string", "description": "0x-prefixed arbiter Smart Wallet address." },
          "dueDate": { "type": "string", "format": "datetime" },
          "purpose": { "type": "string", "enum": ["purchase", "grant", "subscription"] },
          "forUri": { "type": "string", "format": "at-uri" },
          "memo": { "type": "string", "maxLength": 280 },
          "openedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
