{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.payment.treasury-rebalance-skip",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "No-op trail record emitted by TreasuryRebalanceCell when the monthly cron tick fired but no governance proposal was produced — either because all three tiers were within drift_threshold_bps or because the treasury is empty. Per ADR-2605172300 §3.3. Existence guarantees the cell ran; silence is never the cell's output.",
      "record": {
        "type": "object",
        "required": [
          "reason",
          "navLiquidUsdcMicros",
          "navReserveUsdcMicros",
          "navCorpusUsdcMicros",
          "navTotalUsdcMicros",
          "targetLiquidBps",
          "targetReserveBps",
          "targetCorpusBps",
          "driftThresholdBps",
          "epochSeconds"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "enum": ["within_band", "treasury_empty"],
            "description": "Why no proposal was emitted. 'within_band' = max(|drift|) <= driftThresholdBps; 'treasury_empty' = navTotal == 0."
          },
          "navLiquidUsdcMicros": {
            "type": "integer",
            "minimum": 0,
            "description": "TreasuryMirror.tierLatest(TIER_LIQUID), USDC base units."
          },
          "navReserveUsdcMicros": {
            "type": "integer",
            "minimum": 0,
            "description": "TreasuryMirror.tierLatest(TIER_RESERVE), USDC base units."
          },
          "navCorpusUsdcMicros": {
            "type": "integer",
            "minimum": 0,
            "description": "TreasuryMirror.tierLatest(TIER_CORPUS), USDC base units."
          },
          "navTotalUsdcMicros": {
            "type": "integer",
            "minimum": 0,
            "description": "Sum of the three tiers."
          },
          "observedLiquidBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "description": "Observed 流動 share. Zero when reason = treasury_empty."
          },
          "observedReserveBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "description": "Observed 準備 share."
          },
          "observedCorpusBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "description": "Observed 本財 share."
          },
          "targetLiquidBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "description": "Constitution.getMutable('tier_liquid_bps') at tick time."
          },
          "targetReserveBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "description": "Constitution.getMutable('tier_reserve_bps') at tick time."
          },
          "targetCorpusBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "description": "Constitution.getMutable('tier_corpus_bps') at tick time."
          },
          "driftThresholdBps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "description": "Threshold against which all tiers stayed within band."
          },
          "epochSeconds": {
            "type": "integer",
            "minimum": 1,
            "description": "Unix seconds of the monthly cron tick."
          }
        }
      }
    }
  }
}
