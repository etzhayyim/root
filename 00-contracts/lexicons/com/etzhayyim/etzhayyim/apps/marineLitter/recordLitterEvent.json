{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.marineLitter.recordLitterEvent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Marine litter / ALDFG / pellet spill event (UNEA plastic treaty / GPML / ghost gear — bridges maritimeSpill.flagClcInadequacy + fisheries-iuu + biodiversity-gbf)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "eventId",
            "regionName",
            "litterKind",
            "detectedAt"
          ],
          "properties": {
            "eventId": {
              "type": "string"
            },
            "regionName": {
              "type": "string"
            },
            "litterKind": {
              "type": "string",
              "enum": [
                "aldfg_ghost_gear",
                "plastic_pellet_spill",
                "container_loss",
                "urban_debris",
                "fishing_line",
                "micro_bead",
                "tire_dust",
                "ppe_debris",
                "coastal_trash",
                "river_plume",
                "deep_sea_trawl"
              ]
            },
            "estMassTonnes": {
              "type": "number"
            },
            "spillVid": {
              "type": "string",
              "description": "bridges maritimeSpill.flagClcInadequacy"
            },
            "detectedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}