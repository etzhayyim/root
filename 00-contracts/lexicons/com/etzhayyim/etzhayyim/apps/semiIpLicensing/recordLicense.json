{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.semiIpLicensing.recordLicense",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Semiconductor IP licensing (Arm / RISC-V / synopsys / cadence — bridges semiconductor-fab + ai-supply-chain + merger-review + mofcom-export-control)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "licenseId",
            "ipCategory",
            "signedAt"
          ],
          "properties": {
            "licenseId": {
              "type": "string"
            },
            "licensorLei": {
              "type": "string"
            },
            "licenseeLei": {
              "type": "string"
            },
            "ipCategory": {
              "type": "string",
              "enum": [
                "cpu_isa",
                "gpu_ip",
                "dsp",
                "fpga",
                "memory_controller",
                "pcie",
                "usb",
                "display",
                "analog",
                "eda_tool",
                "mixed_signal"
              ]
            },
            "feeStructure": {
              "type": "string",
              "enum": [
                "royalty_per_unit",
                "lump_sum",
                "subscription",
                "hybrid"
              ]
            },
            "upfrontFeeUsd": {
              "type": "number"
            },
            "royaltyPct": {
              "type": "number"
            },
            "signedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}