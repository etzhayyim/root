{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.semiIpLicensing.flagLitigation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Semi IP litigation (bridges antitrust-dma + merger-review + mofcom-export-control + ustr-section-301)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "caseId",
            "claimKind",
            "filedAt"
          ],
          "properties": {
            "caseId": {
              "type": "string"
            },
            "licenseVid": {
              "type": "string",
              "description": "bridges recordLicense"
            },
            "venue": {
              "type": "string",
              "enum": [
                "itc_337",
                "d_delaware",
                "txsd",
                "uk_patents",
                "epo",
                "upc",
                "japan_ipdivision"
              ]
            },
            "claimKind": {
              "type": "string",
              "enum": [
                "patent_infringement",
                "trade_secret",
                "breach_of_license",
                "fradua_on_patent_office",
                "standard_essential"
              ]
            },
            "damagesSoughtUsd": {
              "type": "number"
            },
            "filedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "commercial",
                "major",
                "bet_the_company"
              ]
            }
          }
        }
      }
    }
  }
}