{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.priceCapCoalition.recordAttestation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "G7 Price Cap Coalition attestation / maritime service (bridges aisDarkVessel.flagSanctionsEvasion + ofac-sanctions-sdn + commodity-trade)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "attestationId",
            "tier",
            "attestationKind",
            "attestedAt"
          ],
          "properties": {
            "attestationId": {
              "type": "string"
            },
            "tier": {
              "type": "string",
              "enum": [
                "tier_1_trader",
                "tier_2_service",
                "tier_3_port",
                "crude_cap",
                "petroleum_product_cap",
                "diesel_cap",
                "gasoline_cap"
              ]
            },
            "serviceProviderLei": {
              "type": "string"
            },
            "attestationKind": {
              "type": "string",
              "enum": [
                "price_below_cap",
                "itinerary_compliant",
                "no_sts_with_shadow",
                "insurance_compliant",
                "flag_registry_check",
                "vessel_owner_check"
              ]
            },
            "vesselImo": {
              "type": "string"
            },
            "darkVesselVid": {
              "type": "string",
              "description": "bridges aisDarkVessel.flagSanctionsEvasion"
            },
            "attestedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}