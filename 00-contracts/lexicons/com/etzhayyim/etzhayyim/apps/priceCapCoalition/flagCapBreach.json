{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.priceCapCoalition.flagCapBreach",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Price cap violation / attestation fraud / fronting (bridges aisDarkVessel.flagSanctionsEvasion + ofac-sanctions-sdn + commodity-trade)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "attestationVid",
            "breachKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "attestationVid": {
              "type": "string",
              "description": "bridges recordAttestation"
            },
            "breachKind": {
              "type": "string",
              "enum": [
                "above_cap_sale",
                "back_dated_invoice",
                "attestation_forgery",
                "fronting_entity",
                "insurance_gap",
                "stsless_traceable",
                "uae_hub_routing",
                "india_refining_loophole",
                "hidden_profit_tranche"
              ]
            },
            "estPremiumUsd": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}