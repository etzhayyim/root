{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airCargo.reportCargoSecurity",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Report the security screening result for a cargo shipment.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["awb_no", "security_check_type", "result"],
          "properties": {
            "awb_no": { "type": "string" },
            "security_check_type": { "type": "string" },
            "result": { "type": "string" },
            "screener_id": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
