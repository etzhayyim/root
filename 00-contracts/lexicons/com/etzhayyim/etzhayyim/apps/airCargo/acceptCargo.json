{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airCargo.acceptCargo",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Accept cargo at the terminal.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["awb_no", "acceptance_date", "actual_weight_kg"],
          "properties": {
            "awb_no": { "type": "string" },
            "acceptance_date": { "type": "string" },
            "actual_weight_kg": { "type": "string" },
            "pieces": { "type": "integer" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
