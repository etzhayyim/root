{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airCargo.processClaim",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Process a cargo claim for damage, loss, or delay.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["awb_no", "claim_type", "claim_amount"],
          "properties": {
            "awb_no": { "type": "string" },
            "claim_type": { "type": "string" },
            "claim_amount": { "type": "string" },
            "currency": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
