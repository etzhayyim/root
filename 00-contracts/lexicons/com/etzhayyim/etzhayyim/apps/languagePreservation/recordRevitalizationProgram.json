{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.languagePreservation.recordRevitalizationProgram",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Language revitalization program (bridges indigenous-rights + climate-adaptation-finance)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "programId",
            "languageVid",
            "programKind",
            "startedAt"
          ],
          "properties": {
            "programId": {
              "type": "string"
            },
            "languageVid": {
              "type": "string",
              "description": "bridges registerEndangeredLanguage"
            },
            "programKind": {
              "type": "string",
              "enum": [
                "immersion_school",
                "adult_apprentice",
                "media",
                "digital_corpus",
                "dictionary",
                "ai_model",
                "orthography"
              ]
            },
            "sponsorLei": {
              "type": "string"
            },
            "annualBudgetUsd": {
              "type": "number"
            },
            "startedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}