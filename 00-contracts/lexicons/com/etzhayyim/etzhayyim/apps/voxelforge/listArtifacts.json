{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.voxelforge.listArtifacts",
  "defs": {
    "main": {
      "type": "query",
      "description": "List voxelforge artifacts filtered by designId / actor / format. Per ADR-2605080700.",
      "parameters": {
        "type": "params",
        "properties": {
          "designId": { "type": "string", "description": "Optional vertex_voxelforge_design.vertex_id." },
          "actorDid": { "type": "string", "description": "Optional ERC725 / did:web of the design owner." },
          "format": { "type": "string", "enum": ["glb", "vox", "voxel_grid_json", "manifest_json"] },
          "generatedBy": { "type": "string", "enum": ["trellis", "comfy3d", "cadquery"] },
          "limit": { "type": "integer", "default": 50, "minimum": 1, "maximum": 200 },
          "offset": { "type": "integer", "default": 0 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["artifacts", "total", "offset", "limit"],
          "properties": {
            "artifacts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["vertexId", "designVertexId", "runVertexId", "format", "b2Bucket", "b2Key", "sha256Hex", "byteSize", "generatedBy", "tsMs"],
                "properties": {
                  "vertexId": { "type": "string" },
                  "designVertexId": { "type": "string" },
                  "runVertexId": { "type": "string" },
                  "format": { "type": "string" },
                  "b2Bucket": { "type": "string" },
                  "b2Key": { "type": "string" },
                  "sha256Hex": { "type": "string" },
                  "byteSize": { "type": "integer" },
                  "voxelDim": { "type": "integer" },
                  "polygonCount": { "type": "integer" },
                  "generatedBy": { "type": "string" },
                  "tsMs": { "type": "integer" },
                  "actorDid": { "type": "string" }
                }
              }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
