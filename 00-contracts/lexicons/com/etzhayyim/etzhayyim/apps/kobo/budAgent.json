{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kobo.budAgent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Bud (asexual reproduction) a new child agent from a parent kobo agent. Transfers heritable prions (vertex_kobo_prion where heritable=true) to the child. Records edge_kobo_budding.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "parentDid": { "type": "string", "description": "Parent agent DID" },
            "childDid": { "type": "string", "description": "New child agent DID" },
            "inheritPrions": { "type": "boolean", "description": "Copy heritable prions to child", "default": true }
          },
          "required": ["parentDid", "childDid"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "buddingEdgeId": { "type": "string" },
            "childVertexId": { "type": "string" },
            "prionsCopied": { "type": "integer" },
            "error": { "type": "string" }
          },
          "required": ["buddingEdgeId", "childVertexId"]
        }
      }
    }
  }
}
