{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kobo.spawnAgent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Spawn a new kobo agent (yeast cell). Creates vertex_kobo_agent with genesis state. No parent — this is a root agent creation.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "agentDid": { "type": "string", "description": "DID for the new agent" },
            "role": { "type": "string", "description": "Agent role (generalist / specialist / scout)" },
            "initialEta": { "type": "number", "description": "Initial Shannon η score" }
          },
          "required": ["agentDid", "role"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "vertexId": { "type": "string" },
            "agentDid": { "type": "string" },
            "status": { "type": "string" },
            "error": { "type": "string" }
          },
          "required": ["vertexId", "agentDid", "status"]
        }
      }
    }
  }
}
