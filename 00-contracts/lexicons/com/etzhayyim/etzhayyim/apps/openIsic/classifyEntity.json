{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openIsic.classifyEntity",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Assign a legal entity to an ISIC Rev.4 class. FEEL auto-classifies verification as 'authoritative' (confidence >= 0.9), 'community' (0.5..0.89), 'candidate' (< 0.5). Starts BPMN open_isic_classify_entity.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["entityDid","isicClassCode","confidence","classifiedAt"],
          "properties": {
            "entityDid":     { "type": "string" },
            "isicClassCode": { "type": "string", "description": "4-digit ISIC class" },
            "entityName":    { "type": "string" },
            "country":       { "type": "string" },
            "evidenceUrl":   { "type": "string" },
            "confidence":    { "type": "number", "minimum": 0, "maximum": 1 },
            "classifiedAt":  { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
            "verification": { "type": "string", "enum": ["authoritative","community","candidate"] },
            "requireReview": { "type": "boolean" },
            "instanceKey": { "type": "integer" }, "error": { "type": "string" }
          }
        }
      }
    }
  }
}
