{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.catBondIls.recordPayout",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Trigger event + payout record",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "payoutId",
            "bondVid",
            "triggerEventDescription",
            "payoutUsd",
            "triggeredAt"
          ],
          "properties": {
            "payoutId": {
              "type": "string"
            },
            "bondVid": {
              "type": "string",
              "description": "bridges issueCatBond"
            },
            "triggerEventDescription": {
              "type": "string"
            },
            "payoutUsd": {
              "type": "number"
            },
            "payoutPct": {
              "type": "number"
            },
            "disasterVid": {
              "type": "string",
              "description": "bridges open-disaster-response"
            },
            "triggeredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "outcomeTier": {
              "type": "string",
              "enum": [
                "haircut",
                "partial",
                "full_loss"
              ]
            }
          }
        }
      }
    }
  }
}