{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.catBondIls.issueCatBond",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Catastrophe / ILS bond (bridges disaster-response + cyclone-prepo + climate-litigation + sovereign-debt)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "bondId",
            "triggerType",
            "peril",
            "principalUsd",
            "tenorYears",
            "issuedAt",
            "maturesAt"
          ],
          "properties": {
            "bondId": {
              "type": "string"
            },
            "sponsorLei": {
              "type": "string"
            },
            "triggerType": {
              "type": "string",
              "enum": [
                "indemnity",
                "parametric",
                "industry_loss",
                "modeled_loss",
                "hybrid"
              ]
            },
            "peril": {
              "type": "string",
              "enum": [
                "us_hurricane",
                "us_earthquake",
                "us_wildfire",
                "jp_earthquake",
                "jp_typhoon",
                "eu_windstorm",
                "cyber",
                "pandemic",
                "flood",
                "mortality",
                "longevity"
              ]
            },
            "principalUsd": {
              "type": "number"
            },
            "couponSpreadBps": {
              "type": "number"
            },
            "tenorYears": {
              "type": "number"
            },
            "disasterVid": {
              "type": "string",
              "description": "bridges open-disaster-response (if linked)"
            },
            "issuedAt": {
              "type": "string",
              "format": "datetime"
            },
            "maturesAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "attachmentTier": {
              "type": "string",
              "enum": [
                "slow",
                "medium",
                "rapid"
              ]
            }
          }
        }
      }
    }
  }
}