{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.crew.listCrew",
  "defs": {
    "main": {
      "type": "query",
      "description": "List maritime crew members with optional rank/flag/vessel filter. PII Tier 3 — full profile only via authorized conversation/service access.",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "properties": {
          "rank": { "type": "string" },
          "flagState": { "type": "string" },
          "currentVesselDid": { "type": "string", "format": "did" },
          "currentEmployerDid": { "type": "string", "format": "did" },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "required": ["crew", "total", "offset", "limit"], "properties": { "crew": { "type": "array", "items": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "rank": { "type": "string" }, "flagState": { "type": "string" }, "currentVesselDid": { "type": "string", "format": "did" } } } }, "total": { "type": "integer" }, "offset": { "type": "integer" }, "limit": { "type": "integer" } } } }
    }
  }
}
