{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.crew.registerCrew",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a maritime crew member with STCW certification. Sources: STCW Convention + flag state seafarer registries. Path-based DID: did:web:crew.etzhayyim.com:seafarer:{flagState}:{cdcNo}. PII Tier 3.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["rank", "flagState"],
          "properties": {
            "rank": { "type": "string", "enum": ["master", "chief-officer", "second-officer", "third-officer", "chief-engineer", "second-engineer", "third-engineer", "fourth-engineer", "electrical-officer", "bosun", "able-seaman", "ordinary-seaman", "oiler", "wiper", "cook", "steward"] },
            "flagState": { "type": "string", "description": "ISO 3166-1 alpha-3 issuing state" },
            "nationality": { "type": "string" },
            "cdcNumber": { "type": "string", "description": "Continuous Discharge Certificate number" },
            "stcwCertificates": { "type": "array", "items": { "type": "string", "description": "STCW regulation code (II/1, II/2, III/1, V/1-1-1, etc)" } },
            "currentVesselDid": { "type": "string", "format": "did" },
            "currentEmployerDid": { "type": "string", "format": "did" },
            "embarkedAt": { "type": "string", "format": "datetime" },
            "contractEndsAt": { "type": "string", "format": "datetime" },
            "mlcCompliance": { "type": "boolean", "description": "Maritime Labour Convention 2006 compliance verified" }
          }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "uri": { "type": "string", "format": "at-uri" } } } }
    }
  }
}
