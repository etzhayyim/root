{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.refugeeLivelihood.reportImpactMetric",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Livelihood outcome metric (bridges sdg-reporting + ocha-funding)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "metricId",
            "programVid",
            "reportingYear",
            "reportedAt"
          ],
          "properties": {
            "metricId": {
              "type": "string"
            },
            "programVid": {
              "type": "string",
              "description": "bridges registerFinanceProgram"
            },
            "livelihoodsSustainedPct": {
              "type": "number"
            },
            "employmentRatePct": {
              "type": "number"
            },
            "businessesStartedCount": {
              "type": "integer"
            },
            "householdIncomeDeltaPct": {
              "type": "number"
            },
            "reportingYear": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "outcomeTier": {
              "type": "string",
              "enum": [
                "nascent",
                "emerging",
                "strong"
              ]
            }
          }
        }
      }
    }
  }
}