{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.domain.registerAssist",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Assist with TLD registration: run eligibility check, recommend registrars, and append a draft registration ledger row (status='planning') so an operator can complete the registrar's own signup flow. Phase 1 is advisory + ledger only — registrar API automation deferred to Phase 2.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["domainName", "tld", "registrantDid", "actorKind", "jurisdiction"],
          "properties": {
            "domainName": {"type": "string", "description": "Fully-qualified domain name including TLD, e.g. 'etzhayyim.law'."},
            "tld": {"type": "string", "description": "Including the dot, e.g. '.law'."},
            "registrantDid": {"type": "string", "description": "DID of the registrant (lawyer / law-firm / company)."},
            "registrantName": {"type": "string", "description": "Legal name to be recorded in WHOIS / registry contact."},
            "actorKind": {"type": "string"},
            "jurisdiction": {"type": "string"},
            "regulatorSlug": {"type": "string"},
            "preferredRegistrar": {"type": "string", "description": "Optional registrar slug hint (e.g. 'namecheap')."},
            "nsProvider": {"type": "string", "description": "Optional preferred DNS host (default 'cloudflare')."},
            "evidenceUrl": {"type": "string", "description": "Public license-verification URL (e.g. JFBA registry entry)."}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "eligible"],
          "properties": {
            "ok": {"type": "boolean"},
            "eligible": {"type": "boolean"},
            "registrationVid": {"type": "string", "description": "Inserted vertex_domain_registration vertex_id (when eligible)."},
            "registrarRecommendation": {
              "type": "object",
              "properties": {
                "primary": {"type": "string"},
                "alternates": {"type": "array", "items": {"type": "string"}},
                "rationale": {"type": "string"}
              }
            },
            "verificationRequired": {"type": "boolean"},
            "verificationNotes": {"type": "string", "description": "What to prepare (e.g. JFBA member-card scan, registry URL)."},
            "alternativesIfBlocked": {"type": "array", "items": {"type": "string"}},
            "policyExcerpt": {"type": "string"},
            "sourceUrl": {"type": "string"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
