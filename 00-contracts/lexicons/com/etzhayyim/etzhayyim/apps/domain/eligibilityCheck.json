{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.domain.eligibilityCheck",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Check whether a given (TLD, jurisdiction, actor kind) tuple is eligible to register the TLD, citing the registry policy excerpt and any verification requirement.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["tld", "jurisdiction", "actorKind"],
          "properties": {
            "tld": {"type": "string", "description": "Including the dot, e.g. '.law'."},
            "jurisdiction": {"type": "string", "description": "ISO 3166-1 alpha-2 / alpha-3 (e.g. 'JP') or extended code ('GB-EAW')."},
            "actorKind": {
              "type": "string",
              "description": "Free-form label, e.g. 'individual-lawyer' / 'law-firm' / 'registered-foreign-lawyer' / 'non-legal-corporation' / 'any'."
            },
            "regulatorSlug": {"type": "string", "description": "Optional regulator hint (e.g. 'jfba')."}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "eligible", "tld"],
          "properties": {
            "ok": {"type": "boolean"},
            "eligible": {"type": "boolean"},
            "tld": {"type": "string"},
            "matchedAdviceSlug": {"type": "string"},
            "basis": {"type": "string"},
            "policyExcerpt": {"type": "string"},
            "verificationRequired": {"type": "boolean"},
            "regulatorSlug": {"type": "string"},
            "regulatorName": {"type": "string"},
            "sourceUrl": {"type": "string"},
            "alternatives": {"type": "array", "items": {"type": "string"}, "description": "Alternative TLDs if not eligible (e.g. ['.lawyer', '.legal'])."},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
