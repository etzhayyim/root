{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.domain.listRegistrars",
  "defs": {
    "main": {
      "type": "query",
      "description": "List registrars in the catalog, optionally filtered to those that handle a given TLD.",
      "parameters": {
        "type": "params",
        "properties": {
          "tld": {"type": "string", "description": "If set, restrict to registrars supporting this TLD."},
          "jpFriendly": {"type": "boolean", "description": "If true, restrict to registrars known to support JP customers."}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["registrars"],
          "properties": {
            "registrars": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["slug", "name"],
                "properties": {
                  "slug": {"type": "string"},
                  "name": {"type": "string"},
                  "homepageUrl": {"type": "string"},
                  "jpFriendly": {"type": "boolean"},
                  "supports": {"type": "array", "items": {"type": "string"}, "description": "TLDs supported (e.g. ['.law', '.lawyer'])."},
                  "notes": {"type": "string"}
                }
              }
            }
          }
        }
      }
    }
  }
}
