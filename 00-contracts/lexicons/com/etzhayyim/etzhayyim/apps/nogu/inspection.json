{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.nogu.inspection",
  "description": "農具・農機具の定期点検記録。農繁期前点検・年次点検・法定検査を記録。result=fail 時は maintenance レコードを連鎖作成。",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["itemId", "inspectedAt", "inspectorDid", "result"],
        "properties": {
          "itemId": { "type": "string" },
          "itemDid": { "type": "string", "description": "did:web:nogu.etzhayyim.com:item:{serialId}" },
          "inspectedAt": { "type": "string", "format": "date" },
          "inspectorDid": { "type": "string" },
          "inspectionType": {
            "type": "string",
            "enum": ["pre-season", "annual", "statutory", "spot"],
            "description": "農繁期前/年次/法定/臨時"
          },
          "result": { "type": "string", "enum": ["pass", "conditional-pass", "fail"] },
          "checkItems": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["checkName", "result"],
              "properties": {
                "checkName": { "type": "string" },
                "result": { "type": "string", "enum": ["ok", "caution", "ng"] },
                "note": { "type": "string" }
              }
            }
          },
          "nextInspectionDate": { "type": "string", "format": "date" },
          "maintenanceRequired": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
