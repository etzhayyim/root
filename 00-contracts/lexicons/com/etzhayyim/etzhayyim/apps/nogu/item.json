{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.nogu.item",
  "description": "農具・農機具の個体登録。手工具 (鍬/鎌/スコップ) から農業機械 (耕運機/田植機/コンバイン/トラクター) まで。serialId は製造番号または農協管理番号。",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["itemId", "category", "name", "ownerDid"],
        "properties": {
          "itemId": { "type": "string", "description": "農具管理 ID (ownerDid 内で一意)" },
          "category": {
            "type": "string",
            "enum": ["hand-tool", "power-tool", "tractor", "transplanter", "harvester", "cultivator", "sprayer", "irrigation", "other-machinery"],
            "description": "手工具/電動工具/トラクター/田植機/収穫機/耕運機/散布機/灌漑設備/その他農機"
          },
          "name": { "type": "string", "description": "品目名 (例: 管理機 VC70, 田植機 RJ8)" },
          "maker": { "type": "string", "description": "メーカー名" },
          "model": { "type": "string", "description": "型式" },
          "serialId": { "type": "string", "description": "製造番号 / 農協管理番号" },
          "ownerDid": { "type": "string", "description": "所有者 DID (農協単協 path-DID または個人)" },
          "acquiredAt": { "type": "string", "format": "date", "description": "取得日" },
          "acquiredPriceJpy": { "type": "number" },
          "status": {
            "type": "string",
            "enum": ["active", "leased", "maintenance", "retired"],
            "description": "稼働中/リース中/整備中/廃棄済"
          },
          "nextInspectionDate": { "type": "string", "format": "date" },
          "locationFarmId": { "type": "string", "description": "保管圃場 ID (nokyo.farm.farmId)" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
