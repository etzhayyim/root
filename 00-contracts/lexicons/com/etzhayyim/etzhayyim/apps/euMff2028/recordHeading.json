{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.euMff2028.recordHeading",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "EU Multiannual Financial Framework 2028+ heading proposal (bridges frugalFourCoalition.flagSwingShift + euTrilogue + euSummitConclusion)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "headingId",
            "headingKind",
            "budgetSizeKind",
            "proposedAt"
          ],
          "properties": {
            "headingId": {
              "type": "string"
            },
            "headingKind": {
              "type": "string",
              "enum": [
                "heading_1_single_market",
                "heading_2_cohesion",
                "heading_3_natural_resources",
                "heading_4_migration",
                "heading_5_security",
                "heading_6_neighbourhood",
                "heading_7_admin",
                "ngeu_successor",
                "competitiveness_fund",
                "ukraine_facility",
                "defence",
                "crisis",
                "new_own_resources"
              ]
            },
            "budgetSizeKind": {
              "type": "string",
              "enum": [
                "below_1pct_gni",
                "at_1pct_gni",
                "above_1pct_gni",
                "headroom_increase",
                "accc_anti_crisis"
              ]
            },
            "swingShiftVid": {
              "type": "string",
              "description": "bridges frugalFourCoalition.flagSwingShift"
            },
            "proposedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}