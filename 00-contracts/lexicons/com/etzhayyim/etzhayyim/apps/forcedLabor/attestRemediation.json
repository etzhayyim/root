{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.forcedLabor.attestRemediation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Remediation attestation (ILO Operational Guidelines / OECD Guidelines)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "attestationId",
            "flagVid",
            "remediationType",
            "attestedAt"
          ],
          "properties": {
            "attestationId": {
              "type": "string"
            },
            "flagVid": {
              "type": "string",
              "description": "bridges flagIndicator"
            },
            "remediationType": {
              "type": "string",
              "enum": [
                "wages_restored",
                "documents_returned",
                "worker_consulted",
                "grievance_mechanism",
                "third_party_audit",
                "prosecution",
                "workplace_closed"
              ]
            },
            "auditorLei": {
              "type": "string",
              "description": "bridges open-lei"
            },
            "effectivenessScore": {
              "type": "number",
              "description": "0-100 scale"
            },
            "attestedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "outcomeTier": {
              "type": "string",
              "enum": [
                "nominal",
                "partial",
                "substantive"
              ]
            }
          }
        }
      }
    }
  }
}