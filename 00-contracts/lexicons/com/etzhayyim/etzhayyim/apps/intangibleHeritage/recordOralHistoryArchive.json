{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.intangibleHeritage.recordOralHistoryArchive",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Oral history / community archive record (bridges language-preservation + cultural-heritage + bbnj-highseas DSI)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "archiveId",
            "elementVid",
            "mediaType",
            "archivedAt"
          ],
          "properties": {
            "archiveId": {
              "type": "string"
            },
            "elementVid": {
              "type": "string",
              "description": "bridges listIchElement"
            },
            "stewardLei": {
              "type": "string"
            },
            "languageId": {
              "type": "string"
            },
            "durationMinutes": {
              "type": "number"
            },
            "mediaType": {
              "type": "string",
              "enum": [
                "audio",
                "video",
                "transcript",
                "annotation",
                "interactive_map"
              ]
            },
            "licenseSpdx": {
              "type": "string"
            },
            "consentModel": {
              "type": "string",
              "enum": [
                "community_consent",
                "individual_consent",
                "traditional_knowledge_label",
                "cc0",
                "all_rights_reserved"
              ]
            },
            "archivedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}