{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.oilTrading.listTrades",
  "defs": {
    "main": {
      "type": "query",
      "description": "List physical oil trades with optional grade/benchmark/counterparty filter.",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "properties": {
          "tradeType": { "type": "string" },
          "grade": { "type": "string" },
          "benchmark": { "type": "string" },
          "buyerDid": { "type": "string", "format": "did" },
          "sellerDid": { "type": "string", "format": "did" },
          "tradedAfter": { "type": "string", "format": "datetime" },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "required": ["trades", "total", "offset", "limit"], "properties": { "trades": { "type": "array", "items": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "tradeType": { "type": "string" }, "grade": { "type": "string" }, "volumeBbl": { "type": "number" }, "priceUsdBbl": { "type": "number" }, "tradedAt": { "type": "string", "format": "datetime" } } } }, "total": { "type": "integer" }, "offset": { "type": "integer" }, "limit": { "type": "integer" } } } }
    }
  }
}
