{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.oilTrading.getTrade",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a physical oil trade by DID.",
      "x-bootstrap": true,
      "parameters": { "type": "params", "required": ["did"], "properties": { "did": { "type": "string", "format": "did" } } },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "tradeType": { "type": "string" }, "grade": { "type": "string" }, "benchmark": { "type": "string" }, "volumeBbl": { "type": "number" }, "priceUsdBbl": { "type": "number" }, "differentialUsdBbl": { "type": "number" }, "tradedAt": { "type": "string", "format": "datetime" }, "buyerDid": { "type": "string", "format": "did" }, "sellerDid": { "type": "string", "format": "did" }, "loadingPortDid": { "type": "string", "format": "did" }, "dischargePortDid": { "type": "string", "format": "did" } } } }
    }
  }
}
