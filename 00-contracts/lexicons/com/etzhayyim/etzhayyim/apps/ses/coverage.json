{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ses.coverage",
  "defs": {
    "main": {
      "type": "query",
      "description": "案件数・状況別集計・直近 24h delta などのヘルススナップショットを返す。",
      "parameters": {
        "type": "params",
        "properties": {
          "windowDays": { "type": "integer", "description": "集計ウィンドウ (デフォルト 7)" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "totalAnken": { "type": "integer" },
            "activeAnken": { "type": "integer" },
            "jokyoCounts": {
              "type": "object",
              "description": "状況名 → 件数のマップ"
            },
            "delta24h": {
              "type": "object",
              "properties": {
                "newAnken": { "type": "integer" },
                "jokyoUpdates": { "type": "integer" }
              }
            },
            "lastIngestAt": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
