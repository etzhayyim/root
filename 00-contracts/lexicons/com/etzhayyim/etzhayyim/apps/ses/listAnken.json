{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ses.listAnken",
  "defs": {
    "main": {
      "type": "query",
      "description": "actor scope の案件一覧。status フィルタ付き。",
      "parameters": {
        "type": "params",
        "properties": {
          "jokyo": {
            "type": "string",
            "description": "状況フィルタ (カンマ区切りで複数指定可)"
          },
          "limit": { "type": "integer" },
          "offset": { "type": "integer" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["anken", "total", "offset", "limit"],
          "properties": {
            "anken": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "vertexId": { "type": "string" },
                  "clientName": { "type": "string" },
                  "clientCompany": { "type": "string" },
                  "jokyoCurrent": { "type": "string" },
                  "startMonth": { "type": "string" },
                  "endMonth": { "type": "string" },
                  "rateLowerYen": { "type": "integer" },
                  "rateUpperYen": { "type": "integer" },
                  "workLocation": { "type": "string" },
                  "remoteOk": { "type": "boolean" },
                  "createdAt": { "type": "string" }
                }
              }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
