{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ses.ingestAnken",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "メール本文または raw_text を投入して SES 案件を抽出・登録する。LangGraph run_id を返す。",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sourceKind", "rawText"],
          "properties": {
            "sourceKind": {
              "type": "string",
              "enum": ["email", "manual"],
              "description": "入力種別"
            },
            "rawText": {
              "type": "string",
              "maxLength": 32000,
              "description": "メール本文またはフリーテキスト"
            },
            "sourceEmailSubject": {
              "type": "string",
              "maxLength": 500,
              "description": "メール件名 (email sourceKind 時)"
            },
            "sourceEmailFrom": {
              "type": "string",
              "maxLength": 200,
              "description": "送信元メールアドレス (email sourceKind 時)"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["runId", "status"],
          "properties": {
            "runId": { "type": "string" },
            "ankenId": { "type": "string", "description": "既存案件に合致した場合の anken_vertex_id" },
            "status": { "type": "string", "enum": ["running", "completed", "completed_with_error"] },
            "estimatedSeconds": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
