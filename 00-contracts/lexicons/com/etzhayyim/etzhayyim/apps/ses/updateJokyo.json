{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ses.updateJokyo",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "既存案件の状況を手動更新する (append-only log)。forbidden 遷移はスキップ。",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ankenId", "jokyo"],
          "properties": {
            "ankenId": {
              "type": "string",
              "description": "vertex_ses_anken.vertex_id"
            },
            "jokyo": {
              "type": "string",
              "enum": ["提案中", "選考中", "契約", "稼働中", "終了", "見送り", "中途終了"]
            },
            "notes": {
              "type": "string",
              "maxLength": 400
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "jokyoId": { "type": "string", "description": "vertex_ses_jokyo.vertex_id" },
            "skipped": { "type": "boolean", "description": "forbidden 遷移のためスキップした場合 true" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
