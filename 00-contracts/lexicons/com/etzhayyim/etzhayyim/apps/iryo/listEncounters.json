{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.iryo.listEncounters",
  "defs": {
    "main": {
      "type": "query",
      "description": "List encounters filtered by department / ward / status / admission window. Returns Tier-1 fields only (no PHI; patient_did is opaque hash).",
      "parameters": {
        "type": "params",
        "properties": {
          "deptSlug": {"type": "string"},
          "wardSlug": {"type": "string"},
          "status": {"type": "string", "enum": ["open", "closed", "any"], "default": "any"},
          "admittedAfter": {"type": "string", "format": "datetime"},
          "admittedBefore": {"type": "string", "format": "datetime"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 200, "default": 50}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "encounters"],
          "properties": {
            "ok": {"type": "boolean"},
            "encounters": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["encounterId", "patientDid", "deptSlug", "wardSlug", "status", "admittedAtMs"],
                "properties": {
                  "encounterId": {"type": "string"},
                  "patientDid": {"type": "string"},
                  "deptSlug": {"type": "string"},
                  "wardSlug": {"type": "string"},
                  "bedSlug": {"type": "string"},
                  "status": {"type": "string"},
                  "admissionType": {"type": "string"},
                  "admittedAtMs": {"type": "integer"},
                  "dischargedAtMs": {"type": "integer"},
                  "principalDiagnosisCode": {"type": "string"},
                  "drgCode": {"type": "string"},
                  "lengthOfStayDays": {"type": "integer"},
                  "severityTier": {"type": "integer"}
                }
              }
            }
          }
        }
      }
    }
  }
}
