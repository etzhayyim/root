{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.iryo.coverage",
  "defs": {
    "main": {
      "type": "query",
      "description": "Coverage snapshot — counts of hospital / dept / ward / bed / staff / encounter / drg_claim plus MV freshness for iryo Phase 1.",
      "parameters": {
        "type": "params",
        "properties": {
          "asOf": {"type": "string", "format": "datetime"}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["asOf", "hospitals", "depts", "wards", "beds", "staff", "encountersOpen", "encountersClosed", "drgClaimsOpen", "drgClaimsClosed", "lastBedRecomputeMs"],
          "properties": {
            "asOf": {"type": "string", "format": "datetime"},
            "hospitals": {"type": "integer"},
            "depts": {"type": "integer"},
            "wards": {"type": "integer"},
            "beds": {"type": "integer"},
            "staff": {"type": "integer"},
            "encountersOpen": {"type": "integer"},
            "encountersClosed": {"type": "integer"},
            "drgClaimsOpen": {"type": "integer"},
            "drgClaimsClosed": {"type": "integer"},
            "lastBedRecomputeMs": {"type": "integer"}
          }
        }
      }
    }
  }
}
