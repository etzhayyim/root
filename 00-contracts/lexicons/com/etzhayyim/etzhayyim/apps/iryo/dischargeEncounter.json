{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.iryo.dischargeEncounter",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Discharge an encounter: transitions status open→closed, releases the bed, computes lengthOfStayDays, and drafts a DRG claim from the supplied diagnosis codes (claim status=draft, finalized via submitDrgClaim).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["encounterId", "principalDiagnosisCode", "dischargeDisposition"],
          "properties": {
            "encounterId": {"type": "string"},
            "principalDiagnosisCode": {"type": "string"},
            "secondaryDiagnosisCodes": {"type": "array", "items": {"type": "string"}},
            "drgCode": {"type": "string", "description": "Optional, will be auto-suggested from ICD-10 → DRG mapping when omitted."},
            "dischargeDisposition": {"type": "string", "enum": ["home", "transfer", "deceased", "ama", "rehab", "snf"]}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": {"type": "boolean"},
            "encounterId": {"type": "string"},
            "claimId": {"type": "string"},
            "drgCode": {"type": "string"},
            "lengthOfStayDays": {"type": "integer"},
            "dischargedAtMs": {"type": "integer"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
