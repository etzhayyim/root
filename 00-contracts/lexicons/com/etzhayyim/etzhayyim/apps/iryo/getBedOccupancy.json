{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.iryo.getBedOccupancy",
  "defs": {
    "main": {
      "type": "query",
      "description": "Bed occupancy snapshot from mv_iryo_bed_occupancy_now. Per-ward occupied/total/utilization. Optional dept filter.",
      "parameters": {
        "type": "params",
        "properties": {
          "deptSlug": {"type": "string"}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "snapshotMs", "rows"],
          "properties": {
            "ok": {"type": "boolean"},
            "snapshotMs": {"type": "integer"},
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["wardSlug", "deptSlug", "totalBeds", "occupiedBeds", "utilization"],
                "properties": {
                  "wardSlug": {"type": "string"},
                  "deptSlug": {"type": "string"},
                  "totalBeds": {"type": "integer"},
                  "occupiedBeds": {"type": "integer"},
                  "utilization": {"type": "number"}
                }
              }
            }
          }
        }
      }
    }
  }
}
