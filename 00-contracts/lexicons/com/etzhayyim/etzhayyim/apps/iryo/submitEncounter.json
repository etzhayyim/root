{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.iryo.submitEncounter",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Admit a patient: creates vertex_iryo_encounter (status=open) and assigns an available bed in the requested ward. Returns the encounter id and bed slug. patientDid is opaque hash; no PHI is stored at Tier 1.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["patientDid", "deptSlug", "wardSlug", "admissionType"],
          "properties": {
            "patientDid": {"type": "string", "description": "Opaque hash of patient identity. Phase 1 = synthetic; Phase 2 binds did:plc with PHI in Tier 3."},
            "deptSlug": {"type": "string"},
            "wardSlug": {"type": "string"},
            "admissionType": {"type": "string", "enum": ["emergency", "elective", "transfer", "newborn"]},
            "principalDiagnosisCode": {"type": "string", "description": "ICD-10 code, optional at admission, finalized at discharge."},
            "ageBand": {"type": "string", "description": "5-year age band, e.g. 70-74"},
            "sex": {"type": "string", "enum": ["M", "F", "O", "U"]},
            "severityTier": {"type": "integer", "minimum": 1, "maximum": 4}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": {"type": "boolean"},
            "encounterId": {"type": "string"},
            "bedSlug": {"type": "string"},
            "wardSlug": {"type": "string"},
            "admittedAtMs": {"type": "integer"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
