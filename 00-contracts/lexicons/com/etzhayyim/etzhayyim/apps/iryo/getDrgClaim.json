{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.iryo.getDrgClaim",
  "defs": {
    "main": {
      "type": "query",
      "description": "Fetch one DRG claim by claim_id (content-addressed PK).",
      "parameters": {
        "type": "params",
        "required": ["claimId"],
        "properties": {
          "claimId": {"type": "string"}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": {"type": "boolean"},
            "claim": {
              "type": "object",
              "properties": {
                "claimId": {"type": "string"},
                "encounterId": {"type": "string"},
                "drgCode": {"type": "string"},
                "principalDiagnosisCode": {"type": "string"},
                "secondaryDiagnosisCodesJson": {"type": "string"},
                "specialtyCode": {"type": "string"},
                "lengthOfStayDays": {"type": "integer"},
                "severityTier": {"type": "integer"},
                "packagePoints": {"type": "number"},
                "tariffSystem": {"type": "string"},
                "submittedAtMs": {"type": "integer"},
                "status": {"type": "string"},
                "denialReason": {"type": "string"}
              }
            },
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
