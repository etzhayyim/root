{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.sendaiDrr.recordIndicatorProgress",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Sendai Framework DRR indicator (bridges disaster-response + cyclone-prepo + climate-adaptation-finance + sdg-reporting + extreme-weather-attribution)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "reportId",
            "countryIso3",
            "targetSendai",
            "indicator",
            "reportingYear",
            "reportedAt"
          ],
          "properties": {
            "reportId": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "targetSendai": {
              "type": "string",
              "enum": [
                "A",
                "B",
                "C",
                "D",
                "E",
                "F",
                "G"
              ]
            },
            "indicator": {
              "type": "string",
              "description": "A-1 to G-3 etc"
            },
            "valueNumeric": {
              "type": "number"
            },
            "baselineValue": {
              "type": "number"
            },
            "targetValue2030": {
              "type": "number"
            },
            "reportingYear": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "progressTier": {
              "type": "string",
              "enum": [
                "off_track",
                "partial",
                "on_track"
              ]
            }
          }
        }
      }
    }
  }
}