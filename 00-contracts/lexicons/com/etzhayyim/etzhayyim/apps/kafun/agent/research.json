{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kafun.agent.research",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Run kafun-bokumetsu researcher LangGraph (kafun.research.v1). Returns findings rows authored under did:web:n97ik10n.etzhayyim.com:actor:researcher; CF Worker writes them to vertex_kafun_research.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "description": "biology | policy | medical | tech | economic",
              "enum": ["biology", "policy", "medical", "tech", "economic"]
            },
            "query": {
              "type": "string",
              "description": "Natural-language sub-question scoped to the category."
            }
          },
          "required": ["category", "query"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok":       { "type": "boolean" },
            "count":    { "type": "integer" },
            "findings": { "type": "array", "items": { "type": "unknown" } }
          },
          "required": ["ok", "count", "findings"]
        }
      }
    }
  }
}
