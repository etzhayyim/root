{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.karute.getChartSummary",
  "defs": {
    "main": {
      "type": "query",
      "description": "LLM-generated patient chart timeline summary, derived from public meta only (PHI redacted). Surfaces: active problems count, recent encounters, pending orders, medication count, interaction warnings.",
      "parameters": {
        "type": "params",
        "required": ["patientDid"],
        "properties": {
          "patientDid": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 500, "default": 100, "description": "max timeline rows to consider"}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "summary": {"type": "string", "description": "<200 word clinical narrative (no PHI). Caller may merge with locally-decrypted detail."},
            "stats": {
              "type": "object",
              "properties": {
                "encountersTotal": {"type": "integer"},
                "activeConditions": {"type": "integer"},
                "activeMedications": {"type": "integer"},
                "pendingOrders": {"type": "integer"},
                "interactionFlagsMaxSeverity": {"type": "string"}
              }
            },
            "timeline": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "innerType": {"type": "string"},
                  "rkey": {"type": "string"},
                  "encryptedCid": {"type": "string"},
                  "occurredAt": {"type": "string", "format": "datetime"}
                }
              }
            },
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
