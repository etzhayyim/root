{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.karute.createMedicationRequest",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Issue a prescription. Encrypted-write inner type com.etzhayyim.karute.medicationRequest. Drug-drug interaction + allergy check runs upstream via agent.chat. shouldBlock=true halts the write.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["record", "recipientDids", "publicMeta"],
          "properties": {
            "record": {"type": "unknown"},
            "recipientDids": {"type": "array", "items": {"type": "string"}},
            "publicMeta": {
              "type": "object",
              "required": ["patientDid", "prescriberDid", "status", "authoredOn"],
              "properties": {
                "patientDid": {"type": "string"},
                "encounterDid": {"type": "string"},
                "prescriberDid": {"type": "string"},
                "status": {"type": "string"},
                "rxnormSummary": {"type": "string"},
                "yjCodeSummary": {"type": "string"},
                "authoredOn": {"type": "string", "format": "datetime"}
              }
            },
            "overrideInteractionBlock": {
              "type": "boolean",
              "description": "If true, prescriber explicitly overrides interaction warnings (audited; requires reason)"
            },
            "overrideReason": {"type": "string"}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "rkey": {"type": "string"},
            "encryptedCid": {"type": "string"},
            "interactionFlags": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "severity": {"type": "string"},
                  "mechanism": {"type": "string"},
                  "recommendation": {"type": "string"}
                }
              }
            },
            "blocked": {"type": "boolean"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
