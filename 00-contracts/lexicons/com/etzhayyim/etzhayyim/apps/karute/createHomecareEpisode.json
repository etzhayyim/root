{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.karute.createHomecareEpisode",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Open a 在宅医療 episode for a patient. Encrypted-write inner type com.etzhayyim.karute.homecareEpisode.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["envelopeUri", "encryptedCid", "keyId", "publicMeta"],
          "properties": {
            "envelopeUri": {"type": "string"},
            "encryptedCid": {"type": "string"},
            "keyId": {"type": "string"},
            "keyWraps": {"type": "array", "items": {"type": "ref", "ref": "#keyWrapRef"}},
            "recipientDids": {"type": "array", "items": {"type": "string"}},
            "publicMeta": {
              "type": "object",
              "required": ["patientDid", "managingFacilityDid", "status", "startedAt"],
              "properties": {
                "patientDid": {"type": "string"},
                "managingFacilityDid": {"type": "string"},
                "primaryMdDid": {"type": "string"},
                "primaryNurseDid": {"type": "string"},
                "status": {"type": "string"},
                "careType": {"type": "array", "items": {"type": "string"}},
                "startedAt": {"type": "string", "format": "datetime"},
                "dnar": {"type": "boolean"}
              }
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "rkey": {"type": "string"},
            "encryptedCid": {"type": "string"},
            "episodeDid": {"type": "string"},
            "error": {"type": "string"}
          }
        }
      }
    },
    "keyWrapRef": {
      "type": "object",
      "properties": {
        "recipient": {"type": "string"},
        "uri": {"type": "string"},
        "cid": {"type": "string"}
      }
    }
  }
}
