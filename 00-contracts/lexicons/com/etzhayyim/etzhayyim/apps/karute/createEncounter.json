{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.karute.createEncounter",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create a new Encounter (visit/admission/home-care). Encrypted-write inner type com.etzhayyim.karute.encounter.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["record", "recipientDids", "publicMeta"],
          "properties": {
            "record": {"type": "unknown"},
            "recipientDids": {"type": "array", "items": {"type": "string"}},
            "publicMeta": {
              "type": "object",
              "required": ["patientDid", "occurredAt", "encounterClass"],
              "properties": {
                "patientDid": {"type": "string"},
                "occurredAt": {"type": "string", "format": "datetime"},
                "encounterClass": {"type": "string"},
                "facilityDid": {"type": "string"},
                "department": {"type": "string"}
              }
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "rkey": {"type": "string"},
            "encryptedCid": {"type": "string"},
            "encounterDid": {"type": "string"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
