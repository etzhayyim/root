{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.karute.listTombstones",
  "defs": {
    "main": {
      "type": "query",
      "description": "List tombstones (rekey + redact + sealed) so a consumer can rebuild the 'logical present' view of a patient timeline. Public meta only — tombstones themselves carry no PHI by design.",
      "parameters": {
        "type": "params",
        "properties": {
          "patientDid": {"type": "string"},
          "actorDid": {"type": "string"},
          "tombstoneType": {"type": "string"},
          "reason": {"type": "string"},
          "fromDate": {"type": "string", "format": "datetime"},
          "toDate": {"type": "string", "format": "datetime"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 500, "default": 100},
          "offset": {"type": "integer", "minimum": 0, "default": 0}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "items": {"type": "array", "items": {"type": "ref", "ref": "#tombstoneRow"}}
          }
        }
      }
    },
    "tombstoneRow": {
      "type": "object",
      "properties": {
        "tombstoneCid": {"type": "string"},
        "supersededCid": {"type": "string"},
        "successorCid": {"type": "string"},
        "tombstoneType": {"type": "string"},
        "reason": {"type": "string"},
        "actorDid": {"type": "string"},
        "tombstoneAt": {"type": "string", "format": "datetime"},
        "scope": {"type": "string"}
      }
    }
  }
}
