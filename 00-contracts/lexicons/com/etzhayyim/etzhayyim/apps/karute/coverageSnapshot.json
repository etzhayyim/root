{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.karute.coverageSnapshot",
  "defs": {
    "main": {
      "type": "record",
      "description": "Periodic public coverage statistics for the karute actor (no PHI). Generated by the cron pipeline.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["bucket", "actorName", "nanoid", "nodeCount", "snapshotAt"],
        "properties": {
          "bucket": {"type": "string"},
          "actorName": {"type": "string"},
          "nanoid": {"type": "string"},
          "nodeCount": {"type": "integer"},
          "patientCount": {"type": "integer"},
          "encountersLast24h": {"type": "integer"},
          "activeMedicationsCount": {"type": "integer"},
          "pendingOrdersCount": {"type": "integer"},
          "interactionFlagsLast24h": {"type": "integer"},
          "snapshotAt": {"type": "string", "format": "datetime"}
        }
      }
    }
  }
}
