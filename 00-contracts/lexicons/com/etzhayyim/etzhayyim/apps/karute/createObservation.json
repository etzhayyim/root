{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.karute.createObservation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create a vital sign / lab / imaging Observation. Encrypted-write inner type com.etzhayyim.karute.observation.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["record", "recipientDids", "publicMeta"],
          "properties": {
            "record": {"type": "unknown"},
            "recipientDids": {"type": "array", "items": {"type": "string"}},
            "publicMeta": {
              "type": "object",
              "required": ["patientDid", "loincCode", "occurredAt"],
              "properties": {
                "patientDid": {"type": "string"},
                "encounterDid": {"type": "string"},
                "loincCode": {"type": "string"},
                "category": {"type": "string"},
                "interpretation": {"type": "string"},
                "occurredAt": {"type": "string", "format": "datetime"}
              }
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "rkey": {"type": "string"},
            "encryptedCid": {"type": "string"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
