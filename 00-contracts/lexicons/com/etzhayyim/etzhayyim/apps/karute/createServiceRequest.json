{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.karute.createServiceRequest",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Order a lab / imaging / procedure / counselling. Encrypted-write inner type com.etzhayyim.karute.serviceRequest.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["record", "recipientDids", "publicMeta"],
          "properties": {
            "record": {"type": "unknown"},
            "recipientDids": {"type": "array", "items": {"type": "string"}},
            "publicMeta": {
              "type": "object",
              "required": ["patientDid", "requesterDid", "category", "status"],
              "properties": {
                "patientDid": {"type": "string"},
                "encounterDid": {"type": "string"},
                "requesterDid": {"type": "string"},
                "category": {"type": "string"},
                "status": {"type": "string"},
                "priority": {"type": "string"},
                "scheduledFor": {"type": "string", "format": "datetime"}
              }
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "rkey": {"type": "string"},
            "encryptedCid": {"type": "string"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
