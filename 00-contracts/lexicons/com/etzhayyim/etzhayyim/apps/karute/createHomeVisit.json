{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.karute.createHomeVisit",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a home visit. Encrypted-write inner type com.etzhayyim.karute.homeVisit. The pipeline derives the encounter timestamp from `whenStartedAt` and writes an audit event for the episode.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["envelopeUri", "encryptedCid", "keyId", "publicMeta"],
          "properties": {
            "envelopeUri": {"type": "string"},
            "encryptedCid": {"type": "string"},
            "keyId": {"type": "string"},
            "keyWraps": {"type": "array", "items": {"type": "ref", "ref": "#keyWrapRef"}},
            "recipientDids": {"type": "array", "items": {"type": "string"}},
            "publicMeta": {
              "type": "object",
              "required": ["patientDid", "episodeDid", "visitorDid", "visitType", "occurredAt"],
              "properties": {
                "patientDid": {"type": "string"},
                "episodeDid": {"type": "string"},
                "visitorDid": {"type": "string"},
                "visitType": {"type": "string"},
                "occurredAt": {"type": "string", "format": "datetime"},
                "endedAt": {"type": "string", "format": "datetime"},
                "lengthMinutes": {"type": "integer"},
                "escalationType": {"type": "string"},
                "prefectureCode": {"type": "string"},
                "municipalityCode": {"type": "string"}
              }
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "rkey": {"type": "string"},
            "encryptedCid": {"type": "string"},
            "error": {"type": "string"}
          }
        }
      }
    },
    "keyWrapRef": {
      "type": "object",
      "properties": {
        "recipient": {"type": "string"},
        "uri": {"type": "string"},
        "cid": {"type": "string"}
      }
    }
  }
}
