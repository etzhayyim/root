{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.karute.listObservations",
  "defs": {
    "main": {
      "type": "query",
      "description": "List observations (vitals/labs/imaging findings) for a patient. Returns public meta only — LOINC code, category, interpretation, occurredAt. Numeric values stay inside encrypted envelope.",
      "parameters": {
        "type": "params",
        "required": ["patientDid"],
        "properties": {
          "patientDid": {"type": "string"},
          "encounterDid": {"type": "string"},
          "loincCode": {"type": "string"},
          "category": {"type": "string"},
          "fromDate": {"type": "string", "format": "datetime"},
          "toDate": {"type": "string", "format": "datetime"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 500, "default": 100},
          "offset": {"type": "integer", "minimum": 0, "default": 0}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "rkey": {"type": "string"},
                  "encryptedCid": {"type": "string"},
                  "loincCode": {"type": "string"},
                  "category": {"type": "string"},
                  "interpretation": {"type": "string"},
                  "occurredAt": {"type": "string", "format": "datetime"}
                }
              }
            },
            "offset": {"type": "integer"},
            "limit": {"type": "integer"}
          }
        }
      }
    }
  }
}
