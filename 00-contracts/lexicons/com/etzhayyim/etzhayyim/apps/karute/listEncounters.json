{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.karute.listEncounters",
  "defs": {
    "main": {
      "type": "query",
      "description": "List encounters for a patient. Returns public meta only; ciphertext fetched via getEncounter.",
      "parameters": {
        "type": "params",
        "required": ["patientDid"],
        "properties": {
          "patientDid": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 200, "default": 50},
          "offset": {"type": "integer", "minimum": 0, "default": 0},
          "fromDate": {"type": "string", "format": "datetime"},
          "toDate": {"type": "string", "format": "datetime"}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "rkey": {"type": "string"},
                  "encounterDid": {"type": "string"},
                  "encryptedCid": {"type": "string"},
                  "occurredAt": {"type": "string", "format": "datetime"},
                  "endedAt": {"type": "string", "format": "datetime"},
                  "encounterClass": {"type": "string"},
                  "department": {"type": "string"},
                  "facilityDid": {"type": "string"},
                  "attendingDids": {"type": "array", "items": {"type": "string"}}
                }
              }
            },
            "offset": {"type": "integer"},
            "limit": {"type": "integer"}
          }
        }
      }
    }
  }
}
