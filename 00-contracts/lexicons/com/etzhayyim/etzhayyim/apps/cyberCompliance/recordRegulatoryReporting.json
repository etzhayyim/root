{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.cyberCompliance.recordRegulatoryReporting",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Regulatory filing (NIS2/SEC/IMO)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "filingId",
            "regulator",
            "filingType",
            "filedAt"
          ],
          "properties": {
            "filingId": {
              "type": "string"
            },
            "regulator": {
              "type": "string",
              "enum": [
                "eu-nis2",
                "us-sec-cyber-rule",
                "imo-msc-fal1",
                "jpn-picn",
                "au-oaic",
                "uk-ico",
                "kr-pipc",
                "cn-cac"
              ]
            },
            "filerLei": {
              "type": "string"
            },
            "incidentVid": {
              "type": "string"
            },
            "filingType": {
              "type": "string",
              "enum": [
                "initial-notification",
                "interim-update",
                "final-report",
                "annual-register"
              ]
            },
            "deadlineHours": {
              "type": "integer",
              "description": "regulatory deadline (e.g. NIS2=24h, SEC=96h / 4 days)"
            },
            "filedWithinDeadline": {
              "type": "boolean"
            },
            "filedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "timelinessTier": {
              "type": "string",
              "enum": [
                "on-time",
                "late",
                "significantly-late",
                "non-reported"
              ]
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
