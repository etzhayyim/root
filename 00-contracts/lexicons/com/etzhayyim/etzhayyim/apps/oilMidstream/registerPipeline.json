{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.oilMidstream.registerPipeline",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a midstream pipeline / storage terminal. Path-based DID: did:web:oil-midstream.etzhayyim.com:pipeline:{slug} or :storage:{slug}. Tracks chokepoint exposure.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["assetType", "name"],
          "properties": {
            "assetType": { "type": "string", "enum": ["pipeline-crude", "pipeline-product", "pipeline-gas", "storage-crude", "storage-product", "lng-terminal", "marine-terminal"] },
            "name": { "type": "string" },
            "operatorDid": { "type": "string", "format": "did" },
            "originCountry": { "type": "string" },
            "destinationCountry": { "type": "string" },
            "lengthKm": { "type": "number" },
            "capacityBopd": { "type": "number" },
            "storageCapacityMmbbl": { "type": "number" },
            "chokepointExposure": { "type": "array", "items": { "type": "string", "enum": ["hormuz", "malacca", "bab-el-mandeb", "suez", "panama", "bosphorus", "danish-straits"] } }
          }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "uri": { "type": "string", "format": "at-uri" } } } }
    }
  }
}
