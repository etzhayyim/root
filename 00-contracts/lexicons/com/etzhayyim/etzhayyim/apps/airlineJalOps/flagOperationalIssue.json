{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airlineJalOps.flagOperationalIssue",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "JAL operational issue / aircraft swap / safety event (bridges aviation-safety + airplane-incident + airplane-flight)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "scheduleVid",
            "issueKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "scheduleVid": {
              "type": "string",
              "description": "bridges recordFlightSchedule"
            },
            "issueKind": {
              "type": "string",
              "enum": [
                "aircraft_swap",
                "crew_shortage",
                "ata_delay",
                "weather_div",
                "atc_constraint",
                "etops_loss",
                "fuel_anomaly",
                "cabin_safety_event",
                "runway_incursion",
                "bird_strike",
                "tailstrike",
                "cracked_windshield",
                "engine_replacement",
                "hard_landing",
                "skipped_segment",
                "cancellation_cascade"
              ]
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "incident",
                "serious",
                "accident_2018_canon",
                "report_published",
                "investigation_open",
                "investigation_closed"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}