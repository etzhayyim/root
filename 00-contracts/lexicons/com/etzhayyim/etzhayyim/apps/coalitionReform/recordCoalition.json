{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.coalitionReform.recordCoalition",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Bipartisan ethics / governance reform coalition (bridges stockActAmendment.flagStallPattern + judicialInfluence + ethicsDisclosure)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "coalitionId",
            "jurisdiction",
            "coalitionKind",
            "subject",
            "formedAt"
          ],
          "properties": {
            "coalitionId": {
              "type": "string"
            },
            "jurisdiction": {
              "type": "string",
              "enum": [
                "us_congress",
                "eu_parliament",
                "uk_parliament",
                "canada_parliament",
                "australian_parliament",
                "japan_diet",
                "brazil_congress",
                "india_parliament",
                "state_legislature"
              ]
            },
            "coalitionKind": {
              "type": "string",
              "enum": [
                "bipartisan",
                "cross_party",
                "issue_specific",
                "back_bench",
                "constituent_driven",
                "advocacy_led",
                "media_exposure",
                "caucus_task_force",
                "commission_royal",
                "cso_led"
              ]
            },
            "subject": {
              "type": "string",
              "enum": [
                "stock_act",
                "election_law",
                "campaign_finance",
                "lobbying",
                "judicial_ethics",
                "post_emp_cooling",
                "whistleblower_protect",
                "pension_rules",
                "redistricting",
                "ai_disclosure_ban",
                "crypto_officials"
              ]
            },
            "stallVid": {
              "type": "string",
              "description": "bridges stockActAmendment.flagStallPattern"
            },
            "formedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}