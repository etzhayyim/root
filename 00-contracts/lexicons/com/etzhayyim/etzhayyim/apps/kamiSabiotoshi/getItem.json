{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kamiSabiotoshi.getItem",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a sabiotoshi game item by DID.",
      "x-bootstrap": true,
      "parameters": { "type": "params", "required": ["did"], "properties": { "did": { "type": "string", "format": "did" } } },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "name": { "type": "string" }, "nameLocal": { "type": "string" }, "category": { "type": "string" }, "rarity": { "type": "string" }, "gameTitleDid": { "type": "string", "format": "did" }, "stackable": { "type": "boolean" }, "tradable": { "type": "boolean" }, "imageUri": { "type": "string", "format": "uri" }, "stats": { "type": "object", "additionalProperties": { "type": "number" } } } } }
    }
  }
}
