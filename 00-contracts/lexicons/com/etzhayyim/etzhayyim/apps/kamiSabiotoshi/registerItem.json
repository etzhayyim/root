{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kamiSabiotoshi.registerItem",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a game item in the sabiotoshi catalog (KAMI canvas item collector). Path-based DID: did:web:kami.etzhayyim.com:item:{slug}.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["name", "category"],
          "properties": {
            "name": { "type": "string" },
            "nameLocal": { "type": "string" },
            "category": { "type": "string", "enum": ["weapon", "armor", "consumable", "material", "key-item", "cosmetic", "mount", "currency"] },
            "rarity": { "type": "string", "enum": ["common", "uncommon", "rare", "epic", "legendary", "mythic"] },
            "gameTitleDid": { "type": "string", "format": "did", "description": "media-gamers title DID" },
            "stackable": { "type": "boolean", "default": false },
            "tradable": { "type": "boolean", "default": true },
            "imageUri": { "type": "string", "format": "uri" },
            "stats": { "type": "object", "additionalProperties": { "type": "number" } }
          }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "uri": { "type": "string", "format": "at-uri" } } } }
    }
  }
}
