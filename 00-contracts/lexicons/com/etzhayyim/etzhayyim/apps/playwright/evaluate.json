{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.playwright.evaluate",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Evaluate allowlisted JS in page context. Allowed APIs: document.querySelector*, .textContent, window.location.*.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sessionId", "jsCode"],
          "properties": {
            "sessionId": { "type": "string" },
            "jsCode": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "value": { "type": "unknown" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
