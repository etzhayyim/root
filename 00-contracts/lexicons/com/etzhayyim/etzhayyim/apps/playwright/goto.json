{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.playwright.goto",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Navigate to a URL.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sessionId", "url"],
          "properties": {
            "sessionId": { "type": "string" },
            "url": { "type": "string" },
            "waitUntil": { "type": "string", "enum": ["load", "domcontentloaded", "networkidle"], "default": "domcontentloaded" },
            "timeout": { "type": "integer", "default": 30000, "maximum": 120000 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "status": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
