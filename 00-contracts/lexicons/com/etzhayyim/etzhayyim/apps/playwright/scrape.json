{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.playwright.scrape",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Scrape text (or attribute) from a selector. parse controls post-processing.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sessionId", "selector"],
          "properties": {
            "sessionId": { "type": "string" },
            "selector": { "type": "string" },
            "parse": { "type": "string", "description": "'text' | 'jpy' | 'number' | 'attr:<name>'", "default": "text" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "raw": { "type": "string" },
            "value": { "type": "unknown" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
