{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.playwright.dequeueAction",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Daemon long-poll: atomically claim one pending action for a local session.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["daemonId"],
          "properties": { "daemonId": { "type": "string" } }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "action": { "type": "unknown" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
