{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.playwright.reportActionResult",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Daemon reports action outcome (ok|failed). Never includes credential material.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["actionId", "outcome"],
          "properties": {
            "actionId": { "type": "string" },
            "outcome": { "type": "string", "enum": ["ok", "failed"] },
            "result": { "type": "unknown" },
            "error": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "actionId": { "type": "string" },
            "outcome": { "type": "string" },
            "accepted": { "type": "boolean" }
          }
        }
      }
    }
  }
}
