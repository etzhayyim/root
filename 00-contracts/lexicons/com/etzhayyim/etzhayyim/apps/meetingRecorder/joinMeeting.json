{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.meetingRecorder.joinMeeting",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Dispatch a recorder bot to join a meeting on the specified provider and begin capturing audio/video. Requires a consent JWT signed by the on-behalf-of user (lxm=com.etzhayyim.apps.meetingRecorder.joinMeeting).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["provider", "joinTarget", "onBehalfOfDid", "consentToken"],
          "properties": {
            "provider": {
              "type": "string",
              "enum": ["teams", "meet", "zoom"]
            },
            "joinTarget": {
              "type": "object",
              "description": "Provider-specific join payload. Teams: {joinUrl}. Meet: {meetingCode} or {meetingUrl}. Zoom: {meetingId, passcode?}.",
              "properties": {
                "joinUrl": {"type": "string"},
                "meetingCode": {"type": "string"},
                "meetingUrl": {"type": "string"},
                "meetingId": {"type": "string"},
                "passcode": {"type": "string"}
              }
            },
            "onBehalfOfDid": {
              "type": "string",
              "description": "DID of the user the recorder is acting on behalf of."
            },
            "consentToken": {
              "type": "string",
              "description": "ES256 JWT signed by onBehalfOfDid. Claims: iss, sub, aud=did:web:meeting-recorder.etzhayyim.com, lxm=com.etzhayyim.apps.meetingRecorder.joinMeeting, meetingRef, audio (bool), video (bool), purpose, exp."
            },
            "recordAudio": {"type": "boolean", "default": true},
            "recordVideo": {"type": "boolean", "default": true},
            "transcribe": {"type": "boolean", "default": true},
            "chunkSeconds": {"type": "integer", "minimum": 15, "maximum": 300, "default": 60},
            "displayName": {
              "type": "string",
              "description": "Bot display name shown inside the meeting (e.g. 'etzhayyim Recorder (jun)')."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sessionDid", "sessionId", "provider", "status"],
          "properties": {
            "sessionDid": {"type": "string"},
            "sessionId": {"type": "string"},
            "provider": {"type": "string"},
            "status": {"type": "string", "enum": ["joining", "joined", "rejected", "failed"]},
            "startedAt": {"type": "string"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
