{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.meetingRecorder.getTranscript",
  "defs": {
    "main": {
      "type": "query",
      "description": "Fetch transcript segments for a session. Segment text is stored with field-level Signal encryption (`signal:v1:` prefix per 10-protocol/wproto signal). Caller must decrypt client-side with their X25519 identity; server never returns plaintext.",
      "parameters": {
        "type": "params",
        "required": ["sessionId"],
        "properties": {
          "sessionId": {"type": "string"},
          "since": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 200},
          "cursor": {"type": "string"}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sessionId", "segments"],
          "properties": {
            "sessionId": {"type": "string"},
            "segments": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["seq", "startedAtMs", "endedAtMs", "textCipher"],
                "properties": {
                  "seq": {"type": "integer"},
                  "startedAtMs": {"type": "integer"},
                  "endedAtMs": {"type": "integer"},
                  "speakerHash": {"type": "string"},
                  "lang": {"type": "string"},
                  "confidence": {"type": "number"},
                  "textCipher": {
                    "type": "string",
                    "description": "`signal:v1:{ciphertext}` — E2E encrypted to session participants' X25519 identity keys. Empty string if transcription disabled."
                  }
                }
              }
            },
            "cursor": {"type": "string"},
            "limit": {"type": "integer"}
          }
        }
      }
    }
  }
}
