{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.arb.scoreProposal",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Score an existing arbitrage proposal via judge actor (Murakumo MLX). Writes vertex_arb_score row.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["proposalId"],
          "properties": {
            "proposalId": { "type": "string" },
            "model":      { "type": "string", "description": "optional override; default = MURAKUMO_DEFAULT_MODEL" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "score":     { "type": "number" },
            "riskNotes": { "type": "string" },
            "model":     { "type": "string" }
          }
        }
      }
    }
  }
}
