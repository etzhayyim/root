{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.arb.detectSpread",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Scan recent vertex_arb_quote rows for one assetClass and emit candidate spread legs (legA, legB, spread_bps). Stateless — caller persists via proposeTrade.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["assetClass"],
          "properties": {
            "assetClass": { "type": "string", "enum": ["eq", "fut", "fx", "com", "re", "cr"] },
            "lookbackMin": { "type": "integer", "default": 15, "minimum": 1, "maximum": 1440 },
            "minSpreadBps": { "type": "integer", "default": 20 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "legA":      { "type": "string" },
                  "legB":      { "type": "string" },
                  "spreadBps": { "type": "integer" },
                  "edgeBps":   { "type": "integer" },
                  "rationale": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
