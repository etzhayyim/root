{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.cryptoDerivatives.registerVenue",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Crypto derivative exchange / CCP (CFTC DCM / SFC ATS / FCA / MAS / ESMA MiCAR — bridges mica-crypto + fatf-travel-rule + psd3-open-finance + merger-review)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "venueId",
            "regime",
            "productKinds",
            "registeredAt"
          ],
          "properties": {
            "venueId": {
              "type": "string"
            },
            "operatorLei": {
              "type": "string"
            },
            "regime": {
              "type": "string",
              "enum": [
                "cftc_dcm",
                "sec_regulated",
                "sfc_ats",
                "fca",
                "mas",
                "bafin",
                "jfsa",
                "esma_micar",
                "hk_vasp",
                "abu_dhabi_fsra"
              ]
            },
            "productKinds": {
              "type": "string",
              "description": "comma: perp,futures,options,swaps,structured,etf,spot"
            },
            "ccpTier": {
              "type": "string",
              "enum": [
                "none",
                "recognised",
                "qualified_ccp",
                "third_country"
              ]
            },
            "registeredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}