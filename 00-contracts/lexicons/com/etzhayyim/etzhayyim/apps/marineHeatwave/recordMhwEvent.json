{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.marineHeatwave.recordMhwEvent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Marine heatwave event (Hobday category / NOAA CRW / BOM / Copernicus — bridges coralReefBleaching.flagMortalityRisk + ocean-acidification + fisheries-iuu)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "eventId",
            "regionName",
            "hobdayCategory",
            "detectedAt"
          ],
          "properties": {
            "eventId": {
              "type": "string"
            },
            "regionName": {
              "type": "string"
            },
            "latCenter": {
              "type": "number"
            },
            "lonCenter": {
              "type": "number"
            },
            "hobdayCategory": {
              "type": "string",
              "enum": [
                "cat_i_moderate",
                "cat_ii_strong",
                "cat_iii_severe",
                "cat_iv_extreme",
                "cat_v_unprecedented"
              ]
            },
            "durationDays": {
              "type": "integer"
            },
            "peakIntensityC": {
              "type": "number"
            },
            "coralBleachingVid": {
              "type": "string",
              "description": "bridges coralReefBleaching.flagMortalityRisk"
            },
            "detectedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}