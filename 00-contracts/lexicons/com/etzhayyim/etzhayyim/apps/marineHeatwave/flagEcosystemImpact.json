{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.marineHeatwave.flagEcosystemImpact",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Fishery collapse / seabird mortality / HAB bloom cascade (bridges coralReefBleaching.flagMortalityRisk + fisheries-iuu + biodiversity-gbf)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "impactId",
            "eventVid",
            "impactKind",
            "reportedAt"
          ],
          "properties": {
            "impactId": {
              "type": "string"
            },
            "eventVid": {
              "type": "string",
              "description": "bridges recordMhwEvent"
            },
            "impactKind": {
              "type": "string",
              "enum": [
                "coral_bleaching",
                "kelp_collapse",
                "fishery_closure",
                "harmful_algal_bloom",
                "seabird_die_off",
                "whale_stranding",
                "cephalopod_range_shift",
                "shellfish_mortality"
              ]
            },
            "biomassLossPct": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "moderate",
                "significant",
                "catastrophic"
              ]
            }
          }
        }
      }
    }
  }
}