{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.orbitalDebris.logBreakup",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Break-up / fragmentation event (bridges space-traffic conjunctions)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "breakupId",
            "parentObjectVid",
            "occurredAt"
          ],
          "properties": {
            "breakupId": {
              "type": "string"
            },
            "parentObjectVid": {
              "type": "string",
              "description": "bridges open-space-traffic"
            },
            "fragmentCount": {
              "type": "integer"
            },
            "causeClass": {
              "type": "string",
              "enum": [
                "collision",
                "propulsion_failure",
                "deliberate_asat",
                "battery_breach",
                "aerodynamic",
                "unknown"
              ]
            },
            "apogeeKmAtBreakup": {
              "type": "number"
            },
            "occurredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "kesslerContributionTier": {
              "type": "string",
              "enum": [
                "minor",
                "significant",
                "severe"
              ]
            }
          }
        }
      }
    }
  }
}