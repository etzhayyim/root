{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.digitalEuroBrics.recordCorridor",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Cross-border CBDC corridor (digital euro / BRICS Pay / mBridge — bridges cbdc + fatf-travel-rule + instant-payments + sovereign-debt)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "corridorId",
            "senderCountryIso3",
            "receiverCountryIso3",
            "scheme",
            "launchedAt"
          ],
          "properties": {
            "corridorId": {
              "type": "string"
            },
            "senderCountryIso3": {
              "type": "string"
            },
            "receiverCountryIso3": {
              "type": "string"
            },
            "scheme": {
              "type": "string",
              "enum": [
                "digital_euro",
                "brics_pay",
                "mbridge",
                "agora",
                "sibos_jade",
                "pix_pace"
              ]
            },
            "bridgeProtocol": {
              "type": "string",
              "enum": [
                "iso_20022_enhanced",
                "cbdc_native",
                "hashed_tlock",
                "atomic_swap"
              ]
            },
            "settlementTimeSec": {
              "type": "number"
            },
            "launchedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}