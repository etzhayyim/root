{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.trustedFlagger.flagAbuseConcern",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Trusted flagger abuse / over-flagging / cross-border (bridges dsaVlop.flagSystemicRisk + transnational-repression + press-freedom)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "designationVid",
            "concernKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "designationVid": {
              "type": "string",
              "description": "bridges recordDesignation"
            },
            "concernKind": {
              "type": "string",
              "enum": [
                "over_flagging",
                "political_target",
                "frivolous",
                "cross_border_overreach",
                "quality_control_gap",
                "pattern_of_misuse",
                "appeal_disregard",
                "government_capture",
                "industry_capture",
                "spec_state_targeting",
                "data_protection_breach"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}