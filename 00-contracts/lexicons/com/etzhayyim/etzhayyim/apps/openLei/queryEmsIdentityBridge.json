{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openLei.queryEmsIdentityBridge",
  "defs": {
    "main": {
      "type": "query",
      "description": "Query the LEI-backed robotics EMS supplier identity bridge for supplier shortlist and RFQ review.",
      "parameters": {
        "type": "params",
        "properties": {
          "lei": { "type": "string" },
          "country": { "type": "string" },
          "emsCompanyId": { "type": "string" },
          "minMatchScore": { "type": "number" },
          "shortlistedOnly": { "type": "boolean" },
          "limit": { "type": "integer" },
          "dryRun": { "type": "boolean" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "dryRun": { "type": "boolean" },
            "queryPlan": { "type": "unknown" },
            "rows": { "type": "array" },
            "rowCount": { "type": "integer" }
          }
        }
      }
    }
  }
}
