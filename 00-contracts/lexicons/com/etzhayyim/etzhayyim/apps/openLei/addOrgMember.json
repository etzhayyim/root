{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openLei.addOrgMember",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Associate a person (natural or system) with an org unit at a given role.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["orgUnitVid", "personDid", "role"],
          "properties": {
            "orgUnitVid":  { "type": "string" },
            "personDid":   { "type": "string", "description": "DID of the person or system actor." },
            "role":        { "type": "string", "description": "E.g. member, lead, chair, secretary, observer." },
            "since":       { "type": "string", "format": "date" },
            "until":       { "type": "string", "format": "date" },
            "confidence":  { "type": "number", "description": "0..1, default 1.0" },
            "dryRun":      { "type": "boolean", "default": false }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok":      { "type": "boolean" },
            "edgeId":  { "type": "string" },
            "dryRun":  { "type": "boolean" },
            "error":   { "type": "string" }
          }
        }
      }
    }
  }
}
