{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openLei.collectGleifGlobal",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Plan and run a AgentGateway MCP/LangServer GLEIF global LEI collection for Level 1 LEI-CDF, Level 2 RR-CDF, and reporting exceptions.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "requestId": { "type": "string" },
            "asOfDate": { "type": "string" },
            "mode": { "type": "string", "enum": ["delta", "backfill", "repair", "verify"] },
            "datasets": { "type": "array", "items": { "type": "string" } },
            "datasetKind": { "type": "string" },
            "shard": { "type": "integer" },
            "shardCount": { "type": "integer" },
            "limit": { "type": "integer" },
            "countries": { "type": "array", "items": { "type": "string" } },
            "keywords": { "type": "array", "items": { "type": "string" } },
            "records": { "type": "array" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "openLeiGleifManifestPlan": { "type": "unknown" },
            "openLeiGleifBulkCollect": { "type": "unknown" },
            "openLeiGleifRecordNormalize": { "type": "unknown" },
            "openLeiGleifEmsMatch": { "type": "unknown" },
            "finalStatus": { "type": "string" }
          }
        }
      }
    }
  }
}
