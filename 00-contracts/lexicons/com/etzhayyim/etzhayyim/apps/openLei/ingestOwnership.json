{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openLei.ingestOwnership",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Ingest GLEIF Level 2 (RR-CDF) ownership relationship records into vertex_open_lei_ownership and edge_open_lei_ownership_pair. Triggered from openLei.gleif.record.normalize output or called directly with ownershipRows.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ownershipRows":           { "type": "array", "description": "Raw GLEIF rr-cdf records or flat {parentLei,childLei,...} objects." },
            "openLeiGleifRecordNormalize": { "type": "object", "description": "Upstream normalize step output; ownershipRows extracted automatically." },
            "batchSize":               { "type": "integer", "default": 500 },
            "dryRun":                  { "type": "boolean", "default": false }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["openLeiOwnershipIngest"],
          "properties": {
            "openLeiOwnershipIngest": {
              "type": "object",
              "properties": {
                "ingestId":           { "type": "string" },
                "recordsRead":        { "type": "integer" },
                "recordsNormalized":  { "type": "integer" },
                "inserted":           { "type": "integer" },
                "skipped":            { "type": "integer" },
                "dryRun":             { "type": "boolean" },
                "errors":             { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
