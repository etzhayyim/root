{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.amrSurveillance.flagOneHealthSignal",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "One Health AMR signal linking human/animal/env (WOAH + FAO + UNEP)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "signalId",
            "patternVid",
            "sectorsInvolved",
            "flaggedAt"
          ],
          "properties": {
            "signalId": {
              "type": "string"
            },
            "patternVid": {
              "type": "string",
              "description": "bridges reportResistancePattern"
            },
            "sectorsInvolved": {
              "type": "string",
              "description": "comma: human,animal,food,water,soil,wildlife"
            },
            "foodSecurityVid": {
              "type": "string",
              "description": "bridges open-agri-food-security"
            },
            "waterBasinVid": {
              "type": "string",
              "description": "bridges open-water-scarcity"
            },
            "flaggedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}