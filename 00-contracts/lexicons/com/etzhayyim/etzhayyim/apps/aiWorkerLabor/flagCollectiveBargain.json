{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.aiWorkerLabor.flagCollectiveBargain",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Collective bargaining / AI clause / strike (bridges gig-worker + migrant-worker-welfare + antitrust-dma)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "actionId",
            "actionKind",
            "concludedAt"
          ],
          "properties": {
            "actionId": {
              "type": "string"
            },
            "studyVid": {
              "type": "string",
              "description": "bridges recordDisplacementStudy"
            },
            "unionLei": {
              "type": "string"
            },
            "employerLei": {
              "type": "string"
            },
            "actionKind": {
              "type": "string",
              "enum": [
                "cba_ai_clause",
                "strike",
                "walkout",
                "works_council",
                "industry_framework",
                "national_dialogue"
              ]
            },
            "aiProvisions": {
              "type": "string",
              "description": "comma: consultation,training_fund,severance,data_rights,surveillance_limit,opt_out,right_to_human_review"
            },
            "workersCovered": {
              "type": "integer"
            },
            "concludedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}