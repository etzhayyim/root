{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kigaliHfc.recordHfcPhasedown",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Kigali HFC phasedown schedule (Montreal Protocol — bridges climate-carbon-market + chemicals-management + hydrogen-economy)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "reportId",
            "partyIso3",
            "groupA1OrA2OrA3",
            "currentCo2eTonnes",
            "phasedownStepYear",
            "reportingYear",
            "submittedAt"
          ],
          "properties": {
            "reportId": {
              "type": "string"
            },
            "partyIso3": {
              "type": "string"
            },
            "groupA1OrA2OrA3": {
              "type": "string",
              "enum": [
                "A1",
                "A2",
                "A3",
                "developed"
              ]
            },
            "baselineCo2eTonnes": {
              "type": "number"
            },
            "currentCo2eTonnes": {
              "type": "number"
            },
            "freezeYear": {
              "type": "integer"
            },
            "phasedownStepYear": {
              "type": "integer"
            },
            "reductionFromBaselinePct": {
              "type": "number"
            },
            "reportingYear": {
              "type": "integer"
            },
            "submittedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}