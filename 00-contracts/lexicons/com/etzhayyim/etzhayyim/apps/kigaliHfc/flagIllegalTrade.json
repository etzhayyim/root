{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kigaliHfc.flagIllegalTrade",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Illegal HFC / ODS trade (bridges customs-clearance + chemicals-management + ofac-sanctions)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "tradeId",
            "originIso3",
            "destinationIso3",
            "chemicalCode",
            "detectedAt"
          ],
          "properties": {
            "tradeId": {
              "type": "string"
            },
            "originIso3": {
              "type": "string"
            },
            "destinationIso3": {
              "type": "string"
            },
            "chemicalCode": {
              "type": "string",
              "description": "HFC-134a / R-410A / HCFC-22 / etc"
            },
            "tonnesSeized": {
              "type": "number"
            },
            "seizureAuthority": {
              "type": "string"
            },
            "detectedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "minor",
                "moderate",
                "major"
              ]
            }
          }
        }
      }
    }
  }
}