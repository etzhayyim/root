{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.micaLicense.recordAuthorization",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "MiCA CASP / EMT / ART authorization (bridges stablecoinRun.flagReserveOpacity + mica-crypto + dpa-authority)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "authId",
            "serviceKind",
            "memberStateIso3",
            "homeCompetentAuth",
            "authorizedAt"
          ],
          "properties": {
            "authId": {
              "type": "string"
            },
            "issuerLei": {
              "type": "string"
            },
            "serviceKind": {
              "type": "string",
              "enum": [
                "casp_custody",
                "casp_exchange",
                "casp_oft",
                "emt_issuance",
                "art_issuance",
                "portfolio_mgmt",
                "advice",
                "transfer",
                "onchain_op",
                "white_label",
                "trading_platform",
                "passport_in_out"
              ]
            },
            "memberStateIso3": {
              "type": "string"
            },
            "homeCompetentAuth": {
              "type": "string",
              "enum": [
                "bafin_de",
                "cssf_lu",
                "fcmc_lv",
                "acpr_fr",
                "cmvm_pt",
                "consob_it",
                "gfsc_gi",
                "cnmv_es",
                "cssi_lu",
                "fma_at",
                "fma_li"
              ]
            },
            "reserveOpacityVid": {
              "type": "string",
              "description": "bridges stablecoinRun.flagReserveOpacity"
            },
            "authorizedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}