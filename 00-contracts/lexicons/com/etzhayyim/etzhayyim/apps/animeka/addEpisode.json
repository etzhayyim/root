{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.animeka.addEpisode",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create an episode record (com.etzhayyim.apps.animeka.episode) and bootstrap its project (convoId). The episode inherits work.fps unless overridden. Emits social announcement via derive rule on status transition.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["workId", "episodeNum", "titleJP"],
          "properties": {
            "workId": { "type": "string", "format": "at-uri", "description": "AT URI of parent work." },
            "id": { "type": "string", "description": "Optional rkey." },
            "episodeNum": { "type": "integer" },
            "titleJP": { "type": "string" },
            "titleEN": { "type": "string" },
            "durationSec": { "type": "integer" },
            "fps": { "type": "integer" },
            "airDate": { "type": "string", "format": "datetime" },
            "thumbCid": { "type": "string", "format": "cid" },
            "teamDids": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "cid", "convoId"],
          "properties": {
            "uri": { "type": "string", "format": "at-uri" },
            "cid": { "type": "string", "format": "cid" },
            "convoId": { "type": "string" }
          }
        }
      }
    }
  }
}
