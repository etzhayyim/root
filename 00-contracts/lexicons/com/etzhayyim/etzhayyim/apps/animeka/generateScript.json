{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.animeka.generateScript",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Stage 1/12 — Draft an episode script with Claude Sonnet 4.5 (deep tier), structure scenes via Qwen 7B (mid tier), and persist a script row. Backed by BPMN animeka_generate_script (ADR-2604231328).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["episodeId", "episodeTitle", "synopsis"],
          "properties": {
            "episodeId": { "type": "string" },
            "episodeTitle": { "type": "string" },
            "synopsis": { "type": "string" },
            "targetSceneCount": { "type": "integer", "default": 10 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "scriptVertexId": { "type": "string" },
            "draftModel": { "type": "string" },
            "inserted": { "type": "integer" }
          }
        }
      }
    }
  }
}
