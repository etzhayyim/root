{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.animeka.listCuts",
  "defs": {
    "main": {
      "type": "query",
      "description": "List cuts. Powers the Pipeline Board (episode-scoped) and the flat Cuts browser (cross-episode when only workId is given).",
      "parameters": {
        "type": "params",
        "properties": {
          "episodeId": { "type": "string" },
          "workId": { "type": "string" },
          "sceneId": { "type": "string" },
          "stage": {
            "type": "string",
            "enum": ["script", "storyboard", "layout", "keyAnim", "inbetween", "colorDesign", "finish", "background", "composite", "edit", "sound", "delivery"]
          },
          "stageStatus": {
            "type": "string",
            "enum": ["none", "pending", "in_progress", "review", "approved", "retake"]
          },
          "priority": {
            "type": "string",
            "enum": ["low", "normal", "high", "retake"]
          },
          "assigneeDid": { "type": "string" },
          "limit": { "type": "integer" },
          "offset": { "type": "integer" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items", "total"],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "uri": { "type": "string", "format": "at-uri" },
                  "cutNum": { "type": "integer" },
                  "sceneNum": { "type": "integer" },
                  "durationFrames": { "type": "integer" },
                  "fps": { "type": "integer" },
                  "priority": { "type": "string" },
                  "dialogueSummary": { "type": "string" },
                  "stageStatus": { "type": "object", "description": "Map of 12 stages to status." },
                  "assignees": { "type": "object" },
                  "thumbCid": { "type": "string", "format": "cid" }
                }
              }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
