{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.animeka.character",
  "defs": {
    "main": {
      "type": "record",
      "description": "Tier 2 domain record for a character design (キャラデザ). Each character gets a path-based DID `did:web:animeka.etzhayyim.com:character:{slug}` used as the mention facet target in social posts. Holds the canonical reference sheet + pointers to color models.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["workRef", "slug", "name", "createdAt"],
        "properties": {
          "workRef": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "slug": {
            "type": "string",
            "description": "URL-safe slug. Used for did:web:animeka.etzhayyim.com:character:{slug}."
          },
          "name": {
            "type": "string",
            "description": "Display name (JP primary)."
          },
          "nameEN": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": ["protagonist", "deuteragonist", "supporting", "antagonist", "background", "mob"]
          },
          "refSheetCid": {
            "type": "string",
            "format": "cid",
            "description": "Blob CID of the character reference sheet (front/side/back + expressions)."
          },
          "turnaroundCids": {
            "type": "array",
            "description": "Multi-angle turnaround sheets.",
            "items": { "type": "string", "format": "cid" }
          },
          "expressionsCid": {
            "type": "string",
            "format": "cid"
          },
          "heightCm": {
            "type": "number"
          },
          "description": {
            "type": "string"
          },
          "voiceCast": {
            "type": "string",
            "description": "Voice actor DID or name (public credit — Tier 2 ok; private contract data → Tier 3)."
          },
          "status": {
            "type": "string",
            "enum": ["draft", "review", "approved"]
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
