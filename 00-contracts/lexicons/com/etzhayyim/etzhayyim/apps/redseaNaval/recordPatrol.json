{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.redseaNaval.recordPatrol",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "海軍哨戒記録",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "patrolId",
            "operation",
            "flag",
            "areaCode",
            "startedAt"
          ],
          "properties": {
            "patrolId": {
              "type": "string"
            },
            "operation": {
              "type": "string",
              "enum": [
                "eu-aspides",
                "us-prosperity-guardian",
                "cmf-153",
                "cn-adendan",
                "ind-sankalp",
                "jpn-msdf"
              ]
            },
            "flag": {
              "type": "string"
            },
            "vesselClass": {
              "type": "string"
            },
            "areaCode": {
              "type": "string"
            },
            "startedAt": {
              "type": "string",
              "format": "datetime"
            },
            "endedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
