{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.redseaNaval.recordEscort",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "商船護衛",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "escortId",
            "protectedImo",
            "fromWaypoint",
            "toWaypoint",
            "startedAt"
          ],
          "properties": {
            "escortId": {
              "type": "string"
            },
            "protectedImo": {
              "type": "string"
            },
            "escortPatrolVid": {
              "type": "string"
            },
            "fromWaypoint": {
              "type": "string"
            },
            "toWaypoint": {
              "type": "string"
            },
            "startedAt": {
              "type": "string",
              "format": "datetime"
            },
            "endedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
