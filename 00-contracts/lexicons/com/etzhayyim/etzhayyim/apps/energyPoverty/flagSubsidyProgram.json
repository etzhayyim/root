{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.energyPoverty.flagSubsidyProgram",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Energy subsidy / tariff protection program (bridges cofog + power-grid-interconnect + ocha-funding)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "programId",
            "countryIso3",
            "kind",
            "launchedAt"
          ],
          "properties": {
            "programId": {
              "type": "string"
            },
            "metricVid": {
              "type": "string",
              "description": "bridges recordHouseholdMetric"
            },
            "countryIso3": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "lump_sum",
                "tariff_discount",
                "weatherization",
                "off_grid_subsidy",
                "fuel_voucher",
                "ev_charging",
                "clean_cooking",
                "retrofit_grant"
              ]
            },
            "annualSpendUsd": {
              "type": "number"
            },
            "beneficiaryHouseholds": {
              "type": "integer"
            },
            "launchedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}