{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.migrantWorkerWelfare.flagWageTheft",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Wage theft complaint + resolution (bridges forced-labor + ofac-sanctions)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "complaintId",
            "fundVid",
            "amountOwedUsd",
            "workersAffected",
            "resolutionStatus",
            "reportedAt"
          ],
          "properties": {
            "complaintId": {
              "type": "string"
            },
            "fundVid": {
              "type": "string",
              "description": "bridges recordWelfareFund"
            },
            "employerLei": {
              "type": "string"
            },
            "amountOwedUsd": {
              "type": "number"
            },
            "workersAffected": {
              "type": "integer"
            },
            "resolutionStatus": {
              "type": "string",
              "enum": [
                "reported",
                "mediation",
                "paid_partial",
                "paid_full",
                "unresolved"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "incident",
                "chronic",
                "systemic"
              ]
            }
          }
        }
      }
    }
  }
}