{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.aiGovernance.reportIncident",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "AI incident report (AIAAIC / deepfake attribution / bias / hallucination harm)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "incidentId",
            "incidentType",
            "reporterType",
            "reportedAt"
          ],
          "properties": {
            "incidentId": {
              "type": "string"
            },
            "modelVid": {
              "type": "string",
              "description": "bridges registerModel"
            },
            "incidentType": {
              "type": "string",
              "enum": [
                "deepfake",
                "hallucination_harm",
                "bias_discrimination",
                "privacy_leak",
                "ipr_infringement",
                "autonomy_violation",
                "physical_harm"
              ]
            },
            "reporterType": {
              "type": "string",
              "enum": [
                "self",
                "regulator",
                "journalist",
                "ngo",
                "user"
              ]
            },
            "jurisdictionIso3": {
              "type": "string"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "minor",
                "severe",
                "critical"
              ]
            }
          }
        }
      }
    }
  }
}