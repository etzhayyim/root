{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ftzZones.flagLabourAbuse",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "FTZ labour abuse / wage below minimum / union suppression (bridges cumulationRule.flagExploitation + worker-grievance + ilo-labor-rights)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "zoneVid",
            "abuseKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "zoneVid": {
              "type": "string",
              "description": "bridges recordZone"
            },
            "abuseKind": {
              "type": "string",
              "enum": [
                "below_minimum",
                "union_suppression",
                "overtime_forced",
                "bonded_labour",
                "migrant_worker_exploit",
                "worker_dormitory_abuse",
                "forced_pregnancy_test",
                "occ_safety_gap",
                "no_collective_bargaining",
                "pit_pay",
                "child_labour"
              ]
            },
            "affectedWorkers": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}