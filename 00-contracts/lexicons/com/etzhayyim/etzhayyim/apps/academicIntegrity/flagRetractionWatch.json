{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.academicIntegrity.flagRetractionWatch",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Retraction Watch / PubPeer post-publication concern (bridges oss-vuln + precision-medicine + pharma-supply)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "concernId",
            "publicationDoi",
            "concernKind",
            "reportedAt"
          ],
          "properties": {
            "concernId": {
              "type": "string"
            },
            "caseVid": {
              "type": "string",
              "description": "bridges recordMisconductCase"
            },
            "publicationDoi": {
              "type": "string"
            },
            "journalIssn": {
              "type": "string"
            },
            "concernKind": {
              "type": "string",
              "enum": [
                "duplicate_publication",
                "image_manipulation",
                "statistical_error",
                "undisclosed_conflict",
                "paper_mill",
                "tortured_phrase",
                "self_plagiarism"
              ]
            },
            "citesSincePublication": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "minor",
                "significant",
                "critical"
              ]
            }
          }
        }
      }
    }
  }
}