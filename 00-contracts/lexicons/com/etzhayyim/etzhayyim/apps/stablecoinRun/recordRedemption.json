{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.stablecoinRun.recordRedemption",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Stablecoin redemption run / depeg event (bridges cryptoMixerSanction.flagDelistingChallenge + mica-crypto + stablecoin-reserves)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "eventId",
            "stablecoin",
            "triggerKind",
            "occurredAt"
          ],
          "properties": {
            "eventId": {
              "type": "string"
            },
            "issuerLei": {
              "type": "string"
            },
            "stablecoin": {
              "type": "string",
              "enum": [
                "usdt",
                "usdc",
                "dai",
                "frax",
                "lusd",
                "usdp",
                "gusd",
                "ustc_failed",
                "first_digital",
                "pax_gold",
                "pyusd",
                "crvusd",
                "susd",
                "rai",
                "fei_discontinued"
              ]
            },
            "triggerKind": {
              "type": "string",
              "enum": [
                "bank_failure",
                "sanctions",
                "regulatory",
                "exchange_delisting",
                "collateral_concern",
                "audit_concern",
                "oracle_failure",
                "governance_breakdown",
                "whales_exit",
                "svb_exposure",
                "silvergate_signature",
                "fdic_gap"
              ]
            },
            "sanctionVid": {
              "type": "string",
              "description": "bridges cryptoMixerSanction.flagDelistingChallenge"
            },
            "depegBasisPoints": {
              "type": "number"
            },
            "occurredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}