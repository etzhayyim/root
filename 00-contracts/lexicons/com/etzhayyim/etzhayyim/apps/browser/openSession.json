{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.browser.openSession",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Open a headless browser session for L2 Browser Agent (JS rendering, stealth, darkweb, phishing detection). Backed by CF Browser Rendering / browserless.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["url"],
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "stealthMode": { "type": "boolean", "default": false, "description": "anti-bot fingerprint evasion" },
            "darkwebMode": { "type": "boolean", "default": false, "description": "route via Tor circuit" },
            "userAgent": { "type": "string" },
            "viewport": { "type": "object", "properties": { "width": { "type": "integer" }, "height": { "type": "integer" } } },
            "waitFor": { "type": "string", "enum": ["load", "domcontentloaded", "networkidle0", "networkidle2"], "default": "networkidle2" },
            "timeout": { "type": "integer", "minimum": 1000, "maximum": 60000, "default": 30000 },
            "extractMode": { "type": "string", "enum": ["html", "text", "screenshot", "pdf", "har", "phishing-score"], "default": "html" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sessionId"],
          "properties": {
            "sessionId": { "type": "string" },
            "finalUrl": { "type": "string", "format": "uri" },
            "statusCode": { "type": "integer" },
            "contentBlobCid": { "type": "string", "format": "cid" },
            "phishingScore": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    }
  }
}
