{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.browser.getSession",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a browser session by sessionId.",
      "x-bootstrap": true,
      "parameters": { "type": "params", "required": ["sessionId"], "properties": { "sessionId": { "type": "string" } } },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "sessionId": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "finalUrl": { "type": "string", "format": "uri" }, "statusCode": { "type": "integer" }, "stealthMode": { "type": "boolean" }, "darkwebMode": { "type": "boolean" }, "extractMode": { "type": "string" }, "contentBlobCid": { "type": "string", "format": "cid" }, "phishingScore": { "type": "number", "minimum": 0, "maximum": 1 }, "openedAt": { "type": "string", "format": "datetime" }, "closedAt": { "type": "string", "format": "datetime" } } } }
    }
  }
}
