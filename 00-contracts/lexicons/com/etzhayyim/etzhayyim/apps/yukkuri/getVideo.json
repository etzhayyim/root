{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yukkuri.getVideo",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a yukkuri video with scenes, lines, assets, and the most recent generation event.",
      "parameters": {
        "type": "params",
        "required": ["videoUri"],
        "properties": {
          "videoUri": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["video"],
          "properties": {
            "video": {
              "type": "object",
              "properties": {
                "videoUri": { "type": "string" },
                "projectId": { "type": "string" },
                "title": { "type": "string" },
                "topic": { "type": "string" },
                "status": { "type": "string" },
                "language": { "type": "string" },
                "targetSec": { "type": "integer" },
                "durationSec": { "type": "integer" },
                "resolution": { "type": "string" },
                "fps": { "type": "integer" },
                "blobKey": { "type": "string" },
                "mimeType": { "type": "string" },
                "createdAt": { "type": "string" }
              }
            },
            "scenes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sceneUri": { "type": "string" },
                  "index": { "type": "integer" },
                  "startSec": { "type": "number" },
                  "durationSec": { "type": "number" },
                  "backgroundAssetUri": { "type": "string" },
                  "bgmAssetUri": { "type": "string" }
                }
              }
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "lineUri": { "type": "string" },
                  "sceneUri": { "type": "string" },
                  "index": { "type": "integer" },
                  "speaker": { "type": "string", "enum": ["left", "right", "narrator"] },
                  "text": { "type": "string" },
                  "emotion": { "type": "string" },
                  "voicePreset": { "type": "string" },
                  "voiceBlobKey": { "type": "string" },
                  "durationSec": { "type": "number" }
                }
              }
            },
            "assets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "assetUri": { "type": "string" },
                  "kind": { "type": "string", "enum": ["image", "sfx", "bgm", "character", "timeline", "video"] },
                  "blobKey": { "type": "string" },
                  "mimeType": { "type": "string" },
                  "actorDid": { "type": "string" }
                }
              }
            },
            "lastGeneration": {
              "type": "object",
              "properties": {
                "generationUri": { "type": "string" },
                "stage": { "type": "string" },
                "status": { "type": "string" },
                "createdAt": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
