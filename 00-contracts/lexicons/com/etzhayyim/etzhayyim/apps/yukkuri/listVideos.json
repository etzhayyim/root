{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yukkuri.listVideos",
  "defs": {
    "main": {
      "type": "query",
      "description": "List yukkuri videos with offset/limit pagination. Optional status filter.",
      "parameters": {
        "type": "params",
        "properties": {
          "ownerDid": { "type": "string" },
          "status": { "type": "string", "enum": ["queued", "script", "assembled", "editready", "rendered", "published", "rejected"] },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["videos", "offset", "limit", "total"],
          "properties": {
            "videos": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "videoUri": { "type": "string" },
                  "projectId": { "type": "string" },
                  "title": { "type": "string" },
                  "status": { "type": "string" },
                  "durationSec": { "type": "integer" },
                  "blobKey": { "type": "string" },
                  "createdAt": { "type": "string" }
                }
              }
            },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" },
            "total": { "type": "integer" }
          }
        }
      }
    }
  }
}
