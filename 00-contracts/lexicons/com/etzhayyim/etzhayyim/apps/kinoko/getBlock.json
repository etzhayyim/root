{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kinoko.getBlock",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a specific PoNF block by vertex_id, or the latest finalized block for a network.",
      "parameters": {
        "type": "params",
        "properties": {
          "blockVertexId": { "type": "string", "description": "Block vertex_id (optional — omit to get latest)" },
          "networkRootDid": { "type": "string", "description": "Network root DID (required if blockVertexId omitted)" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "vertexId": { "type": "string" },
            "prevBlockId": { "type": "string" },
            "blockHash": { "type": "string" },
            "totalFlow": { "type": "number" },
            "participantCount": { "type": "integer" },
            "etaMinUsed": { "type": "number" },
            "blockStatus": { "type": "string" },
            "createdAt": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
