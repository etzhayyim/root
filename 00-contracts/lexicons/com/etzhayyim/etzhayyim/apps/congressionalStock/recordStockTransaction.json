{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.congressionalStock.recordStockTransaction",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Member of Congress / senior official stock transaction (STOCK Act / PTRs — bridges insiderTrading.flagFrontRunning + ethics-disclosure + judicial-influence)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "transactionId",
            "memberCategory",
            "transactionKind",
            "filedPtrAt",
            "executedAt"
          ],
          "properties": {
            "transactionId": {
              "type": "string"
            },
            "memberCategory": {
              "type": "string",
              "enum": [
                "sitting_sen",
                "sitting_rep",
                "spouse",
                "dependent_child",
                "senior_staff",
                "cabinet",
                "fed_reserve",
                "justice_scotus",
                "fed_judge",
                "whistleblower_protect"
              ]
            },
            "transactionKind": {
              "type": "string",
              "enum": [
                "buy",
                "sell",
                "exchange",
                "purchase_option",
                "sell_option",
                "convert",
                "margin_call",
                "crypto_purchase",
                "brokerage_consolidate",
                "retirement_rebalance",
                "immediate_family",
                "trust_transaction"
              ]
            },
            "issuerTicker": {
              "type": "string"
            },
            "frontRunningVid": {
              "type": "string",
              "description": "bridges insiderTrading.flagFrontRunning"
            },
            "filedPtrAt": {
              "type": "string",
              "format": "datetime"
            },
            "executedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}