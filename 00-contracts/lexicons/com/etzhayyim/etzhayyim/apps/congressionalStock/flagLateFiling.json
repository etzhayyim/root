{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.congressionalStock.flagLateFiling",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Late PTR filing / 45-day window breach (bridges insiderTrading.flagFrontRunning + ethicsDisclosure + enforcement-action)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "transactionVid",
            "lateKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "transactionVid": {
              "type": "string",
              "description": "bridges recordStockTransaction"
            },
            "lateKind": {
              "type": "string",
              "enum": [
                "past_45_day",
                "past_30_day",
                "undisclosed_spouse",
                "undisclosed_child",
                "grouped_disclosure",
                "rounded_amount",
                "error_amended",
                "no_filing",
                "hearing_day_trade",
                "pattern_repeat",
                "committee_chair_self",
                "markup_trade"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}