{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.carrierEsg.recordGreenBunker",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Green bunker share report",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "reportId",
            "carrierCode",
            "periodQuarter",
            "totalBunkerTonnes",
            "greenShareTotalPct",
            "reportedAt"
          ],
          "properties": {
            "reportId": {
              "type": "string"
            },
            "carrierCode": {
              "type": "string"
            },
            "periodQuarter": {
              "type": "string",
              "description": "YYYY-Qn"
            },
            "totalBunkerTonnes": {
              "type": "number"
            },
            "lngSharePct": {
              "type": "number"
            },
            "methanolSharePct": {
              "type": "number"
            },
            "biofuelSharePct": {
              "type": "number"
            },
            "greenShareTotalPct": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "transitionTier": {
              "type": "string",
              "enum": [
                "laggard",
                "slow-adopter",
                "adopter",
                "leader"
              ]
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
