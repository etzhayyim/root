{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openMachineryMaintenance.flagDowntime",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Flag a machinery downtime event and escalate when safety or production impact rules require it.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["vertexId", "assetId", "downtimeStartedAt", "estimatedMinutes"],
          "properties": {
            "vertexId": { "type": "string" },
            "assetId": { "type": "string" },
            "facilityLei": { "type": "string" },
            "downtimeStartedAt": { "type": "string" },
            "estimatedMinutes": { "type": "integer" },
            "safetyIncident": { "type": "boolean" },
            "productionImpact": { "type": "string" },
            "rootCauseCode": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
