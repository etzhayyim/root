{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openMachineryMaintenance.recordMaintenancePlan",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a machinery maintenance plan with safety lockout and spare-parts readiness checks.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["vertexId", "assetId", "machineClass", "criticality", "maintenanceType", "plannedStart", "plannedEnd"],
          "properties": {
            "vertexId": { "type": "string" },
            "assetId": { "type": "string" },
            "facilityLei": { "type": "string" },
            "machineClass": { "type": "string" },
            "criticality": { "type": "string" },
            "maintenanceType": { "type": "string" },
            "plannedStart": { "type": "string" },
            "plannedEnd": { "type": "string" },
            "safetyLockout": { "type": "boolean" },
            "sparePartsReady": { "type": "boolean" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
