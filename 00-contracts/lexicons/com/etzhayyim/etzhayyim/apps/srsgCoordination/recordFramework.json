{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.srsgCoordination.recordFramework",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "UN Special Adviser on Genocide Prevention / R2P framework (bridges genocideConvention.flagProvisionalMeasure + poc-ihl + minority-rights)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "frameworkId",
            "country",
            "frameworkKind",
            "publishedAt"
          ],
          "properties": {
            "frameworkId": {
              "type": "string"
            },
            "country": {
              "type": "string"
            },
            "frameworkKind": {
              "type": "string",
              "enum": [
                "office_spa_prevention",
                "oip_r2p",
                "framework_analysis",
                "risk_assessment",
                "urgent_appeal",
                "early_warning",
                "joint_statement",
                "mission_country",
                "advocacy",
                "field_mission",
                "commission_of_inquiry"
              ]
            },
            "provisionalMeasureVid": {
              "type": "string",
              "description": "bridges genocideConvention.flagProvisionalMeasure"
            },
            "publishedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}