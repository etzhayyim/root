{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.landTenure.flagEviction",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Eviction / land grab flag (bridges forced-labor + indigenous-rights + climate-litigation + uasc-protection)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "evictionId",
            "evictionKind",
            "reportedAt"
          ],
          "properties": {
            "evictionId": {
              "type": "string"
            },
            "recognitionVid": {
              "type": "string",
              "description": "bridges recordRecognition"
            },
            "evictingActorLei": {
              "type": "string"
            },
            "evictionKind": {
              "type": "string",
              "enum": [
                "state",
                "corporate_land_grab",
                "infrastructure",
                "conservation_fortress",
                "conflict_displacement",
                "climate_risk"
              ]
            },
            "personsAffected": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "targeted",
                "major",
                "mass"
              ]
            }
          }
        }
      }
    }
  }
}