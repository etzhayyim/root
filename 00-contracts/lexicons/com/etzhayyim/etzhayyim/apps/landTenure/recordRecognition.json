{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.landTenure.recordRecognition",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Land tenure recognition (LGAF / VGGT / IFAD Land Tenure — bridges indigenous-rights + mining-operation + agri-food-security + forestry-mrv)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "recognitionId",
            "countryIso3",
            "tenureType",
            "recognizedAt"
          ],
          "properties": {
            "recognitionId": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "tenureType": {
              "type": "string",
              "enum": [
                "customary",
                "collective",
                "leasehold",
                "freehold",
                "squatter_rights",
                "indigenous_community",
                "state",
                "private"
              ]
            },
            "areaHectares": {
              "type": "number"
            },
            "beneficiariesCount": {
              "type": "integer"
            },
            "instrumentKind": {
              "type": "string",
              "enum": [
                "formal_title",
                "registered_custom",
                "certificate",
                "ccro",
                "land_use_right",
                "restitution"
              ]
            },
            "recognizedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}