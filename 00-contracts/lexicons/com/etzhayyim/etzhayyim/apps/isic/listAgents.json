{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.isic.listAgents",
  "defs": {
    "main": {
      "type": "query",
      "description": "List available ISIC class agents in the registry. Result is paged.",
      "parameters": {
        "type": "params",
        "properties": {
          "section": {
            "type": "string",
            "description": "Filter by ISIC section letter (A through U)."
          },
          "divisionPrefix": {
            "type": "string",
            "description": "Filter by 2-digit division code prefix."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100
          },
          "cursor": {"type": "string"}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["agents", "totalCount"],
          "properties": {
            "agents": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["classCode"],
                "properties": {
                  "classCode": {"type": "string"},
                  "title": {"type": "string"},
                  "section": {"type": "string"},
                  "division": {"type": "string"},
                  "group": {"type": "string"},
                  "module": {"type": "string"},
                  "loaded": {"type": "boolean"}
                }
              }
            },
            "totalCount": {"type": "integer"},
            "cursor": {"type": "string"}
          }
        }
      }
    }
  }
}
