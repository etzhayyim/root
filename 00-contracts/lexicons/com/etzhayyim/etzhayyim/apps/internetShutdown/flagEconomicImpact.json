{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.internetShutdown.flagEconomicImpact",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Economic / social impact of shutdown (bridges cellBroadcastAlert.flagDeliveryGap + digital-public-infra + refugee-unhcr)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "shutdownVid",
            "impactKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "shutdownVid": {
              "type": "string",
              "description": "bridges recordShutdown"
            },
            "impactKind": {
              "type": "string",
              "enum": [
                "gdp_loss_pct",
                "remittance_halt",
                "exam_disrupt",
                "medical_telemed",
                "banking_halt",
                "emergency_alerts_off",
                "schools_online_halt",
                "pandemic_info_halt",
                "agri_price_info",
                "msme_impact",
                "tourism_hit",
                "elections_affected"
              ]
            },
            "estBusdLoss": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}