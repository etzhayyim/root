{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.fatfGreylist.recordListingChange",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "FATF / EU / UK greylist / blacklist listing change (bridges bearerShare.flagLoophole + sanctions-entry + aml)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "changeId",
            "jurisdictionIso3",
            "listKind",
            "actionKind",
            "effectiveAt"
          ],
          "properties": {
            "changeId": {
              "type": "string"
            },
            "jurisdictionIso3": {
              "type": "string"
            },
            "listKind": {
              "type": "string",
              "enum": [
                "fatf_black",
                "fatf_grey",
                "eu_third_high_risk",
                "uk_amlr",
                "us_8206",
                "jp_msb_risk",
                "fatf_progress",
                "fatf_off_ramp",
                "fatf_icrg",
                "fatf_monitored"
              ]
            },
            "actionKind": {
              "type": "string",
              "enum": [
                "added",
                "removed",
                "upgraded",
                "downgraded",
                "partial_delist",
                "increased_monitoring",
                "enhanced_due_diligence",
                "counter_measures"
              ]
            },
            "loopholeVid": {
              "type": "string",
              "description": "bridges bearerShare.flagLoophole"
            },
            "effectiveAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}