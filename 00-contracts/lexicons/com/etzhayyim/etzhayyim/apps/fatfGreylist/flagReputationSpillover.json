{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.fatfGreylist.flagReputationSpillover",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Correspondent derisking / FDI drop / cost-of-funds premium (bridges bearerShare.flagLoophole + correspondentBanking + debt-transparency)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "changeVid",
            "impactKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "changeVid": {
              "type": "string",
              "description": "bridges recordListingChange"
            },
            "impactKind": {
              "type": "string",
              "enum": [
                "cbr_exit",
                "fdi_drop",
                "yield_premium",
                "trade_finance_tighten",
                "mto_corridor_close",
                "imf_warning",
                "rating_downgrade",
                "capital_outflow",
                "dedollarization_push",
                "remittance_squeeze"
              ]
            },
            "estBusdImpact": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}