{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.modernSlavery.recordDisclosure",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Modern slavery / forced labor disclosure (UK MSA / AU MSA / CA S-211 — bridges ftzZones.flagLabourAbuse + forced-labor + ilo-labor-rights)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "disclosureId",
            "regime",
            "supplyChainScope",
            "filedAt"
          ],
          "properties": {
            "disclosureId": {
              "type": "string"
            },
            "entityLei": {
              "type": "string"
            },
            "regime": {
              "type": "string",
              "enum": [
                "uk_msa_s54",
                "au_msa",
                "ca_s211",
                "nl_child_labor_due_dil",
                "fr_vigilance",
                "de_lksg",
                "no_transparency",
                "us_uflpa",
                "us_cust_border_withhold",
                "thailand_anti_trafficking",
                "peru_vigilance"
              ]
            },
            "supplyChainScope": {
              "type": "string",
              "enum": [
                "tier_1_only",
                "tier_2",
                "tier_3",
                "entire_value_chain",
                "material_imports",
                "high_risk_geographies",
                "specific_commodity",
                "finance_investments"
              ]
            },
            "labourAbuseVid": {
              "type": "string",
              "description": "bridges ftzZones.flagLabourAbuse"
            },
            "filedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}