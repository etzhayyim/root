{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.zeroDayBroker.flagVendorPatchLag",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Patch lag / exploit used in wild / supply chain (bridges spywareExport.flagMisuse + cyber-vuln-patch + cyber-incident-ioc)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "acquisitionVid",
            "issueKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "acquisitionVid": {
              "type": "string",
              "description": "bridges recordAcquisition"
            },
            "issueKind": {
              "type": "string",
              "enum": [
                "patch_gap_days",
                "zero_click_itw",
                "broker_disclosure_breach",
                "unfixed_dependency",
                "post_patch_itw",
                "long_tail_unpatched",
                "device_abandonware",
                "citizen_lab_report",
                "itw_before_broker_disclose",
                "re_exploit"
              ]
            },
            "daysTillPatch": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}