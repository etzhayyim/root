{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.refugeeUnhcr.recordPopulation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "UNHCR population snapshot (bridges forced-labor + disaster-response + cofog)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "snapshotId",
            "originIso3",
            "asylumIso3",
            "populationType",
            "populationSize",
            "snapshotMonth"
          ],
          "properties": {
            "snapshotId": {
              "type": "string"
            },
            "originIso3": {
              "type": "string"
            },
            "asylumIso3": {
              "type": "string"
            },
            "populationType": {
              "type": "string",
              "enum": [
                "refugee",
                "asylum_seeker",
                "idp",
                "returnee",
                "stateless",
                "other_protected"
              ]
            },
            "populationSize": {
              "type": "integer"
            },
            "causeDisasterVid": {
              "type": "string",
              "description": "bridges open-disaster-response"
            },
            "snapshotMonth": {
              "type": "string",
              "description": "YYYY-MM"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "scaleTier": {
              "type": "string",
              "enum": [
                "small",
                "significant",
                "large",
                "mass"
              ]
            }
          }
        }
      }
    }
  }
}