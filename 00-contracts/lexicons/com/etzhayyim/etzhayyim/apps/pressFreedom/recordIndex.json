{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.pressFreedom.recordIndex",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "RSF / Freedom House / CPJ press-freedom index (bridges election-integrity + misinformation-observatory + election integrity)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "recordId",
            "countryIso3",
            "indexProvider",
            "cursorYear",
            "scoreValue",
            "publishedAt"
          ],
          "properties": {
            "recordId": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "indexProvider": {
              "type": "string",
              "enum": [
                "rsf",
                "freedom_house",
                "cpj",
                "ifj",
                "v_dem",
                "bbc_media_action"
              ]
            },
            "cursorYear": {
              "type": "integer"
            },
            "scoreValue": {
              "type": "number",
              "description": "index score 0-100 (higher=freer)"
            },
            "rankGlobal": {
              "type": "integer"
            },
            "publishedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "freedomTier": {
              "type": "string",
              "enum": [
                "very_serious",
                "difficult",
                "problematic",
                "satisfactory",
                "good"
              ]
            }
          }
        }
      }
    }
  }
}