{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.bpmn.analyzeProcess",
  "defs": {
    "main": {
      "type": "query",
      "description": "Optimize-free process mining over BPMN/POD-side LangServer OCEL audit events. Reads vertex_repo_commit rows where collection=com.etzhayyim.bpmn.audit, returns deterministic KPIs and optional LLM diagnosis.",
      "parameters": {
        "type": "params",
        "properties": {
          "processId": {
            "type": "string",
            "description": "Optional BPMN process id filter when audit payloads carry process_id/processId/_bpmnProcessId."
          },
          "caseId": {
            "type": "string",
            "description": "Optional OCEL case/run id filter."
          },
          "actionPrefix": {
            "type": "string",
            "description": "Optional action prefix filter, e.g. mangaka. or jpCorpFinance."
          },
          "since": {
            "type": "string",
            "format": "datetime"
          },
          "until": {
            "type": "string",
            "format": "datetime"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000,
            "default": 500
          },
          "includeLlm": {
            "type": "boolean",
            "default": true,
            "description": "When false, return statistics only and skip the LLM explanation call."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "source": { "type": "string" },
            "filters": { "type": "unknown" },
            "eventCount": { "type": "integer" },
            "caseCount": { "type": "integer" },
            "activityCount": { "type": "integer" },
            "window": { "type": "unknown" },
            "activities": { "type": "array", "items": { "type": "unknown" } },
            "bottlenecks": { "type": "array", "items": { "type": "unknown" } },
            "variants": { "type": "array", "items": { "type": "unknown" } },
            "cases": { "type": "array", "items": { "type": "unknown" } },
            "anomalies": { "type": "unknown" },
            "llm": { "type": "unknown" },
            "llmError": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
