{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.bpmn.startInstance",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Start a process instance with inputs. Correlation key is optional and enables signalInstance routing.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["processId"],
          "properties": {
            "processId": { "type": "string" },
            "variables": { "type": "unknown" },
            "correlationKey": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "instanceId": { "type": "string" },
            "processId": { "type": "string" },
            "state": { "type": "string" },
            "startedAt": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
