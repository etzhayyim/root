{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.bpmn.compileJsonToXml",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Compile BPMN JSON subset (9 step types) to BPMN 2.0 XML. Deterministic.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["json"],
          "properties": { "json": { "type": "unknown", "description": "{id, name, version?, variables?, flow[]}" } }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "xml": { "type": "string" },
            "byteSize": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
