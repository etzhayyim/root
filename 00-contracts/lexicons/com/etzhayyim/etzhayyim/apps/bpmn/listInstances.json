{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.bpmn.listInstances",
  "defs": {
    "main": {
      "type": "query",
      "description": "List process instances, optionally filtered by processId and state.",
      "parameters": {
        "type": "params",
        "properties": {
          "processId": { "type": "string" },
          "state": { "type": "string", "enum": ["active", "completed", "terminated", "error", "suspended"] },
          "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 50 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "instances": { "type": "array", "items": { "type": "unknown" } },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
