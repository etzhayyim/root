{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.public-fund.milestone-evidence",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "Recipient's submission of milestone completion evidence in a MilestoneEscrow path grant. Council Lv6+ attests next. Per ADR-2605192145 §4.2.",
      "record": {
        "type": "object",
        "required": ["proposalUri", "milestoneIndex", "evidenceUri", "recipientDid", "submittedAt"],
        "properties": {
          "proposalUri": { "type": "string", "format": "at-uri" },
          "executionUri": { "type": "string", "format": "at-uri" },
          "milestoneIndex": {
            "type": "integer",
            "minimum": 0,
            "description": "0-indexed milestone within the grant."
          },
          "milestoneTitle": { "type": "string", "maxLength": 200 },
          "evidenceUri": {
            "type": "string",
            "description": "URI of completion evidence (IPFS CID / URL / AT URI)."
          },
          "evidenceNarrative": { "type": "string", "maxLength": 4000 },
          "recipientDid": { "type": "string" },
          "recipientSignature": { "type": "string" },
          "submittedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
