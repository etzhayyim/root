{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.public-fund.evaluation",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "PublicFundGrantCell (Pregel + LLM) evaluation of a proposal. Advisory only; binding decision is the 1 SBT = 1 vote. Per ADR-2605192145 §3 + 2605192415.",
      "record": {
        "type": "object",
        "required": ["proposalUri", "recommendation", "ratingScore", "evaluatedAt", "cellSignature"],
        "properties": {
          "proposalUri": { "type": "string", "format": "at-uri" },
          "riderCompliance": {
            "type": "string",
            "enum": ["pass", "fail", "needs-human"],
            "description": "Whether recipients pass Charter Compliance Rider §2(a)-(h) check."
          },
          "missionAxisMatch": {
            "type": "integer",
            "description": "How well proposal matches declared mission axis, scaled by 100 (0-100)."
          },
          "amountReasonableness": {
            "type": "integer",
            "description": "vs treasury NAV + median past similar grants, scaled by 100."
          },
          "proposerTrackRecord": {
            "type": "integer",
            "description": "Based on MST attestation history. Scaled by 100."
          },
          "similarGrantOutcomes": {
            "type": "array",
            "maxLength": 10,
            "items": {
              "type": "object",
              "properties": {
                "pastProposalUri": { "type": "string", "format": "at-uri" },
                "outcome": { "type": "string", "enum": ["completed-milestone", "completed-simple", "cancelled", "failed"] }
              }
            }
          },
          "recommendation": {
            "type": "string",
            "enum": ["approve", "reject", "needs-human-review"]
          },
          "ratingScore": {
            "type": "integer",
            "description": "Aggregate score 0-100; voting UI displays this as advisory."
          },
          "llmRationale": { "type": "string", "maxLength": 4000 },
          "evaluatedAt": { "type": "string", "format": "datetime" },
          "cellSignature": {
            "type": "string",
            "description": "Cell-key signature (rotated quarterly per ADR-2605192415 §9)."
          }
        }
      }
    }
  }
}
