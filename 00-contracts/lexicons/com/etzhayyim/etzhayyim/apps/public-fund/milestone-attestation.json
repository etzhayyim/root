{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.public-fund.milestone-attestation",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "Council Lv6+ attestation that a recipient's milestone-evidence is complete + unlock disbursement. Per ADR-2605192145 §4.2.",
      "record": {
        "type": "object",
        "required": ["milestoneEvidenceUri", "councilSigners", "councilSignatures", "approved", "attestedAt"],
        "properties": {
          "milestoneEvidenceUri": { "type": "string", "format": "at-uri" },
          "proposalUri": { "type": "string", "format": "at-uri" },
          "milestoneIndex": { "type": "integer", "minimum": 0 },
          "councilSigners": {
            "type": "array",
            "minLength": 3,
            "items": { "type": "string" }
          },
          "councilSignatures": {
            "type": "array",
            "minLength": 3,
            "items": { "type": "string" }
          },
          "approved": { "type": "boolean" },
          "rationale": { "type": "string", "maxLength": 2000 },
          "milestoneEscrowTxHash": {
            "type": "string",
            "description": "MilestoneEscrow release tx hash on Base L2 (set after approval)."
          },
          "attestedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
