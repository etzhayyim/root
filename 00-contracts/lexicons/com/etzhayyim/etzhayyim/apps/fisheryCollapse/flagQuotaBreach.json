{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.fisheryCollapse.flagQuotaBreach",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "TAC / quota breach / RFMO non-compliance (bridges fisheries-iuu + fisheries-subsidies + marineHeatwave)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "assessmentVid",
            "rfmo",
            "breachKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "assessmentVid": {
              "type": "string",
              "description": "bridges recordStockAssessment"
            },
            "rfmo": {
              "type": "string",
              "enum": [
                "iccat",
                "iotc",
                "wcpfc",
                "iattc",
                "sprfmo",
                "ccamlr",
                "napfc",
                "nasco",
                "nafo",
                "siofa"
              ]
            },
            "breachKind": {
              "type": "string",
              "enum": [
                "tac_exceed",
                "unreported_landing",
                "iuu_vessel",
                "misreporting",
                "discard_ban_violation",
                "transshipment",
                "bycatch_excess",
                "observer_coverage_fail"
              ]
            },
            "breachVolumeTonnes": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "moderate",
                "significant",
                "severe"
              ]
            }
          }
        }
      }
    }
  }
}