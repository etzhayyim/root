{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openSmartphoneBom.listBoms",
  "defs": {
    "main": {
      "type": "query",
      "description": "List smartphone BOMs",
      "parameters": {
        "type": "params",
        "properties": {
          "status": { "type": "string", "knownValues": ["draft", "review", "approved", "production"] },
          "minOpenScorePct": { "type": "number" },
          "limit": { "type": "integer", "default": 50, "maximum": 200 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["boms", "total"],
          "properties": {
            "boms": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["vertexId", "bomId", "designName", "version"],
                "properties": {
                  "vertexId": { "type": "string" },
                  "bomId": { "type": "string" },
                  "designName": { "type": "string" },
                  "version": { "type": "string" },
                  "openScorePct": { "type": "number" },
                  "targetPriceUsd": { "type": "number" },
                  "status": { "type": "string" }
                }
              }
            },
            "total": { "type": "integer" }
          }
        }
      }
    }
  }
}
