{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openSmartphoneBom.recordBomLine",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Add a component line item to a smartphone BOM",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["lineId", "bomDid", "componentType", "vendorName", "partNumber", "unitCostUsd"],
          "properties": {
            "lineId": { "type": "string" },
            "bomDid": { "type": "string", "format": "did" },
            "componentType": { "type": "string", "knownValues": ["soc", "modem", "display", "battery", "camera-module", "pmic", "memory-dram", "storage-flash", "rf-frontend", "antenna", "frame-chassis", "pcb", "charging-ic", "usb-controller", "audio-codec", "speaker", "microphone", "other"] },
            "vendorName": { "type": "string" },
            "partNumber": { "type": "string" },
            "unitCostUsd": { "type": "number" },
            "openSource": { "type": "boolean" },
            "license": { "type": "string" },
            "patentDid": { "type": "string", "format": "did" },
            "alternativeCount": { "type": "integer" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["vertexId"],
          "properties": { "vertexId": { "type": "string" } }
        }
      }
    }
  }
}
