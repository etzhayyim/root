{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openSmartphoneBom.assembleBom",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Assemble a full smartphone BOM linking SoC, modem, OS, and EMS facility",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["bomId", "designName", "version"],
          "properties": {
            "bomId": { "type": "string" },
            "designName": { "type": "string" },
            "version": { "type": "string" },
            "socDid": { "type": "string", "format": "did" },
            "modemDid": { "type": "string", "format": "did" },
            "osDid": { "type": "string", "format": "did" },
            "emsFacilityDid": { "type": "string", "format": "did" },
            "targetPriceUsd": { "type": "number" },
            "openScorePct": { "type": "number", "description": "Initial open-source score estimate (0-100)" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["vertexId"],
          "properties": { "vertexId": { "type": "string" } }
        }
      }
    }
  }
}
