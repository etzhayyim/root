{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.panamaNeopanamax.recordTransferCost",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "代替ルート費用",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "costId",
            "imo",
            "decidedAt"
          ],
          "properties": {
            "costId": {
              "type": "string"
            },
            "imo": {
              "type": "string"
            },
            "alternativeRoute": {
              "type": "string",
              "enum": [
                "suez",
                "cape-of-good-hope",
                "us-rail-landbridge"
              ]
            },
            "daysPenalty": {
              "type": "number"
            },
            "costDeltaUsd": {
              "type": "number"
            },
            "decidedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "impactTier": {
              "type": "string",
              "enum": [
                "minor",
                "moderate",
                "major"
              ]
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
