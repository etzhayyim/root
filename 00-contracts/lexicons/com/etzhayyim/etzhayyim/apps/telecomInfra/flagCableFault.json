{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecomInfra.flagCableFault",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Undersea cable fault / cut event (sanctions + cyber-incident bridge)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "faultId",
            "cableVid",
            "faultType",
            "detectedAt"
          ],
          "properties": {
            "faultId": {
              "type": "string"
            },
            "cableVid": {
              "type": "string",
              "description": "bridges registerCable"
            },
            "faultType": {
              "type": "string",
              "enum": [
                "anchor_drag",
                "fishing",
                "earthquake",
                "landslide",
                "sabotage_suspected",
                "sabotage_confirmed",
                "equipment"
              ]
            },
            "locationLat": {
              "type": "number"
            },
            "locationLon": {
              "type": "number"
            },
            "repairShipEta": {
              "type": "string"
            },
            "cyberIncidentVid": {
              "type": "string",
              "description": "bridges open-cyber-incident if cyber-correlated"
            },
            "detectedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "routine",
                "investigation",
                "state_sponsored"
              ]
            }
          }
        }
      }
    }
  }
}