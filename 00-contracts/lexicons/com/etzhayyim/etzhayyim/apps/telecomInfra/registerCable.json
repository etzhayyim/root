{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecomInfra.registerCable",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Undersea cable registry (TeleGeography — bridges cyber-compliance + carrier-esg)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "cableId",
            "cableName",
            "landingPointsIso3",
            "status",
            "registeredAt"
          ],
          "properties": {
            "cableId": {
              "type": "string"
            },
            "cableName": {
              "type": "string"
            },
            "consortiumLei": {
              "type": "string"
            },
            "landingPointsIso3": {
              "type": "string",
              "description": "comma-separated ISO 3166-1 alpha-3"
            },
            "lengthKm": {
              "type": "number"
            },
            "designCapacityTbps": {
              "type": "number"
            },
            "rfsYear": {
              "type": "integer",
              "description": "ready-for-service year"
            },
            "status": {
              "type": "string",
              "enum": [
                "planned",
                "under_construction",
                "in_service",
                "retired"
              ]
            },
            "registeredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "capacityTier": {
              "type": "string",
              "enum": [
                "standard",
                "major",
                "mega"
              ]
            }
          }
        }
      }
    }
  }
}