{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.oceanAcidification.flagCalcifierStress",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Calcifier stress signal (shellfish / coral / pteropod — bridges fisheries-iuu + agri-food-security)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "signalId",
            "measurementVid",
            "organismGroup",
            "detectedAt"
          ],
          "properties": {
            "signalId": {
              "type": "string"
            },
            "measurementVid": {
              "type": "string",
              "description": "bridges recordPhMeasurement"
            },
            "organismGroup": {
              "type": "string",
              "enum": [
                "corals",
                "molluscs",
                "echinoderms",
                "crustaceans",
                "foraminifera",
                "coralline_algae",
                "pteropods"
              ]
            },
            "mortalityPct": {
              "type": "number"
            },
            "hatcheryImpactDescription": {
              "type": "string"
            },
            "detectedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}