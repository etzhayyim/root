{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.wtoTradeCbam.recordSpecificTradeConcern",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "WTO STC / CTTE / CBAM trade-environment concern (bridges cbamEmbedded.flagLeakage + wto-dispute + eu-cbam)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "stcId",
            "raisingMemberIso3",
            "againstMemberIso3",
            "forum",
            "concernKind",
            "raisedAt"
          ],
          "properties": {
            "stcId": {
              "type": "string"
            },
            "raisingMemberIso3": {
              "type": "string"
            },
            "againstMemberIso3": {
              "type": "string"
            },
            "forum": {
              "type": "string",
              "enum": [
                "wto_cte",
                "wto_cttd",
                "wto_ctg",
                "wto_sps",
                "wto_tbt",
                "wto_pmeu",
                "g20_trade",
                "commerce_summit",
                "asean_trade"
              ]
            },
            "concernKind": {
              "type": "string",
              "enum": [
                "trade_disruption",
                "discriminatory",
                "most_favoured_nation",
                "unilateral_standard",
                "extraterritorial",
                "cbam_scope",
                "lca_methodology",
                "default_value",
                "least_developed_carveout",
                "transition_period"
              ]
            },
            "leakageVid": {
              "type": "string",
              "description": "bridges cbamEmbedded.flagLeakage"
            },
            "raisedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}