{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.oilCoverage.listOrchestrations",
  "defs": {
    "main": {
      "type": "query",
      "description": "List oil coverage orchestration baselines with offset/limit pagination.",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "properties": {
          "jurisdiction": { "type": "string" },
          "segment": { "type": "string" },
          "actorFreshness": { "type": "string", "enum": ["fresh", "stale", "missing"] },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "required": ["orchestrations", "total", "offset", "limit"], "properties": { "orchestrations": { "type": "array", "items": { "type": "object", "properties": { "uri": { "type": "string", "format": "at-uri" }, "jurisdiction": { "type": "string" }, "segment": { "type": "string" }, "baselineCount": { "type": "integer" }, "actorFreshness": { "type": "string" } } } }, "total": { "type": "integer" }, "offset": { "type": "integer" }, "limit": { "type": "integer" } } } }
    }
  }
}
