{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openRail.defineLine",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a rail line. Station sequence is supplied via separate calls; this call creates just the line header. Starts BPMN process open_rail_define_line.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["operatorOrgId", "lineCode", "name"],
          "properties": {
            "operatorOrgId": { "type": "string" },
            "lineCode":      { "type": "string" },
            "name":          { "type": "string" },
            "gaugeMm":       { "type": "integer" },
            "lengthKm":      { "type": "number" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" }, "error": { "type": "string" }
          }
        }
      }
    }
  }
}
