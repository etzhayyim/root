{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openRail.reportIncident",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Report a rail incident (safety or delay). Severity = major if category = derailment/collision/fatality or delay >= 60min. Starts BPMN open_rail_report_incident.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["operatorOrgId", "lineVid", "category", "reportedAt"],
          "properties": {
            "operatorOrgId": { "type": "string" },
            "lineVid":       { "type": "string" },
            "runVid":        { "type": "string" },
            "category":      { "type": "string", "description": "derailment / collision / fatality / signal-failure / delay / other" },
            "narrative":     { "type": "string" },
            "delayMinutes":  { "type": "integer" },
            "reportedAt":    { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
            "severity": { "type": "string", "enum": ["minor","moderate","major"] },
            "requirePublicNotice": { "type": "boolean" },
            "instanceKey": { "type": "integer" }, "error": { "type": "string" }
          }
        }
      }
    }
  }
}
