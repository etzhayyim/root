{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.jpMeti.flagInterAgencyTension",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "METI vs MOF / METI vs MOFA / 産業政策会議 (bridges jpMof + treasuryRulemaking + sovereignDebt)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "actionVid",
            "tensionKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "actionVid": {
              "type": "string",
              "description": "bridges recordAction"
            },
            "tensionKind": {
              "type": "string",
              "enum": [
                "mof_budget_block",
                "mofa_diplomatic_concern",
                "mlit_aviation_overlap",
                "mhlw_health_industry_dual",
                "mext_research_ip",
                "kantei_steering",
                "ldp_chair_pressure",
                "ldp_seimuchoukai",
                "fsa_bank_industrial_intersection",
                "industry_capture",
                "gx_finance_dispute",
                "semiconductor_subsidy_dispute",
                "fnsf_special_meeting"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}