{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.unescoInDanger.flagDegradationDriver",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Degradation driver / armed conflict / commercial pressure (bridges heritageAccessibility.flagConservationConflict + cultural-heritage + poc-ihl)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "changeVid",
            "driverKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "changeVid": {
              "type": "string",
              "description": "bridges recordListingChange"
            },
            "driverKind": {
              "type": "string",
              "enum": [
                "armed_conflict",
                "looting",
                "uncontrolled_urban",
                "mining_extractive",
                "tourism_overuse",
                "climate_change",
                "invasive_species",
                "illegal_wildlife",
                "lack_of_maintenance",
                "terror_bombing",
                "deforestation",
                "dam_construction",
                "inappropriate_restoration"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}