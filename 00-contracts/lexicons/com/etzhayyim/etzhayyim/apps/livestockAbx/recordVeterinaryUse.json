{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.livestockAbx.recordVeterinaryUse",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Veterinary antibiotic use (WOAH annual report / EMA ESVAC / FDA ADUFA — bridges amrSurveillance.flagStewardshipBreach + one-health + food-safety)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "reportId",
            "countryIso3",
            "animalCategory",
            "antibioticClass",
            "reportedAt"
          ],
          "properties": {
            "reportId": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "animalCategory": {
              "type": "string",
              "enum": [
                "cattle_dairy",
                "cattle_beef",
                "swine",
                "poultry_broiler",
                "poultry_layer",
                "aquaculture_salmon",
                "aquaculture_shrimp",
                "companion",
                "sheep_goat"
              ]
            },
            "antibioticClass": {
              "type": "string",
              "enum": [
                "tetracycline",
                "penicillin",
                "macrolide",
                "sulfonamide",
                "aminoglycoside",
                "fluoroquinolone",
                "colistin",
                "cephalosporin"
              ]
            },
            "indicationKind": {
              "type": "string",
              "enum": [
                "therapeutic",
                "metaphylaxis",
                "prophylactic",
                "growth_promotion_banned"
              ]
            },
            "mgPerPcu": {
              "type": "number",
              "description": "ESVAC PCU denominator"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "priorityTier": {
              "type": "string",
              "enum": [
                "standard",
                "cia",
                "hp_cia"
              ]
            }
          }
        }
      }
    }
  }
}