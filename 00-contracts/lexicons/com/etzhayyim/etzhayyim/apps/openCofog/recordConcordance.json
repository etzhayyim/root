{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openCofog.recordConcordance",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a cross-walk mapping between a COFOG class and a code in another taxonomy (GFS, ESA2010, SEEA, national CoA). Starts BPMN open_cofog_record_concordance.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["cofogClassCode","otherTaxonomy","otherCode","relation"],
          "properties": {
            "cofogClassCode": { "type": "string" },
            "otherTaxonomy":  { "type": "string", "description": "GFS / ESA2010 / SEEA / nationalCoA" },
            "otherCode":      { "type": "string" },
            "relation":       { "type": "string", "enum": ["exactMatch","broader","narrower","relatedTo"] },
            "confidence":     { "type": "number" },
            "source":         { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" }, "error": { "type": "string" }
          }
        }
      }
    }
  }
}
