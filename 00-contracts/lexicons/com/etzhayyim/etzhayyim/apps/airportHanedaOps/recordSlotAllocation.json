{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airportHanedaOps.recordSlotAllocation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Haneda HND slot allocation / runway / curfew (bridges airplane-airport + iata-codeshare + ports-port)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "allocationId",
            "runwayKind",
            "slotKind",
            "allocatedAt"
          ],
          "properties": {
            "allocationId": {
              "type": "string"
            },
            "runwayKind": {
              "type": "string",
              "enum": [
                "a_runway_16r_34l",
                "b_runway_04_22",
                "c_runway_16l_34r",
                "d_runway_05_23",
                "new_runway_2030_proposed",
                "cross_a_b_dependency",
                "conflict_b_c",
                "apron_only",
                "go_around_alternate"
              ]
            },
            "slotKind": {
              "type": "string",
              "enum": [
                "domestic_slot",
                "int_slot",
                "mctd_morning",
                "mctd_evening",
                "new_route_slot",
                "seasonal_summer",
                "seasonal_winter",
                "early_curfew",
                "late_curfew",
                "emergency_extension",
                "cargo_only",
                "ga_general_aviation"
              ]
            },
            "carrierLei": {
              "type": "string"
            },
            "flightVid": {
              "type": "string",
              "description": "bridges airplane-flight"
            },
            "allocatedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}