{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.pressFinanceCoercion.recordSlappCase",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "SLAPP / strategic lawsuit against public participation (bridges press-freedom + climate-litigation + ofac-sanctions)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "caseId",
            "defendantCategory",
            "jurisdictionIso3",
            "claimBasis",
            "filedAt"
          ],
          "properties": {
            "caseId": {
              "type": "string"
            },
            "plaintiffLei": {
              "type": "string"
            },
            "defendantCategory": {
              "type": "string",
              "enum": [
                "journalist",
                "ngo",
                "academic",
                "environmentalist",
                "activist",
                "whistleblower"
              ]
            },
            "jurisdictionIso3": {
              "type": "string"
            },
            "claimBasis": {
              "type": "string",
              "enum": [
                "defamation",
                "privacy",
                "ip",
                "tortious_interference",
                "trade_secret",
                "contract",
                "regulatory"
              ]
            },
            "damageClaimedUsd": {
              "type": "number"
            },
            "antiSlappJurisdiction": {
              "type": "boolean"
            },
            "filedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "chillingTier": {
              "type": "string",
              "enum": [
                "notice",
                "significant",
                "severe"
              ]
            }
          }
        }
      }
    }
  }
}