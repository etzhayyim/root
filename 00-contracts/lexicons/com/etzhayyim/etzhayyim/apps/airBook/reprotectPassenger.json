{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airBook.reprotectPassenger",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Reprotect a passenger onto an alternative flight due to irregular operations.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["pnr_ref", "irrop_reason", "new_flight_no"],
          "properties": {
            "pnr_ref": { "type": "string" },
            "irrop_reason": { "type": "string" },
            "new_flight_no": { "type": "string" },
            "new_dep_date": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
