{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airBook.settleBsp",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Settle Billing and Settlement Plan (BSP) for a carrier period.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["carrier_code", "period", "settlement_amount"],
          "properties": {
            "carrier_code": { "type": "string" },
            "period": { "type": "string" },
            "settlement_amount": { "type": "string" },
            "currency": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
