{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.otakiage.scheduleMatsuri",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "季節祭 (供養祭) を新規スケジュール。authority gated (issuer = did:web:otakiage.etzhayyim.com or :matsuri sub-DID のみ)。BPMN matsuriSchedule (cron 月初) からも内部呼出される。",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["name", "scheduledDate", "categoryScope"],
          "properties": {
            "name": {"type": "string", "maxLength": 200, "description": "例: 「春の人形供養祭」「絵本供養祭 2026 / こどもの読書週間」"},
            "scheduledDate": {"type": "string", "format": "date"},
            "categoryScope": {"type": "array", "items": {"type": "string", "enum": ["ehon", "jidousho", "nuigurumi", "ningyo", "omocha", "kagu", "kaden"]}, "description": "対象カテゴリ"},
            "capacity": {"type": "integer", "minimum": 0, "description": "受付上限件数 (0 = 制限なし)"},
            "locationH3": {"type": "string", "description": "開催地 H3 cell (Phase 1 = digital ritual のため optional)"},
            "description": {"type": "string", "maxLength": 4000, "description": "祭の趣旨 / 司式者 / 開催場所 etc"}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "matsuriUri"],
          "properties": {
            "ok": {"type": "boolean"},
            "matsuriUri": {"type": "string"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
