{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.liquidityFacility.flagStigmaEffect",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Stigma / counterparty risk / signal contamination (bridges digitalRunRisk.flagContagionRisk + bank-resolution + sovereign-debt)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "facilityVid",
            "concernKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "facilityVid": {
              "type": "string",
              "description": "bridges recordFacility"
            },
            "concernKind": {
              "type": "string",
              "enum": [
                "stigma",
                "too_narrow_haircuts",
                "eligibility_too_restricted",
                "daily_report_chilling",
                "misreporting_access",
                "interest_penal",
                "withdrawal_run_on_access",
                "counterparty_credit_risk",
                "balance_sheet_footprint",
                "moral_hazard"
              ]
            },
            "usagePremiumBps": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}