{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openPower.defineFeeder",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a distribution feeder (substation → service area). Starts BPMN process open_power_define_feeder.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "utilityOrgId":  { "type": "string" },
            "fromVertexId":  { "type": "string" },
            "toVertexId":    { "type": "string" },
            "voltageKv":     { "type": "number" },
            "capacityAmps":  { "type": "number" },
            "lengthKm":      { "type": "number" },
            "installedAt":   { "type": "string", "format": "datetime" }
          },
          "required": ["utilityOrgId", "fromVertexId", "toVertexId", "voltageKv"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok":          { "type": "boolean" },
            "vertexId":    { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error":       { "type": "string" }
          }
        }
      }
    }
  }
}
