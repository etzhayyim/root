{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.emailServiceAdapter.getSync",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a mailbox sync status by userDid+provider. PII Tier 3 — returns metadata only; message bodies remain in Preferences.",
      "x-bootstrap": true,
      "parameters": { "type": "params", "required": ["userDid", "provider"], "properties": { "userDid": { "type": "string", "format": "did" }, "provider": { "type": "string" } } },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "userDid": { "type": "string", "format": "did" }, "provider": { "type": "string" }, "folder": { "type": "string" }, "messagesIngested": { "type": "integer" }, "lastSyncAt": { "type": "string", "format": "datetime" }, "watermark": { "type": "string" }, "oauthStatus": { "type": "string", "enum": ["connected", "expired", "revoked"] } } } }
    }
  }
}
