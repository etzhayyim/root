{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.emailServiceAdapter.listSyncs",
  "defs": {
    "main": {
      "type": "query",
      "description": "List mailbox sync events. PII Tier 3 — message bodies in Preferences only; this query returns sync metadata only.",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "properties": {
          "userDid": { "type": "string", "format": "did" },
          "provider": { "type": "string" },
          "syncedAfter": { "type": "string", "format": "datetime" },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "required": ["syncs", "total", "offset", "limit"], "properties": { "syncs": { "type": "array", "items": { "type": "object", "properties": { "userDid": { "type": "string", "format": "did" }, "provider": { "type": "string" }, "messagesIngested": { "type": "integer" }, "lastSyncAt": { "type": "string", "format": "datetime" } } } }, "total": { "type": "integer" }, "offset": { "type": "integer" }, "limit": { "type": "integer" } } } }
    }
  }
}
