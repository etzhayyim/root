{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.cyberIncident.recordIOC",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "IOC 記録 (hash/IP/domain)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "iocId",
            "iocType",
            "value",
            "tlp",
            "firstSeenAt"
          ],
          "properties": {
            "iocId": {
              "type": "string"
            },
            "incidentVid": {
              "type": "string"
            },
            "iocType": {
              "type": "string",
              "enum": [
                "sha256",
                "sha1",
                "md5",
                "ip",
                "domain",
                "url",
                "email",
                "cve",
                "tool"
              ]
            },
            "value": {
              "type": "string"
            },
            "context": {
              "type": "string"
            },
            "confidence": {
              "type": "number"
            },
            "tlp": {
              "type": "string",
              "enum": [
                "white",
                "green",
                "amber",
                "red",
                "clear"
              ]
            },
            "firstSeenAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
