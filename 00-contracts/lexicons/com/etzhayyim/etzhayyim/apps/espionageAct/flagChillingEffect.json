{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.espionageAct.flagChillingEffect",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Press chill / source closure / sentence severity (bridges classificationReview.flagOverClassification + press-freedom + whistleblower-protect)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "prosecutionVid",
            "concernKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "prosecutionVid": {
              "type": "string",
              "description": "bridges recordProsecution"
            },
            "concernKind": {
              "type": "string",
              "enum": [
                "disproportionate_sentence",
                "source_dried_up",
                "journalist_conspiracy",
                "press_cert_subpoena",
                "extradition_chill",
                "no_public_interest_defense",
                "electronic_communications_act",
                "broad_definition",
                "routine_classification",
                "newsgathering_criminalized",
                "iron_on_journalism"
              ]
            },
            "sentenceYears": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}