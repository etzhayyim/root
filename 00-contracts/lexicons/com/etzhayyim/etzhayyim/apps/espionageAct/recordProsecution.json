{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.espionageAct.recordProsecution",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Espionage Act / OSA / national security leak prosecution (bridges classificationReview.flagOverClassification + federal-court-docket + press-freedom)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "prosecutionId",
            "jurisdiction",
            "subjectCategory",
            "chargedAt"
          ],
          "properties": {
            "prosecutionId": {
              "type": "string"
            },
            "jurisdiction": {
              "type": "string",
              "enum": [
                "us_espionage",
                "uk_osa",
                "fr_code_penal",
                "de_stgb",
                "jp_special_secrets",
                "cn_national_security",
                "ru_ugol_kodex",
                "in_osa",
                "au_foreign_interference",
                "za_rica"
              ]
            },
            "subjectCategory": {
              "type": "string",
              "enum": [
                "whistleblower",
                "journalist",
                "contractor",
                "government_employee",
                "foreign_agent",
                "dual_national",
                "academic",
                "activist",
                "ngo_worker",
                "leaker"
              ]
            },
            "classifiedMaterial": {
              "type": "string",
              "enum": [
                "tech",
                "signals",
                "human_intel",
                "diplomatic",
                "military_ops",
                "nuclear",
                "financial",
                "economic",
                "commercial_secret",
                "constitutional"
              ]
            },
            "overClassifyVid": {
              "type": "string",
              "description": "bridges classificationReview.flagOverClassification"
            },
            "chargedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}