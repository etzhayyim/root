{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.mangaka.realtimeDraw",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Realtime sketch-to-image via img2img. Accepts a base64 PNG sketch and returns an AI-generated image synchronously.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sketchBase64"],
          "properties": {
            "sketchBase64": {
              "type": "string",
              "description": "Base64-encoded PNG of the sketch (data URI or raw base64)"
            },
            "prompt": {
              "type": "string",
              "description": "AI generation prompt"
            },
            "strength": {
              "type": "number",
              "description": "img2img strength 0.0-1.0 (how much the AI deviates from the sketch)"
            },
            "steps": {
              "type": "integer",
              "description": "Diffusion steps 4-20 (fewer = faster)"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "imageBase64": {
              "type": "string",
              "description": "Base64-encoded PNG of the generated image"
            },
            "latencyMs": {
              "type": "integer"
            },
            "status": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
