{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.mangaka.tools.placeScene",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Pregel step 4 of com.etzhayyim.apps.mangaka.composeScene3d. Composes a scene_dag JSON-LD descriptor from panel_plan + asset_refs + pose_plan. Pure CPU. ADR-2605082000 §2 — kind='mcp_tool'. SSoT: lg_mangaka.tools:tool_place_scene.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["panelPlan", "assetRefs", "posePlan"],
          "properties": {
            "panelPlan": { "type": "ref", "ref": "com.etzhayyim.apps.mangaka.tools.loadPanelPlan#panelPlan" },
            "assetRefs": { "type": "ref", "ref": "com.etzhayyim.apps.mangaka.tools.resolveAssets#assetRefs" },
            "posePlan":  { "type": "unknown", "description": "Map rkey → {label, expression, bones[], ik_targets[], root_xform}." }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "sceneDag": { "type": "unknown", "description": "JSON-LD shape consumed by kami_mangaka_scene::MangakaScene::from_jsonld." }
          }
        }
      }
    }
  }
}
