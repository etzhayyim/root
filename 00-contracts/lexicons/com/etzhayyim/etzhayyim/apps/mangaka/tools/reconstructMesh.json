{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.mangaka.tools.reconstructMesh",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "P16 step 4 of com.etzhayyim.apps.mangaka.composeCharacterVrm. Runs Hunyuan3D-2 (Tencent OSS) on the VKE render pool to turn 4–6 multi-view images into a textured binary-glTF mesh. Self-hosted on `ghcr.io/etzhayyim/hunyuan3d-2:0.2` (open-weight, no external API). ADR-2605082000 §2 — kind='mcp_tool'. SSoT: lg_mangaka.tools:tool_reconstruct_mesh.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["multiviewImages"],
          "properties": {
            "multiviewImages": {
              "type": "array",
              "items": { "type": "string" },
              "minLength": 4,
              "maxLength": 6,
              "description": "Base64 PNG views from generateMultiviewAnime."
            },
            "polyBudget": {
              "type": "integer",
              "minimum": 5000,
              "maximum": 100000,
              "description": "Decimation target tri count. Default 50000 (VRM budget)."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "meshGlbB64": {
              "type": "string",
              "description": "Base64-encoded binary glTF (mesh + albedo texture)."
            },
            "triCount": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
