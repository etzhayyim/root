{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.mangaka.saveDocument",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Save (upsert) a manga document. docId/convoId are string identifiers (AT-style rkey-compatible) — tightened from F2 bootstrap stub on 2026-05-12 to support ghosthacker import.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "docId": { "type": "string" },
            "name": { "type": "string" },
            "document": { "type": "string" },
            "convoId": { "type": "string" }
          },
          "required": ["docId"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "status": { "type": "string" },
            "docId": { "type": "string" }
          },
          "required": []
        }
      }
    }
  }
}
