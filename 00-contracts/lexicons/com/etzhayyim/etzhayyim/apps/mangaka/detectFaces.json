{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.mangaka.detectFaces",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Detect character faces in an ai-image node (or batch all ai-images in a doc) and write normalized face coords back to the node's _faces[] field. Powers fukidashi tail face-anchoring.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["docId"],
          "properties": {
            "docId": { "type": "string" },
            "imageNid": { "type": "string", "description": "Optional. If set, only detect on this one ai-image; otherwise batch all ai-images in the doc." }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "status": { "type": "string" },
            "docId": { "type": "string" },
            "imageNid": { "type": "string" },
            "method": { "type": "string", "description": "Detector used: 'torch-mtcnn' (preferred) or 'heuristic' (fallback)" },
            "faces": {
              "type": "array",
              "description": "Per-image face boxes (single-image mode). cx/cy/w/h are normalized 0-1 within the image.",
              "items": { "type": "string" }
            },
            "latencyMs": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
