  "id": "com.etzhayyim.apps.mangaka.dedupeEdges",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Remove duplicate edge_contains rows per (src_vid, dst_vid, label). RisingWave does not enforce PK uniqueness on non-streaming INSERTs; this retro-cleans accumulated dups. Idempotent.",
      "input": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {} }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "chapter": { "type": "unknown" },
            "page":    { "type": "unknown" },
            "work":    { "type": "unknown" }
          }
        }
      }
    }
  }
}
