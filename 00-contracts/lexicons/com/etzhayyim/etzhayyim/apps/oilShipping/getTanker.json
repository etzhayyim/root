{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.oilShipping.getTanker",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a tanker by DID or IMO number.",
      "x-bootstrap": true,
      "parameters": { "type": "params", "properties": { "did": { "type": "string", "format": "did" }, "imo": { "type": "string", "description": "7-digit IMO number (alternative lookup key)" } } },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "imo": { "type": "string" }, "name": { "type": "string" }, "tankerClass": { "type": "string" }, "dwt": { "type": "number" }, "flagState": { "type": "string" }, "ownerDid": { "type": "string", "format": "did" }, "operatorDid": { "type": "string", "format": "did" }, "darkFleetSuspect": { "type": "boolean" }, "darkFleetReason": { "type": "string" }, "sanctionsScreening": { "type": "string" }, "linkedVesselDid": { "type": "string", "format": "did", "description": "vessel.etzhayyim.com DID with same IMO" } } } }
    }
  }
}
