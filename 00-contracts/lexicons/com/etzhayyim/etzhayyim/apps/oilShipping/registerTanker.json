{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.oilShipping.registerTanker",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a crude/product tanker (vessel domain superset). Path-based DID: did:web:oil-shipping.etzhayyim.com:tanker:imo:{imo}. Includes dark-fleet flagging.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["imo", "tankerClass"],
          "properties": {
            "imo": { "type": "string", "description": "IMO number (7-digit)" },
            "name": { "type": "string" },
            "tankerClass": { "type": "string", "enum": ["ulcc", "vlcc", "suezmax", "aframax", "panamax", "lr2", "lr1", "mr", "handy"] },
            "dwt": { "type": "number", "description": "deadweight tonnage" },
            "flagState": { "type": "string", "description": "ISO 3166-1 alpha-3" },
            "ownerDid": { "type": "string", "format": "did", "description": "legal-entity DID" },
            "operatorDid": { "type": "string", "format": "did" },
            "darkFleetSuspect": { "type": "boolean", "default": false },
            "darkFleetReason": { "type": "string", "enum": ["ais-spoofing", "ship-to-ship-transfer", "sanctioned-flag-hopping", "shadow-insurance"] },
            "sanctionsScreening": { "type": "string", "enum": ["clear", "flagged", "blocked"], "default": "clear" }
          }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "uri": { "type": "string", "format": "at-uri" } } } }
    }
  }
}
