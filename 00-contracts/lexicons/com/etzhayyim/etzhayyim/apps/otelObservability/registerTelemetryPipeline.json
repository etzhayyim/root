{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.otelObservability.registerTelemetryPipeline",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "OpenTelemetry pipeline registry (bridges oss-vuln + cyber-resilience-stress + slsa-supply-chain + ai-governance)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "pipelineId",
            "signalTypes",
            "registeredAt"
          ],
          "properties": {
            "pipelineId": {
              "type": "string"
            },
            "operatorLei": {
              "type": "string"
            },
            "signalTypes": {
              "type": "string",
              "description": "comma: traces,metrics,logs,profiles"
            },
            "collectorVersion": {
              "type": "string"
            },
            "exporters": {
              "type": "string",
              "description": "comma: otlp,prometheus,jaeger,zipkin,loki,datadog,honeycomb"
            },
            "protocol": {
              "type": "string",
              "enum": [
                "otlp_http",
                "otlp_grpc",
                "prometheus_remote_write",
                "loki_push"
              ]
            },
            "samplingStrategy": {
              "type": "string",
              "enum": [
                "always_on",
                "always_off",
                "parent_based",
                "probabilistic",
                "tail_based",
                "head_adaptive"
              ]
            },
            "registeredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}