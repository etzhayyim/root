{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.cbamExtension.registerScopeExpansion",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "CBAM / carbon border extension scope addition (bridges eu-cbam + critical-minerals + sovereign-debt + wto-dispute)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "extensionId",
            "jurisdictionRegime",
            "sectorAddedHs",
            "effectiveFrom"
          ],
          "properties": {
            "extensionId": {
              "type": "string"
            },
            "jurisdictionRegime": {
              "type": "string",
              "enum": [
                "eu_cbam",
                "uk_cbam",
                "ca_cbca",
                "us_ccia",
                "au_ccr",
                "jp_mf_cba"
              ]
            },
            "sectorAddedHs": {
              "type": "string",
              "description": "HS 2-digit range"
            },
            "coveredGhgScopes": {
              "type": "string",
              "description": "comma: direct,indirect,downstream"
            },
            "defaultEmissionFactor": {
              "type": "number"
            },
            "defaultFactorSource": {
              "type": "string"
            },
            "transitionalPeriodYears": {
              "type": "integer"
            },
            "effectiveFrom": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}