{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.railCrossBorder.recordCorridorFlow",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "International rail corridor flow (OTIF / OSJD / CIM / SMGS — bridges carrier-schedule + customs-clearance + logistics-lastmile + urban-mobility)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flowId",
            "corridorName",
            "originIso3",
            "destinationIso3",
            "regimeDocument",
            "periodMonth",
            "recordedAt"
          ],
          "properties": {
            "flowId": {
              "type": "string"
            },
            "operatorLei": {
              "type": "string"
            },
            "corridorName": {
              "type": "string"
            },
            "originIso3": {
              "type": "string"
            },
            "destinationIso3": {
              "type": "string"
            },
            "regimeDocument": {
              "type": "string",
              "enum": [
                "cim_smgs",
                "cim",
                "smgs",
                "uz_smgs",
                "amtrak",
                "intercity"
              ]
            },
            "gaugeProfile": {
              "type": "string",
              "enum": [
                "standard",
                "broad_1520",
                "broad_1676",
                "cape",
                "iberian",
                "dual",
                "metre"
              ]
            },
            "wagonCount": {
              "type": "integer"
            },
            "tonnesNet": {
              "type": "number"
            },
            "transitHours": {
              "type": "number"
            },
            "periodMonth": {
              "type": "string"
            },
            "recordedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}