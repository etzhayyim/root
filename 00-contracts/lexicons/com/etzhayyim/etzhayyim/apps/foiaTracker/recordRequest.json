{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.foiaTracker.recordRequest",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "FOIA / EU Reg 1049 / public records request (bridges igAudit.flagRecommendationStall + press-freedom + enforcement-action)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "requestId",
            "requesterCategory",
            "regime",
            "filedAt"
          ],
          "properties": {
            "requestId": {
              "type": "string"
            },
            "requesterCategory": {
              "type": "string",
              "enum": [
                "journalist",
                "academic",
                "nonprofit",
                "commercial",
                "public_interest",
                "anonymous",
                "industry",
                "political",
                "individual",
                "government"
              ]
            },
            "regime": {
              "type": "string",
              "enum": [
                "us_foia",
                "us_privacy_act",
                "eu_reg_1049",
                "uk_foia",
                "ca_atia",
                "au_foi",
                "jp_joho_kokai",
                "mex_transparency",
                "br_lai",
                "in_rti"
              ]
            },
            "subjectAgency": {
              "type": "string"
            },
            "recommendationStallVid": {
              "type": "string",
              "description": "bridges igAudit.flagRecommendationStall"
            },
            "filedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}