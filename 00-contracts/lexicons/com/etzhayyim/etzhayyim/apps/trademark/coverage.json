{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.trademark.coverage",
  "defs": {
    "main": {
      "type": "query",
      "description": "Trademark coverage by jurisdiction with Nice class histogram.",
      "parameters": {
        "type": "params",
        "properties": {"jurisdiction": {"type": "string"}}
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["jurisdiction", "total", "byNiceClass", "reportedAt"],
          "properties": {
            "jurisdiction": {"type": "string"},
            "total": {"type": "integer"},
            "byNiceClass": {"type": "unknown"},
            "reportedAt": {"type": "string", "format": "datetime"}
          }
        }
      }
    }
  }
}
