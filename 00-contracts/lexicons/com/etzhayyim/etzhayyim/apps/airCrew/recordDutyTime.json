{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airCrew.recordDutyTime",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record duty time and rest period for a crew member.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["crew_did", "duty_start", "duty_end"],
          "properties": {
            "crew_did": { "type": "string" },
            "duty_start": { "type": "string" },
            "duty_end": { "type": "string" },
            "rest_period_hrs": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
