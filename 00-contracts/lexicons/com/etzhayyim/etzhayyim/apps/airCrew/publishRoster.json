{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airCrew.publishRoster",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Publish crew roster for a carrier and period.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["carrier_code", "period", "base_airport"],
          "properties": {
            "carrier_code": { "type": "string" },
            "period": { "type": "string" },
            "base_airport": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
