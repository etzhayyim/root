{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.artemisLunar.flagSafetyZoneOverlap",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Artemis safety zone overlap / conflict (bridges space-traffic + orbital-debris + laws-autonomous-weapons)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "conflictId",
            "activityVid",
            "overlappingSignatoryIso3",
            "issueKind",
            "reportedAt"
          ],
          "properties": {
            "conflictId": {
              "type": "string"
            },
            "activityVid": {
              "type": "string",
              "description": "bridges recordMissionActivity"
            },
            "overlappingSignatoryIso3": {
              "type": "string"
            },
            "issueKind": {
              "type": "string",
              "enum": [
                "safety_zone_overlap",
                "heritage_site",
                "resource_claim",
                "mining_dispute",
                "traffic_management",
                "communications_interference"
              ]
            },
            "copuosWorkingGroup": {
              "type": "string"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "escalationTier": {
              "type": "string",
              "enum": [
                "routine",
                "severe",
                "critical"
              ]
            }
          }
        }
      }
    }
  }
}