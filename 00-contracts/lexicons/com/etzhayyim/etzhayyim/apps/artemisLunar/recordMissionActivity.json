{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.artemisLunar.recordMissionActivity",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Artemis Accords / Moon Treaty / COPUOS resource activity (bridges space-traffic + orbital-debris + critical-minerals + iaea-safeguards)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "activityId",
            "signatoryIso3",
            "missionName",
            "activityKind",
            "locationBody",
            "startedAt",
            "recordedAt"
          ],
          "properties": {
            "activityId": {
              "type": "string"
            },
            "signatoryIso3": {
              "type": "string"
            },
            "missionName": {
              "type": "string"
            },
            "activityKind": {
              "type": "string",
              "enum": [
                "landing",
                "sample_return",
                "resource_extraction",
                "habitat",
                "power",
                "refueling",
                "scientific",
                "rover_ops",
                "constellation_ops"
              ]
            },
            "locationBody": {
              "type": "string",
              "enum": [
                "moon",
                "mars",
                "asteroid",
                "europa",
                "titan",
                "other"
              ]
            },
            "coordinates": {
              "type": "string"
            },
            "peacefulUseDeclared": {
              "type": "boolean"
            },
            "startedAt": {
              "type": "string",
              "format": "datetime"
            },
            "recordedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}