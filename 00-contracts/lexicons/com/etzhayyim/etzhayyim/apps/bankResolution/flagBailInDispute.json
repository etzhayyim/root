{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.bankResolution.flagBailInDispute",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Bail-in / NCWO / creditor priority litigation (bridges subordinatedDebt.flagResolution + civil-liability + federal-court-docket)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "actionVid",
            "disputeKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "actionVid": {
              "type": "string",
              "description": "bridges recordResolutionAction"
            },
            "disputeKind": {
              "type": "string",
              "enum": [
                "ncwo_breach",
                "creditor_pari_passu",
                "hybrid_treatment",
                "cross_border_recognition",
                "statutory_bail_in",
                "conversion_rate_manipulated",
                "lender_information_gap",
                "credit_event_trigger",
                "isda_determination"
              ]
            },
            "estClaimBusd": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}