{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.antitrustDma.designateGatekeeper",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "EU DMA gatekeeper / UK DMCC / China SAMR platform designation (bridges ofac-sanctions + misinformation)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "designationId",
            "regime",
            "platformLei",
            "cpsCategory",
            "designatedAt"
          ],
          "properties": {
            "designationId": {
              "type": "string"
            },
            "regime": {
              "type": "string",
              "enum": [
                "eu_dma",
                "uk_dmcc",
                "china_samr",
                "us_doj",
                "us_ftc",
                "japan_jftc",
                "kr_kftc"
              ]
            },
            "platformLei": {
              "type": "string"
            },
            "cpsCategory": {
              "type": "string",
              "enum": [
                "search",
                "social",
                "video",
                "app_store",
                "os",
                "browser",
                "cloud",
                "messaging",
                "ads",
                "marketplace",
                "ai_platform"
              ]
            },
            "revenueEur": {
              "type": "number"
            },
            "eeauserCount": {
              "type": "integer"
            },
            "designatedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}