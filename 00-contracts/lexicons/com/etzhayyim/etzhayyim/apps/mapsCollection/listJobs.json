{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.mapsCollection.listJobs",
  "defs": {
    "main": {
      "type": "query",
      "description": "List maps collection jobs (control plane).",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "properties": {
          "jobType": { "type": "string" },
          "sourceDid": { "type": "string", "format": "did" },
          "country": { "type": "string" },
          "frequency": { "type": "string" },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "required": ["jobs", "total", "offset", "limit"], "properties": { "jobs": { "type": "array", "items": { "type": "object", "properties": { "uri": { "type": "string", "format": "at-uri" }, "jobType": { "type": "string" }, "sourceDid": { "type": "string", "format": "did" }, "country": { "type": "string" }, "scheduledAt": { "type": "string", "format": "datetime" } } } }, "total": { "type": "integer" }, "offset": { "type": "integer" }, "limit": { "type": "integer" } } } }
    }
  }
}
