{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.mapsCollection.registerJob",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a maps collection job (control plane). Coordinates web crawl / OSM diff / Overpass query / Microsoft Building Footprint ingestion for maps.etzhayyim.com.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["jobType", "sourceDid"],
          "properties": {
            "jobType": { "type": "string", "enum": ["overpass", "osm-diff", "ms-building-footprint", "google-places", "openaddresses", "naturalearth", "wikidata-poi", "web-crawl"] },
            "sourceDid": { "type": "string", "format": "did", "description": "source DID under maps.etzhayyim.com" },
            "bbox": { "type": "array", "items": { "type": "number" }, "description": "[minLon, minLat, maxLon, maxLat]" },
            "country": { "type": "string" },
            "scheduledAt": { "type": "string", "format": "datetime" },
            "frequency": { "type": "string", "enum": ["once", "daily", "weekly", "monthly", "quarterly"] },
            "outputCollection": { "type": "string", "description": "maps.etzhayyim.com NSID for derived records" }
          }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "uri": { "type": "string", "format": "at-uri" } } } }
    }
  }
}
