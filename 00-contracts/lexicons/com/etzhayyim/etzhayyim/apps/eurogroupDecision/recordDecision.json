{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.eurogroupDecision.recordDecision",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Eurogroup political-body decision (bridges euStabilityMechanism.flagBoardDispute + euTrilogue + euSummitConclusion)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "decisionId",
            "topic",
            "formatKind",
            "issuedAt"
          ],
          "properties": {
            "decisionId": {
              "type": "string"
            },
            "topic": {
              "type": "string",
              "enum": [
                "fiscal_stance",
                "banking_union",
                "capital_markets_union",
                "esm_treaty",
                "digital_euro",
                "euro_excl_in",
                "convergence",
                "sgp_review",
                "budget_recommendation",
                "macro_imbalance",
                "ngeu",
                "rrf"
              ]
            },
            "formatKind": {
              "type": "string",
              "enum": [
                "plenary",
                "inclusive",
                "wkg",
                "high_level",
                "preparatory",
                "tripartite",
                "press_remarks",
                "statement",
                "conclusions",
                "term_sheet"
              ]
            },
            "boardDisputeVid": {
              "type": "string",
              "description": "bridges euStabilityMechanism.flagBoardDispute"
            },
            "issuedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}