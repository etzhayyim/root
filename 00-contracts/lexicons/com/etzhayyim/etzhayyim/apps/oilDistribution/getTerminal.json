{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.oilDistribution.getTerminal",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a downstream terminal by DID.",
      "x-bootstrap": true,
      "parameters": { "type": "params", "required": ["did"], "properties": { "did": { "type": "string", "format": "did" } } },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "name": { "type": "string" }, "country": { "type": "string" }, "terminalType": { "type": "string" }, "operatorDid": { "type": "string", "format": "did" }, "throughputBopd": { "type": "number" }, "storageMmbbl": { "type": "number" }, "modes": { "type": "array", "items": { "type": "string" } }, "products": { "type": "array", "items": { "type": "string" } } } } }
    }
  }
}
