{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.gamePlayUploader.reviewUpload",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Review an uploaded gameplay video for eligibility, safety, and domain coverage value.",
      "input": { "encoding": "application/json", "schema": { "type": "object", "required": ["uploadId", "decision"], "properties": { "uploadId": { "type": "string" }, "decision": { "type": "string", "enum": ["approved", "rejected", "needsReview"] }, "reviewerDid": { "type": "string" }, "notes": { "type": "string" }, "qualityScore": { "type": "number" } } } },
      "output": { "encoding": "application/json", "schema": { "type": "object", "required": ["uploadId", "decision"], "properties": { "uploadId": { "type": "string" }, "decision": { "type": "string" }, "rewardEstimateJpy": { "type": "integer" } } } }
    }
  }
}
