{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.gamePlayUploader.registerParticipant",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a gameplay-video contributor for the ¥100/hour domain coverage campaign.",
      "input": { "encoding": "application/json", "schema": { "type": "object", "required": ["participantDid"], "properties": { "participantDid": { "type": "string" }, "displayName": { "type": "string" }, "ageBand": { "type": "string", "enum": ["kid", "adult", "unknown"] }, "payoutHandle": { "type": "string" }, "guardianConsentRef": { "type": "string" } } } },
      "output": { "encoding": "application/json", "schema": { "type": "object", "required": ["participantId", "status"], "properties": { "participantId": { "type": "string" }, "status": { "type": "string" } } } }
    }
  }
}
