{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.transshipmentEvasion.recordInvestigation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "AD/CVD transshipment / circumvention investigation (bridges tradeRemedy.flagTariffOutcome + customs-declaration + logistics-container)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "investigationId",
            "initiatingCountryIso3",
            "routingPattern",
            "originCountryIso3",
            "transshipCountryIso3",
            "initiatedAt"
          ],
          "properties": {
            "investigationId": {
              "type": "string"
            },
            "initiatingCountryIso3": {
              "type": "string"
            },
            "routingPattern": {
              "type": "string",
              "enum": [
                "direct_relabel",
                "minor_processing",
                "hub_country_laundering",
                "ftz_manipulation",
                "document_forgery",
                "ec_commerce_split",
                "low_value_parcel",
                "re_classification",
                "tariff_line_drift"
              ]
            },
            "originCountryIso3": {
              "type": "string"
            },
            "transshipCountryIso3": {
              "type": "string"
            },
            "tariffOutcomeVid": {
              "type": "string",
              "description": "bridges tradeRemedy.flagTariffOutcome"
            },
            "initiatedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}