{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.universalJurisdiction.flagExecutiveInterference",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Executive interference / immunity plea / extradition blocking (bridges pocIhl.flagAccountabilityGap + federal-court-docket + press-freedom)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "caseVid",
            "interferenceKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "caseVid": {
              "type": "string",
              "description": "bridges recordUjCase"
            },
            "interferenceKind": {
              "type": "string",
              "enum": [
                "political_pressure",
                "statehood_immunity",
                "diplomatic_immunity",
                "sitting_official",
                "extradition_block",
                "refugee_conversion",
                "policy_vicissitude",
                "budget_cut",
                "pardoning",
                "visa_block",
                "amnesty_by_inaction"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}