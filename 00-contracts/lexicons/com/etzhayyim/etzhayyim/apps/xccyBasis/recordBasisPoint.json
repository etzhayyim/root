{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.xccyBasis.recordBasisPoint",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Cross-currency basis swap snapshot (bridges treasuryMarketStress.flagFedIntervention + fx-swap-lines + stablecoin-reserves)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "snapshotId",
            "pair",
            "tenor",
            "asOfTime"
          ],
          "properties": {
            "snapshotId": {
              "type": "string"
            },
            "pair": {
              "type": "string",
              "enum": [
                "usd_eur",
                "usd_jpy",
                "usd_cny",
                "usd_cad",
                "usd_gbp",
                "eur_jpy",
                "usd_brl",
                "usd_mxn",
                "usd_krw",
                "usd_inr",
                "usd_zar",
                "usd_try"
              ]
            },
            "tenor": {
              "type": "string",
              "enum": [
                "1m",
                "3m",
                "6m",
                "1y",
                "2y",
                "5y",
                "10y",
                "30y",
                "ois_spread",
                "sabr_smile",
                "forward_start"
              ]
            },
            "basisBps": {
              "type": "number"
            },
            "stressVid": {
              "type": "string",
              "description": "bridges treasuryMarketStress.flagFedIntervention"
            },
            "asOfTime": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}