{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.commodityPhysicalDelivery.recordDelivery",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Physical delivery of commodity futures (commodity-trade+refiner-product+hormuz-cargo bridge)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "deliveryId",
            "settlementVid",
            "volumeBbl",
            "deliveredAt"
          ],
          "properties": {
            "deliveryId": {
              "type": "string"
            },
            "settlementVid": {
              "type": "string",
              "description": "bridges open-commodity-trade settleContract"
            },
            "refinerReceiptVid": {
              "type": "string",
              "description": "bridges open-refiner-product / open-asia-refinery"
            },
            "hormuzCargoVid": {
              "type": "string",
              "description": "bridges open-hormuz-cargo"
            },
            "customsClearanceVid": {
              "type": "string",
              "description": "bridges open-customs-clearance"
            },
            "deliveryPortVid": {
              "type": "string"
            },
            "volumeBbl": {
              "type": "number"
            },
            "deliveredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}