{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.commodityPhysicalDelivery.recordStorageBalance",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Storage terminal balance after delivery",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "balanceId",
            "deliveryVid",
            "closingBbl",
            "recordedAt"
          ],
          "properties": {
            "balanceId": {
              "type": "string"
            },
            "deliveryVid": {
              "type": "string",
              "description": "bridges recordDelivery"
            },
            "terminalPortVid": {
              "type": "string"
            },
            "openingBbl": {
              "type": "number"
            },
            "closingBbl": {
              "type": "number"
            },
            "daysToCovered": {
              "type": "number"
            },
            "recordedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "inventoryTier": {
              "type": "string",
              "enum": [
                "critical",
                "tight",
                "adequate"
              ]
            }
          }
        }
      }
    }
  }
}