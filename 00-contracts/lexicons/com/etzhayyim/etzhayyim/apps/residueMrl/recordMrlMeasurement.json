{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.residueMrl.recordMrlMeasurement",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Pesticide / veterinary drug MRL measurement (Codex CCPR / EU MRL / FDA / JECFA — bridges livestockAbx.flagGrowthPromoter + food-safety + rasff)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "measurementId",
            "compoundName",
            "compoundClass",
            "matrix",
            "countryIso3",
            "concentrationUgKg",
            "sampledAt"
          ],
          "properties": {
            "measurementId": {
              "type": "string"
            },
            "compoundName": {
              "type": "string"
            },
            "compoundClass": {
              "type": "string",
              "enum": [
                "organophosphate",
                "organochlorine",
                "carbamate",
                "pyrethroid",
                "neonicotinoid",
                "glyphosate",
                "veterinary_antibiotic",
                "hormone",
                "anthelmintic",
                "fungicide"
              ]
            },
            "matrix": {
              "type": "string",
              "enum": [
                "milk",
                "egg",
                "beef_muscle",
                "beef_fat",
                "pork",
                "poultry",
                "honey",
                "fish",
                "shrimp",
                "fruit",
                "vegetable",
                "cereal",
                "water"
              ]
            },
            "countryIso3": {
              "type": "string"
            },
            "concentrationUgKg": {
              "type": "number"
            },
            "codexMrlUgKg": {
              "type": "number"
            },
            "sampledAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "complianceTier": {
              "type": "string",
              "enum": [
                "compliant",
                "exceeds",
                "severe"
              ]
            }
          }
        }
      }
    }
  }
}