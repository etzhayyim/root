{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.amicusBrief.recordBriefFiling",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Amicus curiae brief filing (bridges scotusDocket.flagDoctrinalShift + federal-court-docket + civil-liability)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "briefId",
            "courtLevel",
            "caseNumber",
            "amicusKind",
            "filedAt"
          ],
          "properties": {
            "briefId": {
              "type": "string"
            },
            "courtLevel": {
              "type": "string",
              "enum": [
                "scotus",
                "ca_circuit",
                "district",
                "state_supreme",
                "appellate_state",
                "intl_tribunal",
                "echr",
                "cjeu",
                "icj",
                "iccpr"
              ]
            },
            "caseNumber": {
              "type": "string"
            },
            "amicusKind": {
              "type": "string",
              "enum": [
                "industry_coalition",
                "state_ag",
                "academic",
                "ngo_civil_rights",
                "ngo_environmental",
                "religious",
                "former_officials",
                "bar_association",
                "trade_association",
                "scholars_intl_law"
              ]
            },
            "doctrinalShiftVid": {
              "type": "string",
              "description": "bridges scotusDocket.flagDoctrinalShift"
            },
            "supportsParty": {
              "type": "string",
              "enum": [
                "petitioner",
                "respondent",
                "neither",
                "partial",
                "cross"
              ]
            },
            "filedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}