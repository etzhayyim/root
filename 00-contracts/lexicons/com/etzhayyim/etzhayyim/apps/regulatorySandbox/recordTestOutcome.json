{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.regulatorySandbox.recordTestOutcome",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Sandbox test outcome (bridges ai-governance + cyber-resilience-stress + icpen-consumer)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "outcomeId",
            "cohortVid",
            "product",
            "outcomeKind",
            "reportedAt"
          ],
          "properties": {
            "outcomeId": {
              "type": "string"
            },
            "cohortVid": {
              "type": "string",
              "description": "bridges registerCohort"
            },
            "participantLei": {
              "type": "string"
            },
            "product": {
              "type": "string"
            },
            "outcomeKind": {
              "type": "string",
              "enum": [
                "graduated",
                "authorised",
                "withdrawn",
                "extended",
                "failed",
                "discontinued"
              ]
            },
            "consumerHarmFound": {
              "type": "boolean"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "valueTier": {
              "type": "string",
              "enum": [
                "halted",
                "iterating",
                "positive"
              ]
            }
          }
        }
      }
    }
  }
}