{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openTransit.reportDelay",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Report a transit delay on a route (GTFS-RT equivalent). FEEL severity: major (>= 30min), moderate (10-29min), minor. Starts BPMN open_transit_report_delay.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["agencyOrgId","routeVertexId","delayMinutes","reportedAt"],
          "properties": {
            "agencyOrgId":   { "type": "string" },
            "routeVertexId": { "type": "string" },
            "stopSequence":  { "type": "integer" },
            "delayMinutes":  { "type": "integer" },
            "reason":        { "type": "string" },
            "reportedAt":    { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
            "severity": { "type": "string", "enum": ["minor","moderate","major"] },
            "requirePublicNotice": { "type": "boolean" },
            "instanceKey": { "type": "integer" }, "error": { "type": "string" }
          }
        }
      }
    }
  }
}
