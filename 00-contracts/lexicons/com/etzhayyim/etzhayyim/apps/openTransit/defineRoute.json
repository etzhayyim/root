{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openTransit.defineRoute",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a transit route (GTFS-equivalent). Starts BPMN open_transit_define_route.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["agencyOrgId","routeCode","routeType"],
          "properties": {
            "agencyOrgId":  { "type": "string" },
            "routeCode":    { "type": "string" },
            "routeType":    { "type": "string", "enum": ["bus","tram","metro","rail","ferry","cable","gondola","funicular"] },
            "name":         { "type": "string" },
            "headsignFwd":  { "type": "string" },
            "headsignRev":  { "type": "string" },
            "color":        { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" }, "error": { "type": "string" }
          }
        }
      }
    }
  }
}
