{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.bearerShare.flagLoophole",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Bearer share loophole / circumvention / FATF mutual eval finding (bridges freeportRegistry.flagOpacityIssue + beneficial-ownership + fatf-travel-rule)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "recordVid",
            "loopholeKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "recordVid": {
              "type": "string",
              "description": "bridges recordAbolition"
            },
            "loopholeKind": {
              "type": "string",
              "enum": [
                "electronic_bearer",
                "cross_border_ibc",
                "nominee_for_nominee",
                "trust_settlor_hidden",
                "foundation_protector",
                "bearer_debt",
                "participating_note",
                "tokenized_opaque",
                "layered_succession",
                "grandfathered"
              ]
            },
            "fatfGrade": {
              "type": "string",
              "enum": [
                "compliant",
                "largely_compliant",
                "partially_compliant",
                "non_compliant",
                "not_applicable"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}