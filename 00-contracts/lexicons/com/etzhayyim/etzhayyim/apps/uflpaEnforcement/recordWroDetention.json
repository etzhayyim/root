{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.uflpaEnforcement.recordWroDetention",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "UFLPA / Withhold Release Order / CBP detention (bridges modernSlavery.flagInadequateDisclosure + forced-labor + customs-declaration)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "actionId",
            "agency",
            "actionKind",
            "commodity",
            "issuedAt"
          ],
          "properties": {
            "actionId": {
              "type": "string"
            },
            "agency": {
              "type": "string",
              "enum": [
                "us_cbp",
                "us_dhs_uflpa_task_force",
                "us_doc",
                "eu_commission",
                "uk_border_force",
                "ca_cbsa",
                "au_border_force",
                "nl_customs",
                "thb_dutch_ftc",
                "jp_customs"
              ]
            },
            "actionKind": {
              "type": "string",
              "enum": [
                "wro",
                "finding",
                "detention_notice",
                "exclusion_entity",
                "summary_rebuttal",
                "seizure",
                "forced_reexport",
                "auto_exclude_ppp",
                "entity_list",
                "reclassification"
              ]
            },
            "commodity": {
              "type": "string",
              "enum": [
                "cotton_textile",
                "polysilicon_solar",
                "tomato",
                "batch_processing",
                "aluminum",
                "electronics",
                "apparel",
                "fish_seafood",
                "rubber_glove",
                "timber",
                "down_feather",
                "mica",
                "silver"
              ]
            },
            "modernSlaveryVid": {
              "type": "string",
              "description": "bridges modernSlavery.flagInadequateDisclosure"
            },
            "issuedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}