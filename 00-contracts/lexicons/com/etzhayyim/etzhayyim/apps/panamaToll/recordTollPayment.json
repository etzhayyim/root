{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.panamaToll.recordTollPayment",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "通行料支払",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "paymentId",
            "imo",
            "baseTollUsd",
            "totalTollUsd",
            "paidAt"
          ],
          "properties": {
            "paymentId": {
              "type": "string"
            },
            "transitVid": {
              "type": "string"
            },
            "imo": {
              "type": "string"
            },
            "baseTollUsd": {
              "type": "number"
            },
            "auctionPremiumUsd": {
              "type": "number"
            },
            "totalTollUsd": {
              "type": "number"
            },
            "paidAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
