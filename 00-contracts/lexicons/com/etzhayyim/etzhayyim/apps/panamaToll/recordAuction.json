{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.panamaToll.recordAuction",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "特別 auction",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "auctionId",
            "slotDate",
            "lane",
            "winningBidUsd",
            "closedAt"
          ],
          "properties": {
            "auctionId": {
              "type": "string"
            },
            "slotDate": {
              "type": "string",
              "format": "date"
            },
            "lane": {
              "type": "string"
            },
            "winningBidUsd": {
              "type": "number"
            },
            "bidderImo": {
              "type": "string"
            },
            "bidCount": {
              "type": "integer"
            },
            "closedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
