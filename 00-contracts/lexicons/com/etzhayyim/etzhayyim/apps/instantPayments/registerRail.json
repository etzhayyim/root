{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.instantPayments.registerRail",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Instant payment rail (FedNow / UPI / Pix / SEPA Inst / FAST SG / Zengin NT / DuitNow — bridges psd3-open-finance + cbdc + fatf-travel-rule + antitrust-dma)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "railId",
            "railName",
            "countryIso3",
            "launchedAt"
          ],
          "properties": {
            "railId": {
              "type": "string"
            },
            "operatorLei": {
              "type": "string"
            },
            "railName": {
              "type": "string",
              "enum": [
                "fednow",
                "upi",
                "pix",
                "sepa_inst",
                "fast_sg",
                "zengin_nt",
                "duitnow",
                "rtp_us",
                "nnss_gb",
                "target_ips",
                "paynow"
              ]
            },
            "countryIso3": {
              "type": "string"
            },
            "launchedAt": {
              "type": "string",
              "format": "datetime"
            },
            "settlementCurrency": {
              "type": "string"
            },
            "maxTxnAmount": {
              "type": "number"
            },
            "targetSlaSec": {
              "type": "number"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}