{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.arcticTrafficForecast.forecastSeason",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "NSR/NWP season forecast (arctic-nsr + carrier-schedule + freight-rate + climate)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "forecastId",
            "route",
            "forecastYear",
            "publishedAt"
          ],
          "properties": {
            "forecastId": {
              "type": "string"
            },
            "route": {
              "type": "string",
              "enum": [
                "NSR",
                "NWP",
                "TRANSPOLAR"
              ]
            },
            "forecastYear": {
              "type": "integer"
            },
            "iceExtentKm2": {
              "type": "number"
            },
            "expectedTransitCount": {
              "type": "integer"
            },
            "avgFreightRateUsdTeu": {
              "type": "number"
            },
            "co2ReductionVsSuezPct": {
              "type": "number"
            },
            "publishedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "demandTier": {
              "type": "string",
              "enum": [
                "low",
                "moderate",
                "high"
              ]
            }
          }
        }
      }
    }
  }
}