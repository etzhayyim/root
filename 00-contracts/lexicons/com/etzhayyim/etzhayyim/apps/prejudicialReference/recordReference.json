{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.prejudicialReference.recordReference",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Preliminary reference to CJEU (Art 267 TFEU) (bridges grandChamberRuling.flagDoctrinalShift + judicial-review-gdpr + schrems-challenge)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "referenceId",
            "referringCourtCountry",
            "courtLevel",
            "questionKind",
            "submittedAt"
          ],
          "properties": {
            "referenceId": {
              "type": "string"
            },
            "referringCourtCountry": {
              "type": "string"
            },
            "courtLevel": {
              "type": "string",
              "enum": [
                "court_of_last_instance",
                "intermediate",
                "first_instance",
                "constitutional",
                "competition",
                "administrative",
                "labor",
                "tax",
                "tribunale",
                "audiencia"
              ]
            },
            "questionKind": {
              "type": "string",
              "enum": [
                "interpretation",
                "validity",
                "procedural",
                "interplay_instruments",
                "prior_ruling_scope",
                "temporal_effect",
                "application_methodology",
                "direct_effect",
                "consistency",
                "reasonableness",
                "charter_compatibility"
              ]
            },
            "doctrinalShiftVid": {
              "type": "string",
              "description": "bridges grandChamberRuling.flagDoctrinalShift"
            },
            "submittedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}