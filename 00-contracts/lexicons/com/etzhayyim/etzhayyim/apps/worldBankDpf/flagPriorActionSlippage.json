{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.worldBankDpf.flagPriorActionSlippage",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Prior action slippage / waiver request / reform reversal (bridges imfArticleIv.flagProgramRequest + sovereign-debt)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "operationVid",
            "issueKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "operationVid": {
              "type": "string",
              "description": "bridges recordOperation"
            },
            "issueKind": {
              "type": "string",
              "enum": [
                "prior_action_missed",
                "waiver_requested",
                "reform_reversal",
                "conditionality_stretch",
                "disbursement_delay",
                "next_tranche_blocked",
                "program_off_track"
              ]
            },
            "affectedTrancheBusd": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}