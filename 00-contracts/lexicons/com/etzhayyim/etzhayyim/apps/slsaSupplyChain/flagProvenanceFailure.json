{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.slsaSupplyChain.flagProvenanceFailure",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Verification failure / tampered attestation / stolen signing key",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "failureId",
            "failureKind",
            "reportedAt"
          ],
          "properties": {
            "failureId": {
              "type": "string"
            },
            "attestationVid": {
              "type": "string",
              "description": "bridges registerAttestation"
            },
            "failureKind": {
              "type": "string",
              "enum": [
                "signature_invalid",
                "replay",
                "tampered_digest",
                "stolen_key",
                "revoked_cert",
                "unsigned"
              ]
            },
            "advisoryVid": {
              "type": "string",
              "description": "bridges open-oss-vuln"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}