{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.opec.recordComplianceReport",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "OPEC+ compliance レポート",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "reportId",
            "memberCountry",
            "periodMonth",
            "quotaMbd",
            "actualMbd",
            "reportedAt"
          ],
          "properties": {
            "reportId": {
              "type": "string"
            },
            "memberCountry": {
              "type": "string"
            },
            "periodMonth": {
              "type": "string",
              "description": "YYYY-MM"
            },
            "quotaMbd": {
              "type": "number"
            },
            "actualMbd": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "compliancePct": {
              "type": "number"
            },
            "reliabilityTier": {
              "type": "string",
              "enum": [
                "non-compliant",
                "marginal",
                "compliant",
                "exemplary"
              ]
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
