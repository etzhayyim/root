{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.miningOperation.reportTailings",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Tailings dam safety report (GISTM — bridges disaster-response + water-scarcity)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "reportId",
            "mineVid",
            "gistmClassification",
            "reportedAt"
          ],
          "properties": {
            "reportId": {
              "type": "string"
            },
            "mineVid": {
              "type": "string",
              "description": "bridges registerMine"
            },
            "gistmClassification": {
              "type": "string",
              "enum": [
                "extreme",
                "very_high",
                "high",
                "significant",
                "low"
              ]
            },
            "storageVolumeM3": {
              "type": "number"
            },
            "lastIndependentReviewAt": {
              "type": "string",
              "format": "datetime"
            },
            "failureMode": {
              "type": "string",
              "enum": [
                "overtopping",
                "static_liquefaction",
                "seismic",
                "foundation",
                "piping",
                "erosion"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}