{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.bbnjHighseas.registerMpa",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "BBNJ / high-seas MPA area designation (bridges biodiversity-gbf + fisheries-iuu + deep-sea-mining)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "mpaId",
            "areaName",
            "governanceBody",
            "abnJurisdictionType",
            "areaKm2",
            "protectionLevel",
            "establishedAt"
          ],
          "properties": {
            "mpaId": {
              "type": "string"
            },
            "areaName": {
              "type": "string"
            },
            "governanceBody": {
              "type": "string",
              "enum": [
                "bbnj_cop",
                "cbd",
                "ospar",
                "ccamlr",
                "nafo",
                "iotc",
                "regional"
              ]
            },
            "abnJurisdictionType": {
              "type": "string",
              "enum": [
                "abnJ",
                "eez_high_seas_interface",
                "area",
                "ccamlr_area"
              ]
            },
            "areaKm2": {
              "type": "number"
            },
            "protectionLevel": {
              "type": "string",
              "enum": [
                "no_take",
                "partial",
                "restricted_fishing",
                "navigational_only"
              ]
            },
            "establishedAt": {
              "type": "string",
              "format": "datetime"
            },
            "reviewDueAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "conservationTier": {
              "type": "string",
              "enum": [
                "minimal",
                "mixed",
                "strict"
              ]
            }
          }
        }
      }
    }
  }
}