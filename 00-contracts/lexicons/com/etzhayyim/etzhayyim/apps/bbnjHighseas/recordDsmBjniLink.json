{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.bbnjHighseas.recordDsmBjniLink",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "BBNJ digital sequence information / genetic resources benefit-sharing",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "linkId",
            "dsiIdentifier",
            "benefitSharingMechanism",
            "recordedAt"
          ],
          "properties": {
            "linkId": {
              "type": "string"
            },
            "mpaVid": {
              "type": "string",
              "description": "bridges registerMpa"
            },
            "dsiIdentifier": {
              "type": "string",
              "description": "GenBank / BOLD / INSDC accession"
            },
            "taxonAsfisOrCas": {
              "type": "string"
            },
            "benefitSharingMechanism": {
              "type": "string",
              "enum": [
                "mat",
                "national_levy",
                "global_fund",
                "traditional_knowledge"
              ]
            },
            "recordedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}