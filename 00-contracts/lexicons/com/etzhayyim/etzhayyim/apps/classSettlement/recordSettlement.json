{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.classSettlement.recordSettlement",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Class action settlement administration (bridges civilLiability.flagDispositiveRuling + enforcementAction + insurance-claim)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "settlementId",
            "caseKind",
            "finalApprovedAt"
          ],
          "properties": {
            "settlementId": {
              "type": "string"
            },
            "caseKind": {
              "type": "string",
              "enum": [
                "securities_10b5",
                "consumer_protection",
                "antitrust",
                "product_liability",
                "environmental",
                "wage_hour",
                "data_breach",
                "discrimination",
                "opioid",
                "pfas",
                "erisa",
                "biometric_bipa"
              ]
            },
            "classSize": {
              "type": "integer"
            },
            "rulingVid": {
              "type": "string",
              "description": "bridges civilLiability.flagDispositiveRuling"
            },
            "grossMusd": {
              "type": "number"
            },
            "cyPresMusd": {
              "type": "number"
            },
            "finalApprovedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}