{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.reskillingFund.flagOutcomeGap",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Reskilling outcome / placement gap / gender-disparity (bridges coalExit.flagJustTransition + just-transition + worker-grievance)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "programVid",
            "gapKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "programVid": {
              "type": "string",
              "description": "bridges recordProgram"
            },
            "gapKind": {
              "type": "string",
              "enum": [
                "low_placement_rate",
                "age_bias",
                "gender_disparity",
                "migrant_exclusion",
                "skills_mismatch",
                "certification_unrecognized",
                "wage_drop",
                "community_exodus",
                "completion_rate",
                "regional_imbalance"
              ]
            },
            "placementRatePct": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}