{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yoro.translatePost",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Translate one yoro social post into a target language. The worker creates a translated sibling app.bsky.feed.post and records com.etzhayyim.apps.media_gamers.record.translationLink for yoro post-detail language tabs.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["postUri", "targetLang"],
          "properties": {
            "postUri": {
              "type": "string",
              "format": "at-uri",
              "description": "Canonical source app.bsky.feed.post URI."
            },
            "targetLang": {
              "type": "string",
              "description": "BCP-47 target language code."
            },
            "sourceLang": {
              "type": "string",
              "description": "Optional BCP-47 source language override. Defaults to the source post langs[0], then ja."
            },
            "postRepo": {
              "type": "string",
              "description": "Repository DID for translated sibling posts. Defaults to did:web:yoro.etzhayyim.com."
            },
            "postText": {
              "type": "string",
              "description": "Optional source text override for dry-run or controlled retranslation."
            },
            "dryRun": {
              "type": "boolean"
            },
            "flush": {
              "type": "boolean"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "error": { "type": "string" },
            "postUri": { "type": "string", "format": "at-uri" },
            "translatedUri": { "type": "string", "format": "at-uri" },
            "translationLinkUri": { "type": "string", "format": "at-uri" },
            "sourceLang": { "type": "string" },
            "targetLang": { "type": "string" },
            "translatedText": { "type": "string" },
            "model": { "type": "string" },
            "latencyMs": { "type": "integer" },
            "dryRun": { "type": "boolean" }
          }
        }
      }
    }
  }
}
