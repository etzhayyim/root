{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yoro.postAgencyUpdate",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Post a public update or policy change from a government agency actor to the yoro.etzhayyim.com social feed.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "agencyDid": { "type": "string", "format": "did" },
            "content": { "type": "string", "maxLength": 10000 },
            "policyId": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["agencyDid", "content"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "postUri": { "type": "string", "format": "uri" },
            "publishedAt": { "type": "string", "format": "datetime" }
          }
        }
      }
    }
  }
}
