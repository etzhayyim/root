{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yoro.translatePostBatch",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Translate one yoro social post into multiple target languages via the yoro LangServer translation worker.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["postUri"],
          "properties": {
            "postUri": {
              "type": "string",
              "format": "at-uri"
            },
            "targetLangs": {
              "type": "array",
              "items": { "type": "string" },
              "description": "BCP-47 target language codes. Defaults to YORO_TRANSLATION_TARGET_LANGS."
            },
            "sourceLang": {
              "type": "string"
            },
            "postRepo": {
              "type": "string"
            },
            "postText": {
              "type": "string"
            },
            "dryRun": {
              "type": "boolean"
            },
            "flush": {
              "type": "boolean"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "error": { "type": "string" },
            "postUri": { "type": "string", "format": "at-uri" },
            "count": { "type": "integer" },
            "translated": { "type": "integer" },
            "results": {
              "type": "array",
              "items": { "type": "unknown" }
            }
          }
        }
      }
    }
  }
}
