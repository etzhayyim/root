{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.robotics.workflow.start",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Start a robotics BPMN process instance through the robotics MCP bridge. Returns a dry-run start plan when POD-side LangServer is not configured.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "processKind": {
              "type": "string",
              "enum": ["business-process", "work-execution", "transport-sales", "manufacturing-package", "vehicle-manufacturing-package"]
            },
            "bpmnProcessId": { "type": "string" },
            "variables": { "type": "unknown" },
            "requestId": { "type": "string" },
            "processes": { "type": "array", "items": { "type": "string" } },
            "assetKind": { "type": "string" },
            "dryRun": { "type": "boolean" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "dryRun": { "type": "boolean" },
            "bpmnProcessId": { "type": "string" },
            "instanceKey": { "type": "string" },
            "startedAt": { "type": "string" },
            "variables": { "type": "unknown" },
            "reason": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
