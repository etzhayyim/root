{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.robotics.product.file.catalog",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Normalize CAD, PCB, BOM, assembly, QA, RFQ, control, and compliance files in a robotics manufacturing package.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["packageId", "packageManifest"],
          "properties": {
            "packageId": { "type": "string" },
            "packageManifest": { "type": "unknown" },
            "packageValidation": { "type": "unknown" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "roboticsProductFileCatalog": { "type": "unknown" }
          }
        }
      }
    }
  }
}
