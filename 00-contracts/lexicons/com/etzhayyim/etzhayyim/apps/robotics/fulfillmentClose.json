{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.robotics.fulfillment.close",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Check quality, delivery, sales, and invoice records for robotics fulfillment close readiness.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "requestId": { "type": "string" },
            "records": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "closeId": { "type": "string" },
            "requestId": { "type": "string" },
            "status": { "type": "string" },
            "requiredRecords": { "type": "array", "items": { "type": "string" } },
            "missingRecords": { "type": "array", "items": { "type": "string" } },
            "auditAction": { "type": "string" }
          }
        }
      }
    }
  }
}
