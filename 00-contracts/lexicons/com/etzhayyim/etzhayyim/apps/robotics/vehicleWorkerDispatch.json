{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.robotics.vehicle.worker.dispatch",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Dispatch or dry-run automotive manufacturing worker tasks for CAD/PLM import, MBOM/routing, tooling, line balance, QA gates, EOL, software flashing, DPP, and supplier RFQ preparation.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["taskType", "packageId"],
          "properties": {
            "requestId": { "type": "string" },
            "packageId": { "type": "string" },
            "taskType": {
              "type": "string",
              "enum": [
                "automotive.package.profile",
                "automotive.file.catalog",
                "automotive.ebom.mbom.align",
                "automotive.supply.process.link",
                "automotive.material.procurement.plan",
                "automotive.intermediate.process.plan",
                "automotive.routing.plan",
                "automotive.tooling.plan",
                "automotive.line.balance",
                "automotive.quality.gate",
                "automotive.eol.plan",
                "automotive.software.release",
                "automotive.dpp.export",
                "automotive.rfq.export"
              ]
            },
            "workerPool": {
              "type": "string",
              "enum": ["langserver", "cad-container", "tsukuru-worker", "quality-worker", "supplier-worker"]
            },
            "payload": { "type": "unknown" },
            "dryRun": { "type": "boolean" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "dryRun": { "type": "boolean" },
            "taskType": { "type": "string" },
            "workerPool": { "type": "string" },
            "jobId": { "type": "string" },
            "reason": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
