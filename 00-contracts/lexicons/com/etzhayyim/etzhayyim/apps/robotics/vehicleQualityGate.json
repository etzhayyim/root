{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.robotics.vehicle.quality.gate",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Evaluate automotive manufacturing quality gates across APQP, PPAP, FMEA, control plan, measurement, traceability, EOL, homologation, cybersecurity, and software release evidence.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["packageId", "qualityGate", "evidence"],
          "properties": {
            "requestId": { "type": "string" },
            "packageId": { "type": "string" },
            "vehicleProgram": { "type": "string" },
            "qualityGate": {
              "type": "string",
              "enum": [
                "concept",
                "design_freeze",
                "tooling_release",
                "prototype_build",
                "pilot_build",
                "sop_readiness",
                "end_of_line",
                "homologation",
                "service_release"
              ]
            },
            "evidence": { "type": "unknown" },
            "blockingOnly": { "type": "boolean" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "automotiveQualityGateResult": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "enum": ["pass", "warn", "block"] },
                "missingEvidence": { "type": "array", "items": { "type": "string" } },
                "blockingIssues": { "type": "array", "items": { "type": "string" } },
                "auditRefs": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
