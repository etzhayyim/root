{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.robotics.ems.supplier.shortlist",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Shortlist EMS suppliers for a robotics RFQ by matching normalized company profiles against package capabilities, certifications, quantity, and region constraints.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "requestId": { "type": "string" },
            "rfq": { "type": "unknown" },
            "companyProfiles": { "type": "array" },
            "requiredCapabilities": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "roboticsEmsSupplierShortlist": { "type": "unknown" }
          }
        }
      }
    }
  }
}
