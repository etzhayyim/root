{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.robotics.vehicle.manufacturing.profile",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Normalize an automotive manufacturing package profile for vehicle body, chassis, powertrain, battery, E/E, trim, software, end-of-line, homologation, and service data.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["packageId", "vehicleProgram", "packageManifest"],
          "properties": {
            "requestId": { "type": "string" },
            "packageId": { "type": "string" },
            "vehicleProgram": { "type": "string" },
            "modelCode": { "type": "string" },
            "plantId": { "type": "string" },
            "lineId": { "type": "string" },
            "vehicleKind": {
              "type": "string",
              "enum": ["ice", "hybrid", "phev", "bev", "fuel_cell", "sdv", "autonomous_vehicle", "commercial_vehicle"]
            },
            "packageManifest": { "type": "unknown" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "automotiveManufacturingProfile": {
              "type": "object",
              "properties": {
                "packageId": { "type": "string" },
                "vehicleProgram": { "type": "string" },
                "vehicleKind": { "type": "string" },
                "requiredFileGroups": { "type": "array", "items": { "type": "string" } },
                "requiredProcessGroups": { "type": "array", "items": { "type": "string" } },
                "requiredQualityGates": { "type": "array", "items": { "type": "string" } },
                "workerTaskTypes": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
