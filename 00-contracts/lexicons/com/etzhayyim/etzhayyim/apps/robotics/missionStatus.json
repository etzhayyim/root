{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.robotics.mission.status",
  "defs": {
    "main": {
      "type": "query",
      "description": "Compute robotics mission state from simulation, approval, and telemetry frames.",
      "parameters": {
        "type": "params",
        "properties": {
          "missionId": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "missionId": { "type": "string" },
            "state": { "type": "string" },
            "blockers": { "type": "array", "items": { "type": "string" } },
            "evidence": { "type": "array", "items": { "type": "string" } },
            "nextActions": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
