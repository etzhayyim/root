{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.robotics.process.catalog",
  "defs": {
    "main": {
      "type": "query",
      "description": "List robotics and automotive manufacturing process forms for sales, requirements, engineering, procurement, production, manufacturing, quality, warehouse, transport, installation, maintenance, and finance.",
      "parameters": {
        "type": "params",
        "properties": {
          "processes": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Optional process ids to filter."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "forms": { "type": "array", "items": { "type": "unknown" } }
          }
        }
      }
    }
  }
}
