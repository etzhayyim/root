{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.robotics.mission.plan",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Plan robot, AGV, drone, or autonomous-vehicle mission commands with safety and telemetry contracts.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "missionId": { "type": "string" },
            "assetKind": { "type": "string" },
            "missionType": { "type": "string" },
            "routeId": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "roboticsMission": { "type": "unknown" }
          }
        }
      }
    }
  }
}
