{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.tnfdDisclosure.recordDisclosure",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "TNFD nature-related financial disclosure (bridges esgSovereign.flagMaterialityDebate + biodiversity-gbf + climate-value-chain)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "disclosureId",
            "pillarKind",
            "reportedAt"
          ],
          "properties": {
            "disclosureId": {
              "type": "string"
            },
            "filerLei": {
              "type": "string"
            },
            "pillarKind": {
              "type": "string",
              "enum": [
                "governance",
                "strategy",
                "risk_impact",
                "metrics_targets",
                "location_specific",
                "leap_framework",
                "sector_prototype",
                "financial_sector"
              ]
            },
            "dependencyKind": {
              "type": "string",
              "enum": [
                "water_supply",
                "soil_health",
                "pollination",
                "climate_regulation",
                "genetic_resources",
                "flood_protection",
                "waste_degradation"
              ]
            },
            "impactKind": {
              "type": "string",
              "enum": [
                "land_use_change",
                "water_withdrawal",
                "pollution",
                "invasive_species",
                "direct_exploit",
                "climate"
              ]
            },
            "materialityVid": {
              "type": "string",
              "description": "bridges esgSovereign.flagMaterialityDebate"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}