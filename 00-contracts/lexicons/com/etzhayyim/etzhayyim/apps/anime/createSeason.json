{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.anime.createSeason",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a season under an anime title.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["title_id"],
          "properties": {
            "title_id": { "type": "string" },
            "season_num": { "type": "integer" },
            "year": { "type": "integer" },
            "cour": { "type": "string" },
            "episode_count": { "type": "integer" },
            "org_id": { "type": "string" },
            "user_id": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": { "id": { "type": "string" } } }
      }
    }
  }
}
