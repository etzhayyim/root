{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.anime.getTitle",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get an anime title by ID including its seasons.",
      "parameters": {
        "type": "params",
        "required": ["id"],
        "properties": { "id": { "type": "string" } }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "title": { "type": "object" },
            "seasons": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    }
  }
}
