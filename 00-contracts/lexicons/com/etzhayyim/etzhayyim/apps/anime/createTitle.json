{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.anime.createTitle",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a new anime title.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": { "type": "string" },
            "title_ja": { "type": "string" },
            "genre": { "type": "string" },
            "tags": { "type": "string" },
            "synopsis": { "type": "string" },
            "studio": { "type": "string" },
            "source_type": { "type": "string" },
            "status": { "type": "string" },
            "org_id": { "type": "string" },
            "user_id": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": { "id": { "type": "string" } } }
      }
    }
  }
}
