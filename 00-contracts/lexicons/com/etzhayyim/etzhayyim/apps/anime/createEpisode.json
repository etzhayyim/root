{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.anime.createEpisode",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register an episode under an anime season.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["season_id"],
          "properties": {
            "season_id": { "type": "string" },
            "episode_num": { "type": "integer" },
            "title": { "type": "string" },
            "air_date": { "type": "string" },
            "duration_sec": { "type": "integer" },
            "org_id": { "type": "string" },
            "user_id": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": { "id": { "type": "string" } } }
      }
    }
  }
}
