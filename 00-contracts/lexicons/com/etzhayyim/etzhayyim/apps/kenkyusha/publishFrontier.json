{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kenkyusha.publishFrontier",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Publish a research problem (Science OS Step 1 — analogous to scienceearth.org EACN3 'Publish A Problem'). The Pregel 6-role co-scientist loop (Generation / Reflection / Ranking / Evolution / Proximity / Meta-review) runs synchronously over the frontier and returns the winning hypothesis + consensus level. Exposed as the canonical MCP tool 'kenkyusha.publishFrontier' for cross-agent invocation.",
      "x-hostImportsMethod": "kenkyushaPublishFrontier",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 4,
              "maxLength": 240,
              "description": "One-sentence statement of the research frontier."
            },
            "primaryDiscipline": {
              "type": "string",
              "description": "ISCED-F 2013 four-digit detailed field code (default '0613' = software/applications development).",
              "default": "0613"
            },
            "maxHypotheses": {
              "type": "integer",
              "minimum": 2,
              "maximum": 8,
              "default": 4,
              "description": "Number of seed hypotheses the Generation node should propose."
            },
            "description": {
              "type": "string",
              "maxLength": 1024,
              "description": "Optional longer description / context."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok":                 { "type": "boolean" },
            "frontier_id":        { "type": "string" },
            "frontier_did":       { "type": "string" },
            "winner_hypothesis_id": { "type": "string" },
            "consensus_level":    {
              "type": "string",
              "enum": ["none", "disputed", "emerging", "partial", "strong"]
            },
            "next_action": {
              "type": "string",
              "enum": ["publish", "iterate", "abandon"]
            },
            "duration_ms": { "type": "integer" },
            "error":       { "type": "string" }
          }
        }
      }
    }
  }
}
