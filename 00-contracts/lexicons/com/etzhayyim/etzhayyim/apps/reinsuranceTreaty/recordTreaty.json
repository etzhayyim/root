{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.reinsuranceTreaty.recordTreaty",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Reinsurance treaty placement (proportional / non-proportional / catastrophe — bridges shadowFleetInsurance.flagGapOrFraud + insurance-policy + cat-bond-ils)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "treatyId",
            "treatyKind",
            "perilKind",
            "incepedAt"
          ],
          "properties": {
            "treatyId": {
              "type": "string"
            },
            "cedentLei": {
              "type": "string"
            },
            "reinsurerLei": {
              "type": "string"
            },
            "treatyKind": {
              "type": "string",
              "enum": [
                "quota_share",
                "surplus_share",
                "working_xol",
                "cat_xol",
                "stop_loss",
                "aggregate_xol",
                "retro",
                "ils_cat_bond",
                "sidecar",
                "whole_account",
                "facultative",
                "loss_portfolio_transfer"
              ]
            },
            "perilKind": {
              "type": "string",
              "enum": [
                "nat_cat_storm",
                "nat_cat_quake",
                "wildfire",
                "flood",
                "cyber",
                "liability_long_tail",
                "casualty",
                "credit_political_risk",
                "marine_war",
                "aviation_war",
                "nuclear_pool",
                "pandemic",
                "terror"
              ]
            },
            "shadowGapVid": {
              "type": "string",
              "description": "bridges shadowFleetInsurance.flagGapOrFraud"
            },
            "incepedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}