{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.media_gamers.record.pokemon",
  "defs": {
    "main": {
      "type": "record",
      "description": "Pokémon pokédex entry scoped by game_slug (species / form). Moves & evolutions are stored as separate edges (edge_pokemon_has_move / edge_pokemon_evolves_to) — keep this record small.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["id", "slug", "game_slug", "name", "types", "lang"],
        "properties": {
          "id": { "type": "string", "description": "Canonical id, e.g. pokemon:pokemon-legends-z-a:pikachu" },
          "slug": { "type": "string" },
          "game_slug": { "type": "string" },
          "name": { "type": "string" },
          "dex_no": { "type": "integer", "minimum": 0 },
          "form": { "type": "string", "description": "Default/Mega/Gigantamax/Alolan/Galarian/Hisuian/Paldean/etc." },
          "types": {
            "type": "array",
            "description": "Mono/dual typing. Lowercase canonical: normal/fire/water/grass/electric/ice/fighting/poison/ground/flying/psychic/bug/rock/ghost/dragon/dark/steel/fairy.",
            "items": { "type": "string" }
          },
          "abilities": {
            "type": "array",
            "items": { "type": "string" }
          },
          "base_stats": { "type": "ref", "ref": "#stats" },
          "habitat": { "type": "string", "description": "Primary spawning region / habitat slug" },
          "catch_rate": { "type": "integer", "minimum": 0, "maximum": 255 },
          "base_exp": { "type": "integer", "minimum": 0 },
          "generation": { "type": "integer", "minimum": 1, "description": "National Pokédex generation (1-9)" },
          "is_mega": { "type": "boolean", "default": false },
          "mega_base_slug": { "type": "string", "description": "If is_mega=true, slug of the base form" },
          "height_cm": { "type": "integer", "description": "Height in centimeters (0.4m → 40)" },
          "weight_hg": { "type": "integer", "description": "Weight in hectograms (6.0kg → 60). Matches PokeAPI conventions." },
          "lang": { "type": "string", "default": "en" },
          "sources": {
            "type": "array",
            "items": { "type": "string", "format": "uri" }
          },
          "org_id": { "type": "string", "default": "anon" },
          "user_id": { "type": "string", "default": "anon" },
          "actor_id": { "type": "string" },
          "created_at": { "type": "string", "format": "datetime" }
        }
      }
    },
    "stats": {
      "type": "object",
      "required": ["hp", "atk", "def", "spa", "spd", "spe"],
      "properties": {
        "hp": { "type": "integer", "minimum": 1 },
        "atk": { "type": "integer", "minimum": 1 },
        "def": { "type": "integer", "minimum": 1 },
        "spa": { "type": "integer", "minimum": 1, "description": "Special Attack" },
        "spd": { "type": "integer", "minimum": 1, "description": "Special Defense" },
        "spe": { "type": "integer", "minimum": 1, "description": "Speed" }
      }
    }
  }
}
