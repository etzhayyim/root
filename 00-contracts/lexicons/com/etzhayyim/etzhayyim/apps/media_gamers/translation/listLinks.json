{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.media_gamers.translation.listLinks",
  "defs": {
    "main": {
      "type": "query",
      "description": "List translation links anchored to a post URI. Matches when the URI appears as either sourceUri or translatedUri. Returns the canonical source + all known translated siblings. ADR-0034.",
      "parameters": {
        "type": "params",
        "required": ["anyUri"],
        "properties": {
          "anyUri": {
            "type": "string",
            "format": "at-uri",
            "description": "Post URI to anchor the lookup. May be the source post or any translated sibling."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sourceUri", "sourceLang", "links"],
          "properties": {
            "sourceUri": { "type": "string", "format": "at-uri" },
            "sourceLang": { "type": "string" },
            "links": {
              "type": "array",
              "items": { "type": "ref", "ref": "#link" }
            }
          }
        }
      }
    },
    "link": {
      "type": "object",
      "required": ["lang", "translatedUri", "source"],
      "properties": {
        "lang": { "type": "string" },
        "translatedUri": { "type": "string", "format": "at-uri" },
        "source": { "type": "string" },
        "qualityScore": { "type": "number" },
        "createdAt": { "type": "string", "format": "datetime" }
      }
    }
  }
}
