{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.media_gamers.graph.clearGame",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Delete every graphVertex/graphEdge record for a game_slug via com.atproto.repo.applyWrites#delete.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "game_slug": { "type": "string" }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "game_slug": { "type": "string" },
            "deleted_vertices": { "type": "integer" },
            "deleted_edges": { "type": "integer" },
            "error": { "type": "string" }
          },
          "required": []
        }
      }
    }
  }
}
