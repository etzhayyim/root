{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.fhirHealthData.registerTerminology",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "FHIR R5 + ICD-11 + SNOMED CT + LOINC + RxNorm terminology (bridges universal-health-coverage + pharma-supply + amr-surveillance)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "terminologyId",
            "system",
            "resourceType",
            "registeredAt"
          ],
          "properties": {
            "terminologyId": {
              "type": "string"
            },
            "system": {
              "type": "string",
              "enum": [
                "fhir_r5",
                "icd_11",
                "icd_10_cm",
                "snomed_ct",
                "loinc",
                "rxnorm",
                "hl7_v2",
                "omop_cdm",
                "openehr",
                "gs1_healthcare"
              ]
            },
            "resourceType": {
              "type": "string",
              "description": "FHIR Patient / Observation / Condition / Procedure / MedicationRequest / Encounter / Immunization / etc"
            },
            "vsVersion": {
              "type": "string"
            },
            "jurisdictionIso3": {
              "type": "string"
            },
            "registeredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}