{
  "$type": "lexicon",
  "lexicon": 1,
  "id": "com.etzhayyim.apps.site.searchSemantic",
  "defs": {
    "main": {
      "type": "query",
      "description": "Corpus2Skill-guided IVF+PQ semantic search over WET chunks. LLM navigates the skill tree to find relevant domain clusters, then ADC-scores PQ-encoded chunks for top-K retrieval.",
      "parameters": {
        "type": "params",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 2048,
            "description": "Natural language search query."
          },
          "domain": {
            "type": "string",
            "maxLength": 512,
            "description": "Restrict search to a specific crawled domain (e.g. 'site.wet'). Defaults to 'site.wet'."
          },
          "topK": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 10,
            "description": "Maximum number of WET chunk hits to return."
          },
          "nProbe": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64,
            "default": 8,
            "description": "Number of IVF centroid clusters to probe during ADC search."
          },
          "maxHops": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 3,
            "description": "Maximum tree-navigation hops for Corpus2Skill routing."
          },
          "skipNav": {
            "type": "boolean",
            "default": false,
            "description": "Skip Corpus2Skill navigation and search all clusters directly."
          }
        },
        "required": ["q"]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "query": { "type": "string" },
            "domain": { "type": "string" },
            "nav": {
              "type": "object",
              "nullable": true,
              "properties": {
                "leafNodeId":    { "type": "string" },
                "nodePath":      { "type": "array", "items": { "type": "string" } },
                "clusterIds":    { "type": "array", "items": { "type": "integer" } },
                "hopCount":      { "type": "integer" },
                "distillVersion": { "type": "string" }
              }
            },
            "hits": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "chunkVertexId":   { "type": "string" },
                  "domain":          { "type": "string" },
                  "url":             { "type": "string" },
                  "title":           { "type": "string" },
                  "markdownPreview": { "type": "string" },
                  "score":           { "type": "number" },
                  "clusterId":       { "type": "integer", "nullable": true }
                },
                "required": ["chunkVertexId", "url", "markdownPreview", "score"]
              }
            },
            "totalHits": { "type": "integer" },
            "method":    { "type": "string" },
            "latencyMs": { "type": "number" }
          },
          "required": ["query", "domain", "hits", "totalHits", "method", "latencyMs"]
        }
      }
    }
  }
}
