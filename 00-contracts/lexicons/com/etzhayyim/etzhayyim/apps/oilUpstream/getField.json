{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.oilUpstream.getField",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get an upstream oil/gas field by DID.",
      "x-bootstrap": true,
      "parameters": { "type": "params", "required": ["did"], "properties": { "did": { "type": "string", "format": "did" } } },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "name": { "type": "string" }, "basin": { "type": "string" }, "country": { "type": "string" }, "operatorDid": { "type": "string", "format": "did" }, "fieldType": { "type": "string" }, "discoveredYear": { "type": "integer" }, "firstProductionYear": { "type": "integer" }, "reservesProvedMmbbl": { "type": "number" }, "currentProductionBopd": { "type": "number" } } } }
    }
  }
}
