{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.oilUpstream.registerField",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register an oil/gas upstream field. Path-based DID: did:web:oil-upstream.etzhayyim.com:basin:{basin}:field:{slug}. Sources: USGS + IHS Markit + Wood Mackenzie + national petroleum agencies.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["name", "basin", "country"],
          "properties": {
            "name": { "type": "string" },
            "basin": { "type": "string" },
            "country": { "type": "string", "description": "ISO 3166-1 alpha-3" },
            "operatorDid": { "type": "string", "format": "did" },
            "fieldType": { "type": "string", "enum": ["onshore", "offshore-shallow", "offshore-deep", "shale", "oil-sands", "heavy-oil"] },
            "discoveredYear": { "type": "integer" },
            "firstProductionYear": { "type": "integer" },
            "reservesProvedMmbbl": { "type": "number" },
            "currentProductionBopd": { "type": "number" }
          }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "uri": { "type": "string", "format": "at-uri" } } } }
    }
  }
}
