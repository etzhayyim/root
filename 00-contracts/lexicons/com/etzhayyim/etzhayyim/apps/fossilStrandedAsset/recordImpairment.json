{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.fossilStrandedAsset.recordImpairment",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Fossil-fuel stranded asset impairment / write-down (bridges energyCharterExit.flagInvestorClaimSurge + climate-value-chain + just-transition)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "impairmentId",
            "assetClass",
            "triggerKind",
            "recordedAt"
          ],
          "properties": {
            "impairmentId": {
              "type": "string"
            },
            "assetClass": {
              "type": "string",
              "enum": [
                "upstream_oil",
                "upstream_gas",
                "downstream_refinery",
                "midstream_pipeline",
                "midstream_lng",
                "coal_thermal",
                "coal_metallurgical",
                "power_unabated",
                "reserves_e_p",
                "copa_uneconomic",
                "tar_sands"
              ]
            },
            "operatorLei": {
              "type": "string"
            },
            "triggerKind": {
              "type": "string",
              "enum": [
                "regulatory_phase_out",
                "carbon_price",
                "demand_destruction",
                "financing_unavailable",
                "insurance_withdrawn",
                "pension_divest",
                "sovereign_wealth_divest",
                "renewables_displace",
                "ev_displace",
                "heat_pump_displace",
                "just_transition_close"
              ]
            },
            "investorSurgeVid": {
              "type": "string",
              "description": "bridges energyCharterExit.flagInvestorClaimSurge"
            },
            "recordedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}