{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kiyo.submitRevision",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Submit a revised version of an existing paper. Caller must be the original owner_did. Triggers submitRevision.bpmn.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "paperId":         { "type": "string" },
            "fileBase64":      { "type": "string" },
            "fileContentType": { "type": "string", "default": "application/pdf" },
            "sourceBase64":    { "type": "string" },
            "changeNote":      { "type": "string" }
          },
          "required": ["paperId", "fileBase64"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "accepted":        { "type": "boolean" },
            "version":         { "type": "integer" },
            "newIpfsCid":      { "type": "string" }
          },
          "required": ["accepted"]
        }
      }
    }
  }
}
