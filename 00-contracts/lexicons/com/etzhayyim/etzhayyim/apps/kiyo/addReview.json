{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kiyo.addReview",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Add a peer review or comment to a paper. reviewer_did = caller DID. review_type: peer | comment | editorial.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "paperId":    { "type": "string" },
            "rating":     { "type": "integer", "minimum": 1, "maximum": 5 },
            "body":       { "type": "string" },
            "reviewType": { "type": "string", "default": "comment" }
          },
          "required": ["paperId", "body"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "reviewId": { "type": "string" },
            "accepted": { "type": "boolean" }
          },
          "required": ["accepted"]
        }
      }
    }
  }
}
