{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kiyo.getStats",
  "defs": {
    "main": {
      "type": "query",
      "description": "Platform-wide statistics: total papers, subject breakdown, author count, recent activity from mv_kiyo_subject_stats.",
      "parameters": {
        "type": "params",
        "properties": {},
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "totalPapers":   { "type": "integer" },
            "totalAuthors":  { "type": "integer" },
            "totalCitations":{ "type": "integer" },
            "recentPapers":  { "type": "integer", "description": "Papers submitted in last 30 days" },
            "subjects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "subjectCode":   { "type": "string" },
                  "paperCount":    { "type": "integer" },
                  "recent30d":     { "type": "integer" }
                }
              }
            }
          },
          "required": ["totalPapers", "subjects"]
        }
      }
    }
  }
}
