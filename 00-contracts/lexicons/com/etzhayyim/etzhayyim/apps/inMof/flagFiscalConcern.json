{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.inMof.flagFiscalConcern",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Fiscal concern / state vs centre / GST share dispute (bridges sovereignDebt + worldBankDpf + frugalFourCoalition)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "actionVid",
            "concernKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "actionVid": {
              "type": "string",
              "description": "bridges recordFiscalAction"
            },
            "concernKind": {
              "type": "string",
              "enum": [
                "centre_state_revenue_share",
                "gst_compensation_extension_demand",
                "fiscal_responsibility_breach",
                "sovereign_rating_pressure",
                "capex_vs_revex",
                "disinvestment_target_miss",
                "npa_recurrence",
                "real_estate_overhang",
                "msme_credit_squeeze",
                "household_debt_rising",
                "state_dpe_overdraw"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}