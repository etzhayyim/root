{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.vaccineEquity.flagAccessGap",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "LMIC access / dose sharing / IP waiver concern (bridges pandemicPrep.flagCoverageGap + trips-waiver + cold-chain)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "gapId",
            "concernKind",
            "reportedAt"
          ],
          "properties": {
            "gapId": {
              "type": "string"
            },
            "allocationVid": {
              "type": "string",
              "description": "bridges recordAllocation"
            },
            "coverageGapVid": {
              "type": "string",
              "description": "bridges pandemicPrep.flagCoverageGap"
            },
            "concernKind": {
              "type": "string",
              "enum": [
                "lmic_shortfall",
                "hoarding",
                "ip_waiver_blocked",
                "price_gouging",
                "cold_chain_failure",
                "tech_transfer_gap",
                "wasted_doses"
              ]
            },
            "shortfallDoses": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}