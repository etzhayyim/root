{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.vaccineEquity.flagCoverageGap",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "WHO/UNICEF Immunization Coverage Estimate gap (bridges amr-surveillance + pandemic-preparedness)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "gapId",
            "countryIso3",
            "antigen",
            "coveragePct",
            "reportingYear",
            "flaggedAt"
          ],
          "properties": {
            "gapId": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "antigen": {
              "type": "string"
            },
            "coveragePct": {
              "type": "number"
            },
            "targetPct": {
              "type": "number"
            },
            "zeroDoseChildren": {
              "type": "integer"
            },
            "reportingYear": {
              "type": "integer"
            },
            "flaggedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "coverageTier": {
              "type": "string",
              "enum": [
                "on_target",
                "approaching",
                "elevated",
                "critical"
              ]
            }
          }
        }
      }
    }
  }
}