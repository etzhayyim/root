{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maps3d.fetchMapillary",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Fetch Mapillary v4 image metadata for an H3 tile bbox. Used as a LangServer handler (`maps3d.fetchMapillary`) inside `processTile.bpmn`. Output is metadata only (image_id + camera_pose + captured_at + url); the actual JPEG fetch + B2 upload happens after image curation narrows the candidate set. Source DID `did:web:maps.etzhayyim.com:street_view`.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["tileH3"],
          "properties": {
            "tileH3": { "type": "string", "description": "H3 res-12 cell." },
            "maxImages": { "type": "integer", "description": "Hard cap on Mapillary results returned (default 200, max 500)." },
            "minQuality": { "type": "number", "description": "Mapillary `quality_score` lower bound 0..1 (default 0.5)." },
            "lookbackDays": { "type": "integer", "description": "Reject images older than this many days (default 1825 = 5y)." }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["tileH3", "candidates"],
          "properties": {
            "tileH3": { "type": "string" },
            "candidates": {
              "type": "array",
              "description": "Ordered Mapillary image candidates (newest first).",
              "items": {
                "type": "object",
                "required": ["imageId", "lat", "lng", "capturedAt", "url"],
                "properties": {
                  "imageId": { "type": "string" },
                  "lat": { "type": "number" },
                  "lng": { "type": "number" },
                  "compassAngle": { "type": "number" },
                  "altitude": { "type": "number" },
                  "capturedAt": { "type": "string", "description": "ISO 8601." },
                  "qualityScore": { "type": "number" },
                  "url": { "type": "string", "description": "Mapillary thumb_2048_url for COLMAP." }
                }
              }
            },
            "totalAvailable": { "type": "integer" }
          }
        }
      }
    }
  }
}
