{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openLogisticsLastmile.dispatchLeg",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Dispatch a last-mile logistics leg with SLA, customs, and special-handling checks.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["vertexId", "legId", "mode", "destAddress", "plannedArrival", "slaMinutes"],
          "properties": {
            "vertexId": { "type": "string" },
            "legId": { "type": "string" },
            "carrierScheduleVid": { "type": "string" },
            "customsClearanceVid": { "type": "string" },
            "mode": { "type": "string" },
            "originPortVid": { "type": "string" },
            "destAddress": { "type": "string" },
            "plannedArrival": { "type": "string" },
            "slaMinutes": { "type": "integer" },
            "temperatureRequired": { "type": "boolean" },
            "hazardousGoods": { "type": "boolean" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
