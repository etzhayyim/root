{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openLogisticsLastmile.confirmDelivery",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Confirm a last-mile delivery and open a claim when SLA or damage rules require it.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["vertexId", "proofId", "legVid", "deliveredAt"],
          "properties": {
            "vertexId": { "type": "string" },
            "claimVertexId": { "type": "string" },
            "proofId": { "type": "string" },
            "legVid": { "type": "string" },
            "deliveredAt": { "type": "string" },
            "minutesLate": { "type": "integer" },
            "damageReported": { "type": "boolean" },
            "signatureCid": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
