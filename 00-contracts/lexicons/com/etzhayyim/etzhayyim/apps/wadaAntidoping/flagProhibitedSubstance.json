{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.wadaAntidoping.flagProhibitedSubstance",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Adverse Analytical Finding + violation flow",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "aafId",
            "testVid",
            "substanceClass",
            "flaggedAt"
          ],
          "properties": {
            "aafId": {
              "type": "string"
            },
            "testVid": {
              "type": "string",
              "description": "bridges recordTest"
            },
            "substanceClass": {
              "type": "string",
              "enum": [
                "S0_non_approved",
                "S1_anabolic",
                "S2_peptide",
                "S3_beta2",
                "S4_hormone_modulator",
                "S5_diuretic",
                "S6_stimulant",
                "S7_narcotic",
                "S8_cannabinoid",
                "S9_glucocorticoid",
                "P1_beta_blocker",
                "M1_enhancement",
                "M2_manipulation",
                "M3_gene_doping"
              ]
            },
            "concentrationNgMl": {
              "type": "number"
            },
            "sanctionIssued": {
              "type": "string",
              "enum": [
                "warning",
                "3_month_ban",
                "6_month_ban",
                "1_year_ban",
                "2_year_ban",
                "4_year_ban",
                "lifetime"
              ]
            },
            "flaggedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "minor",
                "major",
                "severe"
              ]
            }
          }
        }
      }
    }
  }
}