{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.wadaAntidoping.recordTest",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "WADA ADAMS test / analysis result (bridges esports-integrity + pharma-supply + livestock-antibiotics)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "testId",
            "sport",
            "sampleType",
            "analyzedAt"
          ],
          "properties": {
            "testId": {
              "type": "string"
            },
            "athleteOrcid": {
              "type": "string"
            },
            "sport": {
              "type": "string"
            },
            "competitionType": {
              "type": "string",
              "enum": [
                "in_competition",
                "out_of_competition",
                "training",
                "remote_sample"
              ]
            },
            "sampleType": {
              "type": "string",
              "enum": [
                "urine",
                "blood",
                "dried_blood_spot",
                "saliva",
                "hair"
              ]
            },
            "testAuthority": {
              "type": "string"
            },
            "wadaLab": {
              "type": "string"
            },
            "analyzedAt": {
              "type": "string",
              "format": "datetime"
            },
            "atf": {
              "type": "string",
              "enum": [
                "negative",
                "adverse_finding",
                "atypical_finding"
              ]
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}