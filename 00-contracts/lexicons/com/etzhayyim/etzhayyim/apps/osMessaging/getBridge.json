{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.osMessaging.getBridge",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get an OS messaging bridge by DID or platform+channelId.",
      "x-bootstrap": true,
      "parameters": { "type": "params", "properties": { "did": { "type": "string", "format": "did" }, "platform": { "type": "string" }, "channelId": { "type": "string", "description": "combined with platform for alternative lookup" } } },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "platform": { "type": "string" }, "channelId": { "type": "string" }, "channelName": { "type": "string" }, "ownerDid": { "type": "string", "format": "did" }, "bridgeMode": { "type": "string" }, "convoDid": { "type": "string", "format": "did" }, "e2eMode": { "type": "string" } } } }
    }
  }
}
