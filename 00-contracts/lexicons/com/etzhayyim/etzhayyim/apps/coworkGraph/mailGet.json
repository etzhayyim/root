{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.coworkGraph.mailGet",
  "defs": {
    "main": {
      "type": "query",
      "description": "特定メールの本文・添付情報を取得する。Graph API /users/{userId}/messages/{messageId} をラップ。",
      "parameters": {
        "type": "params",
        "required": ["userId", "messageId"],
        "properties": {
          "userId": {
            "type": "string",
            "description": "UPN (user@domain.com) または Graph API user ID"
          },
          "messageId": {
            "type": "string",
            "description": "Graph API message ID"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "subject": { "type": "string" },
            "body": { "type": "unknown" },
            "from": { "type": "unknown" },
            "toRecipients": { "type": "array", "items": { "type": "unknown" } },
            "ccRecipients": { "type": "array", "items": { "type": "unknown" } },
            "receivedDateTime": { "type": "string" },
            "isRead": { "type": "boolean" },
            "hasAttachments": { "type": "boolean" }
          }
        }
      }
    }
  }
}
