{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.coworkGraph.mailList",
  "defs": {
    "main": {
      "type": "query",
      "description": "指定ユーザーのメール一覧を取得する (最大 50 件)。Graph API /users/{userId}/messages をラップ。",
      "parameters": {
        "type": "params",
        "required": ["userId"],
        "properties": {
          "userId": {
            "type": "string",
            "description": "UPN (user@domain.com) または Graph API user ID"
          },
          "top": {
            "type": "integer",
            "description": "取得件数 (最大 50)",
            "default": 20
          },
          "filter": {
            "type": "string",
            "description": "OData $filter 式 (例: isRead eq false)"
          },
          "orderby": {
            "type": "string",
            "description": "OData $orderby 式 (例: receivedDateTime desc)"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "value": {
              "type": "array",
              "items": { "type": "unknown" }
            },
            "@odata.nextLink": { "type": "string" }
          }
        }
      }
    }
  }
}
