{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.coworkGraph.graphActorGet",
  "defs": {
    "main": {
      "type": "query",
      "description": "DID で Actor の RisingWave graph データを取得する (read-only)。vertex_app テーブルを参照。",
      "parameters": {
        "type": "params",
        "required": ["did"],
        "properties": {
          "did": {
            "type": "string",
            "description": "Actor の DID (例: did:web:kaisya.etzhayyim.com)"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "actor": { "type": "unknown" }
          }
        }
      }
    }
  }
}
