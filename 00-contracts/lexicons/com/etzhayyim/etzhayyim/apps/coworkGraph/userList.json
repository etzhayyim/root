{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.coworkGraph.userList",
  "defs": {
    "main": {
      "type": "query",
      "description": "Microsoft 365 ユーザー一覧を検索・取得する。Graph API /users をラップ。",
      "parameters": {
        "type": "params",
        "properties": {
          "top": {
            "type": "integer",
            "description": "取得件数 (最大 50)",
            "default": 20
          },
          "filter": {
            "type": "string",
            "description": "OData $filter 式 (例: department eq '開発部')"
          },
          "search": {
            "type": "string",
            "description": "displayName/mail のキーワード検索 (ConsistencyLevel: eventual)"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "value": {
              "type": "array",
              "items": { "type": "unknown" }
            }
          }
        }
      }
    }
  }
}
