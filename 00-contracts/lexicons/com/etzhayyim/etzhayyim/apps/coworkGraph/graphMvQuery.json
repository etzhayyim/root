{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.coworkGraph.graphMvQuery",
  "defs": {
    "main": {
      "type": "query",
      "description": "RisingWave マテリアライズドビューをクエリする (read-only)。mv 名は英数字/アンダースコアのみ許可。",
      "parameters": {
        "type": "params",
        "required": ["mv"],
        "properties": {
          "mv": {
            "type": "string",
            "description": "マテリアライズドビュー名 (例: mv_actor_social_stats)"
          },
          "filter": {
            "type": "string",
            "description": "WHERE 句の条件 (例: owner_did = 'did:web:kaisya.etzhayyim.com')"
          },
          "orderby": {
            "type": "string",
            "description": "ORDER BY 句 (例: created_at DESC)"
          },
          "limit": {
            "type": "integer",
            "description": "取得件数 (最大 500)",
            "default": 100
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["mv", "rows", "count"],
          "properties": {
            "mv": { "type": "string" },
            "rows": {
              "type": "array",
              "items": { "type": "unknown" }
            },
            "count": { "type": "integer" }
          }
        }
      }
    }
  }
}
