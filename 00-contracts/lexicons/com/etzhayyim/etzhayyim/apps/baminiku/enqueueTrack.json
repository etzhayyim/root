{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.baminiku.enqueueTrack",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Append a BGM or karaoke track to the stream music queue and emit a KAMI audio command.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["streamId", "title", "audioUri"],
          "properties": {
            "streamId": { "type": "string" },
            "title": { "type": "string" },
            "audioUri": { "type": "string" },
            "artist": { "type": "string" },
            "requestedByDid": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["trackId", "queuePosition", "kamiCommand"],
          "properties": {
            "trackId": { "type": "string" },
            "queuePosition": { "type": "integer" },
            "kamiCommand": { "type": "object" }
          }
        }
      }
    }
  }
}
