{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.baminiku.skipTrack",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Skip the current music queue item and emit a KAMI audio transition command.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["streamId"],
          "properties": {
            "streamId": { "type": "string" },
            "reason": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["streamId", "kamiCommand"],
          "properties": {
            "streamId": { "type": "string" },
            "skippedTrackId": { "type": "string" },
            "kamiCommand": { "type": "object" }
          }
        }
      }
    }
  }
}
