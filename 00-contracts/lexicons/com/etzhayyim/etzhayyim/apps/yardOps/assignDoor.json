{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yardOps.assignDoor",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Assign a checked-in trailer to a dock door and trigger a loading-robot mission.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["trailerVertexId", "direction"],
          "properties": {
            "trailerVertexId": { "type": "string" },
            "direction": { "type": "string", "enum": ["inbound", "outbound"] },
            "loadPlanRef": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "dockDoorCode": { "type": "string" },
            "loadingRobotMissionId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
