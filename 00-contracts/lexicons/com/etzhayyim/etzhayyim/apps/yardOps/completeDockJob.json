{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yardOps.completeDockJob",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Complete a dock job and gate-out the trailer.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["dockJobVertexId", "actualDurationMin"],
          "properties": {
            "dockJobVertexId": { "type": "string" },
            "actualDurationMin": { "type": "integer" },
            "exceptions": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
