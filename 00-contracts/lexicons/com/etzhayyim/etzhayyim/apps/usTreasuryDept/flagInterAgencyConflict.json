{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.usTreasuryDept.flagInterAgencyConflict",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Inter-agency conflict / Treasury vs Commerce / Treasury vs DOJ (bridges treasury-rulemaking + judicial-influence + cveCna)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "actionVid",
            "conflictKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "actionVid": {
              "type": "string",
              "description": "bridges recordAction"
            },
            "conflictKind": {
              "type": "string",
              "enum": [
                "doj_vs_treasury",
                "commerce_vs_treasury",
                "fed_vs_treasury",
                "sec_vs_treasury",
                "fdic_vs_occ",
                "cfius_vs_state",
                "ofac_vs_doj",
                "fincen_vs_irs_ci",
                "carve_out_dispute",
                "general_license_dispute",
                "sectoral_priority",
                "stewards_role"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}