{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.greenSteel.registerOfftake",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Green steel offtake agreement (auto / construction / renewables)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "agreementId",
            "metricVid",
            "sector",
            "annualVolumeTonnes",
            "signedAt"
          ],
          "properties": {
            "agreementId": {
              "type": "string"
            },
            "metricVid": {
              "type": "string",
              "description": "bridges recordProductionMetric"
            },
            "offtakerLei": {
              "type": "string"
            },
            "sector": {
              "type": "string",
              "enum": [
                "automotive",
                "construction",
                "wind_tower",
                "rail",
                "shipping",
                "consumer_goods",
                "appliances"
              ]
            },
            "annualVolumeTonnes": {
              "type": "number"
            },
            "premiumUsdTonne": {
              "type": "number"
            },
            "signedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}