{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.beneficialOwnership.flagUboDiscrepancy",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "UBO discrepancy / nominee / trust layering (bridges debarmentList.flagPhoenixEntity + ofac-sanctions-sdn + aml)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "filingVid",
            "discrepancyKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "filingVid": {
              "type": "string",
              "description": "bridges recordUboFiling"
            },
            "discrepancyKind": {
              "type": "string",
              "enum": [
                "registry_vs_bank_kyc",
                "nominee_only",
                "trust_layering",
                "bearer_share",
                "opaque_tier",
                "threshold_avoidance",
                "delayed_filing",
                "blank_filing",
                "circular_ownership",
                "dual_resident"
              ]
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "watch",
                "elevated",
                "high",
                "sdn_match"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}