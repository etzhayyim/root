{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.upovPlantBreeders.flagIpIndigenousConflict",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Conflict with ITPGRFA / Nagoya / indigenous FPIC (bridges indigenous-rights + biodiversity-gbf + bbnj-highseas)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "conflictId",
            "grantVid",
            "issueType",
            "reportedAt"
          ],
          "properties": {
            "conflictId": {
              "type": "string"
            },
            "grantVid": {
              "type": "string",
              "description": "bridges grantPbr"
            },
            "territoryVid": {
              "type": "string",
              "description": "bridges open-indigenous-rights"
            },
            "issueType": {
              "type": "string",
              "enum": [
                "biopiracy",
                "lack_fpic",
                "absent_benefit_sharing",
                "unauthorized_transfer",
                "traditional_knowledge_appropriation"
              ]
            },
            "nagoyaComplaintStatus": {
              "type": "string",
              "enum": [
                "informal",
                "formal",
                "mediation",
                "resolved"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "moderate",
                "strong",
                "severe"
              ]
            }
          }
        }
      }
    }
  }
}