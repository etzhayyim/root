{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.upovPlantBreeders.grantPbr",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "UPOV 1991 Plant Breeders Right (bridges agri-food-security + biodiversity-gbf + indigenous-rights)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "grantId",
            "varietyDenomination",
            "species",
            "jurisdictionIso3",
            "grantedAt"
          ],
          "properties": {
            "grantId": {
              "type": "string"
            },
            "varietyDenomination": {
              "type": "string"
            },
            "breederLei": {
              "type": "string"
            },
            "species": {
              "type": "string"
            },
            "jurisdictionIso3": {
              "type": "string"
            },
            "upovFiliation": {
              "type": "string",
              "enum": [
                "upov1978",
                "upov1991"
              ]
            },
            "farmSavedSeedAllowed": {
              "type": "boolean"
            },
            "durationYears": {
              "type": "integer"
            },
            "grantedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}