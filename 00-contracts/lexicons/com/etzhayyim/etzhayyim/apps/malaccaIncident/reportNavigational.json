{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.malaccaIncident.reportNavigational",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "航行事故",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "incidentId",
            "incidentType",
            "occurredAt"
          ],
          "properties": {
            "incidentId": {
              "type": "string"
            },
            "imo": {
              "type": "string"
            },
            "incidentType": {
              "type": "string",
              "enum": [
                "collision",
                "grounding",
                "fire",
                "spill",
                "near-miss"
              ]
            },
            "lat": {
              "type": "number"
            },
            "lon": {
              "type": "number"
            },
            "narrative": {
              "type": "string"
            },
            "spillVolumeTonnes": {
              "type": "number"
            },
            "occurredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "severity": {
              "type": "string",
              "enum": [
                "minor",
                "moderate",
                "major"
              ]
            },
            "requirePublicNotice": {
              "type": "boolean"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
