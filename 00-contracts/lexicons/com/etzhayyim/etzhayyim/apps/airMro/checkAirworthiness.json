{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airMro.checkAirworthiness",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Check airworthiness directive and service bulletin compliance for an aircraft.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["tail_number", "ad_no"],
          "properties": {
            "tail_number": { "type": "string" },
            "ad_no": { "type": "string" },
            "sb_no": { "type": "string" },
            "compliance_date": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
