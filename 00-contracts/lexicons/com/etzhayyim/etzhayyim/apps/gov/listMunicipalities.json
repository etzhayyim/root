{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.gov.listMunicipalities",
  "defs": {
    "main": {
      "type": "query",
      "description": "List municipalities with optional prefecture filter.",
      "parameters": {
        "type": "params",
        "properties": {
          "prefecture": { "type": "string" },
          "limit": { "type": "integer" },
          "offset": { "type": "integer" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "municipalities": { "type": "array", "items": { "type": "object" } },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
