{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.gov.recordOfficial",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a public official's appointment to a government agency role (minister/director/commissioner/etc).",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["agencyDid", "personDid", "role", "appointedAt"],
          "properties": {
            "agencyDid": { "type": "string", "format": "did" },
            "personDid": { "type": "string", "format": "did", "description": "natural-person DID" },
            "role": { "type": "string", "description": "minister/secretary/director/commissioner/judge/etc" },
            "appointedAt": { "type": "string", "format": "datetime" },
            "termEndsAt": { "type": "string", "format": "datetime" },
            "appointedByDid": { "type": "string", "format": "did" },
            "confirmationProcess": { "type": "string", "enum": ["election", "appointment", "confirmation", "succession", "acting"] }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri"],
          "properties": {
            "uri": { "type": "string", "format": "at-uri" }
          }
        }
      }
    }
  }
}
