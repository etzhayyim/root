{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.gov.listConsults",
  "defs": {
    "main": {
      "type": "query",
      "description": "List public services consultations for a requester.",
      "parameters": {
        "type": "params",
        "properties": {
          "requesterDid": { "type": "string" },
          "domain": { "type": "string" },
          "status": { "type": "string" },
          "limit": { "type": "integer" },
          "offset": { "type": "integer" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "consults": { "type": "array", "items": { "type": "object" } },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
