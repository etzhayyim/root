{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.gov.listAgencies",
  "defs": {
    "main": {
      "type": "query",
      "description": "List government agencies with offset/limit pagination, optional filters.",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "properties": {
          "jurisdiction": { "type": "string" },
          "branch": { "type": "string" },
          "level": { "type": "string" },
          "cofog": { "type": "string" },
          "parentAgencyDid": { "type": "string", "format": "did" },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["agencies", "total", "offset", "limit"],
          "properties": {
            "agencies": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "did": { "type": "string", "format": "did" },
                  "name": { "type": "string" },
                  "nameLocal": { "type": "string" },
                  "jurisdiction": { "type": "string" },
                  "branch": { "type": "string" },
                  "cofog": { "type": "string" }
                }
              }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
