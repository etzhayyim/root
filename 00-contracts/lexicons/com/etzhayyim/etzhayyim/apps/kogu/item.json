{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kogu.item",
  "description": "工具・測定器・設備の個体登録。ISO 9001 §7.1.5 校正要求対象品は calibrationRequired=true。toolId は社内管理番号。",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["toolId", "category", "name", "custodianDid"],
        "properties": {
          "toolId": { "type": "string", "description": "社内工具管理番号" },
          "category": {
            "type": "string",
            "enum": ["hand-tool", "power-tool", "measuring-instrument", "fixture", "cutting-tool", "pneumatic-tool", "welding-equipment", "other"],
            "description": "手工具/電動工具/測定器/治具/切削工具/空圧工具/溶接設備/その他"
          },
          "name": { "type": "string" },
          "maker": { "type": "string" },
          "model": { "type": "string" },
          "serialId": { "type": "string" },
          "custodianDid": { "type": "string", "description": "管理担当者または部署 DID" },
          "locationCode": { "type": "string", "description": "保管場所コード (工場/倉庫/作業台)" },
          "acquiredAt": { "type": "string", "format": "date" },
          "acquiredPriceJpy": { "type": "number" },
          "calibrationRequired": { "type": "boolean", "description": "ISO 9001 校正管理対象フラグ" },
          "calibrationIntervalDays": { "type": "integer" },
          "nextCalibrationDate": { "type": "string", "format": "date" },
          "status": {
            "type": "string",
            "enum": ["available", "checked-out", "calibration", "repair", "retired"]
          },
          "sekkeiDrawingId": { "type": "string", "description": "sekkei.drawing.drawingId (工具仕様図)" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
