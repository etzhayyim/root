{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kogu.calibration",
  "description": "工具・測定器の校正記録。ISO 9001 §7.1.5 準拠。校正機関 DID または社内校正者 DID を記録。JCSS 認定校正は accreditedCalibration=true。",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["toolId", "calibratedAt", "calibratorDid", "result"],
        "properties": {
          "toolId": { "type": "string" },
          "calibratedAt": { "type": "string", "format": "date" },
          "calibratorDid": { "type": "string", "description": "校正機関または社内校正者 DID" },
          "accreditedCalibration": { "type": "boolean", "description": "JCSS/ISO 17025 認定校正フラグ" },
          "calibrationCertNo": { "type": "string" },
          "referenceStandardId": { "type": "string", "description": "基準器管理番号" },
          "beforeValue": { "type": "number", "description": "校正前測定値" },
          "afterValue": { "type": "number", "description": "校正後測定値" },
          "unit": { "type": "string" },
          "tolerance": { "type": "number" },
          "result": { "type": "string", "enum": ["pass", "adjusted-pass", "fail-retired"] },
          "nextCalibrationDate": { "type": "string", "format": "date" },
          "calibrationCostJpy": { "type": "number" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
