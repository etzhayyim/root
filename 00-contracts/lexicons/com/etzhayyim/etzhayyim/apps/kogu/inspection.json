{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kogu.inspection",
  "description": "工具・設備の定期点検記録。電動工具の安全点検・治具の精度確認等。result=fail 時は status=repair へ遷移。",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["toolId", "inspectedAt", "inspectorDid", "result"],
        "properties": {
          "toolId": { "type": "string" },
          "inspectedAt": { "type": "string", "format": "date" },
          "inspectorDid": { "type": "string" },
          "inspectionType": {
            "type": "string",
            "enum": ["periodic", "pre-use", "post-use", "statutory"],
            "description": "定期/使用前/使用後/法定"
          },
          "checkItems": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["checkName", "result"],
              "properties": {
                "checkName": { "type": "string" },
                "result": { "type": "string", "enum": ["ok", "caution", "ng"] },
                "note": { "type": "string" }
              }
            }
          },
          "result": { "type": "string", "enum": ["pass", "conditional-pass", "fail"] },
          "repairRequired": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
