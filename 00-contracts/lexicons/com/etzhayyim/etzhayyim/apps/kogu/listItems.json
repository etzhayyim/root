{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kogu.listItems",
  "defs": {
    "main": {
      "type": "query",
      "description": "工具・測定器一覧を category / status / custodianDid / calibration 期限でフィルタ。",
      "parameters": {
        "type": "params",
        "properties": {
          "category": { "type": "string" },
          "status": { "type": "string" },
          "custodianDid": { "type": "string" },
          "calibrationDueBefore": { "type": "string", "format": "date" },
          "calibrationRequired": { "type": "boolean" },
          "limit": { "type": "integer", "default": 50, "maximum": 500 },
          "offset": { "type": "integer", "default": 0 }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items"],
          "properties": {
            "items": { "type": "array", "items": { "type": "unknown" } },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
