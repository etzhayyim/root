{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.training.listCheckpoints",
  "defs": {
    "main": {
      "type": "query",
      "description": "List training checkpoints ordered by (run_id, step). Optional filters by run_id and is_final. Read-only over vertex_training_checkpoint.",
      "parameters": {
        "type": "params",
        "properties": {
          "runId": {"type": "string", "description": "Optional: limit to one run."},
          "onlyFinal": {"type": "boolean", "default": false, "description": "When true, return only is_final=true checkpoints."},
          "limit": {"type": "integer", "minimum": 1, "maximum": 500, "default": 50}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "checkpoints"],
          "properties": {
            "ok": {"type": "boolean"},
            "checkpoints": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "checkpointId": {"type": "string"},
                  "vertexId": {"type": "string"},
                  "runId": {"type": "string"},
                  "step": {"type": "integer"},
                  "isFinal": {"type": "boolean"},
                  "weightB2Uri": {"type": "string"},
                  "weightByteSize": {"type": "integer"},
                  "weightSha256": {"type": "string"},
                  "adapterKind": {"type": "string"},
                  "adapterRank": {"type": "integer"},
                  "trainLoss": {"type": "number"},
                  "createdAt": {"type": "string"}
                }
              }
            },
            "count": {"type": "integer"}
          }
        }
      }
    }
  }
}
