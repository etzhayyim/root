{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.training.coverage",
  "defs": {
    "main": {
      "type": "query",
      "description": "Single-shot training pipeline coverage snapshot for soak monitors / dashboards. Aggregates over the lineage tables; returns counts + last-* timestamps + B2 storage estimate.",
      "parameters": {"type": "params", "properties": {}},
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "asOf"],
          "properties": {
            "ok": {"type": "boolean"},
            "asOf": {"type": "string", "description": "Snapshot timestamp (ISO 8601 UTC)."},
            "snapshotsCount": {"type": "integer"},
            "datasetSnapshotRows": {"type": "integer", "description": "Sum of row_count across all frozen snapshots."},
            "runsTotal": {"type": "integer"},
            "runsQueued": {"type": "integer"},
            "runsRunning": {"type": "integer"},
            "runsDone": {"type": "integer"},
            "runsFailed": {"type": "integer"},
            "checkpointsTotal": {"type": "integer"},
            "checkpointsFinal": {"type": "integer"},
            "checkpointBytesTotal": {"type": "integer", "description": "Sum of weight_byte_size across all checkpoints (B2 storage)."},
            "evalsTotal": {"type": "integer"},
            "servingActiveCount": {"type": "integer"},
            "lastRunStartedAt": {"type": "string"},
            "lastCheckpointAt": {"type": "string"},
            "lastPromotedAt": {"type": "string"}
          }
        }
      }
    }
  }
}
