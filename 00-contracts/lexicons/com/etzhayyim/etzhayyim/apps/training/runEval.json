{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.training.runEval",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Run one or more benchmarks against an existing checkpoint. lm-eval-harness compatible task names plus internal benches (ADR-2604282100). Writes one row per (checkpoint, bench) into vertex_training_eval.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["checkpointId", "benches"],
          "properties": {
            "checkpointId": {"type": "string"},
            "benches": {"type": "array", "minLength": 1, "items": {"type": "string"}, "description": "e.g. ['mmlu', 'arc_challenge', 'etzhayyim-internal-shanno-bench']."},
            "evalDatasetName": {"type": "string", "description": "Optional eval split name; resolved to vertex_training_dataset_snapshot."},
            "evalDatasetRevision": {"type": "string"},
            "sampleLimit": {"type": "integer", "description": "Cap samples per bench for fast smoke evals."},
            "gpuTarget": {"type": "string"}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "checkpointId", "evalCount"],
          "properties": {
            "ok": {"type": "boolean"},
            "checkpointId": {"type": "string"},
            "evalCount": {"type": "integer"},
            "evalIds": {"type": "array", "items": {"type": "string"}},
            "primaryScores": {"type": "string", "description": "JSON-encoded { benchName: primaryScore }."},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
