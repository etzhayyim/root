{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.training.listRuns",
  "defs": {
    "main": {
      "type": "query",
      "description": "List training runs ordered by recency. Optional filters by kind / status. Read-only over vertex_training_run.",
      "parameters": {
        "type": "params",
        "properties": {
          "kind": {"type": "string", "enum": ["sft", "lora", "dpo", "distill", "pretrain"], "description": "Optional run kind filter."},
          "status": {"type": "string", "enum": ["queued", "running", "done", "failed"], "description": "Optional run status filter."},
          "limit": {"type": "integer", "minimum": 1, "maximum": 500, "default": 50}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "runs"],
          "properties": {
            "ok": {"type": "boolean"},
            "runs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "runId": {"type": "string"},
                  "vertexId": {"type": "string"},
                  "kind": {"type": "string"},
                  "baseModel": {"type": "string"},
                  "datasetSnapshotId": {"type": "string"},
                  "status": {"type": "string"},
                  "startedAt": {"type": "string"},
                  "endedAt": {"type": "string"},
                  "completedSteps": {"type": "integer"},
                  "failureReason": {"type": "string"}
                }
              }
            },
            "count": {"type": "integer"}
          }
        }
      }
    }
  }
}
