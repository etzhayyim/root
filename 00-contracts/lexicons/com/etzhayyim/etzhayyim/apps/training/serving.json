{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.training.serving",
  "defs": {
    "main": {
      "type": "query",
      "description": "List active serving alias → checkpoint promotions. Read-only over mv_training_active_serving (filter status='active').",
      "parameters": {
        "type": "params",
        "properties": {
          "alias": {"type": "string", "description": "Optional: filter to one alias substring."}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "serving"],
          "properties": {
            "ok": {"type": "boolean"},
            "serving": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "alias": {"type": "string"},
                  "checkpointVertexId": {"type": "string"},
                  "servingTarget": {"type": "string"},
                  "promotedAt": {"type": "string"},
                  "promotedBy": {"type": "string"}
                }
              }
            },
            "count": {"type": "integer"}
          }
        }
      }
    }
  }
}
