{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.manimani.listProjects",
  "defs": {
    "main": {
      "type": "query",
      "description": "List projects in actor scope, optionally filtered by status / kind. Returns recent intake count from mv_manimani_project_active. Per ADR-2605080800.",
      "parameters": {
        "type": "params",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["active", "dormant", "archived"],
            "description": "Filter by lifecycle status. Default returns all non-archived."
          },
          "kind": {
            "type": "string",
            "enum": ["knowledge", "task", "memo", "unsorted"]
          },
          "limit": {
            "type": "integer",
            "default": 50,
            "minimum": 1,
            "maximum": 200
          },
          "cursor": {
            "type": "string",
            "description": "Opaque pagination cursor (last_intake_at descending)."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["projects"],
          "properties": {
            "projects": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["vertexId", "projectDid", "slug", "title", "kind", "status"],
                "properties": {
                  "vertexId": { "type": "string" },
                  "projectDid": { "type": "string" },
                  "slug": { "type": "string" },
                  "title": { "type": "string" },
                  "kind": { "type": "string" },
                  "status": { "type": "string" },
                  "intakeCount": { "type": "integer" },
                  "intakeCount30d": {
                    "type": "integer",
                    "description": "Count from mv_manimani_project_active (last 30 days)."
                  },
                  "lastIntakeAt": { "type": "string" },
                  "createdAt": { "type": "string" }
                }
              }
            },
            "cursor": { "type": "string" }
          }
        }
      }
    }
  }
}
