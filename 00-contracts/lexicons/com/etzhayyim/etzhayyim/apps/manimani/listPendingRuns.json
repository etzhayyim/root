{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.manimani.listPendingRuns",
  "defs": {
    "main": {
      "type": "query",
      "description": "List runs paused at the HITL gate (status='interrupted'), newest first. Each entry includes the classifier proposal + rationale recovered from the LangGraph checkpoint chain so a UI can render the review queue without a separate per-run lookup. Per ADR-2605080800 Phase 7.",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": {
            "type": "integer",
            "default": 25,
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["runs"],
          "properties": {
            "runs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["runId", "intakeId", "status", "startedAt"],
                "properties": {
                  "runId": { "type": "string" },
                  "intakeId": { "type": "string" },
                  "status": {
                    "type": "string",
                    "enum": ["pending", "running", "completed", "completed_with_error", "failed", "interrupted"]
                  },
                  "startedAt": { "type": "string" },
                  "currentNode": { "type": "string" },
                  "pendingClassification": {
                    "type": "object",
                    "description": "Recovered from vertex_langgraph_checkpoint by thread_id=runId. Empty when checkpoint has been pruned.",
                    "properties": {}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
