{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openPatent.acknowledgeSeiyakuBatchStart",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Acknowledge that a queued openSeiyaku.startBatchRecord request has been accepted by the open-seiyaku batch workflow.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["startRequestVid"],
          "properties": {
            "startRequestVid": { "type": "string" },
            "seiyakuInstanceKey": { "type": "integer" },
            "seiyakuBatchVertexId": { "type": "string" },
            "status": {
              "type": "string",
              "enum": ["accepted", "rejected", "started"]
            },
            "message": { "type": "string" },
            "dryRun": { "type": "boolean" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "status": { "type": "string" },
            "startRequestVid": { "type": "string" },
            "seiyakuInstanceKey": { "type": "integer" },
            "seiyakuBatchVertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
