{
  "$type": "lex:com.atproto.lexicon.schema",
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openPatent.noveltyReport",
  "defs": {
    "main": {
      "type": "record",
      "description": "Prior art search result + LLM novelty assessment for an invention seed",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["seedVid", "overallNoveltyScore", "reasoning", "createdAt"],
        "properties": {
          "seedVid": { "type": "string", "description": "AT URI of the inventionSeed record" },
          "priorArtCount": { "type": "integer" },
          "priorArtVids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "AT URIs of similar existing patents"
          },
          "similarityScores": {
            "type": "array",
            "items": { "type": "ref", "ref": "#similarityItem" }
          },
          "overallNoveltyScore": { "type": "integer", "minimum": 0, "maximum": 100 },
          "reasoning": { "type": "string", "maxLength": 4000 },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    },
    "similarityItem": {
      "type": "object",
      "required": ["patentVid", "score"],
      "properties": {
        "patentVid": { "type": "string" },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
