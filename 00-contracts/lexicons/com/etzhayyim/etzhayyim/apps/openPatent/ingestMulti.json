{
  "$type": "lex:com.atproto.lexicon.schema",
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openPatent.ingestMulti",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Multi-jurisdiction patent enrichment coordinator (Follow-based: reads from AT firehose data already ingested by patent.etzhayyim.com)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "jurisdictions": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Jurisdiction codes: ['us', 'ep', 'jp', 'wo']. Default: all."
            },
            "batchSize": { "type": "integer", "default": 100 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "results": {
              "type": "array",
              "items": { "type": "ref", "ref": "#jurisdictionResult" }
            },
            "error": { "type": "string" }
          }
        }
      }
    },
    "jurisdictionResult": {
      "type": "object",
      "required": ["jurisdiction", "ok"],
      "properties": {
        "jurisdiction": { "type": "string" },
        "ok": { "type": "boolean" },
        "citationsAdded": { "type": "integer" },
        "familyEdgesAdded": { "type": "integer" },
        "skipped": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    }
  }
}
