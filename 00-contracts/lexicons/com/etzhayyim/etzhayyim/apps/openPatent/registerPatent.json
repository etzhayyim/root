{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openPatent.registerPatent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "特許登録 - Starts BPMN open_patent_register_patent.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "officeOrgId",
            "patentNumber",
            "jurisdiction",
            "filingDate"
          ],
          "properties": {
            "officeOrgId": {
              "type": "string"
            },
            "patentNumber": {
              "type": "string"
            },
            "jurisdiction": {
              "type": "string",
              "description": "ISO 3166 alpha-3"
            },
            "title": {
              "type": "string"
            },
            "inventorNames": {
              "type": "string"
            },
            "assigneeDid": {
              "type": "string"
            },
            "ipcClasses": {
              "type": "string"
            },
            "filingDate": {
              "type": "string",
              "format": "date"
            },
            "grantDate": {
              "type": "string",
              "format": "date"
            },
            "priorityDate": {
              "type": "string",
              "format": "date"
            },
            "noveltyScore": {
              "type": "number"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "verification": {
              "type": "string",
              "enum": [
                "authoritative",
                "community",
                "candidate"
              ]
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
