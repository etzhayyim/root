{
  "$type": "lex:com.atproto.lexicon.schema",
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openPatent.synthesizeInvention",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "LangGraph Pregel: generate invention seeds from patent corpus, assess novelty, flag for HITL review",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "techDomainLimit": { "type": "integer", "default": 5, "description": "Max tech domains to sample" },
            "seedsPerDomain": { "type": "integer", "default": 3 },
            "noveltyThreshold": { "type": "integer", "default": 60, "description": "Min score to flag for HITL review" },
            "dryRun": { "type": "boolean", "default": false }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "seedsGenerated", "seedsFlagged"],
          "properties": {
            "ok": { "type": "boolean" },
            "seedsGenerated": { "type": "integer" },
            "seedsFlagged": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
