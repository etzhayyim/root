{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openPatent.recordDrugRegulatoryBlocker",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a regulatory, litigation, or secondary-patent blocker that prevents an expired pharmaceutical patent from moving directly into manufacturing candidacy.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["patentVertexId", "patentNumber", "jurisdiction", "blockerType", "blockingUntil"],
          "properties": {
            "patentVertexId": { "type": "string" },
            "patentNumber": { "type": "string" },
            "jurisdiction": { "type": "string" },
            "productId": { "type": "string" },
            "blockerType": {
              "type": "string",
              "enum": [
                "regulatory_exclusivity",
                "pediatric_exclusivity",
                "orphan_exclusivity",
                "data_exclusivity",
                "secondary_patent",
                "litigation_stay",
                "market_exclusivity",
                "other"
              ]
            },
            "blockingUntil": { "type": "string", "format": "date" },
            "source": { "type": "string" },
            "evidenceUri": { "type": "string" },
            "asOf": { "type": "string", "format": "date" },
            "dryRun": { "type": "boolean" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "active": { "type": "boolean" },
            "status": { "type": "string" },
            "blockingUntil": { "type": "string", "format": "date" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
