{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.fedSwapUsage.recordUsage",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Fed central bank swap line usage (Standing/FIMA/emergency — bridges xccyBasis.flagBlowout + fx-swap-lines + treasury-market-stress)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "usageId",
            "counterpartyCb",
            "swapKind",
            "drawnAt"
          ],
          "properties": {
            "usageId": {
              "type": "string"
            },
            "counterpartyCb": {
              "type": "string",
              "enum": [
                "ecb",
                "boe",
                "boj",
                "snb",
                "boc",
                "pboc_cdh",
                "rba",
                "sek",
                "korea",
                "india",
                "mexico",
                "brazil",
                "fima_non_standing"
              ]
            },
            "swapKind": {
              "type": "string",
              "enum": [
                "standing_core",
                "fima_repo",
                "emergency_bilateral",
                "dollar_auction_ope_market",
                "central_bank_counterparty",
                "non_primary_dealer_access",
                "chiangmai",
                "cmim_plus",
                "swap_plus"
              ]
            },
            "notionalBusd": {
              "type": "number"
            },
            "basisBlowoutVid": {
              "type": "string",
              "description": "bridges xccyBasis.flagBlowout"
            },
            "drawnAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}