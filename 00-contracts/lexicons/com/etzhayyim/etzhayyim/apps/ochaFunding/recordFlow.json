{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ochaFunding.recordFlow",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "OCHA FTS humanitarian funding flow (bridges disaster-response + refugee-unhcr + climate-adaptation-finance)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flowId",
            "sourceType",
            "recipientType",
            "destinationIso3",
            "amountUsd",
            "flowDate",
            "recordedAt"
          ],
          "properties": {
            "flowId": {
              "type": "string"
            },
            "sourceLei": {
              "type": "string"
            },
            "sourceType": {
              "type": "string",
              "enum": [
                "government",
                "private_org",
                "private_individual",
                "un_agency",
                "ngo",
                "pooled_fund",
                "other"
              ]
            },
            "recipientLei": {
              "type": "string"
            },
            "recipientType": {
              "type": "string",
              "enum": [
                "un_agency",
                "red_cross",
                "ngo",
                "government",
                "affected_population"
              ]
            },
            "destinationIso3": {
              "type": "string"
            },
            "emergencyCode": {
              "type": "string",
              "description": "HRP/flash appeal code"
            },
            "sectorCluster": {
              "type": "string",
              "enum": [
                "food",
                "health",
                "shelter",
                "wash",
                "education",
                "protection",
                "logistics",
                "nutrition",
                "camp"
              ]
            },
            "amountUsd": {
              "type": "number"
            },
            "pledged": {
              "type": "boolean",
              "description": "pledged vs committed/paid"
            },
            "flowDate": {
              "type": "string"
            },
            "recordedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "scaleTier": {
              "type": "string",
              "enum": [
                "small",
                "medium",
                "large",
                "mega"
              ]
            }
          }
        }
      }
    }
  }
}