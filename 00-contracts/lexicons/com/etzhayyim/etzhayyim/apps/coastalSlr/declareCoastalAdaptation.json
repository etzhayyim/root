{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.coastalSlr.declareCoastalAdaptation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Coastal protect / accommodate / retreat plan (bridges climate-adaptation-finance)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "planId",
            "adaptationType",
            "declaredAt"
          ],
          "properties": {
            "planId": {
              "type": "string"
            },
            "measurementVid": {
              "type": "string",
              "description": "bridges recordSlrMeasurement"
            },
            "adaptationType": {
              "type": "string",
              "enum": [
                "protect_hard",
                "protect_soft",
                "accommodate",
                "managed_retreat",
                "advance",
                "hybrid"
              ]
            },
            "financeProjectVid": {
              "type": "string",
              "description": "bridges open-climate-adaptation-finance"
            },
            "budgetUsd": {
              "type": "number"
            },
            "timelineYears": {
              "type": "integer"
            },
            "housingUnitsAffected": {
              "type": "integer"
            },
            "declaredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}