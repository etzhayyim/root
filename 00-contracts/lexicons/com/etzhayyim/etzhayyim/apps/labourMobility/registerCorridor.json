{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.labourMobility.registerCorridor",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Labour mobility corridor (GCM / BLAs — bridges refugee-unhcr + forced-labor + just-transition + crew-welfare)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "corridorId",
            "originIso3",
            "destinationIso3",
            "instrument",
            "effectiveFrom"
          ],
          "properties": {
            "corridorId": {
              "type": "string"
            },
            "originIso3": {
              "type": "string"
            },
            "destinationIso3": {
              "type": "string"
            },
            "instrument": {
              "type": "string",
              "enum": [
                "bla",
                "mou",
                "gcm_compact",
                "eu_blue_card",
                "caricom",
                "asean",
                "ecowas"
              ]
            },
            "sectorIsic": {
              "type": "string",
              "description": "bridges open-isic"
            },
            "annualQuota": {
              "type": "integer"
            },
            "durationMonths": {
              "type": "integer"
            },
            "pathwayToResidence": {
              "type": "boolean"
            },
            "effectiveFrom": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}