{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.labourMobility.flagRecruitmentAbuse",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Recruitment abuse / Fair Recruitment Principles violation",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "abuseId",
            "corridorVid",
            "abuseType",
            "reportedAt"
          ],
          "properties": {
            "abuseId": {
              "type": "string"
            },
            "corridorVid": {
              "type": "string",
              "description": "bridges registerCorridor"
            },
            "recruiterLei": {
              "type": "string"
            },
            "abuseType": {
              "type": "string",
              "enum": [
                "recruitment_fees",
                "deception",
                "contract_substitution",
                "passport_confiscation",
                "wage_theft",
                "debt_bondage",
                "forced_overtime"
              ]
            },
            "workersAffected": {
              "type": "integer"
            },
            "forcedLaborVid": {
              "type": "string",
              "description": "bridges open-forced-labor"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "moderate",
                "strong",
                "severe"
              ]
            }
          }
        }
      }
    }
  }
}