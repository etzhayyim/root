{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.portStateMeasures.flagEvasionPattern",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Port-hopping / flag-of-convenience evasion pattern (bridges fisheryCollapse.flagQuotaBreach + fisheries-iuu + seafood-traceability)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "patternId",
            "inspectionVid",
            "evasionKind",
            "reportedAt"
          ],
          "properties": {
            "patternId": {
              "type": "string"
            },
            "inspectionVid": {
              "type": "string",
              "description": "bridges recordInspection"
            },
            "evasionKind": {
              "type": "string",
              "enum": [
                "port_hopping",
                "flag_hopping",
                "transshipment_evasion",
                "ais_gap",
                "document_forgery",
                "vessel_id_change",
                "beneficial_owner_hidden",
                "double_flagging",
                "registry_lag"
              ]
            },
            "psmaStateCount": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}