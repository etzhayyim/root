{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.eudrDeforestation.recordDueDiligence",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "EUDR Reg 2023/1115 / US FOREST Act / UK Sch 17 due-diligence statement (bridges forestry-mrv + seafood-traceability + customs-clearance + textile-circularity)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "statementId",
            "regime",
            "commodityHs",
            "commodityName",
            "submittedAt"
          ],
          "properties": {
            "statementId": {
              "type": "string"
            },
            "operatorLei": {
              "type": "string"
            },
            "regime": {
              "type": "string",
              "enum": [
                "eu_eudr",
                "us_forest_act",
                "uk_schedule_17",
                "kr_smdi",
                "au_illegal_logging"
              ]
            },
            "commodityHs": {
              "type": "string"
            },
            "commodityName": {
              "type": "string",
              "enum": [
                "cattle",
                "cocoa",
                "coffee",
                "oil_palm",
                "rubber",
                "soy",
                "wood",
                "leather",
                "charcoal",
                "printed_paper"
              ]
            },
            "originCountryIso3": {
              "type": "string"
            },
            "geolocationHectares": {
              "type": "number"
            },
            "deforestationFreeCertPresent": {
              "type": "boolean"
            },
            "submittedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}