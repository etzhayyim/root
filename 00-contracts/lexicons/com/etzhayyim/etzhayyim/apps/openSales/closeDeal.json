{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openSales.closeDeal",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Close a sales deal as won or lost. Updates opportunity status and stage. Starts BPMN open_sales_close_deal.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["oppId", "outcome"],
          "properties": {
            "oppId":      { "type": "string" },
            "outcome":    { "type": "string", "knownValues": ["won", "lost"] },
            "lostReason": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["vertexId"],
          "properties": {
            "vertexId":    { "type": "string" },
            "status":      { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error":       { "type": "string" }
          }
        }
      }
    }
  }
}
