{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openSales.listOpportunities",
  "defs": {
    "main": {
      "type": "query",
      "description": "List sales opportunities with optional filters. Reads from vertex_open_sales_opportunity.",
      "parameters": {
        "type": "params",
        "properties": {
          "stage":        { "type": "string" },
          "ownerDid":     { "type": "string" },
          "minAmountUsd": { "type": "number" },
          "limit":        { "type": "integer", "default": 50, "maximum": 200 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["opportunities", "total"],
          "properties": {
            "opportunities": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "vertexId":       { "type": "string" },
                  "oppId":          { "type": "string" },
                  "title":          { "type": "string" },
                  "stage":          { "type": "string" },
                  "amountUsd":      { "type": "number" },
                  "probabilityPct": { "type": "number" },
                  "closeDate":      { "type": "string" },
                  "ownerDid":       { "type": "string" },
                  "status":         { "type": "string" }
                }
              }
            },
            "total": { "type": "integer" }
          }
        }
      }
    }
  }
}
