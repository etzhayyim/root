{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openSales.generateQuote",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Generate a sales quote with LLM-powered summary. Starts BPMN open_sales_generate_quote which calls generic.llm.json then saves to vertex_open_sales_quote.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["quoteId", "oppDid"],
          "properties": {
            "quoteId":       { "type": "string" },
            "oppDid":        { "type": "string" },
            "oppTitle":      { "type": "string" },
            "amountUsd":     { "type": "number" },
            "currency":      { "type": "string" },
            "validUntil":    { "type": "string" },
            "lineItemsJson": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["vertexId"],
          "properties": {
            "vertexId":    { "type": "string" },
            "status":      { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error":       { "type": "string" }
          }
        }
      }
    }
  }
}
