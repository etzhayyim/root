{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kami.ketsuGorilla.submitScore",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Submit a Goriketsu Dash score.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "score": { "type": "number" },
            "slaps": { "type": "number" },
            "bananas": { "type": "number" },
            "runSec": { "type": "number" },
            "playerDid": { "type": "string" }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "scoreId": { "type": "string" }
          },
          "required": ["ok"]
        }
      }
    }
  }
}
