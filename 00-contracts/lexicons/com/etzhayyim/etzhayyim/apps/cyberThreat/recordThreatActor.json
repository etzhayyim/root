{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.cyberThreat.recordThreatActor",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "脅威 actor 追跡 (MITRE ATT&CK)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "actorIdCode",
            "actorName",
            "firstObserved"
          ],
          "properties": {
            "actorIdCode": {
              "type": "string",
              "description": "Mandiant APT# / MITRE G# / Crowdstrike BEAR/PANDA"
            },
            "actorName": {
              "type": "string"
            },
            "aliases": {
              "type": "string"
            },
            "attribution": {
              "type": "string",
              "description": "state / criminal / hacktivist / insider"
            },
            "suspectedNexus": {
              "type": "string",
              "description": "ISO 3166-1 alpha-3 or unknown"
            },
            "primaryMotivation": {
              "type": "string",
              "enum": [
                "espionage",
                "financial",
                "disruption",
                "ideological",
                "unknown"
              ]
            },
            "firstObserved": {
              "type": "string",
              "format": "date"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "capabilityTier": {
              "type": "string",
              "enum": [
                "script-kiddie",
                "emerging",
                "competent",
                "advanced",
                "nation-state-top-tier"
              ]
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
