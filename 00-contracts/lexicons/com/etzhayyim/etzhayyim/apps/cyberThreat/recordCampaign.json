{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.cyberThreat.recordCampaign",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "観測された campaign + TTP",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "campaignId",
            "targetSector",
            "mitreTechniques",
            "startObserved"
          ],
          "properties": {
            "campaignId": {
              "type": "string"
            },
            "threatActorCode": {
              "type": "string"
            },
            "targetSector": {
              "type": "string"
            },
            "targetCountry": {
              "type": "string"
            },
            "mitreTactics": {
              "type": "string",
              "description": "TA0001-TA0043 pipe-delimited"
            },
            "mitreTechniques": {
              "type": "string",
              "description": "T1234 etc pipe-delimited"
            },
            "startObserved": {
              "type": "string",
              "format": "date"
            },
            "endObserved": {
              "type": "string",
              "format": "date"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "impactTier": {
              "type": "string",
              "enum": [
                "limited",
                "regional",
                "global",
                "systemic"
              ]
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
