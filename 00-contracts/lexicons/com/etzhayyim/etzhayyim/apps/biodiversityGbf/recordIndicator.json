{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.biodiversityGbf.recordIndicator",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "KM-GBF target indicator (CBD COP15 — bridges mining + agri-food-security + cultural-heritage)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "indicatorId",
            "countryIso3",
            "gbfTarget",
            "indicatorCode",
            "reportedYear",
            "reportedAt"
          ],
          "properties": {
            "indicatorId": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "gbfTarget": {
              "type": "string",
              "description": "target 1-23"
            },
            "indicatorCode": {
              "type": "string",
              "description": "A.1 / A.2 / B.1 etc"
            },
            "valueNumeric": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            },
            "baselineValue": {
              "type": "number"
            },
            "targetValue2030": {
              "type": "number"
            },
            "reportedYear": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "progressTier": {
              "type": "string",
              "enum": [
                "off_track",
                "partial",
                "on_track"
              ]
            }
          }
        }
      }
    }
  }
}