{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.foodWasteEpr.reportFoodLoss",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "SDG 12.3 food loss & waste report (bridges agri-food-security + sdg-reporting + plastic-treaty)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "reportId",
            "countryIso3",
            "sector",
            "stage",
            "tonnesPerYear",
            "reportingYear",
            "reportedAt"
          ],
          "properties": {
            "reportId": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "sector": {
              "type": "string",
              "enum": [
                "production",
                "post_harvest",
                "processing",
                "distribution",
                "retail",
                "household",
                "food_service"
              ]
            },
            "stage": {
              "type": "string",
              "enum": [
                "loss",
                "waste"
              ]
            },
            "tonnesPerYear": {
              "type": "number"
            },
            "percapitaKg": {
              "type": "number"
            },
            "methodology": {
              "type": "string",
              "enum": [
                "ghg_fl_index",
                "fl_calculator",
                "fwp_fao",
                "household_diary"
              ]
            },
            "reportingYear": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "intensityTier": {
              "type": "string",
              "enum": [
                "low",
                "moderate",
                "high"
              ]
            }
          }
        }
      }
    }
  }
}