{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.foodWasteEpr.recordEprScheme",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Extended Producer Responsibility scheme for packaging/food (bridges plastic-treaty + chemicals-management)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "schemeId",
            "countryIso3",
            "scope",
            "effectiveFrom"
          ],
          "properties": {
            "schemeId": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "scope": {
              "type": "string",
              "enum": [
                "packaging",
                "food_waste",
                "electronics",
                "batteries",
                "textiles",
                "tyres",
                "plastic_bottles"
              ]
            },
            "feeBasisDescription": {
              "type": "string"
            },
            "annualFeesUsd": {
              "type": "number"
            },
            "collectionTargetPct": {
              "type": "number"
            },
            "recyclingTargetPct": {
              "type": "number"
            },
            "effectiveFrom": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}