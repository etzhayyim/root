{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.resourceFlow.registerEmitter",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Subscribe resource-flow.etzhayyim.com to a legal-entity emitter's firehose by issuing app.bsky.graph.follow and recording the emitter in vertex_profile. ADR-0028. Invoked once per emitter; idempotent on emitterDid.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["emitterDid", "industryCode"],
          "properties": {
            "emitterDid":         { "type": "string", "format": "did" },
            "emitterHandle":      { "type": "string" },
            "emitterDisplayName": { "type": "string" },
            "emitterDescription": { "type": "string" },
            "industryCode":       { "type": "string", "description": "ISIC rev4 (e.g. I5510)" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["emitterDid", "status"],
          "properties": {
            "emitterDid": { "type": "string" },
            "status":     { "type": "string", "enum": ["registered", "already-registered"] }
          }
        }
      },
      "errors": [
        { "name": "IndividualDidRejected", "description": "emitterDid is not a recognized legal-entity DID" }
      ]
    }
  }
}
