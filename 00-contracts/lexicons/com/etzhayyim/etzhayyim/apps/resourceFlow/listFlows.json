{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.resourceFlow.listFlows",
  "defs": {
    "main": {
      "type": "query",
      "description": "Paginated list of recently-projected flow events. Reads vertex_resource_flow_{currency,service,personnel} directly. Tier 1 / aggregate fields only.",
      "parameters": {
        "type": "params",
        "required": ["flowClass"],
        "properties": {
          "flowClass":    { "type": "string", "enum": ["currency", "service", "personnel"] },
          "sourceDid":    { "type": "string", "format": "did" },
          "fiscalPeriod": { "type": "string" },
          "limit":        { "type": "integer", "minimum": 1, "maximum": 500, "default": 50 },
          "offset":       { "type": "integer", "minimum": 0, "default": 0 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["flowClass", "flows", "total", "offset", "limit"],
          "properties": {
            "flowClass": { "type": "string" },
            "flows":     { "type": "array", "items": { "type": "object" } },
            "total":     { "type": "integer" },
            "offset":    { "type": "integer" },
            "limit":     { "type": "integer" }
          }
        }
      }
    }
  }
}
