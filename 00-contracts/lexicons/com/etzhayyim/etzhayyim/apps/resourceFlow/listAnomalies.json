{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.resourceFlow.listAnomalies",
  "defs": {
    "main": {
      "type": "query",
      "description": "Paginated list of resource-flow anomalies (vertex_resource_flow_anomaly), sorted by observed_at desc. Phase 13 detector writes the rows; this Phase 14'' query exposes them to AppViews and Follow consumers without leaking any PII (anomalies are tier-1 aggregate by construction).",
      "parameters": {
        "type": "params",
        "properties": {
          "flowClass":     { "type": "string", "enum": ["currency", "service", "personnel"] },
          "severity":      { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "sourceDid":     { "type": "string", "format": "did" },
          "fiscalPeriod":  { "type": "string" },
          "since":         { "type": "string", "description": "ISO 8601 lower bound on observed_at" },
          "reviewed":      { "type": "string", "enum": ["any", "open", "closed"], "default": "open",
            "description": "open = no review row, closed = at least one review action recorded, any = both." },
          "limit":         { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
          "offset":        { "type": "integer", "minimum": 0, "default": 0 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["anomalies", "total", "offset", "limit"],
          "properties": {
            "anomalies": { "type": "array", "items": { "type": "object" } },
            "total":     { "type": "integer" },
            "offset":    { "type": "integer" },
            "limit":     { "type": "integer" }
          }
        }
      }
    }
  }
}
