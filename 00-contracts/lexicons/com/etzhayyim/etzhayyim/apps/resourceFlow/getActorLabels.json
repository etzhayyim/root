{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.resourceFlow.getActorLabels",
  "defs": {
    "main": {
      "type": "query",
      "description": "Bulk-resolve actor display labels for a set of DIDs (facade or ADR-0074 ERC725 root). Reads view_resource_flow_actor_label which JOINs vertex_profile + edge_erc725_facade_did, so callers get one round-trip instead of N app.bsky.actor.getProfile calls. Cluster-wide; not yadoya-specific.",
      "parameters": {
        "type": "params",
        "required": ["dids"],
        "properties": {
          "dids": {
            "type": "array",
            "items": { "type": "string", "format": "did" },
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["labels"],
          "properties": {
            "labels": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["did"],
                "properties": {
                  "did":              { "type": "string" },
                  "kind":             { "type": "string", "enum": ["facade", "root"] },
                  "facadeDid":        { "type": "string" },
                  "rootDid":          { "type": "string" },
                  "handle":           { "type": "string" },
                  "displayName":      { "type": "string" },
                  "description":      { "type": "string" },
                  "rootIdentityAddr": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
