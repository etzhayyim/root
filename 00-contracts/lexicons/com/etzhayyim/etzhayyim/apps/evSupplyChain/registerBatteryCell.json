{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.evSupplyChain.registerBatteryCell",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "EV battery cell / pack production (EU Battery Passport / IRA FEOC / chemistries — bridges criticalMinerals.registerMineralFlow + green-transition)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "cellId",
            "chemistry",
            "factoryCountryIso3",
            "manufacturedAt"
          ],
          "properties": {
            "cellId": {
              "type": "string"
            },
            "manufacturerLei": {
              "type": "string"
            },
            "chemistry": {
              "type": "string",
              "enum": [
                "ncm_811",
                "ncm_622",
                "ncm_532",
                "nca",
                "lfp",
                "lmfp",
                "lto",
                "sodium_ion",
                "solid_state",
                "lithium_sulfur"
              ]
            },
            "capacityKwh": {
              "type": "number"
            },
            "factoryCountryIso3": {
              "type": "string"
            },
            "mineralFlowVid": {
              "type": "string",
              "description": "bridges criticalMinerals.registerMineralFlow"
            },
            "passportId": {
              "type": "string",
              "description": "EU Battery Passport"
            },
            "manufacturedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}