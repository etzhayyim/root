{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.states.govDocument",
  "defs": {
    "main": {
      "type": "record",
      "description": "Government document (HTML page / PDF / notice) captured from a govSource.",
      "x-bootstrap": true,
      "key": "any",
      "record": {
        "type": "object",
        "required": [],
        "properties": {
          "actorDid": { "type": "string" },
          "actorPath": { "type": "string" },
          "actorName": { "type": "string" },
          "sourceUrl": { "type": "string", "format": "uri" },
          "docType": { "type": "string" },
          "mimeType": { "type": "string" },
          "title": { "type": "string" },
          "publishedAt": { "type": "string", "format": "datetime" },
          "fetchedAt": { "type": "string", "format": "datetime" },
          "renderStatus": { "type": "string" },
          "ocrStatus": { "type": "string" },
          "textStatus": { "type": "string" },
          "lineageStatus": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    }
  }
}
