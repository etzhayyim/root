{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.states.bpmnElement",
  "defs": {
    "main": {
      "type": "record",
      "description": "BPMN element (task / gateway / event) within a bpmnProcess. Maps to vertex_bpmn_element.",
      "x-bootstrap": true,
      "key": "any",
      "record": {
        "type": "object",
        "required": ["element_id", "element_type"],
        "properties": {
          "element_id": { "type": "string" },
          "name": { "type": "string" },
          "element_type": { "type": "string" },
          "process_did": { "type": "string" },
          "mcp_primitive": { "type": "string" },
          "camunda_type": { "type": "string" },
          "camunda_expression": { "type": "string" },
          "camunda_form_ref": { "type": "string" },
          "camunda_form_key": { "type": "string" },
          "camunda_decision_ref": { "type": "string" },
          "camunda_result_variable": { "type": "string" },
          "script_format": { "type": "string" },
          "script_body": { "type": "string" },
          "event_type": { "type": "string" },
          "timer_definition": { "type": "string" },
          "timer_type": { "type": "string" },
          "signal_ref": { "type": "string" },
          "message_ref": { "type": "string" },
          "error_ref": { "type": "string" },
          "is_interrupting": { "type": "string" },
          "attached_to_ref": { "type": "string" },
          "multi_instance_type": { "type": "string" },
          "mi_collection": { "type": "string" },
          "mi_element_variable": { "type": "string" },
          "mi_completion_condition": { "type": "string" },
          "loop_condition": { "type": "string" },
          "loop_maximum": { "type": "integer" },
          "async_before": { "type": "string" },
          "async_after": { "type": "string" },
          "retry_cycle": { "type": "string" },
          "extensions_json": { "type": "string" },
          "listeners_json": { "type": "string" },
          "io_mapping_json": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    }
  }
}
