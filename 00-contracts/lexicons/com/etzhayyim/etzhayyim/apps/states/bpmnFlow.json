{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.states.bpmnFlow",
  "defs": {
    "main": {
      "type": "record",
      "description": "BPMN sequence flow connecting two bpmnElements. Maps to vertex_bpmn_flow.",
      "x-bootstrap": true,
      "key": "any",
      "record": {
        "type": "object",
        "required": ["flow_id", "source_element_id", "target_element_id"],
        "properties": {
          "flow_id": { "type": "string" },
          "process_id": { "type": "string" },
          "source_element_id": { "type": "string" },
          "target_element_id": { "type": "string" },
          "flow_name": { "type": "string" },
          "condition_expression": { "type": "string" },
          "created_at": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
