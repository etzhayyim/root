{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.states.govMunicipalityCoverage",
  "defs": {
    "main": {
      "type": "record",
      "description": "Per-municipality coverage metric. Maps to vertex_gov_municipality.",
      "x-bootstrap": true,
      "key": "any",
      "record": {
        "type": "object",
        "required": ["municipality_code"],
        "properties": {
          "actorDid": { "type": "string" },
          "municipality_code": { "type": "string" },
          "prefecture": { "type": "string" },
          "city": { "type": "string" },
          "coverage_pct": { "type": "number" },
          "site_url": { "type": "string", "format": "uri" },
          "status": { "type": "string" },
          "created_at": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
