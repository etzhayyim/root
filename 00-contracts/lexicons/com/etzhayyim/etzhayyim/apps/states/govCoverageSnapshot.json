{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.states.govCoverageSnapshot",
  "defs": {
    "main": {
      "type": "record",
      "description": "Periodic coverage snapshot for a government actor. Coverage ratios (0..1) and raw counts.",
      "x-bootstrap": true,
      "key": "any",
      "record": {
        "type": "object",
        "required": ["snapshotTs"],
        "properties": {
          "actorDid": { "type": "string" },
          "actorPath": { "type": "string" },
          "actorName": { "type": "string" },
          "domainCode": { "type": "string" },
          "orgTier": { "type": "string" },
          "canonicalCoverage": { "type": "number" },
          "entityCoverage": { "type": "number" },
          "sourceCoverage": { "type": "number" },
          "documentCoverage": { "type": "number" },
          "knowledgeCoverage": { "type": "number" },
          "overallCoverage": { "type": "number" },
          "expectedEntityCount": { "type": "integer" },
          "actualEntityCount": { "type": "integer" },
          "expectedSourceTypesJson": { "type": "string" },
          "coveredSourceTypesJson": { "type": "string" },
          "expectedDocumentClassesJson": { "type": "string" },
          "coveredDocumentClassesJson": { "type": "string" },
          "discoveredDocs": { "type": "integer" },
          "fetchedDocs": { "type": "integer" },
          "renderedDocs": { "type": "integer" },
          "ocrDocs": { "type": "integer" },
          "linkedDocs": { "type": "integer" },
          "snapshotTs": { "type": "string", "format": "datetime" },
          "gapSummary": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    }
  }
}
