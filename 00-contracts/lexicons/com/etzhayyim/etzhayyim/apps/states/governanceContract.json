{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.states.governanceContract",
  "defs": {
    "main": {
      "type": "record",
      "description": "Governance contract (設置法 / enabling act / charter) that grounds a govOrg. Maps to vertex_governance_contract.",
      "x-bootstrap": true,
      "key": "any",
      "record": {
        "type": "object",
        "required": ["contract_slug"],
        "properties": {
          "contract_did": { "type": "string" },
          "contract_slug": { "type": "string" },
          "name": { "type": "string" },
          "name_en": { "type": "string" },
          "legal_basis": { "type": "string" },
          "effective_date": { "type": "string", "format": "datetime" },
          "url": { "type": "string", "format": "uri" },
          "gov_level": { "type": "string" },
          "cofog_code": { "type": "string" },
          "country_code": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "seeded_at": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
