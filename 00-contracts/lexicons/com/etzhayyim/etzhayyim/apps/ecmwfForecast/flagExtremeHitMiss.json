{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ecmwfForecast.flagExtremeHitMiss",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Extreme weather hit / miss / false alarm (bridges extreme-weather-attribution + cyclone-prepo + disaster-response)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "eventId",
            "extremeKind",
            "outcome",
            "reportedAt"
          ],
          "properties": {
            "eventId": {
              "type": "string"
            },
            "skillVid": {
              "type": "string",
              "description": "bridges recordForecastSkill"
            },
            "extremeKind": {
              "type": "string",
              "enum": [
                "heatwave",
                "coldsnap",
                "cyclone",
                "flood",
                "drought",
                "wildfire_risk",
                "wind_storm"
              ]
            },
            "outcome": {
              "type": "string",
              "enum": [
                "hit",
                "miss",
                "false_alarm",
                "correct_negative"
              ]
            },
            "leadTimeHours": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}