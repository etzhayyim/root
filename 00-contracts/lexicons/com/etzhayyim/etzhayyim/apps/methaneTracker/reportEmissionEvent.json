{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.methaneTracker.reportEmissionEvent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "IMEO / MARS / EDF MethaneSAT plume observation (bridges climate-carbon-market + hydrogen-economy + agri-food-security)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "eventId",
            "source",
            "locationIso3",
            "emissionKgPerHour",
            "detectionPlatform",
            "observedAt"
          ],
          "properties": {
            "eventId": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "enum": [
                "oil_gas",
                "coal",
                "landfill",
                "livestock",
                "rice_paddy",
                "wetland",
                "permafrost",
                "wastewater"
              ]
            },
            "locationIso3": {
              "type": "string"
            },
            "locationLat": {
              "type": "number"
            },
            "locationLon": {
              "type": "number"
            },
            "emissionKgPerHour": {
              "type": "number"
            },
            "detectionPlatform": {
              "type": "string",
              "enum": [
                "tropomi",
                "methanesat",
                "carbonmapper",
                "emit",
                "sentinel5p",
                "ghgsat",
                "ground"
              ]
            },
            "operatorLei": {
              "type": "string"
            },
            "observedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "plumeTier": {
              "type": "string",
              "enum": [
                "background",
                "moderate",
                "large",
                "super_emitter"
              ]
            }
          }
        }
      }
    }
  }
}