{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.universalHealthCoverage.reportUhcIndex",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "WHO UHC Service Coverage Index (bridges pharma-supply + pandemic-preparedness + cofog)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "reportId",
            "countryIso3",
            "scoreValue",
            "reportedYear",
            "reportedAt"
          ],
          "properties": {
            "reportId": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "scoreValue": {
              "type": "integer",
              "description": "UHC SCI 0-100"
            },
            "financialProtectionScore": {
              "type": "integer"
            },
            "catastrophicExpenditurePct": {
              "type": "number"
            },
            "reportedYear": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "coverageTier": {
              "type": "string",
              "enum": [
                "foundational",
                "progressing",
                "developed",
                "advanced"
              ]
            }
          }
        }
      }
    }
  }
}