{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.universalHealthCoverage.recordEssentialMedicineAvailability",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "WHO EML stock availability (bridges pharma-supply + atc)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "recordId",
            "reportVid",
            "atcCode",
            "availabilityPct",
            "measuredYear"
          ],
          "properties": {
            "recordId": {
              "type": "string"
            },
            "reportVid": {
              "type": "string",
              "description": "bridges reportUhcIndex"
            },
            "atcCode": {
              "type": "string",
              "description": "bridges open-atc"
            },
            "productVid": {
              "type": "string",
              "description": "bridges open-pharma-supply"
            },
            "availabilityPct": {
              "type": "number",
              "description": "% of facilities stocked"
            },
            "stockoutDays": {
              "type": "integer"
            },
            "measuredYear": {
              "type": "integer"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "availabilityTier": {
              "type": "string",
              "enum": [
                "low",
                "moderate",
                "high"
              ]
            }
          }
        }
      }
    }
  }
}