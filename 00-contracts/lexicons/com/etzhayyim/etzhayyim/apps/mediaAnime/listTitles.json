{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.mediaAnime.listTitles",
  "defs": {
    "main": {
      "type": "query",
      "description": "List anime titles with optional season/type/source filter.",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "properties": {
          "type": { "type": "string" },
          "season": { "type": "string" },
          "sourceMaterial": { "type": "string" },
          "studioDid": { "type": "string", "format": "did" },
          "genre": { "type": "string" },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "required": ["titles", "total", "offset", "limit"], "properties": { "titles": { "type": "array", "items": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "title": { "type": "string" }, "titleEnglish": { "type": "string" }, "type": { "type": "string" }, "season": { "type": "string" }, "episodeCount": { "type": "integer" } } } }, "total": { "type": "integer" }, "offset": { "type": "integer" }, "limit": { "type": "integer" } } } }
    }
  }
}
