{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.mediaAnime.getTitle",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get an anime title by DID, MAL ID, AniList ID, or Annict ID.",
      "x-bootstrap": true,
      "parameters": { "type": "params", "properties": { "did": { "type": "string", "format": "did" }, "malId": { "type": "integer" }, "anilistId": { "type": "integer" }, "annictId": { "type": "integer" } } },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "title": { "type": "string" }, "titleEnglish": { "type": "string" }, "titleJapanese": { "type": "string" }, "titleRomaji": { "type": "string" }, "type": { "type": "string" }, "season": { "type": "string" }, "episodeCount": { "type": "integer" }, "studioDids": { "type": "array", "items": { "type": "string", "format": "did" } }, "sourceMaterial": { "type": "string" }, "malId": { "type": "integer" }, "anilistId": { "type": "integer" }, "annictId": { "type": "integer" }, "genres": { "type": "array", "items": { "type": "string" } } } } }
    }
  }
}
