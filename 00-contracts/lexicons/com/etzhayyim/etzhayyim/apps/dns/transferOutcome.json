{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.dns.transferOutcome",
  "defs": {
    "main": {
      "type": "record",
      "description": "Terminal record for a domain transfer. onCommit of this collection triggers (a) zone DID creation (did:web:dns.etzhayyim.com:zone:{domain_slug}) via cfRegistrar, (b) com.etzhayyim.apps.dns.ownershipTransfer write, (c) T1 social announce via derive rule.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["transferRequestUri", "domain", "result", "completedAt"],
        "properties": {
          "transferRequestUri": { "type": "string" },
          "domain": { "type": "string" },
          "result": { "type": "string", "enum": ["success", "failure", "aborted"] },
          "zoneDid": { "type": "string", "description": "did:web:dns.etzhayyim.com:zone:{domain_slug} — populated on success" },
          "cloudflareZoneId": { "type": "string" },
          "failureReason": { "type": "string", "maxLength": 1024 },
          "rollbackSteps": {
            "type": "array",
            "description": "Ordered list of step names rolled back on failure",
            "items": { "type": "string" },
            "maxLength": 8
          },
          "completedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
