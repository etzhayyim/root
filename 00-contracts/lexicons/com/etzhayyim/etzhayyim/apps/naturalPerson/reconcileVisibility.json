{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.naturalPerson.reconcileVisibility",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Audit and optionally reconcile natural-person visibility classes. Dry-run by default.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "applyOpenalexPublic": {
              "type": "boolean",
              "description": "When true, mark OpenAlex open natural-person rows as public_searchable."
            },
            "emitAudit": {
              "type": "boolean",
              "description": "When true, emit an OCEL audit event for the reconciliation run."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "evaluatedAt": { "type": "string", "format": "datetime" },
            "applyOpenalexPublic": { "type": "boolean" },
            "plannedOpenalexPublic": { "type": "integer" },
            "updatedOpenalexPublic": { "type": "integer" },
            "businessUnclassified": { "type": "integer" },
            "cohortHashCollisionGroups": { "type": "integer" }
          },
          "required": ["evaluatedAt", "applyOpenalexPublic"]
        }
      }
    }
  }
}
