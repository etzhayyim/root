{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.naturalPerson.importCensusSource",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "sourceName": { "type": "string" },
            "sourceOrg": { "type": "string" },
            "sourceUrl": { "type": "string", "format": "uri" },
            "dataYear": { "type": "integer" },
            "dimensions": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["sourceName", "sourceOrg"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "sourceId": { "type": "string" },
            "status": { "type": "string" }
          },
          "required": ["sourceId", "status"]
        }
      }
    }
  }
}
