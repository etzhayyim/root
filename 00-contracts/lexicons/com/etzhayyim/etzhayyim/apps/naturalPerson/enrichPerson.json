{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.naturalPerson.enrichPerson",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "personHash": { "type": "string" },
            "name": { "type": "string" },
            "country": { "type": "string" },
            "organization": { "type": "string" }
          },
          "required": ["personHash"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "personHash": { "type": "string" },
            "enrichmentCount": { "type": "integer" },
            "status": { "type": "string" }
          },
          "required": ["personHash", "status"]
        }
      }
    }
  }
}
