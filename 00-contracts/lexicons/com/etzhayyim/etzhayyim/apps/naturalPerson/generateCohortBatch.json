{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.naturalPerson.generateCohortBatch",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "country": { "type": "string" },
            "region": { "type": "string" },
            "age": { "type": "integer" },
            "gender": { "type": "string" },
            "vitalStatus": { "type": "string" },
            "era": { "type": "string" },
            "incomeDecile": { "type": "integer" },
            "educationIsced": { "type": "string" },
            "occupationIsco": { "type": "string" },
            "employmentStatus": { "type": "string" }
          },
          "required": ["country", "vitalStatus", "era"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "cohortHash": { "type": "string" },
            "did": { "type": "string" },
            "dataClassification": { "type": "string" },
            "created": { "type": "boolean" }
          },
          "required": ["cohortHash", "did"]
        }
      }
    }
  }
}
