{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.naturalPerson.evalCompliance",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "cohortHash": { "type": "string" },
            "jurisdiction": { "type": "string" }
          },
          "required": ["cohortHash"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "dataClassification": { "type": "string" },
            "jurisdiction": { "type": "string" },
            "rationale": { "type": "string" },
            "protectionPeriodYears": { "type": "integer" },
            "expired": { "type": "boolean" }
          },
          "required": ["dataClassification", "jurisdiction", "rationale"]
        }
      }
    }
  }
}
