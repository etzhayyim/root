{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ofacSanctionsSdn.listSdn",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "OFAC SDN / Non-SDN list addition (bridges sanctions + lei + forced-labor + swift)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "sdnId",
            "sdnProgram",
            "listType",
            "listedAt"
          ],
          "properties": {
            "sdnId": {
              "type": "string"
            },
            "entityLei": {
              "type": "string"
            },
            "sdnProgram": {
              "type": "string",
              "enum": [
                "SDGT",
                "IRAN",
                "NKOREA",
                "RUSSIA",
                "UKRAINE",
                "VENEZUELA",
                "CUBA",
                "MYANMAR",
                "SYRIA",
                "CYBER2",
                "NARCOTICS",
                "MAGNITSKY",
                "UFLPA"
              ]
            },
            "listType": {
              "type": "string",
              "enum": [
                "SDN",
                "NS",
                "SSI",
                "FSE"
              ]
            },
            "forcedLaborFlagVid": {
              "type": "string",
              "description": "bridges open-forced-labor"
            },
            "listedAt": {
              "type": "string",
              "format": "datetime"
            },
            "delistedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "blockingTier": {
              "type": "string",
              "enum": [
                "limited",
                "sectoral",
                "full_block"
              ]
            }
          }
        }
      }
    }
  }
}