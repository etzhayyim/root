{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ofacSanctionsSdn.flagTransaction",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "SWIFT / banking transaction flagged against SDN list",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "sdnVid",
            "action",
            "flaggedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "sdnVid": {
              "type": "string",
              "description": "bridges listSdn"
            },
            "swiftUetr": {
              "type": "string",
              "description": "bridges open-swift"
            },
            "bankingAccountVid": {
              "type": "string",
              "description": "bridges open-banking"
            },
            "amountUsd": {
              "type": "number"
            },
            "action": {
              "type": "string",
              "enum": [
                "blocked",
                "rejected",
                "licensed",
                "pending"
              ]
            },
            "flaggedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}