{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.disasterResponse.declareEmergency",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Sendai Framework / IFRC / GDACS declaration (bridges agri-food-security + water-scarcity + cofog)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "declarationId",
            "hazardType",
            "jurisdictionIso3",
            "declaredAt"
          ],
          "properties": {
            "declarationId": {
              "type": "string"
            },
            "hazardType": {
              "type": "string",
              "enum": [
                "earthquake",
                "tsunami",
                "cyclone",
                "flood",
                "wildfire",
                "drought",
                "volcano",
                "landslide",
                "pandemic",
                "industrial",
                "nuclear",
                "conflict"
              ]
            },
            "jurisdictionIso3": {
              "type": "string"
            },
            "gdacsLevel": {
              "type": "string",
              "enum": [
                "green",
                "orange",
                "red"
              ]
            },
            "estimatedAffected": {
              "type": "integer"
            },
            "estimatedDead": {
              "type": "integer"
            },
            "estimatedEconLossUsd": {
              "type": "number"
            },
            "declaredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "moderate",
                "severe",
                "catastrophic"
              ]
            }
          }
        }
      }
    }
  }
}