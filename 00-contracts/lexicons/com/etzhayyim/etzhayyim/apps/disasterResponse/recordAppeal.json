{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.disasterResponse.recordAppeal",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "IFRC DREF / UN CERF appeal (bridges cofog + ofac-sanctions if conflict)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "appealId",
            "declarationVid",
            "mechanism",
            "fundingRequestedUsd",
            "launchedAt"
          ],
          "properties": {
            "appealId": {
              "type": "string"
            },
            "declarationVid": {
              "type": "string",
              "description": "bridges declareEmergency"
            },
            "mechanism": {
              "type": "string",
              "enum": [
                "IFRC_DREF",
                "IFRC_EMERGENCY",
                "UN_CERF",
                "UN_FLASH",
                "ECHO",
                "BILATERAL"
              ]
            },
            "fundingRequestedUsd": {
              "type": "number"
            },
            "fundingReceivedUsd": {
              "type": "number"
            },
            "launchedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "coverageTier": {
              "type": "string",
              "enum": [
                "underfunded",
                "partial",
                "well_funded"
              ]
            }
          }
        }
      }
    }
  }
}