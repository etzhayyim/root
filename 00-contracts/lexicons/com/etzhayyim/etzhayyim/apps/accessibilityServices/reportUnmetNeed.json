{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.accessibilityServices.reportUnmetNeed",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Unmet accessibility service need (bridges digital-accessibility + icpen-consumer + uhcr-health)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "reportId",
            "demographicSegment",
            "barrierKind",
            "reportedAt"
          ],
          "properties": {
            "reportId": {
              "type": "string"
            },
            "serviceVid": {
              "type": "string",
              "description": "bridges registerService"
            },
            "demographicSegment": {
              "type": "string",
              "enum": [
                "deaf",
                "dhh",
                "blind",
                "low_vision",
                "deafblind",
                "motor",
                "cognitive",
                "speech",
                "autistic",
                "multiple"
              ]
            },
            "affectedPopulation": {
              "type": "integer"
            },
            "barrierKind": {
              "type": "string",
              "enum": [
                "cost",
                "geography",
                "language",
                "training",
                "policy",
                "quality",
                "availability"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "local",
                "broad",
                "mass"
              ]
            }
          }
        }
      }
    }
  }
}