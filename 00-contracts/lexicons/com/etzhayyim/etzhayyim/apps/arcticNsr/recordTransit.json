{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.arcticNsr.recordTransit",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Northern Sea Route / Northwest Passage transit (carrier-schedule + biosecurity + panama-transit bridge)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "transitId",
            "route",
            "imo",
            "entryDate"
          ],
          "properties": {
            "transitId": {
              "type": "string"
            },
            "route": {
              "type": "string",
              "enum": [
                "NSR",
                "NWP",
                "TRANSPOLAR"
              ]
            },
            "imo": {
              "type": "string"
            },
            "carrierScheduleVid": {
              "type": "string",
              "description": "bridges open-carrier-schedule"
            },
            "biosecurityInspectionVid": {
              "type": "string",
              "description": "bridges open-biosecurity"
            },
            "iceClass": {
              "type": "string",
              "enum": [
                "PC1",
                "PC2",
                "PC3",
                "PC4",
                "PC5",
                "PC6",
                "PC7",
                "IA_SUPER",
                "IA",
                "IB",
                "IC"
              ]
            },
            "pilotAgencyLei": {
              "type": "string",
              "description": "Atomflot / Transport Canada"
            },
            "entryDate": {
              "type": "string"
            },
            "exitDate": {
              "type": "string"
            },
            "fuelTonnes": {
              "type": "number"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "feasibilityTier": {
              "type": "string",
              "enum": [
                "summer_only",
                "extended_season",
                "year_round"
              ]
            }
          }
        }
      }
    }
  }
}