{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.newsletter.sendCampaign",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Manually trigger send of a curated campaign (status must be 'curated').",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["campaignId"],
          "properties": {
            "campaignId": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status":       { "type": "string" },
            "recipientCount": { "type": "integer" },
            "sentAt":       { "type": "string", "format": "datetime" }
          }
        }
      }
    }
  }
}
