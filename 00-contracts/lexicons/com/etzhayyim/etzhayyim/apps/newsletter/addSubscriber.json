{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.newsletter.addSubscriber",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Add a subscriber to the newsletter list.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["email"],
          "properties": {
            "email":      { "type": "string", "maxLength": 256 },
            "name":       { "type": "string", "maxLength": 120 },
            "cohortName": { "type": "string", "maxLength": 120, "description": "Subscriber cohort for personalization." }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["subscriberId", "status"],
          "properties": {
            "subscriberId": { "type": "string" },
            "status":       { "type": "string", "enum": ["active", "duplicate"] },
            "createdAt":    { "type": "string", "format": "datetime" }
          }
        }
      }
    }
  }
}
