{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.newsletter.getCampaign",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a newsletter campaign by ID.",
      "parameters": {
        "type": "params",
        "required": ["campaignId"],
        "properties": {
          "campaignId": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["campaignId", "status"],
          "properties": {
            "campaignId":      { "type": "string" },
            "name":            { "type": "string" },
            "topic":           { "type": "string" },
            "cohortName":      { "type": "string" },
            "status":          { "type": "string" },
            "subjectLine":     { "type": "string" },
            "bodyHtml":        { "type": "string" },
            "qualityScore":    { "type": "number" },
            "recipientCount":  { "type": "integer" },
            "openCount":       { "type": "integer" },
            "clickCount":      { "type": "integer" },
            "adCampaignId":    { "type": "string" },
            "sentAt":          { "type": "string", "format": "datetime" },
            "createdAt":       { "type": "string", "format": "datetime" }
          }
        }
      }
    }
  }
}
