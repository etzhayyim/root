{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.permafrostThaw.recordMonitoringSite",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Permafrost monitoring site (CALM / TSP / GTN-P — bridges coastal-slr + methane-tracker + soil-carbon + arctic-nsr)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "siteId",
            "countryIso3",
            "measuredYear",
            "recordedAt"
          ],
          "properties": {
            "siteId": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "latitude": {
              "type": "number"
            },
            "longitude": {
              "type": "number"
            },
            "altDepthM": {
              "type": "number",
              "description": "active-layer depth"
            },
            "surfaceTempC": {
              "type": "number"
            },
            "groundTempAt10mC": {
              "type": "number"
            },
            "permafrostZone": {
              "type": "string",
              "enum": [
                "continuous",
                "discontinuous",
                "sporadic",
                "isolated"
              ]
            },
            "measuredYear": {
              "type": "integer"
            },
            "recordedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "degradationTier": {
              "type": "string",
              "enum": [
                "stable",
                "warming",
                "degrading"
              ]
            }
          }
        }
      }
    }
  }
}