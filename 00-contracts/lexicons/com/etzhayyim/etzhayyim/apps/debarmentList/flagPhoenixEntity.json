{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.debarmentList.flagPhoenixEntity",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Phoenix / successor-entity detection (bridges complianceMonitor.flagBreachOfTerms + ofac-sanctions-sdn + beneficial-ownership)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "debarmentVid",
            "phoenixKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "debarmentVid": {
              "type": "string",
              "description": "bridges recordDebarment"
            },
            "phoenixKind": {
              "type": "string",
              "enum": [
                "same_principals",
                "same_address",
                "successor_beneficial_owner",
                "asset_transfer",
                "staff_migration",
                "contract_assignment",
                "subcontractor_veil",
                "sister_entity"
              ]
            },
            "relatedEntityLei": {
              "type": "string"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}