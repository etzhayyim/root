{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.artisticFreedom.recordAttack",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "UN SR in the field of cultural rights / Artists at Risk / Freemuse attack (bridges press-freedom + cultural-heritage + religious-freedom + misinformation-observatory)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "attackId",
            "artForm",
            "jurisdictionIso3",
            "attackKind",
            "reportedAt"
          ],
          "properties": {
            "attackId": {
              "type": "string"
            },
            "artistOrcid": {
              "type": "string"
            },
            "artForm": {
              "type": "string",
              "enum": [
                "music",
                "visual",
                "literature",
                "theatre",
                "film",
                "dance",
                "street_art",
                "digital"
              ]
            },
            "jurisdictionIso3": {
              "type": "string"
            },
            "attackKind": {
              "type": "string",
              "enum": [
                "killed",
                "imprisoned",
                "detained",
                "exiled",
                "censored",
                "harassed",
                "work_destroyed",
                "travel_ban"
              ]
            },
            "perpetratorCategory": {
              "type": "string",
              "enum": [
                "state",
                "non_state",
                "political_movement",
                "religious_actor",
                "organized_crime",
                "platform"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "serious",
                "severe",
                "critical"
              ]
            }
          }
        }
      }
    }
  }
}