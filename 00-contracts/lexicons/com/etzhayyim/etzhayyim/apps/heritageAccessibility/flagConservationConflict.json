{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.heritageAccessibility.flagConservationConflict",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Conservation authority conflict / structural risk / exemption (bridges universalDesign.flagImplementationShortfall + cultural-heritage + fpic-consent)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "retrofitVid",
            "conflictKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "retrofitVid": {
              "type": "string",
              "description": "bridges recordRetrofit"
            },
            "conflictKind": {
              "type": "string",
              "enum": [
                "conservation_board_refused",
                "structural_load_risk",
                "architectural_intrusion",
                "religious_objection",
                "community_objection",
                "budget_shortfall",
                "planning_permission",
                "heritage_listing_downgrade",
                "tourist_degrade"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}