{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.carrierFleet.registerCarrier",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Carrier 登録 (Alphaliner Top 100)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "carrierCode",
            "carrierName",
            "registeredAt"
          ],
          "properties": {
            "carrierCode": {
              "type": "string",
              "description": "SCAC / BIC e.g. MAEU, MSCU, CMDU"
            },
            "carrierName": {
              "type": "string"
            },
            "scac": {
              "type": "string"
            },
            "lei": {
              "type": "string"
            },
            "alliance": {
              "type": "string",
              "enum": [
                "gemini",
                "ocean",
                "the-alliance",
                "unaligned"
              ]
            },
            "hqCountry": {
              "type": "string"
            },
            "vesselCount": {
              "type": "integer"
            },
            "teuCapacity": {
              "type": "number"
            },
            "registeredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "rankTier": {
              "type": "string",
              "enum": [
                "mega",
                "large",
                "mid",
                "small"
              ]
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
