{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.fxSwapLines.flagLineStress",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Swap line drawdown / stigma / rollover concern (bridges sovereignDebt.flagCreditorCoordination + digitalEuroBrics.flagSovereigntyConcern)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "stressId",
            "lineVid",
            "stressKind",
            "reportedAt"
          ],
          "properties": {
            "stressId": {
              "type": "string"
            },
            "lineVid": {
              "type": "string",
              "description": "bridges recordSwapLine"
            },
            "restructureVid": {
              "type": "string",
              "description": "bridges sovereignDebt.recordDebtRestructure"
            },
            "stressKind": {
              "type": "string",
              "enum": [
                "heavy_drawdown",
                "stigma",
                "rollover_risk",
                "counterparty_credit",
                "basis_widening",
                "collateral_quality",
                "unwind_order"
              ]
            },
            "intensityTier": {
              "type": "string",
              "enum": [
                "watch",
                "elevated",
                "acute"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}