{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.blockchainMev.recordMevEvent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Blockchain MEV / front-running event (bridges cyber-incident + antitrust-dma + ofac-sanctions)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "eventId",
            "chain",
            "txHash",
            "mevKind",
            "occurredAt"
          ],
          "properties": {
            "eventId": {
              "type": "string"
            },
            "chain": {
              "type": "string",
              "enum": [
                "ethereum",
                "arbitrum",
                "optimism",
                "base",
                "polygon",
                "solana",
                "bnb",
                "avalanche",
                "cosmos"
              ]
            },
            "blockNumber": {
              "type": "integer"
            },
            "txHash": {
              "type": "string"
            },
            "mevKind": {
              "type": "string",
              "enum": [
                "sandwich",
                "front_running",
                "back_running",
                "arbitrage",
                "liquidation",
                "just_in_time",
                "time_bandit"
              ]
            },
            "extractedUsd": {
              "type": "number"
            },
            "builderId": {
              "type": "string"
            },
            "relayLei": {
              "type": "string"
            },
            "victimAddress": {
              "type": "string"
            },
            "occurredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "harmTier": {
              "type": "string",
              "enum": [
                "benign",
                "mixed",
                "toxic"
              ]
            }
          }
        }
      }
    }
  }
}