{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.esportsIntegrity.logCompetition",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Esports / online gambling competition registry (bridges election-integrity + antitrust-dma + misinformation-observatory)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "competitionId",
            "title",
            "sanctioningBody",
            "stateIso3",
            "startedAt"
          ],
          "properties": {
            "competitionId": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "sanctioningBody": {
              "type": "string",
              "enum": [
                "esic",
                "iso",
                "iesf",
                "nba2kl",
                "olympic",
                "riot_games",
                "blizzard",
                "faceit"
              ]
            },
            "prizePoolUsd": {
              "type": "number"
            },
            "stateIso3": {
              "type": "string"
            },
            "bettingMarketLei": {
              "type": "string"
            },
            "startedAt": {
              "type": "string",
              "format": "datetime"
            },
            "endedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}