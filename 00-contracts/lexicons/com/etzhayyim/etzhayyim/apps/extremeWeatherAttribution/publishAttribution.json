{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.extremeWeatherAttribution.publishAttribution",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "WWA / ClimaMeter / NCAR extreme weather attribution study (bridges coastal-slr + agri-food-security + disaster-response + climate-litigation)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "studyId",
            "eventName",
            "eventType",
            "regionM49",
            "eventStartedAt",
            "publishedAt"
          ],
          "properties": {
            "studyId": {
              "type": "string"
            },
            "eventName": {
              "type": "string"
            },
            "eventType": {
              "type": "string",
              "enum": [
                "heatwave",
                "drought",
                "flood",
                "wildfire",
                "cyclone",
                "cold_spell",
                "rain_burst",
                "marine_heatwave"
              ]
            },
            "regionM49": {
              "type": "string"
            },
            "eventStartedAt": {
              "type": "string",
              "format": "datetime"
            },
            "fractionAttributableRiskPct": {
              "type": "number",
              "description": "FAR 0-100"
            },
            "intensityIncreaseRatio": {
              "type": "number"
            },
            "confidenceBand": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "very_high"
              ]
            },
            "publishedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "signalTier": {
              "type": "string",
              "enum": [
                "weak",
                "moderate",
                "strong",
                "unequivocal"
              ]
            }
          }
        }
      }
    }
  }
}