{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.extremeWeatherAttribution.flagClimateLitigationUse",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Attribution used in climate litigation / liability / adaptation-finance claim",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "useId",
            "studyVid",
            "usageCategory",
            "citedAt"
          ],
          "properties": {
            "useId": {
              "type": "string"
            },
            "studyVid": {
              "type": "string",
              "description": "bridges publishAttribution"
            },
            "litigationVid": {
              "type": "string",
              "description": "bridges open-climate-litigation"
            },
            "disasterVid": {
              "type": "string",
              "description": "bridges open-disaster-response"
            },
            "usageCategory": {
              "type": "string",
              "enum": [
                "legal_evidence",
                "adaptation_claim",
                "insurance_trigger",
                "policy_brief",
                "journalism"
              ]
            },
            "citedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}