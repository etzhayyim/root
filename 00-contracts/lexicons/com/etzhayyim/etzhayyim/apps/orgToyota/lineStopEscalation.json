{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.orgToyota.lineStopEscalation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Start the Toyota-facing line stop escalation BPMN workflow.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["vertexId", "organizationId", "plantId", "lineId", "stopStartedAt", "estimatedMinutes"],
          "properties": {
            "vertexId": { "type": "string" },
            "containmentVertexId": { "type": "string" },
            "organizationId": { "type": "string" },
            "plantId": { "type": "string" },
            "lineId": { "type": "string" },
            "modelCode": { "type": "string" },
            "stopStartedAt": { "type": "string" },
            "estimatedMinutes": { "type": "integer" },
            "safetyConcern": { "type": "boolean" },
            "supplierIssue": { "type": "boolean" },
            "qualityGate": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
