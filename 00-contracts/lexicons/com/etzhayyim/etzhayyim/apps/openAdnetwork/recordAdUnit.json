{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openAdnetwork.recordAdUnit",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Publisher の広告枠（Ad Unit）を登録する。Starts BPMN process open_adnetwork_record_ad_unit.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["unitId", "publisherDid", "unitType", "placement"],
          "properties": {
            "unitId":        { "type": "string", "description": "Ad unit unique identifier" },
            "publisherDid":  { "type": "string", "description": "DID of the publisher" },
            "unitType": {
              "type": "string",
              "knownValues": ["display", "native", "video", "interstitial"],
              "description": "Ad unit type"
            },
            "size":          { "type": "string", "description": "Ad unit size (e.g. 300x250)" },
            "placement":     { "type": "string", "description": "Placement identifier (e.g. header, sidebar)" },
            "floorCpmUsd":   { "type": "number", "description": "Floor CPM in USD (default 0.5)" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["vertexId"],
          "properties": {
            "vertexId": { "type": "string" },
            "status":   { "type": "string" }
          }
        }
      }
    }
  }
}
