{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.onion.seedCrawl",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Seed one or more .onion URLs for crawling.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["urls"],
          "properties": {
            "urls":     { "type": "array", "items": { "type": "string" }, "maxLength": 50 },
            "category": { "type": "string", "description": "hint category for all seeds" },
            "priority": { "type": "integer", "minimum": 0, "maximum": 10, "default": 5 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["seeded"],
          "properties": {
            "seeded": { "type": "integer" },
            "hosts":  { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
