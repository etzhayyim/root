{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.onion.page",
  "defs": {
    "main": {
      "type": "record",
      "description": "A crawled dark web (.onion) page record. Written by site path-based DID.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["onionUrl", "onionHost", "crawledAt"],
        "properties": {
          "onionUrl":          { "type": "string" },
          "onionHost":         { "type": "string" },
          "title":             { "type": "string" },
          "contentHash":       { "type": "string", "description": "SHA-256 hex of HTML body" },
          "contentBlobCid":    { "type": "string" },
          "screenshotBlobCid": { "type": "string" },
          "statusCode":        { "type": "integer" },
          "language":          { "type": "string" },
          "textSnippet":       { "type": "string", "maxLength": 2000 },
          "outboundLinks":     { "type": "string", "description": "JSON array of discovered .onion URLs" },
          "threatIndicators":  { "type": "string", "description": "JSON array of detected threat keywords" },
          "riskScore":         { "type": "integer", "minimum": 0, "maximum": 100 },
          "category":          { "type": "string", "description": "marketplace/forum/drugs/weapons/fraud/phishing/carding/leaks/other" },
          "crawledAt":         { "type": "string", "format": "datetime" },
          "siteNodeId":        { "type": "string", "description": "onion.site nodeId for graph edge" }
        }
      }
    }
  }
}
