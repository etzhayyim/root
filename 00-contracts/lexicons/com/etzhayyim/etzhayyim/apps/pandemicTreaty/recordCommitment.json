{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.pandemicTreaty.recordCommitment",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "WHO Pandemic Agreement / IHR 2024 commitment (bridges pandemic-preparedness + vaccine-equity + pharma-supply + tax-transparency)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "commitmentId",
            "partyIso3",
            "pillar",
            "recordedAt"
          ],
          "properties": {
            "commitmentId": {
              "type": "string"
            },
            "partyIso3": {
              "type": "string"
            },
            "pillar": {
              "type": "string",
              "enum": [
                "prevention",
                "preparedness",
                "response",
                "one_health",
                "pabs",
                "surge_capacity",
                "tech_transfer",
                "financing"
              ]
            },
            "targetValue": {
              "type": "number"
            },
            "targetUnit": {
              "type": "string"
            },
            "targetYear": {
              "type": "integer"
            },
            "currentProgressPct": {
              "type": "number"
            },
            "recordedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}