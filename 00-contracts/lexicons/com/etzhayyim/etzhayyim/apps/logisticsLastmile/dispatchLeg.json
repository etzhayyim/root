{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.logisticsLastmile.dispatchLeg",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Last-mile dispatch (carrier-schedule+customs-clearance bridge)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "legId",
            "carrierScheduleVid",
            "mode",
            "destAddress",
            "plannedArrival"
          ],
          "properties": {
            "legId": {
              "type": "string"
            },
            "carrierScheduleVid": {
              "type": "string",
              "description": "bridges open-carrier-schedule"
            },
            "customsClearanceVid": {
              "type": "string",
              "description": "bridges open-customs-clearance"
            },
            "mode": {
              "type": "string",
              "enum": [
                "truck",
                "rail",
                "parcel",
                "air"
              ]
            },
            "originPortVid": {
              "type": "string"
            },
            "destAddress": {
              "type": "string"
            },
            "plannedArrival": {
              "type": "string"
            },
            "slaMinutes": {
              "type": "integer"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}