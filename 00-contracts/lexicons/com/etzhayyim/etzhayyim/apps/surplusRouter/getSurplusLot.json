{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.surplusRouter.getSurplusLot",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a single surplus lot by DID. Per ADR-2605211241.",
      "parameters": {
        "type": "params",
        "required": ["did"],
        "properties": {
          "did": { "type": "string", "format": "did" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "did": { "type": "string", "format": "did" },
            "lotId": { "type": "string" },
            "category": { "type": "string" },
            "skuCode": { "type": "string" },
            "warehouseSkuRef": { "type": "string", "format": "at-uri" },
            "quantity": { "type": "integer" },
            "unitOfMeasure": { "type": "string" },
            "estimatedValueUsdcMicros": { "type": "integer" },
            "donorDid": { "type": "string", "format": "did" },
            "donorKind": { "type": "string" },
            "originCountry": { "type": "string" },
            "shelfLifeRemainingDays": { "type": "integer" },
            "hazardFlags": { "type": "array", "items": { "type": "string" } },
            "state": {
              "type": "string",
              "enum": [
                "registered",
                "matched",
                "redistributed",
                "flagged-dead-stock",
                "kozan-handoff",
                "recycled",
                "disposed-licensed"
              ]
            },
            "matchedReceiverDid": { "type": "string", "format": "did" },
            "redistributionUri": { "type": "string", "format": "at-uri" },
            "kozanStreamRef": { "type": "string", "format": "at-uri" },
            "registeredAt": { "type": "string", "format": "datetime" },
            "lastTransitionAt": { "type": "string", "format": "datetime" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
