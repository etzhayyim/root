{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airOps.fileFlightPlan",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "File a flight plan with air traffic control.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["flight_no", "dep_date", "origin", "dest"],
          "properties": {
            "flight_no": { "type": "string" },
            "dep_date": { "type": "string" },
            "origin": { "type": "string" },
            "dest": { "type": "string" },
            "aircraft_type": { "type": "string" },
            "fuel_on_board": { "type": "string" },
            "route_string": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
