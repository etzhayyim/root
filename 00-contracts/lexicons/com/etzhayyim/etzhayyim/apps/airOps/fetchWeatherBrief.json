{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airOps.fetchWeatherBrief",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Fetch a weather briefing for an airport.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["airport", "forecast_type"],
          "properties": {
            "airport": { "type": "string" },
            "forecast_type": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
