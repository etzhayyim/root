{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airOps.orderFuel",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Order fuel uplift for a flight.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["flight_no", "dep_date", "fuel_uplift_kg"],
          "properties": {
            "flight_no": { "type": "string" },
            "dep_date": { "type": "string" },
            "fuel_uplift_kg": { "type": "string" },
            "supplier": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
