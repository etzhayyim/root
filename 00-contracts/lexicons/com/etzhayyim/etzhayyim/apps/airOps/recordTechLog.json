{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airOps.recordTechLog",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a technical log entry for a flight.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["flight_no", "dep_date", "ata_chapter", "defect_description"],
          "properties": {
            "flight_no": { "type": "string" },
            "dep_date": { "type": "string" },
            "ata_chapter": { "type": "string" },
            "defect_description": { "type": "string" },
            "status": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
