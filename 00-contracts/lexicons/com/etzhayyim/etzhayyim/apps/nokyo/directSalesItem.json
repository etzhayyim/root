{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.nokyo.directSalesItem",
  "description": "JA 農産物直売所の出品。生産者 (組合員) 名義で直売所に陳列。価格は生産者が決定、手数料 15% が相場。",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["itemId", "memberId", "productName", "priceJpy"],
        "properties": {
          "itemId": { "type": "string" },
          "memberId": { "type": "string" },
          "coopPath": { "type": "string" },
          "marketPath": { "type": "string", "description": "直売所 DID path (例 tanno:niigata:echigo-chuo:market:main)" },
          "productName": { "type": "string" },
          "category": { "type": "string", "enum": ["vegetable", "fruit", "rice", "processed", "flower", "other"] },
          "priceJpy": { "type": "number" },
          "quantity": { "type": "integer" },
          "unit": { "type": "string", "description": "袋 / 個 / 束" },
          "harvestDate": { "type": "string", "format": "date" },
          "displayedAt": { "type": "string", "format": "datetime" },
          "status": { "type": "string", "enum": ["displayed", "soldOut", "withdrawn", "expired"] }
        }
      }
    }
  }
}
