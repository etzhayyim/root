{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.nokyo.loanApplication",
  "description": "JAバンク 農業融資申込 (農機 / 施設 / 運転資金 / 認定農業者スーパーL資金)。農林中金が最終与信、単協が一次審査。",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["applicationId", "memberId", "loanType", "principalJpy"],
        "properties": {
          "applicationId": { "type": "string" },
          "memberId": { "type": "string" },
          "coopPath": { "type": "string" },
          "loanType": { "type": "string", "enum": ["machinery", "facility", "working", "superL", "youngFarmer", "landReform"], "description": "農機 / 施設 / 運転 / スーパーL / 青年就農 / 農地" },
          "principalJpy": { "type": "number" },
          "termMonths": { "type": "integer" },
          "interestRateBps": { "type": "integer", "description": "金利 (bps)" },
          "purpose": { "type": "string" },
          "collateral": { "type": "string" },
          "status": { "type": "string", "enum": ["submitted", "screening", "approved", "rejected", "disbursed", "repaid", "defaulted"] },
          "submittedDate": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
