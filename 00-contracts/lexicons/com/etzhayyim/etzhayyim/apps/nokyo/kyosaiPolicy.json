{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.nokyo.kyosaiPolicy",
  "description": "JA 共済契約 (建物更生 / 自動車 / 生命 / 年金)。JA共済連 (zenkyoren) が元受、単協が窓口。個人情報は field-level encrypt (Signal E2E)。",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["policyId", "memberId", "productType"],
        "properties": {
          "policyId": { "type": "string" },
          "memberId": { "type": "string" },
          "coopPath": { "type": "string" },
          "productType": { "type": "string", "enum": ["buildingKosei", "auto", "life", "pension", "medical"], "description": "建物更生 / 自動車 / 生命 / 年金 / 医療" },
          "productName": { "type": "string" },
          "effectiveDate": { "type": "string", "format": "date" },
          "expirationDate": { "type": "string", "format": "date" },
          "premiumJpyMonthly": { "type": "number" },
          "sumInsuredJpy": { "type": "number" },
          "beneficiaryEnc": { "type": "string", "description": "受取人氏名 (signal:v1:{ciphertext})" },
          "status": { "type": "string", "enum": ["active", "lapsed", "cancelled", "claimed", "matured"] }
        }
      }
    }
  }
}
