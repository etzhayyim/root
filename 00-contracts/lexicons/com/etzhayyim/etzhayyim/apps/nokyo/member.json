{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.nokyo.member",
  "description": "JA 組合員 (正組合員 / 准組合員 / 法人組合員)。coopPath は tanno path (例 tanno:hokkaido:bibai) または zenchu/zennoh/zenkyoren/jabank。",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["memberId", "coopPath", "memberType"],
        "properties": {
          "memberId": { "type": "string", "description": "JA 組合員番号" },
          "coopPath": { "type": "string", "description": "所属 coop の path-based DID suffix (例 tanno:hokkaido:bibai)" },
          "memberType": { "type": "string", "enum": ["regular", "associate", "corporate"], "description": "正組合員 / 准組合員 / 法人組合員" },
          "fullName": { "type": "string" },
          "prefCode": { "type": "string", "description": "JIS X 0401 都道府県コード" },
          "joinedDate": { "type": "string", "format": "date" },
          "investmentShares": { "type": "integer", "description": "出資口数" }
        }
      }
    }
  }
}
