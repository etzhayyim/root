{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.nokyo.advisoryNote",
  "description": "営農指導員の助言レコード。cropPlan submit 時に LLM が一次ドラフト、指導員が check → 承認。",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["cropPlanId", "verdict", "advisoryText"],
        "properties": {
          "cropPlanId": { "type": "string" },
          "coopPath": { "type": "string" },
          "verdict": { "type": "string", "enum": ["approve", "revise", "reject"] },
          "advisoryText": { "type": "string" },
          "flaggedRisks": { "type": "string", "description": "JSON list: 輪作 / 農薬 / 気候 / 市況 risk tags" },
          "advisorDid": { "type": "string", "description": "指導員 DID (LLM draft の場合は agent DID)" },
          "reviewedBy": { "type": "string", "description": "最終承認指導員 DID" }
        }
      }
    }
  }
}
