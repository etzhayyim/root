{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ruralBroadband.registerDeployment",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Rural broadband deployment (FCC BEAD / DSIT UK / DG CNECT / MIC JP / DigitalIndia — bridges telecom-infra + energy-poverty + housing-affordability + sdg-reporting)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "deploymentId",
            "countryIso3",
            "program",
            "technology",
            "launchedAt"
          ],
          "properties": {
            "deploymentId": {
              "type": "string"
            },
            "providerLei": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "program": {
              "type": "string",
              "enum": [
                "fcc_bead",
                "dsit_uk",
                "eu_gigabit",
                "kdt_kor",
                "mic_jp",
                "pradhan_mantri_gramodaya",
                "bnb_sg"
              ]
            },
            "technology": {
              "type": "string",
              "enum": [
                "ftth",
                "fwa",
                "leo_satellite",
                "docsis_3_1",
                "copper_fttc",
                "mobile_5g_saam",
                "mesh"
              ]
            },
            "premisesPassed": {
              "type": "integer"
            },
            "investmentUsd": {
              "type": "number"
            },
            "targetSpeedMbpsDown": {
              "type": "integer"
            },
            "launchedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}