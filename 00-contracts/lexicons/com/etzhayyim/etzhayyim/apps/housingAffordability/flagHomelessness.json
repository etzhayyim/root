{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.housingAffordability.flagHomelessness",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Homelessness point-in-time count (bridges refugee-unhcr + universal-health-coverage + migrant-worker-welfare)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "countId",
            "countryIso3",
            "pitDate",
            "totalCount",
            "reportedAt"
          ],
          "properties": {
            "countId": {
              "type": "string"
            },
            "indexVid": {
              "type": "string",
              "description": "bridges recordIndex"
            },
            "countryIso3": {
              "type": "string"
            },
            "pitDate": {
              "type": "string"
            },
            "totalCount": {
              "type": "integer"
            },
            "unshelteredCount": {
              "type": "integer"
            },
            "chronicCount": {
              "type": "integer"
            },
            "familyCount": {
              "type": "integer"
            },
            "veteranCount": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}