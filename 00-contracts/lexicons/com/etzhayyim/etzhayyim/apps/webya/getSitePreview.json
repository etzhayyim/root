{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.webya.getSitePreview",
  "defs": {
    "main": {
      "type": "query",
      "description": "指定ページの rendered HTML を返す。status=draft でも返却する。CF Worker のプレビューエンドポイントが使用する。",
      "parameters": {
        "type": "params",
        "required": ["siteId"],
        "properties": {
          "siteId": { "type": "string" },
          "slug":   { "type": "string", "description": "ページ slug (省略時は home)" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok":          { "type": "boolean" },
            "slug":        { "type": "string" },
            "htmlContent": { "type": "string", "description": "rendered HTML (potentially large)" },
            "jsonLd":      { "type": "string", "description": "Schema.org JSON-LD (raw JSON string)" },
            "status":      { "type": "string" },
            "updatedAt":   { "type": "string" },
            "error":       { "type": "string" }
          }
        }
      }
    }
  }
}
