{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.webya.createSite",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "企業・士業のホームページ生成ジョブを投入する。LangGraph Server でサイト構成→コンテンツ→HTML レンダリング→ドメイン登録を非同期実行。site_id と job_id を即時返却し、状態は getSite で確認。",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["clientName", "professionKind", "representativeName", "address", "phone"],
          "properties": {
            "clientName":             { "type": "string", "description": "事務所名 / 会社名" },
            "professionKind":         { "type": "string", "enum": ["law_firm", "accounting_firm", "judicial_scrivener", "admin_scrivener", "general_company"] },
            "representativeName":     { "type": "string", "description": "代表者氏名" },
            "address":                { "type": "string", "description": "所在地 (都道府県+市区町村+番地)" },
            "phone":                  { "type": "string" },
            "email":                  { "type": "string" },
            "tagline":                { "type": "string", "description": "キャッチコピー (任意)" },
            "specialties":            { "type": "array", "items": { "type": "string" }, "description": "注力分野・サービス" },
            "tone":                   { "type": "string", "enum": ["formal", "friendly", "professional"], "default": "professional" },
            "registrationNumber":     { "type": "string", "description": "弁護士/税理士/司法書士登録番号 (士業必須)" },
            "associationName":        { "type": "string", "description": "所属会名 (士業必須)" },
            "corporateNumber":        { "type": "string", "description": "法人番号 13桁 (一般企業)" },
            "customDomain":           { "type": "string", "description": "希望独自ドメイン (例: yamada-law.jp)。未指定時は {slug}.webya.etzhayyim.com を自動付与" },
            "contactEmail":           { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "siteId", "jobId", "subdomain"],
          "properties": {
            "ok":        { "type": "boolean" },
            "siteId":    { "type": "string" },
            "jobId":     { "type": "string" },
            "subdomain": { "type": "string", "description": "自動付与サブドメイン (例: yamada-law-webya.etzhayyim.com)" },
            "status":    { "type": "string", "enum": ["generating", "failed"] },
            "error":     { "type": "string" }
          }
        }
      }
    }
  }
}
