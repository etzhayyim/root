{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openPorts.scheduleVesselCall",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Schedule a vessel call at a port (ETA/ETD + berth). Starts BPMN process open_ports_schedule_vessel_call.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["authorityOrgId", "portVid", "vesselVid", "eta", "etd"],
          "properties": {
            "authorityOrgId": { "type": "string" },
            "portVid":        { "type": "string" },
            "vesselVid":      { "type": "string" },
            "berthLabel":     { "type": "string" },
            "eta":            { "type": "string", "format": "datetime" },
            "etd":            { "type": "string", "format": "datetime" },
            "purpose":        { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" }, "error": { "type": "string" }
          }
        }
      }
    }
  }
}
