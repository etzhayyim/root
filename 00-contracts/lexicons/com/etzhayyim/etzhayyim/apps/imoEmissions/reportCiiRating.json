{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.imoEmissions.reportCiiRating",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "IMO CII / EEXI carbon intensity rating (bridges carrier-fleet + climate-value-chain + eu-cbam)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "ratingId",
            "imo",
            "cursorYear",
            "ciiRating",
            "reportedAt"
          ],
          "properties": {
            "ratingId": {
              "type": "string"
            },
            "imo": {
              "type": "string"
            },
            "carrierFleetVid": {
              "type": "string",
              "description": "bridges open-carrier-fleet"
            },
            "cursorYear": {
              "type": "integer"
            },
            "ciiRating": {
              "type": "string",
              "enum": [
                "A",
                "B",
                "C",
                "D",
                "E"
              ]
            },
            "ciiRequiredGramsCo2": {
              "type": "number"
            },
            "ciiAttainedGramsCo2": {
              "type": "number"
            },
            "eexiAttained": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "complianceTier": {
              "type": "string",
              "enum": [
                "compliant",
                "marginal",
                "non_compliant"
              ]
            }
          }
        }
      }
    }
  }
}