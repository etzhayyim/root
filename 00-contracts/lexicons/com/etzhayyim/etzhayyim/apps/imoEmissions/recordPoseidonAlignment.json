{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.imoEmissions.recordPoseidonAlignment",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Poseidon Principles alignment (banks financing shipping)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "alignmentId",
            "bankLei",
            "reportingYear",
            "reportedAt"
          ],
          "properties": {
            "alignmentId": {
              "type": "string"
            },
            "bankLei": {
              "type": "string"
            },
            "portfolioImoCount": {
              "type": "integer"
            },
            "portfolioAlignmentDeltaPct": {
              "type": "number",
              "description": "vs IMO trajectory"
            },
            "reportingYear": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}