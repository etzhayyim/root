{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.coalExit.flagJustTransition",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Just transition / stranded worker gap / community impact (bridges exportCreditAgency.flagClimateCarveout + just-transition + worker-grievance)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "retirementVid",
            "issueKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "retirementVid": {
              "type": "string",
              "description": "bridges recordRetirement"
            },
            "issueKind": {
              "type": "string",
              "enum": [
                "stranded_worker_no_retrain",
                "pension_shortfall",
                "community_revenue_loss",
                "supply_chain_shock",
                "social_license",
                "environmental_legacy",
                "superfund",
                "subsidence",
                "water_remediation",
                "public_finance_gap"
              ]
            },
            "affectedWorkers": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}