{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.publicMalak.listScraperRuns",
  "defs": {
    "main": {
      "type": "query",
      "description": "List recent scraper invocations (vertex_ads_scraper_run). Useful for observability and rate-limit diagnosis.",
      "parameters": {
        "type": "params",
        "properties": {
          "platform": { "type": "string", "knownValues": ["meta", "facebook", "instagram", "whatsapp", "google", "linkedin", "tiktok", "x", "line", "telegram"] },
          "status": { "type": "string", "knownValues": ["queued", "running", "completed", "failed", "rate_limited"] },
          "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 50 },
          "cursor": { "type": "string" }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["runs"],
          "properties": {
            "runs": {
              "type": "array",
              "items": { "type": "ref", "ref": "#scraperRunView" }
            },
            "cursor": { "type": "string" }
          }
        }
      }
    },
    "scraperRunView": {
      "type": "object",
      "required": ["vertexId", "platform", "startedAt"],
      "properties": {
        "vertexId": { "type": "string" },
        "platform": { "type": "string" },
        "queryKind": { "type": "string" },
        "queryValue": { "type": "string" },
        "country": { "type": "string" },
        "startedAt": { "type": "string" },
        "finishedAt": { "type": "string" },
        "status": { "type": "string" },
        "adsSeen": { "type": "integer" },
        "adsNew": { "type": "integer" },
        "adsUpdated": { "type": "integer" },
        "errorMessage": { "type": "string" },
        "userAgent": { "type": "string" },
        "proxyCountry": { "type": "string" },
        "playwrightTraceCid": { "type": "string" },
        "robotsTxtSnapshotCid": { "type": "string" },
        "rateLimitSleepMs": { "type": "integer" }
      }
    }
  }
}
