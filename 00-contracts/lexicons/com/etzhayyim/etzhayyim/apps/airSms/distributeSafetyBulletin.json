{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airSms.distributeSafetyBulletin",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Distribute a safety bulletin to designated recipient groups.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["bulletin_no", "subject", "recipients_group"],
          "properties": {
            "bulletin_no": { "type": "string" },
            "subject": { "type": "string" },
            "recipients_group": { "type": "string" },
            "content": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
