{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airSms.fileRegulatoryReport",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "File a mandatory occurrence report to a regulatory authority.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["report_vid", "authority", "submission_date"],
          "properties": {
            "report_vid": { "type": "string" },
            "authority": { "type": "string" },
            "submission_date": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
