{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.llm.answerWithKnowledge",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Answer a user question through the LangGraph/Pregel/LangChain knowledge workflow. The workflow retrieves evidence from RisingWave domain knowledge vertices and then calls the configured LLM tier.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["question"],
          "properties": {
            "question": { "type": "string" },
            "domain": { "type": "string", "description": "Optional domain filter, e.g. media_gamers" },
            "game_slug": { "type": "string", "description": "Optional game filter, e.g. pokemon-pokopia" },
            "lang": { "type": "string", "default": "ja" },
            "model": { "type": "string" },
            "tier": { "type": "string", "default": "fast" },
            "topK": { "type": "integer", "default": 8 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "answer": { "type": "string" },
            "confidence": { "type": "string" },
            "citations": {
              "type": "array",
              "items": { "type": "string" }
            },
            "usedKnowledge": {
              "type": "array",
              "items": { "type": "string" }
            },
            "model": { "type": "string" },
            "latencyMs": { "type": "integer" }
          }
        }
      }
    }
  }
}
