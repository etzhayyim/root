{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.hydrogenEconomy.registerProject",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Hydrogen production/offtake (IEA HyLaw / HyResource — bridges climate-carbon-market + critical-minerals + power-grid-interconnect)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "projectId",
            "countryIso3",
            "productionTier",
            "capacityMtPerYear",
            "endUses",
            "registeredAt"
          ],
          "properties": {
            "projectId": {
              "type": "string"
            },
            "operatorLei": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "productionTier": {
              "type": "string",
              "enum": [
                "green_elec",
                "blue_ccs",
                "grey_natgas",
                "turquoise_methane",
                "pink_nuclear",
                "white_geologic"
              ]
            },
            "capacityMtPerYear": {
              "type": "number"
            },
            "endUses": {
              "type": "string",
              "description": "comma: ammonia,steel,refining,heavy_transport,blending,power,export"
            },
            "commissioningYear": {
              "type": "integer"
            },
            "fidTaken": {
              "type": "boolean"
            },
            "registeredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "carbonTier": {
              "type": "string",
              "enum": [
                "low_carbon",
                "mid_carbon",
                "high_carbon"
              ]
            }
          }
        }
      }
    }
  }
}