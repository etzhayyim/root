{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.euDpp.recordPassport",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "EU Digital Product Passport (ESPR / battery / textile / construction — bridges recycledContentVerify.flagFraud + eudr-deforestation + eu-cbam)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "passportId",
            "productCategory",
            "dataModel",
            "effectiveAt"
          ],
          "properties": {
            "passportId": {
              "type": "string"
            },
            "productCategory": {
              "type": "string",
              "enum": [
                "battery_industrial",
                "battery_ev",
                "textile_apparel",
                "construction_product",
                "electronics_consumer",
                "toy",
                "iron_steel",
                "chemicals",
                "footwear",
                "tyres",
                "furniture",
                "ict_electronics"
              ]
            },
            "producerLei": {
              "type": "string"
            },
            "dataModel": {
              "type": "string",
              "enum": [
                "ce_rfid",
                "ce_qr",
                "ce_nfc",
                "ce_watermark",
                "ce_multi_carrier"
              ]
            },
            "recycledContentVid": {
              "type": "string",
              "description": "bridges recycledContentVerify.flagFraud"
            },
            "effectiveAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}