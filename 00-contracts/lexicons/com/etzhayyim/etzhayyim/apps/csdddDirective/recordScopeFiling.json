{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.csdddDirective.recordScopeFiling",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "EU CSDDD / UK Modern Slavery / German LkSG / French Vigilance scope filing (bridges ungpNap.flagImplementationGap + ilo-labor-rights + eudr-deforestation)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "filingId",
            "regime",
            "tierApplicable",
            "filedAt"
          ],
          "properties": {
            "filingId": {
              "type": "string"
            },
            "companyLei": {
              "type": "string"
            },
            "regime": {
              "type": "string",
              "enum": [
                "eu_csddd",
                "eu_csrd",
                "uk_modern_slavery",
                "de_lksg",
                "fr_vigilance",
                "no_transparency",
                "nl_child_labor",
                "au_modern_slavery",
                "ca_supply_chain"
              ]
            },
            "tierApplicable": {
              "type": "string",
              "enum": [
                "tier_1_gte5000",
                "tier_2_gte3000",
                "tier_3_gte1000",
                "high_impact_sector",
                "group_consolidation",
                "upstream_entity",
                "downstream_entity"
              ]
            },
            "implementationGapVid": {
              "type": "string",
              "description": "bridges ungpNap.flagImplementationGap"
            },
            "filedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}