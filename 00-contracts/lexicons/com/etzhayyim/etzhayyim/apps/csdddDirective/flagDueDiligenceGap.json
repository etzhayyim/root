{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.csdddDirective.flagDueDiligenceGap",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Due diligence process gap / failure to act (bridges ungpNap.flagImplementationGap + worker-grievance + ilo-labor-rights)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "gapId",
            "filingVid",
            "gapKind",
            "reportedAt"
          ],
          "properties": {
            "gapId": {
              "type": "string"
            },
            "filingVid": {
              "type": "string",
              "description": "bridges recordScopeFiling"
            },
            "gapKind": {
              "type": "string",
              "enum": [
                "identify_actual",
                "identify_potential",
                "prevent_mitigate",
                "cease_activity",
                "remediation",
                "stakeholder_engage",
                "reporting",
                "integrate_policy",
                "terminate_relationship"
              ]
            },
            "enforcementKind": {
              "type": "string",
              "enum": [
                "civil_fine",
                "public_naming",
                "exclude_public_procurement",
                "injunction",
                "directorial_liability",
                "class_action"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}