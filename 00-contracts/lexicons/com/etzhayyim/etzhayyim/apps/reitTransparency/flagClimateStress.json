{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.reitTransparency.flagClimateStress",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Physical / transition climate risk stress test (bridges coastal-slr + urban-heat + extreme-weather-attribution + cat-bond-ils)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "stressId",
            "disclosureVid",
            "scenario",
            "analyzedAt"
          ],
          "properties": {
            "stressId": {
              "type": "string"
            },
            "disclosureVid": {
              "type": "string",
              "description": "bridges recordPortfolioDisclosure"
            },
            "scenario": {
              "type": "string",
              "enum": [
                "ngfs_net_zero",
                "ngfs_delayed",
                "ngfs_current",
                "iea_sds",
                "iea_steps",
                "physical_rcp26",
                "physical_rcp45",
                "physical_rcp85"
              ]
            },
            "impactedAssetsPct": {
              "type": "number"
            },
            "valueAtRiskUsd": {
              "type": "number"
            },
            "analyzedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}