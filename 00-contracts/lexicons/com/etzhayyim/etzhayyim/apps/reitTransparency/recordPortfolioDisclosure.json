{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.reitTransparency.recordPortfolioDisclosure",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "REIT portfolio disclosure (EPRA / NAREIT / Japan J-REIT — bridges esg-risk-rating + climate-adaptation-finance + coastal-slr)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "disclosureId",
            "listingJurisdictionIso3",
            "reportingStandard",
            "assetsUnderMgmtUsd",
            "submittedAt"
          ],
          "properties": {
            "disclosureId": {
              "type": "string"
            },
            "reitLei": {
              "type": "string"
            },
            "listingJurisdictionIso3": {
              "type": "string"
            },
            "reportingStandard": {
              "type": "string",
              "enum": [
                "epra_sbpr",
                "nareit",
                "iffas",
                "jreit",
                "glio"
              ]
            },
            "assetsUnderMgmtUsd": {
              "type": "number"
            },
            "propertyTypeBreakdown": {
              "type": "string",
              "description": "comma: office,residential,retail,industrial,hotel,data_center,healthcare,logistics,life_science"
            },
            "energyIntensityKwhM2Y": {
              "type": "number"
            },
            "scope1To3Tco2e": {
              "type": "number"
            },
            "submittedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "scaleTier": {
              "type": "string",
              "enum": [
                "small",
                "mid",
                "large",
                "mega"
              ]
            }
          }
        }
      }
    }
  }
}