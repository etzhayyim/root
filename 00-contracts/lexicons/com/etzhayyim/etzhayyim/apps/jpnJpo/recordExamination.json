{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.jpnJpo.recordExamination",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "特許庁 審査記録",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "applicationNumber",
            "decision",
            "decisionDate"
          ],
          "properties": {
            "applicationNumber": {
              "type": "string"
            },
            "decision": {
              "type": "string",
              "enum": [
                "grant",
                "reject",
                "amend-required",
                "withdrawn"
              ]
            },
            "decisionDate": {
              "type": "string",
              "format": "date"
            },
            "examinerId": {
              "type": "string"
            },
            "rejectionGrounds": {
              "type": "string"
            },
            "citedArt": {
              "type": "string"
            },
            "nextAction": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
