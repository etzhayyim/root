{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.cargo.registerCargo",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a maritime cargo manifest (container/bulk/breakbulk/RoRo). Sources: WCO + national customs + AIS-linked manifests. Path-based DID: did:web:cargo.etzhayyim.com:cargo:{bookingRef}.",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["cargoType", "vesselDid", "loadingPortDid", "dischargePortDid"],
          "properties": {
            "cargoType": { "type": "string", "enum": ["container", "dry-bulk", "liquid-bulk", "breakbulk", "ro-ro", "project-cargo", "reefer", "dangerous-goods"] },
            "vesselDid": { "type": "string", "format": "did" },
            "loadingPortDid": { "type": "string", "format": "did" },
            "dischargePortDid": { "type": "string", "format": "did" },
            "shipperDid": { "type": "string", "format": "did", "description": "legal-entity DID" },
            "consigneeDid": { "type": "string", "format": "did" },
            "billOfLadingNo": { "type": "string" },
            "containerNumbers": { "type": "array", "items": { "type": "string" }, "description": "ISO 6346 container numbers" },
            "teu": { "type": "integer", "description": "twenty-foot equivalent units" },
            "weightTonnes": { "type": "number" },
            "hsCode": { "type": "string", "description": "Harmonized System code" },
            "imdgClass": { "type": "string", "description": "IMDG dangerous goods class if applicable" },
            "etd": { "type": "string", "format": "datetime" },
            "eta": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "uri": { "type": "string", "format": "at-uri" } } } }
    }
  }
}
