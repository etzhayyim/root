{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.cargo.listCargoes",
  "defs": {
    "main": {
      "type": "query",
      "description": "List maritime cargo manifests with optional vessel/port/type filter.",
      "x-bootstrap": true,
      "parameters": {
        "type": "params",
        "properties": {
          "cargoType": { "type": "string" },
          "vesselDid": { "type": "string", "format": "did" },
          "loadingPortDid": { "type": "string", "format": "did" },
          "dischargePortDid": { "type": "string", "format": "did" },
          "shipperDid": { "type": "string", "format": "did" },
          "imdgClass": { "type": "string" },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "required": ["cargoes", "total", "offset", "limit"], "properties": { "cargoes": { "type": "array", "items": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "cargoType": { "type": "string" }, "billOfLadingNo": { "type": "string" }, "teu": { "type": "integer" }, "weightTonnes": { "type": "number" }, "etd": { "type": "string", "format": "datetime" } } } }, "total": { "type": "integer" }, "offset": { "type": "integer" }, "limit": { "type": "integer" } } } }
    }
  }
}
