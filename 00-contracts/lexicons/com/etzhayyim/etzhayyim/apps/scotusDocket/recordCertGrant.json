{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.scotusDocket.recordCertGrant",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "SCOTUS / apex court cert grant (bridges tosArbitration.flagUnconscionability + federal-court-docket + civil-liability)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "certId",
            "court",
            "caseNumber",
            "questionPresented",
            "grantedAt"
          ],
          "properties": {
            "certId": {
              "type": "string"
            },
            "court": {
              "type": "string",
              "enum": [
                "scotus",
                "uk_supreme",
                "in_supreme",
                "au_high_court",
                "ca_supreme",
                "eu_cjeu",
                "echr_grand",
                "br_stf",
                "sa_constitutional",
                "icj",
                "itlos",
                "arbitral_uncitral"
              ]
            },
            "caseNumber": {
              "type": "string"
            },
            "questionPresented": {
              "type": "string",
              "enum": [
                "arbitration_preemption",
                "preemption",
                "first_amendment",
                "equal_protection",
                "administrative_deference",
                "nondelegation",
                "commerce_clause",
                "takings",
                "search_seizure",
                "qualified_immunity",
                "voting_rights",
                "class_action",
                "stare_decisis"
              ]
            },
            "unconscionabilityVid": {
              "type": "string",
              "description": "bridges tosArbitration.flagUnconscionability"
            },
            "grantedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}