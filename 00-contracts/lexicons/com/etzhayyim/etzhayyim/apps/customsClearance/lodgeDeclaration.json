{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.customsClearance.lodgeDeclaration",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "税関申告 (ports+hs+hormuz-cargo+sanctions bridge)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "declarationId",
            "hsCode",
            "declaredValueUsd",
            "lodgedAt"
          ],
          "properties": {
            "declarationId": {
              "type": "string"
            },
            "portVid": {
              "type": "string"
            },
            "manifestVid": {
              "type": "string"
            },
            "hsCode": {
              "type": "string"
            },
            "declaredValueUsd": {
              "type": "number"
            },
            "importerLei": {
              "type": "string"
            },
            "sanctionsScreeningVid": {
              "type": "string"
            },
            "lodgedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "riskTier": {
              "type": "string",
              "enum": [
                "green",
                "yellow",
                "red"
              ]
            },
            "requireInspection": {
              "type": "boolean"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
