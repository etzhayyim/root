{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.customsClearance.releaseShipment",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "税関 release",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "releaseId",
            "declarationVid",
            "releasedAt"
          ],
          "properties": {
            "releaseId": {
              "type": "string"
            },
            "declarationVid": {
              "type": "string"
            },
            "inspectionResult": {
              "type": "string"
            },
            "dutiesPaidUsd": {
              "type": "number"
            },
            "releaseTimeHours": {
              "type": "number"
            },
            "releasedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "efficiencyTier": {
              "type": "string",
              "enum": [
                "express",
                "normal",
                "slow",
                "stuck"
              ]
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
