{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.inquiryCommission.flagAccessDenial",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Access denial / cooperation refusal / report suppression (bridges srsgCoordination.flagPillarGap + humanitarian-corridor + transnational-repression)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "commissionVid",
            "issueKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "commissionVid": {
              "type": "string",
              "description": "bridges recordMandate"
            },
            "issueKind": {
              "type": "string",
              "enum": [
                "visa_denied",
                "territory_access_refused",
                "witness_intimidation",
                "document_unfit",
                "funding_stripped",
                "mandate_truncated",
                "report_suppressed",
                "staff_threatened",
                "remote_only",
                "state_obstruction",
                "follow_up_denied"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}