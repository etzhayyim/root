{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ustrSection301.imposeTariff",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "USTR §301 tariff imposition (bridges customs-clearance + commodity-trade + ai-supply-chain)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "actionId",
            "htsCode",
            "listName",
            "ratePct",
            "rationale",
            "effectiveFrom"
          ],
          "properties": {
            "actionId": {
              "type": "string"
            },
            "htsCode": {
              "type": "string",
              "description": "Harmonized Tariff Schedule US"
            },
            "listName": {
              "type": "string",
              "enum": [
                "list_1",
                "list_2",
                "list_3",
                "list_4a",
                "list_4b",
                "IRA",
                "CHIPS"
              ]
            },
            "ratePct": {
              "type": "number"
            },
            "rationale": {
              "type": "string",
              "enum": [
                "ip_theft",
                "forced_tech",
                "cyber",
                "subsidies",
                "overcapacity",
                "labor_violations"
              ]
            },
            "effectiveFrom": {
              "type": "string"
            },
            "expiresAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "impactTier": {
              "type": "string",
              "enum": [
                "nuisance",
                "moderate",
                "high",
                "prohibitive"
              ]
            }
          }
        }
      }
    }
  }
}