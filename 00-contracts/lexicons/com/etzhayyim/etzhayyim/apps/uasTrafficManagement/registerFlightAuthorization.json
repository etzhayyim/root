{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.uasTrafficManagement.registerFlightAuthorization",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "UAS/drone flight authorization (FAA LAANC / EASA U-space / JCAB — bridges aviation-safety + urban-mobility)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "authorizationId",
            "regime",
            "flightCategory",
            "authorizedAt"
          ],
          "properties": {
            "authorizationId": {
              "type": "string"
            },
            "operatorLei": {
              "type": "string"
            },
            "regime": {
              "type": "string",
              "enum": [
                "faa_laanc",
                "easa_uspace",
                "jcab",
                "caac",
                "isac",
                "dgca"
              ]
            },
            "uasRegistrationId": {
              "type": "string"
            },
            "flightCategory": {
              "type": "string",
              "enum": [
                "open",
                "specific",
                "certified",
                "part_107",
                "sora"
              ]
            },
            "maxAltitudeMeters": {
              "type": "integer"
            },
            "airspaceClass": {
              "type": "string",
              "enum": [
                "A",
                "B",
                "C",
                "D",
                "E",
                "G",
                "UTM_reserved"
              ]
            },
            "authorizedAt": {
              "type": "string",
              "format": "datetime"
            },
            "expiresAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "riskTier": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            }
          }
        }
      }
    }
  }
}