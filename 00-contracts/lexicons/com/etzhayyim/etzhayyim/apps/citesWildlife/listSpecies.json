{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.citesWildlife.listSpecies",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "CITES appendix listing (bridges biodiversity-gbf + fisheries-iuu + asfis)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "listingId",
            "scientificName",
            "appendix",
            "effectiveFrom"
          ],
          "properties": {
            "listingId": {
              "type": "string"
            },
            "scientificName": {
              "type": "string"
            },
            "asfisCode": {
              "type": "string"
            },
            "appendix": {
              "type": "string",
              "enum": [
                "I",
                "II",
                "III"
              ]
            },
            "sourceCountryIso3": {
              "type": "string"
            },
            "annotationKey": {
              "type": "string"
            },
            "effectiveFrom": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "endangermentTier": {
              "type": "string",
              "enum": [
                "cooperative",
                "regulated",
                "most_endangered"
              ]
            }
          }
        }
      }
    }
  }
}