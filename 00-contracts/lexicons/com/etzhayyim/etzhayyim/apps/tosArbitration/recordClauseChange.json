{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.tosArbitration.recordClauseChange",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "TOS arbitration clause / opt-out window change (bridges massArbitration.flagFeePushback + consumer-protection + antitrust-dma)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "changeId",
            "platform",
            "clauseKind",
            "effectiveAt"
          ],
          "properties": {
            "changeId": {
              "type": "string"
            },
            "operatorLei": {
              "type": "string"
            },
            "platform": {
              "type": "string",
              "enum": [
                "rideshare",
                "delivery",
                "streaming",
                "marketplace",
                "fintech",
                "social",
                "crypto_exchange",
                "telecom",
                "airline",
                "saas_enterprise",
                "gaming",
                "adtech"
              ]
            },
            "clauseKind": {
              "type": "string",
              "enum": [
                "mandatory_arb",
                "class_waiver",
                "carve_out",
                "opt_out_window",
                "severability",
                "informal_negotiation",
                "batch_arbitration_gate",
                "delegation_clause",
                "forum_selection",
                "attorneys_fee"
              ]
            },
            "feePushbackVid": {
              "type": "string",
              "description": "bridges massArbitration.flagFeePushback"
            },
            "effectiveAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}