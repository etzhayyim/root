{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.shadowFleetInsurance.recordCoverage",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "P&I Club / Russian reinsurance / shadow-fleet insurance (bridges priceCapCoalition.flagCapBreach + aisDarkVessel + insurance-policy)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "coverageId",
            "vesselImo",
            "insurerKind",
            "effectiveAt"
          ],
          "properties": {
            "coverageId": {
              "type": "string"
            },
            "vesselImo": {
              "type": "string"
            },
            "insurerLei": {
              "type": "string"
            },
            "insurerKind": {
              "type": "string",
              "enum": [
                "igpi_club",
                "ingosstrakh",
                "sogaz",
                "chubb_russia_local",
                "turkish_insurer",
                "indian_insurer",
                "uae_captive",
                "unknown",
                "self_insured",
                "no_cover"
              ]
            },
            "reinsuranceChain": {
              "type": "string"
            },
            "capBreachVid": {
              "type": "string",
              "description": "bridges priceCapCoalition.flagCapBreach"
            },
            "effectiveAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}