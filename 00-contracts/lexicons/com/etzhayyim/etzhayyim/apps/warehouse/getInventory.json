{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.warehouse.getInventory",
  "defs": {
    "main": {
      "type": "query",
      "description": "Read aggregated inventory by SKU.",
      "parameters": {
        "type": "params",
        "required": ["skuCode"],
        "properties": {
          "skuCode": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "skuCode": { "type": "string" },
            "onHandQty": { "type": "integer" },
            "bins": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "binCode": { "type": "string" },
                  "qty": { "type": "integer" }
                }
              }
            },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
