{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.warehouse.pick",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Pick stock for an outbound order line.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["orderId", "skuCode", "quantity"],
          "properties": {
            "orderId": { "type": "string" },
            "skuCode": { "type": "string" },
            "quantity": { "type": "integer" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "pickedFromBins": { "type": "array", "items": { "type": "string" } },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
