{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.warehouse.putaway",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Putaway inbound stock to a bin.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["skuCode", "quantity"],
          "properties": {
            "skuCode": { "type": "string" },
            "quantity": { "type": "integer" },
            "receivedAt": { "type": "string" },
            "binCode": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "assignedBinCode": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
