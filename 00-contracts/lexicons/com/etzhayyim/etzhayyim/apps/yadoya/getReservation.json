{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yadoya.getReservation",
  "defs": {
    "main": {
      "type": "query",
      "description": "Fetch a reservation. Returns Tier 1/2 fields only. Tier 3 (guestSummary plaintext, amountJpy raw) is never returned — use the dedicated revealReservation procedure with caller-side decrypt.",
      "parameters": {
        "type": "params",
        "required": ["reservationId"],
        "properties": {
          "reservationId": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "reservation": { "type": "object" }
          }
        }
      },
      "errors": [
        { "name": "NotFound", "description": "reservationId 不在" }
      ]
    }
  }
}
