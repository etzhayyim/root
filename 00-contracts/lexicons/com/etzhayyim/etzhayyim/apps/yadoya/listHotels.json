{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yadoya.listHotels",
  "defs": {
    "main": {
      "type": "query",
      "description": "List published hotel catalog. Returns Tier 2 domain rows from vertex_yadoya_hotel without occupancy join.",
      "parameters": {
        "type": "params",
        "properties": {
          "region":   { "type": "string" },
          "chainDid": { "type": "string", "format": "did" },
          "limit":    { "type": "integer", "minimum": 1, "maximum": 500, "default": 50 },
          "offset":   { "type": "integer", "minimum": 0, "default": 0 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["hotels", "total", "offset", "limit"],
          "properties": {
            "hotels": { "type": "array", "items": { "type": "object" } },
            "total":  { "type": "integer" },
            "offset": { "type": "integer" },
            "limit":  { "type": "integer" }
          }
        }
      }
    }
  }
}
