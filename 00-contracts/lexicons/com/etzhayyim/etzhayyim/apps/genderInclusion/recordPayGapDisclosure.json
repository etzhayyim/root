{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.genderInclusion.recordPayGapDisclosure",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Gender pay gap / EU Pay Transparency Directive / UK GPG disclosure (bridges apprenticeshipReg.flagCompletionGap + labor-rights + gender-pay-gap)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "disclosureId",
            "regime",
            "disclosedAt"
          ],
          "properties": {
            "disclosureId": {
              "type": "string"
            },
            "employerLei": {
              "type": "string"
            },
            "regime": {
              "type": "string",
              "enum": [
                "eu_pay_transparency",
                "uk_gpg",
                "us_eeoc",
                "ca_pay_equity",
                "au_wgea",
                "jp_act_women",
                "kr_gender_equality",
                "de_entgelttrans",
                "fr_index_egalite",
                "nl_gelijkheid"
              ]
            },
            "gapUnadjustedPct": {
              "type": "number"
            },
            "gapAdjustedPct": {
              "type": "number"
            },
            "completionGapVid": {
              "type": "string",
              "description": "bridges apprenticeshipReg.flagCompletionGap"
            },
            "disclosedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}