{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.credentialPortability.recordCrossBorderRecognition",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Cross-border recognition decision (bridges labour-mobility + refugee-unhcr + digital-identity)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "decisionId",
            "walletVid",
            "recognizingIso3",
            "decisionKind",
            "decidedAt"
          ],
          "properties": {
            "decisionId": {
              "type": "string"
            },
            "walletVid": {
              "type": "string",
              "description": "bridges registerCredentialWallet"
            },
            "recognizingIso3": {
              "type": "string"
            },
            "decisionKind": {
              "type": "string",
              "enum": [
                "full_recognition",
                "partial_recognition",
                "supplement_required",
                "refused",
                "professional_test_required"
              ]
            },
            "decisionMonths": {
              "type": "number"
            },
            "decidedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "portabilityTier": {
              "type": "string",
              "enum": [
                "blocked",
                "conditional",
                "seamless"
              ]
            }
          }
        }
      }
    }
  }
}