{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.bilingualEducation.flagOutcomeGap",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Outcome gap / achievement / cultural preservation (bridges languageEndangerment.flagRevitalization + gender-inclusion + accessibility-wcag)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "programVid",
            "gapKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "programVid": {
              "type": "string",
              "description": "bridges recordProgram"
            },
            "gapKind": {
              "type": "string",
              "enum": [
                "subtractive",
                "language_gap_english",
                "heritage_loss",
                "parental_opt_out",
                "teacher_shortage",
                "material_shortage",
                "assessment_bias",
                "standardized_test_skew",
                "code_switching_discouraged",
                "semilingualism",
                "cultural_disconnect"
              ]
            },
            "studentsImpacted": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}