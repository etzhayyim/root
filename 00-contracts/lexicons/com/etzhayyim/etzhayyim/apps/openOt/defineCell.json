{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openOt.defineCell",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Declare a WASM cell instance on a device. The cell is an IEC 61499 Basic Function Block; one cell tick == one Pregel super-step participation.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["cellCode", "name", "deviceDid", "fbKind", "iec61499Fbtype", "modulePinDid", "cyclePeriodMs", "deadlineMs"],
          "properties": {
            "cellCode":        { "type": "string" },
            "name":            { "type": "string" },
            "deviceDid":       { "type": "string", "description": "Host device DID" },
            "fbKind":          { "type": "string", "enum": ["bfb", "cfb", "sifb"] },
            "iec61499Fbtype":  { "type": "string", "description": "FBType identifier (e.g. PID_LIMITED)" },
            "modulePinDid":    { "type": "string", "description": "DID of the pinModule record holding the .aot CID" },
            "cyclePeriodMs":   { "type": "integer", "minimum": 1, "maximum": 60000, "description": "Cycle period in milliseconds" },
            "deadlineMs":      { "type": "integer", "minimum": 1, "maximum": 60000, "description": "Hard deadline in milliseconds" },
            "safetyClass":     { "type": "string", "enum": ["none", "safetyObserved", "sif"], "default": "none" },
            "eventsIn":        { "type": "array", "items": { "type": "ref", "ref": "#event" } },
            "eventsOut":       { "type": "array", "items": { "type": "ref", "ref": "#event" } },
            "dataIn":          { "type": "array", "items": { "type": "ref", "ref": "#dataBinding" } },
            "dataOut":         { "type": "array", "items": { "type": "ref", "ref": "#dataBinding" } },
            "paramsJson":      { "type": "string", "description": "Opaque JSON-encoded BFB parameters (immutable post-pin)" },
            "capabilityGrants":{ "type": "array", "items": { "type": "string" } },
            "cohort":          { "type": "array", "items": { "type": "string" }, "description": "Loop DIDs this cell participates in" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "cellDid":    { "type": "string" },
            "cellCode":   { "type": "string" },
            "definedAt":  { "type": "string", "format": "datetime" },
            "error":      { "type": "string" }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "description": "IEC 61499 event name (e.g. REQ, CNF, ALM)" },
        "with": { "type": "array", "items": { "type": "string" }, "description": "Associated data variable names" }
      }
    },
    "dataBinding": {
      "type": "object",
      "required": ["name", "signalDid"],
      "properties": {
        "name":      { "type": "string", "description": "Cell-local variable name" },
        "signalDid": { "type": "string", "description": "Bound signal DID" }
      }
    }
  }
}
