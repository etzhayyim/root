{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openOt.modeChange",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Change the operating mode of a loop. Subject to interlock DMN; safe-mode transitions are always permitted and may be auto-triggered by fault propagation.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["loopDid", "newMode", "requestedByDid", "reasonCode"],
          "properties": {
            "loopDid":        { "type": "string" },
            "newMode":        { "type": "string", "enum": ["auto", "manual", "cascade", "safe", "maintenance"] },
            "reasonCode":     { "type": "string", "enum": ["operatorManual", "agentEconomic", "agentSafety", "faultEscalation", "scheduledMaintenance", "commissioning"] },
            "requestedByDid": { "type": "string" },
            "justification":  { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "changeDid":    { "type": "string" },
            "previousMode": { "type": "string" },
            "newMode":      { "type": "string" },
            "appliedAt":    { "type": "string", "format": "datetime" },
            "error":        { "type": "string" }
          }
        }
      }
    }
  }
}
