{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openOt.getLoop",
  "defs": {
    "main": {
      "type": "query",
      "description": "Fetch loop detail including cells, edges, current mode, last super-step, and last checkpoint summary.",
      "parameters": {
        "type": "params",
        "required": ["loopDid"],
        "properties": {
          "loopDid": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "loopDid":              { "type": "string" },
            "loopCode":             { "type": "string" },
            "name":                 { "type": "string" },
            "loopKind":             { "type": "string" },
            "currentMode":          { "type": "string" },
            "superStepRateMillihz": { "type": "integer" },
            "lastSuperStep":        { "type": "integer" },
            "lastSuperStepAt":      { "type": "string", "format": "datetime" },
            "lastCheckpointTs":     { "type": "string", "format": "datetime" },
            "cellDids":             { "type": "array", "items": { "type": "string" } },
            "edges":                { "type": "array", "items": { "type": "ref", "ref": "#edgeRef" } },
            "barrierSource":        { "type": "string" },
            "openFaultCount":       { "type": "integer" },
            "definedAt":            { "type": "string", "format": "datetime" },
            "error":                { "type": "string" }
          }
        }
      }
    },
    "edgeRef": {
      "type": "object",
      "required": ["fromCellDid", "fromEvent", "toCellDid", "toEvent"],
      "properties": {
        "fromCellDid": { "type": "string" },
        "fromEvent":   { "type": "string" },
        "toCellDid":   { "type": "string" },
        "toEvent":     { "type": "string" }
      }
    }
  }
}
