{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openOt.defineSignal",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Declare a signal point (analog / digital / string). Engineering-unit ranges and deadbands are stored in micro-units (1e-6) so all values are integers (AT Lexicon prohibits float).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["signalCode", "name", "deviceDid", "signalKind", "direction"],
          "properties": {
            "signalCode":      { "type": "string" },
            "name":            { "type": "string" },
            "deviceDid":       { "type": "string" },
            "signalKind":      { "type": "string", "enum": ["analog", "digital", "string"] },
            "direction":       { "type": "string", "enum": ["input", "output", "bidirectional"] },
            "unitCode":        { "type": "string", "description": "UCUM unit code (e.g. kW, V, A, degC, m, %)" },
            "euRangeMinMicro": { "type": "integer", "description": "Engineering-unit minimum, in micro-units (1e-6)" },
            "euRangeMaxMicro": { "type": "integer", "description": "Engineering-unit maximum, in micro-units (1e-6)" },
            "deadbandMicro":   { "type": "integer", "description": "Deadband in micro-units (1e-6)" },
            "samplePeriodMs":  { "type": "integer", "minimum": 1, "maximum": 86400000 },
            "qualitySource":   { "type": "string", "enum": ["sensor", "computed", "manual", "estimated"] }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "signalDid":  { "type": "string" },
            "signalCode": { "type": "string" },
            "definedAt":  { "type": "string", "format": "datetime" },
            "error":      { "type": "string" }
          }
        }
      }
    }
  }
}
