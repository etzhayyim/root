{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openOt.getDevice",
  "defs": {
    "main": {
      "type": "query",
      "description": "Fetch device detail including attached cells and signals.",
      "parameters": {
        "type": "params",
        "required": ["deviceDid"],
        "properties": {
          "deviceDid": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "deviceDid":       { "type": "string" },
            "deviceCode":      { "type": "string" },
            "name":            { "type": "string" },
            "deviceClass":     { "type": "string" },
            "manufacturer":    { "type": "string" },
            "model":           { "type": "string" },
            "serialNumber":    { "type": "string" },
            "firmwareVersion": { "type": "string" },
            "locationCode":    { "type": "string" },
            "operatorDid":     { "type": "string" },
            "definedAt":       { "type": "string", "format": "datetime" },
            "cells":           { "type": "array", "items": { "type": "ref", "ref": "#cellRef" } },
            "signals":         { "type": "array", "items": { "type": "ref", "ref": "#signalRef" } },
            "error":           { "type": "string" }
          }
        }
      }
    },
    "cellRef": {
      "type": "object",
      "required": ["cellDid", "cellCode"],
      "properties": {
        "cellDid":        { "type": "string" },
        "cellCode":       { "type": "string" },
        "iec61499Fbtype": { "type": "string" },
        "cyclePeriodMs":  { "type": "integer" }
      }
    },
    "signalRef": {
      "type": "object",
      "required": ["signalDid", "signalCode"],
      "properties": {
        "signalDid":  { "type": "string" },
        "signalCode": { "type": "string" },
        "signalKind": { "type": "string" },
        "direction":  { "type": "string" },
        "unitCode":   { "type": "string" }
      }
    }
  }
}
