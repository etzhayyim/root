{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.bepsPillar.recordImplementation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "OECD BEPS Pillar 1 / Pillar 2 implementation (bridges advanceTaxRuling + global-tax + tax-transparency)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "implementationId",
            "countryIso3",
            "pillarKind",
            "statusKind",
            "publishedAt"
          ],
          "properties": {
            "implementationId": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "pillarKind": {
              "type": "string",
              "enum": [
                "pillar_1_amt_a",
                "pillar_1_amt_b",
                "pillar_2_gloBE",
                "pillar_2_qdmtt",
                "pillar_2_iir",
                "pillar_2_utpr",
                "pillar_2_pillar_2_safe",
                "stt_substantial_test",
                "gloBE_15pct"
              ]
            },
            "statusKind": {
              "type": "string",
              "enum": [
                "adopted",
                "draft_law",
                "cabinet_approved",
                "under_consultation",
                "legislation_pending",
                "applies_2024",
                "applies_2025",
                "applies_2026",
                "carve_out_invoked",
                "substance_test",
                "minimum_revenue_750_million"
              ]
            },
            "publishedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}