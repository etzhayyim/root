{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openDenki.defineGenerationNode",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Declare a generation node (solar / wind / hydro / thermal / nuclear / storage). Returns a path-based DID.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["genCode", "name", "genType", "capacityKw", "operatorDid"],
          "properties": {
            "genCode":      { "type": "string", "description": "Unique uppercase alphanumeric code (A-Z0-9-, 2..32)" },
            "name":         { "type": "string" },
            "genType":      { "type": "string", "enum": ["solar","wind","hydro","thermal","nuclear","storage","other"] },
            "substationDid":{ "type": "string", "description": "DID of connected substation (optional)" },
            "capacityKw":   { "type": "number", "description": "Nameplate capacity in kW" },
            "operatorDid":  { "type": "string", "description": "DID of operating entity" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "genDid":       { "type": "string" },
            "genCode":      { "type": "string" },
            "name":         { "type": "string" },
            "genType":      { "type": "string" },
            "substationDid":{ "type": "string" },
            "capacityKw":   { "type": "number" },
            "operatorDid":  { "type": "string" },
            "definedAt":    { "type": "string", "format": "datetime" },
            "error":        { "type": "string" }
          }
        }
      }
    }
  }
}
