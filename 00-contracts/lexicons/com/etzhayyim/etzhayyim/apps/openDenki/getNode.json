{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openDenki.getNode",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get detail for a substation (by subDid) or generation node (by genDid). For substations returns downstream feeders and connected gen nodes.",
      "parameters": {
        "type": "params",
        "properties": {
          "subDid": { "type": "string", "description": "Substation DID (exclusive-or with genDid)" },
          "genDid": { "type": "string", "description": "Generation node DID (exclusive-or with subDid)" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "nodeType":    { "type": "string", "enum": ["substation","genNode"] },
            "subDid":      { "type": "string" },
            "genDid":      { "type": "string" },
            "subCode":     { "type": "string" },
            "genCode":     { "type": "string" },
            "name":        { "type": "string" },
            "voltageKv":   { "type": "number" },
            "genType":     { "type": "string" },
            "capacityKw":  { "type": "number" },
            "operatorDid": { "type": "string" },
            "definedAt":   { "type": "string", "format": "datetime" },
            "feeders":     { "type": "array", "items": { "type": "object" } },
            "genNodes":    { "type": "array", "items": { "type": "object" } },
            "error":       { "type": "string" }
          }
        }
      }
    }
  }
}
