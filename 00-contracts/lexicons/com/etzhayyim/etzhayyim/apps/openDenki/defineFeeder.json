{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openDenki.defineFeeder",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Declare a distribution feeder connecting a substation to delivery points.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["substationDid", "feederCode", "lengthKm", "voltageKv", "ratingKva"],
          "properties": {
            "substationDid": { "type": "string" },
            "feederCode":    { "type": "string", "description": "Unique code (A-Z0-9-, 2..16)" },
            "lengthKm":      { "type": "number" },
            "voltageKv":     { "type": "number" },
            "ratingKva":     { "type": "number", "description": "Thermal rating in kVA" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "feederDid":     { "type": "string" },
            "feederCode":    { "type": "string" },
            "substationDid": { "type": "string" },
            "lengthKm":      { "type": "number" },
            "voltageKv":     { "type": "number" },
            "ratingKva":     { "type": "number" },
            "status":        { "type": "string" },
            "definedAt":     { "type": "string", "format": "datetime" },
            "error":         { "type": "string" }
          }
        }
      }
    }
  }
}
