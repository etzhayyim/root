{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.spywareExport.recordExportLicense",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Commercial spyware / dual-use / Wassenaar export license (bridges pressFreedomIndex.flagDeclineFactor + ofac-sanctions-sdn + cyber-vuln-cve)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "licenseId",
            "productKind",
            "exportCountryIso3",
            "importCountryIso3",
            "issuedAt"
          ],
          "properties": {
            "licenseId": {
              "type": "string"
            },
            "vendorLei": {
              "type": "string"
            },
            "productKind": {
              "type": "string",
              "enum": [
                "nso_pegasus",
                "intellexa_predator",
                "cytrox",
                "candiru",
                "quadream",
                "hacking_team_legacy",
                "finfisher",
                "darkmatter",
                "paragon",
                "ring_zero",
                "macos_zero_click",
                "android_zero_click"
              ]
            },
            "exportCountryIso3": {
              "type": "string"
            },
            "importCountryIso3": {
              "type": "string"
            },
            "endUseCert": {
              "type": "string",
              "enum": [
                "le_lawful_intercept",
                "national_security",
                "counter_terror",
                "counter_narcotics",
                "dual_use_civilian",
                "research",
                "ban_exceptions",
                "none"
              ]
            },
            "pressDeclineVid": {
              "type": "string",
              "description": "bridges pressFreedomIndex.flagDeclineFactor"
            },
            "issuedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}