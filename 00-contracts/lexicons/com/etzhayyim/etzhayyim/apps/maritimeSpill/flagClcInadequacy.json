{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maritimeSpill.flagClcInadequacy",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "CLC / IOPC fund inadequacy / bunker convention gap (bridges shadowFleetInsurance.flagGapOrFraud + insurance-claim + coastal-slr)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "spillVid",
            "gapKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "spillVid": {
              "type": "string",
              "description": "bridges recordSpill"
            },
            "gapKind": {
              "type": "string",
              "enum": [
                "shipowner_limit_breach",
                "iopc_supplementary",
                "bunker_convention_gap",
                "hns_convention_unratified",
                "flag_state_uncooperative",
                "insurer_insolvent",
                "fraudulent_certificate",
                "jurisdiction_forum_shop",
                "sanction_freezes_payout"
              ]
            },
            "unrecoveredBusd": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}