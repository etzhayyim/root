{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.maritimeSpill.recordSpill",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Maritime oil spill / ITOPF / CLC / IOPC event (bridges shadowFleetInsurance.flagGapOrFraud + oil-gas + coastal-slr)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "spillId",
            "spillKind",
            "regionName",
            "occurredAt"
          ],
          "properties": {
            "spillId": {
              "type": "string"
            },
            "vesselImo": {
              "type": "string"
            },
            "spillKind": {
              "type": "string",
              "enum": [
                "crude_persistent",
                "hfo",
                "mgo_mdo",
                "bunker",
                "chemical_marpol_x",
                "palm_oil",
                "lng_flash",
                "plastic_pellet",
                "ore_tailings",
                "containerized_chemicals"
              ]
            },
            "regionName": {
              "type": "string"
            },
            "volumeTonnes": {
              "type": "number"
            },
            "insuranceGapVid": {
              "type": "string",
              "description": "bridges shadowFleetInsurance.flagGapOrFraud"
            },
            "occurredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}