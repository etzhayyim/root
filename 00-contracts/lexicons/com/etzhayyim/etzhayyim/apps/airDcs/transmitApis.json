{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airDcs.transmitApis",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Transmit Advance Passenger Information System (APIS) data to destination country.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["flight_no", "dep_date", "destination_country"],
          "properties": {
            "flight_no": { "type": "string" },
            "dep_date": { "type": "string" },
            "destination_country": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
