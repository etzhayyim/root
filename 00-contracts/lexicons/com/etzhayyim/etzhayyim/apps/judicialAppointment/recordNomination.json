{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.judicialAppointment.recordNomination",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Judicial appointment / nomination / vetting (bridges judgeRapporteur.flagBiasConcern + ethics-disclosure + scotus-docket)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "nominationId",
            "courtLevel",
            "processKind",
            "nominatedAt"
          ],
          "properties": {
            "nominationId": {
              "type": "string"
            },
            "courtLevel": {
              "type": "string",
              "enum": [
                "scotus",
                "federal_circuit",
                "federal_district",
                "us_state",
                "cjeu",
                "echr",
                "supreme_uk",
                "constitutional_de",
                "constitutional_fr",
                "apex_in",
                "apex_jp",
                "apex_br",
                "apex_za",
                "arbitrator_pcca"
              ]
            },
            "processKind": {
              "type": "string",
              "enum": [
                "executive_appoint",
                "legislative_confirm",
                "judicial_council",
                "peer_election",
                "mixed_ja_chk",
                "constitutional_commission",
                "kj_korea_judicial",
                "gcb_brazil",
                "csm_italy",
                "cnnj_chile",
                "crpc"
              ]
            },
            "biasConcernVid": {
              "type": "string",
              "description": "bridges judgeRapporteur.flagBiasConcern"
            },
            "nominatedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}