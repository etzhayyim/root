{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.imfArticleIv.flagProgramRequest",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "IMF program request (SBA/EFF/RSF/RCF/PRGT — bridges emFxReserves.flagReserveAdequacy + sovereignDebt.recordDebtRestructure)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "programId",
            "consultationVid",
            "programType",
            "approvedAt"
          ],
          "properties": {
            "programId": {
              "type": "string"
            },
            "consultationVid": {
              "type": "string",
              "description": "bridges recordConsultation"
            },
            "programType": {
              "type": "string",
              "enum": [
                "sba",
                "eff",
                "rsf",
                "rfi",
                "rcf",
                "pll",
                "fcl",
                "psi",
                "prgt",
                "scf"
              ]
            },
            "notionalBusd": {
              "type": "number"
            },
            "conditionalityCount": {
              "type": "integer"
            },
            "approvedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}