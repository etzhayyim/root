{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.tripsWaiver.flagRetaliationRisk",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Trade retaliation / §301 / adequacy downgrade concern (bridges vaccineEquity.flagAccessGap + ustr-section-301 + wto-dispute)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "invocationVid",
            "retaliatorCountryIso3",
            "retaliationKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "invocationVid": {
              "type": "string",
              "description": "bridges recordWaiverInvocation"
            },
            "retaliatorCountryIso3": {
              "type": "string"
            },
            "retaliationKind": {
              "type": "string",
              "enum": [
                "priority_watch_list",
                "section_301_tariff",
                "wto_dispute",
                "bilateral_pressure",
                "adequacy_downgrade",
                "gsp_withdrawal",
                "aid_conditionality"
              ]
            },
            "estimatedLossMusd": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}