{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.sox404Icfr.recordAttestation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "SOX §404 ICFR management/auditor attestation (bridges restatementEvent.flagStockImpact + audit-firm-oversight + enforcement-action)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "attestationId",
            "attestationKind",
            "periodEnd"
          ],
          "properties": {
            "attestationId": {
              "type": "string"
            },
            "filerLei": {
              "type": "string"
            },
            "attestationKind": {
              "type": "string",
              "enum": [
                "management_assessment",
                "auditor_attestation",
                "non_accelerated_exempt",
                "smaller_reporting",
                "emerging_growth",
                "dual_reporting",
                "combined_ia_404"
              ]
            },
            "materialWeakness": {
              "type": "boolean"
            },
            "stockImpactVid": {
              "type": "string",
              "description": "bridges restatementEvent.flagStockImpact"
            },
            "periodEnd": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}