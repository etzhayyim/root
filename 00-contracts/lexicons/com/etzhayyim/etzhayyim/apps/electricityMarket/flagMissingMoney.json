{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.electricityMarket.flagMissingMoney",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Missing-money / capacity adequacy / negative price abuse (bridges fossilStrandedAsset.flagJustTransitionGap + power-grid-interconnect + sovereign-debt)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "mechanismVid",
            "issueKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "mechanismVid": {
              "type": "string",
              "description": "bridges recordMechanism"
            },
            "issueKind": {
              "type": "string",
              "enum": [
                "missing_money",
                "scarcity_pricing_inadequate",
                "price_cap_too_tight",
                "capacity_payment_distortion",
                "subsidy_overlap",
                "cross_border_distortion",
                "loop_flow",
                "wind_curtailment",
                "solar_curtailment",
                "battery_arbitrage_concern",
                "resource_adequacy_failure",
                "ela_event"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}