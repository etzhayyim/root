{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.grandChamberRuling.recordRuling",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "CJEU Grand Chamber / ECHR Grand Chamber ruling (bridges judicialReviewGdpr.flagRulingImpact + schrems-challenge + minority-rights)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "rulingId",
            "forum",
            "caseKind",
            "deliveredAt"
          ],
          "properties": {
            "rulingId": {
              "type": "string"
            },
            "forum": {
              "type": "string",
              "enum": [
                "cjeu_gc",
                "cjeu_full_court",
                "echr_gc",
                "echr_fc",
                "sfc_ic",
                "supreme_court_fr_assembly",
                "uk_supreme",
                "brazil_stf_plenario",
                "japan_grand_bench"
              ]
            },
            "caseKind": {
              "type": "string",
              "enum": [
                "preliminary_ref",
                "annulment",
                "treaty_infringement",
                "human_rights",
                "fundamental_rights",
                "rule_of_law",
                "state_aid",
                "competition",
                "freedom_movement",
                "asylum",
                "data_protection"
              ]
            },
            "rulingImpactVid": {
              "type": "string",
              "description": "bridges judicialReviewGdpr.flagRulingImpact"
            },
            "deliveredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}