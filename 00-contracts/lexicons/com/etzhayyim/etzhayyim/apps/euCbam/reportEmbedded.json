{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.euCbam.reportEmbedded",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "EU CBAM embedded emissions report (Q1 2026→ — bridges climate-carbon-market + customs-clearance + critical-minerals)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "reportId",
            "cnCode",
            "quantityTonnes",
            "directEmissionsTco2e",
            "reportingQuarter",
            "submittedAt"
          ],
          "properties": {
            "reportId": {
              "type": "string"
            },
            "cnCode": {
              "type": "string",
              "description": "EU Combined Nomenclature (HS-linked)"
            },
            "importerLei": {
              "type": "string"
            },
            "customsDeclarationVid": {
              "type": "string",
              "description": "bridges open-customs-clearance"
            },
            "criticalMineralVid": {
              "type": "string",
              "description": "bridges open-critical-minerals"
            },
            "quantityTonnes": {
              "type": "number"
            },
            "directEmissionsTco2e": {
              "type": "number"
            },
            "indirectEmissionsTco2e": {
              "type": "number"
            },
            "certificatePriceEur": {
              "type": "number"
            },
            "reportingQuarter": {
              "type": "string",
              "description": "YYYY-QN"
            },
            "submittedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "intensityTier": {
              "type": "string",
              "enum": [
                "low",
                "moderate",
                "high"
              ]
            }
          }
        }
      }
    }
  }
}