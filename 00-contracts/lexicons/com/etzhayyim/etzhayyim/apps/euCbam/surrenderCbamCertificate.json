{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.euCbam.surrenderCbamCertificate",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Surrender CBAM certificate against import declaration",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "surrenderId",
            "reportVid",
            "certificatesSurrendered",
            "eurPaid",
            "surrenderedAt"
          ],
          "properties": {
            "surrenderId": {
              "type": "string"
            },
            "reportVid": {
              "type": "string",
              "description": "bridges reportEmbedded"
            },
            "carbonCreditVid": {
              "type": "string",
              "description": "bridges open-climate-carbon-market"
            },
            "certificatesSurrendered": {
              "type": "integer"
            },
            "eurPaid": {
              "type": "number"
            },
            "surrenderedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}