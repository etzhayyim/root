{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.massArbitration.recordDemandBatch",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Mass arbitration demand batch (AAA / JAMS / FairClaims — bridges classSettlement.flagClaimRate + consumer-protection + enforcement-action)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "batchId",
            "forum",
            "industry",
            "claimantCount",
            "filedAt"
          ],
          "properties": {
            "batchId": {
              "type": "string"
            },
            "respondentLei": {
              "type": "string"
            },
            "forum": {
              "type": "string",
              "enum": [
                "aaa",
                "jams",
                "fair_claims",
                "ftc_smg",
                "int_arbitration",
                "cpr",
                "pam",
                "trust_arb",
                "adr_chambers"
              ]
            },
            "industry": {
              "type": "string",
              "enum": [
                "telecom",
                "rideshare",
                "gigecon",
                "streaming",
                "fintech",
                "ecommerce",
                "crypto",
                "insurance",
                "consumer_finance",
                "food_delivery",
                "daycare"
              ]
            },
            "claimantCount": {
              "type": "integer"
            },
            "claimRateVid": {
              "type": "string",
              "description": "bridges classSettlement.flagClaimRate"
            },
            "filingFeeMusd": {
              "type": "number"
            },
            "filedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}