{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airSched.changeFrequency",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Change the operating frequency of a scheduled flight.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["flight_no", "old_frequency", "new_frequency"],
          "properties": {
            "flight_no": { "type": "string" },
            "old_frequency": { "type": "string" },
            "new_frequency": { "type": "string" },
            "effective_date": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
