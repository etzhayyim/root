{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airSched.requestSlot",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Request an airport slot for a flight.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["airport", "slot_date", "slot_type"],
          "properties": {
            "airport": { "type": "string" },
            "slot_date": { "type": "string" },
            "slot_type": { "type": "string" },
            "flight_no": { "type": "string" },
            "carrier_code": { "type": "string" },
            "requested_time": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
