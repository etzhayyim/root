{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.climateAdaptationFinance.reportImpact",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Ex-post adaptation impact report",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "reportId",
            "projectVid",
            "reportedAt"
          ],
          "properties": {
            "reportId": {
              "type": "string"
            },
            "projectVid": {
              "type": "string",
              "description": "bridges approveProject"
            },
            "beneficiariesDirect": {
              "type": "integer"
            },
            "beneficiariesIndirect": {
              "type": "integer"
            },
            "hectaresRestored": {
              "type": "number"
            },
            "co2AvoidedTonnes": {
              "type": "number"
            },
            "disbursedPct": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}