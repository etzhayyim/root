{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ongakuka.getTrack",
  "defs": {
    "main": {
      "type": "query",
      "description": "Resolve a track + its stems + latest generation event.",
      "parameters": {
        "type": "params",
        "required": ["uri"],
        "properties": {
          "uri": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["track"],
          "properties": {
            "track": { "type": "unknown" },
            "stems": { "type": "array", "items": { "type": "unknown" } },
            "lastGeneration": { "type": "unknown" }
          }
        }
      }
    }
  }
}
