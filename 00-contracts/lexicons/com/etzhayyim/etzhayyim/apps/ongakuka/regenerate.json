{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ongakuka.regenerate",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Partial regeneration of an existing track. Targets a section [startSec,endSec] and/or specific stems. Produces a new com.etzhayyim.apps.ongakuka.generation record and updates blobKey.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["trackUri"],
          "properties": {
            "trackUri": { "type": "string" },
            "startSec": { "type": "number", "minimum": 0 },
            "endSec": { "type": "number" },
            "stems": {
              "type": "array",
              "items": { "type": "string", "enum": ["vocal", "drums", "bass", "guitar", "keys", "synth", "strings", "fx", "other", "instrumental"] }
            },
            "stylePatch": { "type": "string", "description": "Additional style hints to overlay (e.g. 'softer chorus, less reverb')" },
            "seed": { "type": "integer" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["generationUri", "trackUri"],
          "properties": {
            "generationUri": { "type": "string" },
            "trackUri": { "type": "string" }
          }
        }
      }
    }
  }
}
