{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.aiSupplyChain.traceCompute",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "AI compute infra trace (critical-minerals → semiconductor → ai-governance)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "traceId",
            "tracedAt"
          ],
          "properties": {
            "traceId": {
              "type": "string"
            },
            "modelVid": {
              "type": "string",
              "description": "bridges open-ai-governance registerModel"
            },
            "mineralClassificationVid": {
              "type": "string",
              "description": "bridges open-critical-minerals"
            },
            "gpuVendorLei": {
              "type": "string"
            },
            "gpuModel": {
              "type": "string"
            },
            "trainingPetaflopDays": {
              "type": "number"
            },
            "datacenterIso3": {
              "type": "string"
            },
            "tracedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "dependencyTier": {
              "type": "string",
              "enum": [
                "research",
                "production",
                "frontier"
              ]
            }
          }
        }
      }
    }
  }
}