{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.aiSupplyChain.flagSupplyRisk",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Flag AI supply-chain risk (critical-mineral concentration + cyber-incident at chip fab)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "traceVid",
            "flaggedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "traceVid": {
              "type": "string",
              "description": "bridges traceCompute"
            },
            "cyberIncidentVid": {
              "type": "string",
              "description": "bridges open-cyber-incident"
            },
            "concentrationVid": {
              "type": "string",
              "description": "bridges open-critical-minerals recordConcentration"
            },
            "affectedModelsCount": {
              "type": "integer"
            },
            "flaggedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}