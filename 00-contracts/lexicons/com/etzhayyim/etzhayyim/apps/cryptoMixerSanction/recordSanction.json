{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.cryptoMixerSanction.recordSanction",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Crypto mixer / privacy protocol OFAC sanction (bridges ransomwarePay.flagSanctionsHit + ofac-sanctions-sdn + mica-crypto)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "sanctionId",
            "mixerKind",
            "sanctionAuthority",
            "listedAt"
          ],
          "properties": {
            "sanctionId": {
              "type": "string"
            },
            "mixerKind": {
              "type": "string",
              "enum": [
                "tornado_cash_eth",
                "blender_io_btc",
                "chipmixer",
                "sinbad",
                "samurai_whirlpool",
                "wasabi_btc",
                "railgun",
                "aztec",
                "aleo",
                "monero_native",
                "zcash_native",
                "secret_network",
                "fixed_float"
              ]
            },
            "sanctionAuthority": {
              "type": "string",
              "enum": [
                "ofac",
                "fincen",
                "ukhmt",
                "eu_restrictive",
                "japan_mof",
                "kr_fsc",
                "in_fiu",
                "sg_mas",
                "au_austrac",
                "ca_fintrac"
              ]
            },
            "sanctionsHitVid": {
              "type": "string",
              "description": "bridges ransomwarePay.flagSanctionsHit"
            },
            "listedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}