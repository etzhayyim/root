{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.parisClub.recordTreatment",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Paris Club debt treatment (bridges bricsBank.flagGovernanceDispute + sovereign-debt + imf-article-iv)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "treatmentId",
            "debtorCountryIso3",
            "treatmentKind",
            "signedAt"
          ],
          "properties": {
            "treatmentId": {
              "type": "string"
            },
            "debtorCountryIso3": {
              "type": "string"
            },
            "treatmentKind": {
              "type": "string",
              "enum": [
                "classic_terms",
                "houston_terms",
                "naples_terms",
                "cologne_terms",
                "evian_approach",
                "ex_ante",
                "common_framework_cf",
                "suspension_dsss",
                "reprofiling",
                "debt_for_nature",
                "debt_for_climate",
                "post_cutoff"
              ]
            },
            "governanceVid": {
              "type": "string",
              "description": "bridges bricsBank.flagGovernanceDispute"
            },
            "signedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}