{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.plasticTreaty.recordTradeFlow",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Plastic waste / resin trade flow (Basel Convention Annex IX — bridges hs + customs + commodity-trade)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flowId",
            "hsCode",
            "exporterIso3",
            "importerIso3",
            "baselCategory",
            "tonnes",
            "shippedAt"
          ],
          "properties": {
            "flowId": {
              "type": "string"
            },
            "hsCode": {
              "type": "string",
              "description": "HS 3915 / 3901-3914"
            },
            "exporterIso3": {
              "type": "string"
            },
            "importerIso3": {
              "type": "string"
            },
            "baselCategory": {
              "type": "string",
              "enum": [
                "B3011",
                "Y48",
                "A3210",
                "dissoluble",
                "non_covered"
              ]
            },
            "tonnes": {
              "type": "number"
            },
            "priorInformedConsent": {
              "type": "boolean"
            },
            "customsDeclarationVid": {
              "type": "string",
              "description": "bridges open-customs-clearance"
            },
            "shippedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "complianceTier": {
              "type": "string",
              "enum": [
                "compliant",
                "compliant_mixed",
                "illegal_shipment"
              ]
            }
          }
        }
      }
    }
  }
}