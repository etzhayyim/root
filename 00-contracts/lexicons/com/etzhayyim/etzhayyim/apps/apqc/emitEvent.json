{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.apqc.emitEvent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Write an APQC OCEL event through the LangServer runtime.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["apqcCode", "eventType"],
          "properties": {
            "apqcCode": { "type": "string" },
            "taskId": { "type": "string" },
            "eventType": { "type": "string" },
            "caseId": { "type": "string" },
            "objects": {},
            "attributes": {},
            "actorDid": { "type": "string" },
            "callerDid": { "type": "string" },
            "dryRun": { "type": "boolean" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "ocelEventId": { "type": "string" },
            "apqcCode": { "type": "string" },
            "eventType": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
