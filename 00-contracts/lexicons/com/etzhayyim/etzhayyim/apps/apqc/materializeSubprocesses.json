{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.apqc.materializeSubprocesses",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Materialize APQC subprocess DIDs for an APQC L1 code using the LangGraph/Pregel/LangChain runtime.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["apqcCode"],
          "properties": {
            "apqcCode": { "type": "string" },
            "subprocessCode": { "type": "string" },
            "callerDid": { "type": "string" },
            "dryRun": { "type": "boolean" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "apqcCode": { "type": "string" },
            "materialized": { "type": "integer" },
            "subprocesses": { "type": "array" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
