{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.apqc.coverageSnapshot",
  "defs": {
    "main": {
      "type": "query",
      "description": "Return APQC LangGraph/Pregel/LangChain + UDF migration coverage.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "registeredL1": { "type": "integer" },
            "totalL1": { "type": "integer" },
            "registeredSubProcesses": { "type": "integer" },
            "totalSubProcesses": { "type": "integer" },
            "runtime": { "type": "string" },
            "standaloneWasm": { "type": "string" }
          }
        }
      }
    }
  }
}
