{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.news.liveAudioSource",
  "defs": {
    "main": {
      "type": "record",
      "description": "Public live-news/radio stream source monitored by news.etzhayyim.com live audio ingest.",
      "key": "any",
      "record": {
        "type": "object",
        "properties": {
          "sourceId": { "type": "string" },
          "sourceName": { "type": "string" },
          "streamUrl": { "type": "string", "format": "uri" },
          "sourceUrl": { "type": "string", "format": "uri" },
          "sourceType": { "type": "string" },
          "region": { "type": "string" },
          "country": { "type": "string" },
          "topic": { "type": "string" },
          "topics": { "type": "array", "items": { "type": "string" } },
          "lang": { "type": "string" },
          "captureSeconds": { "type": "integer", "minimum": 5, "maximum": 180 },
          "maxBytes": { "type": "integer", "minimum": 262144, "maximum": 52428800 },
          "cadenceSeconds": { "type": "integer", "minimum": 60 },
          "cooldownSeconds": { "type": "integer", "minimum": 0 },
          "retainAudio": { "type": "boolean" },
          "retentionDays": { "type": "integer", "minimum": 0 },
          "rightsPolicy": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "paused", "disabled"] },
          "createdAt": { "type": "string", "format": "datetime" },
          "updatedAt": { "type": "string", "format": "datetime" }
        },
        "required": ["sourceId", "sourceName", "streamUrl", "status", "createdAt"]
      }
    }
  }
}
