{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.news.registerLiveAudioSource",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register or update a public live-news/radio stream source for scheduled live audio ingest.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "sourceId": { "type": "string" },
            "sourceName": { "type": "string" },
            "streamUrl": { "type": "string" },
            "sourceUrl": { "type": "string" },
            "sourceType": { "type": "string" },
            "region": { "type": "string" },
            "country": { "type": "string" },
            "topic": { "type": "string" },
            "topics": { "type": "array", "items": { "type": "string" } },
            "lang": { "type": "string" },
            "captureSeconds": { "type": "integer", "minimum": 5, "maximum": 180 },
            "maxBytes": { "type": "integer", "minimum": 262144, "maximum": 52428800 },
            "cadenceSeconds": { "type": "integer", "minimum": 60 },
            "cooldownSeconds": { "type": "integer", "minimum": 0 },
            "retainAudio": { "type": "boolean" },
            "retentionDays": { "type": "integer", "minimum": 0 },
            "rightsPolicy": { "type": "string" },
            "status": { "type": "string" }
          },
          "required": ["sourceId", "sourceName", "streamUrl"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "sourceId": { "type": "string" },
            "rkey": { "type": "string" },
            "record": { "type": "object" },
            "policyGate": { "type": "object" },
            "error": { "type": "string" }
          },
          "required": ["ok"]
        }
      }
    }
  }
}
