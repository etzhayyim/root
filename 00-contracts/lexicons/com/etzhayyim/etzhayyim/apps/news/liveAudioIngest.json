{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.news.liveAudioIngest",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Capture a short public live-news/radio audio window, transcribe it, and submit the transcript as attributed news intel.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "sourceId": { "type": "string" },
            "sourceName": { "type": "string" },
            "streamUrl": { "type": "string" },
            "sourceUrl": { "type": "string" },
            "sourceType": { "type": "string" },
            "region": { "type": "string" },
            "country": { "type": "string" },
            "topic": { "type": "string" },
            "lang": { "type": "string" },
            "captureSeconds": { "type": "integer", "minimum": 5, "maximum": 180 },
            "maxBytes": { "type": "integer", "minimum": 262144, "maximum": 52428800 },
            "retainAudio": { "type": "boolean" },
            "retentionDays": { "type": "integer", "minimum": 0, "maximum": 30 },
            "rightsPolicy": { "type": "string" },
            "publish": { "type": "boolean" }
          },
          "required": ["sourceId", "sourceName", "streamUrl"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "sourceId": { "type": "string" },
            "transcriptText": { "type": "string" },
            "language": { "type": "string" },
            "capturedBytes": { "type": "integer" },
            "audioSha256": { "type": "string" },
            "audioMimeType": { "type": "string" },
            "audioUri": { "type": "string" },
            "policyGate": { "type": "object" },
            "effectiveRetainAudio": { "type": "boolean" },
            "retentionDays": { "type": "integer" },
            "sttBytes": { "type": "integer" },
            "sttMimeType": { "type": "string" },
            "sttExtension": { "type": "string" },
            "remuxStatus": { "type": "string" },
            "remuxError": { "type": "string" },
            "streamKind": { "type": "string" },
            "resolvedStreamUrls": { "type": "array", "items": { "type": "string" } },
            "intelReport": { "type": "object" },
            "auditRkey": { "type": "string" },
            "error": { "type": "string" }
          },
          "required": ["ok"]
        }
      }
    }
  }
}
