{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.news.listLiveAudioSources",
  "defs": {
    "main": {
      "type": "query",
      "description": "List registered public live-news/radio stream sources for live audio ingest scheduling.",
      "parameters": {
        "type": "params",
        "properties": {
          "status": { "type": "string" },
          "region": { "type": "string" },
          "topic": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
          "cursor": { "type": "string" }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "sources": { "type": "array", "items": { "type": "object" } },
            "total": { "type": "integer" },
            "cursor": { "type": "string" },
            "policySummary": { "type": "object" },
            "error": { "type": "string" }
          },
          "required": ["sources", "total"]
        }
      }
    }
  }
}
