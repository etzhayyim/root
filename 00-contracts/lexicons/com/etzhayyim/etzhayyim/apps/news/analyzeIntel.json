{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.news.analyzeIntel",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Turn primary/official-source news evidence into an attributed intel brief for news.etzhayyim.com.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "summary": { "type": "string" },
            "text": { "type": "string" },
            "url": { "type": "string" },
            "sourceId": { "type": "string" },
            "sourceType": { "type": "string" },
            "country": { "type": "string" },
            "region": { "type": "string" },
            "topic": { "type": "string" },
            "rightsPolicy": { "type": "string" },
            "publishedAt": { "type": "string" },
            "facts": { "type": "array", "items": { "type": "string" } },
            "findings": { "type": "array", "items": { "type": "string" } },
            "entities": { "type": "array", "items": { "type": "object" } },
            "socialPost": { "type": "string" },
            "socialArbitrageScore": { "type": "number" },
            "credibility": { "type": "number" },
            "priority": { "type": "number" },
            "bridgeScores": {
              "type": "object",
              "properties": {
                "inequalityBridge": { "type": "number" },
                "lonelinessBridge": { "type": "number" },
                "separationBridge": { "type": "number" },
                "actionability": { "type": "number" }
              }
            },
            "publish": { "type": "boolean" }
          },
          "required": ["title", "url"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "id": { "type": "string" },
            "status": { "type": "string" },
            "report": { "type": "object" },
            "policyGate": { "type": "object" },
            "policyAllowPublish": { "type": "boolean" },
            "spatialEventExport": { "type": "object" },
            "published": { "type": "boolean" },
            "postText": { "type": "string" },
            "error": { "type": "string" }
          },
          "required": ["ok"]
        }
      }
    }
  }
}
