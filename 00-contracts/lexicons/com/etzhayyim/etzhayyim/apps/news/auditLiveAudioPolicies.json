{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.news.auditLiveAudioPolicies",
  "defs": {
    "main": {
      "type": "query",
      "description": "Audit registered live-news/radio sources for publication, maps export, and audio retention policy status.",
      "parameters": {
        "type": "params",
        "properties": {
          "status": { "type": "string" },
          "region": { "type": "string" },
          "topic": { "type": "string" },
          "onlyBlocked": { "type": "boolean" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
          "cursor": { "type": "string" }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "total": { "type": "integer" },
            "cursor": { "type": "string" },
            "summary": { "type": "object" },
            "items": { "type": "array", "items": { "type": "object" } },
            "error": { "type": "string" }
          },
          "required": ["ok", "total", "items"]
        }
      }
    }
  }
}
