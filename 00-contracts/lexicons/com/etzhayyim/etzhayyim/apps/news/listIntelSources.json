{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.news.listIntelSources",
  "defs": {
    "main": {
      "type": "query",
      "description": "List official and primary source feeds used by the news.etzhayyim.com intel actor process.",
      "parameters": {
        "type": "params",
        "properties": {
          "region": { "type": "string" },
          "topic": { "type": "string" },
          "officialOnly": { "type": "boolean" }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "sources": { "type": "array", "items": { "type": "object" } },
            "total": { "type": "integer" }
          },
          "required": ["sources", "total"]
        }
      }
    }
  }
}
