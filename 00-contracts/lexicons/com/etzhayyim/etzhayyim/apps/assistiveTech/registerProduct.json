{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.assistiveTech.registerProduct",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Assistive tech / AT2030 / WHO GATE product (bridges digital-accessibility + accessibility-services + crc-children-digital + crpd-disability)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "productId",
            "productKind",
            "registeredAt"
          ],
          "properties": {
            "productId": {
              "type": "string"
            },
            "manufacturerLei": {
              "type": "string"
            },
            "productKind": {
              "type": "string",
              "enum": [
                "hearing_aid",
                "eyeglasses",
                "wheelchair_manual",
                "wheelchair_powered",
                "prosthetic",
                "screen_reader",
                "aac",
                "braille_display",
                "mobility_cane",
                "pill_organiser",
                "environmental_control",
                "smart_home_a11y"
              ]
            },
            "who_APL_listed": {
              "type": "boolean",
              "description": "WHO Priority Assistive Products List"
            },
            "isoTaxonomy": {
              "type": "string",
              "description": "ISO 9999"
            },
            "priceUsd": {
              "type": "number"
            },
            "registeredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}