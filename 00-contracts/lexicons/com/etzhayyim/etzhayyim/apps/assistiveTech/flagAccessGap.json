{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.assistiveTech.flagAccessGap",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Access gap / procurement failure / lack of training (bridges ocds-procurement + universal-health-coverage + just-transition)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "gapId",
            "productVid",
            "countryIso3",
            "gapKind",
            "reportedAt"
          ],
          "properties": {
            "gapId": {
              "type": "string"
            },
            "productVid": {
              "type": "string",
              "description": "bridges registerProduct"
            },
            "countryIso3": {
              "type": "string"
            },
            "gapKind": {
              "type": "string",
              "enum": [
                "cost",
                "procurement",
                "training",
                "supply_chain",
                "repair",
                "cultural_acceptability",
                "digital_divide"
              ]
            },
            "unmetNeedPersons": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "targeted",
                "broad",
                "mass"
              ]
            }
          }
        }
      }
    }
  }
}