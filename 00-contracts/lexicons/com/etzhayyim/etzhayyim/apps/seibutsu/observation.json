{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.seibutsu.observation",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "An individual organism observation. Individual = path-based DID under taxon.",
      "record": {
        "type": "object",
        "required": ["taxonDid", "observerDid", "observedAt"],
        "properties": {
          "taxonDid": { "type": "string" },
          "individualDid": { "type": "string", "description": "Optional persistent DID for a tracked individual." },
          "observerDid": { "type": "string" },
          "observedAt": { "type": "string", "format": "datetime" },
          "geoH3": { "type": "string", "description": "H3 cell at resolution 9 (~150m)." },
          "lat": { "type": "number" },
          "lon": { "type": "number" },
          "imageBlobCid": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
