{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.isotopeTraceability.flagOriginMismatch",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Origin mismatch / adulteration / laundering detection (bridges uflpaEnforcement.flagRebuttalFailure + rules-of-origin + residue-mrl)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "assayVid",
            "mismatchKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "assayVid": {
              "type": "string",
              "description": "bridges recordAssay"
            },
            "mismatchKind": {
              "type": "string",
              "enum": [
                "claimed_vs_measured",
                "dilution",
                "substitution_with_cheap",
                "blending",
                "intentional_adulteration",
                "unintentional_cross",
                "mislabelled",
                "transshipment_identified",
                "sampling_bias",
                "matrix_interference"
              ]
            },
            "dilutionPct": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}