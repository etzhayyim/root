{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.micaCrypto.flagTokenIssuance",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ART/EMT issuance whitepaper + reserve event (bridges sovereign-debt + misinformation-observatory)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "issuanceId",
            "caspVid",
            "tokenKind",
            "issuedAt"
          ],
          "properties": {
            "issuanceId": {
              "type": "string"
            },
            "caspVid": {
              "type": "string",
              "description": "bridges registerCasp"
            },
            "tokenKind": {
              "type": "string",
              "enum": [
                "emt_fiat",
                "art",
                "utility",
                "nft",
                "security",
                "governance"
              ]
            },
            "underlyingCurrency": {
              "type": "string",
              "description": "ISO 4217 if EMT"
            },
            "reserveRatio": {
              "type": "number"
            },
            "reserveCustodyLei": {
              "type": "string"
            },
            "capMcapUsd": {
              "type": "number"
            },
            "issuedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "riskTier": {
              "type": "string",
              "enum": [
                "standard",
                "undercollateralized",
                "systemic"
              ]
            }
          }
        }
      }
    }
  }
}