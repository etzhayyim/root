{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openOssekai.proposeArbitrageBrief",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "L2: Generate LLM arbitrage proposal for a supply/demand gap. Writes to vertex_ossekai_arbitrage and vertex_open_sales_lead.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["opportunityKind"],
          "properties": {
            "opportunityKind":  { "type": "string", "description": "Type of opportunity (e.g. 'skill_gap', 'demand_latent', 'supply_excess')" },
            "supplyActorDid":   { "type": "string", "description": "DID of supply-side actor (optional)" },
            "demandActorDid":   { "type": "string", "description": "DID of demand-side actor (optional)" },
            "contextHint":      { "type": "string", "description": "Additional context for the LLM (optional)" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok":          { "type": "boolean" },
            "instanceKey": { "type": "string" },
            "arbId":       { "type": "string" }
          }
        }
      }
    }
  }
}
