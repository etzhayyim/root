{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openOssekai.scoreJocho",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "L3: Score jocho (情緒) on 5 Well-Becoming axes for a consented actor. Requires prior requestOssekaiConsent call.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["targetDid"],
          "properties": {
            "targetDid": { "type": "string", "description": "DID of actor to score" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok":          { "type": "boolean" },
            "instanceKey": { "type": "string" },
            "jochoScore":  { "type": "number" }
          }
        }
      }
    }
  }
}
