{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openOssekai.requestOssekaiConsent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "L3: Record consent for Well-Becoming analysis (ADR-0018 Tier 3 PII gate). Must be called before scoreJocho.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["targetDid", "consentDid"],
          "properties": {
            "targetDid":    { "type": "string", "description": "DID of actor to be analyzed" },
            "consentDid":   { "type": "string", "description": "DID granting consent (usually same as targetDid)" },
            "consentScope": { "type": "string", "description": "Scope of consent (default: 'wellbecoming.jocho')" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok":          { "type": "boolean" },
            "instanceKey": { "type": "string" }
          }
        }
      }
    }
  }
}
