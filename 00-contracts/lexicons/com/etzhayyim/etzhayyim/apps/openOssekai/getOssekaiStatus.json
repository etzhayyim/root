{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openOssekai.getOssekaiStatus",
  "defs": {
    "main": {
      "type": "query",
      "description": "Read latest ossekai status for an actor: signals, briefs, arbitrage, and wellbecoming plan.",
      "parameters": {
        "type": "params",
        "required": ["targetDid"],
        "properties": {
          "targetDid": { "type": "string", "description": "DID of actor to query" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["targetDid"],
          "properties": {
            "targetDid":        { "type": "string" },
            "signalCount":      { "type": "integer" },
            "latestBriefId":    { "type": "string" },
            "latestBriefTitle": { "type": "string" },
            "openArbCount":     { "type": "integer" },
            "kyuDanPlan":       { "type": "string" },
            "jochoScore":       { "type": "number" },
            "consentStatus":    { "type": "string" }
          }
        }
      }
    }
  }
}
