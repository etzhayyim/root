{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openOssekai.generateWellBecomingPlan",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "L3: Generate Well-Becoming coaching plan with kyu/dan roadmap. Run after scoreJocho. Propagates qualified lead to vertex_open_sales_lead.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["targetDid"],
          "properties": {
            "targetDid": { "type": "string", "description": "DID of actor to coach" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok":           { "type": "boolean" },
            "instanceKey":  { "type": "string" },
            "targetKyuDan": { "type": "string" }
          }
        }
      }
    }
  }
}
