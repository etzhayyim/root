{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openSmartphoneEms.recordCapacityOrder",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a manufacturing capacity order with an EMS facility",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["orderId", "facilityDid", "quantityUnits", "deliveryQuarter"],
          "properties": {
            "orderId": { "type": "string" },
            "facilityDid": { "type": "string", "format": "did" },
            "bomDid": { "type": "string", "format": "did" },
            "quantityUnits": { "type": "integer" },
            "targetUnitCostUsd": { "type": "number" },
            "deliveryQuarter": { "type": "string", "description": "YYYY-QN format e.g. 2026-Q3" },
            "qualityStandard": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["vertexId"],
          "properties": { "vertexId": { "type": "string" } }
        }
      }
    }
  }
}
