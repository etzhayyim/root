{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openSmartphoneEms.registerFacility",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register an EMS (Electronics Manufacturing Services) facility for smartphone production",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["facilityId", "operatorName", "locationIso3", "facilityType"],
          "properties": {
            "facilityId": { "type": "string" },
            "operatorName": { "type": "string" },
            "operatorLei": { "type": "string", "description": "LEI code of operating entity" },
            "locationIso3": { "type": "string" },
            "city": { "type": "string" },
            "facilityType": { "type": "string", "knownValues": ["pcba", "smt", "assembly", "testing", "full-line", "logistics"] },
            "monthlyCapacityUnits": { "type": "integer" },
            "certifications": { "type": "array", "items": { "type": "string" }, "description": "e.g. ISO9001, ISO14001, RBA, IATF16949" },
            "rbaAuditStatus": { "type": "string", "knownValues": ["passed", "conditional", "failed", "pending", "not-audited"] },
            "conflictMineralCompliant": { "type": "boolean" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["vertexId"],
          "properties": { "vertexId": { "type": "string" } }
        }
      }
    }
  }
}
