{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.etzhayyim.eros-gore-precedent",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "Council Lv6+ ruling established as a precedent for future Eros/Gore classifications. Indexed via vector search by future judging requests. Per ADR-2605192400 Layer 3.",
      "record": {
        "type": "object",
        "required": [
          "subjectDescription",
          "councilDetermination",
          "councilRationale",
          "councilSigners",
          "applicableScope",
          "establishedAt"
        ],
        "properties": {
          "subjectDescription": {
            "type": "string",
            "maxLength": 2000,
            "description": "Canonical description of the content category this precedent governs."
          },
          "originalJudgingUri": {
            "type": "string",
            "format": "at-uri",
            "description": "AT URI of the eros-gore-judging that triggered Council deliberation."
          },
          "llmPreClassification": {
            "type": "string",
            "enum": ["T1", "T2", "T3", "T4", "T5"]
          },
          "councilDetermination": {
            "type": "string",
            "enum": ["permit", "prohibit", "conditional"]
          },
          "councilRationale": {
            "type": "string",
            "maxLength": 8000,
            "description": "Full Council reasoning. Public + permanent. Future similar cases applied directly without Council re-deliberation."
          },
          "councilSigners": {
            "type": "array",
            "minLength": 3,
            "items": { "type": "string" }
          },
          "councilSignatures": {
            "type": "array",
            "minLength": 3,
            "items": { "type": "string" }
          },
          "applicableScope": {
            "type": "string",
            "maxLength": 500,
            "description": "Concise category descriptor for indexing (e.g., 'commercial-entertainment-violence-games', 'religious-art-crucifixion-imagery')."
          },
          "establishedAt": { "type": "string", "format": "datetime" },
          "supersedesPrecedent": {
            "type": "string",
            "format": "at-uri",
            "description": "Optional AT URI of an earlier precedent this one revises/overturns."
          },
          "supersededBy": {
            "type": "string",
            "format": "at-uri",
            "description": "Set by a later precedent when this one is overturned."
          }
        }
      }
    }
  }
}
