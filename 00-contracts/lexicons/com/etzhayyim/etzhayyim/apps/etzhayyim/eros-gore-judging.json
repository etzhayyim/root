{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.etzhayyim.eros-gore-judging",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "Content classification request for Eros/Gore boundary. 3-layer framework (LLM pre-classification → Council Lv6+ on T2/T4 → precedent application). Per ADR-2605192400.",
      "record": {
        "type": "object",
        "required": ["contentUri", "deploymentContext", "requestedAt", "llmTier"],
        "properties": {
          "contentUri": {
            "type": "string",
            "description": "URI of the content being classified (AT URI / URL / IPFS CID)."
          },
          "contentMetadata": {
            "type": "object",
            "description": "Open object — metadata schema varies by content type.",
            "properties": {
              "title": { "type": "string", "maxLength": 200 },
              "mediaType": { "type": "string", "maxLength": 100 },
              "ageRating": { "type": "string", "maxLength": 50 },
              "encrypted": {
                "type": "boolean",
                "default": false,
                "description": "If true, classification uses Murakumo Gemma local fallback (no external LLM)."
              }
            }
          },
          "deploymentContext": {
            "type": "string",
            "enum": ["internal-religious", "internal-general", "external-public", "educational", "documentary", "religious-art", "commercial-entertainment"]
          },
          "requestingAppDid": { "type": "string" },
          "llmTier": {
            "type": "string",
            "enum": ["T1", "T2", "T3", "T4", "T5"],
            "description": "T1 Clear Eros / T2 Eros Borderline / T3 Neutral / T4 Gore Borderline / T5 Clear Gore"
          },
          "llmRationale": { "type": "string", "maxLength": 4000 },
          "applicablePrecedentUris": {
            "type": "array",
            "maxLength": 20,
            "items": { "type": "string", "format": "at-uri" }
          },
          "councilDeferralUri": {
            "type": "string",
            "format": "at-uri",
            "description": "If T2/T4 and no precedent matched, AT URI of the Council deliberation request."
          },
          "finalDetermination": {
            "type": "string",
            "enum": ["permit", "prohibit", "conditional", "council-required"]
          },
          "finalRationale": { "type": "string", "maxLength": 4000 },
          "requestedAt": { "type": "string", "format": "datetime" },
          "finalizedAt": { "type": "string", "format": "datetime" },
          "cellSignature": { "type": "string" }
        }
      }
    }
  }
}
