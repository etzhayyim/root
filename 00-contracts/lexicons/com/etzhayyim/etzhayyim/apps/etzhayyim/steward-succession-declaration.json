{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.etzhayyim.steward-succession-declaration",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "Steward's pre-declaration of successors for a land trust holding. Required at land-donation time. Primary + ≥2 backup successors with pre-acceptance. Per ADR-2605192345 §1.",
      "record": {
        "type": "object",
        "required": [
          "landId",
          "donorDid",
          "primarySuccessor",
          "backupSuccessors",
          "fallbackPath",
          "declaredAt",
          "donorSignature"
        ],
        "properties": {
          "landId": { "type": "integer", "minimum": 1 },
          "donorDid": { "type": "string" },
          "primarySuccessor": {
            "type": "ref",
            "ref": "#successorEntry"
          },
          "backupSuccessors": {
            "type": "array",
            "minLength": 2,
            "maxLength": 10,
            "items": { "type": "ref", "ref": "#successorEntry" }
          },
          "fallbackPath": {
            "type": "string",
            "enum": ["council-appointed", "corpus-direct", "community-trust", "dissolution-to-corpus"],
            "description": "Path if all primary + backup successors decline or are unavailable. Per ADR-2605192345 §4."
          },
          "multiGenerationalPlan": {
            "type": "array",
            "maxLength": 7,
            "items": { "type": "ref", "ref": "#generationEntry" },
            "description": "Optional 3+ generation succession plan per ADR-2605192345 §6."
          },
          "declaredAt": { "type": "string", "format": "datetime" },
          "donorSignature": { "type": "string" },
          "supersedes": {
            "type": "string",
            "format": "at-uri",
            "description": "Optional AT URI of a prior declaration this one replaces (donor can update during their lifetime)."
          }
        }
      }
    },
    "successorEntry": {
      "type": "object",
      "required": ["did", "relationship", "preAcceptanceUri"],
      "properties": {
        "did": { "type": "string" },
        "sbtTokenId": { "type": "integer" },
        "relationship": {
          "type": "string",
          "enum": ["child", "grandchild", "spouse", "sibling", "trusted-adherent", "council-appointed"]
        },
        "preAcceptanceUri": {
          "type": "string",
          "format": "at-uri",
          "description": "AT URI of the successor's signed steward-succession-pre-acceptance record."
        }
      }
    },
    "generationEntry": {
      "type": "object",
      "required": ["generation", "successorDid"],
      "properties": {
        "generation": { "type": "integer", "minimum": 1, "maximum": 7 },
        "successorDid": { "type": "string" },
        "preAcceptanceUri": { "type": "string", "format": "at-uri" },
        "preAcceptFuture": {
          "type": "boolean",
          "default": false,
          "description": "True if this generation is not yet born (placeholder for future SBT holder)."
        }
      }
    }
  }
}
