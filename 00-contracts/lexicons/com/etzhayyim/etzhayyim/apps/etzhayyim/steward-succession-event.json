{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.etzhayyim.steward-succession-event",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "Steward succession activation event. Triggered by death / incapacitation / absence / step-down / Non-Aligned. Council Lv6+ ≥3 verification required. Per ADR-2605192345 §2.",
      "record": {
        "type": "object",
        "required": [
          "landId",
          "previousStewardDid",
          "newStewardDid",
          "trigger",
          "triggerEvidenceCid",
          "successionDeclarationUri",
          "councilSigners",
          "activatedAt"
        ],
        "properties": {
          "landId": { "type": "integer", "minimum": 1 },
          "previousStewardDid": { "type": "string" },
          "newStewardDid": { "type": "string" },
          "newStewardSbtTokenId": { "type": "integer" },
          "trigger": {
            "type": "string",
            "enum": ["death", "incapacitation", "long-term-absence", "step-down", "non-aligned-status", "council-reassignment"]
          },
          "triggerEvidenceCid": {
            "type": "string",
            "description": "IPFS CID of evidence (death certificate / medical attestation / absence attestation / step-down record / Charter Compliance attestation tx ref)."
          },
          "successionDeclarationUri": {
            "type": "string",
            "format": "at-uri",
            "description": "AT URI of the donor's original steward-succession-declaration."
          },
          "successorRoleUsed": {
            "type": "string",
            "enum": ["primary", "backup-1", "backup-2", "backup-N", "fallback-council-appointed", "fallback-corpus-direct", "fallback-community-trust", "fallback-dissolution-to-corpus"]
          },
          "councilSigners": {
            "type": "array",
            "minLength": 3,
            "items": { "type": "string" }
          },
          "councilSignatures": {
            "type": "array",
            "minLength": 3,
            "items": { "type": "string" }
          },
          "landRegistryTxHash": {
            "type": "string",
            "description": "LandRegistry.reassignSteward() tx hash on geth-private."
          },
          "activatedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
