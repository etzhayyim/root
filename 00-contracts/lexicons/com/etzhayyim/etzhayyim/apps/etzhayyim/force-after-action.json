{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.etzhayyim.force-after-action",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "After-action review of a force operation. RELIGIOUS REQUIREMENT — analogous to Buddhist 懺悔 / Christian confession + lessons learned. Required within 30 days of force-log. Council Lv6+ ≥3 sign-off. Per ADR-2605192315 §5.",
      "record": {
        "type": "object",
        "required": [
          "forceLogUri",
          "complianceWithProportionality",
          "lessonsLearned",
          "councilSigners",
          "councilSignatures",
          "reviewedAt"
        ],
        "properties": {
          "forceLogUri": { "type": "string", "format": "at-uri" },
          "complianceWithProportionality": {
            "type": "string",
            "enum": ["fully-compliant", "partially-compliant", "non-compliant"]
          },
          "complianceNarrative": { "type": "string", "maxLength": 4000 },
          "lessonsLearned": {
            "type": "string",
            "maxLength": 8000,
            "description": "Public + permanent record. Religious-corp collective memory."
          },
          "recommendations": {
            "type": "array",
            "maxLength": 50,
            "items": { "type": "string", "maxLength": 1000 },
            "description": "Concrete recommendations for future force operations or doctrine revision."
          },
          "selfCritiqueCid": {
            "type": "string",
            "description": "IPFS CID of optional self-critique document from operating actors."
          },
          "councilSigners": {
            "type": "array",
            "minLength": 3,
            "items": { "type": "string" }
          },
          "councilSignatures": {
            "type": "array",
            "minLength": 3,
            "items": { "type": "string" }
          },
          "reviewedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
