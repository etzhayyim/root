{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.etzhayyim.force-log",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "On-chain log of an actual force operation. Constitutional REQUIREMENT — every force action MUST be logged. Per ADR-2605192100 §1.12.B + 2605192315.",
      "record": {
        "type": "object",
        "required": [
          "authorizationUri",
          "actionDescription",
          "actorDids",
          "outcomeNarrative",
          "actionTimestamp",
          "loggedAt"
        ],
        "properties": {
          "authorizationUri": {
            "type": "string",
            "format": "at-uri",
            "description": "AT URI of the prior force-authorization-proposal that approved this action."
          },
          "onchainAuthorizationId": { "type": "string" },
          "actionDescription": { "type": "string", "maxLength": 8000 },
          "actorDids": {
            "type": "array",
            "minLength": 1,
            "items": { "type": "string" }
          },
          "locationCid": {
            "type": "string",
            "description": "Optional IPFS CID of location data (GPS coordinates / GeoJSON area / 'redacted' for adherent safety)."
          },
          "outcomeNarrative": { "type": "string", "maxLength": 8000 },
          "casualties": {
            "type": "object",
            "description": "Required field. Religious-corp accountability standard demands explicit transparency.",
            "properties": {
              "etzhayyimAdherent": { "type": "integer", "minimum": 0 },
              "thirdPartyCivilian": { "type": "integer", "minimum": 0 },
              "thirdPartyCombatant": { "type": "integer", "minimum": 0 },
              "details": { "type": "string", "maxLength": 4000 }
            }
          },
          "witnessesAttestations": {
            "type": "array",
            "maxLength": 50,
            "items": { "type": "string", "format": "at-uri" },
            "description": "AT URIs of independent witness attestations."
          },
          "actionTimestamp": { "type": "string", "format": "datetime" },
          "loggedAt": { "type": "string", "format": "datetime" },
          "actorSignatures": {
            "type": "array",
            "minLength": 1,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
