{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.etzhayyim.yobel.declareRite",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "etzhayyim religious-corp が集合的債務免除 rite を宣言する。voluntary opt-in 前提、強制力なし。",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "riteId",
            "riteType",
            "scope",
            "effectiveDate",
            "doctrinalBasis",
            "issuerDid"
          ],
          "properties": {
            "riteId": {
              "type": "string",
              "description": "Unique rite identifier (e.g. shmita-5786 / yobel-2074 / tokusei-1297-eikyo)"
            },
            "riteType": {
              "type": "string",
              "enum": [
                "shmita_7yr",
                "yobel_50yr",
                "tokusei_rei",
                "religious_jubilee",
                "political_amnesty"
              ]
            },
            "scope": {
              "type": "string",
              "description": "Free-text scope description (community boundary, jurisdiction, debt class)",
              "maxLength": 2000
            },
            "effectiveDate": {
              "type": "string",
              "format": "datetime"
            },
            "expiryDate": {
              "type": "string",
              "format": "datetime",
              "description": "Optional; absent = perpetual / single-event"
            },
            "doctrinalBasis": {
              "type": "string",
              "description": "Required citation (e.g. 'Lev 25:8-13' / 'Eikyo no Tokusei-rei 1297' / 'HIPC Initiative 1996')",
              "maxLength": 1000
            },
            "jurisdictionNotes": {
              "type": "string",
              "description": "Tax / legal warnings per jurisdiction (e.g. US IRC §61(a)(11) cancellation-of-debt income)",
              "maxLength": 4000
            },
            "issuerDid": {
              "type": "string",
              "description": "DID of declaring religious-corp / authority (etzhayyim primary or peer religious-corp)"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "riteId": {
              "type": "string"
            },
            "vertexId": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
