{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.etzhayyim.yobel.getRite",
  "defs": {
    "main": {
      "type": "query",
      "description": "Rite 詳細 (doctrinalBasis / jurisdictionNotes / 集計 metrics 含む)",
      "parameters": {
        "type": "params",
        "required": [
          "riteId"
        ],
        "properties": {
          "riteId": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "riteId"
          ],
          "properties": {
            "riteId": {
              "type": "string"
            },
            "riteType": {
              "type": "string"
            },
            "scope": {
              "type": "string"
            },
            "effectiveDate": {
              "type": "string",
              "format": "datetime"
            },
            "expiryDate": {
              "type": "string",
              "format": "datetime"
            },
            "status": {
              "type": "string"
            },
            "issuerDid": {
              "type": "string"
            },
            "doctrinalBasis": {
              "type": "string"
            },
            "jurisdictionNotes": {
              "type": "string"
            },
            "enrolledCreditors": {
              "type": "integer"
            },
            "enrolledDebtors": {
              "type": "integer"
            },
            "releasesCount": {
              "type": "integer"
            },
            "totalReleasedMicroUsdc": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
