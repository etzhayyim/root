{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.etzhayyim.yobel.enrollCreditor",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "債権者が voluntary に rite に opt-in し、release 対象 debt を登録する。signedConsent (ERC725 signature or Webauthn assertion) 必須。",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "riteId",
            "creditorDid",
            "debts",
            "signedConsent"
          ],
          "properties": {
            "riteId": {
              "type": "string"
            },
            "creditorDid": {
              "type": "string"
            },
            "debts": {
              "type": "array",
              "minLength": 1,
              "maxLength": 1000,
              "items": {
                "type": "ref",
                "ref": "#debtItem"
              }
            },
            "signedConsent": {
              "type": "string",
              "description": "Signature over canonical hash of (riteId|creditorDid|debts). ERC725 EIP-712 typed-data signature or DPoP JWT.",
              "maxLength": 4000
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "enrollmentId": {
              "type": "string"
            },
            "debtCount": {
              "type": "integer"
            },
            "vertexId": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    },
    "debtItem": {
      "type": "object",
      "required": [
        "debtId",
        "debtorDid",
        "principalMicroUsdc",
        "originationDate",
        "instrument"
      ],
      "properties": {
        "debtId": {
          "type": "string"
        },
        "debtorDid": {
          "type": "string"
        },
        "principalMicroUsdc": {
          "type": "integer",
          "description": "Principal in micro-USDC (1 USDC = 1_000_000). Float-free per AT Lexicon spec."
        },
        "accruedMicroUsdc": {
          "type": "integer",
          "description": "Accrued interest in micro-USDC (optional, default 0)"
        },
        "originationDate": {
          "type": "string",
          "format": "datetime"
        },
        "instrument": {
          "type": "string",
          "enum": [
            "loan",
            "promissory_note",
            "mortgage",
            "trade_receivable",
            "tax_obligation",
            "tithe_obligation",
            "other"
          ],
          "description": "Debt instrument the natural-person debtor owes. **sovereign_bond and corporate_bond intentionally excluded** — those are legal-person obligations and yobel is natural-person-only. margin_call also excluded (Charter Rider §2(b))."
        }
      }
    }
  }
}
