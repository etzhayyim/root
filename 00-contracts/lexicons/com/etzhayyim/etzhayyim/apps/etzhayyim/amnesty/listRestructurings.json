{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.etzhayyim.amnesty.listRestructurings",
  "defs": {
    "main": {
      "type": "query",
      "description": "Restructuring rite 一覧 (riteType / status / debtorJurisdiction / period filter)。pagination 必須。",
      "parameters": {
        "type": "params",
        "properties": {
          "riteType": {
            "type": "string",
            "enum": [
              "sovereign_multilateral",
              "sovereign_bilateral",
              "corporate_chapter_11",
              "corporate_workout",
              "debt_for_nature_swap"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "declared",
              "voting",
              "ratified",
              "settled",
              "cancelled",
              "superseded"
            ]
          },
          "debtorJurisdictionIso3": {
            "type": "string"
          },
          "issuerDid": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "default": 50,
            "minimum": 1,
            "maximum": 200
          },
          "offset": {
            "type": "integer",
            "default": 0,
            "minimum": 0
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "restructurings",
            "total",
            "offset",
            "limit"
          ],
          "properties": {
            "restructurings": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#restructuringSummary"
              }
            },
            "total": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            },
            "limit": {
              "type": "integer"
            }
          }
        }
      }
    },
    "restructuringSummary": {
      "type": "object",
      "required": [
        "restructuringId",
        "riteType",
        "status",
        "effectiveDate",
        "debtorJurisdictionIso3"
      ],
      "properties": {
        "restructuringId": {
          "type": "string"
        },
        "riteType": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "effectiveDate": {
          "type": "string",
          "format": "datetime"
        },
        "debtorJurisdictionIso3": {
          "type": "string"
        },
        "consentThresholdPermille": {
          "type": "integer"
        },
        "currentConsentPermille": {
          "type": "integer"
        },
        "totalReducedLiabilityMicroUsdc": {
          "type": "integer"
        }
      }
    }
  }
}
