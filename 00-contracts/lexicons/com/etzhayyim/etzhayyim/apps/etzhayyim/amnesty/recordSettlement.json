{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.etzhayyim.amnesty.recordSettlement",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Restructuring settlement 記録。yobel と異なり single-direction forgiveness ではなく **restructuring instruments** を扱う: haircut % / rescheduled tenor / debt-for-equity swap / debt-for-nature swap。consent threshold pass 確認後に呼ばれる。",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "settlementId",
            "restructuringId",
            "settlementType",
            "instruments",
            "settledAt"
          ],
          "properties": {
            "settlementId": {
              "type": "string"
            },
            "restructuringId": {
              "type": "string"
            },
            "settlementType": {
              "type": "string",
              "enum": [
                "haircut_only",
                "rescheduling_only",
                "haircut_plus_rescheduling",
                "debt_for_equity_swap",
                "debt_for_nature_swap",
                "comprehensive"
              ]
            },
            "instruments": {
              "type": "array",
              "minLength": 1,
              "maxLength": 100,
              "items": {
                "type": "ref",
                "ref": "#settlementInstrument"
              }
            },
            "totalOriginalLiabilityMicroUsdc": {
              "type": "integer"
            },
            "totalReducedLiabilityMicroUsdc": {
              "type": "integer",
              "description": "Post-settlement liability. (totalOriginal - totalReduced) is the aggregate haircut."
            },
            "settledAt": {
              "type": "string",
              "format": "datetime"
            },
            "courtDecreeRef": {
              "type": "string",
              "description": "For corporate_chapter_11 / scheme of arrangement: reference to the confirming court order (case number, docket)"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "settlementId": {
              "type": "string"
            },
            "haircutPermille": {
              "type": "integer",
              "description": "(totalOriginal - totalReduced) * 1000 / totalOriginal"
            },
            "vertexId": {
              "type": "string"
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    },
    "settlementInstrument": {
      "type": "object",
      "required": [
        "instrumentKind",
        "creditorClassId",
        "originalClaimMicroUsdc",
        "reducedClaimMicroUsdc"
      ],
      "properties": {
        "instrumentKind": {
          "type": "string",
          "enum": [
            "haircut",
            "rescheduling",
            "equity_swap",
            "nature_swap",
            "performance_contingent"
          ]
        },
        "creditorClassId": {
          "type": "string"
        },
        "originalClaimMicroUsdc": {
          "type": "integer"
        },
        "reducedClaimMicroUsdc": {
          "type": "integer"
        },
        "reschedulingTenorMonths": {
          "type": "integer",
          "description": "For rescheduling: new tenor in months. 0 if not applicable."
        },
        "equitySharePermille": {
          "type": "integer",
          "description": "For equity_swap: creditor's equity stake share in permille. 0 if not applicable."
        },
        "natureCommitmentCid": {
          "type": "string",
          "description": "For nature_swap: IPFS CID of the conservation commitment document. Empty otherwise."
        },
        "performanceTriggerCid": {
          "type": "string",
          "description": "For performance_contingent: IPFS CID of the contingent trigger spec. Empty otherwise."
        }
      }
    }
  }
}
