{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.etzhayyim.amnesty.verifyEligibility",
  "defs": {
    "main": {
      "type": "query",
      "description": "Restructuring eligibility 判定。rite type 別の cross-creditor consent threshold pre-check + entity-type gate (A14) + jurisdiction match + Charter Rider compliance scan。",
      "parameters": {
        "type": "params",
        "required": [
          "restructuringId",
          "debtorDid"
        ],
        "properties": {
          "restructuringId": {
            "type": "string"
          },
          "debtorDid": {
            "type": "string"
          },
          "strict": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "eligible",
            "riteType"
          ],
          "properties": {
            "eligible": {
              "type": "boolean"
            },
            "riteType": {
              "type": "string"
            },
            "consentThresholdPermille": {
              "type": "integer"
            },
            "currentConsentPermille": {
              "type": "integer",
              "description": "Running consent (weighted by claim share). Compares against consentThresholdPermille for vote completion check."
            },
            "deferToYobel": {
              "type": "boolean"
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Non-blocking warnings (e.g. 'sovereign creditor coalition has 2 non-aligned members under Charter Rider §2(a) review')"
            }
          }
        }
      }
    }
  }
}
