{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.etzhayyim.amnesty.enrollCreditorClass",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Creditor class が voluntary に restructuring rite に opt-in。class voting weight (creditor coalition share / impaired class share) を宣言。class membership 一覧 + 各 creditor の voting power を encrypted 状態で記録。",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "restructuringId",
            "creditorClassId",
            "className",
            "members",
            "totalClaimMicroUsdc",
            "classCoordinatorDid",
            "signedClassConsent"
          ],
          "properties": {
            "restructuringId": {
              "type": "string"
            },
            "creditorClassId": {
              "type": "string",
              "description": "Class identifier within the restructuring (e.g. 'senior-bondholders' / 'paris-club-bilateral' / 'trade-creditors-class-3')"
            },
            "className": {
              "type": "string",
              "description": "Human-readable class name",
              "maxLength": 200
            },
            "members": {
              "type": "array",
              "minLength": 1,
              "maxLength": 1000,
              "items": {
                "type": "ref",
                "ref": "#creditorMember"
              }
            },
            "totalClaimMicroUsdc": {
              "type": "integer",
              "description": "Total creditor claim across the class, in micro-USDC. Used to compute consent threshold satisfaction."
            },
            "classCoordinatorDid": {
              "type": "string",
              "description": "DID of the class coordinator (lead arranger / trustee / class representative)"
            },
            "signedClassConsent": {
              "type": "string",
              "description": "Aggregate signature set (EIP-712 typed data) signed by ≥ 50% of class members by claim value. Hashed in canonical form on-chain.",
              "maxLength": 8000
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "classEnrollmentId": {
              "type": "string"
            },
            "memberCount": {
              "type": "integer"
            },
            "totalClaimMicroUsdc": {
              "type": "integer"
            },
            "vertexId": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    },
    "creditorMember": {
      "type": "object",
      "required": [
        "creditorDid",
        "claimMicroUsdc"
      ],
      "properties": {
        "creditorDid": {
          "type": "string",
          "description": "Member creditor's DID. May be natural or legal person (yobel's natural-person-only restriction does NOT apply to creditors)."
        },
        "claimMicroUsdc": {
          "type": "integer",
          "description": "This member's individual claim in micro-USDC. Sum across members must equal class totalClaimMicroUsdc."
        },
        "creditorEntityType": {
          "type": "string",
          "enum": [
            "natural_person",
            "legal_person",
            "sovereign_state",
            "multilateral_institution"
          ]
        },
        "instrumentRef": {
          "type": "string",
          "description": "Optional reference (CUSIP / ISIN / loan agreement hash) identifying the underlying instrument"
        }
      }
    }
  }
}
