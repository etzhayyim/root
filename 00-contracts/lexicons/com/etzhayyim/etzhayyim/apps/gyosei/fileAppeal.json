{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.gyosei.fileAppeal",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "File an administrative appeal (shinsa seikyu).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "caseId": { "type": "string" },
            "appealPayload": {
              "type": "object",
              "properties": {
                "specialRouteCode": {
                  "type": "string",
                  "enum": [
                    "tax.national.general-disposition",
                    "social-insurance.health-pension.disposition",
                    "licensing.construction.permit-revocation"
                  ]
                },
                "statutoryAppealAvailability": { "type": "string", "enum": ["allowed", "excluded", "unknown"] },
                "specialAppealDeadlineDays": { "type": "integer" },
                "daysSinceNotice": { "type": "integer" },
                "hasJustifiableReason": { "type": "boolean" },
                "hasNewEvidence": { "type": "boolean" },
                "appealType": { "type": "string" }
              },
              "required": ["daysSinceNotice", "appealType"]
            }
          },
          "required": ["caseId", "appealPayload"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "appealCaseId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
