{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.gyosei.submitPrecedentMemo",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Store a precedent / administrative decision memo for a gyosei case.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "caseId": { "type": "string" },
            "memoPayload": {
              "type": "object",
              "properties": {
                "sourceIds": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "required": ["caseId", "memoPayload"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "memoId": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
