{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.gyosei.fileLitigation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Open a litigation bridge record for an administrative case.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "caseId": { "type": "string" },
            "litigationPayload": {
              "type": "object",
              "properties": {
                "specialRouteCode": {
                  "type": "string",
                  "enum": [
                    "tax.national.general-disposition",
                    "social-insurance.health-pension.disposition",
                    "licensing.construction.permit-revocation"
                  ]
                },
                "statutoryAppealPrecondition": { "type": "string", "enum": ["required", "optional", "excluded", "unknown"] },
                "hasAppealDecision": { "type": "boolean" },
                "specialLitigationDeadlineDays": { "type": "integer" },
                "daysSinceFinalNotice": { "type": "integer" },
                "requestedClaimType": { "type": "string" },
                "hasJustifiableReason": { "type": "boolean" },
                "wantsStay": { "type": "boolean" }
              },
              "required": ["daysSinceFinalNotice"]
            }
          },
          "required": ["caseId", "litigationPayload"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "litigationCaseId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
