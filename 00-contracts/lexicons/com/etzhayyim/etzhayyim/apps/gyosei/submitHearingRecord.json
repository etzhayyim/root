{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.gyosei.submitHearingRecord",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Submit a hearing / statement-opportunity execution record.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "caseId": { "type": "string" },
            "recordPayload": { "type": "object" }
          },
          "required": ["caseId", "recordPayload"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "recordId": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
