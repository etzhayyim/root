{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.gyosei.requestStay",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Request stay of execution / interim relief for a gyosei case.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "caseId": { "type": "string" },
            "stayPayload": { "type": "object" }
          },
          "required": ["caseId", "stayPayload"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "stayCaseId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
