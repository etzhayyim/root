{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.gyosei.submitDraft",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Submit or save an administrative procedure draft payload.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "caseId": { "type": "string" },
            "draftPayload": { "type": "object" }
          },
          "required": ["caseId", "draftPayload"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "savedAt": { "type": "string", "format": "datetime" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
