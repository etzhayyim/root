{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.gyosei.finalizeDisposition",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Finalize the administrative disposition / appeal outcome.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "caseId": { "type": "string" },
            "finalStatus": { "type": "string" },
            "noticeText": { "type": "string" }
          },
          "required": ["caseId", "finalStatus"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "notifiedAt": { "type": "string", "format": "datetime" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
