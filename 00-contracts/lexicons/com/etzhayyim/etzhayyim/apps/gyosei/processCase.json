{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.gyosei.processCase",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Internal agency processing of a submitted administrative procedure case.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "caseId": { "type": "string" },
            "decision": { "type": "string", "enum": ["approve", "reject", "request_more_info"] },
            "reviewerDid": { "type": "string", "format": "did" },
            "comments": { "type": "string" }
          },
          "required": ["caseId", "decision"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "newStatus": { "type": "string" },
            "processedAt": { "type": "string", "format": "datetime" }
          }
        }
      }
    }
  }
}
