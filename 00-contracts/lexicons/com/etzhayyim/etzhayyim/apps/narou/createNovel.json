{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.narou.createNovel",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create a new novel work",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "genre": { "type": "string" },
            "tags": { "type": "string" },
            "user_id": { "type": "string" },
            "org_id": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string" }
          }
        }
      }
    }
  }
}
