{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.narou.createChapter",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create a chapter draft under a novel",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["novel_id"],
          "properties": {
            "novel_id": { "type": "string" },
            "chapter_num": { "type": "integer" },
            "title": { "type": "string" },
            "content": { "type": "string" },
            "user_id": { "type": "string" },
            "org_id": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string" }
          }
        }
      }
    }
  }
}
