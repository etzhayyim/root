{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.refinerProduct.recordProductYield",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "製油 yield (asia-refinery+hs+unispsc bridge)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "yieldId",
            "refineryCode",
            "productCategory",
            "volumeTonnes",
            "producedAt"
          ],
          "properties": {
            "yieldId": {
              "type": "string"
            },
            "refineryCode": {
              "type": "string"
            },
            "receiptVid": {
              "type": "string",
              "description": "open-asia-refinery.receipt ref"
            },
            "productCategory": {
              "type": "string",
              "enum": [
                "gasoline",
                "diesel",
                "kerosene",
                "naphtha",
                "heavy-fuel-oil",
                "lpg",
                "petrochemical-feedstock",
                "asphalt"
              ]
            },
            "hsCode": {
              "type": "string"
            },
            "unspscCode": {
              "type": "string"
            },
            "volumeTonnes": {
              "type": "number"
            },
            "yieldPct": {
              "type": "number"
            },
            "producedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "efficiencyTier": {
              "type": "string",
              "enum": [
                "below-benchmark",
                "at-benchmark",
                "above-benchmark",
                "world-class"
              ]
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
