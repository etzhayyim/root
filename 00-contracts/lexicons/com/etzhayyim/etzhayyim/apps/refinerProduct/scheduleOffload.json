{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.refinerProduct.scheduleOffload",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "下流 offload 予定 (refinery→carrier bridge)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "offloadId",
            "volumeTonnes",
            "scheduledAt"
          ],
          "properties": {
            "offloadId": {
              "type": "string"
            },
            "yieldVid": {
              "type": "string"
            },
            "destinationCarrier": {
              "type": "string"
            },
            "destinationImo": {
              "type": "string"
            },
            "scheduleVid": {
              "type": "string",
              "description": "open-carrier-schedule.portCall ref"
            },
            "volumeTonnes": {
              "type": "number"
            },
            "scheduledAt": {
              "type": "string",
              "format": "datetime"
            },
            "actualAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "timelinessTier": {
              "type": "string",
              "enum": [
                "ahead",
                "on-time",
                "slight-delay",
                "major-delay"
              ]
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
