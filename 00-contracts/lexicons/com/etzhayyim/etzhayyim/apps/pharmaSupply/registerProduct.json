{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.pharmaSupply.registerProduct",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Pharma product registration (ATC + FDA NDC + EMA — bridges open-atc + open-ndc)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "productId",
            "registeredAt"
          ],
          "properties": {
            "productId": {
              "type": "string"
            },
            "atcCode": {
              "type": "string",
              "description": "WHO ATC L5 code, bridges open-atc"
            },
            "ndcCode": {
              "type": "string",
              "description": "FDA NDC 10/11-digit, bridges open-ndc"
            },
            "emaProductNumber": {
              "type": "string"
            },
            "manufacturerLei": {
              "type": "string"
            },
            "apiOriginIso3": {
              "type": "string",
              "description": "active pharmaceutical ingredient country"
            },
            "dosageForm": {
              "type": "string"
            },
            "registeredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}