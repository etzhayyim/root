{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.postalUnion.flagIpRights",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "UPU S-series misuse / counterfeit mail flag",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "flowVid",
            "issueType",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "flowVid": {
              "type": "string",
              "description": "bridges recordUpuFlow"
            },
            "issueType": {
              "type": "string",
              "enum": [
                "counterfeit",
                "prohibited",
                "dangerous",
                "narcotics",
                "weapons",
                "stamp_fraud",
                "forged_documents"
              ]
            },
            "customsDeclarationVid": {
              "type": "string",
              "description": "bridges open-customs-clearance"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "moderate",
                "severe",
                "critical"
              ]
            }
          }
        }
      }
    }
  }
}