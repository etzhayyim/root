{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.agent.activeInferenceTick",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Score candidate actions with an auditable expected-free-energy decomposition.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["agentDid", "candidateActions"],
          "properties": {
            "agentDid": { "type": "string" },
            "tickKind": { "type": "string" },
            "beliefSnapshotHash": { "type": "string" },
            "candidateActions": { "type": "array", "items": { "type": "unknown" } },
            "mokutekiGatePass": { "type": "boolean" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "selectedActionId": { "type": "string" },
            "expectedFreeEnergy": { "type": "unknown" },
            "rejected": { "type": "array", "items": { "type": "unknown" } }
          }
        }
      }
    }
  }
}
