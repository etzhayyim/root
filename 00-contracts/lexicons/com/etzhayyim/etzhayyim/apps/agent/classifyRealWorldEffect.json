{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.agent.classifyRealWorldEffect",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Classify an action proposal as a real-world effect and compute required gates.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["channel", "payload"],
          "properties": {
            "actionProposalId": { "type": "string" },
            "agentDid": { "type": "string" },
            "principalDid": { "type": "string" },
            "channel": { "type": "string" },
            "effectClass": { "type": "string" },
            "targetRef": { "type": "string" },
            "payload": { "type": "unknown" },
            "summary": { "type": "string" },
            "approvalRef": { "type": "string" },
            "autonomousAuthorityRef": {
              "type": "string",
              "description": "Scoped capability reference used instead of per-action human approval"
            },
            "budgetRef": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "realWorldEffect": { "type": "unknown" },
            "requiresApproval": { "type": "boolean" },
            "authorityMode": { "type": "string" },
            "blockers": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
