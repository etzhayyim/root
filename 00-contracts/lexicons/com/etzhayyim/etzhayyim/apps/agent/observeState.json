{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.agent.observeState",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record an observation for the active-inference agent world/self model.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["agentDid", "sourceKind", "payload"],
          "properties": {
            "agentDid": { "type": "string" },
            "sourceKind": { "type": "string" },
            "sourceRef": { "type": "string" },
            "observedAt": { "type": "string" },
            "payload": { "type": "unknown" },
            "confidence": { "type": "number" },
            "uncertainty": { "type": "number" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "observation": { "type": "unknown" }
          }
        }
      }
    }
  }
}
