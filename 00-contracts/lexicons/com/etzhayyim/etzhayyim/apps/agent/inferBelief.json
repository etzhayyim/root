{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.agent.inferBelief",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Derive persistent belief-state rows from recent observations.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["agentDid"],
          "properties": {
            "agentDid": { "type": "string" },
            "observations": { "type": "array", "items": { "type": "unknown" } },
            "beliefKind": { "type": "string" },
            "stateKey": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "beliefs": { "type": "array", "items": { "type": "unknown" } }
          }
        }
      }
    }
  }
}
