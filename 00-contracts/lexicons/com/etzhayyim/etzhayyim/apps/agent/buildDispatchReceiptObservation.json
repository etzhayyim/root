{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.agent.buildDispatchReceiptObservation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Convert a channel dispatch result into an agent observation and effect receipt patch.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "realWorldEffect": { "type": "object" },
            "dispatchPlan": { "type": "object" },
            "dispatchResult": { "type": "object" }
          },
          "required": ["realWorldEffect", "dispatchPlan", "dispatchResult"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "observation": { "type": "object" },
            "effectPatch": { "type": "object" },
            "receiptRef": { "type": "string" },
            "dispatchState": { "type": "string" },
            "blockers": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
