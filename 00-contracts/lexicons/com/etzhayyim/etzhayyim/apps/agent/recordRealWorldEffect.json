{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.agent.recordRealWorldEffect",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a real-world effect gate transition or dispatch receipt.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["effectId", "dispatchState"],
          "properties": {
            "effectId": { "type": "string" },
            "dispatchState": { "type": "string" },
            "dispatchReceiptRef": { "type": "string" },
            "observationPlan": { "type": "unknown" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "effectId": { "type": "string" }
          }
        }
      }
    }
  }
}
