{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.gulfTerminal.recordLoading",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Gulf 出荷端末 loading 記録",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "loadingId",
            "terminalCode",
            "country",
            "imo",
            "crudeGrade",
            "volumeTonnes",
            "blDate"
          ],
          "properties": {
            "loadingId": {
              "type": "string"
            },
            "terminalCode": {
              "type": "string",
              "description": "SARRS (Ras Tanura), UAFJR (Fujairah), IQBAS (Basra), AEJEA (Jebel Ali)"
            },
            "terminalName": {
              "type": "string"
            },
            "country": {
              "type": "string"
            },
            "imo": {
              "type": "string"
            },
            "vesselName": {
              "type": "string"
            },
            "crudeGrade": {
              "type": "string",
              "description": "arab-light / arab-heavy / murban / basra-light / etc"
            },
            "volumeTonnes": {
              "type": "number"
            },
            "quotaRef": {
              "type": "string",
              "description": "OPEC quota decision vertex_id"
            },
            "blDate": {
              "type": "string",
              "format": "date"
            },
            "departedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
