{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.fax.cancel",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Cancel a queued fax (only possible before provider starts sending).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["txId"],
          "properties": {
            "txId": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "status": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
