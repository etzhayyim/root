{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.fax.send",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Send a FAX via Dropbox Fax / Phaxio-compatible provider. Input = recipient fax number (E.164) + document reference (B2 blobKey or public URL). Returns provider faxId + local txId.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["to"],
          "properties": {
            "to": { "type": "string", "description": "Recipient fax number (E.164, e.g. +81338188411)" },
            "from": { "type": "string", "description": "Sender fax number or caller ID (optional, provider default)" },
            "blobKey": { "type": "string", "description": "R2 CDN blob key (SHA-256 hex) of the document to send (PDF)" },
            "url": { "type": "string", "format": "uri", "description": "Public HTTPS URL of the document (alternative to blobKey)" },
            "subject": { "type": "string", "description": "Fax subject / cover page title" },
            "caseId": { "type": "string", "description": "Related business case id (e.g. matsuoka-2504)" },
            "cover": {
              "type": "object",
              "description": "Cover page metadata (optional)",
              "properties": {
                "recipientName": { "type": "string" },
                "senderName": { "type": "string" },
                "note": { "type": "string" }
              }
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "txId"],
          "properties": {
            "ok": { "type": "boolean" },
            "txId": { "type": "string", "description": "Local transmission id (fax-<nanoid>)" },
            "providerFaxId": { "type": "string", "description": "Provider-side fax id" },
            "status": { "type": "string", "enum": ["queued", "sending", "success", "failure", "unknown"] },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
