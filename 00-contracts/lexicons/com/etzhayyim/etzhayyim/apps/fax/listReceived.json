{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.fax.listReceived",
  "defs": {
    "main": {
      "type": "query",
      "description": "List received faxes (inbound). Provider webhook writes com.etzhayyim.apps.fax.inboundFax records that this query projects.",
      "parameters": {
        "type": "params",
        "required": [],
        "properties": {
          "since": { "type": "string", "format": "datetime" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
          "offset": { "type": "integer", "minimum": 0, "default": 0 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "faxes", "total", "offset", "limit"],
          "properties": {
            "ok": { "type": "boolean" },
            "faxes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["rxId", "from", "receivedAt"],
                "properties": {
                  "rxId": { "type": "string" },
                  "providerFaxId": { "type": "string" },
                  "from": { "type": "string" },
                  "to": { "type": "string" },
                  "pages": { "type": "integer" },
                  "blobKey": { "type": "string", "description": "R2 CDN blob key of the inbound PDF" },
                  "receivedAt": { "type": "string", "format": "datetime" }
                }
              }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
