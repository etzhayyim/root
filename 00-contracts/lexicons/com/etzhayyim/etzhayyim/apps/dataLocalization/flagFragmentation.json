{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.dataLocalization.flagFragmentation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Fragmentation / conflict / extraterritorial reach (bridges internetShutdown.flagEconomicImpact + data-adequacy + crypto-derivatives)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "requirementVid",
            "concernKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "requirementVid": {
              "type": "string",
              "description": "bridges recordRequirement"
            },
            "concernKind": {
              "type": "string",
              "enum": [
                "conflict_with_gdpr",
                "conflict_cloud_act",
                "transfer_mechanism_lacking",
                "ridiculous_fines",
                "foreign_state_disclosure",
                "data_mirroring_waste",
                "multi_jurisdiction",
                "fintech_disrupt",
                "research_hamper",
                "msme_hit",
                "ai_training_blocked"
              ]
            },
            "estBusdImpact": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}