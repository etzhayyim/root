{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.dataLocalization.recordRequirement",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Data localization / sovereignty requirement (bridges internetShutdown.flagEconomicImpact + data-adequacy + cross-border-data)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "requirementId",
            "countryIso3",
            "regime",
            "dataCategory",
            "enforcedAt"
          ],
          "properties": {
            "requirementId": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "regime": {
              "type": "string",
              "enum": [
                "ru_sovereign",
                "cn_dsl_pipl",
                "in_dpdp",
                "id_dps_law",
                "vn_cyber",
                "sa_pdpl",
                "uae_data_law",
                "ke_data_prot",
                "ng_ndpa",
                "br_lgpd_transfer",
                "eu_data_act",
                "chile_pdp"
              ]
            },
            "dataCategory": {
              "type": "string",
              "enum": [
                "personal",
                "financial",
                "health",
                "critical_infrastructure",
                "government",
                "iot_sensor",
                "telecom_metadata",
                "biometric",
                "ai_training",
                "genomic",
                "child",
                "payment",
                "geospatial",
                "national_security"
              ]
            },
            "shutdownImpactVid": {
              "type": "string",
              "description": "bridges internetShutdown.flagEconomicImpact"
            },
            "enforcedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}