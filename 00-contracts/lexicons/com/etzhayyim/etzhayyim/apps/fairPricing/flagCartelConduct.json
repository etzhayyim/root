{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.fairPricing.flagCartelConduct",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Cartel / RPM / hub-and-spoke / algorithmic collusion (bridges antitrust-dma + misinformation-observatory + blockchain-mev)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "conductId",
            "monitorVid",
            "practiceKind",
            "detectedAt"
          ],
          "properties": {
            "conductId": {
              "type": "string"
            },
            "monitorVid": {
              "type": "string",
              "description": "bridges recordPriceMonitor"
            },
            "firmsInvolved": {
              "type": "integer"
            },
            "practiceKind": {
              "type": "string",
              "enum": [
                "price_fixing",
                "bid_rigging",
                "market_allocation",
                "rpm",
                "hub_spoke",
                "algorithmic",
                "tying",
                "refusal_to_deal"
              ]
            },
            "fineEur": {
              "type": "number"
            },
            "leniencyAppliedBy": {
              "type": "integer"
            },
            "detectedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "other",
                "vertical",
                "hardcore"
              ]
            }
          }
        }
      }
    }
  }
}