{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.forestryMrv.flagBaselineDrift",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Baseline drift / additionality / leakage concern (bridges nature-markets.flagDoubleClaim + cdr-verification + climate-value-chain)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "driftId",
            "projectVid",
            "concernKind",
            "reportedAt"
          ],
          "properties": {
            "driftId": {
              "type": "string"
            },
            "projectVid": {
              "type": "string",
              "description": "bridges registerForestProject"
            },
            "doubleClaimVid": {
              "type": "string",
              "description": "bridges nature-markets.flagDoubleClaim"
            },
            "concernKind": {
              "type": "string",
              "enum": [
                "baseline_manipulation",
                "no_additionality",
                "leakage",
                "permanence",
                "reversal_event",
                "monitoring_gap",
                "jurisdictional_mismatch"
              ]
            },
            "overcreditPct": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "moderate",
                "significant",
                "severe"
              ]
            }
          }
        }
      }
    }
  }
}