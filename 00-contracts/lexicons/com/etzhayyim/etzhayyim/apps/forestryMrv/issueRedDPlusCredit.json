{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.forestryMrv.issueRedDPlusCredit",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "REDD+ / JREDD / ART TREES jurisdictional credit (bridges climate-carbon-market + indigenous-rights + sovereign-debt)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "creditId",
            "jurisdictionIso3",
            "methodology",
            "tonnesCo2e",
            "vintage",
            "issuedAt"
          ],
          "properties": {
            "creditId": {
              "type": "string"
            },
            "measurementVid": {
              "type": "string",
              "description": "bridges recordCoverChange"
            },
            "jurisdictionIso3": {
              "type": "string"
            },
            "methodology": {
              "type": "string",
              "enum": [
                "art_trees",
                "jreddplus",
                "vm0048",
                "vm0007",
                "vcs_redd",
                "verra_redd"
              ]
            },
            "tonnesCo2e": {
              "type": "number"
            },
            "indigenousBenefitSharingPct": {
              "type": "number"
            },
            "vintage": {
              "type": "string"
            },
            "issuedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}