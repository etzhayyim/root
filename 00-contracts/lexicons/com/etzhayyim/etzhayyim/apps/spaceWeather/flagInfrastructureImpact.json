{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.spaceWeather.flagInfrastructureImpact",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Space-weather infrastructure impact (grid / comms / GNSS / aviation)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "impactId",
            "eventVid",
            "infraType",
            "reportedAt"
          ],
          "properties": {
            "impactId": {
              "type": "string"
            },
            "eventVid": {
              "type": "string",
              "description": "bridges reportGeomagneticStorm"
            },
            "infraType": {
              "type": "string",
              "enum": [
                "power_grid",
                "hf_comms",
                "gnss",
                "satellite",
                "pipeline",
                "aviation_polar",
                "rail_signal"
              ]
            },
            "regionIso3": {
              "type": "string"
            },
            "outageMinutes": {
              "type": "integer"
            },
            "cableFaultVid": {
              "type": "string",
              "description": "bridges open-telecom-infra flagCableFault"
            },
            "airproxVid": {
              "type": "string",
              "description": "bridges open-aviation-safety reportAirprox"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}