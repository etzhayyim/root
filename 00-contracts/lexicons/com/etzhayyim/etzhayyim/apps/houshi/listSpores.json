{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.houshi.listSpores",
  "defs": {
    "main": {
      "type": "query",
      "description": "List spores in custody by a custodian DID, or spores emitted by an origin agent. Excludes already-germinated spores by default.",
      "parameters": {
        "type": "params",
        "properties": {
          "custodianDid": { "type": "string", "description": "Filter by custodian DID" },
          "originAgentDid": { "type": "string", "description": "Filter by origin agent DID" },
          "includeGerminated": { "type": "boolean", "default": false },
          "offset": { "type": "integer", "default": 0 },
          "limit": { "type": "integer", "default": 50 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "spores": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "vertexId": { "type": "string" },
                  "originAgentDid": { "type": "string" },
                  "quorumN": { "type": "integer" },
                  "custodyCount": { "type": "integer" },
                  "germinatedAt": { "type": "string" },
                  "createdAt": { "type": "string" }
                }
              }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          },
          "required": ["spores", "total", "offset", "limit"]
        }
      }
    }
  }
}
