{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.smartGridCyber.flagOtIncident",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "OT / SCADA grid incident (bridges cyber-incident + telecom-infra + ai-governance)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "incidentId",
            "postureVid",
            "incidentKind",
            "reportedAt"
          ],
          "properties": {
            "incidentId": {
              "type": "string"
            },
            "postureVid": {
              "type": "string",
              "description": "bridges recordSecurityPosture"
            },
            "incidentKind": {
              "type": "string",
              "enum": [
                "ransomware",
                "wiper",
                "sabotage",
                "misconfiguration",
                "insider",
                "supply_chain",
                "physical",
                "nation_state_apt"
              ]
            },
            "affectedCustomers": {
              "type": "integer"
            },
            "durationHours": {
              "type": "number"
            },
            "attributionSuspected": {
              "type": "string"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "minor",
                "major",
                "severe",
                "critical"
              ]
            }
          }
        }
      }
    }
  }
}