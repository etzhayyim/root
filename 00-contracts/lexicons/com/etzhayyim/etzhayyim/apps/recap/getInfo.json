{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.recap.getInfo",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Fetch media metadata from a supported platform without downloading. Returns title, uploader, duration, available formats, etc.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["url"],
          "properties": {
            "url": {
              "type": "string",
              "description": "Source video URL"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "platform": { "type": "string" },
            "title": { "type": "string" },
            "uploader": { "type": "string" },
            "duration": { "type": "integer" },
            "thumbnail": { "type": "string" },
            "description": { "type": "string" },
            "uploadDate": { "type": "string" },
            "formats": {
              "type": "array",
              "items": { "type": "ref", "ref": "#format" }
            },
            "error": { "type": "string" }
          }
        }
      }
    },
    "format": {
      "type": "object",
      "properties": {
        "formatId": { "type": "string" },
        "ext": { "type": "string" },
        "note": { "type": "string" },
        "height": { "type": "integer" },
        "filesize": { "type": "integer" }
      }
    }
  }
}
