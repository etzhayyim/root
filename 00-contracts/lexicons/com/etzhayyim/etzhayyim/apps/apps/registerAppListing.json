{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.apps.registerAppListing",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register an app listing for apps.etzhayyim.com directory search and category navigation.",
      "input": { "encoding": "application/json", "schema": { "type": "object", "required": ["appDid", "name"], "properties": { "appDid": { "type": "string" }, "name": { "type": "string" }, "displayName": { "type": "string" }, "description": { "type": "string" }, "category": { "type": "string" }, "icon": { "type": "string" }, "embedUrl": { "type": "string" }, "capabilities": { "type": "array", "items": { "type": "string" } } } } },
      "output": { "encoding": "application/json", "schema": { "type": "object", "required": ["listingId", "status"], "properties": { "listingId": { "type": "string" }, "status": { "type": "string" } } } }
    }
  }
}
