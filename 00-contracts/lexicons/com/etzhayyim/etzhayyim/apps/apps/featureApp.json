{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.apps.featureApp",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Promote an app listing to a featured rail with operator approval metadata.",
      "input": { "encoding": "application/json", "schema": { "type": "object", "required": ["listingId"], "properties": { "listingId": { "type": "string" }, "rail": { "type": "string" }, "rank": { "type": "integer" }, "reason": { "type": "string" }, "approvedByDid": { "type": "string" } } } },
      "output": { "encoding": "application/json", "schema": { "type": "object", "required": ["featureId", "status"], "properties": { "featureId": { "type": "string" }, "status": { "type": "string" } } } }
    }
  }
}
