{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.apps.recordInstallIntent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record that a user clicked install/open for an app listing.",
      "input": { "encoding": "application/json", "schema": { "type": "object", "required": ["listingId"], "properties": { "listingId": { "type": "string" }, "userDid": { "type": "string" }, "source": { "type": "string" }, "client": { "type": "string" } } } },
      "output": { "encoding": "application/json", "schema": { "type": "object", "required": ["intentId", "status"], "properties": { "intentId": { "type": "string" }, "status": { "type": "string" } } } }
    }
  }
}
