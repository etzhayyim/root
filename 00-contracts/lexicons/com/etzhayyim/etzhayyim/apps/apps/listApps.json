{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.apps.listApps",
  "defs": {
    "main": {
      "type": "query",
      "description": "List apps.etzhayyim.com directory listings with optional category/search filters.",
      "parameters": { "type": "params", "properties": { "category": { "type": "string" }, "search": { "type": "string" }, "limit": { "type": "integer" }, "offset": { "type": "integer" } } },
      "output": { "encoding": "application/json", "schema": { "type": "object", "required": ["apps", "total", "limit", "offset"], "properties": { "apps": { "type": "array", "items": { "type": "object" } }, "total": { "type": "integer" }, "limit": { "type": "integer" }, "offset": { "type": "integer" } } } }
    }
  }
}
