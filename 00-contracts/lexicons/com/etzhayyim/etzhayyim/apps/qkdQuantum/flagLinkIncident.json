{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.qkdQuantum.flagLinkIncident",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "QKD link incident (side-channel / interception / hardware — bridges cyber-incident + quantum-safe-crypto + space-weather)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "incidentId",
            "linkVid",
            "incidentKind",
            "reportedAt"
          ],
          "properties": {
            "incidentId": {
              "type": "string"
            },
            "linkVid": {
              "type": "string",
              "description": "bridges registerLink"
            },
            "incidentKind": {
              "type": "string",
              "enum": [
                "side_channel",
                "photon_number_splitting",
                "trojan_horse",
                "detector_blinding",
                "hardware_failure",
                "geomagnetic_storm",
                "polarization_drift"
              ]
            },
            "keyBatchCompromised": {
              "type": "boolean"
            },
            "spaceWxEventVid": {
              "type": "string",
              "description": "bridges open-space-weather"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}