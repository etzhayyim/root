{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.oshinobi.getPost",
  "defs": {
    "main": {
      "type": "query",
      "description": "Fetch a post. Server checks entitlement (vertex_oshinobi_subscription active + tierRequired match, OR PPV receipt). Unauthorized callers receive teaser only; body + mediaCids are stripped.",
      "parameters": {
        "type": "params",
        "required": ["postUri"],
        "properties": {
          "postUri": { "type": "string", "format": "at-uri" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["postId", "creatorDid", "contentLabel", "entitled"],
          "properties": {
            "postId":        { "type": "string" },
            "creatorDid":    { "type": "string", "format": "did" },
            "tierRequired":  { "type": "string" },
            "contentLabel":  { "type": "string" },
            "title":         { "type": "string" },
            "teaser":        { "type": "string" },
            "body":          { "type": "string", "description": "Present only when entitled=true" },
            "mediaCids":     { "type": "array", "items": { "type": "string" } },
            "publishedAt":   { "type": "string", "format": "datetime" },
            "entitled":      { "type": "boolean" },
            "priceUsdCents": { "type": "integer" }
          }
        }
      },
      "errors": [
        { "name": "PostNotFound", "description": "postUri does not resolve" },
        { "name": "AgeGateBlock", "description": "contentLabel=adult and caller age-verification missing" }
      ]
    }
  }
}
