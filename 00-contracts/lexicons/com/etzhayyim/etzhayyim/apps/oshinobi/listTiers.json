{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.oshinobi.listTiers",
  "defs": {
    "main": {
      "type": "query",
      "description": "List all active tiers for a creator.",
      "parameters": {
        "type": "params",
        "required": ["creatorDid"],
        "properties": {
          "creatorDid": { "type": "string", "format": "did" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["tiers"],
          "properties": {
            "tiers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["tierId", "name", "priceUsdCents", "billingPeriod"],
                "properties": {
                  "tierId":         { "type": "string" },
                  "name":           { "type": "string" },
                  "description":    { "type": "string" },
                  "priceUsdCents":  { "type": "integer" },
                  "billingPeriod":  { "type": "string" },
                  "benefits":       { "type": "array", "items": { "type": "string" } },
                  "status":         { "type": "string", "enum": ["active", "archived"] }
                }
              }
            }
          }
        }
      }
    }
  }
}
