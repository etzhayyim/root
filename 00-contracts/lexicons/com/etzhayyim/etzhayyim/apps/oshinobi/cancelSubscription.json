{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.oshinobi.cancelSubscription",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Cancel an active subscription. Entitlement remains valid until periodEnd; no prorated refund at this layer (processor handles refund policy). Sets status=cancelled and disables auto-renew.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["subscriptionId"],
          "properties": {
            "subscriptionId": { "type": "string" },
            "reason":         { "type": "string", "maxLength": 500 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["subscriptionId", "status", "accessUntil"],
          "properties": {
            "subscriptionId": { "type": "string" },
            "status":         { "type": "string", "enum": ["cancelled"] },
            "accessUntil":    { "type": "string", "format": "datetime" }
          }
        }
      },
      "errors": [
        { "name": "NotSubscriber",      "description": "caller DID does not own this subscription" },
        { "name": "SubscriptionNotFound", "description": "no subscription with that id" }
      ]
    }
  }
}
