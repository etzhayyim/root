{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.metaOversightBoard.recordRuling",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Meta Oversight Board ruling / policy advisory (bridges contentModerationAppeal.flagOutcomeAsymmetry + dsa-vlop + dpa-authority)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "rulingId",
            "caseCategory",
            "rulingKind",
            "ruledAt"
          ],
          "properties": {
            "rulingId": {
              "type": "string"
            },
            "caseCategory": {
              "type": "string",
              "enum": [
                "public_figure",
                "misinformation",
                "csam",
                "violence_glorify",
                "hate_speech",
                "terrorism",
                "political_ad",
                "election_manipulation",
                "historical_image",
                "gender",
                "minor_protect",
                "platform_advertising"
              ]
            },
            "rulingKind": {
              "type": "string",
              "enum": [
                "overturn",
                "uphold",
                "partial",
                "standard_clarification",
                "policy_advisory",
                "reinstate",
                "remove",
                "metricize_appeal",
                "systemic_recommendation",
                "summary_decision",
                "standard_iss"
              ]
            },
            "outcomeAsymmetryVid": {
              "type": "string",
              "description": "bridges contentModerationAppeal.flagOutcomeAsymmetry"
            },
            "ruledAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}