{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yata.bmcAddHypothesis",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Insert a new hypothesis (status defaults to pending). Slug must be unique per org. threshold/baseline are decimal strings.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["slug", "block", "statement", "metric", "metricQuery", "threshold", "baseline", "deadlineIso", "minSample"],
          "properties": {
            "slug":           {"type": "string", "maxLength": 256, "description": "stable id, e.g. H1-mcp-cursor-listing"},
            "block":          {"type": "string", "knownValues": ["customerSegments", "valuePropositions", "channels", "customerRelationships", "revenueStreams", "keyResources", "keyActivities", "keyPartnerships", "costStructure"]},
            "statement":      {"type": "string", "maxLength": 1024},
            "metric":         {"type": "string", "maxLength": 256},
            "metricQuery":    {"type": "string", "maxLength": 4096, "description": "sql:<dispatcher>:<args> | external:stripe:<filter> | external:plausible:<args>"},
            "threshold":      {"type": "string", "description": "decimal string"},
            "baseline":       {"type": "string", "description": "decimal string"},
            "deadlineIso":    {"type": "string", "format": "datetime"},
            "minSample":      {"type": "integer", "minimum": 0},
            "authoredBy":     {"type": "string", "maxLength": 256},
            "autoApplyPivot": {"type": "boolean", "default": false}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "vertexId"],
          "properties": {
            "ok":       {"type": "boolean"},
            "vertexId": {"type": "string"},
            "error":    {"type": "string"}
          }
        }
      }
    }
  }
}
