{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yata.presignUrl",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Mint a time-limited HTTPS URL for direct GET / PUT against B2 / Vultr OS, signed by yatabase using the platform-side credentials. Caller never sees the upstream provider key. URL is intended to be handed to a browser / non-yatabase client.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["bucketName", "objectKey", "method"],
          "properties": {
            "bucketName": {"type": "string"},
            "objectKey": {"type": "string"},
            "method": {"type": "string", "enum": ["GET", "PUT", "HEAD"]},
            "expiresInSec": {"type": "integer", "minimum": 60, "maximum": 604800, "default": 3600},
            "contentType": {"type": "string", "description": "For PUT — locks the Content-Type that the eventual upload must declare."},
            "responseContentDisposition": {"type": "string"}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["url", "expiresAt", "method"],
          "properties": {
            "url": {"type": "string"},
            "expiresAt": {"type": "string", "format": "datetime"},
            "method": {"type": "string"},
            "headers": {"type": "string", "description": "JSON object of additional headers the client must send (e.g. x-amz-content-sha256)."}
          }
        }
      }
    }
  }
}
