{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yata.bmcIterate",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Fire one BMC iteration cycle on demand. Runs the bmc_iteration LangGraph inside the lg-yatabase pod (LangGraph Server + Granian). The cron schedule `0 7 * * *` invokes the same graph automatically. Use this endpoint after adding/activating a hypothesis to skip the wait.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "hypothesisSlug": {"type": "string", "description": "Optional override — force this hypothesis instead of the round-robin pick."},
            "dryRun":         {"type": "boolean", "default": false, "description": "Run measurement + decide but skip the iteration/decision row insert."}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "firedAt"],
          "properties": {
            "ok":       {"type": "boolean"},
            "threadId": {"type": "string", "description": "LangGraph thread id (lg_yatabase_checkpoint key)."},
            "firedAt":  {"type": "string", "format": "datetime"},
            "picked":   {"type": "ref", "ref": "#pickedHypothesis"},
            "measurement": {"type": "ref", "ref": "#measurement"},
            "evaluation":  {"type": "ref", "ref": "#evaluation"},
            "decision":    {"type": "ref", "ref": "#decision"},
            "iterationVertexId": {"type": "string"},
            "decisionVertexId":  {"type": "string"},
            "notes":    {"type": "string"},
            "error":    {"type": "string"}
          }
        }
      }
    },
    "pickedHypothesis": {
      "type": "object",
      "required": ["slug", "block", "iterationNo", "threshold"],
      "properties": {
        "slug":        {"type": "string"},
        "block":       {"type": "string"},
        "iterationNo": {"type": "integer"},
        "threshold":   {"type": "string", "description": "decimal string"}
      }
    },
    "measurement": {
      "type": "object",
      "required": ["value", "sample", "source"],
      "properties": {
        "value":  {"type": "string", "description": "decimal string"},
        "sample": {"type": "integer"},
        "source": {"type": "string"},
        "error":  {"type": "string"}
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["passed", "deadlineReached", "minSampleReached"],
      "properties": {
        "passed":           {"type": "boolean"},
        "deadlineReached":  {"type": "boolean"},
        "minSampleReached": {"type": "boolean"}
      }
    },
    "decision": {
      "type": "object",
      "required": ["action", "rationale", "authoredBy"],
      "properties": {
        "action":     {"type": "string", "knownValues": ["persevere", "pivot", "kill", "extend"]},
        "rationale":  {"type": "string"},
        "authoredBy": {"type": "string"},
        "proposedBlockEdits": {
          "type": "object",
          "properties": {
            "block":        {"type": "string"},
            "addBullets":   {"type": "array", "items": {"type": "string"}},
            "removeBullets":{"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  }
}
