{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yata.listObjects",
  "defs": {
    "main": {
      "type": "query",
      "description": "List objects in a bucket. Supports prefix filter + cursor pagination. Mirrors S3 ListObjectsV2.",
      "parameters": {
        "type": "params",
        "required": ["bucketName"],
        "properties": {
          "bucketName": {"type": "string"},
          "prefix": {"type": "string"},
          "delimiter": {"type": "string", "description": "Use '/' for directory-style listing."},
          "limit": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 100},
          "cursor": {"type": "string"}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["bucketName", "objects"],
          "properties": {
            "bucketName": {"type": "string"},
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["objectKey", "sizeBytes", "etag", "createdAt"],
                "properties": {
                  "objectKey": {"type": "string"},
                  "blobId": {"type": "string"},
                  "versionId": {"type": "string"},
                  "sizeBytes": {"type": "integer"},
                  "etag": {"type": "string"},
                  "contentType": {"type": "string"},
                  "storageTier": {"type": "string"},
                  "createdAt": {"type": "string", "format": "datetime"}
                }
              }
            },
            "commonPrefixes": {"type": "array", "items": {"type": "string"}, "description": "When delimiter is set."},
            "nextCursor": {"type": "string"}
          }
        }
      }
    }
  }
}
