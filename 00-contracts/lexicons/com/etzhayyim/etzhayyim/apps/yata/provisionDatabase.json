{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yata.provisionDatabase",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Provision a per-tenant RisingWave database for the caller's org_did. Creates `yata_<sha256(did)[:16]>` database + dedicated PG ROLE + applies storage schema migration inside the new DB. Idempotent. Caller MUST be `did:web:billing.etzhayyim.com` admin or an authorized provisioning agent.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["orgDid", "plan"],
          "properties": {
            "orgDid": {"type": "string"},
            "plan": {"type": "string", "enum": ["free", "starter", "developer", "team", "business", "enterprise"]},
            "region": {"type": "string", "default": "lax-01"},
            "force": {"type": "boolean", "default": false, "description": "Re-provision even if a database exists for this org."}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "dbName", "endpointUrl"],
          "properties": {
            "ok": {"type": "boolean"},
            "dbName": {"type": "string"},
            "endpointUrl": {"type": "string", "description": "Example shape (placeholders only): postgresql://<dbUser>:<dbPassword>@<dbHost>:5432/<dbName>?sslmode=require"},
            "pgUser": {"type": "string"},
            "pgPasswordOnce": {"type": "string", "description": "Raw PG password — returned ONCE, never persisted in plaintext."},
            "alreadyExisted": {"type": "boolean"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
