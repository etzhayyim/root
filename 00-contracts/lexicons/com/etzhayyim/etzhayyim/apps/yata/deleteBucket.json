{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yata.deleteBucket",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Delete a bucket. Bucket MUST be empty (no active blobs); pass `force=true` to cascade-delete all blobs first. Bytes in B2 / Vultr Object Storage are reaped asynchronously by `yata.storage.bucket.reap` BPMN.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["bucketName"],
          "properties": {
            "bucketName": {"type": "string"},
            "force": {"type": "boolean", "default": false, "description": "If true, also delete all blobs in this bucket."}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": {"type": "boolean"},
            "blobsScheduledForReap": {"type": "integer"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
