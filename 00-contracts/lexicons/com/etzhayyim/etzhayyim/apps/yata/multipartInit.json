{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yata.multipartInit",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Initiate a multipart upload. Returns `uploadId` for use with subsequent multipartPart / multipartComplete / multipartAbort calls. State is tracked in vertex_yata_multipart with TTL 24h.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["bucketName", "objectKey"],
          "properties": {
            "bucketName": {"type": "string"},
            "objectKey": {"type": "string"},
            "contentType": {"type": "string", "default": "application/octet-stream"},
            "encryption": {"type": "string"}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uploadId", "expiresAt"],
          "properties": {
            "uploadId": {"type": "string"},
            "expiresAt": {"type": "string", "format": "datetime"}
          }
        }
      }
    }
  }
}
