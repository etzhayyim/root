{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yata.bmcSetHypothesisStatus",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Append a status transition to vertex_bmc_hypothesis_event. UPDATE-free — current status is read from mv_bmc_hypothesis_status (DISTINCT ON latest event).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["slug", "nextStatus"],
          "properties": {
            "slug":              {"type": "string"},
            "nextStatus":        {"type": "string", "knownValues": ["pending", "active", "completed", "killed"]},
            "reason":            {"type": "string", "maxLength": 1024},
            "iterationVertexId": {"type": "string", "description": "Optional — link the transition to the iteration that triggered it."},
            "authoredBy":        {"type": "string", "maxLength": 256}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "vertexId"],
          "properties": {
            "ok":       {"type": "boolean"},
            "vertexId": {"type": "string", "description": "Event row vertex_id (bmc:hyp_evt:{slug}:{ulid})."},
            "error":    {"type": "string"}
          }
        }
      }
    }
  }
}
