{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.yata.deleteObject",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Delete an object. If versioning is enabled, inserts a delete marker and keeps prior versions. If versioning is disabled, marks status='deleted' and schedules byte reap. Set `purge=true` to also delete from B2 / Vultr OS immediately (irreversible).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["bucketName", "objectKey"],
          "properties": {
            "bucketName": {"type": "string"},
            "objectKey": {"type": "string"},
            "versionId": {"type": "string", "description": "When versioning is on, target a specific version."},
            "purge": {"type": "boolean", "default": false, "description": "Skip versioning + reap bytes immediately."}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": {"type": "boolean"},
            "deleteMarkerVersionId": {"type": "string"},
            "purged": {"type": "boolean"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
