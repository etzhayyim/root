{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ethicsDisclosure.flagDisclosureGap",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Missing disclosure / recusal failure / spouse loophole (bridges judicialInfluence.flagConflictOfInterest + enforcement-action + civil-liability)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "filingVid",
            "gapKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "filingVid": {
              "type": "string",
              "description": "bridges recordFiling"
            },
            "gapKind": {
              "type": "string",
              "enum": [
                "missing_gift",
                "missing_travel",
                "missing_property",
                "spouse_loophole",
                "blind_trust_fake",
                "recusal_failure",
                "post_employment",
                "shadow_advisor",
                "consulting_side",
                "opaque_foundation",
                "incomplete_amendment"
              ]
            },
            "undeclaredValueUsd": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}