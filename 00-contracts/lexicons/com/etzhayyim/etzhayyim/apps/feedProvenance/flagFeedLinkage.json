{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.feedProvenance.flagFeedLinkage",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Feed-to-deforestation / illegal fishing linkage (bridges aquacultureCert.flagCertificationRisk + eudr-deforestation + fisheries-iuu)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "linkageId",
            "lotVid",
            "linkageKind",
            "reportedAt"
          ],
          "properties": {
            "linkageId": {
              "type": "string"
            },
            "lotVid": {
              "type": "string",
              "description": "bridges recordFeedLot"
            },
            "linkageKind": {
              "type": "string",
              "enum": [
                "amazon_deforestation",
                "cerrado_clearance",
                "indonesian_peatland",
                "west_african_iuu",
                "antarctic_krill_overfish",
                "soy_moratorium_breach",
                "labor_rights_breach",
                "dolphin_bycatch"
              ]
            },
            "affectedHectares": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}