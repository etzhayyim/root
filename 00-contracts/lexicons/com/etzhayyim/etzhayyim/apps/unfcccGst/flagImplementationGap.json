{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.unfcccGst.flagImplementationGap",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "GST implementation gap (bridges climate-adaptation-finance + ocha-funding + migrant-worker-welfare)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "gapId",
            "reportVid",
            "gapCategory",
            "reportedAt"
          ],
          "properties": {
            "gapId": {
              "type": "string"
            },
            "reportVid": {
              "type": "string",
              "description": "bridges recordNdcProgress"
            },
            "gapCategory": {
              "type": "string",
              "enum": [
                "finance",
                "technology_transfer",
                "capacity_building",
                "adaptation",
                "loss_damage",
                "just_transition",
                "carbon_markets"
              ]
            },
            "requiredActionsDescription": {
              "type": "string"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}