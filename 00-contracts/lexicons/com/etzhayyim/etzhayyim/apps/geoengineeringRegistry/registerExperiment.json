{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.geoengineeringRegistry.registerExperiment",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Geoengineering experiment registry (CDR + SRM — bridges climate-carbon-market + water-scarcity + biodiversity-gbf)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "experimentId",
            "technologyClass",
            "locationIso3",
            "startedAt"
          ],
          "properties": {
            "experimentId": {
              "type": "string"
            },
            "operatorLei": {
              "type": "string"
            },
            "technologyClass": {
              "type": "string",
              "enum": [
                "SAI",
                "MCB",
                "CCT",
                "OAF",
                "DAC",
                "BECCS",
                "ERW",
                "OIF",
                "SAH",
                "biochar",
                "afforestation"
              ]
            },
            "locationIso3": {
              "type": "string"
            },
            "locationLat": {
              "type": "number"
            },
            "locationLon": {
              "type": "number"
            },
            "scaleTier": {
              "type": "string",
              "enum": [
                "lab",
                "field_small",
                "field_medium",
                "field_large",
                "commercial"
              ]
            },
            "expectedCo2eTonnes": {
              "type": "number"
            },
            "startedAt": {
              "type": "string",
              "format": "datetime"
            },
            "endsAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "riskTier": {
              "type": "string",
              "enum": [
                "local",
                "regional",
                "planetary"
              ]
            }
          }
        }
      }
    }
  }
}