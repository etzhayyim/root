{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.outreach.createSequence",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Start a personalized outreach sequence for a prospect. Triggers LangGraph research→draft→quality_gate loop via POD-side LangServer BPMN.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["prospectId", "sequenceName", "goal"],
          "properties": {
            "prospectId": { "type": "string", "description": "vertex_outreach_prospect vertex_id" },
            "sequenceName": { "type": "string", "maxLength": 200 },
            "goal": { "type": "string", "maxLength": 500, "description": "Outreach goal (e.g. intro call, demo, partnership)" },
            "maxSteps": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 },
            "includeSponsorSlot": { "type": "boolean", "default": false }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sequenceId", "status"],
          "properties": {
            "sequenceId": { "type": "string" },
            "status": { "type": "string" }
          }
        }
      }
    }
  }
}
