{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.esmaConvergence.flagDivergence",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Member-state divergence / gold-plating / race-to-bottom (bridges micaLicense.flagPassportAbuse + dpa-authority + cross-border-transfer)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "reviewVid",
            "divergenceKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "reviewVid": {
              "type": "string",
              "description": "bridges recordReview"
            },
            "divergenceKind": {
              "type": "string",
              "enum": [
                "gold_plating",
                "race_to_bottom",
                "carve_out_exploit",
                "regulator_shopping",
                "approval_speed_wars",
                "enforcement_intensity",
                "fee_reduction",
                "sandbox_gap",
                "lex_fori",
                "private_enforcement_gap"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}