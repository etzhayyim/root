{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.bilateralInvestmentTreaty.flagSurvivalClause",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Survival / sunset clause stress (bridges mineralRoyalty.flagInvestorClaim + sovereign-debt + civil-liability)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "entryVid",
            "issueKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "entryVid": {
              "type": "string",
              "description": "bridges recordEntry"
            },
            "issueKind": {
              "type": "string",
              "enum": [
                "sunset_15yr",
                "sunset_20yr",
                "staggered_protection",
                "retroactive_carveout",
                "termination_dispute_pre_existing",
                "survival_only_specific",
                "interpretation_dispute",
                "grandfathering",
                "scope_drift",
                "most_favored_nation_drag"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}