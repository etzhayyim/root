{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.bluesky.searchActors",
  "defs": {
    "main": {
      "type": "query",
      "description": "Bluesky handle / DID による actor 検索。opt-out 済 DID は除外。",
      "parameters": {
        "type": "params",
        "properties": {
          "handle": { "type": "string" },
          "did": { "type": "string" },
          "q": { "type": "string", "description": "displayName / description 部分一致 (IVF vector)" },
          "limit": { "type": "integer", "default": 25, "maximum": 100 }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "actors": {
              "type": "array",
              "items": { "type": "unknown" }
            }
          },
          "required": ["actors"]
        }
      }
    }
  }
}
