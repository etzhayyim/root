{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.bluesky.refreshStalest",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Refresh the stalest tracked Bluesky actors via LangServer. Timer-started every 30 minutes; also manually triggerable.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "batchSize": { "type": "integer", "default": 10, "maximum": 100 },
            "appview": { "type": "string", "default": "https://public.api.bsky.app" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "actorsRead": { "type": "integer" },
            "ingested": { "type": "integer" },
            "tombstoned": { "type": "integer" },
            "errorCount": { "type": "integer" }
          }
        }
      }
    }
  }
}
