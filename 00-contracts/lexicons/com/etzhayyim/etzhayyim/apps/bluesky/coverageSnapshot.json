{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.bluesky.coverageSnapshot",
  "description": "6 時間ごとの actor coverage スナップショット。ingestRate / optOutCount / purgeCount を KPI として記録。",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["nodeCount", "latestTs"],
        "properties": {
          "nodeCount": { "type": "integer" },
          "latestTs": { "type": "string" },
          "optOutCount": { "type": "integer" },
          "purgeCount24h": { "type": "integer" },
          "bucket": { "type": "string", "default": "6h" }
        }
      }
    }
  }
}
