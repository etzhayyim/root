{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openSaas.registerProduct",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a SaaS product in the catalog. FEEL risk_score: high (no SOC2/ISO27001, sanctioned-country vendor, or non-EU-US residency for EU data), medium (partial certs), low (full certs + EU/US residency). Starts BPMN open_saas_register_product.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["productName","vendorDid","category","registeredAt"],
          "properties": {
            "productName":    { "type": "string" },
            "vendorDid":      { "type": "string" },
            "vendorCountry":  { "type": "string", "description": "ISO 3166-1 alpha-3" },
            "homepage":       { "type": "string" },
            "category":       { "type": "string", "description": "e.g. crm / erp / analytics / storage" },
            "pricingTier":    { "type": "string" },
            "dataResidency":  { "type": "string", "description": "EU / US / APAC / global" },
            "soc2":           { "type": "boolean" },
            "iso27001":       { "type": "boolean" },
            "gdprCompliant":  { "type": "boolean" },
            "registeredAt":   { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
            "riskScore": { "type": "string", "enum": ["low","medium","high"] },
            "requireSecurityReview": { "type": "boolean" },
            "instanceKey": { "type": "integer" }, "error": { "type": "string" }
          }
        }
      }
    }
  }
}
