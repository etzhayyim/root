{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.opensaas.salesforce.convertLead",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Atomically convert a Lead into (Account, Contact, Opportunity). Replicates Salesforce 'Convert Lead' semantics. Writes all three records in one PDS commit pipeline transaction and updates the original Lead with status=converted plus converted*Did back-references. The PDS derive rule emits a derived com.etzhayyim.apps.opensaas.salesforce.activity record with kind=conversion.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["leadUri"],
          "properties": {
            "leadUri": { "type": "string" },
            "accountName": { "type": "string", "maxLength": 255, "description": "if omitted, companyLabel from the lead is used" },
            "existingAccountDid": { "type": "string", "description": "attach to an existing account instead of creating a new one" },
            "createOpportunity": { "type": "boolean", "default": true },
            "opportunityName": { "type": "string", "maxLength": 255 },
            "opportunityAmountJpy": { "type": "integer", "minimum": 0 },
            "opportunityCloseDate": { "type": "string", "format": "datetime" },
            "opportunityStage": { "type": "string", "enum": ["prospecting", "qualification", "needs-analysis", "proposal", "negotiation"], "default": "qualification" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["accountUri", "contactUri"],
          "properties": {
            "accountUri": { "type": "string" },
            "contactUri": { "type": "string" },
            "opportunityUri": { "type": "string" },
            "activityUri": { "type": "string", "description": "AT URI of the derived conversion activity record" }
          }
        }
      },
      "errors": [
        { "name": "LeadNotFound" },
        { "name": "LeadAlreadyConverted" },
        { "name": "TenantMismatch" }
      ]
    }
  }
}
