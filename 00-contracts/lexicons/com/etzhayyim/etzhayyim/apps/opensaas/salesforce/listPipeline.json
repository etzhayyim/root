{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.opensaas.salesforce.listPipeline",
  "defs": {
    "main": {
      "type": "query",
      "description": "List pipeline opportunities for a tenant, grouped by stage with forecast amounts. Backed by a RisingWave streaming MV (mv_opensaas_salesforce_pipeline_by_stage) so read latency is <100ms even at tenant scale.",
      "parameters": {
        "type": "params",
        "required": ["tenantDid"],
        "properties": {
          "tenantDid": { "type": "string" },
          "ownerDid": { "type": "string", "description": "filter by opportunity owner" },
          "stage": { "type": "string", "enum": ["prospecting", "qualification", "needs-analysis", "proposal", "negotiation", "closed-won", "closed-lost"] },
          "forecastCategory": { "type": "string", "enum": ["pipeline", "best-case", "commit", "closed", "omitted"] },
          "closeDateFrom": { "type": "string", "format": "datetime" },
          "closeDateTo": { "type": "string", "format": "datetime" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
          "offset": { "type": "integer", "minimum": 0, "default": 0 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items", "total", "offset", "limit", "stageRollup"],
          "properties": {
            "items": { "type": "array", "items": { "type": "ref", "ref": "#pipelineItem" } },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" },
            "stageRollup": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["stage", "count", "amountJpy", "weightedAmountJpy"],
                "properties": {
                  "stage": { "type": "string" },
                  "count": { "type": "integer" },
                  "amountJpy": { "type": "integer" },
                  "weightedAmountJpy": { "type": "integer", "description": "sum of amountJpy * probability/100" }
                }
              }
            }
          }
        }
      }
    },
    "pipelineItem": {
      "type": "object",
      "required": ["uri", "name", "stage", "closeDate"],
      "properties": {
        "uri": { "type": "string" },
        "accountDid": { "type": "string" },
        "accountName": { "type": "string" },
        "ownerDid": { "type": "string" },
        "name": { "type": "string" },
        "stage": { "type": "string" },
        "probability": { "type": "integer" },
        "amountJpy": { "type": "integer" },
        "amountBand": { "type": "string" },
        "forecastCategory": { "type": "string" },
        "closeDate": { "type": "string", "format": "datetime" },
        "lastStageChangeAt": { "type": "string", "format": "datetime" }
      }
    }
  }
}
