{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.cloudflareBrowserRender.dispatchOp",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Dispatch a Playwright-compatible op (goto/fill/click/scrape/...) to a DO-held session. Arg shape mirrors the corresponding com.etzhayyim.apps.playwright method.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sessionId", "op"],
          "properties": {
            "sessionId": { "type": "string" },
            "op": { "type": "string" },
            "args": { "type": "unknown" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "result": { "type": "unknown" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
