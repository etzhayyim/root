{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.cloudflareBrowserRender.renderPage",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "One-shot render a URL to HTML / PNG / PDF. Stateless (no session).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["url"],
          "properties": {
            "url": { "type": "string" },
            "output": { "type": "string", "enum": ["html", "png", "pdf"], "default": "html" },
            "waitUntil": { "type": "string", "enum": ["load", "domcontentloaded", "networkidle"], "default": "networkidle" },
            "fullPage": { "type": "boolean", "default": false }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "artifactCid": { "type": "string" },
            "artifactId": { "type": "string" },
            "byteSize": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
