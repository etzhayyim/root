{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.justTransition.recordSectoralShift",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Just transition sectoral workforce shift (bridges climate-adaptation-finance + refugee-unhcr + forced-labor)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "shiftId",
            "regionIso3",
            "fromSectorIsic",
            "workersAffected",
            "geographicScope",
            "driver",
            "recordedAt"
          ],
          "properties": {
            "shiftId": {
              "type": "string"
            },
            "regionIso3": {
              "type": "string"
            },
            "fromSectorIsic": {
              "type": "string",
              "description": "bridges open-isic"
            },
            "toSectorIsic": {
              "type": "string"
            },
            "workersAffected": {
              "type": "integer"
            },
            "reskillingSpendUsd": {
              "type": "number"
            },
            "geographicScope": {
              "type": "string",
              "enum": [
                "local",
                "regional",
                "national"
              ]
            },
            "driver": {
              "type": "string",
              "enum": [
                "coal_phaseout",
                "ice_ban",
                "fishing_quota",
                "automation",
                "decarbonization",
                "trade_policy"
              ]
            },
            "recordedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}