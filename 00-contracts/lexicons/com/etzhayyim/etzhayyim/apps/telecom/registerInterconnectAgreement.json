{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.registerInterconnectAgreement",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register an interconnect / wholesale agreement with a peer carrier (MNO / MVNO). Phase 3 telecom Supplier/Partner domain.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["peerOrgId", "peerKind", "jurisdiction", "settlementCurrency", "validFrom", "validUntil"],
          "properties": {
            "agreementId": { "type": "string" },
            "peerOrgId": { "type": "string" },
            "peerKind": { "type": "string", "enum": ["mno", "mvno", "fixed", "isp", "transit"] },
            "jurisdiction": { "type": "string" },
            "settlementCurrency": { "type": "string" },
            "rateCardRef": { "type": "string" },
            "validFrom": { "type": "string", "format": "date" },
            "validUntil": { "type": "string", "format": "date" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "agreementId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
