{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.deployXapp",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "O-RAN Near-RT RIC — deploy an xApp (near-RT RIC application). Lists supported RAN functions + bound E2 nodes.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["nearRtRicId", "vendor", "name", "version", "packageHash", "observedAt"],
          "properties": {
            "xappId": { "type": "string" },
            "nearRtRicId": { "type": "string" },
            "vendor": { "type": "string" },
            "name": { "type": "string" },
            "version": { "type": "string" },
            "useCases": { "type": "array", "items": { "type": "string" } },
            "e2NodeIds": { "type": "array", "items": { "type": "string" } },
            "supportedRanFunctions": { "type": "array", "items": { "type": "string" } },
            "packageHash": { "type": "string" },
            "packageRef": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "xappId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
