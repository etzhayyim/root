{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.deliverInterceptContent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "DF3 (X3) — deliver Communication Content (CC) to LEMF. Only delivery metadata + payload hash + encryption pointer persisted in graph; the CC payload itself goes directly DF3 → LEMF (audit-only graph).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["targetId", "contentKind", "x3Sequence", "df3NfId", "lemfId", "payloadHash", "observedAt"],
          "properties": {
            "ccId": { "type": "string" },
            "targetId": { "type": "string" },
            "contentKind": { "type": "string", "enum": ["voice_rtp", "data_pdu", "sms_payload", "ims_media", "video_rtp"] },
            "x3Sequence": { "type": "integer" },
            "df3NfId": { "type": "string" },
            "lemfId": { "type": "string" },
            "payloadHash": { "type": "string" },
            "payloadSize": { "type": "integer" },
            "encryptionRef": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "ccId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
