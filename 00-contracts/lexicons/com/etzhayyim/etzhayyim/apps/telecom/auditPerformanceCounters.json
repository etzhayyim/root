{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.auditPerformanceCounters",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Persist a TMF671 performance counter sample (RRC drop / DL throughput / handover / CQI). Designed to be invoked from a timer-start BPMN (R/PT15M).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["nodeId", "metric", "value", "sampledAt"],
          "properties": {
            "sampleId": { "type": "string" },
            "nodeId": { "type": "string" },
            "metric": { "type": "string" },
            "value": { "type": "number" },
            "unit": { "type": "string" },
            "sampledAt": { "type": "string", "format": "datetime" },
            "slaThreshold": { "type": "number" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "sampleId": { "type": "string" }, "breach": { "type": "boolean" },
          "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
