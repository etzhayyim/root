{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.snapshotConfiguration",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "OSS NMS — capture a configuration snapshot of a scope (NF instance, RAN node, transport device). Compares configHash against baselineSnapshotId to detect drift; raw config body persisted only via vault:// configRef.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["scopeKind", "scopeVid", "sourceSystem", "configHash", "observedAt"],
          "properties": {
            "snapshotId": { "type": "string" },
            "scopeKind": { "type": "string", "enum": ["cellSite", "ranNode", "nfInstance", "networkAsset", "transport"] },
            "scopeVid": { "type": "string" },
            "sourceSystem": { "type": "string" },
            "configHash": { "type": "string" },
            "configRef": { "type": "string" },
            "configSize": { "type": "integer" },
            "baselineSnapshotId": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "snapshotId": { "type": "string" },
          "drift": { "type": "boolean" },
          "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
