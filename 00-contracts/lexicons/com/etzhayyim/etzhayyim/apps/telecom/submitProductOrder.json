{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.submitProductOrder",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Submit a product order via TMF622 Product Ordering Management API. Creates a vertex_telecom_tmf_product_order record.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["productOrderId", "accountId", "orderKind"],
          "properties": {
            "productOrderId": { "type": "string" },
            "accountId": { "type": "string" },
            "orderKind": { "type": "string", "enum": ["add", "modify", "suspend", "resume", "terminate"] },
            "offeringId": { "type": "string" },
            "productId": { "type": "string" },
            "orderItemHash": { "type": "string" },
            "orderItemRef": { "type": "string" },
            "requestedStartAt": { "type": "string", "format": "datetime" },
            "requestedCompletionAt": { "type": "string", "format": "datetime" },
            "priority": { "type": "integer" },
            "channelId": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" },
            "callerDid": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "productOrderId": { "type": "string" },
            "status": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
