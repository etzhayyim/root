{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.provisionService",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Provision a telecom service instance (voice/data/SMS/IoT) with QoS profile + APN.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["subscriberId", "serviceType", "planId"],
          "properties": {
            "subscriberId": { "type": "string" },
            "simId": { "type": "string" },
            "serviceType": { "type": "string", "enum": ["voice", "sms", "data", "iot", "fixed_line", "fiber"] },
            "planId": { "type": "string" },
            "qosProfile": { "type": "string" },
            "apn": { "type": "string" },
            "asOf": { "type": "string", "format": "date" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "serviceId": { "type": "string" },
            "status": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
