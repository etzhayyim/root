{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.registerRanNode",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a RAN node (gNB / eNB / DU / CU) bound to a cell site and a spectrum license.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["siteId", "nodeType", "generation"],
          "properties": {
            "nodeId": { "type": "string" },
            "siteId": { "type": "string" },
            "nodeType": { "type": "string", "enum": ["gnb", "enb", "du", "cu", "small_cell", "base_station"] },
            "generation": { "type": "string", "enum": ["2g", "3g", "4g", "5g", "5g_sa"] },
            "vendor": { "type": "string" },
            "model": { "type": "string" },
            "spectrumLicenseId": { "type": "string" },
            "plmnId": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "nodeId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
