{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.instantiateVnf",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "VNFM — instantiate a VNF/CNF from a VNFD on a chosen VIM under an NS. Optional `mappedNfInstanceId` ties this VNF back to the Phase 4 5G NF instance it implements.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["nsId", "vnfdId", "vnfmNfId", "vimId", "deploymentFlavor", "observedAt"],
          "properties": {
            "vnfId": { "type": "string" },
            "nsId": { "type": "string" },
            "vnfdId": { "type": "string" },
            "vnfmNfId": { "type": "string" },
            "vimId": { "type": "string" },
            "deploymentFlavor": { "type": "string" },
            "requestedVcpus": { "type": "integer" },
            "requestedMemoryGib": { "type": "number" },
            "mappedNfInstanceId": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "vnfId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
