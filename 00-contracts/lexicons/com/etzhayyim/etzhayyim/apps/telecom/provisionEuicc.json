{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.provisionEuicc",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a new eUICC device in the graph (SGP.22 §2 EID provisioning). EID stored sha256: hashed. Creates vertex_telecom_esim_euicc record.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["eid", "deviceKind"],
          "properties": {
            "eid": { "type": "string", "description": "sha256: hashed EID (32-hex EID)" },
            "deviceKind": { "type": "string", "enum": ["smartphone", "tablet", "wearable", "iot", "automotive", "cpe"] },
            "manufacturerName": { "type": "string" },
            "platformVersion": { "type": "string" },
            "smdpAddress": { "type": "string" },
            "smdsAddress": { "type": "string" },
            "profileSlots": { "type": "integer" },
            "observedAt": { "type": "string", "format": "datetime" },
            "callerDid": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "eid": { "type": "string" },
            "status": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
