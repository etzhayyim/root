{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.provisionDwdmChannel",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Provision a DWDM lightpath / spectrum slot between two ROADMs through pre-validated fiber spans. centerFrequencyGhz on flex-grid (e.g. 193.1 THz center + multiples of channelGridGhz).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["olsId", "sourceRoadmId", "targetRoadmId", "centerFrequencyGhz", "bandwidthGhz", "modulation", "lineRateGbps", "observedAt"],
          "properties": {
            "channelId": { "type": "string" },
            "olsId": { "type": "string" },
            "sourceRoadmId": { "type": "string" },
            "targetRoadmId": { "type": "string" },
            "pathSpanIds": { "type": "array", "items": { "type": "string" } },
            "centerFrequencyGhz": { "type": "number" },
            "bandwidthGhz": { "type": "number" },
            "modulation": { "type": "string", "enum": ["bpsk", "qpsk", "8qam", "16qam", "32qam", "64qam", "pcs_64qam"] },
            "lineRateGbps": { "type": "number" },
            "fec": { "type": "string", "enum": ["sd_fec_15", "sd_fec_25", "sd_fec_28", "hard_decision_g709", "openroadm_25"] },
            "oTransparentTo": { "type": "string", "enum": ["otn", "ethernet_lan_phy", "fc"] },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "channelId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
