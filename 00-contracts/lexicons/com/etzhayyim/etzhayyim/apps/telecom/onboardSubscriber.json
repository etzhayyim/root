{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.onboardSubscriber",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Onboard a new telecom subscriber. PII (customerName) is stored Tier-3 per ADR-0018; AT Repo holds hashed identity only.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["customerName", "msisdn", "kycStatus", "planId"],
          "properties": {
            "subscriberId": { "type": "string" },
            "customerName": { "type": "string" },
            "msisdn": { "type": "string" },
            "imsi": { "type": "string" },
            "kycStatus": { "type": "string", "enum": ["pending", "verified", "rejected"] },
            "planId": { "type": "string" },
            "asOf": { "type": "string", "format": "date" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "subscriberId": { "type": "string" },
            "status": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
