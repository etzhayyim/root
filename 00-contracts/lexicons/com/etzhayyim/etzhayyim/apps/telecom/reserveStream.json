{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.reserveStream",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Reserve a deterministic stream (IEEE 802.1Q SRP / Qcc CNC). pathBridgeIds is the ordered talker→listener path computed by the controller.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["domainId", "talkerEndpointId", "listenerEndpointIds", "trafficClass", "maxFrameBytes", "framesPerInterval", "intervalNs", "maxLatencyNs", "reservationKind", "observedAt"],
          "properties": {
            "streamId": { "type": "string" },
            "domainId": { "type": "string" },
            "talkerEndpointId": { "type": "string" },
            "listenerEndpointIds": { "type": "array", "items": { "type": "string" } },
            "streamRank": { "type": "integer" },
            "trafficClass": { "type": "integer" },
            "maxFrameBytes": { "type": "integer" },
            "framesPerInterval": { "type": "integer" },
            "intervalNs": { "type": "integer" },
            "maxLatencyNs": { "type": "integer" },
            "pathBridgeIds": { "type": "array", "items": { "type": "string" } },
            "reservationKind": { "type": "string", "enum": ["srp_legacy", "qcc_centralized", "qcc_distributed", "yang_uni"] },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "streamId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
