{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.registerNumberRange",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register an MSISDN range allocation from the regulator (E.164, country code + range bounds).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["jurisdiction", "countryCode", "startMsisdn", "endMsisdn", "allocatedAt"],
          "properties": {
            "rangeId": { "type": "string" },
            "jurisdiction": { "type": "string" },
            "countryCode": { "type": "string" },
            "startMsisdn": { "type": "string" },
            "endMsisdn": { "type": "string" },
            "regulatorAllocationId": { "type": "string" },
            "allocatedAt": { "type": "string", "format": "date" },
            "plmnId": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "rangeId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
