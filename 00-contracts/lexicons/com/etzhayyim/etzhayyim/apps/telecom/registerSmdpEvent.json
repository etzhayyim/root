{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.registerSmdpEvent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a pending profile event on SM-DS (GSMA SGP.22 §3.6). The eUICC polls SM-DS and retrieves the event to initiate profile download. EID sha256: hashed.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["eventId", "eid", "smdpAddress", "eventType"],
          "properties": {
            "eventId": { "type": "string" },
            "eid": { "type": "string", "description": "sha256: hashed EID" },
            "smdpAddress": { "type": "string" },
            "smdsAddress": { "type": "string" },
            "eventType": { "type": "string", "enum": ["profileDownload", "profileUpdate", "policyUpdate"] },
            "iccid": { "type": "string", "description": "sha256: hashed ICCID (optional)" },
            "expiresAt": { "type": "string", "format": "datetime" },
            "observedAt": { "type": "string", "format": "datetime" },
            "callerDid": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "eventId": { "type": "string" },
            "status": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
