{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.onboardNetworkServiceDescriptor",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ETSI MANO NFVO — onboard a Network Service Descriptor (NSD) into the catalog. Phase 12 SDN-NFV control plane. Body persisted via vault://+sha256 only.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["vendor", "name", "version", "descriptorFormat", "constituentVnfdIds", "packageHash", "observedAt"],
          "properties": {
            "nsdId": { "type": "string" },
            "vendor": { "type": "string" },
            "name": { "type": "string" },
            "version": { "type": "string" },
            "descriptorFormat": { "type": "string", "enum": ["tosca", "yang", "heat", "helm"] },
            "constituentVnfdIds": { "type": "array", "items": { "type": "string" } },
            "virtualLinks": { "type": "array", "items": { "type": "string" } },
            "packageHash": { "type": "string" },
            "packageRef": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "nsdId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
