{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.applyO1Configuration",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "O-RAN O1 — SMO pushes a NETCONF/RESTCONF YANG configuration to a managed function (O-CU / O-DU / O-RU / Near-RT RIC). Body persisted via vault:// ref only.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["smoId", "targetKind", "targetVid", "interfaceTransport", "operation", "configHash", "observedAt"],
          "properties": {
            "configId": { "type": "string" },
            "smoId": { "type": "string" },
            "targetKind": { "type": "string", "enum": ["o-cu-cp", "o-cu-up", "o-du", "o-ru", "near-rt-ric", "smo"] },
            "targetVid": { "type": "string" },
            "interfaceTransport": { "type": "string", "enum": ["netconf", "restconf", "ves"] },
            "operation": { "type": "string", "enum": ["create", "merge", "replace", "delete"] },
            "yangModuleSet": { "type": "string" },
            "configHash": { "type": "string" },
            "configRef": { "type": "string" },
            "configSize": { "type": "integer" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "configId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
