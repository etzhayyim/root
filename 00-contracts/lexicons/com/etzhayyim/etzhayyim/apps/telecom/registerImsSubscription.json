{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.registerImsSubscription",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "IMS HSS — register an IMS user-profile subscription (IMPI ↔ IMPU list ↔ S-CSCF). Phase 5 voice control plane.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["profileId", "subscriberId", "impi", "impuList", "sCscfFqdn", "hssNfId"],
          "properties": {
            "subscriptionId": { "type": "string" },
            "profileId": { "type": "string" },
            "subscriberId": { "type": "string" },
            "impi": { "type": "string" },
            "impuList": { "type": "array", "items": { "type": "string" } },
            "serviceProfileRef": { "type": "string" },
            "sCscfFqdn": { "type": "string" },
            "hssNfId": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "subscriptionId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
