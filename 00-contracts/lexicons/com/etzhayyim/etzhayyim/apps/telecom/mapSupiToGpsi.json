{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.mapSupiToGpsi",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "NPN UDR — upsert a SUPI ↔ GPSI mapping (Generic Public Subscription Identifier — MSISDN/external_id/IMEI). SUPI/GPSI persisted as sha256 hashes.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["profileId", "supi", "gpsiKind", "gpsiValue", "action", "observedAt"],
          "properties": {
            "mappingId": { "type": "string" },
            "profileId": { "type": "string" },
            "supi": { "type": "string" },
            "gpsiKind": { "type": "string", "enum": ["msisdn", "external_id", "imei", "external_uri"] },
            "gpsiValue": { "type": "string" },
            "snpnId": { "type": "string" },
            "action": { "type": "string", "enum": ["create", "update", "delete"] },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "mappingId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
