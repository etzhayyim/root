{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.provisionSdnFlow",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "SDN controller — install / modify / delete a flow rule on a southbound switch (OpenFlow / P4Runtime / NETCONF / OVSDB / gNMI). matchHash + actionHash only; raw match/action bodies via vault://.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sdnControllerId", "southboundProtocol", "switchDpid", "tableId", "priority", "matchHash", "actionHash", "action", "observedAt"],
          "properties": {
            "flowId": { "type": "string" },
            "sdnControllerId": { "type": "string" },
            "southboundProtocol": { "type": "string", "enum": ["openflow", "p4runtime", "netconf", "ovsdb", "gnmi"] },
            "switchDpid": { "type": "string" },
            "tableId": { "type": "integer" },
            "priority": { "type": "integer" },
            "matchHash": { "type": "string" },
            "actionHash": { "type": "string" },
            "action": { "type": "string", "enum": ["install", "modify", "delete"] },
            "vnfId": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "flowId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
