{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.emitImsBillingEvent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "IMS CDF / TAS — emit an IMS-specific billing event (3GPP Rf interface). Bridges voice call usage to Phase 1 subscriber billing rollup; complements Phase 4 emitChargingDataRecord which is data-plane only.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["callId", "subscriberId", "eventKind", "ratingGroup", "units", "currency", "amount", "chargingMethod", "startedAt"],
          "properties": {
            "billingId": { "type": "string" },
            "callId": { "type": "string" },
            "subscriberId": { "type": "string" },
            "eventKind": { "type": "string", "enum": ["call_setup", "call_complete", "supp_service", "emergency", "interconnect_leg"] },
            "ratingGroup": { "type": "string" },
            "units": { "type": "number" },
            "unitOfMeasure": { "type": "string", "enum": ["seconds", "messages", "events"] },
            "currency": { "type": "string" },
            "amount": { "type": "number" },
            "chargingMethod": { "type": "string", "enum": ["online", "offline", "converged"] },
            "cdfNfId": { "type": "string" },
            "startedAt": { "type": "string", "format": "datetime" },
            "endedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "billingId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
