{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.registerRoamingPartner",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a TAP 3.12 roaming partner (TADIG code, IMSI prefix, SCCP GT prefix) under an existing interconnect agreement.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["peerOrgId", "tadigCode", "agreementId"],
          "properties": {
            "partnerId": { "type": "string" },
            "peerOrgId": { "type": "string" },
            "tadigCode": { "type": "string" },
            "plmnId": { "type": "string" },
            "sccpGtPrefix": { "type": "string" },
            "imsiPrefix": { "type": "string" },
            "agreementId": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "partnerId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
