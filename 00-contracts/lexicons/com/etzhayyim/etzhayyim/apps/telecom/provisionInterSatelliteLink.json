{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.provisionInterSatelliteLink",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "NTN — provision an inter-satellite link (ISL) between two satellites. Optical (LCT) or RF, with optional encryption key reference (vault://).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sourceSatelliteId", "targetSatelliteId", "linkKind", "capacityMbps", "validFrom", "observedAt"],
          "properties": {
            "islId": { "type": "string" },
            "sourceSatelliteId": { "type": "string" },
            "targetSatelliteId": { "type": "string" },
            "linkKind": { "type": "string", "enum": ["optical_lct", "rf_ka", "rf_v_band", "rf_w_band", "rf_q_band"] },
            "capacityMbps": { "type": "number" },
            "frequencyBand": { "type": "string" },
            "encryptionRef": { "type": "string" },
            "validFrom": { "type": "string", "format": "datetime" },
            "validUntil": { "type": "string", "format": "datetime" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "islId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
