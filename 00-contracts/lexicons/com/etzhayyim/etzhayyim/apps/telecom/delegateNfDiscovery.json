{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.delegateNfDiscovery",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "5G SCP — delegated NF discovery (SCP queries NRF on behalf of consumer NF). Records candidate set + selected NF + selection strategy.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["scpNfId", "requesterNfId", "targetNfType", "selectedNfId", "observedAt"],
          "properties": {
            "discoveryId": { "type": "string" },
            "scpNfId": { "type": "string" },
            "requesterNfId": { "type": "string" },
            "targetNfType": { "type": "string", "enum": ["AMF", "SMF", "UPF", "UDM", "UDR", "AUSF", "PCF", "NRF", "NSSF", "NEF", "NWDAF", "CHF", "BSF"] },
            "snssai": { "type": "string" },
            "dnn": { "type": "string" },
            "plmnId": { "type": "string" },
            "candidateNfIds": { "type": "array", "items": { "type": "string" } },
            "selectedNfId": { "type": "string" },
            "selectionStrategy": { "type": "string", "enum": ["round_robin", "weighted", "priority", "least_load", "locality"] },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "discoveryId": { "type": "string" },
          "candidateCount": { "type": "integer" },
          "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
