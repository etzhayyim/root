{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.applyPolicyDecision",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "5G Core PCF — record a policy + charging decision (Npcf_SMPolicyControl). Drives QoS flows + rating group + charging method for a PDU session.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["profileId", "snssai", "dnn", "chargingMethod", "pcfNfId", "observedAt"],
          "properties": {
            "decisionId": { "type": "string" },
            "profileId": { "type": "string" },
            "sessionId": { "type": "string" },
            "snssai": { "type": "string" },
            "dnn": { "type": "string" },
            "qosFlowList": { "type": "array", "items": { "type": "string" } },
            "chargingMethod": { "type": "string", "enum": ["online", "offline", "converged"] },
            "ratingGroup": { "type": "string" },
            "sponsorId": { "type": "string" },
            "pcfNfId": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "decisionId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
