{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.establishPduSession",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "5G Core SMF — establish a PDU session (Nsmf_PDUSession) with selected slice / DNN / UPF / RAN node and active policy decision.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["registrationId", "profileId", "snssai", "dnn", "sessionType", "smfNfId", "observedAt"],
          "properties": {
            "sessionId": { "type": "string" },
            "registrationId": { "type": "string" },
            "profileId": { "type": "string" },
            "snssai": { "type": "string" },
            "dnn": { "type": "string" },
            "sessionType": { "type": "string", "enum": ["IPv4", "IPv6", "IPv4v6", "Ethernet", "Unstructured"] },
            "smfNfId": { "type": "string" },
            "upfNfId": { "type": "string" },
            "ranNodeId": { "type": "string" },
            "policyDecisionId": { "type": "string" },
            "ueIpv4": { "type": "string" },
            "ueIpv6Prefix": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "sessionId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
