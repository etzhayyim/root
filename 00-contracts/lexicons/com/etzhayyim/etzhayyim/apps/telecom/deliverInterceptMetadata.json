{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.deliverInterceptMetadata",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "DF2 (X2) — deliver Intercept-Related Information (IRI) to LEMF. Only delivery metadata + payload hash persisted in graph; the IRI payload itself goes directly DF2 → LEMF (audit-only graph).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["targetId", "eventKind", "eventVid", "x2Sequence", "df2NfId", "lemfId", "payloadHash", "observedAt"],
          "properties": {
            "iriId": { "type": "string" },
            "targetId": { "type": "string" },
            "eventKind": { "type": "string", "enum": ["registration", "session_establish", "session_release", "voice_setup", "voice_release", "sms", "supp_service", "location_update", "handover"] },
            "eventVid": { "type": "string" },
            "x2Sequence": { "type": "integer" },
            "df2NfId": { "type": "string" },
            "lemfId": { "type": "string" },
            "payloadHash": { "type": "string" },
            "payloadSize": { "type": "integer" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "iriId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
