{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.emitNwdafAnalyticsResult",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "5G NWDAF — emit a periodic analytics result for an active subscription. Only payload metadata (hash + size + vault:// ref) persisted in graph.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["subscriptionId", "analyticsId", "sequenceNumber", "payloadHash", "observedAt"],
          "properties": {
            "resultId": { "type": "string" },
            "subscriptionId": { "type": "string" },
            "analyticsId": { "type": "string" },
            "sequenceNumber": { "type": "integer" },
            "confidence": { "type": "number" },
            "validityPeriodSeconds": { "type": "integer" },
            "payloadHash": { "type": "string" },
            "payloadRef": { "type": "string" },
            "payloadSize": { "type": "integer" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "resultId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
