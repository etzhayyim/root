{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.subscribeNwdafAnalytics",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "5G NWDAF — subscribe to a network data analytics report (3GPP TS 23.288 Nnwdaf_AnalyticsSubscription). Phase 8 control plane.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["consumerNfId", "nwdafNfId", "analyticsId", "targetOfAnalyticsKind", "targetOfAnalyticsVid", "reportingPeriodSeconds", "observedAt"],
          "properties": {
            "subscriptionId": { "type": "string" },
            "consumerNfId": { "type": "string" },
            "nwdafNfId": { "type": "string" },
            "analyticsId": { "type": "string", "enum": ["LOAD_LEVEL_INFORMATION", "NETWORK_PERFORMANCE", "SERVICE_EXPERIENCE", "UE_MOBILITY", "UE_COMMUNICATION", "ABNORMAL_BEHAVIOUR", "QOS_SUSTAINABILITY", "USER_DATA_CONGESTION", "DISPERSION", "WLAN_PERFORMANCE", "REDUNDANT_TRANSMISSION_EXP", "SM_CONGESTION", "NF_LOAD"] },
            "targetOfAnalyticsKind": { "type": "string", "enum": ["nfInstance", "ranNode", "cellSite", "subscriberProfile5g", "service", "snssai", "any"] },
            "targetOfAnalyticsVid": { "type": "string" },
            "snssai": { "type": "string" },
            "dnn": { "type": "string" },
            "reportingPeriodSeconds": { "type": "integer" },
            "accuracyRequirement": { "type": "string", "enum": ["low", "medium", "high"] },
            "expiresAt": { "type": "string", "format": "datetime" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "subscriptionId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
