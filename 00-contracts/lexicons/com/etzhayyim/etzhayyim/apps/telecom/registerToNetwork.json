{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.registerToNetwork",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "5G Core AMF — record a UE registration (initial / mobility / periodic). Binds Phase 2 RAN node to a 5G subscriber profile.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["profileId", "registrationType", "ranNodeId", "amfNfId", "observedAt"],
          "properties": {
            "registrationId": { "type": "string" },
            "profileId": { "type": "string" },
            "supi": { "type": "string" },
            "registrationType": { "type": "string", "enum": ["initial", "mobility", "periodic", "emergency"] },
            "ranNodeId": { "type": "string" },
            "amfNfId": { "type": "string" },
            "taiPlmnId": { "type": "string" },
            "taiTac": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "registrationId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
