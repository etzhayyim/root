{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.recordSyncDeviation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a gPTP / PTP sync deviation observed by a bridge. breach=true when offsetNs/pathDelayNs exceeds profile thresholds (computed by primitive).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["syncProfileId", "observedBridgeId", "deviationKind", "offsetNs", "observedAt"],
          "properties": {
            "deviationId": { "type": "string" },
            "syncProfileId": { "type": "string" },
            "observedBridgeId": { "type": "string" },
            "deviationKind": { "type": "string", "enum": ["offset_drift", "path_delay_drift", "frequency_drift", "gm_loss", "bmca_change"] },
            "offsetNs": { "type": "integer" },
            "pathDelayNs": { "type": "integer" },
            "pathDelayVarianceNs": { "type": "integer" },
            "sourceClockIdHash": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "deviationId": { "type": "string" },
          "breach": { "type": "boolean" },
          "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
