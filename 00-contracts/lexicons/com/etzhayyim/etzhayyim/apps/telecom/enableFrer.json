{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.enableFrer",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Enable Frame Replication & Elimination for Reliability (IEEE 802.1CB) on an existing TSN stream. Replication kind picks how diverse paths are computed.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["streamId", "replicationKind", "replicationCount", "observedAt"],
          "properties": {
            "frerProfileId": { "type": "string" },
            "streamId": { "type": "string" },
            "replicationKind": { "type": "string", "enum": ["disjoint_paths", "max_disjoint", "node_disjoint", "link_disjoint", "k_safe"] },
            "replicationCount": { "type": "integer" },
            "replicationPathBridgeIds": { "type": "array", "items": { "type": "string" } },
            "eliminationBridgeIds": { "type": "array", "items": { "type": "string" } },
            "sequenceRecoveryWindow": { "type": "integer" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "frerProfileId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
