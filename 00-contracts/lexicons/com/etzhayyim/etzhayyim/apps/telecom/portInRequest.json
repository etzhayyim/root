{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.portInRequest",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "MNP port-in request — receive a subscriber from a donor partner.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["msisdn", "subscriberId", "donorPartnerId", "requestedAt", "authCode"],
          "properties": {
            "requestId": { "type": "string" },
            "msisdn": { "type": "string" },
            "subscriberId": { "type": "string" },
            "donorPartnerId": { "type": "string" },
            "requestedAt": { "type": "string", "format": "datetime" },
            "scheduledCutoverAt": { "type": "string", "format": "datetime" },
            "authCode": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "requestId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
