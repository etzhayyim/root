{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.registerSmoNode",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "O-RAN SMO — register a Service Management & Orchestration node hosting Non-RT RIC + O1/O2 northbound endpoints. Phase 9 Open RAN control plane.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["vendor", "releaseVersion", "plmnId", "nonRtRicEndpoint", "o1Endpoint", "observedAt"],
          "properties": {
            "smoId": { "type": "string" },
            "vendor": { "type": "string" },
            "releaseVersion": { "type": "string" },
            "plmnId": { "type": "string" },
            "nonRtRicEndpoint": { "type": "string" },
            "o1Endpoint": { "type": "string" },
            "o2Endpoint": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "smoId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
