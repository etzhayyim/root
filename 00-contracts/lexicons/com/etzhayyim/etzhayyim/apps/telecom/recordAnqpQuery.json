{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.recordAnqpQuery",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ANQP / Hotspot 2.0 GAS query audit. UE MAC address persisted only as sha256 hash; ANQP response body persisted as sha256 hash + size.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["venueId", "ueMacHash", "gasProtocol", "queryElement", "responseHash", "observedAt"],
          "properties": {
            "queryId": { "type": "string" },
            "venueId": { "type": "string" },
            "ueMacHash": { "type": "string" },
            "gasProtocol": { "type": "string", "enum": ["gas_anqp", "gas_p2p", "gas_h2t"] },
            "queryElement": { "type": "string", "enum": ["nai_realm", "venue_name", "domain_name", "roaming_consortium", "ip_addr_type", "3gpp_cellular", "icon_request", "osu_providers", "advice_of_charge"] },
            "responseHash": { "type": "string" },
            "responseSize": { "type": "integer" },
            "latencyMs": { "type": "number" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "queryId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
