{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.registerSubmarineCableSystem",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a submarine cable system with landing-station and capacity metadata.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["displayName", "ownerOrgId", "jurisdictionScope", "observedAt"],
          "properties": {
            "cableSystemId": { "type": "string" },
            "displayName": { "type": "string" },
            "ownerOrgId": { "type": "string" },
            "designCapacityTbps": { "type": "number" },
            "litCapacityTbps": { "type": "number" },
            "readyForServiceAt": { "type": "string", "format": "datetime" },
            "jurisdictionScope": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "cableSystemId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
