{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.terminateVoiceCall",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "IMS TAS — record SIP BYE / CANCEL / 4xx-5xx-6xx response. Updates voice_call status + duration; never persists media content.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["callId", "releaseCause", "releasedBy", "releasedAt"],
          "properties": {
            "callId": { "type": "string" },
            "releaseCause": { "type": "string", "enum": ["normal", "busy", "no_answer", "rejected", "network_failure", "media_failure", "timeout"] },
            "releasedBy": { "type": "string", "enum": ["caller", "callee", "network", "interconnect"] },
            "releasedAt": { "type": "string", "format": "datetime" },
            "sipResponseCode": { "type": "integer" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "callId": { "type": "string" },
          "durationSeconds": { "type": "number" },
          "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
