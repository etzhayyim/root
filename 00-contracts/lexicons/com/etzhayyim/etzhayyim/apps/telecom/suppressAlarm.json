{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.suppressAlarm",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "OSS NOC — suppress an active alarm temporarily (planned maintenance window or known-issue). Mutates the alarm row in place.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["alarmId", "suppressionReason", "suppressUntil", "suppressedBy", "observedAt"],
          "properties": {
            "alarmId": { "type": "string" },
            "suppressionReason": { "type": "string", "enum": ["maintenance", "known_issue", "duplicate", "test", "operator_override"] },
            "suppressUntil": { "type": "string", "format": "datetime" },
            "windowVid": { "type": "string" },
            "suppressedBy": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "alarmId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
