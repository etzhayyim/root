{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.authenticateSubscriber",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "5G Core AUSF — record an authentication event (5G-AKA / EAP-AKA' / EAP-TLS). Audit-only: RAND / RES* / KAUSF never persisted; only the event outcome and a randHash for correlation.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["profileId", "supi", "authMethod", "result", "observedAt"],
          "properties": {
            "authEventId": { "type": "string" },
            "profileId": { "type": "string" },
            "supi": { "type": "string" },
            "servingNetwork": { "type": "string" },
            "authMethod": { "type": "string", "enum": ["5G-AKA", "EAP-AKA-prime", "EAP-TLS"] },
            "result": { "type": "string", "enum": ["success", "failure", "synchronization-failure"] },
            "randHash": { "type": "string" },
            "ausfNfId": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "authEventId": { "type": "string" },
          "success": { "type": "boolean" },
          "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
