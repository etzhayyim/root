{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.raiseAlarm",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "OSS NOC — raise an alarm against a network entity (cell site, RAN node, NF instance, asset, or service). 3GPP TS 32.111 / ITU-T X.733 fault management shape.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sourceKind", "sourceVid", "alarmType", "severity", "raisedAt"],
          "properties": {
            "alarmId": { "type": "string" },
            "sourceKind": { "type": "string", "enum": ["cellSite", "ranNode", "nfInstance", "networkAsset", "service", "transport"] },
            "sourceVid": { "type": "string" },
            "alarmType": { "type": "string", "enum": ["communications", "quality_of_service", "processing_error", "equipment", "environmental", "integrity_violation"] },
            "severity": { "type": "string", "enum": ["info", "warning", "minor", "major", "critical"] },
            "perceivedSeverity": { "type": "string", "enum": ["info", "warning", "minor", "major", "critical"] },
            "probableCause": { "type": "string" },
            "alarmText": { "type": "string" },
            "raisedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "alarmId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
