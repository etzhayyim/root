{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.registerCagGroup",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "NPN — register a Closed Access Group (CAG) within an SNPN. Restricts which UEs may camp on which Phase 2 cellSite/ranNode.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["snpnId", "cagValue", "displayName", "accessKind", "observedAt"],
          "properties": {
            "cagId": { "type": "string" },
            "snpnId": { "type": "string" },
            "cagValue": { "type": "string" },
            "displayName": { "type": "string" },
            "allowedCellSiteIds": { "type": "array", "items": { "type": "string" } },
            "allowedRanNodeIds": { "type": "array", "items": { "type": "string" } },
            "accessKind": { "type": "string", "enum": ["cag_only", "cag_preferred", "shared"] },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "cagId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
