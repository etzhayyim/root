{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.registerCellSite",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a cell site (TMF639 Resource Inventory). Latitude/longitude only — tower owner contact PII held elsewhere.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["name", "latitude", "longitude", "jurisdiction"],
          "properties": {
            "siteId": { "type": "string" },
            "name": { "type": "string" },
            "latitude": { "type": "number" },
            "longitude": { "type": "number" },
            "jurisdiction": { "type": "string" },
            "towerOwnerOrgId": { "type": "string" },
            "height": { "type": "number" },
            "powerSource": { "type": "string", "enum": ["grid", "battery", "solar", "diesel", "hybrid"] }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "siteId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
