{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.discoverEdgeApplicationServer",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "EES (Edge Enabler Server) — record an EAS discovery request from an Edge Enabler Client / Application Client. UE identifier persisted only as sha256 hash.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["eesId", "requestingAcId", "ueIdHash", "easProviderId", "requestedAppId", "selectedEasId", "observedAt"],
          "properties": {
            "discoveryId": { "type": "string" },
            "eesId": { "type": "string" },
            "requestingAcId": { "type": "string" },
            "ueIdHash": { "type": "string" },
            "ueLocationCellId": { "type": "string" },
            "easProviderId": { "type": "string" },
            "requestedAppId": { "type": "string" },
            "candidateEasIds": { "type": "array", "items": { "type": "string" } },
            "selectedEasId": { "type": "string" },
            "selectionStrategy": { "type": "string", "enum": ["nearest", "lowest_load", "preferred_provider", "round_robin", "policy_driven"] },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "discoveryId": { "type": "string" },
          "candidateCount": { "type": "integer" },
          "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
