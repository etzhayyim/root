{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.routeServiceRequest",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "5G SCP — record an SBI service request routing event (3GPP TS 23.501 §6.2.18). Request URI persisted as sha256 hash; body never persisted.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["scpNfId", "sourceNfId", "targetNfId", "targetServiceName", "routingMode", "methodKind", "statusCode", "observedAt"],
          "properties": {
            "routeId": { "type": "string" },
            "scpNfId": { "type": "string" },
            "sourceNfId": { "type": "string" },
            "targetNfId": { "type": "string" },
            "targetServiceName": { "type": "string" },
            "targetApiVersion": { "type": "string" },
            "routingMode": { "type": "string", "enum": ["direct_a", "direct_b", "indirect_c", "indirect_d"] },
            "requestUriHash": { "type": "string" },
            "methodKind": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
            "statusCode": { "type": "integer" },
            "latencyMs": { "type": "number" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "routeId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
