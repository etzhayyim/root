{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.provisionPasspointPpsMo",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Hotspot 2.0 PPS-MO (Per-Provider Subscription Management Object) provisioning. credentialRef must be vault://; raw EAP credentials never persist. ppsMoRef stores the full MO XML out-of-band.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["subscriberId", "identityProviderOrgId", "eapMethod", "credentialKind", "advertisedRcoiIds", "ppsMoHash", "observedAt"],
          "properties": {
            "ppsMoId": { "type": "string" },
            "subscriberId": { "type": "string" },
            "profileId": { "type": "string" },
            "identityProviderOrgId": { "type": "string" },
            "eapMethod": { "type": "string", "enum": ["EAP-SIM", "EAP-AKA", "EAP-AKA-prime", "EAP-TLS", "EAP-TTLS", "EAP-PEAP"] },
            "credentialKind": { "type": "string", "enum": ["sim", "certificate", "username_password", "passpoint_r3"] },
            "credentialRef": { "type": "string" },
            "advertisedRcoiIds": { "type": "array", "items": { "type": "string" } },
            "ppsMoHash": { "type": "string" },
            "ppsMoRef": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "ppsMoId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
