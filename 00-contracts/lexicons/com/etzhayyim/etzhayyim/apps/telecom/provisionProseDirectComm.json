{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.provisionProseDirectComm",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "NPN — provision 5G ProSe (Proximity Services) direct communication / sidelink (3GPP TS 23.304). prosePolicyRef must be vault://; raw policy body never persisted.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["snpnId", "communicationKind", "prosePolicyHash", "validUntil", "observedAt"],
          "properties": {
            "proseId": { "type": "string" },
            "snpnId": { "type": "string" },
            "communicationKind": { "type": "string", "enum": ["one_to_one", "one_to_many", "ue_to_network_relay", "ue_to_ue_relay"] },
            "layer2GroupId": { "type": "string" },
            "prosePolicyHash": { "type": "string" },
            "prosePolicyRef": { "type": "string" },
            "sidelinkProfile": { "type": "string", "enum": ["pc5_mode_1", "pc5_mode_2", "ranged_mode"] },
            "allowedRanNodeIds": { "type": "array", "items": { "type": "string" } },
            "validUntil": { "type": "string", "format": "datetime" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "proseId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
