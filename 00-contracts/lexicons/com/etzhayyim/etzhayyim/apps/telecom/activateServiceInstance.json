{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.activateServiceInstance",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Activate or configure a service instance via TMF640 Service Activation and Configuration API. Creates a vertex_telecom_tmf_service_activation record.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["activationId", "serviceOrderId", "serviceInstanceKind", "action"],
          "properties": {
            "activationId": { "type": "string" },
            "serviceOrderId": { "type": "string" },
            "serviceInstanceKind": { "type": "string" },
            "serviceInstanceVid": { "type": "string" },
            "action": { "type": "string", "enum": ["activate", "deactivate", "configure", "test", "reconfigure"] },
            "configurationHash": { "type": "string" },
            "configurationRef": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" },
            "callerDid": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "activationId": { "type": "string" },
            "status": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
