{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.establishVoiceCall",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "IMS S-CSCF / TAS — record SIP INVITE → 200 OK → ACK call setup. Caller/callee MSISDN persisted as hashes; IMPU/SIP URI as plain (already public-style identifier).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["subscriberId", "callerImpu", "calleeImpu", "sessionVoltype", "sCscfNfId", "tasNfId", "invitedAt"],
          "properties": {
            "callId": { "type": "string" },
            "subscriberId": { "type": "string" },
            "callerImpu": { "type": "string" },
            "calleeImpu": { "type": "string" },
            "callerMsisdn": { "type": "string" },
            "calleeMsisdn": { "type": "string" },
            "sessionVoltype": { "type": "string", "enum": ["volte", "vonr", "vowifi", "fixed", "interconnect"] },
            "codec": { "type": "string", "enum": ["AMR-NB", "AMR-WB", "EVS", "EVS-SWB", "EVS-FB", "G.711", "G.722"] },
            "pduSessionId": { "type": "string" },
            "sCscfNfId": { "type": "string" },
            "tasNfId": { "type": "string" },
            "invitedAt": { "type": "string", "format": "datetime" },
            "answeredAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "callId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
