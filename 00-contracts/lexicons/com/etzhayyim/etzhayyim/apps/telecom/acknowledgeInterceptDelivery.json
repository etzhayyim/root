{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.acknowledgeInterceptDelivery",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "LEMF — acknowledge receipt (or report failure) of an IRI / CC delivery. Used to compute delivery loss for SLA reporting to the requesting authority.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["deliveryKind", "deliveryVid", "lemfId", "ackResult", "ackedAt"],
          "properties": {
            "ackId": { "type": "string" },
            "deliveryKind": { "type": "string", "enum": ["iri", "cc"] },
            "deliveryVid": { "type": "string" },
            "lemfId": { "type": "string" },
            "ackResult": { "type": "string", "enum": ["received", "checksum_failure", "decode_failure", "timeout", "rejected"] },
            "ackCode": { "type": "string" },
            "ackedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "ackId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
