{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.registerBluetoothDevice",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a Bluetooth/BLE device for short-range telecom inventory. Device addresses are stored as hashes only.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["addressHash", "addressKind", "bluetoothVersion", "deviceRole", "observedAt"],
          "properties": {
            "deviceId": { "type": "string" },
            "deviceName": { "type": "string" },
            "addressHash": { "type": "string" },
            "addressKind": { "type": "string", "enum": ["public_hash", "random_static_hash", "rpa_hash", "unknown_hash"] },
            "bluetoothVersion": { "type": "string", "enum": ["4.0", "4.1", "4.2", "5.0", "5.1", "5.2", "5.3", "5.4", "unknown"] },
            "deviceRole": { "type": "string", "enum": ["central", "peripheral", "broadcaster", "observer", "mesh_node", "gateway"] },
            "gattProfileRefs": { "type": "array", "items": { "type": "string" } },
            "siteId": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "deviceId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
