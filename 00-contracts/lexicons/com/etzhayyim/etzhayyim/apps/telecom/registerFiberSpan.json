{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.registerFiberSpan",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a fiber span between two ROADMs. Captures SMF/NZDSF type + length + attenuation + dispersion + amplifier (EDFA/Raman/hybrid) for GNPy planning.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["olsId", "sourceRoadmId", "targetRoadmId", "fiberType", "lengthKm", "attenuationDb", "ownerOrgId", "observedAt"],
          "properties": {
            "spanId": { "type": "string" },
            "olsId": { "type": "string" },
            "sourceRoadmId": { "type": "string" },
            "targetRoadmId": { "type": "string" },
            "fiberType": { "type": "string", "enum": ["smf28", "nzdsf", "lefiber", "tw_reach", "g653", "g655", "g657"] },
            "lengthKm": { "type": "number" },
            "attenuationDb": { "type": "number" },
            "dispersionPsNmKm": { "type": "number" },
            "amplifierKind": { "type": "string", "enum": ["edfa_inline", "edfa_booster", "edfa_preamp", "raman", "hybrid_raman_edfa", "none"] },
            "amplifierGainDb": { "type": "number" },
            "ownerOrgId": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "spanId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
