{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.applyTrafficShaper",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Apply / modify / delete a traffic shaper on a bridge port. CBS = idle-slope; TAS = gate schedule (vault://+sha256); ATS = per-flow asynchronous.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["bridgeId", "portIndex", "shaperKind", "trafficClass", "action", "observedAt"],
          "properties": {
            "shaperId": { "type": "string" },
            "bridgeId": { "type": "string" },
            "portIndex": { "type": "integer" },
            "shaperKind": { "type": "string", "enum": ["cbs", "tas", "ats", "strict_priority", "qci", "frame_preemption"] },
            "trafficClass": { "type": "integer" },
            "idleSlopeBps": { "type": "integer" },
            "gateScheduleHash": { "type": "string" },
            "gateScheduleRef": { "type": "string" },
            "cycleTimeNs": { "type": "integer" },
            "action": { "type": "string", "enum": ["apply", "modify", "delete"] },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "shaperId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
