{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.downloadEsimProfile",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Initiate eSIM profile download from SM-DP+ to eUICC (GSMA SGP.22 §3.1). EID and ICCID stored sha256: hashed. Creates vertex_telecom_esim_profile record.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["downloadId", "eid", "iccid", "smdpAddress"],
          "properties": {
            "downloadId": { "type": "string" },
            "eid": { "type": "string", "description": "sha256: hashed EID" },
            "iccid": { "type": "string", "description": "sha256: hashed ICCID" },
            "matchingId": { "type": "string", "description": "Activation code / matching ID" },
            "confirmationCode": { "type": "string" },
            "smdpAddress": { "type": "string" },
            "profileType": { "type": "string", "enum": ["telecom", "iot", "m2m", "enterprise"] },
            "mno": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" },
            "callerDid": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "iccid": { "type": "string" },
            "status": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
