{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.terminateNetworkService",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "NFVO — terminate a Network Service. Mutates the existing NS row + computes lifetime_seconds; cascading VNF termination tracked separately by VNFM.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["nsId", "terminationKind", "terminatedBy", "terminatedAt"],
          "properties": {
            "nsId": { "type": "string" },
            "terminationKind": { "type": "string", "enum": ["graceful", "forceful", "scheduled", "operator_request"] },
            "terminationReason": { "type": "string" },
            "terminatedBy": { "type": "string" },
            "terminatedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "nsId": { "type": "string" },
          "lifetimeSeconds": { "type": "number" },
          "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
