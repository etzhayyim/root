{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.recordPmEvent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record an optical performance-monitoring event (rx-power, tx-power, OSNR, pre-FEC-BER, Q-factor, CD/PMD). breach=true when |value| crosses slaThreshold.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sourceKind", "sourceVid", "metric", "value", "unit", "observedAt"],
          "properties": {
            "pmId": { "type": "string" },
            "sourceKind": { "type": "string", "enum": ["roadm", "fiber_span", "dwdm_channel", "otn_connection", "amplifier", "transponder"] },
            "sourceVid": { "type": "string" },
            "metric": { "type": "string", "enum": ["rx_power_dbm", "tx_power_dbm", "osnr_db", "pre_fec_ber", "post_fec_ber", "q_factor_db", "chromatic_dispersion_ps_nm", "pmd_ps", "amplifier_gain_db"] },
            "value": { "type": "number" },
            "unit": { "type": "string" },
            "binIntervalSeconds": { "type": "integer" },
            "slaThreshold": { "type": "number" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "pmId": { "type": "string" },
          "breach": { "type": "boolean" },
          "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
