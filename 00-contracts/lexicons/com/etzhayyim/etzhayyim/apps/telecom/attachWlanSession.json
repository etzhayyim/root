{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.attachWlanSession",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Wi-Fi session attach — bind a UE to a Hotspot 2.0 venue under a Passpoint PPS-MO. UE MAC + assigned IP persisted as sha256 hashes. Single-row lifecycle: releasedAt UPDATEd in place.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["subscriberId", "ppsMoId", "venueId", "rcoiId", "ueMacHash", "eapMethod", "attachedAt"],
          "properties": {
            "sessionId": { "type": "string" },
            "subscriberId": { "type": "string" },
            "ppsMoId": { "type": "string" },
            "venueId": { "type": "string" },
            "rcoiId": { "type": "string" },
            "ueMacHash": { "type": "string" },
            "eapMethod": { "type": "string", "enum": ["EAP-SIM", "EAP-AKA", "EAP-AKA-prime", "EAP-TLS", "EAP-TTLS", "EAP-PEAP"] },
            "ipAssignment": { "type": "string", "enum": ["dhcp_v4", "slaac_v6", "dual_stack", "ipv6_only", "static"] },
            "attachedAt": { "type": "string", "format": "datetime" },
            "releasedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "sessionId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
