{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.escalateSlaBreach",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record an SLA / QoS breach against a provisioned service and open an escalation ticket.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["serviceId", "breachType", "severity", "observedAt"],
          "properties": {
            "serviceId": { "type": "string" },
            "breachType": { "type": "string", "enum": ["latency", "packet_loss", "throughput", "availability", "jitter"] },
            "severity": { "type": "string", "enum": ["minor", "major", "critical"] },
            "metric": { "type": "string" },
            "observedValue": { "type": "number" },
            "slaThreshold": { "type": "number" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "breachId": { "type": "string" },
            "ticketId": { "type": "string" },
            "status": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
