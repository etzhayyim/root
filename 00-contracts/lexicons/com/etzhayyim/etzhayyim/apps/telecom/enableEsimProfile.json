{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.enableEsimProfile",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Enable an installed eSIM profile on eUICC (GSMA SGP.22 §3.2). Records state transition to 'enabled'. EID/ICCID sha256: hashed.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["operationId", "eid", "iccid"],
          "properties": {
            "operationId": { "type": "string" },
            "eid": { "type": "string", "description": "sha256: hashed EID" },
            "iccid": { "type": "string", "description": "sha256: hashed ICCID" },
            "refreshFlag": { "type": "boolean", "description": "Send REFRESH after enable" },
            "observedAt": { "type": "string", "format": "datetime" },
            "callerDid": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "iccid": { "type": "string" },
            "status": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
