{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.recordTapFile",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a TAP 3.12 batch file aggregate (counts + total charge per file). Per-call detail rows go to recordInterconnectCdr.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["partnerId", "fileType", "fileSequence", "transferDate", "totalCharge", "currency"],
          "properties": {
            "tapFileId": { "type": "string" },
            "partnerId": { "type": "string" },
            "fileType": { "type": "string", "enum": ["tap", "rap", "iot", "nrtrde"] },
            "fileSequence": { "type": "integer" },
            "transferDate": { "type": "string", "format": "date" },
            "voiceUnits": { "type": "number" },
            "smsUnits": { "type": "number" },
            "dataUnits": { "type": "number" },
            "totalCharge": { "type": "number" },
            "currency": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "tapFileId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
