{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.healVnf",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "VNFM — heal a VNF (restart / re-instantiate / live-migrate). alarmVid may reference a Phase 7 alarm.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["vnfId", "healCause", "healKind", "observedAt"],
          "properties": {
            "healEventId": { "type": "string" },
            "vnfId": { "type": "string" },
            "healCause": { "type": "string", "enum": ["sw_failure", "hw_failure", "sla_breach", "operator_request", "alarm_correlation", "policy"] },
            "healKind": { "type": "string", "enum": ["restart", "reinstantiate", "live_migrate", "snapshot_rollback"] },
            "alarmVid": { "type": "string" },
            "recreateAffectedInstances": { "type": "boolean" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "healEventId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
