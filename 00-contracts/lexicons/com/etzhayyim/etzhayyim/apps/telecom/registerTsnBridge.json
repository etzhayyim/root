{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.telecom.registerTsnBridge",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a TSN bridge / endpoint in a domain. attachedAssetId may reference a Phase 2 networkAsset for inventory linkage.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["domainId", "vendor", "model", "bridgeKind", "portCount", "supportedShapers", "observedAt"],
          "properties": {
            "bridgeId": { "type": "string" },
            "domainId": { "type": "string" },
            "vendor": { "type": "string" },
            "model": { "type": "string" },
            "bridgeKind": { "type": "string", "enum": ["endpoint_talker", "endpoint_listener", "endpoint_dual", "transit_bridge", "edge_bridge", "tsn_du_translator", "tsn_5g_aware"] },
            "portCount": { "type": "integer" },
            "supportedShapers": { "type": "array", "items": { "type": "string", "enum": ["cbs", "tas", "ats", "strict_priority", "qci", "frame_preemption"] } },
            "supportsFrer": { "type": "boolean" },
            "supportsSrp": { "type": "boolean" },
            "attachedAssetId": { "type": "string" },
            "observedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": {
          "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
          "bridgeId": { "type": "string" }, "status": { "type": "string" },
          "instanceKey": { "type": "integer" }, "error": { "type": "string" }
        } }
      }
    }
  }
}
