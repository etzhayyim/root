{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.digitalIdentity.registerCredentialSchema",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "EUDI ARF / ISO 18013-5 mDL / W3C VC schema registry (bridges ai-governance + cyber-compliance)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "schemaId",
            "format",
            "framework",
            "credentialType",
            "publishedAt"
          ],
          "properties": {
            "schemaId": {
              "type": "string"
            },
            "format": {
              "type": "string",
              "enum": [
                "mso_mdoc",
                "sd_jwt_vc",
                "jwt_vc",
                "ldp_vc",
                "hmac_vc"
              ]
            },
            "framework": {
              "type": "string",
              "enum": [
                "eudi",
                "mdl",
                "verifiable_credential",
                "open_id4vc",
                "oid4vp",
                "dif_presentation"
              ]
            },
            "issuerLei": {
              "type": "string"
            },
            "governingJurisdictionIso3": {
              "type": "string"
            },
            "credentialType": {
              "type": "string",
              "enum": [
                "pid",
                "mdl",
                "residence",
                "diploma",
                "professional_license",
                "health",
                "bank_account"
              ]
            },
            "pqcReady": {
              "type": "boolean"
            },
            "publishedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}