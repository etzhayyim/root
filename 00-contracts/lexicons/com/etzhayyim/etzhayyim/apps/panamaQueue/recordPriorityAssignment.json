{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.panamaQueue.recordPriorityAssignment",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "優先通航指定",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "assignmentId",
            "imo",
            "priorityClass",
            "assignedSlotDate",
            "assignedAt"
          ],
          "properties": {
            "assignmentId": {
              "type": "string"
            },
            "imo": {
              "type": "string"
            },
            "priorityClass": {
              "type": "string",
              "enum": [
                "humanitarian",
                "perishable",
                "cruise",
                "lng",
                "regular"
              ]
            },
            "reason": {
              "type": "string"
            },
            "assignedSlotDate": {
              "type": "string",
              "format": "date"
            },
            "assignedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "requireBroadcast": {
              "type": "boolean"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
