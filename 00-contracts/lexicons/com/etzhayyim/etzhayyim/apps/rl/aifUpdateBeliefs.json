{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.rl.aifUpdateBeliefs",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Active Inference Phase 1B — update beliefs q(s) and compute Expected Free Energy G(a) for new rl_step rows. Runs hourly via BPMN contract timer BPMN.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "batch_size": {
              "type": "integer",
              "description": "Steps to process per (actor_did, action_nsid) per invocation",
              "default": 50
            },
            "max_actors": {
              "type": "integer",
              "description": "Maximum (actor_did, action_nsid) pairs to process per invocation",
              "default": 20
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "actors_processed": { "type": "integer" },
            "total_beliefs": { "type": "integer" }
          }
        }
      }
    }
  }
}
