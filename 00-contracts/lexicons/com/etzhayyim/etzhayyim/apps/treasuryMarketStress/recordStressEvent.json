{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.treasuryMarketStress.recordStressEvent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "US Treasury market stress event / basis trade unwind (bridges marginCall.flagFailure + nbfi-stress + ccp-oversight)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "eventId",
            "stressKind",
            "depthImpactLevel",
            "detectedAt"
          ],
          "properties": {
            "eventId": {
              "type": "string"
            },
            "stressKind": {
              "type": "string",
              "enum": [
                "basis_trade_unwind",
                "swap_spread_blow",
                "dash_for_cash",
                "on_run_off_run_widen",
                "srf_activation",
                "bond_liquidity_gap",
                "mbs_basis",
                "bid_ask_widen",
                "cbb_sofr_arm_spike",
                "atr_spike",
                "repo_mmt_spike"
              ]
            },
            "depthImpactLevel": {
              "type": "string",
              "enum": [
                "tolerable",
                "elevated",
                "impaired",
                "crisis",
                "systemic"
              ]
            },
            "marginCallVid": {
              "type": "string",
              "description": "bridges marginCall.flagFailure"
            },
            "detectedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}