{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.advanceTaxRuling.flagMap",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Mutual Agreement Procedure MAP case (bridges sovereign-debt + global-tax + tax-transparency)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "mapId",
            "jurisdictionsInvolved",
            "issueCategory",
            "openingDate",
            "reportedAt"
          ],
          "properties": {
            "mapId": {
              "type": "string"
            },
            "apaVid": {
              "type": "string",
              "description": "bridges recordApa"
            },
            "jurisdictionsInvolved": {
              "type": "string",
              "description": "comma ISO3"
            },
            "issueCategory": {
              "type": "string",
              "enum": [
                "transfer_pricing",
                "treaty_interpretation",
                "dividends_interest",
                "permanent_establishment",
                "withholding",
                "pillar2"
              ]
            },
            "openingDate": {
              "type": "string"
            },
            "closureStatus": {
              "type": "string",
              "enum": [
                "pending",
                "agreed",
                "withdrawn",
                "arbitration",
                "denied"
              ]
            },
            "resolutionMonths": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "complexityTier": {
              "type": "string",
              "enum": [
                "rapid",
                "standard",
                "prolonged"
              ]
            }
          }
        }
      }
    }
  }
}