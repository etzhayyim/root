{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.vehicle.planSupplyProcess",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Plan automotive material procurement, intermediate manufacturing, responsible party, legal entity, person, and patent graph edges.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "processId": { "type": "string" },
            "packageId": { "type": "string" },
            "vehicleProgram": { "type": "string" },
            "materialId": { "type": "string" },
            "intermediateId": { "type": "string" },
            "lei": { "type": "string" },
            "personVid": { "type": "string" },
            "patentPubNumber": { "type": "string" }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "accepted": { "type": "boolean" },
            "processId": { "type": "string" },
            "materialVertex": { "type": "string" },
            "intermediateVertex": { "type": "string" },
            "responsibilityVertex": { "type": "string" },
            "nextEdges": { "type": "array", "items": { "type": "string" } },
            "note": { "type": "string" }
          },
          "required": ["accepted", "processId"]
        }
      }
    }
  }
}
