{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.whistleblowerProtect.flagRetaliation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Retaliation / reprisal against whistleblower (bridges genderInclusion.flagHarassment + worker-grievance + civil-liability)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "disclosureVid",
            "retaliationKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "disclosureVid": {
              "type": "string",
              "description": "bridges recordDisclosure"
            },
            "retaliationKind": {
              "type": "string",
              "enum": [
                "termination",
                "demotion",
                "pay_cut",
                "blacklisting",
                "threats",
                "smear_campaign",
                "counterclaim_suit",
                "criminal_charge",
                "visa_cancellation",
                "nda_weaponized",
                "immigration_pressure",
                "professional_license"
              ]
            },
            "remedySought": {
              "type": "string",
              "enum": [
                "reinstatement",
                "double_back_pay",
                "bounty",
                "injunction",
                "protective_order",
                "asylum",
                "passport"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}