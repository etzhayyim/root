{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ingest.backfill",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Start a bounded backfill ingest run with an explicit source range.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ingestFamily", "sourceId", "range"],
          "properties": {
            "ingestFamily": { "type": "string" },
            "sourceId": { "type": "string" },
            "range": { "type": "string", "description": "Required JSON range selector; unbounded backfills are rejected." },
            "limit": { "type": "integer" },
            "requestedBy": { "type": "string" },
            "inputJson": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "runId": { "type": "string" },
            "runVertexId": { "type": "string" },
            "langserverRunKey": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
