{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ingest.status",
  "defs": {
    "main": {
      "type": "query",
      "description": "Read durable ingest run status from vertex_ingest_run and related cursor/artifact rows.",
      "parameters": {
        "type": "params",
        "properties": {
          "runId": { "type": "string" },
          "ingestFamily": { "type": "string" },
          "sourceId": { "type": "string" },
          "status": { "type": "string" },
          "limit": { "type": "integer" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "runs": { "type": "array", "items": { "type": "unknown" } },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
