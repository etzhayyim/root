{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ingest.plan",
  "defs": {
    "main": {
      "type": "query",
      "description": "Dry-run an ingest plan: source selection, shard count, estimated records, and write targets. Does not mutate source cursors or graph rows.",
      "parameters": {
        "type": "params",
        "required": ["ingestFamily", "sourceId"],
        "properties": {
          "ingestFamily": { "type": "string", "description": "Domain family such as houbun, contracts, domain, maps, patent, workspace, media, talent." },
          "sourceId": { "type": "string", "description": "Source identifier such as egov-jpn, govinfo-cfr, eurlex, uspto-patentsview." },
          "mode": { "type": "string", "description": "delta, backfill, repair, or verify." },
          "range": { "type": "string", "description": "Optional JSON range/cursor selector." },
          "limit": { "type": "integer", "description": "Optional maximum planned records or shards." }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "ingestFamily", "sourceId"],
          "properties": {
            "ok": { "type": "boolean" },
            "ingestFamily": { "type": "string" },
            "sourceId": { "type": "string" },
            "mode": { "type": "string" },
            "estimatedShards": { "type": "integer" },
            "estimatedRecords": { "type": "integer" },
            "targets": { "type": "array", "items": { "type": "string" } },
            "planJson": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
