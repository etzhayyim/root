{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ingest.pause",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Pause an ingest run or source cursor. Active POD-side LangServer work should observe the paused state before taking the next shard.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "runId": { "type": "string" },
            "ingestFamily": { "type": "string" },
            "sourceId": { "type": "string" },
            "reason": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "paused": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
