{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.depositInsurance.recordScheme",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Deposit insurance scheme (FDIC / DGS / IADI — bridges bankResolution.flagBailInDispute + banking-account + sovereign-guarantee)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "schemeId",
            "schemeKind",
            "countryIso3",
            "effectiveAt"
          ],
          "properties": {
            "schemeId": {
              "type": "string"
            },
            "schemeKind": {
              "type": "string",
              "enum": [
                "fdic",
                "fslic_legacy",
                "eu_dgsd",
                "uk_fscs",
                "jp_dic",
                "ca_cdic",
                "au_fcs",
                "mx_ipab",
                "br_fgc",
                "cn_dis",
                "ru_asv",
                "sg_sdic",
                "kr_kdic",
                "in_dicgc"
              ]
            },
            "countryIso3": {
              "type": "string"
            },
            "coverageLimitUsd": {
              "type": "number"
            },
            "bailInVid": {
              "type": "string",
              "description": "bridges bankResolution.flagBailInDispute"
            },
            "effectiveAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}