{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.religiousFreedom.flagPersecutionEvent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Persecution event / attack / closure (bridges press-freedom + forced-labor + refugee-unhcr)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "eventId",
            "targetGroup",
            "eventKind",
            "reportedAt"
          ],
          "properties": {
            "eventId": {
              "type": "string"
            },
            "recordVid": {
              "type": "string",
              "description": "bridges recordRegistry"
            },
            "targetGroup": {
              "type": "string"
            },
            "eventKind": {
              "type": "string",
              "enum": [
                "attack",
                "arrest",
                "closure",
                "property_destruction",
                "restriction_worship",
                "conversion_ban",
                "blasphemy_prosecution",
                "genocide_allegation"
              ]
            },
            "victimCount": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "serious",
                "severe",
                "critical"
              ]
            }
          }
        }
      }
    }
  }
}