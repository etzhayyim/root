{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ransomwatch.listGroups",
  "defs": {
    "main": {
      "type": "query",
      "description": "List tracked ransomware groups with sanitized public metadata (TLP:WHITE).",
      "parameters": {
        "type": "params",
        "properties": {
          "status":   { "type": "string" },
          "offset":   { "type": "integer", "default": 0 },
          "limit":    { "type": "integer", "default": 50, "maximum": 100 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["groups", "total", "offset", "limit"],
          "properties": {
            "groups": { "type": "array", "items": { "type": "unknown" } },
            "total":  { "type": "integer" },
            "offset": { "type": "integer" },
            "limit":  { "type": "integer" }
          }
        }
      }
    }
  }
}
