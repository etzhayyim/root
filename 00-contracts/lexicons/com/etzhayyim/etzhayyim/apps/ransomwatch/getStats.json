{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.ransomwatch.getStats",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get aggregate ransomwatch statistics (TLP:WHITE).",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["totalGroups", "activeGroups", "totalPosts", "newPostsLast24h"],
          "properties": {
            "totalGroups":       { "type": "integer" },
            "activeGroups":      { "type": "integer" },
            "totalPosts":        { "type": "integer" },
            "newPostsLast24h":   { "type": "integer" }
          }
        }
      }
    }
  }
}
