{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.patent.list",
  "defs": {
    "main": {
      "type": "query",
      "description": "List patents with optional jurisdiction / IPC section / IPC prefix / CPC prefix filter.",
      "parameters": {
        "type": "params",
        "properties": {
          "jurisdiction": {"type": "string"},
          "ipcSection": {"type": "string", "enum": ["A","B","C","D","E","F","G","H"]},
          "ipcPrefix": {"type": "string", "description": "IPC prefix such as B64, F01, F02K"},
          "cpcPrefix": {"type": "string", "description": "CPC prefix such as B64C, F02K, Y02T"},
          "cpcYSection": {"type": "string", "enum": ["Y02","Y04","Y10"]},
          "offset": {"type": "integer", "default": 0, "minimum": 0},
          "limit": {"type": "integer", "default": 50, "minimum": 1, "maximum": 200}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items", "offset", "limit", "total"],
          "properties": {
            "items": {"type": "array", "items": {"type": "unknown"}},
            "offset": {"type": "integer"},
            "limit": {"type": "integer"},
            "total": {"type": "integer"}
          }
        }
      }
    }
  }
}
