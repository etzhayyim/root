{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.patent.coverage",
  "defs": {
    "main": {
      "type": "query",
      "description": "Patent coverage by jurisdiction with IPC section / CPC Y-section histograms.",
      "parameters": {
        "type": "params",
        "properties": {"jurisdiction": {"type": "string"}}
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["jurisdiction", "total", "status", "reportedAt"],
          "properties": {
            "jurisdiction": {"type": "string"},
            "total": {"type": "integer"},
            "status": {"type": "object", "properties": {"granted": {"type": "integer"}, "published": {"type": "integer"}, "pending": {"type": "integer"}}},
            "grantRate": {"type": "number"},
            "byIpcSection": {"type": "unknown"},
            "byCpcYSection": {"type": "unknown"},
            "reportedAt": {"type": "string", "format": "datetime"}
          }
        }
      }
    }
  }
}
