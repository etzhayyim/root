        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "actionId",
            "bureau",
            "actionKind",
            "issuedAt"
          ],
          "properties": {
            "actionId": {
              "type": "string"
            },
            "bureau": {
              "type": "string",
              "enum": [
                "honsho",
                "infra",
                "road",
                "river",
                "ports",
                "aviation",
                "rail",
                "public_transport",
                "jma_meteorology",
                "mlit_kaijou_jcg_jcga",
                "tourism_jnto",
                "city_planning",
                "housing_construction",
                "kintai_emergency"
              ]
            },
            "actionKind": {
              "type": "string",
              "enum": [
                "aviation_law_amend",
                "slot_allocation",
                "new_runway",
                "port_expansion",
                "road_act",
                "river_basic_plan",
                "rail_law_amend",
                "shinkansen_extension",
                "linear_chuo",
                "disaster_recovery",
                "tourism_policy",
                "building_code_revise",
                "energy_efficiency_building",
                "public_transport_act",
                "jma_alert_revise",
                "jcga_coast_guard_strategy"
              ]
            },
            "relatedActorVid": {
              "type": "string",
              "description": "bridges airportHanedaOps / airportNaritaOps / railLine"
            },
            "issuedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}