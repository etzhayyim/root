{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.flightOffer.fetchFromSource",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Fetch + persist offers from a specific source registered in vertex_flight_offer_source. Adapter is resolved at runtime via pymagatama.ingest.flight_offer._SOURCE_ADAPTERS keyed by source_id. Falls back to stub if credentials are missing or source is in 'planned' status.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sourceId", "originIata", "destinationIata", "outboundDate"],
          "properties": {
            "sourceId":        { "type": "string", "description": "Matches vertex_flight_offer_source.source_id (amadeus | duffel | kiwi-tequila | travelpayouts-aviasales | ana-ndc | jal-ndc | stub)." },
            "originIata":      { "type": "string", "minLength": 3, "maxLength": 3 },
            "destinationIata": { "type": "string", "minLength": 3, "maxLength": 3 },
            "outboundDate":    { "type": "string", "format": "datetime" },
            "returnDate":      { "type": "string", "format": "datetime" },
            "currency":        { "type": "string", "minLength": 3, "maxLength": 3 },
            "maxOffers":       { "type": "integer", "minimum": 1, "maximum": 50 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok":              { "type": "boolean" },
            "sourceId":        { "type": "string" },
            "resolvedSource":  { "type": "string", "description": "Actual adapter used (may be 'stub' if requested source had no creds)." },
            "offersFetched":   { "type": "integer" },
            "offersWritten":   { "type": "integer" },
            "providerObservedAt": { "type": "string" },
            "error":           { "type": "string" }
          }
        }
      }
    }
  }
}
