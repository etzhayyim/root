{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.flightOffer.listSources",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "List rows from vertex_flight_offer_source. Each row also reports `credentialsAvailable` (env vars present in the worker pod) and `adapterRegistered` (function present in _SOURCE_ADAPTERS).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "description": "Filter by status (active | stub | planned). Empty = all." },
            "limit":  { "type": "integer", "minimum": 1, "maximum": 500 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok":    { "type": "boolean" },
            "count": { "type": "integer" },
            "items": { "type": "array", "items": { "type": "object" } },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
