{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.flightOffer.cleanupRuns",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Delete vertex_flight_offer_source_run rows older than retentionDays. Triggered by the R/PT24H timer-start BPMN; also exposed as XRPC for ad-hoc invocation.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "retentionDays": { "type": "integer", "minimum": 1, "maximum": 365, "description": "Rows with observed_at older than now - retentionDays are deleted (default 90)." }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok":             { "type": "boolean" },
            "deleted":        { "type": "integer" },
            "cutoffAt":       { "type": "string" },
            "retentionDays":  { "type": "integer" },
            "error":          { "type": "string" }
          }
        }
      }
    }
  }
}
