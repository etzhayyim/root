        "required": ["vertexId"],
        "properties": {
          "vertexId": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "batch": { "type": "object" }
          }
        }
      }
    }
  }
}
