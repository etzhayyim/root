{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openSeiyaku.purge",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Purge confidential open-seiyaku payloads after retention expiry and mark Tier 1 rows as purged.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "asOf": { "type": "string" },
            "dryRun": { "type": "boolean", "default": false }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "purgedCount": { "type": "integer" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
