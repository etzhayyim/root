{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openSeiyaku.startBatchRecord",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Begin a new open-seiyaku batch-record workflow. Starts BPMN process seiyaku_register_batch.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "manufacturerOrgId": { "type": "string" },
            "plantOrgId": { "type": "string" },
            "productCode": { "type": "string" },
            "batchNumber": { "type": "string" }
          },
          "required": ["manufacturerOrgId", "plantOrgId", "productCode", "batchNumber"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
