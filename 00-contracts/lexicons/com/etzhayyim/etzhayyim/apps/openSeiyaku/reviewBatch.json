{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openSeiyaku.reviewBatch",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "QA review verdict for an open-seiyaku batch.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "vertexId": { "type": "string" },
            "verdict": { "type": "string", "enum": ["approve", "reject"] },
            "comment": { "type": "string" }
          },
          "required": ["vertexId", "verdict"]
        }
      }
    }
  }
}
