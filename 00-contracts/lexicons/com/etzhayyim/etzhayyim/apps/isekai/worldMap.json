{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.isekai.worldMap",
  "defs": {
    "main": {
      "type": "record",
      "description": "ISEKAI world map root (ADR-0040). Top-level record that owns a bag of worldScene placements. Federable.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["name", "widthM", "heightM", "seed", "createdAt"],
        "properties": {
          "name": { "type": "string", "maxLength": 128 },
          "widthM": { "type": "integer", "minimum": 16, "maximum": 10000 },
          "heightM": { "type": "integer", "minimum": 16, "maximum": 10000 },
          "seed": { "type": "integer" },
          "biomeMaskCid": { "type": "string" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
