{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.marginCall.recordMarginCall",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Counterparty margin call / treasury liquidity demand (bridges ccpOversight.flagProcyclicality + banking-ledger-entry + liquidity-facility)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "callId",
            "callKind",
            "issuedAt"
          ],
          "properties": {
            "callId": {
              "type": "string"
            },
            "debtorLei": {
              "type": "string"
            },
            "creditorLei": {
              "type": "string"
            },
            "callKind": {
              "type": "string",
              "enum": [
                "variation_margin",
                "initial_margin",
                "intraday",
                "end_of_day",
                "stress_call",
                "pfe_add_on",
                "csa_driven",
                "exchange_forced",
                "dispute_pending",
                "lci_facility",
                "terminated_netting"
              ]
            },
            "procyclicalityVid": {
              "type": "string",
              "description": "bridges ccpOversight.flagProcyclicality"
            },
            "amountBusd": {
              "type": "number"
            },
            "issuedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}