{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.itpgrfaSeeds.logSmtaTransfer",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Standard Material Transfer Agreement (benefit-sharing monetary + non-monetary)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "transferId",
            "accessionVid",
            "recipientCountryIso3",
            "intendedUse",
            "transferredAt"
          ],
          "properties": {
            "transferId": {
              "type": "string"
            },
            "accessionVid": {
              "type": "string",
              "description": "bridges recordAccession"
            },
            "providerLei": {
              "type": "string"
            },
            "recipientLei": {
              "type": "string"
            },
            "recipientCountryIso3": {
              "type": "string"
            },
            "intendedUse": {
              "type": "string",
              "enum": [
                "research",
                "breeding",
                "training",
                "commercial_variety"
              ]
            },
            "benefitSharingCommitmentPct": {
              "type": "number"
            },
            "transferredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}