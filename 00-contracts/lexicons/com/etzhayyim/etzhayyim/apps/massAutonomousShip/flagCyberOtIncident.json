{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.massAutonomousShip.flagCyberOtIncident",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "MASS cyber / OT incident (bridges cyber-incident + maritime-piracy + quantum-safe-crypto)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "incidentId",
            "certificationVid",
            "incidentKind",
            "reportedAt"
          ],
          "properties": {
            "incidentId": {
              "type": "string"
            },
            "certificationVid": {
              "type": "string",
              "description": "bridges certifyAutonomyLevel"
            },
            "incidentKind": {
              "type": "string",
              "enum": [
                "gps_spoofing",
                "ais_manipulation",
                "ot_intrusion",
                "c2_loss",
                "ml_model_drift",
                "sensor_tamper",
                "ransomware"
              ]
            },
            "cyberIncidentVid": {
              "type": "string",
              "description": "bridges open-cyber-incident"
            },
            "impactDescription": {
              "type": "string"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "operational",
                "severe",
                "critical"
              ]
            }
          }
        }
      }
    }
  }
}