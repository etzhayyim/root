{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.koke.fixSignal",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Primary fixation: capture a raw external signal (CO₂) into a structured vertex_koke_fixation row (glucose). Reversible until handoff to hakkou.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "inputKind": { "type": "string", "description": "Signal kind: text | url | record | stream" },
            "rawRef": { "type": "string", "description": "Raw reference or content to fix" },
            "agentDid": { "type": "string", "description": "DID of the kobo agent requesting fixation (optional)" }
          },
          "required": ["inputKind", "rawRef"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "fixationId": { "type": "string" },
            "vertexId": { "type": "string" },
            "signalHash": { "type": "string" },
            "status": { "type": "string" },
            "error": { "type": "string" }
          },
          "required": ["fixationId", "status"]
        }
      }
    }
  }
}
