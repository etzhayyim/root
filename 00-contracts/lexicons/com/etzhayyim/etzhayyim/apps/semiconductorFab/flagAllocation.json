{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.semiconductorFab.flagAllocation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Allocation window / shortage allocation (tariff + export-control bridge)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "allocationId",
            "fabVid",
            "productLine",
            "allocatedPct",
            "flaggedAt"
          ],
          "properties": {
            "allocationId": {
              "type": "string"
            },
            "fabVid": {
              "type": "string",
              "description": "bridges recordCapacity"
            },
            "customerLei": {
              "type": "string"
            },
            "productLine": {
              "type": "string"
            },
            "allocatedPct": {
              "type": "number",
              "description": "% of requested"
            },
            "waitWeeks": {
              "type": "integer"
            },
            "rootCause": {
              "type": "string",
              "enum": [
                "euv_constraint",
                "rare_gas",
                "substrate",
                "packaging",
                "ate",
                "labor"
              ]
            },
            "ustrActionVid": {
              "type": "string",
              "description": "bridges open-ustr-section-301"
            },
            "mofcomControlVid": {
              "type": "string",
              "description": "bridges open-mofcom-export-control"
            },
            "flaggedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "scarcityTier": {
              "type": "string",
              "enum": [
                "tight",
                "constrained",
                "severe"
              ]
            }
          }
        }
      }
    }
  }
}