{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.sbtnTarget.flagMiss",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "SBTN miss / withdrawal / boundary violation (bridges tnfdDisclosure.flagGreenwash + climate-value-chain + consumer-protection)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "targetVid",
            "missKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "targetVid": {
              "type": "string",
              "description": "bridges recordTarget"
            },
            "missKind": {
              "type": "string",
              "enum": [
                "target_withdrawn",
                "behind_trajectory",
                "baseline_revised",
                "scope_3_excluded",
                "absolute_cap_breach",
                "ar5_ar6_drift",
                "water_basin_exceed",
                "scenario_inconsistent",
                "offset_reliance",
                "renewed_non_committed"
              ]
            },
            "deltaPct": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}