{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.satelliteEvidence.recordImagery",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Satellite / SAR imagery for human rights documentation (bridges inquiryCommission.flagAccessDenial + ais-dark-vessel + poc-ihl)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "imageryId",
            "regionName",
            "sensorKind",
            "evidenceKind",
            "acquiredAt"
          ],
          "properties": {
            "imageryId": {
              "type": "string"
            },
            "regionName": {
              "type": "string"
            },
            "sensorKind": {
              "type": "string",
              "enum": [
                "sentinel_1_sar",
                "sentinel_2_optical",
                "sentinel_3",
                "planet_skysat",
                "maxar_worldview",
                "airbus_pleiades",
                "capella_sar",
                "iceye_sar",
                "umbra_sar",
                "cloud_optical",
                "viirs_thermal",
                "msl_landsat"
              ]
            },
            "evidenceKind": {
              "type": "string",
              "enum": [
                "mass_grave",
                "destruction_residential",
                "camp_construction",
                "forced_displacement",
                "crop_burning",
                "prison_construction",
                "extraction_mining",
                "deforestation",
                "oil_spill",
                "ais_dark_vessel",
                "blockade",
                "factory_emission_signature"
              ]
            },
            "accessDenialVid": {
              "type": "string",
              "description": "bridges inquiryCommission.flagAccessDenial"
            },
            "acquiredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}