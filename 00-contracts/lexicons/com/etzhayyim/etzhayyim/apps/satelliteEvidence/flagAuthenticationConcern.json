{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.satelliteEvidence.flagAuthenticationConcern",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Imagery authentication / chain-of-custody / data-poisoning (bridges inquiryCommission.flagAccessDenial + civil-liability + classification-review)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "imageryVid",
            "concernKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "imageryVid": {
              "type": "string",
              "description": "bridges recordImagery"
            },
            "concernKind": {
              "type": "string",
              "enum": [
                "timestamp_dispute",
                "resolution_inadequate",
                "metadata_tampered",
                "cloud_cover",
                "geolocation_error",
                "comparison_baseline",
                "missing_imagery",
                "sensor_calibration",
                "data_poisoning_synthetic",
                "classification_redaction",
                "commercial_provider_pressure",
                "sovereign_block"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}