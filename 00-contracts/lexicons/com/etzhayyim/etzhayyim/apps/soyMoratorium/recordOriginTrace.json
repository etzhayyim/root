{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.soyMoratorium.recordOriginTrace",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Amazon / Cerrado soy moratorium origin trace (bridges feedProvenance.flagFeedLinkage + eudr-deforestation + forestry-mrv)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "traceId",
            "lotCode",
            "biome",
            "complianceKind",
            "tracedAt"
          ],
          "properties": {
            "traceId": {
              "type": "string"
            },
            "lotCode": {
              "type": "string"
            },
            "originMuniIbge": {
              "type": "string",
              "description": "IBGE municipality code"
            },
            "biome": {
              "type": "string",
              "enum": [
                "amazon",
                "cerrado",
                "atlantic_forest",
                "pantanal",
                "caatinga",
                "pampa",
                "chaco_argentine",
                "chaco_paraguay",
                "gran_chaco_bolivia"
              ]
            },
            "complianceKind": {
              "type": "string",
              "enum": [
                "compliant_pre_2008",
                "compliant_pre_2020",
                "non_compliant",
                "in_review",
                "unmapped",
                "embargo_ibama",
                "pra_pending"
              ]
            },
            "feedLinkageVid": {
              "type": "string",
              "description": "bridges feedProvenance.flagFeedLinkage"
            },
            "volumeTonnes": {
              "type": "number"
            },
            "tracedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}