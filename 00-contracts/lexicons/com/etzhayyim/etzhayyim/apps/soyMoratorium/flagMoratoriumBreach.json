{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.soyMoratorium.flagMoratoriumBreach",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Soy moratorium / forest code breach (bridges feedProvenance.flagFeedLinkage + eudr-deforestation + climate-value-chain)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "breachId",
            "traceVid",
            "breachKind",
            "reportedAt"
          ],
          "properties": {
            "breachId": {
              "type": "string"
            },
            "traceVid": {
              "type": "string",
              "description": "bridges recordOriginTrace"
            },
            "breachKind": {
              "type": "string",
              "enum": [
                "post_cutoff_clearance",
                "illegal_embargo_area",
                "indigenous_overlap",
                "conservation_unit",
                "legal_reserve_deficit",
                "permanent_preservation_area",
                "laundering_cattle_soy",
                "undocumented"
              ]
            },
            "affectedHectares": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}