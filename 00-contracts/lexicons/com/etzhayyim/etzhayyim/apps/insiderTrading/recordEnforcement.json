{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.insiderTrading.recordEnforcement",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Insider trading enforcement (SEC / DOJ criminal / international — bridges auditCommitteeOversight.flagIndependenceGap + enforcementAction + securities-investor)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "enforcementId",
            "respondentCategory",
            "jurisdiction",
            "filedAt"
          ],
          "properties": {
            "enforcementId": {
              "type": "string"
            },
            "respondentCategory": {
              "type": "string",
              "enum": [
                "corporate_insider",
                "tipper",
                "tippee",
                "analyst",
                "banker",
                "hedge_fund",
                "political_insider",
                "spouse",
                "friend",
                "political_trade",
                "bond_market_maker",
                "arb",
                "fixed_income_mm"
              ]
            },
            "jurisdiction": {
              "type": "string",
              "enum": [
                "us_sec",
                "us_doj",
                "uk_fca",
                "jp_sesc",
                "de_bafin",
                "fr_amf",
                "sg_mas",
                "hk_sfc",
                "kr_fss",
                "eu_esma",
                "au_asic",
                "ca_osc",
                "br_cvm",
                "in_sebi",
                "ch_finma"
              ]
            },
            "independenceGapVid": {
              "type": "string",
              "description": "bridges auditCommitteeOversight.flagIndependenceGap"
            },
            "filedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}