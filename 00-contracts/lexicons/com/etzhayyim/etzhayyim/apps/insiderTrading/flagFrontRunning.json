{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.insiderTrading.flagFrontRunning",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Front-running / political-trade / shadow-trade (bridges auditCommitteeOversight.flagIndependenceGap + enforcementAction + ethicsDisclosure)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "enforcementVid",
            "frontKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "enforcementVid": {
              "type": "string",
              "description": "bridges recordEnforcement"
            },
            "frontKind": {
              "type": "string",
              "enum": [
                "pre_public_trade",
                "congressional_stock",
                "pelosi_trade",
                "shadow_trading",
                "doppelganger_security",
                "parked_short",
                "misappropriation",
                "breach_of_duty",
                "hot_hand",
                "insider_etf_skew",
                "nonpublic_tender_offer",
                "merger_arb_pre"
              ]
            },
            "estProfitMusd": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}