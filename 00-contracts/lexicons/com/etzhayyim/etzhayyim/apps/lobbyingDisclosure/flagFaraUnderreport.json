{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.lobbyingDisclosure.flagFaraUnderreport",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "FARA / foreign agent / shadow lobby gap (bridges ethicsDisclosure.flagDisclosureGap + enforcement-action + judicial-influence)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "filingVid",
            "gapKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "filingVid": {
              "type": "string",
              "description": "bridges recordFiling"
            },
            "gapKind": {
              "type": "string",
              "enum": [
                "fara_non_registration",
                "lda_vs_fara",
                "pr_shadow_work",
                "think_tank_pipeline",
                "shell_consultancy",
                "dual_hat",
                "below_threshold_gaming",
                "covert_op",
                "foreign_principal_hidden",
                "domestic_subsidiary"
              ]
            },
            "estimatedValueUsd": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}