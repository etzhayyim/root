{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.civilLiability.flagDispositiveRuling",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Standing / dismissal / class certification / summary judgment (bridges csdddDirective.flagDueDiligenceGap + federal-court-docket.flagInjunction)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "rulingId",
            "claimVid",
            "rulingKind",
            "ruledAt"
          ],
          "properties": {
            "rulingId": {
              "type": "string"
            },
            "claimVid": {
              "type": "string",
              "description": "bridges recordTortClaim"
            },
            "rulingKind": {
              "type": "string",
              "enum": [
                "standing_denied",
                "motion_to_dismiss_granted",
                "class_certified",
                "class_decertified",
                "summary_judgment",
                "settlement_approved",
                "verdict_plaintiff",
                "verdict_defendant",
                "daubert_exclusion",
                "forum_non_conveniens"
              ]
            },
            "totalDamagesMusd": {
              "type": "number"
            },
            "ruledAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}