{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.demining.recordDetection",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a detector hit / EO item find. Coordinates and operator identity are Tier 3. Item classification (APM/ATM/UXO/ERW/CMR/IED) is Tier 2.",
      "x-bootstrap": true,
      "x-sensitivityTier": 3,
      "x-imasRef": ["08.20", "09.10", "09.30"],
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["areaId", "itemType", "detectionMethod"],
          "properties": {
            "areaId": { "type": "string" },
            "itemType": { "type": "string", "enum": ["APM", "ATM", "UXO", "AXO", "ERW", "CMR", "IED", "BAC", "FRAGMENT", "FALSE_POSITIVE"] },
            "detectionMethod": { "type": "string", "enum": ["manual", "metal_detector", "dual_sensor_gpr", "mdd", "mechanical", "visual"] },
            "detectorAssetId": { "type": "string" },
            "operatorDid": { "type": "string", "description": "Tier 3 — stored in Preferences()." },
            "hitCoordsWkt": { "type": "string", "description": "Tier 3 — exact WKT, Preferences() only." },
            "depthCm": { "type": "integer" },
            "disposition": { "type": "string", "enum": ["destroyed_in_situ", "moved_to_cdp", "ongoing", "marked_for_eod"] }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "detectionId": { "type": "string" }
          }
        }
      }
    }
  }
}
