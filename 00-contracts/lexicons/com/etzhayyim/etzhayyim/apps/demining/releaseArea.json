{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.demining.releaseArea",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Land Release decision per IMAS 07.11. This is the ONLY transition that demotes a HazardArea from Tier 3 → Tier 1. Released polygon becomes public on success.",
      "x-bootstrap": true,
      "x-sensitivityTier": 1,
      "x-imasRef": ["07.11", "09.20"],
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["areaId", "releaseMethod", "decidedBy", "decidedAt"],
          "properties": {
            "areaId": { "type": "string" },
            "releaseMethod": { "type": "string", "enum": ["cancellation", "reduction", "clearance"], "description": "IMAS 07.11 distinguishes these three release pathways." },
            "releasedSqm": { "type": "integer" },
            "polygonPublic": { "type": "string", "description": "WKT of released polygon. Public post-release." },
            "qcReportUri": { "type": "string" },
            "decidedBy": { "type": "string", "description": "DID of national mine action authority / accredited operator." },
            "decidedAt": { "type": "string", "format": "date-time" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "decisionId": { "type": "string" },
            "tier": { "type": "integer" }
          }
        }
      }
    }
  }
}
