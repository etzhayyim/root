{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.demining.registerHazardArea",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a Suspected Hazardous Area (SHA) or Confirmed Hazardous Area (CHA) per IMAS 08.10/08.20. Geometry is Tier 3 — stored server-side until Land Release. Only `areaLabel` and bounding admin region are returned publicly.",
      "x-bootstrap": true,
      "x-sensitivityTier": 3,
      "x-imasRef": ["08.10", "08.20"],
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["areaLabel", "status", "imasStage"],
          "properties": {
            "areaLabel": { "type": "string", "description": "Human label (public). No PII, no exact coords." },
            "status": { "type": "string", "enum": ["SHA", "CHA", "UNDER_SURVEY", "UNDER_CLEARANCE", "RELEASED", "CANCELLED"] },
            "imasStage": { "type": "string", "enum": ["nts", "ts", "clearance", "release", "qc"] },
            "adminAreaDid": { "type": "string", "description": "did:web:...:region:{nanoid} of enclosing admin area (public)." },
            "geometryWkt": { "type": "string", "description": "Tier 3 — polygon WKT. Persisted to Preferences() not Repo." },
            "contaminationTypes": { "type": "array", "items": { "type": "string", "enum": ["APM", "ATM", "UXO", "AXO", "ERW", "CMR", "IED", "BAC"] } },
            "estimatedSqm": { "type": "integer" },
            "sourceOfEvidence": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "areaId": { "type": "string" },
            "tier": { "type": "integer" }
          }
        }
      }
    }
  }
}
