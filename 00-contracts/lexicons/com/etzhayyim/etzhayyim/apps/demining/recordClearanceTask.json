{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.demining.recordClearanceTask",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record or advance a clearance task per IMAS 09.10 (manual), 09.40 (MDD), 09.50 (mechanical). Links operators, assets, area.",
      "x-bootstrap": true,
      "x-sensitivityTier": 2,
      "x-imasRef": ["09.10", "09.40", "09.50"],
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["areaId", "method", "phase"],
          "properties": {
            "taskId": { "type": "string" },
            "areaId": { "type": "string" },
            "method": { "type": "string", "enum": ["manual", "mdd", "mechanical", "combined"] },
            "phase": { "type": "string", "enum": ["planned", "in_progress", "qc", "completed", "suspended"] },
            "clearanceDepthCm": { "type": "integer", "description": "Agreed clearance depth per IMAS 09.10." },
            "assetIds": { "type": "array", "items": { "type": "string" } },
            "operatorDids": { "type": "array", "items": { "type": "string" }, "description": "Tier 3 — referenced but not published." },
            "plannedSqm": { "type": "integer" },
            "clearedSqm": { "type": "integer" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "taskId": { "type": "string" }
          }
        }
      }
    }
  }
}
