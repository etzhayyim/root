{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.demining.recordVictim",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a victim for assistance referral per IMAS 13.10 / APMBC Art.6(3). Tier 3 — PII and location never written to public AT Repo. Only de-identified aggregates may be socialized.",
      "x-bootstrap": true,
      "x-sensitivityTier": 3,
      "x-imasRef": ["13.10"],
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["incidentAt", "injuryCategory"],
          "properties": {
            "victimRef": { "type": "string", "description": "Opaque ref (not name). PII resolved only via Preferences()." },
            "incidentAt": { "type": "string", "format": "date-time" },
            "incidentAreaId": { "type": "string" },
            "causeItemType": { "type": "string", "enum": ["APM", "ATM", "UXO", "AXO", "ERW", "CMR", "IED", "UNKNOWN"] },
            "injuryCategory": { "type": "string", "enum": ["fatal", "amputation", "blast_injury", "fragmentation", "burn", "hearing", "psychological", "other"] },
            "ageBand": { "type": "string", "enum": ["under5", "5_17", "18_59", "60plus", "unknown"] },
            "sex": { "type": "string", "enum": ["m", "f", "other", "unknown"] },
            "referralStatus": { "type": "string", "enum": ["pending", "referred", "treated", "rehabilitation", "closed"] },
            "referralOrgDid": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "recordId": { "type": "string" }
          }
        }
      }
    }
  }
}
