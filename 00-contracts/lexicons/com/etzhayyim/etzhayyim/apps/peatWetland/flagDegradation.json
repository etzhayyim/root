{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.peatWetland.flagDegradation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Peat drainage / fire / conversion event",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "eventId",
            "stockVid",
            "driver",
            "detectedAt"
          ],
          "properties": {
            "eventId": {
              "type": "string"
            },
            "stockVid": {
              "type": "string",
              "description": "bridges recordPeatStock"
            },
            "driver": {
              "type": "string",
              "enum": [
                "drainage_agriculture",
                "drainage_palm",
                "fire",
                "extraction",
                "coastal_development",
                "aquaculture",
                "pollution"
              ]
            },
            "hectaresLost": {
              "type": "number"
            },
            "co2eEmittedTonnes": {
              "type": "number"
            },
            "forestryMrvVid": {
              "type": "string",
              "description": "bridges open-forestry-mrv"
            },
            "detectedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}