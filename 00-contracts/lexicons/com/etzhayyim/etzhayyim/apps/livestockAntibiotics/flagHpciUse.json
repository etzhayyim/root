{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.livestockAntibiotics.flagHpciUse",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Highest Priority Critically Important use (WHO CIA list — bridges amr-surveillance + pandemic-preparedness)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "reportVid",
            "hpciaClassName",
            "usagePurpose",
            "flaggedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "reportVid": {
              "type": "string",
              "description": "bridges reportVeterinaryUse"
            },
            "hpciaClassName": {
              "type": "string"
            },
            "usagePurpose": {
              "type": "string",
              "enum": [
                "therapeutic",
                "metaphylaxis",
                "prophylaxis",
                "growth_promotion"
              ]
            },
            "banOrRestricted": {
              "type": "string",
              "enum": [
                "banned",
                "restricted",
                "permitted_limited",
                "permitted"
              ]
            },
            "flaggedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}