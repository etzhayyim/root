{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.aisDarkVessel.flagSanctionsEvasion",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Sanctions / oil embargo / illicit ship-to-ship transfer (bridges portStateMeasures.flagEvasionPattern + ofac-sanctions + hormuz-sts-transfer)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "eventVid",
            "evasionKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "eventVid": {
              "type": "string",
              "description": "bridges recordDarkEvent"
            },
            "evasionKind": {
              "type": "string",
              "enum": [
                "shadow_fleet_iran",
                "shadow_fleet_russia",
                "shadow_fleet_venezuela",
                "sts_transfer",
                "flag_hopping",
                "ais_spoofing",
                "document_forgery",
                "insurance_fraud",
                "price_cap_evasion"
              ]
            },
            "estCargoBarrels": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "riskTier": {
              "type": "string",
              "enum": [
                "moderate",
                "significant",
                "severe"
              ]
            }
          }
        }
      }
    }
  }
}