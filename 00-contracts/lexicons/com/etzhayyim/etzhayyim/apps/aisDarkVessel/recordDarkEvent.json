{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.aisDarkVessel.recordDarkEvent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Global Fishing Watch / Planet Labs AIS dark-vessel event (bridges portStateMeasures.flagEvasionPattern + fisheries-iuu + hormuz)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "eventId",
            "vesselKind",
            "detectionSource",
            "detectedAt"
          ],
          "properties": {
            "eventId": {
              "type": "string"
            },
            "vesselImo": {
              "type": "string"
            },
            "flagStateIso3": {
              "type": "string"
            },
            "vesselKind": {
              "type": "string",
              "enum": [
                "fishing",
                "cargo",
                "tanker",
                "bulk_carrier",
                "reefer",
                "transshipment",
                "military_auxiliary",
                "research",
                "passenger"
              ]
            },
            "detectionSource": {
              "type": "string",
              "enum": [
                "sar_satellite",
                "optical_satellite",
                "vms",
                "port_inspection",
                "witness_report",
                "military_tracking",
                "bluetooth_ais_emulation"
              ]
            },
            "darkDurationHours": {
              "type": "integer"
            },
            "evasionVid": {
              "type": "string",
              "description": "bridges portStateMeasures.flagEvasionPattern"
            },
            "detectedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}