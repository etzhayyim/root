{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openHs.classifyShipment",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Classify a trade shipment by WCO Harmonized System code (6/8/10 digit). Starts BPMN open_hs_classify_shipment.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["shipperOrgId","hsCode","confidence","classifiedAt"],
          "properties": {
            "shipperOrgId":       { "type": "string" },
            "hsCode":             { "type": "string", "description": "6/8/10 digit HS code" },
            "productDescription": { "type": "string" },
            "countryOfOrigin":    { "type": "string" },
            "valueUsd":           { "type": "number" },
            "quantity":           { "type": "number" },
            "unitCode":           { "type": "string" },
            "confidence":         { "type": "number", "minimum": 0, "maximum": 1 },
            "classifiedAt":       { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
            "verification": { "type": "string", "enum": ["authoritative","community","candidate"] },
            "requireReview": { "type": "boolean" },
            "instanceKey": { "type": "integer" }, "error": { "type": "string" }
          }
        }
      }
    }
  }
}
