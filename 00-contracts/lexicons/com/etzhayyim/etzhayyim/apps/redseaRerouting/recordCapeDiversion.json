{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.redseaRerouting.recordCapeDiversion",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "喜望峰迂回",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "diversionId",
            "imo",
            "originalRoute",
            "decidedAt"
          ],
          "properties": {
            "diversionId": {
              "type": "string"
            },
            "imo": {
              "type": "string"
            },
            "originalRoute": {
              "type": "string",
              "enum": [
                "suez-to-europe",
                "suez-to-asia"
              ]
            },
            "additionalDays": {
              "type": "number"
            },
            "additionalCostUsd": {
              "type": "number"
            },
            "bunkerFuelExtraTonnes": {
              "type": "number"
            },
            "decidedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "impactTier": {
              "type": "string",
              "enum": [
                "minor",
                "moderate",
                "major"
              ]
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
