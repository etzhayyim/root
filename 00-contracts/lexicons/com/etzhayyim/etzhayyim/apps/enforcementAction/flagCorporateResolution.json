{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.enforcementAction.flagCorporateResolution",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "DPA / NPA / monitor / compliance obligation flag (bridges federalCourtDocket.flagInjunction + esg-controversy + fcpa)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "actionVid",
            "resolutionKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "actionVid": {
              "type": "string",
              "description": "bridges recordAction"
            },
            "resolutionKind": {
              "type": "string",
              "enum": [
                "dpa_monitor",
                "npa_monitor",
                "consent_decree",
                "compliance_monitor",
                "disgorgement",
                "officer_bar",
                "industry_ban",
                "admission_of_wrongdoing",
                "recidivist",
                "self_disclosure_credit"
              ]
            },
            "monitorTermYears": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}