{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openSwift.registerInstitution",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a SWIFT participant institution (BIC + DID). Starts BPMN open_swift_register_institution.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["bic", "institutionDid", "legalName", "country"],
          "properties": {
            "bic":              { "type": "string" },
            "institutionDid":   { "type": "string" },
            "legalName":        { "type": "string" },
            "country":          { "type": "string", "description": "ISO 3166-1 alpha-2" },
            "settlementAgent":  { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" }, "error": { "type": "string" }
          }
        }
      }
    }
  }
}
