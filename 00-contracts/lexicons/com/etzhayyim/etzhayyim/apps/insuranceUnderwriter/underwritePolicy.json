{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.insuranceUnderwriter.underwritePolicy",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "保険 underwriting (swift+hormuz-warrisk+cyber+lei bridge)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "policyId",
            "underwriterLei",
            "coverType",
            "sumInsuredUsd",
            "premiumUsd",
            "effectiveFrom"
          ],
          "properties": {
            "policyId": {
              "type": "string"
            },
            "underwriterLei": {
              "type": "string"
            },
            "insuredLei": {
              "type": "string"
            },
            "insuredImo": {
              "type": "string"
            },
            "coverType": {
              "type": "string",
              "enum": [
                "hull-marine",
                "cargo-marine",
                "war-risk",
                "cyber",
                "pni"
              ]
            },
            "sumInsuredUsd": {
              "type": "number"
            },
            "premiumUsd": {
              "type": "number"
            },
            "hormuzZoneVid": {
              "type": "string"
            },
            "cyberAuditVid": {
              "type": "string"
            },
            "effectiveFrom": {
              "type": "string",
              "format": "datetime"
            },
            "effectiveUntil": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "riskTier": {
              "type": "string",
              "enum": [
                "standard",
                "elevated",
                "high",
                "declined"
              ]
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
