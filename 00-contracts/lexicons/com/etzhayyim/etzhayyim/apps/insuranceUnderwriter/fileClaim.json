{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.insuranceUnderwriter.fileClaim",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "保険金請求",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "claimId",
            "claimAmountUsd",
            "reportedAt"
          ],
          "properties": {
            "claimId": {
              "type": "string"
            },
            "policyVid": {
              "type": "string"
            },
            "incidentVid": {
              "type": "string"
            },
            "claimAmountUsd": {
              "type": "number"
            },
            "causeCategory": {
              "type": "string"
            },
            "swiftUetr": {
              "type": "string"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "minor",
                "moderate",
                "major",
                "catastrophic"
              ]
            },
            "requireReinsurerNotice": {
              "type": "boolean"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
