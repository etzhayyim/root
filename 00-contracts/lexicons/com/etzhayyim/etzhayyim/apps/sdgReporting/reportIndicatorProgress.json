{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.sdgReporting.reportIndicatorProgress",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Per-indicator SDG progress vs 2030 target (bridges open-sdg / biodiversity-gbf)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "progressId",
            "sdgIndicator",
            "countryIso3",
            "reportedYear",
            "reportedAt"
          ],
          "properties": {
            "progressId": {
              "type": "string"
            },
            "vnrVid": {
              "type": "string",
              "description": "bridges submitVnr"
            },
            "sdgIndicator": {
              "type": "string",
              "description": "e.g. 3.1.1 / 13.2.1"
            },
            "countryIso3": {
              "type": "string"
            },
            "currentValue": {
              "type": "number"
            },
            "targetValue2030": {
              "type": "number"
            },
            "progressPct": {
              "type": "number",
              "description": "% of 2030 target achieved (vs 2015 baseline)"
            },
            "reportedYear": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "progressTier": {
              "type": "string",
              "enum": [
                "regressing",
                "stagnating",
                "progressing_slowly",
                "on_track",
                "achieved"
              ]
            }
          }
        }
      }
    }
  }
}