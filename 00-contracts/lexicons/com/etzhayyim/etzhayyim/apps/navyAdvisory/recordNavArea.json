{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.navyAdvisory.recordNavArea",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "IMO NAVAREA coordinator 更新",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "navareaId",
            "navarea",
            "sequenceNumber",
            "issuedAt"
          ],
          "properties": {
            "navareaId": {
              "type": "string"
            },
            "navarea": {
              "type": "string",
              "description": "NAVAREA IX / X / XI / XII etc (IMO area)"
            },
            "sequenceNumber": {
              "type": "string"
            },
            "subject": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "coordinatorCountry": {
              "type": "string"
            },
            "issuedAt": {
              "type": "string",
              "format": "datetime"
            },
            "cancelAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
