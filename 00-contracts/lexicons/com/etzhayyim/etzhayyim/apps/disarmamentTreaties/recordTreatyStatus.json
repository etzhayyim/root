{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.disarmamentTreaties.recordTreatyStatus",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "NPT / CWC / BWC / CCM / CCW / APMBC / ATT / TPNW status (bridges iaea-safeguards + ofac-sanctions)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "statusId",
            "treaty",
            "partyIso3",
            "statusKind",
            "effectiveFrom"
          ],
          "properties": {
            "statusId": {
              "type": "string"
            },
            "treaty": {
              "type": "string",
              "enum": [
                "npt",
                "cwc",
                "bwc",
                "ccm",
                "ccw",
                "apmbc",
                "att",
                "tpnw",
                "new_start",
                "inf"
              ]
            },
            "partyIso3": {
              "type": "string"
            },
            "statusKind": {
              "type": "string",
              "enum": [
                "signed",
                "ratified",
                "acceded",
                "withdrawn",
                "suspended",
                "not_party",
                "observer"
              ]
            },
            "reservationsDescription": {
              "type": "string"
            },
            "effectiveFrom": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}