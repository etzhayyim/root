{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.mofcomExportControl.publishControl",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "China MOFCOM/MIIT export control listing (bridges critical-minerals + ai-supply-chain)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "controlId",
            "hsCode",
            "licenseType",
            "rationale",
            "publishedAt",
            "effectiveFrom"
          ],
          "properties": {
            "controlId": {
              "type": "string"
            },
            "hsCode": {
              "type": "string"
            },
            "materialClassificationVid": {
              "type": "string",
              "description": "bridges open-critical-minerals"
            },
            "licenseType": {
              "type": "string",
              "enum": [
                "general",
                "targeted",
                "prohibited",
                "dual_use",
                "technology"
              ]
            },
            "targetCountries": {
              "type": "string"
            },
            "rationale": {
              "type": "string",
              "enum": [
                "national_security",
                "retaliatory",
                "technology_transfer",
                "environmental"
              ]
            },
            "publishedAt": {
              "type": "string",
              "format": "datetime"
            },
            "effectiveFrom": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "moderate",
                "severe",
                "critical"
              ]
            }
          }
        }
      }
    }
  }
}