{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.mofcomExportControl.logLicenseApplication",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Applicant log against a MOFCOM control",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "applicationId",
            "controlVid",
            "destinationIso3",
            "appliedAt"
          ],
          "properties": {
            "applicationId": {
              "type": "string"
            },
            "controlVid": {
              "type": "string",
              "description": "bridges publishControl"
            },
            "applicantLei": {
              "type": "string"
            },
            "destinationIso3": {
              "type": "string"
            },
            "volumeRequested": {
              "type": "number"
            },
            "outcome": {
              "type": "string",
              "enum": [
                "granted",
                "denied",
                "pending",
                "withdrawn"
              ]
            },
            "appliedAt": {
              "type": "string",
              "format": "datetime"
            },
            "decidedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}