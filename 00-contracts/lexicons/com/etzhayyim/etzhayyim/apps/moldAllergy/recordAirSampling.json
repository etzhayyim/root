{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.moldAllergy.recordAirSampling",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record a fungal spore air-sampling measurement.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["site"],
          "properties": {
            "site":                   { "type": "string" },
            "sampledAt":              { "type": "string", "format": "datetime" },
            "method":                 { "type": "string" },
            "alternariaCountPerM3":   { "type": "number" },
            "cladosporiumCountPerM3": { "type": "number" },
            "aspergillusCountPerM3":  { "type": "number" },
            "penicilliumCountPerM3":  { "type": "number" },
            "temperatureC":           { "type": "number" },
            "relativeHumidity":       { "type": "number" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sessionId"],
          "properties": { "sessionId": { "type": "string" } }
        }
      }
    }
  }
}
