{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.moldAllergy.listAllergens",
  "defs": {
    "main": {
      "type": "query",
      "description": "List fungal allergen molecules.",
      "parameters": {
        "type": "params",
        "properties": {
          "species": { "type": "string" },
          "limit":   { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
          "offset":  { "type": "integer", "minimum": 0, "default": 0 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["allergens"],
          "properties": {
            "allergens": { "type": "array", "items": { "type": "unknown" } },
            "total":     { "type": "integer" },
            "offset":    { "type": "integer" },
            "limit":     { "type": "integer" }
          }
        }
      }
    }
  }
}
