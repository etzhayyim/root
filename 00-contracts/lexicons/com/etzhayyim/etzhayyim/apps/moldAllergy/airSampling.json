{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.moldAllergy.airSampling",
  "defs": {
    "main": {
      "type": "record",
      "description": "Fungal spore air-sampling session (Burkard / MAS-100). Tier 1 public.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["sessionId", "site", "sampledAt"],
        "properties": {
          "sessionId":              { "type": "string" },
          "site":                   { "type": "string", "description": "sampling location (geohash / address)" },
          "sampledAt":              { "type": "string", "format": "datetime" },
          "method":                 { "type": "string", "description": "Burkard / MAS-100 / Andersen" },
          "alternariaCountPerM3":   { "type": "number" },
          "cladosporiumCountPerM3": { "type": "number" },
          "aspergillusCountPerM3":  { "type": "number" },
          "penicilliumCountPerM3":  { "type": "number" },
          "temperatureC":           { "type": "number" },
          "relativeHumidity":       { "type": "number" },
          "actorId":                { "type": "string" }
        }
      }
    }
  }
}
