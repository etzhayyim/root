{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.euDgClima.recordAction",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "EU DG Climate Action policy / ETS / CBAM / Fit for 55 (bridges cbam-embedded + climate-value-chain + euTrilogue)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
