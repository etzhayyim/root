{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.waterStewardship.recordStewardshipPlan",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Alliance for Water Stewardship / CDP Water plan (bridges sbtnTarget.flagMiss + climate-value-chain + biodiversity-gbf)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "planId",
            "regime",
            "committedAt"
          ],
          "properties": {
            "planId": {
              "type": "string"
            },
            "operatorLei": {
              "type": "string"
            },
            "regime": {
              "type": "string",
              "enum": [
                "aws_standard",
                "cdp_water",
                "watershed_tnc",
                "iwa_utility",
                "context_based_wri",
                "20x_reduction",
                "zero_liquid_discharge",
                "circular_water",
                "reuse_pathway"
              ]
            },
            "basinName": {
              "type": "string"
            },
            "riskBasinStressLevel": {
              "type": "string",
              "enum": [
                "low",
                "medium_low",
                "medium_high",
                "high",
                "extremely_high"
              ]
            },
            "sbtnMissVid": {
              "type": "string",
              "description": "bridges sbtnTarget.flagMiss"
            },
            "committedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}