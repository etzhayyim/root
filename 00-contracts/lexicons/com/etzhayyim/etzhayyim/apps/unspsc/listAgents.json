{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.unispsc.listAgents",
  "defs": {
    "main": {
      "type": "query",
      "description": "List available UNSPSC commodity agents in the registry. Result is paged.",
      "parameters": {
        "type": "params",
        "properties": {
          "prefix": {
            "type": "string",
            "description": "Filter by commodity-code prefix (e.g. '10' for live plants and animals segment)."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 100
          },
          "cursor": {
            "type": "string",
            "description": "Opaque pagination cursor from previous response."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["agents", "totalCount"],
          "properties": {
            "agents": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["code"],
                "properties": {
                  "code": {"type": "string"},
                  "title": {"type": "string"},
                  "module": {"type": "string", "description": "Fully-qualified Python module path."},
                  "loaded": {"type": "boolean", "description": "Currently warm in LRU."}
                }
              }
            },
            "totalCount": {"type": "integer"},
            "cursor": {"type": "string"}
          }
        }
      }
    }
  }
}
