{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.unispsc.invokeAgent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Invoke a specific UNSPSC commodity agent by code. Dispatches to the lazy-loaded LangGraph Pregel agent at langgraph_graphs.unispsc_agents.c{code}.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["code", "payload"],
          "properties": {
            "code": {
              "type": "string",
              "description": "UNSPSC commodity code (numeric, typically 8 digits).",
              "minLength": 4,
              "maxLength": 12
            },
            "payload": {
              "type": "object",
              "description": "Agent input state (shape depends on each commodity agent's StateGraph)."
            },
            "modelHint": {
              "type": "string",
              "enum": ["haiku-4.5", "sonnet-4.6", "auto"],
              "default": "auto"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 25000,
              "default": 10000
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": {"type": "boolean"},
            "result": {
              "type": "object",
              "description": "Agent output state after StateGraph.ainvoke()."
            },
            "modelUsed": {"type": "string"},
            "elapsedMs": {"type": "integer"},
            "error": {"type": "string"}
          }
        }
      },
      "errors": [
        {"name": "AgentNotFound"},
        {"name": "AgentLoadFailed"},
        {"name": "InvocationFailed"},
        {"name": "Timeout"}
      ]
    }
  }
}
