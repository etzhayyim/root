{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.live.tweakTrack",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Edit one track of a live room's setlist by (roomSlug, position). Performer-only (Rego-gated). Re-inserts the vertex_live_track row at the same PK so RisingWave overwrites; partial-edit support requires the caller to supply all required fields (title / bpm / lengthBeats). Optional fields default to null and clear the column when omitted.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["roomSlug", "position", "title", "bpm", "lengthBeats"],
          "properties": {
            "roomSlug": { "type": "string" },
            "position": { "type": "integer", "minimum": 1 },
            "title": { "type": "string", "maxLength": 120 },
            "bpm": { "type": "number", "minimum": 40, "maximum": 240 },
            "lengthBeats": { "type": "integer", "minimum": 4, "maximum": 4096 },
            "dance": {
              "type": "string",
              "knownValues": ["idle", "four-on-floor", "wota", "kpop-point", "shuffle", "hold"]
            },
            "audio": {
              "type": "string",
              "knownValues": ["none", "opener", "ballad", "encore"]
            },
            "cuesJson": {
              "type": "string",
              "description": "Optional JSON-encoded array of {atBeat, kind, tag} cue points."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" }
          }
        }
      }
    }
  }
}
