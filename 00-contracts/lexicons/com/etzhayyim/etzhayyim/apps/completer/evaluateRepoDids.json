{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.completer.evaluateRepoDids",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Batch compliance evaluation for a list of actor DIDs in a repo.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["actor_dids"],
          "properties": {
            "actor_dids": { "type": "array", "items": { "type": "string" } },
            "org_id": { "type": "string" },
            "user_id": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "results": { "type": "array", "items": { "type": "object" } },
            "evaluated": { "type": "integer" }
          }
        }
      }
    }
  }
}
