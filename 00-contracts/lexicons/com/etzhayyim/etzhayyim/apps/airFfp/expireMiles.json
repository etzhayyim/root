{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airFfp.expireMiles",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Expire miles from a member's account.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["member_did", "miles_expired", "expiry_reason"],
          "properties": {
            "member_did": { "type": "string" },
            "miles_expired": { "type": "integer" },
            "expiry_reason": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
