{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airFfp.transferMiles",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Transfer frequent flyer miles between two members.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["from_member_did", "to_member_did", "miles"],
          "properties": {
            "from_member_did": { "type": "string" },
            "to_member_did": { "type": "string" },
            "miles": { "type": "integer" },
            "fee_amount": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
