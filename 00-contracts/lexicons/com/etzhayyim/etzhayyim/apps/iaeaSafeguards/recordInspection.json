{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.iaeaSafeguards.recordInspection",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "IAEA INFCIRC/153 + 540 safeguards inspection (bridges critical-minerals + disaster-response)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "inspectionId",
            "facilityCode",
            "stateIso3",
            "safeguardsAgreement",
            "finding",
            "inspectedAt"
          ],
          "properties": {
            "inspectionId": {
              "type": "string"
            },
            "facilityCode": {
              "type": "string",
              "description": "IAEA facility code"
            },
            "stateIso3": {
              "type": "string"
            },
            "safeguardsAgreement": {
              "type": "string",
              "enum": [
                "csa",
                "ap",
                "sqp",
                "vo",
                "other"
              ]
            },
            "materialCategory": {
              "type": "string",
              "enum": [
                "hyperlink",
                "heu",
                "leu",
                "plutonium",
                "natural_uranium",
                "thorium",
                "depleted"
              ]
            },
            "finding": {
              "type": "string",
              "enum": [
                "routine",
                "anomaly",
                "broader_conclusion",
                "non_compliance",
                "material_unaccounted"
              ]
            },
            "inspectedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "concernTier": {
              "type": "string",
              "enum": [
                "routine",
                "elevated",
                "critical"
              ]
            }
          }
        }
      }
    }
  }
}