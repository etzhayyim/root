{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.judicialMisconductBoard.flagOutcomeBias",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Selective outcome / impeachment threshold / appeal stall (bridges barAssociationRecall.flagBaselineConcern + judicialAppointment + civilLiability)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "complaintVid",
            "outcomeKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "complaintVid": {
              "type": "string",
              "description": "bridges recordComplaint"
            },
            "outcomeKind": {
              "type": "string",
              "enum": [
                "dismissed_no_action",
                "admonishment",
                "censure",
                "suspension",
                "retirement_stipulated",
                "impeachment_referred",
                "appeal_stalled",
                "sealed",
                "public_hearing",
                "political_immunity_invoked",
                "peer_review_inadequate"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}