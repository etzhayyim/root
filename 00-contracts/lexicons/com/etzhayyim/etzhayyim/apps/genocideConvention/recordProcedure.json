{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.genocideConvention.recordProcedure",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Genocide Convention Art I/II/III procedure (bridges minorityRights.flagBacklash + poc-ihl + universal-jurisdiction)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "procedureId",
            "situationCountryIso3",
            "procedureKind",
            "filedAt"
          ],
          "properties": {
            "procedureId": {
              "type": "string"
            },
            "situationCountryIso3": {
              "type": "string"
            },
            "procedureKind": {
              "type": "string",
              "enum": [
                "icj_contentious",
                "icj_advisory",
                "ucc_article_iii",
                "national_prosecution",
                "eccc_khmer",
                "ictr_rwanda_legacy",
                "icty_yugo_legacy",
                "icc_referral",
                "universal_jurisdiction",
                "commission_inquiry",
                "fact_finding"
              ]
            },
            "primaryRespondent": {
              "type": "string"
            },
            "backlashVid": {
              "type": "string",
              "description": "bridges minorityRights.flagBacklash"
            },
            "filedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}