{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openUnispsc.procurement",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Submit a procurement request tagged by UNSPSC 8-digit commodity code. FEEL derives approval tier: enterprise (>=1M or dangerousGoods), department (>=50K), routine (<50K). Starts BPMN open_unispsc_procurement.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["buyerOrgId","commodityCode","quantity","unitPrice","currency","submittedAt"],
          "properties": {
            "buyerOrgId":     { "type": "string" },
            "commodityCode":  { "type": "string", "description": "UNSPSC 8-digit" },
            "quantity":       { "type": "number" },
            "unitPrice":      { "type": "number" },
            "currency":       { "type": "string" },
            "dangerousGoods": { "type": "boolean" },
            "sanctionsCheck": { "type": "string", "description": "pass / hit / unknown" },
            "submittedAt":    { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" }, "vertexId": { "type": "string" },
            "totalAmount": { "type": "number" },
            "approvalTier": { "type": "string", "enum": ["routine","department","enterprise"] },
            "requireCab": { "type": "boolean" },
            "instanceKey": { "type": "integer" }, "error": { "type": "string" }
          }
        }
      }
    }
  }
}
