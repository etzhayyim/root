{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openUnispsc.itemScreenSupplier",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Apply open_unispsc_supplier BPMN KYC and quality routing for a concrete UNSPSC item.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["commodityCode", "supplierDid", "country", "kycCleared", "qualityScore"],
          "properties": {
            "commodityCode": { "type": "string" },
            "commodityName": { "type": "string" },
            "supplierDid": { "type": "string" },
            "legalName": { "type": "string" },
            "country": { "type": "string" },
            "kycCleared": { "type": "boolean" },
            "qualityScore": { "type": "number" }
          }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object" } }
    }
  }
}
