      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["code"],
          "properties": {
            "code": { "type": "string", "description": "UNSPSC 2-digit segment code" },
            "name": { "type": "string" },
            "dryRun": { "type": "boolean" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object" }
      }
    }
  }
}
