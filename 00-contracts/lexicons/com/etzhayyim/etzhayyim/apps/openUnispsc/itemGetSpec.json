{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openUnispsc.itemGetSpec",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Return an executable item-specific UNSPSC spec contract with BPMN and LangGraph/LangChain references.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["commodityCode"],
          "properties": {
            "commodityCode": { "type": "string" },
            "commodityName": { "type": "string" }
          }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object" } }
    }
  }
}
