{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openSmartphoneOs.listOsBuilds",
  "defs": {
    "main": {
      "type": "query",
      "description": "List registered open smartphone OS builds",
      "parameters": {
        "type": "params",
        "properties": {
          "osBase": { "type": "string" },
          "socSupport": { "type": "string", "description": "Filter by SoC DID or chip ID" },
          "verifiedBoot": { "type": "boolean" },
          "limit": { "type": "integer", "default": 50, "maximum": 200 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["builds", "total"],
          "properties": {
            "builds": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["vertexId", "buildId", "osName", "osBase", "version"],
                "properties": {
                  "vertexId": { "type": "string" },
                  "buildId": { "type": "string" },
                  "osName": { "type": "string" },
                  "osBase": { "type": "string" },
                  "version": { "type": "string" },
                  "kernelVersion": { "type": "string" },
                  "openBlobsPct": { "type": "number" },
                  "verifiedBoot": { "type": "boolean" }
                }
              }
            },
            "total": { "type": "integer" }
          }
        }
      }
    }
  }
}
