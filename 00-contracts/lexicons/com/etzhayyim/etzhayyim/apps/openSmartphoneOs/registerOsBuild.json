{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openSmartphoneOs.registerOsBuild",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register an open smartphone OS build",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["buildId", "osName", "osBase", "version", "kernelVersion"],
          "properties": {
            "buildId": { "type": "string" },
            "osName": { "type": "string" },
            "osBase": { "type": "string", "knownValues": ["aosp", "postmarketos", "ubuntu-touch", "sailfishos", "kalios", "nixos-mobile", "debian-mobile", "other"] },
            "version": { "type": "string" },
            "kernelVersion": { "type": "string" },
            "socSupport": { "type": "array", "items": { "type": "string" }, "description": "List of supported SoC DIDs or chip IDs" },
            "openBlobsPct": { "type": "number", "description": "Percentage of firmware that is open-source (0-100)" },
            "verifiedBoot": { "type": "boolean" },
            "buildUrl": { "type": "string", "format": "uri" },
            "releaseDate": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["vertexId"],
          "properties": { "vertexId": { "type": "string" } }
        }
      }
    }
  }
}
