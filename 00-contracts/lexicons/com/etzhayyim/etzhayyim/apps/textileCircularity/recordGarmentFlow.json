{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.textileCircularity.recordGarmentFlow",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Garment lifecycle flow (EU ESPR / DPP / EPR textile — bridges chemicals-management + forced-labor + food-waste-epr + plastic-treaty)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flowId",
            "productCategory",
            "stage",
            "tonnes",
            "recordedAt"
          ],
          "properties": {
            "flowId": {
              "type": "string"
            },
            "brandLei": {
              "type": "string"
            },
            "hsCode": {
              "type": "string"
            },
            "productCategory": {
              "type": "string",
              "enum": [
                "fast_fashion",
                "luxury",
                "sport",
                "workwear",
                "home_textile",
                "medical",
                "technical"
              ]
            },
            "fiberMix": {
              "type": "string",
              "description": "comma: cotton,polyester,nylon,wool,viscose,recycled,elastane"
            },
            "stage": {
              "type": "string",
              "enum": [
                "design",
                "production",
                "distribution",
                "use",
                "collection",
                "reuse",
                "recycle",
                "incineration",
                "landfill"
              ]
            },
            "tonnes": {
              "type": "number"
            },
            "originIso3": {
              "type": "string"
            },
            "destinationIso3": {
              "type": "string"
            },
            "recordedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "circularityTier": {
              "type": "string",
              "enum": [
                "linear",
                "in_use",
                "recovery",
                "circular"
              ]
            }
          }
        }
      }
    }
  }
}