{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.textileCircularity.registerDppBadge",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Digital Product Passport (ESPR Reg 2024/1781 — bridges slsa-supply-chain + forced-labor + chemicals-management)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "dppId",
            "flowVid",
            "dppStandard",
            "publishedAt"
          ],
          "properties": {
            "dppId": {
              "type": "string"
            },
            "flowVid": {
              "type": "string",
              "description": "bridges recordGarmentFlow"
            },
            "dppStandard": {
              "type": "string",
              "enum": [
                "jtc24_iso_iec",
                "catena_x",
                "gs1_digital_link",
                "cirpass"
              ]
            },
            "recycledContentPct": {
              "type": "number"
            },
            "durabilityIndex": {
              "type": "number"
            },
            "repairabilityIndex": {
              "type": "number"
            },
            "substancesOfConcernFlagged": {
              "type": "boolean",
              "description": "bridges open-chemicals-management"
            },
            "publishedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}