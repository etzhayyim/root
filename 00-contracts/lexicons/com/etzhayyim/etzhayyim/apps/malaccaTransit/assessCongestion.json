{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.malaccaTransit.assessCongestion",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "混雑評価",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "assessmentId",
            "vtsGate",
            "vesselCountHour",
            "assessedAt"
          ],
          "properties": {
            "assessmentId": {
              "type": "string"
            },
            "vtsGate": {
              "type": "string"
            },
            "vesselCountHour": {
              "type": "integer"
            },
            "avgSogKnots": {
              "type": "number"
            },
            "assessedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "queueTier": {
              "type": "string",
              "enum": [
                "light",
                "normal",
                "heavy",
                "gridlock"
              ]
            },
            "requireNotice": {
              "type": "boolean"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
