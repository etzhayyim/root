{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.chromato.predictRetention",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Predict chromatographic retention time (HPLC/GC/TLC). Auto-generated stub (coverage expansion 2026-04-17).",
      "x-bootstrap": true,
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["smiles", "technique"],
          "properties": {
            "smiles": { "type": "string" },
            "technique": { "type": "string", "enum": ["HPLC", "UHPLC", "GC", "TLC", "IC"] },
            "column": { "type": "string" },
            "mobilePhase": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "retentionTime": { "type": "number", "description": "minutes" },
            "confidence": { "type": "number" }
          }
        }
      }
    }
  }
}
