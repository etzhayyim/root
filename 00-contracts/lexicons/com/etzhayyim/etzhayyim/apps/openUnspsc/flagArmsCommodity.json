{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openUnispsc.flagArmsCommodity",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Defence wave3 arms (stub): 武器物資 (UNSPSC 46). Starts BPMN process open_unispsc_flag_arms_commodity.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "vertexId": { "type": "string" },
            "commodityVid": { "type": "string" },
            "unspscCode": { "type": "string" },
            "subFamily": { "type": "string" },
            "callerDid": { "type": "string" },
            "detectedAt": { "type": "string", "format": "datetime" },
            "evidenceUri": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "required": ["vertexId", "commodityVid", "unspscCode"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok":          { "type": "boolean" },
            "instanceKey": { "type": "integer" },
            "graphWritePlan": { "type": "object" },
            "error":       { "type": "string" }
          }
        }
      }
    }
  }
}
