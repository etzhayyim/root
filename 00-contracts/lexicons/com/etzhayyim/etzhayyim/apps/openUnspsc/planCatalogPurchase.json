{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openUnispsc.planCatalogPurchase",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Plan the okaimono purchase flow for a UNSPSC catalog item: product_id to commodity spec invocation, checkout saga, procurement-find-offers, and fulfillment handoff.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "productId": { "type": "string", "description": "okaimono product_id, e.g. unispsc-43211501" },
            "commodityCode": { "type": "string", "description": "UNSPSC 8-digit; optional when productId is present" },
            "orderId": { "type": "string" },
            "customerDid": { "type": "string" },
            "buyerOrgId": { "type": "string" },
            "quantity": { "type": "number", "default": 1 },
            "unitPrice": { "type": "number", "default": 0 },
            "currency": { "type": "string", "default": "USD" }
          },
          "anyOf": [
            { "required": ["productId"] },
            { "required": ["commodityCode"] }
          ]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "productId": { "type": "string" },
            "commodityCode": { "type": "string" },
            "orderLine": { "type": "object" },
            "checkoutSaga": { "type": "object" },
            "procurementInvocation": { "type": "object" },
            "fulfillmentPlan": { "type": "object" },
            "purchaseFlow": { "type": "array", "items": { "type": "string" } },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
