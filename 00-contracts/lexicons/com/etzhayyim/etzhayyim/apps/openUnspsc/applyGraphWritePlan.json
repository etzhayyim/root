{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openUnispsc.applyGraphWritePlan",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Validate or apply an openUnispsc graphWritePlan emitted by supplier/procurement tools. Defaults to dryRun=true and returns parameterized SQL statements for deterministic graph upsert.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["graphWritePlan"],
          "properties": {
            "graphWritePlan": {
              "type": "object",
              "properties": {
                "mode": { "type": "string", "const": "deterministic-upsert" },
                "operation": { "type": "string" },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["table", "key", "record"],
                    "properties": {
                      "table": { "type": "string" },
                      "key": { "type": "string" },
                      "record": { "type": "object" }
                    }
                  }
                }
              }
            },
            "dryRun": { "type": "boolean", "default": true }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "dryRun": { "type": "boolean" },
            "validatedRows": { "type": "integer" },
            "appliedRows": { "type": "integer" },
            "sqlStatements": { "type": "array" },
            "errors": { "type": "array", "items": { "type": "string" } },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
