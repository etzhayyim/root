{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.euStabilityMechanism.flagBoardDispute",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Board of Governors dispute / national veto / conditionality fight (bridges euSummitConclusion.flagDilution + sovereign-debt + imf-article-iv)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "interventionVid",
            "disputeKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "interventionVid": {
              "type": "string",
              "description": "bridges recordIntervention"
            },
            "disputeKind": {
              "type": "string",
              "enum": [
                "national_veto",
                "mou_conditionality",
                "reform_pace",
                "privatisation_demand",
                "politicization_concern",
                "seniority_dispute",
                "loss_absorption",
                "esm_treaty_amendment",
                "cdq_creditor_quasi",
                "creditor_committee_split"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}