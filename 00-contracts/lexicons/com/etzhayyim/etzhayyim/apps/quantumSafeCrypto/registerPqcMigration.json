{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.quantumSafeCrypto.registerPqcMigration",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "NIST PQC migration inventory (FIPS 203/204/205 — bridges cyber-compliance + ai-supply-chain + banking)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "migrationId",
            "systemName",
            "cryptoAssetType",
            "qRiskTier",
            "registeredAt"
          ],
          "properties": {
            "migrationId": {
              "type": "string"
            },
            "operatorLei": {
              "type": "string"
            },
            "systemName": {
              "type": "string"
            },
            "cryptoAssetType": {
              "type": "string",
              "enum": [
                "rsa",
                "ecdsa",
                "ecdh",
                "dsa",
                "ml_kem",
                "ml_dsa",
                "slh_dsa",
                "hash",
                "hybrid"
              ]
            },
            "keyLengthBits": {
              "type": "integer"
            },
            "qRiskTier": {
              "type": "string",
              "enum": [
                "hnsk_critical",
                "store_now_decrypt_later",
                "tactical",
                "low"
              ]
            },
            "targetPqcScheme": {
              "type": "string"
            },
            "targetCompletionYear": {
              "type": "integer"
            },
            "registeredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "urgencyTier": {
              "type": "string",
              "enum": [
                "monitor",
                "planned",
                "priority",
                "immediate"
              ]
            }
          }
        }
      }
    }
  }
}