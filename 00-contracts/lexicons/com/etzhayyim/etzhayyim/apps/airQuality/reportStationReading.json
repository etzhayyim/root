{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airQuality.reportStationReading",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "WHO AQG / EPA AirNow / EEA / OpenAQ reading (bridges pandemic-preparedness + disaster-response + cyclone-prepo)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "readingId",
            "stationId",
            "countryIso3",
            "readingUtc"
          ],
          "properties": {
            "readingId": {
              "type": "string"
            },
            "stationId": {
              "type": "string"
            },
            "countryIso3": {
              "type": "string"
            },
            "pm25": {
              "type": "number",
              "description": "ug/m3"
            },
            "pm10": {
              "type": "number"
            },
            "no2": {
              "type": "number"
            },
            "o3": {
              "type": "number"
            },
            "so2": {
              "type": "number"
            },
            "co": {
              "type": "number"
            },
            "aqi": {
              "type": "integer"
            },
            "readingUtc": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "airQualityTier": {
              "type": "string",
              "enum": [
                "good",
                "moderate",
                "unhealthy_sg",
                "unhealthy",
                "very_unhealthy",
                "hazardous"
              ]
            }
          }
        }
      }
    }
  }
}