{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.saikin.formColony",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create a cooperative colony of related signals. Analogous to bacterial biofilm formation — related signals group for shared processing context without merging identity.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "signalIds": {
              "type": "array",
              "items": { "type": "string" },
              "description": "IDs of signals to group into a colony"
            }
          },
          "required": ["signalIds"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "colonyId": { "type": "string" },
            "memberCount": { "type": "integer" },
            "error": { "type": "string" }
          },
          "required": ["colonyId", "memberCount"]
        }
      }
    }
  }
}
