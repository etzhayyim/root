{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.saikin.probeEnvironment",
  "defs": {
    "main": {
      "type": "query",
      "description": "Scan external data sources for novel signals. Analogous to bacterial chemotaxis — saikin probes the environment for new information gradients.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "signalCount": { "type": "integer", "description": "Number of novel signals detected" },
            "signals": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "signalId": { "type": "string" },
                  "sourceRef": { "type": "string" },
                  "noveltyScore": { "type": "number" }
                },
                "required": ["signalId", "sourceRef"]
              }
            },
            "error": { "type": "string" }
          },
          "required": ["signalCount", "signals"]
        }
      }
    }
  }
}
