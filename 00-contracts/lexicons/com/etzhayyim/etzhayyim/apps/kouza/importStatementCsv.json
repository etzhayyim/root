{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kouza.importStatementCsv",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Import read-only statement CSV for one external financial account. CSV must include postedAt, amountMinor, and currency headers; optional headers include externalTxnId, valueAt, counterpartyName, description, and categoryHint.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ownerDid", "connectionDid", "financialAccountDid", "csvText"],
          "properties": {
            "ownerDid": { "type": "string", "format": "did" },
            "connectionDid": { "type": "string" },
            "financialAccountDid": { "type": "string" },
            "sourceFileCid": { "type": "string" },
            "csvText": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["syncRunDid", "imported", "skipped", "kaikeiDerived"],
          "properties": {
            "syncRunDid": { "type": "string", "format": "did" },
            "imported": { "type": "integer" },
            "skipped": { "type": "integer" },
            "kaikeiDerived": { "type": "integer" }
          }
        }
      }
    }
  }
}
