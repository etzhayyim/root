{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kouza.importStatement",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Import read-only statement rows for one external financial account. Writes kouza.externalTransaction rows and derives kaikei.bankTransaction candidates when the account is mapped.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ownerDid", "connectionDid", "financialAccountDid", "rows"],
          "properties": {
            "ownerDid": { "type": "string", "format": "did" },
            "connectionDid": { "type": "string", "format": "did" },
            "financialAccountDid": { "type": "string", "format": "did" },
            "sourceFileCid": { "type": "string" },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["postedAt", "amountMinor", "currency"],
                "properties": {
                  "externalTxnId": { "type": "string" },
                  "postedAt": { "type": "string", "format": "datetime" },
                  "valueAt": { "type": "string", "format": "datetime" },
                  "amountMinor": { "type": "integer" },
                  "currency": { "type": "string" },
                  "counterpartyName": { "type": "string" },
                  "description": { "type": "string" },
                  "categoryHint": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["syncRunDid", "imported", "skipped", "kaikeiDerived"],
          "properties": {
            "syncRunDid": { "type": "string", "format": "did" },
            "imported": { "type": "integer" },
            "skipped": { "type": "integer" },
            "kaikeiDerived": { "type": "integer" }
          }
        }
      }
    }
  }
}
