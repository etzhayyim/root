{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kouza.mapKaikeiAccount",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Map an external financial account to a kaikei chart-of-accounts DID for downstream bankTransaction derivation.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["financialAccountDid", "kaikeiAccountDid"],
          "properties": {
            "financialAccountDid": { "type": "string", "format": "did" },
            "kaikeiAccountDid": { "type": "string", "format": "did" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" }
          }
        }
      }
    }
  }
}
