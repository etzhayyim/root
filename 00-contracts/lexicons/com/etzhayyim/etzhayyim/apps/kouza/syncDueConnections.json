{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kouza.syncDueConnections",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Resident kouza scheduler entrypoint. Scans active institution connections that are due for sync and records syncRun audit rows without initiating payments or transfers.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ownerDid": { "type": "string", "format": "did" },
            "maxConnections": { "type": "integer", "minimum": 1, "maximum": 200, "default": 25 },
            "staleMinutes": { "type": "integer", "minimum": 1, "maximum": 10080, "default": 60 },
            "dryRun": { "type": "boolean", "default": false }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "connectionsScanned", "syncRunsCreated"],
          "properties": {
            "ok": { "type": "boolean" },
            "connectionsScanned": { "type": "integer" },
            "syncRunsCreated": { "type": "integer" },
            "syncRunDids": { "type": "array", "items": { "type": "string" } },
            "adapterMode": { "type": "string" },
            "dryRun": { "type": "boolean" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
