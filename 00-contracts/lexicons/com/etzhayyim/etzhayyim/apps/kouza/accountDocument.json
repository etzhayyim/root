{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kouza.accountDocument",
  "defs": {
    "main": {
      "type": "record",
      "description": "Vault-encrypted financial account document: statement, balance certificate, securities report, tax document, passbook scan, or source import file.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["ownerDid", "financialAccountDid", "documentKind", "vaultCid", "contentHash", "issuedAt", "createdAt"],
        "properties": {
          "ownerDid": { "type": "string", "format": "did" },
          "financialAccountDid": { "type": "string", "format": "did" },
          "documentKind": { "type": "string", "enum": ["statement", "balanceCertificate", "securitiesReport", "taxDocument", "passbookScan", "sourceImport", "other"] },
          "title": { "type": "string" },
          "periodFrom": { "type": "string", "format": "datetime" },
          "periodTo": { "type": "string", "format": "datetime" },
          "issuedAt": { "type": "string", "format": "datetime" },
          "vaultCid": { "type": "string", "description": "CID of vault-encrypted document bytes" },
          "contentHash": { "type": "string", "description": "Hash of original plaintext bytes for duplicate detection; not reversible" },
          "mimeType": { "type": "string" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
