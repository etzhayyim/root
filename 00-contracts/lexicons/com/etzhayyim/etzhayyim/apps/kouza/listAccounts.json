{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kouza.listAccounts",
  "defs": {
    "main": {
      "type": "query",
      "description": "List external financial accounts imported by kouza.",
      "parameters": {
        "type": "params",
        "required": ["ownerDid"],
        "properties": {
          "ownerDid": { "type": "string", "format": "did" },
          "connectionDid": { "type": "string", "format": "did" },
          "accountKind": { "type": "string" },
          "status": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["accounts"],
          "properties": {
            "accounts": { "type": "array", "items": { "type": "unknown" } },
            "cursor": { "type": "string" }
          }
        }
      }
    }
  }
}
