{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kouza.institutionConnection",
  "defs": {
    "main": {
      "type": "record",
      "description": "Read-only external financial institution connection. Stores consent metadata and an opaque vault reference to credential material; never stores secrets or full account numbers in plaintext.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["ownerDid", "institutionName", "institutionKind", "providerKey", "scopes", "status", "createdAt"],
        "properties": {
          "ownerDid": { "type": "string", "format": "did" },
          "institutionName": { "type": "string" },
          "institutionKind": { "type": "string", "enum": ["bank", "securities", "card", "custody", "emoney", "other"] },
          "providerKey": { "type": "string", "description": "Stable adapter key, e.g. csv, ofx, moneyforwardExport, jp-bank-api" },
          "credentialVaultRef": { "type": "string", "description": "Opaque vault pointer. Secret material is never returned over XRPC." },
          "scopes": {
            "type": "array",
            "items": { "type": "string", "enum": ["accounts.read", "transactions.read", "documents.read", "balances.read"] }
          },
          "consentExpiresAt": { "type": "string", "format": "datetime" },
          "status": { "type": "string", "enum": ["active", "expired", "revoked", "error"] },
          "lastSyncRunDid": { "type": "string", "format": "did" },
          "createdAt": { "type": "string", "format": "datetime" },
          "updatedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
