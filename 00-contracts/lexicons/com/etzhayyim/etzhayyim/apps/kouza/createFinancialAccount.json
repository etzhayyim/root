{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kouza.createFinancialAccount",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create or update an external financial account under a read-only institution connection. Used by CSV/manual import adapters before statement import.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ownerDid", "connectionDid", "accountKind", "currency"],
          "properties": {
            "ownerDid": { "type": "string", "format": "did" },
            "connectionDid": { "type": "string", "format": "did" },
            "externalAccountIdHash": { "type": "string" },
            "maskedAccountNumber": { "type": "string" },
            "displayName": { "type": "string" },
            "accountKind": { "type": "string", "enum": ["checking", "savings", "termDeposit", "securities", "creditCard", "loan", "custody", "emoney", "other"] },
            "currency": { "type": "string" },
            "currentBalanceMinor": { "type": "integer" },
            "balanceAsOf": { "type": "string", "format": "datetime" },
            "kaikeiAccountDid": { "type": "string", "format": "did" },
            "status": { "type": "string", "enum": ["active", "closed", "hidden", "error"] }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["financialAccountDid"],
          "properties": {
            "financialAccountDid": { "type": "string", "format": "did" }
          }
        }
      }
    }
  }
}
