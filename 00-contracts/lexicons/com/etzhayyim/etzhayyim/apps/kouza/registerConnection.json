{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kouza.registerConnection",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register read-only institution consent and credential vault reference. Rejects write/payment scopes.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ownerDid", "institutionName", "institutionKind", "providerKey", "scopes"],
          "properties": {
            "ownerDid": { "type": "string", "format": "did" },
            "institutionName": { "type": "string" },
            "institutionKind": { "type": "string", "enum": ["bank", "securities", "card", "custody", "emoney", "other"] },
            "providerKey": { "type": "string" },
            "credentialVaultRef": { "type": "string" },
            "scopes": { "type": "array", "items": { "type": "string" } },
            "consentExpiresAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["connectionDid", "status"],
          "properties": {
            "connectionDid": { "type": "string", "format": "did" },
            "status": { "type": "string" }
          }
        }
      }
    }
  }
}
