{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.carrierSchedule.recordPortCall",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "実際の port call",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "callId",
            "imo",
            "portLocode"
          ],
          "properties": {
            "callId": {
              "type": "string"
            },
            "imo": {
              "type": "string"
            },
            "carrierCode": {
              "type": "string"
            },
            "stringCode": {
              "type": "string"
            },
            "voyageNumber": {
              "type": "string"
            },
            "portLocode": {
              "type": "string"
            },
            "terminal": {
              "type": "string"
            },
            "eta": {
              "type": "string",
              "format": "datetime"
            },
            "etd": {
              "type": "string",
              "format": "datetime"
            },
            "ata": {
              "type": "string",
              "format": "datetime"
            },
            "atd": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "scheduleTier": {
              "type": "string",
              "enum": [
                "on-time",
                "minor-delay",
                "moderate-delay",
                "major-delay"
              ]
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
