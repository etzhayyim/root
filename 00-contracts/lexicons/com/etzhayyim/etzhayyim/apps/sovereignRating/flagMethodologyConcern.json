{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.sovereignRating.flagMethodologyConcern",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Rating methodology / conflict-of-interest / split-rating concern (bridges fatfGreylist.flagReputationSpillover + judicial-influence + enforcement-action)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "actionVid",
            "concernKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "actionVid": {
              "type": "string",
              "description": "bridges recordRatingAction"
            },
            "concernKind": {
              "type": "string",
              "enum": [
                "split_rating",
                "methodology_opacity",
                "conflict_issuer_pays",
                "cra_oligopoly",
                "esg_methodology",
                "geopolitical_bias",
                "non_transparent_stress",
                "inconsistent_migration",
                "procyclicality",
                "rating_shopping",
                "shadow_rating"
              ]
            },
            "notchDivergence": {
              "type": "integer"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}