{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.biometricStandards.recordStandard",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Biometric standard (ICAO 9303 / ISO/IEC 39794 / FIDO2 — bridges digitalPublicInfra.flagExclusionRisk + digital-identity + crpd-disability)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "standardId",
            "body",
            "modality",
            "publishedAt"
          ],
          "properties": {
            "standardId": {
              "type": "string"
            },
            "body": {
              "type": "string",
              "enum": [
                "icao_9303",
                "iso_iec_39794",
                "iso_iec_17839",
                "nist_fips",
                "fido2",
                "eu_eidas2",
                "bsp_india",
                "cic_china",
                "enisa",
                "oasis_saml"
              ]
            },
            "modality": {
              "type": "string",
              "enum": [
                "facial",
                "fingerprint",
                "iris",
                "voice",
                "gait",
                "palm_vein",
                "signature",
                "dna_forensic",
                "vein",
                "behavioral",
                "multimodal",
                "passive_liveness"
              ]
            },
            "accuracyTier": {
              "type": "string",
              "enum": [
                "ultra_high",
                "high",
                "medium",
                "low",
                "acceptable_with_caveats"
              ]
            },
            "exclusionVid": {
              "type": "string",
              "description": "bridges digitalPublicInfra.flagExclusionRisk"
            },
            "publishedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}