{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.spsStandardIso.flagCertificationSleight",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Certification sleight / equivalence / audit mill (bridges codexStandard.flagNonHarmonization + food-fraud + enforcement-action)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "standardVid",
            "issueKind",
            "reportedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "standardVid": {
              "type": "string",
              "description": "bridges recordStandard"
            },
            "issueKind": {
              "type": "string",
              "enum": [
                "audit_mill",
                "non_equivalent_mutual",
                "cert_forgery",
                "double_dipping",
                "benchmarking_reduction",
                "skipped_re_cert",
                "post_shipment_downgrade",
                "scope_creep",
                "private_public_divergence",
                "ngo_vs_industry"
              ]
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}