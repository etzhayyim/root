{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.brokerCharter.recordDemurrage",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Demurrage 請求",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "demurrageId",
            "imo",
            "laytimeHours",
            "actualHours",
            "reportedAt"
          ],
          "properties": {
            "demurrageId": {
              "type": "string"
            },
            "charterVid": {
              "type": "string"
            },
            "imo": {
              "type": "string"
            },
            "portVid": {
              "type": "string"
            },
            "laytimeHours": {
              "type": "number"
            },
            "actualHours": {
              "type": "number"
            },
            "rateUsdDay": {
              "type": "number"
            },
            "totalUsd": {
              "type": "number"
            },
            "reportedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "costTier": {
              "type": "string",
              "enum": [
                "minor",
                "moderate",
                "significant",
                "severe"
              ]
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
