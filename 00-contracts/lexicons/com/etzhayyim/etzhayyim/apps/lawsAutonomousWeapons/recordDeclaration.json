{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.lawsAutonomousWeapons.recordDeclaration",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "LAWS declaration / position under UN GGE / CCW (bridges disarmament-treaties + ai-governance + esports-integrity)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "declarationId",
            "stateIso3",
            "forum",
            "positionType",
            "declaredAt"
          ],
          "properties": {
            "declarationId": {
              "type": "string"
            },
            "stateIso3": {
              "type": "string"
            },
            "forum": {
              "type": "string",
              "enum": [
                "un_gge",
                "ccw",
                "unga1",
                "unga6",
                "icrc",
                "tpnw_review"
              ]
            },
            "positionType": {
              "type": "string",
              "enum": [
                "moratorium_calling",
                "prohibit_laws",
                "regulate_laws",
                "no_laws_policy",
                "opposed_restriction",
                "silent"
              ]
            },
            "keyElements": {
              "type": "string",
              "description": "meaningful_human_control / accountability / ihl_compliance / proliferation"
            },
            "declaredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}