{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.lawsAutonomousWeapons.flagSystemDeployment",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Alleged LAWS battlefield deployment (bridges disarmament-treaties + ai-governance)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "deploymentId",
            "systemName",
            "operatorIso3",
            "autonomyLevel",
            "allegedAt"
          ],
          "properties": {
            "deploymentId": {
              "type": "string"
            },
            "systemName": {
              "type": "string"
            },
            "operatorIso3": {
              "type": "string"
            },
            "conflictName": {
              "type": "string"
            },
            "autonomyLevel": {
              "type": "string",
              "enum": [
                "human_on_the_loop",
                "human_in_the_loop",
                "fully_autonomous",
                "swarm"
              ]
            },
            "aiModelVid": {
              "type": "string",
              "description": "bridges open-ai-governance"
            },
            "sourceType": {
              "type": "string",
              "enum": [
                "open_source",
                "ngo_report",
                "state_claim",
                "journalism",
                "uav_log"
              ]
            },
            "allegedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "concernTier": {
              "type": "string",
              "enum": [
                "routine",
                "elevated",
                "critical"
              ]
            }
          }
        }
      }
    }
  }
}