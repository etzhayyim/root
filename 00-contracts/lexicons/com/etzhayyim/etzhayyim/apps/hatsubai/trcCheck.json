{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.hatsubai.trcCheck",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["buildDid", "ruleId", "severity", "result", "observedAt", "createdAt"],
        "properties": {
          "buildDid":     { "type": "string" },
          "ruleId":       { "type": "string", "description": "Vendor rule code (e.g. NSW-TRC-0042 / TRC R4001 / TCR-XGS-118 / Steam VAC-12)." },
          "ruleName":     { "type": "string" },
          "severity": {
            "type": "string",
            "knownValues": ["must", "should", "info"]
          },
          "result": {
            "type": "string",
            "knownValues": ["pass", "fail", "waived", "not_applicable"]
          },
          "evidenceUri":  { "type": "string", "description": "URL/CID of the screenshot, log, or repro document." },
          "reviewerNote": { "type": "string" },
          "observedAt":   { "type": "string", "format": "datetime" },
          "createdAt":    { "type": "string", "format": "datetime" },
          "updatedAt":    { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
