{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.hatsubai.certSubmission",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["buildDid", "roundNo", "submittedAt", "result", "createdAt"],
        "properties": {
          "buildDid":          { "type": "string" },
          "roundNo":           { "type": "integer", "description": "1-indexed cert submission round." },
          "submittedAt":       { "type": "string", "format": "datetime" },
          "resolvedAt":        { "type": "string", "format": "datetime" },
          "result": {
            "type": "string",
            "knownValues": ["pending", "pass", "fail", "withdrawn"]
          },
          "reviewerNoteUri":   { "type": "string" },
          "failCount":         { "type": "integer" },
          "mustFailCount":     { "type": "integer", "description": "Severity=must fails. Non-zero blocks pass." },
          "createdAt":         { "type": "string", "format": "datetime" },
          "updatedAt":         { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
