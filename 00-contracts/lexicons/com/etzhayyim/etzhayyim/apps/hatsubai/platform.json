{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.hatsubai.platform",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["platformCode", "displayName", "createdAt"],
        "properties": {
          "platformCode": {
            "type": "string",
            "description": "Stable code: nsw2 (Switch 2) / ps5 / xbsx (Xbox Series X|S) / steam."
          },
          "displayName":   { "type": "string" },
          "holderLegalEntityDid": {
            "type": "string",
            "description": "DID of the platform holder (Nintendo / Sony Interactive / Microsoft / Valve)."
          },
          "certProgramName":     { "type": "string", "description": "e.g. Lotcheck / SUBMIT / Mainline Cert / Steamworks Self-Cert." },
          "submissionPortalUrl": { "type": "string" },
          "developerPortalUrl":  { "type": "string" },
          "regionLocked":        { "type": "boolean" },
          "createdAt":           { "type": "string", "format": "datetime" },
          "updatedAt":           { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
