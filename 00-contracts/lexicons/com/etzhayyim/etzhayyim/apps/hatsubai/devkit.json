{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.hatsubai.devkit",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["serial", "platformCode", "kitKind", "status", "createdAt"],
        "properties": {
          "serial":           { "type": "string" },
          "platformCode":     { "type": "string" },
          "kitKind": {
            "type": "string",
            "knownValues": ["devkit", "testkit", "debug", "retail_unlocked"]
          },
          "status": {
            "type": "string",
            "knownValues": ["allocated", "active", "idle", "in_repair", "returned", "decommissioned"]
          },
          "firmwareVersion":  { "type": "string" },
          "assignedToDid":    { "type": "string", "description": "partnerAccount or natural-person DID." },
          "assignedAt":       { "type": "string", "format": "datetime" },
          "returnedAt":       { "type": "string", "format": "datetime" },
          "createdAt":        { "type": "string", "format": "datetime" },
          "updatedAt":        { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
