{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.hatsubai.sdkVersion",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["platformCode", "sdkVersion", "createdAt"],
        "properties": {
          "platformCode":       { "type": "string" },
          "sdkVersion":         { "type": "string", "description": "Vendor SDK version label (e.g. NSW2-SDK 1.4.2 / Sony PS5 SDK 9.020 / GDK 25.04 / Steamworks 1.59)." },
          "certWindowOpenAt":   { "type": "string", "format": "datetime" },
          "certWindowCloseAt":  { "type": "string", "format": "datetime" },
          "releaseNotesUri":    { "type": "string" },
          "createdAt":          { "type": "string", "format": "datetime" },
          "updatedAt":          { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
