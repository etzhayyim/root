{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.hatsubai.ageRating",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["titleDid", "board", "regionIso3166", "ratingLabel", "createdAt"],
        "properties": {
          "titleDid":         { "type": "string" },
          "board": {
            "type": "string",
            "knownValues": ["cero", "esrb", "pegi", "iarc", "grac", "uscb", "djctq", "dgbas", "sgrb", "rars"]
          },
          "regionIso3166":    { "type": "string", "description": "ISO 3166-1 alpha-2." },
          "ratingLabel":      { "type": "string", "description": "Board-native label (e.g. CERO Z / ESRB M / PEGI 18 / IARC 16+)." },
          "ratingAgeMin":     { "type": "integer", "description": "Numeric minimum age, normalized." },
          "descriptorCodes":  { "type": "string", "description": "Comma-joined descriptor codes (violence, language, etc.)." },
          "certificateUri":   { "type": "string" },
          "grantedAt":        { "type": "string", "format": "datetime" },
          "expiresAt":        { "type": "string", "format": "datetime" },
          "createdAt":        { "type": "string", "format": "datetime" },
          "updatedAt":        { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
