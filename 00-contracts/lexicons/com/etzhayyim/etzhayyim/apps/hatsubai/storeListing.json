{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.hatsubai.storeListing",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["titleDid", "regionIso3166", "locale", "currencyIso4217", "publishStatus", "createdAt"],
        "properties": {
          "titleDid":         { "type": "string" },
          "regionIso3166":    { "type": "string" },
          "locale":           { "type": "string", "description": "BCP-47 locale (e.g. ja-JP / en-US / pt-BR)." },
          "priceMinor":       { "type": "integer", "description": "Price in minor currency units (cents / sen). AT Lexicon forbids floats." },
          "currencyIso4217":  { "type": "string" },
          "releaseDate":      { "type": "string", "format": "datetime" },
          "preorderAt":       { "type": "string", "format": "datetime" },
          "descriptionCid":   { "type": "string", "description": "CID of the long-form store description blob." },
          "shortDescription": { "type": "string" },
          "publishStatus": {
            "type": "string",
            "knownValues": ["draft", "scheduled", "live", "delisted"]
          },
          "createdAt":        { "type": "string", "format": "datetime" },
          "updatedAt":        { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
