{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.hatsubai.title",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["gamesTitleDid", "platformCode", "masterStatus", "createdAt"],
        "properties": {
          "gamesTitleDid": {
            "type": "string",
            "description": "DID of the cross-platform vertex_games_title row this projection belongs to."
          },
          "platformCode":       { "type": "string" },
          "titleId":            { "type": "string", "description": "Platform-issued unique id (NSUID / CUSA / 9PXX product id / Steam appId)." },
          "masterStatus": {
            "type": "string",
            "knownValues": ["draft", "in_dev", "alpha", "beta", "submitted", "approved", "released", "delisted"]
          },
          "targetReleaseDate":  { "type": "string", "format": "datetime" },
          "leadStudioDid":      { "type": "string" },
          "publisherDid":       { "type": "string" },
          "storefrontSlug":     { "type": "string" },
          "createdAt":          { "type": "string", "format": "datetime" },
          "updatedAt":          { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
