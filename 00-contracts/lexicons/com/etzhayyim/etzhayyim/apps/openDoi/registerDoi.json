{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openDoi.registerDoi",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "DOI 登録 - Starts BPMN open_doi_register_doi.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "doi",
            "registrantOrgId",
            "publicationType"
          ],
          "properties": {
            "doi": {
              "type": "string",
              "description": "prefix/suffix"
            },
            "registrantOrgId": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "publicationType": {
              "type": "string",
              "enum": [
                "journalArticle",
                "conference",
                "book",
                "dataset",
                "preprint",
                "report"
              ]
            },
            "publisher": {
              "type": "string"
            },
            "publishedAt": {
              "type": "string",
              "format": "datetime"
            },
            "authorsOrcid": {
              "type": "string",
              "description": "pipe-delimited"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "verification": {
              "type": "string",
              "enum": [
                "authoritative",
                "community",
                "candidate"
              ]
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
