{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.lifehack.listTips",
  "defs": {
    "main": {
      "type": "query",
      "description": "List tips, optionally scoped to a topic, ordered by effectiveness DESC.",
      "parameters": {
        "type": "params",
        "properties": {
          "topicId": {"type": "string"},
          "category": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20},
          "offset": {"type": "integer", "minimum": 0, "default": 0}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["tips", "total", "offset", "limit"],
          "properties": {
            "tips": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["tipId", "topicId", "bodyJa", "effectivenessScore"],
                "properties": {
                  "tipId": {"type": "string"},
                  "topicId": {"type": "string"},
                  "bodyJa": {"type": "string"},
                  "bodyEn": {"type": "string"},
                  "effectivenessScore": {"type": "number"},
                  "costJpyMin": {"type": "number"},
                  "costJpyMax": {"type": "number"},
                  "difficulty": {"type": "string"},
                  "sourceUrl": {"type": "string"},
                  "sourceAuthority": {"type": "string"}
                }
              }
            },
            "total": {"type": "integer"},
            "offset": {"type": "integer"},
            "limit": {"type": "integer"}
          }
        }
      }
    }
  }
}
