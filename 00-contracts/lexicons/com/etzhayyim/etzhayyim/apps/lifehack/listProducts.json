{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.lifehack.listProducts",
  "defs": {
    "main": {
      "type": "query",
      "description": "List recommended products. Commercial products carry an Amazon search keyword; diy_tsukuru products carry CAD/factory DID cross-references to tsukuru.etzhayyim.com.",
      "parameters": {
        "type": "params",
        "properties": {
          "category": {"type": "string"},
          "sourceType": {"type": "string", "enum": ["commercial", "diy_tsukuru"]},
          "limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20},
          "offset": {"type": "integer", "minimum": 0, "default": 0}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["products", "total", "offset", "limit"],
          "properties": {
            "products": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["productId", "name", "category", "sourceType"],
                "properties": {
                  "productId": {"type": "string"},
                  "name": {"type": "string"},
                  "brand": {"type": "string"},
                  "category": {"type": "string"},
                  "sourceType": {"type": "string", "enum": ["commercial", "diy_tsukuru"]},
                  "priceJpyMin": {"type": "number"},
                  "priceJpyMax": {"type": "number"},
                  "amazonSearchKeyword": {"type": "string"},
                  "asin": {"type": "string"},
                  "pseCertified": {"type": "boolean"},
                  "tsukuruCadModelDid": {"type": "string"},
                  "tsukuruFactoryDid": {"type": "string"},
                  "tsukuruProductionOrderNsid": {"type": "string"},
                  "estimatedMakeCostJpy": {"type": "number"},
                  "estimatedMakeTimeHours": {"type": "number"},
                  "notesJa": {"type": "string"}
                }
              }
            },
            "total": {"type": "integer"},
            "offset": {"type": "integer"},
            "limit": {"type": "integer"}
          }
        }
      }
    }
  }
}
