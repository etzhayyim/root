{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.lifehack.coverage",
  "defs": {
    "main": {
      "type": "query",
      "description": "Coverage snapshot — counts of topics / tips / products / posts and last activity timestamps.",
      "parameters": {
        "type": "params",
        "properties": {
          "asOf": {"type": "string", "format": "datetime"}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["asOf", "topicsActive", "tipsActive", "productsActive", "postsTotal", "postsLast24h", "lastPostedAtMs", "envReadings"],
          "properties": {
            "asOf": {"type": "string", "format": "datetime"},
            "topicsActive": {"type": "integer"},
            "tipsActive": {"type": "integer"},
            "productsActive": {"type": "integer"},
            "postsTotal": {"type": "integer"},
            "postsLast24h": {"type": "integer"},
            "lastPostedAtMs": {"type": "integer"},
            "envReadings": {"type": "integer"},
            "staticRiskCells": {"type": "integer"}
          }
        }
      }
    }
  }
}
