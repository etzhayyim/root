{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.lifehack.dailyDustPost",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Manual override that fires the daily dust-prevention bsky post pipeline (normally cron-driven 09:00 JST). Useful for ad-hoc replays + smoke tests. Returns the bsky URI of the new post (or null if dedup-skipped).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "topicId": {"type": "string", "description": "Override topic; default = pickTrending()"},
            "tipId": {"type": "string", "description": "Override tip; default = pickBest(topicId)"},
            "dryRun": {"type": "boolean", "default": false}
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": {"type": "boolean"},
            "tipId": {"type": "string"},
            "topicId": {"type": "string"},
            "bskyUri": {"type": "string"},
            "postText": {"type": "string"},
            "skipped": {"type": "boolean", "description": "true if dedup gate skipped (already posted in last 30d)"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
