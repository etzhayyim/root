{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.stablecoinReserves.flagDepegEvent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Stablecoin depeg / run / redemption crisis (bridges cat-bond-ils + mica-crypto + antitrust-dma)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "eventId",
            "attestationVid",
            "minPriceUsd",
            "observedAt"
          ],
          "properties": {
            "eventId": {
              "type": "string"
            },
            "attestationVid": {
              "type": "string",
              "description": "bridges recordAttestation"
            },
            "minPriceUsd": {
              "type": "number"
            },
            "durationMinutes": {
              "type": "integer"
            },
            "redemptionsUsd": {
              "type": "number"
            },
            "triggerCause": {
              "type": "string",
              "enum": [
                "reserve_quality",
                "bank_failure",
                "liquidity",
                "oracle_failure",
                "bridge_hack",
                "regulatory",
                "market"
              ]
            },
            "observedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "severityTier": {
              "type": "string",
              "enum": [
                "mild",
                "distressed",
                "failed"
              ]
            }
          }
        }
      }
    }
  }
}