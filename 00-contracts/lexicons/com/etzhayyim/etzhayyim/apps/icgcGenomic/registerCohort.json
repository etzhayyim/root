{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.icgcGenomic.registerCohort",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ICGC-ARGO / TCGA / UK Biobank / AoU cohort (bridges precision-medicine + fhir-health-data + pandemic-treaty + vaccine-equity)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "cohortId",
            "cohortName",
            "platform",
            "registeredAt"
          ],
          "properties": {
            "cohortId": {
              "type": "string"
            },
            "programLei": {
              "type": "string"
            },
            "cohortName": {
              "type": "string"
            },
            "participantsCount": {
              "type": "integer"
            },
            "platform": {
              "type": "string",
              "enum": [
                "wgs",
                "wes",
                "rna_seq",
                "methylome",
                "proteome",
                "single_cell",
                "targeted_panel"
              ]
            },
            "consentModel": {
              "type": "string",
              "enum": [
                "broad",
                "tiered",
                "dynamic",
                "open",
                "indigenous_collective"
              ]
            },
            "datasetAccessModel": {
              "type": "string",
              "enum": [
                "open",
                "controlled",
                "federated",
                "dac_review"
              ]
            },
            "registeredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}