{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.icgcGenomic.recordClinvarSubmission",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ClinVar / HGVS variant submission (bridges pharma-supply + universal-health-coverage)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "submissionId",
            "variantHgvs",
            "clinicalSignificance",
            "submittedAt"
          ],
          "properties": {
            "submissionId": {
              "type": "string"
            },
            "cohortVid": {
              "type": "string",
              "description": "bridges registerCohort"
            },
            "variantHgvs": {
              "type": "string"
            },
            "clinicalSignificance": {
              "type": "string",
              "enum": [
                "benign",
                "likely_benign",
                "uncertain",
                "likely_pathogenic",
                "pathogenic",
                "conflicting",
                "risk_factor",
                "drug_response"
              ]
            },
            "reviewStatus": {
              "type": "string",
              "enum": [
                "expert_panel",
                "single_submitter",
                "multi_submitter",
                "no_assertion",
                "criteria_only"
              ]
            },
            "submittedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}