{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.hakkou.getFerment",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get the status and result of a fermentation job from vertex_hakkou_ferment.",
      "parameters": {
        "type": "params",
        "properties": {
          "fermentVertexId": { "type": "string", "description": "vertex_hakkou_ferment vertex_id" }
        },
        "required": ["fermentVertexId"]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "vertexId": { "type": "string" },
            "agentDid": { "type": "string" },
            "inputKind": { "type": "string" },
            "inputRef": { "type": "string" },
            "outputVertexId": { "type": "string" },
            "outputKind": { "type": "string" },
            "ethanolHash": { "type": "string" },
            "co2AuditRef": { "type": "string" },
            "status": { "type": "string" },
            "createdAt": { "type": "string" },
            "error": { "type": "string" }
          },
          "required": ["vertexId", "agentDid", "status"]
        }
      }
    }
  }
}
