{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.copyright.resolve",
  "defs": {
    "main": {
      "type": "query",
      "description": "Resolve a work by DOI / ISBN-13 / ISRC / ISWC.",
      "parameters": {
        "type": "params",
        "properties": {
          "doi": {"type": "string"},
          "isbn13": {"type": "string", "minLength": 13, "maxLength": 13},
          "isrc": {"type": "string"},
          "iswc": {"type": "string"}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "rkey": {"type": "string"},
            "kind": {"type": "string"},
            "title": {"type": "string"},
            "license": {"type": "string"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
