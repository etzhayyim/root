{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.copyright.work",
  "defs": {
    "main": {
      "type": "record",
      "description": "A copyrighted work. Primary key derived from DOI/ISBN/ISRC/ISWC/registry-regId priority.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["kind", "title", "collectedAt"],
        "properties": {
          "kind": {"type": "string", "enum": ["literary", "musical", "visual", "audiovisual", "software", "dramatic", "choreographic", "architectural", "dataset"]},
          "title": {"type": "string", "maxLength": 1000},
          "authorDids": {"type": "array", "items": {"type": "string", "format": "did"}, "description": "ORCID-linked DIDs"},
          "publisherDid": {"type": "string", "format": "did", "description": "LEI-linked publisher"},
          "doi": {"type": "string", "description": "10.XXXX/... (Crossref/DataCite/mEDRA)"},
          "isbn13": {"type": "string", "maxLength": 13, "minLength": 13},
          "isrc": {"type": "string", "description": "ISO 3901 — 12 chars"},
          "iswc": {"type": "string", "description": "ISO 15707 — T-NNN.NNN.NNN-N"},
          "registry": {"type": "string", "enum": ["us-copyright", "jasrac", "cisac", "crossref", "datacite", "isbn", "orcid", "ascap", "prs"]},
          "regId": {"type": "string"},
          "license": {"type": "string", "description": "CC variant / SPDX ID / CMO blanket / commercial / PD"},
          "firstPublishedAt": {"type": "string", "format": "datetime"},
          "jurisdiction": {"type": "string"},
          "berneAutomatic": {"type": "boolean", "default": true},
          "sourceUrl": {"type": "string", "format": "uri"},
          "sourceDid": {"type": "string", "format": "did"},
          "collectedAt": {"type": "string", "format": "datetime"}
        }
      }
    }
  }
}
