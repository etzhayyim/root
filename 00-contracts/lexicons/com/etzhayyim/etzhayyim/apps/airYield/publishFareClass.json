{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airYield.publishFareClass",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Publish fare class availability and pricing for a flight.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["flight_no", "dep_date", "cabin_class", "rbd"],
          "properties": {
            "flight_no": { "type": "string" },
            "dep_date": { "type": "string" },
            "cabin_class": { "type": "string" },
            "rbd": { "type": "string" },
            "fare_amount": { "type": "string" },
            "currency": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
