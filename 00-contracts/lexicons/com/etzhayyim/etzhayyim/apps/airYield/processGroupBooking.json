{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airYield.processGroupBooking",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Process a group booking request.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["group_name", "pax_count", "origin", "dest"],
          "properties": {
            "group_name": { "type": "string" },
            "pax_count": { "type": "integer" },
            "origin": { "type": "string" },
            "dest": { "type": "string" },
            "dep_date": { "type": "string" },
            "cabin_class": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
