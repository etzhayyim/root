{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.airYield.forecastDemand",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Forecast passenger demand for a specific flight and departure date.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["flight_no", "dep_date"],
          "properties": {
            "flight_no": { "type": "string" },
            "dep_date": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "vertexId": { "type": "string" },
            "instanceKey": { "type": "integer" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
