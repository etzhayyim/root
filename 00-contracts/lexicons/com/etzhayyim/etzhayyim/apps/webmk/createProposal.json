{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.webmk.createProposal",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Submit a web-marketing proposal request. Triggers LangGraph agent loop (research → competitor analysis → strategy → copy → deliver). Returns proposalId immediately; async delivery via Resend.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["clientName", "websiteUrl", "industry"],
          "properties": {
            "clientName":    { "type": "string", "maxLength": 120 },
            "websiteUrl":    { "type": "string", "maxLength": 500 },
            "industry":      { "type": "string", "maxLength": 120, "description": "ISIC Rev 4 sector or free text." },
            "targetAudience":{ "type": "string", "maxLength": 500 },
            "budgetJpy":     { "type": "integer", "minimum": 0 },
            "deliveryEmail": { "type": "string", "maxLength": 256, "description": "Recipient email for proposal delivery via Resend." },
            "createAdCampaign": { "type": "boolean", "description": "If true, also calls ads.etzhayyim.com createCampaign after generation." }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["proposalId", "status"],
          "properties": {
            "proposalId": { "type": "string" },
            "status":     { "type": "string", "enum": ["queued", "running", "delivered", "failed"] },
            "createdAt":  { "type": "string", "format": "datetime" }
          }
        }
      }
    }
  }
}
