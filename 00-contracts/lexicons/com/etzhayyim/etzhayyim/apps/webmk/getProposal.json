{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.webmk.getProposal",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a marketing proposal by ID.",
      "parameters": {
        "type": "params",
        "required": ["proposalId"],
        "properties": {
          "proposalId": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["proposalId", "status"],
          "properties": {
            "proposalId":     { "type": "string" },
            "clientName":     { "type": "string" },
            "websiteUrl":     { "type": "string" },
            "industry":       { "type": "string" },
            "status":         { "type": "string" },
            "strategyJson":   { "type": "string", "description": "JSON-encoded strategy document." },
            "copyMarkdown":   { "type": "string", "description": "Generated ad copy in Markdown." },
            "qualityScore":   { "type": "number" },
            "campaignId":     { "type": "string", "description": "ads.etzhayyim.com campaignId if createAdCampaign was true." },
            "deliveredAt":    { "type": "string", "format": "datetime" },
            "createdAt":      { "type": "string", "format": "datetime" }
          }
        }
      }
    }
  }
}
