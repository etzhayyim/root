{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.judicialReviewGdpr.flagRulingImpact",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Ruling impact / pattern shift / preliminary reference (bridges gdprEnforcementPattern.flagFinePatterns + schrems-challenge + consumer-protection)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "reviewVid",
            "rulingKind",
            "rulingAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "reviewVid": {
              "type": "string",
              "description": "bridges recordReview"
            },
            "rulingKind": {
              "type": "string",
              "enum": [
                "annulled",
                "upheld",
                "referred_to_cjeu",
                "partial_annul",
                "interpretive_guidance",
                "doctrinal_shift",
                "public_body_liable",
                "private_body_liable",
                "remedy_expanded",
                "remedy_narrowed",
                "damages_quantified"
              ]
            },
            "rulingAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}