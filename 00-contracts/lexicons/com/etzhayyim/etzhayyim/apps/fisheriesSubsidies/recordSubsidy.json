{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.fisheriesSubsidies.recordSubsidy",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "WTO Fisheries Subsidies Agreement disclosure (bridges fisheries-iuu + cofog + wto-dispute)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "subsidyId",
            "memberIso3",
            "subsidyType",
            "amountUsd",
            "notifiedAt"
          ],
          "properties": {
            "subsidyId": {
              "type": "string"
            },
            "memberIso3": {
              "type": "string"
            },
            "recipientLei": {
              "type": "string"
            },
            "subsidyType": {
              "type": "string",
              "enum": [
                "fuel",
                "vessel_construction",
                "operating_cost",
                "gear",
                "insurance",
                "port_dues",
                "processing",
                "tax_concession"
              ]
            },
            "amountUsd": {
              "type": "number"
            },
            "targetsIuu": {
              "type": "boolean"
            },
            "targetsOverfished": {
              "type": "boolean"
            },
            "cofogExpenditureVid": {
              "type": "string",
              "description": "bridges open-cofog-expenditure"
            },
            "notifiedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "complianceTier": {
              "type": "string",
              "enum": [
                "neutral",
                "capacity_enhancing",
                "prohibited"
              ]
            }
          }
        }
      }
    }
  }
}