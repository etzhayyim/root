{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.fisheriesSubsidies.flagNotificationGap",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Notification gap / peer review finding",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "flagId",
            "memberIso3",
            "period",
            "missingCategories",
            "flaggedAt"
          ],
          "properties": {
            "flagId": {
              "type": "string"
            },
            "memberIso3": {
              "type": "string"
            },
            "period": {
              "type": "string",
              "description": "YYYY"
            },
            "expectedCategories": {
              "type": "string"
            },
            "missingCategories": {
              "type": "string"
            },
            "raisedByIso3": {
              "type": "string"
            },
            "wtoDisputeVid": {
              "type": "string",
              "description": "bridges open-wto-dispute"
            },
            "flaggedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}