{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kyber.getTenantPlan",
  "defs": {
    "main": {
      "type": "query",
      "description": "Return current plan, usage counters, and limits for the calling tenant.",
      "parameters": {
        "type": "params",
        "properties": {
          "orgDid": { "type": "string", "format": "did" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["tenantId", "planId", "status"],
          "properties": {
            "tenantId":              { "type": "string" },
            "planId":                { "type": "string" },
            "status":                { "type": "string" },
            "maxUsers":              { "type": "integer" },
            "maxMonthlyTxns":        { "type": "integer" },
            "usage": {
              "type": "object",
              "properties": {
                "xrpcRequestsThisMonth":    { "type": "integer" },
                "rwRowsThisMonth":          { "type": "integer" },
                "llmTokensThisMonth":       { "type": "integer" },
                "langserverInvocationsThisMonth":  { "type": "integer" },
                "pdsBytesThisMonth":        { "type": "integer" }
              }
            }
          }
        }
      },
      "errors": [
        { "name": "TenantNotFound", "description": "No tenant provisioned for this orgDid" }
      ]
    }
  }
}
