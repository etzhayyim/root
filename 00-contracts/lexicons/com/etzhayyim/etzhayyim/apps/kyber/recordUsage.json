{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kyber.recordUsage",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Append a usage delta to vertex_kyber_usage_meter. Called internally by CF Worker middleware on each XRPC request and by LangServer handlers on job completion.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["orgDid", "meterType", "deltaCount"],
          "properties": {
            "orgDid":      { "type": "string", "format": "did" },
            "meterType":   { "type": "string", "enum": ["xrpc_request", "rw_row", "llm_token", "langserver_invocation", "pds_byte"] },
            "deltaCount":  { "type": "integer", "minimum": 1 },
            "periodMonth": { "type": "string", "description": "YYYY-MM; defaults to current month if omitted" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok":       { "type": "boolean" },
            "meterId":  { "type": "string" }
          }
        }
      }
    }
  }
}
