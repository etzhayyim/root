{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kyber.inbox.calendarSignal",
  "defs": {
    "main": {
      "type": "record",
      "description": "An Outlook/Google calendar event classified and routed to a kyber department. Subject is encrypted; attendee graph is indexable.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["eventIdHash", "startAt", "accountDid", "kyberDept", "signalClass"],
        "properties": {
          "eventIdHash":   { "type": "string" },
          "accountDid":    { "type": "string", "format": "did" },
          "subjectEnc":    { "type": "string" },
          "subjectHash":   { "type": "string" },
          "startAt":       { "type": "string", "format": "datetime" },
          "endAt":         { "type": "string", "format": "datetime" },
          "durationMin":   { "type": "integer", "minimum": 0 },
          "organizerAddress": { "type": "string" },
          "location":      { "type": "string", "maxLength": 200 },
          "showAs":        { "type": "string", "enum": ["free", "tentative", "busy", "oof", "workingElsewhere", "unknown"] },
          "isCancelled":   { "type": "boolean" },
          "attendeeCount": { "type": "integer", "minimum": 0 },
          "internalAttendeeCount": { "type": "integer", "minimum": 0 },
          "externalAttendeeCount": { "type": "integer", "minimum": 0 },
          "kyberDept":     { "type": "string", "enum": ["accounting", "hr", "procurement", "inventory", "sales", "it", "strategy"] },
          "kyberDeptDid":  { "type": "string", "format": "did" },
          "signalClass":   { "type": "string", "enum": ["signal", "noise", "focus"] },
          "sensitivityOrd": { "type": "integer", "minimum": 0, "maximum": 3 }
        }
      }
    }
  }
}
