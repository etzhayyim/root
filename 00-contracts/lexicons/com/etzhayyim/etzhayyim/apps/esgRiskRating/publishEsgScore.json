{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.esgRiskRating.publishEsgScore",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "ESG rating (carrier-esg+lei+cyber-compliance bridge)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "ratingId",
            "entityLei",
            "agency",
            "compositeScore",
            "publishedAt"
          ],
          "properties": {
            "ratingId": {
              "type": "string"
            },
            "entityLei": {
              "type": "string"
            },
            "agency": {
              "type": "string",
              "enum": [
                "msci",
                "sustainalytics",
                "iss",
                "refinitiv",
                "fitch-esg",
                "moodys-esg"
              ]
            },
            "envScore": {
              "type": "number"
            },
            "socialScore": {
              "type": "number"
            },
            "govScore": {
              "type": "number"
            },
            "compositeScore": {
              "type": "number"
            },
            "ciiVid": {
              "type": "string",
              "description": "open-carrier-esg.cii ref"
            },
            "auditVid": {
              "type": "string",
              "description": "open-cyber-compliance.audit ref"
            },
            "greenBunkerVid": {
              "type": "string"
            },
            "publishedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "ratingTier": {
              "type": "string",
              "enum": [
                "leader",
                "average",
                "laggard",
                "non-compliant"
              ]
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
