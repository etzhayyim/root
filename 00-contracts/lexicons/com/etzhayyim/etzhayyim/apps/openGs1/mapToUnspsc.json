{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openGs1.mapToUnspsc",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "GTIN→UNSPSC 対応 - Starts BPMN open_gs1_map_to_unspsc.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "gtin",
            "unspscCode"
          ],
          "properties": {
            "gtin": {
              "type": "string"
            },
            "unspscCode": {
              "type": "string"
            },
            "confidence": {
              "type": "number"
            },
            "mapperDid": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
