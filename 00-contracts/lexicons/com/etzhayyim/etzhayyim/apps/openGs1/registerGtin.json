{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openGs1.registerGtin",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "GTIN 登録 - Starts BPMN open_gs1_register_gtin.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "gtin",
            "gtinFormat",
            "brandOrgId",
            "registeredAt"
          ],
          "properties": {
            "gtin": {
              "type": "string",
              "description": "GTIN-8/12/13/14"
            },
            "gtinFormat": {
              "type": "string",
              "enum": [
                "GTIN-8",
                "GTIN-12",
                "GTIN-13",
                "GTIN-14"
              ]
            },
            "brandOrgId": {
              "type": "string"
            },
            "productName": {
              "type": "string"
            },
            "productCategory": {
              "type": "string"
            },
            "countryOfOrigin": {
              "type": "string"
            },
            "netWeightG": {
              "type": "number"
            },
            "containerType": {
              "type": "string"
            },
            "checkDigitValid": {
              "type": "boolean"
            },
            "registeredAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
