{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.urbanMobility.registerMaasRoute",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Mobility-as-a-Service multimodal route (bridges logistics-lastmile + datacenter + open-transit)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "routeId",
            "cityUnlocode",
            "modes",
            "activatedAt"
          ],
          "properties": {
            "routeId": {
              "type": "string"
            },
            "providerLei": {
              "type": "string"
            },
            "cityUnlocode": {
              "type": "string"
            },
            "modes": {
              "type": "string",
              "description": "comma: bus,metro,rail,bike,scooter,carshare,ride,ferry"
            },
            "originStopVid": {
              "type": "string"
            },
            "destStopVid": {
              "type": "string"
            },
            "avgTravelSec": {
              "type": "integer"
            },
            "priceUsd": {
              "type": "number"
            },
            "co2GPerTrip": {
              "type": "number"
            },
            "activatedAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            },
            "sustainabilityTier": {
              "type": "string",
              "enum": [
                "zero_low",
                "low_carbon",
                "standard",
                "high_carbon"
              ]
            }
          }
        }
      }
    }
  }
}