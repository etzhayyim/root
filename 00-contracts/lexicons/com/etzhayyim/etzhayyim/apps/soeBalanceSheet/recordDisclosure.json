{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.soeBalanceSheet.recordDisclosure",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "State-owned enterprise balance sheet / contingent liabilities (bridges debtTransparency.flagHiddenDebt + sovereign-debt + fiscal-risk)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "disclosureId",
            "parentGovIso3",
            "sector",
            "asOfDate"
          ],
          "properties": {
            "disclosureId": {
              "type": "string"
            },
            "soeLei": {
              "type": "string"
            },
            "parentGovIso3": {
              "type": "string"
            },
            "sector": {
              "type": "string",
              "enum": [
                "power",
                "oil_gas",
                "mining",
                "rail_transport",
                "air_transport",
                "shipping",
                "telecom",
                "banking_development",
                "insurance",
                "pension",
                "agriculture",
                "water",
                "postal"
              ]
            },
            "totalAssetsBusd": {
              "type": "number"
            },
            "totalDebtBusd": {
              "type": "number"
            },
            "sovereignGuaranteedBusd": {
              "type": "number"
            },
            "hiddenDebtVid": {
              "type": "string",
              "description": "bridges debtTransparency.flagHiddenDebt"
            },
            "asOfDate": {
              "type": "string"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}