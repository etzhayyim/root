{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.freightRate.recordSpotQuote",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Spot quote per carrier",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "quoteId",
            "carrierCode",
            "tradeLane",
            "boxType",
            "rateUsdBox",
            "quotedAt",
            "effectiveFrom"
          ],
          "properties": {
            "quoteId": {
              "type": "string"
            },
            "carrierCode": {
              "type": "string"
            },
            "tradeLane": {
              "type": "string"
            },
            "boxType": {
              "type": "string",
              "enum": [
                "20gp",
                "40gp",
                "40hc",
                "20rf",
                "40rf"
              ]
            },
            "rateUsdBox": {
              "type": "number"
            },
            "bafUsd": {
              "type": "number"
            },
            "peakSeasonSurcharge": {
              "type": "number"
            },
            "quotedAt": {
              "type": "string",
              "format": "datetime"
            },
            "effectiveFrom": {
              "type": "string",
              "format": "date"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "premiumTier": {
              "type": "string",
              "enum": [
                "below-index",
                "at-index",
                "above-index",
                "premium"
              ]
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
