{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.freightRate.publishRateIndex",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Rate index publication (SCFI/WCI/Xeneta)",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "indexId",
            "benchmark",
            "tradeLane",
            "valueUsdTeu",
            "publishDate"
          ],
          "properties": {
            "indexId": {
              "type": "string"
            },
            "benchmark": {
              "type": "string",
              "enum": [
                "SCFI",
                "WCI",
                "Xeneta",
                "CCFI",
                "NCFI"
              ]
            },
            "tradeLane": {
              "type": "string"
            },
            "valueUsdTeu": {
              "type": "number"
            },
            "baselineValue": {
              "type": "number"
            },
            "weekOverWeekPct": {
              "type": "number"
            },
            "publishDate": {
              "type": "string",
              "format": "date"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vertexId": {
              "type": "string"
            },
            "shockTier": {
              "type": "string",
              "enum": [
                "stable",
                "elevated",
                "spike",
                "crash"
              ]
            },
            "instanceKey": {
              "type": "integer"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
