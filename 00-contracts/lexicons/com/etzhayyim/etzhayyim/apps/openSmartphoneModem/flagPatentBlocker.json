{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.openSmartphoneModem.flagPatentBlocker",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Flag an active SEP/patent that blocks modem implementation",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["modemDid", "patentNo", "rat", "frandDeclared", "severity"],
          "properties": {
            "modemDid": { "type": "string", "format": "did" },
            "patentNo": { "type": "string" },
            "rat": { "type": "string", "knownValues": ["4g-lte", "5g-nr", "wifi6", "wifi7", "bt", "gnss", "other"] },
            "frandDeclared": { "type": "boolean" },
            "severity": { "type": "string", "knownValues": ["critical", "high", "medium"] },
            "holderDid": { "type": "string", "format": "did" },
            "poolId": { "type": "string" },
            "expiryDate": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["vertexId"],
          "properties": { "vertexId": { "type": "string" } }
        }
      }
    }
  }
}
