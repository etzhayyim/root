{
  "lexicon": 1,
  "id": "com.etzhayyim.market.listOffer",
  "defs": {
    "main": {
      "type": "query",
      "description": "List published market offers (ADR 2605011300). Returns 5-lane public market listings with priceUnit / settlementCurrency / issuer did:erc725 fields. Phase 1 lanes: vault / sashiosae / lawfirm / bpmn / murakumo.",
      "parameters": {
        "type": "params",
        "properties": {
          "lane": {
            "type": "string",
            "enum": ["vault", "sashiosae", "lawfirm", "bpmn", "murakumo"],
            "description": "Filter by market lane. Omit for all lanes."
          },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["offers"],
          "properties": {
            "offers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["listingId", "lane", "issuerDid", "priceUnit", "settlementCurrency", "publishedAt"],
                "properties": {
                  "listingId": { "type": "string" },
                  "lane": { "type": "string" },
                  "issuerDid": { "type": "string", "description": "did:erc725 of the lane operator" },
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "priceUnit": { "type": "number", "description": "Spot price per quantity unit" },
                  "settlementCurrency": { "type": "string", "description": "ISO 4217 or ERC-20 symbol" },
                  "minQuantity": { "type": "number" },
                  "maxQuantity": { "type": "number" },
                  "vacuumScore": { "type": "number", "description": "Inverse of supply saturation; higher = more demand gradient" },
                  "publishedAt": { "type": "string", "format": "datetime" }
                }
              }
            },
            "cursor": { "type": "string" }
          }
        }
      }
    }
  }
}
