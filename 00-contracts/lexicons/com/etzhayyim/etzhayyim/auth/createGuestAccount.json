{
  "lexicon": 1,
  "id": "com.etzhayyim.auth.createGuestAccount",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create a guest account with username/password. Issues AT Protocol session with guest tier.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["username", "password"],
          "properties": {
            "username": { "type": "string", "description": "3-30 chars, lowercase alphanumeric with _ and -", "minLength": 3, "maxLength": 30 },
            "password": { "type": "string", "description": "Minimum 8 characters", "minLength": 8 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did", "handle", "accessJwt", "refreshJwt", "tier"],
          "properties": {
            "did": { "type": "string" },
            "handle": { "type": "string" },
            "accessJwt": { "type": "string" },
            "refreshJwt": { "type": "string" },
            "tier": { "type": "string", "const": "guest" }
          }
        }
      },
      "errors": [
        { "name": "InvalidUsername", "description": "Username must be 3-30 chars, alphanumeric with _ and -" },
        { "name": "WeakPassword", "description": "Password must be at least 8 characters" }
      ]
    }
  }
}
