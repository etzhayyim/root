{
  "lexicon": 1,
  "id": "com.etzhayyim.auth.passkeyVerifyAuth",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Verify WebAuthn authentication assertion. Validates signature against stored credential and issues AT Protocol session.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["challenge", "credentialId", "clientDataJson", "authenticatorData", "signature"],
          "properties": {
            "challenge": { "type": "string", "description": "Original challenge from passkeyBeginAuth" },
            "credentialId": { "type": "string", "description": "Base64url-encoded credential ID" },
            "clientDataJson": { "type": "string", "description": "Base64url-encoded clientDataJSON" },
            "authenticatorData": { "type": "string", "description": "Base64url-encoded authenticatorData" },
            "signature": { "type": "string", "description": "Base64url-encoded signature" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did", "sessionTokens", "credentialId", "newSignCount"],
          "properties": {
            "did": { "type": "string" },
            "sessionTokens": { "type": "object" },
            "credentialId": { "type": "string" },
            "newSignCount": { "type": "integer" }
          }
        }
      },
      "errors": [
        { "name": "AuthenticationFailed" },
        { "name": "CredentialNotFound", "description": "Passkey credential not found - sign up first" },
        { "name": "ConfigError", "description": "AUTH_DB D1 binding is required" }
      ]
    }
  }
}
