{
  "lexicon": 1,
  "id": "com.etzhayyim.auth.createPlcAlias",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create a did:plc alias for a did:web identity. Used for AT Protocol federation bridge.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["webDid", "handle"],
          "properties": {
            "webDid": { "type": "string", "description": "Source did:web identity" },
            "handle": { "type": "string", "description": "AT Protocol handle" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["webDid", "plcDid", "handle", "createdAt"],
          "properties": {
            "webDid": { "type": "string" },
            "plcDid": { "type": "string", "description": "Generated did:plc alias" },
            "handle": { "type": "string" },
            "createdAt": { "type": "string", "format": "datetime" }
          }
        }
      }
    }
  }
}
