{
  "lexicon": 1,
  "id": "com.etzhayyim.auth.listAgentKeys",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "List agent signing keys for a DID.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did"],
          "properties": {
            "did": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did", "keys"],
          "properties": {
            "did": { "type": "string" },
            "keys": { "type": "array", "items": { "type": "ref", "ref": "#AgentKey" } }
          }
        }
      }
    }
  }
}
