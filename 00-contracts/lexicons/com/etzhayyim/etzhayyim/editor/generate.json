{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.editor.generate",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["projectId", "prompt"],
          "properties": {
            "projectId": { "type": "string" },
            "prompt": { "type": "string", "maxLength": 8192 },
            "targetPath": { "type": "string" },
            "framework": { "type": "string", "enum": ["react", "svelte", "vanilla"] }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["path", "framework", "code", "model"],
          "properties": {
            "path": { "type": "string" },
            "framework": { "type": "string" },
            "code": { "type": "string" },
            "model": { "type": "string" }
          }
        }
      }
    }
  }
}
