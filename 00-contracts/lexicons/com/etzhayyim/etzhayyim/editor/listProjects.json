{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.editor.listProjects",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["projects"],
          "properties": {
            "projects": {
              "type": "array",
              "items": { "type": "ref", "ref": "com.etzhayyim.apps.editor.editorProject" }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
