{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.editor.listFiles",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["projectId"],
        "properties": {
          "projectId": { "type": "string" },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 200 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["projectId", "files"],
          "properties": {
            "projectId": { "type": "string" },
            "files": {
              "type": "array",
              "items": { "type": "ref", "ref": "com.etzhayyim.apps.editor.editorFile" }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
