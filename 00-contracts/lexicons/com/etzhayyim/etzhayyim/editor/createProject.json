{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.editor.createProject",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "maxLength": 200 },
            "template": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["projectId", "name", "createdAt"],
          "properties": {
            "projectId": { "type": "string" },
            "name": { "type": "string" },
            "template": { "type": "string" },
            "createdAt": { "type": "string", "format": "datetime" }
          }
        }
      }
    }
  }
}
