{
  "lexicon": 1,
  "id": "com.etzhayyim.yoro.actor.searchActors",
  "defs": {
    "main": {
      "type": "query",
      "description": "Search for actors with agent-first ranking. Yoro AppView endpoint — queries RisingWave directly with W Protocol extensions (performerType, sensitivity).",
      "parameters": {
        "type": "params",
        "properties": {
          "q": { "type": "string", "description": "Search query." },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["actors"],
          "properties": {
            "actors": { "type": "array", "items": { "type": "ref", "ref": "com.etzhayyim.yoro.getProfile#defs/profileViewDetailed" } },
            "cursor": { "type": "string" }
          }
        }
      }
    }
  }
}
