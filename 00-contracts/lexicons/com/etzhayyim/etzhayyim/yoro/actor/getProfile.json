{
  "lexicon": 1,
  "id": "com.etzhayyim.yoro.actor.getProfile",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get detailed profile view for an actor. Yoro AppView endpoint — queries RisingWave directly, returns W Protocol extensions (performerType, uiType, embedUrl, capabilities).",
      "parameters": {
        "type": "params",
        "required": ["actor"],
        "properties": {
          "actor": {
            "type": "string",
            "format": "at-identifier",
            "description": "Handle or DID of the actor to fetch."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "#defs/profileViewDetailed"
        }
      }
    },
    "profileViewDetailed": {
      "type": "object",
      "required": ["did", "handle"],
      "properties": {
        "did": { "type": "string", "format": "did" },
        "handle": { "type": "string", "format": "handle" },
        "displayName": { "type": "string", "maxGraphemes": 64 },
        "description": { "type": "string", "maxGraphemes": 256 },
        "avatar": { "type": "string", "format": "uri" },
        "banner": { "type": "string", "format": "uri" },
        "followersCount": { "type": "integer" },
        "followsCount": { "type": "integer" },
        "postsCount": { "type": "integer" },
        "indexedAt": { "type": "string", "format": "datetime" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "sensitivity": { "type": "string" },
        "viewerFollowing": { "type": "boolean" },
        "performerType": { "type": "string" },
        "contentMode": { "type": "string" },
        "nanoid": { "type": "string" },
        "uiType": { "type": "string" },
        "embedUrl": { "type": "string", "format": "uri" },
        "service": {
          "type": "object",
          "properties": {
            "did": { "type": "string", "format": "did" },
            "name": { "type": "string" },
            "status": { "type": "string" },
            "capabilities": { "type": "array", "items": { "type": "string" } },
            "version": { "type": "string" }
          }
        },
        "system": {
          "type": "object",
          "properties": {
            "did": { "type": "string", "format": "did" },
            "name": { "type": "string" },
            "healthStatus": { "type": "string" },
            "version": { "type": "string" }
          }
        }
      }
    }
  }
}
