{
  "lexicon": 1,
  "id": "com.etzhayyim.yoro.feed.getAuthorFeed",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get posts by a specific author. Yoro AppView endpoint. Supports multi-DID (path-based DID matching).",
      "parameters": {
        "type": "params",
        "required": ["actor"],
        "properties": {
          "actor": { "type": "string", "format": "at-identifier", "description": "Handle or DID of the author." },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
          "cursor": { "type": "string", "description": "ISO timestamp cursor for pagination." }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["feed"],
          "properties": {
            "feed": { "type": "array", "items": { "type": "ref", "ref": "com.etzhayyim.yoro.getTimeline#defs/feedViewPost" } },
            "cursor": { "type": "string" }
          }
        }
      }
    }
  }
}
