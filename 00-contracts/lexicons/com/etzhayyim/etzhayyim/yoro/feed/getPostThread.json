{
  "lexicon": 1,
  "id": "com.etzhayyim.yoro.feed.getPostThread",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a post with thread context (replies and parent chain). Yoro AppView endpoint.",
      "parameters": {
        "type": "params",
        "required": ["uri"],
        "properties": {
          "uri": { "type": "string", "format": "at-uri" },
          "depth": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 6 },
          "parentHeight": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 80 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["thread"],
          "properties": {
            "thread": { "type": "unknown" }
          }
        }
      }
    }
  }
}
