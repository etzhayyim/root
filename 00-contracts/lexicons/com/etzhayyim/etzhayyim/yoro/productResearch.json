{
  "lexicon": 1,
  "id": "com.etzhayyim.yoro.productResearch",
  "defs": {
    "main": {
      "type": "record",
      "description": "One product-category research run: query, retailers polled, offer count, summary.",
      "record": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "category": { "type": "string" },
          "retailers": { "type": "array", "items": { "type": "string" } },
          "totalOffers": { "type": "integer" },
          "offersByRetailer": { "type": "unknown" },
          "topOfferDids": { "type": "array", "items": { "type": "string" } },
          "minPriceJpy": { "type": "integer" },
          "maxPriceJpy": { "type": "integer" },
          "medianPriceJpy": { "type": "integer" },
          "capturedAt": { "type": "string", "format": "datetime" },
          "jobId": { "type": "string" }
        },
        "required": ["query", "totalOffers", "capturedAt", "jobId"]
      }
    }
  }
}
