{
  "lexicon": 1,
  "id": "com.etzhayyim.pds.importRepo",
  "description": "Import a repository. Superset of com.atproto.repo.importRepo — accepts both CAR data and JSON wrapper.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "data": {
              "type": "string",
              "description": "Base64-encoded CAR file data. Compatible with com.atproto.repo.importRepo input."
            },
            "did": {
              "type": "string",
              "format": "did",
              "description": "etzhayyim extension: target DID for import"
            }
          },
          "required": [
            "data"
          ]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "imported": {
              "type": "boolean"
            }
          },
          "required": [
            "imported"
          ]
        }
      }
    }
  }
}
