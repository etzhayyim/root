{
  "lexicon": 1,
  "id": "com.etzhayyim.murakumo.evalV6",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Run Hayate V6 benchmark. SQL-routing eval default off in etzhayyim (RW SQL not available; vendor-only feature, etzhayyim.com keeps sql=true as default for its RisingWave substrate).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "default": "quick"
            },
            "checkpoint": {
              "type": "string"
            },
            "limit": {
              "type": "integer",
              "default": 100
            },
            "sql": {
              "type": "boolean",
              "default": false
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "benchResultsPath"
          ],
          "properties": {
            "benchResultsPath": {
              "type": "string"
            },
            "sqlResultsPath": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
