{
  "lexicon": 1,
  "id": "com.etzhayyim.mangaka.composePage",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Stage 7/8 — Compose final page. Loads approved toned panels + lettering overlays for a page, sends them to ComfyUI /v1/images/edits (composite mode) for final page render. Writes one vertex_mangaka row (kind=composedPage).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["pageId"],
          "properties": {
            "pageId": { "type": "string" },
            "gutterPx": { "type": "integer", "default": 24 },
            "pageSize": { "type": "string", "enum": ["b5", "a4", "webtoon"], "default": "b5" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "pageCompositeVertexId": { "type": "string", "format": "at-uri" },
            "blobCid": { "type": "string" },
            "panelCount": { "type": "integer" },
            "renderMs": { "type": "integer" }
          }
        }
      }
    }
  }
}
