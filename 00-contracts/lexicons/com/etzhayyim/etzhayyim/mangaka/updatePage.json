{
  "lexicon": 1,
  "id": "com.etzhayyim.mangaka.updatePage",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Update a page record. Kysely UPDATE vertex_mangaka + edge_contains.quantity when pageNum changes.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["pageId"],
          "properties": {
            "pageId": { "type": "string", "description": "Page rkey or at-uri." },
            "id": { "type": "string", "description": "Legacy alias of pageId." },
            "pageNum": { "type": "integer" },
            "altText": { "type": "string" },
            "width": { "type": "integer" },
            "height": { "type": "integer" },
            "compositedImageCid": { "type": "string", "format": "cid" },
            "charactersAppearing": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["slug"],
                "properties": {
                  "slug": { "type": "string" },
                  "displayName": { "type": "string" },
                  "role": { "type": "string" }
                }
              }
            },
            "panels": { "type": "array", "items": { "type": "unknown" } }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["pageId", "status"],
          "properties": {
            "pageId": { "type": "string" },
            "status": { "type": "string" }
          }
        }
      }
    }
  }
}
