{
  "lexicon": 1,
  "id": "com.etzhayyim.ki.bloom",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Publish a synthesized knowledge artifact to the graph. Analogous to phloem transport — synthesized knowledge flows outward (downward) to all parts of the ecosystem.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "artifactId": { "type": "string", "description": "ID of the synthesized artifact to publish" }
          },
          "required": ["artifactId"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "bloomId": { "type": "string" },
            "publishedAt": { "type": "string", "description": "ISO 8601 timestamp of publication" },
            "error": { "type": "string" }
          },
          "required": ["bloomId", "publishedAt"]
        }
      }
    }
  }
}
