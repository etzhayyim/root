{
  "lexicon": 1,
  "id": "com.etzhayyim.ki.synthesize",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "LLM-based structured synthesis of absorbed signals into a knowledge artifact. Analogous to photosynthesis — absorbed inputs are synthesized into structured knowledge (sugar) for downstream distribution.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "absorbId": { "type": "string", "description": "ID of the absorbed input to synthesize" }
          },
          "required": ["absorbId"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "artifactId": { "type": "string" },
            "synthesis": { "type": "string", "description": "Synthesized knowledge artifact content" },
            "confidence": { "type": "integer", "description": "LLM confidence score 0.0–1.0" },
            "error": { "type": "string" }
          },
          "required": ["artifactId", "synthesis", "confidence"]
        }
      }
    }
  }
}
