{
  "lexicon": 1,
  "id": "com.etzhayyim.isin.getSecurity",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a security by ISIN code or DID.",
      "x-bootstrap": true,
      "parameters": { "type": "params", "properties": { "did": { "type": "string", "format": "did" }, "isin": { "type": "string", "description": "12-character ISO 6166 ISIN (alternative lookup key)" } } },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "did": { "type": "string", "format": "did" }, "isin": { "type": "string" }, "name": { "type": "string" }, "issuerLei": { "type": "string", "description": "ISO 17442 LEI of issuer" }, "issuerDid": { "type": "string", "format": "did", "description": "legal-entity DID" }, "assetClass": { "type": "string", "enum": ["equity", "debt", "derivative", "fund", "commodity", "index", "currency"] }, "cfi": { "type": "string", "description": "ISO 10962 Classification of Financial Instruments code" }, "currency": { "type": "string" }, "country": { "type": "string", "description": "ISO 3166-1 alpha-3" }, "exchangeMic": { "type": "string", "description": "ISO 10383 Market Identifier Code" } } } }
    }
  }
}
