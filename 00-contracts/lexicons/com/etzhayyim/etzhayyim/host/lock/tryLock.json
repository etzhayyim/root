{
  "lexicon": 1,
  "id": "com.etzhayyim.host.lock.tryLock",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Attempt to acquire a distributed lock with a TTL lease.",
      "x-hostImportsMethod": "lockTryLock",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "ttlMs": {
              "type": "integer"
            }
          },
          "required": [
            "key",
            "ttlMs"
          ]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "acquired": {
              "type": "boolean"
            }
          },
          "required": [
            "acquired"
          ]
        }
      }
    }
  }
}
