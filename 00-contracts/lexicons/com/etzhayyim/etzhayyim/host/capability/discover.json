{
  "lexicon": 1,
  "id": "com.etzhayyim.host.capability.discover",
  "defs": {
    "main": {
      "type": "query",
      "description": "Discover capabilities by tag/status (CV-1 discovery).",
      "x-hostImportsMethod": "capabilityDiscover",
      "parameters": {
        "type": "params",
        "properties": {
          "tag": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": [
          "offset",
          "limit"
        ]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "capabilitiesJson": {
              "type": "string"
            }
          },
          "required": [
            "capabilitiesJson"
          ]
        }
      }
    }
  }
}
