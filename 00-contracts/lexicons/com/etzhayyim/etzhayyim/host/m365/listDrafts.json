{
  "lexicon": 1,
  "id": "com.etzhayyim.host.m365.listDrafts",
  "defs": {
    "main": {
      "type": "query",
      "description": "List drafts in /users/{fromUpn}/mailFolders/drafts/messages (newest first). Used for approval UIs / audit trails.",
      "x-hostImportsMethod": "m365ListDrafts",
      "parameters": {
        "type": "params",
        "properties": {
          "token": { "type": "string" },
          "fromUpn": { "type": "string" },
          "top": { "type": "integer", "default": 25, "minimum": 1, "maximum": 100 }
        },
        "required": ["token", "fromUpn"]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "drafts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "subject": { "type": "string" },
                  "toRecipients": { "type": "array", "items": { "type": "string" } },
                  "createdDateTime": { "type": "string" },
                  "lastModifiedDateTime": { "type": "string" },
                  "webLink": { "type": "string" }
                }
              }
            }
          },
          "required": ["drafts"]
        }
      }
    }
  }
}
