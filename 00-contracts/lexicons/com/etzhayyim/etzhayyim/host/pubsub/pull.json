      "x-hostImportsMethod": "pubsubPull",
      "parameters": {
        "type": "params",
        "properties": {
          "topic": {
            "type": "string"
          },
          "maxMessages": {
            "type": "integer"
          }
        },
        "required": [
          "topic",
          "maxMessages"
        ]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "envelopesJson": {
              "type": "string"
            }
          },
          "required": [
            "envelopesJson"
          ]
        }
      }
    }
  }
}
