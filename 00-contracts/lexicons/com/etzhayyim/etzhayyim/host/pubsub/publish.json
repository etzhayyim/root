{
  "lexicon": 1,
  "id": "com.etzhayyim.host.pubsub.publish",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Publish a message to a pubsub topic (at-least-once).",
      "x-hostImportsMethod": "pubsubPublish",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "topic": {
              "type": "string"
            },
            "payload": {
              "type": "string",
              "description": "base64-encoded bytes"
            }
          },
          "required": [
            "topic",
            "payload"
          ]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            }
          },
          "required": [
            "ok"
          ]
        }
      }
    }
  }
}
