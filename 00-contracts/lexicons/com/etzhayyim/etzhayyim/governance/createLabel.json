{
  "lexicon": 1,
  "id": "com.etzhayyim.governance.createLabel",
  "description": "Create a governance label. Input uses official com.atproto.label.defs#label schema.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "label": {
              "type": "ref",
              "description": "Label conforming to official AT Protocol label schema.",
              "ref": "com.atproto.label.defs#label"
            }
          },
          "required": [
            "label"
          ]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "rkey": {
              "type": "string"
            },
            "uri": {
              "type": "string",
              "format": "at-uri"
            },
            "cid": {
              "type": "string",
              "format": "cid"
            }
          },
          "required": [
            "rkey",
            "uri",
            "cid"
          ]
        }
      }
    }
  }
}
