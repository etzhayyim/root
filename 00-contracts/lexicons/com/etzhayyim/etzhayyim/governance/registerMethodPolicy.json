{
  "lexicon": 1,
  "id": "com.etzhayyim.governance.registerMethodPolicy",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string"
            },
            "requiredRoles": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "trustLevel": {
              "type": "string"
            }
          },
          "required": [
            "method"
          ]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string"
            },
            "registered": {
              "type": "boolean"
            }
          },
          "required": [
            "method",
            "registered"
          ]
        }
      }
    }
  }
}
