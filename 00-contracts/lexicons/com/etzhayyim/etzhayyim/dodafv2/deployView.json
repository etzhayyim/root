{
  "lexicon": 1,
  "id": "com.etzhayyim.dodafv2.deployView",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Deploy a DoDAF v2.02 architecture view for an actor DID. References to BPMN (OV-5b/OV-6c), DMN (OV-6a), and form schemas must be via their deployed IDs (bpmnProcessKey/dmnDecisionKey/formKey).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did", "viewId", "viewType", "content"],
          "properties": {
            "did": { "type": "string", "format": "did", "description": "Target actor DID" },
            "viewId": { "type": "string", "description": "Stable view key, e.g., 'open-banking.OV-1'" },
            "viewType": {
              "type": "string",
              "description": "DoDAF v2.02 view designator",
              "enum": [
                "AV-1","AV-2",
                "CV-1","CV-2","CV-3","CV-4","CV-5","CV-6","CV-7",
                "DIV-1","DIV-2","DIV-3",
                "OV-1","OV-2","OV-3","OV-4","OV-5a","OV-5b","OV-6a","OV-6b","OV-6c",
                "PV-1","PV-2","PV-3",
                "SV-1","SV-2","SV-3","SV-4","SV-5a","SV-5b","SV-6","SV-7","SV-8","SV-9","SV-10a","SV-10b","SV-10c",
                "StdV-1","StdV-2",
                "SvcV-1","SvcV-2","SvcV-3a","SvcV-3b","SvcV-4","SvcV-5","SvcV-6","SvcV-7","SvcV-8","SvcV-9","SvcV-10a","SvcV-10b","SvcV-10c"
              ]
            },
            "format": { "type": "string", "enum": ["json", "xml", "bpmn", "dmn", "markdown"], "default": "json" },
            "title": { "type": "string" },
            "content": { "type": "object", "description": "View body (structure depends on viewType)" },
            "refs": {
              "type": "object",
              "description": "Cross-view references",
              "properties": {
                "bpmnProcessKeys": { "type": "array", "items": { "type": "string" } },
                "dmnDecisionKeys": { "type": "array", "items": { "type": "string" } },
                "formKeys": { "type": "array", "items": { "type": "string" } },
                "viewIds": { "type": "array", "items": { "type": "string" } }
              }
            },
            "version": { "type": "integer", "default": 1 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["deployed", "viewId"],
          "properties": {
            "deployed": { "type": "boolean" },
            "viewId": { "type": "string" },
            "viewType": { "type": "string" },
            "version": { "type": "integer" },
            "warnings": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
