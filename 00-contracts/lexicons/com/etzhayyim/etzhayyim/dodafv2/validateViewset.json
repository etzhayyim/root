{
  "lexicon": 1,
  "id": "com.etzhayyim.dodafv2.validateViewset",
  "defs": {
    "main": {
      "type": "query",
      "description": "Validate the DoDAF v2 viewset for a DID: checks AV-1 presence, OV↔SV traceability, CV-2 ↔ capability declarations, and BPMN/DMN/form ref integrity.",
      "parameters": {
        "type": "params",
        "required": ["did"],
        "properties": {
          "did": { "type": "string", "format": "did" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "viewCount"],
          "properties": {
            "ok": { "type": "boolean" },
            "viewCount": { "type": "integer" },
            "missing": { "type": "array", "items": { "type": "string" }, "description": "Required views not present" },
            "brokenRefs": { "type": "array", "items": { "type": "string" } },
            "warnings": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
