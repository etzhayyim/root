{
  "lexicon": 1,
  "id": "com.etzhayyim.dodafv2.getView",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a deployed DoDAF v2 view by viewId (optionally scoped to DID).",
      "parameters": {
        "type": "params",
        "required": ["viewId"],
        "properties": {
          "viewId": { "type": "string" },
          "did": { "type": "string", "format": "did" },
          "version": { "type": "integer", "description": "Omit for latest" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["viewId", "viewType", "content"],
          "properties": {
            "viewId": { "type": "string" },
            "did": { "type": "string", "format": "did" },
            "viewType": { "type": "string" },
            "format": { "type": "string" },
            "title": { "type": "string" },
            "content": { "type": "object" },
            "refs": { "type": "object" },
            "version": { "type": "integer" },
            "deployedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "errors": [{ "name": "NotFound" }]
    }
  }
}
