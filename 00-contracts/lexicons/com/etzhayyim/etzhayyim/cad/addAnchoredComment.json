{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.cad.addAnchoredComment",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Add a comment anchored to a specific topology ref (face / edge / vertex) on a revision. Stored as a domain record via Hyperdrive (vertex_cad_comment per ADR-0036). Social announcement (app.bsky.feed.post) is derived automatically on first post of a thread.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["revisionId", "partOccurrencePath", "topologyRef", "worldPosition", "text"],
          "properties": {
            "revisionId": { "type": "string" },
            "partOccurrencePath": {
              "type": "string",
              "description": "slash-joined assembly path (e.g. `root/gearbox/shaft-2/face-17`)"
            },
            "topologyRef": {
              "type": "object",
              "required": ["kind", "topoId"],
              "properties": {
                "kind": { "type": "string", "enum": ["face", "edge", "vertex"] },
                "topoId": { "type": "string", "description": "BREP topology id (u64)" }
              }
            },
            "worldPosition": {
              "type": "array",
              "items": { "type": "number" },
              "minLength": 3,
              "maxLength": 3,
              "description": "world-space anchor point, model units"
            },
            "cameraSnapshot": {
              "type": "object",
              "description": "camera state at comment creation for click-to-recenter",
              "properties": {
                "target": { "type": "array", "items": { "type": "number" }, "minLength": 3, "maxLength": 3 },
                "distance": { "type": "number" },
                "yaw": { "type": "number" },
                "pitch": { "type": "number" }
              }
            },
            "text": { "type": "string", "maxLength": 4000 },
            "replyTo": {
              "type": "string",
              "description": "parent comment rkey for threaded replies"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["commentUri", "rkey", "createdAt"],
          "properties": {
            "commentUri": { "type": "string" },
            "rkey": { "type": "string" },
            "createdAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "errors": [
        { "name": "RevisionNotFound" },
        { "name": "TopologyRefInvalid", "description": "topologyRef does not resolve on this revision" },
        { "name": "NotAuthorized" }
      ]
    }
  }
}
