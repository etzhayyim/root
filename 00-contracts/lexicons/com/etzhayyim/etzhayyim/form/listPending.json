{
  "lexicon": 1,
  "id": "com.etzhayyim.form.listPending",
  "defs": {
    "main": {
      "type": "query",
      "description": "List pending form tasks awaiting user submission.",
      "parameters": {
        "type": "params",
        "properties": {
          "did": { "type": "string", "description": "Actor DID scope" },
          "assigneeDid": { "type": "string", "description": "Filter by assignee DID" },
          "limit": { "type": "integer", "default": 50, "maximum": 100 },
          "offset": { "type": "integer", "default": 0 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "tasks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "taskId": { "type": "string" },
                  "formKey": { "type": "string" },
                  "name": { "type": "string" },
                  "status": { "type": "string" },
                  "formType": { "type": "string" }
                }
              }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          },
          "required": ["tasks", "total", "offset", "limit"]
        }
      }
    }
  }
}
