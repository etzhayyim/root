{
  "lexicon": 1,
  "id": "com.etzhayyim.repository.blame",
  "defs": {
    "main": {
      "type": "query",
      "description": "Per-line blame for a blob at a given ref or commit. Each line is attributed to the commit that last introduced it.",
      "parameters": {
        "type": "params",
        "required": ["path"],
        "properties": {
          "ownerDid": {
            "type": "string",
            "format": "did",
            "description": "Required when startRef is set."
          },
          "startRef": { "type": "string" },
          "startCommit": { "type": "string" },
          "path": {
            "type": "string",
            "description": "Path within the tree at startRef/startCommit."
          },
          "lineStart": {
            "type": "integer",
            "description": "Optional 1-based range start."
          },
          "lineEnd": {
            "type": "integer",
            "description": "Optional 1-based range end (inclusive)."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["path", "blobHash", "lines"],
          "properties": {
            "path": { "type": "string" },
            "blobHash": { "type": "string" },
            "lines": {
              "type": "array",
              "items": { "type": "ref", "ref": "#blameLine" }
            }
          }
        }
      },
      "errors": [
        { "name": "PathNotFound" },
        { "name": "RefNotFound" },
        { "name": "CommitNotFound" },
        { "name": "BinaryBlob", "description": "Blame not supported for binary blobs." }
      ]
    },
    "blameLine": {
      "type": "object",
      "required": ["lineNo", "content", "commitHash", "authorDid", "authorTimestamp"],
      "properties": {
        "lineNo": { "type": "integer" },
        "content": { "type": "string" },
        "commitHash": { "type": "string" },
        "authorDid": { "type": "string", "format": "did" },
        "authorTimestamp": { "type": "string", "format": "datetime" }
      }
    }
  }
}
