{
  "lexicon": 1,
  "id": "com.etzhayyim.repository.getCommit",
  "defs": {
    "main": {
      "type": "query",
      "description": "Fetch a commit object by hash.",
      "parameters": {
        "type": "params",
        "required": ["commitHash"],
        "properties": {
          "commitHash": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["commitHash", "treeHash", "authorDid", "message", "authorTimestamp", "committerTimestamp"],
          "properties": {
            "commitHash": { "type": "string" },
            "treeHash": { "type": "string" },
            "parentHashes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "authorDid": { "type": "string", "format": "did" },
            "committerDid": { "type": "string", "format": "did" },
            "message": { "type": "string" },
            "authorTimestamp": { "type": "string", "format": "datetime" },
            "committerTimestamp": { "type": "string", "format": "datetime" },
            "signatureEs256": { "type": "string" },
            "signatureValid": {
              "type": "boolean",
              "description": "Server verifies on read. True if signature verifies against authorDid's signing key at authorTimestamp."
            }
          }
        }
      },
      "errors": [
        { "name": "CommitNotFound" }
      ]
    }
  }
}
