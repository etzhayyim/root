{
  "lexicon": 1,
  "id": "com.etzhayyim.repository.getTree",
  "defs": {
    "main": {
      "type": "query",
      "description": "Fetch a tree by hash, returning canonical-sorted entry list.",
      "parameters": {
        "type": "params",
        "required": ["treeHash"],
        "properties": {
          "treeHash": { "type": "string" },
          "recursive": {
            "type": "boolean",
            "default": false,
            "description": "If true, inline nested trees up to maxDepth."
          },
          "maxDepth": { "type": "integer", "default": 16, "maximum": 32 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["treeHash", "entries"],
          "properties": {
            "treeHash": { "type": "string" },
            "entries": {
              "type": "array",
              "items": { "type": "ref", "ref": "com.etzhayyim.repository.createTree#treeEntry" }
            },
            "truncated": {
              "type": "boolean",
              "description": "True if recursive expansion hit maxDepth."
            }
          }
        }
      },
      "errors": [
        { "name": "TreeNotFound" }
      ]
    }
  }
}
