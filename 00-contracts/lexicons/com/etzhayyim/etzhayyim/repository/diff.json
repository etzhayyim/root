{
  "lexicon": 1,
  "id": "com.etzhayyim.repository.diff",
  "defs": {
    "main": {
      "type": "query",
      "description": "Compute tree diff between two commits. Supports path-scoped and binary-aware output.",
      "parameters": {
        "type": "params",
        "required": ["baseCommit", "headCommit"],
        "properties": {
          "baseCommit": { "type": "string" },
          "headCommit": { "type": "string" },
          "pathPrefix": {
            "type": "string",
            "description": "Scope diff to entries under this path prefix."
          },
          "unified": {
            "type": "integer",
            "default": 3,
            "description": "Context lines per hunk. 0 = no context. -1 = full file."
          },
          "includeContent": {
            "type": "boolean",
            "default": true,
            "description": "If false, returns only file-level add/delete/modify summary (fast)."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["baseCommit", "headCommit", "files"],
          "properties": {
            "baseCommit": { "type": "string" },
            "headCommit": { "type": "string" },
            "files": {
              "type": "array",
              "items": { "type": "ref", "ref": "#fileDiff" }
            }
          }
        }
      },
      "errors": [
        { "name": "CommitNotFound" }
      ]
    },
    "fileDiff": {
      "type": "object",
      "required": ["path", "changeKind"],
      "properties": {
        "path": { "type": "string" },
        "changeKind": {
          "type": "string",
          "knownValues": ["added", "modified", "deleted", "renamed", "typeChanged"]
        },
        "oldPath": {
          "type": "string",
          "description": "Populated when changeKind=renamed."
        },
        "oldBlobHash": { "type": "string" },
        "newBlobHash": { "type": "string" },
        "binary": {
          "type": "boolean",
          "description": "True if either side is detected as binary; hunks omitted."
        },
        "hunks": {
          "type": "array",
          "description": "Unified diff hunks. Omitted when includeContent=false or binary=true.",
          "items": { "type": "ref", "ref": "#hunk" }
        }
      }
    },
    "hunk": {
      "type": "object",
      "required": ["oldStart", "oldLines", "newStart", "newLines", "lines"],
      "properties": {
        "oldStart": { "type": "integer" },
        "oldLines": { "type": "integer" },
        "newStart": { "type": "integer" },
        "newLines": { "type": "integer" },
        "lines": {
          "type": "array",
          "description": "Each entry prefixed with ' ', '+', or '-'.",
          "items": { "type": "string" }
        }
      }
    }
  }
}
