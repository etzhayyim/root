{
  "lexicon": 1,
  "id": "com.etzhayyim.narou.createWorldSetting",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Define world building settings for a novel",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["novel_id", "name"],
          "properties": {
            "novel_id": { "type": "string" },
            "name": { "type": "string" },
            "description": { "type": "string" },
            "user_id": { "type": "string" },
            "org_id": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string" }
          }
        }
      }
    }
  }
}
