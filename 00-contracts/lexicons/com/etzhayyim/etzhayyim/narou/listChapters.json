{
  "lexicon": 1,
  "id": "com.etzhayyim.narou.listChapters",
  "defs": {
    "main": {
      "type": "query",
      "description": "List chapters for a novel",
      "parameters": {
        "type": "params",
        "required": ["novel_id"],
        "properties": {
          "novel_id": { "type": "string" },
          "status": { "type": "string" },
          "offset": { "type": "integer" },
          "limit": { "type": "integer" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["chapters", "total", "offset", "limit"],
          "properties": {
            "chapters": { "type": "array", "items": { "type": "object" } },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      }
    }
  }
}
