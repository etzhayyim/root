{
  "lexicon": 1,
  "id": "com.etzhayyim.anime.createSchedule",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register a broadcast schedule slot for an anime title.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["title_id"],
          "properties": {
            "title_id": { "type": "string" },
            "season_id": { "type": "string" },
            "channel": { "type": "string" },
            "day_of_week": { "type": "string" },
            "time_slot": { "type": "string" },
            "start_date": { "type": "string" },
            "end_date": { "type": "string" },
            "org_id": { "type": "string" },
            "user_id": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": { "id": { "type": "string" } } }
      }
    }
  }
}
