{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.kyber.initApqcProjector",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Cross-project bootstrap: kyber ERP follows kyber-projector and writes an apqcBootstrap record. Projector's onCommit sees the follow + record and auto-registers the 13 APQC L1 DIDs plus the 3 APQC LangServer BPMN bindings (idempotent).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "projectorDid": { "type": "string", "description": "Override projector DID (default did:web:kyber-projector.etzhayyim.com)" },
            "projectorNanoid": { "type": "string", "description": "Override projector nanoid (default kyb3proj)" },
            "scope": { "type": "string", "description": "all | l1-only" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "projectorDid": { "type": "string" },
            "followed": { "type": "boolean" },
            "bootstrapRkey": { "type": "string" },
            "scope": { "type": "string" }
          },
          "required": ["ok", "projectorDid", "followed"]
        }
      }
    }
  }
}
