{
  "lexicon": 1,
  "id": "com.etzhayyim.govZaf.resolveOrgPath",
  "defs": {
    "main": {
      "type": "query",
      "description": "Resolve a South Africa government organization path to its actor DID and display metadata.",
      "parameters": {
        "type": "params",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "did": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "nameEn": {
              "type": "string"
            },
            "website": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          },
          "required": []
        }
      }
    }
  }
}
