{
  "lexicon": 1,
  "id": "com.etzhayyim.govZaf.listOrgs",
  "defs": {
    "main": {
      "type": "query",
      "description": "List South Africa government organizations by tier.",
      "parameters": {
        "type": "params",
        "properties": {
          "orgTier": {
            "type": "string"
          },
          "offset": {
            "type": "number"
          },
          "limit": {
            "type": "number",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": []
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "orgs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "did": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "nameEn": {
                    "type": "string"
                  },
                  "website": {
                    "type": "string"
                  },
                  "didRegistered": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "path",
                  "did",
                  "name",
                  "nameEn",
                  "website",
                  "didRegistered"
                ]
              }
            },
            "total": {
              "type": "integer"
            }
          },
          "required": []
        }
      }
    }
  }
}
