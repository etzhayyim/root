{
  "lexicon": 1,
  "id": "com.etzhayyim.govZaf.ingestOfficialSources",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Queue official South Africa government sources through site.etzhayyim.com for WET/WAT/screenshot capture.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            },
            "processBatchSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            },
            "includeOrgSites": {
              "type": "boolean",
              "default": true
            }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "enqueued": {
              "type": "integer"
            },
            "targets": {
              "type": "integer"
            },
            "processed": {
              "type": "integer"
            },
            "processStatus": {
              "type": "integer"
            }
          },
          "required": []
        }
      }
    }
  }
}
