{
  "lexicon": 1,
  "id": "com.etzhayyim.govHkg.seedOrgs",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Seed Hong Kong central ministry and province organization rows into the graph.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "seeded": {
              "type": "integer"
            },
            "remaining": {
              "type": "integer"
            }
          },
          "required": []
        }
      }
    }
  }
}
