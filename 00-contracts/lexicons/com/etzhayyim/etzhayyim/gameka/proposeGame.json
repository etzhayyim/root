{
  "lexicon": 1,
  "id": "com.etzhayyim.gameka.proposeGame",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "brief": {
              "type": "string",
              "maxLength": 2000
            },
            "iteration": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "lineageParent": {
              "type": "string"
            },
            "priorSpecs": {
              "type": "array",
              "description": "Prior iteration outcomes feeding the LangGraph studio's planner so the revise loop avoids the same trap. Emitted by playtestGame on outcome='revise'.",
              "items": {
                "type": "object",
                "properties": {
                  "slug":       { "type": "string" },
                  "title":      { "type": "string" },
                  "score":      { "type": "number" },
                  "outcome":    { "type": "string" },
                  "issuesJson": { "type": "string" }
                }
              }
            }
          },
          "required": ["brief"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "specId": {
              "type": "string"
            },
            "uri": {
              "type": "string"
            },
            "score": {
              "type": "number"
            },
            "iterations": {
              "type": "integer"
            },
            "modelId": {
              "type": "string"
            }
          },
          "required": ["specId", "uri", "score"]
        }
      }
    }
  }
}
