{
  "lexicon": 1,
  "id": "com.etzhayyim.koke.releaseCarbon",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Release a fixation back to raw state (reversible CO₂ exhalation). Only valid while status='fixed'. Once handed off to hakkou, release is no longer possible.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "fixationId": { "type": "string", "description": "ID of the fixation to release" },
            "reason": { "type": "string", "description": "Optional reason for release" }
          },
          "required": ["fixationId"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "released": { "type": "boolean" },
            "fixationId": { "type": "string" },
            "releasedAt": { "type": "string" },
            "error": { "type": "string" }
          },
          "required": ["released", "fixationId"]
        }
      }
    }
  }
}
