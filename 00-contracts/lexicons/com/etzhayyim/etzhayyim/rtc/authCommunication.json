{
  "lexicon": 1,
  "id": "com.etzhayyim.rtc.authCommunication",
  "description": "Real-time communication permissions. etzhayyim-only (no official AT Protocol equivalent). Includes notification push registration from app.bsky for cross-layer push support.",
  "defs": {
    "main": {
      "type": "permission-set",
      "title": "Real-Time Communication",
      "title:lang": {
        "ja": "リアルタイム通信"
      },
      "detail": "Voice/video calls, screen sharing, push notifications, meetings, breakout rooms, and recording. Includes official notification push registration for unified push infrastructure.",
      "detail:lang": {
        "ja": "音声・ビデオ通話、画面共有、プッシュ通知、ミーティング、ブレイクアウトルーム、録画。統合プッシュ基盤のため公式通知プッシュ登録を含む"
      },
      "permissions": [
        {
          "type": "permission",
          "resource": "rpc",
          "description": "Official app.bsky notification push RPCs (shared push infrastructure)",
          "lxm": [
            "app.bsky.notification.registerPush",
            "app.bsky.notification.unregisterPush"
          ]
        },
        {
          "type": "permission",
          "resource": "repo",
          "description": "etzhayyim RTC record collections",
          "collection": ["com.etzhayyim.rtc.*"],
          "action": ["create", "update", "delete"]
        },
        {
          "type": "permission",
          "resource": "rpc",
          "description": "etzhayyim RTC extension RPCs",
          "lxm": [
            "com.etzhayyim.rtc.getVAPIDPublicKey",
            "com.etzhayyim.rtc.sendCallOffer",
            "com.etzhayyim.rtc.sendCallAnswer",
            "com.etzhayyim.rtc.sendCallICE",
            "com.etzhayyim.rtc.hangupCall",
            "com.etzhayyim.rtc.subscribePush",
            "com.etzhayyim.rtc.unsubscribePush",
            "com.etzhayyim.rtc.shareScreen",
            "com.etzhayyim.rtc.scheduleMeeting",
            "com.etzhayyim.rtc.joinMeeting",
            "com.etzhayyim.rtc.admitParticipant",
            "com.etzhayyim.rtc.createBreakout",
            "com.etzhayyim.rtc.startRecording",
            "com.etzhayyim.rtc.raiseHand",
            "com.etzhayyim.rtc.openHuddle"
          ]
        }
      ]
    }
  }
}
