{
  "lexicon": 1,
  "id": "com.etzhayyim.vault.removeMember",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Remove a member's wrappedVaultKey. Caller must rotate vault key separately (rotateVaultKey) to invalidate any keys the removed member may have cached.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "vaultId": { "type": "string" },
            "memberDid": { "type": "string" }
          },
          "required": ["vaultId", "memberDid"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "removed": { "type": "boolean" },
            "removedAt": { "type": "string" },
            "rotationRecommended": {
              "type": "boolean",
              "description": "True when removed member had access to non-trivial item count; client should call rotateVaultKey"
            }
          },
          "required": ["removed", "removedAt", "rotationRecommended"]
        }
      }
    }
  }
}
