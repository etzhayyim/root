{
  "lexicon": 1,
  "id": "com.etzhayyim.vault.deleteItem",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "vaultId": { "type": "string" },
            "itemId": { "type": "string" }
          },
          "required": ["vaultId", "itemId"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "deleted": { "type": "boolean" },
            "deletedAt": { "type": "string" }
          },
          "required": ["deleted", "deletedAt"]
        }
      }
    }
  }
}
