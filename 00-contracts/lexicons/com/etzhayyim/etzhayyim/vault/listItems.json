{
  "lexicon": 1,
  "id": "com.etzhayyim.vault.listItems",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "vaultId": { "type": "string" },
          "limit": { "type": "integer", "default": 100 },
          "offset": { "type": "integer", "default": 0 },
          "labelFilter": { "type": "string" }
        },
        "required": ["vaultId"]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "itemId": { "type": "string" },
                  "itemName": { "type": "string" },
                  "contentType": { "type": "string" },
                  "labels": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "size": { "type": "integer" },
                  "createdAt": { "type": "string" },
                  "updatedAt": { "type": "string" }
                },
                "required": ["itemId", "itemName", "createdAt"]
              }
            },
            "total": { "type": "integer" },
            "limit": { "type": "integer" },
            "offset": { "type": "integer" }
          },
          "required": ["items", "total", "limit", "offset"]
        }
      }
    }
  }
}
