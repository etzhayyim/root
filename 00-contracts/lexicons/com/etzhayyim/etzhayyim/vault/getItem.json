{
  "lexicon": 1,
  "id": "com.etzhayyim.vault.getItem",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "vaultId": { "type": "string" },
          "itemId": { "type": "string" },
          "itemName": {
            "type": "string",
            "description": "Lookup by name within vault. Mutually exclusive with itemId."
          }
        },
        "required": ["vaultId"]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "itemId": { "type": "string" },
            "itemName": { "type": "string" },
            "wrappedItemKey": { "type": "string" },
            "wrappedVaultKey": {
              "type": "string",
              "description": "Caller's wrappedVaultKey (so client can unwrap with memberDeviceKey in single round-trip)"
            },
            "ciphertext": { "type": "string" },
            "iv": { "type": "string" },
            "mac": { "type": "string" },
            "contentType": { "type": "string" },
            "labels": {
              "type": "array",
              "items": { "type": "string" }
            },
            "createdAt": { "type": "string" },
            "updatedAt": { "type": "string" }
          },
          "required": ["itemId", "itemName", "wrappedItemKey", "wrappedVaultKey", "ciphertext", "iv"]
        }
      }
    }
  }
}
