{
  "lexicon": 1,
  "id": "com.etzhayyim.cohort.fission",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "cohortDid": {
              "type": "string"
            },
            "posterior": {
              "type": "number",
              "minimum": 0.95,
              "maximum": 1
            },
            "judgeAgreement": {
              "type": "boolean",
              "const": true
            },
            "evidenceUris": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "required": [
            "cohortDid",
            "posterior",
            "judgeAgreement",
            "evidenceUris"
          ]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "individualDid": {
              "type": "string"
            },
            "individualHandle": {
              "type": "string"
            },
            "derivedFrom": {
              "type": "string"
            },
            "lineageArchiveUri": {
              "type": "string"
            },
            "fissionAt": {
              "type": "string"
            }
          },
          "required": [
            "individualDid",
            "individualHandle",
            "derivedFrom",
            "fissionAt"
          ]
        }
      }
    }
  }
}
