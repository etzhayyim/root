{
  "lexicon": 1,
  "id": "com.etzhayyim.cohort.lineageStats",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "pcfL1": { "type": "string" },
          "minChildren": { "type": "integer", "minimum": 0, "default": 1 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "cohortDid": { "type": "string" },
                  "directChildren": { "type": "integer" },
                  "lastFissionAt": { "type": "string" }
                },
                "required": ["cohortDid", "directChildren"]
              }
            },
            "limit": { "type": "integer" }
          },
          "required": ["rows", "limit"]
        }
      }
    }
  }
}
