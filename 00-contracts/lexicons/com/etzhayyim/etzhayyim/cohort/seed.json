{
  "lexicon": 1,
  "id": "com.etzhayyim.cohort.seed",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "segmentJsonld": {
              "type": "string"
            },
            "kAnonymity": {
              "type": "integer",
              "minimum": 50
            },
            "fissionEnabled": {
              "type": "boolean",
              "default": false
            },
            "policyRef": {
              "type": "string"
            }
          },
          "required": [
            "segmentJsonld",
            "kAnonymity"
          ]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "did": {
              "type": "string"
            },
            "handle": {
              "type": "string"
            },
            "signatureUri": {
              "type": "string"
            },
            "genesisAt": {
              "type": "string"
            }
          },
          "required": [
            "did",
            "handle",
            "signatureUri",
            "genesisAt"
          ]
        }
      }
    }
  }
}
