{
  "lexicon": 1,
  "id": "com.etzhayyim.cohort.listCohorts",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["cohort", "fissioned"]
          },
          "pcfL1": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "fissionEnabled": {
            "type": "boolean"
          },
          "cohortDid": {
            "type": "string"
          },
          "derivedFrom": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "cohorts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "cohortDid": { "type": "string" },
                  "handle": { "type": "string" },
                  "kind": { "type": "string" },
                  "segmentHash": { "type": "string" },
                  "kAnonymity": { "type": "integer" },
                  "fissionEnabled": { "type": "boolean" },
                  "derivedFrom": { "type": "string" },
                  "status": { "type": "string" },
                  "genesisAt": { "type": "string" }
                },
                "required": ["cohortDid", "handle", "kind", "segmentHash", "kAnonymity", "fissionEnabled", "status", "genesisAt"]
              }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          },
          "required": ["cohorts", "total", "offset", "limit"]
        }
      }
    }
  }
}
