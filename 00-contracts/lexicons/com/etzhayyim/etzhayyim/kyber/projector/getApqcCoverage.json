{
  "lexicon": 1,
  "id": "com.etzhayyim.kyber.projector.getApqcCoverage",
  "defs": {
    "main": {
      "type": "query",
      "description": "APQC coverage summary: registered L1 actors (/13), bound BPMN tasks, observed OCEL events per L1 in the period.",
      "parameters": {
        "type": "params",
        "properties": {
          "period": { "type": "string", "description": "ISO date range e.g. 2026-04-01/2026-04-30" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "registeredL1": { "type": "integer" },
            "totalL1": { "type": "integer" },
            "registeredSubProcesses": { "type": "integer" },
            "totalSubProcesses": { "type": "integer" },
            "boundBpmnTasks": { "type": "integer" },
            "byL1": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "apqcCode": { "type": "string" },
                  "name": { "type": "string" },
                  "registered": { "type": "boolean" },
                  "subProcesses": { "type": "integer" },
                  "bpmnTasks": { "type": "integer" },
                  "ocelEvents": { "type": "integer" }
                },
                "required": ["apqcCode", "name", "registered"]
              }
            }
          },
          "required": ["ok", "registeredL1", "totalL1", "byL1"]
        }
      }
    }
  }
}
