{
  "lexicon": 1,
  "id": "com.etzhayyim.kyber.projector.listBpmnTasks",
  "defs": {
    "main": {
      "type": "query",
      "description": "List BPMN 2.0 task bindings to APQC codes. Each task carries {taskId, apqcCode, taskType, ocelEventType, kyberCollection}.",
      "parameters": {
        "type": "params",
        "properties": {
          "apqcCode": { "type": "string" },
          "taskType": { "type": "string", "description": "userTask | serviceTask | businessRuleTask | scriptTask | sendTask | receiveTask" },
          "kyberCollection": { "type": "string", "description": "Filter by upstream kyber collection e.g. journalEntry" },
          "offset": { "type": "integer", "default": 0 },
          "limit": { "type": "integer", "default": 100 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "tasks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "taskId": { "type": "string" },
                  "apqcCode": { "type": "string" },
                  "actorDid": { "type": "string" },
                  "taskType": { "type": "string" },
                  "name": { "type": "string" },
                  "ocelEventType": { "type": "string" },
                  "kyberCollection": { "type": "string" }
                },
                "required": ["taskId", "apqcCode", "taskType", "name", "ocelEventType"]
              }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          },
          "required": ["ok", "tasks", "total", "offset", "limit"]
        }
      }
    }
  }
}
