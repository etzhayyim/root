{
  "lexicon": 1,
  "id": "com.etzhayyim.kyber.projector.emitApqcEvent",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Emit an OCEL 2.0 event linked to an APQC code + BPMN task + case objects. Writes com.etzhayyim.apps.apqc.apqcEvent (federable). Intended for handler use and external orchestrators.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "apqcCode": { "type": "string" },
            "taskId": { "type": "string" },
            "eventType": { "type": "string", "description": "OCEL event type (e.g. journal.posted)" },
            "caseId": { "type": "string" },
            "objects": {
              "type": "array",
              "description": "OCEL object refs {id,type}",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "type": { "type": "string" }
                },
                "required": ["id", "type"]
              }
            },
            "attributes": { "type": "object" },
            "actorDid": { "type": "string" }
          },
          "required": ["apqcCode", "eventType"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "ocelEventId": { "type": "string" },
            "apqcCode": { "type": "string" },
            "eventType": { "type": "string" },
            "timestamp": { "type": "string" }
          },
          "required": ["ok", "ocelEventId", "eventType"]
        }
      }
    }
  }
}
