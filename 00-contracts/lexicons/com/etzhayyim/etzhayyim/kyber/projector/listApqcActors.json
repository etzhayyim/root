{
  "lexicon": 1,
  "id": "com.etzhayyim.kyber.projector.listApqcActors",
  "defs": {
    "main": {
      "type": "query",
      "description": "List registered APQC L1 actor DIDs with coverage summary.",
      "parameters": {
        "type": "params",
        "properties": {
          "apqcCode": { "type": "string" },
          "offset": { "type": "integer", "default": 0 },
          "limit": { "type": "integer", "default": 50 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "actors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "did": { "type": "string" },
                  "apqcCode": { "type": "string" },
                  "name": { "type": "string" },
                  "subProcesses": { "type": "integer" },
                  "bpmnTaskCount": { "type": "integer" },
                  "status": { "type": "string" }
                },
                "required": ["did", "apqcCode", "name"]
              }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          },
          "required": ["ok", "actors", "total", "offset", "limit"]
        }
      }
    }
  }
}
