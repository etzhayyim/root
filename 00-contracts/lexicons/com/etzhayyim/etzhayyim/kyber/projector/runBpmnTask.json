{
  "lexicon": 1,
  "id": "com.etzhayyim.kyber.projector.runBpmnTask",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Execute a BPMN task bound to an APQC code. Creates a processInstance record (Design E Tier 2), emits an OCEL event (apqcEvent collection), and performs the task effect (e.g. post to dept DID, notify subscriber).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "taskId": { "type": "string" },
            "processInstanceId": { "type": "string", "description": "Optional — auto-generated when omitted" },
            "caseId": { "type": "string", "description": "Business case correlation (e.g. invoiceId, journalId)" },
            "input": { "type": "object", "description": "Task input payload (case attributes, BPMN data objects)" },
            "actorDid": { "type": "string", "description": "Override the APQC L1 DID; defaults to the task binding" }
          },
          "required": ["taskId"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "processInstanceId": { "type": "string" },
            "taskId": { "type": "string" },
            "apqcCode": { "type": "string" },
            "actorDid": { "type": "string" },
            "ocelEventId": { "type": "string" },
            "ocelEventType": { "type": "string" },
            "startedAt": { "type": "string" },
            "completedAt": { "type": "string" },
            "status": { "type": "string" }
          },
          "required": ["ok", "taskId", "status"]
        }
      }
    }
  }
}
