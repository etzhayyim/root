{
  "lexicon": 1,
  "id": "com.etzhayyim.kyber.projector.getActivity",
  "defs": {
    "main": {
      "type": "query",
      "description": "Compatibility query for one APQC activity by activityId/ocelEventId.",
      "parameters": {
        "type": "params",
        "properties": {
          "activityId": { "type": "string", "description": "Alias of ocelEventId" },
          "ocelEventId": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "activityId": { "type": "string" },
            "ocelEventId": { "type": "string" },
            "processId": { "type": "string" },
            "taskId": { "type": "string" },
            "groupId": { "type": "string" },
            "apqcCode": { "type": "string" },
            "actorDid": { "type": "string" },
            "name": { "type": "string" },
            "eventType": { "type": "string" },
            "caseId": { "type": "string" },
            "timestamp": { "type": "string" },
            "status": { "type": "string" },
            "objects": { "type": "array" },
            "attributes": { "type": "object" }
          }
        }
      }
    }
  }
}
