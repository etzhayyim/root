{
  "lexicon": 1,
  "id": "com.etzhayyim.tools.http.fetch",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Generic HTTP fetch primitive (ADR-2605082000 §2 follow-up). Wraps httpx for outbound requests. Read-only by default (GET / HEAD); POST/PUT/DELETE require explicit `method` arg + `allowWrite=true` flag (no implicit writes). Replaces per-actor httpx py_primitive nodes (copyright_*, isbn_*, …). Body-bytes are returned as a base64 string when not text.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "method": {
              "type": "string",
              "description": "HTTP method (GET / HEAD / POST / PUT / DELETE). Default: GET."
            },
            "headers": { "type": "object" },
            "body": {
              "type": "string",
              "description": "Request body for POST/PUT (string, JSON, or base64-encoded bytes)."
            },
            "timeout": {
              "type": "number",
              "description": "Timeout in seconds. Default: 30."
            },
            "allowWrite": {
              "type": "boolean",
              "description": "Required to be `true` for POST/PUT/DELETE (defense-in-depth)."
            }
          },
          "required": ["url"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "status": { "type": "integer" },
            "headers": { "type": "object" },
            "body": { "type": "string" },
            "isText": { "type": "boolean" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
