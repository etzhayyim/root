{
  "lexicon": 1,
  "id": "com.etzhayyim.tools.audit.emit",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Generic OCEL audit-row emitter. Writes one row to vertex_repo_commit. Replaces per-actor `emit_audit` py_primitive nodes (e.g. shosha_*, isbn_*, animeka_*) with a single data-resolved primitive — ADR-2605082000 §2.5 compliance for audit logging without per-actor code.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "repo": {
              "type": "string",
              "description": "Repo DID (e.g. did:web:shosha.etzhayyim.com)"
            },
            "collection": {
              "type": "string",
              "description": "AT collection NSID (e.g. com.etzhayyim.apps.shosha.audit)"
            },
            "rkey": {
              "type": "string",
              "description": "Record key. Empty string → auto-generated UUID."
            },
            "action": {
              "type": "string",
              "description": "Action verb (create / update / delete / ingest / synth / ...)"
            },
            "recordJson": {
              "type": "object",
              "description": "Audit payload, serialized to vertex_repo_commit.record_json."
            }
          },
          "required": ["repo", "collection", "action"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "vertexId": { "type": "string" },
            "rkey": { "type": "string" },
            "error": { "type": "string" }
          }
        }
      }
    }
  }
}
