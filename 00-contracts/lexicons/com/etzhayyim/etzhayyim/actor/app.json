{
  "lexicon": 1,
  "id": "com.etzhayyim.actor.app",
  "description": "Developer-authenticated actor (App Store model). Extends app.bsky.actor.defs profile fields with runtime placement, governance, and contract model.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["did", "nanoid"],
        "properties": {
          "did": {
            "type": "string",
            "format": "did",
            "description": "Canonical nanoid DID (did:web:{nanoid}.etzhayyim.com). Compatible with app.bsky.actor.defs profile DID."
          },
          "nanoid": { "type": "string", "description": "App nanoid identifier" },
          "handle": {
            "type": "string",
            "format": "handle",
            "description": "Compatible with app.bsky.actor.defs handle format."
          },
          "displayName": {
            "type": "string",
            "maxGraphemes": 64,
            "maxLength": 640,
            "description": "Compatible with app.bsky.actor.defs#profileViewBasic.displayName."
          },
          "description": {
            "type": "string",
            "maxGraphemes": 256,
            "maxLength": 2560,
            "description": "Compatible with app.bsky.actor.defs#profileView.description."
          },
          "labels": {
            "type": "ref",
            "description": "Self-labels. Uses official com.atproto.label.defs#selfLabels.",
            "ref": "com.atproto.label.defs#selfLabels"
          },
          "runtime": {
            "type": "string",
            "description": "etzhayyim extension: business execution runtime placement",
            "knownValues": ["k8s-langserver"]
          },
          "edge": {
            "type": "string",
            "description": "etzhayyim extension: public edge placement",
            "knownValues": ["sveltekit-proxy"]
          },
          "legacyExecutionTier": {
            "type": "string",
            "description": "Historical migration inventory value only; do not use for runtime placement",
            "knownValues": ["T1", "T2", "T3", "T4"]
          },
          "status": {
            "type": "string",
            "description": "etzhayyim extension: app lifecycle status",
            "knownValues": ["active", "suspended", "archived"]
          },
          "performerType": { "type": "string" },
          "contentMode": { "type": "string" },
          "capabilitiesJson": { "type": "string" },
          "contract": { "type": "string" },
          "icon": { "type": "string", "format": "uri" },
          "accent": { "type": "string" },
          "version": { "type": "string" },
          "uiType": { "type": "string" },
          "embedUrl": { "type": "string", "format": "uri" },
          "governanceJson": { "type": "string" },
          "agentConfigJson": { "type": "string" },
          "deployAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
