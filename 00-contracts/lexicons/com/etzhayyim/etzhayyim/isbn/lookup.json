{
  "lexicon": 1,
  "id": "com.etzhayyim.isbn.lookup",
  "defs": {
    "main": {
      "type": "query",
      "description": "Lookup a book by ISBN-13 / ISBN-10.",
      "parameters": {
        "type": "params",
        "required": ["isbn"],
        "properties": {
          "isbn": {"type": "string", "description": "ISBN-13 or ISBN-10 (hyphens optional)"}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "book": {"type": "unknown"},
            "copyright": {"type": "unknown"},
            "fulltext": {"type": "unknown"}
          }
        }
      }
    }
  }
}
