{
  "lexicon": 1,
  "id": "com.etzhayyim.wrpc.call",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["package", "interface", "function", "params"],
          "properties": {
            "package": { "type": "string" },
            "interface": { "type": "string" },
            "function": { "type": "string" },
            "params": {
              "type": "array",
              "items": { "type": "integer" }
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["result"],
          "properties": {
            "result": {
              "type": "array",
              "items": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
