{
  "lexicon": 1,
  "id": "com.etzhayyim.convo.sendMessage",
  "description": "Send message with payload. Superset of chat.bsky.convo.sendMessage — adds payload, kind, contentType for rich messaging.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "convoId": {
              "type": "string"
            },
            "text": {
              "type": "string",
              "maxLength": 10000,
              "maxGraphemes": 1000
            },
            "facets": {
              "type": "array",
              "description": "Annotations. Compatible with chat.bsky.convo.defs#messageInput.facets.",
              "items": { "type": "ref", "ref": "app.bsky.richtext.facet" }
            },
            "embed": {
              "type": "union",
              "description": "Embedded record. Compatible with chat.bsky.convo.defs#messageInput.embed.",
              "refs": ["app.bsky.embed.record"]
            },
            "payload": {
              "type": "string",
              "description": "etzhayyim extension: arbitrary payload (JSON-stringified)"
            },
            "kind": {
              "type": "string",
              "description": "etzhayyim extension: message kind"
            },
            "contentType": {
              "type": "string",
              "description": "etzhayyim extension: MIME content type"
            }
          },
          "required": ["convoId"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "rkey": { "type": "string" },
            "uri": { "type": "string", "format": "at-uri" },
            "cid": { "type": "string", "format": "cid" }
          },
          "required": ["rkey", "uri", "cid"]
        }
      }
    }
  }
}
