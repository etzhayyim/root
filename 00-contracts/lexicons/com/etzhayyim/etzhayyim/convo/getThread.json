{
  "lexicon": 1,
  "id": "com.etzhayyim.convo.getThread",
  "description": "etzhayyim extension: get a message thread. Returns messages as chat.bsky.convo.defs#messageView compatible objects.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "convoId": {
            "type": "string"
          },
          "messageId": {
            "type": "string"
          }
        },
        "required": [
          "convoId",
          "messageId"
        ]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "thread": {
              "type": "array",
              "items": {
                "type": "union",
                "refs": [
                  "chat.bsky.convo.defs#messageView",
                  "chat.bsky.convo.defs#deletedMessageView"
                ]
              }
            }
          },
          "required": [
            "thread"
          ]
        }
      }
    }
  }
}
