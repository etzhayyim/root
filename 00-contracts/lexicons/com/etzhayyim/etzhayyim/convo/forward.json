{
  "lexicon": 1,
  "id": "com.etzhayyim.convo.forward",
  "description": "etzhayyim extension: message forwarding record. No official chat.bsky equivalent.",
  "defs": {
    "main": {
      "type": "record",
      "record": {
        "type": "object",
        "properties": {
          "sourceConvoId": {
            "type": "string"
          },
          "targetConvoId": {
            "type": "string"
          },
          "messageId": {
            "type": "string"
          },
          "forwardedAt": {
            "type": "string",
            "format": "datetime"
          }
        },
        "required": [
          "sourceConvoId",
          "targetConvoId",
          "messageId",
          "forwardedAt"
        ]
      }
    }
  }
}
