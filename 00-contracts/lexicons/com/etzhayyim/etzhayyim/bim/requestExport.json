{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.bim.requestExport",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Enqueue an export of a BIM revision (IFC STEP / IFC XML / glTF / BCF / Excel schedule). Heavy conversion runs in the CF Container job service. Returns jobId; the finished blob appears in B2 (Backblaze B2 S3-compatible) under `bim/exports/{sha256}` and is referenced by the job's completion commit.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["revisionId", "target"],
          "properties": {
            "revisionId": { "type": "string" },
            "target": {
              "type": "string",
              "enum": ["ifcStep", "ifcXml", "ifcZip", "gltf", "bcf", "xlsx", "pdf"]
            },
            "schemaVersion": {
              "type": "string",
              "enum": ["IFC2X3", "IFC4", "IFC4X3"],
              "default": "IFC4"
            },
            "scope": {
              "type": "string",
              "enum": ["whole", "storey", "space", "discipline"],
              "default": "whole"
            },
            "scopeId": {
              "type": "string",
              "description": "rkey of the storey / space / discipline filter when scope != whole"
            },
            "includeQuantities": { "type": "boolean", "default": true },
            "includePropertySets": { "type": "boolean", "default": true }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["jobId", "status"],
          "properties": {
            "jobId": { "type": "string" },
            "status": {
              "type": "string",
              "enum": ["queued", "running", "ready", "failed"]
            },
            "estimatedSeconds": { "type": "integer" }
          }
        }
      },
      "errors": [
        { "name": "RevisionNotFound" },
        { "name": "UnsupportedTarget" },
        { "name": "ScopeTargetMissing" },
        { "name": "QuotaExceeded" }
      ]
    }
  }
}
