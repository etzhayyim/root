{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.bim.annotateElement",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Attach a review annotation (comment, BCF-style issue, approval state) to a specific element (wall / slab / door / ...). Stored as a domain record via Hyperdrive (vertex_bim_annotation per ADR-0036). BCF-compatible viewpoint (camera + selection) is recorded for click-to-recenter.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["elementId", "kind", "text"],
          "properties": {
            "elementId": { "type": "string", "description": "vertex_bim_element rkey (or IFC GlobalId)" },
            "storeyId": { "type": "string" },
            "kind": {
              "type": "string",
              "enum": ["comment", "issue", "approval", "rfi", "change"]
            },
            "severity": {
              "type": "string",
              "enum": ["info", "minor", "major", "blocker"],
              "default": "info"
            },
            "text": { "type": "string", "maxLength": 4000 },
            "viewpoint": {
              "type": "object",
              "description": "BCF-style viewpoint (camera + selection) for click-to-recenter",
              "properties": {
                "target": { "type": "array", "items": { "type": "number" }, "minLength": 3, "maxLength": 3 },
                "distance": { "type": "number" },
                "yaw": { "type": "number" },
                "pitch": { "type": "number" },
                "clippingPlanes": { "type": "array", "items": { "type": "unknown" } },
                "selectedElementIds": { "type": "array", "items": { "type": "string" } }
              }
            },
            "assignedTo": { "type": "string", "format": "did" },
            "replyTo": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["annotationUri", "rkey", "createdAt"],
          "properties": {
            "annotationUri": { "type": "string" },
            "rkey": { "type": "string" },
            "createdAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "errors": [
        { "name": "ElementNotFound" },
        { "name": "NotAuthorized" }
      ]
    }
  }
}
