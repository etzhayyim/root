{
  "lexicon": 1,
  "id": "com.etzhayyim.apps.bim.listSpaces",
  "defs": {
    "main": {
      "type": "query",
      "description": "List IfcSpace entities in a project or storey (room schedule). Useful for room-pick navigation, occupancy dashboards, and area take-offs. Paginated per 60-apps rules.",
      "parameters": {
        "type": "params",
        "required": ["projectId"],
        "properties": {
          "projectId": { "type": "string" },
          "storeyId": { "type": "string", "description": "optional filter to a single storey" },
          "category": {
            "type": "string",
            "enum": ["office", "residential", "circulation", "service", "mechanicalRoom", "outdoorCovered", "external", "other"]
          },
          "offset": { "type": "integer", "minimum": 0, "default": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items", "total", "offset", "limit"],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["spaceId", "storeyId", "name", "category"],
                "properties": {
                  "spaceId": { "type": "string" },
                  "storeyId": { "type": "string" },
                  "buildingId": { "type": "string" },
                  "name": { "type": "string" },
                  "longName": { "type": "string" },
                  "label": { "type": "string" },
                  "category": { "type": "string" },
                  "grossAreaM2": { "type": "number" },
                  "netAreaM2": { "type": "number" },
                  "height": { "type": "number" }
                }
              }
            },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" }
          }
        }
      },
      "errors": [
        { "name": "ProjectNotFound" },
        { "name": "StoreyNotFound" }
      ]
    }
  }
}
