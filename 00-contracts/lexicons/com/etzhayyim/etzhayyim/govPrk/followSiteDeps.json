{
  "lexicon": 1,
  "id": "com.etzhayyim.govPrk.followSiteDeps",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create graph-visible site dependency follow records for North Korea government organizations.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 15
            }
          },
          "required": []
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "followed": {
              "type": "integer"
            }
          },
          "required": []
        }
      }
    }
  }
}
