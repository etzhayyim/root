{
  "lexicon": 1,
  "id": "com.etzhayyim.mitate.diagnosticResult",
  "description": "Diagnostic test result (IgE panel / nasal smear / endoscopy / rhinomanometry / paranasal CT) returned by external lab or community center equipment. Full result data (lab values, DICOM, images, classification confidence) is XChaCha20-Poly1305 encrypted (encryptedResultEnvelope) — public fields contain only metadata + verdict summary (positive/negative, severity score, key value). G2 + G4 + G9 (witness N ≥ 2 = operator DID + licensed MD attestor DID). Per ADR-2605260100 + per-condition sub-ADRs.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "v",
          "resultId",
          "orderUri",
          "patientPseudonymDid",
          "resultType",
          "operatorDid",
          "physicianAttestorDid",
          "encryptedResultEnvelope",
          "verdictSummary",
          "completedAt"
        ],
        "properties": {
          "v": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1
          },
          "resultId": {
            "type": "string",
            "maxLength": 64
          },
          "orderUri": {
            "type": "string",
            "format": "at-uri",
            "description": "Back-reference to diagnosticOrder record."
          },
          "patientPseudonymDid": {
            "type": "string",
            "format": "did"
          },
          "resultType": {
            "type": "string",
            "knownValues": [
              "ige-panel-result",
              "eosinophil-microscopy",
              "endoscopy-image-classification",
              "rhinomanometry-aar",
              "paranasal-ct-lund-mackay",
              "paranasal-mri",
              "blood-cbc-eosinophil",
              "nasal-culture-bacterial",
              "nasal-culture-fungal"
            ]
          },
          "operatorDid": {
            "type": "string",
            "format": "did",
            "description": "G9 witness #1 — external lab DID, or internal equipment operator DID (Hanami / Mimi / rhinomanometer operator)."
          },
          "physicianAttestorDid": {
            "type": "string",
            "format": "did",
            "description": "G4 + G9 witness #2 — licensed MD attestor DID. For imaging (endoscopy / CT) must be specialist (ENT / radiologist)."
          },
          "encryptedResultEnvelope": {
            "type": "string",
            "format": "cid",
            "description": "G2 mandatory. CID of XChaCha20-Poly1305 envelope. Contains: full lab values, DICOM, images, classification confidence, classifier model variant CID (G13). Sealed-recipient = patient + Council medical advisory + this physicianAttestorDid + (for ESS planning) surgeon DID set."
          },
          "verdictSummary": {
            "type": "object",
            "required": ["overallVerdict"],
            "properties": {
              "overallVerdict": {
                "type": "string",
                "knownValues": [
                  "positive-strong",
                  "positive-moderate",
                  "positive-mild",
                  "borderline",
                  "negative",
                  "inconclusive",
                  "technically-failed-retake"
                ]
              },
              "keyValue": {
                "type": "string",
                "maxLength": 256,
                "description": "Public summary value (e.g. 'eosinophil 28%', 'Lund-Mackay 14/24', 'rhinomanometry 0.42 Pa/cm³/s @ 150Pa', 'IgE-Df1 class-3'). MUST NOT contain patient-identifying detail."
              },
              "supportingConditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "knownValues": [
                    "allergic-rhinitis-perennial",
                    "vasomotor-rhinitis",
                    "chronic-sinusitis-CRSsNP",
                    "chronic-sinusitis-CRSwNP",
                    "chronic-sinusitis-eosinophilic",
                    "chronic-sinusitis-odontogenic",
                    "chronic-sinusitis-fungal",
                    "septal-deviation-C-shape",
                    "septal-deviation-S-shape",
                    "septal-deviation-spur",
                    "rhinitis-medicamentosa",
                    "nares-syndrome-wave2-flag"
                  ]
                }
              }
            }
          },
          "classifierModelCid": {
            "type": "string",
            "format": "cid",
            "description": "G13 — open-weights model variant CID used for image/microscopy classification. Reproducibility for bias audit."
          },
          "completedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
