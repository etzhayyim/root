{
  "lexicon": 1,
  "id": "com.etzhayyim.mitate.treatmentPlan",
  "description": "Treatment routing advisory for triaged condition. INN-only (G8 — brand 不可 except yakushi-distributed products under did:web:etzhayyim.com:yakushi:product:*). G3 disclaimer text mandatory. G4 licensed MD co-sign required for Rx-tier and surgical-tier advisory (R2+). Cost transparency for surgical-tier (G11 wellbecoming + §2(e) anti-paywall). Per ADR-2605260100 + all 5 condition sub-ADRs (Treatment ladder advisory sections).",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "v",
          "planId",
          "triageUri",
          "patientPseudonymDid",
          "conditionSlug",
          "severityTier",
          "treatmentTier",
          "innRecommendations",
          "disclaimerText",
          "disclaimerAccepted",
          "issuedAt"
        ],
        "properties": {
          "v": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1
          },
          "planId": {
            "type": "string",
            "maxLength": 64
          },
          "triageUri": {
            "type": "string",
            "format": "at-uri",
            "description": "Back-reference to triageVerdict record."
          },
          "diagnosticResultUris": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "at-uri"
            },
            "description": "Optional R2+ — back-reference to all diagnosticResult records contributing to this plan."
          },
          "patientPseudonymDid": {
            "type": "string",
            "format": "did"
          },
          "conditionSlug": {
            "type": "string",
            "knownValues": [
              "allergic-rhinitis-perennial",
              "vasomotor-rhinitis",
              "chronic-sinusitis-CRSsNP",
              "chronic-sinusitis-CRSwNP",
              "chronic-sinusitis-eosinophilic",
              "chronic-sinusitis-odontogenic",
              "chronic-sinusitis-fungal",
              "septal-deviation",
              "rhinitis-medicamentosa"
            ]
          },
          "severityTier": {
            "type": "string",
            "knownValues": ["mild", "moderate", "severe", "severe-refractory"]
          },
          "treatmentTier": {
            "type": "string",
            "knownValues": [
              "self-care-environmental",
              "otc-yakushi-dispense",
              "otc-non-yakushi",
              "rx-routing-required",
              "surgical-routing-required",
              "withdrawal-protocol-tier-1",
              "withdrawal-protocol-tier-2",
              "withdrawal-protocol-tier-3"
            ]
          },
          "innRecommendations": {
            "type": "array",
            "items": {
              "type": "ref",
              "ref": "#innRecommendation"
            }
          },
          "environmentalAdjustments": {
            "type": "array",
            "items": {
              "type": "string",
              "knownValues": [
                "bedding-60c-weekly-wash",
                "hepa-air-purifier",
                "humidity-40-50-percent",
                "carpet-removal",
                "pet-bedroom-exclusion",
                "saline-nasal-irrigation",
                "temperature-differential-mask",
                "trigger-avoidance-perfume-smoke",
                "sleep-position-lateral"
              ]
            }
          },
          "surgicalConsideration": {
            "type": "object",
            "description": "Only for treatmentTier = 'surgical-routing-required'. R3 phase only. surgeonAttestorDid mandatory in this section.",
            "properties": {
              "procedureType": {
                "type": "string",
                "knownValues": [
                  "ess-fess",
                  "ess-extended",
                  "septoplasty",
                  "septorhinoplasty",
                  "inferior-turbinate-reduction",
                  "posterior-nasal-nerve-section"
                ]
              },
              "estimatedDurationDays": {
                "type": "integer",
                "minimum": 0,
                "maximum": 30
              },
              "estimatedCostJpyBeforeInsurance": {
                "type": "integer",
                "description": "Patient-facing cost transparency (G11 + §2(e) anti-paywall). Pre-insurance / pre-高額療養費 estimate."
              },
              "highCostMedicalRefundReferenced": {
                "type": "boolean",
                "description": "Whether 高額療養費制度 reference text was included."
              },
              "surgeonAttestorDid": {
                "type": "string",
                "format": "did",
                "description": "N4 invariant — surgeon-in-loop attestation required for surgical advisory R3+. mitate plans only, surgeon executes."
              }
            }
          },
          "escalationLink": {
            "type": "string",
            "knownValues": [
              "none-self-administer",
              "md-visit-recommended",
              "md-otolaryngology-recommended",
              "md-allergy-specialist-recommended",
              "md-rhinology-specialist-recommended",
              "dental-clinic-recommended",
              "emergency-otolaryngology-recommended"
            ]
          },
          "physicianAttestorDid": {
            "type": "string",
            "format": "did",
            "description": "G4 mandatory for treatmentTier ∈ {rx-routing-required, surgical-routing-required, withdrawal-protocol-tier-3}. Optional for self-care / OTC tier (R1 advisory)."
          },
          "disclaimerText": {
            "type": "string",
            "maxLength": 2000,
            "description": "G3 disclaimer — 'qualified physician 判断の代替ではない' equivalent in patient language. Template registered in silenMitateReview scope."
          },
          "disclaimerAccepted": {
            "type": "boolean",
            "description": "G3 — patient must acknowledge disclaimer before plan is delivered. False = plan undelivered (kept in pending state)."
          },
          "issuedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    },
    "innRecommendation": {
      "type": "object",
      "required": ["inn", "dispensePath"],
      "properties": {
        "inn": {
          "type": "string",
          "maxLength": 64,
          "description": "International nonproprietary name only (G8). E.g. 'cetirizine-dihydrochloride', 'mometasone-furoate', 'clarithromycin'. NO brand names."
        },
        "dispensePath": {
          "type": "string",
          "knownValues": [
            "yakushi-distributed-product",
            "external-otc-pharmacy",
            "rx-physician-required",
            "biologics-specialist-required",
            "self-administered-environmental"
          ]
        },
        "yakushiProductDid": {
          "type": "string",
          "format": "did",
          "description": "If dispensePath = 'yakushi-distributed-product', must be did:web:etzhayyim.com:yakushi:product:*."
        },
        "doseInstructionTemplate": {
          "type": "string",
          "maxLength": 1000,
          "description": "Patient-language dose instruction (INN-only). G11 label warning text inherited from yakushi product label if yakushi-distributed."
        }
      }
    }
  }
}
