{
  "lexicon": 1,
  "id": "com.etzhayyim.mitate.triageVerdict",
  "description": "5-condition Bayesian classifier output. Top-3 condition posterior probabilities + escalation flag + G3 disclaimer text + G6 high-risk human-review flag. Detailed reasoning (per-sign contribution, LLM second-pass narrative) is XChaCha20-Poly1585 encrypted (encryptedTriageEnvelope) — public fields include only verdict summary + escalation decision. Per ADR-2605260100 §Decision 3 G3 + G6 + G12 (Murakumo only) + G13 (open weights) + all 5 condition sub-ADRs.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "v",
          "intakeUri",
          "patientPseudonymDid",
          "top3Conditions",
          "escalation",
          "disclaimerText",
          "modelVariantCid",
          "verdictAt"
        ],
        "properties": {
          "v": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1
          },
          "intakeUri": {
            "type": "string",
            "format": "at-uri",
            "description": "Back-reference to rhinitisIntake record."
          },
          "patientPseudonymDid": {
            "type": "string",
            "format": "did"
          },
          "top3Conditions": {
            "type": "array",
            "minLength": 1,
            "maxLength": 3,
            "items": {
              "type": "ref",
              "ref": "#conditionPosterior"
            }
          },
          "escalation": {
            "type": "string",
            "knownValues": [
              "self-care-advisory",
              "recommend-md-visit",
              "recommend-md-otolaryngology",
              "recommend-md-allergy-specialist",
              "recommend-md-specialist-rhinology",
              "recommend-md-otolaryngology-surgical",
              "recommend-md-rhinoplasty-specialist",
              "recommend-dental-clinic",
              "recommend-emergency-otolaryngology",
              "g6-mandatory-human-review",
              "stopped-by-emergency-screen"
            ]
          },
          "g6HighRiskFlags": {
            "type": "array",
            "items": {
              "type": "string",
              "knownValues": [
                "pediatric-under-13",
                "pregnancy",
                "lactation",
                "immunocompromised",
                "anticoagulant-active",
                "elderly-frailty"
              ]
            }
          },
          "disclaimerText": {
            "type": "string",
            "maxLength": 2000,
            "description": "G3 disclaimer text — 'qualified physician 判断の代替ではない' equivalent in patient language. Frozen template registered in silenMitateReview scope `g3-disclaimer-text-baseline`."
          },
          "encryptedTriageEnvelope": {
            "type": "string",
            "format": "cid",
            "description": "CID of XChaCha20-Poly1305 envelope containing detailed reasoning: per-sign Bayesian contribution, LLM second-pass narrative, alternative conditions considered."
          },
          "modelVariantCid": {
            "type": "string",
            "format": "cid",
            "description": "CID of the open-weights gemma4:e4b medical distill variant used (G13). Pins reproducibility for bias audit."
          },
          "physicianAttestorDid": {
            "type": "string",
            "format": "did",
            "description": "Optional R1 (advisory tier — single-witness automated, disclaimer-gated). Required R2+ for escalation = 'recommend-md-*' attesting acknowledgment."
          },
          "verdictAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    },
    "conditionPosterior": {
      "type": "object",
      "required": ["conditionSlug", "posteriorPpm", "confidence"],
      "properties": {
        "conditionSlug": {
          "type": "string",
          "knownValues": [
            "allergic-rhinitis-perennial",
            "vasomotor-rhinitis",
            "chronic-sinusitis",
            "septal-deviation",
            "rhinitis-medicamentosa"
          ]
        },
        "posteriorPpm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Posterior probability in parts-per-million (0..1_000_000 maps to 0.0..1.0). Per ADR-2605190900 lexicon convention (no float types; integer with implied units)."
        },
        "confidence": {
          "type": "string",
          "knownValues": ["low", "medium", "high"]
        }
      }
    }
  }
}
