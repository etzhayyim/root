{
  "lexicon": 1,
  "id": "com.etzhayyim.supply.purchaseOrder",
  "description": "Purchase order record emitted by the yoro-supply order_placement Pregel cell. Captures the supplier-confirmed PO terms (price, quantity, delivery schedule) and the supplier's manufacturing schedule. Both buyer and supplier sign (G3 minLength 2 witnesses, buyer and supplier DIDs must differ). Per ADR-2605250850 + gates G3 (≥2 witnesses), G6 (deterministic Gantt scheduling).",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "createdAt",
          "purchaseOrderId",
          "selectionId",
          "buyerDid",
          "supplierReference",
          "lineItems",
          "totalPriceMicroCents",
          "currencyCode",
          "agreedDeliveryStartsAt",
          "agreedDeliveryEndsAt",
          "manufacturingScheduleIpfsCid",
          "witnessSignatures",
          "orderPlacementCellAttestationCid"
        ],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "purchaseOrderId": {
            "type": "string",
            "description": "Stable PO identifier; usually `<supplierReference>:PO-<n>`."
          },
          "selectionId": {
            "type": "string",
            "description": "Parent supplierSelection.selectionId."
          },
          "buyerDid": {
            "type": "string",
            "description": "DID of the etzhayyim member placing the order (project owner or designated agent)."
          },
          "supplierReference": {
            "type": "string",
            "description": "MUST match parent supplierSelection.supplierReference."
          },
          "lineItems": {
            "type": "array",
            "items": {
              "type": "ref",
              "ref": "#poLineItem"
            },
            "minLength": 1
          },
          "totalPriceMicroCents": {
            "type": "integer",
            "minimum": 0,
            "description": "PO total in micro-cents per Lexicon convention."
          },
          "currencyCode": {
            "type": "string"
          },
          "agreedDeliveryStartsAt": {
            "type": "string",
            "format": "datetime"
          },
          "agreedDeliveryEndsAt": {
            "type": "string",
            "format": "datetime",
            "description": "Latest acceptable delivery; validator MAY enforce ≤ N days after agreedDeliveryStartsAt."
          },
          "manufacturingScheduleIpfsCid": {
            "type": "string",
            "format": "cid",
            "description": "G6: IPFS CID of the deterministic manufacturing Gantt schedule (replayable from inputs)."
          },
          "witnessSignatures": {
            "type": "array",
            "items": {
              "type": "ref",
              "ref": "#witnessSignature"
            },
            "minLength": 2,
            "description": "G3: at least 2 distinct witnesses. Typical pattern: buyerDid + supplier-authorized DID. The two MUST differ."
          },
          "orderPlacementCellAttestationCid": {
            "type": "string",
            "format": "cid"
          }
        }
      }
    },
    "poLineItem": {
      "type": "object",
      "required": ["projectBomLineRef", "materialClass", "quantity", "unitOfMeasure", "unitPriceMicroCents"],
      "properties": {
        "projectBomLineRef": {
          "type": "string"
        },
        "materialClass": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "minimum": 0
        },
        "unitOfMeasure": {
          "type": "string",
          "knownValues": [
            "ea",
            "kg",
            "g",
            "m",
            "mm",
            "m2",
            "m3",
            "l",
            "ml",
            "ton",
            "roll",
            "sheet",
            "pallet"
          ]
        },
        "unitPriceMicroCents": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "witnessSignature": {
      "type": "object",
      "required": ["witnessDid", "role", "signedAt", "signature"],
      "properties": {
        "witnessDid": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "knownValues": ["buyer", "supplier", "third-party-agent"]
        },
        "signedAt": {
          "type": "string",
          "format": "datetime"
        },
        "signature": {
          "type": "string",
          "description": "Ed25519 signature over (purchaseOrderId + totalPriceMicroCents + agreedDeliveryEndsAt + manufacturingScheduleIpfsCid)."
        }
      }
    }
  }
}
