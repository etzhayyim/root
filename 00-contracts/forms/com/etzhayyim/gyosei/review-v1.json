{
  "$schema": "https://etzhayyim.com/schemas/form/v1.json",
  "key": "gyosei-review-v1",
  "version": 1,
  "title": "行政庁 review / 裁決準備",
  "components": [
    {
      "key": "review",
      "type": "fieldset",
      "label": "審査結果",
      "components": [
        { "key": "decision", "type": "select", "label": "判断", "required": true, "options": [
          { "value": "approve-disposition", "label": "原案どおり処分" },
          { "value": "amend-disposition", "label": "修正して処分" },
          { "value": "withdraw-disposition", "label": "処分見送り" },
          { "value": "remand-or-reconsider", "label": "再考・差戻し" }
        ]},
        { "key": "dueProcessCheck", "type": "datagrid", "label": "手続チェック", "components": [
          { "key": "item", "type": "textfield", "label": "項目", "required": true },
          { "key": "checked", "type": "checkbox", "label": "確認済" },
          { "key": "comment", "type": "textfield", "label": "コメント" }
        ]},
        { "key": "proportionalityAssessment", "type": "textarea", "label": "比例原則・裁量統制評価", "required": true },
        { "key": "reasoningSummary", "type": "textarea", "label": "理由要旨", "required": true }
      ]
    },
    {
      "key": "precedent",
      "type": "fieldset",
      "label": "判例・裁決参照",
      "components": [
        { "key": "precedentReviewed", "type": "checkbox", "label": "判例 / 裁決 / 答申を確認した", "required": true },
        { "key": "sourceIds", "type": "select", "label": "参照 sourceIds", "multiple": true, "options": [
          { "value": "laws-administrative-procedure-act", "label": "行政手続法 / e-Gov法令検索" },
          { "value": "laws-administrative-appeal-act", "label": "行政不服審査法 / e-Gov法令検索" },
          { "value": "laws-administrative-case-litigation-act", "label": "行政事件訴訟法 / e-Gov法令検索" },
          { "value": "courts-hanrei-search", "label": "裁判例検索 / 裁判所" },
          { "value": "chiba-appeal-system", "label": "行政不服審査制度について / 千葉県" },
          { "value": "nta-appeal-index", "label": "不服申立て / 国税庁" },
          { "value": "nta-appeal-guide-01", "label": "国税に関する処分に不服があるとき / 国税庁" },
          { "value": "mhlw-social-insurance-review-index", "label": "社会保険審査会 / 厚生労働省" },
          { "value": "mhlw-social-insurance-review-flow", "label": "審査請求・再審査請求の流れ / 厚生労働省" },
          { "value": "mlit-construction-guideline", "label": "建設業許可事務ガイドライン / 国土交通省" }
        ]},
        { "key": "citedAuthorities", "type": "datagrid", "label": "参照先", "components": [
          { "key": "sourceType", "type": "select", "label": "種別", "required": true, "options": [
            { "value": "court-precedent", "label": "裁判例" },
            { "value": "appeal-decision", "label": "裁決・答申" },
            { "value": "ministry-rule", "label": "府省規則・通達" }
          ]},
          { "key": "identifier", "type": "textfield", "label": "事件番号等", "required": true },
          { "key": "holding", "type": "textarea", "label": "要旨", "required": true },
          { "key": "riskLevel", "type": "select", "label": "逆風リスク", "options": [
            { "value": "low", "label": "低" },
            { "value": "medium", "label": "中" },
            { "value": "high", "label": "高" }
          ]}
        ]}
      ]
    }
  ]
}
