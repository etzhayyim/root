{
  "$schema": "https://etzhayyim.com/schemas/form/v1.json",
  "key": "open-seiyaku-batch-form-v1",
  "version": 1,
  "title": "製薬バッチ製造記録",
  "tier": 2,
  "encryptionScheme": "signal:v1",
  "components": [
    {
      "key": "batchIdentity",
      "type": "fieldset",
      "label": "バッチ識別",
      "components": [
        { "key": "manufacturerOrgId", "label": "製造販売業者 org_id", "type": "textfield", "required": true },
        { "key": "plantOrgId", "label": "工場 org_id", "type": "textfield", "required": true },
        { "key": "productCode", "label": "製品コード", "type": "textfield", "required": true },
        { "key": "batchNumber", "label": "バッチ番号", "type": "textfield", "required": true },
        { "key": "dosageForm", "label": "剤形", "type": "select", "required": true,
          "options": [
            { "value": "tablet", "label": "錠剤" },
            { "value": "capsule", "label": "カプセル" },
            { "value": "injectable", "label": "注射剤" },
            { "value": "liquid", "label": "液剤" },
            { "value": "other", "label": "その他" }
          ]
        },
        { "key": "manufacturingDate", "label": "製造日", "type": "datepicker", "required": true },
        { "key": "expiryDate", "label": "使用期限", "type": "datepicker" }
      ]
    },
    {
      "key": "masterFormula",
      "type": "fieldset",
      "label": "製造指図・処方",
      "x-encryptedSection": "masterFormulaPayload",
      "components": [
        { "key": "formulaVersion", "label": "処方版", "type": "textfield", "required": true },
        { "key": "targetYieldUnits", "label": "理論収量", "type": "number", "required": true },
        { "key": "targetYieldUnitCode", "label": "単位", "type": "textfield", "required": true },
        { "key": "criticalProcessParams", "label": "重要工程条件", "type": "textarea" },
        { "key": "cleaningStatus", "label": "設備洗浄状態", "type": "select",
          "options": [
            { "value": "released", "label": "使用可" },
            { "value": "pending", "label": "確認中" },
            { "value": "blocked", "label": "使用不可" }
          ]
        }
      ]
    },
    {
      "key": "materials",
      "type": "datagrid",
      "label": "原料ロット",
      "x-encryptedSection": "materialPayload",
      "components": [
        { "key": "materialCode", "label": "原料コード", "type": "textfield", "required": true },
        { "key": "lotNumber", "label": "ロット番号", "type": "textfield", "required": true },
        { "key": "supplierDid", "label": "供給者 DID", "type": "textfield" },
        { "key": "quantity", "label": "使用量", "type": "number", "required": true },
        { "key": "unitCode", "label": "単位", "type": "textfield", "required": true },
        { "key": "released", "label": "受入試験済", "type": "checkbox" }
      ]
    },
    {
      "key": "batchRecord",
      "type": "fieldset",
      "label": "実製造記録",
      "x-encryptedSection": "batchRecordPayload",
      "components": [
        { "key": "startTimestamp", "label": "製造開始", "type": "datetime" },
        { "key": "endTimestamp", "label": "製造終了", "type": "datetime" },
        { "key": "actualYieldUnits", "label": "実収量", "type": "number" },
        { "key": "yieldVariancePct", "label": "収率差異 (%)", "type": "number" },
        { "key": "equipmentIds", "label": "使用設備", "type": "textarea" },
        { "key": "operatorNotes", "label": "オペレータ記録", "type": "textarea" }
      ]
    },
    {
      "key": "quality",
      "type": "fieldset",
      "label": "品質試験サマリ",
      "x-encryptedSection": "qualityPayload",
      "components": [
        { "key": "coaReference", "label": "COA 参照", "type": "textfield" },
        { "key": "sterilityResult", "label": "無菌/微生物試験", "type": "select",
          "options": [
            { "value": "pass", "label": "適合" },
            { "value": "fail", "label": "不適合" },
            { "value": "na", "label": "対象外" }
          ]
        },
        { "key": "assayResult", "label": "含量試験", "type": "select",
          "options": [
            { "value": "pass", "label": "適合" },
            { "value": "fail", "label": "不適合" },
            { "value": "pending", "label": "保留" }
          ]
        },
        { "key": "stabilityImpact", "label": "安定性影響", "type": "textarea" }
      ]
    },
    {
      "key": "deviation",
      "type": "fieldset",
      "label": "逸脱・CAPA",
      "x-encryptedSection": "deviationPayload",
      "components": [
        { "key": "hasDeviation", "label": "逸脱あり", "type": "checkbox" },
        { "key": "deviationCode", "label": "逸脱番号", "type": "textfield", "conditional": "=hasDeviation = true" },
        { "key": "deviationSummary", "label": "逸脱概要", "type": "textarea", "conditional": "=hasDeviation = true" },
        { "key": "capaPlan", "label": "CAPA", "type": "textarea" }
      ]
    },
    {
      "key": "attestation",
      "type": "fieldset",
      "label": "記録確認",
      "components": [
        { "key": "recordIntegrityConfirmed", "label": "記録完全性を確認した", "type": "checkbox", "required": true },
        { "key": "enteredByDid", "label": "入力者 DID", "type": "textfield", "required": true }
      ]
    }
  ]
}
