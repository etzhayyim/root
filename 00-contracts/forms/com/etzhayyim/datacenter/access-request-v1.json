{
  "$schema": "https://etzhayyim.com/schemas/form/v1.json",
  "key": "datacenter-access-request-v1",
  "version": 1,
  "title": "データセンター物理アクセス申請",
  "tier": 3,
  "encryptionScheme": "signal:v1",
  "actorRole": "dc-requester",
  "components": [
    {
      "key": "accessMeta",
      "type": "fieldset",
      "label": "申請メタデータ",
      "components": [
        {
          "key": "purpose",
          "label": "入館目的",
          "type": "select",
          "required": true,
          "options": [
            { "value": "maintenance", "label": "保守作業" },
            { "value": "delivery", "label": "搬入搬出" },
            { "value": "inspection", "label": "点検" },
            { "value": "audit", "label": "監査" },
            { "value": "emergency", "label": "緊急対応" }
          ]
        },
        {
          "key": "accessScope",
          "label": "アクセス範囲",
          "type": "select",
          "required": true,
          "options": [
            { "value": "lobby", "label": "ロビーのみ" },
            { "value": "mep", "label": "MEP エリア" },
            { "value": "white-space", "label": "ホワイトスペース" },
            { "value": "cage", "label": "ケージ / ラック前" },
            { "value": "loading-bay", "label": "搬入口" }
          ]
        },
        { "key": "escortRequired", "label": "エスコート必須", "type": "checkbox" },
        { "key": "visitStart", "label": "入館予定開始", "type": "textfield", "required": true, "description": "ISO-8601 datetime" },
        { "key": "visitEnd", "label": "入館予定終了", "type": "textfield", "required": true, "description": "ISO-8601 datetime" },
        { "key": "declarationHash", "label": "申請ハッシュ", "type": "textfield", "required": true }
      ]
    },
    {
      "key": "visitor",
      "type": "fieldset",
      "label": "来訪者情報",
      "x-encryptedSection": "visitorPayload",
      "components": [
        { "key": "fullName", "label": "氏名", "type": "textfield", "required": true, "x-piiTier": 3, "x-encrypt": "signal:v1" },
        { "key": "companyName", "label": "所属会社", "type": "textfield", "required": true, "x-piiTier": 3 },
        { "key": "email", "label": "メールアドレス", "type": "textfield", "required": true, "x-piiTier": 3, "x-encrypt": "signal:v1" },
        { "key": "phone", "label": "電話番号", "type": "textfield", "x-piiTier": 3, "x-encrypt": "signal:v1" },
        { "key": "governmentIdType", "label": "本人確認書類種別", "type": "select", "required": true,
          "options": [
            { "value": "passport", "label": "パスポート" },
            { "value": "drivers-license", "label": "運転免許証" },
            { "value": "national-id", "label": "公的ID" },
            { "value": "employee-badge", "label": "社員証" }
          ]
        },
        { "key": "governmentIdLast4", "label": "本人確認書類末尾4桁", "type": "textfield", "x-piiTier": 3, "x-encrypt": "signal:v1" }
      ]
    },
    {
      "key": "employer",
      "type": "fieldset",
      "label": "受入担当 / スポンサー",
      "x-encryptedSection": "employerPayload",
      "components": [
        { "key": "sponsorName", "label": "スポンサー氏名", "type": "textfield", "required": true, "x-piiTier": 3 },
        { "key": "sponsorEmail", "label": "スポンサーEmail", "type": "textfield", "required": true, "x-piiTier": 3, "x-encrypt": "signal:v1" },
        { "key": "sponsorPhone", "label": "スポンサー電話", "type": "textfield", "x-piiTier": 3, "x-encrypt": "signal:v1" }
      ]
    },
    {
      "key": "badge",
      "type": "fieldset",
      "label": "バッジ・持込情報",
      "x-encryptedSection": "badgePayload",
      "components": [
        { "key": "temporaryBadgeNeeded", "label": "一時バッジ発行が必要", "type": "checkbox" },
        { "key": "equipmentSummary", "label": "持込機材", "type": "textarea" },
        { "key": "vehiclePlate", "label": "車両ナンバー", "type": "textfield", "x-piiTier": 3, "x-encrypt": "signal:v1" }
      ]
    },
    {
      "key": "safety",
      "type": "fieldset",
      "label": "安全確認",
      "x-encryptedSection": "safetyPayload",
      "components": [
        { "key": "ppeConfirmed", "label": "必要PPEを確認", "type": "checkbox", "required": true },
        { "key": "safetyTrainingCompleted", "label": "安全教育済み", "type": "checkbox", "required": true },
        { "key": "restrictedAreaAcknowledged", "label": "立入禁止区域を理解", "type": "checkbox", "required": true }
      ]
    }
  ]
}
