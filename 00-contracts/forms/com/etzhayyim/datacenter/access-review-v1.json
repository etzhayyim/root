{
  "$schema": "https://etzhayyim.com/schemas/form/v1.json",
  "key": "datacenter-access-review-v1",
  "version": 1,
  "title": "データセンター物理アクセス審査",
  "tier": 3,
  "encryptionScheme": "signal:v1",
  "actorRole": "dc-security",
  "components": [
    {
      "key": "summary",
      "type": "fieldset",
      "label": "申請サマリ",
      "components": [
        { "key": "facilityId", "label": "施設 ID", "type": "textfield", "readOnly": true },
        { "key": "purpose", "label": "入館目的", "type": "textfield", "readOnly": true },
        { "key": "visitWindow", "label": "予定時間帯", "type": "textfield", "readOnly": true },
        { "key": "escortRequired", "label": "エスコート要否", "type": "checkbox", "readOnly": true }
      ]
    },
    {
      "key": "checks",
      "type": "fieldset",
      "label": "確認チェック",
      "components": [
        { "key": "identityChecked", "label": "本人確認書類を確認", "type": "checkbox", "required": true },
        { "key": "sponsorValidated", "label": "スポンサー確認済み", "type": "checkbox", "required": true },
        { "key": "safetyValidated", "label": "安全条件を確認", "type": "checkbox", "required": true },
        { "key": "scopeLeastPrivilege", "label": "アクセス範囲は最小権限", "type": "checkbox", "required": true }
      ]
    },
    {
      "key": "review",
      "type": "fieldset",
      "label": "審査結果",
      "components": [
        { "key": "decision", "label": "判定", "type": "select", "required": true,
          "options": [
            { "value": "approve", "label": "承認" },
            { "value": "reject", "label": "却下" }
          ]
        },
        { "key": "badgeId", "label": "発行予定バッジ ID", "type": "textfield" },
        { "key": "comment", "label": "コメント", "type": "textarea", "validate": { "maxLength": 1000 } }
      ]
    }
  ]
}
