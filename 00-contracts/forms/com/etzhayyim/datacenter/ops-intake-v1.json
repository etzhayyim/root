{
  "$schema": "https://etzhayyim.com/schemas/form/v1.json",
  "key": "datacenter-ops-intake-v1",
  "version": 1,
  "title": "データセンター運営要求 起票",
  "tier": 1,
  "actorRole": "dc-ops",
  "components": [
    {
      "key": "operation",
      "type": "fieldset",
      "label": "要求内容",
      "components": [
        {
          "key": "kind",
          "label": "要求種別",
          "type": "select",
          "required": true,
          "options": [
            { "value": "incident", "label": "障害対応" },
            { "value": "maintenance", "label": "保守作業" },
            { "value": "capacity", "label": "容量拡張" },
            { "value": "access", "label": "入退館・アクセス変更" }
          ]
        },
        {
          "key": "summary",
          "label": "概要",
          "type": "textarea",
          "required": true,
          "validate": { "maxLength": 2000 }
        },
        {
          "key": "riskClass",
          "label": "リスク区分",
          "type": "select",
          "required": true,
          "options": [
            { "value": "low", "label": "low" },
            { "value": "medium", "label": "medium" },
            { "value": "high", "label": "high" },
            { "value": "critical", "label": "critical" }
          ]
        },
        {
          "key": "requiresApproval",
          "label": "変更承認が必要",
          "type": "checkbox",
          "description": "高リスク作業、計画停止、電源・冷却系統変更では有効化"
        },
        {
          "key": "windowStart",
          "label": "作業開始予定",
          "type": "textfield",
          "description": "ISO-8601 datetime"
        },
        {
          "key": "windowEnd",
          "label": "作業終了予定",
          "type": "textfield",
          "description": "ISO-8601 datetime"
        },
        {
          "key": "customerImpact",
          "label": "顧客影響",
          "type": "select",
          "options": [
            { "value": "none", "label": "なし" },
            { "value": "degraded", "label": "性能低下" },
            { "value": "partial-outage", "label": "部分停止" },
            { "value": "full-outage", "label": "全面停止" }
          ]
        }
      ]
    }
  ]
}
