{
  "$schema": "https://etzhayyim.com/schemas/form/v1.json",
  "key": "gyosei-hearing-record-v1",
  "version": 1,
  "title": "聴聞・弁明実施記録",
  "components": [
    {
      "key": "hearingRecord",
      "type": "fieldset",
      "label": "実施記録",
      "components": [
        { "key": "caseId", "type": "textfield", "label": "対象 caseId", "required": true },
        { "key": "procedureKind", "type": "select", "label": "手続種別", "required": true, "options": [
          { "value": "hearing", "label": "聴聞" },
          { "value": "statement-opportunity", "label": "弁明の機会付与" }
        ]},
        { "key": "heldAt", "type": "datetime", "label": "実施日時", "required": true },
        { "key": "participants", "type": "textarea", "label": "出席者", "required": true },
        { "key": "issuesDiscussed", "type": "textarea", "label": "争点・主張", "required": true },
        { "key": "submittedMaterials", "type": "textarea", "label": "提出資料" },
        { "key": "officerSummary", "type": "textarea", "label": "主宰者要約", "required": true }
      ]
    }
  ]
}
