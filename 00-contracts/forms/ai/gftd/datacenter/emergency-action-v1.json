{
  "$schema": "https://etzhayyim.com/schemas/form/v1.json",
  "key": "datacenter-emergency-action-v1",
  "version": 1,
  "title": "データセンター緊急復旧対応",
  "tier": 1,
  "actorRole": "dc-oncall",
  "components": [
    {
      "key": "executionReport",
      "type": "fieldset",
      "label": "一次対応",
      "components": [
        {
          "key": "status",
          "label": "一次対応結果",
          "type": "select",
          "required": true,
          "options": [
            { "value": "completed", "label": "復旧済み" },
            { "value": "rolledBack", "label": "切戻しで安定化" },
            { "value": "degraded", "label": "暫定対応のみ" }
          ]
        },
        {
          "key": "notes",
          "label": "実施内容",
          "type": "textarea",
          "required": true,
          "validate": { "maxLength": 4000 }
        },
        {
          "key": "suspectedCause",
          "label": "想定原因",
          "type": "textarea",
          "validate": { "maxLength": 1500 }
        },
        {
          "key": "startedAt",
          "label": "対応開始日時",
          "type": "textfield",
          "required": true,
          "description": "ISO-8601 datetime"
        },
        {
          "key": "endedAt",
          "label": "一次対応終了日時",
          "type": "textfield",
          "required": true,
          "description": "ISO-8601 datetime"
        }
      ]
    }
  ]
}
