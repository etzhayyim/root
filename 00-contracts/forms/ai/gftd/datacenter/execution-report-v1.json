{
  "$schema": "https://etzhayyim.com/schemas/form/v1.json",
  "key": "datacenter-execution-report-v1",
  "version": 1,
  "title": "データセンター作業実施報告",
  "tier": 1,
  "actorRole": "dc-ops",
  "components": [
    {
      "key": "executionReport",
      "type": "fieldset",
      "label": "実施結果",
      "components": [
        {
          "key": "status",
          "label": "実施結果",
          "type": "select",
          "required": true,
          "options": [
            { "value": "completed", "label": "計画通り完了" },
            { "value": "rolledBack", "label": "rollback 実施" },
            { "value": "degraded", "label": "劣化状態で終了" }
          ]
        },
        {
          "key": "changeSteps",
          "label": "実施内容",
          "type": "textarea",
          "required": true,
          "validate": { "maxLength": 4000 }
        },
        {
          "key": "notes",
          "label": "補足メモ",
          "type": "textarea",
          "validate": { "maxLength": 2000 }
        },
        {
          "key": "rollbackInvoked",
          "label": "rollback を実施した",
          "type": "checkbox"
        },
        {
          "key": "startedAt",
          "label": "開始日時",
          "type": "textfield",
          "required": true,
          "description": "ISO-8601 datetime"
        },
        {
          "key": "endedAt",
          "label": "終了日時",
          "type": "textfield",
          "required": true,
          "description": "ISO-8601 datetime"
        }
      ]
    }
  ]
}
