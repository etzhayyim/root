{
  "$schema": "https://etzhayyim.com/schemas/form/v1.json",
  "key": "gyosei-precedent-memo-v1",
  "version": 1,
  "title": "行政事件 判例メモ",
  "components": [
    {
      "key": "memo",
      "type": "fieldset",
      "label": "判例整理",
      "components": [
        { "key": "searchScope", "type": "select", "label": "検索範囲", "required": true, "options": [
          { "value": "courts", "label": "裁判所裁判例検索" },
          { "value": "appeal-db", "label": "裁決・答申 DB" },
          { "value": "both", "label": "両方" }
        ]},
        { "key": "searchTerms", "type": "textarea", "label": "検索語", "required": true },
        { "key": "sourceIds", "type": "select", "label": "参照 sourceIds", "multiple": true, "options": [
          { "value": "laws-administrative-procedure-act", "label": "行政手続法 / e-Gov法令検索" },
          { "value": "laws-administrative-appeal-act", "label": "行政不服審査法 / e-Gov法令検索" },
          { "value": "laws-administrative-case-litigation-act", "label": "行政事件訴訟法 / e-Gov法令検索" },
          { "value": "courts-hanrei-search", "label": "裁判例検索 / 裁判所" },
          { "value": "chiba-appeal-system", "label": "行政不服審査制度について / 千葉県" },
          { "value": "nta-appeal-index", "label": "不服申立て / 国税庁" },
          { "value": "nta-appeal-guide-01", "label": "国税に関する処分に不服があるとき / 国税庁" },
          { "value": "mhlw-social-insurance-review-index", "label": "社会保険審査会 / 厚生労働省" },
          { "value": "mhlw-social-insurance-review-flow", "label": "審査請求・再審査請求の流れ / 厚生労働省" },
          { "value": "mlit-construction-guideline", "label": "建設業許可事務ガイドライン / 国土交通省" }
        ]},
        { "key": "leadAuthorities", "type": "datagrid", "label": "主要先例", "components": [
          { "key": "identifier", "type": "textfield", "label": "事件番号等", "required": true },
          { "key": "courtOrBody", "type": "textfield", "label": "裁判所 / 審査会", "required": true },
          { "key": "date", "type": "date", "label": "日付" },
          { "key": "holding", "type": "textarea", "label": "規範・要旨", "required": true },
          { "key": "similarity", "type": "select", "label": "事案類似度", "required": true, "options": [
            { "value": "high", "label": "高" },
            { "value": "medium", "label": "中" },
            { "value": "low", "label": "低" }
          ]}
        ]},
        { "key": "recommendedPosition", "type": "textarea", "label": "推奨ポジション", "required": true }
      ]
    }
  ]
}
