{
  "$schema": "https://etzhayyim.com/schemas/form/v1.json",
  "key": "gyosei-stay-form-v1",
  "version": 1,
  "title": "執行停止・仮救済申立",
  "tier": 3,
  "encryptionScheme": "signal:v1",
  "components": [
    {
      "key": "stay",
      "type": "fieldset",
      "label": "執行停止情報",
      "components": [
        { "key": "caseId", "type": "textfield", "label": "対象 caseId", "required": true },
        { "key": "requestedOrder", "type": "select", "label": "求める保全", "required": true, "options": [
          { "value": "stay-of-effect", "label": "効力停止" },
          { "value": "stay-of-execution", "label": "執行停止" },
          { "value": "interim-measure", "label": "仮の救済" }
        ]},
        { "key": "irreparableHarmLevel", "type": "select", "label": "回復困難性", "required": true, "options": [
          { "value": "low", "label": "低" },
          { "value": "medium", "label": "中" },
          { "value": "high", "label": "高" }
        ]},
        { "key": "urgencyLevel", "type": "select", "label": "緊急性", "required": true, "options": [
          { "value": "low", "label": "低" },
          { "value": "medium", "label": "中" },
          { "value": "high", "label": "高" }
        ]},
        { "key": "publicInterestRisk", "type": "select", "label": "公共利益阻害リスク", "required": true, "options": [
          { "value": "low", "label": "低" },
          { "value": "medium", "label": "中" },
          { "value": "high", "label": "高" }
        ]},
        { "key": "harmNarrative", "type": "textarea", "label": "具体的損害", "required": true }
      ]
    }
  ]
}
