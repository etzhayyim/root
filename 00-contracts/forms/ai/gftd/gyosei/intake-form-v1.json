{
  "$schema": "https://etzhayyim.com/schemas/form/v1.json",
  "key": "gyosei-intake-form-v1",
  "version": 1,
  "title": "行政手続・不利益処分 intake",
  "regulatoryRef": {
    "law": "行政手続法 / 行政不服審査法",
    "ref": "事前手続・審査請求の一般法パターン"
  },
  "tier": 3,
  "encryptionScheme": "signal:v1",
  "components": [
    {
      "key": "party",
      "type": "fieldset",
      "label": "当事者情報",
      "x-encryptedSection": "partyPayload",
      "components": [
        { "key": "partyType", "type": "select", "label": "当事者区分", "required": true, "options": [
          { "value": "natural-person", "label": "個人" },
          { "value": "corporation", "label": "法人" }
        ]},
        { "key": "name", "type": "textfield", "label": "氏名 / 法人名", "required": true, "x-piiTier": 3, "x-encrypt": "signal:v1" },
        { "key": "address", "type": "textfield", "label": "住所 / 所在地", "required": true, "x-piiTier": 3, "x-encrypt": "signal:v1" },
        { "key": "contactEmail", "type": "email", "label": "連絡先メール", "x-piiTier": 3, "x-encrypt": "signal:v1" },
        { "key": "representativeName", "type": "textfield", "label": "代理人名", "x-piiTier": 3, "x-encrypt": "signal:v1" }
      ]
    },
    {
      "key": "disposition",
      "type": "fieldset",
      "label": "対象処分",
      "components": [
        { "key": "agencyOrgId", "type": "textfield", "label": "行政庁 org_id", "required": true },
        { "key": "domain", "type": "select", "label": "領域", "required": true, "options": [
          { "value": "licensing", "label": "許認可" },
          { "value": "tax", "label": "税務" },
          { "value": "social-security", "label": "社会保障" },
          { "value": "procurement", "label": "入札・調達" },
          { "value": "sanctions", "label": "制裁・不利益処分" },
          { "value": "other", "label": "その他" }
        ]},
        { "key": "dispositionType", "type": "select", "label": "処分類型", "required": true, "options": [
          { "value": "license-revocation", "label": "許認可取消" },
          { "value": "suspension", "label": "停止命令" },
          { "value": "surcharge", "label": "課徴金・加算金" },
          { "value": "rejection", "label": "申請拒否" },
          { "value": "administrative-guidance-related", "label": "行政指導関連" },
          { "value": "other", "label": "その他" }
        ]},
        { "key": "legalBasis", "type": "textfield", "label": "根拠法令", "required": true },
        { "key": "factualSummary", "type": "textarea", "label": "事実概要", "required": true },
        { "key": "isEmergency", "type": "checkbox", "label": "緊急暫定処分が必要" },
        { "key": "financialImpactLevel", "type": "select", "label": "経済的不利益", "required": true, "options": [
          { "value": "low", "label": "小" },
          { "value": "medium", "label": "中" },
          { "value": "high", "label": "大" }
        ]},
        { "key": "requestedHearing", "type": "checkbox", "label": "当事者は聴聞・意見陳述を希望" }
      ]
    },
    {
      "key": "precedent",
      "type": "fieldset",
      "label": "先例・判例候補",
      "components": [
        { "key": "needsPrecedentSearch", "type": "checkbox", "label": "判例調査を行う" },
        { "key": "knownCaseNumbers", "type": "textarea", "label": "既知の事件番号 / 裁決番号" },
        { "key": "precedentSearchTerms", "type": "textarea", "label": "検索語" }
      ]
    },
    {
      "key": "declaration",
      "type": "fieldset",
      "label": "申告",
      "components": [
        { "key": "truthfulnessConfirmed", "type": "checkbox", "label": "事実記載が現時点で正確であることを確認", "required": true },
        { "key": "submittedAt", "type": "datetime", "label": "提出日時", "required": true }
      ]
    }
  ]
}
