<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_green_steel_record_production_metric" targetNamespace="https://etzhayyim.ai/bpmn/open-green-steel" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_green_steel_record_production_metric" name="recordProductionMetric" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_green_steel&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, metric_id: metricId, plant_lei: plantLei, country_iso3: countryIso3, route: route, annual_output_tonnes: annualOutputTonnes, scope1_intensity_tco2e_t: scope1IntensityTco2eT, scope2_intensity_tco2e_t: scope2IntensityTco2eT, recycled_content_pct: recycledContentPct, reporting_year: reportingYear, reported_at: reportedAt, green_tier: if route = &quot;dri_h2&quot; or route = &quot;molten_oxide_electrolysis&quot; then &quot;near_zero&quot; else if route = &quot;eaf_scrap&quot; then &quot;low_carbon&quot; else if route = &quot;dri_ng&quot; or route = &quot;hisarna&quot; then &quot;transitional&quot; else &quot;legacy&quot;, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-green-steel&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-green-steel.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;open.greenSteel.recordProductionMetric&quot;" target="action"/><zeebe:input source="={vertexId: vertexId}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>