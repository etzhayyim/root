<?xml version="1.0" encoding="UTF-8"?>
<!--
  Agent policy adaptation — ADR-2605061200.

  Inputs:
    agentDid
    preferenceKey
    proposal
    mokutekiGatePass
    tripleWitnessPass
    currentPreference
    maxWeightDelta
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_agent_policy_adaptation"
    targetNamespace="https://etzhayyim.ai/bpmn/agent"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="agent_policy_adaptation" name="Agent policy adaptation" isExecutable="true">
    <bpmn:startEvent id="Start" name="manual / timer">
      <bpmn:outgoing>Flow_Start_Adapt</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_Adapt" sourceRef="Start" targetRef="Task_Adapt"/>

    <bpmn:serviceTask id="Task_Adapt" name="Build bounded policy adaptation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="agent.adaptPolicy"/>
        <zeebe:ioMapping>
          <zeebe:input source="=agentDid" target="agentDid"/>
          <zeebe:input source="=preferenceKey" target="preferenceKey"/>
          <zeebe:input source="=proposal" target="proposal"/>
          <zeebe:input source="=mokutekiGatePass" target="mokutekiGatePass"/>
          <zeebe:input source="=tripleWitnessPass" target="tripleWitnessPass"/>
          <zeebe:input source="=currentPreference" target="currentPreference"/>
          <zeebe:input source="=if maxWeightDelta = null then 0.2 else maxWeightDelta" target="maxWeightDelta"/>
          <zeebe:output source="=accepted" target="policyAccepted"/>
          <zeebe:output source="=blockers" target="policyBlockers"/>
          <zeebe:output source="=policyProposal" target="policyProposal"/>
          <zeebe:output source="=preference" target="preference"/>
          <zeebe:output source="=proposalHash" target="proposalHash"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Adapt</bpmn:incoming>
      <bpmn:outgoing>Flow_Adapt_WriteProposal</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Adapt_WriteProposal" sourceRef="Task_Adapt" targetRef="Task_WriteProposal"/>

    <bpmn:serviceTask id="Task_WriteProposal" name="Record policy adaptation proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_agent_policy_adaptation_proposal&quot;" target="table"/>
          <zeebe:input source="=policyProposal" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
          <zeebe:input source="=&quot;agent_policy_adaptation&quot;" target="_bpmnProcessId"/>
          <zeebe:output source="=inserted" target="policyProposalInserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Adapt_WriteProposal</bpmn:incoming>
      <bpmn:outgoing>Flow_WriteProposal_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_WriteProposal_Gateway" sourceRef="Task_WriteProposal" targetRef="Gateway_Accepted"/>

    <bpmn:exclusiveGateway id="Gateway_Accepted" name="accepted?" default="Flow_Accepted_AuditBlocked">
      <bpmn:incoming>Flow_WriteProposal_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Accepted_WritePreference</bpmn:outgoing>
      <bpmn:outgoing>Flow_Accepted_AuditBlocked</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Accepted_WritePreference" sourceRef="Gateway_Accepted" targetRef="Task_WritePreference">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=policyAccepted = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Accepted_AuditBlocked" sourceRef="Gateway_Accepted" targetRef="Task_AuditBlocked"/>

    <bpmn:serviceTask id="Task_WritePreference" name="Activate bounded prior preference">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_agent_prior_preference&quot;" target="table"/>
          <zeebe:input source="=preference" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
          <zeebe:input source="=&quot;agent_policy_adaptation&quot;" target="_bpmnProcessId"/>
          <zeebe:output source="=inserted" target="preferenceInserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Accepted_WritePreference</bpmn:incoming>
      <bpmn:outgoing>Flow_WritePreference_AuditAccepted</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_WritePreference_AuditAccepted" sourceRef="Task_WritePreference" targetRef="Task_AuditAccepted"/>

    <bpmn:serviceTask id="Task_AuditAccepted" name="Audit policy adaptation accepted">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;agent.policyAdaptation.accepted&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;agentDid&quot;: agentDid, &quot;preferenceKey&quot;: preferenceKey, &quot;proposalHash&quot;: proposalHash, &quot;proposalInserted&quot;: policyProposalInserted, &quot;preferenceInserted&quot;: preferenceInserted }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_WritePreference_AuditAccepted</bpmn:incoming>
      <bpmn:outgoing>Flow_AuditAccepted_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AuditAccepted_End" sourceRef="Task_AuditAccepted" targetRef="End_Accepted"/>

    <bpmn:serviceTask id="Task_AuditBlocked" name="Audit policy adaptation blocked">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;agent.policyAdaptation.blocked&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;agentDid&quot;: agentDid, &quot;preferenceKey&quot;: preferenceKey, &quot;proposalHash&quot;: proposalHash, &quot;proposalInserted&quot;: policyProposalInserted, &quot;blockers&quot;: policyBlockers }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Accepted_AuditBlocked</bpmn:incoming>
      <bpmn:outgoing>Flow_AuditBlocked_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AuditBlocked_End" sourceRef="Task_AuditBlocked" targetRef="End_Blocked"/>

    <bpmn:endEvent id="End_Accepted" name="accepted">
      <bpmn:incoming>Flow_AuditAccepted_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Blocked" name="blocked">
      <bpmn:incoming>Flow_AuditBlocked_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
