<?xml version="1.0" encoding="UTF-8"?>
<!--
  Agent homeostasis watch — ADR-2605061200.

  Inputs:
    agentDid
    computeBudgetRemaining
    storagePressure
    leaseSecondsRemaining
    errorRate1h
    toolSuccessRate1h
    energyOrCostProxy
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_agent_homeostasis_watch"
    targetNamespace="https://etzhayyim.ai/bpmn/agent"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="agent_homeostasis_watch" name="Agent homeostasis watch" isExecutable="true">
    <bpmn:startEvent id="Start" name="manual / timer">
      <bpmn:outgoing>Flow_Start_Evaluate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_Evaluate" sourceRef="Start" targetRef="Task_Evaluate"/>

    <bpmn:serviceTask id="Task_Evaluate" name="Evaluate viability">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="agent.evaluateViability"/>
        <zeebe:ioMapping>
          <zeebe:input source="=computeBudgetRemaining" target="computeBudgetRemaining"/>
          <zeebe:input source="=storagePressure" target="storagePressure"/>
          <zeebe:input source="=leaseSecondsRemaining" target="leaseSecondsRemaining"/>
          <zeebe:input source="=errorRate1h" target="errorRate1h"/>
          <zeebe:input source="=toolSuccessRate1h" target="toolSuccessRate1h"/>
          <zeebe:input source="=energyOrCostProxy" target="energyOrCostProxy"/>
          <zeebe:output source="=viabilityState" target="viabilityState"/>
          <zeebe:output source="=blockers" target="viabilityBlockers"/>
          <zeebe:output source="=nextActions" target="viabilityNextActions"/>
          <zeebe:output source="=normalized" target="homeostasisNormalized"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Evaluate</bpmn:incoming>
      <bpmn:outgoing>Flow_Evaluate_Write</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Evaluate_Write" sourceRef="Task_Evaluate" targetRef="Task_Write"/>

    <bpmn:serviceTask id="Task_Write" name="Record homeostasis snapshot">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="agent.recordHomeostasisSnapshot"/>
        <zeebe:ioMapping>
          <zeebe:input source="=agentDid" target="agentDid"/>
          <zeebe:input source="=homeostasisNormalized" target="homeostasisNormalized"/>
          <zeebe:input source="=viabilityState" target="viabilityState"/>
          <zeebe:input source="=string(now())" target="createdAt"/>
          <zeebe:output source="=inserted" target="homeostasisInserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Evaluate_Write</bpmn:incoming>
      <bpmn:outgoing>Flow_Write_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Write_Audit" sourceRef="Task_Write" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="Emit homeostasis audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;agent.homeostasis.snapshot&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;agentDid&quot;: agentDid, &quot;viabilityState&quot;: viabilityState, &quot;blockers&quot;: viabilityBlockers, &quot;nextActions&quot;: viabilityNextActions, &quot;inserted&quot;: homeostasisInserted }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Write_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_Audit_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
