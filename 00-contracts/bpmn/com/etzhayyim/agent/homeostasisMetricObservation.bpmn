<?xml version="1.0" encoding="UTF-8"?>
<!--
  Agent homeostasis metric observation — ADR-2605061200.

  Records local measured homeostasis inputs as vertex_agent_observation rows so
  the artificial organism can evaluate its own runtime health over time.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_agent_homeostasis_metric_observation"
    targetNamespace="https://etzhayyim.ai/bpmn/agent"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="agent_homeostasis_metric_observation" name="Agent homeostasis metric observation" isExecutable="true">
    <bpmn:startEvent id="Start" name="metrics measured">
      <bpmn:outgoing>Flow_Start_Record</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_Record" sourceRef="Start" targetRef="Task_Record"/>

    <bpmn:serviceTask id="Task_Record" name="Record homeostasis metric observation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="agent.recordHomeostasisMetricObservation"/>
        <zeebe:ioMapping>
          <zeebe:input source="=agentDid" target="agentDid"/>
          <zeebe:input source="=viability" target="viability"/>
          <zeebe:input source="=homeostasisMetrics" target="homeostasisMetrics"/>
          <zeebe:input source="=homeostasisControls" target="homeostasisControls"/>
          <zeebe:input source="=observedAt" target="observedAt"/>
          <zeebe:output source="=inserted" target="observationInserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Record</bpmn:incoming>
      <bpmn:outgoing>Flow_Record_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Record_Audit" sourceRef="Task_Record" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="Audit homeostasis metric observation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;agent.homeostasis.metrics.observed&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;agentDid&quot;: agentDid, &quot;viabilityState&quot;: viability.viabilityState, &quot;errorRate1h&quot;: homeostasisMetrics.errorRate1h, &quot;toolSuccessRate1h&quot;: homeostasisMetrics.toolSuccessRate1h, &quot;inserted&quot;: observationInserted }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Record_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="recorded">
      <bpmn:incoming>Flow_Audit_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
