<?xml version="1.0" encoding="UTF-8"?>
<!--
  Active Inference tick — ADR-2605061200 / ADR-2605061300.

  Inputs:
    agentDid
    tickKind
    beliefSnapshotHash
    candidateActions
    mokutekiGatePass

  Outputs:
    selectedActionId
    expectedFreeEnergy
    rejectedActions
    tickInserted
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_agent_active_inference_tick"
    targetNamespace="https://etzhayyim.ai/bpmn/agent"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="agent_active_inference_tick" name="Agent active inference tick" isExecutable="true">
    <bpmn:startEvent id="Start" name="manual / timer">
      <bpmn:outgoing>Flow_Start_Evaluate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_Evaluate" sourceRef="Start" targetRef="Task_Evaluate"/>

    <bpmn:serviceTask id="Task_Evaluate" name="Evaluate expected free energy">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="agent.evaluateExpectedFreeEnergy"/>
        <zeebe:ioMapping>
          <zeebe:input source="=candidateActions" target="candidateActions"/>
          <zeebe:input source="=mokutekiGatePass" target="mokutekiGatePass"/>
          <zeebe:input source="=true" target="requireSafetyFloor"/>
          <zeebe:output source="=selectedActionId" target="selectedActionId"/>
          <zeebe:output source="=expectedFreeEnergy" target="expectedFreeEnergy"/>
          <zeebe:output source="=rejected" target="rejectedActions"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Evaluate</bpmn:incoming>
      <bpmn:outgoing>Flow_Evaluate_WriteTick</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Evaluate_WriteTick" sourceRef="Task_Evaluate" targetRef="Task_WriteTick"/>

    <bpmn:serviceTask id="Task_WriteTick" name="Record active inference tick">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="agent.recordActiveInferenceTick"/>
        <zeebe:ioMapping>
          <zeebe:input source="=agentDid" target="agentDid"/>
          <zeebe:input source="=tickKind" target="tickKind"/>
          <zeebe:input source="=beliefSnapshotHash" target="beliefSnapshotHash"/>
          <zeebe:input source="=candidateActions" target="candidateActions"/>
          <zeebe:input source="=expectedFreeEnergy" target="expectedFreeEnergy"/>
          <zeebe:input source="=selectedActionId" target="selectedActionId"/>
          <zeebe:input source="=mokutekiGatePass" target="mokutekiGatePass"/>
          <zeebe:input source="=string(now())" target="createdAt"/>
          <zeebe:input source="=tickId" target="tickId"/>
          <zeebe:output source="=inserted" target="tickInserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Evaluate_WriteTick</bpmn:incoming>
      <bpmn:outgoing>Flow_WriteTick_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_WriteTick_Audit" sourceRef="Task_WriteTick" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="Emit active inference audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;agent.activeInference.tick&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;agentDid&quot;: agentDid, &quot;selectedActionId&quot;: selectedActionId, &quot;expectedFreeEnergy&quot;: expectedFreeEnergy, &quot;rejected&quot;: rejectedActions, &quot;inserted&quot;: tickInserted }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_WriteTick_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_Audit_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
