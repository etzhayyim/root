<?xml version="1.0" encoding="UTF-8"?>
<!--
  Autonomous real-world effect dispatch — active influence path.

  This process does not wait for per-action human approval. It requires a
  scoped autonomous authority ref, policy ref, payload hash match, and a
  supported channel task plan. Phase A dispatches email only because
  mailer.sendEmail is the channel worker currently present in this repo.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_agent_realworld_autonomous_dispatch"
    targetNamespace="https://etzhayyim.ai/bpmn/agent"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="agent_realworld_autonomous_dispatch" name="Agent real-world autonomous dispatch" isExecutable="true">
    <bpmn:startEvent id="Start" name="effect proposal received">
      <bpmn:outgoing>Flow_Start_Classify</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_Classify" sourceRef="Start" targetRef="Task_Classify"/>

    <bpmn:serviceTask id="Task_Classify" name="Classify effect with autonomous authority">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="agent.classifyRealWorldEffect"/>
        <zeebe:ioMapping>
          <zeebe:input source="=channel" target="channel"/>
          <zeebe:input source="=payload" target="payload"/>
          <zeebe:input source="=actionProposalId" target="actionProposalId"/>
          <zeebe:input source="=agentDid" target="agentDid"/>
          <zeebe:input source="=principalDid" target="principalDid"/>
          <zeebe:input source="=effectClass" target="effectClass"/>
          <zeebe:input source="=targetRef" target="targetRef"/>
          <zeebe:input source="=summary" target="summary"/>
          <zeebe:input source="=approvalRef" target="approvalRef"/>
          <zeebe:input source="=authorityRef" target="authorityRef"/>
          <zeebe:input source="=autonomousAuthorityRef" target="autonomousAuthorityRef"/>
          <zeebe:input source="=budgetRef" target="budgetRef"/>
          <zeebe:output source="=realWorldEffect" target="realWorldEffect"/>
          <zeebe:output source="=requiresApproval" target="requiresApproval"/>
          <zeebe:output source="=authorityMode" target="authorityMode"/>
          <zeebe:output source="=blockers" target="effectBlockers"/>
          <zeebe:output source="=externalEffectPenalty" target="externalEffectPenalty"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Classify</bpmn:incoming>
      <bpmn:outgoing>Flow_Classify_Write</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Classify_Write" sourceRef="Task_Classify" targetRef="Task_Write"/>

    <bpmn:serviceTask id="Task_Write" name="Record real-world effect">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_agent_realworld_effect&quot;" target="table"/>
          <zeebe:input source="={ vertex_id: realWorldEffect.vertex_id, action_proposal_id: realWorldEffect.action_proposal_id, agent_did: realWorldEffect.agent_did, principal_did: realWorldEffect.principal_did, channel: realWorldEffect.channel, effect_class: realWorldEffect.effect_class, target_ref_hash: realWorldEffect.target_ref_hash, payload_hash: realWorldEffect.payload_hash, summary: realWorldEffect.summary, approval_ref: realWorldEffect.approval_ref, authority_ref: realWorldEffect.authority_ref, budget_ref: realWorldEffect.budget_ref, dispatch_state: realWorldEffect.dispatch_state, dispatch_receipt_ref: realWorldEffect.dispatch_receipt_ref, observation_plan_json: realWorldEffect.observation_plan_json, created_at: realWorldEffect.created_at, updated_at: realWorldEffect.updated_at, sensitivity_ord: 1, actor_id: &quot;sys.agent.autonomousDispatch&quot;, owner_did: realWorldEffect.agent_did, org_id: realWorldEffect.agent_did, user_id: realWorldEffect.agent_did }" target="values"/>
          <zeebe:input source="=&quot;agent_realworld_autonomous_dispatch&quot;" target="_bpmnProcessId"/>
          <zeebe:output source="=inserted" target="effectInserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Classify_Write</bpmn:incoming>
      <bpmn:outgoing>Flow_Write_Plan</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Write_Plan" sourceRef="Task_Write" targetRef="Task_Plan"/>

    <bpmn:serviceTask id="Task_Plan" name="Plan autonomous channel dispatch">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="agent.planRealWorldDispatch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=realWorldEffect" target="realWorldEffect"/>
          <zeebe:input source="=payload" target="payload"/>
          <zeebe:input source="=autonomousAuthorityRef" target="autonomousAuthorityRef"/>
          <zeebe:input source="=policyRef" target="policyRef"/>
          <zeebe:input source="=policy" target="policy"/>
          <zeebe:input source="=budgetRef" target="budgetRef"/>
          <zeebe:input source="=&quot;autonomous&quot;" target="mode"/>
          <zeebe:output source="={ dispatchAllowed: dispatchAllowed, dispatchPlanId: dispatchPlanId, blockers: blockers, channel: channel, effectClass: effectClass, taskType: taskType, nsid: nsid, channelPayload: channelPayload, payloadHash: payloadHash, authorityRef: authorityRef, policyRef: policyRef, budgetRef: budgetRef, receiptExpectation: receiptExpectation }" target="dispatchPlan"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Write_Plan</bpmn:incoming>
      <bpmn:outgoing>Flow_Plan_RecordLedger</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Plan_RecordLedger" sourceRef="Task_Plan" targetRef="Task_RecordDispatchLedger"/>

    <bpmn:serviceTask id="Task_RecordDispatchLedger" name="Record dispatch ledger">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_agent_dispatch_ledger&quot;" target="table"/>
          <zeebe:input source="={ vertex_id: dispatchPlan.dispatchPlanId, agent_did: agentDid, dispatch_plan_id: dispatchPlan.dispatchPlanId, realworld_effect_id: realWorldEffect.vertex_id, channel: dispatchPlan.channel, task_type: dispatchPlan.taskType, payload_hash: dispatchPlan.payloadHash, authority_ref: dispatchPlan.authorityRef, policy_ref: dispatchPlan.policyRef, dispatch_state: &quot;planned&quot;, created_at: realWorldEffect.updated_at, updated_at: realWorldEffect.updated_at, sensitivity_ord: 1, actor_id: &quot;sys.agent.dispatchLedger&quot;, owner_did: agentDid, org_id: agentDid, user_id: agentDid }" target="values"/>
          <zeebe:input source="=&quot;agent_realworld_autonomous_dispatch&quot;" target="_bpmnProcessId"/>
          <zeebe:output source="=inserted" target="dispatchLedgerInserted"/>
          <zeebe:output source="=already_known" target="dispatchAlreadyKnown"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Plan_RecordLedger</bpmn:incoming>
      <bpmn:outgoing>Flow_Ledger_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Ledger_Gateway" sourceRef="Task_RecordDispatchLedger" targetRef="Gateway_Dispatch"/>

    <bpmn:exclusiveGateway id="Gateway_Dispatch" name="dispatch allowed?" default="Flow_Dispatch_Blocked">
      <bpmn:incoming>Flow_Ledger_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Dispatch_Email</bpmn:outgoing>
      <bpmn:outgoing>Flow_Dispatch_Blocked</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Dispatch_Email" sourceRef="Gateway_Dispatch" targetRef="Task_SendEmail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=dispatchPlan.dispatchAllowed and dispatchPlan.taskType = "mailer.sendEmail" and dispatchLedgerInserted = 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Dispatch_Blocked" sourceRef="Gateway_Dispatch" targetRef="Task_AuditBlocked"/>

    <bpmn:serviceTask id="Task_SendEmail" name="Send autonomous email">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mailer.sendEmail"/>
        <zeebe:ioMapping>
          <zeebe:input source="=dispatchPlan.channelPayload.to" target="to"/>
          <zeebe:input source="=dispatchPlan.channelPayload.subject" target="subject"/>
          <zeebe:input source="=dispatchPlan.channelPayload.text" target="text"/>
          <zeebe:input source="=dispatchPlan.channelPayload.html" target="html"/>
          <zeebe:input source="=dispatchPlan.channelPayload.fromAddress" target="fromAddress"/>
          <zeebe:input source="=dispatchPlan.channelPayload.replyTo" target="replyTo"/>
          <zeebe:output source="={ messageId: messageId, provider: provider, sentAt: sentAt, error: error, status: status, body: body }" target="dispatchResult"/>
          <zeebe:output source="=messageId" target="dispatchReceiptRef"/>
          <zeebe:output source="=error" target="dispatchError"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Dispatch_Email</bpmn:incoming>
      <bpmn:outgoing>Flow_Email_BuildReceipt</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Email_BuildReceipt" sourceRef="Task_SendEmail" targetRef="Task_BuildReceiptObservation"/>

    <bpmn:serviceTask id="Task_BuildReceiptObservation" name="Build dispatch receipt observation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="agent.buildDispatchReceiptObservation"/>
        <zeebe:ioMapping>
          <zeebe:input source="=realWorldEffect" target="realWorldEffect"/>
          <zeebe:input source="=dispatchPlan" target="dispatchPlan"/>
          <zeebe:input source="=dispatchResult" target="dispatchResult"/>
          <zeebe:output source="=observation" target="receiptObservation"/>
          <zeebe:output source="=effectPatch" target="effectPatch"/>
          <zeebe:output source="=dispatchState" target="dispatchState"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Email_BuildReceipt</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildReceipt_RecordEffectReceipt</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_BuildReceipt_RecordEffectReceipt" sourceRef="Task_BuildReceiptObservation" targetRef="Task_RecordEffectReceipt"/>

    <bpmn:serviceTask id="Task_RecordEffectReceipt" name="Record effect dispatch receipt">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="agent.recordDispatchReceipt"/>
        <zeebe:ioMapping>
          <zeebe:input source="=effectPatch" target="effectPatch"/>
          <zeebe:output source="=updated" target="effectReceiptUpdated"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_BuildReceipt_RecordEffectReceipt</bpmn:incoming>
      <bpmn:outgoing>Flow_RecordEffectReceipt_RecordObservation</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_RecordEffectReceipt_RecordObservation" sourceRef="Task_RecordEffectReceipt" targetRef="Task_RecordReceiptObservation"/>

    <bpmn:serviceTask id="Task_RecordReceiptObservation" name="Record dispatch receipt observation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_agent_observation&quot;" target="table"/>
          <zeebe:input source="=receiptObservation" target="values"/>
          <zeebe:input source="=&quot;agent_realworld_autonomous_dispatch&quot;" target="_bpmnProcessId"/>
          <zeebe:output source="=inserted" target="receiptObservationInserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RecordEffectReceipt_RecordObservation</bpmn:incoming>
      <bpmn:outgoing>Flow_RecordObservation_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_RecordObservation_Audit" sourceRef="Task_RecordReceiptObservation" targetRef="Task_AuditSent"/>

    <bpmn:serviceTask id="Task_AuditSent" name="Audit autonomous dispatch">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;agent.realWorldEffect.autonomousDispatched&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;agentDid&quot;: agentDid, &quot;channel&quot;: dispatchPlan.channel, &quot;taskType&quot;: dispatchPlan.taskType, &quot;dispatchPlanId&quot;: dispatchPlan.dispatchPlanId, &quot;authorityRef&quot;: dispatchPlan.authorityRef, &quot;policyRef&quot;: dispatchPlan.policyRef, &quot;payloadHash&quot;: dispatchPlan.payloadHash, &quot;receiptRef&quot;: dispatchReceiptRef, &quot;dispatchState&quot;: dispatchState, &quot;effectReceiptUpdated&quot;: effectReceiptUpdated, &quot;observationInserted&quot;: receiptObservationInserted, &quot;error&quot;: dispatchError }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RecordObservation_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_AuditSent_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AuditSent_End" sourceRef="Task_AuditSent" targetRef="End_Sent"/>

    <bpmn:serviceTask id="Task_AuditBlocked" name="Audit autonomous dispatch blocked">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;agent.realWorldEffect.autonomousBlocked&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;agentDid&quot;: agentDid, &quot;channel&quot;: channel, &quot;effectBlockers&quot;: effectBlockers, &quot;dispatchBlockers&quot;: dispatchPlan.blockers, &quot;dispatchPlanId&quot;: dispatchPlan.dispatchPlanId, &quot;dispatchLedgerInserted&quot;: dispatchLedgerInserted, &quot;dispatchAlreadyKnown&quot;: dispatchAlreadyKnown, &quot;policyRef&quot;: policyRef }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Dispatch_Blocked</bpmn:incoming>
      <bpmn:outgoing>Flow_AuditBlocked_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AuditBlocked_End" sourceRef="Task_AuditBlocked" targetRef="End_Blocked"/>

    <bpmn:endEvent id="End_Sent" name="autonomous dispatch sent">
      <bpmn:incoming>Flow_AuditSent_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Blocked" name="autonomous dispatch blocked">
      <bpmn:incoming>Flow_AuditBlocked_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
