<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.etzhayyim.apps.agent.triagedIngest — Phase D pilot of ADR-0049 (2026-04-25).

  First production-shaped caller of `com.etzhayyim.agent.plan` (LangGraph 3-node:
  classify → summarise → audit). Routes the row through fast / thorough /
  skip and emits one OCEL audit row per branch into vertex_repo_commit.

  Flow:
    Start → Task_Plan → Gate(branch) ─┬─ skip     → Audit_Skip     → End_Skip
                                      ├─ fast     → Audit_Fast     → End_Fast
                                      └─ thorough → Audit_Thorough → End_Thorough

  Inputs (from XRPC POST body):
    context   — free-form dict for the planner (FEEL context literal)
    taskHint  — optional string
    threadId  — optional correlation id; defaults to BPMN process key

  Outputs (returned to XRPC caller):
    ok            = true
    branch        — "skip" | "fast" | "thorough"
    nextTool      — NSID the caller should run next, or "" for skip
    confidence    — 0.1..1.0 (planner-reported)
    reason        — <=200 char rationale
    planLatencyMs — wall clock of the LLM call
    llmModel      — model id resolved by the tier
    auditRkey     — vertex_repo_commit rkey written by plan.audit_plan
    triageRkey    — vertex_repo_commit rkey written by this BPMN's audit step
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_agent_triaged_ingest"
    targetNamespace="https://etzhayyim.ai/bpmn/agent"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="agent_triaged_ingest" name="agent triaged ingest" isExecutable="true">
    <bpmn:documentation>{"nsid": "com.etzhayyim.apps.agent.triagedIngest", "version": 2, "resultTimeoutMs": 60000}</bpmn:documentation>

    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_Plan</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Plan" sourceRef="Start" targetRef="Task_Plan"/>

    <bpmn:serviceTask id="Task_Plan" name="agent.plan (LangGraph)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.agent.plan" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=context"                                           target="context"/>
          <zeebe:input source="=if taskHint = null then &quot;&quot; else taskHint" target="taskHint"/>
          <zeebe:input source="=if threadId = null then &quot;&quot; else threadId" target="threadId"/>
          <zeebe:input source="=10000"                                              target="budgetMs"/>
          <zeebe:output source="=branch"        target="branch"/>
          <zeebe:output source="=nextTool"      target="nextTool"/>
          <zeebe:output source="=confidence"    target="confidence"/>
          <zeebe:output source="=reason"        target="reason"/>
          <zeebe:output source="=planLatencyMs" target="planLatencyMs"/>
          <zeebe:output source="=llmModel"      target="llmModel"/>
          <zeebe:output source="=auditRkey"     target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Plan</bpmn:incoming><bpmn:outgoing>Flow_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Gate" sourceRef="Task_Plan" targetRef="Gate"/>

    <bpmn:exclusiveGateway id="Gate" name="branch?" default="Flow_Skip">
      <bpmn:incoming>Flow_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Fast</bpmn:outgoing>
      <bpmn:outgoing>Flow_Thorough</bpmn:outgoing>
      <bpmn:outgoing>Flow_Skip</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Fast" sourceRef="Gate" targetRef="Audit_Fast">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=branch = "fast"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Thorough" sourceRef="Gate" targetRef="Audit_Thorough">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=branch = "thorough"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Skip" sourceRef="Gate" targetRef="Audit_Skip"/>

    <bpmn:serviceTask id="Audit_Fast" name="audit triage.fast">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:agent.etzhayyim.com:triage&quot;" target="actor"/>
          <zeebe:input source="=&quot;agent.triage.fast&quot;"             target="action"/>
          <zeebe:input source="={
              branch:        branch,
              nextTool:      nextTool,
              confidence:    confidence,
              reason:        reason,
              planLatencyMs: planLatencyMs,
              llmModel:      llmModel,
              planAuditRkey: auditRkey,
              threadId:      if threadId = null then &quot;&quot; else threadId
          }" target="payload"/>
          <zeebe:output source="=rkey" target="triageRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Fast</bpmn:incoming><bpmn:outgoing>Flow_EndFast</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndFast" sourceRef="Audit_Fast" targetRef="End_Fast"/>

    <bpmn:serviceTask id="Audit_Thorough" name="audit triage.thorough">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:agent.etzhayyim.com:triage&quot;" target="actor"/>
          <zeebe:input source="=&quot;agent.triage.thorough&quot;"         target="action"/>
          <zeebe:input source="={
              branch:        branch,
              nextTool:      nextTool,
              confidence:    confidence,
              reason:        reason,
              planLatencyMs: planLatencyMs,
              llmModel:      llmModel,
              planAuditRkey: auditRkey,
              threadId:      if threadId = null then &quot;&quot; else threadId
          }" target="payload"/>
          <zeebe:output source="=rkey" target="triageRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Thorough</bpmn:incoming><bpmn:outgoing>Flow_EndThorough</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndThorough" sourceRef="Audit_Thorough" targetRef="End_Thorough"/>

    <bpmn:serviceTask id="Audit_Skip" name="audit triage.skip">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:agent.etzhayyim.com:triage&quot;" target="actor"/>
          <zeebe:input source="=&quot;agent.triage.skip&quot;"             target="action"/>
          <zeebe:input source="={
              branch:        branch,
              nextTool:      nextTool,
              confidence:    confidence,
              reason:        reason,
              planLatencyMs: planLatencyMs,
              llmModel:      llmModel,
              planAuditRkey: auditRkey,
              threadId:      if threadId = null then &quot;&quot; else threadId
          }" target="payload"/>
          <zeebe:output source="=rkey" target="triageRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Skip</bpmn:incoming><bpmn:outgoing>Flow_EndSkip</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndSkip" sourceRef="Audit_Skip" targetRef="End_Skip"/>

    <bpmn:endEvent id="End_Fast"><bpmn:incoming>Flow_EndFast</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_Thorough"><bpmn:incoming>Flow_EndThorough</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_Skip"><bpmn:incoming>Flow_EndSkip</bpmn:incoming></bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
