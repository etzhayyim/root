<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_airplane_report_incident"
    targetNamespace="https://etzhayyim.ai/bpmn/open-airplane"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="open_airplane_report_incident" name="事故 報告" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Classify"/>

    <!--
      severity: fatal (inj>=1 OR category in {runway-excursion,collision,hull-loss})
                serious (inj<=0 AND category in {bird-strike,engine-failure,turbulence-injury})
                minor (otherwise)
      requirePublicNotice = severity != "minor"
    -->
    <bpmn:serviceTask id="Task_Classify" name="severity 分類">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT 1 AS ok LIMIT 1&quot;" target="query"/>
          <zeebe:input source="=[]" target="params"/>
          <zeebe:output source="=if injuries &gt;= 1 or list contains([&quot;runway-excursion&quot;,&quot;collision&quot;,&quot;hull-loss&quot;], category) then &quot;fatal&quot;
                                else if list contains([&quot;bird-strike&quot;,&quot;engine-failure&quot;,&quot;turbulence-injury&quot;], category) then &quot;serious&quot;
                                else &quot;minor&quot;" target="severity"/>
          <zeebe:output source="=injuries &gt;= 1 or list contains([&quot;runway-excursion&quot;,&quot;collision&quot;,&quot;hull-loss&quot;,&quot;bird-strike&quot;,&quot;engine-failure&quot;,&quot;turbulence-injury&quot;], category)" target="requirePublicNotice"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_Save</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Save" sourceRef="Task_Classify" targetRef="Task_SaveIncident"/>

    <bpmn:serviceTask id="Task_SaveIncident" name="incident 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_airplane_incident&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:             vertexId,
              operator_org_id:       operatorOrgId,
              aircraft_vid:          aircraftVid,
              flight_vid:            flightVid,
              category:              category,
              narrative:             narrative,
              injuries:              injuries,
              severity:              severity,
              require_public_notice: requirePublicNotice,
              status:                &quot;open&quot;,
              reported_at:           reportedAt,
              created_at:            string(now()),
              owner_did:             callerDid,
              sensitivity_ord:       1,
              org_id:                operatorOrgId,
              user_id:               callerDid,
              actor_id:              &quot;sys.bpmn.open-airplane&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Save</bpmn:incoming><bpmn:outgoing>Flow_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Gate" sourceRef="Task_SaveIncident" targetRef="Gate"/>

    <bpmn:exclusiveGateway id="Gate" name="公衆周知?" default="Flow_Silent">
      <bpmn:incoming>Flow_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Notice</bpmn:outgoing>
      <bpmn:outgoing>Flow_Silent</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Notice" sourceRef="Gate" targetRef="Task_Notice">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=requirePublicNotice = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Silent" sourceRef="Gate" targetRef="Task_AuditSilent"/>

    <bpmn:serviceTask id="Task_Notice" name="公衆周知 post">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;app.bsky.feed.post&quot;" target="type"/>
          <zeebe:input source="={
              text: &quot;[open-airplane] incident: aircraft=&quot; + string(aircraftVid)
                    + &quot; severity=&quot; + string(severity)
                    + &quot; category=&quot; + string(category),
              createdAt: string(now())
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Notice</bpmn:incoming><bpmn:outgoing>Flow_AM</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AM" sourceRef="Task_Notice" targetRef="Task_AuditMajor"/>

    <bpmn:serviceTask id="Task_AuditMajor" name="audit incident.notice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-airplane.etzhayyim.com:ops&quot;" target="actor"/>
          <zeebe:input source="=&quot;openAirplane.incident.publicNotice&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, severity: severity, aircraftVid: aircraftVid}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AM</bpmn:incoming><bpmn:outgoing>Flow_EndM</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndM" sourceRef="Task_AuditMajor" targetRef="End_M"/>

    <bpmn:serviceTask id="Task_AuditSilent" name="audit incident.log">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-airplane.etzhayyim.com:ops&quot;" target="actor"/>
          <zeebe:input source="=&quot;openAirplane.incident.log&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, severity: severity, aircraftVid: aircraftVid}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Silent</bpmn:incoming><bpmn:outgoing>Flow_EndS</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndS" sourceRef="Task_AuditSilent" targetRef="End_S"/>

    <bpmn:endEvent id="End_S"><bpmn:incoming>Flow_EndS</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_M"><bpmn:incoming>Flow_EndM</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
