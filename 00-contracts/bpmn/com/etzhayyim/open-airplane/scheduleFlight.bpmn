<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_airplane_schedule_flight"
    targetNamespace="https://etzhayyim.ai/bpmn/open-airplane"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="open_airplane_schedule_flight" name="便 登録" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_SaveFlight"/>

    <bpmn:serviceTask id="Task_SaveFlight" name="flight 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_airplane_flight&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:        vertexId,
              operator_org_id:  operatorOrgId,
              aircraft_vid:     aircraftVid,
              origin_vid:       originVid,
              destination_vid:  destinationVid,
              flight_number:    flightNumber,
              scheduled_off:    scheduledOff,
              scheduled_in:     scheduledIn,
              status:           &quot;scheduled&quot;,
              created_at:       string(now()),
              owner_did:        callerDid,
              sensitivity_ord:  1,
              org_id:           operatorOrgId,
              user_id:          callerDid,
              actor_id:         &quot;sys.bpmn.open-airplane&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_EdgeO</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EdgeO" sourceRef="Task_SaveFlight" targetRef="Task_EdgeOrigin"/>

    <bpmn:serviceTask id="Task_EdgeOrigin" name="route edge (origin)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;edge_open_airplane_flight_route&quot;" target="table"/>
          <zeebe:input source="={
              edge_id:   string(vertexId) + &quot;:origin&quot;,
              src_vid:   vertexId,
              dst_vid:   originVid,
              role:      &quot;origin&quot;,
              created_at: string(now()),
              owner_did: callerDid,
              sensitivity_ord: 1,
              org_id:    operatorOrgId,
              user_id:   callerDid,
              actor_id:  &quot;sys.bpmn.open-airplane&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_EdgeO</bpmn:incoming><bpmn:outgoing>Flow_EdgeD</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EdgeD" sourceRef="Task_EdgeOrigin" targetRef="Task_EdgeDest"/>

    <bpmn:serviceTask id="Task_EdgeDest" name="route edge (destination)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;edge_open_airplane_flight_route&quot;" target="table"/>
          <zeebe:input source="={
              edge_id:   string(vertexId) + &quot;:destination&quot;,
              src_vid:   vertexId,
              dst_vid:   destinationVid,
              role:      &quot;destination&quot;,
              created_at: string(now()),
              owner_did: callerDid,
              sensitivity_ord: 1,
              org_id:    operatorOrgId,
              user_id:   callerDid,
              actor_id:  &quot;sys.bpmn.open-airplane&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_EdgeD</bpmn:incoming><bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_EdgeDest" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit flight.schedule">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-airplane.etzhayyim.com:ops&quot;" target="actor"/>
          <zeebe:input source="=&quot;openAirplane.flight.schedule&quot;" target="action"/>
          <zeebe:input source="={
              vertexId:      vertexId,
              operatorOrgId: operatorOrgId,
              flightNumber:  flightNumber,
              originVid:     originVid,
              destinationVid: destinationVid
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
