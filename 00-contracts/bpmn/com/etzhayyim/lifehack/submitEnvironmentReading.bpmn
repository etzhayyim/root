<?xml version="1.0" encoding="UTF-8"?>
<!--
  lifehack.etzhayyim.com — submitEnvironmentReading
  (XRPC com.etzhayyim.apps.lifehack.submitEnvironmentReading).

  Single-step persist into vertex_lifehack_environment_reading.  Feeds
  mv_lifehack_static_risk_now → staticAlert BPMN.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_lifehack_submit_environment_reading"
    targetNamespace="https://etzhayyim.ai/bpmn/lifehack"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="lifehack_submit_environment_reading" name="lifehack submit environment reading" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.lifehack.submitEnvironmentReading", "version": 1, "resultTimeoutMs": 15000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="submitEnvironmentReading">
      <bpmn:outgoing>Flow_ToPersist</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Persist" name="persist reading">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lifehack.env.persistReading"/>
        <zeebe:ioMapping>
          <zeebe:input source="=locationH3" target="locationH3"/>
          <zeebe:input source="=lat" target="lat"/>
          <zeebe:input source="=lon" target="lon"/>
          <zeebe:input source="=humidityPct" target="humidityPct"/>
          <zeebe:input source="=tempC" target="tempC"/>
          <zeebe:input source="=pm25Ugm3" target="pm25Ugm3"/>
          <zeebe:input source="=source" target="source"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=readingId" target="readingId"/>
          <zeebe:output source="=vertexId" target="vertexId"/>
          <zeebe:output source="=staticRisk" target="staticRisk"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPersist</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToPersist" sourceRef="Start" targetRef="Task_Persist"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:lifehack.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.lifehack.submitEnvironmentReading&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;readingId&quot;: readingId, &quot;staticRisk&quot;: staticRisk }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Persist" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
