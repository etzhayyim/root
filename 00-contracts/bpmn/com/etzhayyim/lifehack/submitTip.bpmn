<?xml version="1.0" encoding="UTF-8"?>
<!--
  lifehack.etzhayyim.com — submitTip workflow (XRPC com.etzhayyim.apps.lifehack.submitTip).

  Pipeline:
    1. lifehack.tip.validateAuthority   sourceUrl + sourceAuthority sanity
    2. lifehack.tip.gradeEffectiveness  LLM-grade 0-100 effectiveness
    3. lifehack.tip.persist             insert vertex_lifehack_tip
    4. generic.audit.emit               OCEL trail
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_lifehack_submit_tip"
    targetNamespace="https://etzhayyim.ai/bpmn/lifehack"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="lifehack_submit_tip" name="lifehack submit tip" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.lifehack.submitTip", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="submitTip">
      <bpmn:outgoing>Flow_ToValidate</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Validate" name="validate authority">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lifehack.tip.validateAuthority"/>
        <zeebe:ioMapping>
          <zeebe:input source="=topicId" target="topicId"/>
          <zeebe:input source="=bodyJa" target="bodyJa"/>
          <zeebe:input source="=sourceUrl" target="sourceUrl"/>
          <zeebe:input source="=sourceAuthority" target="sourceAuthority"/>
          <zeebe:output source="=valid" target="valid"/>
          <zeebe:output source="=normalizedSourceUrl" target="normalizedSourceUrl"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToValidate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGrade</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToValidate" sourceRef="Start" targetRef="Task_Validate"/>

    <bpmn:serviceTask id="Task_Grade" name="grade effectiveness (LLM)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lifehack.tip.gradeEffectiveness"/>
        <zeebe:ioMapping>
          <zeebe:input source="=topicId" target="topicId"/>
          <zeebe:input source="=bodyJa" target="bodyJa"/>
          <zeebe:input source="=sourceAuthority" target="sourceAuthority"/>
          <zeebe:output source="=effectivenessScore" target="effectivenessScore"/>
          <zeebe:output source="=evidenceSummary" target="evidenceSummary"/>
          <zeebe:output source="=graderModel" target="graderModel"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToGrade</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPersist</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToGrade" sourceRef="Task_Validate" targetRef="Task_Grade"/>

    <bpmn:serviceTask id="Task_Persist" name="persist tip (single)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lifehack.tip.persist"/>
        <zeebe:ioMapping>
          <zeebe:input source="=topicId" target="topicId"/>
          <zeebe:input source="=bodyJa" target="bodyJa"/>
          <zeebe:input source="=bodyEn" target="bodyEn"/>
          <zeebe:input source="=normalizedSourceUrl" target="sourceUrl"/>
          <zeebe:input source="=sourceAuthority" target="sourceAuthority"/>
          <zeebe:input source="=evidenceSummary" target="evidenceSummary"/>
          <zeebe:input source="=effectivenessScore" target="effectivenessScore"/>
          <zeebe:input source="=costJpyMin" target="costJpyMin"/>
          <zeebe:input source="=costJpyMax" target="costJpyMax"/>
          <zeebe:input source="=difficulty" target="difficulty"/>
          <zeebe:input source="=graderModel" target="graderModel"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=tipId" target="tipId"/>
          <zeebe:output source="=vertexId" target="vertexId"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPersist</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:lifehack.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.lifehack.submitTip&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;tipId&quot;: tipId, &quot;effectivenessScore&quot;: effectivenessScore }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Persist" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
