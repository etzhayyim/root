<?xml version="1.0" encoding="UTF-8"?>
<!--
  lifehack.etzhayyim.com — daily dust-prevention bsky post (cron 09:00 JST).

  Pipeline:
    1. lifehack.topic.pickTrending     pick the most engagement-weighted topic
    2. lifehack.tip.pickBest           pick a fresh top-effectiveness tip
                                          (gated by mv_lifehack_recently_posted)
    3. ExclusiveGateway                tipId == null  → audit-skip + EndSkip
    4. lifehack.post.compose           LLM compose Japanese 280-char post
    5. generic.pds.dispatch            app.bsky.feed.post via T2 K8s-internal
    6. lifehack.postLog.persist        insert vertex_lifehack_post_log
    7. generic.audit.emit              OCEL trail

  Cron: 0 0 0 * * ?  (00:00 UTC = 09:00 JST). Manual override: XRPC
  com.etzhayyim.apps.lifehack.dailyDustPost.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_lifehack_daily_dust_post"
    targetNamespace="https://etzhayyim.ai/bpmn/lifehack"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="lifehack_daily_dust_post" name="lifehack daily dust post" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.lifehack.dailyDustPost", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="StartTimer" name="cron 09:00 JST">
      <bpmn:outgoing>Flow_ToPickTopic</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 0 * * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_PickTopic" name="pick trending topic">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lifehack.topic.pickTrending"/>
        <zeebe:ioMapping>
          <zeebe:input source="=topicId" target="topicIdHint"/>
          <zeebe:output source="=topicId" target="topicId"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPickTopic</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPickTip</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToPickTopic" sourceRef="StartTimer" targetRef="Task_PickTopic"/>

    <bpmn:serviceTask id="Task_PickTip" name="pick best tip (dedup gated)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lifehack.tip.pickBest"/>
        <zeebe:ioMapping>
          <zeebe:input source="=topicId" target="topicId"/>
          <zeebe:input source="=tipId" target="tipIdHint"/>
          <zeebe:input source="=2592000000" target="dedupWindowMs"/>
          <zeebe:output source="=tipId" target="tipId"/>
          <zeebe:output source="=bodyJa" target="bodyJa"/>
          <zeebe:output source="=skipped" target="skipped"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPickTip</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToPickTip" sourceRef="Task_PickTopic" targetRef="Task_PickTip"/>

    <bpmn:exclusiveGateway id="Gate_Skip" name="skip?">
      <bpmn:incoming>Flow_ToGate</bpmn:incoming>
      <bpmn:outgoing>Flow_Pass</bpmn:outgoing>
      <bpmn:outgoing>Flow_Skip</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToGate" sourceRef="Task_PickTip" targetRef="Gate_Skip"/>

    <bpmn:sequenceFlow id="Flow_Pass" sourceRef="Gate_Skip" targetRef="Task_Compose">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=skipped = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Skip" sourceRef="Gate_Skip" targetRef="Task_AuditSkip">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=skipped = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_Compose" name="compose post (LLM)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lifehack.post.compose"/>
        <zeebe:ioMapping>
          <zeebe:input source="=tipId" target="tipId"/>
          <zeebe:input source="=topicId" target="topicId"/>
          <zeebe:input source="=bodyJa" target="bodyJa"/>
          <zeebe:input source="=280" target="maxChars"/>
          <zeebe:output source="=postText" target="postText"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Pass</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDispatch</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Dispatch" name="bsky feed post (T2 K8s-internal)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;app.bsky.feed.post&quot;" target="type"/>
          <zeebe:input source="=&quot;did:web:lifehack.etzhayyim.com&quot;" target="did"/>
          <zeebe:input source="=postText" target="text"/>
          <zeebe:output source="=uri" target="bskyUri"/>
          <zeebe:output source="=cid" target="bskyCid"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDispatch</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLog</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToDispatch" sourceRef="Task_Compose" targetRef="Task_Dispatch"/>

    <bpmn:serviceTask id="Task_Log" name="persist post log">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lifehack.postLog.persist"/>
        <zeebe:ioMapping>
          <zeebe:input source="=tipId" target="tipId"/>
          <zeebe:input source="=topicId" target="topicId"/>
          <zeebe:input source="=bskyUri" target="bskyUri"/>
          <zeebe:input source="=bskyCid" target="bskyCid"/>
          <zeebe:output source="=postId" target="postId"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToLog</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToLog" sourceRef="Task_Dispatch" targetRef="Task_Log"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit (post)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:lifehack.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.lifehack.dailyDustPost&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;tipId&quot;: tipId, &quot;topicId&quot;: topicId, &quot;bskyUri&quot;: bskyUri }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Log" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:serviceTask id="Task_AuditSkip" name="audit emit (skipped)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:lifehack.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.lifehack.dailyDustPost.skip&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;topicId&quot;: topicId }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Skip</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndSkip</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEndSkip" sourceRef="Task_AuditSkip" targetRef="EndSkip"/>

    <bpmn:endEvent id="End" name="posted">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndSkip" name="dedup-skipped">
      <bpmn:incoming>Flow_ToEndSkip</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
