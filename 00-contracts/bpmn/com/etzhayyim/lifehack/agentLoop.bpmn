<?xml version="1.0" encoding="UTF-8"?>
<!--
  lifehack.etzhayyim.com — agentLoop (XRPC com.etzhayyim.apps.lifehack.agentLoop).

  Path F unified agent loop entry (ADR 260413). The pyzeebe handler
  lifehack.agent.chat:
    1. fetches active topics + top tips + recent posts
    2. composes a lifehack system prompt
    3. calls kotodama.llm.call_tier(tier, system, user)
    4. returns content / model / latency / row counts
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_lifehack_agent_loop"
    targetNamespace="https://etzhayyim.ai/bpmn/lifehack"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="lifehack_agent_loop" name="lifehack agent loop" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.lifehack.agentLoop", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="agentLoop">
      <bpmn:outgoing>Flow_ToChat</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Chat" name="lifehack agent chat (LLM)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lifehack.agent.chat"/>
        <zeebe:ioMapping>
          <zeebe:input source="=prompt" target="prompt"/>
          <zeebe:input source="=tier" target="tier"/>
          <zeebe:input source="=topicFocus" target="topicFocus"/>
          <zeebe:input source="=maxTokens" target="maxTokens"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=content" target="content"/>
          <zeebe:output source="=model" target="model"/>
          <zeebe:output source="=latencyMs" target="latencyMs"/>
          <zeebe:output source="=topicsUsed" target="topicsUsed"/>
          <zeebe:output source="=tipsUsed" target="tipsUsed"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToChat</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToChat" sourceRef="Start" targetRef="Task_Chat"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:lifehack.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.lifehack.agentLoop&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;model&quot;: model, &quot;latencyMs&quot;: latencyMs, &quot;topicsUsed&quot;: topicsUsed, &quot;tipsUsed&quot;: tipsUsed }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Chat" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
