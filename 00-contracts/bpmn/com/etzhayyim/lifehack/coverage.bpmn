<?xml version="1.0" encoding="UTF-8"?>
<!--
  lifehack.etzhayyim.com — coverage (XRPC com.etzhayyim.apps.lifehack.coverage).

  Read-only single-task snapshot. Used by soak monitors / dashboard.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_lifehack_coverage"
    targetNamespace="https://etzhayyim.ai/bpmn/lifehack"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="lifehack_coverage" name="lifehack coverage" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.lifehack.coverage", "version": 1, "resultTimeoutMs": 15000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="coverage">
      <bpmn:outgoing>Flow_ToSnap</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Snap" name="coverage snapshot">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lifehack.coverage.snapshot"/>
        <zeebe:ioMapping>
          <zeebe:output source="=asOf" target="asOf"/>
          <zeebe:output source="=topicsActive" target="topicsActive"/>
          <zeebe:output source="=tipsActive" target="tipsActive"/>
          <zeebe:output source="=productsActive" target="productsActive"/>
          <zeebe:output source="=postsTotal" target="postsTotal"/>
          <zeebe:output source="=postsLast24h" target="postsLast24h"/>
          <zeebe:output source="=lastPostedAtMs" target="lastPostedAtMs"/>
          <zeebe:output source="=envReadings" target="envReadings"/>
          <zeebe:output source="=staticRiskCells" target="staticRiskCells"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSnap</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToSnap" sourceRef="Start" targetRef="Task_Snap"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Snap" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
