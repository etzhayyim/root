<?xml version="1.0" encoding="UTF-8"?>
<!--
  Timer-start BPMN — seeds IR company registry and queues scrape runs every 6 hours.
  Task handler: irScrape.queueSeeds (kotodama ir_scrape.py)
  NSID: com.etzhayyim.apps.irScrape.queueSeeds
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/ir-scrape-queue-seeds-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_ir_scrape_queue_seeds"
    targetNamespace="https://etzhayyim.ai/bpmn/irScrape"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="ir_scrape_queue_seeds" name="IR Scrape: Queue Seeds" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.irScrape.queueSeeds", "version": 1, "resultTimeoutMs": 120000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start_Timer" name="every 6 hours">
      <bpmn:outgoing>Flow_Timer</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_PT6H">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">R/PT6H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Manual" name="manual / on-demand">
      <bpmn:outgoing>Flow_Manual</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Timer"  sourceRef="Start_Timer"  targetRef="Task_Queue"/>
    <bpmn:sequenceFlow id="Flow_Manual" sourceRef="Start_Manual" targetRef="Task_Queue"/>

    <bpmn:serviceTask id="Task_Queue" name="seed companies + queue runs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="irScrape.queueSeeds" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=if maxSeeds = null then 200 else maxSeeds" target="maxSeeds"/>
          <zeebe:output source="=queued"         target="queued"/>
          <zeebe:output source="=skipped"        target="skipped"/>
          <zeebe:output source="=companiesAdded" target="companiesAdded"/>
          <zeebe:output source="=ok"             target="queueOk"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Timer</bpmn:incoming>
      <bpmn:incoming>Flow_Manual</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Queue" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="emit irScrape.queueSeeds OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.irScrape.queueSeeds.completed&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;queued&quot;: queued, &quot;skipped&quot;: skipped, &quot;companiesAdded&quot;: companiesAdded, &quot;ok&quot;: queueOk }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
