<?xml version="1.0" encoding="UTF-8"?>
<!--
  yabai.listFlags — migration of cmdListFlags.

  Lists recent flag rows with optional filters on flag_type / severity /
  account_did. Filters are skipped when the caller passes `null`.

  Flow:
    Start (input: flagType?, severity?, accountDid?, limit?)
      → generic.db.select (vertex_yabai_flag + extraFilters)
      → End

  Uses the dynamic WHERE primitive extension (kotodama 0.2.27).
  Output shape matches TS handler: `{ flags, total, offset, limit }`.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_yabai_list_flags"
    targetNamespace="https://etzhayyim.ai/bpmn/yabai"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="yabai_list_flags" name="yabai list flags" isExecutable="true">

    <bpmn:startEvent id="Start" name="list flags">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_Select"/>

    <bpmn:serviceTask id="Task_Select" name="select recent flags">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_yabai_flag&quot;" target="table"/>
          <zeebe:input source="=if limit = null then 50 else number(string(limit))" target="limit"/>
          <zeebe:input source="=&quot;created_at DESC&quot;"    target="orderBy"/>
          <zeebe:input source="=[
              { column: &quot;flag_type&quot;,   value: if flagType   = null then null else string(flagType)   },
              { column: &quot;severity&quot;,    value: if severity   = null then null else string(severity)   },
              { column: &quot;account_did&quot;, value: if accountDid = null then null else string(accountDid) }
          ]" target="extraFilters"/>
          <zeebe:output source="=rows"     target="flags"/>
          <zeebe:output source="=rowCount" target="total"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Select" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
