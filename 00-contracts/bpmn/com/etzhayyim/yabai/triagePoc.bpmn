<?xml version="1.0" encoding="UTF-8"?>
<!--
  F3 PoC — yabai triage actor expressed entirely as BPMN + generic
  primitives. Deliberately uses NO yabai-specific Python; this is the
  shape that ~80% of T1/T2 actors are supposed to take going forward.

  Flow:
    Start (input: emailId, fromAddr, subject, ...)
      → generic.db.select  (read sender history from vertex_gmail_email)
      → generic.llm.json   (Devstral classifies "phishing|legit|ambiguous"
                            given the sender history + email metadata)
      → Gateway: data.verdict == "phishing"?
          yes → generic.db.insert (write to vertex_gmail_phishing_alert)
          no  → (skip, no alert row)
      → End

  Variables on the instance:
    in:  emailId, fromAddr, subject, replyTo, spf, dkim, dmarc, bodyUrls
    middle: rows[], data{verdict,score,rationale}, model, latencyMs
    out: inserted (0 or 1), verdict
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_yabai_triage_poc"
    targetNamespace="https://etzhayyim.ai/bpmn/yabai"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="yabai_triage_poc" name="yabai triage (BPMN-only PoC)" isExecutable="true">

    <bpmn:startEvent id="Start" name="email arrived">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_LookupHistory"/>

    <!-- Task 1: read sender's recent email history. -->
    <bpmn:serviceTask id="Task_LookupHistory" name="lookup sender history">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_gmail_email&quot;"        target="table"/>
          <zeebe:input source="=&quot;from_addr = %s&quot;"             target="whereExpr"/>
          <zeebe:input source="=[fromAddr]"                              target="whereParams"/>
          <zeebe:input source="=&quot;from_addr, spf_result, dmarc_result, created_date&quot;" target="columns"/>
          <zeebe:input source="=20"                                      target="limit"/>
          <zeebe:input source="=&quot;created_date DESC&quot;"            target="orderBy"/>
          <zeebe:output source="=rows"     target="historyRows"/>
          <zeebe:output source="=rowCount" target="historyCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_LookupHistory" targetRef="Task_Classify"/>

    <!-- Task 2: ask Devstral for a verdict. The input prompt is built
         inline from the variables; no Python templating required. -->
    <bpmn:serviceTask id="Task_Classify" name="LLM verdict">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.json"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;classifier&quot;" target="tier"/>
          <zeebe:input source="=&quot;You are a phishing triage assistant. Output ONE JSON object: {&apos;score&apos;:0-100,&apos;verdict&apos;:&apos;phishing|legitimate|ambiguous&apos;,&apos;rationale&apos;:string&lt;=200chars}. JSON only.&quot;" target="system"/>
          <zeebe:input source="=&quot;From: &quot; + string(fromAddr) + &quot;\nSubject: &quot; + string(subject) + &quot;\nReply-To: &quot; + string(replyTo) + &quot;\nSPF: &quot; + string(spf) + &quot; / DKIM: &quot; + string(dkim) + &quot; / DMARC: &quot; + string(dmarc) + &quot;\nPrior emails from sender (last 30d): &quot; + string(historyCount)" target="user"/>
          <zeebe:input source="=200" target="maxTokens"/>
          <zeebe:input source="=0.1" target="temperature"/>
          <zeebe:output source="=ok"           target="llmOk"/>
          <zeebe:output source="=data"         target="verdict"/>
          <zeebe:output source="=model"        target="llmModel"/>
          <zeebe:output source="=latencyMs"    target="llmLatencyMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Classify" targetRef="Gate_IsPhish"/>

    <bpmn:exclusiveGateway id="Gate_IsPhish" name="phishing?" default="Flow_NotPhish">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_IsPhish</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotPhish</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_IsPhish" sourceRef="Gate_IsPhish" targetRef="Task_WriteAlert">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verdict.verdict = "phishing"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotPhish" sourceRef="Gate_IsPhish" targetRef="Task_Audit"/>

    <!-- Task 3: write the alert. Generic db.insert builds the column
         list from the values dict. -->
    <bpmn:serviceTask id="Task_WriteAlert" name="write phishing alert">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_gmail_phishing_alert&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:        &quot;at://did:web:yabcom.etzhayyim.ai/com.etzhayyim.apps.yabai.alert/&quot; + string(emailId),
              alert_id:         string(emailId),
              email_id:         string(emailId),
              from_addr:        string(fromAddr),
              subject:          string(subject),
              spf_result:       string(spf),
              dkim_result:      string(dkim),
              dmarc_result:     string(dmarc),
              phishing_score:   verdict.score,
              llm_score:        verdict.score,
              llm_verdict:      verdict.verdict,
              llm_rationale:    verdict.rationale,
              reasons:          &quot;bpmn:yabai_triage_poc&quot;,
              owner_did:        &quot;did:web:yabcom.etzhayyim.ai&quot;,
              sensitivity_ord:  100,
              org_id:           &quot;etzhayyim&quot;,
              user_id:          &quot;system&quot;,
              actor_id:         &quot;sys.bpmn.yabai&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
          <zeebe:output source="=inserted" target="inserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_IsPhish</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_WriteAlert" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="emit yabai triage audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.yabai.triagePoc.completed&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;emailId&quot;: emailId, &quot;fromAddr&quot;: fromAddr, &quot;verdict&quot;: verdict, &quot;inserted&quot;: inserted, &quot;historyCount&quot;: historyCount, &quot;llmModel&quot;: llmModel, &quot;llmLatencyMs&quot;: llmLatencyMs }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NotPhish</bpmn:incoming>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_AuditEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AuditEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_AuditEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
