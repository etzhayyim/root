<?xml version="1.0" encoding="UTF-8"?>
<!--
  yabai.getFlags — migration of cmdGetFlags.

  Lists flag rows for a given entityVid with optional flag_type / severity
  filters. `entityVid` is mandatory; `flagType` / `severity` skip when
  the caller passes `null`.

  Flow:
    Start (input: entityVid, flagType?, severity?, limit?)
      → generic.db.select (entity_vid=? AND extraFilters)
      → End

  Uses dynamic WHERE via `extraFilters` (pymagatama 0.2.27).
  Output shape: `{ flags, total, entityVid, offset, limit }`.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_yabai_get_flags"
    targetNamespace="https://etzhayyim.ai/bpmn/yabai"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="yabai_get_flags" name="yabai get flags" isExecutable="true">

    <bpmn:startEvent id="Start" name="get flags">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_Select"/>

    <bpmn:serviceTask id="Task_Select" name="select flags for entity">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_yabai_flag&quot;"  target="table"/>
          <zeebe:input source="=&quot;entity_vid = %s&quot;"     target="whereExpr"/>
          <zeebe:input source="=[string(entityVid)]"             target="whereParams"/>
          <zeebe:input source="=[
              { column: &quot;flag_type&quot;, value: if flagType = null then null else string(flagType) },
              { column: &quot;severity&quot;,  value: if severity = null then null else string(severity)  }
          ]" target="extraFilters"/>
          <zeebe:input source="=if limit = null then 50 else number(string(limit))" target="limit"/>
          <zeebe:input source="=&quot;created_at DESC&quot;"     target="orderBy"/>
          <zeebe:output source="=rows"     target="flags"/>
          <zeebe:output source="=rowCount" target="total"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Select" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
