<?xml version="1.0" encoding="UTF-8"?>
<!--
  yabai.enrichLegalEntity — GLEIF LEI lookup + legal-entity ingest.

  Replaces: 60-apps/etzhayyim-project-yabai/tools/track-phishing-infra/enrich-legal-entity.mjs
  Legacy script iterated 9 hardcoded TARGETS in one process.
  This BPMN runs once per target — callers drive the fan-out by looping
  over the TARGETS list and POSTing per-entry.

  Pipeline (ADR-0056 generic primitives, no custom task type):
    1. generic.http.fetch   — GLEIF `/api/v1/lei-records` filter=legalName, page[size]=5
    2. bpmn:scriptTask      — FEEL: pick best hit (country hint fallback first, else [1]);
                               derive {lei, rkey, name, country, registration_number,
                               address, jurisdiction, incorporation_date, status}
    3. generic.db.insert    — vertex_legal_entity
    4. generic.db.insert    — vertex_yabai_entity
    5. gateway              — has LEI?
    5a. yes → generic.db.insert edge_yabai_operated_by
    5b. no  → skip
    6. generic.audit.emit   — OCEL yabai.enrich.legalEntity

  NSID derivation (sync-bpmn-actors.py convention):
    path = 00-contracts/bpmn/com/etzhayyim/yabai/enrichLegalEntity.bpmn
    NSID = com.etzhayyim.apps.yabai.enrichLegalEntity
    vid  = at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/yabai-enrich-legal-entity-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_yabai_enrich_legal_entity"
    targetNamespace="https://etzhayyim.ai/bpmn/yabai"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="yabai_enrich_legal_entity" name="yabai enrichLegalEntity" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.yabai.enrichLegalEntity", "version": 1, "resultTimeoutMs": 30000 }
    </bpmn:documentation>

    <!-- Body variables (input):
           yabaiEntityId  string    required  e.g. "asn-135377" / "reg-dynadot"
           search         string    required  org name for GLEIF legalName filter
           kind           string    required  "hosting" | "registrar"
           countryHint    string    optional  ISO-2 country hint for disambiguation
           asn            int       optional  ASN number, only meaningful when kind="hosting"
    -->

    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_ToBuildUrl</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToBuildUrl" sourceRef="Start" targetRef="Task_BuildUrl"/>

    <!-- Step 0: URL-encode `search` (FEEL has no encodeURIComponent; replace the
         characters GLEIF's filter surface cares about). Keeps the happy path
         working for ASCII org names, which is 100% of the current TARGETS list.
         Unicode names need a proper primitive / Python UDF — deferred. -->
    <bpmn:scriptTask id="Task_BuildUrl" name="url-encode search → gleifUrl">
      <bpmn:extensionElements>
        <zeebe:script
            expression='=string join(["https://api.gleif.org/api/v1/lei-records?filter[entity.legalName]=", replace(replace(replace(search, " ", "%20"), "&amp;", "%26"), "\+", "%2B"), "&amp;page[size]=5"], "")'
            resultVariable="gleifUrl"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToBuildUrl</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFetch</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ToFetch" sourceRef="Task_BuildUrl" targetRef="Task_GleifFetch"/>

    <!-- Step 1: GLEIF LEI lookup -->
    <bpmn:serviceTask id="Task_GleifFetch" name="GLEIF LEI search">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.http.fetch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;GET&quot;" target="method"/>
          <zeebe:input source="=gleifUrl" target="url"/>
          <zeebe:input source='={"Accept": "application/vnd.api+json"}' target="headers"/>
          <zeebe:input source="=10" target="timeoutSec"/>
          <zeebe:output source="=status"   target="gleifStatus"/>
          <zeebe:output source="=bodyJson" target="gleifBody"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToFetch</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDerive</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToDerive" sourceRef="Task_GleifFetch" targetRef="Task_Derive"/>

    <!-- Step 2: FEEL-derive best match + row fragments.
         Preference: first record whose legalAddress.country == countryHint, else first record overall.
         All downstream tasks consume `derived.*` — no FEEL re-computation needed.
         Empty-results case: bestHit=null, lei=null, rkey="nolei-${yabaiEntityId}", fall-back names. -->
    <bpmn:scriptTask id="Task_Derive" name="pick best + derive row fragments">
      <bpmn:extensionElements>
        <zeebe:script
            expression="=if gleifBody = null or gleifBody.data = null or count(gleifBody.data) = 0 then { bestHit: null, lei: null, rkey: string join([&quot;nolei-&quot;, yabaiEntityId], &quot;&quot;), name: search, country: countryHint, regNumber: null, jurisdiction: null, address: null, incorpDate: null, entityStatus: null } else (if countryHint != null and count(gleifBody.data[attributes.entity.legalAddress.country = countryHint]) &gt; 0 then { bestHit: gleifBody.data[attributes.entity.legalAddress.country = countryHint][1], lei: gleifBody.data[attributes.entity.legalAddress.country = countryHint][1].id, rkey: lower case(gleifBody.data[attributes.entity.legalAddress.country = countryHint][1].id), name: gleifBody.data[attributes.entity.legalAddress.country = countryHint][1].attributes.entity.legalName.name, country: gleifBody.data[attributes.entity.legalAddress.country = countryHint][1].attributes.entity.legalAddress.country, regNumber: gleifBody.data[attributes.entity.legalAddress.country = countryHint][1].attributes.entity.registeredAs, jurisdiction: gleifBody.data[attributes.entity.legalAddress.country = countryHint][1].attributes.entity.jurisdiction, address: gleifBody.data[attributes.entity.legalAddress.country = countryHint][1].attributes.entity.legalAddress.city, incorpDate: gleifBody.data[attributes.entity.legalAddress.country = countryHint][1].attributes.entity.creationDate, entityStatus: gleifBody.data[attributes.entity.legalAddress.country = countryHint][1].attributes.entity.status } else { bestHit: gleifBody.data[1], lei: gleifBody.data[1].id, rkey: lower case(gleifBody.data[1].id), name: gleifBody.data[1].attributes.entity.legalName.name, country: gleifBody.data[1].attributes.entity.legalAddress.country, regNumber: gleifBody.data[1].attributes.entity.registeredAs, jurisdiction: gleifBody.data[1].attributes.entity.jurisdiction, address: gleifBody.data[1].attributes.entity.legalAddress.city, incorpDate: gleifBody.data[1].attributes.entity.creationDate, entityStatus: gleifBody.data[1].attributes.entity.status })"
            resultVariable="derived"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDerive</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLegal</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ToLegal" sourceRef="Task_Derive" targetRef="Task_InsertLegal"/>

    <!-- Step 3: vertex_legal_entity -->
    <bpmn:serviceTask id="Task_InsertLegal" name="vertex_legal_entity INSERT">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_legal_entity&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:           string join([&quot;at://did:web:legal-entity.etzhayyim.com/com.etzhayyim.apps.legalEntity.legalEntity/&quot;, derived.rkey], &quot;&quot;),
              rkey:                derived.rkey,
              repo:                &quot;did:web:legal-entity.etzhayyim.com&quot;,
              did:                 &quot;did:web:legal-entity.etzhayyim.com&quot;,
              collection:          &quot;com.etzhayyim.apps.legalEntity.legalEntity&quot;,
              name:                derived.name,
              display_name:        derived.name,
              description:         string join([kind, &quot; operator — imported from yabai phishing-infra tracking (BPMN)&quot;], &quot;&quot;),
              entity_type:         &quot;company&quot;,
              registration_number: derived.regNumber,
              jurisdiction:        derived.jurisdiction,
              country:             derived.country,
              address:             derived.address,
              incorporation_date:  derived.incorpDate,
              status:              derived.entityStatus,
              lei:                 derived.lei,
              source:              &quot;gleif+yabai+bpmn&quot;,
              sensitivity_ord:     1,
              owner_did:           &quot;did:web:legal-entity.etzhayyim.com&quot;,
              created_date:        substring(string(now()), 1, 10),
              source_record_id:    string join([&quot;yabai:&quot;, yabaiEntityId], &quot;&quot;)
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
          <zeebe:output source="=inserted" target="legalInserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToLegal</bpmn:incoming>
      <bpmn:outgoing>Flow_ToYabai</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToYabai" sourceRef="Task_InsertLegal" targetRef="Task_InsertYabai"/>

    <!-- Step 4: vertex_yabai_entity (ASN or registrar) -->
    <bpmn:serviceTask id="Task_InsertYabai" name="vertex_yabai_entity INSERT">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_yabai_entity&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:       string join([&quot;at://did:web:yabcom.etzhayyim.ai/com.etzhayyim.apps.yabai.entity/&quot;, yabaiEntityId], &quot;&quot;),
              rkey:            yabaiEntityId,
              repo:            &quot;did:web:yabcom.etzhayyim.ai&quot;,
              entity_id:       yabaiEntityId,
              entity_type:     if kind = &quot;hosting&quot; then &quot;hosting_provider&quot; else &quot;registrar&quot;,
              name:            derived.name,
              value:           if derived.lei != null then derived.lei else search,
              canonical_name:  derived.name,
              source:          &quot;yabai.bpmn.enrich-legal-entity&quot;,
              sensitivity_ord: 100,
              owner_did:       &quot;did:web:yabcom.etzhayyim.ai&quot;,
              created_at:      string(now()),
              org_id:          &quot;did:web:yabcom.etzhayyim.ai&quot;,
              user_id:         &quot;did:web:yabcom.etzhayyim.ai&quot;,
              actor_id:        &quot;sys.bpmn.yabai.enrich&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
          <zeebe:output source="=inserted" target="yabaiInserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToYabai</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToGate" sourceRef="Task_InsertYabai" targetRef="Gate_HasLei"/>

    <!-- Step 5: gateway — edge only meaningful if LEI resolved -->
    <bpmn:exclusiveGateway id="Gate_HasLei" name="LEI resolved?">
      <bpmn:incoming>Flow_ToGate</bpmn:incoming>
      <bpmn:outgoing>Flow_HasLei</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoLei</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_HasLei" sourceRef="Gate_HasLei" targetRef="Task_InsertEdge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=derived.lei != null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoLei" sourceRef="Gate_HasLei" targetRef="Task_Audit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=derived.lei = null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Step 5a: edge_yabai_operated_by -->
    <bpmn:serviceTask id="Task_InsertEdge" name="edge_yabai_operated_by INSERT">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;edge_yabai_operated_by&quot;" target="table"/>
          <zeebe:input source="={
              edge_id:         string join([&quot;edge-operated-by-&quot;, yabaiEntityId, &quot;-&quot;, derived.rkey], &quot;&quot;),
              src_vid:         string join([&quot;at://did:web:yabcom.etzhayyim.ai/com.etzhayyim.apps.yabai.entity/&quot;, yabaiEntityId], &quot;&quot;),
              dst_vid:         string join([&quot;at://did:web:legal-entity.etzhayyim.com/com.etzhayyim.apps.legalEntity.legalEntity/&quot;, derived.rkey], &quot;&quot;),
              sensitivity_ord: 100,
              owner_did:       &quot;did:web:yabcom.etzhayyim.ai&quot;,
              created_at:      string(now()),
              created_date:    substring(string(now()), 1, 10)
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
          <zeebe:output source="=inserted" target="edgeInserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HasLei</bpmn:incoming>
      <bpmn:outgoing>Flow_EdgeToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EdgeToAudit" sourceRef="Task_InsertEdge" targetRef="Task_Audit"/>

    <!-- Step 6: OCEL audit emit -->
    <bpmn:serviceTask id="Task_Audit" name="audit yabai.enrich.legalEntity">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:yabcom.etzhayyim.ai&quot;" target="actor"/>
          <zeebe:input source="=&quot;yabai.enrich.legalEntity&quot;" target="action"/>
          <zeebe:input source="={
              yabaiEntityId: yabaiEntityId,
              search:        search,
              kind:          kind,
              lei:           derived.lei,
              rkey:          derived.rkey,
              gleifStatus:   gleifStatus
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoLei</bpmn:incoming>
      <bpmn:incoming>Flow_EdgeToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
