<?xml version="1.0" encoding="UTF-8"?>
<!--
  yabai.ingestKycEvidence — migration of cmdIngestKYCEvidence.

  TS derives entityId = `did-${did.replace(/[:.]/g, "_")}`. FEEL equivalent:
  `"did-" + replace(string(did), "[.:]", "_")`.

  v1 scope: upsert Person entity + insert KYC evidence row + audit.
  Risk recompute (evaluateAndPersist) is deferred (same as ingestEvidence
  v1). Callers that need updated risk query getRisk afterward.

  Flow:
    Start (did, evidenceType, verificationId?, documentType?,
           issuingCountry?, score?)
      → generic.db.insert (vertex_yabai_entity Person)
      → generic.db.insert (vertex_yabai_evidence KYC*)
      → generic.audit.emit
      → End
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_yabai_ingest_kyc_evidence"
    targetNamespace="https://etzhayyim.ai/bpmn/yabai"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="yabai_ingest_kyc_evidence" name="yabai ingest kyc evidence" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_UpsertPerson"/>

    <bpmn:serviceTask id="Task_UpsertPerson" name="upsert Person entity">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_yabai_entity&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:   &quot;yabai-entity:did-&quot; + replace(string(did), &quot;[.:]&quot;, &quot;_&quot;),
              entity_id:   &quot;did-&quot; + replace(string(did), &quot;[.:]&quot;, &quot;_&quot;),
              entity_type: &quot;Person&quot;,
              name:        string(did),
              value:       string(did),
              source:      &quot;ekyc&quot;,
              created_at:  string(now()),
              org_id:      &quot;anon&quot;, user_id: &quot;anon&quot;, actor_id: &quot;did:web:yabcom.etzhayyim.ai&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
          <zeebe:output source="=inserted" target="entityInserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_UpsertPerson" targetRef="Task_InsertKyc"/>

    <bpmn:serviceTask id="Task_InsertKyc" name="insert KYC evidence">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_yabai_evidence&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:    &quot;yabai-evidence:&quot; + string(did) + &quot;:&quot; + string(evidenceType) + &quot;:&quot; + string(now()),
              evidence_id:  &quot;ev-&quot; + string(now()),
              entity_id:    &quot;did-&quot; + replace(string(did), &quot;[.:]&quot;, &quot;_&quot;),
              category:     string(evidenceType),
              confidence:   if evidenceType = &quot;KYCApproved&quot;
                              then (if score = null then 0.9 else score / 100)
                              else if evidenceType = &quot;KYCRejected&quot; then 0.8
                              else 0.5,
              source:       &quot;ekyc.etzhayyim.com&quot;,
              description:  &quot;KYC &quot; + string(evidenceType),
              created_at:   string(now()),
              org_id:       &quot;anon&quot;, user_id: &quot;anon&quot;, actor_id: &quot;did:web:yabcom.etzhayyim.ai&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
          <zeebe:output source="=inserted" target="evidenceInserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_InsertKyc" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit: ingestKyc">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:yabcom.etzhayyim.ai&quot;" target="actor"/>
          <zeebe:input source="=&quot;ingestKycEvidence&quot;"     target="action"/>
          <zeebe:input source="={ did: string(did), evidenceType: string(evidenceType), entityInserted: entityInserted, evidenceInserted: evidenceInserted }" target="payload"/>
          <zeebe:output source="=emitted" target="auditEmitted"/>
          <zeebe:output source="=rkey"    target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End"><bpmn:incoming>Flow_4</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
