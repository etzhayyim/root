<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_gyosei_purge"
  targetNamespace="https://etzhayyim.ai/bpmn/gyosei"
  exporter="hand-written"
  exporterVersion="1.0">
  <bpmn:process id="gyosei_purge" name="行政手続 purge" isExecutable="true">
    <bpmn:startEvent id="Start_Purge_Timer" name="daily 05:00">
      <bpmn:outgoing>Flow_PT</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 5 * * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_PT" sourceRef="Start_Purge_Timer" targetRef="Task_SelectExpired"/>

    <bpmn:startEvent id="Start_Purge_Manual" name="manual">
      <bpmn:outgoing>Flow_PM</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_PM" sourceRef="Start_Purge_Manual" targetRef="Task_SelectExpired"/>

    <bpmn:serviceTask id="Task_SelectExpired" name="期限切れ抽出">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PT</bpmn:incoming>
      <bpmn:incoming>Flow_PM</bpmn:incoming>
      <bpmn:outgoing>Flow_P2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_P2" sourceRef="Task_SelectExpired" targetRef="Task_DeleteExpired"/>

    <bpmn:serviceTask id="Task_DeleteExpired" name="Tier 3 hard delete">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.delete"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_P2</bpmn:incoming>
      <bpmn:outgoing>Flow_P3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_P3" sourceRef="Task_DeleteExpired" targetRef="Task_PurgeAudit"/>

    <bpmn:serviceTask id="Task_PurgeAudit" name="purge audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:jpn.state.etzhayyim.com:gyosei&quot;" target="actor"/>
          <zeebe:input source="=&quot;gyosei.purge&quot;" target="action"/>
          <zeebe:input source="={
              deleted: deleted
          }" target="payload"/>
          <zeebe:output source="=rkey" target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_P3</bpmn:incoming>
      <bpmn:outgoing>Flow_P4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_P4" sourceRef="Task_PurgeAudit" targetRef="End_Purge"/>

    <bpmn:endEvent id="End_Purge" name="purge 完了">
      <bpmn:incoming>Flow_P4</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
