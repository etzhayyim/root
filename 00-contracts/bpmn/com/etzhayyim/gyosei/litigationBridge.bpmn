<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_gyosei_litigation_bridge"
  targetNamespace="https://etzhayyim.ai/bpmn/gyosei"
  exporter="hand-written"
  exporterVersion="1.0">
  <bpmn:process id="gyosei_litigation_bridge" name="行政事件訴訟 bridge" isExecutable="true">
    <bpmn:startEvent id="Start_Lit" name="行訴検討開始">
      <bpmn:outgoing>Flow_L1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_L1" sourceRef="Start_Lit" targetRef="Task_LitigationForm"/>

    <bpmn:userTask id="Task_LitigationForm" name="訴訟ブリッジ入力">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:gyosei-litigation-form-v1"/>
        <zeebe:assignmentDefinition candidateGroups="legal-officer"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_L1</bpmn:incoming>
      <bpmn:outgoing>Flow_L2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_L2" sourceRef="Task_LitigationForm" targetRef="Task_RouteCatalog"/>

    <bpmn:businessRuleTask id="Task_RouteCatalog" name="個別法 route catalog 判定">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="gyosei_route_catalog" resultVariable="routeCatalog"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_L2</bpmn:incoming>
      <bpmn:outgoing>Flow_L2a</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_L2a" sourceRef="Task_RouteCatalog" targetRef="Task_LitigationRoute"/>

    <bpmn:businessRuleTask id="Task_LitigationRoute" name="行訴 route 判定">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="gyosei_litigation_route" resultVariable="litigationRoute"/>
        <zeebe:ioMapping>
          <zeebe:input source="=if statutoryAppealPrecondition != null then statutoryAppealPrecondition else routeCatalog.appealPrecondition" target="statutoryAppealPrecondition"/>
          <zeebe:input source="=if specialLitigationDeadlineDays != null then specialLitigationDeadlineDays else routeCatalog.litigationDeadlineDays" target="specialLitigationDeadlineDays"/>
          <zeebe:input source="=if requestedClaimType != null then requestedClaimType else routeCatalog.preferredClaimType" target="requestedClaimType"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_L2a</bpmn:incoming>
      <bpmn:outgoing>Flow_L3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_L3" sourceRef="Task_LitigationRoute" targetRef="Task_LitigationReview"/>

    <bpmn:userTask id="Task_LitigationReview" name="訴状準備 review">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:gyosei-review-v1"/>
        <zeebe:assignmentDefinition candidateGroups="lawyer"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_L3</bpmn:incoming>
      <bpmn:outgoing>Flow_L4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_L4" sourceRef="Task_LitigationReview" targetRef="Task_LinkReviewSources"/>

    <bpmn:serviceTask id="Task_LinkReviewSources" name="行訴 review source 参照記録">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gyosei.source.link"/>
        <zeebe:ioMapping>
          <zeebe:input source="=caseId" target="caseId"/>
          <zeebe:input source="=sourceIds" target="sourceIds"/>
          <zeebe:input source="=&quot;review-reference&quot;" target="relation"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_L4</bpmn:incoming>
      <bpmn:outgoing>Flow_L4a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_L4a" sourceRef="Task_LinkReviewSources" targetRef="Gate_StayNeeded"/>

    <bpmn:exclusiveGateway id="Gate_StayNeeded" name="執行停止必要?" default="Flow_StaySkip">
      <bpmn:incoming>Flow_L4a</bpmn:incoming>
      <bpmn:outgoing>Flow_StayDo</bpmn:outgoing>
      <bpmn:outgoing>Flow_StaySkip</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_StayDo" sourceRef="Gate_StayNeeded" targetRef="Task_StayBridge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=needsStayReview = true or wantsStay = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_StaySkip" sourceRef="Gate_StayNeeded" targetRef="Task_LitigationAudit"/>

    <bpmn:serviceTask id="Task_StayBridge" name="執行停止 workflow 接続">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StayDo</bpmn:incoming>
      <bpmn:outgoing>Flow_L5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_L5" sourceRef="Task_StayBridge" targetRef="Task_LitigationAudit"/>

    <bpmn:serviceTask id="Task_LitigationAudit" name="訴訟ルート記録">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StaySkip</bpmn:incoming>
      <bpmn:incoming>Flow_L5</bpmn:incoming>
      <bpmn:outgoing>Flow_L6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_L6" sourceRef="Task_LitigationAudit" targetRef="End_Lit"/>

    <bpmn:endEvent id="End_Lit" name="行訴 bridge 完了">
      <bpmn:incoming>Flow_L6</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
