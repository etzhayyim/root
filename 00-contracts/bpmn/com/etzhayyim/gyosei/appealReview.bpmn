<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_gyosei_appeal_review"
  targetNamespace="https://etzhayyim.ai/bpmn/gyosei"
  exporter="hand-written"
  exporterVersion="1.0">
  <bpmn:process id="gyosei_appeal_review" name="審査請求 review" isExecutable="true">
    <bpmn:startEvent id="Start_Appeal" name="審査請求開始">
      <bpmn:outgoing>Flow_A1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_A1" sourceRef="Start_Appeal" targetRef="Task_AppealForm"/>

    <bpmn:userTask id="Task_AppealForm" name="審査請求提出">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:gyosei-appeal-form-v1"/>
        <zeebe:assignmentDefinition candidateGroups="appellant"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A1</bpmn:incoming>
      <bpmn:outgoing>Flow_A2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="Task_AppealForm" targetRef="Task_RouteCatalog"/>

    <bpmn:businessRuleTask id="Task_RouteCatalog" name="個別法 route catalog 判定">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="gyosei_route_catalog" resultVariable="routeCatalog"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A2</bpmn:incoming>
      <bpmn:outgoing>Flow_A2a</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_A2a" sourceRef="Task_RouteCatalog" targetRef="Task_AppealRoute"/>

    <bpmn:businessRuleTask id="Task_AppealRoute" name="審査請求 route 判定">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="gyosei_appeal_route" resultVariable="appealRoute"/>
        <zeebe:ioMapping>
          <zeebe:input source="=if statutoryAppealAvailability != null then statutoryAppealAvailability else routeCatalog.appealAvailability" target="statutoryAppealAvailability"/>
          <zeebe:input source="=if specialAppealDeadlineDays != null then specialAppealDeadlineDays else routeCatalog.appealDeadlineDays" target="specialAppealDeadlineDays"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A2a</bpmn:incoming>
      <bpmn:outgoing>Flow_A3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_A3" sourceRef="Task_AppealRoute" targetRef="Task_AppealReview"/>

    <bpmn:userTask id="Task_AppealReview" name="審理員 review">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:gyosei-review-v1"/>
        <zeebe:assignmentDefinition candidateGroups="appeal-reviewer"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A3</bpmn:incoming>
      <bpmn:outgoing>Flow_A4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_A4" sourceRef="Task_AppealReview" targetRef="Task_LinkReviewSources"/>

    <bpmn:serviceTask id="Task_LinkReviewSources" name="審査請求 review source 参照記録">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gyosei.source.link"/>
        <zeebe:ioMapping>
          <zeebe:input source="=caseId" target="caseId"/>
          <zeebe:input source="=sourceIds" target="sourceIds"/>
          <zeebe:input source="=&quot;review-reference&quot;" target="relation"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A4</bpmn:incoming>
      <bpmn:outgoing>Flow_A4a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A4a" sourceRef="Task_LinkReviewSources" targetRef="Gate_AppealOutcome"/>

    <bpmn:exclusiveGateway id="Gate_AppealOutcome" name="裁決方向?" default="Flow_Accepted">
      <bpmn:incoming>Flow_A4a</bpmn:incoming>
      <bpmn:outgoing>Flow_Remand</bpmn:outgoing>
      <bpmn:outgoing>Flow_Accepted</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Remand" sourceRef="Gate_AppealOutcome" targetRef="Task_Remand">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision = "remand-or-reconsider"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Accepted" sourceRef="Gate_AppealOutcome" targetRef="Task_AppealFinalize"/>

    <bpmn:serviceTask id="Task_Remand" name="原処分庁へ差戻し">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Remand</bpmn:incoming>
      <bpmn:outgoing>Flow_A5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A5" sourceRef="Task_Remand" targetRef="Task_AppealFinalize"/>

    <bpmn:serviceTask id="Task_AppealFinalize" name="裁決確定">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Accepted</bpmn:incoming>
      <bpmn:incoming>Flow_A5</bpmn:incoming>
      <bpmn:outgoing>Flow_A6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A6" sourceRef="Task_AppealFinalize" targetRef="End_Appeal"/>

    <bpmn:endEvent id="End_Appeal" name="裁決完了">
      <bpmn:incoming>Flow_A6</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
