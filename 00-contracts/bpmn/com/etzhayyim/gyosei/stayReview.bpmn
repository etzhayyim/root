<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_gyosei_stay_review"
  targetNamespace="https://etzhayyim.ai/bpmn/gyosei"
  exporter="hand-written"
  exporterVersion="1.0">
  <bpmn:process id="gyosei_stay_review" name="執行停止 review" isExecutable="true">
    <bpmn:startEvent id="Start_Stay" name="執行停止開始">
      <bpmn:outgoing>Flow_S1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S1" sourceRef="Start_Stay" targetRef="Task_StayForm"/>

    <bpmn:userTask id="Task_StayForm" name="執行停止フォーム入力">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:gyosei-stay-form-v1"/>
        <zeebe:assignmentDefinition candidateGroups="legal-officer"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S1</bpmn:incoming>
      <bpmn:outgoing>Flow_S2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_S2" sourceRef="Task_StayForm" targetRef="Task_StayDecision"/>

    <bpmn:businessRuleTask id="Task_StayDecision" name="緊急性判定">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="gyosei_stay_urgency" resultVariable="stayUrgency"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S2</bpmn:incoming>
      <bpmn:outgoing>Flow_S3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_S3" sourceRef="Task_StayDecision" targetRef="Task_StayReview"/>

    <bpmn:userTask id="Task_StayReview" name="執行停止申立 review">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:gyosei-review-v1"/>
        <zeebe:assignmentDefinition candidateGroups="lawyer"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S3</bpmn:incoming>
      <bpmn:outgoing>Flow_S4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_S4" sourceRef="Task_StayReview" targetRef="Task_LinkReviewSources"/>

    <bpmn:serviceTask id="Task_LinkReviewSources" name="執行停止 review source 参照記録">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gyosei.source.link"/>
        <zeebe:ioMapping>
          <zeebe:input source="=caseId" target="caseId"/>
          <zeebe:input source="=sourceIds" target="sourceIds"/>
          <zeebe:input source="=&quot;review-reference&quot;" target="relation"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S4</bpmn:incoming>
      <bpmn:outgoing>Flow_S4a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_S4a" sourceRef="Task_LinkReviewSources" targetRef="Task_StayAudit"/>

    <bpmn:serviceTask id="Task_StayAudit" name="執行停止記録">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S4a</bpmn:incoming>
      <bpmn:outgoing>Flow_S5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_S5" sourceRef="Task_StayAudit" targetRef="End_Stay"/>

    <bpmn:endEvent id="End_Stay" name="執行停止完了">
      <bpmn:incoming>Flow_S5</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
