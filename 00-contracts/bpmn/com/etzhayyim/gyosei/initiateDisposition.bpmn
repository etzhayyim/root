<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_gyosei_initiate_disposition"
  targetNamespace="https://etzhayyim.ai/bpmn/gyosei"
  exporter="hand-written"
  exporterVersion="1.0">
  <bpmn:process id="gyosei_initiate_disposition" name="行政手続開始・不利益処分前 review" isExecutable="true">
    <bpmn:startEvent id="Start" name="手続開始">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_Intake"/>

    <bpmn:userTask id="Task_Intake" name="intake 入力">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:gyosei-intake-form-v1"/>
        <zeebe:assignmentDefinition candidateGroups="case-worker"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Intake" targetRef="Task_HearingDecision"/>

    <bpmn:businessRuleTask id="Task_HearingDecision" name="聴聞要否判定">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="gyosei_hearing_required" resultVariable="hearingRequired"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_HearingDecision" targetRef="Task_PrecedentDecision"/>

    <bpmn:businessRuleTask id="Task_PrecedentDecision" name="判例処理要否判定">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="gyosei_precedent_handling" resultVariable="precedentRequired"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_PrecedentDecision" targetRef="Gate_PrecedentNeeded"/>

    <bpmn:exclusiveGateway id="Gate_PrecedentNeeded" name="判例メモ必要?" default="Flow_PrecedentSkip">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_PrecedentDo</bpmn:outgoing>
      <bpmn:outgoing>Flow_PrecedentSkip</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_PrecedentDo" sourceRef="Gate_PrecedentNeeded" targetRef="Task_PrecedentMemo">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=precedentRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PrecedentSkip" sourceRef="Gate_PrecedentNeeded" targetRef="Gate_HearingNeeded"/>

    <bpmn:userTask id="Task_PrecedentMemo" name="判例メモ作成">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:gyosei-precedent-memo-v1"/>
        <zeebe:assignmentDefinition candidateGroups="legal-officer"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PrecedentDo</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_PrecedentMemo" targetRef="Task_LinkPrecedentSources"/>

    <bpmn:serviceTask id="Task_LinkPrecedentSources" name="判例メモ source 参照記録">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gyosei.source.link"/>
        <zeebe:ioMapping>
          <zeebe:input source="=caseId" target="caseId"/>
          <zeebe:input source="=sourceIds" target="sourceIds"/>
          <zeebe:input source="=&quot;precedent-memo-reference&quot;" target="relation"/>
          <zeebe:input source="=&quot;memo:&quot; + string(caseId)" target="memoId"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_5a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_5a" sourceRef="Task_LinkPrecedentSources" targetRef="Gate_HearingNeeded"/>

    <bpmn:exclusiveGateway id="Gate_HearingNeeded" name="聴聞必要?" default="Flow_HearingSkip">
      <bpmn:incoming>Flow_PrecedentSkip</bpmn:incoming>
      <bpmn:incoming>Flow_5a</bpmn:incoming>
      <bpmn:outgoing>Flow_HearingDo</bpmn:outgoing>
      <bpmn:outgoing>Flow_HearingSkip</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_HearingDo" sourceRef="Gate_HearingNeeded" targetRef="Task_Hearing">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=hearingRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HearingSkip" sourceRef="Gate_HearingNeeded" targetRef="Task_Review"/>

    <bpmn:userTask id="Task_Hearing" name="聴聞 / 弁明機会付与">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="hearing-officer"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HearingDo</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Hearing" targetRef="Task_Review"/>

    <bpmn:userTask id="Task_Review" name="行政庁 review">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:gyosei-review-v1"/>
        <zeebe:assignmentDefinition candidateGroups="review-officer"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HearingSkip</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Review" targetRef="Task_LinkReviewSources"/>

    <bpmn:serviceTask id="Task_LinkReviewSources" name="review source 参照記録">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gyosei.source.link"/>
        <zeebe:ioMapping>
          <zeebe:input source="=caseId" target="caseId"/>
          <zeebe:input source="=sourceIds" target="sourceIds"/>
          <zeebe:input source="=&quot;review-reference&quot;" target="relation"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_7a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_7a" sourceRef="Task_LinkReviewSources" targetRef="Task_Finalize"/>

    <bpmn:serviceTask id="Task_Finalize" name="処分確定">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_7a</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Finalize" targetRef="End"/>

    <bpmn:endEvent id="End" name="完了">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
