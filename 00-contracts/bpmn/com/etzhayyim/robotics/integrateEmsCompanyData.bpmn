<?xml version="1.0" encoding="UTF-8"?>
<!--
  EMS company data acquisition and supplier-shortlist integration.

  Inputs:
    requestId
    query
    regions
    capabilities
    certifications
    rfq

  Outputs:
    roboticsEmsCompanySearch
    roboticsEmsCompanyProfiles
    roboticsEmsSupplierShortlist
    finalStatus
    auditRkey
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_robotics_integrate_ems_company_data"
    targetNamespace="https://etzhayyim.ai/bpmn/robotics"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="robotics_integrate_ems_company_data" name="Robotics EMS company data integration" isExecutable="true">
    <bpmn:startEvent id="Start" name="EMS search requested">
      <bpmn:outgoing>Flow_Start_Search</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_Search" sourceRef="Start" targetRef="Task_SearchCompanies"/>

    <bpmn:serviceTask id="Task_SearchCompanies" name="Search EMS companies">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="robotics.ems.company.search"/>
        <zeebe:ioMapping>
          <zeebe:input source="=query" target="query"/>
          <zeebe:input source="=regions" target="regions"/>
          <zeebe:input source="=capabilities" target="capabilities"/>
          <zeebe:input source="=certifications" target="certifications"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Search</bpmn:incoming>
      <bpmn:outgoing>Flow_Search_Profile</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Search_Profile" sourceRef="Task_SearchCompanies" targetRef="Task_ProfileCompanies"/>

    <bpmn:serviceTask id="Task_ProfileCompanies" name="Normalize EMS company profiles">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="robotics.ems.company.profile"/>
        <zeebe:ioMapping>
          <zeebe:input source="=roboticsEmsCompanySearch.candidates" target="companies"/>
          <zeebe:input source="=&quot;operator-provided-or-public-search&quot;" target="source"/>
          <zeebe:input source="=asOfDate" target="asOfDate"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Search_Profile</bpmn:incoming>
      <bpmn:outgoing>Flow_Profile_Shortlist</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Profile_Shortlist" sourceRef="Task_ProfileCompanies" targetRef="Task_Shortlist"/>

    <bpmn:serviceTask id="Task_Shortlist" name="Shortlist suppliers for RFQ">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="robotics.ems.supplier.shortlist"/>
        <zeebe:ioMapping>
          <zeebe:input source="=requestId" target="requestId"/>
          <zeebe:input source="=rfq" target="rfq"/>
          <zeebe:input source="=roboticsEmsCompanyProfiles.companyProfiles" target="companyProfiles"/>
          <zeebe:input source="=capabilities" target="requiredCapabilities"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Profile_Shortlist</bpmn:incoming>
      <bpmn:outgoing>Flow_Shortlist_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Shortlist_Audit" sourceRef="Task_Shortlist" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="Emit EMS supplier shortlist audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:robotics.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;robotics.ems.supplier.shortlisted&quot;" target="action"/>
          <zeebe:input source="={ requestId: requestId, search: roboticsEmsCompanySearch, profiles: roboticsEmsCompanyProfiles, shortlist: roboticsEmsSupplierShortlist }" target="payload"/>
          <zeebe:output source="=&quot;shortlisted&quot;" target="finalStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Shortlist_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="EMS company data integrated">
      <bpmn:incoming>Flow_Audit_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
