<?xml version="1.0" encoding="UTF-8"?>
<!--
  Robotics business process design across sales, engineering, manufacturing,
  quality, warehouse, transport, service, and finance.

  Inputs:
    requestId
    processes
    customerId
    itemOrService
    quantity

  Outputs:
    roboticsWorkflowPlan
    roboticsKamiScene
    auditRkey
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_robotics_business_process"
    targetNamespace="https://etzhayyim.ai/bpmn/robotics"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="robotics_business_process_plan" name="Robotics business process plan" isExecutable="true">
    <bpmn:startEvent id="Start" name="Process design request">
      <bpmn:outgoing>Flow_Start_Dependencies</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_Dependencies" sourceRef="Start" targetRef="Task_ProcessDependencies"/>

    <bpmn:serviceTask id="Task_ProcessDependencies" name="Resolve process dependencies">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="robotics.process.dependencies"/>
        <zeebe:ioMapping>
          <zeebe:input source="=processes" target="processes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Dependencies</bpmn:incoming>
      <bpmn:outgoing>Flow_Dependencies_Workflow</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Dependencies_Workflow" sourceRef="Task_ProcessDependencies" targetRef="Task_WorkflowPlan"/>

    <bpmn:serviceTask id="Task_WorkflowPlan" name="Plan robotics workflow">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="robotics.workflow.plan"/>
        <zeebe:ioMapping>
          <zeebe:input source="=requestId" target="requestId"/>
          <zeebe:input source="=processes" target="processes"/>
          <zeebe:input source="=customerId" target="customerId"/>
          <zeebe:input source="=itemOrService" target="itemOrService"/>
          <zeebe:input source="=quantity" target="quantity"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Dependencies_Workflow</bpmn:incoming>
      <bpmn:outgoing>Flow_Workflow_Kami</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Workflow_Kami" sourceRef="Task_WorkflowPlan" targetRef="Task_KamiScene"/>

    <bpmn:serviceTask id="Task_KamiScene" name="Plan KAMI review scene">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="robotics.kami.scene.plan"/>
        <zeebe:ioMapping>
          <zeebe:input source="=requestId" target="requestId"/>
          <zeebe:input source="=cellId" target="cellId"/>
          <zeebe:input source="=assetKind" target="assetKind"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Workflow_Kami</bpmn:incoming>
      <bpmn:outgoing>Flow_Kami_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Kami_Audit" sourceRef="Task_KamiScene" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="Emit robotics process audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:robotics.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;robotics.process.planned&quot;" target="action"/>
          <zeebe:input source="={ requestId: requestId, workflow: roboticsWorkflowPlan, kamiScene: roboticsKamiScene }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Kami_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="Process plan completed">
      <bpmn:incoming>Flow_Audit_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
