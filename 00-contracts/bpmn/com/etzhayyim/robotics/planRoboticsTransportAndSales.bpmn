<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sales-to-transport planning for robot-enabled manufacturing fulfillment.

  Inputs:
    requestId
    customerId
    itemOrService
    quantity
    origin
    destination
    assetKind

  Outputs:
    roboticsSalesPlan
    roboticsTransportPlan
    auditRkey
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_robotics_transport_sales"
    targetNamespace="https://etzhayyim.ai/bpmn/robotics"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="robotics_transport_sales_plan" name="Robotics transport and sales plan" isExecutable="true">
    <bpmn:startEvent id="Start" name="Fulfillment plan requested">
      <bpmn:outgoing>Flow_Start_Sales</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_Sales" sourceRef="Start" targetRef="Task_SalesPlan"/>

    <bpmn:serviceTask id="Task_SalesPlan" name="Plan sales fulfillment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="robotics.sales.plan"/>
        <zeebe:ioMapping>
          <zeebe:input source="=customerId" target="customerId"/>
          <zeebe:input source="=itemOrService" target="itemOrService"/>
          <zeebe:input source="=quantity" target="quantity"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Sales</bpmn:incoming>
      <bpmn:outgoing>Flow_Sales_Transport</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Sales_Transport" sourceRef="Task_SalesPlan" targetRef="Task_TransportPlan"/>

    <bpmn:serviceTask id="Task_TransportPlan" name="Plan transport and transfer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="robotics.transport.plan"/>
        <zeebe:ioMapping>
          <zeebe:input source="=assetKind" target="assetKind"/>
          <zeebe:input source="=origin" target="origin"/>
          <zeebe:input source="=destination" target="destination"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Sales_Transport</bpmn:incoming>
      <bpmn:outgoing>Flow_Transport_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Transport_Audit" sourceRef="Task_TransportPlan" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="Emit fulfillment audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:robotics.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;robotics.fulfillment.planned&quot;" target="action"/>
          <zeebe:input source="={ requestId: requestId, sales: roboticsSalesPlan, transport: roboticsTransportPlan }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Transport_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="Fulfillment plan completed">
      <bpmn:incoming>Flow_Audit_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
