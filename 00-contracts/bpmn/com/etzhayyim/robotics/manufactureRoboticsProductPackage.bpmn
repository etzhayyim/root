<?xml version="1.0" encoding="UTF-8"?>
<!--
  Robotics product manufacturing package orchestration.

  Inputs:
    requestId
    packageId
    assetKind
    packageManifest
    quantity
    targetUnitCost
    incoterms
    supplierRegion

  Outputs:
    roboticsProductPackageValidation
    roboticsProductFileCatalog
    roboticsManufacturingProcessPlan
    roboticsRfqExport
    finalStatus
    auditRkey
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_robotics_manufacture_product_package"
    targetNamespace="https://etzhayyim.ai/bpmn/robotics"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="robotics_manufacture_product_package" name="Robotics product manufacturing package" isExecutable="true">
    <bpmn:startEvent id="Start" name="Manufacturing package received">
      <bpmn:outgoing>Flow_Start_Validate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_Validate" sourceRef="Start" targetRef="Task_ValidatePackage"/>

    <bpmn:serviceTask id="Task_ValidatePackage" name="Validate product package">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="robotics.product.package.validate"/>
        <zeebe:ioMapping>
          <zeebe:input source="=requestId" target="requestId"/>
          <zeebe:input source="=packageId" target="packageId"/>
          <zeebe:input source="=assetKind" target="assetKind"/>
          <zeebe:input source="=packageManifest" target="packageManifest"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Catalog</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Validate_Catalog" sourceRef="Task_ValidatePackage" targetRef="Task_FileCatalog"/>

    <bpmn:serviceTask id="Task_FileCatalog" name="Build manufacturing file catalog">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="robotics.product.file.catalog"/>
        <zeebe:ioMapping>
          <zeebe:input source="=packageId" target="packageId"/>
          <zeebe:input source="=packageManifest" target="packageManifest"/>
          <zeebe:input source="=roboticsProductPackageValidation" target="packageValidation"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Validate_Catalog</bpmn:incoming>
      <bpmn:outgoing>Flow_Catalog_ProcessPlan</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Catalog_ProcessPlan" sourceRef="Task_FileCatalog" targetRef="Task_ProcessPlan"/>

    <bpmn:serviceTask id="Task_ProcessPlan" name="Plan manufacturing processes">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="robotics.product.process.plan"/>
        <zeebe:ioMapping>
          <zeebe:input source="=requestId" target="requestId"/>
          <zeebe:input source="=packageId" target="packageId"/>
          <zeebe:input source="=assetKind" target="assetKind"/>
          <zeebe:input source="=roboticsProductFileCatalog" target="fileCatalog"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Catalog_ProcessPlan</bpmn:incoming>
      <bpmn:outgoing>Flow_ProcessPlan_Rfq</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ProcessPlan_Rfq" sourceRef="Task_ProcessPlan" targetRef="Task_RfqExport"/>

    <bpmn:serviceTask id="Task_RfqExport" name="Export EMS / Alibaba RFQ package">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="robotics.product.rfq.export"/>
        <zeebe:ioMapping>
          <zeebe:input source="=requestId" target="requestId"/>
          <zeebe:input source="=packageId" target="packageId"/>
          <zeebe:input source="=quantity" target="quantity"/>
          <zeebe:input source="=targetUnitCost" target="targetUnitCost"/>
          <zeebe:input source="=incoterms" target="incoterms"/>
          <zeebe:input source="=supplierRegion" target="supplierRegion"/>
          <zeebe:input source="=roboticsProductFileCatalog" target="fileCatalog"/>
          <zeebe:input source="=roboticsManufacturingProcessPlan" target="processPlan"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ProcessPlan_Rfq</bpmn:incoming>
      <bpmn:outgoing>Flow_Rfq_Review</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Rfq_Review" sourceRef="Task_RfqExport" targetRef="Task_RfqReview"/>

    <bpmn:userTask id="Task_RfqReview" name="Review supplier RFQ package">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:robotics-product-rfq-review-v1"/>
        <zeebe:assignmentDefinition candidateGroups="robotics-supply-chain"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Rfq_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Gate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Review_Gate" sourceRef="Task_RfqReview" targetRef="Gate_RfqApproved"/>

    <bpmn:exclusiveGateway id="Gate_RfqApproved" name="RFQ ready?" default="Flow_RfqHold">
      <bpmn:incoming>Flow_Review_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_RfqReady</bpmn:outgoing>
      <bpmn:outgoing>Flow_RfqHold</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_RfqReady" sourceRef="Gate_RfqApproved" targetRef="Task_AuditReady">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rfqReview.decision = "ready"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RfqHold" sourceRef="Gate_RfqApproved" targetRef="Task_AuditHold"/>

    <bpmn:serviceTask id="Task_AuditReady" name="Emit RFQ-ready audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:robotics.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;robotics.product.rfq.ready&quot;" target="action"/>
          <zeebe:input source="={ requestId: requestId, packageId: packageId, validation: roboticsProductPackageValidation, fileCatalog: roboticsProductFileCatalog, processPlan: roboticsManufacturingProcessPlan, rfq: roboticsRfqExport }" target="payload"/>
          <zeebe:output source="=&quot;ready&quot;" target="finalStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RfqReady</bpmn:incoming>
      <bpmn:outgoing>Flow_Ready_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Ready_End" sourceRef="Task_AuditReady" targetRef="End"/>

    <bpmn:serviceTask id="Task_AuditHold" name="Emit RFQ-hold audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:robotics.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;robotics.product.rfq.hold&quot;" target="action"/>
          <zeebe:input source="={ requestId: requestId, packageId: packageId, validation: roboticsProductPackageValidation, rfq: roboticsRfqExport, review: rfqReview }" target="payload"/>
          <zeebe:output source="=&quot;hold&quot;" target="finalStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RfqHold</bpmn:incoming>
      <bpmn:outgoing>Flow_Hold_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Hold_End" sourceRef="Task_AuditHold" targetRef="End"/>

    <bpmn:endEvent id="End" name="Manufacturing package planned">
      <bpmn:incoming>Flow_Ready_End</bpmn:incoming>
      <bpmn:incoming>Flow_Hold_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
