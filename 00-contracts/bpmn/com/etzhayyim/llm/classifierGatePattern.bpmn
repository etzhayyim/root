<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_llm_classifier_gate_pattern"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="2.0">

  <!--
    LLM Classifier Gate Pattern
    Process: llm_classifier_gate_pattern

    Task flow:
      Start → LLM classify (generic.llm.json) → DMN gate (llm_classifier_gate) → audit emit → End

    The DMN table (llm_classifier_gate) accepts:
      llmOk (bool), llmLabel (string), llmConfidence (number),
      minConfidence (number), llmRationaleHash (string)
    and outputs:
      gateAction (allow/deny/manual-review), allow (bool),
      requiresManualReview (bool), reason (string)

    retries="0" on classify: generic.llm.json failures should fail-fast
    (retry logic belongs in the calling BPMN, not here).
  -->

  <bpmn:process id="llm_classifier_gate_pattern" name="LLM Classifier Gate Pattern" isExecutable="true">

    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_Start_Classify</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- LLM classification — generic.llm.json returns ok/label/confidence/rationaleHash -->
    <bpmn:serviceTask id="Task_Classify" name="Classify with LLM">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.json" retries="0"/>
        <zeebe:ioMapping>
          <zeebe:output source="=ok"             target="llmOk"/>
          <zeebe:output source="=label"          target="llmLabel"/>
          <zeebe:output source="=confidence"     target="llmConfidence"/>
          <zeebe:output source="=rationaleHash"  target="llmRationaleHash"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Classify</bpmn:incoming>
      <bpmn:outgoing>Flow_Classify_Gate</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- DMN gate — llm_classifier_gate decision table -->
    <bpmn:businessRuleTask id="Task_Gate" name="Gate LLM Classification">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="llm_classifier_gate" resultVariable="gateResult"/>
        <zeebe:ioMapping>
          <zeebe:input source="=llmOk"             target="llmOk"/>
          <zeebe:input source="=llmLabel"          target="llmLabel"/>
          <zeebe:input source="=llmConfidence"     target="llmConfidence"/>
          <zeebe:input source="=minConfidence"     target="minConfidence"/>
          <zeebe:input source="=llmRationaleHash"  target="llmRationaleHash"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Classify_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Gate_Audit</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <!-- Audit emit — OCEL event for every gate decision -->
    <bpmn:serviceTask id="Task_Audit" name="Emit classifier gate audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit" retries="0"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.llm.classifierGatePattern&quot;" target="eventType"/>
          <zeebe:input source="={ processId: &quot;llm_classifier_gate_pattern&quot;, decisionId: &quot;llm_classifier_gate&quot;, gateAction: gateResult.gateAction, allow: gateResult.allow }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gate_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_1" name="Done">
      <bpmn:incoming>Flow_Audit_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_Start_Classify"  sourceRef="StartEvent_1" targetRef="Task_Classify"/>
    <bpmn:sequenceFlow id="Flow_Classify_Gate"   sourceRef="Task_Classify" targetRef="Task_Gate"/>
    <bpmn:sequenceFlow id="Flow_Gate_Audit"      sourceRef="Task_Gate"     targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_Audit_End"       sourceRef="Task_Audit"    targetRef="EndEvent_1"/>

  </bpmn:process>
</bpmn:definitions>
