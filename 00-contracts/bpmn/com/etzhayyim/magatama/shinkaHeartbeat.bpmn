<?xml version="1.0" encoding="UTF-8"?>
<!--
  ADR-0049 Phase Z-α — BPMN migration of pymagatama.shinka LangGraph.

  Instead of a 7-node StateGraph running in-process in the UDF pod, the
  heartbeat tick becomes a Zeebe process instance per actor, correlated
  by `actorDid`. The four service tasks below cover the critical path;
  kyumei/koji/analyze branches remain in-handler for now (collapsed into
  loadAndResolve's "actions" variable) and graduate to their own nodes
  when we add approval gates.

  Variables on the instance:
    in  : actorDid (string, required)
    out : mood, axes, cadence flags, draft (if composed), heartbeatKey

  Trigger shape:
    1. Manually (pyzeebe.run_process) during migration / smoke.
    2. Later: timer start event `*/15m per actor` — replaces the current
       k8s CronJob. Not in this BPMN yet; adding timer requires per-actor
       message correlation which we'll layout in Phase Z-β.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_magatama_shinka_heartbeat"
    targetNamespace="https://etzhayyim.ai/bpmn/magatama"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="magatama_shinka_heartbeat"
                name="magatama shinka heartbeat"
                isExecutable="true">

    <bpmn:startEvent id="Start" name="tick">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_LoadAndResolve"/>

    <!-- Task 1: merge load_state + resolve_cadence. Output exposes flags so
         downstream XOR can branch without a separate task. -->
    <bpmn:serviceTask id="Task_LoadAndResolve" name="load state + resolve cadence">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="magatama.shinka.loadAndResolve"/>
        <zeebe:ioMapping>
          <zeebe:input source="=actorDid" target="actorDid"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_LoadAndResolve" targetRef="Gate_ShouldPost"/>

    <!-- XOR gateway: compose_content only when cadence.should_post is true.
         "default" fall-through goes straight to writeHeartbeat so every
         tick still produces a heartbeat row even on quiet actors. -->
    <bpmn:exclusiveGateway id="Gate_ShouldPost" name="shouldPost?" default="Flow_SkipCompose">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Compose</bpmn:outgoing>
      <bpmn:outgoing>Flow_SkipCompose</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Compose" sourceRef="Gate_ShouldPost" targetRef="Task_Compose">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=shouldPost = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SkipCompose" sourceRef="Gate_ShouldPost" targetRef="Task_WriteHeartbeat"/>

    <!-- Task 2: compose draft via llm.call_tier_json. Output merged into
         instance variables as `draft`. -->
    <bpmn:serviceTask id="Task_Compose" name="compose content">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="magatama.shinka.compose"/>
        <zeebe:ioMapping>
          <zeebe:input source="=actorDid" target="actorDid"/>
          <zeebe:input source="=mood" target="mood"/>
          <zeebe:input source="=axes" target="axes"/>
          <zeebe:input source="=actions" target="actions"/>
          <zeebe:input source="=followerDeltaCount" target="followerDeltaCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Compose</bpmn:incoming>
      <bpmn:outgoing>Flow_Composed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Composed" sourceRef="Task_Compose" targetRef="Task_WriteHeartbeat"/>

    <!-- Task 3: writeHeartbeat is always-run. Mirrors
         pymagatama.shinka._write_heartbeat. -->
    <bpmn:serviceTask id="Task_WriteHeartbeat" name="write heartbeat">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="magatama.shinka.writeHeartbeat"/>
        <zeebe:ioMapping>
          <zeebe:input source="=actorDid" target="actorDid"/>
          <zeebe:input source="=mood" target="mood"/>
          <zeebe:input source="=actions" target="actions"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SkipCompose</bpmn:incoming>
      <bpmn:incoming>Flow_Composed</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_WriteHeartbeat" targetRef="Task_EmitEvolution"/>

    <!-- Task 4: emitEvolution writes the audit row including the
         composed draft if present. -->
    <bpmn:serviceTask id="Task_EmitEvolution" name="emit evolution">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="magatama.shinka.emitEvolution"/>
        <zeebe:ioMapping>
          <zeebe:input source="=actorDid" target="actorDid"/>
          <zeebe:input source="=mood" target="mood"/>
          <zeebe:input source="=axes" target="axes"/>
          <zeebe:input source="=actions" target="actions"/>
          <zeebe:input source="=followerDeltaCount" target="followerDeltaCount"/>
          <zeebe:input source="=draft" target="draft"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_EmitEvolution" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="emit shinka heartbeat audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.magatama.shinkaHeartbeat.completed&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;actorDid&quot;: actorDid, &quot;mood&quot;: mood, &quot;axes&quot;: axes, &quot;followerDeltaCount&quot;: followerDeltaCount, &quot;hasDraft&quot;: draft != null }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
