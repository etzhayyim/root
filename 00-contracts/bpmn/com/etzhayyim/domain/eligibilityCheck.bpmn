<?xml version="1.0" encoding="UTF-8"?>
<!--
  domain.etzhayyim.com eligibilityCheck (XRPC com.etzhayyim.apps.domain.eligibilityCheck).

  Resolves (tld, jurisdiction, actorKind) against vertex_domain_eligibility_advice
  and returns the matched advice row. Audit emit captures the lookup.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_domain_eligibility_check"
    targetNamespace="https://etzhayyim.ai/bpmn/domain"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="domain_eligibility_check" name="domain eligibility check" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.domain.eligibilityCheck", "version": 1, "resultTimeoutMs": 30000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="eligibilityCheck">
      <bpmn:outgoing>Flow_ToCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Check" name="resolve eligibility advice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="domain.eligibility.check"/>
        <zeebe:ioMapping>
          <zeebe:input source="=tld" target="tld"/>
          <zeebe:input source="=jurisdiction" target="jurisdiction"/>
          <zeebe:input source="=actorKind" target="actorKind"/>
          <zeebe:input source="=regulatorSlug" target="regulatorSlug"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=eligible" target="eligible"/>
          <zeebe:output source="=matchedAdviceSlug" target="matchedAdviceSlug"/>
          <zeebe:output source="=basis" target="basis"/>
          <zeebe:output source="=policyExcerpt" target="policyExcerpt"/>
          <zeebe:output source="=verificationRequired" target="verificationRequired"/>
          <zeebe:output source="=regulatorName" target="regulatorName"/>
          <zeebe:output source="=sourceUrl" target="sourceUrl"/>
          <zeebe:output source="=alternatives" target="alternatives"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToCheck" sourceRef="Start" targetRef="Task_Check"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:domain.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.domain.eligibilityCheck&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;tld&quot;: tld, &quot;jurisdiction&quot;: jurisdiction, &quot;actorKind&quot;: actorKind, &quot;eligible&quot;: eligible }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Check" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
