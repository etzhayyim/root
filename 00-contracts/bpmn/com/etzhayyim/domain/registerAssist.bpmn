<?xml version="1.0" encoding="UTF-8"?>
<!--
  domain.etzhayyim.com registerAssist (XRPC com.etzhayyim.apps.domain.registerAssist).

  Single-task BPMN: domain.register.assist runs eligibility check + registrar
  recommendation + draft ledger INSERT in one primitive (the ledger write
  needs the eligibility verdict atomically). Audit step records the outcome.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_domain_register_assist"
    targetNamespace="https://etzhayyim.ai/bpmn/domain"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="domain_register_assist" name="domain register assist" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.domain.registerAssist", "version": 1, "resultTimeoutMs": 30000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="registerAssist">
      <bpmn:outgoing>Flow_ToAssist</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Assist" name="evaluate + draft registration">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="domain.register.assist"/>
        <zeebe:ioMapping>
          <zeebe:input source="=domainName" target="domainName"/>
          <zeebe:input source="=tld" target="tld"/>
          <zeebe:input source="=registrantDid" target="registrantDid"/>
          <zeebe:input source="=registrantName" target="registrantName"/>
          <zeebe:input source="=actorKind" target="actorKind"/>
          <zeebe:input source="=jurisdiction" target="jurisdiction"/>
          <zeebe:input source="=regulatorSlug" target="regulatorSlug"/>
          <zeebe:input source="=preferredRegistrar" target="preferredRegistrar"/>
          <zeebe:input source="=nsProvider" target="nsProvider"/>
          <zeebe:input source="=evidenceUrl" target="evidenceUrl"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=eligible" target="eligible"/>
          <zeebe:output source="=registrationVid" target="registrationVid"/>
          <zeebe:output source="=registrarRecommendation" target="registrarRecommendation"/>
          <zeebe:output source="=verificationRequired" target="verificationRequired"/>
          <zeebe:output source="=verificationNotes" target="verificationNotes"/>
          <zeebe:output source="=alternativesIfBlocked" target="alternativesIfBlocked"/>
          <zeebe:output source="=policyExcerpt" target="policyExcerpt"/>
          <zeebe:output source="=sourceUrl" target="sourceUrl"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAssist</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAssist" sourceRef="Start" targetRef="Task_Assist"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:domain.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.domain.registerAssist&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;domainName&quot;: domainName, &quot;tld&quot;: tld, &quot;registrantDid&quot;: registrantDid, &quot;eligible&quot;: eligible, &quot;registrationVid&quot;: registrationVid }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Assist" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
