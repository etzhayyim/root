<?xml version="1.0" encoding="UTF-8"?>
<!--
  domain.etzhayyim.com refreshTldCatalog (timer-start, autonomous).

  Phase 1: stub primitive (no-op). Phase 2 will fetch each TLD's
  eligibility policy URL, diff against the stored excerpt, and bump
  effective_at on vertex_domain_eligibility_advice when the policy changes.

  cron 0 0 0 7 * ?  (monthly day 7 — staggered from shosha/isbn).
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_domain_refresh_tld_catalog"
    targetNamespace="https://etzhayyim.ai/bpmn/domain"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="domain_refresh_tld_catalog" name="domain refresh TLD catalog" isExecutable="true">

    <bpmn:documentation>
      { "version": 1 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="cron 07:00 UTC monthly day 7">
      <bpmn:outgoing>Flow_ToRefresh</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_MonthlyDay7">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 0 7 * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Refresh" name="refresh TLD policy excerpts">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="domain.tld.catalog.refresh"/>
        <zeebe:ioMapping>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=tldsChecked" target="tldsChecked"/>
          <zeebe:output source="=tldsUpdated" target="tldsUpdated"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRefresh</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToRefresh" sourceRef="Start" targetRef="Task_Refresh"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:domain.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.domain.refreshTldCatalog&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;tldsChecked&quot;: tldsChecked, &quot;tldsUpdated&quot;: tldsUpdated }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Refresh" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
