<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_telecom_instantiate_vnf" targetNamespace="https://etzhayyim.ai/bpmn/telecom" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="telecom_instantiate_vnf" name="instantiateVnf" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Instantiate"/>
    <bpmn:serviceTask id="Task_Instantiate" name="instantiate vnf">
      <bpmn:extensionElements><zeebe:taskDefinition type="telecom.nfv.vnf.instantiate"/>
        <zeebe:ioMapping>
          <zeebe:input source="={vnfId: vnfId, nsId: nsId, vnfdId: vnfdId, vnfmNfId: vnfmNfId, vimId: vimId, deploymentFlavor: deploymentFlavor, requestedVcpus: requestedVcpus, requestedMemoryGib: requestedMemoryGib, mappedNfInstanceId: mappedNfInstanceId, observedAt: observedAt, callerDid: callerDid}" target="payload"/>
          <zeebe:output source="=vertexId" target="vertexId"/><zeebe:output source="=vnfId" target="vnfId"/><zeebe:output source="=status" target="status"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Instantiate" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:telecom.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;telecom.nfv.vnf.instantiate&quot;" target="action"/><zeebe:input source="={vertexId: vertexId, vnfId: vnfId, status: status}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
