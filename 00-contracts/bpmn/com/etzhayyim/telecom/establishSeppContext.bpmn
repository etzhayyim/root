<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_telecom_establish_sepp_context" targetNamespace="https://etzhayyim.ai/bpmn/telecom" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="telecom_establish_sepp_context" name="establishSeppContext" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Establish"/>
    <bpmn:serviceTask id="Task_Establish" name="establish sepp context">
      <bpmn:extensionElements><zeebe:taskDefinition type="telecom.sepp.context"/>
        <zeebe:ioMapping>
          <zeebe:input source="={contextId: contextId, localSeppNfId: localSeppNfId, remoteSeppFqdn: remoteSeppFqdn, localPlmnId: localPlmnId, remotePlmnId: remotePlmnId, agreementId: agreementId, n32CipherSuite: n32CipherSuite, telescopicFqdnEnabled: telescopicFqdnEnabled, certificateRef: certificateRef, validUntil: validUntil, observedAt: observedAt, callerDid: callerDid}" target="payload"/>
          <zeebe:output source="=vertexId" target="vertexId"/><zeebe:output source="=contextId" target="contextId"/><zeebe:output source="=status" target="status"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Establish" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:telecom.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;telecom.sepp.context&quot;" target="action"/><zeebe:input source="={vertexId: vertexId, contextId: contextId, status: status}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
