      <bpmn:extensionElements><zeebe:taskDefinition type="telecom.wlan.pps.provision"/>
        <zeebe:ioMapping>
          <zeebe:input source="={ppsMoId: ppsMoId, subscriberId: subscriberId, profileId: profileId, identityProviderOrgId: identityProviderOrgId, eapMethod: eapMethod, credentialKind: credentialKind, credentialRef: credentialRef, advertisedRcoiIds: advertisedRcoiIds, ppsMoHash: ppsMoHash, ppsMoRef: ppsMoRef, observedAt: observedAt, callerDid: callerDid}" target="payload"/>
          <zeebe:output source="=vertexId" target="vertexId"/><zeebe:output source="=ppsMoId" target="ppsMoId"/><zeebe:output source="=status" target="status"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
