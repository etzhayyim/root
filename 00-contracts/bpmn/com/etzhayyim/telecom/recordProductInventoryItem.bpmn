<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_telecom_record_product_inventory_item" targetNamespace="https://etzhayyim.ai/bpmn/telecom" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="telecom_record_product_inventory_item" name="recordProductInventoryItem" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Record"/>
    <bpmn:serviceTask id="Task_Record" name="record product inventory item">
      <bpmn:extensionElements><zeebe:taskDefinition type="telecom.tmf.product.inventory"/>
        <zeebe:ioMapping>
          <zeebe:input source="=recordId" target="recordId"/>
          <zeebe:input source="={recordId: recordId, productId: productId, accountId: accountId, offeringId: offeringId, orderId: orderId, productKind: productKind, lifecycleStatus: lifecycleStatus, startedAt: startedAt, expectedEndAt: expectedEndAt, terminatedAt: terminatedAt, observedAt: observedAt, callerDid: callerDid}" target="payload"/>
          <zeebe:output source="=vertexId" target="vertexId"/><zeebe:output source="=productId" target="productId"/><zeebe:output source="=status" target="status"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Record" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:telecom.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;telecom.tmf.product.inventory&quot;" target="action"/><zeebe:input source="={vertexId: vertexId, productId: productId, status: status}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
