<?xml version="1.0" encoding="UTF-8"?>
<!--
  arms.expiredPermitScanner — R/P1D batch job.

  Scans vertex_arms_permit for permits where expires_at < NOW() AND status = 'active',
  then overwrites those rows with status = 'expired' via RisingWave PK-upsert
  (same vertex_id re-insert = implicit overwrite per ADR-0036 / record-log semantics).

  NSID: com.etzhayyim.apps.arms.scanExpiredPermits  (manual trigger + timer)
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/arms-expired-permit-scanner-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_arms_expired_permit_scanner"
    targetNamespace="https://etzhayyim.ai/bpmn/arms"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="arms_expired_permit_scanner" name="arms expired permit scanner" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.arms.scanExpiredPermits", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <!-- R/P1D: fires once per day. Also triggerable via XRPC for manual scans. -->
    <bpmn:startEvent id="Start" name="daily">
      <bpmn:outgoing>Flow_ToCount</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_1d">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToCount" sourceRef="Start" targetRef="Task_CountExpired"/>

    <!-- Step 1: count permits that have passed their expiry but are still active -->
    <bpmn:serviceTask id="Task_CountExpired" name="count active-but-expired permits">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input
            source="=&quot;SELECT COUNT(*) AS expired_count FROM vertex_arms_permit WHERE expires_at &lt; NOW() AND status = 'active'&quot;"
            target="sql"/>
          <zeebe:output source="=rows[1].expired_count" target="expiredCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCount</bpmn:incoming>
      <bpmn:outgoing>Flow_ToExpire</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToExpire" sourceRef="Task_CountExpired" targetRef="Task_ExpireBatch"/>

    <!--
      Step 2: RisingWave PK-upsert pattern — INSERT INTO ... SELECT ... overwriting status.
      Same vertex_id re-insert = implicit overwrite (no ON CONFLICT needed, RW spec).
      Selects ALL columns to avoid partial-row null issues.
    -->
    <bpmn:serviceTask id="Task_ExpireBatch" name="expire permits (PK upsert)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input
            source="=&quot;INSERT INTO vertex_arms_permit (vertex_id, _seq, created_date, sensitivity_ord, owner_did, holder_did, firearm_vid, permit_type, permit_hash, issued_at, expires_at, jurisdiction, status, created_at, org_id, user_id, actor_id) SELECT vertex_id, _seq, created_date, sensitivity_ord, owner_did, holder_did, firearm_vid, permit_type, permit_hash, issued_at, expires_at, jurisdiction, 'expired', created_at, org_id, user_id, actor_id FROM vertex_arms_permit WHERE expires_at &lt; NOW() AND status = 'active'&quot;"
            target="sql"/>
          <zeebe:output source="=rowCount" target="expiredRows"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToExpire</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_ExpireBatch" targetRef="Task_Audit"/>

    <!-- Step 3: OCEL audit event -->
    <bpmn:serviceTask id="Task_Audit" name="emit audit event">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.arms.scanExpiredPermits&quot;" target="activity"/>
          <zeebe:input source="=&quot;arms.etzhayyim.com&quot;" target="actorDid"/>
          <zeebe:input source="=expiredRows" target="expiredRows"/>
          <zeebe:input source="=expiredCount" target="expiredCountBefore"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
