<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_pandemic_preparedness_stockpile_countermeasure" targetNamespace="https://etzhayyim.ai/bpmn/open-pandemic-preparedness" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_pandemic_preparedness_stockpile_countermeasure" name="stockpileCountermeasure" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_pandemic_preparedness&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, stockpile_id: stockpileId, outbreak_vid: outbreakVid, countermeasure_type: countermeasureType, product_vid: productVid, jurisdiction_iso3: jurisdictionIso3, units_stockpiled: unitsStockpiled, days_of_supply: daysOfSupply, recorded_at: recordedAt, readiness_tier: if daysOfSupply != null and daysOfSupply &gt;= 90 then &quot;robust&quot; else if daysOfSupply != null and daysOfSupply &gt;= 30 then &quot;adequate&quot; else &quot;insufficient&quot;, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-pandemic-preparedness&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-pandemic-preparedness.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;open.pandemicPreparedness.stockpileCountermeasure&quot;" target="action"/><zeebe:input source="={vertexId: vertexId}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>