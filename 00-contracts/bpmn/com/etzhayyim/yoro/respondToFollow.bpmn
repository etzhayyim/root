<?xml version="1.0" encoding="UTF-8"?>
<!--
  yoro.respondToFollow — reactive reciprocal follow + welcome post.

  CF PDS commit handling only detects the inbound follow and starts this
  process. The PyZeebe worker writes both graph-visible records and FLUSHes.

  NSID: com.etzhayyim.apps.yoro.respondToFollow
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/yoro-respond-to-follow-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_yoro_respond_to_follow"
    targetNamespace="https://etzhayyim.ai/bpmn/yoro"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="yoro_respond_to_follow" name="yoro respondToFollow" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.yoro.respondToFollow", "version": 2, "resultTimeoutMs": 15000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_ToFollow</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToFollow" sourceRef="Start" targetRef="Task_Follow"/>

    <bpmn:serviceTask id="Task_Follow" name="yoro social respond to follow">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="yoro.social.respondToFollowGraphFallback"/>
        <zeebe:ioMapping>
          <zeebe:input source="=string(followerDid)" target="followerDid"/>
          <zeebe:input source="=if followerHandle = null then &quot;&quot; else string(followerHandle)" target="followerHandle"/>
          <zeebe:input source="=if followRkey = null then &quot;&quot; else string(followRkey)" target="followRkey"/>
          <zeebe:input source="=true" target="flush"/>
          <zeebe:output source="=followBackUri" target="followBackUri"/>
          <zeebe:output source="=welcomeUri" target="welcomeUri"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToFollow</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Follow" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
