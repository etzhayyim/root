<?xml version="1.0" encoding="UTF-8"?>
<!--
  YORO actor quality enrichment.

  Purpose:
    Improve one public actor page at a time so profile, feed, sitemap, SEO
    snapshot, and domain-knowledge surfaces do not expose empty placeholder
    pages.

  Input variables:
    actorDid       required, e.g. did:etzhayyim:baf...
    handle         optional
    sourceHint     optional, human-readable provenance hint
    dryRun         optional boolean, default false

  Output variables:
    beforeQuality, afterQuality, missingFields, profileChanged, seedPostCreated

  NSID: com.etzhayyim.apps.yoro.actorQualityEnrich
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_yoro_actor_quality_enrich"
    targetNamespace="https://etzhayyim.ai/bpmn/yoro"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="yoro_actor_quality_enrich" name="YORO actor quality enrich" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.yoro.actorQualityEnrich", "version": 1, "resultTimeoutMs": 0 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start_Actor" name="actor quality request">
      <bpmn:outgoing>Flow_InspectBefore</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_InspectBefore" sourceRef="Start_Actor" targetRef="Task_InspectBefore"/>
    <bpmn:sequenceFlow id="Flow_ToNeedsEnrich" sourceRef="Task_InspectBefore" targetRef="Gateway_NeedsEnrich"/>
    <bpmn:sequenceFlow id="Flow_EnrichProfile" sourceRef="Gateway_NeedsEnrich" targetRef="Task_EnrichProfile">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= beforeQuality &lt; 80</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SkipEnrich" sourceRef="Gateway_NeedsEnrich" targetRef="Task_VerifyAfter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= beforeQuality &gt;= 80</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToSeedPost" sourceRef="Task_EnrichProfile" targetRef="Gateway_NeedsSeedPost"/>
    <bpmn:sequenceFlow id="Flow_CreateSeedPost" sourceRef="Gateway_NeedsSeedPost" targetRef="Task_CreateSeedPost">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= postsCount = 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SkipSeedPost" sourceRef="Gateway_NeedsSeedPost" targetRef="Task_VerifyAfter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= postsCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PostToVerify" sourceRef="Task_CreateSeedPost" targetRef="Task_VerifyAfter"/>
    <bpmn:sequenceFlow id="Flow_VerifyToAudit" sourceRef="Task_VerifyAfter" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End_Done"/>

    <bpmn:serviceTask id="Task_InspectBefore" name="inspect current actor quality">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="yoro.actorQuality.inspect"/>
        <zeebe:ioMapping>
          <zeebe:input source="=actorDid" target="actorDid"/>
          <zeebe:input source="=handle" target="handle"/>
          <zeebe:output source="=qualityScore" target="beforeQuality"/>
          <zeebe:output source="=missingFields" target="missingFields"/>
          <zeebe:output source="=postsCount" target="postsCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_NeedsEnrich" name="quality below threshold?"/>

    <bpmn:serviceTask id="Task_EnrichProfile" name="write profile fragments / safe profile defaults">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="yoro.actorQuality.enrichProfile" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=actorDid" target="actorDid"/>
          <zeebe:input source="=handle" target="handle"/>
          <zeebe:input source="=missingFields" target="missingFields"/>
          <zeebe:input source="=sourceHint" target="sourceHint"/>
          <zeebe:input source="=dryRun" target="dryRun"/>
          <zeebe:output source="=profileChanged" target="profileChanged"/>
          <zeebe:output source="=displayName" target="displayName"/>
          <zeebe:output source="=description" target="description"/>
          <zeebe:output source="=seedPostText" target="seedPostText"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_NeedsSeedPost" name="has public post?"/>

    <bpmn:serviceTask id="Task_CreateSeedPost" name="create one provenance seed post">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="yoro.actorQuality.ensureSeedPost" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=actorDid" target="actorDid"/>
          <zeebe:input source="=handle" target="handle"/>
          <zeebe:input source="=displayName" target="displayName"/>
          <zeebe:input source="=description" target="description"/>
          <zeebe:input source="=seedPostText" target="seedPostText"/>
          <zeebe:input source="=sourceHint" target="sourceHint"/>
          <zeebe:input source="=dryRun" target="dryRun"/>
          <zeebe:output source="=seedPostCreated" target="seedPostCreated"/>
          <zeebe:output source="=seedPostUri" target="seedPostUri"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_VerifyAfter" name="verify actor page quality">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="yoro.actorQuality.verify"/>
        <zeebe:ioMapping>
          <zeebe:input source="=actorDid" target="actorDid"/>
          <zeebe:input source="=handle" target="handle"/>
          <zeebe:input source="=sourceHint" target="sourceHint"/>
          <zeebe:input source="=dryRun" target="dryRun"/>
          <zeebe:output source="=qualityScore" target="afterQuality"/>
          <zeebe:output source="=missingFields" target="remainingMissingFields"/>
          <zeebe:output source="=postsCount" target="verifiedPostsCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Audit" name="emit actor quality OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.yoro.actorQuality.enrich&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;actorDid&quot;: actorDid, &quot;handle&quot;: handle, &quot;sourceHint&quot;: sourceHint, &quot;dryRun&quot;: dryRun, &quot;beforeQuality&quot;: beforeQuality, &quot;afterQuality&quot;: afterQuality, &quot;profileChanged&quot;: profileChanged, &quot;seedPostCreated&quot;: seedPostCreated, &quot;seedPostUri&quot;: seedPostUri, &quot;remainingMissingFields&quot;: remainingMissingFields, &quot;verifiedPostsCount&quot;: verifiedPostsCount }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Done" name="actor quality checked"/>

  </bpmn:process>
</bpmn:definitions>
