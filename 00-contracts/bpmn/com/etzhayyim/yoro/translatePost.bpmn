<?xml version="1.0" encoding="UTF-8"?>
<!--
  yoro.translatePost — create one translated sibling post and translationLink.

  NSID: com.etzhayyim.apps.yoro.translatePost
  Worker task: yoro.social.translatePost
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_yoro_translate_post"
    targetNamespace="https://etzhayyim.ai/bpmn/yoro"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="yoro_translate_post" name="yoro translatePost" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.yoro.translatePost", "version": 1, "resultTimeoutMs": 90000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="translate request">
      <bpmn:outgoing>Flow_ToTranslate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToTranslate" sourceRef="Start" targetRef="Task_Translate"/>

    <bpmn:serviceTask id="Task_Translate" name="translate yoro post">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="yoro.social.translatePost"/>
        <zeebe:ioMapping>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=postUri" target="postUri"/>
          <zeebe:output source="=translatedUri" target="translatedUri"/>
          <zeebe:output source="=translationLinkUri" target="translationLinkUri"/>
          <zeebe:output source="=sourceLang" target="sourceLang"/>
          <zeebe:output source="=targetLang" target="targetLang"/>
          <zeebe:output source="=model" target="model"/>
          <zeebe:output source="=error" target="error"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToTranslate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Translate" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
