<?xml version="1.0" encoding="UTF-8"?>
<!--
  yoro.platformPulse — timer-started actor pulse.

  CF Worker stays out of the execution path. Zeebe owns the cadence and the
  PyZeebe worker owns graph-visible post construction, JSON escaping, counts,
  insert, and FLUSH.

  NSID: com.etzhayyim.apps.yoro.platformPulse
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/yoro-platform-pulse-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_yoro_platform_pulse"
    targetNamespace="https://etzhayyim.ai/bpmn/yoro"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="yoro_platform_pulse" name="yoro platformPulse" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.yoro.platformPulse", "version": 2, "resultTimeoutMs": 20000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="every 4h">
      <bpmn:outgoing>Flow_ToPulse</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_4h">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT4H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToPulse" sourceRef="Start" targetRef="Task_Pulse"/>

    <bpmn:serviceTask id="Task_Pulse" name="yoro social platform pulse">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="yoro.social.platformPulseGraphFallback"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:yoro.etzhayyim.com&quot;" target="postRepo"/>
          <zeebe:input source="=true" target="flush"/>
          <zeebe:output source="=uri" target="postUri"/>
          <zeebe:output source="=text" target="postText"/>
          <zeebe:output source="=postsLast24h" target="postsLast24h"/>
          <zeebe:output source="=activeActors" target="activeActors"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPulse</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Pulse" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
