<?xml version="1.0" encoding="UTF-8"?>
<!--
  yoro.respondToMention — reactive reply when another actor mentions yoro.

  CF PDS commit handling only detects the event and starts this process. The
  PyZeebe worker builds the reply record, preserves reply.root/parent, writes
  vertex_repo_record, and FLUSHes.

  NSID: com.etzhayyim.apps.yoro.respondToMention
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/yoro-respond-to-mention-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_yoro_respond_to_mention"
    targetNamespace="https://etzhayyim.ai/bpmn/yoro"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="yoro_respond_to_mention" name="yoro respondToMention" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.yoro.respondToMention", "version": 2, "resultTimeoutMs": 15000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_ToReply</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToReply" sourceRef="Start" targetRef="Task_Reply"/>

    <bpmn:serviceTask id="Task_Reply" name="yoro social reply to mention">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="yoro.social.respondToMentionGraphFallback"/>
        <zeebe:ioMapping>
          <zeebe:input source="=string(authorDid)" target="authorDid"/>
          <zeebe:input source="=if authorHandle = null then &quot;&quot; else string(authorHandle)" target="authorHandle"/>
          <zeebe:input source="=string(postUri)" target="postUri"/>
          <zeebe:input source="=if postCid = null then &quot;&quot; else string(postCid)" target="postCid"/>
          <zeebe:input source="=if postText = null then &quot;&quot; else string(postText)" target="postText"/>
          <zeebe:input source="=true" target="flush"/>
          <zeebe:output source="=uri" target="replyUri"/>
          <zeebe:output source="=text" target="replyText"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToReply</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Reply" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
