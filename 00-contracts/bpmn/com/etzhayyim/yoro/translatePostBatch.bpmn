<?xml version="1.0" encoding="UTF-8"?>
<!--
  yoro.translatePostBatch — create translated sibling posts for target languages.

  NSID: com.etzhayyim.apps.yoro.translatePostBatch
  Worker task: yoro.social.translatePostBatch
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_yoro_translate_post_batch"
    targetNamespace="https://etzhayyim.ai/bpmn/yoro"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="yoro_translate_post_batch" name="yoro translatePostBatch" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.yoro.translatePostBatch", "version": 1, "resultTimeoutMs": 300000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="batch translate request">
      <bpmn:outgoing>Flow_ToTranslate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToTranslate" sourceRef="Start" targetRef="Task_TranslateBatch"/>

    <bpmn:serviceTask id="Task_TranslateBatch" name="translate yoro post batch">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="yoro.social.translatePostBatch"/>
        <zeebe:ioMapping>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=postUri" target="postUri"/>
          <zeebe:output source="=count" target="count"/>
          <zeebe:output source="=translated" target="translated"/>
          <zeebe:output source="=results" target="results"/>
          <zeebe:output source="=error" target="error"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToTranslate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_TranslateBatch" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
