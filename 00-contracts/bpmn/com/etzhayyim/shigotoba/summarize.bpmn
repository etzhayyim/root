<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shigotoba job-market summary.
  Appview dispatches this BPMN; Python Zeebe generic primitives read the graph
  and call the LLM outside the Worker.
  in:  topic?
  out: summary, topic, model, latencyMs
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_shigotoba_summarize"
    targetNamespace="https://etzhayyim.ai/bpmn/shigotoba"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="shigotoba_summarize" name="shigotoba summarize" isExecutable="true">
    <bpmn:startEvent id="Start" name="summary requested">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_SelectJobs"/>
    <bpmn:serviceTask id="Task_SelectJobs" name="read recent jobs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_shigotoba_job_posting&quot;" target="table"/>
          <zeebe:input source="=&quot;title, company_name, source&quot;" target="columns"/>
          <zeebe:input source="=&quot;actor_id = $1&quot;" target="whereExpr"/>
          <zeebe:input source="=[&quot;a80c21a0&quot;]" target="whereParams"/>
          <zeebe:input source="=&quot;created_at DESC&quot;" target="orderBy"/>
          <zeebe:input source="=20" target="limit"/>
          <zeebe:output source="=rows" target="jobRows"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_SelectJobs" targetRef="Task_Summarize"/>
    <bpmn:serviceTask id="Task_Summarize" name="summarize market">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.chat"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;classifier&quot;" target="tier"/>
          <zeebe:input source="=&quot;You summarize public job-market data for shigotoba.etzhayyim.com. Be concise, factual, and avoid unsupported claims.&quot;" target="system"/>
          <zeebe:input source="=&quot;Topic: &quot; + (if topic = null then &quot;job market&quot; else string(topic)) + &quot;\nRecent jobs JSON: &quot; + string(jobRows)" target="user"/>
          <zeebe:input source="=500" target="maxTokens"/>
          <zeebe:input source="=0.2" target="temperature"/>
          <zeebe:output source="=content" target="summary"/>
          <zeebe:output source="=model" target="model"/>
          <zeebe:output source="=latencyMs" target="latencyMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Summarize" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:shigotoba.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;summarize&quot;" target="action"/>
          <zeebe:input source="={topic: (if topic = null then &quot;job market&quot; else string(topic)), model: string(model), latencyMs: latencyMs}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>F4</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
