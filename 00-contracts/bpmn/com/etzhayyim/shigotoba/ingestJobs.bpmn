<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shigotoba public job ingestion.
  Appview dispatches this BPMN only; Python Zeebe worker fetches public APIs,
  normalizes, and writes graph rows.
  in:  source? = all|remotive|arbeitnow|remoteok, limit?
  out: result
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_shigotoba_ingest_jobs"
    targetNamespace="https://etzhayyim.ai/bpmn/shigotoba"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="shigotoba_ingest_jobs" name="shigotoba ingest jobs" isExecutable="true">
    <bpmn:startEvent id="Start" name="ingest requested">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Ingest"/>
    <bpmn:serviceTask id="Task_Ingest" name="fetch normalize persist">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="shigotoba.jobs.ingest"/>
        <zeebe:ioMapping>
          <zeebe:input source="=if source = null then &quot;all&quot; else string(source)" target="source"/>
          <zeebe:input source="=if limit = null then 100 else limit" target="limit"/>
          <zeebe:output source="=result" target="result"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Ingest" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:shigotoba.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;ingestJobs&quot;" target="action"/>
          <zeebe:input source="=result" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>F3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
