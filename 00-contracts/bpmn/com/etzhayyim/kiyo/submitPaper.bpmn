<?xml version="1.0" encoding="UTF-8"?>
<!--
  XRPC-triggered: com.etzhayyim.apps.kiyo.submitPaper
  Flow: validateAuthor → pinToIpfs → insertPaper → announceSubmission
  Storage: ipfs.etzhayyim.com (CIDv1, content-addressed)

  NSID: com.etzhayyim.apps.kiyo.submitPaper
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/kiyo-submit-paper-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_kiyo_submit_paper"
    targetNamespace="https://etzhayyim.ai/bpmn/kiyo"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="kiyo_submit_paper" name="kiyo submit paper" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.kiyo.submitPaper", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start_Manual" name="XRPC / on-demand">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="Start_Manual" targetRef="Task_ValidateAuthor"/>

    <!-- 1. Validate caller is a registered actor DID -->
    <bpmn:serviceTask id="Task_ValidateAuthor" name="validate author DID">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kiyo.validateAuthor"/>
        <zeebe:ioMapping>
          <zeebe:input  source="=ownerDid"    target="ownerDid"/>
          <zeebe:input  source="=authors"     target="authors"/>
          <zeebe:output source="=valid"       target="authorValid"/>
          <zeebe:output source="=authorNames" target="authorNames"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_AfterValidate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AfterValidate" sourceRef="Task_ValidateAuthor" targetRef="Task_PinToIpfs"/>

    <!-- 2. Pin PDF to ipfs.etzhayyim.com -->
    <bpmn:serviceTask id="Task_PinToIpfs" name="pin PDF to ipfs.etzhayyim.com">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.http.fetch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;https://ip5s7b2x.etzhayyim.com/xrpc/etzhayyim.ipfs.v1.IpfsCommandService/Publish&quot;" target="url"/>
          <zeebe:input source="=&quot;POST&quot;"               target="method"/>
          <zeebe:input source="=&quot;application/json&quot;"   target="contentType"/>
          <zeebe:input source="={content_base64: fileBase64, content_type: fileContentType}" target="body"/>
          <zeebe:input source="=30000"                          target="timeoutMs"/>
          <zeebe:output source="=bodyJson.cid"  target="ipfsCid"/>
          <zeebe:output source="=status"        target="ipfsStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_AfterIpfs</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AfterIpfs" sourceRef="Task_PinToIpfs" targetRef="Task_InsertPaper"/>

    <!-- 3. Insert vertex_kiyo_paper + edges into RisingWave -->
    <bpmn:serviceTask id="Task_InsertPaper" name="insert paper record">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kiyo.insertPaper"/>
        <zeebe:ioMapping>
          <zeebe:input source="=paperId"     target="paperId"/>
          <zeebe:input source="=title"       target="title"/>
          <zeebe:input source="=abstract"    target="abstract"/>
          <zeebe:input source="=subject"     target="subject"/>
          <zeebe:input source="=authors"     target="authors"/>
          <zeebe:input source="=ownerDid"    target="ownerDid"/>
          <zeebe:input source="=authorType"  target="authorType"/>
          <zeebe:input source="=ipfsCid"     target="ipfsCid"/>
          <zeebe:input source="=sourceBase64" target="sourceBase64"/>
          <zeebe:output source="=vertexId"   target="paperVertexId"/>
          <zeebe:output source="=paperId"    target="paperId"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_AfterInsert</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AfterInsert" sourceRef="Task_InsertPaper" targetRef="Task_Announce"/>

    <!-- 4. Post announcement to AT Protocol -->
    <bpmn:serviceTask id="Task_Announce" name="announce on AT Protocol">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;app.bsky.feed.post&quot;" target="type"/>
          <zeebe:input source="=ownerDid"                       target="did"/>
          <zeebe:input source="=&quot;📄 New preprint: &quot; + title + &quot; — kiyo:&quot; + paperId + &quot; https://kiyo.etzhayyim.com/paper/&quot; + paperId" target="text"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Announce" targetRef="End"/>

    <bpmn:endEvent id="End" name="submitted"/>
  </bpmn:process>
</bpmn:definitions>
