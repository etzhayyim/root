<?xml version="1.0" encoding="UTF-8"?>
<!--
  Timer R/P7D — select top-cited papers → LLM digest → AT post
  NSID: com.etzhayyim.apps.kiyo.weeklyDigest
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_kiyo_weekly_digest"
    targetNamespace="https://etzhayyim.ai/bpmn/kiyo"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="kiyo_weekly_digest" name="kiyo weekly digest" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.kiyo.weeklyDigest", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start_Timer" name="every 7 days">
      <bpmn:outgoing>Flow_Timer</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_P7D">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">R/P7D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Manual" name="on-demand">
      <bpmn:outgoing>Flow_Manual</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Timer"  sourceRef="Start_Timer"  targetRef="Task_SelectTop"/>
    <bpmn:sequenceFlow id="Flow_Manual" sourceRef="Start_Manual" targetRef="Task_SelectTop"/>

    <!-- 1. Select top-10 papers by citation+endorsement this week -->
    <bpmn:serviceTask id="Task_SelectTop" name="select top papers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT p.paper_id, p.title, p.abstract, COALESCE(s.citation_in_count,0)+COALESCE(s.endorsement_count,0) AS score FROM vertex_kiyo_paper p LEFT JOIN mv_kiyo_paper_stats s ON s.paper_id=p.paper_id WHERE p.status='active' ORDER BY score DESC LIMIT 10&quot;" target="sql"/>
          <zeebe:output source="=rows" target="topPapers"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_AfterSelect</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AfterSelect" sourceRef="Task_SelectTop" targetRef="Task_GenerateDigest"/>

    <!-- 2. LLM: generate digest text -->
    <bpmn:serviceTask id="Task_GenerateDigest" name="generate weekly digest">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.json"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;You are the editorial bot for kiyo.etzhayyim.com (紀要), a self-hosted research archive. Summarize the top papers of the week in 280 characters or less (Japanese or English). Include paper IDs.&quot;" target="systemPrompt"/>
          <zeebe:input source="=&quot;Top papers this week:\n&quot; + string(topPapers)" target="userPrompt"/>
          <zeebe:input source="={digestText: {type: &quot;string&quot;}}"                target="schema"/>
          <zeebe:output source="=result.digestText" target="digestText"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_AfterLlm</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AfterLlm" sourceRef="Task_GenerateDigest" targetRef="Task_PostDigest"/>

    <!-- 3. Post to AT Protocol -->
    <bpmn:serviceTask id="Task_PostDigest" name="post weekly digest">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;app.bsky.feed.post&quot;"     target="type"/>
          <zeebe:input source="=&quot;did:web:kiyo.etzhayyim.com&quot;"  target="did"/>
          <zeebe:input source="=&quot;📚 kiyo weekly digest\n&quot; + digestText" target="text"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_PostDigest" targetRef="End"/>

    <bpmn:endEvent id="End" name="digest posted"/>
  </bpmn:process>
</bpmn:definitions>
