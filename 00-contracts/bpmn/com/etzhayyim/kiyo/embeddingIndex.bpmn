<?xml version="1.0" encoding="UTF-8"?>
<!--
  Timer R/P1D — embed abstracts of new papers via murakumo
  LangGraph batch embedding → UPDATE vertex_kiyo_paper.embedding
  NSID: com.etzhayyim.apps.kiyo.embeddingIndex
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_kiyo_embedding_index"
    targetNamespace="https://etzhayyim.ai/bpmn/kiyo"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="kiyo_embedding_index" name="kiyo embedding index" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.kiyo.embeddingIndex", "version": 1, "resultTimeoutMs": 180000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start_Timer" name="every day">
      <bpmn:outgoing>Flow_Timer</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_P1D">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">R/P1D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Manual" name="on-demand">
      <bpmn:outgoing>Flow_Manual</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Timer"  sourceRef="Start_Timer"  targetRef="Task_FetchUnembedded"/>
    <bpmn:sequenceFlow id="Flow_Manual" sourceRef="Start_Manual" targetRef="Task_FetchUnembedded"/>

    <!-- 1. Select papers without embedding -->
    <bpmn:serviceTask id="Task_FetchUnembedded" name="select papers without embedding">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT paper_id, title, abstract FROM vertex_kiyo_paper WHERE embedding IS NULL AND status = 'active' LIMIT 100&quot;" target="sql"/>
          <zeebe:output source="=rows" target="papers"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_AfterFetch</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AfterFetch" sourceRef="Task_FetchUnembedded" targetRef="Task_EmbedBatch"/>

    <!-- 2. LangGraph: batch embed title+abstract via murakumo -->
    <bpmn:serviceTask id="Task_EmbedBatch" name="embed abstracts via LangGraph">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kiyo.embedAbstracts"/>
        <zeebe:ioMapping>
          <zeebe:input  source="=papers"       target="papers"/>
          <zeebe:output source="=embeddings"   target="embeddings"/>
          <zeebe:output source="=embeddedCount" target="embeddedCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_AfterEmbed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AfterEmbed" sourceRef="Task_EmbedBatch" targetRef="Task_UpdateEmbeddings"/>

    <!-- 3. Batch-update vertex_kiyo_paper.embedding -->
    <bpmn:serviceTask id="Task_UpdateEmbeddings" name="persist embeddings">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kiyo.persistEmbeddings"/>
        <zeebe:ioMapping>
          <zeebe:input  source="=embeddings"   target="embeddings"/>
          <zeebe:output source="=updatedCount" target="updatedCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_UpdateEmbeddings" targetRef="End"/>

    <bpmn:endEvent id="End" name="embeddings indexed"/>
  </bpmn:process>
</bpmn:definitions>
