<?xml version="1.0" encoding="UTF-8"?>
<!--
  XRPC-triggered: com.etzhayyim.apps.kiyo.submitRevision
  Flow: validateOwner → pinNewVersion → insertRevision → updatePaper
  NSID: com.etzhayyim.apps.kiyo.submitRevision
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_kiyo_submit_revision"
    targetNamespace="https://etzhayyim.ai/bpmn/kiyo"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="kiyo_submit_revision" name="kiyo submit revision" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.kiyo.submitRevision", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start_Manual" name="XRPC / on-demand">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="Start_Manual" targetRef="Task_ValidateOwner"/>

    <bpmn:serviceTask id="Task_ValidateOwner" name="validate paper owner">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kiyo.validateOwner"/>
        <zeebe:ioMapping>
          <zeebe:input  source="=paperId"     target="paperId"/>
          <zeebe:input  source="=callerDid"   target="callerDid"/>
          <zeebe:output source="=valid"       target="ownerValid"/>
          <zeebe:output source="=nextVersion" target="nextVersion"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_AfterValidate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AfterValidate" sourceRef="Task_ValidateOwner" targetRef="Task_PinRevision"/>

    <bpmn:serviceTask id="Task_PinRevision" name="pin new version to ipfs.etzhayyim.com">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.http.fetch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;https://ip5s7b2x.etzhayyim.com/xrpc/etzhayyim.ipfs.v1.IpfsCommandService/Publish&quot;" target="url"/>
          <zeebe:input source="=&quot;POST&quot;"             target="method"/>
          <zeebe:input source="=&quot;application/json&quot;" target="contentType"/>
          <zeebe:input source="={content_base64: fileBase64, content_type: fileContentType}" target="body"/>
          <zeebe:input source="=30000"                        target="timeoutMs"/>
          <zeebe:output source="=bodyJson.cid"  target="newIpfsCid"/>
          <zeebe:output source="=status"        target="ipfsStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_AfterPin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AfterPin" sourceRef="Task_PinRevision" targetRef="Task_InsertRevision"/>

    <bpmn:serviceTask id="Task_InsertRevision" name="insert revision + update paper">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kiyo.insertRevision"/>
        <zeebe:ioMapping>
          <zeebe:input source="=paperId"      target="paperId"/>
          <zeebe:input source="=nextVersion"  target="version"/>
          <zeebe:input source="=newIpfsCid"   target="ipfsCid"/>
          <zeebe:input source="=callerDid"    target="ownerDid"/>
          <zeebe:output source="=revisionVertexId" target="revisionVertexId"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_InsertRevision" targetRef="End"/>

    <bpmn:endEvent id="End" name="revision inserted"/>
  </bpmn:process>
</bpmn:definitions>
