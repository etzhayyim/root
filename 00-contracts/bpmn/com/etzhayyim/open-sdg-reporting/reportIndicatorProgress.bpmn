<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_sdg_reporting_report_indicator_progress" targetNamespace="https://etzhayyim.ai/bpmn/open-sdg-reporting" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_sdg_reporting_report_indicator_progress" name="reportIndicatorProgress" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_sdg_reporting&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, progress_id: progressId, vnr_vid: vnrVid, sdg_indicator: sdgIndicator, country_iso3: countryIso3, current_value: currentValue, target_value2030: targetValue2030, progress_pct: progressPct, reported_year: reportedYear, reported_at: reportedAt, progress_tier: if progressPct != null and progressPct &gt;= 100 then &quot;achieved&quot; else if progressPct != null and progressPct &gt;= 70 then &quot;on_track&quot; else if progressPct != null and progressPct &gt;= 30 then &quot;progressing_slowly&quot; else if progressPct != null and progressPct &gt;= 0 then &quot;stagnating&quot; else &quot;regressing&quot;, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-sdg-reporting&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-sdg-reporting.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;open.sdgReporting.reportIndicatorProgress&quot;" target="action"/><zeebe:input source="={vertexId: vertexId}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>