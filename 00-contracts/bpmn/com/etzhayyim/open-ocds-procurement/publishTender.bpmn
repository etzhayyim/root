<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_ocds_procurement_publish_tender" targetNamespace="https://etzhayyim.ai/bpmn/open-ocds-procurement" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_ocds_procurement_publish_tender" name="publishTender" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_ocds_procurement&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, ocid: ocid, buyer_lei: buyerLei, jurisdiction_iso3: jurisdictionIso3, procurement_stage: procurementStage, estimated_value_usd: estimatedValueUsd, procurement_method: procurementMethod, main_category_cpv: mainCategoryCpv, published_at: publishedAt, scale_tier: if estimatedValueUsd != null and estimatedValueUsd &gt;= 100000000 then &quot;mega&quot; else if estimatedValueUsd != null and estimatedValueUsd &gt;= 10000000 then &quot;large&quot; else if estimatedValueUsd != null and estimatedValueUsd &gt;= 1000000 then &quot;mid&quot; else &quot;small&quot;, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-ocds-procurement&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-ocds-procurement.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;open.ocdsProcurement.publishTender&quot;" target="action"/><zeebe:input source="={vertexId: vertexId}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>