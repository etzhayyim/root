<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_coastal_slr_record_slr_measurement" targetNamespace="https://etzhayyim.ai/bpmn/open-coastal-slr" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_coastal_slr_record_slr_measurement" name="recordSlrMeasurement" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_coastal_slr&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, measurement_id: measurementId, station_id: stationId, country_iso3: countryIso3, location_lat: locationLat, location_lon: locationLon, ms_mm_per_year: msMmPerYear, shoreline_retreat_mm: shorelineRetreatMm, reliability_score: reliabilityScore, measured_year: measuredYear, recorded_at: recordedAt, exposure_tier: if msMmPerYear != null and msMmPerYear &gt;= 6 then &quot;extreme&quot; else if msMmPerYear != null and msMmPerYear &gt;= 3.3 then &quot;high&quot; else if msMmPerYear != null and msMmPerYear &gt;= 2 then &quot;moderate&quot; else &quot;low&quot;, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-coastal-slr&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-coastal-slr.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;open.coastalSlr.recordSlrMeasurement&quot;" target="action"/><zeebe:input source="={vertexId: vertexId}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>