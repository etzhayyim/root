<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fund manager discovery pilot.

  NSID:       com.etzhayyim.apps.fund.managerDiscovery
  Owner DID:  did:web:fund.etzhayyim.com
  Process ID: fund_manager_discovery

  The Zeebe task types follow ADR-2604261200. Raw artifacts are persisted
  before graph writes, and cursor advancement is gated by visibility checks.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_fund_manager_discovery"
    targetNamespace="https://etzhayyim.ai/bpmn/fund"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="fund_manager_discovery" name="fund manager discovery" isExecutable="true">
    <bpmn:startEvent id="Start" name="discovery requested">
      <bpmn:outgoing>Flow_PlanSources</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_PlanSources" sourceRef="Start" targetRef="Task_PlanSources"/>

    <bpmn:serviceTask id="Task_PlanSources" name="plan fund sources">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fund.planSources" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PlanSources</bpmn:incoming>
      <bpmn:outgoing>Flow_FetchRaw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_FetchRaw" sourceRef="Task_PlanSources" targetRef="Task_FetchRaw"/>

    <bpmn:serviceTask id="Task_FetchRaw" name="fetch source artifacts">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fund.fetchRaw" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FetchRaw</bpmn:incoming>
      <bpmn:outgoing>Flow_PersistArtifact</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_PersistArtifact" sourceRef="Task_FetchRaw" targetRef="Task_PersistArtifact"/>

    <bpmn:serviceTask id="Task_PersistArtifact" name="persist raw artifact">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fund.persistArtifact" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PersistArtifact</bpmn:incoming>
      <bpmn:outgoing>Flow_NormalizeManager</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_NormalizeManager" sourceRef="Task_PersistArtifact" targetRef="Task_NormalizeManager"/>

    <bpmn:serviceTask id="Task_NormalizeManager" name="normalize manager">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fund.normalizeManager" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NormalizeManager</bpmn:incoming>
      <bpmn:outgoing>Flow_NormalizeFund</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_NormalizeFund" sourceRef="Task_NormalizeManager" targetRef="Task_NormalizeFund"/>

    <bpmn:serviceTask id="Task_NormalizeFund" name="normalize funds">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fund.normalizeFund" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NormalizeFund</bpmn:incoming>
      <bpmn:outgoing>Flow_EnrichEntity</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EnrichEntity" sourceRef="Task_NormalizeFund" targetRef="Task_EnrichEntity"/>

    <bpmn:serviceTask id="Task_EnrichEntity" name="enrich legal entities">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fund.enrichEntity" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_EnrichEntity</bpmn:incoming>
      <bpmn:outgoing>Flow_Health</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Health" sourceRef="Task_EnrichEntity" targetRef="Task_Health"/>

    <bpmn:serviceTask id="Task_Health" name="rw health gate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="rw.health.probe" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:output source="=healthy" target="rwHealthy"/>
          <zeebe:output source="=reason" target="rwHealthReason"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Health</bpmn:incoming>
      <bpmn:outgoing>Flow_HealthGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_HealthGate" sourceRef="Task_Health" targetRef="Gateway_RwHealthy"/>

    <bpmn:exclusiveGateway id="Gateway_RwHealthy" name="RisingWave healthy?" default="Flow_RwDegraded">
      <bpmn:incoming>Flow_HealthGate</bpmn:incoming>
      <bpmn:outgoing>Flow_WriteGraph</bpmn:outgoing>
      <bpmn:outgoing>Flow_RwDegraded</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_WriteGraph" sourceRef="Gateway_RwHealthy" targetRef="Task_WriteGraph">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rwHealthy = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RwDegraded" sourceRef="Gateway_RwHealthy" targetRef="Task_AuditRwDegraded"/>

    <bpmn:serviceTask id="Task_WriteGraph" name="write fund graph">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fund.writeGraph" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_WriteGraph</bpmn:incoming>
      <bpmn:outgoing>Flow_VerifyCoverage</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_VerifyCoverage" sourceRef="Task_WriteGraph" targetRef="Task_VerifyCoverage"/>

    <bpmn:serviceTask id="Task_VerifyCoverage" name="verify fund coverage">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fund.verifyCoverage" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_VerifyCoverage</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_VerifyCoverage" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_AuditRwDegraded" name="audit rw degraded">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:fund.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;fund.managerDiscovery.rwDegraded&quot;" target="action"/>
          <zeebe:input source="={sourceId: sourceId, runId: runId, rwHealthy: rwHealthy, rwHealthReason: rwHealthReason, status: &quot;rw-degraded&quot;}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RwDegraded</bpmn:incoming>
      <bpmn:outgoing>Flow_DegradedEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_DegradedEnd" sourceRef="Task_AuditRwDegraded" targetRef="End"/>

    <bpmn:serviceTask id="Task_Audit" name="audit fund discovery">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:fund.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;fund.managerDiscovery.completed&quot;" target="action"/>
          <zeebe:input source="={sourceId: sourceId, runId: runId, managersWritten: managersWritten, fundsWritten: fundsWritten, artifactsWritten: artifactsWritten}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="discovery completed">
      <bpmn:incoming>Flow_End</bpmn:incoming>
      <bpmn:incoming>Flow_DegradedEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
