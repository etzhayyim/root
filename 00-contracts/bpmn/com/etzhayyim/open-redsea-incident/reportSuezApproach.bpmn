<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_redsea_incident_suez"
    targetNamespace="https://etzhayyim.ai/bpmn/open-redsea-incident"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_redsea_incident_suez" name="Suez 接近事故" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="suez 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_redsea_suez_approach_incident&quot;" target="table"/>
          <zeebe:input source="={vertex_id: vertexId, incident_id: incidentId, imo: imo, incident_type: incidentType, lat: lat, lon: lon, narrative: narrative, severity: if incidentType = &quot;blockage&quot; then &quot;major&quot; else if list contains([&quot;grounding&quot;,&quot;collision&quot;], incidentType) then &quot;moderate&quot; else &quot;minor&quot;, require_public_notice: incidentType = &quot;blockage&quot;, occurred_at: occurredAt, status: &quot;confirmed&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-redsea-incident&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit openRedseaIncident.suezApproach.record">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-redsea-incident.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openRedseaIncident.suezApproach.record&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, incidentId: incidentId, incidentType: incidentType}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
