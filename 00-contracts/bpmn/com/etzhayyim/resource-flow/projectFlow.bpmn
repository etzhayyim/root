<?xml version="1.0" encoding="UTF-8"?>
<!--
  resource-flow projectFlow — ADR-0036/0056 BPMN worker projection.

  NSID: com.etzhayyim.apps.resourceFlow.projectFlow
  Task type: resource-flow.project.flow
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_resource_flow_project_flow"
    targetNamespace="https://etzhayyim.ai/bpmn/resource-flow"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="resource_flow_project_flow" name="resource-flow projectFlow" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.resourceFlow.projectFlow", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="request">
      <bpmn:outgoing>Flow_Start_Project</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_Project" sourceRef="Start" targetRef="Task_Project"/>

    <bpmn:serviceTask id="Task_Project" name="project resource-flow record">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="resource-flow.project.flow"/>
        <zeebe:ioMapping>
          <zeebe:input source="=flowClass" target="flowClass"/>
          <zeebe:input source="=recordUri" target="recordUri"/>
          <zeebe:input source="=observedAt" target="observedAt"/>
          <zeebe:input source="=record" target="record"/>
          <zeebe:input source="=primaryDid" target="primaryDid"/>
          <zeebe:input source="=orgId" target="orgId"/>
          <zeebe:input source="=userId" target="userId"/>
          <zeebe:output source="=flowClass" target="flowClass"/>
          <zeebe:output source="=vertexId" target="vertexId"/>
          <zeebe:output source="=status" target="status"/>
          <zeebe:output source="=rejectReason" target="rejectReason"/>
          <zeebe:output source="=error" target="error"/>
          <zeebe:output source="=message" target="message"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Project</bpmn:incoming>
      <bpmn:outgoing>Flow_Project_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Project_Audit" sourceRef="Task_Project" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:resource-flow.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;resource-flow.project.flow&quot;" target="action"/>
          <zeebe:input source="={flowClass: flowClass, recordUri: recordUri, vertexId: vertexId, status: status, error: error}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Project_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
