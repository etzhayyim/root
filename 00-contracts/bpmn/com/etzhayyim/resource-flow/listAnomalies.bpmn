<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_resource_flow_list_anomalies" targetNamespace="https://etzhayyim.ai/bpmn/resource-flow" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="resource_flow_list_anomalies" name="resource-flow listAnomalies" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Query"/>
    <bpmn:serviceTask id="Task_Query" name="list anomalies">
      <bpmn:extensionElements><zeebe:taskDefinition type="resource-flow.list.anomalies"/>
        <zeebe:ioMapping>
          <zeebe:output source="=anomalies" target="anomalies"/>
          <zeebe:output source="=total" target="total"/>
          <zeebe:output source="=offset" target="offset"/>
          <zeebe:output source="=limit" target="limit"/>
          <zeebe:output source="=reviewed" target="reviewed"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Query" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
