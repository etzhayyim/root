<?xml version="1.0" encoding="UTF-8"?>
<!--
  resource-flow.detectAnomaly — timer-started anomaly cron (ADR-0028 + ADR-0046).

  Daily R/PT24H sweep of mv_resource_flow_sankey_{currency,service,personnel}.
  Actual comparison + anomaly write + social emission runs in pyzeebe task
  resource-flow.detect.anomaly (pymagatama/primitives/resource_flow.py).
  CF Worker XRPC endpoint is a thin dispatcher stub only.

  NSID: com.etzhayyim.apps.resourceFlow.detectAnomaly
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/resource-flow-detect-anomaly-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_resource_flow_detect_anomaly"
    targetNamespace="https://etzhayyim.ai/bpmn/resource-flow"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="resource_flow_detect_anomaly" name="resource-flow detectAnomaly" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.resourceFlow.detectAnomaly", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="daily">
      <bpmn:outgoing>Flow_S</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_24h">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT24H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Detect"/>

    <bpmn:serviceTask id="Task_Detect" name="scan + flag + alert">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="resource-flow.detect.anomaly"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;all&quot;"  target="flowClass"/>
          <zeebe:input source="=30"    target="windowDays"/>
          <zeebe:input source="=3.0"   target="thresholdFactor"/>
          <zeebe:input source="=3"     target="minBaselineSamples"/>
          <zeebe:input source="=true"  target="post"/>
          <zeebe:output source="=runId"   target="runId"/>
          <zeebe:output source="=scanned" target="scanned"/>
          <zeebe:output source="=flagged" target="flagged"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming>
      <bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Detect" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:resource-flow.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;resource-flow.anomaly.scan&quot;"     target="action"/>
          <zeebe:input source="={runId: runId, scanned: scanned, flagged: flagged}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End" name="done"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
