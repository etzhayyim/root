        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_blue_carbon_mrv&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, project_id: projectId, registry_kind: registryKind, ecosystem: ecosystem, country_iso3: countryIso3, area_hectares: areaHectares, sequestration_tco2e_yearly: sequestrationTco2eYearly, forest_project_vid: forestProjectVid, indigenous_tenure_pct: indigenousTenurePct, registered_at: registeredAt, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-blue-carbon-mrv&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
