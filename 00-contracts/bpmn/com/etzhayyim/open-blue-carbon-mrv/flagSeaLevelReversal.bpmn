<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_blue_carbon_mrv_flag_sea_level_reversal" targetNamespace="https://etzhayyim.ai/bpmn/open-blue-carbon-mrv" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_blue_carbon_mrv_flag_sea_level_reversal" name="flagSeaLevelReversal" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_blue_carbon_mrv&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, flag_id: flagId, project_vid: projectVid, baseline_drift_vid: baselineDriftVid, driver_kind: driverKind, reversal_tco2e: reversalTco2e, reported_at: reportedAt, severity_tier: if reversalTco2e != null and reversalTco2e &gt;= 100000 then &quot;catastrophic&quot; else if reversalTco2e != null and reversalTco2e &gt;= 10000 then &quot;significant&quot; else &quot;moderate&quot;, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-blue-carbon-mrv&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
