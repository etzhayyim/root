<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_biodiversity_gbf_record_indicator" targetNamespace="https://etzhayyim.ai/bpmn/open-biodiversity-gbf" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_biodiversity_gbf_record_indicator" name="recordIndicator" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_biodiversity_gbf&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, indicator_id: indicatorId, country_iso3: countryIso3, gbf_target: gbfTarget, indicator_code: indicatorCode, value_numeric: valueNumeric, unit: unit, baseline_value: baselineValue, target_value2030: targetValue2030, reported_year: reportedYear, reported_at: reportedAt, progress_tier: if valueNumeric != null and baselineValue != null and targetValue2030 != null and (valueNumeric - baselineValue) / (targetValue2030 - baselineValue) &gt;= 0.7 then &quot;on_track&quot; else if valueNumeric != null and baselineValue != null and targetValue2030 != null and (valueNumeric - baselineValue) / (targetValue2030 - baselineValue) &gt;= 0.3 then &quot;partial&quot; else &quot;off_track&quot;, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-biodiversity-gbf&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-biodiversity-gbf.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;open.biodiversityGbf.recordIndicator&quot;" target="action"/><zeebe:input source="={vertexId: vertexId}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>