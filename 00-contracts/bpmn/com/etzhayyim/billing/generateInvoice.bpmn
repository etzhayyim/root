<?xml version="1.0" encoding="UTF-8"?>
<!--
  billing.etzhayyim.com — monthly invoice generator (autonomous, cron 0 0 3 1 * ? = month 1st 03:00 UTC).

  Pipeline:
    1. billing.generate.invoice   for every org with status='active'
                                  org_plan, draft a vertex_billing_invoice
                                  row from previous-month consumption,
                                  apply outstanding credits FIFO, compute
                                  10% 消費税内税, set status='draft'.
                                  (Stripe push happens later when status is
                                  flipped to 'issued' — Phase 8 manual
                                  approval gate; Phase 9 auto-issue.)
    2. generic.audit.emit         OCEL trail.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_billing_generate_invoice"
    targetNamespace="https://etzhayyim.ai/bpmn/billing"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="billing_generate_invoice" name="billing generate invoice (1st 03:00 UTC)" isExecutable="true">

    <bpmn:startEvent id="StartTimer" name="month 1st 03:00 UTC">
      <bpmn:outgoing>Flow_ToGen</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 3 1 * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Generate" name="generate invoices for active orgs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="billing.generate.invoice"/>
        <zeebe:ioMapping>
          <zeebe:output source="=invoicesGenerated" target="invoicesGenerated"/>
          <zeebe:output source="=totalJpyMicro" target="totalJpyMicro"/>
          <zeebe:output source="=creditsConsumedJpyMicro" target="creditsConsumedJpyMicro"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToGen</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToGen" sourceRef="StartTimer" targetRef="Task_Generate"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:billing.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.billing.generateInvoice&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;invoicesGenerated&quot;: invoicesGenerated, &quot;totalJpyMicro&quot;: totalJpyMicro, &quot;creditsConsumedJpyMicro&quot;: creditsConsumedJpyMicro }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Generate" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
