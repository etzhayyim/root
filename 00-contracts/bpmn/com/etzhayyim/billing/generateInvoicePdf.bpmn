<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_billing_generate_invoice_pdf"
    targetNamespace="https://etzhayyim.ai/bpmn/billing"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="billing_generate_invoice_pdf" name="billing generate invoice PDF" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.billing.generateInvoicePdf", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="generateInvoicePdf">
      <bpmn:outgoing>Flow_ToRender</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Render" name="render 適格請求書 PDF + put to B2 archive">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="billing.invoice.renderPdf"/>
        <zeebe:ioMapping>
          <zeebe:input source="=invoiceId" target="invoiceId"/>
          <zeebe:input source="=lang"      target="lang"/>
          <zeebe:input source="=force"     target="force"/>
          <zeebe:output source="=ok"          target="ok"/>
          <zeebe:output source="=invoiceId"   target="invoiceId"/>
          <zeebe:output source="=b2Key"       target="b2Key"/>
          <zeebe:output source="=sha256"      target="sha256"/>
          <zeebe:output source="=sizeBytes"   target="sizeBytes"/>
          <zeebe:output source="=renderedAt"  target="renderedAt"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRender</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToRender" sourceRef="Start" targetRef="Task_Render"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Render" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
