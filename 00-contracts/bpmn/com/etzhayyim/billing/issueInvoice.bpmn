<?xml version="1.0" encoding="UTF-8"?>
<!--
  billing.etzhayyim.com — issue invoice (timer-start cron 0 0 5 1 * ? = month 1st 05:00 UTC).

  Flow:
    1. billing.invoice.draftBatch     SELECT all status='draft' invoices for last month.
    2. for each: billing.invoice.renderPdf   render 適格請求書 PDF, store in B2.
    3. for each: billing.invoice.issue       UPDATE status='issued' + issued_at.
    4. (Phase 7.1) Stripe.invoices.create + .send.

  Phase 7 v0 keeps the loop server-side in the pyzeebe primitive; the
  BPMN is a single ServiceTask. v0.1 splits per-invoice into separate
  Zeebe job activations once the per-invoice latency profile is known.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_billing_issue_invoice"
    targetNamespace="https://etzhayyim.ai/bpmn/billing"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="billing_issue_invoice" name="billing issue invoice (1st 05:00 UTC)" isExecutable="true">

    <bpmn:startEvent id="StartTimer" name="month 1st 05:00 UTC">
      <bpmn:outgoing>Flow_ToIssue</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 5 1 * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Issue" name="render + issue all draft invoices">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="billing.invoice.issueBatch"/>
        <zeebe:ioMapping>
          <zeebe:output source="=invoicesIssued" target="invoicesIssued"/>
          <zeebe:output source="=pdfsRendered"   target="pdfsRendered"/>
          <zeebe:output source="=totalJpyMicro"  target="totalJpyMicro"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToIssue</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToIssue" sourceRef="StartTimer" targetRef="Task_Issue"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:billing.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.billing.issueInvoice&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;invoicesIssued&quot;: invoicesIssued, &quot;pdfsRendered&quot;: pdfsRendered, &quot;totalJpyMicro&quot;: totalJpyMicro }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Issue" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
