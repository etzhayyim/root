<?xml version="1.0" encoding="UTF-8"?>
<!--
  billing.etzhayyim.com — Stripe webhook receiver (XRPC com.etzhayyim.apps.billing.stripeWebhook).

  PDS verifies the stripe-signature header before this BPMN starts. The
  primitive is therefore trust-boundaried at the dispatcher.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_billing_stripe_webhook"
    targetNamespace="https://etzhayyim.ai/bpmn/billing"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="billing_stripe_webhook" name="billing stripe webhook" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.billing.stripeWebhook", "version": 1, "resultTimeoutMs": 30000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="stripeWebhook">
      <bpmn:outgoing>Flow_ToHandle</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Handle" name="ingest event + dispatch by type">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="billing.stripe.handleEvent"/>
        <zeebe:ioMapping>
          <zeebe:input source="=id"      target="stripeEventId"/>
          <zeebe:input source="=type"    target="stripeEventType"/>
          <zeebe:input source="=account" target="stripeAccountId"/>
          <zeebe:input source="=data"    target="data"/>
          <zeebe:output source="=ok"             target="ok"/>
          <zeebe:output source="=stripeEventId"  target="stripeEventId"/>
          <zeebe:output source="=duplicate"      target="duplicate"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToHandle</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToHandle" sourceRef="Start" targetRef="Task_Handle"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:billing.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.billing.stripeWebhook&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;stripeEventId&quot;: stripeEventId, &quot;stripeEventType&quot;: stripeEventType, &quot;duplicate&quot;: duplicate }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Handle" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
