<?xml version="1.0" encoding="UTF-8"?>
<!--
  billing.etzhayyim.com — applyDiscount workflow (XRPC com.etzhayyim.apps.billing.setDiscount).

  Pipeline:
    1. billing.discount.validateRole    check approverRole vs discountPct band:
                                          sales-rep ≤ 40% / cfo ≤ 50% / ceo > 50%.
       ExclusiveGateway                  approvalAllowed?
       Yes → billing.discount.apply      INSERT vertex_billing_discount row +
                                          UPDATE vertex_billing_org_plan.applied_discount_pct.
       No  → audit + EndFail (return approvalState=rejected, rejectReason).
    3. generic.audit.emit                OCEL trail.

  XRPC-bound (ADR-0056).
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_billing_apply_discount"
    targetNamespace="https://etzhayyim.ai/bpmn/billing"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="billing_apply_discount" name="billing apply discount" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.billing.setDiscount", "version": 1, "resultTimeoutMs": 30000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="setDiscount">
      <bpmn:outgoing>Flow_ToValidate</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Validate" name="validate approver role / band">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="billing.discount.validateRole"/>
        <zeebe:ioMapping>
          <zeebe:input source="=orgDid" target="orgDid"/>
          <zeebe:input source="=discountPct" target="discountPct"/>
          <zeebe:input source="=approver" target="approver"/>
          <zeebe:input source="=approverRole" target="approverRole"/>
          <zeebe:output source="=approvalAllowed" target="approvalAllowed"/>
          <zeebe:output source="=rejectReason" target="rejectReason"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToValidate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToValidate" sourceRef="Start" targetRef="Task_Validate"/>

    <bpmn:exclusiveGateway id="Gate_Approval" name="approvalAllowed?">
      <bpmn:incoming>Flow_ToGate</bpmn:incoming>
      <bpmn:outgoing>Flow_Pass</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToGate" sourceRef="Task_Validate" targetRef="Gate_Approval"/>

    <bpmn:sequenceFlow id="Flow_Pass" sourceRef="Gate_Approval" targetRef="Task_Apply">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approvalAllowed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Fail" sourceRef="Gate_Approval" targetRef="Task_AuditFail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approvalAllowed = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_Apply" name="apply discount">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="billing.discount.apply"/>
        <zeebe:ioMapping>
          <zeebe:input source="=orgDid" target="orgDid"/>
          <zeebe:input source="=discountPct" target="discountPct"/>
          <zeebe:input source="=kind" target="kind"/>
          <zeebe:input source="=approver" target="approver"/>
          <zeebe:input source="=approverRole" target="approverRole"/>
          <zeebe:input source="=rationale" target="rationale"/>
          <zeebe:input source="=validFrom" target="validFrom"/>
          <zeebe:input source="=validUntil" target="validUntil"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=discountId" target="discountId"/>
          <zeebe:output source="=previousDiscountPct" target="previousDiscountPct"/>
          <zeebe:output source="=approvalState" target="approvalState"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Pass</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Apply" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit (success)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:billing.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.billing.setDiscount&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;orgDid&quot;: orgDid, &quot;discountPct&quot;: discountPct, &quot;approver&quot;: approver, &quot;approvalState&quot;: approvalState, &quot;discountId&quot;: discountId }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:serviceTask id="Task_AuditFail" name="audit emit (rejected by role band)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:billing.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.billing.setDiscount.rejected&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;orgDid&quot;: orgDid, &quot;discountPct&quot;: discountPct, &quot;approver&quot;: approver, &quot;approverRole&quot;: approverRole, &quot;rejectReason&quot;: rejectReason }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Fail</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndFail</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEndFail" sourceRef="Task_AuditFail" targetRef="EndFail"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndFail" name="role band exceeded">
      <bpmn:incoming>Flow_ToEndFail</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
