<?xml version="1.0" encoding="UTF-8"?>
<!--
  billing.etzhayyim.com — monthly rollup (autonomous, cron 0 0 2 1 * ? = month 1st 02:00 UTC).

  Pipeline:
    1. billing.rollup.monthly     freeze last-month invoice draft per org from
                                  mv_billing_monthly_org × vertex_billing_org_plan
                                  (no Stripe push yet — that is generateInvoice).
    2. generic.audit.emit         OCEL trail.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_billing_rollup_monthly"
    targetNamespace="https://etzhayyim.ai/bpmn/billing"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="billing_rollup_monthly" name="billing monthly rollup (1st 02:00 UTC)" isExecutable="true">

    <bpmn:startEvent id="StartTimer" name="month 1st 02:00 UTC">
      <bpmn:outgoing>Flow_ToRollup</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 2 1 * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Rollup" name="freeze monthly invoice drafts">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="billing.rollup.monthly"/>
        <zeebe:ioMapping>
          <zeebe:output source="=invoicesDrafted" target="invoicesDrafted"/>
          <zeebe:output source="=totalJpyMicro" target="totalJpyMicro"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRollup</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToRollup" sourceRef="StartTimer" targetRef="Task_Rollup"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:billing.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.billing.rollupMonthly&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;invoicesDrafted&quot;: invoicesDrafted, &quot;totalJpyMicro&quot;: totalJpyMicro }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Rollup" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
