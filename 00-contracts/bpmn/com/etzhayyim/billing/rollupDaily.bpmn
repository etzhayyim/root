<?xml version="1.0" encoding="UTF-8"?>
<!--
  billing.etzhayyim.com — daily rollup (autonomous, cron 0 0 1 * * ? = 01:00 UTC daily).

  Pipeline:
    1. billing.rollup.daily       compute previous-day per-org × metric ×
                                  product totals from mv_billing_daily_org
                                  and snapshot a daily row in
                                  vertex_billing_event_daily_summary (or
                                  emit audit-only if data already current).
    2. generic.audit.emit         OCEL trail.

  No XRPC entry. Pure timer-start BPMN-as-actor (ADR-0056).
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_billing_rollup_daily"
    targetNamespace="https://etzhayyim.ai/bpmn/billing"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="billing_rollup_daily" name="billing daily rollup (01:00 UTC)" isExecutable="true">

    <bpmn:startEvent id="StartTimer" name="01:00 UTC daily">
      <bpmn:outgoing>Flow_ToRollup</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 1 * * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Rollup" name="rollup previous day">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="billing.rollup.daily"/>
        <zeebe:ioMapping>
          <zeebe:output source="=summarizedOrgs" target="summarizedOrgs"/>
          <zeebe:output source="=billedJpyMicro" target="billedJpyMicro"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRollup</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToRollup" sourceRef="StartTimer" targetRef="Task_Rollup"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:billing.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.billing.rollupDaily&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;summarizedOrgs&quot;: summarizedOrgs, &quot;billedJpyMicro&quot;: billedJpyMicro }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Rollup" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
