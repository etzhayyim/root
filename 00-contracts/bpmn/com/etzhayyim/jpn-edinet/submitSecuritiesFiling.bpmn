<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_jpn_edinet_submit_securities_filing"
    targetNamespace="https://etzhayyim.ai/bpmn/jpn-edinet"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="jpn_edinet_submit_securities_filing" name="金融庁 EDINET 有報" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Classify"/>
    <bpmn:serviceTask id="Task_Classify" name="分類">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT 1 AS ok LIMIT 1&quot;" target="query"/>
          <zeebe:input source="=[]" target="params"/>
          <zeebe:output source="=if docTypeCode = &quot;130&quot; then &quot;extraordinary&quot;
                                else if list contains([&quot;120&quot;,&quot;140&quot;,&quot;160&quot;], docTypeCode) then &quot;periodic&quot;
                                else &quot;routine&quot;" target="disclosureTier"/>
          <zeebe:output source="=docTypeCode = &quot;130&quot;" target="requireMarketNotice"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_Save</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Save" sourceRef="Task_Classify" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="filing 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_jpn_edinet_securities_filing&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id: vertexId, doc_id: docId, edinet_code: edinetCode,
              issuer_name: issuerName, doc_type_code: docTypeCode,
              doc_description: docDescription, fiscal_year_end: fiscalYearEnd,
              submitted_at: submittedAt, period_covered: periodCovered,
              disclosure_tier: disclosureTier, require_market_notice: requireMarketNotice,
              status: &quot;published&quot;, created_at: string(now()),
              owner_did: callerDid, sensitivity_ord: 1,
              org_id: edinetCode, user_id: callerDid, actor_id: &quot;sys.bpmn.jpn-edinet&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Save</bpmn:incoming><bpmn:outgoing>Flow_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Gate" sourceRef="Task_Save" targetRef="Gate"/>
    <bpmn:exclusiveGateway id="Gate" default="Flow_Log">
      <bpmn:incoming>Flow_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Major</bpmn:outgoing>
      <bpmn:outgoing>Flow_Log</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Major" sourceRef="Gate" targetRef="Task_AuditMajor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=requireMarketNotice = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Log" sourceRef="Gate" targetRef="Task_AuditLog"/>
    <bpmn:serviceTask id="Task_AuditMajor" name="audit jpnEdinet.filing.marketNotice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:jpn-edinet.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;jpnEdinet.filing.marketNotice&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, docId: docId, edinetCode: edinetCode, docTypeCode: docTypeCode, disclosureTier: disclosureTier}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Major</bpmn:incoming><bpmn:outgoing>Flow_EM</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EM" sourceRef="Task_AuditMajor" targetRef="End_M"/>
    <bpmn:serviceTask id="Task_AuditLog" name="audit jpnEdinet.filing.log">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:jpn-edinet.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;jpnEdinet.filing.log&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, docId: docId, edinetCode: edinetCode, docTypeCode: docTypeCode, disclosureTier: disclosureTier}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Log</bpmn:incoming><bpmn:outgoing>Flow_EL</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EL" sourceRef="Task_AuditLog" targetRef="End_L"/>
    <bpmn:endEvent id="End_L"><bpmn:incoming>Flow_EL</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_M"><bpmn:incoming>Flow_EM</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
