<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_jpn_edinet_record_material_event"
    targetNamespace="https://etzhayyim.ai/bpmn/jpn-edinet"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="jpn_edinet_record_material_event" name="金融庁 EDINET 臨報" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Classify"/>
    <bpmn:serviceTask id="Task_Classify" name="分類">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT 1 AS ok LIMIT 1&quot;" target="query"/>
          <zeebe:input source="=[]" target="params"/>
          <zeebe:output source="=if list contains([&quot;delisting&quot;,&quot;insider-trading&quot;,&quot;tob&quot;], eventType) then &quot;critical&quot;
                                else if list contains([&quot;merger&quot;,&quot;financial-restatement&quot;], eventType) then &quot;high&quot;
                                else if list contains([&quot;litigation&quot;,&quot;subsidiary-change&quot;,&quot;management-change&quot;], eventType) then &quot;medium&quot;
                                else &quot;low&quot;" target="priority"/>
          <zeebe:output source="=list contains([&quot;delisting&quot;,&quot;insider-trading&quot;,&quot;tob&quot;], eventType)" target="requireTradingHalt"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_Save</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Save" sourceRef="Task_Classify" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="event 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_jpn_edinet_material_event&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id: vertexId, event_id: eventId, edinet_code: edinetCode,
              issuer_name: issuerName, event_type: eventType, narrative: narrative,
              occurred_at: occurredAt, reported_at: reportedAt,
              priority: priority, require_trading_halt: requireTradingHalt,
              status: &quot;reported&quot;, created_at: string(now()),
              owner_did: callerDid, sensitivity_ord: 1,
              org_id: edinetCode, user_id: callerDid, actor_id: &quot;sys.bpmn.jpn-edinet&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Save</bpmn:incoming><bpmn:outgoing>Flow_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Gate" sourceRef="Task_Save" targetRef="Gate"/>
    <bpmn:exclusiveGateway id="Gate" default="Flow_Log">
      <bpmn:incoming>Flow_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Major</bpmn:outgoing>
      <bpmn:outgoing>Flow_Log</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Major" sourceRef="Gate" targetRef="Task_AuditMajor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=requireTradingHalt = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Log" sourceRef="Gate" targetRef="Task_AuditLog"/>
    <bpmn:serviceTask id="Task_AuditMajor" name="audit jpnEdinet.event.tradingHalt">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:jpn-edinet.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;jpnEdinet.event.tradingHalt&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, eventId: eventId, edinetCode: edinetCode, eventType: eventType, priority: priority}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Major</bpmn:incoming><bpmn:outgoing>Flow_EM</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EM" sourceRef="Task_AuditMajor" targetRef="End_M"/>
    <bpmn:serviceTask id="Task_AuditLog" name="audit jpnEdinet.event.log">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:jpn-edinet.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;jpnEdinet.event.log&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, eventId: eventId, edinetCode: edinetCode, eventType: eventType, priority: priority}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Log</bpmn:incoming><bpmn:outgoing>Flow_EL</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EL" sourceRef="Task_AuditLog" targetRef="End_L"/>
    <bpmn:endEvent id="End_L"><bpmn:incoming>Flow_EL</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_M"><bpmn:incoming>Flow_EM</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
