<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_legal_corpus_fetch_canlii_delta" targetNamespace="https://etzhayyim.ai/bpmn/legal-corpus" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="legal_corpus_fetch_canlii_delta" name="fetchCanLiiDelta" isExecutable="true">
    <bpmn:startEvent id="Start" name="every 24h"><bpmn:outgoing>Flow_F</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeCycle xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">R/PT24H</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Manual" name="manual"><bpmn:outgoing>Flow_FM</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_FM" sourceRef="Start_Manual" targetRef="Task_Key"/>
    <bpmn:sequenceFlow id="Flow_F" sourceRef="Start" targetRef="Task_Key"/>
    <bpmn:serviceTask id="Task_Key" name="load api key">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.select" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT secret_ref FROM vertex_legal_corpus_source WHERE source_id = 'canlii' LIMIT 1&quot;" target="sql"/>
          <zeebe:input source="=[]" target="params"/>
          <zeebe:output source="=rows[1].secret_ref" target="canliiKey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F</bpmn:incoming><bpmn:incoming>Flow_FM</bpmn:incoming><bpmn:outgoing>Flow_Fetch</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Fetch" sourceRef="Task_Key" targetRef="Task_Fetch"/>
    <bpmn:serviceTask id="Task_Fetch" name="canlii v1 cases">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.http.fetch" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;GET&quot;" target="method"/>
          <zeebe:input source="=&quot;https://api.canlii.org/v1/caseBrowse/en/csc-scc/?api_key=&quot; + canliiKey + &quot;&amp;decisionDateBegin=&quot; + (now - duration(&quot;PT24H&quot;))" target="url"/>
          <zeebe:output source="=bodyJson.cases" target="items"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Fetch</bpmn:incoming><bpmn:outgoing>Flow_L</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_L" sourceRef="Task_Fetch" targetRef="Task_Loop"/>
    <bpmn:callActivity id="Task_Loop" name="ingest each scc case" calledElement="legal_corpus_ingest_document">
      <bpmn:extensionElements><zeebe:calledElement processId="legal_corpus_ingest_document"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;canlii&quot;" target="sourceId"/>
          <zeebe:input source="=&quot;https://www.canlii.org/en/&quot; + item.databaseId + &quot;/&quot; + item.caseId.en" target="canonicalUri"/>
          <zeebe:input source="=&quot;opinion&quot;" target="documentType"/>
          <zeebe:input source="=&quot;CAN&quot;" target="jurisdiction"/>
          <zeebe:input source="=&quot;Supreme Court of Canada&quot;" target="court"/>
          <zeebe:input source="=item.language" target="languageCode"/>
          <zeebe:input source="=item.title" target="title"/>
          <zeebe:input source="=item.citation" target="citation"/>
          <zeebe:input source="=item.decisionDate" target="decidedAt"/>
          <zeebe:input source="=now" target="fetchedAt"/>
          <zeebe:input source="=1" target="sensitivityOrd"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_L</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false"><bpmn:extensionElements><zeebe:loopCharacteristics inputCollection="=items" inputElement="item"/></bpmn:extensionElements></bpmn:multiInstanceLoopCharacteristics>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Loop" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
