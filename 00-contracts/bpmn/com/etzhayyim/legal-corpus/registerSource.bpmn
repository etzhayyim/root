<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_legal_corpus_register_source" targetNamespace="https://etzhayyim.ai/bpmn/legal-corpus" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="legal_corpus_register_source" name="registerSource" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Insert"/>
    <bpmn:serviceTask id="Task_Insert" name="upsert source row">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_legal_corpus_source&quot;" target="table"/>
          <zeebe:input source="={vertex_id: &quot;at://did:web:legal-corpus.etzhayyim.com/com.etzhayyim.apps.legal-corpus.source/&quot; + sourceId, source_id: sourceId, display_name: displayName, base_url: baseUrl, jurisdictions_csv: jurisdictions, cadence_iso8601: cadenceIso8601, auth_strategy: authStrategy, secret_ref: secretRef, license: license, status: &quot;active&quot;, sensitivity_ord: 1, owner_did: &quot;did:web:legal-corpus.etzhayyim.com&quot;, created_at: now}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
          <zeebe:output source="=vertex_id" target="vertexId"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Insert" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
