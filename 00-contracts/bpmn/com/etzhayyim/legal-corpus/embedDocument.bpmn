<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_legal_corpus_embed_document" targetNamespace="https://etzhayyim.ai/bpmn/legal-corpus" exporter="hand-written" exporterVersion="2.0">
  <bpmn:process id="legal_corpus_embed_document" name="embedDocument" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Load"/>
    <bpmn:serviceTask id="Task_Load" name="load doc body">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.select" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT vertex_id, body_text FROM vertex_legal_corpus_document WHERE vertex_id = $1 LIMIT 1&quot;" target="sql"/>
          <zeebe:input source="=[vertexId]" target="params"/>
          <zeebe:output source="=rows[1]" target="doc"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_E</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_E" sourceRef="Task_Load" targetRef="Task_Embed"/>
    <bpmn:serviceTask id="Task_Embed" name="bge-m3 embed (local CPU)">
      <bpmn:extensionElements><zeebe:taskDefinition type="legal.corpus.embedText" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=doc.body_text" target="text"/>
          <zeebe:output source="=embedding" target="embedding"/>
          <zeebe:output source="=dim" target="embeddingDim"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_E</bpmn:incoming><bpmn:outgoing>Flow_U</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_U" sourceRef="Task_Embed" targetRef="Task_Update"/>
    <bpmn:serviceTask id="Task_Update" name="write embedding">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;UPDATE vertex_legal_corpus_document SET embedding_vec = $1::vector(1024), embedding_dim = $2, embedding_model = 'BAAI/bge-m3', embedding_at = now() WHERE vertex_id = $3&quot;" target="sql"/>
          <zeebe:input source="=[embedding, embeddingDim, vertexId]" target="params"/>
          <zeebe:output source="=updated" target="updated"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_U</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Update" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
