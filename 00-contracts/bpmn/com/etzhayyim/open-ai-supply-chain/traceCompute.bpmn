<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_ai_supply_chain_trace_compute" targetNamespace="https://etzhayyim.ai/bpmn/open-ai-supply-chain" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_ai_supply_chain_trace_compute" name="traceCompute" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_ai_supply_chain&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, trace_id: traceId, model_vid: modelVid, mineral_classification_vid: mineralClassificationVid, gpu_vendor_lei: gpuVendorLei, gpu_model: gpuModel, training_petaflop_days: trainingPetaflopDays, datacenter_iso3: datacenterIso3, traced_at: tracedAt, dependency_tier: if trainingPetaflopDays != null and trainingPetaflopDays &gt;= 10000 then &quot;frontier&quot; else if trainingPetaflopDays != null and trainingPetaflopDays &gt;= 100 then &quot;production&quot; else &quot;research&quot;, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-ai-supply-chain&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-ai-supply-chain.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;open.aiSupplyChain.traceCompute&quot;" target="action"/><zeebe:input source="={vertexId: vertexId}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>