<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_digital_twin_city_record_resilience_drill" targetNamespace="https://etzhayyim.ai/bpmn/open-digital-twin-city" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_digital_twin_city_record_resilience_drill" name="recordResilienceDrill" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_digital_twin_city&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, drill_id: drillId, twin_vid: twinVid, scenario: scenario, simulated_duration_hours: simulatedDurationHours, failure_cascade_count: failureCascadeCount, recovery_target_hours: recoveryTargetHours, executed_at: executedAt, preparedness_tier: if recoveryTargetHours != null and recoveryTargetHours &lt;= 4 then &quot;high&quot; else if recoveryTargetHours != null and recoveryTargetHours &lt;= 24 then &quot;moderate&quot; else &quot;low&quot;, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-digital-twin-city&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-digital-twin-city.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;open.digitalTwinCity.recordResilienceDrill&quot;" target="action"/><zeebe:input source="={vertexId: vertexId}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>