<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_stablecoin_reserves_record_attestation" targetNamespace="https://etzhayyim.ai/bpmn/open-stablecoin-reserves" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_stablecoin_reserves_record_attestation" name="recordAttestation" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_stablecoin_reserves&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, attestation_id: attestationId, issuer_lei: issuerLei, token_symbol: tokenSymbol, jurisdiction_iso3: jurisdictionIso3, issuance_circulating_usd: issuanceCirculatingUsd, reserve_cash_pct: reserveCashPct, reserve_tbill_pct: reserveTbillPct, reserve_reverse_repo_pct: reserveReverseRepoPct, reserve_other_pct: reserveOtherPct, attestor_lei: attestorLei, attested_at: attestedAt, reserve_quality_tier: if reserveCashPct != null and reserveCashPct &gt;= 20 and reserveTbillPct != null and reserveTbillPct &gt;= 70 then &quot;high_quality&quot; else if reserveCashPct != null and reserveCashPct &gt;= 5 then &quot;adequate&quot; else &quot;concerning&quot;, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-stablecoin-reserves&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-stablecoin-reserves.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;open.stablecoinReserves.recordAttestation&quot;" target="action"/><zeebe:input source="={vertexId: vertexId}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>