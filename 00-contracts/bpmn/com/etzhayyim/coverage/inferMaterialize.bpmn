<?xml version="1.0" encoding="UTF-8"?>
<!--
  coverage.inferMaterialize — promote clusters to actor DIDs (ADR-0056).

  Mirrors `etzhayyim coverage infer materialize`. Reads active clusters from
  `vertex_infer_cluster` for a batch and inserts one `vertex_actor` row
  per cluster (DID = `did:web:infer.etzhayyim.com:cluster:{batch}:{id}`).

  Trigger: XRPC only (caller decides when a batch is ready to promote).

  Pipeline:
    1. generic.db.select  — active clusters for the batch (latest if blank)
    2. multi-instance     — generic.db.insert vertex_actor (per cluster)
    3. generic.audit.emit — OCEL summary

  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/coverage-infer-materialize-v1
  NSID:      com.etzhayyim.apps.coverage.inferMaterialize
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_coverage_infer_materialize"
    targetNamespace="https://etzhayyim.ai/bpmn/coverage"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="coverage_infer_materialize" name="coverage infer materialize" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.coverage.inferMaterialize", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_PickBatch"/>

    <bpmn:serviceTask id="Task_PickBatch" name="resolve batch id">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_infer_cluster&quot;" target="table"/>
          <zeebe:input source="=&quot;batch_id, MAX(created_date) AS created_date&quot;" target="columns"/>
          <zeebe:input source="=if (batchId = null or batchId = &quot;&quot;) then &quot;status = 'active'&quot; else &quot;batch_id = %s AND status = 'active'&quot;" target="whereExpr"/>
          <zeebe:input source="=if (batchId = null or batchId = &quot;&quot;) then [] else [string(batchId)]" target="whereParams"/>
          <zeebe:input source="=&quot;batch_id&quot;" target="groupBy"/>
          <zeebe:input source="=&quot;created_date DESC&quot;" target="orderBy"/>
          <zeebe:input source="=1" target="limit"/>
          <zeebe:output source="=rows" target="batchRows"/>
          <zeebe:output source="=rowCount" target="batchCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_PickBatch" targetRef="Gateway_HasBatch"/>

    <bpmn:exclusiveGateway id="Gateway_HasBatch" name="batch?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Has</bpmn:outgoing>
      <bpmn:outgoing>Flow_None</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Has" sourceRef="Gateway_HasBatch" targetRef="Task_SelectClusters">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
                                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=batchCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_None" sourceRef="Gateway_HasBatch" targetRef="End">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
                                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=batchCount &lt;= 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_SelectClusters" name="select active clusters">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_infer_cluster&quot;" target="table"/>
          <zeebe:input source="=&quot;cluster_id, member_count, k_anonymity&quot;" target="columns"/>
          <zeebe:input source="=&quot;batch_id = %s AND status = 'active'&quot;" target="whereExpr"/>
          <zeebe:input source="=[string(batchRows[1].batch_id)]" target="whereParams"/>
          <zeebe:input source="=100" target="limit"/>
          <zeebe:input source="=&quot;cluster_id ASC&quot;" target="orderBy"/>
          <zeebe:output source="=rows" target="clusters"/>
          <zeebe:output source="=rowCount" target="clusterCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Has</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_SelectClusters" targetRef="Task_InsertActor"/>

    <bpmn:serviceTask id="Task_InsertActor" name="insert vertex_actor (per cluster)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_actor&quot;" target="table"/>
          <zeebe:input source="={
            &quot;vertex_id&quot;:    &quot;did:web:infer.etzhayyim.com:cluster:&quot; + batchRows[1].batch_id + &quot;:&quot; + string(cluster.cluster_id),
            &quot;did&quot;:          &quot;did:web:infer.etzhayyim.com:cluster:&quot; + batchRows[1].batch_id + &quot;:&quot; + string(cluster.cluster_id),
            &quot;name&quot;:         &quot;infer-cluster-&quot; + string(cluster.cluster_id),
            &quot;display_name&quot;: &quot;Statistical Cluster &quot; + string(cluster.cluster_id),
            &quot;performer_type&quot;: &quot;service&quot;,
            &quot;operator&quot;:     &quot;etzhayyim.co.jp&quot;
          }" target="values"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=clusters" inputElement="cluster"/>
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_InsertActor" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="emit materialize OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:coverage.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;coverage.inferMaterialize.batch&quot;" target="action"/>
          <zeebe:input source="={ &quot;batchId&quot;: batchRows[1].batch_id, &quot;materialized&quot;: clusterCount }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_None</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
