<?xml version="1.0" encoding="UTF-8"?>
<!--
  coverage.inferIngest — push talent-cohort rows into RisingWave (ADR-0056).

  Mirrors the DB-write half of `etzhayyim coverage infer ingest`. CSV/SDMX
  parsing stays CLI-side (filesystem); this BPMN actor exposes a
  uniform XRPC sink `{ source, rows[] }` so the CLI (or any other
  agent) hands off pre-parsed rows.

  Trigger: XRPC only. No timer — ingestion is a push, not a poll.

  Pipeline:
    1. generic.db.bulkInsert : vertex_talent_cohort, all rows in one
                               multi-row VALUES statement (1-RTT atomic)
    2. generic.audit.emit    : OCEL summary (source, count)

  Was: a multi-instance loop over `generic.db.insert`. Stress test 2026-04-27
  showed 1-of-10 row drop + 1.7 s/row latency under the loop pattern; the
  bulkInsert primitive collapses N round-trips into one and removes the
  per-row connection churn.

  DEPLOY GATE: this BPMN requires `pymagatama` image newer than
  open-lei-zeebe-20260426112309 (the version that registers
  `generic.db.bulkInsert`). Do not run `sync-bpmn-actors.py` `apply` on
  this file until the helm chart is rolled forward, otherwise the
  dispatcher will activate jobs the running worker can't claim.

  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/coverage-infer-ingest-v1
  NSID:      com.etzhayyim.apps.coverage.inferIngest
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_coverage_infer_ingest"
    targetNamespace="https://etzhayyim.ai/bpmn/coverage"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="coverage_infer_ingest" name="coverage infer ingest" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.coverage.inferIngest", "version": 1, "resultTimeoutMs": 300000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_Insert"/>

    <bpmn:serviceTask id="Task_Insert" name="bulk-insert vertex_talent_cohort">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.bulkInsert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_talent_cohort&quot;" target="table"/>
          <zeebe:input source="=for row in rows return {
            &quot;vertex_id&quot;:       &quot;talent-cohort:&quot; + (if (source = null) then &quot;ilostat&quot; else source) + &quot;:&quot; + row.country + &quot;:&quot; + row.iscoCode + &quot;:&quot; + row.sex + &quot;:&quot; + row.timePeriod,
            &quot;label&quot;:           &quot;TalentCohort&quot;,
            &quot;source&quot;:          if (source = null) then &quot;ilostat&quot; else source,
            &quot;isco_code&quot;:       row.iscoCode,
            &quot;country&quot;:         row.country,
            &quot;sex&quot;:             row.sex,
            &quot;time_period&quot;:     row.timePeriod,
            &quot;size_thousands&quot;:  row.sizeThousands
          }" target="rows"/>
          <zeebe:output source="=inserted" target="inserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Insert" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="emit ingest OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:coverage.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;coverage.inferIngest.batch&quot;" target="action"/>
          <zeebe:input source="={ &quot;source&quot;: if (source = null) then &quot;ilostat&quot; else source, &quot;rows&quot;: count(rows) }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End"><bpmn:incoming>Flow_3</bpmn:incoming></bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
