<?xml version="1.0" encoding="UTF-8"?>
<!--
  coverage.inferPersonCohorts — refresh historical population cohort data
  from UN WPP 2024 and update vertex_person_population_cohort (ADR-0056).

  Designed to run weekly to pick up annual UN WPP revision releases.
  Does NOT create 12B individual rows — each row represents an era×region
  population aggregate with BIGINT estimated_population.

  Trigger:
    timer-start R/P7D (every 7 days) AND XRPC (`com.etzhayyim.apps.coverage.inferPersonCohorts`).

  Pipeline:
    1. generic.db.select  — read current cohort watermark (latest era_end_year)
    2. generic.http.fetch — UN WPP 2024 summary API (contemporary era only)
    3. generic.db.insert  — upsert contemporary cohort with latest UN WPP estimate
    4. generic.db.select  — compute ancestor edge coverage (SELECT COUNT)
    5. generic.audit.emit — OCEL summary (cohorts refreshed, total estimated population)

  Note: prehistoric/ancient eras are seeded in migration
  20260428320000_vertex_person_population_cohort.ts and do not change
  week-to-week. Only the 'contemporary' cohort (2000-2025) is refreshed
  here via UN WPP API.

  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/coverage-infer-person-cohorts-v1
  NSID:      com.etzhayyim.apps.coverage.inferPersonCohorts
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_coverage_infer_person_cohorts"
    targetNamespace="https://etzhayyim.ai/bpmn/coverage"
    exporter="hand-written" exporterVersion="2.0">
  <bpmn:process id="coverage_infer_person_cohorts" name="coverage infer person cohorts" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.coverage.inferPersonCohorts", "version": 1, "resultTimeoutMs": 120000 }
    </bpmn:documentation>

    <!-- Timer start: every 7 days -->
    <bpmn:startEvent id="Start_Timer" name="every 7 days">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_P7D">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">R/P7D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Timer" targetRef="Task_ReadWatermark"/>

    <!-- Manual trigger entry point -->
    <bpmn:startEvent id="Start_Manual" name="manual trigger">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Start_Manual" targetRef="Task_ReadWatermark"/>

    <!-- Step 1: Read current watermark (latest contemporary row) -->
    <bpmn:serviceTask id="Task_ReadWatermark" name="read cohort watermark">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_person_population_cohort&quot;" target="table"/>
          <zeebe:input source="=&quot;era_label, era_end_year, estimated_population, created_at&quot;" target="columns"/>
          <zeebe:input source="=&quot;era_label = &apos;contemporary&apos; AND region_m49 = &apos;001&apos;&quot;" target="where"/>
          <zeebe:input source="=1" target="limit"/>
          <zeebe:output source="=rows"     target="existingRows"/>
          <zeebe:output source="=rowCount" target="existingCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ReadWatermark" targetRef="Task_FetchWPP"/>

    <!-- Step 2: Fetch UN WPP 2024 world total (latest annual estimate) -->
    <bpmn:serviceTask id="Task_FetchWPP" name="fetch UN WPP world population">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.http.fetch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;https://population.un.org/dataportalapi/api/v1/data/indicators/49/locations/900/start/2024/end/2025?format=json&amp;pageSize=1&amp;pageNumber=1&quot;" target="url"/>
          <zeebe:input source="=&quot;GET&quot;" target="method"/>
          <zeebe:input source="={ &quot;Accept&quot;: &quot;application/json&quot;, &quot;User-Agent&quot;: &quot;etzhayyim-coverage-bot/1.0 (coverage.etzhayyim.com)&quot; }" target="headers"/>
          <zeebe:output source="=body"   target="wppResponse"/>
          <zeebe:output source="=status" target="wppStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_FetchWPP" targetRef="Gateway_WppHealthy"/>
    <bpmn:exclusiveGateway id="Gateway_WppHealthy" name="WPP fetch healthy?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_3a</bpmn:outgoing>
      <bpmn:outgoing>Flow_WppDegraded</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_3a" sourceRef="Gateway_WppHealthy" targetRef="Task_UpsertCohort">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=wppStatus = 200</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_WppDegraded" sourceRef="Gateway_WppHealthy" targetRef="Task_AuditWppDegraded"/>

    <bpmn:serviceTask id="Task_AuditWppDegraded" name="audit WPP fetch degraded">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:coverage.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;coverage.inferPersonCohorts.fetchDegraded&quot;" target="action"/>
          <zeebe:input source="={&quot;reason&quot;: &quot;wpp_fetch_degraded_using_fallback&quot;, &quot;wpp_status&quot;: wppStatus, &quot;existing_count&quot;: existingCount}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_WppDegraded</bpmn:incoming>
      <bpmn:outgoing>Flow_WppDegradedToUpsert</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_WppDegradedToUpsert" sourceRef="Task_AuditWppDegraded" targetRef="Task_UpsertCohort"/>

    <!-- Step 3: Upsert contemporary cohort with latest estimate -->
    <bpmn:serviceTask id="Task_UpsertCohort" name="upsert contemporary cohort">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_person_population_cohort&quot;" target="table"/>
          <zeebe:input source="={
            &quot;vertex_id&quot;:            &quot;at://did:web:natural-person.etzhayyim.com/com.etzhayyim.apps.naturalPerson.populationCohort/contemporary-001-2000&quot;,
            &quot;_seq&quot;:                  1,
            &quot;sensitivity_ord&quot;:       0,
            &quot;owner_did&quot;:             &quot;did:web:natural-person.etzhayyim.com&quot;,
            &quot;rkey&quot;:                  &quot;contemporary-001-2000&quot;,
            &quot;repo&quot;:                  &quot;at://did:web:natural-person.etzhayyim.com&quot;,
            &quot;era_label&quot;:             &quot;contemporary&quot;,
            &quot;era_start_year&quot;:        2000,
            &quot;era_end_year&quot;:          2025,
            &quot;region_m49&quot;:            &quot;001&quot;,
            &quot;region_name&quot;:           &quot;World&quot;,
            &quot;estimated_population&quot;:  if (wppStatus = 200 and wppResponse.data != null and count(wppResponse.data) > 0) then wppResponse.data[1].value else 8200000000,
            &quot;population_low&quot;:         8100000000,
            &quot;population_high&quot;:        8300000000,
            &quot;life_expectancy&quot;:        73,
            &quot;birth_rate&quot;:             18,
            &quot;death_rate&quot;:             8,
            &quot;infant_mortality_rate&quot;:  28,
            &quot;data_source&quot;:            &quot;un_wpp_2024&quot;,
            &quot;confidence_level&quot;:       &quot;high&quot;,
            &quot;cohort_did&quot;:             &quot;did:web:natural-person.etzhayyim.com:pop:contemporary-001-2000&quot;,
            &quot;actor_did&quot;:              &quot;did:web:natural-person.etzhayyim.com&quot;,
            &quot;org_did&quot;:               &quot;did:web:natural-person.etzhayyim.com&quot;,
            &quot;created_at&quot;:             now()
          }" target="row"/>
          <zeebe:output source="=inserted" target="upsertResult"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3a</bpmn:incoming>
      <bpmn:incoming>Flow_WppDegradedToUpsert</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_UpsertCohort" targetRef="Task_ReadSummary"/>

    <!-- Step 4: Read MV summary for audit payload -->
    <bpmn:serviceTask id="Task_ReadSummary" name="read era summary MV">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;mv_person_cohort_era_summary&quot;" target="table"/>
          <zeebe:input source="=&quot;era_label, era_start_year, era_end_year, cohort_count, total_population&quot;" target="columns"/>
          <zeebe:input source="=20" target="limit"/>
          <zeebe:input source="=&quot;era_start_year ASC&quot;" target="orderBy"/>
          <zeebe:output source="=rows"     target="eraSummary"/>
          <zeebe:output source="=rowCount" target="eraCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ReadSummary" targetRef="Task_Audit"/>

    <!-- Step 5: OCEL audit -->
    <bpmn:serviceTask id="Task_Audit" name="emit person cohort OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:coverage.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;coverage.inferPersonCohorts.refresh&quot;" target="action"/>
          <zeebe:input source="={
            &quot;eras_tracked&quot;:       eraCount,
            &quot;wpp_status&quot;:         wppStatus,
            &quot;contemporary_pop&quot;:   if (count(eraSummary) > 0) then eraSummary[count(eraSummary)].total_population else 0,
            &quot;era_summary&quot;:        eraSummary
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End"><bpmn:incoming>Flow_6</bpmn:incoming></bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
