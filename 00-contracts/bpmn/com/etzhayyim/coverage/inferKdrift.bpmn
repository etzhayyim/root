<?xml version="1.0" encoding="UTF-8"?>
<!--
  coverage.inferKdrift — k-anonymity drift watch (pilot per ADR-0056).

  Mirrors `etzhayyim coverage infer kdrift`. Pure SQL against the streaming MV
  `mv_cohort_k_drift` (RisingWave). Surfaces low-k cohorts that risk
  re-identification.

  Trigger:
    timer-start R/PT15M (every 15 min) AND XRPC (`com.etzhayyim.apps.coverage.inferKdrift`).

  Pipeline:
    1. generic.db.select  — top-N cohorts ordered by k_proxy ASC
    2. generic.audit.emit — OCEL summary (cohort count + min k_proxy)

  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/coverage-infer-kdrift-v1
  NSID:      com.etzhayyim.apps.coverage.inferKdrift
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_coverage_infer_kdrift"
    targetNamespace="https://etzhayyim.ai/bpmn/coverage"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="coverage_infer_kdrift" name="coverage infer kdrift" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.coverage.inferKdrift", "version": 1, "resultTimeoutMs": 30000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="every 15 minutes">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_PT15M">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">R/PT15M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_Select"/>

    <bpmn:serviceTask id="Task_Select" name="select k-drift cohorts">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;mv_cohort_k_drift&quot;" target="table"/>
          <zeebe:input source="=&quot;cohort_did, distinct_signal_kinds, evidence_count, k_proxy&quot;" target="columns"/>
          <zeebe:input source="=if (limit = null) then 100 else limit" target="limit"/>
          <zeebe:input source="=&quot;k_proxy ASC&quot;" target="orderBy"/>
          <zeebe:output source="=rows"     target="rows"/>
          <zeebe:output source="=rowCount" target="rowCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Select" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="emit kdrift OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:coverage.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;coverage.inferKdrift.tick&quot;" target="action"/>
          <zeebe:input source="={ &quot;cohorts&quot;: rowCount }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
