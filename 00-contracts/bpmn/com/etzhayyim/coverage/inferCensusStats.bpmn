<?xml version="1.0" encoding="UTF-8"?>
<!--
  coverage.inferCensusStats — weekly demographic statistics refresh
  Fetches UN WPP 2024 / World Bank / WHO / ILO population data and
  upserts vertex_natural_person_demographic_stat for registered sources.

  Trigger:
    timer-start R/P7D (every 7 days) AND XRPC (com.etzhayyim.apps.coverage.inferCensusStats).

  Pipeline:
    1. generic.db.select  — read registered census sources (vertex_natural_person_census_source)
    2. generic.db.select  — read existing stat watermark (latest data_year per country)
    3. generic.http.fetch — UN WPP 2024 summary API (population by country × age × gender)
    4. generic.llm.json   — normalize raw API response to 16-dimension stat rows
    5. generic.db.insert  — upsert vertex_natural_person_demographic_stat rows
    6. generic.audit.emit — OCEL event (statsRefreshed, countries, sources)

  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/coverage-infer-census-stats-v1
  NSID:      com.etzhayyim.apps.coverage.inferCensusStats
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="coverageInferCensusStats"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler"
    exporterVersion="2.0">

  <bpmn:process id="coverage_infer_census_stats_v1" name="coverage.inferCensusStats" isExecutable="true">

    <bpmn:startEvent id="Start_Timer" name="R/P7D timer">
      <bpmn:outgoing>Flow_timer_to_sources</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_7D">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P7D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:startEvent id="Start_Manual" name="XRPC trigger">
      <bpmn:outgoing>Flow_manual_to_sources</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_ReadSources" name="Read census sources">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT source_id, source_name, source_org, source_url, data_year FROM vertex_natural_person_census_source WHERE status = &apos;registered&apos; ORDER BY data_year DESC LIMIT 10&quot;" target="query"/>
          <zeebe:input source="=60000" target="resultTimeoutMs"/>
          <zeebe:output source="=rows" target="censusSources"/>
          <zeebe:output source="=rowCount" target="sourceCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_timer_to_sources</bpmn:incoming>
      <bpmn:incoming>Flow_manual_to_sources</bpmn:incoming>
      <bpmn:outgoing>Flow_sources_to_gate</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_HasSources" name="has census sources?">
      <bpmn:incoming>Flow_sources_to_gate</bpmn:incoming>
      <bpmn:outgoing>Flow_sources_to_watermark</bpmn:outgoing>
      <bpmn:outgoing>Flow_no_sources_to_audit</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_ReadWatermark" name="Read stat watermark">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT country, MAX(data_year) AS max_year FROM vertex_natural_person_demographic_stat GROUP BY country LIMIT 300&quot;" target="query"/>
          <zeebe:input source="=60000" target="resultTimeoutMs"/>
          <zeebe:output source="=rows" target="watermarks"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_sources_to_watermark</bpmn:incoming>
      <bpmn:outgoing>Flow_watermark_to_fetch</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_FetchUnWpp" name="Fetch UN WPP summary">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.http.fetch" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;https://population.un.org/wpp/Download/Files/1_Indicators%20(Standard)/CSV_FILES/WPP2024_PopulationBySingleAgeSex_Medium_1950-2023.zip&quot;" target="url"/>
          <zeebe:input source="=&quot;GET&quot;" target="method"/>
          <zeebe:input source="={&quot;Accept&quot;: &quot;application/json&quot;}" target="headers"/>
          <zeebe:input source="=120000" target="resultTimeoutMs"/>
          <zeebe:output source="=body" target="wppRawData"/>
          <zeebe:output source="=status" target="fetchStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_watermark_to_fetch</bpmn:incoming>
      <bpmn:outgoing>Flow_fetch_to_normalize</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_NormalizeStats" name="Normalize to 16-dimension stat rows">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.json" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="={
            &quot;task&quot;: &quot;normalize_census_stats&quot;,
            &quot;instructions&quot;: &quot;Parse the UN WPP summary data and return an array of demographic stat rows. Each row must have: country (ISO-3), ageMin, ageMax, gender (M/F/T), populationCount (integer), populationShare (0-1 float), dataYear (int), vitalStatus (alive/deceased), era (modern/industrial), statType (population). Limit to 100 rows covering top-10 countries × age groups × gender.&quot;,
            &quot;rawData&quot;: wppRawData,
            &quot;watermarks&quot;: watermarks,
            &quot;outputSchema&quot;: {&quot;stats&quot;: [{&quot;country&quot;: &quot;string&quot;, &quot;ageMin&quot;: &quot;string&quot;, &quot;ageMax&quot;: &quot;string&quot;, &quot;gender&quot;: &quot;string&quot;, &quot;populationCount&quot;: &quot;number&quot;, &quot;populationShare&quot;: &quot;number&quot;, &quot;dataYear&quot;: &quot;number&quot;, &quot;vitalStatus&quot;: &quot;string&quot;, &quot;era&quot;: &quot;string&quot;, &quot;statType&quot;: &quot;string&quot;}]}
          }" target="prompt"/>
          <zeebe:input source="=120000" target="resultTimeoutMs"/>
          <zeebe:output source="=result.stats" target="normalizedStats"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_fetch_to_normalize</bpmn:incoming>
      <bpmn:outgoing>Flow_normalize_to_insert</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_InsertStats" name="Upsert demographic stat rows">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_natural_person_demographic_stat&quot;" target="table"/>
          <zeebe:input source="=normalizedStats" target="rows"/>
          <zeebe:input source="=180000" target="resultTimeoutMs"/>
          <zeebe:output source="=rowsAffected" target="statsInserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_normalize_to_insert</bpmn:incoming>
      <bpmn:outgoing>Flow_insert_to_audit</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Audit" name="OCEL audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="={
            &quot;eventType&quot;: &quot;coverage.censusStats.refresh&quot;,
            &quot;actorDid&quot;: &quot;did:web:natural-person.etzhayyim.com&quot;,
            &quot;attributes&quot;: {
              &quot;statsInserted&quot;: statsInserted,
              &quot;sourcesRead&quot;: count(censusSources),
              &quot;fetchStatus&quot;: fetchStatus,
              &quot;trigger&quot;: &quot;R/P7D&quot;
            }
          }" target="event"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_insert_to_audit</bpmn:incoming>
      <bpmn:outgoing>Flow_audit_to_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_AuditNoSources" name="audit no census sources">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="={
            &quot;eventType&quot;: &quot;coverage.censusStats.abort&quot;,
            &quot;actorDid&quot;: &quot;did:web:natural-person.etzhayyim.com&quot;,
            &quot;attributes&quot;: {
              &quot;reason&quot;: &quot;no_registered_census_sources&quot;,
              &quot;sourcesRead&quot;: sourceCount
            }
          }" target="event"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_no_sources_to_audit</bpmn:incoming>
      <bpmn:outgoing>Flow_no_sources_to_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End" name="Done">
      <bpmn:incoming>Flow_audit_to_end</bpmn:incoming>
      <bpmn:incoming>Flow_no_sources_to_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_timer_to_sources" sourceRef="Start_Timer" targetRef="Task_ReadSources"/>
    <bpmn:sequenceFlow id="Flow_manual_to_sources" sourceRef="Start_Manual" targetRef="Task_ReadSources"/>
    <bpmn:sequenceFlow id="Flow_sources_to_gate" sourceRef="Task_ReadSources" targetRef="Gateway_HasSources"/>
    <bpmn:sequenceFlow id="Flow_sources_to_watermark" sourceRef="Gateway_HasSources" targetRef="Task_ReadWatermark">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=sourceCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_no_sources_to_audit" sourceRef="Gateway_HasSources" targetRef="Task_AuditNoSources"/>
    <bpmn:sequenceFlow id="Flow_watermark_to_fetch" sourceRef="Task_ReadWatermark" targetRef="Task_FetchUnWpp"/>
    <bpmn:sequenceFlow id="Flow_fetch_to_normalize" sourceRef="Task_FetchUnWpp" targetRef="Task_NormalizeStats"/>
    <bpmn:sequenceFlow id="Flow_normalize_to_insert" sourceRef="Task_NormalizeStats" targetRef="Task_InsertStats"/>
    <bpmn:sequenceFlow id="Flow_insert_to_audit" sourceRef="Task_InsertStats" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_audit_to_end" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:sequenceFlow id="Flow_no_sources_to_end" sourceRef="Task_AuditNoSources" targetRef="End"/>

  </bpmn:process>
</bpmn:definitions>
