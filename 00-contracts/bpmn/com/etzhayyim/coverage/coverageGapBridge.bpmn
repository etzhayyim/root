<?xml version="1.0" encoding="UTF-8"?>
<!--
  coverage.coverageGapBridge — Von Neumann gap-bridge orchestrator (ADR-0056).

  Reads vertex_coverage_recipe as stored-program memory. Each recipe row
  classifies one (domain, authority_kind) cell into:
    ingest   — pure data pull (OFAC SDN, GLEIF, gov open data …)
    infer    — SQL UDF classify + LLM structured output (fast/structured tier)
    generate — LangGraph multi-hop synthesis (business_person, legal_aid …)
    hybrid   — ingest then re-classify with LLM
    defer    — world_total too large; no actionable path (webpage, photos …)

  Timer-start R/PT6H → scan for highest-regret gap → route per recipe_kind.

  Pipeline:
    1. coverage.gap.scan        : SELECT minimax worst-case domain from recipe
    2. exclusive gateway         : branch on recipe_kind
    3a. coverage.gap.ingest     : pure HTTP fetch → vertex_* INSERT (crypto_asset_freeze OFAC etc.)
    3b. coverage.gap.infer      : SQL UDF classify + call_tier LLM → INSERT row
    3c. coverage.gap.generate   : LangGraph graph (business_person_synth_v1 etc.) → INSERT rows
    4. generic.audit.emit        : OCEL event (domain, kind, rows_written)

  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/coverage-gap-bridge-v1
  NSID:      com.etzhayyim.apps.coverage.coverageGapBridge
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_coverage_gap_bridge"
    targetNamespace="https://etzhayyim.ai/bpmn/coverage"
    exporter="hand-written" exporterVersion="2.0">

  <bpmn:process id="coverage_gap_bridge" name="coverage gap bridge" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.coverage.coverageGapBridge", "version": 1, "resultTimeoutMs": 900000 }
    </bpmn:documentation>

    <!-- Timer-start: every 6 hours -->
    <bpmn:startEvent id="Start_Timer" name="R/PT6H">
      <bpmn:outgoing>Flow_timer_sync</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">R/PT6H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_timer_sync" sourceRef="Start_Timer" targetRef="Task_StatsSync"/>

    <!-- 0. Sync live coverage stats → vertex_coverage_stats (real regret) -->
    <bpmn:serviceTask id="Task_StatsSync" name="coverage.gap.stats.sync">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="coverage.gap.stats.sync"/>
        <zeebe:ioMapping>
          <zeebe:output source="=rowsSynced" target="statsSynced"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_timer_sync</bpmn:incoming>
      <bpmn:outgoing>Flow_sync_scan</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_sync_scan" sourceRef="Task_StatsSync" targetRef="Task_Scan"/>

    <!-- 1. Scan minimax worst-case domain from recipe -->
    <bpmn:serviceTask id="Task_Scan" name="coverage.gap.scan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="coverage.gap.scan"/>
        <zeebe:ioMapping>
          <zeebe:output source="=domain"      target="domain"/>
          <zeebe:output source="=recipeKind"  target="recipeKind"/>
          <zeebe:output source="=llmTier"     target="llmTier"/>
          <zeebe:output source="=langgraphId" target="langgraphId"/>
          <zeebe:output source="=worldTotal"  target="worldTotal"/>
          <zeebe:output source="=collected"   target="collected"/>
          <zeebe:output source="=regret"      target="regret"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_sync_scan</bpmn:incoming>
      <bpmn:outgoing>Flow_scan_gw</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_scan_gw" sourceRef="Task_Scan" targetRef="GW_Recipe"/>

    <!-- Exclusive gateway on recipe_kind -->
    <bpmn:exclusiveGateway id="GW_Recipe" name="recipe_kind?">
      <bpmn:incoming>Flow_scan_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_ingest</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_infer</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_generate</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_defer</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- ingest branch -->
    <bpmn:sequenceFlow id="Flow_gw_ingest" sourceRef="GW_Recipe" targetRef="Task_Ingest">
      <bpmn:conditionExpression>=recipeKind = "ingest" or recipeKind = "hybrid"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_Ingest" name="coverage.gap.ingest">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="coverage.gap.ingest"/>
        <zeebe:ioMapping>
          <zeebe:input source="=domain"     target="domain"/>
          <zeebe:input source="=worldTotal" target="worldTotal"/>
          <zeebe:output source="=rowsWritten" target="rowsWritten"/>
          <zeebe:output source="=ok"          target="ok"/>
          <zeebe:output source="=error"       target="ingestError"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_gw_ingest</bpmn:incoming>
      <bpmn:outgoing>Flow_ingest_audit</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_ingest_audit" sourceRef="Task_Ingest" targetRef="Task_Audit"/>

    <!-- infer branch -->
    <bpmn:sequenceFlow id="Flow_gw_infer" sourceRef="GW_Recipe" targetRef="Task_Infer">
      <bpmn:conditionExpression>=recipeKind = "infer"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_Infer" name="coverage.gap.infer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="coverage.gap.infer"/>
        <zeebe:ioMapping>
          <zeebe:input source="=domain"   target="domain"/>
          <zeebe:input source="=llmTier"  target="llmTier"/>
          <zeebe:output source="=rowsWritten" target="rowsWritten"/>
          <zeebe:output source="=ok"          target="ok"/>
          <zeebe:output source="=error"       target="inferError"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_gw_infer</bpmn:incoming>
      <bpmn:outgoing>Flow_infer_audit</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_infer_audit" sourceRef="Task_Infer" targetRef="Task_Audit"/>

    <!-- generate branch -->
    <bpmn:sequenceFlow id="Flow_gw_generate" sourceRef="GW_Recipe" targetRef="Task_Generate">
      <bpmn:conditionExpression>=recipeKind = "generate"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_Generate" name="coverage.gap.generate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="coverage.gap.generate"/>
        <zeebe:ioMapping>
          <zeebe:input source="=domain"       target="domain"/>
          <zeebe:input source="=langgraphId"  target="langgraphId"/>
          <zeebe:input source="=worldTotal"   target="worldTotal"/>
          <zeebe:output source="=rowsWritten" target="rowsWritten"/>
          <zeebe:output source="=ok"          target="ok"/>
          <zeebe:output source="=error"       target="generateError"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_gw_generate</bpmn:incoming>
      <bpmn:outgoing>Flow_generate_audit</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_generate_audit" sourceRef="Task_Generate" targetRef="Task_Audit"/>

    <!-- defer branch → skip to audit with rowsWritten=0 -->
    <bpmn:sequenceFlow id="Flow_gw_defer" sourceRef="GW_Recipe" targetRef="Task_Audit">
      <bpmn:conditionExpression>=recipeKind = "defer" or (recipeKind != "ingest" and recipeKind != "hybrid" and recipeKind != "infer" and recipeKind != "generate")</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- 4. OCEL audit -->
    <bpmn:serviceTask id="Task_Audit" name="generic.audit.emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;coverage.gapBridge&quot;" target="eventType"/>
          <zeebe:input source="={
            &quot;domain&quot;:     domain,
            &quot;recipeKind&quot;: recipeKind,
            &quot;rowsWritten&quot;: if (rowsWritten = null) then 0 else rowsWritten,
            &quot;worldTotal&quot;:  worldTotal,
            &quot;regret&quot;:     regret
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ingest_audit</bpmn:incoming>
      <bpmn:incoming>Flow_infer_audit</bpmn:incoming>
      <bpmn:incoming>Flow_generate_audit</bpmn:incoming>
      <bpmn:incoming>Flow_gw_defer</bpmn:incoming>
      <bpmn:outgoing>Flow_audit_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_audit_end" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End">
      <bpmn:incoming>Flow_audit_end</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
