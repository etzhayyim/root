<?xml version="1.0" encoding="UTF-8"?>
<!--
  coverage.inferDiscover — GMM cluster discovery (ADR-0056 BPMN actor).

  Mirrors `etzhayyim coverage infer discover` for the in-DB path. Caller uploads
  rows to `vertex_infer_input` first (see `com.etzhayyim.apps.coverage.inferIngest`),
  then triggers this with `{ batchId, k }`. The Python UDF `gmm_fit` runs
  inside RisingWave (Arrow Flight, ADR-0049) — no client-side compute.

  Trigger: XRPC only. Caller supplies `{ batchId, k }`; if `batchId` is
  omitted, the freshest batch in `vertex_infer_input` is used.

  Pipeline:
    1. generic.db.select  — pick batch (caller-given or freshest)
    2. generic.db.select  — call `gmm_fit(features, k)` over the batch
    3. multi-instance     — generic.db.insert one vertex_infer_cluster row per cluster
    4. generic.audit.emit — OCEL summary

  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/coverage-infer-discover-v1
  NSID:      com.etzhayyim.apps.coverage.inferDiscover
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_coverage_infer_discover"
    targetNamespace="https://etzhayyim.ai/bpmn/coverage"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="coverage_infer_discover" name="coverage infer discover" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.coverage.inferDiscover", "version": 1, "resultTimeoutMs": 120000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_PickBatch"/>

    <!-- Step 1 — resolve the batch to operate on. -->
    <bpmn:serviceTask id="Task_PickBatch" name="resolve batch id">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_infer_input&quot;" target="table"/>
          <zeebe:input source="=&quot;DISTINCT batch_id, MAX(created_date) AS created_date&quot;" target="columns"/>
          <zeebe:input source="=if (batchId = null or batchId = &quot;&quot;) then &quot;TRUE&quot; else &quot;batch_id = %s&quot;" target="whereExpr"/>
          <zeebe:input source="=if (batchId = null or batchId = &quot;&quot;) then [] else [string(batchId)]" target="whereParams"/>
          <zeebe:input source="=&quot;batch_id&quot;" target="groupBy"/>
          <zeebe:input source="=&quot;created_date DESC&quot;" target="orderBy"/>
          <zeebe:input source="=1" target="limit"/>
          <zeebe:output source="=rows" target="batchRows"/>
          <zeebe:output source="=rowCount" target="batchCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_PickBatch" targetRef="Gateway_HasBatch"/>

    <bpmn:exclusiveGateway id="Gateway_HasBatch" name="batch?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Has</bpmn:outgoing>
      <bpmn:outgoing>Flow_None</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Has" sourceRef="Gateway_HasBatch" targetRef="Task_Fit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
                                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=batchCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_None" sourceRef="Gateway_HasBatch" targetRef="End">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
                                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=batchCount &lt;= 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Step 2 — run gmm_fit UDF inside RisingWave. Returns JSONB array of clusters. -->
    <bpmn:serviceTask id="Task_Fit" name="gmm_fit (RisingWave Python UDF)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_infer_input&quot;" target="table"/>
          <zeebe:input source="=&quot;gmm_fit(features, %s) AS clusters&quot;" target="columns"/>
          <zeebe:input source="=[if (k = null) then 8 else k]" target="columnsParams"/>
          <zeebe:input source="=&quot;batch_id = %s&quot;" target="whereExpr"/>
          <zeebe:input source="=[string(batchRows[1].batch_id)]" target="whereParams"/>
          <zeebe:input source="=1" target="limit"/>
          <zeebe:output source="=rows[1].clusters" target="clusters"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Has</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Fit" targetRef="Task_InsertClusters"/>

    <!-- Step 3 — fan-out one INSERT per cluster. Multi-instance parallel. -->
    <bpmn:serviceTask id="Task_InsertClusters" name="insert vertex_infer_cluster (per cluster)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_infer_cluster&quot;" target="table"/>
          <zeebe:input source="={
            &quot;vertex_id&quot;: &quot;infer-cluster:&quot; + batchRows[1].batch_id + &quot;:&quot; + string(cluster.id),
            &quot;cluster_id&quot;: cluster.id,
            &quot;batch_id&quot;: batchRows[1].batch_id,
            &quot;method&quot;: &quot;gmm&quot;,
            &quot;member_count&quot;: cluster.member_count,
            &quot;k_anonymity&quot;: cluster.member_count,
            &quot;features_avg&quot;: cluster.centroid,
            &quot;status&quot;: &quot;active&quot;
          }" target="values"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=clusters" inputElement="cluster"/>
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_InsertClusters" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="emit discover OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:coverage.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;coverage.inferDiscover.batch&quot;" target="action"/>
          <zeebe:input source="={ &quot;batchId&quot;: batchRows[1].batch_id, &quot;clusters&quot;: count(clusters) }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_None</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
