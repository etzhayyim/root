<?xml version="1.0" encoding="UTF-8"?>
<!--
  coverage.inferDeceasedCohorts — Phase 1C of natural-person entity inference.

  Reads vertex_person_population_cohort (world-level era aggregates) and
  refreshes vertex_natural_person_cohort_person deceased rows to keep
  intel_estimated_count in sync with updated population estimates.

  Also discovers newly-registered vertex_natural_person rows (living persons)
  and connects them to the contemporary population cohort via edge_cohort_derived,
  strengthening the existence of the living-person graph.

  Trigger:
    timer-start R/P30D (monthly) AND XRPC (`com.etzhayyim.apps.coverage.inferDeceasedCohorts`).

  Pipeline:
    1. generic.db.select  — read era summary from mv_person_cohort_era_summary
    2. generic.db.select  — count deceased cohort persons already seeded
    3. generic.db.select  — count living vertex_natural_person rows (for coverage)
    4. generic.db.select  — read un-linked living persons (no edge_cohort_derived)
    5. generic.db.insert  — bulk-link up to 1000 living persons to contemporary cohort
    6. generic.audit.emit — OCEL summary

  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/coverage-infer-deceased-cohorts-v1
  NSID:      com.etzhayyim.apps.coverage.inferDeceasedCohorts
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_coverage_infer_deceased_cohorts"
    targetNamespace="https://etzhayyim.ai/bpmn/coverage"
    exporter="hand-written" exporterVersion="2.0">
  <bpmn:process id="coverage_infer_deceased_cohorts" name="coverage infer deceased cohorts" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.coverage.inferDeceasedCohorts", "version": 1, "resultTimeoutMs": 180000 }
    </bpmn:documentation>

    <!-- Timer: monthly -->
    <bpmn:startEvent id="Start_Timer" name="every 30 days">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_P30D">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">R/P30D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:startEvent id="Start_Manual" name="manual trigger">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_0" sourceRef="Start_Manual" targetRef="Task_ReadEraSummary"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Timer" targetRef="Task_ReadEraSummary"/>

    <!-- Step 1: Read era population summary -->
    <bpmn:serviceTask id="Task_ReadEraSummary" name="read era cohort summary">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;mv_person_cohort_era_summary&quot;" target="table"/>
          <zeebe:input source="=&quot;era_label, era_start_year, era_end_year, cohort_count, total_population, avg_life_expectancy&quot;" target="columns"/>
          <zeebe:input source="=20" target="limit"/>
          <zeebe:input source="=&quot;era_start_year ASC&quot;" target="orderBy"/>
          <zeebe:output source="=rows"     target="eraSummary"/>
          <zeebe:output source="=rowCount" target="eraCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ReadEraSummary" targetRef="Task_CountDeceased"/>

    <!-- Step 2: Count existing deceased cohort persons -->
    <bpmn:serviceTask id="Task_CountDeceased" name="count deceased cohort persons">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_natural_person_cohort_person&quot;" target="table"/>
          <zeebe:input source="=&quot;COUNT(*) AS cnt, SUM(intel_estimated_count) AS total_represented&quot;" target="columns"/>
          <zeebe:input source="=&quot;vital_status = &apos;deceased&apos;&quot;" target="where"/>
          <zeebe:input source="=1" target="limit"/>
          <zeebe:output source="=rows[1]"  target="deceasedStats"/>
          <zeebe:output source="=rowCount" target="deceasedCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_CountDeceased" targetRef="Task_ReadUnlinkedPersons"/>

    <!-- Step 3: Read living persons not yet linked to population cohort -->
    <!-- Finds vertex_natural_person rows with no matching edge_cohort_derived.dst_vid -->
    <bpmn:serviceTask id="Task_ReadUnlinkedPersons" name="read unlinked living persons">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_natural_person&quot;" target="table"/>
          <zeebe:input source="=&quot;vertex_id, owner_did&quot;" target="columns"/>
          <zeebe:input source="=if (batchSize = null) then 500 else batchSize" target="limit"/>
          <zeebe:input source="=&quot;vertex_id ASC&quot;" target="orderBy"/>
          <zeebe:output source="=rows"     target="unlinkedPersons"/>
          <zeebe:output source="=rowCount" target="unlinkedCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ReadUnlinkedPersons" targetRef="Gateway_HasUnlinkedPersons"/>
    <bpmn:exclusiveGateway id="Gateway_HasUnlinkedPersons" name="has unlinked persons?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_4a</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoUnlinkedPersons</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_4a" sourceRef="Gateway_HasUnlinkedPersons" targetRef="Task_LinkLivingPersons">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=unlinkedCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoUnlinkedPersons" sourceRef="Gateway_HasUnlinkedPersons" targetRef="Task_AuditNoUnlinkedPersons"/>

    <!-- Step 4: Link living persons to contemporary population cohort -->
    <bpmn:serviceTask id="Task_LinkLivingPersons" name="link living persons to contemporary cohort">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.bulkInsert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;edge_cohort_ancestor_of&quot;" target="table"/>
          <zeebe:input source="=for p in unlinkedPersons return {
            &quot;edge_id&quot;:         &quot;at://did:web:natural-person.etzhayyim.com/com.etzhayyim.apps.naturalPerson.cohortAncestorOf/living-&quot; + substring(p.vertex_id, 80),
            &quot;src_vid&quot;:         &quot;at://did:web:natural-person.etzhayyim.com/com.etzhayyim.apps.naturalPerson.populationCohort/contemporary-001-2000&quot;,
            &quot;dst_vid&quot;:         p.vertex_id,
            &quot;_seq&quot;:            1,
            &quot;sensitivity_ord&quot;:  0,
            &quot;owner_did&quot;:        &quot;did:web:natural-person.etzhayyim.com&quot;,
            &quot;generation_offset&quot;: 0,
            &quot;temporal_gap_years&quot;: 0,
            &quot;confidence&quot;:       0.7,
            &quot;lineage_type&quot;:     &quot;statistical_membership&quot;,
            &quot;actor_did&quot;:        &quot;did:web:natural-person.etzhayyim.com&quot;,
            &quot;org_did&quot;:          &quot;did:web:natural-person.etzhayyim.com&quot;,
            &quot;created_at&quot;:       now()
          }" target="rows"/>
          <zeebe:output source="=inserted" target="linkedCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4a</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_LinkLivingPersons" targetRef="Task_Audit"/>

    <!-- Step 5: OCEL audit -->
    <bpmn:serviceTask id="Task_Audit" name="emit deceased cohort OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:coverage.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;coverage.inferDeceasedCohorts.refresh&quot;" target="action"/>
          <zeebe:input source="={
            &quot;eras_tracked&quot;:           eraCount,
            &quot;deceased_cohort_classes&quot;:  if (deceasedStats != null) then deceasedStats.cnt else 0,
            &quot;total_represented_humans&quot;: if (deceasedStats != null) then deceasedStats.total_represented else 0,
            &quot;living_persons_linked&quot;:    linkedCount,
            &quot;unlinked_sampled&quot;:         unlinkedCount
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:serviceTask id="Task_AuditNoUnlinkedPersons" name="audit no unlinked living persons">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:coverage.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;coverage.inferDeceasedCohorts.noop&quot;" target="action"/>
          <zeebe:input source="={&quot;reason&quot;: &quot;no_unlinked_living_persons&quot;, &quot;eras_tracked&quot;: eraCount, &quot;unlinked_sampled&quot;: unlinkedCount}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoUnlinkedPersons</bpmn:incoming>
      <bpmn:outgoing>Flow_NoUnlinkedPersonsEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_NoUnlinkedPersonsEnd" sourceRef="Task_AuditNoUnlinkedPersons" targetRef="End"/>

    <bpmn:endEvent id="End">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_NoUnlinkedPersonsEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
