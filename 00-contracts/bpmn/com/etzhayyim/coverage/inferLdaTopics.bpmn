<?xml version="1.0" encoding="UTF-8"?>
<!--
  coverage.inferLdaTopics — Phase B of LDA latent entity inference (ADR-0096).

  Reads the current signal vocabulary and observable record corpus, runs
  Gibbs sampling (via Murakumo Python External UDF, io_threads=100) to
  converge K latent topics, then writes vertex_lda_topic and
  edge_topic_signal_weight (φ distribution) to RisingWave.

  Per ADR-0044: Gibbs sampling is heavy Python (numpy/scipy) → Python
  External UDF with io_threads=100. Called via generic.llm.json which
  bridges to the pymagatama LDA module.

  Pipeline:
    1. generic.db.select  — read converged model watermark (latest model_slug)
    2. generic.db.select  — read signal vocabulary per viewpoint (< 500 signals)
    3. generic.db.select  — read observable record sample (up to 10K records)
    4. generic.llm.json   — Gibbs sampling → K topic↔signal weight matrices
    5. generic.db.insert  — write vertex_lda_model metadata
    6. generic.db.bulkInsert — write vertex_lda_topic (K rows)
    7. generic.db.bulkInsert — write edge_topic_signal_weight (K × vocab rows)
    8. generic.audit.emit — OCEL summary

  Trigger:
    timer-start R/P7D (weekly) AND XRPC (`com.etzhayyim.apps.coverage.inferLdaTopics`).

  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/coverage-infer-lda-topics-v1
  NSID:      com.etzhayyim.apps.coverage.inferLdaTopics
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_coverage_infer_lda_topics"
    targetNamespace="https://etzhayyim.ai/bpmn/coverage"
    exporter="hand-written" exporterVersion="2.0">
  <bpmn:process id="coverage_infer_lda_topics" name="coverage infer LDA topics" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.coverage.inferLdaTopics", "version": 1, "resultTimeoutMs": 600000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start_Timer" name="every 7 days">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_P7D">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P7D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:startEvent id="Start_Manual" name="manual trigger">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_0" sourceRef="Start_Manual" targetRef="Task_ReadModelWatermark"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Timer"  targetRef="Task_ReadModelWatermark"/>

    <!-- Step 1: Read latest converged model watermark -->
    <bpmn:serviceTask id="Task_ReadModelWatermark" name="read latest model watermark">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;mv_lda_model_latest&quot;" target="table"/>
          <zeebe:input source="=&quot;training_corpus, model_vid, k_topics, perplexity, trained_at&quot;" target="columns"/>
          <zeebe:input source="=5" target="limit"/>
          <zeebe:output source="=rows"     target="latestModels"/>
          <zeebe:output source="=rowCount" target="modelCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ReadModelWatermark" targetRef="Task_ReadSignalVocab"/>

    <!-- Step 2: Read signal vocabulary (bounded: < 500 signals per ADR-0096) -->
    <bpmn:serviceTask id="Task_ReadSignalVocab" name="read signal vocabulary">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_lda_signal&quot;" target="table"/>
          <zeebe:input source="=&quot;vertex_id, viewpoint_vid, signal_token, signal_kind, doc_frequency, idf_score&quot;" target="columns"/>
          <zeebe:input source="=&quot;doc_frequency > 0&quot;" target="where"/>
          <zeebe:input source="=500" target="limit"/>
          <zeebe:input source="=&quot;idf_score DESC&quot;" target="orderBy"/>
          <zeebe:output source="=rows"     target="signalVocab"/>
          <zeebe:output source="=rowCount" target="vocabSize"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ReadSignalVocab" targetRef="Task_ReadRecordSample"/>

    <!-- Step 3: Read record sample for training corpus -->
    <bpmn:serviceTask id="Task_ReadRecordSample" name="read observable record sample">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_repo_record&quot;" target="table"/>
          <zeebe:input source="=&quot;vertex_id, collection, owner_did&quot;" target="columns"/>
          <zeebe:input source="=if (sampleSize = null) then 10000 else sampleSize" target="limit"/>
          <zeebe:input source="=&quot;_seq DESC&quot;" target="orderBy"/>
          <zeebe:output source="=rows"     target="recordSample"/>
          <zeebe:output source="=rowCount" target="sampleCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ReadRecordSample" targetRef="Gateway_HasCorpus"/>
    <bpmn:exclusiveGateway id="Gateway_HasCorpus" name="training corpus available?" default="Flow_NoCorpus">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_RunGibbs</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoCorpus</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_RunGibbs" sourceRef="Gateway_HasCorpus" targetRef="Task_RunGibbs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vocabSize &gt; 0 and sampleCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoCorpus" sourceRef="Gateway_HasCorpus" targetRef="Task_AuditNoInput"/>

    <!-- Step 4: Run LDA Gibbs sampling via Murakumo Python UDF (io_threads=100) -->
    <bpmn:serviceTask id="Task_RunGibbs" name="run Gibbs sampling for K topics">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.json"/>
        <zeebe:ioMapping>
          <zeebe:input source="={
            &quot;task&quot;:        &quot;lda_gibbs&quot;,
            &quot;k_topics&quot;:    if (kTopics = null) then 50 else kTopics,
            &quot;alpha&quot;:       if (alpha = null) then 1.0 else alpha,
            &quot;beta&quot;:        if (beta  = null) then 0.1 else beta,
            &quot;iterations&quot;: if (iters  = null) then 200 else iters,
            &quot;vocab&quot;:       for s in signalVocab return { &quot;id&quot;: s.vertex_id, &quot;token&quot;: s.signal_token, &quot;kind&quot;: s.signal_kind, &quot;idf&quot;: s.idf_score },
            &quot;corpus&quot;:      for r in recordSample return { &quot;id&quot;: r.vertex_id, &quot;collection&quot;: r.collection }
          }" target="prompt"/>
          <zeebe:output source="=result.topics"       target="topicResults"/>
          <zeebe:output source="=result.perplexity"   target="perplexity"/>
          <zeebe:output source="=result.log_likelihood" target="logLikelihood"/>
          <zeebe:output source="=result.convergence_iter" target="convergenceIter"/>
          <zeebe:output source="=result.model_slug"   target="modelSlug"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RunGibbs</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_RunGibbs" targetRef="Task_WriteModel"/>

    <!-- Step 5: Write vertex_lda_model metadata -->
    <bpmn:serviceTask id="Task_WriteModel" name="write lda model metadata">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_lda_model&quot;" target="table"/>
          <zeebe:input source="={
            &quot;vertex_id&quot;:             &quot;at://did:web:coverage.etzhayyim.com/com.etzhayyim.apps.coverage.ldaModel/&quot; + modelSlug,
            &quot;_seq&quot;:                   1,
            &quot;sensitivity_ord&quot;:        0,
            &quot;owner_did&quot;:              &quot;did:web:coverage.etzhayyim.com&quot;,
            &quot;model_slug&quot;:             modelSlug,
            &quot;model_version&quot;:          &quot;1.0.0&quot;,
            &quot;k_topics&quot;:              count(topicResults),
            &quot;alpha_prior&quot;:            if (alpha = null) then 1.0 else alpha,
            &quot;beta_prior&quot;:             if (beta  = null) then 0.1 else beta,
            &quot;training_corpus&quot;:        &quot;vertex_repo_record&quot;,
            &quot;training_record_count&quot;: sampleCount,
            &quot;viewpoints_used&quot;:        &quot;lexical,behavioral,network,signal,semantic,temporal,geographic,economic&quot;,
            &quot;perplexity&quot;:             perplexity,
            &quot;log_likelihood&quot;:         logLikelihood,
            &quot;convergence_iter&quot;:       convergenceIter,
            &quot;status&quot;:                 &quot;converged&quot;,
            &quot;trained_at&quot;:             now(),
            &quot;actor_did&quot;:              &quot;did:web:coverage.etzhayyim.com&quot;,
            &quot;org_did&quot;:               &quot;did:web:coverage.etzhayyim.com&quot;,
            &quot;created_at&quot;:             now()
          }" target="row"/>
          <zeebe:output source="=inserted" target="modelInserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_WriteModel" targetRef="Task_WriteTopics"/>

    <!-- Step 6: Bulk-write vertex_lda_topic (K rows) -->
    <bpmn:serviceTask id="Task_WriteTopics" name="write lda topics">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.bulkInsert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_lda_topic&quot;" target="table"/>
          <zeebe:input source="=for t in topicResults return {
            &quot;vertex_id&quot;:             &quot;at://did:web:coverage.etzhayyim.com/com.etzhayyim.apps.coverage.ldaTopic/&quot; + modelSlug + &quot;-&quot; + string(t.index),
            &quot;_seq&quot;:                   t.index + 1,
            &quot;sensitivity_ord&quot;:        0,
            &quot;owner_did&quot;:              &quot;did:web:coverage.etzhayyim.com&quot;,
            &quot;model_vid&quot;:              &quot;at://did:web:coverage.etzhayyim.com/com.etzhayyim.apps.coverage.ldaModel/&quot; + modelSlug,
            &quot;topic_index&quot;:            t.index,
            &quot;primary_viewpoint_vid&quot;:  if (t.primary_viewpoint != null) then &quot;at://did:web:coverage.etzhayyim.com/com.etzhayyim.apps.coverage.ldaViewpoint/&quot; + t.primary_viewpoint else &quot;at://did:web:coverage.etzhayyim.com/com.etzhayyim.apps.coverage.ldaViewpoint/lexical&quot;,
            &quot;topic_label&quot;:            if (t.label != null) then t.label else &quot;topic-&quot; + string(t.index),
            &quot;coherence_score&quot;:        if (t.coherence != null) then t.coherence else 0.0,
            &quot;top_signal_count&quot;:       if (t.top_signals != null) then count(t.top_signals) else 0,
            &quot;entity_kind_hint&quot;:       if (t.entity_kind != null) then t.entity_kind else &quot;unknown&quot;,
            &quot;actor_did&quot;:              &quot;did:web:coverage.etzhayyim.com&quot;,
            &quot;org_did&quot;:               &quot;did:web:coverage.etzhayyim.com&quot;,
            &quot;created_at&quot;:             now()
          }" target="rows"/>
          <zeebe:output source="=inserted" target="topicsWritten"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_WriteTopics" targetRef="Task_WritePhiEdges"/>

    <!-- Step 7: Bulk-write edge_topic_signal_weight (φ distribution) -->
    <bpmn:serviceTask id="Task_WritePhiEdges" name="write topic-signal weight edges">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.bulkInsert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;edge_topic_signal_weight&quot;" target="table"/>
          <zeebe:input source="=for t in topicResults, sw in (if (t.signal_weights != null) then t.signal_weights else [])[weight > 0.01] return {
    &quot;edge_id&quot;:         &quot;lda-phi-&quot; + modelSlug + &quot;-&quot; + string(t.index) + &quot;-&quot; + substring(sw.signal_id, 60),
    &quot;src_vid&quot;:         &quot;at://did:web:coverage.etzhayyim.com/com.etzhayyim.apps.coverage.ldaTopic/&quot; + modelSlug + &quot;-&quot; + string(t.index),
    &quot;dst_vid&quot;:         sw.signal_id,
    &quot;_seq&quot;:            1,
    &quot;sensitivity_ord&quot;: 0,
    &quot;owner_did&quot;:       &quot;did:web:coverage.etzhayyim.com&quot;,
    &quot;weight&quot;:          sw.weight,
    &quot;actor_did&quot;:       &quot;did:web:coverage.etzhayyim.com&quot;,
    &quot;org_did&quot;:         &quot;did:web:coverage.etzhayyim.com&quot;,
    &quot;created_at&quot;:      now()
  }" target="rows"/>
          <zeebe:output source="=inserted" target="phiEdgesWritten"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_WritePhiEdges" targetRef="Task_Audit"/>

    <!-- Step 8: OCEL audit -->
    <bpmn:serviceTask id="Task_Audit" name="emit LDA topics OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:coverage.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;coverage.inferLdaTopics.train&quot;" target="action"/>
          <zeebe:input source="={
            &quot;model_slug&quot;:      modelSlug,
            &quot;k_topics&quot;:       count(topicResults),
            &quot;vocab_size&quot;:      vocabSize,
            &quot;sample_count&quot;:    sampleCount,
            &quot;topics_written&quot;:  topicsWritten,
            &quot;phi_edges&quot;:       phiEdgesWritten,
            &quot;perplexity&quot;:      perplexity,
            &quot;log_likelihood&quot;:  logLikelihood,
            &quot;iters&quot;:           convergenceIter
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:serviceTask id="Task_AuditNoInput" name="emit LDA topics no-input audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:coverage.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;coverage.inferLdaTopics.noInput&quot;" target="action"/>
          <zeebe:input source="={ &quot;vocab_size&quot;: vocabSize, &quot;sample_count&quot;: sampleCount, &quot;status&quot;: &quot;no-corpus&quot; }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoCorpus</bpmn:incoming>
      <bpmn:outgoing>Flow_NoInputEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_NoInputEnd" sourceRef="Task_AuditNoInput" targetRef="End"/>

    <bpmn:endEvent id="End">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_NoInputEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
