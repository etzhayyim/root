<?xml version="1.0" encoding="UTF-8"?>
<!--
  coverage.inferLdaSignals — Phase A of LDA latent entity inference (ADR-0096).

  Extracts observable signal tokens from RisingWave vertex tables and
  refreshes vertex_lda_signal doc_frequency counts. Runs daily to keep
  signal vocabulary up-to-date as new observable records arrive.

  Pipeline:
    1. generic.db.select  — read active viewpoints from vertex_lda_viewpoint
    2. generic.db.select  — count observable records per source collection (corpus size)
    3. generic.db.select  — read signals needing doc_frequency refresh
    4. generic.db.select  — aggregate doc_frequency from each source collection
    5. generic.db.bulkInsert — upsert refreshed doc_frequency + idf_score into vertex_lda_signal
    6. generic.audit.emit — OCEL summary

  Trigger:
    timer-start R/P1D (daily) AND XRPC (`com.etzhayyim.apps.coverage.inferLdaSignals`).

  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/coverage-infer-lda-signals-v1
  NSID:      com.etzhayyim.apps.coverage.inferLdaSignals
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_coverage_infer_lda_signals"
    targetNamespace="https://etzhayyim.ai/bpmn/coverage"
    exporter="hand-written" exporterVersion="2.0">
  <bpmn:process id="coverage_infer_lda_signals" name="coverage infer LDA signals" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.coverage.inferLdaSignals", "version": 1, "resultTimeoutMs": 120000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start_Timer" name="every 1 day">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_P1D">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:startEvent id="Start_Manual" name="manual trigger">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_0" sourceRef="Start_Manual" targetRef="Task_ReadViewpoints"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Timer"  targetRef="Task_ReadViewpoints"/>

    <!-- Step 1: Read active viewpoints -->
    <bpmn:serviceTask id="Task_ReadViewpoints" name="read active viewpoints">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_lda_viewpoint&quot;" target="table"/>
          <zeebe:input source="=&quot;vertex_id, viewpoint_kind, signal_vocab_size&quot;" target="columns"/>
          <zeebe:input source="=&quot;active = true&quot;" target="where"/>
          <zeebe:input source="=10" target="limit"/>
          <zeebe:output source="=rows"     target="viewpoints"/>
          <zeebe:output source="=rowCount" target="viewpointCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ReadViewpoints" targetRef="Task_ReadCorpusSize"/>

    <!-- Step 2: Count corpus size for IDF computation -->
    <bpmn:serviceTask id="Task_ReadCorpusSize" name="count observable corpus size">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_repo_record&quot;" target="table"/>
          <zeebe:input source="=&quot;COUNT(*) AS corpus_size&quot;" target="columns"/>
          <zeebe:input source="=1" target="limit"/>
          <zeebe:output source="=rows[1].corpus_size" target="corpusSize"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ReadCorpusSize" targetRef="Task_ReadSignals"/>

    <!-- Step 3: Read signals needing refresh (all, batch 500) -->
    <bpmn:serviceTask id="Task_ReadSignals" name="read signals to refresh">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_lda_signal&quot;" target="table"/>
          <zeebe:input source="=&quot;vertex_id, viewpoint_vid, signal_token, signal_kind, source_collection, extraction_expr, doc_frequency&quot;" target="columns"/>
          <zeebe:input source="=if (batchSize = null) then 500 else batchSize" target="limit"/>
          <zeebe:input source="=&quot;vertex_id ASC&quot;" target="orderBy"/>
          <zeebe:output source="=rows"     target="signals"/>
          <zeebe:output source="=rowCount" target="signalCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ReadSignals" targetRef="Gateway_HasSignals"/>
    <bpmn:exclusiveGateway id="Gateway_HasSignals" name="has signals?" default="Flow_NoSignals">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_4a</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoSignals</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_4a" sourceRef="Gateway_HasSignals" targetRef="Task_ReadCollectionCounts">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=signalCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Step 4: Count records per collection for freq estimation -->
    <bpmn:serviceTask id="Task_ReadCollectionCounts" name="count records per source collection">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_repo_record&quot;" target="table"/>
          <zeebe:input source="=&quot;collection AS source_collection, COUNT(*) AS cnt&quot;" target="columns"/>
          <zeebe:input source="=&quot;collection IS NOT NULL&quot;" target="where"/>
          <zeebe:input source="=100" target="limit"/>
          <zeebe:input source="=&quot;source_collection&quot;" target="groupBy"/>
          <zeebe:output source="=rows"     target="collectionCounts"/>
          <zeebe:output source="=rowCount" target="collectionCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4a</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ReadCollectionCounts" targetRef="Task_UpsertSignals"/>

    <!-- Step 5: Bulk-upsert signals with refreshed IDF scores -->
    <bpmn:serviceTask id="Task_UpsertSignals" name="upsert signal doc_frequency and idf">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.bulkInsert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_lda_signal&quot;" target="table"/>
          <zeebe:input source="=for s in signals return {
    &quot;vertex_id&quot;:         s.vertex_id,
    &quot;_seq&quot;:              1,
    &quot;sensitivity_ord&quot;:   0,
    &quot;owner_did&quot;:         &quot;did:web:coverage.etzhayyim.com&quot;,
    &quot;viewpoint_vid&quot;:     s.viewpoint_vid,
    &quot;signal_token&quot;:      s.signal_token,
    &quot;signal_kind&quot;:       s.signal_kind,
    &quot;source_collection&quot;: s.source_collection,
    &quot;extraction_expr&quot;:   s.extraction_expr,
    &quot;doc_frequency&quot;:     if (count(collectionCounts[source_collection = s.source_collection]) > 0) then collectionCounts[source_collection = s.source_collection][1].cnt else s.doc_frequency,
    &quot;idf_score&quot;:         if (corpusSize > 0 and (if (count(collectionCounts[source_collection = s.source_collection]) > 0) then collectionCounts[source_collection = s.source_collection][1].cnt else s.doc_frequency) > 0) then corpusSize / (if (count(collectionCounts[source_collection = s.source_collection]) > 0) then collectionCounts[source_collection = s.source_collection][1].cnt else s.doc_frequency) else 1.0,
    &quot;actor_did&quot;:         &quot;did:web:coverage.etzhayyim.com&quot;,
    &quot;org_did&quot;:           &quot;did:web:coverage.etzhayyim.com&quot;,
    &quot;created_at&quot;:        now()
  }" target="rows"/>
          <zeebe:output source="=inserted" target="upsertedCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_UpsertSignals" targetRef="Task_Audit"/>

    <!-- Step 6: OCEL audit -->
    <bpmn:serviceTask id="Task_Audit" name="emit LDA signals OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:coverage.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;coverage.inferLdaSignals.refresh&quot;" target="action"/>
          <zeebe:input source="={
            &quot;viewpoint_count&quot;:    viewpointCount,
            &quot;signal_count&quot;:       signalCount,
            &quot;signals_upserted&quot;:   upsertedCount,
            &quot;corpus_size&quot;:        corpusSize,
            &quot;collection_count&quot;:   collectionCount
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:serviceTask id="Task_AuditNoSignals" name="audit no LDA signals">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:coverage.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;coverage.inferLdaSignals.abort&quot;" target="action"/>
          <zeebe:input source="={&quot;reason&quot;: &quot;no_signals_to_refresh&quot;, &quot;viewpoint_count&quot;: viewpointCount, &quot;signal_count&quot;: signalCount, &quot;corpus_size&quot;: corpusSize}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoSignals</bpmn:incoming>
      <bpmn:outgoing>Flow_NoSignalsEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_NoSignals" sourceRef="Gateway_HasSignals" targetRef="Task_AuditNoSignals"/>
    <bpmn:sequenceFlow id="Flow_NoSignalsEnd" sourceRef="Task_AuditNoSignals" targetRef="End"/>

    <bpmn:endEvent id="End">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_NoSignalsEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
