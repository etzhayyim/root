<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_pensions_dc_flag_inadequacy" targetNamespace="https://etzhayyim.ai/bpmn/open-pensions-dc" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_pensions_dc_flag_inadequacy" name="flagInadequacy" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_pensions_dc&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, report_id: reportId, fund_vid: fundVid, country_iso3: countryIso3, gross_replacement_rate_pct: grossReplacementRatePct, net_replacement_rate_pct: netReplacementRatePct, old_age_poverty_rate_pct: oldAgePovertyRatePct, gender_gap_pension_pct: genderGapPensionPct, reporting_year: reportingYear, reported_at: reportedAt, adequacy_tier: if netReplacementRatePct != null and netReplacementRatePct &gt;= 70 then &quot;adequate&quot; else if netReplacementRatePct != null and netReplacementRatePct &gt;= 50 then &quot;marginal&quot; else &quot;inadequate&quot;, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-pensions-dc&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-pensions-dc.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;open.pensionsDc.flagInadequacy&quot;" target="action"/><zeebe:input source="={vertexId: vertexId}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>