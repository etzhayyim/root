<?xml version="1.0" encoding="UTF-8"?>
<!--
  ADR 2604251024 — EPO OPS REST citation / family fill.

  Timer-start every 6h. For the next 1000 US patents whose citations have
  not yet been enriched with EPO cross-jurisdiction links, fetch OPS
  biblio + citation list and insert additional edges into
  edge_open_patent_citation_pair and edge_family_member.

  OPS free tier = 4 GB/week — batch size tuned so a single 6h sweep
  stays under ~600 MB.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_patent_ingest_epo_citation_fill"
    targetNamespace="https://etzhayyim.ai/bpmn/patent"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="patent_ingest_epo_citation_fill" name="patent EPO OPS citation fill" isExecutable="true">

    <bpmn:startEvent id="StartTimer" name="every 6h">
      <bpmn:outgoing>Flow_Pending</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 0/6 * * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Pending" sourceRef="StartTimer" targetRef="Task_Pending"/>

    <bpmn:serviceTask id="Task_Pending" name="list patents missing EPO citations">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_patent_patent&quot;" target="table"/>
          <zeebe:input source="=&quot;vertex_id, patent_number, jurisdiction&quot;" target="columns"/>
          <zeebe:input source="={jurisdiction: &quot;US&quot;, status: &quot;granted&quot;}" target="where"/>
          <zeebe:input source="=1000" target="limit"/>
          <zeebe:input source="=&quot;pending&quot;" target="resultKey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Pending</bpmn:incoming>
      <bpmn:outgoing>Flow_Fill</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Fill" sourceRef="Task_Pending" targetRef="Task_Fill"/>

    <bpmn:serviceTask id="Task_Fill" name="fetch OPS + fan out citations">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="patent.epoOps.fillCitations"/>
        <zeebe:ioMapping>
          <zeebe:input source="=pending" target="rows"/>
          <zeebe:input source="=100" target="rateLimitPerMin"/>
          <zeebe:input source="=&quot;edge_open_patent_citation_pair&quot;" target="citationEdgeTable"/>
          <zeebe:input source="=&quot;edge_family_member&quot;" target="familyEdgeTable"/>
          <zeebe:input source="=&quot;fill.result&quot;" target="resultKey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Fill</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_Fill" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:patent.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;patent.ingest.epo.citationFill&quot;" target="action"/>
          <zeebe:input source="={
              examined:       count(pending),
              citationEdges:  fill.result.citationEdges,
              familyEdges:    fill.result.familyEdges,
              quotaUsedBytes: fill.result.quotaUsedBytes
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
