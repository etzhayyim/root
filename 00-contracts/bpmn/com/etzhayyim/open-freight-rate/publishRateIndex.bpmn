<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_freight_rate_index" targetNamespace="https://etzhayyim.ai/bpmn/open-freight-rate" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_freight_rate_index" name="Rate index" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="index">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_freight_rate_index&quot;" target="table"/>
          <zeebe:input source="={vertex_id: vertexId, index_id: indexId, benchmark: benchmark, trade_lane: tradeLane, value_usd_teu: valueUsdTeu, baseline_value: baselineValue, week_over_week_pct: weekOverWeekPct, shock_tier: if weekOverWeekPct != null and weekOverWeekPct &gt;= 20 then &quot;spike&quot; else if weekOverWeekPct != null and weekOverWeekPct &lt;= -20 then &quot;crash&quot; else if weekOverWeekPct != null and (weekOverWeekPct &gt;= 5 or weekOverWeekPct &lt;= -5) then &quot;elevated&quot; else &quot;stable&quot;, publish_date: publishDate, status: &quot;published&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-freight-rate&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-freight-rate.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openFreightRate.index.publish&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, indexId: indexId, benchmark: benchmark, tradeLane: tradeLane, valueUsdTeu: valueUsdTeu}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
