<?xml version="1.0" encoding="UTF-8"?>
<!--
  projector.sendProjectMessage — root router for /projects chat.

  Single entry point for the yoro `/projects/{convoId}` UI. CF Worker
  (atproto.etzhayyim.com) receives the XRPC `com.etzhayyim.projector.sendProjectMessage`,
  publishes the message + variables to Zeebe, and returns 202 Accepted.
  Reply is delivered async via SSE / poll.

  XOR gateway routes by leading slash command to a dedicated sub-process:
    /image     → projector.imageGen        (Murakumo WAI-REAL, deferred to Phase 3)
    /think     → projector.deepReason      (qwq-32b, deferred to Phase 3)
    /explore   → projector.treeOfThoughts  (Phase 2, ToT)
    /consistent→ projector.selfConsistency (Phase 2, SC)
    /reflect   → projector.reflexionWrite  (writes episodic memory only)
    default    → projector.agentLoop       (Phase 1, LangGraph ReAct + CoT + Reflexion)

  NSID:      com.etzhayyim.apps.projector.sendProjectMessage
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/projector-send-project-message-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_projector_send_project_message"
    targetNamespace="https://etzhayyim.ai/bpmn/projector"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="projector_send_project_message" name="projector sendProjectMessage" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.projector.sendProjectMessage", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="message in">
      <bpmn:outgoing>Flow_ToParse</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_Send" messageRef="Message_sendProjectMessage"/>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToParse" sourceRef="Start" targetRef="Task_ParseCommand"/>

    <bpmn:serviceTask id="Task_ParseCommand" name="parse leading slash command">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="projector.command.parse"/>
        <zeebe:ioMapping>
          <zeebe:input source="=text" target="text"/>
          <zeebe:output source="=command" target="command"/>
          <zeebe:output source="=argText" target="argText"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToParse</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRouter</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToRouter" sourceRef="Task_ParseCommand" targetRef="Gateway_Command"/>

    <bpmn:exclusiveGateway id="Gateway_Command" name="route by command" default="Flow_Default">
      <bpmn:incoming>Flow_ToRouter</bpmn:incoming>
      <bpmn:outgoing>Flow_Explore</bpmn:outgoing>
      <bpmn:outgoing>Flow_Consistent</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reflect</bpmn:outgoing>
      <bpmn:outgoing>Flow_Image</bpmn:outgoing>
      <bpmn:outgoing>Flow_Think</bpmn:outgoing>
      <bpmn:outgoing>Flow_Default</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Explore" sourceRef="Gateway_Command" targetRef="Call_TreeOfThoughts">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=command = "/explore"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Consistent" sourceRef="Gateway_Command" targetRef="Call_SelfConsistency">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=command = "/consistent"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Reflect" sourceRef="Gateway_Command" targetRef="Task_ReflexionWrite">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=command = "/reflect"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Image" sourceRef="Gateway_Command" targetRef="Task_DeferImage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=command = "/image"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Think" sourceRef="Gateway_Command" targetRef="Task_DeferThink">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=command = "/think"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Default" sourceRef="Gateway_Command" targetRef="Call_AgentLoop"/>

    <bpmn:callActivity id="Call_AgentLoop" name="agentLoop (LangGraph ReAct)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="projector_agent_loop" propagateAllChildVariables="true"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Default</bpmn:incoming>
      <bpmn:outgoing>Flow_AgentToPersist</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_AgentToPersist" sourceRef="Call_AgentLoop" targetRef="Task_PersistReply"/>

    <bpmn:callActivity id="Call_TreeOfThoughts" name="exploreThoughts (LangGraph ToT)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="projector_tree_of_thoughts" propagateAllChildVariables="true"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Explore</bpmn:incoming>
      <bpmn:outgoing>Flow_TotToPersist</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_TotToPersist" sourceRef="Call_TreeOfThoughts" targetRef="Task_PersistReply"/>

    <bpmn:callActivity id="Call_SelfConsistency" name="consistentAnswer (LangGraph SC)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="projector_self_consistency" propagateAllChildVariables="true"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Consistent</bpmn:incoming>
      <bpmn:outgoing>Flow_ScToPersist</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_ScToPersist" sourceRef="Call_SelfConsistency" targetRef="Task_PersistReply"/>

    <bpmn:serviceTask id="Task_ReflexionWrite" name="reflexion write (episodic memory)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="projector.reflexion.write"/>
        <zeebe:ioMapping>
          <zeebe:input source="=convoId" target="convoId"/>
          <zeebe:input source="=callerDid" target="callerDid"/>
          <zeebe:input source="=argText" target="lessonText"/>
          <zeebe:output source="=reply" target="reply"/>
          <zeebe:output source="=rkey" target="reflexionRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reflect</bpmn:incoming>
      <bpmn:outgoing>Flow_ReflectToPersist</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ReflectToPersist" sourceRef="Task_ReflexionWrite" targetRef="Task_PersistReply"/>

    <!-- /image and /think are deferred to Phase 3; for now we route them
         back to the default agentLoop with a note in the reply. The CF
         Worker can keep handling these directly while BPMN matures. -->
    <bpmn:serviceTask id="Task_DeferImage" name="defer /image to CF direct">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="projector.command.deferred"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;/image&quot;" target="command"/>
          <zeebe:output source="=reply" target="reply"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Image</bpmn:incoming>
      <bpmn:outgoing>Flow_DeferToPersist1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_DeferToPersist1" sourceRef="Task_DeferImage" targetRef="Task_PersistReply"/>

    <bpmn:serviceTask id="Task_DeferThink" name="defer /think to CF direct">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="projector.command.deferred"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;/think&quot;" target="command"/>
          <zeebe:output source="=reply" target="reply"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Think</bpmn:incoming>
      <bpmn:outgoing>Flow_DeferToPersist2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_DeferToPersist2" sourceRef="Task_DeferThink" targetRef="Task_PersistReply"/>

    <bpmn:serviceTask id="Task_PersistReply" name="persist reply + OCEL flow.completed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="projector.persist.message"/>
        <zeebe:ioMapping>
          <zeebe:input source="=convoId" target="convoId"/>
          <zeebe:input source="=callerDid" target="callerDid"/>
          <zeebe:input source="=reply" target="reply"/>
          <zeebe:input source="=command" target="command"/>
          <zeebe:output source="=rkey" target="replyRkey"/>
          <zeebe:output source="=uri" target="replyUri"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AgentToPersist</bpmn:incoming>
      <bpmn:incoming>Flow_TotToPersist</bpmn:incoming>
      <bpmn:incoming>Flow_ScToPersist</bpmn:incoming>
      <bpmn:incoming>Flow_ReflectToPersist</bpmn:incoming>
      <bpmn:incoming>Flow_DeferToPersist1</bpmn:incoming>
      <bpmn:incoming>Flow_DeferToPersist2</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_PersistReply" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="emit projector message audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.projector.sendProjectMessage.completed&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;convoId&quot;: convoId, &quot;callerDid&quot;: callerDid, &quot;command&quot;: command, &quot;replyUri&quot;: replyUri, &quot;replyRkey&quot;: replyRkey }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="reply emitted">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <bpmn:message id="Message_sendProjectMessage" name="com.etzhayyim.apps.projector.sendProjectMessage">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=convoId"/>
    </bpmn:extensionElements>
  </bpmn:message>
</bpmn:definitions>
