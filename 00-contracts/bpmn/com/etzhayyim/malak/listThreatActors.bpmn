<?xml version="1.0" encoding="UTF-8"?>
<!--
  malak.listThreatActors — migrates cmdListThreatActors.

  Flow:
    Start (limit?, offset?)
      → generic.db.select (vertex_threat WHERE repo=malak.etzhayyim.com ORDER BY created_date DESC)
      → End

  Output: { rows: [...], rowCount: N }  — callers read variables.rows

  NSID: com.etzhayyim.apps.malak.listThreatActors
  vid:  at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/malak-list-threat-actors-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_malak_list_threat_actors"
    targetNamespace="https://etzhayyim.ai/bpmn/malak"
    exporter="hand-written" exporterVersion="2.0">
  <bpmn:process id="malak_list_threat_actors" name="malak listThreatActors" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.malak.listThreatActors", "version": 1, "resultTimeoutMs": 10000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_ToSelect</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToSelect" sourceRef="Start" targetRef="Task_Select"/>

    <bpmn:serviceTask id="Task_Select" name="select threat actors">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_threat&quot;"                         target="table"/>
          <zeebe:input source="=&quot;repo = %s AND label = %s&quot;"              target="whereExpr"/>
          <zeebe:input source='=["did:web:malak.etzhayyim.com", "ThreatActor"]'          target="whereParams"/>
          <zeebe:input source="=if limit = null then 50 else if limit > 100 then 100 else limit" target="limit"/>
          <zeebe:input source="=&quot;created_date DESC&quot;"                     target="orderBy"/>
          <zeebe:output source="=rows"     target="rows"/>
          <zeebe:output source="=rowCount" target="rowCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSelect</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Select" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
