<?xml version="1.0" encoding="UTF-8"?>
<!--
  malak.queryRiskChain — migrates cmdQueryRiskChain.

  Query: ThreatActor → CONTROLS_WALLET → WalletAddress → BlockchainActor → RiskSignal

  Flow:
    Start (address, chain?)
      → scriptTask: derive chainNodeId
      → generic.db.select (vertex_blockchain_actor WHERE address=?)
      → generic.db.select (vertex_risk_signal WHERE target_node_id=?)
      → End

  Output variables: { blockchainRows, riskRows, chainNodeId, address, chain }

  NSID: com.etzhayyim.apps.malak.queryRiskChain
  vid:  at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/malak-query-risk-chain-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_malak_query_risk_chain"
    targetNamespace="https://etzhayyim.ai/bpmn/malak"
    exporter="hand-written" exporterVersion="2.0">
  <bpmn:process id="malak_query_risk_chain" name="malak queryRiskChain" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.malak.queryRiskChain", "version": 1, "resultTimeoutMs": 15000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_ToDerive</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToDerive" sourceRef="Start" targetRef="Task_Derive"/>

    <!-- Step 1: derive chainNodeId = "bchain:{chain}:{address}" -->
    <bpmn:scriptTask id="Task_Derive" name="derive chainNodeId">
      <bpmn:extensionElements>
        <zeebe:script
            expression='=string join(["bchain:", if chain = null then "btc" else string(chain), ":", string(address)], "")'
            resultVariable="chainNodeId"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDerive</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBlockchain</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ToBlockchain" sourceRef="Task_Derive" targetRef="Task_SelectBlockchain"/>

    <!-- Step 2: BlockchainActor for this address -->
    <bpmn:serviceTask id="Task_SelectBlockchain" name="select blockchain actor">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_blockchain_actor&quot;" target="table"/>
          <zeebe:input source="=&quot;address = %s&quot;"            target="whereExpr"/>
          <zeebe:input source="=[string(address)]"                   target="whereParams"/>
          <zeebe:input source="=1"                                   target="limit"/>
          <zeebe:output source="=rows"     target="blockchainRows"/>
          <zeebe:output source="=rowCount" target="blockchainCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToBlockchain</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRisk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToRisk" sourceRef="Task_SelectBlockchain" targetRef="Task_SelectRisk"/>

    <!-- Step 3: RiskSignals targeting this chain node -->
    <bpmn:serviceTask id="Task_SelectRisk" name="select risk signals">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_risk_signal&quot;"      target="table"/>
          <zeebe:input source="=&quot;target_node_id = %s&quot;"     target="whereExpr"/>
          <zeebe:input source="=[chainNodeId]"                       target="whereParams"/>
          <zeebe:input source="=20"                                  target="limit"/>
          <zeebe:input source="=&quot;detected_at DESC&quot;"        target="orderBy"/>
          <zeebe:output source="=rows"     target="riskRows"/>
          <zeebe:output source="=rowCount" target="riskCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRisk</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_SelectRisk" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
