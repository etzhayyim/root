<?xml version="1.0" encoding="UTF-8"?>
<!--
  malak.getThreatGraph — migrates cmdGetThreatGraph.

  Fetches ThreatActor node + associated RiskSignals.
  Note: WalletAddress correlation is deferred (vertex_malak_wallet_address
  table not yet in schema; will be added in a follow-up migration).

  Flow:
    Start (actorId)
      → generic.db.select (vertex_threat WHERE code=actorId)
      → generic.db.select (vertex_risk_signal WHERE chain IS NOT NULL LIMIT 20)
      → End

  Output variables: { actorRows, riskRows }

  NSID: com.etzhayyim.apps.malak.getThreatGraph
  vid:  at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/malak-get-threat-graph-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_malak_get_threat_graph"
    targetNamespace="https://etzhayyim.ai/bpmn/malak"
    exporter="hand-written" exporterVersion="2.0">
  <bpmn:process id="malak_get_threat_graph" name="malak getThreatGraph" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.malak.getThreatGraph", "version": 1, "resultTimeoutMs": 15000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_ToActor</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToActor" sourceRef="Start" targetRef="Task_SelectActor"/>

    <!-- Step 1: fetch ThreatActor node (code column = actorId) -->
    <bpmn:serviceTask id="Task_SelectActor" name="select threat actor">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_threat&quot;"               target="table"/>
          <zeebe:input source="=&quot;repo = %s AND code = %s&quot;"     target="whereExpr"/>
          <zeebe:input source='=["did:web:malak.etzhayyim.com", string(actorId)]' target="whereParams"/>
          <zeebe:input source="=1"                                        target="limit"/>
          <zeebe:output source="=rows"     target="actorRows"/>
          <zeebe:output source="=rowCount" target="actorCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToActor</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRisk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToRisk" sourceRef="Task_SelectActor" targetRef="Task_SelectRisk"/>

    <!-- Step 2: fetch recent blockchain RiskSignals (chain IS NOT NULL = blockchain signals) -->
    <bpmn:serviceTask id="Task_SelectRisk" name="select blockchain risk signals">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_risk_signal&quot;"      target="table"/>
          <zeebe:input source="=&quot;chain IS NOT NULL&quot;"        target="whereExpr"/>
          <zeebe:input source="=[]"                                   target="whereParams"/>
          <zeebe:input source="=20"                                   target="limit"/>
          <zeebe:input source="=&quot;detected_at DESC&quot;"         target="orderBy"/>
          <zeebe:output source="=rows"     target="riskRows"/>
          <zeebe:output source="=rowCount" target="riskCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRisk</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_SelectRisk" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
