<?xml version="1.0" encoding="UTF-8"?>
<!--
  malak.runInvestigationTick — one bounded Active Inference tick.

  Scores candidate investigation actions with agent.evaluateExpectedFreeEnergy,
  writes vertex_malak_investigation_tick, and emits an audit event.
  This BPMN does not send agency reports or perform external effects.

  NSID: com.etzhayyim.apps.malak.runInvestigationTick
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_malak_run_investigation_tick"
    targetNamespace="https://etzhayyim.ai/bpmn/malak"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="malak_run_investigation_tick" name="malak runInvestigationTick" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.malak.runInvestigationTick", "version": 1, "resultTimeoutMs": 30000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_ToEvaluate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToEvaluate" sourceRef="Start" targetRef="Task_Evaluate"/>

    <bpmn:serviceTask id="Task_Evaluate" name="evaluate expected free energy">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="agent.evaluateExpectedFreeEnergy"/>
        <zeebe:ioMapping>
          <zeebe:input source="=candidateActions" target="candidateActions"/>
          <zeebe:input source="=legalBasis != null and string(legalBasis) != &quot;&quot;" target="mokutekiGatePass"/>
          <zeebe:input source="=true" target="requireSafetyFloor"/>
          <zeebe:output source="=selectedActionId" target="selectedActionId"/>
          <zeebe:output source="=expectedFreeEnergy" target="expectedFreeEnergy"/>
          <zeebe:output source="=rejected" target="rejectedActions"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToEvaluate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWrite</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToWrite" sourceRef="Task_Evaluate" targetRef="Task_Write"/>

    <bpmn:serviceTask id="Task_Write" name="write investigation tick">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_malak_investigation_tick&quot;" target="table"/>
          <zeebe:input source='={
            vertex_id: string join(["at://did:web:malak.etzhayyim.com/com.etzhayyim.apps.malak.investigationTick/", string(actorId), "-", string(now())], ""),
            rkey: string join(["tick-", string(actorId), "-", string(now())], ""),
            repo: "did:web:malak.etzhayyim.com",
            actor_id: string(actorId),
            case_id: if caseId = null then "" else string(caseId),
            tick_kind: if tickKind = null then "deliberative" else string(tickKind),
            observation_refs_json: string(if observationRefs = null then [] else observationRefs),
            candidate_actions_json: string(candidateActions),
            expected_free_energy_json: string(expectedFreeEnergy),
            selected_action_id: if selectedActionId = null then "" else string(selectedActionId),
            rejected_actions_json: string(rejectedActions),
            attribution_confidence: if attributionConfidence = null then 0 else attributionConfidence,
            legal_basis: if legalBasis = null then "" else string(legalBasis),
            approval_ref: if approvalRef = null then "" else string(approvalRef),
            gate_pass: legalBasis != null and string(legalBasis) != "",
            created_at: string(now()),
            created_date: substring(string(now()), 1, 10),
            sensitivity_ord: 100,
            owner_did: "did:web:malak.etzhayyim.com",
            org_id: "did:web:malak.etzhayyim.com",
            user_id: if callerDid = null then "did:web:malak.etzhayyim.com" else string(callerDid)
          }' target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
          <zeebe:output source="=inserted" target="tickInserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToWrite</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Write" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit investigation tick">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;malak.investigation.tick&quot;" target="eventType"/>
          <zeebe:input source="={ actorId: actorId, caseId: caseId, selectedActionId: selectedActionId, expectedFreeEnergy: expectedFreeEnergy, rejected: rejectedActions, inserted: tickInserted }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>

