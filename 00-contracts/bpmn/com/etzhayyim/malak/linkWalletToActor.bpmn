<?xml version="1.0" encoding="UTF-8"?>
<!--
  malak.linkWalletToActor — migrates cmdLinkWalletToActor.

  Replaces sdk.pds.createRecord("com.etzhayyim.apps.malak.walletAddress") with
  Hyperdrive-direct INSERT into vertex_malak_wallet_address (ADR-0036).
  Also inserts CONTROLS_WALLET edge (ThreatActor → WalletAddress) directly.

  Flow:
    Start (actorId, address, chain?, label?, confidence?, evidence?)
      → scriptTask: derive rkey + vertexIds
      → generic.db.insert (vertex_malak_wallet_address)
      → generic.db.insert (edge_malak_controls_wallet)
      → generic.audit.emit
      → End

  NSID derivation (sync-bpmn-actors.py convention):
    path = 00-contracts/bpmn/com/etzhayyim/malak/linkWalletToActor.bpmn
    NSID = com.etzhayyim.apps.malak.linkWalletToActor
    vid  = at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/malak-link-wallet-to-actor-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_malak_link_wallet_to_actor"
    targetNamespace="https://etzhayyim.ai/bpmn/malak"
    exporter="hand-written" exporterVersion="2.0">
  <bpmn:process id="malak_link_wallet_to_actor" name="malak linkWalletToActor" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.malak.linkWalletToActor", "version": 1, "resultTimeoutMs": 15000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_ToDerive</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToDerive" sourceRef="Start" targetRef="Task_Derive"/>

    <!-- Step 1: derive stable rkey + vertex IDs from actorId + chain + address -->
    <bpmn:scriptTask id="Task_Derive" name="derive rkey + vertexIds">
      <bpmn:extensionElements>
        <zeebe:script
            expression='={
              resolvedChain:    if chain = null or string(chain) = "" then "btc" else string(chain),
              rkey:             string join(["wallet-", if chain = null or string(chain) = "" then "btc" else string(chain), "-", string(address)], ""),
              walletVertexId:   string join(["at://did:web:malak.etzhayyim.com/com.etzhayyim.apps.malak.walletAddress/wallet-", if chain = null or string(chain) = "" then "btc" else string(chain), "-", string(address)], ""),
              actorVertexId:    string join(["at://did:web:malak.etzhayyim.com/com.etzhayyim.apps.malak.threatActor/", string(actorId)], ""),
              edgeId:           string join(["malak:edge:controls_wallet:", string(actorId), ":", if chain = null or string(chain) = "" then "btc" else string(chain), ":", string(address)], ""),
              resolvedConf:     if confidence = null then 70 else if confidence > 100 then 100 else confidence
            }'
            resultVariable="derived"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDerive</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWalletInsert</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ToWalletInsert" sourceRef="Task_Derive" targetRef="Task_WalletInsert"/>

    <!-- Step 2: INSERT wallet address vertex (Hyperdrive-direct, ADR-0036) -->
    <bpmn:serviceTask id="Task_WalletInsert" name="vertex_malak_wallet_address INSERT">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_malak_wallet_address&quot;" target="table"/>
          <zeebe:input source='={
              vertex_id:       derived.walletVertexId,
              rkey:            derived.rkey,
              repo:            "did:web:malak.etzhayyim.com",
              did:             "did:web:malak.etzhayyim.com",
              chain:           derived.resolvedChain,
              address:         string(address),
              actor_node_id:   string join(["intel:", string(actorId)], ""),
              label:           if label = null then "" else string(label),
              confidence:      derived.resolvedConf,
              evidence:        if evidence = null then "" else string(evidence),
              linked_at:       string(now()),
              sensitivity_ord: 100,
              owner_did:       "did:web:malak.etzhayyim.com",
              created_date:    substring(string(now()), 1, 10)
          }' target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
          <zeebe:output source="=inserted" target="walletInserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToWalletInsert</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEdgeInsert</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEdgeInsert" sourceRef="Task_WalletInsert" targetRef="Task_EdgeInsert"/>

    <!-- Step 3: INSERT CONTROLS_WALLET edge (ThreatActor → WalletAddress) -->
    <bpmn:serviceTask id="Task_EdgeInsert" name="edge_malak_controls_wallet INSERT">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;edge_malak_controls_wallet&quot;" target="table"/>
          <zeebe:input source='={
              edge_id:         derived.edgeId,
              src_vid:         derived.actorVertexId,
              dst_vid:         derived.walletVertexId,
              sensitivity_ord: 100,
              owner_did:       "did:web:malak.etzhayyim.com",
              created_date:    substring(string(now()), 1, 10)
          }' target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
          <zeebe:output source="=inserted" target="edgeInserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToEdgeInsert</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_EdgeInsert" targetRef="Task_Audit"/>

    <!-- Step 4: OCEL audit -->
    <bpmn:serviceTask id="Task_Audit" name="audit: malak.wallet.linked">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:malak.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;malak.wallet.linked&quot;"   target="action"/>
          <zeebe:input source="={ actorId: string(actorId), chain: derived.resolvedChain, address: string(address), walletInserted: walletInserted, edgeInserted: edgeInserted }" target="payload"/>
          <zeebe:output source="=emitted" target="auditEmitted"/>
          <zeebe:output source="=rkey"    target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
