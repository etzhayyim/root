<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_site_ivf_pq_reindex"
                  targetNamespace="https://etzhayyim.ai/bpmn/site"
                  exporter="hand-written"
                  exporterVersion="2.0">

  <bpmn:process id="site_ivf_pq_reindex" name="site IVF+PQ Reindex" isExecutable="true">
    <bpmn:documentation>{ "taskType": "site.ivfPq.reindex", "resident": true }</bpmn:documentation>

    <bpmn:startEvent id="Start_Timer" name="every 7 days">
      <bpmn:outgoing>Flow_Timer_Health</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_P7D">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P7D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:startEvent id="Start_Manual" name="manual">
      <bpmn:outgoing>Flow_Manual_Health</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_Timer_Health"  sourceRef="Start_Timer"  targetRef="Task_HealthProbe"/>
    <bpmn:sequenceFlow id="Flow_Manual_Health" sourceRef="Start_Manual" targetRef="Task_HealthProbe"/>

    <!-- RisingWave health gate (ADR-0048 / scaling-contract) -->
    <bpmn:serviceTask id="Task_HealthProbe" name="rw health probe">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="rw.health.probe" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:output source="=healthy"   target="healthy"/>
          <zeebe:output source="=degraded"  target="degraded"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Timer_Health</bpmn:incoming>
      <bpmn:incoming>Flow_Manual_Health</bpmn:incoming>
      <bpmn:outgoing>Flow_Health_Gate</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="GW_Health" name="healthy?">
      <bpmn:incoming>Flow_Health_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Health_OK</bpmn:outgoing>
      <bpmn:outgoing>Flow_Health_Degraded</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Health_Gate"    sourceRef="Task_HealthProbe" targetRef="GW_Health"/>
    <bpmn:sequenceFlow id="Flow_Health_OK"      sourceRef="GW_Health" targetRef="Task_EmbedMarkdown">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=healthy = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Health_Degraded" sourceRef="GW_Health" targetRef="Task_Audit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=healthy = false or degraded = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Step 0: embed wet_chunk markdown rows that lack embeddings (prerequisite) -->
    <bpmn:serviceTask id="Task_EmbedMarkdown" name="embed WET chunk markdown">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="site.ivfPq.embedMarkdown" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input  source="=if domain = null then &quot;site.wet&quot; else domain" target="domain"/>
          <zeebe:input  source="=if batch_size = null then 200 else batch_size"          target="batch_size"/>
          <zeebe:output source="=total_embedded"  target="embed_total"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Health_OK</bpmn:incoming>
      <bpmn:outgoing>Flow_Embed_Centroids</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Embed_Centroids" sourceRef="Task_EmbedMarkdown" targetRef="Task_UpdateCentroids"/>

    <!-- Step 1: re-cluster IVF centroids -->
    <bpmn:serviceTask id="Task_UpdateCentroids" name="update IVF centroids">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="site.ivfPq.updateCentroids" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input  source="=if domain = null then &quot;site.wet&quot; else domain" target="domain"/>
          <zeebe:input  source="=if n_centroids = null then 256 else n_centroids"       target="n_centroids"/>
          <zeebe:output source="=n_centroids"        target="centroid_count"/>
          <zeebe:output source="=n_chunks_assigned"  target="chunks_assigned"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Embed_Centroids</bpmn:incoming>
      <bpmn:outgoing>Flow_Centroids_Codebook</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Centroids_Codebook" sourceRef="Task_UpdateCentroids" targetRef="Task_TrainCodebook"/>

    <!-- Step 2: train PQ codebook -->
    <bpmn:serviceTask id="Task_TrainCodebook" name="train PQ codebook">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="site.ivfPq.trainCodebook" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input  source="=if domain = null then &quot;site.wet&quot; else domain" target="domain"/>
          <zeebe:input  source="=if m_subspaces = null then 96 else m_subspaces"        target="m_subspaces"/>
          <zeebe:input  source="=if k_centroids = null then 256 else k_centroids"       target="k_centroids"/>
          <zeebe:output source="=version_tag"      target="pq_version_tag"/>
          <zeebe:output source="=n_train_vectors"  target="pq_train_vectors"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Centroids_Codebook</bpmn:incoming>
      <bpmn:outgoing>Flow_Codebook_Encode</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Codebook_Encode" sourceRef="Task_TrainCodebook" targetRef="Task_EncodeChunks"/>

    <!-- Step 3: encode all wet_chunks -->
    <bpmn:serviceTask id="Task_EncodeChunks" name="encode WET chunks (PQ)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="site.ivfPq.encodeChunks" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input  source="=if domain = null then &quot;site.wet&quot; else domain"  target="domain"/>
          <zeebe:input  source="=if batch_size = null then 500 else batch_size"            target="batch_size"/>
          <zeebe:output source="=encoded"   target="pq_encoded"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Codebook_Encode</bpmn:incoming>
      <bpmn:outgoing>Flow_Encode_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Encode_Audit" sourceRef="Task_EncodeChunks" targetRef="Task_Audit"/>

    <!-- Audit emit -->
    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;site.ivfPq.reindex&quot;" target="event_type"/>
          <zeebe:input source="=if healthy = false then &quot;degraded&quot; else &quot;ok&quot;" target="status"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Health_Degraded</bpmn:incoming>
      <bpmn:incoming>Flow_Encode_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit_End" sourceRef="Task_Audit" targetRef="End_Event"/>

    <bpmn:endEvent id="End_Event" name="done">
      <bpmn:incoming>Flow_Audit_End</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
