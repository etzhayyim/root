<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_power_report_outage"
    targetNamespace="https://etzhayyim.ai/bpmn/open-power"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="open_power_report_outage" name="停電 報告" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Classify"/>

    <!--
      major    : customersAffected >= 1000 OR cause = "storm"
      moderate : 100..999
      minor    : < 100
      public notice: severity = major
    -->
    <bpmn:serviceTask id="Task_Classify" name="severity 分類">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT 1 AS ok LIMIT 1&quot;" target="query"/>
          <zeebe:input source="=[]" target="params"/>
          <zeebe:output source="=if customersAffected &gt;= 1000 or cause = &quot;storm&quot; then &quot;major&quot;
                                else if customersAffected &gt;= 100 then &quot;moderate&quot;
                                else &quot;minor&quot;" target="severity"/>
          <zeebe:output source="=customersAffected &gt;= 1000 or cause = &quot;storm&quot;" target="requirePublicNotice"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_Save</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Save" sourceRef="Task_Classify" targetRef="Task_SaveOutage"/>

    <bpmn:serviceTask id="Task_SaveOutage" name="outage 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_power_outage&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:             vertexId,
              utility_org_id:        utilityOrgId,
              feeder_vertex_id:      feederVertexId,
              cause:                 cause,
              customers_affected:    customersAffected,
              severity:              severity,
              require_public_notice: requirePublicNotice,
              status:                &quot;open&quot;,
              reported_at:           reportedAt,
              created_at:            string(now()),
              owner_did:             callerDid,
              sensitivity_ord:       1,
              org_id:                utilityOrgId,
              user_id:               callerDid,
              actor_id:              &quot;sys.bpmn.open-power&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Save</bpmn:incoming><bpmn:outgoing>Flow_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Gate" sourceRef="Task_SaveOutage" targetRef="Gate"/>

    <bpmn:exclusiveGateway id="Gate" name="公衆周知?" default="Flow_Silent">
      <bpmn:incoming>Flow_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Notice</bpmn:outgoing>
      <bpmn:outgoing>Flow_Silent</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Notice" sourceRef="Gate" targetRef="Task_Notice">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=requirePublicNotice = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Silent" sourceRef="Gate" targetRef="Task_AuditSilent"/>

    <bpmn:serviceTask id="Task_Notice" name="公衆周知 post">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;app.bsky.feed.post&quot;" target="type"/>
          <zeebe:input source="={
              text: &quot;[open-power] 停電公衆周知: feeder=&quot; + string(feederVertexId)
                    + &quot; affected=&quot; + string(customersAffected)
                    + &quot; cause=&quot; + string(cause),
              createdAt: string(now())
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Notice</bpmn:incoming><bpmn:outgoing>Flow_AM</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AM" sourceRef="Task_Notice" targetRef="Task_AuditMajor"/>

    <bpmn:serviceTask id="Task_AuditMajor" name="audit outage.notice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-power.etzhayyim.com:grid&quot;" target="actor"/>
          <zeebe:input source="=&quot;openPower.outage.publicNotice&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, severity: severity, feederVertexId: feederVertexId, customersAffected: customersAffected}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AM</bpmn:incoming><bpmn:outgoing>Flow_EndM</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndM" sourceRef="Task_AuditMajor" targetRef="End_M"/>

    <bpmn:serviceTask id="Task_AuditSilent" name="audit outage.log">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-power.etzhayyim.com:grid&quot;" target="actor"/>
          <zeebe:input source="=&quot;openPower.outage.log&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, severity: severity, feederVertexId: feederVertexId}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Silent</bpmn:incoming><bpmn:outgoing>Flow_EndS</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndS" sourceRef="Task_AuditSilent" targetRef="End_S"/>

    <bpmn:endEvent id="End_S"><bpmn:incoming>Flow_EndS</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_M"><bpmn:incoming>Flow_EndM</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
