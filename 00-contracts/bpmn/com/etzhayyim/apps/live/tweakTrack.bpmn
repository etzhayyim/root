<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.etzhayyim.apps.live.tweakTrack — performer edits one track of a setlist.

  Two-task flow:
    1. generic.db.insert → vertex_live_track (PK rewrite = upsert)
    2. generic.audit.emit → live.tweakTrack

  The PK is deterministic on (room_slug, position): same PK on re-insert
  causes RisingWave to overwrite, which is the canonical "UPDATE" pattern
  per RW's record-log semantics (no OLTP UPDATE TX guarantees).

  Caller supplies the full track payload; optional fields (dance, audio,
  cues_json) default to null and clear the column when omitted.

  RLS shape per ADR-0095. The performer's DID is taken from the dispatch
  context (`callerDid`). org_did is "anon" until a wallet binds.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_live_tweak_track"
    targetNamespace="https://etzhayyim.ai/bpmn/apps/live"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="live_tweak_track" name="live tweakTrack" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>

    <bpmn:serviceTask id="Task_Save" name="vertex_live_track upsert">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_live_track&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id: &quot;at://&quot; + (if callerDid != null then string(callerDid) else &quot;did:web:live.etzhayyim.com&quot;) + &quot;/com.etzhayyim.apps.live.track/&quot; + string(roomSlug) + &quot;-&quot; + string(position),
              room_slug: roomSlug,
              position: position,
              title: title,
              bpm: bpm,
              length_beats: lengthBeats,
              dance: dance,
              audio: audio,
              cues_json: cuesJson,
              name: string(title) + &quot; (track #&quot; + string(position) + &quot;)&quot;,
              description: &quot;Track #&quot; + string(position) + &quot; of room &quot; + string(roomSlug) + &quot; — &quot; + string(title),
              actor_did: if callerDid != null then callerDid else &quot;did:web:live.etzhayyim.com&quot;,
              org_did: if orgDid != null then orgDid else &quot;anon&quot;,
              at_did: callerDid,
              created_at: string(now())
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
          <zeebe:output source="=true" target="ok"/>
          <zeebe:output source="=&quot;at://&quot; + (if callerDid != null then string(callerDid) else &quot;did:web:live.etzhayyim.com&quot;) + &quot;/com.etzhayyim.apps.live.track/&quot; + string(roomSlug) + &quot;-&quot; + string(position)" target="vertexId"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit live.tweakTrack">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:live.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;live.tweakTrack&quot;" target="action"/>
          <zeebe:input source="={
              roomSlug: roomSlug,
              position: position,
              title: title,
              bpm: bpm,
              dance: dance,
              audio: audio,
              callerDid: callerDid
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
