<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.etzhayyim.apps.live.postChat — append an actor utterance to a live room.

  Three-task flow:
    1. generic.db.insert  → vertex_live_chat (Tier 2 Domain write)
    2. generic.pds.dispatch → app.bsky.feed.post as actorDid (Tier 1
       Social write — federation via AT Protocol firehose)
    3. generic.audit.emit → live.postChat (audit trail)

  RLS shape per ADR-0095. The federation step is best-effort: a 4xx
  from atproto.etzhayyim.com (e.g. unmintable Service Auth for the actor)
  doesn't roll back the local chat row — viewers still see the bubble
  via the WebSocket fan-out from the DO.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_live_post_chat"
    targetNamespace="https://etzhayyim.ai/bpmn/apps/live"
    exporter="hand-written" exporterVersion="1.1">
  <bpmn:process id="live_post_chat" name="live postChat" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>

    <!-- 1. Tier 2 Domain write — vertex_live_chat. -->
    <bpmn:serviceTask id="Task_Save" name="vertex_live_chat insert">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_live_chat&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id: &quot;at://&quot; + string(actorDid) + &quot;/com.etzhayyim.apps.live.chat/&quot; + string(now()) + &quot;-&quot; + string(actorDid),
              room_slug: roomSlug,
              actor_handle: handle,
              text: text,
              kind: kind,
              tint_r: if tint != null then tint[1] else null,
              tint_g: if tint != null then tint[2] else null,
              tint_b: if tint != null then tint[3] else null,
              posted_at: now(),
              name: string(handle) + &quot;: &quot; + string(text),
              description: text,
              actor_did: actorDid,
              org_did: if orgDid != null then orgDid else &quot;anon&quot;,
              at_did: actorDid,
              created_at: string(now())
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
          <zeebe:output source="=true" target="accepted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_F</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F" sourceRef="Task_Save" targetRef="Task_Federate"/>

    <!-- 2. Tier 1 Social write — app.bsky.feed.post as actorDid.
         The post text is prefixed with the room handle so the
         federation feed makes context-free sense. Best-effort:
         retries=0 keeps the chat fan-out fast and avoids reposting
         duplicates if the worker re-activates after timeout. -->
    <bpmn:serviceTask id="Task_Federate" name="app.bsky.feed.post (as actor)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch" retries="0"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;app.bsky.feed.post&quot;" target="type"/>
          <zeebe:input source="=actorDid" target="callerDid"/>
          <zeebe:input source="={
              repo: actorDid,
              record: {
                  &quot;$type&quot;: &quot;app.bsky.feed.post&quot;,
                  text: &quot;[live:&quot; + string(roomSlug) + &quot;] &quot; + string(text),
                  createdAt: string(now()),
                  langs: [&quot;ja&quot;],
                  labels: {
                      &quot;$type&quot;: &quot;com.atproto.label.defs#selfLabels&quot;,
                      values: [{ val: &quot;live-room-chat&quot; }]
                  }
              }
          }" target="payload"/>
          <zeebe:output source="=body.uri" target="federatedUri"/>
          <zeebe:output source="=status" target="federatedStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Federate" targetRef="Task_Audit"/>

    <!-- 3. Audit. Captures the federation status for observability. -->
    <bpmn:serviceTask id="Task_Audit" name="audit live.postChat">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:live.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;live.postChat&quot;" target="action"/>
          <zeebe:input source="={
              roomSlug: roomSlug,
              actorDid: actorDid,
              kind: kind,
              federatedUri: federatedUri,
              federatedStatus: federatedStatus
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
