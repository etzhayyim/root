<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_broker_charter_demurrage" targetNamespace="https://etzhayyim.ai/bpmn/open-broker-charter" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_broker_charter_demurrage" name="Demurrage" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="demurrage">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_broker_demurrage&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, demurrage_id: demurrageId, charter_vid: charterVid, imo: imo, port_vid: portVid, laytime_hours: laytimeHours, actual_hours: actualHours, rate_usd_day: rateUsdDay, total_usd: totalUsd, cost_tier: if totalUsd != null and totalUsd &gt;= 500000 then &quot;severe&quot; else if totalUsd != null and totalUsd &gt;= 100000 then &quot;significant&quot; else if totalUsd != null and totalUsd &gt;= 20000 then &quot;moderate&quot; else &quot;minor&quot;, reported_at: reportedAt, status: &quot;billed&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-broker-charter&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-broker-charter.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;openBrokerCharter.demurrage.record&quot;" target="action"/><zeebe:input source="={vertexId: vertexId, demurrageId: demurrageId, totalUsd: totalUsd}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
