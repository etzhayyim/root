<?xml version="1.0" encoding="UTF-8"?>
<!--
  adsk.etzhayyim.com — HuggingFace dataset ingest (autonomous, monthly).

  Timer-start: every 30d. Iterates vertex_hf_dataset rows with
  status='active' and last_synced_at older than 28d, calling the
  pyzeebe primitive task_adsk_dataset_ingest_all (which itself does
  the loop). Phase 1 seed = 5 ADSKAILab text/code datasets.

  Manual one-shot ingest: see CLAUDE.md "Recent Completion: adsk".

  No XRPC entry. No CF Worker. Pure BPMN-as-actor + pyzeebe handler.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_adsk_ingest_dataset"
    targetNamespace="https://etzhayyim.ai/bpmn/adsk"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="adsk_ingest_dataset" name="adsk HF dataset ingest (monthly)" isExecutable="true">

    <bpmn:startEvent id="StartTimer" name="monthly day 6">
      <bpmn:outgoing>Flow_Ingest</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 0 6 * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_IngestAll" name="ingest all HF datasets in catalog">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="adsk.dataset.ingestAll"/>
        <zeebe:ioMapping>
          <zeebe:input source="=2419200" target="staleSeconds"/>
          <zeebe:input source="=10000" target="perDatasetLimit"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ingest</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Ingest" sourceRef="StartTimer" targetRef="Task_IngestAll"/>

    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:adsk.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;adsk.dataset.ingestAll&quot;" target="action"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_IngestAll" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
