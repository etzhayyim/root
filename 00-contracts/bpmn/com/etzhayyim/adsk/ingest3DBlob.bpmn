<?xml version="1.0" encoding="UTF-8"?>
<!--
  adsk.etzhayyim.com — 3D blob manifest registration (ADR-2605080700 Phase 2).

  Timer-start: monthly. Drives `task_adsk_3d_blob_ingest` to register a
  caller-staged ABC-1M / Make-A-Shape / WaLa sample as a row in
  `vertex_3d_blob`. Per ADR-2605080700, the heavy fetch+upload-to-B2
  path is not yet automated; this BPMN provides the autonomous timer
  hook so once a separate Job populates B2, the registration is one
  pyzeebe call away.

  Phase A: timer fires but does nothing until operator stages a sample
  via direct pyzeebe call. Phase B will replace the inert Task with a
  ServiceTask that walks the HF Hub source repo + uploads.

  No XRPC entry. No CF Worker. Pure BPMN-as-actor + pyzeebe handler.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_adsk_ingest_3d_blob"
    targetNamespace="https://etzhayyim.ai/bpmn/adsk"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="adsk_ingest_3d_blob" name="adsk 3D blob register (monthly)" isExecutable="true">

    <bpmn:startEvent id="StartTimer" name="monthly day 8">
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 0 8 * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Audit" name="audit (Phase A no-op)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:adsk.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;adsk.blob3d.ingest.tick&quot;" target="action"/>
          <zeebe:input source="=&quot;phase-a-noop&quot;" target="status"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="StartTimer" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
