<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_asia_refinery_record_crack_spread"
    targetNamespace="https://etzhayyim.ai/bpmn/open-asia-refinery"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_asia_refinery_record_crack_spread" name="refinery crack spread" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Classify"/>
    <bpmn:serviceTask id="Task_Classify" name="分類">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT 1 AS ok LIMIT 1&quot;" target="query"/>
          <zeebe:input source="=[]" target="params"/>
          <zeebe:output source="=if spreadUsdBbl &lt; 0 then &quot;distressed&quot; else if spreadUsdBbl &lt; 5 then &quot;weak&quot; else if spreadUsdBbl &lt; 15 then &quot;healthy&quot; else &quot;boom&quot;" target="healthTier"/>
          <zeebe:output source="=spreadUsdBbl &lt; 0 or spreadUsdBbl &gt;= 15" target="requireAlert"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_Save</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Save" sourceRef="Task_Classify" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="spread 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_asia_refinery_crack_spread&quot;" target="table"/>
          <zeebe:input source="={vertex_id: vertexId, quote_id: quoteId, refinery_code: refineryCode, benchmark: benchmark, spread_usd_bbl: spreadUsdBbl, health_tier: healthTier, require_alert: requireAlert, quoted_at: quotedAt, status: &quot;published&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-asia-refinery&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Save</bpmn:incoming><bpmn:outgoing>Flow_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Gate" sourceRef="Task_Save" targetRef="Gate"/>
    <bpmn:exclusiveGateway id="Gate" default="Flow_Log">
      <bpmn:incoming>Flow_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Major</bpmn:outgoing>
      <bpmn:outgoing>Flow_Log</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Major" sourceRef="Gate" targetRef="Task_AuditMajor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=requireAlert = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Log" sourceRef="Gate" targetRef="Task_AuditLog"/>
    <bpmn:serviceTask id="Task_AuditMajor" name="audit openAsiaRefinery.spread.alert">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-asia-refinery.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openAsiaRefinery.spread.alert&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, refineryCode: refineryCode, benchmark: benchmark, spreadUsdBbl: spreadUsdBbl, healthTier: healthTier}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Major</bpmn:incoming><bpmn:outgoing>Flow_EM</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EM" sourceRef="Task_AuditMajor" targetRef="End_M"/>
    <bpmn:serviceTask id="Task_AuditLog" name="audit openAsiaRefinery.spread.record">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-asia-refinery.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openAsiaRefinery.spread.record&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, refineryCode: refineryCode, benchmark: benchmark, spreadUsdBbl: spreadUsdBbl, healthTier: healthTier}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Log</bpmn:incoming><bpmn:outgoing>Flow_EL</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EL" sourceRef="Task_AuditLog" targetRef="End_L"/>
    <bpmn:endEvent id="End_L"><bpmn:incoming>Flow_EL</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_M"><bpmn:incoming>Flow_EM</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
