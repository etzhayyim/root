<?xml version="1.0" encoding="UTF-8"?>
<!--
  Timer-start BPMN — murakumo cron tick (every 5 min).
  Replaces CF cron trigger per ADR-2604251801 §4-A and ADR-0056.

  NSID: com.etzhayyim.apps.murakumo.cronTick
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/murakumo-cron-tick-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_murakumo_cron_tick"
    targetNamespace="https://etzhayyim.ai/bpmn/murakumo"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="murakumo_cron_tick" name="murakumo cron tick (R/PT5M)" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.murakumo.cronTick", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="every 5 min">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">R/PT5M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_Tick"/>

    <bpmn:serviceTask id="Task_Tick" name="cronTick XRPC">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.http.fetch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;https://murakumo.etzhayyim.com/xrpc/com.etzhayyim.apps.murakumo.cronTick&quot;" target="url"/>
          <zeebe:input source="=&quot;POST&quot;"             target="method"/>
          <zeebe:input source="=&quot;application/json&quot;" target="contentType"/>
          <zeebe:input source="={}"                           target="body"/>
          <zeebe:input source="=45000"                        target="timeoutMs"/>
          <zeebe:output source="=status"   target="tickStatus"/>
          <zeebe:output source="=bodyJson" target="tickResult"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Tick" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="emit murakumo.cron.tick OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.murakumo.cron.tick&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;status&quot;: tickStatus, &quot;ok&quot;: tickResult.ok }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
