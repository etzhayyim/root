<?xml version="1.0" encoding="UTF-8"?>
<!--
  murakumo.fleetHealthCheck — scheduled LiteLLM/Mac Mini fleet sampler.

  CF Worker remains the OpenAI-compatible request gateway. This BPMN process
  moves the periodic health sampling loop to Zeebe/PyZeebe so K8s owns cron,
  retry, and worker lifecycle.

  NSID: com.etzhayyim.apps.murakumo.fleetHealthCheck
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_murakumo_fleet_health_check"
    targetNamespace="https://etzhayyim.ai/bpmn/murakumo"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="murakumo_fleet_health_check" name="murakumo fleetHealthCheck" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.murakumo.fleetHealthCheck", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="every 5m">
      <bpmn:outgoing>Flow_ToCheck</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_5m">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT5M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToCheck" sourceRef="Start" targetRef="Task_Check"/>

    <bpmn:serviceTask id="Task_Check" name="sample fleet health">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="murakumo.fleet.healthCheck"/>
        <zeebe:ioMapping>
          <zeebe:input source="=if litellmUrl = null then &quot;&quot; else string(litellmUrl)" target="litellmUrl"/>
          <zeebe:input source="=false" target="flush"/>
          <zeebe:output source="=uri" target="fleetHealthUri"/>
          <zeebe:output source="=healthPct" target="healthPct"/>
          <zeebe:output source="=nodesHealthy" target="nodesHealthy"/>
          <zeebe:output source="=nodesTotal" target="nodesTotal"/>
          <zeebe:output source="=litellmReachable" target="litellmReachable"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Check" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
