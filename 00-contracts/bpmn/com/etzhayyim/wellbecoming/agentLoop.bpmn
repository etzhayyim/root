<?xml version="1.0" encoding="UTF-8"?>
<!--
  wellbecoming.agentLoop — ADR-2604291800.

  XRPC-triggered (none-start). Called by the infer.ts emitWellBecomingEvent
  path or any actor that wants a Well-Becoming-optimized agent response.

  LangGraph loop:
    load_profile → generate_response → evaluate_spirit
      → (separating + refinements < 2) → refine → generate_response
      → emit_event → END

  NSID: com.etzhayyim.apps.wellbecoming.agentLoop
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/wellbecoming-agent-loop-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_wellbecoming_agent_loop"
    targetNamespace="https://etzhayyim.ai/bpmn/wellbecoming"
    exporter="hand-written"
    exporterVersion="2.0">

  <bpmn:process id="wellbecoming_agent_loop" name="Well-Becoming Agent Loop" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.wellbecoming.agentLoop", "version": 1, "resultTimeoutMs": 120000 }
    </bpmn:documentation>

    <!-- None-start: triggered via XRPC / dispatcher POST -->
    <bpmn:startEvent id="Start_Manual" name="XRPC trigger">
      <bpmn:outgoing>Flow_ToLoop</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToLoop" sourceRef="Start_Manual" targetRef="Task_AgentLoop"/>

    <!--
      Single LangGraph task that runs the full loop internally.
      The graph handles: load_profile → generate → evaluate_spirit →
      (conditional refine) → emit_event.
      BPMN is intentionally thin here — the complexity lives in Python.
    -->
    <bpmn:serviceTask id="Task_AgentLoop" name="LangGraph Well-Becoming loop">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="wellbecoming.agent.loop"/>
        <zeebe:ioMapping>
          <zeebe:output source="=response_final"       target="responseFinal"/>
          <zeebe:output source="=spirit_assessment"    target="spiritAssessment"/>
          <zeebe:output source="=refinement_count"     target="refinementCount"/>
          <zeebe:output source="=wb_event_id"          target="wbEventId"/>
          <zeebe:output source="=bottleneck_axis"      target="bottleneckAxis"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToLoop</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_AgentLoop" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
