<?xml version="1.0" encoding="UTF-8"?>
<!--
  wellbecoming.proactiveConnect — ADR-2604291800.

  Fires every 2h. Finds callers in mv_wellbecoming_at_risk who have not
  received a proactive message recently, then sends a warm check-in via
  vertex_repo_record (C-path, graph-visible).

  NSID: com.etzhayyim.apps.wellbecoming.proactiveConnect
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/wellbecoming-proactive-connect-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_wellbecoming_proactive_connect"
    targetNamespace="https://etzhayyim.ai/bpmn/wellbecoming"
    exporter="hand-written"
    exporterVersion="2.0">

  <bpmn:process id="wellbecoming_proactive_connect" name="Well-Becoming Proactive Connect" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.wellbecoming.proactiveConnect", "version": 1, "resultTimeoutMs": 180000 }
    </bpmn:documentation>

    <!-- Timer: every 2h -->
    <bpmn:startEvent id="Start" name="every 2h">
      <bpmn:outgoing>Flow_ToConnect</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_2h">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT2H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToConnect" sourceRef="Start" targetRef="Task_Connect"/>

    <!-- Find at-risk callers + send warm check-in via C-path -->
    <bpmn:serviceTask id="Task_Connect" name="proactive connect at-risk callers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="wellbecoming.proactive.connect"/>
        <zeebe:ioMapping>
          <zeebe:input source="=10"   target="max_callers"/>
          <zeebe:input source="=7200" target="min_interval_seconds"/>
          <zeebe:output source="=connected_count"  target="connectedCount"/>
          <zeebe:output source="=skipped_count"    target="skippedCount"/>
          <zeebe:output source="=error_count"      target="errorCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToConnect</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Connect" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
