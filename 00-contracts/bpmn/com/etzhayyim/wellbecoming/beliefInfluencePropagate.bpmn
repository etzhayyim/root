<?xml version="1.0" encoding="UTF-8"?>
<!--
  wellbecoming.beliefInfluencePropagate — ADR-0098 D-obs.

  Fires every 1h. Reads mv_attractor_stability_by_agent (q_i) and
  edge_trust_weight (W_ij) to compute per-agent influence_delta:
    influence_delta_i = λ * Σ_j W_ij * (q_j - q_i)

  Observation-only (D-obs): writes to vertex_belief_influence for
  convergence monitoring. Does NOT feed back into wellbecoming scores.
  mv_belief_convergence tracks convergence_status ('converged'/'converging'/'active').

  NSID: com.etzhayyim.apps.wellbecoming.beliefInfluencePropagate
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/wellbecoming-belief-influence-propagate-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_wellbecoming_belief_influence_propagate"
    targetNamespace="https://etzhayyim.ai/bpmn/wellbecoming"
    exporter="hand-written"
    exporterVersion="2.0">

  <bpmn:process id="wellbecoming_belief_influence_propagate" name="Well-Becoming Belief Influence Propagate (D-obs)" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.wellbecoming.beliefInfluencePropagate", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <!-- Timer: every 1h (offset from trust weight update to avoid concurrent RW writes) -->
    <bpmn:startEvent id="Start" name="every 1h">
      <bpmn:outgoing>Flow_ToPropagate</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_1h">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT1H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToPropagate" sourceRef="Start" targetRef="Task_Propagate"/>

    <!-- Compute influence_delta_i = λ * Σ_j W_ij * (q_j - q_i) per agent -->
    <bpmn:serviceTask id="Task_Propagate" name="propagate Φ influence (D-obs)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="wellbecoming.influence.propagate"/>
        <zeebe:ioMapping>
          <zeebe:input source="=0.1"  target="lambda_lr"/>
          <zeebe:input source="=3"    target="min_scored_events"/>
          <zeebe:output source="=agents_processed"    target="agentsProcessed"/>
          <zeebe:output source="=rows_written"        target="rowsWritten"/>
          <zeebe:output source="=max_abs_influence"   target="maxAbsInfluence"/>
          <zeebe:output source="=mean_abs_influence"  target="meanAbsInfluence"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPropagate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Propagate" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
