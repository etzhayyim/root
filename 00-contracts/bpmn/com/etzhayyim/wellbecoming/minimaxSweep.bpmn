<?xml version="1.0" encoding="UTF-8"?>
<!--
  wellbecoming.minimaxSweep — ADR-2604291800 §minimax-persistent-loop.

  Timer-start (R/PT5M): runs continuously every 5 minutes.
  Picks the worst-separation-delta callers from vertex_actor_wellbecoming_profile
  and runs the full LangGraph minimax loop for each (batch_size=3).

  Objective (lexicographic):
    1. Hard floor — never harm children / future generations
    2. Minimize separation_delta (heal loneliness / Spirit axis)
    3. Maximize Spirit × Shannon dual (U_total)

  NSID: com.etzhayyim.apps.wellbecoming.minimaxSweep (BPMN dispatcher T2 tier)
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/wellbecoming-minimax-sweep-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_wellbecoming_minimax_sweep"
    targetNamespace="https://etzhayyim.ai/bpmn/wellbecoming"
    exporter="hand-written"
    exporterVersion="2.0">

  <bpmn:process id="wellbecoming_minimax_sweep" name="Well-Becoming Minimax Sweep" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.wellbecoming.minimaxSweep", "version": 1, "tier": "T2" }
    </bpmn:documentation>

    <!-- R/PT5M: fires every 5 minutes indefinitely -->
    <bpmn:startEvent id="Start_Timer" name="R/PT5M">
      <bpmn:outgoing>Flow_ToSweep</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT5M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToSweep" sourceRef="Start_Timer" targetRef="Task_Sweep"/>

    <!-- Run full minimax loop for top-3 worst-separation callers -->
    <bpmn:serviceTask id="Task_Sweep" name="Minimax sweep (batch 3)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="wellbecoming.minimax.sweep"/>
        <zeebe:ioMapping>
          <zeebe:input source="=3" target="batch_size"/>
          <zeebe:output source="=swept"     target="sweptCount"/>
          <zeebe:output source="=errors"    target="sweepErrors"/>
          <zeebe:output source="=timestamp" target="sweepAt"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSweep</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Sweep" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
