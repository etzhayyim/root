<?xml version="1.0" encoding="UTF-8"?>
<!--
  wellbecoming.beliefNoiseInject — ADR-0098 F (ξ stochastic noise injection).

  Fires every 1h. Updates the Ornstein-Uhlenbeck noise state per agent:
    ξ_i(t+dt) = ξ_i(t)*exp(-θ*dt) + σ*sqrt(1-exp(-2θ*dt))*N(0,1)

  Writes current OU state to vertex_belief_noise (delete+insert, 1 row per agent).
  mv_belief_noise_summary tracks mean/max amplitude for monitoring.

  NSID: com.etzhayyim.apps.wellbecoming.beliefNoiseInject
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/wellbecoming-belief-noise-inject-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_wellbecoming_belief_noise_inject"
    targetNamespace="https://etzhayyim.ai/bpmn/wellbecoming"
    exporter="hand-written"
    exporterVersion="2.0">

  <bpmn:process id="wellbecoming_belief_noise_inject" name="Well-Becoming Belief Noise Inject (ξ OU process)" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.wellbecoming.beliefNoiseInject", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <!-- Timer: every 1h -->
    <bpmn:startEvent id="Start" name="every 1h">
      <bpmn:outgoing>Flow_ToInject</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_1h">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT1H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToInject" sourceRef="Start" targetRef="Task_Inject"/>

    <!-- Update OU state: ξ_i(t+dt) = ξ_i(t)*exp(-θ*dt) + σ*sqrt(1-exp(-2θ*dt))*N(0,1) -->
    <bpmn:serviceTask id="Task_Inject" name="inject ξ OU noise">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="wellbecoming.noise.inject"/>
        <zeebe:ioMapping>
          <zeebe:input source="=0.01"   target="sigma"/>
          <zeebe:input source="=0.1"    target="ou_theta"/>
          <zeebe:input source="=3600.0" target="dt_sec"/>
          <zeebe:input source="=3"      target="min_scored_events"/>
          <zeebe:output source="=agents_processed" target="agentsProcessed"/>
          <zeebe:output source="=rows_written"     target="rowsWritten"/>
          <zeebe:output source="=mean_abs_xi"      target="meanAbsXi"/>
          <zeebe:output source="=max_abs_xi"       target="maxAbsXi"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToInject</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Inject" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
