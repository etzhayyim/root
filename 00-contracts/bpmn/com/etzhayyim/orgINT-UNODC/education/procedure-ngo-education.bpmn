<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="NGO_INT_UNODC" targetNamespace="http://etzhayyim.com/ngo/INT/UNODC/education">
  <bpmn:process id="Process_INT_UNODC_education" isExecutable="true">
    <bpmn:startEvent id="S" name="Grant/program request"/>
