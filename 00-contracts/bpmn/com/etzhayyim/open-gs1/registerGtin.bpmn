<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_gs1_register_gtin"
    targetNamespace="https://etzhayyim.ai/bpmn/open-gs1"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_gs1_register_gtin" name="GTIN 登録" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="gtin 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_gs1_gtin&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id: vertexId, gtin: gtin, gtin_format: gtinFormat,
              brand_org_id: brandOrgId, product_name: productName,
              product_category: productCategory, country_of_origin: countryOfOrigin,
              net_weight_g: netWeightG, container_type: containerType,
              check_digit_valid: checkDigitValid,
              status: &quot;active&quot;, registered_at: registeredAt,
              created_at: string(now()), owner_did: callerDid,
              sensitivity_ord: 1, org_id: brandOrgId,
              user_id: callerDid, actor_id: &quot;sys.bpmn.open-gs1&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit gtin.register">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-gs1.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openGs1.gtin.register&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, gtin: gtin, gtinFormat: gtinFormat, productCategory: productCategory}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
