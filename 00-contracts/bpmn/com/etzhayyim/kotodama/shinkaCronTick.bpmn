<?xml version="1.0" encoding="UTF-8"?>
<!--
  Z-β — BPMN replacement for the K8s CronJob `shinka-tick` (templates/
  cronjob-shinka.yaml, retired 2026-04-23). Zeebe's timer start event
  owns scheduling; the worker task `com.etzhayyim.shinka.tick` wraps the
  existing `shinka_tick_actor` SQL UDF so the per-actor LangGraph
  cadence gate stays intact.

  Flow:
    Start (timerEventDefinition: R/PT15M)
      → serviceTask com.etzhayyim.shinka.tick   actor = did:web:yoro.etzhayyim.com
      → End

  When the actor roster grows past 1, swap the hardcoded `actor` input
  for a `generic.db.select` that reads eligible DIDs from a vertex
  table and a multi-instance loop over the result.

  Cadence choices supported by Zeebe 8.6:
    - ISO 8601: `R/PT15M` (used here; fires every 15m from deploy)
    - cron:     `0 */15 * * * *` (Spring six-field; aligns to wall-clock)
  ISO picked for simplicity — shinka ticks are cadence-relative, not
  wall-clock-pinned.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_shinka_cron_tick"
    targetNamespace="https://etzhayyim.ai/bpmn/kotodama"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="shinka_cron_tick" name="shinka cron tick" isExecutable="true">

    <bpmn:startEvent id="Start" name="every 15min">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_15m">
        <!-- ISO 8601 repeating cycle, every 15m from deploy. Matches
             the prior K8s CronJob cadence. Zeebe 8.6 also accepts
             Spring-style 6-field cron (`0 */15 * * * *`) when we want
             strict wall-clock alignment. -->
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">R/PT15M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_Tick"/>

    <bpmn:serviceTask id="Task_Tick" name="shinka tick yoro">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.shinka.tick"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:yoro.etzhayyim.com&quot;" target="actor"/>
          <zeebe:output source="=actor"            target="tickActor"/>
          <zeebe:output source="=mood"             target="tickMood"/>
          <zeebe:output source="=actions"          target="tickActions"/>
          <zeebe:output source="=heartbeatWritten" target="hbWritten"/>
          <zeebe:output source="=evolutionWritten" target="evoWritten"/>
          <zeebe:output source="=tickMs"           target="tickMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Tick" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
