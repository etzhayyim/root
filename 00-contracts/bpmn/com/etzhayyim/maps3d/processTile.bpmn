<?xml version="1.0" encoding="UTF-8"?>
<!--
  maps3d.processTile — single-tile photogrammetry pipeline.

  Cadence: timer-start R/PT15M draws one pending tile per tick; manual
  invocation via `POST http://dispatcher.etzhayyim.com:8080/xrpc/com.etzhayyim.apps.maps3d.processTile`
  with { tileH3 } skips the picker.

  Pipeline (sequential within one tile, time-budgeted):
    1. generic.db.select   — one pending row from vertex_maps3d_tile (priority DESC)
    2. exclusive gateway   — bail out cleanly if no work
    3. maps3d.fetchMapillary  — Mapillary v4 candidate set
    4. maps3d.curateImages    — LangGraph 30-image down-select
    5. maps3d.colmapTile      — COLMAP CPU dense reconstruction (boundary timer 60min)
    6. exclusive gateway      — success?
        no  → maps3d.replanReconstruction → End (mark tile failed)
        yes → continue
    7. maps3d.simplifyAndExport — Open3D quadric decimate + saturated GLB
    8. maps3d.visionAnnotate    — Murakumo Vision over the curated images
    9. maps3d.linkActor         — LangGraph entity → registry DID disambiguation
   10. generic.db.insert        — vertex_spatial Building rows + edges + vertex_maps3d_tile.status=done
   11. generic.audit.emit       — OCEL maps3d.tile.processed
   12. End

  Steady-state throughput: 1 tile / ~45 min on a 2-core colmap-worker pod.
  Tokyo landmark backfill (~2,000 tiles) ≈ 60 days end-to-end with one pod.

  NSID: com.etzhayyim.apps.maps3d.processTile
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/maps3d-process-tile-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_maps3d_process_tile"
    targetNamespace="https://etzhayyim.ai/bpmn/maps3d"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="maps3d_process_tile" name="maps3d processTile" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.maps3d.processTile", "version": 1, "resultTimeoutMs": 5400000 }
    </bpmn:documentation>

    <!-- ============================== Start ============================== -->
    <bpmn:startEvent id="Start" name="every 15 minutes">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_PT15M">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT15M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="Start" targetRef="Task_SelectTile"/>

    <!-- 1. Pick one pending tile from the registry. attempt_count is
         pulled so the replanner can apply its bounded-retry policy. -->
    <bpmn:serviceTask id="Task_SelectTile" name="select pending tile">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_maps3d_tile&quot;" target="table"/>
          <zeebe:input source="=&quot;tile_h3, priority, image_count, status, attempt_count&quot;" target="columns"/>
          <zeebe:input source="=1" target="limit"/>
          <zeebe:input source="=&quot;priority ASC, last_attempt_at NULLS FIRST, tile_h3 ASC&quot;" target="orderBy"/>
          <zeebe:input source="=&quot;status IN ('pending','stale')&quot;" target="where"/>
          <zeebe:output source="=rows" target="tileRows"/>
          <zeebe:output source="=rowCount" target="tileCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterSelect</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AfterSelect" sourceRef="Task_SelectTile" targetRef="Gateway_HasTile"/>

    <bpmn:exclusiveGateway id="Gateway_HasTile" name="tile?">
      <bpmn:incoming>Flow_AfterSelect</bpmn:incoming>
      <bpmn:outgoing>Flow_Yes_HasTile</bpmn:outgoing>
      <bpmn:outgoing>Flow_No_HasTile</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_No_HasTile" sourceRef="Gateway_HasTile" targetRef="End">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=tileCount &lt;= 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Yes_HasTile" sourceRef="Gateway_HasTile" targetRef="Task_FetchMapillary">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=tileCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- 3. Mapillary candidate set. -->
    <bpmn:serviceTask id="Task_FetchMapillary" name="fetch Mapillary candidates">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="maps3d.fetchMapillary"/>
        <zeebe:ioMapping>
          <zeebe:input source="=tileRows[1].tile_h3" target="tileH3"/>
          <zeebe:input source="=200" target="maxImages"/>
          <zeebe:input source="=0.5" target="minQuality"/>
          <zeebe:output source="=candidates" target="mapillaryCandidates"/>
          <zeebe:output source="=totalAvailable" target="mapillaryTotal"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Yes_HasTile</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterFetch</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AfterFetch" sourceRef="Task_FetchMapillary" targetRef="Task_CurateImages"/>

    <!-- 4. LangGraph image curation. -->
    <bpmn:serviceTask id="Task_CurateImages" name="curate images (LangGraph)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="maps3d.curateImages"/>
        <zeebe:ioMapping>
          <zeebe:input source="=tileRows[1].tile_h3" target="tileH3"/>
          <zeebe:input source="=mapillaryCandidates" target="candidates"/>
          <zeebe:input source="=30" target="targetCount"/>
          <zeebe:input source="=8" target="minCount"/>
          <zeebe:output source="=selectedIds" target="selectedIds"/>
          <zeebe:output source="=abort" target="curateAbort"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AfterFetch</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterCurate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AfterCurate" sourceRef="Task_CurateImages" targetRef="Gateway_CurateOK"/>

    <bpmn:exclusiveGateway id="Gateway_CurateOK" name="enough images?">
      <bpmn:incoming>Flow_AfterCurate</bpmn:incoming>
      <bpmn:outgoing>Flow_Curate_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Curate_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Curate_No" sourceRef="Gateway_CurateOK" targetRef="Task_FailedAudit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=curateAbort = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Curate_Yes" sourceRef="Gateway_CurateOK" targetRef="Task_Colmap">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=curateAbort = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- 5. COLMAP CPU dense reconstruction with 60-min hard timeout. -->
    <bpmn:serviceTask id="Task_Colmap" name="COLMAP dense (CPU, 60min budget)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="maps3d.colmapTile"/>
        <zeebe:ioMapping>
          <zeebe:input source="=tileRows[1].tile_h3" target="tileH3"/>
          <zeebe:input source="=selectedIds" target="selectedIds"/>
          <zeebe:input source="=mapillaryCandidates" target="imageUrls"/>
          <zeebe:input source="=true" target="denseEnabled"/>
          <zeebe:input source="=&quot;exhaustive&quot;" target="matcher"/>
          <zeebe:output source="=ok" target="colmapOk"/>
          <zeebe:output source="=rawMeshUri" target="rawMeshUri"/>
          <zeebe:output source="=imageCount" target="registeredImages"/>
          <zeebe:output source="=errorCode" target="colmapErrorCode"/>
          <zeebe:output source="=errorMessage" target="colmapErrorMessage"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Curate_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterColmap</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_ColmapTimeout" attachedToRef="Task_Colmap" name="60 min">
      <bpmn:outgoing>Flow_ColmapTimeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_Colmap_60min">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT60M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_ColmapTimeout" sourceRef="Boundary_ColmapTimeout" targetRef="Task_Replan"/>
    <bpmn:sequenceFlow id="Flow_AfterColmap" sourceRef="Task_Colmap" targetRef="Gateway_ColmapOK"/>

    <bpmn:exclusiveGateway id="Gateway_ColmapOK" name="reconstruct ok?">
      <bpmn:incoming>Flow_AfterColmap</bpmn:incoming>
      <bpmn:outgoing>Flow_Colmap_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Colmap_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Colmap_No" sourceRef="Gateway_ColmapOK" targetRef="Task_Replan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=colmapOk = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Colmap_Yes" sourceRef="Gateway_ColmapOK" targetRef="Task_Simplify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=colmapOk = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- 6. Failure replanner (LangGraph) — bounded retry policy.
         attempt = (current attempt_count from row) + 1. The worker
         caps retries at 2 attempts and falls back to downgradeOsm so
         transient failures never permanently brick a tile. -->
    <bpmn:serviceTask id="Task_Replan" name="replan reconstruction (LangGraph)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="maps3d.replanReconstruction"/>
        <zeebe:ioMapping>
          <zeebe:input source="=tileRows[1].tile_h3" target="tileH3"/>
          <zeebe:input source="=if colmapErrorCode = null then &quot;TIMEOUT&quot; else colmapErrorCode" target="errorCode"/>
          <zeebe:input source="=if colmapErrorMessage = null then &quot;boundary timer fired&quot; else colmapErrorMessage" target="errorMessage"/>
          <zeebe:input source="=if registeredImages = null then 0 else registeredImages" target="imageCount"/>
          <zeebe:input source="=(if tileRows[1].attempt_count = null then 0 else tileRows[1].attempt_count) + 1" target="attempt"/>
          <zeebe:output source="=action" target="replanAction"/>
          <zeebe:output source="=rationale" target="replanRationale"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Colmap_No</bpmn:incoming>
      <bpmn:incoming>Flow_ColmapTimeout</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterReplan</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AfterReplan" sourceRef="Task_Replan" targetRef="Gateway_ReplanAction"/>

    <!-- 6b. Branch on the replanner's chosen action. retry/requestMore
         loop the tile back into the queue (next R/PT15M tick re-picks
         it with attempt_count incremented). downgradeOsm marks the
         tile so the maps-3d UI keeps showing it via the OSM extrude
         (Phase-1) path. abort is reserved for unrecoverable failures
         and parks the tile until manual review. -->
    <bpmn:exclusiveGateway id="Gateway_ReplanAction" name="replan action?">
      <bpmn:incoming>Flow_AfterReplan</bpmn:incoming>
      <bpmn:outgoing>Flow_Replan_Retry</bpmn:outgoing>
      <bpmn:outgoing>Flow_Replan_RequestMore</bpmn:outgoing>
      <bpmn:outgoing>Flow_Replan_DowngradeOsm</bpmn:outgoing>
      <bpmn:outgoing>Flow_Replan_Abort</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Replan_Retry" sourceRef="Gateway_ReplanAction" targetRef="Task_IncAttempt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=replanAction = "retry"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Replan_RequestMore" sourceRef="Gateway_ReplanAction" targetRef="Task_IncAttempt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=replanAction = "requestMore"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Replan_DowngradeOsm" sourceRef="Gateway_ReplanAction" targetRef="Task_MarkOsmOnly">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=replanAction = "downgradeOsm"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Replan_Abort" sourceRef="Gateway_ReplanAction" targetRef="Task_FailedAudit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=replanAction = "abort"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- 6c. retry/requestMore — bump attempt_count, reset to pending.
         The R/PT15M timer-start picker will re-select this tile on
         the next tick. error_code + error_message are preserved on
         the row for observability. -->
    <bpmn:serviceTask id="Task_IncAttempt" name="bump attempt + requeue">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_maps3d_tile&quot;" target="table"/>
          <zeebe:input source="={ &quot;tile_h3&quot;: tileRows[1].tile_h3, &quot;status&quot;: &quot;pending&quot;, &quot;attempt_count&quot;: (if tileRows[1].attempt_count = null then 0 else tileRows[1].attempt_count) + 1, &quot;last_attempt_at&quot;: &quot;now&quot;, &quot;error_code&quot;: colmapErrorCode, &quot;error_message&quot;: colmapErrorMessage }" target="row"/>
          <zeebe:input source="=&quot;tile_h3&quot;" target="conflictKey"/>
          <zeebe:input source="=&quot;status,attempt_count,last_attempt_at,error_code,error_message&quot;" target="updateColumns"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Replan_Retry</bpmn:incoming>
      <bpmn:incoming>Flow_Replan_RequestMore</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterIncAttempt</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AfterIncAttempt" sourceRef="Task_IncAttempt" targetRef="End"/>

    <!-- 6d. downgradeOsm — terminal state for tiles where photogrammetry
         can't recover. The maps-3d UI still renders them via the
         Phase-1 OSM extrude path (BuildingExtrudeAdapter), so the user
         doesn't see a hole in the world; they just don't get the
         photoreal mesh skin. -->
    <bpmn:serviceTask id="Task_MarkOsmOnly" name="mark tile osm-only">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_maps3d_tile&quot;" target="table"/>
          <zeebe:input source="={ &quot;tile_h3&quot;: tileRows[1].tile_h3, &quot;status&quot;: &quot;osm-only&quot;, &quot;attempt_count&quot;: (if tileRows[1].attempt_count = null then 0 else tileRows[1].attempt_count) + 1, &quot;last_attempt_at&quot;: &quot;now&quot;, &quot;error_code&quot;: colmapErrorCode, &quot;error_message&quot;: colmapErrorMessage }" target="row"/>
          <zeebe:input source="=&quot;tile_h3&quot;" target="conflictKey"/>
          <zeebe:input source="=&quot;status,attempt_count,last_attempt_at,error_code,error_message&quot;" target="updateColumns"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Replan_DowngradeOsm</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterMarkOsmOnly</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AfterMarkOsmOnly" sourceRef="Task_MarkOsmOnly" targetRef="End"/>

    <!-- 7. Open3D simplify + saturated GLB export. -->
    <bpmn:serviceTask id="Task_Simplify" name="simplify + export GLB">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="maps3d.simplifyAndExport"/>
        <zeebe:ioMapping>
          <zeebe:input source="=tileRows[1].tile_h3" target="tileH3"/>
          <zeebe:input source="=rawMeshUri" target="rawMeshUri"/>
          <zeebe:input source="=5000" target="targetTriangles"/>
          <zeebe:input source="=1.3" target="saturate"/>
          <zeebe:input source="=false" target="segmentByFootprint"/>
          <zeebe:output source="=tileMeshUri" target="tileMeshUri"/>
          <zeebe:output source="=triangleCount" target="finalTriangles"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Colmap_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterSimplify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AfterSimplify" sourceRef="Task_Simplify" targetRef="Task_Vision"/>

    <!-- 8. Murakumo Vision annotation across the curated images. -->
    <bpmn:serviceTask id="Task_Vision" name="vision annotate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="maps3d.visionAnnotate"/>
        <zeebe:ioMapping>
          <zeebe:input source="=tileRows[1].tile_h3" target="tileH3"/>
          <zeebe:input source="=selectedIds" target="imageRefs"/>
          <zeebe:input source="=0.55" target="minConfidence"/>
          <zeebe:output source="=detections" target="visionDetections"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AfterSimplify</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterVision</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AfterVision" sourceRef="Task_Vision" targetRef="Task_LinkActor"/>

    <!-- 9. LangGraph actor disambiguation. -->
    <bpmn:serviceTask id="Task_LinkActor" name="link actors (LangGraph)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="maps3d.linkActor"/>
        <zeebe:ioMapping>
          <zeebe:input source="=tileRows[1].tile_h3" target="tileH3"/>
          <zeebe:input source="=visionDetections" target="detections"/>
          <zeebe:input source="=0.7" target="minConfidence"/>
          <zeebe:output source="=links" target="actorLinks"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AfterVision</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterLink</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AfterLink" sourceRef="Task_LinkActor" targetRef="Task_MarkDone"/>

    <!-- 10. Mark tile done. The worker tasks have already INSERT-ed into
         vertex_spatial / vertex_vision_result / edge_* via Hyperdrive. -->
    <bpmn:serviceTask id="Task_MarkDone" name="mark tile done">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_maps3d_tile&quot;" target="table"/>
          <zeebe:input source="={ &quot;tile_h3&quot;: tileRows[1].tile_h3, &quot;status&quot;: &quot;done&quot;, &quot;mesh_uri&quot;: tileMeshUri, &quot;image_count&quot;: registeredImages, &quot;triangle_count&quot;: finalTriangles, &quot;last_attempt_at&quot;: &quot;now&quot; }" target="row"/>
          <zeebe:input source="=&quot;tile_h3&quot;" target="conflictKey"/>
          <zeebe:input source="=&quot;status,mesh_uri,image_count,triangle_count,last_attempt_at&quot;" target="updateColumns"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AfterLink</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterMark</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AfterMark" sourceRef="Task_MarkDone" targetRef="Task_Audit"/>

    <!-- 11. OCEL audit. -->
    <bpmn:serviceTask id="Task_Audit" name="emit maps3d.tile.processed OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.maps3d.tile.processed&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;tileH3&quot;: tileRows[1].tile_h3, &quot;triangles&quot;: finalTriangles, &quot;cameras&quot;: registeredImages, &quot;detections&quot;: count(visionDetections), &quot;links&quot;: count(actorLinks) }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AfterMark</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AfterAudit" sourceRef="Task_Audit" targetRef="End"/>

    <!-- Failure-path audit. Reached only on (a) curator abort (too few
         curated images) or (b) explicit abort from the replanner.
         Marks the row 'failed' so the picker won't immediately re-pick
         it; manual SQL reset is required to retry. -->
    <bpmn:serviceTask id="Task_FailedAudit" name="mark tile failed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_maps3d_tile&quot;" target="table"/>
          <zeebe:input source="={ &quot;tile_h3&quot;: tileRows[1].tile_h3, &quot;status&quot;: &quot;failed&quot;, &quot;last_attempt_at&quot;: &quot;now&quot; }" target="row"/>
          <zeebe:input source="=&quot;tile_h3&quot;" target="conflictKey"/>
          <zeebe:input source="=&quot;status,last_attempt_at&quot;" target="updateColumns"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Curate_No</bpmn:incoming>
      <bpmn:incoming>Flow_Replan_Abort</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterFailedAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AfterFailedAudit" sourceRef="Task_FailedAudit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_AfterAudit</bpmn:incoming>
      <bpmn:incoming>Flow_AfterFailedAudit</bpmn:incoming>
      <bpmn:incoming>Flow_AfterIncAttempt</bpmn:incoming>
      <bpmn:incoming>Flow_AfterMarkOsmOnly</bpmn:incoming>
      <bpmn:incoming>Flow_No_HasTile</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
