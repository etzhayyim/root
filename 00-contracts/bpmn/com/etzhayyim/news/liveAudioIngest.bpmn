<?xml version="1.0" encoding="UTF-8"?>
<!--
  news.liveAudioIngest

  Public live-news/radio audio ingestion bridge. The worker captures a short
  stream window, transcribes it with Murakumo STT, extracts claims, and submits
  the transcript to the existing news intel path. This process is for public
  broadcast/source monitoring only; private meeting capture remains in
  meetingRecorder.

  Input variables:
    sourceId, sourceName, streamUrl, sourceUrl, sourceType, region, country,
    topic, lang, captureSeconds, maxBytes, retainAudio, retentionDays,
    rightsPolicy, publish
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_news_live_audio_ingest"
    targetNamespace="https://etzhayyim.ai/bpmn/news"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="news_live_audio_ingest" name="news live audio ingest" isExecutable="true">
    <bpmn:startEvent id="Start" name="live audio ingest requested">
      <bpmn:outgoing>Flow_Transcribe</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Transcribe" sourceRef="Start" targetRef="Task_Transcribe"/>

    <bpmn:serviceTask id="Task_Transcribe" name="capture and transcribe audio window">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="news.liveAudio.transcribeWindow"/>
        <zeebe:ioMapping>
          <zeebe:input source="=string(sourceId)" target="sourceId"/>
          <zeebe:input source="=string(sourceName)" target="sourceName"/>
          <zeebe:input source="=string(streamUrl)" target="streamUrl"/>
          <zeebe:input source="=string(lang)" target="lang"/>
          <zeebe:input source="=captureSeconds" target="captureSeconds"/>
          <zeebe:input source="=maxBytes" target="maxBytes"/>
          <zeebe:input source="=retainAudio" target="retainAudio"/>
          <zeebe:input source="=retentionDays" target="retentionDays"/>
          <zeebe:input source="=string(rightsPolicy)" target="rightsPolicy"/>
          <zeebe:input source="=string(country)" target="country"/>
          <zeebe:output source="=transcriptText" target="transcriptText"/>
          <zeebe:output source="=language" target="language"/>
          <zeebe:output source="=capturedBytes" target="capturedBytes"/>
          <zeebe:output source="=audioSha256" target="audioSha256"/>
          <zeebe:output source="=audioMimeType" target="audioMimeType"/>
          <zeebe:output source="=audioUri" target="audioUri"/>
          <zeebe:output source="=policyGate" target="transcribePolicyGate"/>
          <zeebe:output source="=effectiveRetainAudio" target="effectiveRetainAudio"/>
          <zeebe:output source="=retentionDays" target="effectiveRetentionDays"/>
          <zeebe:output source="=sttBytes" target="sttBytes"/>
          <zeebe:output source="=sttMimeType" target="sttMimeType"/>
          <zeebe:output source="=sttExtension" target="sttExtension"/>
          <zeebe:output source="=remuxStatus" target="remuxStatus"/>
          <zeebe:output source="=remuxError" target="remuxError"/>
          <zeebe:output source="=streamKind" target="streamKind"/>
          <zeebe:output source="=resolvedStreamUrls" target="resolvedStreamUrls"/>
          <zeebe:output source="=segments" target="transcriptSegments"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Transcribe</bpmn:incoming>
      <bpmn:outgoing>Flow_Extract</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Extract" sourceRef="Task_Transcribe" targetRef="Task_Extract"/>

    <bpmn:serviceTask id="Task_Extract" name="extract broadcast claims">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.json"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;analyst&quot;" target="tier"/>
          <zeebe:input source="=&quot;You are an OSINT broadcast editor. Output one JSON object with keys: title:string, summary:string, facts:string[], findings:string[], entities:object[]. Entities should include objects for places, regions, facilities, incidents, and organizations when mentioned; include name, type, confidence, and lat/lng only when explicitly known from the transcript or source. Use only the supplied transcript. Mark uncertainty when audio text is partial.&quot;" target="system"/>
          <zeebe:input source="=&quot;Source: &quot; + string(sourceName) + &quot;\nStream: &quot; + string(streamUrl) + &quot;\nTranscript:\n&quot; + string(transcriptText)" target="user"/>
          <zeebe:input source="=900" target="maxTokens"/>
          <zeebe:input source="=0.1" target="temperature"/>
          <zeebe:output source="=data" target="extracted"/>
          <zeebe:output source="=model" target="llmModel"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Extract</bpmn:incoming>
      <bpmn:outgoing>Flow_Analyze</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Analyze" sourceRef="Task_Extract" targetRef="Task_Analyze"/>

    <bpmn:serviceTask id="Task_Analyze" name="XRPC analyze live audio intel">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="xrpc.com.etzhayyim.apps.news.analyzeIntel"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:news.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="={ title: string(extracted.title), url: string(if sourceUrl != null and sourceUrl != &quot;&quot; then sourceUrl else streamUrl), sourceId: string(sourceId), sourceType: string(if sourceType != null and sourceType != &quot;&quot; then sourceType else &quot;broadcast&quot;), region: string(region), country: string(country), topic: string(if topic != null and topic != &quot;&quot; then topic else &quot;world&quot;), rightsPolicy: string(rightsPolicy), text: string(transcriptText), summary: string(extracted.summary), facts: extracted.facts, findings: extracted.findings, entities: extracted.entities, publishedAt: now(), publish: false }" target="input"/>
          <zeebe:output source="=result" target="intelReport"/>
          <zeebe:output source="=result.policyGate" target="policyGate"/>
          <zeebe:output source="=result.policyAllowPublish" target="policyAllowPublish"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Analyze</bpmn:incoming>
      <bpmn:outgoing>Flow_PublishGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_PublishGate" sourceRef="Task_Analyze" targetRef="Gate_Publish"/>

    <bpmn:exclusiveGateway id="Gate_Publish" name="publish?" default="Flow_AuditOnly">
      <bpmn:incoming>Flow_PublishGate</bpmn:incoming>
      <bpmn:outgoing>Flow_Publish</bpmn:outgoing>
      <bpmn:outgoing>Flow_AuditOnly</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Publish" sourceRef="Gate_Publish" targetRef="Task_Publish">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=publish = true and policyAllowPublish = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AuditOnly" sourceRef="Gate_Publish" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Publish" name="XRPC publish live audio intel">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="xrpc.com.etzhayyim.apps.news.publishIntel"/>
        <zeebe:ioMapping>
          <zeebe:input source="=intelReport.report" target="input"/>
          <zeebe:output source="=result" target="publishResult"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Publish</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_Publish" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit live audio ingest">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:news.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;news.liveAudioIngest&quot;" target="action"/>
          <zeebe:input source="={ sourceId: string(sourceId), sourceName: string(sourceName), streamUrl: string(streamUrl), streamKind: streamKind, resolvedStreamUrls: resolvedStreamUrls, capturedBytes: capturedBytes, audioSha256: audioSha256, audioMimeType: audioMimeType, audioUri: audioUri, effectiveRetainAudio: effectiveRetainAudio, effectiveRetentionDays: effectiveRetentionDays, transcribePolicyGate: transcribePolicyGate, policyGate: policyGate, sttBytes: sttBytes, sttMimeType: sttMimeType, sttExtension: sttExtension, remuxStatus: remuxStatus, remuxError: remuxError, language: language, llmModel: llmModel, report: intelReport, publishResult: publishResult }" target="payload"/>
          <zeebe:output source="=rkey" target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AuditOnly</bpmn:incoming>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="live audio intel ready">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
