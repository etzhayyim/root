<?xml version="1.0" encoding="UTF-8"?>
<!--
  news.rssIngest

  Zeebe-owned RSS pipeline for news.etzhayyim.com. Python worker performs feed fetch,
  parsing, translation, and social-post drafting. The Cloudflare news worker is
  only the thin edge boundary for PDS writes through commitArticle.

  Input variables:
    sourceId, sources, limit, publish
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_news_rss_ingest"
    targetNamespace="https://etzhayyim.ai/bpmn/news"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="news_rss_ingest" name="news rss ingest" isExecutable="true">
    <bpmn:startEvent id="Start" name="rss ingest requested">
      <bpmn:outgoing>Flow_Resolve</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Resolve" sourceRef="Start" targetRef="Task_Resolve"/>

    <bpmn:serviceTask id="Task_Resolve" name="resolve rss sources">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="news.rss.resolveSources"/>
        <zeebe:ioMapping>
          <zeebe:input source="=string(sourceId)" target="sourceId"/>
          <zeebe:input source="=sources" target="sources"/>
          <zeebe:output source="=sources" target="resolvedSources"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Resolve</bpmn:incoming>
      <bpmn:outgoing>Flow_Ingest</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Ingest" sourceRef="Task_Resolve" targetRef="Task_Ingest"/>

    <bpmn:serviceTask id="Task_Ingest" name="fetch translate and commit rss">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="news.rss.ingestSource"/>
        <zeebe:ioMapping>
          <zeebe:input source="=resolvedSources" target="sources"/>
          <zeebe:input source="=limit" target="limit"/>
          <zeebe:input source="=publish" target="publish"/>
          <zeebe:output source="=results" target="results"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ingest</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_Ingest" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit rss ingest">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:news.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;news.rssIngest&quot;" target="action"/>
          <zeebe:input source="={ sourceId: string(sourceId), results: results }" target="payload"/>
          <zeebe:output source="=rkey" target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="rss ingest committed">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
