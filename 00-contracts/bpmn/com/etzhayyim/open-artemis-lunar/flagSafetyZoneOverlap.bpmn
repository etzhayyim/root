        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_artemis_lunar&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, conflict_id: conflictId, activity_vid: activityVid, overlapping_signatory_iso3: overlappingSignatoryIso3, issue_kind: issueKind, copuos_working_group: copuosWorkingGroup, reported_at: reportedAt, escalation_tier: if issueKind = &quot;resource_claim&quot; or issueKind = &quot;mining_dispute&quot; then &quot;critical&quot; else if issueKind = &quot;safety_zone_overlap&quot; or issueKind = &quot;heritage_site&quot; then &quot;severe&quot; else &quot;routine&quot;, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-artemis-lunar&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
