<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_smartphone_os_fetch_security_patch_delta" targetNamespace="https://etzhayyim.ai/bpmn/open-smartphone-os" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_smartphone_os_fetch_security_patch_delta" name="fetchSecurityPatchDelta" isExecutable="true">
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_S</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Fetch"/>
    <bpmn:serviceTask id="Task_Fetch" name="fetch android bulletin">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.http.fetch"/>
        <zeebe:ioMapping>
          <zeebe:input source="={url: &quot;https://source.android.com/docs/security/bulletin&quot;, method: &quot;GET&quot;}" target="request"/>
          <zeebe:output source="=response.body" target="rawHtml"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_B</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_B" sourceRef="Task_Fetch" targetRef="Task_LLM"/>
    <bpmn:serviceTask id="Task_LLM" name="extract patches">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.json"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;Extract latest Android/Linux mobile security patches and CVE IDs from the bulletin page. List each patch with CVE ID, severity, and affected Android version.&quot;" target="prompt"/>
          <zeebe:input source="=rawHtml" target="context"/>
          <zeebe:input source="={type: &quot;object&quot;, properties: {patches: {type: &quot;array&quot;, items: {type: &quot;object&quot;, properties: {cveId: {type: &quot;string&quot;}, severity: {type: &quot;string&quot;}, affectedVersion: {type: &quot;string&quot;}, patchDate: {type: &quot;string&quot;}}}}}}" target="schema"/>
          <zeebe:output source="=result" target="parsed"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B</bpmn:incoming><bpmn:outgoing>Flow_C</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_C" sourceRef="Task_LLM" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-smartphone-os.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;open.smartphoneOs.fetchSecurityPatchDelta&quot;" target="action"/>
          <zeebe:input source="={count: count(parsed.patches)}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_C</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
