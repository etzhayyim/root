<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_jp_corp_finance_repair_company"
    targetNamespace="https://etzhayyim.ai/bpmn/jp-corp-finance"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="jp_corp_finance_repair_one" name="JP Corporate Finance Repair Company" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.jpCorpFinance.repairCompany", "version": 1 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start_Manual" name="manual">
      <bpmn:outgoing>Flow_CreateRun</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_CreateRun" sourceRef="Start_Manual" targetRef="Task_CreateRun"/>
    <bpmn:sequenceFlow id="Flow_Fetch" sourceRef="Task_CreateRun" targetRef="Task_FetchSource"/>
    <bpmn:sequenceFlow id="Flow_WebpOcr" sourceRef="Task_FetchSource" targetRef="Task_WebpOcr"/>
    <bpmn:sequenceFlow id="Flow_Normalize" sourceRef="Task_WebpOcr" targetRef="Task_Normalize"/>
    <bpmn:sequenceFlow id="Flow_Extract" sourceRef="Task_Normalize" targetRef="Task_Extract"/>
    <bpmn:sequenceFlow id="Flow_ExtractFacts" sourceRef="Task_Extract" targetRef="Task_ExtractFacts"/>
    <bpmn:sequenceFlow id="Flow_Health" sourceRef="Task_ExtractFacts" targetRef="Task_HealthGate"/>
    <bpmn:sequenceFlow id="Flow_ToRwGate" sourceRef="Task_HealthGate" targetRef="Gateway_RwHealthy"/>
    <bpmn:sequenceFlow id="Flow_Write" sourceRef="Gateway_RwHealthy" targetRef="Task_WriteGraph">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rwHealthy = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RwDegraded" sourceRef="Gateway_RwHealthy" targetRef="Task_AuditRwDegraded"/>
    <bpmn:sequenceFlow id="Flow_Coverage" sourceRef="Task_WriteGraph" targetRef="Task_RefreshCoverage"/>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_RefreshCoverage" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:serviceTask id="Task_CreateRun" name="create repair run">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="jpCorpFinance.createRun" retries="3"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_FetchSource" name="fetch company evidence">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="jpCorpFinance.fetchSource" retries="3"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_WebpOcr" name="convert PDF to WebP, pin IPFS, OCR">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="jpCorpFinance.webpOcr" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=sourcePath" target="sourcePath"/>
          <zeebe:input source="=contentB64" target="contentB64"/>
          <zeebe:input source="=contentType" target="contentType"/>
          <zeebe:input source="=3" target="maxPages"/>
          <zeebe:input source="=82" target="webpQuality"/>
          <zeebe:output source="=pages" target="webpPages"/>
          <zeebe:output source="=ocr" target="ocrPages"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Normalize" name="normalize evidence">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="jpCorpFinance.normalize" retries="1"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Extract" name="extract and resolve">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.langgraph.run" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;jp_corp_finance.disclosure_extract_v1&quot;" target="graph_id"/>
          <zeebe:input source="={ runId: runId, jcn: jcn, edinetCode: edinetCode, sourceUrl: sourceUrl, disclosures: disclosures, ocrPages: ocrPages }" target="state"/>
          <zeebe:output source="=final_state" target="extractState"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_WriteGraph" name="write graph rows">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="jpCorpFinance.writeGraph" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=disclosures" target="disclosures"/>
          <zeebe:input source="=financialFacts" target="financialFacts"/>
          <zeebe:input source="=dryRun" target="dryRun"/>
          <zeebe:input source="=rwHealthy" target="rwHealthy"/>
          <zeebe:output source="=recordsPrepared" target="recordsPrepared"/>
          <zeebe:output source="=recordsWritten" target="recordsWritten"/>
          <zeebe:output source="=recordsVisible" target="recordsVisible"/>
          <zeebe:output source="=visibility" target="visibility"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_HealthGate" name="RisingWave health gate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="rw.health.probe" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:output source="=healthy" target="rwHealthy"/>
          <zeebe:output source="=reason" target="rwHealthReason"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_RwHealthy" name="RisingWave healthy?" default="Flow_RwDegraded">
      <bpmn:incoming>Flow_ToRwGate</bpmn:incoming>
      <bpmn:outgoing>Flow_Write</bpmn:outgoing>
      <bpmn:outgoing>Flow_RwDegraded</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ExtractFacts" name="extract financial facts">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="jpCorpFinance.extractFinancialFacts" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="=disclosures" target="disclosures"/>
          <zeebe:input source="=ocrPages" target="ocrPages"/>
          <zeebe:input source="=extractState" target="extractState"/>
          <zeebe:output source="=financialFacts" target="financialFacts"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RefreshCoverage" name="refresh company coverage">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="jpCorpFinance.refreshCoverage" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=jcn" target="jcn"/>
          <zeebe:input source="=recordsPrepared" target="recordsPrepared"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Audit" name="emit repair audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:jp-corp-finance.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;jpCorpFinance.repairCompany.completed&quot;" target="action"/>
          <zeebe:input source="={ case_id: runId, runId: runId, jcn: jcn, edinetCode: edinetCode, sourceUrl: sourceUrl, recordsPrepared: recordsPrepared, recordsWritten: recordsWritten, recordsVisible: recordsVisible, status: &quot;ok&quot; }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AuditRwDegraded" name="emit rw degraded audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:jp-corp-finance.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;jpCorpFinance.repairCompany.rwDegraded&quot;" target="action"/>
          <zeebe:input source="={ case_id: runId, runId: runId, jcn: jcn, edinetCode: edinetCode, sourceUrl: sourceUrl, rwHealthy: rwHealthy, rwHealthReason: rwHealthReason, status: &quot;rw-degraded&quot; }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_DegradedEnd" sourceRef="Task_AuditRwDegraded" targetRef="End"/>
    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_End</bpmn:incoming>
      <bpmn:incoming>Flow_DegradedEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
