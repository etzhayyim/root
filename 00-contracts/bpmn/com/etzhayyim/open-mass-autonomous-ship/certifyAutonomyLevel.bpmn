<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_mass_autonomous_ship_certify_autonomy_level" targetNamespace="https://etzhayyim.ai/bpmn/open-mass-autonomous-ship" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_mass_autonomous_ship_certify_autonomy_level" name="certifyAutonomyLevel" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_mass_autonomous_ship&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, certification_id: certificationId, imo: imo, operator_lei: operatorLei, imo_mass_level: imoMassLevel, autonomy_description: autonomyDescription, shore_control_center_lei: shoreControlCenterLei, flag_state_iso3: flagStateIso3, certifying_authority_lei: certifyingAuthorityLei, certified_at: certifiedAt, expires_at: expiresAt, autonomy_tier: if imoMassLevel &gt;= 4 then &quot;fully_autonomous&quot; else if imoMassLevel = 3 then &quot;remote_unmanned&quot; else if imoMassLevel = 2 then &quot;remote_manned&quot; else &quot;assisted&quot;, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-mass-autonomous-ship&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-mass-autonomous-ship.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;open.massAutonomousShip.certifyAutonomyLevel&quot;" target="action"/><zeebe:input source="={vertexId: vertexId}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>