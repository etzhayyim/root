<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_saas_register_product"
    targetNamespace="https://etzhayyim.ai/bpmn/open-saas"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_saas_register_product" name="SaaS product 登録" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Score"/>

    <!--
      riskScore:
        high   : vendorCountry in {IRN,PRK,RUS,SYR,MMR} OR (soc2=false AND iso27001=false)
        medium : exactly one of (soc2, iso27001) true
        low    : soc2=true AND iso27001=true AND gdprCompliant=true
      requireSecurityReview = high OR medium
    -->
    <bpmn:serviceTask id="Task_Score" name="risk score 計算">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT 1 AS ok LIMIT 1&quot;" target="query"/>
          <zeebe:input source="=[]" target="params"/>
          <zeebe:output source="=if list contains([&quot;IRN&quot;,&quot;PRK&quot;,&quot;RUS&quot;,&quot;SYR&quot;,&quot;MMR&quot;], vendorCountry) or (soc2 = false and iso27001 = false) then &quot;high&quot;
                                else if soc2 = true and iso27001 = true and gdprCompliant = true then &quot;low&quot;
                                else &quot;medium&quot;" target="riskScore"/>
          <zeebe:output source="=not(soc2 = true and iso27001 = true and gdprCompliant = true) or list contains([&quot;IRN&quot;,&quot;PRK&quot;,&quot;RUS&quot;,&quot;SYR&quot;,&quot;MMR&quot;], vendorCountry)" target="requireSecurityReview"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_Save</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Save" sourceRef="Task_Score" targetRef="Task_Save"/>

    <bpmn:serviceTask id="Task_Save" name="product 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_saas_product&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id: vertexId, product_name: productName,
              vendor_did: vendorDid, vendor_country: vendorCountry,
              homepage: homepage, category: category, pricing_tier: pricingTier,
              data_residency: dataResidency, soc2: soc2, iso27001: iso27001,
              gdpr_compliant: gdprCompliant, risk_score: riskScore,
              require_security_review: requireSecurityReview,
              status: &quot;active&quot;, registered_at: registeredAt,
              created_at: string(now()), owner_did: callerDid,
              sensitivity_ord: 1, org_id: vendorDid,
              user_id: callerDid, actor_id: &quot;sys.bpmn.open-saas&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Save</bpmn:incoming><bpmn:outgoing>Flow_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Gate" sourceRef="Task_Save" targetRef="Gate"/>

    <bpmn:exclusiveGateway id="Gate" default="Flow_Auto">
      <bpmn:incoming>Flow_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Review</bpmn:outgoing>
      <bpmn:outgoing>Flow_Auto</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Review" sourceRef="Gate" targetRef="Task_AuditReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=requireSecurityReview = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Auto" sourceRef="Gate" targetRef="Task_AuditAuto"/>

    <bpmn:serviceTask id="Task_AuditReview" name="audit product.securityReview">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-saas.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openSaas.product.securityReview&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, productName: productName, vendorDid: vendorDid, riskScore: riskScore}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Review</bpmn:incoming><bpmn:outgoing>Flow_ER</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ER" sourceRef="Task_AuditReview" targetRef="End_R"/>

    <bpmn:serviceTask id="Task_AuditAuto" name="audit product.register">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-saas.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openSaas.product.register&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, productName: productName, category: category, riskScore: riskScore}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Auto</bpmn:incoming><bpmn:outgoing>Flow_EA</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EA" sourceRef="Task_AuditAuto" targetRef="End_A"/>

    <bpmn:endEvent id="End_A"><bpmn:incoming>Flow_EA</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_R"><bpmn:incoming>Flow_ER</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
