<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_legal_entity_ingest_sec_disclosure"
    targetNamespace="https://etzhayyim.ai/bpmn/legal-entity"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="legal_entity_ingest_sec_disclosure" name="legal entity ingest SEC disclosure" isExecutable="true">
    <bpmn:startEvent id="Start" name="SEC disclosure ingest requested">
      <bpmn:outgoing>Flow_Ingest</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Ingest" sourceRef="Start" targetRef="Task_Ingest"/>
    <bpmn:serviceTask id="Task_Ingest" name="fetch and commit SEC disclosure records">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="legalEntity.edgar.ingestSecDisclosure"/>
        <zeebe:ioMapping>
          <zeebe:input source="=ticker" target="ticker"/>
          <zeebe:input source="=cik" target="cik"/>
          <zeebe:input source="=filingLimit" target="filingLimit"/>
          <zeebe:input source="=factsLimit" target="factsLimit"/>
          <zeebe:output source="=result" target="result"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ingest</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_Ingest" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit SEC disclosure ingest">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:legal-entity.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;legal-entity.ingestSecDisclosure&quot;" target="action"/>
          <zeebe:input source="={ ticker: ticker, cik: cik, result: result }" target="payload"/>
          <zeebe:output source="=rkey" target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End" name="SEC disclosure records committed">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
