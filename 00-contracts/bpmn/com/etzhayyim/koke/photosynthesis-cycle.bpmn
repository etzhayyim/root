<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_koke_photosynthesis" targetNamespace="https://etzhayyim.ai/bpmn/koke" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="koke_photosynthesis_cycle" name="photosynthesis-cycle" isExecutable="true">
    <!-- Timer start: every 30 minutes, scan for unfixed raw signals -->
    <bpmn:startEvent id="Start">
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT30M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
      <bpmn:outgoing>Flow_S</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Step 1: Scan for unfixed raw signals -->
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_ScanSignals"/>
    <bpmn:serviceTask id="Task_ScanSignals" name="scan-raw-signals">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="koke.scan_raw_signals"/>
        <zeebe:ioMapping>
          <zeebe:output source="=signalCount" target="signalCount"/>
          <zeebe:output source="=signals" target="signals"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming>
      <bpmn:outgoing>Flow_GW</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway: any signals to process? -->
    <bpmn:sequenceFlow id="Flow_GW" sourceRef="Task_ScanSignals" targetRef="GW_HasSignals"/>
    <bpmn:exclusiveGateway id="GW_HasSignals" name="signals found?">
      <bpmn:incoming>Flow_GW</bpmn:incoming>
      <bpmn:outgoing>Flow_NoSignals</bpmn:outgoing>
      <bpmn:outgoing>Flow_HasSignals</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- No signals branch → end -->
    <bpmn:sequenceFlow id="Flow_NoSignals" sourceRef="GW_HasSignals" targetRef="End">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=signalCount = 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Has signals branch → fix signal -->
    <bpmn:sequenceFlow id="Flow_HasSignals" sourceRef="GW_HasSignals" targetRef="Task_FixSignal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=signalCount > 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Step 2: Primary fixation (CO₂ → glucose) -->
    <bpmn:serviceTask id="Task_FixSignal" name="fix-signal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="koke.fix_signal"/>
        <zeebe:ioMapping>
          <zeebe:input source="=signals" target="signals"/>
          <zeebe:output source="=fixationId" target="fixationId"/>
          <zeebe:output source="=signalHash" target="signalHash"/>
          <zeebe:output source="=inputKind" target="inputKind"/>
          <zeebe:output source="=rawRef" target="rawRef"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HasSignals</bpmn:incoming>
      <bpmn:outgoing>Flow_Classify</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Step 3: Classify fixation -->
    <bpmn:sequenceFlow id="Flow_Classify" sourceRef="Task_FixSignal" targetRef="Task_ClassifyFixation"/>
    <bpmn:serviceTask id="Task_ClassifyFixation" name="classify-fixation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="koke.classify_fixation"/>
        <zeebe:ioMapping>
          <zeebe:input source="=fixationId" target="fixationId"/>
          <zeebe:input source="=inputKind" target="inputKind"/>
          <zeebe:input source="=rawRef" target="rawRef"/>
          <zeebe:output source="=classification" target="classification"/>
          <zeebe:output source="=confidence" target="confidence"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Classify</bpmn:incoming>
      <bpmn:outgoing>Flow_GW2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway: high confidence → handoff to hakkou -->
    <bpmn:sequenceFlow id="Flow_GW2" sourceRef="Task_ClassifyFixation" targetRef="GW_Confidence"/>
    <bpmn:exclusiveGateway id="GW_Confidence" name="confidence >= 0.7?">
      <bpmn:incoming>Flow_GW2</bpmn:incoming>
      <bpmn:outgoing>Flow_Handoff</bpmn:outgoing>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- High confidence → handoff to hakkou -->
    <bpmn:sequenceFlow id="Flow_Handoff" sourceRef="GW_Confidence" targetRef="Task_HandoffToHakkou">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=confidence >= 0.7</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_HandoffToHakkou" name="handoff-to-hakkou">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="koke.handoff_to_hakkou"/>
        <zeebe:ioMapping>
          <zeebe:input source="=fixationId" target="fixationId"/>
          <zeebe:input source="=classification" target="classification"/>
          <zeebe:input source="=inputKind" target="inputKind"/>
          <zeebe:input source="=rawRef" target="rawRef"/>
          <zeebe:output source="=fermentId" target="fermentId"/>
          <zeebe:output source="=edgeId" target="edgeId"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Handoff</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterHakkou</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Bridge: koke→saikin horizontal-transfer pipeline -->
    <bpmn:sequenceFlow id="Flow_AfterHakkou" sourceRef="Task_HandoffToHakkou" targetRef="Task_HandoffToSaikin"/>
    <bpmn:serviceTask id="Task_HandoffToSaikin" name="handoff-to-saikin">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="koke.handoff_to_saikin"/>
        <zeebe:ioMapping>
          <zeebe:input source="=fixationId" target="fixationId"/>
          <zeebe:input source="=classification" target="classification"/>
          <zeebe:input source="=inputKind" target="inputKind"/>
          <zeebe:input source="=rawRef" target="rawRef"/>
          <zeebe:output source="=saikinSignalId" target="saikinSignalId"/>
          <zeebe:output source="=saikinSignalVertexId" target="saikinSignalVertexId"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AfterHakkou</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterSaikin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AfterSaikin" sourceRef="Task_HandoffToSaikin" targetRef="Task_Audit"/>

    <!-- Low confidence → skip handoff, go to audit -->
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="GW_Confidence" targetRef="Task_Audit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=confidence &lt; 0.7</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Audit emit -->
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:koke.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;koke.photosynthesize&quot;" target="action"/>
          <zeebe:input source="={fixationId: fixationId, classification: classification, confidence: confidence, saikinSignalId: saikinSignalId}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AfterSaikin</bpmn:incoming>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End">
      <bpmn:incoming>Flow_NoSignals</bpmn:incoming>
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
