<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_flight_offer_check_price_drop"
    targetNamespace="https://etzhayyim.ai/bpmn/flight-offer"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="flight_offer_check_price_drop" name="checkPriceDrop" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_Health</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Health" sourceRef="Start" targetRef="Task_Health"/>

    <bpmn:serviceTask id="Task_Health" name="rw health gate">
      <bpmn:extensionElements><zeebe:taskDefinition type="rw.health.probe"/></bpmn:extensionElements>
      <bpmn:incoming>Flow_Health</bpmn:incoming><bpmn:outgoing>Flow_Check</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Check" sourceRef="Task_Health" targetRef="Task_Check"/>

    <bpmn:serviceTask id="Task_Check" name="check drop vs last alert">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="flight.offer.checkDrop"/>
        <zeebe:ioMapping>
          <zeebe:input source="=originIata" target="originIata"/>
          <zeebe:input source="=destinationIata" target="destinationIata"/>
          <zeebe:input source="=outboundDate" target="outboundDate"/>
          <zeebe:input source="=if currency != null and currency != &quot;&quot; then currency else &quot;USD&quot;" target="currency"/>
          <zeebe:input source="=if thresholdPct != null then thresholdPct else 10.0" target="thresholdPct"/>
          <zeebe:output source="=alerted" target="alerted"/>
          <zeebe:output source="=newPrice" target="newPrice"/>
          <zeebe:output source="=previousPrice" target="previousPrice"/>
          <zeebe:output source="=dropPct" target="dropPct"/>
          <zeebe:output source="=vertexId" target="vertexId"/>
          <zeebe:output source="=provider" target="provider"/>
          <zeebe:output source="=bookingUrl" target="bookingUrl"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Check</bpmn:incoming><bpmn:outgoing>Flow_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Gateway" sourceRef="Task_Check" targetRef="Gateway_Alert"/>

    <bpmn:exclusiveGateway id="Gateway_Alert" name="alerted?">
      <bpmn:incoming>Flow_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Post</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoPost</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Post" sourceRef="Gateway_Alert" targetRef="Task_PostDrop">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=alerted = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoPost" sourceRef="Gateway_Alert" targetRef="Gateway_Join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=alerted != true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_PostDrop" name="app.bsky.feed.post drop alert">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;app.bsky.feed.post&quot;" target="collection"/>
          <zeebe:input source="=if notifyDid != null and notifyDid != &quot;&quot; then notifyDid else &quot;did:web:flight-offer.etzhayyim.com&quot;" target="repo"/>
          <zeebe:input source="={
              text: &quot;✈️ &quot; + originIata + &quot; → &quot; + destinationIata + &quot; on &quot; + substring(outboundDate, 1, 10) + &quot;: &quot; + string(round half up(newPrice, 0)) + &quot; &quot; + currency + &quot; (down &quot; + string(round half up(dropPct, 1)) + &quot;% from &quot; + string(round half up(previousPrice, 0)) + &quot;) &quot; + bookingUrl,
              createdAt: string(now()),
              langs: [&quot;en&quot;]
          }" target="record"/>
          <zeebe:input source="=&quot;dropPostResult&quot;" target="resultKey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Post</bpmn:incoming><bpmn:outgoing>Flow_PostJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_PostJoin" sourceRef="Task_PostDrop" targetRef="Gateway_Join"/>

    <bpmn:exclusiveGateway id="Gateway_Join">
      <bpmn:incoming>Flow_NoPost</bpmn:incoming>
      <bpmn:incoming>Flow_PostJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Gateway_Join" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit drop check">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:flight-offer.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;flight.offer.checkPriceDrop&quot;" target="action"/>
          <zeebe:input source="={originIata: originIata, destinationIata: destinationIata, outboundDate: outboundDate, currency: currency, alerted: alerted, newPrice: newPrice, previousPrice: previousPrice, dropPct: dropPct, vertexId: vertexId}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
