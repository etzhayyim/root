<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_flight_offer_search_offers"
    targetNamespace="https://etzhayyim.ai/bpmn/flight-offer"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="flight_offer_search_offers" name="searchOffers" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_Health</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Health" sourceRef="Start" targetRef="Task_Health"/>

    <bpmn:serviceTask id="Task_Health" name="rw health gate">
      <bpmn:extensionElements><zeebe:taskDefinition type="rw.health.probe"/></bpmn:extensionElements>
      <bpmn:incoming>Flow_Health</bpmn:incoming><bpmn:outgoing>Flow_Fetch</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Fetch" sourceRef="Task_Health" targetRef="Task_Fetch"/>

    <bpmn:serviceTask id="Task_Fetch" name="fetch + persist offers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="flight.offer.fetch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=originIata" target="originIata"/>
          <zeebe:input source="=destinationIata" target="destinationIata"/>
          <zeebe:input source="=outboundDate" target="outboundDate"/>
          <zeebe:input source="=returnDate" target="returnDate"/>
          <zeebe:input source="=if currency != null and currency != &quot;&quot; then currency else &quot;USD&quot;" target="currency"/>
          <zeebe:input source="=if provider != null then provider else &quot;&quot;" target="provider"/>
          <zeebe:input source="=if maxOffers != null then maxOffers else 20" target="maxOffers"/>
          <zeebe:output source="=offersWritten" target="offersWritten"/>
          <zeebe:output source="=offersFetched" target="offersFetched"/>
          <zeebe:output source="=provider" target="resolvedProvider"/>
          <zeebe:output source="=providerObservedAt" target="providerObservedAt"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Fetch</bpmn:incoming><bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_Fetch" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit search">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:flight-offer.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;flight.offer.searchOffers&quot;" target="action"/>
          <zeebe:input source="={originIata: originIata, destinationIata: destinationIata, outboundDate: outboundDate, currency: currency, provider: resolvedProvider, offersFetched: offersFetched, offersWritten: offersWritten}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
