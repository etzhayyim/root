<?xml version="1.0" encoding="UTF-8"?>
<!--
  Timer-start BPMN — refreshes vertex_flight_offer_watch entries every 6 hours.

  flight.offer.pollWatchlist primitive:
    - SELECTs active watch rows where next_due_at <= now
    - per row: _do_search() then _do_check_drop()
    - bumps last_polled_at + next_due_at = now + cadence_minutes
    - returns { watchesRead, offersWritten, alertsFired, errors, dropAlerts[] }

  AT post fan-out for individual drop alerts is handled by the
  flight_offer_check_price_drop BPMN when invoked directly via XRPC.
  Within this poll, the alert row is written to vertex_flight_offer_alert
  (downstream consumers can subscribe).

  NSID: com.etzhayyim.apps.flightOffer.pollWatchlist
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/flight-offer-poll-watchlist-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_flight_offer_poll_watchlist"
    targetNamespace="https://etzhayyim.ai/bpmn/flight-offer"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="flight_offer_poll_watchlist" name="pollWatchlist" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.flightOffer.pollWatchlist", "version": 1, "resultTimeoutMs": 300000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start_Timer" name="every 6 hours">
      <bpmn:outgoing>Flow_Health_Timer</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_PT6H">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT6H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Manual" name="manual / on-demand">
      <bpmn:outgoing>Flow_Health_Manual</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Health_Timer" sourceRef="Start_Timer" targetRef="Task_Health"/>
    <bpmn:sequenceFlow id="Flow_Health_Manual" sourceRef="Start_Manual" targetRef="Task_Health"/>

    <bpmn:serviceTask id="Task_Health" name="rw health gate">
      <bpmn:extensionElements><zeebe:taskDefinition type="rw.health.probe"/></bpmn:extensionElements>
      <bpmn:incoming>Flow_Health_Timer</bpmn:incoming><bpmn:incoming>Flow_Health_Manual</bpmn:incoming><bpmn:outgoing>Flow_Poll</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Poll" sourceRef="Task_Health" targetRef="Task_Poll"/>

    <bpmn:serviceTask id="Task_Poll" name="poll watchlist">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="flight.offer.pollWatchlist"/>
        <zeebe:ioMapping>
          <zeebe:input source="=if limit != null then limit else 50" target="limit"/>
          <zeebe:input source="=if force != null then force else false" target="force"/>
          <zeebe:output source="=watchesRead" target="watchesRead"/>
          <zeebe:output source="=offersWritten" target="offersWritten"/>
          <zeebe:output source="=alertsFired" target="alertsFired"/>
          <zeebe:output source="=errors" target="errors"/>
          <zeebe:output source="=dropAlerts" target="dropAlerts"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Poll</bpmn:incoming><bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_Poll" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit poll">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:flight-offer.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;flight.offer.pollWatchlist&quot;" target="action"/>
          <zeebe:input source="={watchesRead: watchesRead, offersWritten: offersWritten, alertsFired: alertsFired, errors: errors}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
