<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_flight_offer_source_health"
    targetNamespace="https://etzhayyim.ai/bpmn/flight-offer"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="flight_offer_source_health" name="sourceHealth" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_Get</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Get" sourceRef="Start" targetRef="Task_Get"/>

    <bpmn:serviceTask id="Task_Get" name="select source health from MV">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="flight.offer.sourceHealth"/>
        <zeebe:ioMapping>
          <zeebe:input source="=if limit != null then limit else 50" target="limit"/>
          <zeebe:output source="=items" target="items"/>
          <zeebe:output source="=count" target="count"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Get</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Get" targetRef="End"/>

    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
