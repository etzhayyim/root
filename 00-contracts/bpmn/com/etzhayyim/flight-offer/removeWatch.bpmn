<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_flight_offer_remove_watch"
    targetNamespace="https://etzhayyim.ai/bpmn/flight-offer"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="flight_offer_remove_watch" name="removeWatch" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_Remove</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Remove" sourceRef="Start" targetRef="Task_Remove"/>

    <bpmn:serviceTask id="Task_Remove" name="archive or delete watch row">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="flight.offer.removeWatch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=originIata" target="originIata"/>
          <zeebe:input source="=destinationIata" target="destinationIata"/>
          <zeebe:input source="=outboundDate" target="outboundDate"/>
          <zeebe:input source="=if currency != null and currency != &quot;&quot; then currency else &quot;USD&quot;" target="currency"/>
          <zeebe:input source="=if hard != null then hard else false" target="hard"/>
          <zeebe:output source="=removed" target="removed"/>
          <zeebe:output source="=vertexId" target="vertexId"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Remove</bpmn:incoming><bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_Remove" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit remove watch">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:flight-offer.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;flight.offer.removeWatch&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, removed: removed}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
