<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_flight_offer_add_watch"
    targetNamespace="https://etzhayyim.ai/bpmn/flight-offer"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="flight_offer_add_watch" name="addWatch" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_Add</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Add" sourceRef="Start" targetRef="Task_Add"/>

    <bpmn:serviceTask id="Task_Add" name="upsert watch row">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="flight.offer.addWatch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=originIata" target="originIata"/>
          <zeebe:input source="=destinationIata" target="destinationIata"/>
          <zeebe:input source="=outboundDate" target="outboundDate"/>
          <zeebe:input source="=if returnDate != null then returnDate else &quot;&quot;" target="returnDate"/>
          <zeebe:input source="=if currency != null and currency != &quot;&quot; then currency else &quot;USD&quot;" target="currency"/>
          <zeebe:input source="=if thresholdPct != null then thresholdPct else 10.0" target="thresholdPct"/>
          <zeebe:input source="=if cadenceMinutes != null then cadenceMinutes else 360" target="cadenceMinutes"/>
          <zeebe:input source="=if providerHint != null then providerHint else &quot;&quot;" target="providerHint"/>
          <zeebe:input source="=if maxOffers != null then maxOffers else 20" target="maxOffers"/>
          <zeebe:input source="=if notifyDid != null then notifyDid else &quot;&quot;" target="notifyDid"/>
          <zeebe:output source="=vertexId" target="vertexId"/>
          <zeebe:output source="=created" target="created"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Add</bpmn:incoming><bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_Add" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit add watch">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:flight-offer.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;flight.offer.addWatch&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, created: created, originIata: originIata, destinationIata: destinationIata, outboundDate: outboundDate}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
