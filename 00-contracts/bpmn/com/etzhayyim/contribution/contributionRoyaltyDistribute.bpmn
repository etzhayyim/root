<?xml version="1.0" encoding="UTF-8"?>
<!--
  Timer-start BPMN — daily OSS/contributor GCC royalty distribution (R/PT24H).
  ADR-2604281400 Phase 2.

  Pipeline:
    1. generic.db.select        — query mv_contribution_royalty_daily for yesterday
    2. contribution.distributeRoyalties — pyzeebe: approve + credit() on ContributionRoyaltyRegistry
    3. generic.audit.emit       — OCEL distribution event

  Process ID  : contribution_royalty_distribute
  NSID        : (timer-start — no lexicon binding needed)
  vertex_id   : at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/contribution-royalty-distribute-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_contribution_royalty_distribute"
    targetNamespace="https://etzhayyim.ai/bpmn/contribution"
    exporter="hand-written"
    exporterVersion="2.0">

  <bpmn:process id="contribution_royalty_distribute"
                name="contribution royalty distribute (R/PT24H)"
                isExecutable="true">

    <bpmn:documentation>
      { "version": 1, "resultTimeoutMs": 300000 }
    </bpmn:documentation>

    <!-- Timer start: every 24h -->
    <bpmn:startEvent id="Start" name="every 24 hours">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT24H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_QueryRoyalties"/>

    <!-- Step 1: fetch yesterday's accrued royalties from streaming MV -->
    <bpmn:serviceTask id="Task_QueryRoyalties" name="query mv_contribution_royalty_daily">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;mv_contribution_royalty_daily&quot;" target="table"/>
          <zeebe:input source="=&quot;source_hash, contributor_addr, SUM(earned_wei) AS total_earned_wei&quot;" target="columns"/>
          <zeebe:input source="=1000" target="limit"/>
          <zeebe:input source="=&quot;distribution_date = (NOW() - INTERVAL '1 day')::DATE AND earned_wei &gt; 0 AND contributor_addr IS NOT NULL&quot;" target="whereExpr"/>
          <zeebe:output source="=rows"     target="royaltyRows"/>
          <zeebe:output source="=rowCount" target="royaltyCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_QueryRoyalties" targetRef="Gateway_HasRoyalties"/>

    <!-- Gate: skip if nothing to distribute -->
    <bpmn:exclusiveGateway id="Gateway_HasRoyalties" name="any royalties?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_HasRows</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoRows</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_HasRows" sourceRef="Gateway_HasRoyalties" targetRef="Task_Distribute">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=royaltyCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoRows" sourceRef="Gateway_HasRoyalties" targetRef="Task_AuditSkip">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=royaltyCount &lt;= 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Step 2: on-chain credit() batch via dedicated pyzeebe handler -->
    <bpmn:serviceTask id="Task_Distribute" name="credit() on ContributionRoyaltyRegistry">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="contribution.distributeRoyalties"/>
        <zeebe:ioMapping>
          <zeebe:input source="=royaltyRows" target="royalty_rows"/>
          <zeebe:output source="=ok"          target="distributeOk"/>
          <zeebe:output source="=txHash"      target="txHash"/>
          <zeebe:output source="=totalWei"    target="totalWei"/>
          <zeebe:output source="=rowsCredit"  target="rowsCredit"/>
          <zeebe:output source="=error"       target="distributeError"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HasRows</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Distribute" targetRef="Task_Audit"/>

    <!-- Step 3: OCEL audit (distribution) -->
    <bpmn:serviceTask id="Task_Audit" name="emit contribution.royalty.distribute OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.contribution.royalty.distribute&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;ok&quot;: distributeOk, &quot;txHash&quot;: txHash, &quot;totalWei&quot;: totalWei, &quot;rowsCredit&quot;: rowsCredit, &quot;error&quot;: distributeError }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <!-- Skip path: emit zero-distribution audit -->
    <bpmn:serviceTask id="Task_AuditSkip" name="emit contribution.royalty.skip OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.contribution.royalty.skip&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;reason&quot;: &quot;no-royalties-yesterday&quot; }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoRows</bpmn:incoming>
      <bpmn:outgoing>Flow_EndSkip</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndSkip" sourceRef="Task_AuditSkip" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_End</bpmn:incoming>
      <bpmn:incoming>Flow_EndSkip</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
