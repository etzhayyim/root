<?xml version="1.0" encoding="UTF-8"?>
<!--
  contributionSourceRegister — XRPC-triggered (ADR-2604281400 Phase 3).

  Registers an OSS / media / dataset source for GCC royalties off-chain.
  Writes to vertex_contribution_source and computes sourceHash = keccak256(canonicalId).
  Pending on-chain: Safe owner must call ContributionRoyaltyRegistry.registerSource()
  separately; until then credits accumulate in pendingEarned.

  NSID:      com.etzhayyim.authz.registerContributionSource
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/contribution-source-register-v1
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_contribution_source_register" targetNamespace="https://etzhayyim.ai/bpmn/contribution" exporter="hand-written" exporterVersion="2.0">
  <bpmn:process id="contribution_source_register" name="registerContributionSource" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.authz.registerContributionSource", "version": 1, "resultTimeoutMs": 30000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Register"/>

    <bpmn:serviceTask id="Task_Register" name="write vertex_contribution_source">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="contribution.registerSource"/>
        <zeebe:ioMapping>
          <zeebe:input source="=canonicalId"     target="canonicalId"/>
          <zeebe:input source="=contributorAddr" target="contributorAddr"/>
          <zeebe:input source="=royaltyBps"      target="royaltyBps"/>
          <zeebe:input source="=sourceType"      target="sourceType"/>
          <zeebe:input source="=description"     target="description"/>
          <zeebe:input source="=license"         target="license"/>
          <zeebe:output source="=ok"             target="ok"/>
          <zeebe:output source="=sourceHash"     target="sourceHash"/>
          <zeebe:output source="=vertexId"       target="vertexId"/>
          <zeebe:output source="=pendingOnChain" target="pendingOnChain"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming>
      <bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Register" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="emit contribution.source.register OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:bpmn.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;contribution.source.register&quot;" target="action"/>
          <zeebe:input source="={ok: ok, sourceHash: sourceHash, vertexId: vertexId, pendingOnChain: pendingOnChain}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
