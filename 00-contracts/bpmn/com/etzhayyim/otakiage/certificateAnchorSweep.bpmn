<?xml version="1.0" encoding="UTF-8"?>
<!--
  otakiage.certificateAnchorSweep - hourly sweep of queued certificate anchors

  Phase 2b1 = state-machine progression only (queued → submitted → anchored
  via stub finalize). Phase 2b2 = real ethers/viem on-chain submit + tx
  receipt poll, gated by ANCHOR_RPC_URL / ANCHOR_PRIVATE_KEY env vars.

  Flow:
    1. otakiage.certificate.anchorSweep (claim queued, submit / finalize)
    2. generic.audit.emit

  Trigger: timer-start R/PT1H. maxItems primitive cap = 20 / fire to bound
  gas cost when Phase 2b2 wires real on-chain calls.

  NSID (informational): com.etzhayyim.apps.otakiage.certificateAnchorSweep
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/otakiage-certificate-anchor-sweep-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_otakiage_certificate_anchor_sweep"
    targetNamespace="https://etzhayyim.ai/bpmn/otakiage"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="otakiage_certificate_anchor_sweep" name="otakiage certificateAnchorSweep" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.otakiage.certificateAnchorSweep", "version": 1, "resultTimeoutMs": 600000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="every 1h">
      <bpmn:outgoing>Flow_ToSweep</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_1h">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT1H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToSweep" sourceRef="Start" targetRef="Task_Sweep"/>

    <bpmn:serviceTask id="Task_Sweep" name="sweep queued certificate anchors">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="otakiage.certificate.anchorSweep"/>
        <zeebe:ioMapping>
          <zeebe:input source="=20" target="maxItems"/>
          <zeebe:output source="=processed" target="processed"/>
          <zeebe:output source="=submitted" target="submitted"/>
          <zeebe:output source="=anchored" target="anchored"/>
          <zeebe:output source="=failed" target="failed"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSweep</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Sweep" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:otakiage.etzhayyim.com:ritual&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.otakiage.certificateAnchorSweep&quot;" target="nsid"/>
          <zeebe:input source="={ processed: processed, submitted: submitted, anchored: anchored, failed: failed }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
