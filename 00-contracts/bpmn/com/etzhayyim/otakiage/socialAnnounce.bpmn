<?xml version="1.0" encoding="UTF-8"?>
<!--
  otakiage.socialAnnounce - T1 social derive on handover/ritual completion

  Flow:
    1. otakiage.social.composeAnnounce (event 別本文生成、PII 除去 + H3 res-3 まで丸める)
    2. generic.pds.dispatch            (app.bsky.feed.post)
    3. generic.audit.emit

  Trigger: invoked internally from confirmHandover / issueCertificate primitives
  via bpmn-dispatcher message-correlation. No XRPC public binding.

  Inputs (passed via process variables):
    eventKind:    "handover" | "ritual"
    refUri:       handoverUri or ritualUri
    authorDid:    did:web:otakiage.etzhayyim.com:reuse | :ritual
    summary:      pre-redacted summary (caller responsibility)

  NSID (informational): com.etzhayyim.apps.otakiage.socialAnnounce
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/otakiage-social-announce-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_otakiage_social_announce"
    targetNamespace="https://etzhayyim.ai/bpmn/otakiage"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="otakiage_social_announce" name="otakiage socialAnnounce" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.otakiage.socialAnnounce", "version": 1, "resultTimeoutMs": 30000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="trigger">
      <bpmn:outgoing>Flow_ToCompose</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToCompose" sourceRef="Start" targetRef="Task_Compose"/>

    <bpmn:serviceTask id="Task_Compose" name="compose announce text (PII 除去)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="otakiage.social.composeAnnounce"/>
        <zeebe:ioMapping>
          <zeebe:input source="=eventKind" target="eventKind"/>
          <zeebe:input source="=refUri" target="refUri"/>
          <zeebe:input source="=authorDid" target="authorDid"/>
          <zeebe:input source="=summary" target="summary"/>
          <zeebe:output source="=postText" target="postText"/>
          <zeebe:output source="=h3Res3" target="h3Res3"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCompose</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDispatch</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToDispatch" sourceRef="Task_Compose" targetRef="Task_Dispatch"/>

    <bpmn:serviceTask id="Task_Dispatch" name="pds dispatch app.bsky.feed.post">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;app.bsky.feed.post&quot;" target="type"/>
          <zeebe:input source="=authorDid" target="did"/>
          <zeebe:input source="=postText" target="text"/>
          <zeebe:output source="=postUri" target="postUri"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDispatch</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Dispatch" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=authorDid" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.otakiage.socialAnnounce&quot;" target="nsid"/>
          <zeebe:input source="={ eventKind: eventKind, refUri: refUri, postUri: postUri, h3Res3: h3Res3 }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
