<?xml version="1.0" encoding="UTF-8"?>
<!--
  karma.etzhayyim.com — submit zk-SNARK rebirth proof (XRPC entry).

  Pipeline:
    1. karma.zk.rebirthVerify     verify Groth16 proof + burn nullifier
                                    (Phase K3 stub on-chain), persist
                                    vertex_karma_rebirth_proof row
    2. generic.audit.emit         OCEL trail
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_karma_submit_rebirth_proof"
    targetNamespace="https://etzhayyim.ai/bpmn/karma"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="karma_submit_rebirth_proof" name="karma submit rebirth proof" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.karma.submitRebirthProof", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="StartXrpc" name="xrpc">
      <bpmn:outgoing>Flow_ToVerify</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Verify" name="verify zk proof + burn nullifier">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="karma.zk.rebirthVerify"/>
        <zeebe:ioMapping>
          <zeebe:input source="=newDid" target="newDid"/>
          <zeebe:input source="=oldDidHash" target="oldDidHash"/>
          <zeebe:input source="=newSantanaRoot" target="newSantanaRoot"/>
          <zeebe:input source="=nullifier" target="nullifier"/>
          <zeebe:input source="=proof" target="proof"/>
          <zeebe:input source="=publicSignals" target="publicSignals"/>
          <zeebe:output source="=proofId" target="proofId"/>
          <zeebe:output source="=verifiedAt" target="verifiedAt"/>
          <zeebe:output source="=txHash" target="txHash"/>
          <zeebe:output source="=blockNumber" target="blockNumber"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToVerify</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToVerify" sourceRef="StartXrpc" targetRef="Task_Verify"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:karma.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.karma.submitRebirthProof&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;proofId&quot;: proofId, &quot;newDid&quot;: newDid, &quot;nullifier&quot;: nullifier, &quot;txHash&quot;: txHash }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Verify" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="verified">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
