<?xml version="1.0" encoding="UTF-8"?>
<!--
  karma.etzhayyim.com — organism agent resume from checkpoint (XRPC entry).

  Pipeline:
    1. karma.organism.resume     load latest vertex_organism_checkpoint
                                   for (did, thread_id), reconstruct
                                   LangGraph state, mark runtime alive
    2. generic.audit.emit        OCEL trail
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_karma_organism_resume"
    targetNamespace="https://etzhayyim.ai/bpmn/karma"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="karma_organism_resume" name="karma organism resume" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.karma.organismResume", "version": 1, "resultTimeoutMs": 30000 }
    </bpmn:documentation>

    <bpmn:startEvent id="StartXrpc" name="xrpc">
      <bpmn:outgoing>Flow_ToResume</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Resume" name="resume from checkpoint">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="karma.organism.resume"/>
        <zeebe:ioMapping>
          <zeebe:input source="=did" target="did"/>
          <zeebe:input source="=if threadId = null then &quot;main&quot; else threadId" target="threadId"/>
          <zeebe:input source="=checkpointId" target="checkpointId"/>
          <zeebe:input source="=if force = null then false else force" target="force"/>
          <zeebe:output source="=resumedFromCheckpointId" target="resumedFromCheckpointId"/>
          <zeebe:output source="=parentCheckpointId" target="parentCheckpointId"/>
          <zeebe:output source="=langgraphNode" target="langgraphNode"/>
          <zeebe:output source="=stateByteSize" target="stateByteSize"/>
          <zeebe:output source="=savedAtMs" target="savedAtMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToResume</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToResume" sourceRef="StartXrpc" targetRef="Task_Resume"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:karma.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.karma.organismResume&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;did&quot;: did, &quot;threadId&quot;: threadId, &quot;resumedFrom&quot;: resumedFromCheckpointId, &quot;node&quot;: langgraphNode, &quot;stateByteSize&quot;: stateByteSize }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Resume" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="resumed">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
