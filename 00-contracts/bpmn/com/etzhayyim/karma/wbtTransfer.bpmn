<?xml version="1.0" encoding="UTF-8"?>
<!--
  karma.etzhayyim.com — WBT transfer (XRPC entry).

  Atomic debit-credit. Pipeline:
    1. karma.wbt.transfer    verify funds, persist transfer + update both balances
    2. generic.audit.emit    OCEL trail
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_karma_wbt_transfer"
    targetNamespace="https://etzhayyim.ai/bpmn/karma"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="karma_wbt_transfer" name="karma WBT transfer" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.karma.wbtTransfer", "version": 1, "resultTimeoutMs": 30000 }
    </bpmn:documentation>

    <bpmn:startEvent id="StartXrpc" name="xrpc">
      <bpmn:outgoing>Flow_ToTransfer</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Transfer" name="atomic transfer (debit + credit + log)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="karma.wbt.transfer"/>
        <zeebe:ioMapping>
          <zeebe:input source="=fromDid" target="fromDid"/>
          <zeebe:input source="=toDid" target="toDid"/>
          <zeebe:input source="=amount" target="amount"/>
          <zeebe:input source="=reason" target="reason"/>
          <zeebe:input source="=memo" target="memo"/>
          <zeebe:output source="=transferId" target="transferId"/>
          <zeebe:output source="=fromBalance" target="fromBalance"/>
          <zeebe:output source="=toBalance" target="toBalance"/>
          <zeebe:output source="=tsMs" target="tsMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToTransfer</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToTransfer" sourceRef="StartXrpc" targetRef="Task_Transfer"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:karma.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.karma.wbtTransfer&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;transferId&quot;: transferId, &quot;fromDid&quot;: fromDid, &quot;toDid&quot;: toDid, &quot;amount&quot;: amount, &quot;reason&quot;: reason }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Transfer" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="transferred">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
