<?xml version="1.0" encoding="UTF-8"?>
<!--
  karma.etzhayyim.com — invite witnesses (XRPC entry).

  Pipeline:
    1. karma.witness.inviteFanOut   per-invitee INSERT vertex_karma_witness_invitation
    2. generic.audit.emit           OCEL trail
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_karma_invite_witnesses"
    targetNamespace="https://etzhayyim.ai/bpmn/karma"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="karma_invite_witnesses" name="karma invite witnesses" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.karma.inviteWitnesses", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="StartXrpc" name="xrpc">
      <bpmn:outgoing>Flow_ToInvite</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Invite" name="invite fan-out (Hyperdrive direct)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="karma.witness.inviteFanOut"/>
        <zeebe:ioMapping>
          <zeebe:input source="=edgeId" target="edgeId"/>
          <zeebe:input source="=candidate" target="candidate"/>
          <zeebe:input source="=inviterDid" target="inviterDid"/>
          <zeebe:input source="=inviteeDids" target="inviteeDids"/>
          <zeebe:input source="=message" target="message"/>
          <zeebe:input source="=rationaleCid" target="rationaleCid"/>
          <zeebe:input source="=if expiresInDays = null then 14 else expiresInDays" target="expiresInDays"/>
          <zeebe:output source="=invitationIds" target="invitationIds"/>
          <zeebe:output source="=inviteCount" target="inviteCount"/>
          <zeebe:output source="=expiresAtMs" target="expiresAtMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToInvite</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToInvite" sourceRef="StartXrpc" targetRef="Task_Invite"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:karma.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.karma.inviteWitnesses&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;edgeId&quot;: edgeId, &quot;inviter&quot;: inviterDid, &quot;count&quot;: inviteCount, &quot;expiresAtMs&quot;: expiresAtMs }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Invite" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="invited">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
