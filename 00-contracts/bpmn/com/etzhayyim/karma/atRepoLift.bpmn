<?xml version="1.0" encoding="UTF-8"?>
<!--
  karma.etzhayyim.com — AT Protocol PDS lift (R/PT1M timer-start).

  Reads edges with non-null ipfs_cid but null atrepo_uri, then mints
  com.etzhayyim.apps.karma.dependency records via generic.pds.dispatch
  (T2 K8s-internal routing per ADR-2604282300 §Addendum 2026-04-30 —
  com.etzhayyim.* → bpmn-dispatcher ClusterIP).
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_karma_atrepo_lift"
    targetNamespace="https://etzhayyim.ai/bpmn/karma"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="karma_atrepo_lift" name="karma atrepo lift" isExecutable="true">

    <bpmn:documentation>
      { "version": 1 }
    </bpmn:documentation>

    <bpmn:startEvent id="StartTimer" name="every 1 min">
      <bpmn:outgoing>Flow_ToFind</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT1M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Find" name="find ipfs-pinned but atrepo-unlifted">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="karma.atrepo.findUnlifted"/>
        <zeebe:ioMapping>
          <zeebe:input source="=500" target="batchSize"/>
          <zeebe:output source="=edges" target="edges"/>
          <zeebe:output source="=count" target="count"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToFind</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToFind" sourceRef="StartTimer" targetRef="Task_Find"/>

    <bpmn:exclusiveGateway id="Gate_HasWork">
      <bpmn:incoming>Flow_ToGate</bpmn:incoming>
      <bpmn:outgoing>Flow_Work</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoWork</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToGate" sourceRef="Task_Find" targetRef="Gate_HasWork"/>

    <bpmn:sequenceFlow id="Flow_Work" sourceRef="Gate_HasWork" targetRef="Task_Lift">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count > 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoWork" sourceRef="Gate_HasWork" targetRef="EndIdle">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count = 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_Lift" name="dispatch karma.dependency records to PDS (T2 internal)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="karma.atrepo.liftBatch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=edges" target="edges"/>
          <zeebe:output source="=lifted" target="lifted"/>
          <zeebe:output source="=failed" target="failed"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Work</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:karma.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.karma.atRepoLift&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;lifted&quot;: lifted, &quot;failed&quot;: failed }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Lift" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="lifted">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndIdle" name="idle">
      <bpmn:incoming>Flow_NoWork</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
