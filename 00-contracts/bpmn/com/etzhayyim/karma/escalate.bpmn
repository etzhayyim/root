<?xml version="1.0" encoding="UTF-8"?>
<!--
  karma.etzhayyim.com — open 覚者 DAO arbitration (XRPC entry).

  Pipeline:
    1. karma.dao.findVoters         Pregel-style cohort intersection over
                                      edge_karma_dependency to discover
                                      eligible 覚者 DIDs (positive
                                      multi-generational karma streak)
    2. ExclusiveGateway             voters >= minVoters?
    3. karma.dao.openArbitration    INSERT vertex_karma_arbitration
    4. generic.audit.emit           OCEL trail
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_karma_escalate"
    targetNamespace="https://etzhayyim.ai/bpmn/karma"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="karma_escalate" name="karma escalate (DAO)" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.karma.escalate", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="StartXrpc" name="xrpc">
      <bpmn:outgoing>Flow_ToFindVoters</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_FindVoters" name="find 覚者 voters (Pregel cohort)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="karma.dao.findVoters"/>
        <zeebe:ioMapping>
          <zeebe:input source="=edgeId" target="edgeId"/>
          <zeebe:input source="=candidate" target="candidate"/>
          <zeebe:input source="=openedBy" target="openedBy"/>
          <zeebe:input source="=if minVoters = null then 5 else minVoters" target="minVoters"/>
          <zeebe:output source="=voters" target="voters"/>
          <zeebe:output source="=voterCount" target="voterCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToFindVoters</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToFindVoters" sourceRef="StartXrpc" targetRef="Task_FindVoters"/>

    <bpmn:exclusiveGateway id="Gate_Quorum" name="quorum?">
      <bpmn:incoming>Flow_ToGate</bpmn:incoming>
      <bpmn:outgoing>Flow_Pass</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoQuorum</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToGate" sourceRef="Task_FindVoters" targetRef="Gate_Quorum"/>

    <bpmn:sequenceFlow id="Flow_Pass" sourceRef="Gate_Quorum" targetRef="Task_Open">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=voterCount >= (if minVoters = null then 5 else minVoters)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoQuorum" sourceRef="Gate_Quorum" targetRef="Task_AuditNoQuorum">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=voterCount &lt; (if minVoters = null then 5 else minVoters)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_Open" name="open arbitration (Hyperdrive direct)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="karma.dao.openArbitration"/>
        <zeebe:ioMapping>
          <zeebe:input source="=edgeId" target="edgeId"/>
          <zeebe:input source="=candidate" target="candidate"/>
          <zeebe:input source="=openedBy" target="openedBy"/>
          <zeebe:input source="=rationale" target="rationale"/>
          <zeebe:input source="=if votingDays = null then 7 else votingDays" target="votingDays"/>
          <zeebe:input source="=if minVoters = null then 5 else minVoters" target="minVoters"/>
          <zeebe:input source="=voters" target="voters"/>
          <zeebe:output source="=arbitrationId" target="arbitrationId"/>
          <zeebe:output source="=closesAtMs" target="closesAtMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Pass</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAuditOk</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_AuditOk" name="audit emit (opened)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:karma.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.karma.escalate&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;arbitrationId&quot;: arbitrationId, &quot;edgeId&quot;: edgeId, &quot;voters&quot;: voterCount, &quot;closesAtMs&quot;: closesAtMs }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAuditOk</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndOk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAuditOk" sourceRef="Task_Open" targetRef="Task_AuditOk"/>

    <bpmn:serviceTask id="Task_AuditNoQuorum" name="audit emit (no quorum)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:karma.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.karma.escalate.noQuorum&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;edgeId&quot;: edgeId, &quot;voterCount&quot;: voterCount }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoQuorum</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndNoQuorum</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_ToEndOk" sourceRef="Task_AuditOk" targetRef="EndOk"/>
    <bpmn:sequenceFlow id="Flow_ToEndNoQuorum" sourceRef="Task_AuditNoQuorum" targetRef="EndNoQuorum"/>

    <bpmn:endEvent id="EndOk" name="opened">
      <bpmn:incoming>Flow_ToEndOk</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndNoQuorum" name="no-quorum">
      <bpmn:incoming>Flow_ToEndNoQuorum</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
