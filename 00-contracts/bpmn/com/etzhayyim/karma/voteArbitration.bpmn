<?xml version="1.0" encoding="UTF-8"?>
<!--
  karma.etzhayyim.com — vote on open arbitration (XRPC entry).

  Pipeline:
    1. karma.dao.castVote     verify voter ∈ invitedVoters, signature
                               valid, no double-vote, window open;
                               INSERT vertex_karma_vote
    2. karma.dao.tally        SELECT mv_karma_arbitration_tally
    3. ExclusiveGateway       supermajority reached or final vote?
                               yes → Task_Finalize, no → just audit
    4. karma.dao.finalize     UPDATE vertex_karma_arbitration set status,
                               finalized_position, finalized_at
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_karma_vote_arbitration"
    targetNamespace="https://etzhayyim.ai/bpmn/karma"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="karma_vote_arbitration" name="karma vote arbitration" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.karma.voteArbitration", "version": 1, "resultTimeoutMs": 30000 }
    </bpmn:documentation>

    <bpmn:startEvent id="StartXrpc" name="xrpc">
      <bpmn:outgoing>Flow_ToCast</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Cast" name="cast vote (verify + persist)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="karma.dao.castVote"/>
        <zeebe:ioMapping>
          <zeebe:input source="=arbitrationId" target="arbitrationId"/>
          <zeebe:input source="=voterDid" target="voterDid"/>
          <zeebe:input source="=position" target="position"/>
          <zeebe:input source="=signature" target="signature"/>
          <zeebe:input source="=signatureAlg" target="signatureAlg"/>
          <zeebe:input source="=rationaleCid" target="rationaleCid"/>
          <zeebe:output source="=voteId" target="voteId"/>
          <zeebe:output source="=tally" target="tally"/>
          <zeebe:output source="=quorumReached" target="quorumReached"/>
          <zeebe:output source="=majorityPosition" target="majorityPosition"/>
          <zeebe:output source="=supermajorityPct" target="supermajorityPct"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCast</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToCast" sourceRef="StartXrpc" targetRef="Task_Cast"/>

    <bpmn:exclusiveGateway id="Gate_Quorum" name="2/3 reached?">
      <bpmn:incoming>Flow_ToGate</bpmn:incoming>
      <bpmn:outgoing>Flow_Finalize</bpmn:outgoing>
      <bpmn:outgoing>Flow_Pending</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToGate" sourceRef="Task_Cast" targetRef="Gate_Quorum"/>

    <bpmn:sequenceFlow id="Flow_Finalize" sourceRef="Gate_Quorum" targetRef="Task_Finalize">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=quorumReached = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Pending" sourceRef="Gate_Quorum" targetRef="Task_AuditPending">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=quorumReached = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_Finalize" name="finalize arbitration (status=closed)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="karma.dao.finalize"/>
        <zeebe:ioMapping>
          <zeebe:input source="=arbitrationId" target="arbitrationId"/>
          <zeebe:input source="=majorityPosition" target="majorityPosition"/>
          <zeebe:input source="=supermajorityPct" target="supermajorityPct"/>
          <zeebe:output source="=finalizedAt" target="finalizedAt"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Finalize</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAuditFinalize</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_AuditFinalize" name="audit emit (finalized)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:karma.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.karma.voteArbitration.finalized&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;arbitrationId&quot;: arbitrationId, &quot;voteId&quot;: voteId, &quot;position&quot;: majorityPosition, &quot;supermajorityPct&quot;: supermajorityPct }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAuditFinalize</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndFinalize</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAuditFinalize" sourceRef="Task_Finalize" targetRef="Task_AuditFinalize"/>

    <bpmn:serviceTask id="Task_AuditPending" name="audit emit (pending)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:karma.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.karma.voteArbitration.pending&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;arbitrationId&quot;: arbitrationId, &quot;voteId&quot;: voteId, &quot;tally&quot;: tally }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Pending</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndPending</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_ToEndFinalize" sourceRef="Task_AuditFinalize" targetRef="EndFinalized"/>
    <bpmn:sequenceFlow id="Flow_ToEndPending" sourceRef="Task_AuditPending" targetRef="EndPending"/>

    <bpmn:endEvent id="EndFinalized" name="finalized">
      <bpmn:incoming>Flow_ToEndFinalize</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndPending" name="vote-recorded">
      <bpmn:incoming>Flow_ToEndPending</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
