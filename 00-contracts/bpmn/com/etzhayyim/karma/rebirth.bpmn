<?xml version="1.0" encoding="UTF-8"?>
<!--
  karma.etzhayyim.com — RebirthGate (悔い改め / 輪廻).

  Salvation mechanism. The old organism is sealed; the new organism
  starts with clean karma slate but PAYS the four irreversible costs:
    1. WBT (or any tradeable asset) forfeiture → community pool
    2. Social graph severance (follows: in + out)
    3. Delegated AI agent wipe (vault key burn implicit)
    4. Reputation reset (DID Trust Score)

  Edges persist (Karma.lean N2 edge_outlives_endpoint).
  New organism cannot claim continuity (Karma.lean N3 anatman).

  Phase K0 enforces non-linkability by protocol commitment only;
  zk-SNARK proof is Phase K1.

  Pipeline:
    1. karma.rebirth.precheck    new_did emergence eligibility
    2. ExclusiveGateway          cooldown / floor debt → reject
    3. karma.rebirth.forfeit     WBT → commons pool
    4. karma.rebirth.severFollows  unfollow + record severance
    5. karma.rebirth.wipeAgents    retrain delegated agents to base
    6. karma.organism.dissolve   set dissolved_at on old
    7. karma.rebirth.emerge      INSERT new organism pattern
    8. generic.audit.emit        OCEL trail
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_karma_rebirth"
    targetNamespace="https://etzhayyim.ai/bpmn/karma"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="karma_rebirth" name="karma rebirth (samsara)" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.karma.rebirth", "version": 1, "resultTimeoutMs": 120000 }
    </bpmn:documentation>

    <bpmn:startEvent id="StartXrpc" name="xrpc">
      <bpmn:outgoing>Flow_ToPrecheck</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Precheck" name="precheck eligibility (cooldown / floor debt / santana)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="karma.rebirth.precheck"/>
        <zeebe:ioMapping>
          <zeebe:input source="=did" target="did"/>
          <zeebe:input source="=newDid" target="newDid"/>
          <zeebe:output source="=eligible" target="eligible"/>
          <zeebe:output source="=oldSantanaRootCid" target="oldSantanaRootCid"/>
          <zeebe:output source="=rejectedReason" target="rejectedReason"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPrecheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToPrecheck" sourceRef="StartXrpc" targetRef="Task_Precheck"/>

    <bpmn:exclusiveGateway id="Gate_Eligible" name="eligible?">
      <bpmn:incoming>Flow_ToGate</bpmn:incoming>
      <bpmn:outgoing>Flow_Pass</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToGate" sourceRef="Task_Precheck" targetRef="Gate_Eligible"/>

    <bpmn:sequenceFlow id="Flow_Pass" sourceRef="Gate_Eligible" targetRef="Task_Forfeit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=eligible = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Reject" sourceRef="Gate_Eligible" targetRef="Task_AuditReject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=eligible = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_Forfeit" name="forfeit assets to commons">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="karma.rebirth.forfeit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=did" target="did"/>
          <zeebe:output source="=wbtForfeited" target="wbtForfeited"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Pass</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSever</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Sever" name="sever social graph (follows in+out)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="karma.rebirth.severFollows"/>
        <zeebe:ioMapping>
          <zeebe:input source="=did" target="did"/>
          <zeebe:output source="=followsSeveredOut" target="followsSeveredOut"/>
          <zeebe:output source="=followsSeveredIn" target="followsSeveredIn"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSever</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWipe</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToSever" sourceRef="Task_Forfeit" targetRef="Task_Sever"/>

    <bpmn:serviceTask id="Task_Wipe" name="wipe delegated agents (retrain to base)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="karma.rebirth.wipeAgents"/>
        <zeebe:ioMapping>
          <zeebe:input source="=did" target="did"/>
          <zeebe:output source="=agentsRetrained" target="agentsRetrained"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToWipe</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDissolve</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToWipe" sourceRef="Task_Sever" targetRef="Task_Wipe"/>

    <bpmn:serviceTask id="Task_Dissolve" name="dissolve old organism (deps remain)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="karma.organism.dissolve"/>
        <zeebe:ioMapping>
          <zeebe:input source="=did" target="did"/>
          <zeebe:input source="=&quot;rebirth-prelude&quot;" target="dissolutionKind"/>
          <zeebe:input source="=membershipDepsRootCid" target="membershipDepsRootCid"/>
          <zeebe:output source="=edgesPersisting" target="edgesPersisting"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDissolve</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEmerge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToDissolve" sourceRef="Task_Wipe" targetRef="Task_Dissolve"/>

    <bpmn:serviceTask id="Task_Emerge" name="emerge new organism (anatman fresh)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="karma.rebirth.emerge"/>
        <zeebe:ioMapping>
          <zeebe:input source="=newDid" target="newDid"/>
          <zeebe:input source="=oldSantanaRootCid" target="oldSantanaRootCid"/>
          <zeebe:output source="=newSantanaRootCid" target="newSantanaRootCid"/>
          <zeebe:output source="=rebirthAt" target="rebirthAt"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToEmerge</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAuditOk</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_AuditOk" name="audit emit (rebirth)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:karma.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.karma.rebirth&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;oldDid&quot;: did, &quot;newDid&quot;: newDid, &quot;wbtForfeited&quot;: wbtForfeited, &quot;edgesPersisting&quot;: edgesPersisting, &quot;followsSeveredOut&quot;: followsSeveredOut, &quot;followsSeveredIn&quot;: followsSeveredIn, &quot;agentsRetrained&quot;: agentsRetrained }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAuditOk</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndOk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAuditOk" sourceRef="Task_Emerge" targetRef="Task_AuditOk"/>

    <bpmn:serviceTask id="Task_AuditReject" name="audit emit (rejected)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:karma.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.karma.rebirth.reject&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;did&quot;: did, &quot;newDid&quot;: newDid, &quot;reason&quot;: rejectedReason }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndReject</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_ToEndOk" sourceRef="Task_AuditOk" targetRef="EndOk"/>
    <bpmn:sequenceFlow id="Flow_ToEndReject" sourceRef="Task_AuditReject" targetRef="EndReject"/>

    <bpmn:endEvent id="EndOk" name="reborn">
      <bpmn:incoming>Flow_ToEndOk</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndReject" name="rejected">
      <bpmn:incoming>Flow_ToEndReject</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
