<?xml version="1.0" encoding="UTF-8"?>
<!--
  karma.etzhayyim.com — WBT balance query (XRPC entry).

  Pure read: returns balance + aggregate stats. Returns zero for
  never-seen DIDs (silent default).
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_karma_wbt_balance"
    targetNamespace="https://etzhayyim.ai/bpmn/karma"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="karma_wbt_balance" name="karma WBT balance" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.karma.wbtBalance", "version": 1, "resultTimeoutMs": 15000 }
    </bpmn:documentation>

    <bpmn:startEvent id="StartXrpc" name="xrpc">
      <bpmn:outgoing>Flow_ToQuery</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Query" name="get balance + stats">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="karma.wbt.balanceGet"/>
        <zeebe:ioMapping>
          <zeebe:input source="=did" target="did"/>
          <zeebe:output source="=balance" target="balance"/>
          <zeebe:output source="=totalInflow" target="totalInflow"/>
          <zeebe:output source="=totalOutflow" target="totalOutflow"/>
          <zeebe:output source="=txCount" target="txCount"/>
          <zeebe:output source="=lastTxTsMs" target="lastTxTsMs"/>
          <zeebe:output source="=lastTxId" target="lastTxId"/>
          <zeebe:output source="=isCommons" target="isCommons"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToQuery</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToQuery" sourceRef="StartXrpc" targetRef="Task_Query"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Query" targetRef="End"/>

    <bpmn:endEvent id="End" name="queried">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
