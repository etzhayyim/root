<?xml version="1.0" encoding="UTF-8"?>
<!--
  karma.etzhayyim.com — resident organism heartbeat (R/PT15M).

  Per-tick supervisor. For each alive organism in vertex_organism_runtime,
  call karma.organism.tick. Tick performs Pregel BFS + observation
  emission + heartbeat. Distributed across the mitama-karma-pool worker
  fleet — one worker activates one tick at a time, but many workers run
  in parallel so all organisms get serviced.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_karma_organism_resident"
    targetNamespace="https://etzhayyim.ai/bpmn/karma"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="karma_organism_resident" name="karma organism resident heartbeat" isExecutable="true">

    <bpmn:documentation>
      { "version": 1 }
    </bpmn:documentation>

    <bpmn:startEvent id="StartTimer" name="every 15 min">
      <bpmn:outgoing>Flow_ToFind</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT15M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_FindAlive" name="select alive organisms (oldest heartbeat first)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;mv_organism_runtime_alive&quot;" target="table"/>
          <zeebe:input source="=&quot;substrate IS NOT NULL&quot;" target="whereExpr"/>
          <zeebe:input source="=[]" target="whereParams"/>
          <zeebe:input source="=&quot;substrate, alive_count&quot;" target="columns"/>
          <zeebe:input source="=10" target="limit"/>
          <zeebe:output source="=rows" target="aliveSubstrates"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToFind</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTick</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToFind" sourceRef="StartTimer" targetRef="Task_FindAlive"/>

    <bpmn:serviceTask id="Task_TickAll" name="tick all alive organisms (per-substrate batch)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="karma.organism.tickBatch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=aliveSubstrates" target="aliveSubstrates"/>
          <zeebe:input source="=50" target="maxNeighborsPerOrganism"/>
          <zeebe:output source="=ticked" target="ticked"/>
          <zeebe:output source="=observations" target="observations"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToTick</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToTick" sourceRef="Task_FindAlive" targetRef="Task_TickAll"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:karma.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.karma.organismResident&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;ticked&quot;: ticked, &quot;observations&quot;: observations }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_TickAll" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="ticked">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
