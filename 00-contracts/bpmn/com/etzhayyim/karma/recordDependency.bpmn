<?xml version="1.0" encoding="UTF-8"?>
<!--
  karma.etzhayyim.com — record karma dependency edge (XRPC entry).

  Pipeline:
    1. karma.input.validate          input shape + tier vs Floor preconditions
    2. karma.floor.gate              child_floor_axiom auto-classify + reject
                                       inadmissible Harm-Floor edges (Karma.lean
                                       floor_violation_inadmissible)
    3. ExclusiveGateway              admissible? → AuditReject if false
    4. karma.edge.persist            Hyperdrive direct INSERT into
                                       edge_karma_dependency (ADR-0036)
                                       with content-addressed edge_id (ADR-0041)
    5. generic.audit.emit            OCEL trail
    6. (lift to L1-L4 layers happens in separate timer-driven BPMNs)
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_karma_record_dependency"
    targetNamespace="https://etzhayyim.ai/bpmn/karma"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="karma_record_dependency" name="karma record dependency" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.karma.recordDependency", "version": 1, "resultTimeoutMs": 30000 }
    </bpmn:documentation>

    <bpmn:startEvent id="StartXrpc" name="xrpc">
      <bpmn:outgoing>Flow_ToValidate</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Validate" name="validate input">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="karma.input.validate"/>
        <zeebe:ioMapping>
          <zeebe:input source="=sourceDid" target="sourceDid"/>
          <zeebe:input source="=targetDid" target="targetDid"/>
          <zeebe:input source="=axis" target="axis"/>
          <zeebe:input source="=tier" target="tier"/>
          <zeebe:input source="=magnitude" target="magnitude"/>
          <zeebe:input source="=direction" target="direction"/>
          <zeebe:input source="=victimVul" target="victimVul"/>
          <zeebe:input source="=futureHorizonYears" target="futureHorizonYears"/>
          <zeebe:input source="=irreversible" target="irreversible"/>
          <zeebe:input source="=tsMs" target="tsMs"/>
          <zeebe:output source="=ok" target="validOk"/>
          <zeebe:output source="=reason" target="validReason"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToValidate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFloor</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToValidate" sourceRef="StartXrpc" targetRef="Task_Validate"/>

    <bpmn:serviceTask id="Task_Floor" name="floor gate (Karma.lean child_floor_axiom)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="karma.floor.gate"/>
        <zeebe:ioMapping>
          <zeebe:input source="=axis" target="axis"/>
          <zeebe:input source="=tier" target="tier"/>
          <zeebe:input source="=direction" target="direction"/>
          <zeebe:input source="=victimVul" target="victimVul"/>
          <zeebe:output source="=admissible" target="admissible"/>
          <zeebe:output source="=resolvedTier" target="resolvedTier"/>
          <zeebe:output source="=rejectedReason" target="rejectedReason"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToFloor</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGate</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gate_Admissible" name="admissible?">
      <bpmn:incoming>Flow_ToGate</bpmn:incoming>
      <bpmn:outgoing>Flow_Pass</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToGate" sourceRef="Task_Floor" targetRef="Gate_Admissible"/>

    <bpmn:sequenceFlow id="Flow_Pass" sourceRef="Gate_Admissible" targetRef="Task_Persist">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=admissible = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Reject" sourceRef="Gate_Admissible" targetRef="Task_AuditReject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=admissible = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_Persist" name="persist edge (Hyperdrive direct, ADR-0036)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="karma.edge.persist"/>
        <zeebe:ioMapping>
          <zeebe:input source="=sourceDid" target="sourceDid"/>
          <zeebe:input source="=targetDid" target="targetDid"/>
          <zeebe:input source="=axis" target="axis"/>
          <zeebe:input source="=resolvedTier" target="tier"/>
          <zeebe:input source="=magnitude" target="magnitude"/>
          <zeebe:input source="=direction" target="direction"/>
          <zeebe:input source="=victimVul" target="victimVul"/>
          <zeebe:input source="=futureHorizonYears" target="futureHorizonYears"/>
          <zeebe:input source="=irreversible" target="irreversible"/>
          <zeebe:input source="=tsMs" target="tsMs"/>
          <zeebe:input source="=contextCid" target="contextCid"/>
          <zeebe:input source="=proofCid" target="proofCid"/>
          <zeebe:input source="=proofEncrypted" target="proofEncrypted"/>
          <zeebe:input source="=prevEdgeInContextCid" target="prevEdgeInContextCid"/>
          <zeebe:output source="=edgeId" target="edgeId"/>
          <zeebe:output source="=vertexId" target="vertexId"/>
          <zeebe:output source="=signedWeight" target="signedWeight"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Pass</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAuditOk</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_AuditOk" name="audit emit (recorded)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:karma.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.karma.recordDependency&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;edgeId&quot;: edgeId, &quot;axis&quot;: axis, &quot;tier&quot;: resolvedTier, &quot;direction&quot;: direction, &quot;signedWeight&quot;: signedWeight }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAuditOk</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndOk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAuditOk" sourceRef="Task_Persist" targetRef="Task_AuditOk"/>

    <bpmn:serviceTask id="Task_AuditReject" name="audit emit (rejected)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:karma.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.karma.recordDependency.reject&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;sourceDid&quot;: sourceDid, &quot;axis&quot;: axis, &quot;tier&quot;: tier, &quot;direction&quot;: direction, &quot;reason&quot;: rejectedReason }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndReject</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_ToEndOk" sourceRef="Task_AuditOk" targetRef="EndOk"/>
    <bpmn:sequenceFlow id="Flow_ToEndReject" sourceRef="Task_AuditReject" targetRef="EndReject"/>

    <bpmn:endEvent id="EndOk" name="recorded">
      <bpmn:incoming>Flow_ToEndOk</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndReject" name="floor-violation">
      <bpmn:incoming>Flow_ToEndReject</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
