<?xml version="1.0" encoding="UTF-8"?>
<!--
  karma.etzhayyim.com — cohort genesis (R/PT24H autonomous self-growth driver).

  Calls karma.organism.harvest which decides whether ecosystem
  conditions warrant spawning a new cohort (alive organisms ≥ K AND
  no active cohort exists for this generation, OR edge density > 100).
  Spawns produce a vertex_organism_cohort row + cohort DID; subsequent
  organism.spawn calls bind individual organism DIDs to the cohort.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_karma_cohort_genesis"
    targetNamespace="https://etzhayyim.ai/bpmn/karma"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="karma_cohort_genesis" name="karma cohort genesis" isExecutable="true">

    <bpmn:documentation>
      { "version": 1 }
    </bpmn:documentation>

    <bpmn:startEvent id="StartTimer" name="cron 00:30 UTC daily">
      <bpmn:outgoing>Flow_ToHarvest</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 30 0 * * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Harvest" name="harvest ecosystem state + decide spawn">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="karma.organism.harvest"/>
        <zeebe:ioMapping>
          <zeebe:output source="=aliveOrganisms" target="aliveOrganisms"/>
          <zeebe:output source="=edgeCount" target="edgeCount"/>
          <zeebe:output source="=edgeDensity" target="edgeDensity"/>
          <zeebe:output source="=activeCohorts" target="activeCohorts"/>
          <zeebe:output source="=shouldSpawn" target="shouldSpawn"/>
          <zeebe:output source="=spawnedCohortId" target="spawnedCohortId"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToHarvest</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToHarvest" sourceRef="StartTimer" targetRef="Task_Harvest"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:karma.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.karma.cohortGenesis&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;aliveOrganisms&quot;: aliveOrganisms, &quot;edgeCount&quot;: edgeCount, &quot;edgeDensity&quot;: edgeDensity, &quot;shouldSpawn&quot;: shouldSpawn, &quot;spawnedCohortId&quot;: spawnedCohortId }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Harvest" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="harvested">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
