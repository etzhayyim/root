<?xml version="1.0" encoding="UTF-8"?>
<!--
  karma.etzhayyim.com — list karma edges for an organism (XRPC entry).

  Returns edges where the given DID is source OR target. Edges persist
  regardless of organism dissolution status (Karma.lean N2). Privacy:
  proofEncrypted edges return only metadata; the encrypted proof_cid
  is opaque without the recipient's vault key.

  Pure read path: 1 generic.db.select call + audit emit.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_karma_list_edges"
    targetNamespace="https://etzhayyim.ai/bpmn/karma"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="karma_list_edges" name="karma list edges" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.karma.listEdges", "version": 1, "resultTimeoutMs": 15000 }
    </bpmn:documentation>

    <bpmn:startEvent id="StartXrpc" name="xrpc">
      <bpmn:outgoing>Flow_ToSelect</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Select" name="select edges (DID source OR target)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;edge_karma_dependency&quot;" target="table"/>
          <zeebe:input source="=&quot;(source_did_at_event = %s OR target_did_at_event = %s)&quot;" target="whereExpr"/>
          <zeebe:input source="=[did, did]" target="whereParams"/>
          <zeebe:input source="=&quot;edge_id, source_did_at_event, target_did_at_event, axis, tier, magnitude, direction, victim_vul, ts_ms, ipfs_cid, atrepo_uri, proof_encrypted, blockchain_anchor_id&quot;" target="columns"/>
          <zeebe:input source="=if limit = null then 100 else limit" target="limit"/>
          <zeebe:input source="=&quot;ts_ms DESC&quot;" target="orderBy"/>
          <zeebe:output source="=rows" target="edges"/>
          <zeebe:output source="=rowCount" target="total"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSelect</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToSelect" sourceRef="StartXrpc" targetRef="Task_Select"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:karma.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.karma.listEdges&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;did&quot;: did, &quot;total&quot;: total }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Select" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="listed">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
