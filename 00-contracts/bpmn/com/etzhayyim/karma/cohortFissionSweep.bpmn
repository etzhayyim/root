<?xml version="1.0" encoding="UTF-8"?>
<!--
  karma.etzhayyim.com — cohort fission sweeper (R/PT12H autonomous).

  Pairs with karma_cohort_genesis (R/PT24H spawn) — completes the
  ecosystem reproduction loop. Calls karma.cohort.fissionScan to
  detect cohorts with posterior > 0.95, then triggers fission for
  each. Idempotent — fissioned cohorts are skipped on subsequent runs.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_karma_cohort_fission_sweep"
    targetNamespace="https://etzhayyim.ai/bpmn/karma"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="karma_cohort_fission_sweep" name="karma cohort fission sweep" isExecutable="true">

    <bpmn:documentation>
      { "version": 1 }
    </bpmn:documentation>

    <bpmn:startEvent id="StartTimer" name="every 12h">
      <bpmn:outgoing>Flow_ToScan</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT12H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Scan" name="scan + fission posterior > 0.95 cohorts">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="karma.cohort.fissionScan"/>
        <zeebe:ioMapping>
          <zeebe:output source="=fissioned" target="fissioned"/>
          <zeebe:output source="=childrenSpawned" target="childrenSpawned"/>
          <zeebe:output source="=eligibleSkipped" target="eligibleSkipped"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToScan</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToScan" sourceRef="StartTimer" targetRef="Task_Scan"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:karma.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.karma.cohortFissionSweep&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;fissioned&quot;: fissioned, &quot;childrenSpawned&quot;: childrenSpawned, &quot;skipped&quot;: eligibleSkipped }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Scan" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="swept">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
