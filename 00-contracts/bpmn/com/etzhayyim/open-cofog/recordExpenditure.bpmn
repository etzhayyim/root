<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_cofog_record_expenditure"
    targetNamespace="https://etzhayyim.ai/bpmn/open-cofog"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_cofog_record_expenditure" name="政府支出 記録" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Classify"/>

    <!--
      scale:
        large  : amount >= 1e9
        medium : amount >= 1e7
        small  : otherwise
      public notice = large
    -->
    <bpmn:serviceTask id="Task_Classify" name="scale 分類">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT 1 AS ok LIMIT 1&quot;" target="query"/>
          <zeebe:input source="=[]" target="params"/>
          <zeebe:output source="=if amount &gt;= 1000000000 then &quot;large&quot; else if amount &gt;= 10000000 then &quot;medium&quot; else &quot;small&quot;" target="scale"/>
          <zeebe:output source="=amount &gt;= 1000000000" target="requirePublicNotice"/>
          <zeebe:output source="=&quot;at://did:web:open-cofog.etzhayyim.com/com.etzhayyim.apps.openCofog.class/&quot; + string(cofogClassCode)" target="classDst"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_Save</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Save" sourceRef="Task_Classify" targetRef="Task_Save"/>

    <bpmn:serviceTask id="Task_Save" name="expenditure 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_cofog_expenditure&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id: vertexId, gov_org_id: govOrgId,
              fiscal_year: fiscalYear, cofog_class_code: cofogClassCode,
              amount: amount, currency: currency, narrative: narrative,
              evidence_url: evidenceUrl, confidence: confidence,
              status: &quot;confirmed&quot;, reported_at: reportedAt,
              created_at: string(now()), owner_did: callerDid,
              sensitivity_ord: 1, org_id: govOrgId,
              user_id: callerDid, actor_id: &quot;sys.bpmn.open-cofog&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Save</bpmn:incoming><bpmn:outgoing>Flow_Edge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Edge" sourceRef="Task_Save" targetRef="Task_Edge"/>

    <bpmn:serviceTask id="Task_Edge" name="expenditure → class edge">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;edge_open_cofog_expenditure_class&quot;" target="table"/>
          <zeebe:input source="={
              edge_id: string(vertexId) + &quot;:class&quot;,
              src_vid: vertexId, dst_vid: classDst, role: &quot;tagged_as&quot;,
              created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1,
              org_id: govOrgId, user_id: callerDid, actor_id: &quot;sys.bpmn.open-cofog&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Edge</bpmn:incoming><bpmn:outgoing>Flow_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Gate" sourceRef="Task_Edge" targetRef="Gate"/>

    <bpmn:exclusiveGateway id="Gate" default="Flow_Silent">
      <bpmn:incoming>Flow_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Notice</bpmn:outgoing>
      <bpmn:outgoing>Flow_Silent</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Notice" sourceRef="Gate" targetRef="Task_AuditLarge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=requirePublicNotice = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Silent" sourceRef="Gate" targetRef="Task_AuditSmall"/>

    <bpmn:serviceTask id="Task_AuditLarge" name="audit expenditure.large">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-cofog.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openCofog.expenditure.large&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, scale: scale, cofogClassCode: cofogClassCode, amount: amount, currency: currency, govOrgId: govOrgId}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Notice</bpmn:incoming><bpmn:outgoing>Flow_EM</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EM" sourceRef="Task_AuditLarge" targetRef="End_M"/>

    <bpmn:serviceTask id="Task_AuditSmall" name="audit expenditure.log">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-cofog.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openCofog.expenditure.log&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, scale: scale, cofogClassCode: cofogClassCode, amount: amount}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Silent</bpmn:incoming><bpmn:outgoing>Flow_ES</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ES" sourceRef="Task_AuditSmall" targetRef="End_S"/>

    <bpmn:endEvent id="End_S"><bpmn:incoming>Flow_ES</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_M"><bpmn:incoming>Flow_EM</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
