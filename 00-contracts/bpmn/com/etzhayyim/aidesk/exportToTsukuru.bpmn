<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  id="Definitions_aidesk_export_to_tsukuru"
  targetNamespace="https://etzhayyim.ai/bpmn/aidesk"
  exporter="hand-written"
  exporterVersion="2.0">

  <bpmn:process id="aidesk_export_to_tsukuru" name="aidesk export artifact to tsukuru" isExecutable="true">

    <bpmn:startEvent id="Start" name="aidesk.export.requested message">
      <bpmn:outgoing>Flow_ToFetchArtifact</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ExportRequested"/>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToFetchArtifact" sourceRef="Start" targetRef="Task_FetchArtifact"/>

    <!-- Fetch artifact + enforce license_tier gate in Python handler -->
    <bpmn:serviceTask id="Task_FetchArtifact" name="fetch artifact + assert license_tier=apache2">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="aidesk.tsukuru.handoff"/>
        <zeebe:ioMapping>
          <zeebe:input source="=artifactId" target="artifactId"/>
          <zeebe:input source="=stepB2Key" target="stepB2Key"/>
          <zeebe:input source="=cadqueryCode" target="cadqueryCode"/>
          <zeebe:input source="=license_tier" target="license_tier"/>
          <zeebe:input source="=rfqNotes" target="rfqNotes"/>
          <zeebe:output source="=tsukuruPackageId" target="tsukuruPackageId"/>
          <zeebe:output source="=dispatched" target="dispatched"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToFetchArtifact</bpmn:incoming>
      <bpmn:outgoing>Flow_ToUpdateArtifact</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToUpdateArtifact" sourceRef="Task_FetchArtifact" targetRef="Task_UpdateArtifact"/>

    <!-- Persist tsukuruPackageId back to artifact record -->
    <bpmn:serviceTask id="Task_UpdateArtifact" name="update vertex_aidesk_artifact.tsukuru_package_id">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_aidesk_artifact&quot;" target="table"/>
          <zeebe:input source="={ vertex_id: artifactVertexId, tsukuru_package_id: tsukuruPackageId }" target="row"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToUpdateArtifact</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_UpdateArtifact" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="emit export audit event">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:aidesk.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;aideskArtifactExportedToTsukuru&quot;" target="action"/>
          <zeebe:input source="={ bpmnProcessId: &quot;aidesk_export_to_tsukuru&quot;, artifactId: artifactId, tsukuruPackageId: tsukuruPackageId, licenseTier: license_tier }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="export complete">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <bpmn:message id="Message_ExportRequested" name="aidesk.export.requested"/>

</bpmn:definitions>
