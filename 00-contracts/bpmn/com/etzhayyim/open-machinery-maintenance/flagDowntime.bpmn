<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_machinery_maintenance_flag_downtime"
    targetNamespace="https://etzhayyim.ai/bpmn/open-machinery-maintenance"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="open_machinery_maintenance_flag_downtime" name="flagDowntime" isExecutable="true">
    <bpmn:startEvent id="Start" name="downtime reported">
      <bpmn:outgoing>Flow_S</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_ClassifyDowntime"/>

    <bpmn:serviceTask id="Task_ClassifyDowntime" name="classify downtime">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.rules.evaluate"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;open-machinery-maintenance.downtime.v1&quot;" target="ruleSet"/>
          <zeebe:input source="={
              vertexId:           vertexId,
              assetId:            assetId,
              facilityLei:        facilityLei,
              downtimeStartedAt:  downtimeStartedAt,
              estimatedMinutes:   estimatedMinutes,
              safetyIncident:     safetyIncident,
              productionImpact:   productionImpact,
              rootCauseCode:      rootCauseCode
          }" target="facts"/>
          <zeebe:output source="=coalesce(severity, if safetyIncident = true then &quot;critical&quot; else if estimatedMinutes &gt; 240 then &quot;major&quot; else &quot;minor&quot;)" target="severity"/>
          <zeebe:output source="=coalesce(escalationRequired, safetyIncident = true or estimatedMinutes &gt; 240 or productionImpact = &quot;line_stop&quot;)" target="escalationRequired"/>
          <zeebe:output source="=findings" target="downtimeFindings"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming>
      <bpmn:outgoing>Flow_Classified</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Classified" sourceRef="Task_ClassifyDowntime" targetRef="Task_Save"/>

    <bpmn:serviceTask id="Task_Save" name="save downtime event">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_machinery_maintenance&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:           vertexId,
              asset_id:            assetId,
              facility_lei:        facilityLei,
              downtime_started_at: downtimeStartedAt,
              estimated_minutes:   estimatedMinutes,
              safety_incident:     safetyIncident,
              production_impact:   productionImpact,
              root_cause_code:     rootCauseCode,
              severity:            severity,
              escalation_required: escalationRequired,
              downtime_findings:   downtimeFindings,
              status:              &quot;downtime_open&quot;,
              created_at:          string(now()),
              owner_did:           callerDid,
              sensitivity_ord:     1,
              org_id:              callerDid,
              user_id:             callerDid,
              actor_id:            &quot;sys.bpmn.open-machinery-maintenance&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Classified</bpmn:incoming>
      <bpmn:outgoing>Flow_EscalationGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EscalationGate" sourceRef="Task_Save" targetRef="Gate_Escalate"/>

    <bpmn:exclusiveGateway id="Gate_Escalate" name="escalate?" default="Flow_NoEscalation">
      <bpmn:incoming>Flow_EscalationGate</bpmn:incoming>
      <bpmn:outgoing>Flow_Escalate</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoEscalation</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Escalate" sourceRef="Gate_Escalate" targetRef="Task_AuditEscalation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=escalationRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoEscalation" sourceRef="Gate_Escalate" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_AuditEscalation" name="audit escalation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-machinery-maintenance.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openMachineryMaintenance.downtime.escalate&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, assetId: assetId, severity: severity, findings: downtimeFindings}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_EndEscalated</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndEscalated" sourceRef="Task_AuditEscalation" targetRef="End"/>

    <bpmn:serviceTask id="Task_Audit" name="audit downtime">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-machinery-maintenance.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openMachineryMaintenance.downtime.flag&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, assetId: assetId, severity: severity}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoEscalation</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="flagged">
      <bpmn:incoming>Flow_EndEscalated</bpmn:incoming>
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
