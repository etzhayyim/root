<?xml version="1.0" encoding="UTF-8"?>
<!--
  media-gamers.guideGenerate

  Zeebe-owned guide generation pipeline for media-gamers.etzhayyim.com. Python workers
  perform target resolution, LLM generation, translation, quality scoring, and
  social-post drafting. Cloudflare app.ts remains the edge/PDS write boundary
  through com.etzhayyim.apps.media_gamers.guide.commitGuide.

  Input variables:
    slug, guideType, translate, offset, limit, userId, mood, publish
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_media_gamers_guide_generate"
    targetNamespace="https://etzhayyim.ai/bpmn/media-gamers"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="media_gamers_guide_generate" name="media gamers guide generate" isExecutable="true">
    <bpmn:startEvent id="Start" name="guide generation requested">
      <bpmn:outgoing>Flow_Resolve</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Resolve" sourceRef="Start" targetRef="Task_Resolve"/>

    <bpmn:serviceTask id="Task_Resolve" name="resolve guide targets">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mediaGamers.guide.resolveTargets"/>
        <zeebe:ioMapping>
          <zeebe:input source="=string(slug)" target="slug"/>
          <zeebe:input source="=string(guideType)" target="guideType"/>
          <zeebe:input source="=offset" target="offset"/>
          <zeebe:input source="=limit" target="limit"/>
          <zeebe:input source="=userId" target="userId"/>
          <zeebe:input source="=mood" target="mood"/>
          <zeebe:output source="=targets" target="targets"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Resolve</bpmn:incoming>
      <bpmn:outgoing>Flow_Generate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Generate" sourceRef="Task_Resolve" targetRef="Task_Generate"/>

    <bpmn:serviceTask id="Task_Generate" name="generate translate and commit guides">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mediaGamers.guide.generate"/>
        <zeebe:ioMapping>
          <zeebe:input source="=targets" target="targets"/>
          <zeebe:input source="=translate" target="translate"/>
          <zeebe:input source="=publish" target="publish"/>
          <zeebe:output source="=results" target="results"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Generate</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_Generate" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit guide generation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:media-gamers.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;media-gamers.guideGenerate&quot;" target="action"/>
          <zeebe:input source="={ slug: string(slug), guideType: string(guideType), results: results }" target="payload"/>
          <zeebe:output source="=rkey" target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="guide committed">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
