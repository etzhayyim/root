<?xml version="1.0" encoding="UTF-8"?>
<!--
  rl.rlPolicyDispatch — Phase 2 AIF policy-guided BPMN action selection. ADR-2604291800.

  Fires every 1h. For each actor with live EFE data, ε-greedy samples from
  π(a) = softmax(−γ·G(a)) and dispatches the winning BPMN NSID to the
  bpmn-dispatcher ClusterIP. Logs every attempt to vertex_rl_aif_dispatch_log.

  NSID: com.etzhayyim.apps.rl.policyDispatch
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/rl-policy-dispatch-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_rl_policy_dispatch"
    targetNamespace="https://etzhayyim.ai/bpmn/rl"
    exporter="hand-written"
    exporterVersion="2.0">

  <bpmn:process id="rl_policy_dispatch" name="AIF Policy Dispatch" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.rl.policyDispatch", "version": 1, "resultTimeoutMs": 300000 }
    </bpmn:documentation>

    <!-- Timer: every 1h (runs after belief update) -->
    <bpmn:startEvent id="Start" name="every 1h">
      <bpmn:outgoing>Flow_ToDispatch</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_1h">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT1H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToDispatch" sourceRef="Start" targetRef="Task_Dispatch"/>

    <!-- ε-greedy policy sample + bpmn-dispatcher POST -->
    <bpmn:serviceTask id="Task_Dispatch" name="sample policy and dispatch BPMN">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="rl.policy.dispatch" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=10"  target="batch_size"/>
          <zeebe:input source="=0.2" target="epsilon"/>
          <zeebe:output source="=ok"             target="ok"/>
          <zeebe:output source="=actors_checked" target="actorsChecked"/>
          <zeebe:output source="=dispatched"     target="dispatched"/>
          <zeebe:output source="=errors"         target="errors"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDispatch</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Dispatch" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
