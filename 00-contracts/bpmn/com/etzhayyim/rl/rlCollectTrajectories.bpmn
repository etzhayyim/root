<?xml version="1.0" encoding="UTF-8"?>
<!--
  rl.rlCollectTrajectories — Phase 0 RL signal accretion. ADR-2604291800.

  Fires every 1h. Cursor-scans vertex_wellbecoming_event → vertex_rl_step.
  No training. Reward signal collection only.

  NSID: com.etzhayyim.apps.rl.collectTrajectories
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/rl-collect-trajectories-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_rl_collect_trajectories"
    targetNamespace="https://etzhayyim.ai/bpmn/rl"
    exporter="hand-written"
    exporterVersion="2.0">

  <bpmn:process id="rl_collect_trajectories" name="RL Collect Trajectories" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.rl.collectTrajectories", "version": 1, "resultTimeoutMs": 120000 }
    </bpmn:documentation>

    <!-- Timer: every 1h -->
    <bpmn:startEvent id="Start" name="every 1h">
      <bpmn:outgoing>Flow_ToCollect</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_1h">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT1H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToCollect" sourceRef="Start" targetRef="Task_Collect"/>

    <!-- Collect: cursor-scan wellbecoming_event → rl_step -->
    <bpmn:serviceTask id="Task_Collect" name="collect RL trajectories">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="rl.collect.trajectories" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=200" target="batch_size"/>
          <zeebe:output source="=collected"  target="collected"/>
          <zeebe:output source="=skipped"    target="skipped"/>
          <zeebe:output source="=cursor_ts"  target="cursorTs"/>
          <zeebe:output source="=has_more"   target="hasMore"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCollect</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Collect" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
