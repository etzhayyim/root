<?xml version="1.0" encoding="UTF-8"?>
<!--
  rl.rlAifLearnModel — Phase 1B Active Inference model learning. ADR-2604291800.

  Fires once per day. For each (actor_did, action_nsid) pair with >= min_steps
  accumulated trajectory steps, performs online Dirichlet update of A_counts
  and B_counts matrices and renormalises A and B.

  NSID: com.etzhayyim.apps.rl.aifLearnModel
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/rl-aif-learn-model-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_rl_aif_learn_model"
    targetNamespace="https://etzhayyim.ai/bpmn/rl"
    exporter="hand-written"
    exporterVersion="2.0">

  <bpmn:process id="rl_aif_learn_model" name="AIF Learn Model" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.rl.aifLearnModel", "version": 1, "resultTimeoutMs": 300000 }
    </bpmn:documentation>

    <!-- Timer: once per day -->
    <bpmn:startEvent id="Start" name="every 1d">
      <bpmn:outgoing>Flow_ToLearn</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_1d">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToLearn" sourceRef="Start" targetRef="Task_Learn"/>

    <!-- Dirichlet update of A_counts and B_counts -->
    <bpmn:serviceTask id="Task_Learn" name="learn AIF generative model">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="rl.aif.learn_model" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=20"  target="min_steps"/>
          <zeebe:input source="=20"  target="max_actors"/>
          <zeebe:output source="=ok"             target="ok"/>
          <zeebe:output source="=models_updated" target="modelsUpdated"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToLearn</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Learn" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
