<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_extreme_weather_attribution_publish_attribution" targetNamespace="https://etzhayyim.ai/bpmn/open-extreme-weather-attribution" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_extreme_weather_attribution_publish_attribution" name="publishAttribution" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_extreme_weather_attribution&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, study_id: studyId, event_name: eventName, event_type: eventType, region_m49: regionM49, event_started_at: eventStartedAt, fraction_attributable_risk_pct: fractionAttributableRiskPct, intensity_increase_ratio: intensityIncreaseRatio, confidence_band: confidenceBand, published_at: publishedAt, signal_tier: if fractionAttributableRiskPct != null and fractionAttributableRiskPct &gt;= 80 and confidenceBand = &quot;very_high&quot; then &quot;unequivocal&quot; else if fractionAttributableRiskPct != null and fractionAttributableRiskPct &gt;= 50 then &quot;strong&quot; else if fractionAttributableRiskPct != null and fractionAttributableRiskPct &gt;= 20 then &quot;moderate&quot; else &quot;weak&quot;, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-extreme-weather-attribution&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-extreme-weather-attribution.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;open.extremeWeatherAttribution.publishAttribution&quot;" target="action"/><zeebe:input source="={vertexId: vertexId}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>