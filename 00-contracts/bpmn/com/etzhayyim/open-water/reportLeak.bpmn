<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_water_report_leak"
    targetNamespace="https://etzhayyim.ai/bpmn/open-water"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="open_water_report_leak" name="漏水 報告" isExecutable="true">
    <bpmn:startEvent id="Start" name="漏水検知">
      <bpmn:outgoing>Flow_S</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Classify"/>

    <!--
      Inline severity classification — equivalent to DMN `openWater.leakSeverity`
      but expressed in FEEL to avoid a separate DMN artifact for the MVP.
        major    : flow >= 300 l/min OR contaminationRisk = "high"
        moderate : 50  <= flow < 300
        minor    : flow < 50
      require_public_notice = severity = "major" OR contaminationRisk = "high"
    -->
    <bpmn:serviceTask id="Task_Classify" name="severity 分類">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT 1 AS ok LIMIT 1&quot;" target="query"/>
          <zeebe:input source="=[]" target="params"/>
          <zeebe:output source="=if contaminationRisk = &quot;high&quot; or estimatedFlowLpm &gt;= 300 then &quot;major&quot;
                                else if estimatedFlowLpm &gt;= 50 then &quot;moderate&quot;
                                else &quot;minor&quot;" target="severity"/>
          <zeebe:output source="=contaminationRisk = &quot;high&quot; or estimatedFlowLpm &gt;= 300" target="requirePublicNotice"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming>
      <bpmn:outgoing>Flow_Save</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Save" sourceRef="Task_Classify" targetRef="Task_SaveLeak"/>

    <bpmn:serviceTask id="Task_SaveLeak" name="leak 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_water_leak&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:              vertexId,
              utility_org_id:         utilityOrgId,
              main_vertex_id:         mainVertexId,
              latitude:               latitude,
              longitude:              longitude,
              estimated_flow_lpm:     estimatedFlowLpm,
              contamination_risk:     contaminationRisk,
              severity:               severity,
              require_public_notice:  requirePublicNotice,
              status:                 &quot;open&quot;,
              reported_at:            reportedAt,
              created_at:             string(now()),
              owner_did:              callerDid,
              sensitivity_ord:        1,
              org_id:                 utilityOrgId,
              user_id:                callerDid,
              actor_id:               &quot;sys.bpmn.open-water&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Save</bpmn:incoming>
      <bpmn:outgoing>Flow_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Gate" sourceRef="Task_SaveLeak" targetRef="Gate_Notice"/>

    <bpmn:exclusiveGateway id="Gate_Notice" name="公衆周知必要?" default="Flow_Silent">
      <bpmn:incoming>Flow_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Notice</bpmn:outgoing>
      <bpmn:outgoing>Flow_Silent</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Notice" sourceRef="Gate_Notice" targetRef="Task_PublicNotice">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=requirePublicNotice = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Silent" sourceRef="Gate_Notice" targetRef="Task_AuditSilent"/>

    <bpmn:serviceTask id="Task_PublicNotice" name="公衆周知 post (app.bsky.feed.post)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;app.bsky.feed.post&quot;" target="type"/>
          <zeebe:input source="={
              text: &quot;[open-water] 漏水公衆周知: main=&quot; + string(mainVertexId)
                    + &quot; severity=&quot; + string(severity)
                    + &quot; flow=&quot; + string(estimatedFlowLpm) + &quot; l/min&quot;
                    + &quot; contamination=&quot; + string(contaminationRisk),
              createdAt: string(now())
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Notice</bpmn:incoming>
      <bpmn:outgoing>Flow_AuditMajor</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AuditMajor" sourceRef="Task_PublicNotice" targetRef="Task_AuditMajor"/>

    <bpmn:serviceTask id="Task_AuditMajor" name="audit leak.major">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-water.etzhayyim.com:network&quot;" target="actor"/>
          <zeebe:input source="=&quot;openWater.leak.publicNotice&quot;" target="action"/>
          <zeebe:input source="={
              vertexId:     vertexId,
              mainVertexId: mainVertexId,
              severity:     severity
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AuditMajor</bpmn:incoming>
      <bpmn:outgoing>Flow_EndMajor</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndMajor" sourceRef="Task_AuditMajor" targetRef="End_Notified"/>

    <bpmn:serviceTask id="Task_AuditSilent" name="audit leak.log">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-water.etzhayyim.com:network&quot;" target="actor"/>
          <zeebe:input source="=&quot;openWater.leak.log&quot;" target="action"/>
          <zeebe:input source="={
              vertexId:     vertexId,
              mainVertexId: mainVertexId,
              severity:     severity
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Silent</bpmn:incoming>
      <bpmn:outgoing>Flow_EndLogged</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndLogged" sourceRef="Task_AuditSilent" targetRef="End_Logged"/>

    <bpmn:endEvent id="End_Logged" name="記録">
      <bpmn:incoming>Flow_EndLogged</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Notified" name="周知">
      <bpmn:incoming>Flow_EndMajor</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
