<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_sales_qualify_lead" targetNamespace="https://etzhayyim.ai/bpmn/open-sales" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_sales_qualify_lead" name="qualifyLead" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_LLM"/>
    <bpmn:serviceTask id="Task_LLM" name="LLM qualify">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.json"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;Qualify this sales lead. Company: &quot; + company + &quot;. Email: &quot; + email + &quot;. Source: &quot; + source + &quot;. Return JSON {lead_score: 0-100, qualification: hot|warm|cold, rationale: string}&quot;" target="user"/>
          <zeebe:input source="=&quot;Output ONE JSON object. No preamble, no commentary, no code fences.&quot;" target="system"/>
          <zeebe:input source="=&quot;classifier&quot;" target="tier"/>
          <zeebe:output source="=result.data.lead_score" target="leadScore"/>
          <zeebe:output source="=result.data.qualification" target="qualification"/>
          <zeebe:output source="=result.data.rationale" target="rationale"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_B</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_B" sourceRef="Task_LLM" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="update lead status">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_sales_lead&quot;" target="table"/>
          <zeebe:input source="={vertex_id: vertexId, lead_id: leadId, full_name: fullName, email: email, company: company, source: source, lead_score: leadScore, status: &quot;qualified&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, actor_id: &quot;sys.bpmn.open-sales&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-sales.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;open.sales.qualifyLead&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, leadId: leadId, leadScore: leadScore, qualification: qualification}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
