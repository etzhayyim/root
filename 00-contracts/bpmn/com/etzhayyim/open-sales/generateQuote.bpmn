<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_sales_generate_quote" targetNamespace="https://etzhayyim.ai/bpmn/open-sales" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_sales_generate_quote" name="generateQuote" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_LLM"/>
    <bpmn:serviceTask id="Task_LLM" name="LLM generate quote summary">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.json"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;Generate a sales quote summary for opportunity. Title: &quot; + oppTitle + &quot;. Amount: $&quot; + string(amountUsd) + &quot;. Include key value propositions and terms. Return JSON {summary: string, key_terms: [string]}&quot;" target="user"/>
          <zeebe:input source="=&quot;Output ONE JSON object. No preamble, no commentary, no code fences.&quot;" target="system"/>
          <zeebe:input source="=&quot;classifier&quot;" target="tier"/>
          <zeebe:output source="=result.data.summary" target="llmSummary"/>
          <zeebe:output source="=result.data.key_terms" target="keyTerms"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_B</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_B" sourceRef="Task_LLM" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save quote">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_sales_quote&quot;" target="table"/>
          <zeebe:input source="={vertex_id: vertexId, quote_id: quoteId, opp_did: oppDid, total_usd: amountUsd, currency: currency, valid_until: validUntil, status: &quot;draft&quot;, line_items_json: lineItemsJson, llm_summary: llmSummary, created_at: string(now()), sensitivity_ord: 1, org_id: callerDid, actor_id: &quot;sys.bpmn.open-sales&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-sales.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;open.sales.generateQuote&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, quoteId: quoteId, oppDid: oppDid, totalUsd: amountUsd}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
