<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_sales_compute_forecast" targetNamespace="https://etzhayyim.ai/bpmn/open-sales" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_sales_compute_forecast" name="computeForecast" isExecutable="true">
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_S</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P7D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Select"/>
    <bpmn:serviceTask id="Task_Select" name="read pipeline health">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT stage, opp_count, total_pipeline_usd, avg_probability_pct, weighted_usd FROM mv_open_sales_pipeline_health&quot;" target="query"/>
          <zeebe:input source="=[]" target="params"/>
          <zeebe:output source="=rows" target="pipelineRows"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_B</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_B" sourceRef="Task_Select" targetRef="Task_LLM"/>
    <bpmn:serviceTask id="Task_LLM" name="LLM compute forecast">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.json"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;Compute a sales forecast based on pipeline data: &quot; + string(pipelineRows) + &quot;. Return JSON {forecast_usd: number, confidence_pct: number, notes: string}&quot;" target="user"/>
          <zeebe:input source="=&quot;Output ONE JSON object. No preamble, no commentary, no code fences.&quot;" target="system"/>
          <zeebe:input source="=&quot;classifier&quot;" target="tier"/>
          <zeebe:output source="=result.data.forecast_usd" target="aiForecastUsd"/>
          <zeebe:output source="=result.data.confidence_pct" target="confidencePct"/>
          <zeebe:output source="=result.data.notes" target="forecastNotes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B</bpmn:incoming><bpmn:outgoing>Flow_C</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_C" sourceRef="Task_LLM" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save forecast">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_sales_forecast&quot;" target="table"/>
          <zeebe:input source="={vertex_id: &quot;at://did:web:open-sales.etzhayyim.com/com.etzhayyim.apps.openSales.forecast/&quot; + string(now()), forecast_id: string(now()), period: string(now()), pipeline_usd: 0.0, weighted_usd: 0.0, closed_usd: 0.0, ai_forecast_usd: aiForecastUsd, confidence_pct: confidencePct, notes: forecastNotes, created_at: string(now()), sensitivity_ord: 0, actor_id: &quot;sys.bpmn.open-sales&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_C</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Save" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
