<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_sales_close_deal" targetNamespace="https://etzhayyim.ai/bpmn/open-sales" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_sales_close_deal" name="closeDeal" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="close opportunity">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_sales_opportunity&quot;" target="table"/>
          <zeebe:input source="={vertex_id: vertexId, opp_id: oppId, title: title, stage: if outcome = &quot;won&quot; then &quot;closed_won&quot; else &quot;closed_lost&quot;, status: outcome, lost_reason: lostReason, amount_usd: amountUsd, probability_pct: if outcome = &quot;won&quot; then 100.0 else 0.0, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, actor_id: &quot;sys.bpmn.open-sales&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-sales.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;open.sales.closeDeal&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, oppId: oppId, outcome: outcome, lostReason: lostReason}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
