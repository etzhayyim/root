<?xml version="1.0" encoding="UTF-8"?>
<!--
  Bluesky ingestActor — manual one-shot ingest via Zeebe/Python.

  NSID: com.etzhayyim.apps.bluesky.ingestActor
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/bluesky-ingest-actor-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_bluesky_ingest_actor"
    targetNamespace="https://etzhayyim.ai/bpmn/bluesky"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="bluesky_ingest_actor" name="bluesky ingest actor" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.bluesky.ingestActor", "version": 1, "resultTimeoutMs": 120000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="manual">
      <bpmn:outgoing>Flow_ToIngest</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToIngest" sourceRef="Start" targetRef="Task_Ingest"/>

    <bpmn:serviceTask id="Task_Ingest" name="ingest public actor">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bluesky.ingest.actor"/>
        <zeebe:ioMapping>
          <zeebe:input source="=actor" target="actor"/>
          <zeebe:input source="=if appview = null then &quot;https://public.api.bsky.app&quot; else appview" target="appview"/>
          <zeebe:input source="=if nanoid = null then &quot;bsky1ngs&quot; else nanoid" target="nanoid"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=actor" target="actorDid"/>
          <zeebe:output source="=handle" target="handle"/>
          <zeebe:output source="=ingested" target="ingested"/>
          <zeebe:output source="=tombstoned" target="tombstoned"/>
          <zeebe:output source="=skippedOptOut" target="skippedOptOut"/>
          <zeebe:output source="=skippedForbidden" target="skippedForbidden"/>
          <zeebe:output source="=error" target="error"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToIngest</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Ingest" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
