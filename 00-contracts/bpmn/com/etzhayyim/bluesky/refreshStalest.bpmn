<?xml version="1.0" encoding="UTF-8"?>
<!--
  Bluesky refreshStalest — BPMN timer replacement for CF Worker cron.

  NSID: com.etzhayyim.apps.bluesky.refreshStalest
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/bluesky-refresh-stalest-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_bluesky_refresh_stalest"
    targetNamespace="https://etzhayyim.ai/bpmn/bluesky"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="bluesky_refresh_stalest" name="bluesky refresh stalest actors (R/PT30M)" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.bluesky.refreshStalest", "version": 1, "resultTimeoutMs": 300000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="every 30 minutes">
      <bpmn:outgoing>Flow_ToRefresh</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_30m">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT30M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToRefresh" sourceRef="Start" targetRef="Task_Refresh"/>

    <bpmn:serviceTask id="Task_Refresh" name="refresh stalest tracked actors">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bluesky.ingest.refreshStalest"/>
        <zeebe:ioMapping>
          <zeebe:input source="=if batchSize = null then 10 else batchSize" target="batchSize"/>
          <zeebe:input source="=if appview = null then &quot;https://public.api.bsky.app&quot; else appview" target="appview"/>
          <zeebe:input source="=if nanoid = null then &quot;bsky1ngs&quot; else nanoid" target="nanoid"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=actorsRead" target="actorsRead"/>
          <zeebe:output source="=ingested" target="ingested"/>
          <zeebe:output source="=tombstoned" target="tombstoned"/>
          <zeebe:output source="=errorCount" target="errorCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRefresh</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Refresh" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="emit bluesky.refresh audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.bluesky.refreshStalest&quot;" target="activity"/>
          <zeebe:input source="=&quot;bluesky.etzhayyim.com&quot;" target="actorDid"/>
          <zeebe:input source="=actorsRead" target="actorsRead"/>
          <zeebe:input source="=ingested" target="ingested"/>
          <zeebe:input source="=tombstoned" target="tombstoned"/>
          <zeebe:input source="=errorCount" target="errorCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
