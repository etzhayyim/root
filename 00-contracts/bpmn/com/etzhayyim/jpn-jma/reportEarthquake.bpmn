<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_jpn_jma_report_earthquake"
    targetNamespace="https://etzhayyim.ai/bpmn/jpn-jma"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="jpn_jma_report_earthquake" name="JMA 地震情報" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Classify"/>
    <bpmn:serviceTask id="Task_Classify" name="分類">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT 1 AS ok LIMIT 1&quot;" target="query"/>
          <zeebe:input source="=[]" target="params"/>
          <zeebe:output source="=if magnitude &gt;= 7 or list contains([&quot;6+&quot;,&quot;7&quot;], maxIntensity) or tsunamiPossibility = &quot;major&quot; then &quot;severe&quot;
                                else if magnitude &gt;= 5.5 or list contains([&quot;5-&quot;,&quot;5+&quot;,&quot;6-&quot;], maxIntensity) then &quot;strong&quot;
                                else if magnitude &gt;= 4 then &quot;moderate&quot;
                                else &quot;weak&quot;" target="severity"/>
          <zeebe:output source="=magnitude &gt;= 5.5 or list contains([&quot;5-&quot;,&quot;5+&quot;,&quot;6-&quot;,&quot;6+&quot;,&quot;7&quot;], maxIntensity) or tsunamiPossibility != &quot;none&quot;" target="requireEmergencyNotice"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_Save</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Save" sourceRef="Task_Classify" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="earthquake 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_jpn_jma_earthquake&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id: vertexId, event_id: eventId, origin_time: originTime,
              epicenter_lat: epicenterLat, epicenter_lon: epicenterLon,
              magnitude: magnitude, depth_km: depthKm,
              max_intensity: maxIntensity, tsunami_possibility: tsunamiPossibility,
              severity: severity, require_emergency_notice: requireEmergencyNotice,
              status: &quot;published&quot;, created_at: string(now()),
              owner_did: callerDid, sensitivity_ord: 1,
              org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.jpn-jma&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Save</bpmn:incoming><bpmn:outgoing>Flow_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Gate" sourceRef="Task_Save" targetRef="Gate"/>
    <bpmn:exclusiveGateway id="Gate" default="Flow_Log">
      <bpmn:incoming>Flow_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Major</bpmn:outgoing>
      <bpmn:outgoing>Flow_Log</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Major" sourceRef="Gate" targetRef="Task_AuditMajor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=requireEmergencyNotice = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Log" sourceRef="Gate" targetRef="Task_AuditLog"/>
    <bpmn:serviceTask id="Task_AuditMajor" name="audit jpnJma.earthquake.emergency">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:jpn-jma.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;jpnJma.earthquake.emergency&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, eventId: eventId, magnitude: magnitude, maxIntensity: maxIntensity, severity: severity, tsunamiPossibility: tsunamiPossibility}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Major</bpmn:incoming><bpmn:outgoing>Flow_EM</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EM" sourceRef="Task_AuditMajor" targetRef="End_M"/>
    <bpmn:serviceTask id="Task_AuditLog" name="audit jpnJma.earthquake.routine">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:jpn-jma.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;jpnJma.earthquake.routine&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, eventId: eventId, magnitude: magnitude, maxIntensity: maxIntensity, severity: severity, tsunamiPossibility: tsunamiPossibility}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Log</bpmn:incoming><bpmn:outgoing>Flow_EL</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EL" sourceRef="Task_AuditLog" targetRef="End_L"/>
    <bpmn:endEvent id="End_L"><bpmn:incoming>Flow_EL</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_M"><bpmn:incoming>Flow_EM</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
