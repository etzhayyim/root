<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_onion_crawl_seeds"
    targetNamespace="https://etzhayyim.ai/bpmn/onion"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="onion_crawl_seeds" name="onion crawl seeds" isExecutable="true">
    <bpmn:startEvent id="Start_Timer" name="every six hours">
      <bpmn:outgoing>Flow_Queue_Timer</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle>R/PT6H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Manual" name="manual / on-demand">
      <bpmn:outgoing>Flow_Queue_Manual</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Queue_Timer" sourceRef="Start_Timer" targetRef="Task_QueueSeeds"/>
    <bpmn:sequenceFlow id="Flow_Queue_Manual" sourceRef="Start_Manual" targetRef="Task_QueueSeeds"/>

    <bpmn:serviceTask id="Task_QueueSeeds" name="queue onion crawl seeds">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="onion.crawl.queueSeeds"/>
        <zeebe:ioMapping>
          <zeebe:input source="=if seeds = null then [] else seeds" target="seeds"/>
          <zeebe:input source="=if category = null then &quot;&quot; else category" target="category"/>
          <zeebe:input source="=if limit = null then 10 else limit" target="limit"/>
          <zeebe:output source="=queued" target="queuedSeeds"/>
          <zeebe:output source="=skipped" target="skippedSeeds"/>
          <zeebe:output source="=runs" target="claimedRuns"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Queue_Timer</bpmn:incoming>
      <bpmn:incoming>Flow_Queue_Manual</bpmn:incoming>
      <bpmn:outgoing>Flow_Process</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Process" sourceRef="Task_QueueSeeds" targetRef="Task_ProcessQueue"/>

    <bpmn:serviceTask id="Task_ProcessQueue" name="process onion crawl queue">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="onion.crawl.processQueue"/>
        <zeebe:ioMapping>
          <zeebe:input source="=claimedRuns" target="runs"/>
          <zeebe:input source="=if timeoutSec = null then 45 else timeoutSec" target="timeoutSec"/>
          <zeebe:output source="=processed" target="processedRuns"/>
          <zeebe:output source="=completed" target="completedRuns"/>
          <zeebe:output source="=failed" target="failedRuns"/>
          <zeebe:output source="=pagesWritten" target="pagesWritten"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Process</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_ProcessQueue" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit onion crawl">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:onion.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;onion.crawl.seeds&quot;" target="action"/>
          <zeebe:input source="={queuedSeeds: queuedSeeds, skippedSeeds: skippedSeeds, processedRuns: processedRuns, completedRuns: completedRuns, failedRuns: failedRuns, pagesWritten: pagesWritten}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="completed">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
