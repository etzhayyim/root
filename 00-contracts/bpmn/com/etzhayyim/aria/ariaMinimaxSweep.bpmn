<?xml version="1.0" encoding="UTF-8"?>
<!--
  aria.minimaxSweep — ADR-2604291800 §minimax

  Timer-start (R/PT5M): runs every 5 minutes.
  Von Neumann minimax sweep over 6-dimensional ARIA signal space.
  Computes A_info = Σ w_k × η_k and selects argmin-regret action.

  NSID: com.etzhayyim.apps.aria.minimaxSweep (BPMN dispatcher T2 tier)
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/aria-minimax-sweep-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_aria_minimax_sweep"
    targetNamespace="https://etzhayyim.ai/bpmn/aria"
    exporter="hand-written"
    exporterVersion="2.0">

  <bpmn:process id="aria_minimax_sweep" name="ARIA Minimax Sweep" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.aria.minimaxSweep", "version": 1, "tier": "T2" }
    </bpmn:documentation>

    <!-- R/PT5M: fires every 5 minutes indefinitely -->
    <bpmn:startEvent id="Start_Timer" name="R/PT5M">
      <bpmn:outgoing>Flow_ToSweep</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT5M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToSweep" sourceRef="Start_Timer" targetRef="Task_Sweep"/>

    <!-- Run minimax sweep over 6-dim ARIA signal space (batch 3) -->
    <bpmn:serviceTask id="Task_Sweep" name="ARIA minimax sweep (batch 3)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="aria.minimax.sweep"/>
        <zeebe:ioMapping>
          <zeebe:input  source="=3"               target="batch_size"/>
          <zeebe:output source="=a_info"          target="aInfo"/>
          <zeebe:output source="=eta_global"      target="etaGlobal"/>
          <zeebe:output source="=minimax_action"  target="minimaxAction"/>
          <zeebe:output source="=regret"          target="regret"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSweep</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Sweep" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
