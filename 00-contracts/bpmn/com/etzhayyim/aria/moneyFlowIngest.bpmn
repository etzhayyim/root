<?xml version="1.0" encoding="UTF-8"?>
<!--
  aria.moneyFlowIngest — ADR-2604291800 §ARIA

  Timer-start (R/P1D): runs once per day.
  Fetches on-chain + payment flow signals (blockchain.info stats).

  NSID: com.etzhayyim.apps.aria.moneyFlowIngest (BPMN dispatcher T2 tier)
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/aria-money-flow-ingest-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_aria_money_flow_ingest"
    targetNamespace="https://etzhayyim.ai/bpmn/aria"
    exporter="hand-written"
    exporterVersion="2.0">

  <bpmn:process id="aria_money_flow_ingest" name="ARIA Money Flow Ingest" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.aria.moneyFlowIngest", "version": 1, "tier": "T2" }
    </bpmn:documentation>

    <!-- R/P1D: fires once per day indefinitely -->
    <bpmn:startEvent id="Start_Timer" name="R/P1D">
      <bpmn:outgoing>Flow_ToIngest</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToIngest" sourceRef="Start_Timer" targetRef="Task_Ingest"/>

    <!-- Fetch on-chain + payment flow signals from blockchain.info stats -->
    <bpmn:serviceTask id="Task_Ingest" name="Money flow ingest">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="aria.money.flow.ingest"/>
        <zeebe:ioMapping>
          <zeebe:input  source="=1"           target="lookback_days"/>
          <zeebe:output source="=volume_usd"  target="tradeVolumeUsd"/>
          <zeebe:output source="=eta"         target="moneyEta"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToIngest</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Ingest" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
