<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_carrier_esg_green_bunker" targetNamespace="https://etzhayyim.ai/bpmn/open-carrier-esg" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_carrier_esg_green_bunker" name="Green bunker" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="bunker">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_carrier_esg_green_bunker&quot;" target="table"/>
          <zeebe:input source="={vertex_id: vertexId, report_id: reportId, carrier_code: carrierCode, period_quarter: periodQuarter, total_bunker_tonnes: totalBunkerTonnes, lng_share_pct: lngSharePct, methanol_share_pct: methanolSharePct, biofuel_share_pct: biofuelSharePct, green_share_total_pct: greenShareTotalPct, transition_tier: if greenShareTotalPct &gt;= 30 then &quot;leader&quot; else if greenShareTotalPct &gt;= 10 then &quot;adopter&quot; else if greenShareTotalPct &gt;= 2 then &quot;slow-adopter&quot; else &quot;laggard&quot;, reported_at: reportedAt, status: &quot;published&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-carrier-esg&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-carrier-esg.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openCarrierEsg.greenBunker.record&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, carrierCode: carrierCode, greenShareTotalPct: greenShareTotalPct}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
