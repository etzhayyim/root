<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_fisheries_iuu_flag_vessel" targetNamespace="https://etzhayyim.ai/bpmn/open-fisheries-iuu" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_fisheries_iuu_flag_vessel" name="flagVessel" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_fisheries_iuu&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, flag_id: flagId, imo: imo, vessel_name: vesselName, flag_state_iso3: flagStateIso3, rfmo: rfmo, violation_code: violationCode, forced_labor_vid: forcedLaborVid, carrier_fleet_vid: carrierFleetVid, listed_at: listedAt, severity_tier: if violationCode = &quot;human_trafficking&quot; or violationCode = &quot;illegal_gear&quot; then &quot;critical&quot; else if violationCode = &quot;unauthorized&quot; or violationCode = &quot;closed_area&quot; then &quot;severe&quot; else &quot;major&quot;, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-fisheries-iuu&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-fisheries-iuu.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;open.fisheriesIuu.flagVessel&quot;" target="action"/><zeebe:input source="={vertexId: vertexId}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>