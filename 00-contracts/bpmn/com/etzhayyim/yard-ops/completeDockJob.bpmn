<?xml version="1.0" encoding="UTF-8"?>
<!--
  Complete a dock job and gate-out the trailer.

  Inputs:
    requestId
    dockJobVertexId
    actualDurationMin
    exceptions (optional list)

  Outputs:
    completionVertexId
    auditRkey
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_yard_ops_complete_dock_job"
    targetNamespace="https://etzhayyim.ai/bpmn/yard-ops"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="yard_ops_complete_dock_job" name="Yard dock-job completion" isExecutable="true">
    <bpmn:startEvent id="Start" name="Dock job completion">
      <bpmn:outgoing>Flow_Start_Persist</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_Persist" sourceRef="Start" targetRef="Task_Persist"/>

    <bpmn:serviceTask id="Task_Persist" name="Persist completion vertex">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="yardOps.dockJob.complete"/>
        <zeebe:ioMapping>
          <zeebe:input source="=dockJobVertexId" target="dockJobVertexId"/>
          <zeebe:input source="=actualDurationMin" target="actualDurationMin"/>
          <zeebe:input source="=exceptions" target="exceptions"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Persist</bpmn:incoming>
      <bpmn:outgoing>Flow_Persist_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Persist_Audit" sourceRef="Task_Persist" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="Emit dock-job completion audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:yard-ops.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;yardOps.dockJob.completed&quot;" target="action"/>
          <zeebe:input source="={ requestId: requestId, completionVertexId: completionVertexId, durationMin: actualDurationMin }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Persist_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="Dock job complete">
      <bpmn:incoming>Flow_Audit_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
