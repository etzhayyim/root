<?xml version="1.0" encoding="UTF-8"?>
<!--
  sbom.etzhayyim.com — cveIngestOsv (Phase C feeder).

  Pull open-source vulnerabilities from osv.dev → vertex_cve_entry.
  XRPC-triggered for ad-hoc refresh; timer-start variant lives in
  cveIngestOsvDaily.bpmn (R/PT24H).
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_sbom_cve_ingest_osv"
    targetNamespace="https://etzhayyim.ai/bpmn/sbom"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="sbom_cve_ingest_osv" name="sbom cveIngest OSV" isExecutable="true">

    <bpmn:startEvent id="StartManual" name="xrpc">
      <bpmn:outgoing>Flow_Ingest</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Ingest" name="ingest OSV">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="xrpc.com.etzhayyim.apps.sbom.cveIngestOsv"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ingest</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Ingest" sourceRef="StartManual" targetRef="Task_Ingest"/>

    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:sb0m001x.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;sbom.cveIngestOsv&quot;" target="action"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_Ingest" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
