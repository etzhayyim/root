<?xml version="1.0" encoding="UTF-8"?>
<!--
  sbom.etzhayyim.com — recall (Phase D blast-radius query).
  Single task: kotodama runs the supplier-scoped JOIN over
  vertex_sbom_component × vertex_sbom_artifact + vuln_match counts,
  returns the affected artifact list. Audit emit closes the trace.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_sbom_recall"
    targetNamespace="https://etzhayyim.ai/bpmn/sbom"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="sbom_recall" name="sbom recall (blast-radius)" isExecutable="true">

    <bpmn:startEvent id="StartManual" name="xrpc">
      <bpmn:outgoing>Flow_Run</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Run" name="run blast-radius query">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="xrpc.com.etzhayyim.apps.sbom.recall"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Run</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Run" sourceRef="StartManual" targetRef="Task_Run"/>

    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:sb0m001x.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;sbom.recall&quot;" target="action"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_Run" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
