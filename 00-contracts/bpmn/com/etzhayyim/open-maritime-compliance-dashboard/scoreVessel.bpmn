<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_maritime_compliance_dashboard_score_vessel" targetNamespace="https://etzhayyim.ai/bpmn/open-maritime-compliance-dashboard" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_maritime_compliance_dashboard_score_vessel" name="scoreVessel" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_maritime_compliance_dashboard&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, score_id: scoreId, imo: imo, psc_detention_count: pscDetentionCount, welfare_breach_count: welfareBreachCount, forced_labor_flag_count: forcedLaborFlagCount, bwm_cert_valid: bwmCertValid, cursor_month: cursorMonth, compliance_tier: if forcedLaborFlagCount != null and forcedLaborFlagCount &gt;= 1 then &quot;sanction_risk&quot; else if pscDetentionCount != null and pscDetentionCount &gt;= 2 then &quot;watchlist&quot; else if welfareBreachCount != null and welfareBreachCount &gt;= 1 then &quot;monitoring&quot; else &quot;clear&quot;, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-maritime-compliance-dashboard&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-maritime-compliance-dashboard.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;open.maritimeComplianceDashboard.scoreVessel&quot;" target="action"/><zeebe:input source="={vertexId: vertexId}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>