<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_rail_report_incident"
    targetNamespace="https://etzhayyim.ai/bpmn/open-rail"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_rail_report_incident" name="鉄道事故 報告" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Classify"/>

    <!--
      major   : category in {derailment, collision, fatality} OR delayMinutes >= 60
      moderate: delayMinutes in [15, 59] OR category = signal-failure
      minor   : otherwise
    -->
    <bpmn:serviceTask id="Task_Classify" name="severity 分類">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT 1 AS ok LIMIT 1&quot;" target="query"/>
          <zeebe:input source="=[]" target="params"/>
          <zeebe:output source="=if list contains([&quot;derailment&quot;,&quot;collision&quot;,&quot;fatality&quot;], category) or delayMinutes &gt;= 60 then &quot;major&quot;
                                else if delayMinutes &gt;= 15 or category = &quot;signal-failure&quot; then &quot;moderate&quot;
                                else &quot;minor&quot;" target="severity"/>
          <zeebe:output source="=list contains([&quot;derailment&quot;,&quot;collision&quot;,&quot;fatality&quot;], category) or delayMinutes &gt;= 60" target="requirePublicNotice"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_Save</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Save" sourceRef="Task_Classify" targetRef="Task_Save"/>

    <bpmn:serviceTask id="Task_Save" name="incident 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_rail_incident&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id: vertexId, operator_org_id: operatorOrgId,
              line_vid: lineVid, run_vid: runVid,
              category: category, narrative: narrative, delay_minutes: delayMinutes,
              severity: severity, require_public_notice: requirePublicNotice,
              status: &quot;open&quot;, reported_at: reportedAt, created_at: string(now()),
              owner_did: callerDid, sensitivity_ord: 1,
              org_id: operatorOrgId, user_id: callerDid, actor_id: &quot;sys.bpmn.open-rail&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Save</bpmn:incoming><bpmn:outgoing>Flow_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Gate" sourceRef="Task_Save" targetRef="Gate"/>

    <bpmn:exclusiveGateway id="Gate" default="Flow_Silent">
      <bpmn:incoming>Flow_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Notice</bpmn:outgoing>
      <bpmn:outgoing>Flow_Silent</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Notice" sourceRef="Gate" targetRef="Task_AuditMajor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=requirePublicNotice = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Silent" sourceRef="Gate" targetRef="Task_AuditSilent"/>

    <bpmn:serviceTask id="Task_AuditMajor" name="audit incident.major">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-rail.etzhayyim.com:ops&quot;" target="actor"/>
          <zeebe:input source="=&quot;openRail.incident.major&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, severity: severity, lineVid: lineVid, category: category}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Notice</bpmn:incoming><bpmn:outgoing>Flow_EM</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EM" sourceRef="Task_AuditMajor" targetRef="End_M"/>

    <bpmn:serviceTask id="Task_AuditSilent" name="audit incident.log">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-rail.etzhayyim.com:ops&quot;" target="actor"/>
          <zeebe:input source="=&quot;openRail.incident.log&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, severity: severity, lineVid: lineVid, category: category}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Silent</bpmn:incoming><bpmn:outgoing>Flow_ES</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ES" sourceRef="Task_AuditSilent" targetRef="End_S"/>

    <bpmn:endEvent id="End_S"><bpmn:incoming>Flow_ES</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_M"><bpmn:incoming>Flow_EM</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
