<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_market_list_offer" targetNamespace="https://etzhayyim.ai/bpmn/market">
  <bpmn:process id="market_list_offer" name="market.listOffer" isExecutable="true">
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_Start_Task</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_Task" sourceRef="Start" targetRef="Task_listOffer" />
    <bpmn:serviceTask id="Task_listOffer" name="market.listOffer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="xrpc.com.etzhayyim.market.listOffer" retries="2" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Task</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Task_End" sourceRef="Task_listOffer" targetRef="End" />
    <bpmn:endEvent id="End">
      <bpmn:incoming>Flow_Task_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
