<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stage 5 / 12 — 原画 (keyframe). ADR-2604231328.
  in:  cutId, layoutUri (approved), frameNum, poseDescription, characterRefCid
  out: keyframeVertexId, blobCid
  Caller fanouts per key pose (N keyframes per cut).
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_animeka_generate_keyframe"
    targetNamespace="https://etzhayyim.ai/bpmn/animeka"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="animeka_generate_keyframe" name="animeka generate keyframe" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Render"/>
    <bpmn:serviceTask id="Task_Render" name="render keyframe (ControlNet+IPAdapter)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.comfyui.call"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;/v1/images/generations&quot;" target="route"/>
          <zeebe:input source="={
              model: &quot;animagine-xl-4&quot;,
              prompt: string(poseDescription) + &quot;, anime keyframe, clean lineart, flat cel shading, production quality&quot;,
              negative_prompt: &quot;blurry, low quality, extra limbs, text, watermark&quot;,
              size: &quot;1024x1024&quot;,
              steps: 30,
              cfg_scale: 6.5,
              controlnet: { model: &quot;controlnet-openpose-sdxl&quot;, layout_ref: string(layoutUri) },
              ip_adapter: { model: &quot;ip-adapter-plus-face-sdxl&quot;, character_ref: string(characterRefCid), weight: 0.75 },
              n: 1
          }" target="body"/>
          <zeebe:input source="=&quot;binary&quot;" target="outputFormat"/>
          <zeebe:input source="=240" target="timeoutSec"/>
          <zeebe:output source="=blobCid" target="blobCid"/>
          <zeebe:output source="=latencyMs" target="renderMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Render" targetRef="Task_Insert"/>
    <bpmn:serviceTask id="Task_Insert" name="persist keyframe">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_animeka&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:   &quot;at://did:web:animeka.etzhayyim.com/com.etzhayyim.apps.animeka.keyframe/&quot; + string(cutId) + &quot;-f&quot; + string(frameNum),
              owner_did:   &quot;did:web:animeka.etzhayyim.com&quot;,
              repo:        &quot;did:web:animeka.etzhayyim.com&quot;,
              collection:  &quot;com.etzhayyim.apps.animeka.keyframe&quot;,
              rkey:        string(cutId) + &quot;-f&quot; + string(frameNum),
              kind:        &quot;keyframe&quot;,
              cut_id:      string(cutId),
              frame_num:   frameNum,
              stage:       &quot;keyAnim&quot;,
              method:      &quot;aiDraft&quot;,
              priority:    &quot;draft&quot;,
              description: string(poseDescription),
              image_cid:    string(blobCid),
              sensitivity_ord: 10}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
          <zeebe:output source="=inserted" target="inserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Insert" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:animeka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;generateKeyframe&quot;" target="action"/>
          <zeebe:input source="={cutId: string(cutId), frameNum: frameNum, blobCid: string(blobCid), renderMs: renderMs}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>F4</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
