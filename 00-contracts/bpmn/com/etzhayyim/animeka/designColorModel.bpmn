<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stage 7 / 12 — 色彩設計. ADR-2604231328.
  in:  characterId, characterDescription, referenceCid
  out: colorModelVertexId, blobCid (color chart), paletteJson
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_animeka_design_color_model"
    targetNamespace="https://etzhayyim.ai/bpmn/animeka"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="animeka_design_color_model" name="animeka design color model" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Palette"/>
    <bpmn:serviceTask id="Task_Palette" name="palette plan (Claude deep)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.json"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;classifier&quot;" target="tier"/>
          <zeebe:input source="=&quot;You are an anime color designer. Output ONE JSON object {palette:[{part:string,normalHex:&apos;#rrggbb&apos;,shadowHex:&apos;#rrggbb&apos;,highlightHex:&apos;#rrggbb&apos;}],materialMap:{skin:string,hair:string,clothes:string,metal:string}}. JSON only.&quot;" target="system"/>
          <zeebe:input source="=&quot;Character: &quot; + string(characterDescription)" target="user"/>
          <zeebe:input source="=700" target="maxTokens"/>
          <zeebe:input source="=0.3" target="temperature"/>
          <zeebe:output source="=data" target="palette"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Palette" targetRef="Task_Render"/>
    <bpmn:serviceTask id="Task_Render" name="render color chart">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.comfyui.call"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;/v1/images/generations&quot;" target="route"/>
          <zeebe:input source="={
              model: &quot;animagine-xl-4&quot;,
              prompt: string(characterDescription) + &quot;, character color chart, front/side/back turnaround, anime model sheet, flat cel shading with clear shadow and highlight zones&quot;,
              negative_prompt: &quot;text, watermark, blurry, inconsistent colors&quot;,
              size: &quot;1024x1024&quot;,
              steps: 28,
              cfg_scale: 6.0,
              ip_adapter: { character_ref: string(referenceCid), weight: 0.8 },
              n: 1
          }" target="body"/>
          <zeebe:input source="=&quot;binary&quot;" target="outputFormat"/>
          <zeebe:input source="=180" target="timeoutSec"/>
          <zeebe:output source="=blobCid" target="blobCid"/>
          <zeebe:output source="=latencyMs" target="renderMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Render" targetRef="Task_Insert"/>
    <bpmn:serviceTask id="Task_Insert" name="persist colorModel">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_animeka&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:   &quot;at://did:web:animeka.etzhayyim.com/com.etzhayyim.apps.animeka.colorModel/&quot; + string(characterId),
              owner_did:   &quot;did:web:animeka.etzhayyim.com&quot;,
              repo:        &quot;did:web:animeka.etzhayyim.com&quot;,
              collection:  &quot;com.etzhayyim.apps.animeka.colorModel&quot;,
              rkey:        string(characterId),
              kind:        &quot;colorModel&quot;,
              character_id: string(characterId),
              stage:       &quot;colorDesign&quot;,
              method:      &quot;aiDesign&quot;,
              priority:    &quot;ready&quot;,
              description: string(palette),
              image_cid:    string(blobCid),
              sensitivity_ord: 10}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
          <zeebe:output source="=inserted" target="inserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Insert" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:animeka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;designColorModel&quot;" target="action"/>
          <zeebe:input source="={characterId: string(characterId), blobCid: string(blobCid)}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>F5</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
