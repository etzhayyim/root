<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stage 8 / 12 — 仕上げ / color trace. ADR-2604231328.
  in:  frameUri (keyframe or inbetween), colorModelUri, lightingCondition
  out: colorTraceVertexId, blobCid
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_animeka_auto_trace_cut"
    targetNamespace="https://etzhayyim.ai/bpmn/animeka"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="animeka_auto_trace_cut" name="animeka auto trace" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Trace"/>
    <bpmn:serviceTask id="Task_Trace" name="color trace (ControlNet-lineart + palette cond)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.comfyui.call"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;/v1/images/edits&quot;" target="route"/>
          <zeebe:input source="={
              model: &quot;animagine-xl-4&quot;,
              edit_mode: &quot;colorize&quot;,
              source_uri: string(frameUri),
              palette_ref: string(colorModelUri),
              controlnet: { model: &quot;controlnet-lineart-sdxl&quot;, weight: 1.0 },
              lighting: string(lightingCondition),
              steps: 24,
              cfg_scale: 5.5
          }" target="body"/>
          <zeebe:input source="=&quot;binary&quot;" target="outputFormat"/>
          <zeebe:input source="=180" target="timeoutSec"/>
          <zeebe:output source="=blobCid" target="blobCid"/>
          <zeebe:output source="=latencyMs" target="renderMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Trace" targetRef="Task_Insert"/>
    <bpmn:serviceTask id="Task_Insert" name="persist colorTrace">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_animeka&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:  &quot;at://did:web:animeka.etzhayyim.com/com.etzhayyim.apps.animeka.colorTrace/&quot; + string(frameUri),
              owner_did:  &quot;did:web:animeka.etzhayyim.com&quot;,
              repo:       &quot;did:web:animeka.etzhayyim.com&quot;,
              collection: &quot;com.etzhayyim.apps.animeka.colorTrace&quot;,
              rkey:       string(frameUri),
              kind:       &quot;colorTrace&quot;,
              target_uri: string(frameUri),
              stage:      &quot;finish&quot;,
              method:     &quot;aiAutoTrace&quot;,
              priority:   &quot;review&quot;,
              lighting_condition: string(lightingCondition),
              image_cid:    string(blobCid),
              sensitivity_ord: 10}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
          <zeebe:output source="=inserted" target="inserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Insert" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:animeka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;autoTrace&quot;" target="action"/>
          <zeebe:input source="={frameUri: string(frameUri), blobCid: string(blobCid)}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>F4</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
