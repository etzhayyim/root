<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stage 13 / Autopilot — engagement-driven production loop.
  ADR-2604231328 §6e (Phase Δ5).

  v27→v28 (2026-04-25): Task_FireCutRunner converted from
  `generic.http.fetch` (dispatcher round-trip + worker slot held
  for 50-200s) to native Zeebe `<bpmn:callActivity>` calling
  `animeka_cut_runner` directly. Eliminates the structural
  http.fetch saturation that was preventing compose from
  reaching PDS under sustained load.

  Flow:
    Start (timer R/PT15M or manual) → Task_GenScene
                                       llm.chat (deep tier, RunPod Qwen 14B)
                                       → fresh sceneText (~5s)
                                     → Task_RunCut (call activity)
                                       runs animeka_cut_runner inline as
                                       BPMN tokens (no worker slot for
                                       parent suspension). Returns
                                       postStatus from compose step.
                                     → Task_Audit
                                     → End
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_animeka_autopilot"
    targetNamespace="https://etzhayyim.ai/bpmn/animeka"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="animeka_autopilot" name="animeka autopilot" isExecutable="true">

    <bpmn:startEvent id="Start" name="every 15 min">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_15m">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">R/PT15M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="StartManual" name="manual trigger">
      <bpmn:outgoing>F1M</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="F1"  sourceRef="Start"       targetRef="Task_GenScene"/>
    <bpmn:sequenceFlow id="F1M" sourceRef="StartManual" targetRef="Task_GenScene"/>

    <bpmn:serviceTask id="Task_GenScene" name="generate scene description (LLM)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.chat"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;deep&quot;" target="tier"/>
          <zeebe:input source="=&quot;You are an anime scene writer. Output ONE atmospheric anime scene visual prompt in English, between 100 and 200 characters. Describe the mood, location, time of day, and the character's pose. The character is misaki, a Japanese high-school girl in navy blazer, dark long hair, gentle introspective expression. Vary the scene mood (calm / lonely / nostalgic / hopeful / autumn / spring / dusk / dawn / rain / starlit) so each call produces a fresh atmosphere. For Pony / WAI-REAL-CN style scenes prepend 'score_9, score_8_up, masterpiece' to the start of the prompt about 1 in 3 calls — for Animagine-XL style scenes (default) leave it bare. Plain English text only, no markdown, no quotes around the output.&quot;" target="system"/>
          <zeebe:input source="=&quot;Generate a fresh scene now.&quot;" target="user"/>
          <zeebe:input source="=400" target="maxTokens"/>
          <zeebe:input source="=0.85" target="temperature"/>
          <zeebe:output source="=content" target="sceneText"/>
          <zeebe:output source="=model" target="sceneModel"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F1M</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_GenScene" targetRef="Task_RunCut"/>

    <!--
      Native call activity: spawns animeka_cut_runner as a child token.
      Parent autopilot does NOT hold a worker slot during child execution.
      cutId = "auto-{now()}" with colons/dots stripped for path safety.
    -->
    <bpmn:callActivity id="Task_RunCut" name="run cut runner (call activity)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="animeka_cut_runner" propagateAllChildVariables="false"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;auto-&quot; + replace(replace(string(now()), &quot;:&quot;, &quot;-&quot;), &quot;\.&quot;, &quot;-&quot;)" target="cutId"/>
          <zeebe:input source="=string(sceneText)"                                                                                  target="cutSummary"/>
          <zeebe:input source="=&quot;misaki: high-school girl, navy blazer, dark long hair, introspective&quot;"                    target="characters"/>
          <zeebe:output source="=postStatus" target="cutPostStatus"/>
          <zeebe:output source="=string(sbCid)" target="sbCid"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_RunCut" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit autopilot tick">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:animeka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;autopilot&quot;" target="action"/>
          <zeebe:input source="={
              cutPostStatus: cutPostStatus,
              sceneModel: string(sceneModel),
              sceneTextLen: string length(string(sceneText))
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>F4</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
