<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stage 3 / 12 — storyboard candidate (絵コンテ 1 候補). ADR-2604231328.
  HITL gate: caller invokes 3 times (candidate=1,2,3), director picks 1.
  in:  cutId, cutSummary, candidateNum (1..3), characters
  out: storyboardVertexId, blobCid
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_animeka_generate_storyboard"
    targetNamespace="https://etzhayyim.ai/bpmn/animeka"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="animeka_generate_storyboard" name="animeka generate storyboard" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Describe"/>
    <bpmn:serviceTask id="Task_Describe" name="describe cut (Claude deep)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.chat"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;deep&quot;" target="tier"/>
          <zeebe:input source="=&quot;You are a storyboard artist. Describe a single storyboard panel for the given cut. Output a concise visual prompt (&lt;=150 words) in English suitable for Animagine XL: include framing, character pose, expression, camera angle, background element. No text overlay, no dialogue balloons.&quot;" target="system"/>
          <zeebe:input source="=&quot;Cut: &quot; + string(cutSummary) + &quot;\nCharacters: &quot; + string(characters) + &quot;\nCandidate variant: &quot; + string(candidateNum)" target="user"/>
          <zeebe:input source="=400" target="maxTokens"/>
          <zeebe:input source="=0.7" target="temperature"/>
          <zeebe:output source="=content" target="visualPrompt"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Describe" targetRef="Task_Render"/>
    <bpmn:serviceTask id="Task_Render" name="render storyboard thumb (L40S)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.comfyui.call"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;/v1/images/generations&quot;" target="route"/>
          <zeebe:input source="={
              model: &quot;animagine-xl-4&quot;,
              prompt: string(visualPrompt) + &quot;, storyboard sketch, monochrome pencil lineart, anime production keyframe&quot;,
              negative_prompt: &quot;color, photographic, text, watermark, signature&quot;,
              size: &quot;512x512&quot;,
              steps: 22,
              cfg_scale: 5.5,
              n: 1
          }" target="body"/>
          <zeebe:input source="=&quot;binary&quot;" target="outputFormat"/>
          <zeebe:input source="=120" target="timeoutSec"/>
          <zeebe:output source="=blobCid" target="blobCid"/>
          <zeebe:output source="=meta" target="blobMeta"/>
          <zeebe:output source="=latencyMs" target="renderMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Render" targetRef="Task_Insert"/>
    <bpmn:serviceTask id="Task_Insert" name="persist storyboard draft">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_animeka&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:  &quot;at://did:web:animeka.etzhayyim.com/com.etzhayyim.apps.animeka.storyboard/&quot; + string(cutId) + &quot;-c&quot; + string(candidateNum),
              owner_did:  &quot;did:web:animeka.etzhayyim.com&quot;,
              repo:       &quot;did:web:animeka.etzhayyim.com&quot;,
              collection: &quot;com.etzhayyim.apps.animeka.storyboard&quot;,
              rkey:       string(cutId) + &quot;-c&quot; + string(candidateNum),
              kind:       &quot;storyboard&quot;,
              cut_id:     string(cutId),
              stage:      &quot;storyboard&quot;,
              method:     &quot;aiDraft&quot;,
              priority:   &quot;draft&quot;,
              description: string(visualPrompt),
              image_cid:    string(blobCid),
              sensitivity_ord: 10}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
          <zeebe:output source="=inserted" target="inserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Insert" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:animeka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;generateStoryboard&quot;" target="action"/>
          <zeebe:input source="={cutId: string(cutId), candidateNum: candidateNum, blobCid: string(blobCid), renderMs: renderMs}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>F5</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
