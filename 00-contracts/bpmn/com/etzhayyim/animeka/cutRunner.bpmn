<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stage 14 / Cut Runner — atomic single-cut artifact pipeline.
  ADR-2604231328 §6e (Phase Δ5).

  v6 (2026-04-25): refactored from nested HTTP fan-out to native Zeebe
  call activity. Each child sub-process runs as a BPMN token inside the
  broker — workers no longer hold long-lived `generic.http.fetch` slots.

  v7 (2026-04-25): added storyboard retry + compose null-tolerance.
  Observed sbCid-null failure rate ~50-75% caused by pyzeebe gRPC
  channel-closed mid sub-process (watchdog restart kills worker
  before completion job propagates blobCid back). Two mitigations:

    1. After Task_Storyboard, Gateway_StoryboardCheck inspects sbCid;
       if null/empty, invoke Task_StoryboardRetry (candidateNum=2 so
       the persisted `vertex_animeka` row gets a distinct rkey).
       Continue to Task_Layout regardless of retry outcome.

    2. Task_Compose builds embed.images via FEEL `flatten()` over per-
       cid conditional sub-lists. A missing cid drops that slot from
       the embed instead of producing a malformed payload that PDS
       rejects with 500. Captions stay intact for whatever survived.

  in:  cutId, cutSummary, characters
  out: sbCid, lyCid, kfCid, bgCid, postStatus, postBody
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_animeka_cut_runner"
    targetNamespace="https://etzhayyim.ai/bpmn/animeka"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="animeka_cut_runner" name="animeka cut runner" isExecutable="true">

    <bpmn:startEvent id="Start"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Storyboard"/>

    <!-- ── Stage 3: storyboard (call activity) ── -->
    <bpmn:callActivity id="Task_Storyboard" name="generate storyboard">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="animeka_generate_storyboard" propagateAllChildVariables="false"/>
        <zeebe:ioMapping>
          <zeebe:input source="=string(cutId)"      target="cutId"/>
          <zeebe:input source="=string(cutSummary)" target="cutSummary"/>
          <zeebe:input source="=1"                  target="candidateNum"/>
          <zeebe:input source="=string(characters)" target="characters"/>
          <zeebe:output source="=blobCid"           target="sbCid"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Storyboard" targetRef="Gateway_StoryboardCheck"/>

    <!-- Storyboard null-check — retry once if sbCid did not propagate. -->
    <bpmn:exclusiveGateway id="Gateway_StoryboardCheck" name="sbCid present?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F2_ok</bpmn:outgoing>
      <bpmn:outgoing>F2_retry</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F2_ok" sourceRef="Gateway_StoryboardCheck" targetRef="Task_Layout">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=sbCid != null and string length(string(sbCid)) &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F2_retry" sourceRef="Gateway_StoryboardCheck" targetRef="Task_StoryboardRetry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=sbCid = null or string length(string(sbCid)) = 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:callActivity id="Task_StoryboardRetry" name="generate storyboard (retry)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="animeka_generate_storyboard" propagateAllChildVariables="false"/>
        <zeebe:ioMapping>
          <zeebe:input source="=string(cutId)"      target="cutId"/>
          <zeebe:input source="=string(cutSummary)" target="cutSummary"/>
          <zeebe:input source="=2"                  target="candidateNum"/>
          <zeebe:input source="=string(characters)" target="characters"/>
          <zeebe:output source="=blobCid"           target="sbCid"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F2_retry</bpmn:incoming><bpmn:outgoing>F2_retry_done</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="F2_retry_done" sourceRef="Task_StoryboardRetry" targetRef="Task_Layout"/>

    <!-- ── Stage 4: layout (call activity) ── -->
    <bpmn:callActivity id="Task_Layout" name="generate layout">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="animeka_generate_layout" propagateAllChildVariables="false"/>
        <zeebe:ioMapping>
          <zeebe:input source="=string(cutId)"                                                                                            target="cutId"/>
          <zeebe:input source="=&quot;at://did:web:animeka.etzhayyim.com/com.etzhayyim.apps.animeka.storyboard/&quot; + string(cutId) + &quot;-c1&quot;" target="storyboardUri"/>
          <zeebe:input source="=string(cutSummary)"                                                                                       target="cutSummary"/>
          <zeebe:output source="=blobCid"                                                                                                 target="lyCid"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F2_ok</bpmn:incoming>
      <bpmn:incoming>F2_retry_done</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Layout" targetRef="Task_Keyframe"/>

    <!-- ── Stage 5: keyframe (call activity) ── -->
    <bpmn:callActivity id="Task_Keyframe" name="generate keyframe">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="animeka_generate_keyframe" propagateAllChildVariables="false"/>
        <zeebe:ioMapping>
          <zeebe:input source="=string(cutId)"                                                                                       target="cutId"/>
          <zeebe:input source="=&quot;at://did:web:animeka.etzhayyim.com/com.etzhayyim.apps.animeka.layout/&quot; + string(cutId) + &quot;-v1&quot;" target="layoutUri"/>
          <zeebe:input source="=1"                                                                                                   target="frameNum"/>
          <zeebe:input source="=string(cutSummary)"                                                                                  target="poseDescription"/>
          <zeebe:input source="=&quot;&quot;"                                                                                        target="characterRefCid"/>
          <zeebe:output source="=blobCid"                                                                                            target="kfCid"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Keyframe" targetRef="Task_Background"/>

    <!-- ── Stage 9: background (call activity) ── -->
    <bpmn:callActivity id="Task_Background" name="generate background">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="animeka_generate_background" propagateAllChildVariables="false"/>
        <zeebe:ioMapping>
          <zeebe:input source="=string(cutId)"                                                                                       target="cutId"/>
          <zeebe:input source="=&quot;at://did:web:animeka.etzhayyim.com/com.etzhayyim.apps.animeka.layout/&quot; + string(cutId) + &quot;-v1&quot;" target="layoutUri"/>
          <zeebe:input source="=string(cutSummary)"                                                                                  target="location"/>
          <zeebe:input source="=&quot;early spring dawn&quot;"                                                                        target="timeOfDay"/>
          <zeebe:input source="=&quot;soft warm morning light&quot;"                                                                  target="lightingMood"/>
          <zeebe:output source="=blobCid"                                                                                            target="bgCid"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Background" targetRef="Task_Compose"/>

    <!--
      Compose social post — null-tolerant 1..4-image embed.

      Each per-stage candidate is materialised as a 1-element sub-list when
      its CID is non-null/non-empty, otherwise as []. flatten() concatenates
      them so a missing slot drops cleanly without leaving a malformed
      blob ref. The post still goes out with whatever images survived.
    -->
    <bpmn:serviceTask id="Task_Compose" name="compose social post">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.atproto.repo.createRecord&quot;" target="type"/>
          <zeebe:input source="={
              repo:       &quot;did:web:an1m3k4x.etzhayyim.com&quot;,
              collection: &quot;app.bsky.feed.post&quot;,
              record: {
                &quot;$type&quot;: &quot;app.bsky.feed.post&quot;,
                text: &quot;🎬 &quot; + string(cutId) + &quot; — autopilot cut\n&quot; + string(cutSummary) + &quot;\n\n12-stage BPMN pipeline (Animagine XL on RunPod L40S)&quot;,
                createdAt: today() + &quot;T00:00:00Z&quot;,
                embed: {
                  &quot;$type&quot;: &quot;app.bsky.embed.images&quot;,
                  images: flatten([
                    if sbCid != null and string length(string(sbCid)) &gt; 0
                      then [ { alt: &quot;絵コンテ&quot;,    image: { &quot;$type&quot;: &quot;blob&quot;, ref: { &quot;$link&quot;: string(sbCid) }, mimeType: &quot;image/png&quot;, size: 250000 } } ]
                      else [],
                    if lyCid != null and string length(string(lyCid)) &gt; 0
                      then [ { alt: &quot;レイアウト&quot;,  image: { &quot;$type&quot;: &quot;blob&quot;, ref: { &quot;$link&quot;: string(lyCid) }, mimeType: &quot;image/png&quot;, size: 250000 } } ]
                      else [],
                    if kfCid != null and string length(string(kfCid)) &gt; 0
                      then [ { alt: &quot;キーフレーム&quot;, image: { &quot;$type&quot;: &quot;blob&quot;, ref: { &quot;$link&quot;: string(kfCid) }, mimeType: &quot;image/png&quot;, size: 250000 } } ]
                      else [],
                    if bgCid != null and string length(string(bgCid)) &gt; 0
                      then [ { alt: &quot;背景&quot;,        image: { &quot;$type&quot;: &quot;blob&quot;, ref: { &quot;$link&quot;: string(bgCid) }, mimeType: &quot;image/png&quot;, size: 250000 } } ]
                      else []
                  ])
                }
              }
          }" target="payload"/>
          <zeebe:output source="=body"   target="postBody"/>
          <zeebe:output source="=status" target="postStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Compose" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit cut runner">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:animeka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;cutRunner&quot;" target="action"/>
          <zeebe:input source="={
              cutId: string(cutId),
              sbCid: string(sbCid),
              lyCid: string(lyCid),
              kfCid: string(kfCid),
              bgCid: string(bgCid),
              postStatus: postStatus
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>F8</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
