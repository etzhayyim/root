<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_etzhayyimcojp_governance"
                  targetNamespace="https://etzhayyim.ai/bpmn/etzhayyimcojp"
                  exporter="hand-written" exporterVersion="2.0">

  <bpmn:process id="etzhayyimcojp_governance_daily_check"
                name="etzhayyimcojp Governance Daily Check"
                isExecutable="true">
    <bpmn:documentation>{ "nsid": "com.etzhayyim.apps.etzhayyimcojp.governanceDailyCheck", "version": 1 }</bpmn:documentation>

    <!-- Daily 09:00 JST = 00:00 UTC -->
    <bpmn:startEvent id="Start_Daily" name="Daily 09:00 JST">
      <bpmn:outgoing>Flow_start_to_ops</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_daily">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 0 * * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_start_to_ops" sourceRef="Start_Daily" targetRef="Task_CompanyOps"/>

    <!-- Submit governance check to LangGraph etzhayyimcojp-company-ops -->
    <bpmn:serviceTask id="Task_CompanyOps" name="Governance Ω(t) Check">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="etzhayyimcojp.ops.submit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;governance.daily&quot;" target="task_type"/>
          <zeebe:input source="={}" target="payload"/>
          <zeebe:output source="=omega_score" target="omega_score"/>
          <zeebe:output source="=floor_violated" target="floor_violated"/>
          <zeebe:output source="=ok" target="ok"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_ops</bpmn:incoming>
      <bpmn:outgoing>Flow_ops_to_audit</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_ops_to_audit" sourceRef="Task_CompanyOps" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="Emit Audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:etzhayyimcojp.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;governance.daily.check&quot;" target="event_type"/>
          <zeebe:input source="={omega: omega_score, floor_violated: floor_violated}" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ops_to_audit</bpmn:incoming>
      <bpmn:outgoing>Flow_audit_to_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_audit_to_end" sourceRef="Task_Audit" targetRef="End_Done"/>

    <bpmn:endEvent id="End_Done" name="Done">
      <bpmn:incoming>Flow_audit_to_end</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
