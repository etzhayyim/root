<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_etzhayyimcojp_personnel_assignment_decide"
                  targetNamespace="https://etzhayyim.ai/bpmn/etzhayyimcojp"
                  exporter="hand-written" exporterVersion="2.0">

  <bpmn:process id="etzhayyimcojp_personnel_assignment_decide"
                name="etzhayyimcojp Personnel Assignment Decide (Minimax + HITL)"
                isExecutable="true">
    <bpmn:documentation>{ "nsid": "com.etzhayyim.apps.etzhayyimcojp.personnelAssignmentDecide", "version": 1, "resultTimeoutMs": 600000 }</bpmn:documentation>

    <!--
      Decision pipeline:
        XRPC trigger
        → load skill matrix + bio + profile + career (Tier 3 RLS)
        → score minimax per candidate × target
        → gateway (spirit_floor_violated? OR ip_leak_risk>0.7?)
            yes → block + notify CEO/CLO (HITL deny)
            no  → recommend top-N + notify COO (HITL approve)
        → on COO approve → write vertex_etzhayyimcojp_assignment + RACI rows
        → audit emit (OCEL)
    -->

    <bpmn:startEvent id="Start_XRPC" name="XRPC: assignment decide">
      <bpmn:outgoing>Flow_start_to_load</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_start_to_load" sourceRef="Start_XRPC" targetRef="Task_LoadProfile"/>

    <bpmn:serviceTask id="Task_LoadProfile" name="Load skill + bio + profile">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="etzhayyimcojp.personnel.loadProfile"/>
        <zeebe:ioMapping>
          <zeebe:input source="=person_did" target="person_did"/>
          <zeebe:input source="=candidate_target" target="candidate_target"/>
          <zeebe:input source="=decision_kind" target="decision_kind"/>
          <zeebe:output source="=profile_bundle" target="profile_bundle"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_load</bpmn:incoming>
      <bpmn:outgoing>Flow_load_to_score</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_load_to_score" sourceRef="Task_LoadProfile" targetRef="Task_MinimaxScore"/>

    <bpmn:serviceTask id="Task_MinimaxScore" name="Compute minimax score">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="etzhayyimcojp.personnel.minimaxScore"/>
        <zeebe:ioMapping>
          <zeebe:input source="=profile_bundle" target="profile_bundle"/>
          <zeebe:input source="=candidate_target" target="candidate_target"/>
          <zeebe:input source="=decision_kind" target="decision_kind"/>
          <zeebe:output source="=minimax_result" target="minimax_result"/>
          <zeebe:output source="=minimax_result.spirit_floor_violated" target="spirit_floor_violated"/>
          <zeebe:output source="=minimax_result.ip_leak_risk" target="ip_leak_risk"/>
          <zeebe:output source="=minimax_result.regret_score" target="regret_score"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_load_to_score</bpmn:incoming>
      <bpmn:outgoing>Flow_score_to_gate</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_score_to_gate" sourceRef="Task_MinimaxScore" targetRef="Gate_FloorOrLeak"/>

    <bpmn:exclusiveGateway id="Gate_FloorOrLeak" name="floor violated or IP leak risk?">
      <bpmn:incoming>Flow_score_to_gate</bpmn:incoming>
      <bpmn:outgoing>Flow_gate_block</bpmn:outgoing>
      <bpmn:outgoing>Flow_gate_proceed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_gate_block" sourceRef="Gate_FloorOrLeak" targetRef="Task_NotifyDeny">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=spirit_floor_violated = true or ip_leak_risk &gt; 0.7</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_gate_proceed" sourceRef="Gate_FloorOrLeak" targetRef="Task_RequestApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=spirit_floor_violated = false and ip_leak_risk &lt;= 0.7</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Block path: notify CEO + CLO, no assignment write -->
    <bpmn:serviceTask id="Task_NotifyDeny" name="Notify CEO+CLO (deny)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="etzhayyimcojp.personnel.notifyDeny"/>
        <zeebe:ioMapping>
          <zeebe:input source="=minimax_result" target="minimax_result"/>
          <zeebe:input source="=[&quot;did:web:j-kawasaki.etzhayyim.com&quot;,&quot;did:web:k-bakshi.etzhayyim.com&quot;]" target="recipient_dids"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_gate_block</bpmn:incoming>
      <bpmn:outgoing>Flow_deny_to_audit</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_deny_to_audit" sourceRef="Task_NotifyDeny" targetRef="Task_Audit"/>

    <!-- Proceed path: HITL approval (COO) -->
    <bpmn:userTask id="Task_RequestApproval" name="COO approval (HITL)">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="did:web:a-nakamura.etzhayyim.com"/>
        <zeebe:ioMapping>
          <zeebe:input source="=minimax_result" target="minimax_result"/>
          <zeebe:output source="=approval_decision" target="approval_decision"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_gate_proceed</bpmn:incoming>
      <bpmn:outgoing>Flow_approval_to_gate</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_approval_to_gate" sourceRef="Task_RequestApproval" targetRef="Gate_Approved"/>

    <bpmn:exclusiveGateway id="Gate_Approved" name="approved?">
      <bpmn:incoming>Flow_approval_to_gate</bpmn:incoming>
      <bpmn:outgoing>Flow_approved_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_approved_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_approved_yes" sourceRef="Gate_Approved" targetRef="Task_WriteAssignment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approval_decision = "approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_approved_no" sourceRef="Gate_Approved" targetRef="Task_Audit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approval_decision != "approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_WriteAssignment" name="Write assignment + RACI">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="etzhayyimcojp.personnel.writeAssignment"/>
        <zeebe:ioMapping>
          <zeebe:input source="=person_did" target="person_did"/>
          <zeebe:input source="=candidate_target" target="candidate_target"/>
          <zeebe:input source="=minimax_result" target="minimax_result"/>
          <zeebe:input source="=approval_decision" target="approval_decision"/>
          <zeebe:output source="=assignment_id" target="assignment_id"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_approved_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_write_to_audit</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_write_to_audit" sourceRef="Task_WriteAssignment" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="Emit Audit (OCEL)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:etzhayyimcojp.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;personnel.assignment.decide&quot;" target="event_type"/>
          <zeebe:input source="={person_did: person_did, candidate_target: candidate_target, regret_score: regret_score, spirit_floor_violated: spirit_floor_violated, ip_leak_risk: ip_leak_risk, approval_decision: approval_decision, assignment_id: assignment_id}" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_deny_to_audit</bpmn:incoming>
      <bpmn:incoming>Flow_approved_no</bpmn:incoming>
      <bpmn:incoming>Flow_write_to_audit</bpmn:incoming>
      <bpmn:outgoing>Flow_audit_to_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_audit_to_end" sourceRef="Task_Audit" targetRef="End_Done"/>

    <bpmn:endEvent id="End_Done" name="Done">
      <bpmn:incoming>Flow_audit_to_end</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
