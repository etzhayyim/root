<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  id="defs_vector_embedding_backfill_batch"
  targetNamespace="https://etzhayyim.ai/bpmn/vector-embedding">

  <bpmn:process id="vector_embedding_backfill_batch" name="Vector Embedding Backfill Batch" isExecutable="true">
    <bpmn:startEvent id="start" name="Start">
      <bpmn:outgoing>flow_health_gate</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="health_gate" name="RisingWave health gate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="rw.health.probe" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_health_gate</bpmn:incoming>
      <bpmn:outgoing>flow_backfill_batch</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="backfill_batch" name="Backfill one embedding batch">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="vectorEmbedding.backfillBatch" retries="2" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_backfill_batch</bpmn:incoming>
      <bpmn:outgoing>flow_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="end" name="End">
      <bpmn:incoming>flow_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="flow_health_gate" sourceRef="start" targetRef="health_gate" />
    <bpmn:sequenceFlow id="flow_backfill_batch" sourceRef="health_gate" targetRef="backfill_batch" />
    <bpmn:sequenceFlow id="flow_end" sourceRef="backfill_batch" targetRef="end" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="diagram_vector_embedding_backfill_batch">
    <bpmndi:BPMNPlane id="plane_vector_embedding_backfill_batch" bpmnElement="vector_embedding_backfill_batch">
      <bpmndi:BPMNShape id="shape_start" bpmnElement="start">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_health_gate" bpmnElement="health_gate">
        <dc:Bounds x="250" y="78" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_backfill_batch" bpmnElement="backfill_batch">
        <dc:Bounds x="470" y="78" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_end" bpmnElement="end">
        <dc:Bounds x="720" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_flow_health_gate" bpmnElement="flow_health_gate">
        <di:waypoint x="196" y="118" />
        <di:waypoint x="250" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow_backfill_batch" bpmnElement="flow_backfill_batch">
        <di:waypoint x="410" y="118" />
        <di:waypoint x="470" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow_end" bpmnElement="flow_end">
        <di:waypoint x="660" y="118" />
        <di:waypoint x="720" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
