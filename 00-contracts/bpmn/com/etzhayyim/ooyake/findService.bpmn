<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_ooyake_find_service"
    targetNamespace="https://etzhayyim.com/bpmn/ooyake"
    exporter="hand-written"
    exporterVersion="1.0">
  <!-- ooyake findService: citizen wayfinding (READ-ONLY, G9). Resolve a procedure
       query → matching procedures → 窓口 + 住所, flag verify-first (G12), hand off
       to toritsugi for delivery. Never files, never a target-list (G10). -->
  <bpmn:process id="ooyake_find_service" name="ooyake findService (civic wayfinding)" isExecutable="true">
    <bpmn:startEvent id="Start" name="service query received">
      <bpmn:outgoing>Flow_Search</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Search" sourceRef="Start" targetRef="Task_SearchProc"/>
    <bpmn:serviceTask id="Task_SearchProc" name="search procedures">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="xrpc.com.etzhayyim.ooyake.searchProcedures"/>
        <zeebe:ioMapping>
          <zeebe:output source="=matches" target="matches"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Search</bpmn:incoming>
      <bpmn:outgoing>Flow_Resolve</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Resolve" sourceRef="Task_SearchProc" targetRef="Task_ResolveWindow"/>
    <bpmn:serviceTask id="Task_ResolveWindow" name="resolve 窓口 + 住所">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="xrpc.com.etzhayyim.ooyake.resolveWindow"/>
        <zeebe:ioMapping>
          <zeebe:output source="=windows" target="windows"/>
          <zeebe:output source="=addresses" target="addresses"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Resolve</bpmn:incoming>
      <bpmn:outgoing>Flow_Freshness</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Freshness" sourceRef="Task_ResolveWindow" targetRef="Gateway_Verified"/>
    <bpmn:exclusiveGateway id="Gateway_Verified" name="maintainer-verified?">
      <bpmn:incoming>Flow_Freshness</bpmn:incoming>
      <bpmn:outgoing>Flow_Verified</bpmn:outgoing>
      <bpmn:outgoing>Flow_VerifyFirst</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_VerifyFirst" name="unverified-seed / stale (G12)" sourceRef="Gateway_Verified" targetRef="Task_FlagVerify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=verificationStatus != "maintainer-verified"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_FlagVerify" name="set verifyFirst flag">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="xrpc.com.etzhayyim.ooyake.flagVerifyFirst"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_VerifyFirst</bpmn:incoming>
      <bpmn:outgoing>Flow_Handoff</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Verified" name="maintainer-verified" sourceRef="Gateway_Verified" targetRef="Task_Handoff">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=verificationStatus = "maintainer-verified"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Handoff" sourceRef="Task_FlagVerify" targetRef="Task_Handoff"/>
    <bpmn:serviceTask id="Task_Handoff" name="hand off to toritsugi (toritsugiRef)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="xrpc.com.etzhayyim.ooyake.toritsugiHandoff"/>
        <zeebe:ioMapping>
          <zeebe:output source="=results" target="results"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Verified</bpmn:incoming>
      <bpmn:incoming>Flow_Handoff</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Handoff" targetRef="End"/>
    <bpmn:endEvent id="End" name="wayfinding result returned">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
