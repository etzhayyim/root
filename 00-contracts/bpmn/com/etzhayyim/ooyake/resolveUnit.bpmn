<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_ooyake_resolve_unit"
    targetNamespace="https://etzhayyim.com/bpmn/ooyake"
    exporter="hand-written"
    exporterVersion="1.0">
  <!-- ooyake resolveUnit: resolve a unitId / atlas-DID to a unit + ancestor chain
       + addresses + windows from the gov-atlas kotoba graph (READ-ONLY, G9). -->
  <bpmn:process id="ooyake_resolve_unit" name="ooyake resolveUnit" isExecutable="true">
    <bpmn:startEvent id="Start" name="resolve requested">
      <bpmn:outgoing>Flow_Lookup</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Lookup" sourceRef="Start" targetRef="Task_Lookup"/>
    <bpmn:serviceTask id="Task_Lookup" name="lookup unit (EAVT/AVET)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="xrpc.com.etzhayyim.ooyake.getUnit"/>
        <zeebe:ioMapping>
          <zeebe:output source="=unit" target="unit"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Lookup</bpmn:incoming>
      <bpmn:outgoing>Flow_Chain</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Chain" sourceRef="Task_Lookup" targetRef="Task_Chain"/>
    <bpmn:serviceTask id="Task_Chain" name="walk :gov.unit/parent chain">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="xrpc.com.etzhayyim.ooyake.resolvePath"/>
        <zeebe:ioMapping>
          <zeebe:output source="=chain" target="chain"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Chain</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Chain" targetRef="End"/>
    <bpmn:endEvent id="End" name="unit + chain returned">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
