<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_ooyake_reconcile_unit"
    targetNamespace="https://etzhayyim.com/bpmn/ooyake"
    exporter="hand-written"
    exporterVersion="1.0">
  <!-- ooyake reconcileUnit: ingest a unit from a PUBLIC official source (G4),
       reconcile against external authorities (Wikidata / 行政機関コード /
       全国地方公共団体コード / ISO-3166-2 / GeoNames), attach provenance +
       last-verified + sourcing (G5), and upsert into the gov-atlas graph.
       Promotes :representative → :authoritative only on maintainer verification. -->
  <bpmn:process id="ooyake_reconcile_unit" name="ooyake reconcileUnit (ingest)" isExecutable="true">
    <bpmn:startEvent id="Start" name="source record received">
      <bpmn:outgoing>Flow_Scan</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Scan" sourceRef="Start" targetRef="Task_RiderScan"/>
    <bpmn:serviceTask id="Task_RiderScan" name="Charter Rider §2 scan (G1)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="xrpc.com.etzhayyim.charterRider.scan"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Scan</bpmn:incoming>
      <bpmn:outgoing>Flow_Reconcile</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Reconcile" sourceRef="Task_RiderScan" targetRef="Task_Reconcile"/>
    <bpmn:serviceTask id="Task_Reconcile" name="reconcile vs external authorities">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="xrpc.com.etzhayyim.ooyake.reconcileExternal"/>
        <zeebe:ioMapping>
          <zeebe:output source="=wikidata" target="wikidata"/>
          <zeebe:output source="=externalCode" target="externalCode"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reconcile</bpmn:incoming>
      <bpmn:outgoing>Flow_Provenance</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Provenance" sourceRef="Task_Reconcile" targetRef="Task_Provenance"/>
    <bpmn:serviceTask id="Task_Provenance" name="attach provenance + sourcing (G5)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="xrpc.com.etzhayyim.ooyake.attachProvenance"/>
        <zeebe:ioMapping>
          <zeebe:output source="=sourcing" target="sourcing"/>
          <zeebe:output source="=verificationStatus" target="verificationStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Provenance</bpmn:incoming>
      <bpmn:outgoing>Flow_Upsert</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Upsert" sourceRef="Task_Provenance" targetRef="Task_Upsert"/>
    <bpmn:serviceTask id="Task_Upsert" name="upsert datoms (kotoba EAVT, G2)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="xrpc.com.etzhayyim.ooyake.upsertUnit"/>
        <zeebe:ioMapping>
          <zeebe:output source="=unitId" target="unitId"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Upsert</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Upsert" targetRef="End"/>
    <bpmn:endEvent id="End" name="unit reconciled + upserted">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
