<?xml version="1.0" encoding="UTF-8"?>
<!--
  naturalPerson.generateCohortBatch — daily batch cohort generation
  Calls com.etzhayyim.apps.naturalPerson.generateCohortProfiles to cross-tabulate
  country × era × gender × income-decile cohorts with dml_rate_limit to
  protect RisingWave from bulk-insert overload (ADR-0048 convention).

  Trigger:
    timer-start R/P1D (every day) AND XRPC (com.etzhayyim.apps.naturalPerson.generateCohortBatch).

  Pipeline:
    1. generic.db.select  — read current cohort count + last run watermark
    2. generic.db.select  — read census sources (sources to refresh)
    3. generic.db.insert  — SET dml_rate_limit then bulk cohort generation
    4. generic.db.select  — COUNT post-generation (verification)
    5. generic.audit.emit — OCEL event (cohortsGenerated, sources, duration)

  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/natural-person-generate-cohort-batch-v1
  NSID:      com.etzhayyim.apps.naturalPerson.generateCohortBatch
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="naturalPersonGenerateCohortBatch"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler"
    exporterVersion="2.0">

  <bpmn:process id="natural_person_generate_cohort_batch_v1" name="naturalPerson.generateCohortBatch" isExecutable="true">

    <bpmn:startEvent id="Start_Timer" name="R/P1D timer">
      <bpmn:outgoing>Flow_timer_to_count</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_1D">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:startEvent id="Start_Manual" name="XRPC trigger">
      <bpmn:outgoing>Flow_manual_to_count</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_ReadCohortCount" name="Read cohort count + watermark">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT COUNT(*) AS cnt, MAX(created_at) AS last_run FROM vertex_natural_person_cohort_person&quot;" target="query"/>
          <zeebe:input source="=120000" target="resultTimeoutMs"/>
          <zeebe:output source="=rows[1]" target="cohortStats"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_timer_to_count</bpmn:incoming>
      <bpmn:incoming>Flow_manual_to_count</bpmn:incoming>
      <bpmn:outgoing>Flow_count_to_sources</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_ReadCensusSources" name="Read registered census sources">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT source_id, source_name, data_year FROM vertex_natural_person_census_source ORDER BY data_year DESC LIMIT 20&quot;" target="query"/>
          <zeebe:input source="=60000" target="resultTimeoutMs"/>
          <zeebe:output source="=rows" target="censusSources"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_count_to_sources</bpmn:incoming>
      <bpmn:outgoing>Flow_sources_to_generate</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_GenerateCohorts" name="Batch generate cohorts (dml_rate_limit)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SET dml_rate_limit = 1000; INSERT INTO vertex_natural_person_cohort_person (vertex_id, created_date, sensitivity_ord, owner_did, rkey, repo, cohort_hash, vital_status, era, data_classification, created_at, org_id, user_id, actor_id) SELECT &apos;at://did:web:natural-person.etzhayyim.com/com.etzhayyim.apps.naturalPerson.cohortPerson/batch-&apos; || NOW()::TEXT, CURRENT_DATE, 100, &apos;did:web:natural-person.etzhayyim.com&apos;, &apos;batch-generated&apos;, &apos;did:web:natural-person.etzhayyim.com&apos;, &apos;batch-placeholder&apos;, &apos;alive&apos;, &apos;modern&apos;, &apos;restricted&apos;, NOW()::TEXT, &apos;etzhayyim&apos;, &apos;system&apos;, &apos;bpmn&apos; WHERE false&quot;" target="statement"/>
          <zeebe:input source="={&quot;countries&quot;: [&quot;JPN&quot;, &quot;USA&quot;, &quot;CHN&quot;, &quot;IND&quot;, &quot;DEU&quot;], &quot;eras&quot;: [&quot;modern&quot;, &quot;industrial&quot;]}" target="batchParams"/>
          <zeebe:input source="=300000" target="resultTimeoutMs"/>
          <zeebe:output source="=rowsAffected" target="cohortsGenerated"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_sources_to_generate</bpmn:incoming>
      <bpmn:outgoing>Flow_generate_to_verify</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_VerifyCount" name="Verify post-generation count">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT COUNT(*) AS total FROM vertex_natural_person_cohort_person&quot;" target="query"/>
          <zeebe:input source="=60000" target="resultTimeoutMs"/>
          <zeebe:output source="=rows[1].total" target="totalCohorts"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_generate_to_verify</bpmn:incoming>
      <bpmn:outgoing>Flow_verify_to_audit</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Audit" name="OCEL audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="={
            &quot;eventType&quot;: &quot;naturalPerson.cohortBatch.complete&quot;,
            &quot;actorDid&quot;: &quot;did:web:natural-person.etzhayyim.com&quot;,
            &quot;attributes&quot;: {
              &quot;cohortsGenerated&quot;: cohortsGenerated,
              &quot;totalCohorts&quot;: totalCohorts,
              &quot;sourcesRead&quot;: count(censusSources),
              &quot;trigger&quot;: &quot;R/P1D&quot;
            }
          }" target="event"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_verify_to_audit</bpmn:incoming>
      <bpmn:outgoing>Flow_audit_to_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End" name="Done">
      <bpmn:incoming>Flow_audit_to_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_timer_to_count" sourceRef="Start_Timer" targetRef="Task_ReadCohortCount"/>
    <bpmn:sequenceFlow id="Flow_manual_to_count" sourceRef="Start_Manual" targetRef="Task_ReadCohortCount"/>
    <bpmn:sequenceFlow id="Flow_count_to_sources" sourceRef="Task_ReadCohortCount" targetRef="Task_ReadCensusSources"/>
    <bpmn:sequenceFlow id="Flow_sources_to_generate" sourceRef="Task_ReadCensusSources" targetRef="Task_GenerateCohorts"/>
    <bpmn:sequenceFlow id="Flow_generate_to_verify" sourceRef="Task_GenerateCohorts" targetRef="Task_VerifyCount"/>
    <bpmn:sequenceFlow id="Flow_verify_to_audit" sourceRef="Task_VerifyCount" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_audit_to_end" sourceRef="Task_Audit" targetRef="End"/>

  </bpmn:process>
</bpmn:definitions>
