<?xml version="1.0" encoding="UTF-8"?>
<!--
  naturalPerson.reconcileVisibility — visibility-class reconciliation guard

  Safe default:
    applyOpenalexPublic is false unless explicitly passed by XRPC/BPMN caller.
    In dry-run mode the workflow only reads counts and emits audit.

  First apply scope:
    vertex_natural_person rows from OpenAlex with data_classification='open'
    and sensitivity_ord IS NULL can be promoted to sensitivity_ord=0
    public_searchable. Business-person rows remain audit-only until source
    allow-listing is explicit.

  NSID: com.etzhayyim.apps.naturalPerson.reconcileVisibility
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="naturalPersonReconcileVisibility"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler"
    exporterVersion="2.0">

  <bpmn:process id="natural_person_reconcile_visibility_v1" name="naturalPerson.reconcileVisibility" isExecutable="true">

    <bpmn:startEvent id="Start_Manual" name="XRPC trigger">
      <bpmn:outgoing>Flow_start_to_read_plan</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_ReadPlan" name="Read visibility reconciliation plan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT (SELECT COUNT(*)::bigint FROM vertex_natural_person WHERE sensitivity_ord IS NULL AND data_classification = 'open' AND source_app = 'openalex') AS planned_openalex_public, (SELECT COUNT(*)::bigint FROM vertex_business_person WHERE sensitivity_ord IS NULL) AS business_unclassified, (SELECT COUNT(*)::bigint FROM (SELECT cohort_hash FROM vertex_natural_person_cohort_person WHERE cohort_hash IS NOT NULL AND cohort_hash &lt;&gt; '' GROUP BY cohort_hash HAVING COUNT(*) &gt; 1) x) AS cohort_hash_collision_groups&quot;" target="sql"/>
          <zeebe:input source="=[]" target="params"/>
          <zeebe:input source="=60000" target="resultTimeoutMs"/>
          <zeebe:output source="=rows[1]" target="visibilityPlan"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_read_plan</bpmn:incoming>
      <bpmn:outgoing>Flow_read_plan_to_apply_openalex</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_ApplyOpenalexPublic" name="Apply OpenAlex public rows when requested">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;UPDATE vertex_natural_person SET sensitivity_ord = 0 WHERE COALESCE($1::boolean, false) = true AND sensitivity_ord IS NULL AND data_classification = 'open' AND source_app = 'openalex'&quot;" target="sql"/>
          <zeebe:input source="=[applyOpenalexPublic]" target="params"/>
          <zeebe:input source="=300000" target="resultTimeoutMs"/>
          <zeebe:output source="=updated" target="updatedOpenalexPublic"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_read_plan_to_apply_openalex</bpmn:incoming>
      <bpmn:outgoing>Flow_apply_openalex_to_audit</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Audit" name="OCEL audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="={
            &quot;eventType&quot;: &quot;naturalPerson.visibilityReconcile.complete&quot;,
            &quot;actorDid&quot;: &quot;did:web:natural-person.etzhayyim.com&quot;,
            &quot;attributes&quot;: {
              &quot;applyOpenalexPublic&quot;: applyOpenalexPublic,
              &quot;plannedOpenalexPublic&quot;: visibilityPlan.planned_openalex_public,
              &quot;updatedOpenalexPublic&quot;: updatedOpenalexPublic,
              &quot;businessUnclassified&quot;: visibilityPlan.business_unclassified,
              &quot;cohortHashCollisionGroups&quot;: visibilityPlan.cohort_hash_collision_groups
            }
          }" target="event"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_apply_openalex_to_audit</bpmn:incoming>
      <bpmn:outgoing>Flow_audit_to_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End" name="Done">
      <bpmn:incoming>Flow_audit_to_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_start_to_read_plan" sourceRef="Start_Manual" targetRef="Task_ReadPlan"/>
    <bpmn:sequenceFlow id="Flow_read_plan_to_apply_openalex" sourceRef="Task_ReadPlan" targetRef="Task_ApplyOpenalexPublic"/>
    <bpmn:sequenceFlow id="Flow_apply_openalex_to_audit" sourceRef="Task_ApplyOpenalexPublic" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_audit_to_end" sourceRef="Task_Audit" targetRef="End"/>

  </bpmn:process>
</bpmn:definitions>
