<?xml version="1.0" encoding="UTF-8"?>
<!--
  Timer-start BPMN — claim unchallenged sweep (every 1 hour).
  Finds expired unchallenged pending claims → calls claimUnchallenged() on-chain
  via the claim-consumer Python Zeebe actor + authz /internal/claim-unchallenged-sweep.
  Emits OCEL alarm when Murakumo fraud signal exists but no challenger stepped up
  (triple-witness mismatch, ADR-2604261717 Phase 4 / ADR-0046 simplified).

  NSID: com.etzhayyim.apps.claim.unchallengedSweep
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/claim-auto-challenge-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_claim_auto_challenge"
    targetNamespace="https://etzhayyim.ai/bpmn/claim"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="claim_auto_challenge" name="claim unchallenged sweep (R/PT1H)" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.claim.unchallengedSweep", "version": 1, "resultTimeoutMs": 120000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="every 1 hour">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">R/PT1H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_Sweep"/>

    <bpmn:serviceTask id="Task_Sweep" name="unchallenged sweep actor">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="claim.unchallenged.sweep"/>
        <zeebe:ioMapping>
          <zeebe:input source="=5" target="limit"/>
          <zeebe:output source="=result" target="tickResult"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Sweep" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="emit claim.unchallenged.sweep OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.claim.unchallenged.sweep&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;ok&quot;: tickResult.ok, &quot;scanned&quot;: tickResult.scanned, &quot;submitted&quot;: tickResult.submitted, &quot;witnessAlarms&quot;: tickResult.witnessAlarms, &quot;errors&quot;: tickResult.errors }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
