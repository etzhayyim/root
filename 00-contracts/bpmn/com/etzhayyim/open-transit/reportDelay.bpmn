<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_transit_report_delay"
    targetNamespace="https://etzhayyim.ai/bpmn/open-transit"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_transit_report_delay" name="交通遅延 報告" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Classify"/>

    <!-- major: >=30min, moderate: 10-29, minor: <10. public notice = major. -->
    <bpmn:serviceTask id="Task_Classify" name="severity 分類">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT 1 AS ok LIMIT 1&quot;" target="query"/>
          <zeebe:input source="=[]" target="params"/>
          <zeebe:output source="=if delayMinutes &gt;= 30 then &quot;major&quot; else if delayMinutes &gt;= 10 then &quot;moderate&quot; else &quot;minor&quot;" target="severity"/>
          <zeebe:output source="=delayMinutes &gt;= 30" target="requirePublicNotice"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_Save</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Save" sourceRef="Task_Classify" targetRef="Task_Save"/>

    <bpmn:serviceTask id="Task_Save" name="delay 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_transit_delay&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id: vertexId, agency_org_id: agencyOrgId,
              route_vertex_id: routeVertexId, stop_sequence: stopSequence,
              delay_minutes: delayMinutes, reason: reason,
              severity: severity, require_public_notice: requirePublicNotice,
              status: &quot;active&quot;, reported_at: reportedAt,
              created_at: string(now()), owner_did: callerDid,
              sensitivity_ord: 1, org_id: agencyOrgId,
              user_id: callerDid, actor_id: &quot;sys.bpmn.open-transit&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Save</bpmn:incoming><bpmn:outgoing>Flow_Edge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Edge" sourceRef="Task_Save" targetRef="Task_Edge"/>

    <bpmn:serviceTask id="Task_Edge" name="delay → route edge">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;edge_open_transit_delay_route&quot;" target="table"/>
          <zeebe:input source="={
              edge_id: string(vertexId) + &quot;:route&quot;,
              src_vid: vertexId, dst_vid: routeVertexId, role: &quot;on_route&quot;,
              created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1,
              org_id: agencyOrgId, user_id: callerDid, actor_id: &quot;sys.bpmn.open-transit&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Edge</bpmn:incoming><bpmn:outgoing>Flow_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Gate" sourceRef="Task_Edge" targetRef="Gate"/>

    <bpmn:exclusiveGateway id="Gate" default="Flow_Silent">
      <bpmn:incoming>Flow_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Notice</bpmn:outgoing>
      <bpmn:outgoing>Flow_Silent</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Notice" sourceRef="Gate" targetRef="Task_AuditMajor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=requirePublicNotice = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Silent" sourceRef="Gate" targetRef="Task_AuditLog"/>

    <bpmn:serviceTask id="Task_AuditMajor" name="audit delay.publicNotice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-transit.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openTransit.delay.publicNotice&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, severity: severity, routeVertexId: routeVertexId, delayMinutes: delayMinutes}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Notice</bpmn:incoming><bpmn:outgoing>Flow_EM</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EM" sourceRef="Task_AuditMajor" targetRef="End_M"/>

    <bpmn:serviceTask id="Task_AuditLog" name="audit delay.log">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-transit.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openTransit.delay.log&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, severity: severity, routeVertexId: routeVertexId, delayMinutes: delayMinutes}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Silent</bpmn:incoming><bpmn:outgoing>Flow_ES</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ES" sourceRef="Task_AuditLog" targetRef="End_S"/>

    <bpmn:endEvent id="End_S"><bpmn:incoming>Flow_ES</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_M"><bpmn:incoming>Flow_EM</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
