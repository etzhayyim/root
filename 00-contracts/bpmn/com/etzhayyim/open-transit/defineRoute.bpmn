<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_transit_define_route"
    targetNamespace="https://etzhayyim.ai/bpmn/open-transit"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_transit_define_route" name="交通ルート 登録" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="route 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_transit_route&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id: vertexId, agency_org_id: agencyOrgId,
              route_code: routeCode, route_type: routeType,
              name: name, headsign_fwd: headsignFwd, headsign_rev: headsignRev,
              color: color, status: &quot;active&quot;,
              created_at: string(now()), owner_did: callerDid,
              sensitivity_ord: 1, org_id: agencyOrgId,
              user_id: callerDid, actor_id: &quot;sys.bpmn.open-transit&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit route.define">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-transit.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openTransit.route.define&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, routeCode: routeCode, routeType: routeType, agencyOrgId: agencyOrgId}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
