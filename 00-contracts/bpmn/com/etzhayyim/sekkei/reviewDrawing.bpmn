<?xml version="1.0" encoding="UTF-8"?>
<!--
  reviewDrawing — XRPC com.etzhayyim.apps.sekkei.reviewDrawing で起動。
  設計図の改訂を登録し、承認ゲートへ進める。
  承認者が decision=approved → drawing.status=approved + currentRevNo 更新。
  decision=rejected → revision.status=rejected + 差し戻し。

  Inputs:
    drawingId
    revNo
    revisionReason
    changeDescription
    revisedByDid
    cadFileRef
    approval.approverDid
    approval.decision    (approved | rejected | conditional)
    approval.conditions
-->
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_sekkei_review_drawing"
  targetNamespace="https://etzhayyim.ai/bpmn/sekkei"
  exporter="hand-written"
  exporterVersion="1.0">
  <bpmn:process id="sekkei_review_drawing" name="sekkei Review Drawing" isExecutable="true">

    <bpmn:startEvent id="Start" name="review requested">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_WriteRevision"/>

    <bpmn:serviceTask id="Task_WriteRevision" name="write revision record">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_sekkei_revision&quot;" target="table"/>
          <zeebe:input source="={ drawing_id: drawingId, rev_no: revNo, revision_reason: revisionReason, change_description: changeDescription, revised_by_did: revisedByDid, revised_at: today, cad_file_ref: cadFileRef, status: &quot;pending-approval&quot; }" target="row"/>
          <zeebe:output source="=insertedId" target="revisionId"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_WriteRevision" targetRef="Task_UpdateDrawingStatus"/>

    <bpmn:serviceTask id="Task_UpdateDrawingStatus" name="set drawing status=review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_sekkei_drawing&quot;" target="table"/>
          <zeebe:input source="={ drawing_id: drawingId, status: &quot;review&quot; }" target="row"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_UpdateDrawingStatus" targetRef="Task_ApprovalGate"/>

    <bpmn:userTask id="Task_ApprovalGate" name="Review and approve drawing">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:sekkei-drawing-review-v1"/>
        <zeebe:assignmentDefinition candidateGroups="sekkei-approvers"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ApprovalGate" targetRef="Gate_Decision"/>

    <bpmn:exclusiveGateway id="Gate_Decision" name="decision?" default="Flow_Rejected">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Approved" sourceRef="Gate_Decision" targetRef="Task_WriteApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approval.decision = "approved" or approval.decision = "conditional"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rejected" sourceRef="Gate_Decision" targetRef="Task_WriteRejection"/>

    <bpmn:serviceTask id="Task_WriteApproval" name="write approval record">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_sekkei_approval&quot;" target="table"/>
          <zeebe:input source="={ drawing_id: drawingId, rev_no: revNo, approver_did: approval.approverDid, approver_role: approval.approverRole, decision: approval.decision, decided_at: now, conditions: approval.conditions }" target="row"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_WriteApproval" targetRef="Task_UpdateApproved"/>

    <bpmn:serviceTask id="Task_UpdateApproved" name="update drawing currentRevNo + status=approved">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_sekkei_drawing&quot;" target="table"/>
          <zeebe:input source="={ drawing_id: drawingId, current_rev_no: revNo, status: &quot;approved&quot; }" target="row"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_AuditApproved</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AuditApproved" sourceRef="Task_UpdateApproved" targetRef="Task_AuditApproved"/>

    <bpmn:serviceTask id="Task_AuditApproved" name="emit approved audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:sekkei.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;drawingApproved&quot;" target="action"/>
          <zeebe:input source="={ drawingId: drawingId, revNo: revNo, approverDid: approval.approverDid, decision: approval.decision }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AuditApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ApprEnd" sourceRef="Task_AuditApproved" targetRef="End"/>

    <bpmn:serviceTask id="Task_WriteRejection" name="write rejection + revert drawing status">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_sekkei_revision&quot;" target="table"/>
          <zeebe:input source="={ drawing_id: drawingId, rev_no: revNo, status: &quot;rejected&quot;, notes: approval.rejectionReason }" target="row"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_RevertDraft</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_RevertDraft" sourceRef="Task_WriteRejection" targetRef="Task_RevertDraft"/>

    <bpmn:serviceTask id="Task_RevertDraft" name="revert drawing to draft">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_sekkei_drawing&quot;" target="table"/>
          <zeebe:input source="={ drawing_id: drawingId, status: &quot;draft&quot; }" target="row"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RevertDraft</bpmn:incoming>
      <bpmn:outgoing>Flow_AuditRejected</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AuditRejected" sourceRef="Task_RevertDraft" targetRef="Task_AuditRejected"/>

    <bpmn:serviceTask id="Task_AuditRejected" name="emit rejected audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:sekkei.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;drawingRejected&quot;" target="action"/>
          <zeebe:input source="={ drawingId: drawingId, revNo: revNo, approverDid: approval.approverDid, reason: approval.rejectionReason }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AuditRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_RejEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_RejEnd" sourceRef="Task_AuditRejected" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ApprEnd</bpmn:incoming>
      <bpmn:incoming>Flow_RejEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
