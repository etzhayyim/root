<?xml version="1.0" encoding="UTF-8"?>
<!--
  F5 demo — `bot.reviewAndPost` actor expressed entirely as BPMN.

  Realistic 5-step pattern that exercises 4 of the 7 generic primitives
  (llm.json + http.fetch is unused; this one uses llm.json + db.select +
  audit.emit). PDS dispatch is conditional on the LLM critique gate.

  Flow:
    Start (input: text, channel)
      → generic.llm.json     (critique: { acceptable, score, issues })
      → XOR (acceptable?)
          yes → generic.audit.emit (decision=accept) → End
          no  → generic.audit.emit (decision=reject + reasons) → End

  The PDS dispatch step is intentionally commented out for this PoC —
  enabling it requires an actor DID with mintable ServiceAuth. We keep
  this demo idempotent / side-effect-light so we can run it
  repeatedly during F5 verification without flooding AT records.

  Variables on the instance:
    in:     text (required), channel (optional)
    middle: critique (parsed LLM JSON object)
    out:    accepted (bool), reviewedAt, auditRkey
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_bot_review_and_post"
    targetNamespace="https://etzhayyim.ai/bpmn/bot"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="bot_review_and_post" name="bot review and post" isExecutable="true">

    <bpmn:startEvent id="Start" name="post requested">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_Critique"/>

    <bpmn:serviceTask id="Task_Critique" name="LLM critique">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.json"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;classifier&quot;" target="tier"/>
          <zeebe:input source="=&quot;You are a content reviewer. Output ONE JSON object: {&apos;acceptable&apos;:true|false,&apos;score&apos;:0-100,&apos;rationale&apos;:string&lt;=160chars}. Reject if the text is hateful, defamatory, contains PII, or is incoherent. JSON only.&quot;" target="system"/>
          <zeebe:input source="=&quot;Channel: &quot; + string(channel) + &quot;\nText:\n&quot; + string(text)" target="user"/>
          <zeebe:input source="=200" target="maxTokens"/>
          <zeebe:input source="=0.1" target="temperature"/>
          <zeebe:output source="=ok"        target="llmOk"/>
          <zeebe:output source="=data"      target="critique"/>
          <zeebe:output source="=model"     target="llmModel"/>
          <zeebe:output source="=latencyMs" target="llmLatencyMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Critique" targetRef="Gate_Accept"/>

    <bpmn:exclusiveGateway id="Gate_Accept" name="acceptable?" default="Flow_Reject">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Accept</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Accept" sourceRef="Gate_Accept" targetRef="Task_AuditAccept">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=critique.acceptable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Reject" sourceRef="Gate_Accept" targetRef="Task_AuditReject"/>

    <bpmn:serviceTask id="Task_AuditAccept" name="audit: accepted">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:bot.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;reviewAndPost.accept&quot;" target="action"/>
          <zeebe:input source="={
              text: string(text),
              channel: string(channel),
              critique: critique,
              llmModel: llmModel,
              llmLatencyMs: llmLatencyMs
          }" target="payload"/>
          <zeebe:output source="=emitted" target="auditEmitted"/>
          <zeebe:output source="=rkey"    target="auditRkey"/>
          <zeebe:output source="=true"    target="accepted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Accept</bpmn:incoming>
      <bpmn:outgoing>Flow_3a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3a" sourceRef="Task_AuditAccept" targetRef="End"/>

    <bpmn:serviceTask id="Task_AuditReject" name="audit: rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:bot.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;reviewAndPost.reject&quot;" target="action"/>
          <zeebe:input source="={
              text: string(text),
              channel: string(channel),
              critique: critique,
              llmModel: llmModel,
              llmLatencyMs: llmLatencyMs
          }" target="payload"/>
          <zeebe:output source="=emitted" target="auditEmitted"/>
          <zeebe:output source="=rkey"    target="auditRkey"/>
          <zeebe:output source="=false"   target="accepted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_3b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3b" sourceRef="Task_AuditReject" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_3a</bpmn:incoming>
      <bpmn:incoming>Flow_3b</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
