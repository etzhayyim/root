<?xml version="1.0" encoding="UTF-8"?>
<!--
  F5 batch — smallest possible BPMN actor: one audit task.
  Demonstrates that "new actor = INSERT 2 rows + 1 generic task".

  Flow:
    Start (input: message?) → generic.audit.emit → End

  Variables on the instance:
    in:  message (optional)
    out: auditEmitted, auditRkey, pingedAt
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_bot_ping"
    targetNamespace="https://etzhayyim.ai/bpmn/bot"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="bot_ping" name="bot ping" isExecutable="true">

    <bpmn:startEvent id="Start" name="ping">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit: ping">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:bot.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;ping&quot;" target="action"/>
          <zeebe:input source="={ message: string(message) }" target="payload"/>
          <zeebe:output source="=emitted" target="auditEmitted"/>
          <zeebe:output source="=rkey"    target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
