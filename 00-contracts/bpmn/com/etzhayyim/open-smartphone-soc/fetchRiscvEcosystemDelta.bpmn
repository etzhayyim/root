<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_smartphone_soc_fetch_riscv_ecosystem_delta" targetNamespace="https://etzhayyim.ai/bpmn/open-smartphone-soc" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_smartphone_soc_fetch_riscv_ecosystem_delta" name="fetchRiscvEcosystemDelta" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.openSmartphoneSoc.fetchRiscvEcosystemDelta", "version": 1, "resultTimeoutMs": 120000 }
    </bpmn:documentation>

    <!-- R/P7D: fires every Monday at 06:00 UTC -->
    <bpmn:startEvent id="Start" name="weekly Monday 06:00">
      <bpmn:outgoing>Flow_C</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_weekly">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P7D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Manual" name="manual"><bpmn:outgoing>Flow_CM</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_CM" sourceRef="Start_Manual" targetRef="Task_Fetch"/>
    <bpmn:sequenceFlow id="Flow_C" sourceRef="Start" targetRef="Task_Fetch"/>

    <!-- Step 1: fetch RISC-V exchange JSON feed -->
    <bpmn:serviceTask id="Task_Fetch" name="fetch riscv.org exchange">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.http.fetch" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;https://riscv.org/exchange/?format=json&quot;" target="url"/>
          <zeebe:input source="=&quot;GET&quot;" target="method"/>
          <zeebe:input source="=30" target="timeoutSec"/>
          <zeebe:output source="=bodyText" target="responseBody"/>
          <zeebe:output source="=status"   target="fetchStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_C</bpmn:incoming>
      <bpmn:incoming>Flow_CM</bpmn:incoming>
      <bpmn:outgoing>Flow_L</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_L" sourceRef="Task_Fetch" targetRef="Task_Parse"/>

    <!-- Step 2: extract new RISC-V chip releases via LLM structured output -->
    <bpmn:serviceTask id="Task_Parse" name="LLM extract releases">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.json"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;classifier&quot;" target="tier"/>
          <zeebe:input source="=&quot;You are a RISC-V ecosystem analyst. Extract new chip releases from the provided content. Output ONE JSON object matching the schema exactly. JSON only, no prose.&quot;" target="system"/>
          <zeebe:input source="=&quot;Extract new RISC-V chip releases from: &quot; + responseBody" target="user"/>
          <zeebe:input source="={type: &quot;object&quot;, properties: {releases: {type: &quot;array&quot;, items: {type: &quot;object&quot;, properties: {name: {type: &quot;string&quot;}, vendor: {type: &quot;string&quot;}, processNm: {type: &quot;integer&quot;}, openRtl: {type: &quot;boolean&quot;}}}}}}" target="schema"/>
          <zeebe:input source="=1000" target="maxTokens"/>
          <zeebe:input source="=0.1" target="temperature"/>
          <zeebe:output source="=ok"        target="llmOk"/>
          <zeebe:output source="=data"      target="parsed"/>
          <zeebe:output source="=model"     target="llmModel"/>
          <zeebe:output source="=latencyMs" target="llmLatencyMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_L</bpmn:incoming>
      <bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Parse" targetRef="Task_Audit"/>

    <!-- Step 3: emit audit event with release count -->
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-smartphone-soc.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;open.smartphoneSoc.fetchRiscvEcosystemDelta&quot;" target="action"/>
          <zeebe:input source="={count: count(parsed.releases), fetchStatus: fetchStatus, llmOk: llmOk, llmModel: llmModel}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
