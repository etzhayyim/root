<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_lei_register_org_unit"
    targetNamespace="https://etzhayyim.ai/bpmn/open-lei"
    exporter="hand-written" exporterVersion="2.0">
  <bpmn:process id="open_lei_register_org_unit" name="Org Unit 登録" isExecutable="true">

    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Register"/>

    <!-- Compute path/level from parent context and INSERT vertex_org_unit + edge -->
    <bpmn:serviceTask id="Task_Register" name="Org Unit 登録">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="openLei.org.register"/>
        <zeebe:ioMapping>
          <zeebe:input source="=lei"              target="lei"/>
          <zeebe:input source="=leiVertexId"      target="leiVertexId"/>
          <zeebe:input source="=orgType"          target="orgType"/>
          <zeebe:input source="=name"             target="name"/>
          <zeebe:input source="=nameEn"           target="nameEn"/>
          <zeebe:input source="=parentOrgVid"     target="parentOrgVid"/>
          <zeebe:input source="=code"             target="code"/>
          <zeebe:input source="=purpose"          target="purpose"/>
          <zeebe:input source="=url"              target="url"/>
          <zeebe:input source="=validFrom"        target="validFrom"/>
          <zeebe:input source="=props"            target="props"/>
          <zeebe:input source="=if dryRun = true then true else false" target="dryRun"/>
          <zeebe:output source="=ok"              target="registerOk"/>
          <zeebe:output source="=vertexId"        target="orgUnitVid"/>
          <zeebe:output source="=code"            target="orgCode"/>
          <zeebe:output source="=path"            target="orgPath"/>
          <zeebe:output source="=level"           target="orgLevel"/>
          <zeebe:output source="=error"           target="registerError"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Gate" sourceRef="Task_Register" targetRef="GW_Ok"/>

    <bpmn:exclusiveGateway id="GW_Ok" default="Flow_Audit">
      <bpmn:incoming>Flow_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Err</bpmn:outgoing>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Err" sourceRef="GW_Ok" targetRef="End_Err">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=registerOk = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="GW_Ok" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit openLei.org.register">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-lei.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openLei.org.register&quot;"    target="action"/>
          <zeebe:input source="={vertexId: orgUnitVid, lei: lei, orgType: orgType, path: orgPath, level: orgLevel, dryRun: dryRun}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End_Ok"/>

    <bpmn:endEvent id="End_Ok"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_Err"><bpmn:incoming>Flow_Err</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
