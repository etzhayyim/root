<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_lei_register_legal_entity"
    targetNamespace="https://etzhayyim.ai/bpmn/open-lei"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_lei_register_legal_entity" name="LEI 登録" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Lifecycle"/>

    <!--
      lifecycleState:
        active  : registrationStatus = "ISSUED"
        lapsed  : registrationStatus in {"LAPSED","PENDING_TRANSFER","DUPLICATE"}
        retired : registrationStatus in {"RETIRED","MERGED"}
      requireRenewal = lapsed
    -->
    <bpmn:serviceTask id="Task_Lifecycle" name="lifecycle 判定">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT 1 AS ok LIMIT 1&quot;" target="query"/>
          <zeebe:input source="=[]" target="params"/>
          <zeebe:output source="=if registrationStatus = &quot;ISSUED&quot; then &quot;active&quot;
                                else if list contains([&quot;RETIRED&quot;,&quot;MERGED&quot;], registrationStatus) then &quot;retired&quot;
                                else &quot;lapsed&quot;" target="lifecycleState"/>
          <zeebe:output source="=list contains([&quot;LAPSED&quot;,&quot;PENDING_TRANSFER&quot;,&quot;DUPLICATE&quot;], registrationStatus)" target="requireRenewal"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_Save</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Save" sourceRef="Task_Lifecycle" targetRef="Task_Save"/>

    <bpmn:serviceTask id="Task_Save" name="entity 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_lei_entity&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id: vertexId, lei: lei, legal_name: legalName,
              country: country, legal_form: legalForm,
              registration_authority: registrationAuthority,
              registration_status: registrationStatus,
              issued_at: issuedAt, next_renewal_at: nextRenewalAt,
              status: lifecycleState, created_at: string(now()),
              owner_did: callerDid, sensitivity_ord: 1,
              org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-lei&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Save</bpmn:incoming><bpmn:outgoing>Flow_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Gate" sourceRef="Task_Save" targetRef="Gate"/>

    <bpmn:exclusiveGateway id="Gate" default="Flow_OK">
      <bpmn:incoming>Flow_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Renew</bpmn:outgoing>
      <bpmn:outgoing>Flow_OK</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Renew" sourceRef="Gate" targetRef="Task_AuditRenew">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=requireRenewal = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OK" sourceRef="Gate" targetRef="Task_AuditOk"/>

    <bpmn:serviceTask id="Task_AuditRenew" name="audit lei.renewalRequired">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-lei.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openLei.lei.renewalRequired&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, lei: lei, registrationStatus: registrationStatus, lifecycleState: lifecycleState}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Renew</bpmn:incoming><bpmn:outgoing>Flow_ER</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ER" sourceRef="Task_AuditRenew" targetRef="End_R"/>

    <bpmn:serviceTask id="Task_AuditOk" name="audit lei.register">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-lei.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openLei.lei.register&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, lei: lei, lifecycleState: lifecycleState, country: country}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_OK</bpmn:incoming><bpmn:outgoing>Flow_EA</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EA" sourceRef="Task_AuditOk" targetRef="End_A"/>

    <bpmn:endEvent id="End_A"><bpmn:incoming>Flow_EA</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_R"><bpmn:incoming>Flow_ER</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
