<?xml version="1.0" encoding="UTF-8"?>
<!--
  Graph expansion tick — ADR 2605011200.

  Every 30 minutes (and on-demand via XRPC), pick ONE stale vertex_actor row,
  ask the classifier-tier LLM to propose ONE related vertex/edge, and write
  the proposal into vertex_graph_expand_proposal (status='proposed').

  Never writes edge_* directly — promotion is a separate downstream step.

  NSID:      com.etzhayyim.apps.graph.expandTick
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/graph-expandTick-v1
  binding allowlist: vertex_graph_expand_proposal
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_graph_expand_tick"
    targetNamespace="https://etzhayyim.ai/bpmn/graph"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="graph_expand_tick" name="graph expand tick" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.graph.expandTick", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start_Timer" name="every 30 minutes">
      <bpmn:outgoing>Flow_Timer</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_PT30M">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">R/PT30M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Manual" name="manual / on-demand">
      <bpmn:outgoing>Flow_Manual</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Timer"  sourceRef="Start_Timer"  targetRef="Task_Pick"/>
    <bpmn:sequenceFlow id="Flow_Manual" sourceRef="Start_Manual" targetRef="Task_Pick"/>

    <!--
      Task 1 — pick ONE stale vertex_actor row that we haven't proposed for in
      the last 7 days under the same llm_model. Conservative: LIMIT 1.
    -->
    <bpmn:serviceTask id="Task_Pick" name="pick stale vertex_actor seed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT vertex_id, COALESCE(display_name, name, handle, '') AS label, COALESCE(category, classification, '') AS summary FROM vertex_actor WHERE display_name IS NOT NULL ORDER BY _seq DESC LIMIT 1&quot;" target="sql"/>
          <zeebe:input source="=[]" target="params"/>
          <zeebe:output source="=rows" target="seedRows"/>
          <zeebe:output source="=rowCount" target="seedCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Timer</bpmn:incoming>
      <bpmn:incoming>Flow_Manual</bpmn:incoming>
      <bpmn:outgoing>Flow_Pick_Infer</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Pick_Infer" sourceRef="Task_Pick" targetRef="Task_Infer"/>

    <!--
      Task 2 — ask the classifier-tier LLM for ONE proposal in strict JSON.
      Empty seed (seedCount = 0) still calls LLM with empty user prompt —
      generic.llm.json returns {ok:false, error:...} which we still record
      in audit so we can spot saturation. Optional optimisation: gateway
      with seedCount > 0 (defer).
    -->
    <bpmn:serviceTask id="Task_Infer" name="LLM propose one related vertex/edge">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.json"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;classifier&quot;" target="tier"/>
          <zeebe:input source="=&quot;You expand a knowledge graph. Output ONE JSON object only, no preamble. Schema: {dstLabel:string,edgeKind:string,confidence:number,rationale:string}. edgeKind must be a short snake_case verb. confidence in [0,1]. rationale ≤ 240 chars.&quot;" target="system"/>
          <zeebe:input source="=&quot;Source vertex: &quot; + (if seedCount &gt; 0 then seedRows[1].label else &quot;(none)&quot;) + &quot;. Summary: &quot; + (if seedCount &gt; 0 then seedRows[1].summary else &quot;(none)&quot;) + &quot;. Propose ONE most-likely related vertex (concept, organization, technology, person, etc.) and the edge linking them.&quot;" target="user"/>
          <zeebe:input source="=400" target="maxTokens"/>
          <zeebe:input source="=0.1" target="temperature"/>
          <zeebe:output source="=ok"    target="llmOk"/>
          <zeebe:output source="=data"  target="llmData"/>
          <zeebe:output source="=model" target="llmModel"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Pick_Infer</bpmn:incoming>
      <bpmn:outgoing>Flow_Infer_Write</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Infer_Write" sourceRef="Task_Infer" targetRef="Task_Write"/>

    <!--
      Task 3 — INSERT proposal row. Raw SQL path (allowed table guarded by
      vertex_bpmn_lexicon_binding.write_table_allowlist = 'vertex_graph_expand_proposal').
      vertex_id = content-hashed: source_vid + '|' + edgeKind + '|' + dstLabel + '|' + llmModel.
      We let RisingWave PK implicit-upsert dedupe (CLAUDE.md §record-log semantics).
    -->
    <bpmn:serviceTask id="Task_Write" name="insert proposal (status=proposed)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;INSERT INTO vertex_graph_expand_proposal (vertex_id, source_vid, proposed_dst_label, edge_kind, confidence, rationale, llm_model, status, created_at, owner_did, sensitivity_ord, org_id, user_id, actor_id, actor_did, org_did) VALUES ($1, $2, $3, $4, $5, $6, $7, 'proposed', $8, 'did:web:graph.etzhayyim.com', 1, 'did:web:graph.etzhayyim.com', 'did:web:graph.etzhayyim.com', 'sys.bpmn.graph.expand', 'did:web:graph.etzhayyim.com', 'anon')&quot;" target="sql"/>
          <zeebe:input source="=[ &quot;at://did:web:graph.etzhayyim.com/com.etzhayyim.apps.graph.expandProposal/&quot; + (if seedCount &gt; 0 then seedRows[1].vertex_id else &quot;empty&quot;) + &quot;|&quot; + (if llmOk then llmData.edgeKind else &quot;none&quot;) + &quot;|&quot; + (if llmOk then llmData.dstLabel else &quot;none&quot;), if seedCount &gt; 0 then seedRows[1].vertex_id else &quot;&quot;, if llmOk then llmData.dstLabel else &quot;&quot;, if llmOk then llmData.edgeKind else &quot;none&quot;, if llmOk then llmData.confidence else 0.0, if llmOk then llmData.rationale else &quot;llm_failed&quot;, llmModel, string(now()) ]" target="params"/>
          <zeebe:output source="=inserted" target="proposalInserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Infer_Write</bpmn:incoming>
      <bpmn:outgoing>Flow_Write_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Write_Audit" sourceRef="Task_Write" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="emit graph.expand.proposal OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.graph.expand.proposal&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;seedCount&quot;: seedCount, &quot;llmOk&quot;: llmOk, &quot;edgeKind&quot;: if llmOk then llmData.edgeKind else &quot;none&quot;, &quot;confidence&quot;: if llmOk then llmData.confidence else 0.0, &quot;inserted&quot;: proposalInserted }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Write_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_Audit_End</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
