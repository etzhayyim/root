<?xml version="1.0" encoding="UTF-8"?>
<!--
  Business actor autonomous profit settlement.

  Cadence:
    - timer: every 1 hour
    - manual start: operator/API smoke

  Pipeline:
    1. rw.health.probe
    2. business.profit.settleOpenAdnetwork
       - aggregates openAdNetwork impressions for the window
       - writes vertex_open_adnetwork_profit_settlement
       - submits an ActorRuntimeRegistry receipt when chain env is present
    3. generic.audit.emit
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_adnetwork_settle_business_profit" targetNamespace="https://etzhayyim.ai/bpmn/open-adnetwork" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_adnetwork_settle_business_profit" name="settleBusinessProfit" isExecutable="true">
    <bpmn:startEvent id="StartManual" name="manual settle">
      <bpmn:outgoing>Flow_ManualToHealth</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ManualToHealth" sourceRef="StartManual" targetRef="Task_Health"/>

    <bpmn:startEvent id="StartTimer" name="every 1 hour">
      <bpmn:outgoing>Flow_TimerToHealth</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT1H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_TimerToHealth" sourceRef="StartTimer" targetRef="Task_Health"/>

    <bpmn:serviceTask id="Task_Health" name="rw health gate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="rw.health.probe"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ManualToHealth</bpmn:incoming>
      <bpmn:incoming>Flow_TimerToHealth</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSettle</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToSettle" sourceRef="Task_Health" targetRef="Task_Settle"/>

    <bpmn:serviceTask id="Task_Settle" name="settle adnetwork profit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="business.profit.settleOpenAdnetwork"/>
        <zeebe:ioMapping>
          <zeebe:input source="=if settlementId != null then settlementId else &quot;&quot;" target="settlementId"/>
          <zeebe:input source="=if windowHours != null then windowHours else 24" target="windowHours"/>
          <zeebe:input source="=if publisherDid != null then publisherDid else &quot;__all__&quot;" target="publisherDid"/>
          <zeebe:input source="=if publisherSharePct != null then publisherSharePct else 70.0" target="publisherSharePct"/>
          <zeebe:input source="=if minGrossRevenueUsd != null then minGrossRevenueUsd else 0.0" target="minGrossRevenueUsd"/>
          <zeebe:input source="=if submitReceipt != null then submitReceipt else true" target="submitReceipt"/>
          <zeebe:output source="=settlementId" target="profitSettlementId"/>
          <zeebe:output source="=vertexId" target="profitVertexId"/>
          <zeebe:output source="=grossRevenueUsd" target="grossRevenueUsd"/>
          <zeebe:output source="=publisherProfitUsd" target="publisherProfitUsd"/>
          <zeebe:output source="=platformProfitUsd" target="platformProfitUsd"/>
          <zeebe:output source="=chainReceiptSubmitted" target="chainReceiptSubmitted"/>
          <zeebe:output source="=chainReceiptTx" target="chainReceiptTx"/>
          <zeebe:output source="=status" target="profitStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSettle</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Settle" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit profit settlement">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:yoro.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;business.profit.settleOpenAdnetwork&quot;" target="action"/>
          <zeebe:input source="={settlementId: profitSettlementId, vertexId: profitVertexId, status: profitStatus, grossRevenueUsd: grossRevenueUsd, publisherProfitUsd: publisherProfitUsd, platformProfitUsd: platformProfitUsd, chainReceiptSubmitted: chainReceiptSubmitted, chainReceiptTx: chainReceiptTx}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="settled">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
