<?xml version="1.0" encoding="UTF-8"?>
<!--
  Timer-start BPMN — daily Publisher RPM snapshot.

  Pipeline:
    1. generic.db.select   — aggregate impressions + revenue per publisher
                             for the past 24h. Returns rows (all publishers
                             combined; see ADR-2604281900 §Limitations for
                             multi-publisher deferred work).
    2. generic.db.insert   — write a single aggregate revenue_snapshot row
                             (publisher_did = "__all__", date = today).
    3. generic.audit.emit  — OCEL event.

  Note: SQL windowing uses NOW() - INTERVAL '1 day' (SQL-side expression)
  to avoid FEEL-in-SQL quoting issues (advisor 2026-04-28).

  Cadence: R/P1D.
  ADR-2604281900. NSID: com.etzhayyim.apps.openAdnetwork.computePublisherRpm (timer-start, no binding needed).
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_adnetwork_compute_publisher_rpm" targetNamespace="https://etzhayyim.ai/bpmn/open-adnetwork" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_adnetwork_compute_publisher_rpm" name="computePublisherRpm" isExecutable="true">
    <bpmn:startEvent id="StartManual" name="manual recompute">
      <bpmn:outgoing>Flow_ManualToSelect</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ManualToSelect" sourceRef="StartManual" targetRef="Task_Select"/>

    <bpmn:startEvent id="Start" name="every 1 day">
      <bpmn:outgoing>Flow_ToSelect</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToSelect" sourceRef="Start" targetRef="Task_Select"/>

    <bpmn:serviceTask id="Task_Select" name="select publisher impression stats (24h)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT au.publisher_did, COUNT(*) AS impressions, SUM(i.cpm_usd) / 1000.0 AS total_revenue FROM vertex_open_adnetwork_impression i JOIN vertex_open_adnetwork_ad_unit au ON au.unit_id = i.unit_id WHERE i.created_at &gt;= (NOW() - INTERVAL &apos;1 day&apos;)::varchar GROUP BY au.publisher_did LIMIT 1000&quot;" target="query"/>
          <zeebe:output source="=rows" target="publisherStats"/>
          <zeebe:output source="=rowCount" target="publisherCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSelect</bpmn:incoming>
      <bpmn:outgoing>Flow_ToInsert</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToInsert" sourceRef="Task_Select" targetRef="Task_Insert"/>

    <bpmn:serviceTask id="Task_Insert" name="write aggregate revenue snapshot">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_adnetwork_revenue_snapshot&quot;" target="table"/>
          <zeebe:input source="={vertex_id: &quot;at://did:web:open-adnetwork.etzhayyim.com/com.etzhayyim.apps.openAdnetwork.revenueSnapshot/&quot; + string(today()), snap_id: &quot;rpm-&quot; + string(today()), publisher_did: &quot;__all__&quot;, date: string(today()), impressions: if publisherCount &gt; 0 then sum(publisherStats.impressions) else 0, clicks: 0, conversions: 0, total_revenue_usd: if publisherCount &gt; 0 then sum(publisherStats.total_revenue) else 0.0, rpm_usd: if publisherCount &gt; 0 and sum(publisherStats.impressions) &gt; 0 then sum(publisherStats.total_revenue) / sum(publisherStats.impressions) * 1000.0 else 0.0, ctr_pct: 0.0, cvr_pct: 0.0, created_at: string(now()), sensitivity_ord: 0, actor_id: &quot;sys.bpmn.open-adnetwork&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToInsert</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Insert" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit computePublisherRpm">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-adnetwork.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;open.adnetwork.computePublisherRpm&quot;" target="action"/>
          <zeebe:input source="={date: string(today()), publisherCount: publisherCount}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
