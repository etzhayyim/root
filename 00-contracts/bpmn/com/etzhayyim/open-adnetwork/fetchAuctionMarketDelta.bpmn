<?xml version="1.0" encoding="UTF-8"?>
<!--
  Timer-start BPMN — weekly IAB benchmark fetch.

  Pipeline:
    1. generic.http.fetch  — fetch IAB Measurement Benchmark H1 2024
                             (public PDF, used as market CPM reference).
    2. generic.audit.emit  — OCEL event with fetch status.

  Cadence: R/P7D.
  ADR-2604281900.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_adnetwork_fetch_auction_market_delta" targetNamespace="https://etzhayyim.ai/bpmn/open-adnetwork" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_adnetwork_fetch_auction_market_delta" name="fetchAuctionMarketDelta" isExecutable="true">
    <bpmn:startEvent id="Start" name="every 7 days">
      <bpmn:outgoing>Flow_ToFetch</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P7D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToFetch" sourceRef="Start" targetRef="Task_Fetch"/>

    <bpmn:serviceTask id="Task_Fetch" name="fetch IAB benchmark">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.http.fetch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;https://www.iab.com/wp-content/uploads/2024/09/IABMeasurementBenchmark_H12024.pdf&quot;" target="url"/>
          <zeebe:input source="=&quot;GET&quot;" target="method"/>
          <zeebe:output source="=status" target="fetchStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToFetch</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Fetch" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit fetchAuctionMarketDelta">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-adnetwork.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;open.adnetwork.fetchAuctionMarketDelta&quot;" target="action"/>
          <zeebe:input source="={timestamp: string(now()), status: &quot;fetched&quot;, fetchStatus: fetchStatus}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
