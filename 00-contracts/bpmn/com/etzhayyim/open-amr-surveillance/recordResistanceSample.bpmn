<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_amr_surveillance_record_resistance_sample" targetNamespace="https://etzhayyim.ai/bpmn/open-amr-surveillance" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_amr_surveillance_record_resistance_sample" name="recordResistanceSample" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_amr_surveillance&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, sample_id: sampleId, pathogen_species: pathogenSpecies, source_compartment: sourceCompartment, country_iso3: countryIso3, antibiotic_class: antibioticClass, resistance_phenotype: resistancePhenotype, mls_type_or_st_like: mlsTypeOrStLike, collected_at: collectedAt, alert_tier: if resistancePhenotype = &quot;pdr&quot; then &quot;critical&quot; else if resistancePhenotype = &quot;xdr&quot; or resistancePhenotype = &quot;mdr&quot; then &quot;high&quot; else if resistancePhenotype = &quot;resistant&quot; then &quot;watch&quot; else &quot;routine&quot;, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-amr-surveillance&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-amr-surveillance.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;open.amrSurveillance.recordResistanceSample&quot;" target="action"/><zeebe:input source="={vertexId: vertexId}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>