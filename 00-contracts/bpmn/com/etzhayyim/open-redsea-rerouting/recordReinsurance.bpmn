<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_redsea_rerouting_reinsurance"
    targetNamespace="https://etzhayyim.ai/bpmn/open-redsea-rerouting"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_redsea_rerouting_reinsurance" name="再保険" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="reinsurance 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_redsea_reinsurance&quot;" target="table"/>
          <zeebe:input source="={vertex_id: vertexId, reinsurance_id: reinsuranceId, insurer_lei: insurerLei, vessel_type: vesselType, original_premium_bps: originalPremiumBps, adjusted_premium_bps: adjustedPremiumBps, premium_delta_bps: adjustedPremiumBps - originalPremiumBps, rate_shock_tier: if (adjustedPremiumBps - originalPremiumBps) &gt;= 200 then &quot;extreme&quot; else if (adjustedPremiumBps - originalPremiumBps) &gt;= 75 then &quot;severe&quot; else if (adjustedPremiumBps - originalPremiumBps) &gt;= 25 then &quot;moderate&quot; else &quot;minor&quot;, require_market_notice: (adjustedPremiumBps - originalPremiumBps) &gt;= 75, effective_from: effectiveFrom, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-redsea-rerouting&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit openRedseaRerouting.reinsurance.record">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-redsea-rerouting.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openRedseaRerouting.reinsurance.record&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, vesselType: vesselType, adjustedPremiumBps: adjustedPremiumBps}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
