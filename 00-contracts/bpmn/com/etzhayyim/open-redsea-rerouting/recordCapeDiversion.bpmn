<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_redsea_rerouting_cape"
    targetNamespace="https://etzhayyim.ai/bpmn/open-redsea-rerouting"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_redsea_rerouting_cape" name="喜望峰迂回" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="cape 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_redsea_cape_diversion&quot;" target="table"/>
          <zeebe:input source="={vertex_id: vertexId, diversion_id: diversionId, imo: imo, original_route: originalRoute, additional_days: additionalDays, additional_cost_usd: additionalCostUsd, bunker_fuel_extra_tonnes: bunkerFuelExtraTonnes, impact_tier: if additionalDays &gt;= 20 then &quot;major&quot; else if additionalDays &gt;= 10 then &quot;moderate&quot; else &quot;minor&quot;, decided_at: decidedAt, status: &quot;committed&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-redsea-rerouting&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit openRedseaRerouting.cape.record">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-redsea-rerouting.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openRedseaRerouting.cape.record&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, diversionId: diversionId, originalRoute: originalRoute}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
