<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_comfyui_openai_image_generation"
    targetNamespace="https://etzhayyim.ai/bpmn/comfyui"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="comfyui_openai_image_generation" name="comfyui OpenAI image generation" isExecutable="true">
    <bpmn:startEvent id="Start" name="image generation requested">
      <bpmn:outgoing>Flow_Generate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Generate" sourceRef="Start" targetRef="Task_Generate"/>
    <bpmn:serviceTask id="Task_Generate" name="generate image via ComfyUI">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="comfyui.openai.generateImage"/>
        <zeebe:ioMapping>
          <zeebe:input source="=request" target="request"/>
          <zeebe:output source="=result" target="result"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Generate</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_Generate" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit ComfyUI generation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:comfyui.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;comfyui.generateImage&quot;" target="action"/>
          <zeebe:input source="={ result: result }" target="payload"/>
          <zeebe:output source="=rkey" target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End" name="image generation completed">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
