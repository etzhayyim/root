<?xml version="1.0" encoding="UTF-8"?>
<!--
  Standalone sketch-to-image. Heavy base64/image handling is delegated to
  the Zeebe Python ComfyUI primitive instead of the appview Worker.
  in:  sketchBase64, prompt?, strength?, steps?
  out: blobCid, meta, latencyMs
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_mangaka_realtime_draw"
    targetNamespace="https://etzhayyim.ai/bpmn/mangaka"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="mangaka_realtime_draw" name="mangaka realtime sketch to image" isExecutable="true">
    <bpmn:startEvent id="Start" name="sketch requested">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Render"/>
    <bpmn:serviceTask id="Task_Render" name="render sketch img2img">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.comfyui.call"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;/v1/images/edits&quot;" target="route"/>
          <zeebe:input source="={
              image: string(sketchBase64),
              prompt: if prompt = null then &quot;1girl, masterpiece, best quality, anime, manga style&quot; else string(prompt),
              negative_prompt: &quot;lowres, bad anatomy, bad hands, text, watermark, blurry, jpeg artifacts, extra limbs&quot;,
              strength: if strength = null then 0.7 else strength,
              steps: if steps = null then 20 else steps
          }" target="body"/>
          <zeebe:input source="=&quot;binary&quot;" target="outputFormat"/>
          <zeebe:input source="=180" target="timeoutSec"/>
          <zeebe:output source="=blobCid" target="blobCid"/>
          <zeebe:output source="=meta" target="meta"/>
          <zeebe:output source="=latencyMs" target="latencyMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Render" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:mangaka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;realtimeDraw&quot;" target="action"/>
          <zeebe:input source="={blobCid: string(blobCid), latencyMs: latencyMs, strength: (if strength = null then 0.7 else strength), steps: (if steps = null then 20 else steps)}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>F3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
