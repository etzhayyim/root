<?xml version="1.0" encoding="UTF-8"?>
<!--
  Standalone storyboard director. Appview dispatches only; Python Zeebe LLM
  primitive handles JSON generation and parsing.
  in:  story
  out: storyboardData
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_mangaka_storyboard_standalone"
    targetNamespace="https://etzhayyim.ai/bpmn/mangaka"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="mangaka_storyboard_standalone" name="mangaka standalone storyboard" isExecutable="true">
    <bpmn:startEvent id="Start" name="storyboard requested">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Storyboard"/>
    <bpmn:serviceTask id="Task_Storyboard" name="draft panel prompts">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.json"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;classifier&quot;" target="tier"/>
          <zeebe:input source="=&quot;You are a professional manga storyboard director. Break the story into 4-6 manga panels. Output ONE JSON object {panels:[{prompt:string}]} only. Each prompt must describe pose, camera angle, expression, background, and action. No prose outside JSON.&quot;" target="system"/>
          <zeebe:input source="=string(story)" target="user"/>
          <zeebe:input source="=1000" target="maxTokens"/>
          <zeebe:input source="=0.4" target="temperature"/>
          <zeebe:output source="=data" target="storyboardData"/>
          <zeebe:output source="=model" target="model"/>
          <zeebe:output source="=latencyMs" target="latencyMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Storyboard" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:mangaka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;storyboard&quot;" target="action"/>
          <zeebe:input source="={model: string(model), latencyMs: latencyMs}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>F3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
