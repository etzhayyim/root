<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stage 7 / 8 — compose final page. ADR-2604231328 applied to mangaka.
  Loads approved toned panels + lettering overlays for a page and calls
  ComfyUI /v1/images/edits composite mode.
  in:  pageId, gutterPx, pageSize
  out: pageCompositeVertexId, blobCid, panelCount
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_mangaka_compose_page"
    targetNamespace="https://etzhayyim.ai/bpmn/mangaka"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="mangaka_compose_page" name="mangaka compose page" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_LoadPanels"/>
    <bpmn:serviceTask id="Task_LoadPanels" name="load approved toned panels">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_mangaka&quot;" target="table"/>
          <zeebe:input source="=&quot;page_id = %s AND kind = %s AND priority = %s&quot;" target="whereExpr"/>
          <zeebe:input source="=[pageId, &quot;tonedPanel&quot;, &quot;approved&quot;]" target="whereParams"/>
          <zeebe:input source="=&quot;vertex_id, target_uri, panel_num, image_cid&quot;" target="columns"/>
          <zeebe:input source="=50" target="limit"/>
          <zeebe:input source="=&quot;panel_num ASC&quot;" target="orderBy"/>
          <zeebe:output source="=rows" target="panelRows"/>
          <zeebe:output source="=rowCount" target="panelCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_LoadPanels" targetRef="Task_LoadOverlays"/>
    <bpmn:serviceTask id="Task_LoadOverlays" name="load lettering overlays">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_mangaka&quot;" target="table"/>
          <zeebe:input source="=&quot;page_id = %s AND kind = %s&quot;" target="whereExpr"/>
          <zeebe:input source="=[pageId, &quot;lettering&quot;]" target="whereParams"/>
          <zeebe:input source="=&quot;vertex_id, target_uri, description&quot;" target="columns"/>
          <zeebe:input source="=50" target="limit"/>
          <zeebe:output source="=rows" target="overlayRows"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_LoadOverlays" targetRef="Task_Compose"/>
    <bpmn:serviceTask id="Task_Compose" name="compose page (ComfyUI)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.comfyui.call"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;/v1/images/edits&quot;" target="route"/>
          <zeebe:input source="={
              mode: &quot;composite_page&quot;,
              page_id: string(pageId),
              page_size: if pageSize = null then &quot;b5&quot; else string(pageSize),
              gutter_px: if gutterPx = null then 24 else gutterPx,
              panels: panelRows,
              overlays: overlayRows
          }" target="body"/>
          <zeebe:input source="=&quot;binary&quot;" target="outputFormat"/>
          <zeebe:input source="=240" target="timeoutSec"/>
          <zeebe:output source="=blobCid" target="blobCid"/>
          <zeebe:output source="=latencyMs" target="renderMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Compose" targetRef="Task_Insert"/>
    <bpmn:serviceTask id="Task_Insert" name="persist composedPage">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_mangaka&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:  &quot;at://did:web:mangaka.etzhayyim.com/com.etzhayyim.apps.mangaka.composedPage/&quot; + string(pageId),
              owner_did:  &quot;did:web:mangaka.etzhayyim.com&quot;,
              repo:       &quot;did:web:mangaka.etzhayyim.com&quot;,
              collection: &quot;com.etzhayyim.apps.mangaka.composedPage&quot;,
              rkey:       string(pageId),
              kind:       &quot;composedPage&quot;,
              page_id:    string(pageId),
              stage:      &quot;compose&quot;,
              method:     &quot;aiCompose&quot;,
              priority:   &quot;review&quot;,
              description: &quot;page composite, &quot; + string(panelCount) + &quot; panels&quot;,
              image_cid:  string(blobCid),
              sensitivity_ord: 10}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
          <zeebe:output source="=inserted" target="inserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Insert" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:mangaka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;composePage&quot;" target="action"/>
          <zeebe:input source="={pageId: string(pageId), panelCount: panelCount, blobCid: string(blobCid), renderMs: renderMs}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>F6</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
