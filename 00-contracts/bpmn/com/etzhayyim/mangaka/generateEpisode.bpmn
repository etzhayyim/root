<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stage 0 / mangaka — full episode autopilot (batch).
  ADR-0057. Wraps v3 bash pipeline (gen_script.py + batchRender + balloon overlay
  + page compose + multi-record write + social post) as a single BPMN process.

  Why this differs from the existing 8-stage HITL pipeline (generateScript /
  breakdownPage / generatePanel / inkPanel / letterPanel / applyTone /
  composePage / publishChapterPipeline): those require editor curation
  (3-candidate panel pick, ink/tone hand-tuning). This process is autopilot —
  full automation for the shinshi character roster, ~7 min per episode on
  RTX 4090. Both can coexist; this one is the default for /loop and timer-start.

  Trigger:
    1. XRPC: POST /xrpc/com.etzhayyim.apps.mangaka.generateEpisode (manual + MCP)
    2. Timer: episodeAutopilot.bpmn R/PT1H call activity

  Wire:
    Start
      → Task_Script           (generic.llm.json — RunPod Qwen 14B, 20 pages × 3-5 panels)
      → Audit_Script          (audit.emit "mangaka.scriptGenerated")
      → Task_BatchRender      (mangaka.panel.batchRender — submit 76 + poll until done)
      → Audit_Render          (audit.emit "mangaka.panelsRendered")
      → Task_BatchOverlay     (mangaka.balloon.batchOverlay — Pillow speech balloons)
      → Audit_Overlay         (audit.emit "mangaka.balloonsOverlaid")
      → Task_BatchCompose     (mangaka.page.batchCompose — Pillow grid + upload 20 pages)
      → Audit_Compose         (audit.emit "mangaka.pagesComposed")
      → Task_WriteWork        (generic.db.insert vertex_mangaka kind=work)
      → Task_WritePages       (mangaka.records.batchInsertPages — 20 page rows)
      → Audit_Domain          (audit.emit "mangaka.domainRecordsCreated")
      → Task_SocialPost       (generic.pds.dispatch app.bsky.feed.post recordWithMedia)
      → Audit_Final           (audit.emit "mangaka.episodePublished")
      → End

  in:  charSlug, charName, appearance, genre, setting (optional), checkpoint (optional)
  out: episodeUri, postUri, pageCount, panelCount, processInstanceKey
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_mangaka_generate_episode"
    targetNamespace="https://etzhayyim.ai/bpmn/mangaka"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="mangaka_generate_episode" name="mangaka generate episode (autopilot)" isExecutable="true">

    <bpmn:startEvent id="Start" name="episode requested">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Script"/>

    <!-- ── Phase 1: LLM script generation (RunPod Qwen 14B via generic.llm.json) ── -->
    <bpmn:serviceTask id="Task_Script" name="generate 20-page script (Qwen 14B)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.json"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;deep&quot;" target="tier"/>
          <zeebe:input source="=&quot;You are a Japanese manga editor. Output ONE JSON object: {episodeId,title,protagonist,setting,genre,negativePrompt,pages:[{pageNum:1..20,act:&apos;1-起&apos;|&apos;2-承&apos;|&apos;3-転&apos;|&apos;4-結&apos;,panels:[{panelNum:1..N,prompt:string(SDXL English),dialogue:[{speaker,text(Japanese),balloonType:&apos;normal&apos;|&apos;sfx&apos;|&apos;narration&apos;}]}]}]}. Pages 1-5 act 1, 6-10 act 2, 11-15 act 3, 16-20 act 4. Each page 3-5 panels. JSON only.&quot;" target="system"/>
          <zeebe:input source="=&quot;Character: &quot; + string(charName) + &quot; (&quot; + string(appearance) + &quot;)\nGenre: &quot; + string(genre) + &quot;\nSetting: &quot; + string(setting) + &quot;\nGenerate the 20-page script now.&quot;" target="user"/>
          <zeebe:input source="=8000" target="maxTokens"/>
          <zeebe:input source="=0.7" target="temperature"/>
          <zeebe:output source="=data" target="scriptJson"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Script" targetRef="Gate_ScriptReady"/>

    <bpmn:exclusiveGateway id="Gate_ScriptReady" name="script ready?" default="F2_ScriptFailed">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F2_ScriptReady</bpmn:outgoing>
      <bpmn:outgoing>F2_ScriptFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F2_ScriptReady" sourceRef="Gate_ScriptReady" targetRef="Audit_Script">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=scriptJson != null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F2_ScriptFailed" sourceRef="Gate_ScriptReady" targetRef="Audit_ScriptFailed"/>

    <bpmn:serviceTask id="Audit_ScriptFailed" name="audit script failed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:mangaka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;mangaka.scriptGenerationFailed&quot;" target="action"/>
          <zeebe:input source="={charSlug: string(charSlug), genre: string(genre), setting: string(setting), status: &quot;script-missing&quot;}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F2_ScriptFailed</bpmn:incoming>
      <bpmn:outgoing>F2_FailedEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F2_FailedEnd" sourceRef="Audit_ScriptFailed" targetRef="End"/>

    <bpmn:serviceTask id="Audit_Script" name="audit script">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:mangaka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;mangaka.scriptGenerated&quot;" target="action"/>
          <zeebe:input source="={
              case_id: string(charSlug) + &quot;-&quot; + string(now()),
              charSlug: string(charSlug),
              genre: string(genre),
              setting: string(setting),
              pageCount: 20,
              objectRefs: { Episode: &quot;pending&quot;, Character: &quot;did:web:sh1n5h1x.etzhayyim.com:&quot; + string(charSlug), Setting: string(setting) }
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F3" sourceRef="Audit_Script" targetRef="Task_BatchRender"/>

    <!-- ── Phase 2: Batch panel render (mangaka primitive — submits all + polls) ── -->
    <bpmn:serviceTask id="Task_BatchRender" name="render 76 panels (ComfyUI batch)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mangaka.panel.batchRender"/>
        <zeebe:ioMapping>
          <zeebe:input source="=scriptJson" target="script"/>
          <zeebe:input source="=string(checkpoint)" target="checkpoint"/>
          <zeebe:input source="=string(charSlug)" target="charSlug"/>
          <zeebe:output source="=panelBlobKeys" target="panelBlobKeys"/>
          <zeebe:output source="=panelCount" target="panelCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_BatchRender" targetRef="Audit_Render"/>

    <bpmn:serviceTask id="Audit_Render" name="audit render">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:mangaka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;mangaka.panelsRendered&quot;" target="action"/>
          <zeebe:input source="={
              case_id: string(charSlug) + &quot;-&quot; + string(now()),
              panelCount: panelCount,
              checkpoint: string(checkpoint)
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F5" sourceRef="Audit_Render" targetRef="Task_BatchOverlay"/>

    <!-- ── Phase 3: Speech balloon overlay (Pillow per-panel) ── -->
    <bpmn:serviceTask id="Task_BatchOverlay" name="overlay speech balloons (Pillow)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mangaka.balloon.batchOverlay"/>
        <zeebe:ioMapping>
          <zeebe:input source="=scriptJson" target="script"/>
          <zeebe:input source="=panelBlobKeys" target="panelBlobKeys"/>
          <zeebe:output source="=overlayBlobKeys" target="overlayBlobKeys"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F6" sourceRef="Task_BatchOverlay" targetRef="Audit_Overlay"/>

    <bpmn:serviceTask id="Audit_Overlay" name="audit overlay">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:mangaka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;mangaka.balloonsOverlaid&quot;" target="action"/>
          <zeebe:input source="={case_id: string(charSlug) + &quot;-&quot; + string(now()), panelCount: panelCount}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F7" sourceRef="Audit_Overlay" targetRef="Task_BatchCompose"/>

    <!-- ── Phase 4: Page composition (Pillow grid + PDS uploadBlob × 20) ── -->
    <bpmn:serviceTask id="Task_BatchCompose" name="compose 20 pages + upload">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mangaka.page.batchCompose"/>
        <zeebe:ioMapping>
          <zeebe:input source="=scriptJson" target="script"/>
          <zeebe:input source="=overlayBlobKeys" target="overlayBlobKeys"/>
          <zeebe:output source="=pageBlobKeys" target="pageBlobKeys"/>
          <zeebe:output source="=pageSizes" target="pageSizes"/>
          <zeebe:output source="=coverCid" target="coverCid"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F8" sourceRef="Task_BatchCompose" targetRef="Audit_Compose"/>

    <bpmn:serviceTask id="Audit_Compose" name="audit compose">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:mangaka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;mangaka.pagesComposed&quot;" target="action"/>
          <zeebe:input source="={case_id: string(charSlug) + &quot;-&quot; + string(now()), pageCount: 20, coverCid: string(coverCid)}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F9" sourceRef="Audit_Compose" targetRef="Task_WriteWork"/>

    <!-- ── Phase 5: Domain records — work + 20 pages (vertex_mangaka, ADR-0036) ── -->
    <bpmn:serviceTask id="Task_WriteWork" name="write work record (vertex_mangaka kind=work)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_mangaka&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:      &quot;at://did:web:mangaka.etzhayyim.com/com.etzhayyim.apps.mangaka.work/&quot; + string(charSlug) + &quot;-&quot; + string(now()),
              owner_did:      &quot;did:web:mangaka.etzhayyim.com&quot;,
              repo:           &quot;did:web:mangaka.etzhayyim.com&quot;,
              did:            &quot;did:web:mangaka.etzhayyim.com:work:&quot; + string(charSlug),
              collection:     &quot;com.etzhayyim.apps.mangaka.work&quot;,
              rkey:           string(charSlug) + &quot;-&quot; + string(now()),
              kind:           &quot;work&quot;,
              title:          string(charName) + &quot; 編 - &quot; + string(setting),
              description:    string(setting),
              stage:          &quot;published&quot;,
              sensitivity_ord: 10
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
          <zeebe:output source="=inserted" target="workInserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F10" sourceRef="Task_WriteWork" targetRef="Task_WritePages"/>

    <bpmn:serviceTask id="Task_WritePages" name="write 20 page records">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mangaka.records.batchInsertPages"/>
        <zeebe:ioMapping>
          <zeebe:input source="=string(charSlug)" target="charSlug"/>
          <zeebe:input source="=scriptJson" target="script"/>
          <zeebe:input source="=pageBlobKeys" target="pageBlobKeys"/>
          <zeebe:input source="=pageSizes" target="pageSizes"/>
          <zeebe:output source="=workVertexId" target="workVertexId"/>
          <zeebe:output source="=pageVertexIds" target="pageVertexIds"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F11" sourceRef="Task_WritePages" targetRef="Audit_Domain"/>

    <bpmn:serviceTask id="Audit_Domain" name="audit domain">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:mangaka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;mangaka.domainRecordsCreated&quot;" target="action"/>
          <zeebe:input source="={
              case_id: string(charSlug) + &quot;-&quot; + string(now()),
              workVertexId: string(workVertexId),
              pageCount: 20
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F12" sourceRef="Audit_Domain" targetRef="Task_SocialPost"/>

    <!-- ── Phase 6: Social post (PDS createRecord with recordWithMedia + facets) ── -->
    <bpmn:serviceTask id="Task_SocialPost" name="publish social post">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mangaka.post.publish"/>
        <zeebe:ioMapping>
          <zeebe:input source="=string(workVertexId)" target="workUri"/>
          <zeebe:input source="=string(charName)" target="charName"/>
          <zeebe:input source="=string(charSlug)" target="charSlug"/>
          <zeebe:input source="=string(genre)" target="genre"/>
          <zeebe:input source="=string(setting)" target="setting"/>
          <zeebe:input source="=pageBlobKeys" target="pageBlobKeys"/>
          <zeebe:input source="=pageSizes" target="pageSizes"/>
          <zeebe:input source="=panelCount" target="panelCount"/>
          <zeebe:output source="=postUri" target="postUri"/>
          <zeebe:output source="=postCid" target="postCid"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F13" sourceRef="Task_SocialPost" targetRef="Audit_Final"/>

    <bpmn:serviceTask id="Audit_Final" name="audit episode published">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:mangaka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;mangaka.episodePublished&quot;" target="action"/>
          <zeebe:input source="={
              case_id: string(charSlug) + &quot;-&quot; + string(now()),
              workVertexId: string(workVertexId),
              postUri: string(postUri),
              postCid: string(postCid),
              pageCount: 20,
              panelCount: panelCount,
              status: &quot;ok&quot;
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F14" sourceRef="Audit_Final" targetRef="End"/>

    <bpmn:endEvent id="End" name="episode published">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:incoming>F2_FailedEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
