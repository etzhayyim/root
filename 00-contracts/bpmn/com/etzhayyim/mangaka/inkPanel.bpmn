<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stage 4 / 8 — inking pass (ペン入れ). ADR-2604231328 applied to mangaka.
  ControlNet-lineart + img2img on the approved panel candidate.
  in:  panelUri (approved Stage 3 output), linewidth
  out: inkedVertexId, blobCid
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_mangaka_ink_panel"
    targetNamespace="https://etzhayyim.ai/bpmn/mangaka"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="mangaka_ink_panel" name="mangaka ink panel" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Ink"/>
    <bpmn:serviceTask id="Task_Ink" name="ink pass (ControlNet-lineart)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.comfyui.call"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;/v1/images/edits&quot;" target="route"/>
          <zeebe:input source="={
              model: &quot;animagine-xl-4&quot;,
              edit_mode: &quot;ink&quot;,
              source_uri: string(panelUri),
              controlnet: { model: &quot;controlnet-lineart-sdxl&quot;, weight: 1.1 },
              prompt: &quot;clean manga ink line art, black and white, &quot; + (if linewidth = null then &quot;medium&quot; else string(linewidth)) + &quot; weight, no color, no halftone, no text&quot;,
              negative_prompt: &quot;color, halftone, screentone, text, watermark&quot;,
              steps: 22,
              cfg_scale: 5.5
          }" target="body"/>
          <zeebe:input source="=&quot;binary&quot;" target="outputFormat"/>
          <zeebe:input source="=150" target="timeoutSec"/>
          <zeebe:output source="=blobCid" target="blobCid"/>
          <zeebe:output source="=latencyMs" target="renderMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Ink" targetRef="Task_Insert"/>
    <bpmn:serviceTask id="Task_Insert" name="persist inkedPanel">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_mangaka&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:  &quot;at://did:web:mangaka.etzhayyim.com/com.etzhayyim.apps.mangaka.inkedPanel/&quot; + string(panelUri),
              owner_did:  &quot;did:web:mangaka.etzhayyim.com&quot;,
              repo:       &quot;did:web:mangaka.etzhayyim.com&quot;,
              collection: &quot;com.etzhayyim.apps.mangaka.inkedPanel&quot;,
              rkey:       string(panelUri),
              kind:       &quot;inkedPanel&quot;,
              target_uri: string(panelUri),
              stage:      &quot;ink&quot;,
              method:     &quot;aiInk&quot;,
              priority:   &quot;review&quot;,
              image_cid:  string(blobCid),
              sensitivity_ord: 10}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
          <zeebe:output source="=inserted" target="inserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Insert" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:mangaka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;inkPanel&quot;" target="action"/>
          <zeebe:input source="={panelUri: string(panelUri), blobCid: string(blobCid), renderMs: renderMs}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>F4</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
