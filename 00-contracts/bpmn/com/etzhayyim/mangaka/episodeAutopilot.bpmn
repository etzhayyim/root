<?xml version="1.0" encoding="UTF-8"?>
<!--
  mangaka episode autopilot — picks a random shinshi character once per hour
  and kicks generateEpisode.bpmn. ADR-0057 §Autopilot.

  Timer-start R/PT1H (replaces /loop and any K8s CronJob — ADR-0056 §F4 Timer
  Start replaces K8s CronJob).

  Wire:
    Timer (R/PT1H)
      → Task_PickCharacter (generic.db.select — random shinshi character row)
      → Task_KickEpisode   (call activity → mangaka_generate_episode)
      → Task_Audit         (audit.emit "mangaka.autopilotTick")
      → End
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_mangaka_episode_autopilot"
    targetNamespace="https://etzhayyim.ai/bpmn/mangaka"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="mangaka_episode_autopilot" name="mangaka episode autopilot (R/PT1H)" isExecutable="true">

    <bpmn:startEvent id="Start" name="hourly tick">
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT1H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_PickCharacter"/>

    <!-- Pick a random shinshi character (vertex_shinshi_model row, public sensitivity) -->
    <bpmn:serviceTask id="Task_PickCharacter" name="pick random shinshi character">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT slug AS char_slug, name AS char_name, appearance, genre, setting FROM vertex_shinshi_model WHERE sensitivity_ord &lt;= 10 ORDER BY random() LIMIT 1&quot;" target="sql"/>
          <zeebe:output source="=rows[1].char_slug"  target="charSlug"/>
          <zeebe:output source="=rows[1].char_name"  target="charName"/>
          <zeebe:output source="=rows[1].appearance" target="appearance"/>
          <zeebe:output source="=rows[1].genre"      target="genre"/>
          <zeebe:output source="=rows[1].setting"    target="setting"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_PickCharacter" targetRef="Task_KickEpisode"/>

    <!-- Native Zeebe call activity — child token runs generateEpisode without holding worker slot -->
    <bpmn:callActivity id="Task_KickEpisode" name="generate episode">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="mangaka_generate_episode" propagateAllChildVariables="false"/>
        <zeebe:ioMapping>
          <zeebe:input source="=string(charSlug)"    target="charSlug"/>
          <zeebe:input source="=string(charName)"    target="charName"/>
          <zeebe:input source="=string(appearance)"  target="appearance"/>
          <zeebe:input source="=string(genre)"       target="genre"/>
          <zeebe:input source="=string(setting)"     target="setting"/>
          <zeebe:input source="=&quot;wai-nsfw-illustrious-v60.safetensors&quot;" target="checkpoint"/>
          <zeebe:output source="=string(workVertexId)" target="workVertexId"/>
          <zeebe:output source="=string(postUri)"     target="postUri"/>
          <zeebe:output source="=panelCount"          target="panelCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_KickEpisode" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit autopilot tick">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:mangaka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;mangaka.autopilotTick&quot;" target="action"/>
          <zeebe:input source="={
              case_id: string(charSlug) + &quot;-&quot; + string(now()),
              charSlug: string(charSlug),
              workVertexId: string(workVertexId),
              postUri: string(postUri),
              panelCount: panelCount
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End"><bpmn:incoming>F4</bpmn:incoming></bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
