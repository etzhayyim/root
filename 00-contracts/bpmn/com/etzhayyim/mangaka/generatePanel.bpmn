<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stage 3 / 8 — panel candidate generation (Animagine XL 4.0 @ pod n911oglid03v5n).
  ADR-2604231328 applied to mangaka. HITL gate: caller invokes 3 times
  (candidateNum=1,2,3), editor picks 1 via status=approved.
  in:  pageId, panelNum, panelSummary, candidateNum, characters, cameraAngle
  out: panelVertexId, blobCid, visualPrompt, renderMs
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_mangaka_generate_panel"
    targetNamespace="https://etzhayyim.ai/bpmn/mangaka"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="mangaka_generate_panel" name="mangaka generate panel" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Describe"/>
    <bpmn:serviceTask id="Task_Describe" name="describe panel (Qwen mid)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.chat"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;classifier&quot;" target="tier"/>
          <zeebe:input source="=&quot;You are a manga artist. Output an Animagine XL english prompt (&lt;=120 words) for ONE panel: framing, character pose, expression, background. Black-and-white manga style, clean ink line, halftone screentone, no text, no speech balloons.&quot;" target="system"/>
          <zeebe:input source="=&quot;Panel: &quot; + string(panelSummary) + &quot;\nCharacters: &quot; + (if characters = null then &quot;&quot; else string(characters)) + &quot;\nCamera: &quot; + (if cameraAngle = null then &quot;eye level&quot; else string(cameraAngle)) + &quot;\nCandidate variant: &quot; + string(candidateNum)" target="user"/>
          <zeebe:input source="=400" target="maxTokens"/>
          <zeebe:input source="=0.7" target="temperature"/>
          <zeebe:output source="=content" target="visualPrompt"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Describe" targetRef="Task_Render"/>
    <bpmn:serviceTask id="Task_Render" name="render panel (Animagine XL @ pod n911oglid03v5n)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.comfyui.call"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;/v1/images/generations&quot;" target="route"/>
          <zeebe:input source="={
              model: &quot;animagine-xl-4&quot;,
              prompt: string(visualPrompt) + &quot;, monochrome manga ink, halftone screentone, clean lineart, dynamic speed lines&quot;,
              negative_prompt: &quot;color, photograph, text, watermark, signature, blurry, extra limbs&quot;,
              size: &quot;832x1216&quot;,
              steps: 25,
              cfg_scale: 6.0,
              n: 1
          }" target="body"/>
          <zeebe:input source="=&quot;binary&quot;" target="outputFormat"/>
          <zeebe:input source="=120" target="timeoutSec"/>
          <zeebe:output source="=blobCid" target="blobCid"/>
          <zeebe:output source="=latencyMs" target="renderMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Render" targetRef="Task_Insert"/>
    <bpmn:serviceTask id="Task_Insert" name="persist panel draft">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_mangaka&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:  &quot;at://did:web:mangaka.etzhayyim.com/com.etzhayyim.apps.mangaka.panel/&quot; + string(pageId) + &quot;-p&quot; + string(panelNum) + &quot;-c&quot; + string(candidateNum),
              owner_did:  &quot;did:web:mangaka.etzhayyim.com&quot;,
              repo:       &quot;did:web:mangaka.etzhayyim.com&quot;,
              collection: &quot;com.etzhayyim.apps.mangaka.panel&quot;,
              rkey:       string(pageId) + &quot;-p&quot; + string(panelNum) + &quot;-c&quot; + string(candidateNum),
              kind:       &quot;panel&quot;,
              page_id:    string(pageId),
              panel_num:  panelNum,
              stage:      &quot;panel&quot;,
              method:     &quot;aiDraft&quot;,
              priority:   &quot;draft&quot;,
              description: string(visualPrompt),
              image_cid:  string(blobCid),
              sensitivity_ord: 10}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
          <zeebe:output source="=inserted" target="inserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Insert" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:mangaka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;generatePanel&quot;" target="action"/>
          <zeebe:input source="={pageId: string(pageId), panelNum: panelNum, candidateNum: candidateNum, blobCid: string(blobCid), renderMs: renderMs}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>F5</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
