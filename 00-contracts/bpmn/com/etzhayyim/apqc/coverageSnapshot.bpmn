<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_apqc_coverage_snapshot"
    targetNamespace="https://etzhayyim.ai/bpmn/apqc"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="apqc_coverage_snapshot" name="APQC coverage snapshot" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_Run</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Run" sourceRef="Start" targetRef="Task_Run"/>
    <bpmn:serviceTask id="Task_Run" name="apqc coverage snapshot">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="apqc.coverageSnapshot"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Run</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Run" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
