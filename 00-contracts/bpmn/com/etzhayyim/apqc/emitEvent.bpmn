<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_apqc_emit_event"
    targetNamespace="https://etzhayyim.ai/bpmn/apqc"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="apqc_emit_event" name="APQC OCEL event emit" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_Run</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Run" sourceRef="Start" targetRef="Task_Run"/>
    <bpmn:serviceTask id="Task_Run" name="apqc emit event">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="apqc.emitEvent"/>
        <zeebe:ioMapping>
          <zeebe:input source="=if apqcCode != null then apqcCode else &quot;&quot;" target="apqcCode"/>
          <zeebe:input source="=if eventType != null then eventType else &quot;apqc.activity&quot;" target="eventType"/>
          <zeebe:input source="=if taskId != null then taskId else &quot;&quot;" target="taskId"/>
          <zeebe:input source="=if caseId != null then caseId else &quot;&quot;" target="caseId"/>
          <zeebe:input source="=if objects != null then objects else []" target="objects"/>
          <zeebe:input source="=if attributes != null then attributes else {}" target="attributes"/>
          <zeebe:input source="=if actorDid != null then actorDid else &quot;&quot;" target="actorDid"/>
          <zeebe:input source="=if callerDid != null then callerDid else &quot;&quot;" target="callerDid"/>
          <zeebe:input source="=if dryRun != null then dryRun else false" target="dryRun"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Run</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Run" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
