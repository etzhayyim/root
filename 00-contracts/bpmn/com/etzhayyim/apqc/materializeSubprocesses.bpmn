<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_apqc_materialize_subprocesses"
    targetNamespace="https://etzhayyim.ai/bpmn/apqc"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="apqc_materialize_subprocesses" name="APQC subprocess materialization" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_Run</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Run" sourceRef="Start" targetRef="Task_Run"/>
    <bpmn:serviceTask id="Task_Run" name="apqc materialize subprocesses">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="apqc.materializeSubprocesses"/>
        <zeebe:ioMapping>
          <zeebe:input source="=if apqcCode != null then apqcCode else &quot;&quot;" target="apqcCode"/>
          <zeebe:input source="=if subprocessCode != null then subprocessCode else &quot;&quot;" target="subprocessCode"/>
          <zeebe:input source="=if callerDid != null then callerDid else &quot;&quot;" target="callerDid"/>
          <zeebe:input source="=if dryRun != null then dryRun else false" target="dryRun"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Run</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Run" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
