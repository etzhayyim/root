<?xml version="1.0" encoding="UTF-8"?>
<!--
  kaisya.cooOpsMonitor — etzhayyimcojp Artificial Organism

  Fires every 24h. COO agent (kaisya_coo_agent) runs:
    1. Query agent run status across all 8 agents (last 24h)
    2. Detect any agent errors or long silences (> cadence * 1.5)
    3. Write vertex_kaisya_agent_run log
    4. If ops anomaly detected → create vertex_kaisya_task for COO approval

  NSID: com.etzhayyim.apps.kaisya.cooOpsMonitor
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/kaisya-coo-ops-monitor-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_kaisya_coo_ops"
    targetNamespace="https://etzhayyim.ai/bpmn/kaisya"
    exporter="hand-written"
    exporterVersion="2.0">

  <bpmn:process id="kaisya_coo_ops_monitor" name="kaisya COO Ops Monitor" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.kaisya.cooOpsMonitor", "version": 1, "resultTimeoutMs": 180000 }
    </bpmn:documentation>

    <!-- Timer: every 24h -->
    <bpmn:startEvent id="Start_XRPC" name="every 24h">
      <bpmn:outgoing>Flow_ToAgentStatus</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_24h">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT24H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToAgentStatus" sourceRef="Start_XRPC" targetRef="Task_AgentStatus"/>

    <!-- Step 1: Query all agent run status for last 24h -->
    <bpmn:serviceTask id="Task_AgentStatus" name="query all agent runs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT agent_id, MAX(ran_at) AS last_ran, COUNT(*) AS run_count, SUM(CASE WHEN status = 'error' THEN 1 ELSE 0 END) AS error_count FROM vertex_kaisya_agent_run WHERE ran_at >= NOW() - INTERVAL '48 hours' GROUP BY agent_id&quot;" target="query"/>
          <zeebe:output source="=rows" target="agentStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAgentStatus</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAnalyze</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAnalyze" sourceRef="Task_AgentStatus" targetRef="Task_Analyze"/>

    <!-- Step 2: Analyze ops anomalies -->
    <bpmn:serviceTask id="Task_Analyze" name="COO ops analysis">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kaisya.coo.analyzeOps"/>
        <zeebe:ioMapping>
          <zeebe:input source="=agentStatus"   target="agent_status"/>
          <zeebe:output source="=report_text"      target="reportText"/>
          <zeebe:output source="=anomaly_detected" target="anomalyDetected"/>
          <zeebe:output source="=anomaly_title"    target="anomalyTitle"/>
          <zeebe:output source="=anomaly_context"  target="anomalyContext"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAnalyze</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLog</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToLog" sourceRef="Task_Analyze" targetRef="Task_Log"/>

    <!-- Step 3: Write agent run log -->
    <bpmn:serviceTask id="Task_Log" name="write agent run log">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kaisya.agent.writeRunLog"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;kaisya_coo_agent&quot;"      target="agent_id"/>
          <zeebe:input source="=&quot;kaisya_coo_ops_monitor&quot;" target="process_id"/>
          <zeebe:input source="=&quot;opsMonitor&quot;"             target="task_type"/>
          <zeebe:input source="=reportText"                        target="output_summary"/>
          <zeebe:input source="=if anomalyDetected then 1 else 0"          target="tasks_created_preview"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToLog</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAnomalyCheck</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAnomalyCheck" sourceRef="Task_Log" targetRef="GW_Anomaly"/>

    <bpmn:exclusiveGateway id="GW_Anomaly" name="anomaly?">
      <bpmn:incoming>Flow_ToAnomalyCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTask</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToTask" sourceRef="GW_Anomaly" targetRef="Task_CreateTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=anomalyDetected = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="GW_Anomaly" targetRef="End_Done">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=anomalyDetected = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_CreateTask" name="create COO approval task">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kaisya.agent.createTask"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;kaisya_coo_agent&quot;" target="agent_id"/>
          <zeebe:input source="=anomalyTitle"              target="title"/>
          <zeebe:input source="=anomalyContext"            target="context_json"/>
          <zeebe:input source="=2"                        target="priority"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToTask</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_TaskToEnd" sourceRef="Task_CreateTask" targetRef="End_Done"/>

    <bpmn:endEvent id="End_Done" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
      <bpmn:incoming>Flow_TaskToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
