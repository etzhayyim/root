<?xml version="1.0" encoding="UTF-8"?>
<!--
  kaisya — 法務案件 start flow.

  NSID (path-derived): com.etzhayyim.apps.kaisya.startLegalCase
  Owner DID:           did:web:kaisya.etzhayyim.com
  Process ID:          kaisya_start_legal_case

  Inputs (from dispatcher):
    caseTitle        (str)  e.g. "LingLing v. Gftd"
    caseKind         (str)  litigation | prelitigation | contract-review
    counterparty     (str)
    responsibleDid   (str)  e.g. did:web:k.bakshi.etzhayyim.com
    openerDid        (str)  caller, injected by dispatcher from Service Auth sub
    vertexId         (str)  at://{openerDid}/com.etzhayyim.apps.kaisya.legalCase/{rkey}

  Flow:
    Start → CLO triage (userTask)
          → CEO approval (userTask)
          → audit.emit  (serviceTask, generic)
          → End

  User tasks land in vertex_human_task via the pyzeebe userTask sink
  (50-infra/vultr/bpmn-worker/user_task_sink.py). Forms reference the
  kaisya form JSONs under 60-apps/etzhayyim-project-kaisya/forms/.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_kaisya_start_legal_case"
    targetNamespace="https://etzhayyim.ai/bpmn/kaisya"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="kaisya_start_legal_case" name="法務案件 — 起票 → CLO 分類 → CEO 承認" isExecutable="true">

    <bpmn:startEvent id="Start_XRPC" name="案件発生">
      <bpmn:outgoing>Flow_S</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start_XRPC" targetRef="Task_CLOTriage"/>

    <bpmn:userTask id="Task_CLOTriage" name="CLO 分類・リスク判定">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="embedded:app:forms/legal-case.form.json"/>
        <zeebe:assignmentDefinition candidateGroups="clo"/>
        <zeebe:taskSchedule dueDate="=now() + duration(&quot;P3D&quot;)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming>
      <bpmn:outgoing>Flow_F1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_F1" sourceRef="Task_CLOTriage" targetRef="Task_CEOApproval"/>

    <bpmn:userTask id="Task_CEOApproval" name="CEO 承認">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="embedded:app:forms/final-approval.form.json"/>
        <zeebe:assignmentDefinition candidateGroups="ceo"/>
        <zeebe:taskSchedule dueDate="=now() + duration(&quot;P2D&quot;)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F1</bpmn:incoming>
      <bpmn:outgoing>Flow_F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_F2" sourceRef="Task_CEOApproval" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit: 法務案件 起票">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:kaisya.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;kaisya.startLegalCase.completed&quot;" target="action"/>
          <zeebe:input source="={
              vertexId:       vertexId,
              caseTitle:      caseTitle,
              caseKind:       caseKind,
              counterparty:   counterparty,
              responsibleDid: responsibleDid,
              openerDid:      openerDid,
              triageDecision: string(triageDecision),
              ceoDecision:    string(ceoDecision)
          }" target="payload"/>
          <zeebe:output source="=rkey" target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F2</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End_Done"/>

    <bpmn:endEvent id="End_Done" name="完了">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
