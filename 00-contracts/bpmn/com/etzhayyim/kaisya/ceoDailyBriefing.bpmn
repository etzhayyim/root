<?xml version="1.0" encoding="UTF-8"?>
<!--
  kaisya.ceoDailyBriefing — etzhayyimcojp Artificial Organism

  Fires every 24h. CEO agent (kaisya_ceo_agent) runs:
    1. Query RisingWave for org metrics (agent run counts, pending tasks, infra cost snapshot)
    2. LangGraph strategic synthesis (Shannon η × Well-Becoming 5軸 assessment)
    3. Write vertex_kaisya_agent_run log
    4. If OKR drift detected → create vertex_kaisya_task for CEO approval

  NSID: com.etzhayyim.apps.kaisya.ceoDailyBriefing
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/kaisya-ceo-daily-briefing-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_kaisya_ceo_daily"
    targetNamespace="https://etzhayyim.ai/bpmn/kaisya"
    exporter="hand-written"
    exporterVersion="2.0">

  <bpmn:process id="kaisya_ceo_daily_briefing" name="kaisya CEO Daily Briefing" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.kaisya.ceoDailyBriefing", "version": 1, "resultTimeoutMs": 300000 }
    </bpmn:documentation>

    <!-- Timer: every 24h -->
    <bpmn:startEvent id="Start_XRPC" name="every 24h">
      <bpmn:outgoing>Flow_ToMetrics</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_24h">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT24H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToMetrics" sourceRef="Start_XRPC" targetRef="Task_Metrics"/>

    <!-- Step 1: Collect org metrics from RisingWave -->
    <bpmn:serviceTask id="Task_Metrics" name="collect org metrics">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT agent_id, COUNT(*) AS runs_today, SUM(tasks_created) AS tasks_today FROM vertex_kaisya_agent_run WHERE ran_at >= NOW() - INTERVAL '24 hours' GROUP BY agent_id&quot;" target="query"/>
          <zeebe:output source="=rows" target="agentMetrics"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToMetrics</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPending</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToPending" sourceRef="Task_Metrics" targetRef="Task_Pending"/>

    <!-- Step 2: Count pending tasks per human -->
    <bpmn:serviceTask id="Task_Pending" name="count pending tasks">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT human_did, pending_count, critical_count FROM mv_kaisya_pending_count&quot;" target="query"/>
          <zeebe:output source="=rows" target="pendingCounts"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPending</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSynthesize</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToSynthesize" sourceRef="Task_Pending" targetRef="Task_Synthesize"/>

    <!-- Step 3: LangGraph strategic synthesis (CEO agent) -->
    <bpmn:serviceTask id="Task_Synthesize" name="CEO LangGraph synthesis">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kaisya.ceo.synthesize"/>
        <zeebe:ioMapping>
          <zeebe:input source="=agentMetrics"  target="agent_metrics"/>
          <zeebe:input source="=pendingCounts" target="pending_counts"/>
          <zeebe:output source="=briefing_text"    target="briefingText"/>
          <zeebe:output source="=okr_drift"        target="okrDrift"/>
          <zeebe:output source="=action_required"  target="actionRequired"/>
          <zeebe:output source="=action_title"     target="actionTitle"/>
          <zeebe:output source="=action_context"   target="actionContext"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSynthesize</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLog</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToLog" sourceRef="Task_Synthesize" targetRef="Task_Log"/>

    <!-- Step 4: Write agent run log -->
    <bpmn:serviceTask id="Task_Log" name="write agent run log">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kaisya.agent.writeRunLog"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;kaisya_ceo_agent&quot;"           target="agent_id"/>
          <zeebe:input source="=&quot;kaisya_ceo_daily_briefing&quot;"  target="process_id"/>
          <zeebe:input source="=&quot;dailyBriefing&quot;"              target="task_type"/>
          <zeebe:input source="=briefingText"                          target="output_summary"/>
          <zeebe:input source="=if actionRequired then 1 else 0"               target="tasks_created_preview"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToLog</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDriftCheck</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToDriftCheck" sourceRef="Task_Log" targetRef="GW_Drift"/>

    <!-- Gateway: OKR drift / action required? -->
    <bpmn:exclusiveGateway id="GW_Drift" name="action required?">
      <bpmn:incoming>Flow_ToDriftCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTask</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToTask" sourceRef="GW_Drift" targetRef="Task_CreateTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=actionRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="GW_Drift" targetRef="End_Done">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=actionRequired = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Step 5 (conditional): Create approval task for CEO -->
    <bpmn:serviceTask id="Task_CreateTask" name="create CEO approval task">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kaisya.agent.createTask"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;kaisya_ceo_agent&quot;" target="agent_id"/>
          <zeebe:input source="=actionTitle"               target="title"/>
          <zeebe:input source="=actionContext"             target="context_json"/>
          <zeebe:input source="=1"                        target="priority"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToTask</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_TaskToEnd" sourceRef="Task_CreateTask" targetRef="End_Done"/>

    <bpmn:endEvent id="End_Done" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
      <bpmn:incoming>Flow_TaskToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
