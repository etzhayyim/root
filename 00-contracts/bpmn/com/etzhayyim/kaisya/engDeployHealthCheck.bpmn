<?xml version="1.0" encoding="UTF-8"?>
<!--
  kaisya.engDeployHealthCheck — etzhayyimcojp Artificial Organism

  Fires every 4h. Deploy engineer agent (kaisya_eng_deploy_agent) runs:
    1. Check CF Worker deploy health (wrangler tail / /_app/meta endpoints)
    2. Check RisingWave migration status (pending count from graph-schema)
    3. Write vertex_kaisya_agent_run log
    4. If deploy anomaly → create vertex_kaisya_task for engineer approval

  NSID: com.etzhayyim.apps.kaisya.engDeployHealthCheck
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/kaisya-eng-deploy-health-check-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_kaisya_eng_deploy"
    targetNamespace="https://etzhayyim.ai/bpmn/kaisya"
    exporter="hand-written"
    exporterVersion="2.0">

  <bpmn:process id="kaisya_eng_deploy_health_check" name="kaisya Eng Deploy Health Check" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.kaisya.engDeployHealthCheck", "version": 1, "resultTimeoutMs": 120000 }
    </bpmn:documentation>

    <!-- Timer: every 4h -->
    <bpmn:startEvent id="Start_XRPC" name="every 4h">
      <bpmn:outgoing>Flow_ToCheck</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_4h">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT4H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToCheck" sourceRef="Start_XRPC" targetRef="Task_Check"/>

    <!-- Step 1: Run deploy health check -->
    <bpmn:serviceTask id="Task_Check" name="deploy health check">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kaisya.eng.deployHealthCheck"/>
        <zeebe:ioMapping>
          <zeebe:output source="=healthy"          target="healthy"/>
          <zeebe:output source="=anomaly_workers"  target="anomalyWorkers"/>
          <zeebe:output source="=pending_migs"     target="pendingMigrations"/>
          <zeebe:output source="=summary"          target="summary"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLog</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToLog" sourceRef="Task_Check" targetRef="Task_Log"/>

    <!-- Step 2: Write agent run log -->
    <bpmn:serviceTask id="Task_Log" name="write agent run log">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kaisya.agent.writeRunLog"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;kaisya_eng_deploy_agent&quot;"         target="agent_id"/>
          <zeebe:input source="=&quot;kaisya_eng_deploy_health_check&quot;"  target="process_id"/>
          <zeebe:input source="=&quot;deployHealthCheck&quot;"               target="task_type"/>
          <zeebe:input source="=summary"                                    target="output_summary"/>
          <zeebe:input source="=if healthy then 0 else 1"                           target="tasks_created_preview"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToLog</bpmn:incoming>
      <bpmn:outgoing>Flow_ToHealthCheck</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToHealthCheck" sourceRef="Task_Log" targetRef="GW_Health"/>

    <bpmn:exclusiveGateway id="GW_Health" name="healthy?">
      <bpmn:incoming>Flow_ToHealthCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTask</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToTask" sourceRef="GW_Health" targetRef="Task_CreateTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=healthy = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="GW_Health" targetRef="End_Done">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=healthy = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_CreateTask" name="create engineer approval task">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kaisya.agent.createTask"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;kaisya_eng_deploy_agent&quot;"    target="agent_id"/>
          <zeebe:input source="=&quot;Deploy anomaly detected&quot;"    target="title"/>
          <zeebe:input source="=summary"                               target="context_json"/>
          <zeebe:input source="=1"                                    target="priority"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToTask</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_TaskToEnd" sourceRef="Task_CreateTask" targetRef="End_Done"/>

    <bpmn:endEvent id="End_Done" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
      <bpmn:incoming>Flow_TaskToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
