<?xml version="1.0" encoding="UTF-8"?>
<!--
  kaisya.brandContentBriefing — etzhayyimcojp Artificial Organism

  Fires every 24h. Brand agent (kaisya_brand_agent) runs:
    1. Query recent platform activity (yoro posts, actor events)
    2. Generate content briefing + next-day content schedule
    3. Write vertex_kaisya_agent_run log
    4. If content plan needs approval (brand direction change) → create task

  NSID: com.etzhayyim.apps.kaisya.brandContentBriefing
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/kaisya-brand-content-briefing-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_kaisya_brand_content"
    targetNamespace="https://etzhayyim.ai/bpmn/kaisya"
    exporter="hand-written"
    exporterVersion="2.0">

  <bpmn:process id="kaisya_brand_content_briefing" name="kaisya Brand Content Briefing" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.kaisya.brandContentBriefing", "version": 1, "resultTimeoutMs": 180000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start_XRPC" name="every 24h">
      <bpmn:outgoing>Flow_ToActivity</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_24h">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT24H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToActivity" sourceRef="Start_XRPC" targetRef="Task_Activity"/>

    <bpmn:serviceTask id="Task_Activity" name="query platform activity">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT collection, COUNT(*) AS count FROM vertex_repo_record WHERE created_at >= NOW() - INTERVAL '24 hours' GROUP BY collection ORDER BY count DESC LIMIT 20&quot;" target="query"/>
          <zeebe:output source="=rows" target="activitySummary"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToActivity</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBriefing</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToBriefing" sourceRef="Task_Activity" targetRef="Task_Briefing"/>

    <bpmn:serviceTask id="Task_Briefing" name="brand content briefing generation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kaisya.brand.contentBriefing"/>
        <zeebe:ioMapping>
          <zeebe:input source="=activitySummary"  target="activity_summary"/>
          <zeebe:output source="=briefing_text"       target="briefingText"/>
          <zeebe:output source="=needs_approval"      target="needsApproval"/>
          <zeebe:output source="=approval_title"      target="approvalTitle"/>
          <zeebe:output source="=approval_context"    target="approvalContext"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToBriefing</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLog</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToLog" sourceRef="Task_Briefing" targetRef="Task_Log"/>

    <bpmn:serviceTask id="Task_Log" name="write agent run log">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kaisya.agent.writeRunLog"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;kaisya_brand_agent&quot;"               target="agent_id"/>
          <zeebe:input source="=&quot;kaisya_brand_content_briefing&quot;"    target="process_id"/>
          <zeebe:input source="=&quot;contentBriefing&quot;"                  target="task_type"/>
          <zeebe:input source="=briefingText"                               target="output_summary"/>
          <zeebe:input source="=if needsApproval then 1 else 0"                     target="tasks_created_preview"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToLog</bpmn:incoming>
      <bpmn:outgoing>Flow_ToApprovalCheck</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToApprovalCheck" sourceRef="Task_Log" targetRef="GW_Approval"/>

    <bpmn:exclusiveGateway id="GW_Approval" name="needs approval?">
      <bpmn:incoming>Flow_ToApprovalCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTask</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToTask" sourceRef="GW_Approval" targetRef="Task_CreateTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=needsApproval = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="GW_Approval" targetRef="End_Done">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=needsApproval = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_CreateTask" name="create brand approval task">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kaisya.agent.createTask"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;kaisya_brand_agent&quot;" target="agent_id"/>
          <zeebe:input source="=approvalTitle"                 target="title"/>
          <zeebe:input source="=approvalContext"               target="context_json"/>
          <zeebe:input source="=2"                            target="priority"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToTask</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_TaskToEnd" sourceRef="Task_CreateTask" targetRef="End_Done"/>

    <bpmn:endEvent id="End_Done" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
      <bpmn:incoming>Flow_TaskToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
