<?xml version="1.0" encoding="UTF-8"?>
<!--
  kaisya.engInfraMonitor — etzhayyimcojp Artificial Organism

  Fires every 4h. Infra engineer agent (kaisya_eng_infra_agent) runs:
    1. Check RisingWave + Zeebe + B2 health (HTTP probes)
    2. Write vertex_kaisya_agent_run log
    3. If infra anomaly → create vertex_kaisya_task for engineer (CTO = j.kawasaki)

  NSID: com.etzhayyim.apps.kaisya.engInfraMonitor
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/kaisya-eng-infra-monitor-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_kaisya_eng_infra"
    targetNamespace="https://etzhayyim.ai/bpmn/kaisya"
    exporter="hand-written"
    exporterVersion="2.0">

  <bpmn:process id="kaisya_eng_infra_monitor" name="kaisya Eng Infra Monitor" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.kaisya.engInfraMonitor", "version": 1, "resultTimeoutMs": 120000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start_XRPC" name="every 4h">
      <bpmn:outgoing>Flow_ToProbe</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_4h">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT4H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToProbe" sourceRef="Start_XRPC" targetRef="Task_Probe"/>

    <bpmn:serviceTask id="Task_Probe" name="probe infra health">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kaisya.eng.infraProbe"/>
        <zeebe:ioMapping>
          <zeebe:output source="=healthy"         target="healthy"/>
          <zeebe:output source="=failed_services" target="failedServices"/>
          <zeebe:output source="=summary"         target="summary"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToProbe</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLog</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToLog" sourceRef="Task_Probe" targetRef="Task_Log"/>

    <bpmn:serviceTask id="Task_Log" name="write agent run log">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kaisya.agent.writeRunLog"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;kaisya_eng_infra_agent&quot;"     target="agent_id"/>
          <zeebe:input source="=&quot;kaisya_eng_infra_monitor&quot;"   target="process_id"/>
          <zeebe:input source="=&quot;infraMonitor&quot;"               target="task_type"/>
          <zeebe:input source="=summary"                               target="output_summary"/>
          <zeebe:input source="=if healthy then 0 else 1"                      target="tasks_created_preview"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToLog</bpmn:incoming>
      <bpmn:outgoing>Flow_ToHealthCheck</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToHealthCheck" sourceRef="Task_Log" targetRef="GW_Health"/>

    <bpmn:exclusiveGateway id="GW_Health" name="healthy?">
      <bpmn:incoming>Flow_ToHealthCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTask</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToTask" sourceRef="GW_Health" targetRef="Task_CreateTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=healthy = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="GW_Health" targetRef="End_Done">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=healthy = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_CreateTask" name="create infra alert task">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kaisya.agent.createTask"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;kaisya_eng_infra_agent&quot;"  target="agent_id"/>
          <zeebe:input source="=&quot;Infra anomaly detected&quot;"  target="title"/>
          <zeebe:input source="=summary"                            target="context_json"/>
          <zeebe:input source="=1"                                 target="priority"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToTask</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_TaskToEnd" sourceRef="Task_CreateTask" targetRef="End_Done"/>

    <bpmn:endEvent id="End_Done" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
      <bpmn:incoming>Flow_TaskToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
