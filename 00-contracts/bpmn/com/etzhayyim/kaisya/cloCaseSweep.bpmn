<?xml version="1.0" encoding="UTF-8"?>
<!--
  kaisya.cloCaseSweep — etzhayyimcojp Artificial Organism

  Fires every 24h. CLO agent (kaisya_clo_agent) runs:
    1. Query lawfirm vertex_lawfirm_case for open cases + obligation deadlines
    2. LangGraph legal reasoning (LingLing litigation status + India auto-route check)
    3. Write vertex_kaisya_agent_run log
    4. If deadline within 7d or new litigation risk → create vertex_kaisya_task for CLO

  NSID: com.etzhayyim.apps.kaisya.cloCaseSweep
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/kaisya-clo-case-sweep-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_kaisya_clo_case"
    targetNamespace="https://etzhayyim.ai/bpmn/kaisya"
    exporter="hand-written"
    exporterVersion="2.0">

  <bpmn:process id="kaisya_clo_case_sweep" name="kaisya CLO Case Sweep" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.kaisya.cloCaseSweep", "version": 1, "resultTimeoutMs": 300000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start_XRPC" name="every 24h">
      <bpmn:outgoing>Flow_ToCases</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_24h">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT24H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToCases" sourceRef="Start_XRPC" targetRef="Task_Cases"/>

    <bpmn:serviceTask id="Task_Cases" name="query open cases + deadlines">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT vertex_id, matter_ref, status, due_date, jurisdiction FROM vertex_lawfirm_case WHERE status NOT IN ('closed','archived') ORDER BY due_date ASC LIMIT 50&quot;" target="query"/>
          <zeebe:output source="=rows" target="openCases"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCases</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReason</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToReason" sourceRef="Task_Cases" targetRef="Task_Reason"/>

    <bpmn:serviceTask id="Task_Reason" name="CLO LangGraph legal reasoning">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kaisya.clo.legalReason"/>
        <zeebe:ioMapping>
          <zeebe:input source="=openCases"  target="open_cases"/>
          <zeebe:output source="=report_text"     target="reportText"/>
          <zeebe:output source="=urgent"          target="urgent"/>
          <zeebe:output source="=urgent_title"    target="urgentTitle"/>
          <zeebe:output source="=urgent_context"  target="urgentContext"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToReason</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLog</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToLog" sourceRef="Task_Reason" targetRef="Task_Log"/>

    <bpmn:serviceTask id="Task_Log" name="write agent run log">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kaisya.agent.writeRunLog"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;kaisya_clo_agent&quot;"      target="agent_id"/>
          <zeebe:input source="=&quot;kaisya_clo_case_sweep&quot;" target="process_id"/>
          <zeebe:input source="=&quot;caseSweep&quot;"             target="task_type"/>
          <zeebe:input source="=reportText"                       target="output_summary"/>
          <zeebe:input source="=if urgent then 1 else 0"                  target="tasks_created_preview"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToLog</bpmn:incoming>
      <bpmn:outgoing>Flow_ToUrgentCheck</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToUrgentCheck" sourceRef="Task_Log" targetRef="GW_Urgent"/>

    <bpmn:exclusiveGateway id="GW_Urgent" name="urgent?">
      <bpmn:incoming>Flow_ToUrgentCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTask</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToTask" sourceRef="GW_Urgent" targetRef="Task_CreateTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=urgent = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="GW_Urgent" targetRef="End_Done">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=urgent = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_CreateTask" name="create CLO approval task">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kaisya.agent.createTask"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;kaisya_clo_agent&quot;" target="agent_id"/>
          <zeebe:input source="=urgentTitle"                target="title"/>
          <zeebe:input source="=urgentContext"              target="context_json"/>
          <zeebe:input source="=1"                         target="priority"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToTask</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_TaskToEnd" sourceRef="Task_CreateTask" targetRef="End_Done"/>

    <bpmn:endEvent id="End_Done" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
      <bpmn:incoming>Flow_TaskToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
