<?xml version="1.0" encoding="UTF-8"?>
<!--
  kaisya.creativeAssetPipeline — etzhayyimcojp Artificial Organism

  Fires every 24h. Creative agent (kaisya_creative_agent) runs:
    1. Query pending creative requests from vertex_kaisya_task (brand requests)
    2. Generate asset briefs (copy, visual direction, schedule)
    3. Write vertex_kaisya_agent_run log
    4. If new creative direction needs sign-off → create task for creative director

  NSID: com.etzhayyim.apps.kaisya.creativeAssetPipeline
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/kaisya-creative-asset-pipeline-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_kaisya_creative_asset"
    targetNamespace="https://etzhayyim.ai/bpmn/kaisya"
    exporter="hand-written"
    exporterVersion="2.0">

  <bpmn:process id="kaisya_creative_asset_pipeline" name="kaisya Creative Asset Pipeline" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.kaisya.creativeAssetPipeline", "version": 1, "resultTimeoutMs": 180000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start_XRPC" name="every 24h">
      <bpmn:outgoing>Flow_ToRequests</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_24h">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT24H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToRequests" sourceRef="Start_XRPC" targetRef="Task_Requests"/>

    <bpmn:serviceTask id="Task_Requests" name="query brand creative requests">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT vertex_id, title, context_json, created_at FROM vertex_kaisya_task WHERE agent_id = 'kaisya_brand_agent' AND status = 'approved' ORDER BY created_at DESC LIMIT 10&quot;" target="query"/>
          <zeebe:output source="=rows" target="brandRequests"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRequests</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPipeline</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToPipeline" sourceRef="Task_Requests" targetRef="Task_Pipeline"/>

    <bpmn:serviceTask id="Task_Pipeline" name="creative asset pipeline generation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kaisya.creative.assetPipeline"/>
        <zeebe:ioMapping>
          <zeebe:input source="=brandRequests"    target="brand_requests"/>
          <zeebe:output source="=pipeline_text"       target="pipelineText"/>
          <zeebe:output source="=needs_signoff"       target="needsSignoff"/>
          <zeebe:output source="=signoff_title"       target="signoffTitle"/>
          <zeebe:output source="=signoff_context"     target="signoffContext"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPipeline</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLog</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToLog" sourceRef="Task_Pipeline" targetRef="Task_Log"/>

    <bpmn:serviceTask id="Task_Log" name="write agent run log">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kaisya.agent.writeRunLog"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;kaisya_creative_agent&quot;"               target="agent_id"/>
          <zeebe:input source="=&quot;kaisya_creative_asset_pipeline&quot;"      target="process_id"/>
          <zeebe:input source="=&quot;assetPipeline&quot;"                       target="task_type"/>
          <zeebe:input source="=pipelineText"                                  target="output_summary"/>
          <zeebe:input source="=if needsSignoff then 1 else 0"                         target="tasks_created_preview"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToLog</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSignoffCheck</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToSignoffCheck" sourceRef="Task_Log" targetRef="GW_Signoff"/>

    <bpmn:exclusiveGateway id="GW_Signoff" name="needs signoff?">
      <bpmn:incoming>Flow_ToSignoffCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTask</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToTask" sourceRef="GW_Signoff" targetRef="Task_CreateTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=needsSignoff = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="GW_Signoff" targetRef="End_Done">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=needsSignoff = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_CreateTask" name="create creative signoff task">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kaisya.agent.createTask"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;kaisya_creative_agent&quot;" target="agent_id"/>
          <zeebe:input source="=signoffTitle"                    target="title"/>
          <zeebe:input source="=signoffContext"                  target="context_json"/>
          <zeebe:input source="=2"                              target="priority"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToTask</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_TaskToEnd" sourceRef="Task_CreateTask" targetRef="End_Done"/>

    <bpmn:endEvent id="End_Done" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
      <bpmn:incoming>Flow_TaskToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
