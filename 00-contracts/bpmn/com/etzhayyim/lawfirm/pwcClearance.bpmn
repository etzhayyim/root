<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_lawfirm_pwc_clearance"
                  targetNamespace="https://etzhayyim.ai/bpmn/lawfirm"
                  exporter="hand-written" exporterVersion="2.0">

  <bpmn:process id="lawfirm_pwc_clearance"
                name="lawfirm PwC Clearance (CEO HITL)"
                isExecutable="true">
    <bpmn:documentation>{ "nsid": "com.etzhayyim.apps.lawfirm.pwcClearanceRequest", "version": 1, "resultTimeoutMs": 86400000 }</bpmn:documentation>

    <!--
      Per matter:
        XRPC trigger
        → persist clearance request row (status=pending, SLA=72h)
        → notify CEO via Teams/Slack with PwC contact draft
        → CEO HITL: approve (no_conflict) | deny (conflict) | need_more_info
        → write outcome → matter unlock or decline
        → audit emit
    -->

    <bpmn:startEvent id="Start_XRPC" name="XRPC: pwcClearanceRequest">
      <bpmn:outgoing>Flow_start_to_persist</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_start_to_persist" sourceRef="Start_XRPC" targetRef="Task_PersistRequest"/>

    <bpmn:serviceTask id="Task_PersistRequest" name="Persist clearance request (status=pending)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lawfirm.pwc.persistRequest"/>
        <zeebe:ioMapping>
          <zeebe:input source="=matter_uri"        target="matter_uri"/>
          <zeebe:input source="=client_name"       target="client_name"/>
          <zeebe:input source="=matter_summary"    target="matter_summary"/>
          <zeebe:input source="=requested_by_did"  target="requested_by_did"/>
          <zeebe:input source="=pwc_contact"       target="pwc_contact"/>
          <zeebe:input source="=sla_hours"         target="sla_hours"/>
          <zeebe:output source="=clearance_uri"  target="clearance_uri"/>
          <zeebe:output source="=sla_deadline"   target="sla_deadline"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_persist</bpmn:incoming>
      <bpmn:outgoing>Flow_persist_to_notify</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_persist_to_notify" sourceRef="Task_PersistRequest" targetRef="Task_NotifyCEO"/>

    <bpmn:serviceTask id="Task_NotifyCEO" name="Notify CEO (Teams/email)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lawfirm.pwc.notifyCEO"/>
        <zeebe:ioMapping>
          <zeebe:input source="=clearance_uri"  target="clearance_uri"/>
          <zeebe:input source="=client_name"    target="client_name"/>
          <zeebe:input source="=matter_summary" target="matter_summary"/>
          <zeebe:input source="=sla_deadline"   target="sla_deadline"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_persist_to_notify</bpmn:incoming>
      <bpmn:outgoing>Flow_notify_to_ceo</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_notify_to_ceo" sourceRef="Task_NotifyCEO" targetRef="Task_CEOReview"/>

    <bpmn:userTask id="Task_CEOReview" name="CEO PwC clearance HITL">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="did:web:j-kawasaki.etzhayyim.com"/>
        <zeebe:ioMapping>
          <zeebe:input source="=clearance_uri" target="clearance_uri"/>
          <zeebe:output source="=clearance_decision"   target="clearance_decision"/>
          <zeebe:output source="=pwc_response_text"    target="pwc_response_text"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_notify_to_ceo</bpmn:incoming>
      <bpmn:outgoing>Flow_ceo_to_apply</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_ceo_to_apply" sourceRef="Task_CEOReview" targetRef="Task_ApplyDecision"/>

    <bpmn:serviceTask id="Task_ApplyDecision" name="Apply clearance decision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lawfirm.pwc.applyDecision"/>
        <zeebe:ioMapping>
          <zeebe:input source="=clearance_uri"      target="clearance_uri"/>
          <zeebe:input source="=clearance_decision" target="clearance_decision"/>
          <zeebe:input source="=pwc_response_text"  target="pwc_response_text"/>
          <zeebe:input source="=matter_uri"         target="matter_uri"/>
          <zeebe:output source="=clearance_status" target="clearance_status"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ceo_to_apply</bpmn:incoming>
      <bpmn:outgoing>Flow_apply_to_audit</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_apply_to_audit" sourceRef="Task_ApplyDecision" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="Emit Audit (OCEL)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:lawfirm.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;lawfirm.pwc.clearance.decided&quot;" target="event_type"/>
          <zeebe:input source="={clearance_uri: clearance_uri, matter_uri: matter_uri, status: clearance_status, decision: clearance_decision}" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_apply_to_audit</bpmn:incoming>
      <bpmn:outgoing>Flow_audit_to_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_audit_to_end" sourceRef="Task_Audit" targetRef="End_Done"/>

    <bpmn:endEvent id="End_Done" name="Done">
      <bpmn:incoming>Flow_audit_to_end</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
