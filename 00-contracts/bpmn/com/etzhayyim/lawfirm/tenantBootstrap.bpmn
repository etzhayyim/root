<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_lawfirm_tenant_bootstrap"
                  targetNamespace="https://etzhayyim.ai/bpmn/lawfirm"
                  exporter="hand-written" exporterVersion="1.0">

  <bpmn:process id="lawfirm_tenant_bootstrap"
                name="lawfirm Tenant Bootstrap (validate → persist → audit)"
                isExecutable="true">
    <bpmn:documentation>{ "nsid": "com.etzhayyim.apps.lawfirm.tenantBootstrap", "version": 1, "resultTimeoutMs": 30000 }</bpmn:documentation>

    <bpmn:startEvent id="Start_XRPC" name="XRPC: tenantBootstrap">
      <bpmn:outgoing>Flow_start_to_provision</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_start_to_provision" sourceRef="Start_XRPC" targetRef="Task_Provision"/>

    <bpmn:serviceTask id="Task_Provision" name="Provision tenant row + did:web + edges">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lawfirm.tenant.bootstrap"/>
        <zeebe:ioMapping>
          <zeebe:input source="=slug"             target="slug"/>
          <zeebe:input source="=legalName"        target="legal_name"/>
          <zeebe:input source="=country"          target="country"/>
          <zeebe:input source="=dataRegion"       target="data_region"/>
          <zeebe:input source="=tier"             target="tier"/>
          <zeebe:input source="=pilotLeadId"      target="pilot_lead_id"/>
          <zeebe:input source="=adminEmail"       target="admin_email"/>
          <zeebe:input source="=consentRegion"    target="consent_regions"/>
          <zeebe:output source="=tenantDid"        target="tenantDid"/>
          <zeebe:output source="=pdsUrl"           target="pdsUrl"/>
          <zeebe:output source="=xrpcEndpoint"     target="xrpcEndpoint"/>
          <zeebe:output source="=kpiDashboardUrl"  target="kpiDashboardUrl"/>
          <zeebe:output source="=tenant_id"        target="tenant_id"/>
          <zeebe:output source="=status"           target="status"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_provision</bpmn:incoming>
      <bpmn:outgoing>Flow_provision_to_audit</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_provision_to_audit" sourceRef="Task_Provision" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="Emit Audit (OCEL)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:lawfirm.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;lawfirm.tenant.provisioned&quot;" target="event_type"/>
          <zeebe:input source="={tenant_id: tenant_id, slug: slug, tier: tier, status: status, tenantDid: tenantDid}" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_provision_to_audit</bpmn:incoming>
      <bpmn:outgoing>Flow_audit_to_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_audit_to_end" sourceRef="Task_Audit" targetRef="End_Done"/>

    <bpmn:endEvent id="End_Done" name="Done">
      <bpmn:incoming>Flow_audit_to_end</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
