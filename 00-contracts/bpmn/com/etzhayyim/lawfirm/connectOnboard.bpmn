<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_lawfirm_connect_onboard"
                  targetNamespace="https://etzhayyim.ai/bpmn/lawfirm"
                  exporter="hand-written" exporterVersion="1.0">

  <bpmn:process id="lawfirm_connect_onboard"
                name="lawfirm Connect Onboard (Mode B rev-share)"
                isExecutable="true">
    <bpmn:documentation>{ "nsid": "com.etzhayyim.apps.lawfirm.connectOnboard", "version": 1, "resultTimeoutMs": 60000 }</bpmn:documentation>

    <bpmn:startEvent id="Start_XRPC" name="XRPC: connectOnboard">
      <bpmn:outgoing>Flow_start_to_onboard</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_start_to_onboard" sourceRef="Start_XRPC" targetRef="Task_OnboardConnect"/>

    <bpmn:serviceTask id="Task_OnboardConnect" name="Stripe Express account + onboarding link">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lawfirm.billing.modeBOnboardConnect"/>
        <zeebe:ioMapping>
          <zeebe:input source="=tenantId"     target="tenant_id"/>
          <zeebe:input source="=country"      target="country"/>
          <zeebe:input source="=adminEmail"   target="admin_email"/>
          <zeebe:input source="=returnOrigin" target="return_origin"/>
          <zeebe:output source="=stripe_connect_account_id" target="stripeConnectAccountId"/>
          <zeebe:output source="=onboarding_url"            target="onboardingUrl"/>
          <zeebe:output source="=dry_run"                   target="dryRun"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_onboard</bpmn:incoming>
      <bpmn:outgoing>Flow_onboard_to_audit</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_onboard_to_audit" sourceRef="Task_OnboardConnect" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="Emit Audit (OCEL)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:lawfirm.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;lawfirm.connect.onboarded&quot;" target="event_type"/>
          <zeebe:input source="={tenant_id: tenantId, stripe_connect_account_id: stripeConnectAccountId, dry_run: dryRun}" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_onboard_to_audit</bpmn:incoming>
      <bpmn:outgoing>Flow_audit_to_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_audit_to_end" sourceRef="Task_Audit" targetRef="End_Done"/>

    <bpmn:endEvent id="End_Done" name="Done">
      <bpmn:incoming>Flow_audit_to_end</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
