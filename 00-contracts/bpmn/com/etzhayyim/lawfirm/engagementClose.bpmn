<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_lawfirm_engagement_close"
                  targetNamespace="https://etzhayyim.ai/bpmn/lawfirm"
                  exporter="hand-written" exporterVersion="2.0">

  <bpmn:process id="lawfirm_engagement_close"
                name="lawfirm Engagement Close (intake → SOW → eSign → Stripe)"
                isExecutable="true">
    <bpmn:documentation>{ "nsid": "com.etzhayyim.apps.lawfirm.engagementClose", "version": 1, "resultTimeoutMs": 600000 }</bpmn:documentation>

    <bpmn:startEvent id="Start_XRPC" name="XRPC: engagementClose">
      <bpmn:outgoing>Flow_start_to_pwc</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_start_to_pwc" sourceRef="Start_XRPC" targetRef="Task_PwcRequest"/>

    <!-- Step 1: PwC clearance request (synchronous block; CEO HITL on a separate process) -->
    <bpmn:serviceTask id="Task_PwcRequest" name="PwC clearance request">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lawfirm.pwc.persistRequest"/>
        <zeebe:ioMapping>
          <zeebe:input source="=matter_uri"      target="matter_uri"/>
          <zeebe:input source="=client_name"     target="client_name"/>
          <zeebe:input source="=matter_summary"  target="matter_summary"/>
          <zeebe:input source="=requester_did"   target="requested_by_did"/>
          <zeebe:input source="=72"              target="sla_hours"/>
          <zeebe:output source="=clearance_uri" target="clearance_uri"/>
          <zeebe:output source="=sla_deadline"  target="pwc_sla_deadline"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_pwc</bpmn:incoming>
      <bpmn:outgoing>Flow_pwc_to_letter</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_pwc_to_letter" sourceRef="Task_PwcRequest" targetRef="Task_DraftLetter"/>

    <!-- Step 2: Draft Engagement Letter via marketing LangGraph (platform brand) -->
    <bpmn:serviceTask id="Task_DraftLetter" name="Draft Engagement Letter (LangGraph)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lawfirm.marketing.submit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;marketing.platformCopy&quot;" target="task_type"/>
          <zeebe:input source="=&quot;platform&quot;" target="brand"/>
          <zeebe:input source="=client_name"      target="audience"/>
          <zeebe:input source="=&quot;Engagement Letter draft for matter&quot;" target="topic"/>
          <zeebe:input source="={matter_uri: matter_uri, fee_structure: fee_structure, fee_amount_minor: fee_amount_minor, currency: currency}" target="payload"/>
          <zeebe:output source="=asset_uris" target="letter_asset_uris"/>
          <zeebe:output source="=summary"    target="letter_summary"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_pwc_to_letter</bpmn:incoming>
      <bpmn:outgoing>Flow_letter_to_esign</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_letter_to_esign" sourceRef="Task_DraftLetter" targetRef="Task_EsignRequest"/>

    <!-- Step 3: DocuSign envelope -->
    <bpmn:serviceTask id="Task_EsignRequest" name="DocuSign envelope">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lawfirm.esign.request"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;engagementLetter&quot;" target="document_kind"/>
          <zeebe:input source="=matter_uri" target="matter_uri"/>
          <zeebe:input source="=recipients" target="recipients"/>
          <zeebe:input source="=&quot;docusign&quot;" target="provider"/>
          <zeebe:input source="=14" target="expires_in_days"/>
          <zeebe:output source="=envelope_id"  target="envelope_id"/>
          <zeebe:output source="=signing_urls" target="signing_urls"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_letter_to_esign</bpmn:incoming>
      <bpmn:outgoing>Flow_esign_to_checkout</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_esign_to_checkout" sourceRef="Task_EsignRequest" targetRef="Task_CheckoutCreate"/>

    <!-- Step 4: Stripe Checkout link -->
    <bpmn:serviceTask id="Task_CheckoutCreate" name="Stripe Checkout session">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lawfirm.checkout.create"/>
        <zeebe:ioMapping>
          <zeebe:input source="=product_kind"      target="product_kind"/>
          <zeebe:input source="=fee_amount_minor"  target="amount_minor"/>
          <zeebe:input source="=currency"          target="currency"/>
          <zeebe:input source="=matter_uri"        target="matter_uri"/>
          <zeebe:input source="=client_did"        target="client_did"/>
          <zeebe:input source="=client_email"      target="client_email"/>
          <zeebe:input source="=client_name"       target="client_name"/>
          <zeebe:input source="=stream"            target="stream"/>
          <zeebe:output source="=checkout_url" target="checkout_url"/>
          <zeebe:output source="=session_id"   target="checkout_session_id"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_esign_to_checkout</bpmn:incoming>
      <bpmn:outgoing>Flow_checkout_to_audit</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_checkout_to_audit" sourceRef="Task_CheckoutCreate" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="Emit Audit (OCEL)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:lawfirm.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;lawfirm.engagement.closed&quot;" target="event_type"/>
          <zeebe:input source="={matter_uri: matter_uri, clearance_uri: clearance_uri, envelope_id: envelope_id, checkout_url: checkout_url, fee_amount_minor: fee_amount_minor, currency: currency}" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_checkout_to_audit</bpmn:incoming>
      <bpmn:outgoing>Flow_audit_to_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_audit_to_end" sourceRef="Task_Audit" targetRef="End_Done"/>

    <bpmn:endEvent id="End_Done" name="Done">
      <bpmn:incoming>Flow_audit_to_end</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
