<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_lawfirm_msgraph_subscription_renew_tick"
                  targetNamespace="https://etzhayyim.ai/bpmn/lawfirm"
                  exporter="hand-written" exporterVersion="2.0">

  <bpmn:process id="lawfirm_msgraph_subscription_renew_tick"
                name="lawfirm MS Graph Subscription Renew Tick (R/PT24H)"
                isExecutable="true">
    <bpmn:documentation>{ "version": 1, "trigger": "timer", "cycle": "R/PT24H" }</bpmn:documentation>

    <bpmn:startEvent id="Start_Timer" name="Daily 03:00 JST">
      <bpmn:outgoing>Flow_start_to_renew</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT24H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_start_to_renew" sourceRef="Start_Timer" targetRef="Task_Renew"/>

    <bpmn:serviceTask id="Task_Renew" name="Renew expiring MS Graph subs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lawfirm.msGraph.subscriptionRenew"/>
        <zeebe:ioMapping>
          <zeebe:output source="=renewed" target="renewed"/>
          <zeebe:output source="=checked" target="checked"/>
          <zeebe:output source="=ok"      target="ok"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_renew</bpmn:incoming>
      <bpmn:outgoing>Flow_renew_to_audit</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_renew_to_audit" sourceRef="Task_Renew" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="Emit Audit (OCEL)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:lawfirm.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;lawfirm.msgraph.renew.tick&quot;" target="event_type"/>
          <zeebe:input source="={renewed: renewed, checked: checked, ok: ok}" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_renew_to_audit</bpmn:incoming>
      <bpmn:outgoing>Flow_audit_to_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_audit_to_end" sourceRef="Task_Audit" targetRef="End_Done"/>

    <bpmn:endEvent id="End_Done" name="Done">
      <bpmn:incoming>Flow_audit_to_end</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
