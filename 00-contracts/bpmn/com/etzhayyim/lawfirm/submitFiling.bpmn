<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_lawfirm_submit_filing" targetNamespace="https://etzhayyim.ai/bpmn/lawfirm" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="lawfirm_submit_filing" name="submitFiling" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Validate"/>
    <bpmn:serviceTask id="Task_Validate" name="validate matter ownership">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.select" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT firm_did, status FROM vertex_lawfirm_matter WHERE vertex_id = $1 LIMIT 1&quot;" target="sql"/>
          <zeebe:input source="=[matterUri]" target="params"/>
          <zeebe:output source="=rows[1]" target="matter"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_W</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_W" sourceRef="Task_Validate" targetRef="Task_WriteFiling"/>
    <bpmn:serviceTask id="Task_WriteFiling" name="write filing record">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_lawfirm_filing&quot;" target="table"/>
          <zeebe:input source="={vertex_id: &quot;at://&quot; + matter.firm_did + &quot;/com.etzhayyim.apps.lawfirm.filing/&quot; + filingId, matter_uri: matterUri, court_did: courtDid, filing_type: filingType, document_uris_csv: documentUris, filed_at: now, status: &quot;submitted&quot;, owner_did: matter.firm_did, sensitivity_ord: 2, created_at: now}" target="row"/>
          <zeebe:output source="=vertex_id" target="filingVid"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_W</bpmn:incoming><bpmn:outgoing>Flow_T</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_T" sourceRef="Task_WriteFiling" targetRef="Task_Transmit"/>
    <bpmn:serviceTask id="Task_Transmit" name="transmit to court endpoint">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.http.fetch" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;POST&quot;" target="method"/>
          <zeebe:input source="=courtEndpointUrl" target="url"/>
          <zeebe:input source="={filingId: filingId, matterUri: matterUri, filingType: filingType, documentUris: documentUris}" target="body"/>
          <zeebe:output source="=response.acknowledgmentId" target="ackId"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_T</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Transmit" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:lawfirm.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;lawfirm.submitFiling&quot;" target="action"/><zeebe:input source="={filingVid: filingVid, ackId: ackId}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
