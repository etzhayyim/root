<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_lawfirm_intake_funnel"
                  targetNamespace="https://etzhayyim.ai/bpmn/lawfirm"
                  exporter="hand-written" exporterVersion="2.0">

  <bpmn:process id="lawfirm_intake_funnel"
                name="lawfirm Intake Funnel (multilingual → conflict → notify)"
                isExecutable="true">
    <bpmn:documentation>{ "nsid": "com.etzhayyim.apps.lawfirm.intakeSubmit", "version": 1, "resultTimeoutMs": 60000 }</bpmn:documentation>

    <bpmn:startEvent id="Start_XRPC" name="XRPC: intakeSubmit">
      <bpmn:outgoing>Flow_start_to_persist</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_start_to_persist" sourceRef="Start_XRPC" targetRef="Task_PersistIntake"/>

    <bpmn:serviceTask id="Task_PersistIntake" name="Persist intake row + encrypt fields">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lawfirm.intake.submit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=tenant_id"          target="tenant_id"/>
          <zeebe:input source="=lang"               target="lang"/>
          <zeebe:input source="=client_name"        target="client_name"/>
          <zeebe:input source="=client_email"       target="client_email"/>
          <zeebe:input source="=client_phone"       target="client_phone"/>
          <zeebe:input source="=client_country"     target="client_country"/>
          <zeebe:input source="=matter_type_hint"   target="matter_type_hint"/>
          <zeebe:input source="=jurisdiction_hint"  target="jurisdiction_hint"/>
          <zeebe:input source="=cross_border_flag"  target="cross_border_flag"/>
          <zeebe:input source="=summary"            target="summary"/>
          <zeebe:input source="=consent_status"     target="consent_status"/>
          <zeebe:input source="=source_url"         target="source_url"/>
          <zeebe:input source="=ip_country"         target="ip_country"/>
          <zeebe:output source="=intake_id"            target="intake_id"/>
          <zeebe:output source="=intake_uri"           target="intake_uri"/>
          <zeebe:output source="=next_steps_message"   target="next_steps_message"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_persist</bpmn:incoming>
      <bpmn:outgoing>Flow_persist_to_audit</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_persist_to_audit" sourceRef="Task_PersistIntake" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="Emit Audit (OCEL)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:lawfirm.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;lawfirm.intake.submitted&quot;" target="event_type"/>
          <zeebe:input source="={intake_id: intake_id, lang: lang, tenant_id: tenant_id, cross_border_flag: cross_border_flag}" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_persist_to_audit</bpmn:incoming>
      <bpmn:outgoing>Flow_audit_to_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_audit_to_end" sourceRef="Task_Audit" targetRef="End_Done"/>

    <bpmn:endEvent id="End_Done" name="Done">
      <bpmn:incoming>Flow_audit_to_end</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
