<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_smartphone_patent_flag_expiry_gate" targetNamespace="https://etzhayyim.ai/bpmn/open-smartphone-patent" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_smartphone_patent_flag_expiry_gate" name="flagExpiryGate" isExecutable="true">
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_S</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P7D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Select"/>
    <bpmn:serviceTask id="Task_Select" name="query expiring SEPs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT vertex_id, patent_no, holder_did, rat, expiry_date FROM vertex_open_smartphone_patent_sep WHERE blocker_status = &apos;active&apos; AND expiry_date IS NOT NULL ORDER BY expiry_date ASC LIMIT 200&quot;" target="query"/>
          <zeebe:output source="=rows" target="expiring"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Select" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-smartphone-patent.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;open.smartphonePatent.flagExpiryGate&quot;" target="action"/>
          <zeebe:input source="={expiringCount: count(expiring)}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
