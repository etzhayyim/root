<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_smartphone_patent_fetch_sep_landscape_delta" targetNamespace="https://etzhayyim.ai/bpmn/open-smartphone-patent" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_smartphone_patent_fetch_sep_landscape_delta" name="fetchSepLandscapeDelta" isExecutable="true">
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_S</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Fetch"/>
    <bpmn:serviceTask id="Task_Fetch" name="fetch ETSI IPR DB">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.http.fetch"/>
        <zeebe:ioMapping>
          <zeebe:input source="={url: &quot;https://www.etsi.org/intellectual-property-rights/ipr-database&quot;, method: &quot;GET&quot;}" target="request"/>
          <zeebe:output source="=response.body" target="rawHtml"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_B</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_B" sourceRef="Task_Fetch" targetRef="Task_LLM"/>
    <bpmn:serviceTask id="Task_LLM" name="extract SEPs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.json"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;Extract newly declared Standard Essential Patents (SEPs) for 4G LTE, 5G NR, Wi-Fi (802.11), Bluetooth from the ETSI IPR database. Include patent number, holder company, applicable standard, and FRAND declaration status.&quot;" target="prompt"/>
          <zeebe:input source="=rawHtml" target="context"/>
          <zeebe:input source="={type: &quot;object&quot;, properties: {seps: {type: &quot;array&quot;, items: {type: &quot;object&quot;, properties: {patentNo: {type: &quot;string&quot;}, holder: {type: &quot;string&quot;}, standard: {type: &quot;string&quot;}, cpcCodes: {type: &quot;array&quot;, items: {type: &quot;string&quot;}}, frandDeclared: {type: &quot;boolean&quot;}, expiryYear: {type: &quot;integer&quot;}}}}}}" target="schema"/>
          <zeebe:output source="=result" target="parsed"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B</bpmn:incoming><bpmn:outgoing>Flow_C</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_C" sourceRef="Task_LLM" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-smartphone-patent.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;open.smartphonePatent.fetchSepLandscapeDelta&quot;" target="action"/>
          <zeebe:input source="={count: count(parsed.seps)}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_C</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
