<?xml version="1.0" encoding="UTF-8"?>
<!--
  shinshi.seedGapFill - autonomous gap-fill seeder for partial / empty
  shinshi model bulk seeds. Timer-start every 4h.

  Flow:
    1. shinshi.coverage.findIncomplete  -> {slugs[], totalIncomplete, checked}
    2. shinshi.scene.bulkSeed           (anime SDXL, thumb, skip if existing)
    3. generic.audit.emit               (audit row in vertex_repo_commit)

  The bulkSeed primitive caps internally at 3 slugs/run. R/PT4H gives
  6 fires/day = ~18 model bulk seeds/day; 1,036 partial models drains
  in ~2 months at zero touch. R/PT4H avoids GPU contention with manual
  XRPC kicks and keeps RunPod cold-start cost bounded.

  No XRPC binding (timer-start only). Operator override: kick
  seedScenesWithImages.bpmn directly.

  NSID: com.etzhayyim.apps.shinshi.seedGapFill (informational, no XRPC)
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/shinshi-seed-gap-fill-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_shinshi_seed_gap_fill"
    targetNamespace="https://etzhayyim.ai/bpmn/shinshi"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="shinshi_seed_gap_fill" name="shinshi seedGapFill" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.shinshi.seedGapFill", "version": 1, "resultTimeoutMs": 900000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="every 4h">
      <bpmn:outgoing>Flow_ToScan</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_4h">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT4H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToScan" sourceRef="Start" targetRef="Task_Scan"/>

    <bpmn:serviceTask id="Task_Scan" name="find models with fewer than 5 scenes">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="shinshi.coverage.findIncomplete"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:sh1n5h1x.etzhayyim.com&quot;" target="appDid"/>
          <zeebe:input source="=5" target="minScenes"/>
          <zeebe:input source="=5" target="maxModels"/>
          <zeebe:output source="=slugs" target="slugs"/>
          <zeebe:output source="=totalIncomplete" target="totalIncomplete"/>
          <zeebe:output source="=checked" target="checked"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToScan</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToGate" sourceRef="Task_Scan" targetRef="Gate_HasSlugs"/>

    <bpmn:exclusiveGateway id="Gate_HasSlugs" name="any incomplete?" default="Flow_NoSlugs">
      <bpmn:incoming>Flow_ToGate</bpmn:incoming>
      <bpmn:outgoing>Flow_HasSlugs</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoSlugs</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_HasSlugs" sourceRef="Gate_HasSlugs" targetRef="Task_BulkSeed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(slugs) &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoSlugs" sourceRef="Gate_HasSlugs" targetRef="Task_AuditSkip"/>

    <bpmn:serviceTask id="Task_BulkSeed" name="bulk seed 5 anime scenes per slug">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="shinshi.scene.bulkSeed"/>
        <zeebe:ioMapping>
          <zeebe:input source="=slugs" target="slugs"/>
          <zeebe:input source="=&quot;did:web:sh1n5h1x.etzhayyim.com&quot;" target="appDid"/>
          <zeebe:input source="=&quot;thumb&quot;" target="sceneType"/>
          <zeebe:input source="=[0,1,2,3,4]" target="sceneIndices"/>
          <zeebe:input source="=true" target="skipIfExisting"/>
          <zeebe:input source="=&quot;animagine-xl-4.0.safetensors&quot;" target="ckpt"/>
          <zeebe:input source="=&quot;anime&quot;" target="style"/>
          <zeebe:output source="=totalPosted" target="bulkTotalPosted"/>
          <zeebe:output source="=totalSkipped" target="bulkTotalSkipped"/>
          <zeebe:output source="=totalActresses" target="bulkTotalActresses"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HasSlugs</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_BulkSeed" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:shinshi.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.shinshi.seedGapFill&quot;" target="nsid"/>
          <zeebe:input source="={ totalIncomplete: totalIncomplete, checked: checked, picked: count(slugs), posted: bulkTotalPosted, skipped: bulkTotalSkipped }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:serviceTask id="Task_AuditSkip" name="audit emit (no incomplete)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:shinshi.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.shinshi.seedGapFill&quot;" target="nsid"/>
          <zeebe:input source="={ totalIncomplete: totalIncomplete, checked: checked, picked: 0, skipReason: &quot;all-complete-or-error&quot; }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoSlugs</bpmn:incoming>
      <bpmn:outgoing>Flow_SkipToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_SkipToEnd" sourceRef="Task_AuditSkip" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
      <bpmn:incoming>Flow_SkipToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
