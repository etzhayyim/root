<?xml version="1.0" encoding="UTF-8"?>
<!--
  shinshi.requestScene — single SDXL scene render for a model DID.

  Entry: shinshi CF Worker (`requestScene`) → dispatcher.etzhayyim.com
         → bpmn-dispatcher → Zeebe → this process.

  Pipeline (single Zeebe service task):
    1. shinshi.scene.render — pyzeebe handler builds workflow, submits to
       ComfyUI on RunPod (browser UA), polls /history, fetches /view bytes,
       uploadBlob to PDS, writes graph-visible AT post.

  Input body:
    { modelDid, userDid, prompt, sceneType, ckpt, appDid }

  Output:
    { postUri, blobKey, cid, renderMs, userDid }

  NSID: com.etzhayyim.apps.shinshi.requestScene
  Token debit + ledger persistence remain in the CF Worker (proxyToDispatcher
  refunds on dispatcher failure by NOT persisting the debit). Generation
  itself runs entirely in pyzeebe + RunPod per ADR-2604282300.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_shinshi_request_scene"
    targetNamespace="https://etzhayyim.ai/bpmn/shinshi"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="shinshi_request_scene"
                name="shinshi requestScene"
                isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.shinshi.requestScene", "version": 1, "resultTimeoutMs": 200000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_ToRender</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToRender" sourceRef="Start" targetRef="Task_Render"/>

    <bpmn:serviceTask id="Task_Render" name="render scene + post (pyzeebe)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="shinshi.scene.render"/>
        <zeebe:ioMapping>
          <zeebe:input source="=modelDid"   target="modelDid"/>
          <zeebe:input source="=userDid"    target="userDid"/>
          <zeebe:input source="=prompt"     target="prompt"/>
          <zeebe:input source="=sceneType"  target="sceneType"/>
          <zeebe:input source="=appDid"     target="appDid"/>
          <zeebe:input source="=ckpt"       target="ckpt"/>
          <zeebe:input source="=&quot;anime&quot;" target="style"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRender</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Render" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
