<?xml version="1.0" encoding="UTF-8"?>
<!--
  shinshi.seedScenesWithVideo — bulk LTX/Wan i2v animation from latest image
  post per actress. Multi-instance (sequential) over slugs, calling the
  existing `shinshi.video.render` pyzeebe handler per slug.

  NSID: com.etzhayyim.apps.shinshi.seedScenesWithVideo
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_shinshi_seed_scenes_with_video"
    targetNamespace="https://etzhayyim.ai/bpmn/shinshi"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="shinshi_seed_scenes_with_video"
                name="shinshi seedScenesWithVideo"
                isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.shinshi.seedScenesWithVideo", "version": 1, "resultTimeoutMs": 1800000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_ToRender</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToRender" sourceRef="Start" targetRef="Task_Render"/>

    <!-- Multi-instance loop over slugs (sequential to keep RunPod queue depth low) -->
    <bpmn:serviceTask id="Task_Render" name="i2v animate per slug (multi-instance)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="shinshi.video.render"/>
        <zeebe:ioMapping>
          <zeebe:input source="=slug" target="slug"/>
          <zeebe:input source='=string join(["did:web:sh1n5h1x.etzhayyim.com:", slug], "")' target="actorDid"/>
          <zeebe:input source="=&quot;cinematic motion, smooth camera&quot;" target="motionPrompt"/>
          <zeebe:input source="=25" target="length"/>
          <zeebe:input source="=768" target="width"/>
          <zeebe:input source="=512" target="height"/>
          <zeebe:input source="=24" target="fps"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRender</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics
            inputCollection="=slugs"
            inputElement="slug"
            outputCollection="results"
            outputElement="={slug: slug, did: actorDid, videoBlobKey: blobKey, postUri: postUri, renderMs: renderMs}"/>
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Render" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
