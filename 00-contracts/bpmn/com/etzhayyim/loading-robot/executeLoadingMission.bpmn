<?xml version="1.0" encoding="UTF-8"?>
<!--
  Loading robot mission planning workflow.

  Inputs:
    requestId
    loadingRobotLoadPlan
    loadingRobotCellDesign
    missionId

  Outputs:
    loadingRobotMission
    auditRkey
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_loading_robot_execute_mission"
    targetNamespace="https://etzhayyim.ai/bpmn/loading-robot"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="loading_robot_execute_mission" name="Loading robot mission planning" isExecutable="true">
    <bpmn:startEvent id="Start" name="Mission request received">
      <bpmn:outgoing>Flow_Start_Mission</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_Mission" sourceRef="Start" targetRef="Task_PlanMission"/>

    <bpmn:serviceTask id="Task_PlanMission" name="Plan robot mission">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="loadingRobot.mission.plan"/>
        <zeebe:ioMapping>
          <zeebe:input source="=loadingRobotLoadPlan" target="loadingRobotLoadPlan"/>
          <zeebe:input source="=loadingRobotCellDesign" target="loadingRobotCellDesign"/>
          <zeebe:input source="=missionId" target="missionId"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Mission</bpmn:incoming>
      <bpmn:outgoing>Flow_Mission_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Mission_Audit" sourceRef="Task_PlanMission" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="Emit mission audit event">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:robot.etzhayyim.com:loading-robot&quot;" target="actor"/>
          <zeebe:input source="=&quot;loadingRobot.mission.planned&quot;" target="action"/>
          <zeebe:input source="={ requestId: requestId, mission: loadingRobotMission }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Mission_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="Mission planned">
      <bpmn:incoming>Flow_Audit_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
