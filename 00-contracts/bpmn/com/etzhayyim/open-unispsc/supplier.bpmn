<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_unispsc_supplier"
    targetNamespace="https://etzhayyim.ai/bpmn/open-unispsc"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_unispsc_supplier" name="UNSPSC サプライヤー 登録" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Screen"/>

    <!--
      riskTier:
        blocked       : country in {IRN, PRK, RUS, SYR, MMR}
        manual-review : qualityScore < 0.5 OR kycCleared = false
        approved      : qualityScore >= 0.7 AND kycCleared = true
        manual-review : otherwise
    -->
    <bpmn:serviceTask id="Task_Screen" name="risk 判定">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT 1 AS ok LIMIT 1&quot;" target="query"/>
          <zeebe:input source="=[]" target="params"/>
          <zeebe:output source="=if list contains([&quot;IRN&quot;,&quot;PRK&quot;,&quot;RUS&quot;,&quot;SYR&quot;,&quot;MMR&quot;], country) then &quot;blocked&quot;
                                else if qualityScore &lt; 0.5 or kycCleared = false then &quot;manual-review&quot;
                                else if qualityScore &gt;= 0.7 and kycCleared = true then &quot;approved&quot;
                                else &quot;manual-review&quot;" target="riskTier"/>
          <zeebe:output source="=qualityScore &lt; 0.7 or kycCleared = false" target="requireManualKyc"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_Save</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Save" sourceRef="Task_Screen" targetRef="Task_Save"/>

    <bpmn:serviceTask id="Task_Save" name="supplier 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_unispsc_supplier&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id: vertexId, supplier_did: supplierDid,
              commodity_code: commodityCode, legal_name: legalName,
              country: country, kyc_cleared: kycCleared,
              quality_score: qualityScore, risk_tier: riskTier,
              require_manual_kyc: requireManualKyc,
              status: &quot;registered&quot;, registered_at: registeredAt,
              created_at: string(now()), owner_did: callerDid,
              sensitivity_ord: 2, org_id: supplierDid,
              user_id: callerDid, actor_id: &quot;sys.bpmn.open-unispsc&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Save</bpmn:incoming><bpmn:outgoing>Flow_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Gate" sourceRef="Task_Save" targetRef="Gate"/>

    <bpmn:exclusiveGateway id="Gate" default="Flow_Approved">
      <bpmn:incoming>Flow_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Block</bpmn:outgoing>
      <bpmn:outgoing>Flow_Manual</bpmn:outgoing>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Block" sourceRef="Gate" targetRef="Task_AuditBlock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=riskTier = "blocked"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Manual" sourceRef="Gate" targetRef="Task_AuditManual">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=riskTier = "manual-review"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Approved" sourceRef="Gate" targetRef="Task_AuditApproved"/>

    <bpmn:serviceTask id="Task_AuditBlock" name="audit supplier.blocked">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-unispsc.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openUnispsc.supplier.blocked&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, supplierDid: supplierDid, country: country, commodityCode: commodityCode}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Block</bpmn:incoming><bpmn:outgoing>Flow_EB</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EB" sourceRef="Task_AuditBlock" targetRef="End_B"/>

    <bpmn:serviceTask id="Task_AuditManual" name="audit supplier.manualReview">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-unispsc.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openUnispsc.supplier.manualReview&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, supplierDid: supplierDid, qualityScore: qualityScore, kycCleared: kycCleared}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Manual</bpmn:incoming><bpmn:outgoing>Flow_EM</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EM" sourceRef="Task_AuditManual" targetRef="End_M"/>

    <bpmn:serviceTask id="Task_AuditApproved" name="audit supplier.approved">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-unispsc.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openUnispsc.supplier.approved&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, supplierDid: supplierDid, qualityScore: qualityScore, commodityCode: commodityCode}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approved</bpmn:incoming><bpmn:outgoing>Flow_EA</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EA" sourceRef="Task_AuditApproved" targetRef="End_A"/>

    <bpmn:endEvent id="End_A"><bpmn:incoming>Flow_EA</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_M"><bpmn:incoming>Flow_EM</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_B"><bpmn:incoming>Flow_EB</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
