<?xml version="1.0" encoding="UTF-8"?>
<!--
  shosha.etzhayyim.com — submitTrade workflow (XRPC com.etzhayyim.apps.shosha.submitTrade).

  Pipeline:
    1. shosha.comply.sanctionsCheck    counterparty + commodity sanctions match
    2. ExclusiveGateway                complyOk?
       Yes → shosha.trade.submit       insert vertex_shosha_trade with
                                        approvalState=pending|approved (size threshold)
       No  → audit + EndFail (return complyOk=false)
    3. generic.audit.emit              OCEL trail

  XRPC-bound (ADR-0056). Returns: ok / tradeId / vertexId / complyOk / approvalState.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_shosha_submit_trade"
    targetNamespace="https://etzhayyim.ai/bpmn/shosha"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="shosha_submit_trade" name="shosha submit trade" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.shosha.submitTrade", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="submitTrade">
      <bpmn:outgoing>Flow_ToComply</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Comply" name="sanctions / comply check">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="shosha.comply.sanctionsCheck"/>
        <zeebe:ioMapping>
          <zeebe:input source="=counterparty" target="counterparty"/>
          <zeebe:input source="=commodity" target="commodity"/>
          <zeebe:output source="=complyOk" target="complyOk"/>
          <zeebe:output source="=flags" target="complyFlags"/>
          <zeebe:output source="=rationale" target="complyRationale"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToComply</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToComply" sourceRef="Start" targetRef="Task_Comply"/>

    <bpmn:exclusiveGateway id="Gate_Comply" name="complyOk?">
      <bpmn:incoming>Flow_ToGate</bpmn:incoming>
      <bpmn:outgoing>Flow_Pass</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToGate" sourceRef="Task_Comply" targetRef="Gate_Comply"/>

    <bpmn:sequenceFlow id="Flow_Pass" sourceRef="Gate_Comply" targetRef="Task_Submit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=complyOk = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Fail" sourceRef="Gate_Comply" targetRef="Task_AuditFail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=complyOk = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_Submit" name="insert vertex_shosha_trade">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="shosha.trade.submit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=tradeId" target="tradeId"/>
          <zeebe:input source="=side" target="side"/>
          <zeebe:input source="=commodity" target="commodity"/>
          <zeebe:input source="=quantity" target="quantity"/>
          <zeebe:input source="=unit" target="unit"/>
          <zeebe:input source="=price" target="price"/>
          <zeebe:input source="=currency" target="currency"/>
          <zeebe:input source="=counterparty" target="counterparty"/>
          <zeebe:input source="=desk" target="desk"/>
          <zeebe:input source="=deliveryDate" target="deliveryDate"/>
          <zeebe:input source="=deliveryLocation" target="deliveryLocation"/>
          <zeebe:input source="=rationale" target="rationale"/>
          <zeebe:input source="=complyOk" target="complyOk"/>
          <zeebe:input source="=complyFlags" target="complyFlags"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=tradeId" target="tradeId"/>
          <zeebe:output source="=vertexId" target="vertexId"/>
          <zeebe:output source="=approvalState" target="approvalState"/>
          <zeebe:output source="=amountUsd" target="amountUsd"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Pass</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Submit" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit (success)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
                    <zeebe:input source="=&quot;did:web:shosha.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.shosha.submitTrade&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;tradeId&quot;: tradeId, &quot;approvalState&quot;: approvalState, &quot;amountUsd&quot;: amountUsd }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:serviceTask id="Task_AuditFail" name="audit emit (comply fail)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
                    <zeebe:input source="=&quot;did:web:shosha.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.shosha.submitTrade.complyFail&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;counterparty&quot;: counterparty, &quot;commodity&quot;: commodity, &quot;flags&quot;: complyFlags }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Fail</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndFail</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEndFail" sourceRef="Task_AuditFail" targetRef="EndFail"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndFail" name="comply blocked">
      <bpmn:incoming>Flow_ToEndFail</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
