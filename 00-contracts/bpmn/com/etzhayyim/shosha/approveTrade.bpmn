<?xml version="1.0" encoding="UTF-8"?>
<!--
  shosha.etzhayyim.com — approveTrade workflow (XRPC com.etzhayyim.apps.shosha.approveTrade).

  Phase 2d simplified — single-step XRPC. Multi-day message-event BPMN
  (waiting on approval signal from inside submitTrade) deferred to
  Phase 3.

  Pipeline:
    1. shosha.trade.approve   validate pending state + INSERT
                               vertex_shosha_approval + UPDATE
                               vertex_shosha_trade.approval_state='approved'
    2. generic.audit.emit     OCEL trail
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_shosha_approve_trade"
    targetNamespace="https://etzhayyim.ai/bpmn/shosha"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="shosha_approve_trade" name="shosha approve trade" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.shosha.approveTrade", "version": 1, "resultTimeoutMs": 30000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="approveTrade">
      <bpmn:outgoing>Flow_ToApprove</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Approve" name="approve trade decision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="shosha.trade.approve"/>
        <zeebe:ioMapping>
          <zeebe:input source="=tradeId" target="tradeId"/>
          <zeebe:input source="=approverDid" target="approverDid"/>
          <zeebe:input source="=approverRole" target="approverRole"/>
          <zeebe:input source="=rationale" target="rationale"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=approvalId" target="approvalId"/>
          <zeebe:output source="=vertexId" target="vertexId"/>
          <zeebe:output source="=tradeId" target="tradeId"/>
          <zeebe:output source="=approvalState" target="approvalState"/>
          <zeebe:output source="=decidedAt" target="decidedAt"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToApprove</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToApprove" sourceRef="Start" targetRef="Task_Approve"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:shosha.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.shosha.approveTrade&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;approvalId&quot;: approvalId, &quot;tradeId&quot;: tradeId, &quot;approvalState&quot;: approvalState, &quot;approverDid&quot;: approverDid }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Approve" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
