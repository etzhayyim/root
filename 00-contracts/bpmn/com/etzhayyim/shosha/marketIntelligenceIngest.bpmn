<?xml version="1.0" encoding="UTF-8"?>
<!--
  shosha.etzhayyim.com — market intelligence ingest (autonomous, R/PT1H).

  Pipeline:
    1. shosha.intel.ingestPrices    Yahoo v8 chart (CL=F, BZ=F, NG=F, GC=F, HG=F)
                                    + Frankfurter (USD/JPY, USD/CNY, USD/EUR)
    2. shosha.intel.ingestFreight   Baltic-style freight indices (Phase 1 stub)
    3. shosha.marketView.synth      LLM-aggregate intel into per-commodity view

  No XRPC entry. Pure timer-start BPMN-as-actor (ADR-0056).
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_shosha_market_intelligence_ingest"
    targetNamespace="https://etzhayyim.ai/bpmn/shosha"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="shosha_market_intelligence_ingest" name="shosha market intelligence ingest (hourly)" isExecutable="true">

    <bpmn:startEvent id="StartTimer" name="every 1 hour">
      <bpmn:outgoing>Flow_ToPrices</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT1H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Prices" name="ingest prices (oil / metals / FX)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="shosha.intel.ingestPrices"/>
        <zeebe:ioMapping>
          <zeebe:output source="=rows" target="priceRows"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPrices</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFreight</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToPrices" sourceRef="StartTimer" targetRef="Task_Prices"/>

    <bpmn:serviceTask id="Task_Freight" name="ingest freight indices">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="shosha.intel.ingestFreight"/>
        <zeebe:ioMapping>
          <zeebe:output source="=rows" target="freightRows"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToFreight</bpmn:incoming>
      <bpmn:outgoing>Flow_ToView</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToFreight" sourceRef="Task_Prices" targetRef="Task_Freight"/>

    <bpmn:serviceTask id="Task_MarketView" name="synthesize market view (LLM)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="shosha.marketView.synth"/>
        <zeebe:ioMapping>
          <zeebe:input source="=24" target="lookbackHours"/>
          <zeebe:output source="=views" target="viewsWritten"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToView</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToView" sourceRef="Task_Freight" targetRef="Task_MarketView"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
                    <zeebe:input source="=&quot;did:web:shosha.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.shosha.marketIntelligenceIngest&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;priceRows&quot;: priceRows, &quot;freightRows&quot;: freightRows, &quot;viewsWritten&quot;: viewsWritten }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_MarketView" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
