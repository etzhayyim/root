<?xml version="1.0" encoding="UTF-8"?>
<!--
  shosha.etzhayyim.com — react to upstream actors (autonomous, R/PT5M).

  Polls vertex_repo_record for commits from configured upstream actors
  (oil-trading, cargo, port — Phase 2a hard-coded set; table-driven
  subscriptions deferred to Phase 2a-extended). For each new commit
  beyond the consumer cursor, the LLM synthesizes a reaction
  (trade idea / hedge suggestion / risk alert / pass). Reactions land
  in vertex_shosha_reaction; cursor is advanced.

  Phase 2a (2026-05-07). Pull-based; no upstream actor changes needed.
  AT-Protocol-friendly (we read other actors' AT records via the
  graph-projected vertex_repo_record table, no signed-data exchange).
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_shosha_react_to_upstream"
    targetNamespace="https://etzhayyim.ai/bpmn/shosha"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="shosha_react_to_upstream" name="shosha react to upstream actors (5 min)" isExecutable="true">

    <bpmn:startEvent id="StartTimer" name="every 5 minutes">
      <bpmn:outgoing>Flow_ToScan</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT5M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Scan" name="scan upstream commits + emit reactions">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="shosha.reactive.scanUpstream"/>
        <zeebe:ioMapping>
          <zeebe:input source="=20" target="batchPerUpstream"/>
          <zeebe:output source="=upstreamsScanned" target="upstreamsScanned"/>
          <zeebe:output source="=recordsSeen" target="recordsSeen"/>
          <zeebe:output source="=reactionsEmitted" target="reactionsEmitted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToScan</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToScan" sourceRef="StartTimer" targetRef="Task_Scan"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:shosha.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.shosha.reactToUpstream&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;upstreamsScanned&quot;: upstreamsScanned, &quot;recordsSeen&quot;: recordsSeen, &quot;reactionsEmitted&quot;: reactionsEmitted }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Scan" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
