<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_judge_list_judges" targetNamespace="https://etzhayyim.ai/bpmn/judge" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="judge_list_judges" name="listJudges" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Select"/>
    <bpmn:serviceTask id="Task_Select" name="select judges">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.select" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT vertex_id, judge_did, full_name, court_did, jurisdiction, appointed_at FROM vertex_judge WHERE ($1::varchar IS NULL OR jurisdiction = $1) AND ($2::varchar IS NULL OR court_did = $2) ORDER BY full_name LIMIT $3 OFFSET $4&quot;" target="sql"/>
          <zeebe:input source="=[jurisdiction, courtDid, limit, offset]" target="params"/>
          <zeebe:output source="=rows" target="judges"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Select" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
