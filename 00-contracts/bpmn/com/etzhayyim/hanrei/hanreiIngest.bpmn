<?xml version="1.0" encoding="UTF-8"?>
<!--
  Timer-start BPMN — Hanrei daily ingest (判例 + jurisdiction collection jobs).

  Pipeline:

    1. hanrei.register.courtProfiles  — idempotent: register 6 JP court + 2 source
                                        DID rows into vertex_hanrei_court.
    2. hanrei.register.jurisdictions  — idempotent: register 75 national + 8 intl
                                        court jurisdiction DID rows.
    3. hanrei.collect.cases           — create queued collection jobs for all 6
                                        courts.go.jp search pages (p1..10 each).
    4. hanrei.collect.egovLaws        — create queued collection jobs for e-Gov
                                        法令API categories 1-4 (CC BY 4.0).
    5. hanrei.collect.wikidataCourts  — create queued collection jobs for Wikidata
                                        SPARQL (CC0).
    6. generic.audit.emit             — OCEL event with aggregate job counts.

  Cadence: R/PT24H. One BPMN instance per day.

  NSID: com.etzhayyim.apps.hanrei.hanreiIngest
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/hanrei-ingest-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_hanrei_ingest"
    targetNamespace="https://etzhayyim.ai/bpmn/hanrei"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="hanrei_ingest" name="hanrei ingest" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.hanrei.hanreiIngest", "version": 1, "resultTimeoutMs": 600000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start_Timer" name="every 24 hours">
      <bpmn:outgoing>Flow_ToRegisterCourts</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_PT24H">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT24H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Manual" name="manual / on-demand">
      <bpmn:outgoing>Flow_ToRegisterCourts_Manual</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_ToRegisterCourts"        sourceRef="Start_Timer"             targetRef="Task_RegisterCourts"/>
    <bpmn:sequenceFlow id="Flow_ToRegisterCourts_Manual" sourceRef="Start_Manual"             targetRef="Task_RegisterCourts"/>
    <bpmn:sequenceFlow id="Flow_ToRegisterJurisdictions" sourceRef="Task_RegisterCourts"      targetRef="Task_RegisterJurisdictions"/>
    <bpmn:sequenceFlow id="Flow_ToCollectCases"          sourceRef="Task_RegisterJurisdictions" targetRef="Task_CollectCases"/>
    <bpmn:sequenceFlow id="Flow_ToEgovLaws"              sourceRef="Task_CollectCases"         targetRef="Task_EgovLaws"/>
    <bpmn:sequenceFlow id="Flow_ToWikidata"              sourceRef="Task_EgovLaws"             targetRef="Task_Wikidata"/>
    <bpmn:sequenceFlow id="Flow_ToJobGate"               sourceRef="Task_Wikidata"             targetRef="Gateway_JobsCreated"/>
    <bpmn:sequenceFlow id="Flow_ToAudit"                 sourceRef="Gateway_JobsCreated"       targetRef="Task_Audit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(caseJobsCreated) + count(egovJobsCreated) + count(wikidataJobsCreated) &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoJobs"                  sourceRef="Gateway_JobsCreated"       targetRef="Task_AuditNoJobs"/>
    <bpmn:sequenceFlow id="Flow_End"                     sourceRef="Task_Audit"                targetRef="End"/>
    <bpmn:sequenceFlow id="Flow_NoJobsEnd"               sourceRef="Task_AuditNoJobs"          targetRef="End"/>

    <!-- Step 1: Register JP court + source profiles (idempotent). -->
    <bpmn:serviceTask id="Task_RegisterCourts" name="register JP court profiles">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="hanrei.register.courtProfiles"/>
        <zeebe:ioMapping>
          <zeebe:output source="=registered" target="courtsRegistered"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- Step 2: Register jurisdiction DIDs (idempotent, offset=0 limit=200 covers all 83). -->
    <bpmn:serviceTask id="Task_RegisterJurisdictions" name="register jurisdiction DIDs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="hanrei.register.jurisdictions"/>
        <zeebe:ioMapping>
          <zeebe:input source="=0"   target="offset"/>
          <zeebe:input source="=200" target="limit"/>
          <zeebe:output source="=registered" target="jurisdictionsRegistered"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- Step 3: Create queued collection jobs for all 6 courts.go.jp search pages. -->
    <bpmn:serviceTask id="Task_CollectCases" name="create case collection jobs (6 courts × 10 pages)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="hanrei.collect.cases"/>
        <zeebe:ioMapping>
          <zeebe:input source="=10"  target="maxPages"/>
          <zeebe:output source="=jobs" target="caseJobsCreated"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- Step 4: Create collection jobs for e-Gov法令API categories 1-4 (CC BY 4.0). -->
    <bpmn:serviceTask id="Task_EgovLaws" name="create e-Gov法令 collection jobs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="hanrei.collect.egovLaws"/>
        <zeebe:ioMapping>
          <zeebe:output source="=jobs" target="egovJobsCreated"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- Step 5: Create collection jobs for Wikidata SPARQL (CC0). -->
    <bpmn:serviceTask id="Task_Wikidata" name="create Wikidata SPARQL collection jobs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="hanrei.collect.wikidataCourts"/>
        <zeebe:ioMapping>
          <zeebe:output source="=jobs" target="wikidataJobsCreated"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_JobsCreated" name="collection jobs created?">
      <bpmn:incoming>Flow_ToJobGate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoJobs</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Step 6: Emit OCEL audit event with aggregate job counts. -->
    <bpmn:serviceTask id="Task_Audit" name="emit ingest audit event">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.hanrei.hanreiIngest&quot;" target="event_type"/>
          <zeebe:input source="=&quot;did:web:hanrei.etzhayyim.com&quot;"            target="actor_did"/>
          <zeebe:input source="={ caseJobsCreated: caseJobsCreated, egovJobsCreated: egovJobsCreated, wikidataJobsCreated: wikidataJobsCreated, courtsRegistered: courtsRegistered, jurisdictionsRegistered: jurisdictionsRegistered }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_AuditNoJobs" name="audit no collection jobs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.hanrei.hanreiIngest.abort&quot;" target="event_type"/>
          <zeebe:input source="=&quot;did:web:hanrei.etzhayyim.com&quot;" target="actor_did"/>
          <zeebe:input source="={ reason: &quot;no_collection_jobs_created&quot;, caseJobsCreated: caseJobsCreated, egovJobsCreated: egovJobsCreated, wikidataJobsCreated: wikidataJobsCreated }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_End</bpmn:incoming>
      <bpmn:incoming>Flow_NoJobsEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
