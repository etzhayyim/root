<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_ai_governance_register_model" targetNamespace="https://etzhayyim.ai/bpmn/open-ai-governance" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_ai_governance_register_model" name="registerModel" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_ai_governance&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, model_id: modelId, developer_lei: developerLei, eu_ai_act_risk_class: euAiActRiskClass, nist_category: nistCategory, cyber_compliance_vid: cyberComplianceVid, esg_rating_vid: esgRatingVid, training_dataset_disclosed: trainingDatasetDisclosed, registered_at: registeredAt, gate_tier: if euAiActRiskClass = &quot;unacceptable&quot; then &quot;banned&quot; else if euAiActRiskClass = &quot;high&quot; then &quot;conformity_assessment&quot; else if euAiActRiskClass = &quot;general_purpose&quot; then &quot;transparency_only&quot; else &quot;exempt&quot;, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-ai-governance&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-ai-governance.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;open.aiGovernance.registerModel&quot;" target="action"/><zeebe:input source="={vertexId: vertexId}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>