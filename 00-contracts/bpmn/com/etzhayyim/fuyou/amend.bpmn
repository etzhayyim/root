<?xml version="1.0" encoding="UTF-8"?>
<!--
  ADR-0051 — fuyou_amend.

  年中の異動申告フロー。
  - 出生 / 死亡            = 即時反映 (HR review skip)
  - 婚姻 / 離婚 / 収入変動 / 認定変更 = HR review 必要

  Variables:
    in:
      employeeDid, employerOrgId, taxYear, vertexId
      amendmentDate, amendmentReason, amendmentDescription
      amendmentPayload (signal:v1: encrypted JSON of changed sub-fields)

    out:
      finalStatus = "amended" | "rejected"
      effectiveFromMonth (YYYY-MM)
      kaikeiPropagated, auditRkey
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_fuyou_amend"
    targetNamespace="https://etzhayyim.ai/bpmn/fuyou"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="fuyou_amend" name="扶養控除等異動申告" isExecutable="true">

    <bpmn:startEvent id="Start" name="異動発生">
      <bpmn:outgoing>Flow_S</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_LoadLatest"/>

    <!-- 1. Load the latest declaration row for the employee/year. -->
    <bpmn:serviceTask id="Task_LoadLatest" name="最新申告ロード">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_fuyou_declaration&quot;" target="table"/>
          <zeebe:input source="=&quot;employee_did = %s AND tax_year = %s&quot;" target="whereExpr"/>
          <zeebe:input source="=[employeeDid, taxYear]" target="whereParams"/>
          <zeebe:input source="=&quot;vertex_id, status, amendment_count, declaration_hash&quot;" target="columns"/>
          <zeebe:input source="=1" target="limit"/>
          <zeebe:input source="=&quot;submitted_at DESC&quot;" target="orderBy"/>
          <zeebe:output source="=rows"     target="latestRows"/>
          <zeebe:output source="=rowCount" target="latestCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming>
      <bpmn:outgoing>Flow_F1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F1" sourceRef="Task_LoadLatest" targetRef="Task_FormAmend"/>

    <!-- 2. Employee fills the amendment form. Pre-filled with the latest
         declaration. -->
    <bpmn:userTask id="Task_FormAmend" name="異動申告フォーム入力">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:fuyou-amend-v1"/>
        <zeebe:assignmentDefinition candidateGroups="employee"/>
        <zeebe:taskSchedule dueDate="=now() + duration(&quot;P14D&quot;)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F1</bpmn:incoming>
      <bpmn:incoming>Flow_LoopBack</bpmn:incoming>
      <bpmn:outgoing>Flow_F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_F2" sourceRef="Task_FormAmend" targetRef="Task_AppendLog"/>

    <!-- 3. Append amendment to the Tier 3 amendment_log. -->
    <bpmn:serviceTask id="Task_AppendLog" name="amendment_log に追記 (Tier 3)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <!--
            Strictly speaking we should UPDATE, not INSERT-replace.
            For Phase 1 we model amendment_log as separate Tier 3 rows
            keyed by {vertexId}:amend:{ts} so we can stay on the
            insert-with-WHERE-NOT-EXISTS shape that generic.db.insert
            already supports under RisingWave constraints.
          -->
          <zeebe:input source="=&quot;vertex_fuyou_declaration_pii&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:           vertexId + &quot;:amend:&quot; + string(now()),
              applicant_payload:   &quot;&quot;,
              spouse_payload:      &quot;&quot;,
              dependents_payload:  &quot;&quot;,
              minor_dep_payload:   &quot;&quot;,
              special_status:      &quot;&quot;,
              amendment_log:       string(amendmentPayload),
              retention_until:     date and time(date(&quot;9999-12-31&quot;), time(&quot;00:00:00&quot;)),
              created_at:          string(now()),
              owner_did:           employeeDid,
              sensitivity_ord:     3,
              org_id:              employerOrgId,
              user_id:             employeeDid,
              actor_id:            &quot;sys.bpmn.fuyou.amend&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
          <zeebe:output source="=inserted" target="amendInserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F2</bpmn:incoming>
      <bpmn:outgoing>Flow_F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F3" sourceRef="Task_AppendLog" targetRef="Gate_NeedsHR"/>

    <!-- 4. HR review needed? Births and deaths skip; everything else
         requires HR sign-off. -->
    <bpmn:exclusiveGateway id="Gate_NeedsHR" name="HR 確認?" default="Flow_NeedHR">
      <bpmn:incoming>Flow_F3</bpmn:incoming>
      <bpmn:outgoing>Flow_SkipHR</bpmn:outgoing>
      <bpmn:outgoing>Flow_NeedHR</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_SkipHR" sourceRef="Gate_NeedsHR" targetRef="Task_AutoApprove">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=amendmentMeta.amendmentReason in ("birth","death")</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NeedHR" sourceRef="Gate_NeedsHR" targetRef="Task_HRReviewAmend"/>

    <!-- 5a. Direct path: birth/death auto-approve. -->
    <bpmn:serviceTask id="Task_AutoApprove" name="自動承認 (出生/死亡)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_fuyou_declaration&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:        vertexId,
              employee_did:     employeeDid,
              employer_org_id:  employerOrgId,
              tax_year:         taxYear,
              process_type:     &quot;amend&quot;,
              status:           &quot;amended&quot;,
              declaration_hash: &quot;amend:&quot; + string(now()),
              amendment_count:  if latestCount &gt; 0 then number(latestRows[1].amendment_count) + 1 else 1,
              submitted_at:     string(now()),
              approved_at:      string(now()),
              approved_by_did:  &quot;did:web:jpn.payroll.etzhayyim.com:fuyou&quot;,
              created_at:       string(now()),
              owner_did:        employeeDid,
              sensitivity_ord:  1,
              org_id:           employerOrgId,
              user_id:          employeeDid,
              actor_id:         &quot;sys.bpmn.fuyou.amend&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;replace&quot;" target="onConflict"/>
          <zeebe:output source="=&quot;amended&quot;" target="finalStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SkipHR</bpmn:incoming>
      <bpmn:outgoing>Flow_F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F5" sourceRef="Task_AutoApprove" targetRef="Task_PropagateKaikei"/>

    <!-- 5b. HR review path. -->
    <bpmn:userTask id="Task_HRReviewAmend" name="HR レビュー (異動)">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:fuyou-review-v1"/>
        <zeebe:assignmentDefinition candidateGroups="hr-officer"/>
        <zeebe:taskSchedule dueDate="=now() + duration(&quot;P7D&quot;)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NeedHR</bpmn:incoming>
      <bpmn:outgoing>Flow_F4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_F4" sourceRef="Task_HRReviewAmend" targetRef="Gate_Approved"/>

    <bpmn:exclusiveGateway id="Gate_Approved" name="承認?" default="Flow_Reject">
      <bpmn:incoming>Flow_F4</bpmn:incoming>
      <bpmn:outgoing>Flow_Approve</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Approve" sourceRef="Gate_Approved" targetRef="Task_MarkAmended">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verdict.decision = "approve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Reject" sourceRef="Gate_Approved" targetRef="Task_AuditRejected"/>

    <bpmn:serviceTask id="Task_MarkAmended" name="承認状態に更新">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_fuyou_declaration&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:        vertexId,
              employee_did:     employeeDid,
              employer_org_id:  employerOrgId,
              tax_year:         taxYear,
              process_type:     &quot;amend&quot;,
              status:           &quot;amended&quot;,
              declaration_hash: &quot;amend:&quot; + string(now()),
              amendment_count:  if latestCount &gt; 0 then number(latestRows[1].amendment_count) + 1 else 1,
              submitted_at:     string(now()),
              approved_at:      string(now()),
              approved_by_did:  string(reviewerDid),
              created_at:       string(now()),
              owner_did:        employeeDid,
              sensitivity_ord:  1,
              org_id:           employerOrgId,
              user_id:          employeeDid,
              actor_id:         &quot;sys.bpmn.fuyou.amend&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;replace&quot;" target="onConflict"/>
          <zeebe:output source="=&quot;amended&quot;" target="finalStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F6" sourceRef="Task_MarkAmended" targetRef="Task_PropagateKaikei"/>

    <!-- 6. Trigger kaikei recompute from the amendment month forward. -->
    <bpmn:serviceTask id="Task_PropagateKaikei" name="kaikei に propagate (異動月から)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.kaikei.recomputeWithholding&quot;" target="type"/>
          <zeebe:input source="={
              employeeDid:        employeeDid,
              employerOrgId:      employerOrgId,
              taxYear:            taxYear,
              effectiveFromMonth: substring(string(amendmentMeta.amendmentDate), 1, 7),
              triggerVertexId:    vertexId,
              triggerSource:      &quot;com.etzhayyim.apps.fuyou.amendDeclaration&quot;,
              amendmentReason:    string(amendmentMeta.amendmentReason)
          }" target="payload"/>
          <zeebe:input source="=&quot;did:web:jpn.payroll.etzhayyim.com:fuyou&quot;" target="callerDid"/>
          <zeebe:output source="=ok"     target="kaikeiPropagated"/>
          <zeebe:output source="=status" target="kaikeiHttpStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F5</bpmn:incoming>
      <bpmn:incoming>Flow_F6</bpmn:incoming>
      <bpmn:outgoing>Flow_AuditOk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AuditOk" sourceRef="Task_PropagateKaikei" targetRef="Task_AuditAmended"/>

    <bpmn:serviceTask id="Task_AuditAmended" name="audit: amended">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:jpn.payroll.etzhayyim.com:fuyou&quot;" target="actor"/>
          <zeebe:input source="=&quot;fuyou.amend&quot;" target="action"/>
          <zeebe:input source="={
              vertexId:           vertexId,
              employeeDid:        employeeDid,
              employerOrgId:      employerOrgId,
              taxYear:            taxYear,
              amendmentReason:    string(amendmentMeta.amendmentReason),
              amendmentDate:      string(amendmentMeta.amendmentDate),
              kaikeiPropagated:   kaikeiPropagated
          }" target="payload"/>
          <zeebe:output source="=rkey" target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AuditOk</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_AuditAmended" targetRef="End"/>

    <!-- Reject path. -->
    <bpmn:serviceTask id="Task_AuditRejected" name="audit: rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:jpn.payroll.etzhayyim.com:fuyou&quot;" target="actor"/>
          <zeebe:input source="=&quot;fuyou.amend.reject&quot;" target="action"/>
          <zeebe:input source="={
              vertexId:        vertexId,
              employeeDid:     employeeDid,
              employerOrgId:   employerOrgId,
              taxYear:         taxYear,
              amendmentReason: string(amendmentMeta.amendmentReason),
              comment:         string(verdict.comment)
          }" target="payload"/>
          <zeebe:output source="=rkey" target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_LoopBack</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_LoopBack" sourceRef="Task_AuditRejected" targetRef="Task_FormAmend"/>

    <bpmn:endEvent id="End" name="完了">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
