<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_malacca_emission_compliance"
    targetNamespace="https://etzhayyim.ai/bpmn/open-malacca-emission"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_malacca_emission_compliance" name="IMO CII/EEXI" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="compliance 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_malacca_imo_compliance&quot;" target="table"/>
          <zeebe:input source="={vertex_id: vertexId, compliance_id: complianceId, imo: imo, metric: metric, rating: rating, numeric_value: numericValue, compliance_tier: if list contains([&quot;A&quot;], rating) then &quot;excellent&quot; else if list contains([&quot;B&quot;,&quot;C&quot;], rating) then &quot;satisfactory&quot; else if rating = &quot;D&quot; then &quot;inferior&quot; else &quot;non-compliant&quot;, require_action: list contains([&quot;D&quot;,&quot;E&quot;], rating), measured_period: measuredPeriod, reported_at: reportedAt, status: &quot;published&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-malacca-emission&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit openMalaccaEmission.compliance.record">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-malacca-emission.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openMalaccaEmission.compliance.record&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, imo: imo, metric: metric, rating: rating}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
