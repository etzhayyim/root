<?xml version="1.0" encoding="UTF-8"?>
<!--
  etzhayyim.ai chat — conversation archive (timer-start, autonomous, R/P7D).

  Conversations idle > 90 d → status='archived', dump rolled into
  Iceberg parquet (read-only cold tier). Active hot store stays
  small for fast IVF / RAG.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_chat_conversation_archive"
    targetNamespace="https://etzhayyim.ai/bpmn/chat"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="chat_conversation_archive" name="chat conversation archive" isExecutable="true">

    <bpmn:documentation>
      { "version": 1, "schedule": "weekly Sunday 02:00 UTC" }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="weekly Sunday 02:00 UTC">
      <bpmn:outgoing>Flow_ToArchive</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_Weekly">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 2 ? * SUN</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Archive" name="archive idle conversations">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="chat.conversation.archive"/>
        <zeebe:ioMapping>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=archivedConversations" target="archivedConversations"/>
          <zeebe:output source="=archivedMessages" target="archivedMessages"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToArchive</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToArchive" sourceRef="Start" targetRef="Task_Archive"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:etzhayyim.ai&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.chat.conversationArchive&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;archivedConversations&quot;: archivedConversations, &quot;archivedMessages&quot;: archivedMessages }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Archive" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
