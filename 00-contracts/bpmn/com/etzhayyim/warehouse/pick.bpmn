<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pick stock for an outbound order line.

  Inputs:
    requestId
    orderId
    skuCode
    quantity

  Outputs:
    pickVertexId
    pickedFromBins
    auditRkey
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_warehouse_pick"
    targetNamespace="https://etzhayyim.ai/bpmn/warehouse"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="warehouse_pick" name="Warehouse pick" isExecutable="true">
    <bpmn:startEvent id="Start" name="Pick requested">
      <bpmn:outgoing>Flow_Start_Allocate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_Allocate" sourceRef="Start" targetRef="Task_Allocate"/>

    <bpmn:serviceTask id="Task_Allocate" name="Allocate stock to pick">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="warehouse.pick.allocate"/>
        <zeebe:ioMapping>
          <zeebe:input source="=orderId" target="orderId"/>
          <zeebe:input source="=skuCode" target="skuCode"/>
          <zeebe:input source="=quantity" target="quantity"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Allocate</bpmn:incoming>
      <bpmn:outgoing>Flow_Allocate_Persist</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Allocate_Persist" sourceRef="Task_Allocate" targetRef="Task_Persist"/>

    <bpmn:serviceTask id="Task_Persist" name="Persist pick vertex">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="warehouse.pick.persist"/>
        <zeebe:ioMapping>
          <zeebe:input source="=orderId" target="orderId"/>
          <zeebe:input source="=skuCode" target="skuCode"/>
          <zeebe:input source="=quantity" target="quantity"/>
          <zeebe:input source="=pickedFromBins" target="pickedFromBins"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Allocate_Persist</bpmn:incoming>
      <bpmn:outgoing>Flow_Persist_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Persist_Audit" sourceRef="Task_Persist" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="Emit pick audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:warehouse.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;warehouse.pick.completed&quot;" target="action"/>
          <zeebe:input source="={ requestId: requestId, pickVertexId: pickVertexId, bins: pickedFromBins }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Persist_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="Pick completed">
      <bpmn:incoming>Flow_Audit_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
