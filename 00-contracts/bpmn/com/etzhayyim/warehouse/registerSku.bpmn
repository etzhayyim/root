<?xml version="1.0" encoding="UTF-8"?>
<!--
  Register a SKU / item master record.

  Inputs:
    requestId
    skuCode
    description
    unitOfMeasure
    weightKg

  Outputs:
    skuVertexId
    auditRkey
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_warehouse_register_sku"
    targetNamespace="https://etzhayyim.ai/bpmn/warehouse"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="warehouse_register_sku" name="Warehouse register SKU" isExecutable="true">
    <bpmn:startEvent id="Start" name="SKU registration requested">
      <bpmn:outgoing>Flow_Start_Register</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_Register" sourceRef="Start" targetRef="Task_Register"/>

    <bpmn:serviceTask id="Task_Register" name="Persist SKU vertex">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="warehouse.sku.register"/>
        <zeebe:ioMapping>
          <zeebe:input source="=skuCode" target="skuCode"/>
          <zeebe:input source="=description" target="description"/>
          <zeebe:input source="=unitOfMeasure" target="unitOfMeasure"/>
          <zeebe:input source="=weightKg" target="weightKg"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Register</bpmn:incoming>
      <bpmn:outgoing>Flow_Register_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Register_Audit" sourceRef="Task_Register" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="Emit SKU registration audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:warehouse.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;warehouse.sku.registered&quot;" target="action"/>
          <zeebe:input source="={ requestId: requestId, skuVertexId: skuVertexId }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Register_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="SKU registered">
      <bpmn:incoming>Flow_Audit_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
