<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_os_messaging_crawl_open_channels"
    targetNamespace="https://etzhayyim.ai/bpmn/os-messaging"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="os_messaging_crawl_open_channels" name="os messaging crawl open channels" isExecutable="true">
    <bpmn:startEvent id="Start_Timer" name="every six hours">
      <bpmn:outgoing>Flow_Queue</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_6h">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">R/PT6H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Queue" sourceRef="Start_Timer" targetRef="Task_QueueSeeds"/>

    <bpmn:serviceTask id="Task_QueueSeeds" name="queue LINE/Telegram open-channel seeds">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="osMessaging.openChannels.queueSeedRuns"/>
        <zeebe:ioMapping>
          <zeebe:input source="=if seeds = null then [] else seeds" target="seeds"/>
          <zeebe:input source="=if seedLimit = null then 50 else seedLimit" target="limit"/>
          <zeebe:output source="=queued" target="queuedRuns"/>
          <zeebe:output source="=skipped" target="skippedSeeds"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Queue</bpmn:incoming>
      <bpmn:outgoing>Flow_Process</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Process" sourceRef="Task_QueueSeeds" targetRef="Task_ProcessQueue"/>

    <bpmn:serviceTask id="Task_ProcessQueue" name="process queued open-channel runs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="osMessaging.openChannels.processQueue"/>
        <zeebe:ioMapping>
          <zeebe:input source="=if maxRuns = null then 5 else maxRuns" target="maxRuns"/>
          <zeebe:input source="=if timeoutSec = null then 20 else timeoutSec" target="timeoutSec"/>
          <zeebe:output source="=processed" target="processedRuns"/>
          <zeebe:output source="=completed" target="completedRuns"/>
          <zeebe:output source="=failed" target="failedRuns"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Process</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_ProcessQueue" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit open-channel crawl">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:os-messaging.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;osMessaging.openChannels.crawl&quot;" target="action"/>
          <zeebe:input source="={queuedRuns: queuedRuns, skippedSeeds: skippedSeeds, processedRuns: processedRuns, completedRuns: completedRuns, failedRuns: failedRuns}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="completed">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
