<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_gas_report_leak"
    targetNamespace="https://etzhayyim.ai/bpmn/open-gas"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_gas_report_leak" name="ガス漏れ 報告" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Classify"/>

    <!--
      DOT 49 CFR 192.703 aligned:
        class 1: concentration >= 80% LEL OR nearIgnition = true  → immediate
        class 2: 20..79% LEL  → repair within 6 months
        class 3: < 20% LEL    → monitor
      requirePublicNotice = class 1
    -->
    <bpmn:serviceTask id="Task_Classify" name="class 分類">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT 1 AS ok LIMIT 1&quot;" target="query"/>
          <zeebe:input source="=[]" target="params"/>
          <zeebe:output source="=if concentrationLelPct &gt;= 80 or nearIgnition = true then 1
                                else if concentrationLelPct &gt;= 20 then 2 else 3" target="leakClass"/>
          <zeebe:output source="=concentrationLelPct &gt;= 80 or nearIgnition = true" target="requirePublicNotice"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_Save</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Save" sourceRef="Task_Classify" targetRef="Task_SaveLeak"/>

    <bpmn:serviceTask id="Task_SaveLeak" name="leak 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_gas_leak&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id: vertexId, utility_org_id: utilityOrgId,
              segment_vertex_id: segmentVertexId,
              latitude: latitude, longitude: longitude,
              concentration_lel_pct: concentrationLelPct, near_ignition: nearIgnition,
              leak_class: leakClass, require_public_notice: requirePublicNotice,
              status: &quot;open&quot;, reported_at: reportedAt, created_at: string(now()),
              owner_did: callerDid, sensitivity_ord: 1,
              org_id: utilityOrgId, user_id: callerDid, actor_id: &quot;sys.bpmn.open-gas&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Save</bpmn:incoming><bpmn:outgoing>Flow_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Gate" sourceRef="Task_SaveLeak" targetRef="Gate"/>

    <bpmn:exclusiveGateway id="Gate" default="Flow_Silent">
      <bpmn:incoming>Flow_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Notice</bpmn:outgoing>
      <bpmn:outgoing>Flow_Silent</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Notice" sourceRef="Gate" targetRef="Task_AuditMajor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=requirePublicNotice = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Silent" sourceRef="Gate" targetRef="Task_AuditSilent"/>

    <bpmn:serviceTask id="Task_AuditMajor" name="audit leak.class1">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-gas.etzhayyim.com:network&quot;" target="actor"/>
          <zeebe:input source="=&quot;openGas.leak.class1&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, leakClass: leakClass, segmentVertexId: segmentVertexId}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Notice</bpmn:incoming><bpmn:outgoing>Flow_EndM</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndM" sourceRef="Task_AuditMajor" targetRef="End_M"/>

    <bpmn:serviceTask id="Task_AuditSilent" name="audit leak.log">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-gas.etzhayyim.com:network&quot;" target="actor"/>
          <zeebe:input source="=&quot;openGas.leak.log&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, leakClass: leakClass, segmentVertexId: segmentVertexId}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Silent</bpmn:incoming><bpmn:outgoing>Flow_EndS</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndS" sourceRef="Task_AuditSilent" targetRef="End_S"/>

    <bpmn:endEvent id="End_S"><bpmn:incoming>Flow_EndS</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_M"><bpmn:incoming>Flow_EndM</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
