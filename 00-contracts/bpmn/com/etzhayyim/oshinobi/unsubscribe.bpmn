<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_oshinobi_unsubscribe"
    targetNamespace="https://etzhayyim.ai/bpmn/oshinobi"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="oshinobi_unsubscribe" name="oshinobi unsubscribe" isExecutable="true">

    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_Lookup</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Lookup" sourceRef="Start" targetRef="Task_Lookup"/>

    <bpmn:serviceTask id="Task_Lookup" name="subscription 取得">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_oshinobi_subscription&quot;" target="table"/>
          <zeebe:input source="={subscription_id: subscriptionId, subscriber_did: callerDid}" target="where"/>
          <zeebe:input source="=1" target="limit"/>
          <zeebe:input source="=&quot;subs&quot;" target="resultKey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Lookup</bpmn:incoming>
      <bpmn:outgoing>Flow_GateOwnership</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_GateOwnership" sourceRef="Task_Lookup" targetRef="Gate_Owned"/>

    <bpmn:exclusiveGateway id="Gate_Owned" name="owned?" default="Flow_NotOwned">
      <bpmn:incoming>Flow_GateOwnership</bpmn:incoming>
      <bpmn:outgoing>Flow_Owned</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotOwned</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Owned" sourceRef="Gate_Owned" targetRef="Task_Cancel">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(subs) &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotOwned" sourceRef="Gate_Owned" targetRef="End_NotSubscriber"/>

    <bpmn:endEvent id="End_NotSubscriber" name="NotSubscriber">
      <bpmn:incoming>Flow_NotOwned</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="Error_NotSubscriber"/>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_Cancel" name="cancelled に更新 (auto_renew=false)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_oshinobi_subscription&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:         subs[1].vertex_id,
              subscription_id:   subs[1].subscription_id,
              subscriber_did:    subs[1].subscriber_did,
              creator_did:       subs[1].creator_did,
              tier_id:           subs[1].tier_id,
              status:            &quot;cancelled&quot;,
              period_start:      subs[1].period_start,
              period_end:        subs[1].period_end,
              auto_renew:        false,
              payment_provider:  subs[1].payment_provider,
              last_charge_at:    subs[1].last_charge_at,
              last_charge_cents: subs[1].last_charge_cents,
              cancelled_at:      string(now()),
              cancel_reason:     reason,
              created_at:        subs[1].created_at,
              owner_did:         callerDid,
              sensitivity_ord:   1,
              org_id:            callerDid,
              user_id:           callerDid,
              actor_id:          &quot;sys.bpmn.oshinobi&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;replace&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Owned</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_Cancel" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit cancelled">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:oshinobi.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;oshinobi.subscription.cancelled&quot;" target="action"/>
          <zeebe:input source="={
              subscriptionId: subs[1].subscription_id,
              subscriberDid:  callerDid,
              creatorDid:     subs[1].creator_did,
              reason:         reason
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="cancelled">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <bpmn:error id="Error_NotSubscriber" errorCode="NotSubscriber" name="NotSubscriber"/>

</bpmn:definitions>
