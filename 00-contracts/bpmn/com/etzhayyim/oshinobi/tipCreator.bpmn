<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_oshinobi_tipCreator"
    targetNamespace="https://etzhayyim.ai/bpmn/oshinobi"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="oshinobi_tip_creator" name="oshinobi tipCreator" isExecutable="true">

    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_LookupCreator</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_LookupCreator" sourceRef="Start" targetRef="Task_LookupCreator"/>

    <bpmn:serviceTask id="Task_LookupCreator" name="creator 存在確認">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_oshinobi_creator&quot;" target="table"/>
          <zeebe:input source="={creator_did: creatorDid}" target="where"/>
          <zeebe:input source="=1" target="limit"/>
          <zeebe:input source="=&quot;creators&quot;" target="resultKey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_LookupCreator</bpmn:incoming>
      <bpmn:outgoing>Flow_GateCreator</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_GateCreator" sourceRef="Task_LookupCreator" targetRef="Gate_CreatorExists"/>

    <bpmn:exclusiveGateway id="Gate_CreatorExists" name="creator?" default="Flow_NoCreator">
      <bpmn:incoming>Flow_GateCreator</bpmn:incoming>
      <bpmn:outgoing>Flow_CreatorOk</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoCreator</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_CreatorOk" sourceRef="Gate_CreatorExists" targetRef="Task_Charge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(creators) &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoCreator" sourceRef="Gate_CreatorExists" targetRef="End_NoCreator"/>

    <bpmn:endEvent id="End_NoCreator" name="CreatorNotFound">
      <bpmn:incoming>Flow_NoCreator</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="Error_CreatorNotFound"/>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_Charge" name="processor charge tip">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="oshinobi.payment.charge" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=paymentToken" target="paymentToken"/>
          <zeebe:input source="=amountUsdCents" target="amountUsdCents"/>
          <zeebe:input source="=&quot;usd&quot;" target="currency"/>
          <zeebe:input source="=&quot;tip&quot;" target="kind"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CreatorOk</bpmn:incoming>
      <bpmn:outgoing>Flow_GateCharge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_GateCharge" sourceRef="Task_Charge" targetRef="Gate_ChargeOk"/>

    <bpmn:exclusiveGateway id="Gate_ChargeOk" name="captured?" default="Flow_Declined">
      <bpmn:incoming>Flow_GateCharge</bpmn:incoming>
      <bpmn:outgoing>Flow_Captured</bpmn:outgoing>
      <bpmn:outgoing>Flow_Declined</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Captured" sourceRef="Gate_ChargeOk" targetRef="Task_InsertTip">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=chargeResult.status = "captured"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Declined" sourceRef="Gate_ChargeOk" targetRef="End_Declined"/>

    <bpmn:endEvent id="End_Declined" name="PaymentDeclined">
      <bpmn:incoming>Flow_Declined</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="Error_PaymentDeclined"/>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_InsertTip" name="tip 保存 (message encrypted)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_oshinobi_tip&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:         tipVertexId,
              tip_id:            tipId,
              from_did:          callerDid,
              to_did:            creatorDid,
              post_uri:          postUri,
              amount_usd_cents:  amountUsdCents,
              payment_provider:  paymentProvider,
              payment_token_ref: chargeResult.tokenRef,
              status:            &quot;captured&quot;,
              message_cipher:    messageCipher,
              captured_at:       string(now()),
              created_at:        string(now()),
              owner_did:         callerDid,
              sensitivity_ord:   2,
              org_id:            callerDid,
              user_id:           callerDid,
              actor_id:          &quot;sys.bpmn.oshinobi&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Captured</bpmn:incoming>
      <bpmn:outgoing>Flow_Ledger</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Ledger" sourceRef="Task_InsertTip" targetRef="Task_LedgerDelta"/>

    <bpmn:serviceTask id="Task_LedgerDelta" name="payout_ledger delta">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_oshinobi_payout_ledger&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:         ledgerVertexId,
              entry_id:          ledgerEntryId,
              creator_did:       creatorDid,
              period:            substring(string(now()), 1, 7),
              source_kind:       &quot;tip&quot;,
              source_uri:        tipVertexId,
              gross_cents:       amountUsdCents,
              platform_fee_bps:  1500,
              net_cents:         amountUsdCents - (amountUsdCents * 1500 / 10000),
              status:            &quot;pending&quot;,
              created_at:        string(now()),
              owner_did:         creatorDid,
              sensitivity_ord:   1,
              org_id:            creatorDid,
              user_id:           creatorDid,
              actor_id:          &quot;sys.bpmn.oshinobi&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ledger</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_LedgerDelta" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit tip.captured">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:oshinobi.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;oshinobi.tip.captured&quot;" target="action"/>
          <zeebe:input source="={
              tipId:       tipId,
              fromDid:     callerDid,
              toDid:       creatorDid,
              postUri:     postUri,
              amountCents: amountUsdCents
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="captured">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <bpmn:error id="Error_CreatorNotFound" errorCode="CreatorNotFound" name="CreatorNotFound"/>
  <bpmn:error id="Error_PaymentDeclined" errorCode="PaymentDeclined" name="PaymentDeclined"/>

</bpmn:definitions>
