<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_oshinobi_publishPost"
    targetNamespace="https://etzhayyim.ai/bpmn/oshinobi"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="oshinobi_publish_post" name="oshinobi publishPost" isExecutable="true">

    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_LookupCreator</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_LookupCreator" sourceRef="Start" targetRef="Task_LookupCreator"/>

    <bpmn:serviceTask id="Task_LookupCreator" name="creator + content_policy 取得">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_oshinobi_creator&quot;" target="table"/>
          <zeebe:input source="={creator_did: callerDid}" target="where"/>
          <zeebe:input source="=1" target="limit"/>
          <zeebe:input source="=&quot;creators&quot;" target="resultKey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_LookupCreator</bpmn:incoming>
      <bpmn:outgoing>Flow_GateCreator</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_GateCreator" sourceRef="Task_LookupCreator" targetRef="Gate_IsCreator"/>

    <bpmn:exclusiveGateway id="Gate_IsCreator" name="creator?" default="Flow_NotCreator">
      <bpmn:incoming>Flow_GateCreator</bpmn:incoming>
      <bpmn:outgoing>Flow_IsCreator</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotCreator</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_IsCreator" sourceRef="Gate_IsCreator" targetRef="Gate_PolicyCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(creators) &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotCreator" sourceRef="Gate_IsCreator" targetRef="End_NotCreator"/>

    <bpmn:endEvent id="End_NotCreator" name="NotCreator">
      <bpmn:incoming>Flow_NotCreator</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="Error_NotCreator"/>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gate_PolicyCheck" name="content_label ≤ policy?" default="Flow_PolicyBlock">
      <bpmn:incoming>Flow_IsCreator</bpmn:incoming>
      <bpmn:outgoing>Flow_PolicyOk</bpmn:outgoing>
      <bpmn:outgoing>Flow_PolicyBlock</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_PolicyOk" sourceRef="Gate_PolicyCheck" targetRef="Task_InsertPost">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=(contentLabel = "safe") or (contentLabel = "suggestive" and creators[1].content_policy != "sfw_only") or (contentLabel = "adult" and creators[1].content_policy = "adult_allowed")</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PolicyBlock" sourceRef="Gate_PolicyCheck" targetRef="End_PolicyBlock"/>

    <bpmn:endEvent id="End_PolicyBlock" name="ContentPolicyBlock">
      <bpmn:incoming>Flow_PolicyBlock</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="Error_ContentPolicyBlock"/>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_InsertPost" name="post 保存 (encrypt if non-safe)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_oshinobi_post&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:       postVertexId,
              post_id:         postId,
              creator_did:     callerDid,
              tier_required:   tierRequired,
              content_label:   contentLabel,
              title:           title,
              teaser:          teaser,
              body_plain:      if contentLabel = &quot;safe&quot; then body else null,
              body_cipher:     if contentLabel != &quot;safe&quot; then bodyCipher else null,
              media_cids_json: string(mediaCids),
              price_usd_cents: priceUsdCents,
              published_at:    string(now()),
              created_at:      string(now()),
              owner_did:       callerDid,
              sensitivity_ord: if contentLabel = &quot;safe&quot; then 1 else 2,
              org_id:          callerDid,
              user_id:         callerDid,
              actor_id:        &quot;sys.bpmn.oshinobi&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PolicyOk</bpmn:incoming>
      <bpmn:outgoing>Flow_LabelGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_LabelGate" sourceRef="Task_InsertPost" targetRef="Gate_DispatchTeaser"/>

    <bpmn:exclusiveGateway id="Gate_DispatchTeaser" name="safe?" default="Flow_SkipTeaser">
      <bpmn:incoming>Flow_LabelGate</bpmn:incoming>
      <bpmn:outgoing>Flow_DispatchTeaser</bpmn:outgoing>
      <bpmn:outgoing>Flow_SkipTeaser</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_DispatchTeaser" sourceRef="Gate_DispatchTeaser" targetRef="Task_DispatchTeaser">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=contentLabel = "safe"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SkipTeaser" sourceRef="Gate_DispatchTeaser" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_DispatchTeaser" name="app.bsky.feed.post teaser">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;app.bsky.feed.post&quot;" target="collection"/>
          <zeebe:input source="=callerDid" target="repo"/>
          <zeebe:input source="={
              text:      (if title = null then &quot;&quot; else title + &quot;\n&quot;) + teaser,
              createdAt: string(now()),
              langs:     [&quot;ja&quot;]
          }" target="record"/>
          <zeebe:input source="=&quot;teaserResult&quot;" target="resultKey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DispatchTeaser</bpmn:incoming>
      <bpmn:outgoing>Flow_AuditSafe</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AuditSafe" sourceRef="Task_DispatchTeaser" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit post.published">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:oshinobi.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;oshinobi.post.published&quot;" target="action"/>
          <zeebe:input source="={
              postId:         postId,
              creatorDid:     callerDid,
              contentLabel:   contentLabel,
              tierRequired:   tierRequired,
              teaserPostUri:  teaserResult.uri
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SkipTeaser</bpmn:incoming>
      <bpmn:incoming>Flow_AuditSafe</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="published">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <bpmn:error id="Error_NotCreator"          errorCode="NotCreator"          name="NotCreator"/>
  <bpmn:error id="Error_ContentPolicyBlock"  errorCode="ContentPolicyBlock"  name="ContentPolicyBlock"/>

</bpmn:definitions>
