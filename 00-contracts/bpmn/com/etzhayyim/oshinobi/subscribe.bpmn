<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_oshinobi_subscribe"
    targetNamespace="https://etzhayyim.ai/bpmn/oshinobi"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="oshinobi_subscribe" name="oshinobi subscribe" isExecutable="true">

    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_LookupTier</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_LookupTier" sourceRef="Start" targetRef="Task_LookupTier"/>

    <bpmn:serviceTask id="Task_LookupTier" name="tier 存在確認">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_oshinobi_tier&quot;" target="table"/>
          <zeebe:input source="={creator_did: creatorDid, tier_id: tierId, status: &quot;active&quot;}" target="where"/>
          <zeebe:input source="=1" target="limit"/>
          <zeebe:input source="=&quot;tiers&quot;" target="resultKey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_LookupTier</bpmn:incoming>
      <bpmn:outgoing>Flow_GateTier</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_GateTier" sourceRef="Task_LookupTier" targetRef="Gate_TierExists"/>

    <bpmn:exclusiveGateway id="Gate_TierExists" name="tier 存在?" default="Flow_TierMissing">
      <bpmn:incoming>Flow_GateTier</bpmn:incoming>
      <bpmn:outgoing>Flow_TierOk</bpmn:outgoing>
      <bpmn:outgoing>Flow_TierMissing</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_TierOk" sourceRef="Gate_TierExists" targetRef="Task_Charge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(tiers) &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TierMissing" sourceRef="Gate_TierExists" targetRef="End_TierMissing"/>

    <bpmn:endEvent id="End_TierMissing" name="TierNotFound">
      <bpmn:incoming>Flow_TierMissing</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="Error_TierNotFound"/>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_Charge" name="processor charge">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="oshinobi.payment.charge" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=paymentToken" target="paymentToken"/>
          <zeebe:input source="=tiers[1].price_usd_cents" target="amountUsdCents"/>
          <zeebe:input source="=&quot;usd&quot;" target="currency"/>
          <zeebe:input source="=&quot;subscription&quot;" target="kind"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_TierOk</bpmn:incoming>
      <bpmn:outgoing>Flow_GateCharge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_GateCharge" sourceRef="Task_Charge" targetRef="Gate_ChargeOk"/>

    <bpmn:exclusiveGateway id="Gate_ChargeOk" name="charge ok?" default="Flow_ChargeFail">
      <bpmn:incoming>Flow_GateCharge</bpmn:incoming>
      <bpmn:outgoing>Flow_ChargeOk</bpmn:outgoing>
      <bpmn:outgoing>Flow_ChargeFail</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_ChargeOk" sourceRef="Gate_ChargeOk" targetRef="Task_InsertSubscription">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=chargeResult.status = "captured"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ChargeFail" sourceRef="Gate_ChargeOk" targetRef="Task_InsertSubscriptionFailed"/>

    <bpmn:serviceTask id="Task_InsertSubscription" name="subscription 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_oshinobi_subscription&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:         subscriptionVertexId,
              subscription_id:   subscriptionId,
              subscriber_did:    callerDid,
              creator_did:       creatorDid,
              tier_id:           tierId,
              status:            &quot;active&quot;,
              period_start:      string(now()),
              period_end:        string(now() + duration(if tiers[1].billing_period = &quot;monthly&quot; then &quot;P30D&quot; else if tiers[1].billing_period = &quot;quarterly&quot; then &quot;P90D&quot; else &quot;P365D&quot;)),
              auto_renew:        autoRenew,
              payment_provider:  paymentProvider,
              payment_token_ref: chargeResult.tokenRef,
              last_charge_at:    string(now()),
              last_charge_cents: tiers[1].price_usd_cents,
              created_at:        string(now()),
              owner_did:         callerDid,
              sensitivity_ord:   1,
              org_id:            callerDid,
              user_id:           callerDid,
              actor_id:          &quot;sys.bpmn.oshinobi&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;replace&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ChargeOk</bpmn:incoming>
      <bpmn:outgoing>Flow_InsertEdge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_InsertEdge" sourceRef="Task_InsertSubscription" targetRef="Task_InsertEdge"/>

    <bpmn:serviceTask id="Task_InsertEdge" name="subscribes_to edge">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;edge_oshinobi_subscribes_to&quot;" target="table"/>
          <zeebe:input source="={
              edge_id:         subscriptionVertexId,
              src_vid:         callerDid,
              dst_vid:         creatorDid,
              tier_id:         tierId,
              status:          &quot;active&quot;,
              period_end:      string(now() + duration(if tiers[1].billing_period = &quot;monthly&quot; then &quot;P30D&quot; else if tiers[1].billing_period = &quot;quarterly&quot; then &quot;P90D&quot; else &quot;P365D&quot;)),
              created_at:      string(now()),
              owner_did:       callerDid,
              sensitivity_ord: 1,
              org_id:          callerDid,
              user_id:         callerDid,
              actor_id:        &quot;sys.bpmn.oshinobi&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;replace&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_InsertEdge</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_InsertEdge" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit subscribed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:oshinobi.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;oshinobi.subscription.created&quot;" target="action"/>
          <zeebe:input source="={
              subscriptionId: subscriptionId,
              subscriberDid:  callerDid,
              creatorDid:     creatorDid,
              tierId:         tierId,
              amountCents:    tiers[1].price_usd_cents
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="active">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_InsertSubscriptionFailed" name="failed 状態で記録">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_oshinobi_subscription&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:         subscriptionVertexId,
              subscription_id:   subscriptionId,
              subscriber_did:    callerDid,
              creator_did:       creatorDid,
              tier_id:           tierId,
              status:            &quot;failed&quot;,
              period_start:      string(now()),
              period_end:        string(now()),
              auto_renew:        false,
              payment_provider:  paymentProvider,
              created_at:        string(now()),
              owner_did:         callerDid,
              sensitivity_ord:   1,
              org_id:            callerDid,
              user_id:           callerDid,
              actor_id:          &quot;sys.bpmn.oshinobi&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;replace&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ChargeFail</bpmn:incoming>
      <bpmn:outgoing>Flow_AuditFail</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AuditFail" sourceRef="Task_InsertSubscriptionFailed" targetRef="Task_AuditFail"/>

    <bpmn:serviceTask id="Task_AuditFail" name="audit payment_declined">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:oshinobi.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;oshinobi.subscription.payment_declined&quot;" target="action"/>
          <zeebe:input source="={
              subscriptionId: subscriptionId,
              subscriberDid:  callerDid,
              creatorDid:     creatorDid,
              tierId:         tierId,
              reason:         chargeResult.reason
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AuditFail</bpmn:incoming>
      <bpmn:outgoing>Flow_EndFail</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndFail" sourceRef="Task_AuditFail" targetRef="End_PaymentDeclined"/>

    <bpmn:endEvent id="End_PaymentDeclined" name="PaymentDeclined">
      <bpmn:incoming>Flow_EndFail</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="Error_PaymentDeclined"/>
    </bpmn:endEvent>

  </bpmn:process>

  <bpmn:error id="Error_TierNotFound"  errorCode="TierNotFound"  name="TierNotFound"/>
  <bpmn:error id="Error_PaymentDeclined" errorCode="PaymentDeclined" name="PaymentDeclined"/>

</bpmn:definitions>
