<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_banking_transfer"
    targetNamespace="https://etzhayyim.ai/bpmn/open-banking"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_banking_transfer" name="振替 (double-entry)" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Debit"/>

    <bpmn:serviceTask id="Task_Debit" name="debit (from)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_banking_ledger_entry&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:        string(transactionId) + &quot;:debit&quot;,
              account_vid:      fromAccountDid,
              transaction_id:   transactionId,
              direction:        &quot;debit&quot;,
              amount:           amount,
              currency:         currency,
              counterparty_vid: toAccountDid,
              memo:             memo,
              executed_at:      string(now()),
              created_at:       string(now()),
              owner_did:        callerDid,
              sensitivity_ord:  2,
              org_id:           callerDid,
              user_id:          callerDid,
              actor_id:         &quot;sys.bpmn.open-banking&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_C</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_C" sourceRef="Task_Debit" targetRef="Task_Credit"/>

    <bpmn:serviceTask id="Task_Credit" name="credit (to)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_banking_ledger_entry&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:        string(transactionId) + &quot;:credit&quot;,
              account_vid:      toAccountDid,
              transaction_id:   transactionId,
              direction:        &quot;credit&quot;,
              amount:           amount,
              currency:         currency,
              counterparty_vid: fromAccountDid,
              memo:             memo,
              executed_at:      string(now()),
              created_at:       string(now()),
              owner_did:        callerDid,
              sensitivity_ord:  2,
              org_id:           callerDid,
              user_id:          callerDid,
              actor_id:         &quot;sys.bpmn.open-banking&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_C</bpmn:incoming><bpmn:outgoing>Flow_E</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_E" sourceRef="Task_Credit" targetRef="Task_Edge"/>

    <bpmn:serviceTask id="Task_Edge" name="transfer pair edge">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;edge_open_banking_transfer_pair&quot;" target="table"/>
          <zeebe:input source="={
              edge_id:          transactionId,
              src_vid:          string(transactionId) + &quot;:debit&quot;,
              dst_vid:          string(transactionId) + &quot;:credit&quot;,
              transaction_id:   transactionId,
              created_at:       string(now()),
              owner_did:        callerDid,
              sensitivity_ord:  2,
              org_id:           callerDid,
              user_id:          callerDid,
              actor_id:         &quot;sys.bpmn.open-banking&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_E</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Edge" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit transfer.settled">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-banking.etzhayyim.com:core&quot;" target="actor"/>
          <zeebe:input source="=&quot;openBanking.transfer.settled&quot;" target="action"/>
          <zeebe:input source="={transactionId: transactionId, amount: amount, currency: currency, fromAccountDid: fromAccountDid, toAccountDid: toAccountDid}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
