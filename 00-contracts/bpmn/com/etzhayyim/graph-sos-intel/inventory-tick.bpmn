<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="graph-sos-intel-inventory-tick"
                  targetNamespace="https://etzhayyim.ai/bpmn/graph-sos-intel">
  <bpmn:process id="graphSosIntelInventoryTick" name="Graph SoS Intel — Inventory Tick (R/PT15M)" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Timer" name="R/PT15M timer">
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT15M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="StartEvent_Timer" targetRef="Task_InventoryCatalog"/>

    <bpmn:serviceTask id="Task_InventoryCatalog" name="com.etzhayyim.apps.graphSosIntel.inventoryCatalog"
                      camunda:topic="com.etzhayyim.apps.graphSosIntel.inventoryCatalog"/>
    <bpmn:sequenceFlow id="f2" sourceRef="Task_InventoryCatalog" targetRef="Task_WriteSnapshot"/>

    <bpmn:serviceTask id="Task_WriteSnapshot" name="com.etzhayyim.apps.graphSosIntel.writeSnapshot"
                      camunda:topic="com.etzhayyim.apps.graphSosIntel.writeSnapshot"/>
    <bpmn:sequenceFlow id="f3" sourceRef="Task_WriteSnapshot" targetRef="Task_DetectFindings"/>

    <bpmn:serviceTask id="Task_DetectFindings" name="com.etzhayyim.apps.graphSosIntel.detectFindings"
                      camunda:topic="com.etzhayyim.apps.graphSosIntel.detectFindings"/>
    <bpmn:sequenceFlow id="f4" sourceRef="Task_DetectFindings" targetRef="EndEvent_Done"/>

    <bpmn:endEvent id="EndEvent_Done" name="Snapshot written"/>
  </bpmn:process>
</bpmn:definitions>
