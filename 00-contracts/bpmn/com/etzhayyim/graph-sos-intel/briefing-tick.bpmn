<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="graph-sos-intel-briefing-tick"
                  targetNamespace="https://etzhayyim.ai/bpmn/graph-sos-intel">
  <bpmn:process id="graphSosIntelBriefingTick" name="Graph SoS Intel — Topology Briefing (R/PT6H)" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Timer" name="R/PT6H timer">
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT6H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="StartEvent_Timer" targetRef="Task_QuerySnapshot"/>

    <bpmn:serviceTask id="Task_QuerySnapshot" name="com.etzhayyim.apps.graphSosIntel.queryLatestSnapshot"
                      camunda:topic="com.etzhayyim.apps.graphSosIntel.queryLatestSnapshot"/>
    <bpmn:sequenceFlow id="f2" sourceRef="Task_QuerySnapshot" targetRef="Task_GenerateBriefing"/>

    <bpmn:serviceTask id="Task_GenerateBriefing" name="com.etzhayyim.apps.graphSosIntel.generateBriefing"
                      camunda:topic="com.etzhayyim.apps.graphSosIntel.generateBriefing"/>
    <bpmn:sequenceFlow id="f3" sourceRef="Task_GenerateBriefing" targetRef="Task_WriteFinding"/>

    <bpmn:serviceTask id="Task_WriteFinding" name="com.etzhayyim.apps.graphSosIntel.writeFinding"
                      camunda:topic="com.etzhayyim.apps.graphSosIntel.writeFinding"/>
    <bpmn:sequenceFlow id="f4" sourceRef="Task_WriteFinding" targetRef="EndEvent_Done"/>

    <bpmn:endEvent id="EndEvent_Done" name="Briefing finding written"/>
  </bpmn:process>
</bpmn:definitions>
