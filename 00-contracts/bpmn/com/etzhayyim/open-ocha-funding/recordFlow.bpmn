<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_ocha_funding_record_flow" targetNamespace="https://etzhayyim.ai/bpmn/open-ocha-funding" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_ocha_funding_record_flow" name="recordFlow" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_ocha_funding&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, flow_id: flowId, source_lei: sourceLei, source_type: sourceType, recipient_lei: recipientLei, recipient_type: recipientType, destination_iso3: destinationIso3, emergency_code: emergencyCode, sector_cluster: sectorCluster, amount_usd: amountUsd, pledged: pledged, flow_date: flowDate, recorded_at: recordedAt, scale_tier: if amountUsd &gt;= 100000000 then &quot;mega&quot; else if amountUsd &gt;= 10000000 then &quot;large&quot; else if amountUsd &gt;= 1000000 then &quot;medium&quot; else &quot;small&quot;, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-ocha-funding&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-ocha-funding.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;open.ochaFunding.recordFlow&quot;" target="action"/><zeebe:input source="={vertexId: vertexId}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>