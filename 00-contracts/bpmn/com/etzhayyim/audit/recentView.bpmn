<?xml version="1.0" encoding="UTF-8"?>
<!--
  F5 expansion — `audit.recentView` — read-only actor that lists the N
  most recent BPMN audit rows. Tests generic.db.select alone, which
  is the read-side mirror of audit.emit.

  Flow:
    Start (input: limit?)
      → generic.db.select   (vertex_repo_commit, collection='com.etzhayyim.bpmn.audit')
      → End

  Variables on the instance:
    in:  limit (optional, 1..200, default 20)
    out: rows (list of audit row dicts), rowCount
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_audit_recent_view"
    targetNamespace="https://etzhayyim.ai/bpmn/audit"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="audit_recent_view" name="audit recent view" isExecutable="true">

    <bpmn:startEvent id="Start" name="view requested">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_Select"/>

    <bpmn:serviceTask id="Task_Select" name="select recent audits">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_repo_commit&quot;" target="table"/>
          <zeebe:input source="=&quot;collection = %s&quot;" target="whereExpr"/>
          <zeebe:input source="=[&quot;com.etzhayyim.bpmn.audit&quot;]" target="whereParams"/>
          <zeebe:input source="=&quot;vertex_id, rkey, repo, ts_ms, value_json, created_at&quot;" target="columns"/>
          <zeebe:input source="=20"                           target="limit"/>
          <zeebe:input source="=&quot;ts_ms DESC&quot;"        target="orderBy"/>
          <zeebe:output source="=rows"     target="rows"/>
          <zeebe:output source="=rowCount" target="rowCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Select" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
