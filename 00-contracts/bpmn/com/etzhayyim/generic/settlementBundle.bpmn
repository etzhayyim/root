<?xml version="1.0" encoding="UTF-8"?>
<!--
  Settlement bundling — ADR 2605011300 (Q axis, throughput layer).

  Phase 1.2 mock-bundler: every 60s, scan vertex_market_settlement for
  Mokuteki-passed pending rows and amend each (PK upsert) with status
  = 'settled' and a deterministic SHA-256 anchor over the 5-tuple
  (issuer | lxm | quantity | unit_price | vertex_id). The anchor is
  written by handleSettleInvoice at POST time (settlement_tx_hash
  starts as 'anchor:sha256:...'), so this BPMN's only job is the
  status flip (PK overwrite using INSERT, since RW does not support
  UPDATE on regular tables — record-log semantics, ADR-2604251220).

  Phase 1.3 will replace this with a real ERC-4337 bundler call that
  produces a userOpHash and submits to a public bundler endpoint.

  NSID:      com.etzhayyim.market.settlementBundle
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/market-settlementBundle-v1
  binding allowlist: vertex_market_settlement
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_market_settlement_bundle"
    targetNamespace="https://etzhayyim.ai/bpmn/market"
    exporter="hand-written"
    exporterVersion="1.2">
  <bpmn:process id="market_settlement_bundle" name="market settlement bundle" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.market.settlementBundle", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start_Timer" name="every 60 seconds">
      <bpmn:outgoing>Flow_Timer</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_PT60S">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">R/PT60S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Timer" sourceRef="Start_Timer" targetRef="Task_Bundle"/>

    <!--
      INSERT … SELECT amends N pending rows in one atomic batch. Same
      vertex_id implicitly upserts; settlement_tx_hash already populated
      by handleSettleInvoice at POST time. We only flip status='pending'
      → 'settled' and stamp settled_at. mokuteki_floor_pass=TRUE filter
      prevents floor-violating rows from ever flowing to Q.
    -->
    <bpmn:serviceTask id="Task_Bundle" name="amend Mokuteki-passed pending → settled (PK upsert)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;INSERT INTO vertex_market_settlement (vertex_id, created_date, sensitivity_ord, owner_did, invoice_id, listing_id, listing_vertex_id, lane, issuer_did, payer_did, lxm, quantity, unit_price, total_price, currency, settlement_currency, settlement_tx_hash, status, mokuteki_floor_pass, memo, enqueued_at, settled_at, created_at, actor_did, at_did, org_id, user_id, actor_id, org_did) SELECT vertex_id, created_date, sensitivity_ord, owner_did, invoice_id, listing_id, listing_vertex_id, lane, issuer_did, payer_did, lxm, quantity, unit_price, total_price, currency, settlement_currency, settlement_tx_hash, 'settled', mokuteki_floor_pass, memo, enqueued_at, $1, created_at, actor_did, at_did, org_id, user_id, actor_id, org_did FROM vertex_market_settlement WHERE status = 'pending' AND mokuteki_floor_pass = TRUE&quot;" target="sql"/>
          <zeebe:input source="=[ string(now()) ]" target="params"/>
          <zeebe:output source="=inserted" target="amendedCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_Bundle_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Bundle_Audit" sourceRef="Task_Bundle" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="emit market.settlement.bundle OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.market.settlement.bundle&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;amendedCount&quot;: amendedCount, &quot;phase&quot;: &quot;1.2-mock-bundler&quot; }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Bundle_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_Audit_End</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
