<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_intel_get_counterparty_graph" targetNamespace="https://etzhayyim.ai/bpmn/intel" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="intel_get_counterparty_graph" name="getCounterpartyGraph" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_Start_Query</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_Query" sourceRef="Start" targetRef="Task_Query"/>
    <bpmn:serviceTask id="Task_Query" name="get counterparty graph">
      <bpmn:extensionElements><zeebe:taskDefinition type="intel.graph.counterparty"/>
        <zeebe:ioMapping>
          <zeebe:input source="=subjectVertexId" target="subjectVertexId"/>
          <zeebe:input source="=lei" target="lei"/>
          <zeebe:input source="=relationKinds" target="relationKinds"/>
          <zeebe:input source="=limit" target="limit"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Query</bpmn:incoming><bpmn:outgoing>Flow_Query_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Query_End" sourceRef="Task_Query" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_Query_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
