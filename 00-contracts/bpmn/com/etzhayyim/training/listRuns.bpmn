<?xml version="1.0" encoding="UTF-8"?>
<!--
  training.etzhayyim.com - listRuns query (XRPC com.etzhayyim.apps.training.listRuns).
  ADR-2605070700 + Addendum-of-Addendum.

  Read-only SELECT over vertex_training_run. Audit step omitted to keep
  vertex_repo_commit clean for high-frequency dashboard probes
  (same convention as shosha.coverage).
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_training_list_runs"
    targetNamespace="https://etzhayyim.ai/bpmn/training"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="training_list_runs" name="training list runs" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.training.listRuns", "version": 1, "resultTimeoutMs": 15000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="listRuns">
      <bpmn:outgoing>Flow_ToList</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_List" name="select runs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="train.list.runs"/>
        <zeebe:ioMapping>
          <zeebe:input source="=kind" target="kind"/>
          <zeebe:input source="=status" target="status"/>
          <zeebe:input source="=limit" target="limit"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=runs" target="runs"/>
          <zeebe:output source="=count" target="count"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToList</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToList" sourceRef="Start" targetRef="Task_List"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_List" targetRef="End"/>
  </bpmn:process>
</bpmn:definitions>
