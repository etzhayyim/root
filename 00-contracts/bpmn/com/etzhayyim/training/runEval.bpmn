<?xml version="1.0" encoding="UTF-8"?>
<!--
  training.etzhayyim.com - runEval workflow (XRPC com.etzhayyim.apps.training.runEval).
  ADR-2605070700.

  Pipeline:
    1. train.eval.run        run benches against given checkpointId, write vertex_training_eval rows
    2. generic.audit.emit
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_training_run_eval"
    targetNamespace="https://etzhayyim.ai/bpmn/training"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="training_run_eval" name="training run eval" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.training.runEval", "version": 1, "resultTimeoutMs": 600000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="runEval">
      <bpmn:outgoing>Flow_ToEval</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Eval" name="run benches">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="train.eval.run"/>
        <zeebe:ioMapping>
          <zeebe:input source="=checkpointId" target="checkpointId"/>
          <zeebe:input source="=benches" target="benches"/>
          <zeebe:input source="=evalDatasetName" target="evalDatasetName"/>
          <zeebe:input source="=evalDatasetRevision" target="evalDatasetRevision"/>
          <zeebe:input source="=sampleLimit" target="sampleLimit"/>
          <zeebe:input source="=gpuTarget" target="gpuTarget"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=evalCount" target="evalCount"/>
          <zeebe:output source="=evalIds" target="evalIds"/>
          <zeebe:output source="=primaryScores" target="primaryScores"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToEval</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEval" sourceRef="Start" targetRef="Task_Eval"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:training.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.training.runEval&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;checkpointId&quot;: checkpointId, &quot;evalCount&quot;: evalCount, &quot;primaryScores&quot;: primaryScores }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Eval" targetRef="Task_Audit"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>
  </bpmn:process>
</bpmn:definitions>
