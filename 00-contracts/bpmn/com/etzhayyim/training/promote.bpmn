<?xml version="1.0" encoding="UTF-8"?>
<!--
  training.etzhayyim.com - promote workflow (XRPC com.etzhayyim.apps.training.promote).
  ADR-2605070700.

  Pipeline:
    1. train.promote.checkpoint   retire prior active edge for alias, insert new active edge
    2. generic.audit.emit
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_training_promote"
    targetNamespace="https://etzhayyim.ai/bpmn/training"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="training_promote" name="training promote" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.training.promote", "version": 1, "resultTimeoutMs": 30000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="promote">
      <bpmn:outgoing>Flow_ToPromote</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Promote" name="promote checkpoint">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="train.promote.checkpoint"/>
        <zeebe:ioMapping>
          <zeebe:input source="=checkpointId" target="checkpointId"/>
          <zeebe:input source="=alias" target="alias"/>
          <zeebe:input source="=servingTarget" target="servingTarget"/>
          <zeebe:input source="=promotedBy" target="promotedBy"/>
          <zeebe:input source="=rationale" target="rationale"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=newEdgeId" target="newEdgeId"/>
          <zeebe:output source="=retiredEdgeId" target="retiredEdgeId"/>
          <zeebe:output source="=weightB2Uri" target="weightB2Uri"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPromote</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToPromote" sourceRef="Start" targetRef="Task_Promote"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:training.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.training.promote&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;alias&quot;: alias, &quot;checkpointId&quot;: checkpointId, &quot;newEdgeId&quot;: newEdgeId, &quot;retiredEdgeId&quot;: retiredEdgeId }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Promote" targetRef="Task_Audit"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>
  </bpmn:process>
</bpmn:definitions>
