<?xml version="1.0" encoding="UTF-8"?>
<!--
  training.etzhayyim.com - serving query (XRPC com.etzhayyim.apps.training.serving).
  ADR-2605070700.

  Read-only SELECT over mv_training_active_serving. Audit omitted.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_training_serving"
    targetNamespace="https://etzhayyim.ai/bpmn/training"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="training_serving" name="training serving snapshot" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.training.serving", "version": 1, "resultTimeoutMs": 15000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="serving">
      <bpmn:outgoing>Flow_ToList</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_List" name="select active serving">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="train.list.serving"/>
        <zeebe:ioMapping>
          <zeebe:input source="=alias" target="alias"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=serving" target="serving"/>
          <zeebe:output source="=count" target="count"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToList</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToList" sourceRef="Start" targetRef="Task_List"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_List" targetRef="End"/>
  </bpmn:process>
</bpmn:definitions>
