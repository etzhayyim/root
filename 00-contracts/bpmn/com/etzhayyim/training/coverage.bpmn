<?xml version="1.0" encoding="UTF-8"?>
<!--
  training.etzhayyim.com - coverage query (XRPC com.etzhayyim.apps.training.coverage).
  ADR-2605070700.

  Single-shot summary aggregate. Audit omitted (high-frequency probe).
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_training_coverage"
    targetNamespace="https://etzhayyim.ai/bpmn/training"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="training_coverage" name="training coverage snapshot" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.training.coverage", "version": 1, "resultTimeoutMs": 15000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="coverage">
      <bpmn:outgoing>Flow_ToSnap</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Coverage" name="aggregate counts">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="train.coverage.snapshot"/>
        <zeebe:ioMapping>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=asOf" target="asOf"/>
          <zeebe:output source="=snapshotsCount" target="snapshotsCount"/>
          <zeebe:output source="=datasetSnapshotRows" target="datasetSnapshotRows"/>
          <zeebe:output source="=runsTotal" target="runsTotal"/>
          <zeebe:output source="=runsQueued" target="runsQueued"/>
          <zeebe:output source="=runsRunning" target="runsRunning"/>
          <zeebe:output source="=runsDone" target="runsDone"/>
          <zeebe:output source="=runsFailed" target="runsFailed"/>
          <zeebe:output source="=checkpointsTotal" target="checkpointsTotal"/>
          <zeebe:output source="=checkpointsFinal" target="checkpointsFinal"/>
          <zeebe:output source="=checkpointBytesTotal" target="checkpointBytesTotal"/>
          <zeebe:output source="=evalsTotal" target="evalsTotal"/>
          <zeebe:output source="=servingActiveCount" target="servingActiveCount"/>
          <zeebe:output source="=lastRunStartedAt" target="lastRunStartedAt"/>
          <zeebe:output source="=lastCheckpointAt" target="lastCheckpointAt"/>
          <zeebe:output source="=lastPromotedAt" target="lastPromotedAt"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSnap</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToSnap" sourceRef="Start" targetRef="Task_Coverage"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Coverage" targetRef="End"/>
  </bpmn:process>
</bpmn:definitions>
