<?xml version="1.0" encoding="UTF-8"?>
<!--
  Timer-start BPMN — ingests DataCite REST API DOIs into vertex_work daily.
  Generic primitives only: generic.http.fetch + generic.db.bulkInsert + generic.audit.emit
  No custom Python handler required (v2 rewrite, 2026-04-30).
  Single-page fetch: 100 most-recent DOIs sorted by created desc.
  vertex_id dedup: RisingWave PK overwrite — safe to re-ingest same DOI.
  NSID: com.etzhayyim.apps.copyright.ingestDatacite
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/copyright-datacite-ingest-v2
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_copyright_datacite_ingest"
    targetNamespace="https://etzhayyim.ai/bpmn/copyright"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="copyright_datacite_ingest" name="copyright datacite ingest" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.copyright.ingestDatacite", "version": 2, "resultTimeoutMs": 120000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start_Timer" name="every 1 day">
      <bpmn:outgoing>Flow_Timer</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_P1D">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Manual" name="manual / on-demand">
      <bpmn:outgoing>Flow_Manual</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Timer"  sourceRef="Start_Timer"  targetRef="Task_Fetch"/>
    <bpmn:sequenceFlow id="Flow_Manual" sourceRef="Start_Manual" targetRef="Task_Fetch"/>

    <!-- Step 1: fetch 100 most-recent DataCite DOIs -->
    <bpmn:serviceTask id="Task_Fetch" name="fetch DataCite DOIs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.http.fetch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;https://api.datacite.org/dois?page%5Bsize%5D=100&amp;sort=created&amp;direction=desc&quot;" target="url"/>
          <zeebe:input source="=&quot;GET&quot;" target="method"/>
          <zeebe:input source="={ &quot;Accept&quot;: &quot;application/json&quot; }" target="headers"/>
          <zeebe:input source="=60" target="timeoutSec"/>
          <zeebe:output source="=bodyJson" target="dataciteBody"/>
          <zeebe:output source="=status"   target="fetchStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Timer</bpmn:incoming>
      <bpmn:incoming>Flow_Manual</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Fetch" targetRef="Task_Insert"/>

    <!-- Step 2: FEEL-transform items and bulk-insert into vertex_work -->
    <bpmn:serviceTask id="Task_Insert" name="bulk insert vertex_work">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.bulkInsert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_work&quot;" target="table"/>
          <zeebe:input source="= if dataciteBody != null and dataciteBody.data != null then for item in dataciteBody.data[item.attributes != null and item.attributes.doi != null] return { &quot;vertex_id&quot;: &quot;at://did:web:copyright.etzhayyim.com:datacite/com.etzhayyim.apps.copyright.work/doi-&quot; + replace(item.attributes.doi, &quot;/&quot;, &quot;-&quot;), &quot;owner_did&quot;: &quot;did:web:copyright.etzhayyim.com:datacite&quot;, &quot;rkey&quot;: &quot;doi-&quot; + replace(item.attributes.doi, &quot;/&quot;, &quot;-&quot;), &quot;repo&quot;: &quot;did:web:copyright.etzhayyim.com:datacite&quot;, &quot;did&quot;: &quot;did:web:copyright.etzhayyim.com:datacite&quot;, &quot;status&quot;: &quot;active&quot;, &quot;kind&quot;: if item.attributes.types != null and (item.attributes.types.resourceTypeGeneral = &quot;Dataset&quot; or item.attributes.types.resourceTypeGeneral = &quot;Model&quot;) then &quot;dataset&quot; else if item.attributes.types != null and (item.attributes.types.resourceTypeGeneral = &quot;Software&quot; or item.attributes.types.resourceTypeGeneral = &quot;InteractiveResource&quot; or item.attributes.types.resourceTypeGeneral = &quot;Workflow&quot; or item.attributes.types.resourceTypeGeneral = &quot;Service&quot;) then &quot;software&quot; else if item.attributes.types != null and item.attributes.types.resourceTypeGeneral = &quot;Audiovisual&quot; then &quot;audiovisual&quot; else if item.attributes.types != null and item.attributes.types.resourceTypeGeneral = &quot;Image&quot; then &quot;visual&quot; else if item.attributes.types != null and item.attributes.types.resourceTypeGeneral = &quot;Sound&quot; then &quot;musical&quot; else &quot;literary&quot;, &quot;title&quot;: if item.attributes.titles != null and count(item.attributes.titles) &gt; 0 then item.attributes.titles[1].title else &quot;(no title)&quot;, &quot;doi&quot;: item.attributes.doi, &quot;registry&quot;: &quot;datacite&quot;, &quot;berne_automatic&quot;: true, &quot;source_url&quot;: &quot;https://doi.org/&quot; + item.attributes.doi, &quot;collected_at&quot;: string(now()), &quot;sensitivity_ord&quot;: 100 } else []" target="rows"/>
          <zeebe:output source="=inserted" target="rowsInserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Insert" targetRef="Task_Audit"/>

    <!-- Step 3: OCEL audit event -->
    <bpmn:serviceTask id="Task_Audit" name="emit datacite.ingest OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.copyright.datacite.ingest.completed&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;registry&quot;: &quot;datacite&quot;, &quot;rowsInserted&quot;: rowsInserted, &quot;fetchStatus&quot;: fetchStatus }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
