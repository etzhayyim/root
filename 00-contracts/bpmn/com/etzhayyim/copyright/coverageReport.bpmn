<?xml version="1.0" encoding="UTF-8"?>
<!--
  Timer-start BPMN — delta-aware copyright coverage social post every 6 hours.
  Generic primitives only: generic.db.select + generic.llm.chat + generic.pds.dispatch + generic.db.insert
  No custom Python handler required (v2 rewrite, 2026-04-30).
  Skips post if total vertex_work count delta < minDelta since last post.
  NSID: com.etzhayyim.apps.copyright.socialCoverageReport
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/copyright-coverage-report-v2
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_copyright_coverage_report"
    targetNamespace="https://etzhayyim.ai/bpmn/copyright"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="copyright_coverage_report" name="copyright coverage report" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.copyright.socialCoverageReport", "version": 2, "resultTimeoutMs": 120000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start_Timer" name="every 6 hours">
      <bpmn:outgoing>Flow_Timer</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_PT6H">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT6H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Manual" name="manual / on-demand">
      <bpmn:outgoing>Flow_Manual</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Timer"  sourceRef="Start_Timer"  targetRef="Task_GetTotal"/>
    <bpmn:sequenceFlow id="Flow_Manual" sourceRef="Start_Manual" targetRef="Task_GetTotal"/>

    <!-- Step 1: count total vertex_work rows -->
    <bpmn:serviceTask id="Task_GetTotal" name="count vertex_work">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT count(*) AS total_works FROM vertex_work&quot;" target="sql"/>
          <zeebe:output source="= if rows != null and count(rows) &gt; 0 then rows[1].total_works else 0" target="totalWorks"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Timer</bpmn:incoming>
      <bpmn:incoming>Flow_Manual</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_GetTotal" targetRef="Task_GetLastCount"/>

    <!-- Step 2: read last-post count from ingest state -->
    <bpmn:serviceTask id="Task_GetLastCount" name="read last post count">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT COALESCE(last_post_count, 0) AS last_count FROM vertex_copyright_ingest_state WHERE registry = 'coverage-report' LIMIT 1&quot;" target="sql"/>
          <zeebe:output source="= if rows != null and count(rows) &gt; 0 then rows[1].last_count else 0" target="lastCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_GetLastCount" targetRef="GW_ShouldPost"/>

    <!-- Gateway: post only if enough new works (or force) -->
    <bpmn:exclusiveGateway id="GW_ShouldPost" name="enough new works?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Post</bpmn:outgoing>
      <bpmn:outgoing>Flow_Skip</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Post" name="yes" sourceRef="GW_ShouldPost" targetRef="Task_LLM">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[= (totalWorks - lastCount) >= (if minDelta != null then minDelta else 10) or forcePost = true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Skip" name="no" sourceRef="GW_ShouldPost" targetRef="Task_SkipAudit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[= not((totalWorks - lastCount) >= (if minDelta != null then minDelta else 10) or forcePost = true)]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Post path: generate text via LLM -->
    <bpmn:serviceTask id="Task_LLM" name="generate coverage post text">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.chat"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;fast&quot;" target="tier"/>
          <zeebe:input source="=&quot;You are the Copyright Registry agent (copyright.etzhayyim.com). Write concise, factual social posts about global copyright data coverage. Max 250 characters. Be engaging, mention numbers, use #copyright #openaccess.&quot;" target="system"/>
          <zeebe:input source="= &quot;Coverage update: &quot; + string(totalWorks) + &quot; works indexed. +&quot; + string(totalWorks - lastCount) + &quot; new since last report. Registries: Crossref and DataCite. Write a 1-2 sentence social post about this copyright coverage milestone.&quot;" target="user"/>
          <zeebe:input source="=300" target="maxTokens"/>
          <zeebe:output source="=content" target="postText"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Post</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_LLM" targetRef="Task_Post"/>

    <!-- Post path: dispatch social post to Bluesky via C-path -->
    <bpmn:serviceTask id="Task_Post" name="post to copyright.etzhayyim.com">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;app.bsky.feed.post&quot;" target="type"/>
          <zeebe:input source="={ &quot;repo&quot;: &quot;did:web:copyright.etzhayyim.com&quot;, &quot;text&quot;: postText, &quot;langs&quot;: [&quot;en&quot;] }" target="payload"/>
          <zeebe:output source="=uri" target="postUri"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Post" targetRef="Task_UpdateState"/>

    <!-- Post path: persist new total as last-post count -->
    <bpmn:serviceTask id="Task_UpdateState" name="update coverage state">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;INSERT INTO vertex_copyright_ingest_state (registry, cursor, last_ingested_at, total_ingested, last_post_count, last_posted_at, owner_did, created_at, updated_at) VALUES ('coverage-report', '', NOW(), $1, $1, NOW(), 'did:web:copyright.etzhayyim.com', NOW(), NOW())&quot;" target="sql"/>
          <zeebe:input source="=[totalWorks]" target="params"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_UpdateState" targetRef="Task_Audit"/>

    <!-- Post path audit -->
    <bpmn:serviceTask id="Task_Audit" name="emit coverage.report OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.copyright.coverage.report.fired&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;posted&quot;: true, &quot;totalWorks&quot;: totalWorks, &quot;delta&quot;: totalWorks - lastCount, &quot;postUri&quot;: postUri }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_End_Post</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End_Post" sourceRef="Task_Audit" targetRef="End"/>

    <!-- Skip path audit -->
    <bpmn:serviceTask id="Task_SkipAudit" name="emit coverage.skipped OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.copyright.coverage.report.skipped&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;posted&quot;: false, &quot;totalWorks&quot;: totalWorks, &quot;delta&quot;: totalWorks - lastCount }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Skip</bpmn:incoming>
      <bpmn:outgoing>Flow_End_Skip</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End_Skip" sourceRef="Task_SkipAudit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_End_Post</bpmn:incoming>
      <bpmn:incoming>Flow_End_Skip</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
