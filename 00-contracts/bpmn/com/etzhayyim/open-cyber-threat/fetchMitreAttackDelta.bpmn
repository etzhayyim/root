<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_open_cyber_threat_fetch_mitre_attack_delta" targetNamespace="https://etzhayyim.ai/bpmn/open-cyber-threat" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_cyber_threat_fetch_mitre_attack_delta" name="fetchMitreAttackDelta" isExecutable="true">
    <bpmn:startEvent id="Start" name="every 24h"><bpmn:outgoing>Flow_F</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeCycle xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">R/PT24H</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Manual" name="manual"><bpmn:outgoing>Flow_FM</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_FM" sourceRef="Start_Manual" targetRef="Task_Fetch"/>
    <bpmn:sequenceFlow id="Flow_F" sourceRef="Start" targetRef="Task_Fetch"/>
    <bpmn:serviceTask id="Task_Fetch" name="mitre attack taxii intrusion-sets">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.http.fetch" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;GET&quot;" target="method"/>
          <zeebe:input source="=&quot;https://cti-taxii.mitre.org/stix/collections/95ecc380-afe9-11e4-9b6c-751b66dd541e/objects/?match[type]=intrusion-set&amp;limit=100&quot;" target="url"/>
          <zeebe:input source="={&quot;Accept&quot;: &quot;application/taxii+json;version=2.1&quot;}" target="headers"/>
          <zeebe:output source="=bodyJson.objects" target="items"/>
          <zeebe:output source="=string(now())" target="fetchedAt"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F</bpmn:incoming><bpmn:outgoing>Flow_L</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_L" sourceRef="Task_Fetch" targetRef="Task_Loop"/>
    <bpmn:callActivity id="Task_Loop" name="record each threat actor" calledElement="open_cyber_threat_actor">
      <bpmn:extensionElements><zeebe:calledElement processId="open_cyber_threat_actor"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;at://did:web:open-cyber-threat.etzhayyim.com/com.etzhayyim.apps.cyberThreat.recordThreatActor/&quot; + item.id" target="vertexId"/>
          <zeebe:input source="=item.id" target="actorIdCode"/>
          <zeebe:input source="=item.name" target="actorName"/>
          <zeebe:input source="=if item.aliases != null then string join(item.aliases, &quot;,&quot;) else &quot;&quot;" target="aliases"/>
          <zeebe:input source="=&quot;unknown&quot;" target="attribution"/>
          <zeebe:input source="=if item.x_mitre_domains != null then item.x_mitre_domains[1] else &quot;&quot;" target="suspectedNexus"/>
          <zeebe:input source="=&quot;espionage&quot;" target="primaryMotivation"/>
          <zeebe:input source="=item.created" target="firstObserved"/>
          <zeebe:input source="=&quot;did:web:open-cyber-threat.etzhayyim.com&quot;" target="callerDid"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_L</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false"><bpmn:extensionElements><zeebe:loopCharacteristics inputCollection="=items" inputElement="item"/></bpmn:extensionElements></bpmn:multiInstanceLoopCharacteristics>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Loop" targetRef="Task_Advance"/>
    <bpmn:serviceTask id="Task_Advance" name="mark fetched">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;UPDATE vertex_open_cyber_source SET last_fetched_at = $1 WHERE source_id = 'mitre-attack'&quot;" target="sql"/>
          <zeebe:input source="=[fetchedAt]" target="params"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Advance" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
