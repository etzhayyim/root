<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_public_malak_crawl_ads"
    targetNamespace="https://etzhayyim.ai/bpmn/public-malak"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="public_malak_crawl_ads" name="public malak crawl ads" isExecutable="true">
    <bpmn:startEvent id="Start_Timer" name="every six hours">
      <bpmn:outgoing>Flow_Queue_Timer</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle>R/PT6H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Manual" name="manual / on-demand">
      <bpmn:outgoing>Flow_Queue_Manual</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Queue_Timer" sourceRef="Start_Timer" targetRef="Task_QueueSeeds"/>
    <bpmn:sequenceFlow id="Flow_Queue_Manual" sourceRef="Start_Manual" targetRef="Task_QueueSeeds"/>

    <bpmn:serviceTask id="Task_QueueSeeds" name="queue public ad seed runs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publicMalak.ads.queueSeedRuns"/>
        <zeebe:ioMapping>
          <zeebe:input source="=if seeds = null then [] else seeds" target="seeds"/>
          <zeebe:input source="=if seedLimit = null then 20 else seedLimit" target="limit"/>
          <zeebe:output source="=queued" target="queuedRuns"/>
          <zeebe:output source="=skipped" target="skippedSeeds"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Queue_Timer</bpmn:incoming>
      <bpmn:incoming>Flow_Queue_Manual</bpmn:incoming>
      <bpmn:outgoing>Flow_Process</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Process" sourceRef="Task_QueueSeeds" targetRef="Task_ProcessQueue"/>

    <bpmn:serviceTask id="Task_ProcessQueue" name="process queued public ad runs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publicMalak.ads.processQueue"/>
        <zeebe:ioMapping>
          <zeebe:input source="=if maxRuns = null then 3 else maxRuns" target="maxRuns"/>
          <zeebe:input source="=if timeoutSec = null then 20 else timeoutSec" target="timeoutSec"/>
          <zeebe:input source="=if platform = null then &quot;&quot; else platform" target="platform"/>
          <zeebe:input source="=if reclaimAfterSec = null then 1800 else reclaimAfterSec" target="reclaimAfterSec"/>
          <zeebe:output source="=processed" target="processedRuns"/>
          <zeebe:output source="=completed" target="completedRuns"/>
          <zeebe:output source="=failed" target="failedRuns"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Process</bpmn:incoming>
      <bpmn:outgoing>Flow_AnalyzeRecent</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AnalyzeRecent" sourceRef="Task_ProcessQueue" targetRef="Task_AnalyzeRecent"/>

    <bpmn:serviceTask id="Task_AnalyzeRecent" name="analyze recent public ads">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publicMalak.ads.analyzeRecent"/>
        <zeebe:ioMapping>
          <zeebe:input source="=if analysisLimit = null then 10 else analysisLimit" target="limit"/>
          <zeebe:input source="=if platform = null then &quot;&quot; else platform" target="platform"/>
          <zeebe:input source="=if analysisKind = null then &quot;competitive&quot; else analysisKind" target="analysisKind"/>
          <zeebe:input source="=if modelId = null then &quot;&quot; else modelId" target="modelId"/>
          <zeebe:output source="=analyzed" target="analyzedAds"/>
          <zeebe:output source="=failed" target="analysisFailed"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AnalyzeRecent</bpmn:incoming>
      <bpmn:outgoing>Flow_ClusterRecent</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ClusterRecent" sourceRef="Task_AnalyzeRecent" targetRef="Task_ClusterRecent"/>

    <bpmn:serviceTask id="Task_ClusterRecent" name="cluster recent public ads">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publicMalak.ads.clusterRecent"/>
        <zeebe:ioMapping>
          <zeebe:input source="=if clusterLimit = null then 25 else clusterLimit" target="limit"/>
          <zeebe:input source="=if platform = null then &quot;&quot; else platform" target="platform"/>
          <zeebe:input source="=if platformScope = null then &quot;platform&quot; else platformScope" target="platformScope"/>
          <zeebe:output source="=clustered" target="clusteredAds"/>
          <zeebe:output source="=failed" target="clusterFailed"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ClusterRecent</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_ClusterRecent" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit public ad crawl">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:public-malak.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;publicMalak.ads.crawl&quot;" target="action"/>
          <zeebe:input source="={queuedRuns: queuedRuns, skippedSeeds: skippedSeeds, processedRuns: processedRuns, completedRuns: completedRuns, failedRuns: failedRuns, analyzedAds: analyzedAds, analysisFailed: analysisFailed, clusteredAds: clusteredAds, clusterFailed: clusterFailed}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="completed">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
