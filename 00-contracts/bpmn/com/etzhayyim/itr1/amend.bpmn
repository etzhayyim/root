<?xml version="1.0" encoding="UTF-8"?>
<!--
  ADR-0055 — itr1_amend.

  §139(5) revised return. Single-actor (taxpayer) flow; no finance review
  gate. Marks predecessor return as 'superseded' and creates a new
  vertex with status='revised' linked via predecessor_vertex_id.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_itr1_amend"
    targetNamespace="https://etzhayyim.ai/bpmn/itr1"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="itr1_amend" name="ITR-1 §139(5) revised return" isExecutable="true">

    <bpmn:startEvent id="Start" name="Revised">
      <bpmn:outgoing>Flow_S</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_LoadPredecessor"/>

    <bpmn:serviceTask id="Task_LoadPredecessor" name="Load predecessor return">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_itr1_return&quot;" target="table"/>
          <zeebe:input source="=&quot;vertex_id = %s&quot;" target="whereExpr"/>
          <zeebe:input source="=[predecessorVertexId]" target="whereParams"/>
          <zeebe:input source="=&quot;vertex_id, taxpayer_pan_hash, assessment_year, ack_number, status, amendment_count&quot;" target="columns"/>
          <zeebe:input source="=1" target="limit"/>
          <zeebe:output source="=rows" target="predRows"/>
          <zeebe:output source="=rowCount" target="predCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming>
      <bpmn:outgoing>Flow_F1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F1" sourceRef="Task_LoadPredecessor" targetRef="Task_FormAmend"/>

    <bpmn:userTask id="Task_FormAmend" name="Revised form (deltas only)">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:itr1-amend-v1"/>
        <zeebe:assignmentDefinition candidateGroups="taxpayer"/>
        <zeebe:taskSchedule dueDate="=now() + duration(&quot;P30D&quot;)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F1</bpmn:incoming>
      <bpmn:outgoing>Flow_F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_F2" sourceRef="Task_FormAmend" targetRef="Task_AppendLog"/>

    <bpmn:serviceTask id="Task_AppendLog" name="Append revised log (Tier 3)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_itr1_return_pii&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:           vertexId + &quot;:revised:&quot; + string(now()),
              taxpayer_pan_hash:   if predCount &gt; 0 then string(predRows[1].taxpayer_pan_hash) else &quot;&quot;,
              applicant_payload:   &quot;&quot;,
              income_payload:      &quot;&quot;,
              deductions_payload:  &quot;&quot;,
              tax_payload:         &quot;&quot;,
              amendment_log:       string(amendmentPayload),
              retention_until:     date and time(date(&quot;9999-12-31&quot;), time(&quot;00:00:00&quot;)),
              created_at:          string(now()),
              owner_did:           filerDid,
              sensitivity_ord:     3,
              org_id:              if predCount &gt; 0 then string(predRows[1].taxpayer_pan_hash) else &quot;&quot;,
              user_id:             filerDid,
              actor_id:            &quot;sys.bpmn.itr1.amend&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F2</bpmn:incoming>
      <bpmn:outgoing>Flow_F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F3" sourceRef="Task_AppendLog" targetRef="Task_MarkRevised"/>

    <bpmn:serviceTask id="Task_MarkRevised" name="Mark new return as revised + chain">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_itr1_return&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:                vertexId,
              taxpayer_pan_hash:        if predCount &gt; 0 then string(predRows[1].taxpayer_pan_hash) else &quot;&quot;,
              assessment_year:          if predCount &gt; 0 then string(predRows[1].assessment_year) else &quot;&quot;,
              process_type:             &quot;amend&quot;,
              status:                   &quot;revised&quot;,
              filing_hash:              &quot;revised:&quot; + string(now()),
              predecessor_vertex_id:    predecessorVertexId,
              revised_reason:           string(revisedMeta.revisedReason),
              amendment_count:          if predCount &gt; 0 then number(predRows[1].amendment_count) + 1 else 1,
              created_at:               string(now()),
              owner_did:                filerDid,
              sensitivity_ord:          1,
              org_id:                   if predCount &gt; 0 then string(predRows[1].taxpayer_pan_hash) else &quot;&quot;,
              user_id:                  filerDid,
              actor_id:                 &quot;sys.bpmn.itr1.amend&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;replace&quot;" target="onConflict"/>
          <zeebe:output source="=&quot;revised&quot;" target="finalStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F3</bpmn:incoming>
      <bpmn:outgoing>Flow_F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F4" sourceRef="Task_MarkRevised" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit: revised">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:ind.union.etzhayyim.com:cbdt:itr1&quot;" target="actor"/>
          <zeebe:input source="=&quot;itr1.fileRevised&quot;" target="action"/>
          <zeebe:input source="={
              vertexId:               vertexId,
              predecessorVertexId:    predecessorVertexId,
              revisedReason:          string(revisedMeta.revisedReason)
          }" target="payload"/>
          <zeebe:output source="=rkey" target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F4</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="Done">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
