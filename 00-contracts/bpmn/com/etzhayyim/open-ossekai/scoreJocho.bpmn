<?xml version="1.0" encoding="UTF-8"?>
<!--
  L3 XRPC-triggered: score jocho (情緒) for a consented actor.
  Reads society6 kyu/dan + trust score via DB, runs LLM 5-axis scoring.
  Requires prior consent via requestOssekaiConsent.
  Input: targetDid
  Updates vertex_ossekai_wellbecoming_plan with jocho scores.
  NSID: com.etzhayyim.apps.openOssekai.scoreJocho
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_ossekai_score_jocho" targetNamespace="https://etzhayyim.ai/bpmn/open-ossekai" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_ossekai_score_jocho" name="scoreJocho" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.openOssekai.scoreJocho", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_CheckConsent"/>

    <!-- Verify consent exists -->
    <bpmn:serviceTask id="Task_CheckConsent" name="check consent exists">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT plan_id, consent_did, status FROM vertex_ossekai_wellbecoming_plan WHERE target_did = '&quot; + targetDid + &quot;' AND status != 'consent_denied' LIMIT 1&quot;" target="query"/>
          <zeebe:output source="=rows" target="consentRows"/>
          <zeebe:output source="=rowCount" target="consentCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming>
      <bpmn:outgoing>Flow_ReadSignals</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ReadSignals" sourceRef="Task_CheckConsent" targetRef="Task_ReadSignals"/>

    <!-- Read recent signals for context -->
    <bpmn:serviceTask id="Task_ReadSignals" name="read recent signals">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT avg_sentiment, avg_relevance, signal_count FROM mv_ossekai_signal_recent WHERE target_did = '&quot; + targetDid + &quot;' LIMIT 1&quot;" target="query"/>
          <zeebe:output source="=rows" target="signalRows"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReadSignals</bpmn:incoming>
      <bpmn:outgoing>Flow_LLM</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_LLM" sourceRef="Task_ReadSignals" targetRef="Task_LLM"/>

    <!-- LLM 5-axis jocho scoring -->
    <bpmn:serviceTask id="Task_LLM" name="LLM jocho scoring">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.json"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;You are a Well-Becoming coach. Score the actor on 5 axes (each 0.0-1.0): engagement (活性), competence (能力), contribution (貢献), growth (成長), resilience (回復力). Also compute overall jocho_score (weighted avg: engagement×0.25 + competence×0.25 + contribution×0.20 + growth×0.20 + resilience×0.10). Respond ONLY with JSON: {engagement_score, competence_score, contribution_score, growth_score, resilience_score, jocho_score}&quot;" target="systemPrompt"/>
          <zeebe:input source="=&quot;Actor DID: &quot; + targetDid + &quot;\nSignal count: &quot; + (if signalRows != null and count(signalRows) &gt; 0 then string(signalRows[1].signal_count) else &quot;0&quot;) + &quot;\nAvg sentiment: &quot; + (if signalRows != null and count(signalRows) &gt; 0 then string(signalRows[1].avg_sentiment) else &quot;0.0&quot;) + &quot;\nConsent granted: &quot; + string(consentCount &gt; 0)" target="userPrompt"/>
          <zeebe:output source="=jocho_score" target="jochoScore"/>
          <zeebe:output source="=engagement_score" target="engagementScore"/>
          <zeebe:output source="=competence_score" target="competenceScore"/>
          <zeebe:output source="=contribution_score" target="contributionScore"/>
          <zeebe:output source="=growth_score" target="growthScore"/>
          <zeebe:output source="=resilience_score" target="resilienceScore"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_LLM</bpmn:incoming>
      <bpmn:outgoing>Flow_Update</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Update" sourceRef="Task_LLM" targetRef="Task_UpdatePlan"/>

    <!-- Update the wellbecoming plan with scores -->
    <bpmn:serviceTask id="Task_UpdatePlan" name="update wellbecoming plan scores">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_ossekai_wellbecoming_plan&quot;" target="table"/>
          <zeebe:input source="={vertex_id: &quot;at://did:web:open-ossekcom.etzhayyim.ai/com.etzhayyim.apps.openOssekai.wellBecomingPlan/scored-&quot; + targetDid + &quot;-&quot; + string(now()), plan_id: &quot;wbp-scored-&quot; + targetDid + &quot;-&quot; + string(now()), target_did: targetDid, consent_did: if consentRows != null and count(consentRows) &gt; 0 then consentRows[1].consent_did else targetDid, jocho_score: jochoScore, engagement_delta: engagementScore, competence_delta: competenceScore, contribution_delta: contributionScore, growth_delta: growthScore, resilience_delta: resilienceScore, status: &quot;scored&quot;, created_at: string(now()), sensitivity_ord: 3, actor_id: &quot;sys.bpmn.open-ossekai&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Update</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_UpdatePlan" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit scoreJocho">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-ossekcom.etzhayyim.ai&quot;" target="actor"/>
          <zeebe:input source="=&quot;open.ossekai.scoreJocho&quot;" target="action"/>
          <zeebe:input source="={targetDid: targetDid, jochoScore: jochoScore, consentCount: consentCount}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
