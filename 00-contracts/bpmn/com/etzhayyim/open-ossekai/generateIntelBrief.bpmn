<?xml version="1.0" encoding="UTF-8"?>
<!--
  L1 XRPC-triggered: generate LLM intel brief for a target actor.
  Input: targetDid, targetHandle, contextHint
  Writes to vertex_ossekai_brief + propagates to vertex_open_sales_lead.
  NSID: com.etzhayyim.apps.openOssekai.generateIntelBrief
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_ossekai_generate_intel_brief" targetNamespace="https://etzhayyim.ai/bpmn/open-ossekai" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_ossekai_generate_intel_brief" name="generateIntelBrief" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.openOssekai.generateIntelBrief", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_LLM"/>

    <bpmn:serviceTask id="Task_LLM" name="LLM intel brief">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.json"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;You are an OSINT intelligence analyst. Given the actor identity and context, produce a structured intel brief with: title (one sentence), summary (2-3 sentences), key_signals (3 bullet points separated by |), confidence_score (0.0-1.0). Respond ONLY with a JSON object: {title, summary, key_signals, confidence_score}&quot;" target="systemPrompt"/>
          <zeebe:input source="=&quot;Actor: &quot; + targetDid + (if targetHandle != null then &quot; (@&quot; + targetHandle + &quot;)&quot; else &quot;&quot;) + &quot;\nContext: &quot; + (if contextHint != null then contextHint else &quot;No additional context&quot;)" target="userPrompt"/>
          <zeebe:output source="=title" target="briefTitle"/>
          <zeebe:output source="=summary" target="briefSummary"/>
          <zeebe:output source="=key_signals" target="briefKeySignals"/>
          <zeebe:output source="=confidence_score" target="briefConfidence"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming>
      <bpmn:outgoing>Flow_Save</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Save" sourceRef="Task_LLM" targetRef="Task_SaveBrief"/>

    <bpmn:serviceTask id="Task_SaveBrief" name="save intel brief">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_ossekai_brief&quot;" target="table"/>
          <zeebe:input source="={vertex_id: &quot;at://did:web:open-ossekcom.etzhayyim.ai/com.etzhayyim.apps.openOssekai.brief/intel-&quot; + targetDid + &quot;-&quot; + string(now()), brief_id: &quot;brief-&quot; + targetDid + &quot;-&quot; + string(now()), target_did: targetDid, target_handle: if targetHandle != null then targetHandle else null, brief_kind: &quot;intel&quot;, title: briefTitle, summary: briefSummary, key_signals: briefKeySignals, confidence_score: briefConfidence, generated_at: string(now()), created_at: string(now()), sensitivity_ord: 0, actor_id: &quot;sys.bpmn.open-ossekai&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Save</bpmn:incoming>
      <bpmn:outgoing>Flow_Lead</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Lead" sourceRef="Task_SaveBrief" targetRef="Task_SaveLead"/>

    <!-- Propagate to sales lead pipeline -->
    <bpmn:serviceTask id="Task_SaveLead" name="upsert sales lead">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_sales_lead&quot;" target="table"/>
          <zeebe:input source="={vertex_id: &quot;at://did:web:open-ossekcom.etzhayyim.ai/com.etzhayyim.apps.openSales.lead/ossekai-intel-&quot; + targetDid, lead_id: &quot;ossekai-intel-&quot; + targetDid, full_name: if targetHandle != null then targetHandle else targetDid, source: &quot;ossekai.intel&quot;, lead_score: briefConfidence * 50.0, status: &quot;new&quot;, notes: briefSummary, created_at: string(now()), sensitivity_ord: 1, actor_id: &quot;sys.bpmn.open-ossekai&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Lead</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_SaveLead" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit generateIntelBrief">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-ossekcom.etzhayyim.ai&quot;" target="actor"/>
          <zeebe:input source="=&quot;open.ossekai.generateIntelBrief&quot;" target="action"/>
          <zeebe:input source="={targetDid: targetDid, confidence: briefConfidence}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
