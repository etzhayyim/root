<?xml version="1.0" encoding="UTF-8"?>
<!--
  L3 XRPC-triggered: record consent grant for Well-Becoming analysis.
  ADR-0018 Tier 3 PII gate — must be called before scoreJocho.
  Input: targetDid, consentDid, consentScope
  Writes consent record to vertex_ossekai_wellbecoming_plan (status=consent_pending).
  NSID: com.etzhayyim.apps.openOssekai.requestOssekaiConsent
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_ossekai_request_consent" targetNamespace="https://etzhayyim.ai/bpmn/open-ossekai" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_ossekai_request_ossekai_consent" name="requestOssekaiConsent" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.openOssekai.requestOssekaiConsent", "version": 1, "resultTimeoutMs": 30000 }
    </bpmn:documentation>
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>

    <bpmn:serviceTask id="Task_Save" name="record consent plan (pending)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_ossekai_wellbecoming_plan&quot;" target="table"/>
          <zeebe:input source="={vertex_id: &quot;at://did:web:open-ossekcom.etzhayyim.ai/com.etzhayyim.apps.openOssekai.wellBecomingPlan/&quot; + targetDid, plan_id: &quot;wbp-&quot; + targetDid, target_did: targetDid, consent_did: consentDid, current_kyu_dan: &quot;6kyu&quot;, target_kyu_dan: &quot;5kyu&quot;, jocho_score: 0.0, engagement_delta: 0.0, competence_delta: 0.0, contribution_delta: 0.0, growth_delta: 0.0, resilience_delta: 0.0, trust_score: 0.0, status: &quot;consent_pending&quot;, created_at: string(now()), sensitivity_ord: 3, actor_id: &quot;sys.bpmn.open-ossekai&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_Save" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit requestOssekaiConsent">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-ossekcom.etzhayyim.ai&quot;" target="actor"/>
          <zeebe:input source="=&quot;open.ossekai.requestOssekaiConsent&quot;" target="action"/>
          <zeebe:input source="={targetDid: targetDid, consentDid: consentDid}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
