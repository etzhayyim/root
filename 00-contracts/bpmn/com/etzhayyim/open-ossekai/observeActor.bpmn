<?xml version="1.0" encoding="UTF-8"?>
<!--
  L1 Timer-start: scan social firehose for actor signals every 15min.
  Writes to vertex_ossekai_signal.
  NSID: com.etzhayyim.apps.openOssekai.observeActor (timer-start, no binding needed)
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_ossekai_observe_actor" targetNamespace="https://etzhayyim.ai/bpmn/open-ossekai" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_ossekai_observe_actor" name="observeActor" isExecutable="true">
    <bpmn:startEvent id="Start" name="every 15 min">
      <bpmn:outgoing>Flow_ToSelect</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT15M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToSelect" sourceRef="Start" targetRef="Task_Select"/>

    <!-- Fetch recent social posts from tracked actors in the last 15min -->
    <bpmn:serviceTask id="Task_Select" name="select recent social signals">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT r.owner_did AS target_did, a.handle AS target_handle, r.collection AS signal_kind, r.vertex_id AS content_uri, r.value_text AS raw_text FROM vertex_repo_record r LEFT JOIN vertex_actor a ON a.did = r.owner_did WHERE r.collection LIKE 'app.bsky.feed%' AND r.created_at &gt;= (NOW() - INTERVAL '15 minutes')::varchar ORDER BY r.created_at DESC LIMIT 200&quot;" target="query"/>
          <zeebe:output source="=rows" target="socialRows"/>
          <zeebe:output source="=rowCount" target="socialCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSelect</bpmn:incoming>
      <bpmn:outgoing>Flow_ToInsert</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToInsert" sourceRef="Task_Select" targetRef="Task_Insert"/>

    <!-- Write aggregate signal row per batch (one representative row) -->
    <bpmn:serviceTask id="Task_Insert" name="write signal snapshot">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_ossekai_signal&quot;" target="table"/>
          <zeebe:input source="={vertex_id: &quot;at://did:web:open-ossekcom.etzhayyim.ai/com.etzhayyim.apps.openOssekai.signal/observe-&quot; + string(now()), signal_id: &quot;obs-&quot; + string(now()), target_did: &quot;__batch__&quot;, signal_kind: &quot;social.batch&quot;, summary: &quot;batch:&quot; + string(socialCount) + &quot; posts observed&quot;, sentiment_score: 0.0, relevance_score: 0.5, observed_at: string(now()), created_at: string(now()), sensitivity_ord: 0, actor_id: &quot;sys.bpmn.open-ossekai&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToInsert</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Insert" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit observeActor">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-ossekcom.etzhayyim.ai&quot;" target="actor"/>
          <zeebe:input source="=&quot;open.ossekai.observeActor&quot;" target="action"/>
          <zeebe:input source="={socialCount: socialCount}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
