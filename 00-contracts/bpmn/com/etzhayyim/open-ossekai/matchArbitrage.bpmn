<?xml version="1.0" encoding="UTF-8"?>
<!--
  L2 Timer-start: hourly supply/demand gap scan → write arbitrage opportunities.
  Reads mv_ossekai_signal_recent, finds actors with high relevance but no active brief.
  NSID: com.etzhayyim.apps.openOssekai.matchArbitrage (timer-start, no binding needed)
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_ossekai_match_arbitrage" targetNamespace="https://etzhayyim.ai/bpmn/open-ossekai" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_ossekai_match_arbitrage" name="matchArbitrage" isExecutable="true">
    <bpmn:startEvent id="Start" name="every 1 hour">
      <bpmn:outgoing>Flow_ToSelect</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT1H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToSelect" sourceRef="Start" targetRef="Task_Select"/>

    <bpmn:serviceTask id="Task_Select" name="scan high-relevance actors without briefs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT s.target_did, s.avg_relevance, s.signal_count FROM mv_ossekai_signal_recent s WHERE s.avg_relevance &gt; 0.6 AND NOT EXISTS (SELECT 1 FROM vertex_ossekai_brief b WHERE b.target_did = s.target_did AND b.created_at &gt;= (NOW() - INTERVAL '1 day')::varchar) ORDER BY s.avg_relevance DESC LIMIT 50&quot;" target="query"/>
          <zeebe:output source="=rows" target="arbCandidates"/>
          <zeebe:output source="=rowCount" target="arbCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSelect</bpmn:incoming>
      <bpmn:outgoing>Flow_ToInsert</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToInsert" sourceRef="Task_Select" targetRef="Task_Insert"/>

    <bpmn:serviceTask id="Task_Insert" name="write arbitrage opportunity batch">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_ossekai_arbitrage&quot;" target="table"/>
          <zeebe:input source="={vertex_id: &quot;at://did:web:open-ossekcom.etzhayyim.ai/com.etzhayyim.apps.openOssekai.arbitrage/arb-scan-&quot; + string(today()), arb_id: &quot;arb-scan-&quot; + string(today()), opportunity_kind: &quot;brief_gap&quot;, gap_description: string(arbCount) + &quot; high-relevance actors without intel briefs&quot;, confidence_score: if arbCount &gt; 0 then 0.7 else 0.0, recommended_action: &quot;run generateIntelBrief for each candidate&quot;, status: &quot;open&quot;, created_at: string(now()), sensitivity_ord: 0, actor_id: &quot;sys.bpmn.open-ossekai&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToInsert</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_Insert" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit matchArbitrage">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-ossekcom.etzhayyim.ai&quot;" target="actor"/>
          <zeebe:input source="=&quot;open.ossekai.matchArbitrage&quot;" target="action"/>
          <zeebe:input source="={arbCount: arbCount}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
