<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_isic_flag_dual_use_industry"
    targetNamespace="https://etzhayyim.ai/bpmn/open-isic"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="open_isic_flag_dual_use_industry" name="軍民両用産業 フラグ" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_SaveEvent"/>

    <bpmn:serviceTask id="Task_SaveEvent" name="openIsic flag dual-use industry">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="openIsic.flagDualUseIndustry"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_SaveEvent" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit openIsic.industry.flagDualUse">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-isic.etzhayyim.com:ops&quot;" target="actor"/>
          <zeebe:input source="=&quot;openIsic.industry.flagDualUse&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, subjectVid: entityVid, isicCode: isicCode, dualUseCategory: dualUseCategory, severity: &quot;high&quot;}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
