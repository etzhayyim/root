<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_isic_classify_arms_manufacturing"
    targetNamespace="https://etzhayyim.ai/bpmn/open-isic"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="open_isic_classify_arms_manufacturing" name="武器・弾薬製造 (ISIC 2520)" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_SaveEvent"/>

    <bpmn:serviceTask id="Task_SaveEvent" name="openIsic classify arms manufacturing">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="openIsic.classifyArmsManufacturing"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_SaveEvent" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit industry.armsManufacture">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-isic.etzhayyim.com:ops&quot;" target="actor"/>
          <zeebe:input source="=&quot;industry.armsManufacture&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, subjectVid: entityVid, isicCode: isicCode, severity: &quot;high&quot;}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
