<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_panama_drought_restriction"
    targetNamespace="https://etzhayyim.ai/bpmn/open-panama-drought"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_panama_drought_restriction" name="Draft 規制" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="restriction 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_panama_draft_restriction&quot;" target="table"/>
          <zeebe:input source="={vertex_id: vertexId, restriction_id: restrictionId, lane: lane, max_draft_feet: maxDraftFeet, max_slots_per_day: maxSlotsPerDay, reason: reason, impact_tier: if maxDraftFeet &lt;= 44 then &quot;major&quot; else if maxDraftFeet &lt;= 48 then &quot;moderate&quot; else &quot;minor&quot;, effective_from: effectiveFrom, effective_until: effectiveUntil, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-panama-drought&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit openPanamaDrought.restriction.record">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-panama-drought.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openPanamaDrought.restriction.record&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, restrictionId: restrictionId, maxDraftFeet: maxDraftFeet}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
