<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_panama_drought_level"
    targetNamespace="https://etzhayyim.ai/bpmn/open-panama-drought"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_panama_drought_level" name="Gatun 水位" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="level 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_panama_lake_level&quot;" target="table"/>
          <zeebe:input source="={vertex_id: vertexId, measurement_id: measurementId, lake: lake, level_feet_pld: levelFeetPld, level_normal_feet: levelNormalFeet, drought_tier: if levelFeetPld &lt;= 79 then &quot;critical&quot; else if levelFeetPld &lt;= 82 then &quot;severe&quot; else if levelFeetPld &lt;= 85 then &quot;elevated&quot; else &quot;normal&quot;, require_restriction_notice: levelFeetPld &lt;= 82, measured_at: measuredAt, status: &quot;published&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-panama-drought&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit openPanamaDrought.level.record">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-panama-drought.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openPanamaDrought.level.record&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, lake: lake, levelFeetPld: levelFeetPld}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
