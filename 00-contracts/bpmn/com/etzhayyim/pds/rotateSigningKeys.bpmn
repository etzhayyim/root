<?xml version="1.0" encoding="UTF-8"?>
<!--
  pds.rotateSigningKeys — scheduled per-DID signing key hygiene.

  PDS still owns D1 signing key storage and KEK access. This BPMN process
  moves the scheduled rotation lifecycle to Zeebe/PyZeebe by invoking a
  HMAC-protected PDS internal maintenance endpoint.

  NSID: com.etzhayyim.apps.pds.rotateSigningKeys
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_pds_rotate_signing_keys"
    targetNamespace="https://etzhayyim.ai/bpmn/pds"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="pds_rotate_signing_keys" name="pds rotateSigningKeys" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.pds.rotateSigningKeys", "version": 1, "resultTimeoutMs": 90000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="every 5m">
      <bpmn:outgoing>Flow_ToRotate</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_5m">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT5M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToRotate" sourceRef="Start" targetRef="Task_Rotate"/>

    <bpmn:serviceTask id="Task_Rotate" name="rotate stale signing keys">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="pds.signingKeys.rotateStale"/>
        <zeebe:ioMapping>
          <zeebe:input source="=if pdsUrl = null then &quot;&quot; else string(pdsUrl)" target="pdsUrl"/>
          <zeebe:input source="=if maxAgeDays = null then 90 else maxAgeDays" target="maxAgeDays"/>
          <zeebe:input source="=if batchSize = null then 5 else batchSize" target="batchSize"/>
          <zeebe:input source="=false" target="flush"/>
          <zeebe:output source="=ok" target="pdsKeyRotationOk"/>
          <zeebe:output source="=scanned" target="pdsKeyRotationScanned"/>
          <zeebe:output source="=rotated" target="pdsKeyRotationRotated"/>
          <zeebe:output source="=errorCount" target="pdsKeyRotationErrorCount"/>
          <zeebe:output source="=auditUri" target="pdsKeyRotationAuditUri"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRotate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Rotate" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
