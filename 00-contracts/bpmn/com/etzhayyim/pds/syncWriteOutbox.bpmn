<?xml version="1.0" encoding="UTF-8"?>
<!--
  pds.syncWriteOutbox — replay failed fire-and-forget writes.

  PDS still owns XRPC dispatch and Hyperdrive bindings. This BPMN process
  moves the outbox replay cron/retry lifecycle to Zeebe/PyZeebe by invoking a
  HMAC-protected PDS internal maintenance endpoint.

  NSID: com.etzhayyim.apps.pds.syncWriteOutbox
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_pds_sync_write_outbox"
    targetNamespace="https://etzhayyim.ai/bpmn/pds"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="pds_sync_write_outbox" name="pds syncWriteOutbox" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.pds.syncWriteOutbox", "version": 1, "resultTimeoutMs": 90000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="every 5m">
      <bpmn:outgoing>Flow_ToSync</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_5m">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT5M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToSync" sourceRef="Start" targetRef="Task_Sync"/>

    <bpmn:serviceTask id="Task_Sync" name="sync write outbox">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="pds.writeOutbox.sync"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;&quot;" target="pdsUrl"/>
          <zeebe:input source="=false" target="flush"/>
          <zeebe:output source="=ok" target="pdsOutboxOk"/>
          <zeebe:output source="=replayed" target="pdsOutboxReplayed"/>
          <zeebe:output source="=retried" target="pdsOutboxRetried"/>
          <zeebe:output source="=expired" target="pdsOutboxExpired"/>
          <zeebe:output source="=auditUri" target="pdsOutboxAuditUri"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSync</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Sync" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
