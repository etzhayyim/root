<?xml version="1.0" encoding="UTF-8"?>
<!--
  pds.warmDiscoverCache — pre-populate DiscoverFeed cache.

  PDS still owns Hyperdrive reads and Cloudflare Cache API writes. This BPMN
  process moves the five-minute cache warm lifecycle to Zeebe/PyZeebe by
  invoking a HMAC-protected PDS internal maintenance endpoint.

  NSID: com.etzhayyim.apps.pds.warmDiscoverCache
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_pds_warm_discover_cache"
    targetNamespace="https://etzhayyim.ai/bpmn/pds"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="pds_warm_discover_cache" name="pds warmDiscoverCache" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.pds.warmDiscoverCache", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="every 5m">
      <bpmn:outgoing>Flow_ToWarm</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_5m">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT5M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToWarm" sourceRef="Start" targetRef="Task_Warm"/>

    <bpmn:serviceTask id="Task_Warm" name="warm discover cache">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="pds.discoverCache.warm"/>
        <zeebe:ioMapping>
          <zeebe:input source="=if pdsUrl = null then &quot;&quot; else string(pdsUrl)" target="pdsUrl"/>
          <zeebe:input source="=false" target="flush"/>
          <zeebe:output source="=ok" target="pdsDiscoverCacheOk"/>
          <zeebe:output source="=rowCount" target="pdsDiscoverCacheRowCount"/>
          <zeebe:output source="=auditUri" target="pdsDiscoverCacheAuditUri"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToWarm</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Warm" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
