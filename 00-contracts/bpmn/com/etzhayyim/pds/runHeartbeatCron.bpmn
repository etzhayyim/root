<?xml version="1.0" encoding="UTF-8"?>
<!--
  pds.runHeartbeatCron — drive app and shinka heartbeats.

  PDS still owns graph lookup and HTTP fan-out to app/_heartbeat endpoints.
  This BPMN process moves the five-minute heartbeat lifecycle to
  Zeebe/PyZeebe by invoking a HMAC-protected PDS internal maintenance endpoint.

  NSID: com.etzhayyim.apps.pds.runHeartbeatCron
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_pds_run_heartbeat_cron"
    targetNamespace="https://etzhayyim.ai/bpmn/pds"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="pds_run_heartbeat_cron" name="pds runHeartbeatCron" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.pds.runHeartbeatCron", "version": 1, "resultTimeoutMs": 120000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="every 5m">
      <bpmn:outgoing>Flow_ToHeartbeat</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_5m">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT5M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToHeartbeat" sourceRef="Start" targetRef="Task_Heartbeat"/>

    <bpmn:serviceTask id="Task_Heartbeat" name="run heartbeat batch">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="pds.heartbeat.run"/>
        <zeebe:ioMapping>
          <zeebe:input source="=if pdsUrl = null then &quot;&quot; else string(pdsUrl)" target="pdsUrl"/>
          <zeebe:input source="=false" target="flush"/>
          <zeebe:output source="=ok" target="pdsHeartbeatOk"/>
          <zeebe:output source="=heartbeatOk" target="pdsHeartbeatAppsOk"/>
          <zeebe:output source="=heartbeatFail" target="pdsHeartbeatAppsFail"/>
          <zeebe:output source="=shinkaStatus" target="pdsHeartbeatShinkaStatus"/>
          <zeebe:output source="=auditUri" target="pdsHeartbeatAuditUri"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToHeartbeat</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Heartbeat" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
