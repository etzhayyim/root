<?xml version="1.0" encoding="UTF-8"?>
<!--
  pds.expandDomainCoverage — register one uncovered domain per tick.

  PDS still owns Common Crawl/site/gyotaku fetches, Murakumo calls, repo writes,
  and social post creation. This BPMN process moves the cadence and audit trail
  to Zeebe/PyZeebe through a HMAC-protected PDS internal maintenance endpoint.

  NSID: com.etzhayyim.apps.pds.expandDomainCoverage
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_pds_expand_domain_coverage"
    targetNamespace="https://etzhayyim.ai/bpmn/pds"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="pds_expand_domain_coverage" name="pds expandDomainCoverage" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.pds.expandDomainCoverage", "version": 1, "resultTimeoutMs": 120000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="every 5m">
      <bpmn:outgoing>Flow_ToExpand</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_5m">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT5M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToExpand" sourceRef="Start" targetRef="Task_Expand"/>

    <bpmn:serviceTask id="Task_Expand" name="expand domain coverage">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="pds.domainCoverage.expand"/>
        <zeebe:ioMapping>
          <zeebe:input source="=if pdsUrl = null then &quot;&quot; else string(pdsUrl)" target="pdsUrl"/>
          <zeebe:input source="=false" target="flush"/>
          <zeebe:output source="=ok" target="pdsDomainCoverageOk"/>
          <zeebe:output source="=domain" target="pdsDomainCoverageDomain"/>
          <zeebe:output source="=appDid" target="pdsDomainCoverageAppDid"/>
          <zeebe:output source="=auditUri" target="pdsDomainCoverageAuditUri"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToExpand</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Expand" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
