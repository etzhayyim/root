<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_newsletter_send_campaign" targetNamespace="https://etzhayyim.ai/bpmn/newsletter">
  <bpmn:process id="newsletter_send_campaign" name="newsletter sendCampaign" isExecutable="true">
    <bpmn:documentation>{ "nsid": "com.etzhayyim.apps.newsletter.sendCampaign", "version": 1, "resultTimeoutMs": 120000 }</bpmn:documentation>
    <bpmn:startEvent id="Start"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task"/>
    <bpmn:serviceTask id="Task" name="send curated campaign">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="newsletter.send_via_resend" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F2" sourceRef="Task" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>F2</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
