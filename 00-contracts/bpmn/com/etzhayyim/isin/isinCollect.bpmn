<?xml version="1.0" encoding="UTF-8"?>
<!--
  Timer-start BPMN — ISIN securities collection (US + JP, every 6 hours).

  Pipeline:

    1. isin.collect.usSecurities  — fetch EDGAR company_tickers.json, batch via
                                    OpenFIGI (100/req), write to vertex_isin_security.
    2. isin.collect.jpSecurities  — OpenFIGI JP ticker range 1000-9999 (10/req free
                                    tier), write to vertex_isin_security.
    3. generic.audit.emit         — OCEL event with aggregate write counts.

  Cadence: R/PT6H. One BPMN instance every 6 hours.

  NSID: com.etzhayyim.apps.isin.isinCollect
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/isin-collect-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_isin_collect"
    targetNamespace="https://etzhayyim.ai/bpmn/isin"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="isin_collect" name="isin collect" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.isin.isinCollect", "version": 1, "resultTimeoutMs": 600000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start_Timer" name="every 6 hours">
      <bpmn:outgoing>Flow_ToCollectUS</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_PT6H">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT6H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Manual" name="manual / on-demand">
      <bpmn:outgoing>Flow_ToCollectUS_Manual</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_ToCollectUS"        sourceRef="Start_Timer"          targetRef="Task_CollectUS"/>
    <bpmn:sequenceFlow id="Flow_ToCollectUS_Manual" sourceRef="Start_Manual"          targetRef="Task_CollectUS"/>
    <bpmn:sequenceFlow id="Flow_ToCollectJP"        sourceRef="Task_CollectUS"        targetRef="Task_CollectJP"/>
    <bpmn:sequenceFlow id="Flow_ToAudit"            sourceRef="Task_CollectJP"        targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_End"                sourceRef="Task_Audit"            targetRef="End"/>

    <!-- Step 1: Collect US securities from EDGAR + OpenFIGI (offset=0 limit=200, enrichFigi=true). -->
    <bpmn:serviceTask id="Task_CollectUS" name="collect US securities (EDGAR + OpenFIGI)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="isin.collect.usSecurities"/>
        <zeebe:ioMapping>
          <zeebe:input source="=0"    target="offset"/>
          <zeebe:input source="=200"  target="limit"/>
          <zeebe:input source="=true" target="enrichFigi"/>
          <zeebe:output source="=written" target="usWritten"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- Step 2: Collect JP securities from OpenFIGI ticker range 1000-9999 (fromTicker=1000 count=25). -->
    <bpmn:serviceTask id="Task_CollectJP" name="collect JP securities (OpenFIGI ticker range)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="isin.collect.jpSecurities"/>
        <zeebe:ioMapping>
          <zeebe:input source="=1000" target="fromTicker"/>
          <zeebe:input source="=25"   target="count"/>
          <zeebe:output source="=written" target="jpWritten"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- Step 3: Emit OCEL audit event with aggregate write counts. -->
    <bpmn:serviceTask id="Task_Audit" name="emit collect audit event">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.isin.isinCollect&quot;" target="event_type"/>
          <zeebe:input source="=&quot;did:web:isin.etzhayyim.com&quot;"          target="actor_did"/>
          <zeebe:input source="={ usWritten: usWritten, jpWritten: jpWritten }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End" name="done"/>

  </bpmn:process>
</bpmn:definitions>
