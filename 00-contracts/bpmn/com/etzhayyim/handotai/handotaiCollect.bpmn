<?xml version="1.0" encoding="UTF-8"?>
<!--
  Timer-start BPMN — handotai semiconductor intelligence collection (every 4 hours).

  Pipeline:

    1. handotai.seed.writers   — idempotent upsert of 6 built-in RSS writer sources
                                 into vertex_handotai_source.
    2. handotai.collect.rssAll — fetch all enabled sources, parse RSS/Atom items,
                                 write deduplicated articles to vertex_handotai_article.
    3. handotai.generate.digest — query today's articles, LLM-summarize into
                                  vertex_handotai_digest.
    4. generic.audit.emit      — OCEL event with aggregate write counts.

  Cadence: R/PT4H. One BPMN instance every 4 hours.

  NSID: com.etzhayyim.apps.handotai.handotaiCollect
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/handotai-collect-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_handotai_collect"
    targetNamespace="https://etzhayyim.ai/bpmn/handotai"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="handotai_collect" name="handotai collect" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.handotai.handotaiCollect", "version": 1, "resultTimeoutMs": 600000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start_Timer" name="every 4 hours">
      <bpmn:outgoing>Flow_ToSeedWriters</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_PT4H">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT4H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Manual" name="manual / on-demand">
      <bpmn:outgoing>Flow_ToSeedWriters_Manual</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_ToSeedWriters"        sourceRef="Start_Timer"          targetRef="Task_SeedWriters"/>
    <bpmn:sequenceFlow id="Flow_ToSeedWriters_Manual" sourceRef="Start_Manual"         targetRef="Task_SeedWriters"/>
    <bpmn:sequenceFlow id="Flow_ToCollectAll"         sourceRef="Task_SeedWriters"     targetRef="Task_CollectAll"/>
    <bpmn:sequenceFlow id="Flow_ToGenerateDigest"     sourceRef="Task_CollectAll"      targetRef="Task_GenerateDigest"/>
    <bpmn:sequenceFlow id="Flow_ToAudit"              sourceRef="Task_GenerateDigest"  targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_End"                  sourceRef="Task_Audit"           targetRef="End"/>

    <!-- Step 1: Upsert 6 built-in RSS writer sources into vertex_handotai_source. -->
    <bpmn:serviceTask id="Task_SeedWriters" name="seed writer sources">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="handotai.seed.writers"/>
        <zeebe:ioMapping>
          <zeebe:output source="=upserted" target="seedUpserted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- Step 2: Fetch all 6 RSS feeds, parse items, write to vertex_handotai_article. -->
    <bpmn:serviceTask id="Task_CollectAll" name="collect all RSS feeds">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="handotai.collect.rssAll"/>
        <zeebe:ioMapping>
          <zeebe:input source="=20" target="maxPerSource"/>
          <zeebe:output source="=written"  target="articlesWritten"/>
          <zeebe:output source="=skipped"  target="articlesSkipped"/>
          <zeebe:output source="=errors"   target="collectErrors"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- Step 3: Query today's articles, LLM-summarize, write to vertex_handotai_digest. -->
    <bpmn:serviceTask id="Task_GenerateDigest" name="generate daily digest">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="handotai.generate.digest"/>
        <zeebe:ioMapping>
          <zeebe:output source="=digest_date"    target="digestDate"/>
          <zeebe:output source="=article_count"  target="digestArticleCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- Step 4: Emit OCEL audit event with aggregate write counts. -->
    <bpmn:serviceTask id="Task_Audit" name="emit collect audit event">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.handotai.handotaiCollect&quot;" target="event_type"/>
          <zeebe:input source="=&quot;did:web:handotcom.etzhayyim.ai&quot;"              target="actor_did"/>
          <zeebe:input source="={ articlesWritten: articlesWritten, articlesSkipped: articlesSkipped, digestDate: digestDate, digestArticleCount: digestArticleCount }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End" name="done"/>

  </bpmn:process>
</bpmn:definitions>
