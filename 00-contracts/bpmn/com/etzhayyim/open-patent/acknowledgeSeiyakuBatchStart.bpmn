<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_open_patent_acknowledge_seiyaku_batch_start" targetNamespace="https://etzhayyim.ai/bpmn/open-patent" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_patent_acknowledge_seiyaku_batch_start" name="acknowledgeSeiyakuBatchStart" isExecutable="true">
