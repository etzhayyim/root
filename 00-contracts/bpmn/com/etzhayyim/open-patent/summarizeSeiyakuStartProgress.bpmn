          <zeebe:output source="=vertexId" target="vertexId"/><zeebe:output source="=progressStatus" target="progressStatus"/><zeebe:output source="=startRequestVid" target="startRequestVid"/><zeebe:output source="=ackVid" target="ackVid"/>
