<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_open_patent_screen_expired_drug_patent" targetNamespace="https://etzhayyim.ai/bpmn/open-patent" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_patent_screen_expired_drug_patent" name="screenExpiredDrugPatent" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Screen"/>
    <bpmn:serviceTask id="Task_Screen" name="screen expired drug patent">
      <bpmn:extensionElements><zeebe:taskDefinition type="openPatent.expiredDrugPatent.screen"/>
        <zeebe:ioMapping>
          <zeebe:input source="={patentVertexId: patentVertexId, patentNumber: patentNumber, jurisdiction: jurisdiction, productId: productId, atcCode: atcCode, ndcCode: ndcCode, expiryDate: expiryDate, blockingExclusivityUntil: blockingExclusivityUntil, asOf: asOf}" target="payload"/>
          <zeebe:output source="=vertexId" target="vertexId"/><zeebe:output source="=eligible" target="eligible"/><zeebe:output source="=status" target="status"/><zeebe:output source="=asOf" target="asOf"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Screen" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-patent.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;openPatent.expiredDrugPatent.screen&quot;" target="action"/><zeebe:input source="={vertexId: vertexId, eligible: eligible, status: status, asOf: asOf}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
