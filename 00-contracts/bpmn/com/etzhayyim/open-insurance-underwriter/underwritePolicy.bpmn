<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_insurance_underwriter_policy" targetNamespace="https://etzhayyim.ai/bpmn/open-insurance-underwriter" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_insurance_underwriter_policy" name="Policy" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="policy">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_insurance_policy&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, policy_id: policyId, underwriter_lei: underwriterLei, insured_lei: insuredLei, insured_imo: insuredImo, cover_type: coverType, sum_insured_usd: sumInsuredUsd, premium_usd: premiumUsd, hormuz_zone_vid: hormuzZoneVid, cyber_audit_vid: cyberAuditVid, risk_tier: if coverType = &quot;war-risk&quot; and hormuzZoneVid != null then &quot;high&quot; else if coverType = &quot;cyber&quot; and cyberAuditVid = null then &quot;elevated&quot; else if (premiumUsd / sumInsuredUsd) * 10000 &gt;= 200 then &quot;high&quot; else &quot;standard&quot;, effective_from: effectiveFrom, effective_until: effectiveUntil, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-insurance-underwriter&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-insurance-underwriter.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;openInsuranceUnderwriter.policy.record&quot;" target="action"/><zeebe:input source="={vertexId: vertexId, policyId: policyId, coverType: coverType}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
