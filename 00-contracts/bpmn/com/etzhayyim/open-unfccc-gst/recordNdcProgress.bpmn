<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_unfccc_gst_record_ndc_progress" targetNamespace="https://etzhayyim.ai/bpmn/open-unfccc-gst" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_unfccc_gst_record_ndc_progress" name="recordNdcProgress" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_unfccc_gst&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, report_id: reportId, party_iso3: partyIso3, ndc_cycle: ndcCycle, gwp_basis: gwpBasis, reduction_target_pct: reductionTargetPct, baseline_year: baselineYear, sector_coverage: sectorCoverage, finance_need_usd_bn: financeNeedUsdBn, submitted_at: submittedAt, ambition_tier: if reductionTargetPct != null and reductionTargetPct &gt;= 55 then &quot;high_ambition&quot; else if reductionTargetPct != null and reductionTargetPct &gt;= 30 then &quot;moderate&quot; else &quot;low&quot;, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-unfccc-gst&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-unfccc-gst.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;open.unfcccGst.recordNdcProgress&quot;" target="action"/><zeebe:input source="={vertexId: vertexId}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>