<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_open_cyber_soc_fetch_cisa_alert_delta" targetNamespace="https://etzhayyim.ai/bpmn/open-cyber-soc" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_cyber_soc_fetch_cisa_alert_delta" name="fetchCisaAlertDelta" isExecutable="true">
    <bpmn:startEvent id="Start" name="every 6h"><bpmn:outgoing>Flow_F</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeCycle xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">R/PT6H</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Manual" name="manual"><bpmn:outgoing>Flow_FM</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_FM" sourceRef="Start_Manual" targetRef="Task_Fetch"/>
    <bpmn:sequenceFlow id="Flow_F" sourceRef="Start" targetRef="Task_Fetch"/>
    <bpmn:serviceTask id="Task_Fetch" name="cisa us-cert alerts atom">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.http.fetch" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;GET&quot;" target="method"/>
          <zeebe:input source="=&quot;https://www.cisa.gov/uscert/ncas/alerts.xml&quot;" target="url"/>
          <zeebe:input source="=&quot;atom&quot;" target="parse"/>
          <zeebe:input source="={&quot;Accept&quot;: &quot;application/atom+xml, application/xml;q=0.9, */*;q=0.8&quot;}" target="headers"/>
          <zeebe:output source="=entries" target="items"/>
          <zeebe:output source="=string(now())" target="fetchedAt"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F</bpmn:incoming><bpmn:outgoing>Flow_L</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_L" sourceRef="Task_Fetch" targetRef="Task_Loop"/>
    <bpmn:callActivity id="Task_Loop" name="record each alert" calledElement="open_cyber_soc_alert">
      <bpmn:extensionElements><zeebe:calledElement processId="open_cyber_soc_alert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;at://did:web:open-cyber-soc.etzhayyim.com/com.etzhayyim.apps.cyberSoc.recordSocAlert/&quot; + replace(item.link, &quot;https://www.cisa.gov/uscert/ncas/alerts/&quot;, &quot;&quot;)" target="vertexId"/>
          <zeebe:input source="=item.link" target="alertId"/>
          <zeebe:input source="=&quot;cisa-us-cert&quot;" target="sourceSiem"/>
          <zeebe:input source="=item.title" target="detectionRule"/>
          <zeebe:input source="=&quot;high&quot;" target="severity"/>
          <zeebe:input source="=item.published" target="firedAt"/>
          <zeebe:input source="=item.published" target="triagedAt"/>
          <zeebe:input source="=false" target="falsePositive"/>
          <zeebe:input source="=&quot;did:web:open-cyber-soc.etzhayyim.com&quot;" target="callerDid"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_L</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false"><bpmn:extensionElements><zeebe:loopCharacteristics inputCollection="=items" inputElement="item"/></bpmn:extensionElements></bpmn:multiInstanceLoopCharacteristics>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Loop" targetRef="Task_Advance"/>
    <bpmn:serviceTask id="Task_Advance" name="mark fetched">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;UPDATE vertex_open_cyber_source SET last_fetched_at = $1 WHERE source_id = 'cisa-alerts'&quot;" target="sql"/>
          <zeebe:input source="=[fetchedAt]" target="params"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Advance" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
