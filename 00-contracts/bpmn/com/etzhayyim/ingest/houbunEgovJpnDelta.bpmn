<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_ingest_houbun_egov_jpn_delta"
    targetNamespace="https://etzhayyim.ai/bpmn/ingest"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="ingest_houbun_egov_jpn_delta" name="ingest houbun e-Gov JPN delta" isExecutable="true">
    <bpmn:startEvent id="Start" name="start">
      <bpmn:outgoing>Flow_CreateRun</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_CreateRun" sourceRef="Start" targetRef="Task_CreateRun"/>

    <bpmn:serviceTask id="Task_CreateRun" name="create run">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="houbun.createRun" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CreateRun</bpmn:incoming>
      <bpmn:outgoing>Flow_Health</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Health" sourceRef="Task_CreateRun" targetRef="Task_Health"/>

    <bpmn:serviceTask id="Task_Health" name="rw health gate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="rw.health.probe" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:output source="=healthy" target="rwHealthy"/>
          <zeebe:output source="=reason" target="rwHealthReason"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Health</bpmn:incoming>
      <bpmn:outgoing>Flow_HealthGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_HealthGate" sourceRef="Task_Health" targetRef="Gateway_RwHealthy"/>

    <bpmn:exclusiveGateway id="Gateway_RwHealthy" name="RisingWave healthy?" default="Flow_RwDegraded">
      <bpmn:incoming>Flow_HealthGate</bpmn:incoming>
      <bpmn:outgoing>Flow_Plan</bpmn:outgoing>
      <bpmn:outgoing>Flow_RwDegraded</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Plan" sourceRef="Gateway_RwHealthy" targetRef="Task_Plan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rwHealthy = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RwDegraded" sourceRef="Gateway_RwHealthy" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Plan" name="plan e-Gov JPN shard">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="houbun.egovJpn.plan" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Plan</bpmn:incoming>
      <bpmn:outgoing>Flow_AcquireCursor</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AcquireCursor" sourceRef="Task_Plan" targetRef="Task_AcquireCursor"/>

    <bpmn:serviceTask id="Task_AcquireCursor" name="acquire cursor">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="houbun.acquireCursor" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AcquireCursor</bpmn:incoming>
      <bpmn:outgoing>Flow_Fetch</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Fetch" sourceRef="Task_AcquireCursor" targetRef="Task_Fetch"/>

    <bpmn:serviceTask id="Task_Fetch" name="fetch e-Gov law">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="houbun.egovJpn.fetch" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Fetch</bpmn:incoming>
      <bpmn:outgoing>Flow_WriteGraph</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_WriteGraph" sourceRef="Task_Fetch" targetRef="Task_WriteGraph"/>

    <bpmn:serviceTask id="Task_WriteGraph" name="write houbun graph">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="houbun.writeGraph" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_WriteGraph</bpmn:incoming>
      <bpmn:outgoing>Flow_IpfsPin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_IpfsPin" sourceRef="Task_WriteGraph" targetRef="Task_IpfsPin"/>

    <!-- Pin fetched document WebP to IPFS after graph write.
         source_url must be set by houbun.egovJpn.fetch as the canonical document URL.
         Output ipfs_cid / ipfs_url are carried forward for audit. -->
    <bpmn:serviceTask id="Task_IpfsPin" name="pin to IPFS">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ipfs.add" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=document_url" target="source_url"/>
          <zeebe:input source="=document_filename" target="filename"/>
          <zeebe:output source="=cid" target="ipfs_cid"/>
          <zeebe:output source="=ipfs_url" target="ipfs_url"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_IpfsPin</bpmn:incoming>
      <bpmn:outgoing>Flow_Verify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Verify" sourceRef="Task_IpfsPin" targetRef="Task_Verify"/>

    <bpmn:serviceTask id="Task_Verify" name="verify visibility">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="houbun.verifyVisibility" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Verify</bpmn:incoming>
      <bpmn:outgoing>Flow_AdvanceCursor</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AdvanceCursor" sourceRef="Task_Verify" targetRef="Task_AdvanceCursor"/>

    <bpmn:serviceTask id="Task_AdvanceCursor" name="advance cursor">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="houbun.advanceCursor" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AdvanceCursor</bpmn:incoming>
      <bpmn:outgoing>Flow_Complete</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Complete" sourceRef="Task_AdvanceCursor" targetRef="Task_Complete"/>

    <bpmn:serviceTask id="Task_Complete" name="complete run">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="houbun.completeRun" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_Complete" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="emit houbun e-Gov delta audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.ingest.houbunEgovJpnDelta.completed&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;processId&quot;: &quot;ingest_houbun_egov_jpn_delta&quot;, &quot;runId&quot;: runId, &quot;rwHealthy&quot;: rwHealthy, &quot;rwHealthReason&quot;: rwHealthReason, &quot;phase&quot;: if rwHealthy = true then &quot;completed&quot; else &quot;rw-degraded&quot; }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:incoming>Flow_RwDegraded</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="completed">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
