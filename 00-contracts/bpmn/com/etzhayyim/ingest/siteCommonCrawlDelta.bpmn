<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_ingest_site_common_crawl_delta"
    targetNamespace="https://etzhayyim.ai/bpmn/ingest"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="ingest_site_common_crawl_delta" name="ingest site Common Crawl delta" isExecutable="true">
    <bpmn:startEvent id="Start" name="start">
      <bpmn:outgoing>Flow_CreateRun</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_CreateRun" sourceRef="Start" targetRef="Task_CreateRun"/>

    <bpmn:serviceTask id="Task_CreateRun" name="create run">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="site.commonCrawl.createRun" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CreateRun</bpmn:incoming>
      <bpmn:outgoing>Flow_Health</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Health" sourceRef="Task_CreateRun" targetRef="Task_Health"/>

    <bpmn:serviceTask id="Task_Health" name="rw health gate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="rw.health.probe" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:output source="=healthy" target="rwHealthy"/>
          <zeebe:output source="=reason" target="rwHealthReason"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Health</bpmn:incoming>
      <bpmn:outgoing>Flow_HealthGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_HealthGate" sourceRef="Task_Health" targetRef="Gateway_RwHealthy"/>

    <bpmn:exclusiveGateway id="Gateway_RwHealthy" name="RisingWave healthy?" default="Flow_RwDegraded">
      <bpmn:incoming>Flow_HealthGate</bpmn:incoming>
      <bpmn:outgoing>Flow_Plan</bpmn:outgoing>
      <bpmn:outgoing>Flow_RwDegraded</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Plan" sourceRef="Gateway_RwHealthy" targetRef="Task_Plan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rwHealthy = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RwDegraded" sourceRef="Gateway_RwHealthy" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Plan" name="plan Common Crawl shard">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="site.commonCrawl.plan" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Plan</bpmn:incoming>
      <bpmn:outgoing>Flow_AcquireCursor</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AcquireCursor" sourceRef="Task_Plan" targetRef="Task_AcquireCursor"/>

    <bpmn:serviceTask id="Task_AcquireCursor" name="acquire cursor">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="site.commonCrawl.acquireCursor" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AcquireCursor</bpmn:incoming>
      <bpmn:outgoing>Flow_Download</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Download" sourceRef="Task_AcquireCursor" targetRef="Task_Download"/>

    <bpmn:serviceTask id="Task_Download" name="download WAT/WET artifacts">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="site.commonCrawl.runPhase" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;download&quot;" target="phase"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Download</bpmn:incoming>
      <bpmn:outgoing>Flow_Graph</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Graph" sourceRef="Task_Download" targetRef="Task_Graph"/>

    <bpmn:serviceTask id="Task_Graph" name="build page graph artifacts">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="site.commonCrawl.runPhase" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;graph&quot;" target="phase"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Graph</bpmn:incoming>
      <bpmn:outgoing>Flow_Intel</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Intel" sourceRef="Task_Graph" targetRef="Task_Intel"/>

    <bpmn:serviceTask id="Task_Intel" name="extract domain intelligence">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="site.commonCrawl.runPhase" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;intel&quot;" target="phase"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Intel</bpmn:incoming>
      <bpmn:outgoing>Flow_DomainIngest</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_DomainIngest" sourceRef="Task_Intel" targetRef="Task_DomainIngest"/>

    <bpmn:serviceTask id="Task_DomainIngest" name="write via domain ingest">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="site.commonCrawl.runPhase" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;domain-ingest&quot;" target="phase"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DomainIngest</bpmn:incoming>
      <bpmn:outgoing>Flow_RecordArtifacts</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_RecordArtifacts" sourceRef="Task_DomainIngest" targetRef="Task_RecordArtifacts"/>

    <bpmn:serviceTask id="Task_RecordArtifacts" name="record handoff artifacts">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="site.commonCrawl.recordArtifacts" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RecordArtifacts</bpmn:incoming>
      <bpmn:outgoing>Flow_Verify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Verify" sourceRef="Task_RecordArtifacts" targetRef="Task_Verify"/>

    <bpmn:serviceTask id="Task_Verify" name="verify site visibility">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="site.commonCrawl.verifyVisibility" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Verify</bpmn:incoming>
      <bpmn:outgoing>Flow_AdvanceCursor</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AdvanceCursor" sourceRef="Task_Verify" targetRef="Task_AdvanceCursor"/>

    <bpmn:serviceTask id="Task_AdvanceCursor" name="advance cursor">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="site.commonCrawl.advanceCursor" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AdvanceCursor</bpmn:incoming>
      <bpmn:outgoing>Flow_Complete</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Complete" sourceRef="Task_AdvanceCursor" targetRef="Task_Complete"/>

    <bpmn:serviceTask id="Task_Complete" name="complete run">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="site.commonCrawl.completeRun" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_Complete" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="emit Common Crawl delta audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.ingest.siteCommonCrawlDelta.completed&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;processId&quot;: &quot;ingest_site_common_crawl_delta&quot;, &quot;runId&quot;: runId, &quot;rwHealthy&quot;: rwHealthy, &quot;rwHealthReason&quot;: rwHealthReason, &quot;phase&quot;: if rwHealthy = true then &quot;completed&quot; else &quot;rw-degraded&quot; }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:incoming>Flow_RwDegraded</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="completed">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
