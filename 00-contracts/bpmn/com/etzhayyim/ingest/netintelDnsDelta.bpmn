<?xml version="1.0" encoding="UTF-8"?>
<!--
  Timer-start BPMN — monthly DNS/RDAP enrichment for shadow-level domains.
  Pulls stale domains from vertex_dns_observation, re-queries RDAP + DoH,
  and writes updated rows.

  NSID: com.etzhayyim.apps.ingest.start (timer-triggered)
  Task: netintel.dns.delta
  Cadence: R/PT1M (every 1 minute)
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_netintel_dns_delta"
    targetNamespace="https://etzhayyim.ai/bpmn/ingest/netintel"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="netintel_dns_delta" name="netintel dns delta" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.ingest.netintelDnsDelta", "version": 1, "resultTimeoutMs": 3600000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start_Timer" name="every 1 minute">
      <bpmn:outgoing>Flow_Timer</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_P1M">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">R/PT1M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Manual" name="manual / on-demand">
      <bpmn:outgoing>Flow_Manual</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Timer"  sourceRef="Start_Timer"  targetRef="Task_Health"/>
    <bpmn:sequenceFlow id="Flow_Manual" sourceRef="Start_Manual" targetRef="Task_Health"/>

    <bpmn:serviceTask id="Task_Health" name="rw health gate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="rw.health.probe"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Timer</bpmn:incoming>
      <bpmn:incoming>Flow_Manual</bpmn:incoming>
      <bpmn:outgoing>Flow_Ingest</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Ingest" sourceRef="Task_Health" targetRef="Task_Ingest"/>

    <bpmn:serviceTask id="Task_Ingest" name="ingest dns delta">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="netintel.dns.delta"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;shadow&quot;"  target="targetTier"/>
          <zeebe:input source="=200"              target="batchSize"/>
          <zeebe:output source="=domainsRead"     target="recordsRead"/>
          <zeebe:output source="=rowsWritten"     target="recordsWritten"/>
          <zeebe:output source="=runId"           target="runId"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ingest</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_Ingest" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit dns delta">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:ingest.etzhayyim.com&quot;"       target="actor"/>
          <zeebe:input source="=&quot;netintel.dns.delta&quot;"            target="action"/>
          <zeebe:input source="={runId: runId, recordsRead: recordsRead, recordsWritten: recordsWritten}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_MarkCompleted</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_MarkCompleted" sourceRef="Task_Audit" targetRef="Task_MarkCompleted"/>

    <bpmn:serviceTask id="Task_MarkCompleted" name="mark run completed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ingest.run.markCompleted"/>
        <zeebe:ioMapping>
          <zeebe:input source="=runId"          target="runId"/>
          <zeebe:input source="=&quot;completed&quot;" target="status"/>
          <zeebe:input source="=recordsRead"    target="recordsRead"/>
          <zeebe:input source="=recordsWritten" target="recordsWritten"/>
          <zeebe:input source="=0"              target="recordsSkipped"/>
          <zeebe:input source="=0"              target="errorCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MarkCompleted</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_MarkCompleted" targetRef="End"/>

    <bpmn:endEvent id="End" name="completed">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
