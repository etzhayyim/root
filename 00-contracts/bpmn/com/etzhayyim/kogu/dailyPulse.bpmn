<?xml version="1.0" encoding="UTF-8"?>
<!--
  kogu daily pulse — 毎日 00:35 に工具在庫・校正期限を集計し audit emit。
  校正期限切れ (nextCalibrationDate <= TODAY) があれば alertCalibrationOverdue を追加出力。
-->
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_kogu_daily_pulse"
  targetNamespace="https://etzhayyim.ai/bpmn/kogu"
  exporter="hand-written"
  exporterVersion="1.0">
  <bpmn:process id="kogu_daily_pulse" name="kogu Daily Pulse" isExecutable="true">

    <bpmn:startEvent id="Start" name="daily pulse">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 35 0 * * *</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_CountByStatus"/>

    <bpmn:serviceTask id="Task_CountByStatus" name="count tools by status">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_kogu_item&quot;" target="table"/>
          <zeebe:input source="=&quot;status != %s&quot;" target="whereExpr"/>
          <zeebe:input source="=[&quot;retired&quot;]" target="whereParams"/>
          <zeebe:input source="=&quot;status, count(*) as cnt&quot;" target="columns"/>
          <zeebe:input source="=10" target="limit"/>
          <zeebe:output source="=rows" target="statusRows"/>
          <zeebe:output source="=rowCount" target="statusCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CountByStatus" targetRef="Task_CheckCalibration"/>

    <bpmn:serviceTask id="Task_CheckCalibration" name="find overdue calibrations">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_kogu_item&quot;" target="table"/>
          <zeebe:input source="=&quot;calibration_required = true AND status = %s AND next_calibration_date &lt;= CURRENT_DATE&quot;" target="whereExpr"/>
          <zeebe:input source="=[&quot;available&quot;]" target="whereParams"/>
          <zeebe:input source="=&quot;tool_id, name, custodian_did, next_calibration_date&quot;" target="columns"/>
          <zeebe:input source="=50" target="limit"/>
          <zeebe:output source="=rows" target="overdueCalibRows"/>
          <zeebe:output source="=rowCount" target="overdueCalibCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_CheckCalibration" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="emit daily audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:kogu.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;dailyPulse&quot;" target="action"/>
          <zeebe:input source="={ statusRows: statusRows, overdueCalibCount: overdueCalibCount, bpmnProcessId: &quot;kogu_daily_pulse&quot; }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Gate" sourceRef="Task_Audit" targetRef="Gate_CalibOverdue"/>

    <bpmn:exclusiveGateway id="Gate_CalibOverdue" name="calibration overdue?" default="Flow_NoOverdue">
      <bpmn:incoming>Flow_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Overdue</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoOverdue</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Overdue" sourceRef="Gate_CalibOverdue" targetRef="Task_AlertCalib">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=overdueCalibCount > 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoOverdue" sourceRef="Gate_CalibOverdue" targetRef="End"/>

    <bpmn:serviceTask id="Task_AlertCalib" name="emit calibration overdue alert">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:kogu.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;calibrationOverdueAlert&quot;" target="action"/>
          <zeebe:input source="={ overdueCalibCount: overdueCalibCount, overdueCalibRows: overdueCalibRows }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Overdue</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_AlertCalib" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_NoOverdue</bpmn:incoming>
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
