<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_omise_list_orders" targetNamespace="https://etzhayyim.ai/bpmn/omise">
  <bpmn:process id="omise_list_orders" name="omise.listOrders" isExecutable="true">
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_Start_Task</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_Task" sourceRef="Start" targetRef="Task_listOrders" />
    <bpmn:serviceTask id="Task_listOrders" name="omise.listOrders">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="xrpc.com.etzhayyim.apps.omise.listOrders" retries="2" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Task</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Task_End" sourceRef="Task_listOrders" targetRef="End" />
    <bpmn:endEvent id="End">
      <bpmn:incoming>Flow_Task_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
