<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="compintelTrack"
                  targetNamespace="com.etzhayyim.apps.compintel">

  <!--
    trackCompetitor.bpmn — Triggered by com.etzhayyim.apps.compintel.trackCompetitor XRPC.
    Runs initial deep research on a newly added competitor.
  -->

  <bpmn:process id="compintelTrackProcess" isExecutable="true" name="Track New Competitor">

    <bpmn:startEvent id="Start" name="Competitor Added">
      <bpmn:outgoing>toInitialResearch</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="InitialResearch" name="Initial Deep Research (LangGraph)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="compintel.run_research_agent" retries="2" />
        <zeebe:taskHeaders>
          <zeebe:header key="timeout" value="300" />
          <zeebe:header key="mode" value="single_deep" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>toInitialResearch</bpmn:incoming>
      <bpmn:outgoing>toScore</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Score" name="Score Threat Level">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="compintel.score_threats" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="timeout" value="30" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>toScore</bpmn:incoming>
      <bpmn:outgoing>toEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End" name="Initial Snapshot Stored">
      <bpmn:incoming>toEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="toInitialResearch" sourceRef="Start" targetRef="InitialResearch" />
    <bpmn:sequenceFlow id="toScore" sourceRef="InitialResearch" targetRef="Score" />
    <bpmn:sequenceFlow id="toEnd" sourceRef="Score" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>
