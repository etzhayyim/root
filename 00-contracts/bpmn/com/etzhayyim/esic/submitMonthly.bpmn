<?xml version="1.0" encoding="UTF-8"?>
<!--
  ADR-0054 — esic_submit_monthly.

  Mirrors epfo_submit_monthly_ecr but for ESIC contributions.
  Tier 3: roster_payload + ip_number_payload + aadhaar_payload + nominee_payload.
  Tier 1: monthly totals + challan reference.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_esic_submit_monthly"
    targetNamespace="https://etzhayyim.ai/bpmn/esic"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="esic_submit_monthly" name="ESIC monthly contribution" isExecutable="true">

    <bpmn:startEvent id="Start" name="Start">
      <bpmn:outgoing>Flow_S</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_FormInput"/>

    <bpmn:userTask id="Task_FormInput" name="Roster input">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:esic-monthly-form-v1"/>
        <zeebe:assignmentDefinition candidateGroups="payroll-officer"/>
        <zeebe:taskSchedule dueDate="=now() + duration(&quot;P10D&quot;)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming>
      <bpmn:incoming>Flow_LoopBack</bpmn:incoming>
      <bpmn:outgoing>Flow_F1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_F1" sourceRef="Task_FormInput" targetRef="Task_PersistDraft"/>

    <bpmn:serviceTask id="Task_PersistDraft" name="Persist Tier 3 roster">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_esic_contribution_pii&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:               vertexId,
              establishment_esi_code:  establishmentEsiCode,
              roster_payload:          string(rosterPayload),
              ip_number_payload:       string(ipNumberPayload),
              aadhaar_payload:         string(aadhaarPayload),
              nominee_payload:         string(nomineePayload),
              amendment_log:           &quot;[]&quot;,
              retention_until:         date and time(date(&quot;9999-12-31&quot;), time(&quot;00:00:00&quot;)),
              created_at:              string(now()),
              owner_did:               filerDid,
              sensitivity_ord:         3,
              org_id:                  employerOrgId,
              user_id:                 filerDid,
              actor_id:                &quot;sys.bpmn.esic&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F1</bpmn:incoming>
      <bpmn:outgoing>Flow_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F2" sourceRef="Task_PersistDraft" targetRef="Task_PersistTier1"/>

    <bpmn:serviceTask id="Task_PersistTier1" name="Persist Tier 1 totals">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_esic_contribution&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:                              vertexId,
              employer_org_id:                        employerOrgId,
              establishment_esi_code:                 establishmentEsiCode,
              wage_month:                             wageMonth,
              process_type:                           &quot;initial&quot;,
              status:                                 &quot;submitted&quot;,
              declaration_hash:                       string(declarationHash),
              total_members:                          number(establishment.totalMembers),
              total_wage_inr_paise:                   number(establishment.totalWageInrPaise),
              total_employee_contribution_inr_paise:  number(establishment.totalEmployeeContributionInrPaise),
              total_employer_contribution_inr_paise:  number(establishment.totalEmployerContributionInrPaise),
              total_contribution_inr_paise:           number(establishment.totalContributionInrPaise),
              submitted_at:                           string(now()),
              created_at:                             string(now()),
              owner_did:                              filerDid,
              sensitivity_ord:                        1,
              org_id:                                 employerOrgId,
              user_id:                                filerDid,
              actor_id:                               &quot;sys.bpmn.esic&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F2</bpmn:incoming>
      <bpmn:outgoing>Flow_F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F3" sourceRef="Task_PersistTier1" targetRef="Task_FinanceReview"/>

    <bpmn:userTask id="Task_FinanceReview" name="Finance review">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:esic-review-v1"/>
        <zeebe:assignmentDefinition candidateGroups="finance-controller"/>
        <zeebe:taskSchedule dueDate="=now() + duration(&quot;P5D&quot;)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F3</bpmn:incoming>
      <bpmn:outgoing>Flow_F4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_F4" sourceRef="Task_FinanceReview" targetRef="Gate_Approved"/>

    <bpmn:exclusiveGateway id="Gate_Approved" name="Approved?" default="Flow_Reject">
      <bpmn:incoming>Flow_F4</bpmn:incoming>
      <bpmn:outgoing>Flow_Approve</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Approve" sourceRef="Gate_Approved" targetRef="Task_MarkSubmitted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verdict.decision = "approve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Reject" sourceRef="Gate_Approved" targetRef="Task_MarkRejected"/>

    <bpmn:serviceTask id="Task_MarkSubmitted" name="Mark submitted">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_esic_contribution&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:                              vertexId,
              employer_org_id:                        employerOrgId,
              establishment_esi_code:                 establishmentEsiCode,
              wage_month:                             wageMonth,
              process_type:                           &quot;initial&quot;,
              status:                                 &quot;submitted&quot;,
              declaration_hash:                       string(declarationHash),
              total_members:                          number(establishment.totalMembers),
              total_wage_inr_paise:                   number(establishment.totalWageInrPaise),
              total_employee_contribution_inr_paise:  number(establishment.totalEmployeeContributionInrPaise),
              total_employer_contribution_inr_paise:  number(establishment.totalEmployerContributionInrPaise),
              total_contribution_inr_paise:           number(establishment.totalContributionInrPaise),
              challan_reference:                      string(verdict.challanReference),
              submitted_at:                           string(now()),
              approved_at:                            string(now()),
              approved_by_did:                        string(reviewerDid),
              created_at:                             string(now()),
              owner_did:                              filerDid,
              sensitivity_ord:                        1,
              org_id:                                 employerOrgId,
              user_id:                                filerDid,
              actor_id:                               &quot;sys.bpmn.esic&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;replace&quot;" target="onConflict"/>
          <zeebe:output source="=&quot;submitted&quot;" target="finalStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_Kaikei</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Kaikei" sourceRef="Task_MarkSubmitted" targetRef="Task_PropagateKaikei"/>

    <bpmn:serviceTask id="Task_PropagateKaikei" name="Propagate ESI payable to kaikei">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.kaikei.recordEsiPayable&quot;" target="type"/>
          <zeebe:input source="={
              employerOrgId:                         employerOrgId,
              establishmentEsiCode:                  establishmentEsiCode,
              wageMonth:                             wageMonth,
              totalEmployeeContributionInrPaise:     number(establishment.totalEmployeeContributionInrPaise),
              totalEmployerContributionInrPaise:     number(establishment.totalEmployerContributionInrPaise),
              triggerVertexId:                       vertexId,
              triggerSource:                         &quot;com.etzhayyim.apps.esic.finalize&quot;,
              challanReference:                      string(verdict.challanReference)
          }" target="payload"/>
          <zeebe:input source="=&quot;did:web:ind.payroll.etzhayyim.com:esic&quot;" target="callerDid"/>
          <zeebe:output source="=ok" target="kaikeiPropagated"/>
          <zeebe:output source="=status" target="kaikeiHttpStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Kaikei</bpmn:incoming>
      <bpmn:outgoing>Flow_AuditOk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AuditOk" sourceRef="Task_PropagateKaikei" targetRef="Task_AuditSubmitted"/>

    <bpmn:serviceTask id="Task_AuditSubmitted" name="Audit submitted">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:ind.payroll.etzhayyim.com:esic&quot;" target="actor"/>
          <zeebe:input source="=&quot;esic.submitMonthly.approve&quot;" target="action"/>
          <zeebe:input source="={
              vertexId:                vertexId,
              establishmentEsiCode:    establishmentEsiCode,
              wageMonth:               wageMonth,
              kaikeiPropagated:        kaikeiPropagated,
              challanReference:        string(verdict.challanReference)
          }" target="payload"/>
          <zeebe:output source="=rkey" target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AuditOk</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_AuditSubmitted" targetRef="End"/>

    <bpmn:serviceTask id="Task_MarkRejected" name="Mark rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_esic_contribution&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:                              vertexId,
              employer_org_id:                        employerOrgId,
              establishment_esi_code:                 establishmentEsiCode,
              wage_month:                             wageMonth,
              process_type:                           &quot;initial&quot;,
              status:                                 &quot;rejected&quot;,
              declaration_hash:                       string(declarationHash),
              total_members:                          number(establishment.totalMembers),
              total_wage_inr_paise:                   number(establishment.totalWageInrPaise),
              total_employee_contribution_inr_paise:  number(establishment.totalEmployeeContributionInrPaise),
              total_employer_contribution_inr_paise:  number(establishment.totalEmployerContributionInrPaise),
              total_contribution_inr_paise:           number(establishment.totalContributionInrPaise),
              submitted_at:                           string(now()),
              created_at:                             string(now()),
              owner_did:                              filerDid,
              sensitivity_ord:                        1,
              org_id:                                 employerOrgId,
              user_id:                                filerDid,
              actor_id:                               &quot;sys.bpmn.esic&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;replace&quot;" target="onConflict"/>
          <zeebe:output source="=&quot;rejected&quot;" target="finalStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_AuditReject</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AuditReject" sourceRef="Task_MarkRejected" targetRef="Task_AuditRejected"/>

    <bpmn:serviceTask id="Task_AuditRejected" name="Audit rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:ind.payroll.etzhayyim.com:esic&quot;" target="actor"/>
          <zeebe:input source="=&quot;esic.submitMonthly.reject&quot;" target="action"/>
          <zeebe:input source="={
              vertexId:             vertexId,
              establishmentEsiCode: establishmentEsiCode,
              wageMonth:            wageMonth,
              comment:              string(verdict.comment)
          }" target="payload"/>
          <zeebe:output source="=rkey" target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AuditReject</bpmn:incoming>
      <bpmn:outgoing>Flow_LoopBack</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_LoopBack" sourceRef="Task_AuditRejected" targetRef="Task_FormInput"/>

    <bpmn:endEvent id="End" name="Done">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
