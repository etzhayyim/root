<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_jpn_jpo_record_examination"
    targetNamespace="https://etzhayyim.ai/bpmn/jpn-jpo"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="jpn_jpo_record_examination" name="JPO 審査記録" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="examination 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_jpn_jpo_examination&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id: vertexId, application_number: applicationNumber,
              decision: decision, decision_date: decisionDate,
              examiner_id: examinerId, rejection_grounds: rejectionGrounds,
              cited_art: citedArt, next_action: nextAction,
              status: &quot;recorded&quot;, created_at: string(now()),
              owner_did: callerDid, sensitivity_ord: 1,
              org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.jpn-jpo&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit jpnJpo.examination.record">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:jpn-jpo.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;jpnJpo.examination.record&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, applicationNumber: applicationNumber, decision: decision}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
