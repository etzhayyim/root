<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_legal_aid_open_case" targetNamespace="https://etzhayyim.ai/bpmn/legal-aid" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="legal_aid_open_case" name="openCase" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Insert"/>
    <bpmn:serviceTask id="Task_Insert" name="insert legal-aid case (Tier 3)">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_legal_aid_case&quot;" target="table"/>
          <zeebe:input source="={vertex_id: &quot;at://&quot; + officeDid + &quot;/com.etzhayyim.apps.legal-aid.case/&quot; + applicantHash, office_did: officeDid, applicant_hash: applicantHash, applicant_pii_enc: applicantPiiEnc, matter_area: matterArea, income_bracket: incomeBracket, language_code: languageCode, intake_channel: intakeChannel, opened_at: openedAt, status: &quot;open&quot;, owner_did: officeDid, sensitivity_ord: 3, created_at: now}" target="row"/>
          <zeebe:input source="=&quot;skip&quot;" target="onConflict"/>
          <zeebe:output source="=vertex_id" target="vertexId"/>
          <zeebe:output source="=row.applicant_hash" target="caseRef"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Insert" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
