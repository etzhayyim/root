<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_org_takeda_gmp_batch_release"
    targetNamespace="https://etzhayyim.ai/bpmn/open-org-takeda"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="open_org_takeda_gmp_batch_release" name="Takeda GMP batch release" isExecutable="true">
    <bpmn:startEvent id="Start" name="release requested">
      <bpmn:outgoing>Flow_S</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_AssessReadiness"/>

    <bpmn:serviceTask id="Task_AssessReadiness" name="assess GMP readiness">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.rules.evaluate"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;open-org-takeda.gmp-batch-release.v1&quot;" target="ruleSet"/>
          <zeebe:input source="={
              vertexId:           vertexId,
              organizationId:     organizationId,
              siteId:             siteId,
              productCode:        productCode,
              batchNumber:        batchNumber,
              bmrComplete:        bmrComplete,
              qcReleased:         qcReleased,
              deviationOpenCount: deviationOpenCount,
              exportControlled:   exportControlled
          }" target="facts"/>
          <zeebe:output source="=readinessPassed" target="readinessPassed"/>
          <zeebe:output source="=releaseRiskTier" target="releaseRiskTier"/>
          <zeebe:output source="=findings" target="readinessFindings"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming>
      <bpmn:outgoing>Flow_ReadinessGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ReadinessGate" sourceRef="Task_AssessReadiness" targetRef="Gate_ReadinessPassed"/>

    <bpmn:exclusiveGateway id="Gate_ReadinessPassed" name="ready?" default="Flow_NotReady">
      <bpmn:incoming>Flow_ReadinessGate</bpmn:incoming>
      <bpmn:outgoing>Flow_Ready</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotReady</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Ready" sourceRef="Gate_ReadinessPassed" targetRef="Gate_ExportControlled">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=readinessPassed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotReady" sourceRef="Gate_ReadinessPassed" targetRef="Task_SaveHold"/>

    <bpmn:exclusiveGateway id="Gate_ExportControlled" name="export controlled?" default="Flow_NoScreen">
      <bpmn:incoming>Flow_Ready</bpmn:incoming>
      <bpmn:outgoing>Flow_Screen</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoScreen</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Screen" sourceRef="Gate_ExportControlled" targetRef="Task_ScreenExport">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=exportControlled = true or releaseRiskTier = "controlled"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoScreen" sourceRef="Gate_ExportControlled" targetRef="Task_SaveRelease"/>

    <bpmn:serviceTask id="Task_ScreenExport" name="screen export control">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.rules.evaluate"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;open-org-takeda.export-screen.v1&quot;" target="ruleSet"/>
          <zeebe:input source="={productCode: productCode, destinationIso3: destinationIso3, batchNumber: batchNumber}" target="facts"/>
          <zeebe:output source="=exportCleared" target="exportCleared"/>
          <zeebe:output source="=findings" target="exportFindings"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Screen</bpmn:incoming>
      <bpmn:outgoing>Flow_ExportGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ExportGate" sourceRef="Task_ScreenExport" targetRef="Gate_ExportCleared"/>

    <bpmn:exclusiveGateway id="Gate_ExportCleared" name="export cleared?" default="Flow_ExportHold">
      <bpmn:incoming>Flow_ExportGate</bpmn:incoming>
      <bpmn:outgoing>Flow_ExportCleared</bpmn:outgoing>
      <bpmn:outgoing>Flow_ExportHold</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_ExportCleared" sourceRef="Gate_ExportCleared" targetRef="Task_SaveRelease">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=exportCleared = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ExportHold" sourceRef="Gate_ExportCleared" targetRef="Task_SaveHold"/>

    <bpmn:serviceTask id="Task_SaveRelease" name="save released batch">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_org_takeda&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:         vertexId,
              organization_id:   organizationId,
              site_id:           siteId,
              product_code:      productCode,
              batch_number:      batchNumber,
              release_risk_tier: releaseRiskTier,
              status:            &quot;released&quot;,
              released_at:       string(now()),
              created_at:        string(now()),
              owner_did:         callerDid,
              sensitivity_ord:   1,
              org_id:            callerDid,
              user_id:           callerDid,
              actor_id:          &quot;sys.bpmn.open-org-takeda&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoScreen</bpmn:incoming>
      <bpmn:incoming>Flow_ExportCleared</bpmn:incoming>
      <bpmn:outgoing>Flow_AuditReleased</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AuditReleased" sourceRef="Task_SaveRelease" targetRef="Task_AuditReleased"/>

    <bpmn:serviceTask id="Task_SaveHold" name="save release hold">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_org_takeda&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:          vertexId,
              organization_id:    organizationId,
              site_id:            siteId,
              product_code:       productCode,
              batch_number:       batchNumber,
              release_risk_tier:  releaseRiskTier,
              readiness_findings: readinessFindings,
              export_findings:    exportFindings,
              status:             &quot;hold&quot;,
              created_at:         string(now()),
              owner_did:          callerDid,
              sensitivity_ord:    1,
              org_id:             callerDid,
              user_id:            callerDid,
              actor_id:           &quot;sys.bpmn.open-org-takeda&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NotReady</bpmn:incoming>
      <bpmn:incoming>Flow_ExportHold</bpmn:incoming>
      <bpmn:outgoing>Flow_AuditHold</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AuditHold" sourceRef="Task_SaveHold" targetRef="Task_AuditHold"/>

    <bpmn:serviceTask id="Task_AuditReleased" name="audit released">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-org-takeda.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openOrg.takeda.gmpBatch.release&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, siteId: siteId, productCode: productCode, batchNumber: batchNumber, riskTier: releaseRiskTier}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AuditReleased</bpmn:incoming>
      <bpmn:outgoing>Flow_EndReleased</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndReleased" sourceRef="Task_AuditReleased" targetRef="End"/>

    <bpmn:serviceTask id="Task_AuditHold" name="audit hold">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-org-takeda.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openOrg.takeda.gmpBatch.hold&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, siteId: siteId, productCode: productCode, batchNumber: batchNumber, findings: readinessFindings}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AuditHold</bpmn:incoming>
      <bpmn:outgoing>Flow_EndHold</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndHold" sourceRef="Task_AuditHold" targetRef="End_Hold"/>

    <bpmn:endEvent id="End" name="released">
      <bpmn:incoming>Flow_EndReleased</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Hold" name="held">
      <bpmn:incoming>Flow_EndHold</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
