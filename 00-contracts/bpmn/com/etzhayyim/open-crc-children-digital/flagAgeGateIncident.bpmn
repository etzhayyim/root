<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_crc_children_digital_flag_age_gate_incident" targetNamespace="https://etzhayyim.ai/bpmn/open-crc-children-digital" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_crc_children_digital_flag_age_gate_incident" name="flagAgeGateIncident" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_crc_children_digital&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, incident_id: incidentId, platform_lei: platformLei, jurisdiction_iso3: jurisdictionIso3, age_gate_method: ageGateMethod, incident_kind: incidentKind, affected_minors: affectedMinors, reported_at: reportedAt, severity_tier: if incidentKind = &quot;coppa_violation&quot; or incidentKind = &quot;gdpr_article8_violation&quot; or incidentKind = &quot;data_overreach&quot; then &quot;systemic&quot; else if affectedMinors != null and affectedMinors &gt;= 100000 then &quot;mass_impact&quot; else &quot;targeted&quot;, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-crc-children-digital&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-crc-children-digital.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;open.crcChildrenDigital.flagAgeGateIncident&quot;" target="action"/><zeebe:input source="={vertexId: vertexId}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>