<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_gmail_triage_tick" targetNamespace="https://etzhayyim.ai/bpmn/gmail" exporter="hand-written" exporterVersion="1.0"><bpmn:process id="gmail_triage_tick" name="gmail triageTick" isExecutable="true"><bpmn:documentation>{ "nsid": "", "version": 1, "resultTimeoutMs": 240000, "note": "R/PT15M timer-only autonomous loop. No XRPC binding. Invokes gmail.triage task which delegates to gmail_triage.v1 LangGraph (ADR-0032 + ADR-2605072000)." }</bpmn:documentation><bpmn:startEvent id="Start" name="every 15 minutes"><bpmn:outgoing>Flow_1</bpmn:outgoing><bpmn:timerEventDefinition id="Timer_PT15M"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT15M</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent><bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_Triage"/><bpmn:serviceTask id="Task_Triage" name="gmail triage"><bpmn:extensionElements><zeebe:taskDefinition type="gmail.triage"/><zeebe:ioMapping><zeebe:input source="=50" target="batchSize"/></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:serviceTask><bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Triage" targetRef="Task_Audit"/><bpmn:serviceTask id="Task_Audit" name="audit emit"><bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/><zeebe:ioMapping><zeebe:input source="=&quot;gmail_triage_tick&quot;" target="actor"/><zeebe:input source="=&quot;gmail.triage.completed&quot;" target="event"/></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:serviceTask><bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Audit" targetRef="End"/><bpmn:endEvent id="End"><bpmn:incoming>Flow_3</bpmn:incoming></bpmn:endEvent></bpmn:process></bpmn:definitions>
