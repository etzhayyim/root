<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_smishing_analyze_message"
    targetNamespace="https://etzhayyim.ai/bpmn/smishing"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="smishing_analyze_message" name="smishing analyze message" isExecutable="true">
    <bpmn:startEvent id="Start" name="sms analysis requested">
      <bpmn:outgoing>Flow_Classify</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Classify" sourceRef="Start" targetRef="Task_Classify"/>
    <bpmn:serviceTask id="Task_Classify" name="classify sms message">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="smishing.message.classify"/>
        <zeebe:ioMapping>
          <zeebe:input source="=smsId" target="smsId"/>
          <zeebe:input source="=senderAddress" target="senderAddress"/>
          <zeebe:input source="=body" target="body"/>
          <zeebe:input source="=timestamp" target="timestamp"/>
          <zeebe:output source="=classification" target="classification"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Classify</bpmn:incoming>
      <bpmn:outgoing>Flow_Analyze</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Analyze" sourceRef="Task_Classify" targetRef="Task_Analyze"/>
    <bpmn:serviceTask id="Task_Analyze" name="deep analyze and commit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="smishing.message.deepAnalyze"/>
        <zeebe:ioMapping>
          <zeebe:input source="=smsId" target="smsId"/>
          <zeebe:input source="=senderAddress" target="senderAddress"/>
          <zeebe:input source="=body" target="body"/>
          <zeebe:input source="=timestamp" target="timestamp"/>
          <zeebe:input source="=publish" target="publish"/>
          <zeebe:input source="=classification" target="classification"/>
          <zeebe:output source="=result" target="result"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Analyze</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_Analyze" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit smishing analysis">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:smishing.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;smishing.analyzeMessage&quot;" target="action"/>
          <zeebe:input source="={ smsId: string(smsId), result: result }" target="payload"/>
          <zeebe:output source="=rkey" target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End" name="smishing analysis committed">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
