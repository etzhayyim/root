<?xml version="1.0" encoding="UTF-8"?>
<!--
  Timer-start BPMN — Science paper knowledge graph ingest pipeline.

  Pipeline (4 service tasks):

    1. science.paper.fetchArxiv    — Fetch arXiv papers for a domain/query,
                                     upsert into vertex_scientific_paper.
                                     Returns insertedCount / domain / query.

    2. science.paper.embedBatch    — Compute abstract embeddings for papers
                                     without ivf_cluster_id. Batch size 50.
                                     Returns embeddedCount.

    3. science.paper.linkGraph     — NER extract entities from paper abstracts,
                                     resolve to vertex_periodic_element /
                                     vertex_scientific_taxon / vertex_compound /
                                     vertex_protein, insert edge_paper_* rows.
                                     Returns linkOpsCount.

    4. generic.audit.emit          — OCEL event with aggregate stats.

  Cadence: R/PT24H. Each fire processes one domain + query pair.
  Multiple instances can be deployed with different domain/query variables.
  ADR-0056 (BPMN-as-actor). NSID: com.etzhayyim.apps.science.sciencePaperIngest.
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/science-paper-ingest-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_science_paper_ingest"
    targetNamespace="https://etzhayyim.ai/bpmn/science"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="science_paper_ingest" name="science paper ingest" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.science.sciencePaperIngest", "version": 1, "resultTimeoutMs": 86400000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="every 24 hours">
      <bpmn:outgoing>Flow_ToFetch</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_PT24H">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT24H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToFetch" sourceRef="Start" targetRef="Task_FetchArxiv"/>

    <!-- Step 1: Fetch arXiv papers for the configured domain/query. -->
    <bpmn:serviceTask id="Task_FetchArxiv" name="fetch arXiv papers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="science.paper.fetchArxiv"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;biology&quot;"  target="domain"/>
          <zeebe:input source="=&quot;molecular biology protein structure function&quot;" target="query"/>
          <zeebe:input source="=50"    target="max_results"/>
          <zeebe:output source="=insertedCount" target="insertedCount"/>
          <zeebe:output source="=domain"        target="domain"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToFetch</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEmbed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEmbed" sourceRef="Task_FetchArxiv" targetRef="Task_EmbedBatch"/>

    <!-- Step 2: Embed abstracts for unembedded papers. -->
    <bpmn:serviceTask id="Task_EmbedBatch" name="embed paper abstracts">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="science.paper.embedBatch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=50"    target="batch_size"/>
          <zeebe:output source="=embeddedCount" target="embeddedCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToEmbed</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLink</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToLink" sourceRef="Task_EmbedBatch" targetRef="Task_LinkGraph"/>

    <!-- Step 3: NER + resolve + link papers to entities in knowledge graph. -->
    <bpmn:serviceTask id="Task_LinkGraph" name="link papers to knowledge graph entities">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="science.paper.linkGraph"/>
        <zeebe:ioMapping>
          <zeebe:input source="=300"   target="batch_size"/>
          <zeebe:input source="=domain" target="domain"/>
          <zeebe:output source="=linkOpsCount" target="linkOpsCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToLink</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_LinkGraph" targetRef="Task_Audit"/>

    <!-- Step 4: OCEL audit event. -->
    <bpmn:serviceTask id="Task_Audit" name="emit science.paper.ingest OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.science.sciencePaperIngest&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;domain&quot;: domain, &quot;insertedCount&quot;: insertedCount, &quot;embeddedCount&quot;: embeddedCount, &quot;linkOpsCount&quot;: linkOpsCount }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
