<?xml version="1.0" encoding="UTF-8"?>
<!--
  Timer-start BPMN — Kami 3D model seeding for scientific entities.

  Pipeline:

    1. science.kami.seedElements   — Seed CPK sphere kami model instances for
                                     all 118 periodic table elements in
                                     vertex_periodic_element. Places one sphere
                                     per element at a default world coordinate
                                     derived from atomic number (demo layout).
                                     Idempotent: skips elements already present
                                     in vertex_kami_model_instance.
                                     Returns elementCount / instancesSeeded.

    2. science.kami.seedVegetation — Seed procedural kami model instances for
                                     all taxa in vertex_scientific_taxon that
                                     have a render_profile_json. Places instances
                                     at H3 res10 tiles near Tokyo anchor (demo).
                                     Idempotent. Returns taxonCount / instancesSeeded.

    3. generic.audit.emit          — OCEL event with aggregate stats.

  Cadence: R/PT6H. Seeds are idempotent — re-runs only add missing instances.
  ADR-0056 (BPMN-as-actor). NSID: com.etzhayyim.apps.science.kamiSeedScientific.
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/science-kami-seed-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_science_kami_seed"
    targetNamespace="https://etzhayyim.ai/bpmn/science"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="science_kami_seed_scientific" name="science kami seed scientific" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.science.kamiSeedScientific", "version": 1, "resultTimeoutMs": 21600000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="every 6 hours">
      <bpmn:outgoing>Flow_ToSeeds</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_PT6H">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT6H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToSeeds" sourceRef="Start" targetRef="Task_SeedElements"/>

    <!-- Step 1: Seed CPK sphere instances for 118 elements. -->
    <bpmn:serviceTask id="Task_SeedElements" name="seed element CPK sphere kami instances">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="science.kami.seedElementInstances"/>
        <zeebe:ioMapping>
          <zeebe:input source="=118"    target="max_elements"/>
          <zeebe:input source="=35.6812" target="anchor_lat"/>
          <zeebe:input source="=139.7671" target="anchor_lng"/>
          <zeebe:output source="=elementCount"    target="elementCount"/>
          <zeebe:output source="=instancesSeeded" target="elementInstancesSeeded"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSeeds</bpmn:incoming>
      <bpmn:outgoing>Flow_ToVeg</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToVeg" sourceRef="Task_SeedElements" targetRef="Task_SeedVegetation"/>

    <!-- Step 2: Seed procedural vegetation kami instances for known taxa. -->
    <bpmn:serviceTask id="Task_SeedVegetation" name="seed vegetation procedural kami instances">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="science.kami.seedVegetationInstances"/>
        <zeebe:ioMapping>
          <zeebe:input source="=35.6812"  target="anchor_lat"/>
          <zeebe:input source="=139.7671" target="anchor_lng"/>
          <zeebe:output source="=taxonCount"      target="taxonCount"/>
          <zeebe:output source="=instancesSeeded" target="vegInstancesSeeded"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToVeg</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_SeedVegetation" targetRef="Task_Audit"/>

    <!-- Step 3: OCEL audit event. -->
    <bpmn:serviceTask id="Task_Audit" name="emit science.kami.seed OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.science.kamiSeedScientific&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;elementCount&quot;: elementCount, &quot;elementInstancesSeeded&quot;: elementInstancesSeeded, &quot;taxonCount&quot;: taxonCount, &quot;vegInstancesSeeded&quot;: vegInstancesSeeded }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
