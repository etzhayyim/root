<?xml version="1.0" encoding="UTF-8"?>
<!--
  ADR-0055 — datacenter_access_review.

  Contractor / visitor / vendor physical access workflow with Tier 3
  visitor PII split and explicit security approval.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_datacenter_access_review"
    targetNamespace="https://etzhayyim.ai/bpmn/datacenter"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="datacenter_access_review" name="データセンター物理アクセス審査" isExecutable="true">

    <bpmn:startEvent id="Start" name="アクセス申請開始">
      <bpmn:outgoing>Flow_S</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_AccessForm"/>

    <bpmn:userTask id="Task_AccessForm" name="アクセス申請フォーム入力">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:datacenter-access-request-v1"/>
        <zeebe:assignmentDefinition candidateGroups="dc-requester"/>
        <zeebe:taskSchedule dueDate="=now() + duration(&quot;P3D&quot;)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming>
      <bpmn:incoming>Flow_LoopBack</bpmn:incoming>
      <bpmn:outgoing>Flow_F1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_F1" sourceRef="Task_AccessForm" targetRef="Task_PersistAccessPii"/>

    <bpmn:serviceTask id="Task_PersistAccessPii" name="Tier 3 来訪者情報を記録">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_datacenter_access_request_pii&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:           requestId,
              facility_id:         facilityId,
              visitor_payload:     string(visitorPayload),
              employer_payload:    string(employerPayload),
              badge_payload:       string(badgePayload),
              safety_payload:      string(safetyPayload),
              retention_until:     string(now() + duration(&quot;P730D&quot;)),
              created_at:          string(now()),
              owner_did:           requesterDid,
              sensitivity_ord:     3,
              org_id:              orgId,
              user_id:             requesterDid,
              actor_id:            &quot;sys.bpmn.datacenter.access&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F1</bpmn:incoming>
      <bpmn:outgoing>Flow_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F2" sourceRef="Task_PersistAccessPii" targetRef="Task_PersistAccessMeta"/>

    <bpmn:serviceTask id="Task_PersistAccessMeta" name="Tier 1 アクセスメタデータを記録">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_datacenter_access_request&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:           requestId,
              facility_id:         facilityId,
              sponsor_did:         requesterDid,
              employer_org_id:     employerOrgId,
              purpose:             string(accessMeta.purpose),
              access_scope:        string(accessMeta.accessScope),
              escort_required:     boolean(accessMeta.escortRequired),
              visit_start:         string(accessMeta.visitStart),
              visit_end:           string(accessMeta.visitEnd),
              status:              &quot;submitted&quot;,
              declaration_hash:    string(accessMeta.declarationHash),
              created_at:          string(now()),
              owner_did:           requesterDid,
              sensitivity_ord:     1,
              org_id:              orgId,
              user_id:             requesterDid,
              actor_id:            &quot;sys.bpmn.datacenter.access&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F2</bpmn:incoming>
      <bpmn:outgoing>Flow_F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F3" sourceRef="Task_PersistAccessMeta" targetRef="Task_SecurityReview"/>

    <bpmn:userTask id="Task_SecurityReview" name="物理アクセス審査">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:datacenter-access-review-v1"/>
        <zeebe:assignmentDefinition candidateGroups="dc-security"/>
        <zeebe:taskSchedule dueDate="=now() + duration(&quot;P2D&quot;)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F3</bpmn:incoming>
      <bpmn:outgoing>Flow_F4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_F4" sourceRef="Task_SecurityReview" targetRef="Gate_Approved"/>

    <bpmn:exclusiveGateway id="Gate_Approved" name="承認?" default="Flow_Reject">
      <bpmn:incoming>Flow_F4</bpmn:incoming>
      <bpmn:outgoing>Flow_Approve</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Approve" sourceRef="Gate_Approved" targetRef="Task_MarkApproved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=review.decision = "approve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Reject" sourceRef="Gate_Approved" targetRef="Task_MarkRejected"/>

    <bpmn:serviceTask id="Task_MarkApproved" name="承認状態に更新">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_datacenter_access_request&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:           requestId,
              facility_id:         facilityId,
              sponsor_did:         requesterDid,
              employer_org_id:     employerOrgId,
              purpose:             string(accessMeta.purpose),
              access_scope:        string(accessMeta.accessScope),
              escort_required:     boolean(accessMeta.escortRequired),
              visit_start:         string(accessMeta.visitStart),
              visit_end:           string(accessMeta.visitEnd),
              status:              &quot;approved&quot;,
              declaration_hash:    string(accessMeta.declarationHash),
              badge_id:            string(review.badgeId),
              approved_at:         string(now()),
              approved_by_did:     string(reviewerDid),
              created_at:          string(now()),
              owner_did:           requesterDid,
              sensitivity_ord:     1,
              org_id:              orgId,
              user_id:             requesterDid,
              actor_id:            &quot;sys.bpmn.datacenter.access&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;replace&quot;" target="onConflict"/>
          <zeebe:output source="=&quot;approved&quot;" target="finalStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_AuditApproved</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AuditApproved" sourceRef="Task_MarkApproved" targetRef="Task_AuditApproved"/>

    <bpmn:serviceTask id="Task_AuditApproved" name="audit: access approved">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:infra.etzhayyim.com:datacenter&quot;" target="actor"/>
          <zeebe:input source="=&quot;datacenter.access.approved&quot;" target="action"/>
          <zeebe:input source="={
              requestId:       requestId,
              facilityId:      facilityId,
              accessScope:     string(accessMeta.accessScope),
              escortRequired:  boolean(accessMeta.escortRequired)
          }" target="payload"/>
          <zeebe:output source="=rkey" target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AuditApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_EndApproved</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndApproved" sourceRef="Task_AuditApproved" targetRef="End_Approved"/>

    <bpmn:serviceTask id="Task_MarkRejected" name="却下状態に更新">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_datacenter_access_request&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:           requestId,
              facility_id:         facilityId,
              sponsor_did:         requesterDid,
              employer_org_id:     employerOrgId,
              purpose:             string(accessMeta.purpose),
              access_scope:        string(accessMeta.accessScope),
              escort_required:     boolean(accessMeta.escortRequired),
              visit_start:         string(accessMeta.visitStart),
              visit_end:           string(accessMeta.visitEnd),
              status:              &quot;rejected&quot;,
              declaration_hash:    string(accessMeta.declarationHash),
              review_comment:      string(review.comment),
              reviewed_at:         string(now()),
              created_at:          string(now()),
              owner_did:           requesterDid,
              sensitivity_ord:     1,
              org_id:              orgId,
              user_id:             requesterDid,
              actor_id:            &quot;sys.bpmn.datacenter.access&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;replace&quot;" target="onConflict"/>
          <zeebe:output source="=&quot;rejected&quot;" target="finalStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_AuditRejected</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AuditRejected" sourceRef="Task_MarkRejected" targetRef="Task_AuditRejected"/>

    <bpmn:serviceTask id="Task_AuditRejected" name="audit: access rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:infra.etzhayyim.com:datacenter&quot;" target="actor"/>
          <zeebe:input source="=&quot;datacenter.access.rejected&quot;" target="action"/>
          <zeebe:input source="={
              requestId:   requestId,
              facilityId:  facilityId,
              comment:     string(review.comment)
          }" target="payload"/>
          <zeebe:output source="=rkey" target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AuditRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_LoopBack</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_LoopBack" sourceRef="Task_AuditRejected" targetRef="Task_AccessForm"/>

    <bpmn:endEvent id="End_Approved" name="アクセス承認完了">
      <bpmn:incoming>Flow_EndApproved</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
