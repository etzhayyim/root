<?xml version="1.0" encoding="UTF-8"?>
<!--
  ADR-0055 — datacenter_purge_access_pii.

  Purge expired Tier 3 visitor/badge payloads while preserving Tier 1 audit chain.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_datacenter_purge_access_pii"
    targetNamespace="https://etzhayyim.ai/bpmn/datacenter"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="datacenter_purge_access_pii" name="データセンターアクセスPII purge" isExecutable="true">

    <bpmn:startEvent id="StartTimer" name="04:10 daily">
      <bpmn:outgoing>Flow_T</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 10 4 * * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_T" sourceRef="StartTimer" targetRef="Task_FindExpired"/>

    <bpmn:startEvent id="StartManual" name="manual purge">
      <bpmn:outgoing>Flow_M</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_M" sourceRef="StartManual" targetRef="Task_FindExpired"/>

    <bpmn:serviceTask id="Task_FindExpired" name="期限切れアクセスPIIを検索">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_datacenter_access_request_pii&quot;" target="table"/>
          <zeebe:input source="=&quot;retention_until &lt; %s&quot;" target="whereExpr"/>
          <zeebe:input source="=[string(now())]" target="whereParams"/>
          <zeebe:input source="=&quot;vertex_id, facility_id&quot;" target="columns"/>
          <zeebe:input source="=200" target="limit"/>
          <zeebe:output source="=rows" target="expiredRows"/>
          <zeebe:output source="=rowCount" target="purgedCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_T</bpmn:incoming>
      <bpmn:incoming>Flow_M</bpmn:incoming>
      <bpmn:outgoing>Flow_F1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F1" sourceRef="Task_FindExpired" targetRef="Gate_HasRows"/>

    <bpmn:exclusiveGateway id="Gate_HasRows" name="対象あり?" default="Flow_NoRows">
      <bpmn:incoming>Flow_F1</bpmn:incoming>
      <bpmn:outgoing>Flow_HasRows</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoRows</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_HasRows" sourceRef="Gate_HasRows" targetRef="Task_PurgeBatch">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=purgedCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoRows" sourceRef="Gate_HasRows" targetRef="Task_AuditNoop"/>

    <bpmn:serviceTask id="Task_PurgeBatch" name="Tier 3 アクセスPIIを purge">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.purgeDatacenterAccessPii"/>
        <zeebe:ioMapping>
          <zeebe:input source="=expiredRows" target="rows"/>
          <zeebe:output source="=deleted" target="deletedCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HasRows</bpmn:incoming>
      <bpmn:outgoing>Flow_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F2" sourceRef="Task_PurgeBatch" targetRef="Task_AuditPurged"/>

    <bpmn:serviceTask id="Task_AuditPurged" name="audit: access purged">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:infra.etzhayyim.com:datacenter&quot;" target="actor"/>
          <zeebe:input source="=&quot;datacenter.access.purge&quot;" target="action"/>
          <zeebe:input source="={
              purgedCount:  purgedCount,
              deletedCount: deletedCount
          }" target="payload"/>
          <zeebe:output source="=rkey" target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F2</bpmn:incoming>
      <bpmn:outgoing>Flow_EndPurged</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndPurged" sourceRef="Task_AuditPurged" targetRef="End"/>

    <bpmn:serviceTask id="Task_AuditNoop" name="audit: purge noop">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:infra.etzhayyim.com:datacenter&quot;" target="actor"/>
          <zeebe:input source="=&quot;datacenter.access.purge.noop&quot;" target="action"/>
          <zeebe:input source="={ purgedCount: 0 }" target="payload"/>
          <zeebe:output source="=rkey" target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoRows</bpmn:incoming>
      <bpmn:outgoing>Flow_EndNoop</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndNoop" sourceRef="Task_AuditNoop" targetRef="End"/>

    <bpmn:endEvent id="End" name="完了">
      <bpmn:incoming>Flow_EndPurged</bpmn:incoming>
      <bpmn:incoming>Flow_EndNoop</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
