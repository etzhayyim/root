<?xml version="1.0" encoding="UTF-8"?>
<!--
  ADR-0055 — datacenter_reserve_capacity.

  Rack / power / cooling capacity reservation workflow.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_datacenter_reserve_capacity"
    targetNamespace="https://etzhayyim.ai/bpmn/datacenter"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="datacenter_reserve_capacity" name="データセンター容量予約" isExecutable="true">

    <bpmn:startEvent id="Start" name="容量予約開始">
      <bpmn:outgoing>Flow_S</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_CapacityForm"/>

    <bpmn:userTask id="Task_CapacityForm" name="容量予約フォーム入力">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:datacenter-capacity-request-v1"/>
        <zeebe:assignmentDefinition candidateGroups="dc-planner"/>
        <zeebe:taskSchedule dueDate="=now() + duration(&quot;P5D&quot;)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming>
      <bpmn:incoming>Flow_LoopBack</bpmn:incoming>
      <bpmn:outgoing>Flow_F1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_F1" sourceRef="Task_CapacityForm" targetRef="Task_LoadFacilityPressure"/>

    <bpmn:serviceTask id="Task_LoadFacilityPressure" name="現行容量状況を取得">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;mv_datacenter_capacity_reserved&quot;" target="table"/>
          <zeebe:input source="=&quot;facility_id = %s&quot;" target="whereExpr"/>
          <zeebe:input source="=[facilityId]" target="whereParams"/>
          <zeebe:input source="=&quot;facility_id, reserved_rack_units, reserved_power_kw, reserved_cooling_kw&quot;" target="columns"/>
          <zeebe:input source="=1" target="limit"/>
          <zeebe:output source="=rows" target="capacityRows"/>
          <zeebe:output source="=rowCount" target="capacityCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F1</bpmn:incoming>
      <bpmn:outgoing>Flow_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F2" sourceRef="Task_LoadFacilityPressure" targetRef="Task_ReviewCapacity"/>

    <bpmn:userTask id="Task_ReviewCapacity" name="容量審査">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:datacenter-capacity-review-v1"/>
        <zeebe:assignmentDefinition candidateGroups="dc-capacity-manager"/>
        <zeebe:taskSchedule dueDate="=now() + duration(&quot;P3D&quot;)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F2</bpmn:incoming>
      <bpmn:outgoing>Flow_F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_F3" sourceRef="Task_ReviewCapacity" targetRef="Gate_Approved"/>

    <bpmn:exclusiveGateway id="Gate_Approved" name="承認?" default="Flow_Reject">
      <bpmn:incoming>Flow_F3</bpmn:incoming>
      <bpmn:outgoing>Flow_Approve</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Approve" sourceRef="Gate_Approved" targetRef="Task_PersistReservation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=review.decision = "approve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Reject" sourceRef="Gate_Approved" targetRef="Task_AuditRejected"/>

    <bpmn:serviceTask id="Task_PersistReservation" name="容量予約を記録">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_datacenter_capacity_reservation&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:              requestId,
              facility_id:            facilityId,
              requester_did:          requesterDid,
              reservation_type:       string(capacityRequest.reservationType),
              rack_units:             number(capacityRequest.rackUnits),
              power_kw:               number(capacityRequest.powerKw),
              cooling_kw:             number(capacityRequest.coolingKw),
              reservation_start:      string(capacityRequest.reservationStart),
              reservation_end:        string(capacityRequest.reservationEnd),
              status:                 &quot;approved&quot;,
              approved_at:            string(now()),
              approved_by_did:        string(reviewerDid),
              created_at:             string(now()),
              owner_did:              requesterDid,
              sensitivity_ord:        1,
              org_id:                 orgId,
              user_id:                requesterDid,
              actor_id:               &quot;sys.bpmn.datacenter.capacity&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;replace&quot;" target="onConflict"/>
          <zeebe:output source="=&quot;approved&quot;" target="finalStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_AuditApproved</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AuditApproved" sourceRef="Task_PersistReservation" targetRef="Task_AuditApproved"/>

    <bpmn:serviceTask id="Task_AuditApproved" name="audit: capacity approved">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:infra.etzhayyim.com:datacenter&quot;" target="actor"/>
          <zeebe:input source="=&quot;datacenter.capacity.approved&quot;" target="action"/>
          <zeebe:input source="={
              requestId:         requestId,
              facilityId:        facilityId,
              reservationType:   string(capacityRequest.reservationType),
              rackUnits:         number(capacityRequest.rackUnits),
              powerKw:           number(capacityRequest.powerKw),
              coolingKw:         number(capacityRequest.coolingKw)
          }" target="payload"/>
          <zeebe:output source="=rkey" target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AuditApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_EndApproved</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndApproved" sourceRef="Task_AuditApproved" targetRef="End_Approved"/>

    <bpmn:serviceTask id="Task_AuditRejected" name="audit: capacity rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:infra.etzhayyim.com:datacenter&quot;" target="actor"/>
          <zeebe:input source="=&quot;datacenter.capacity.rejected&quot;" target="action"/>
          <zeebe:input source="={
              requestId:   requestId,
              facilityId:  facilityId,
              comment:     string(review.comment)
          }" target="payload"/>
          <zeebe:output source="=rkey" target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_LoopBack</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_LoopBack" sourceRef="Task_AuditRejected" targetRef="Task_CapacityForm"/>

    <bpmn:endEvent id="End_Approved" name="容量予約完了">
      <bpmn:incoming>Flow_EndApproved</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
