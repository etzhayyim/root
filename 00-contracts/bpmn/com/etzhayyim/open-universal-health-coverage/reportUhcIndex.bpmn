<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_universal_health_coverage_report_uhc_index" targetNamespace="https://etzhayyim.ai/bpmn/open-universal-health-coverage" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_universal_health_coverage_report_uhc_index" name="reportUhcIndex" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_universal_health_coverage&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, report_id: reportId, country_iso3: countryIso3, score_value: scoreValue, financial_protection_score: financialProtectionScore, catastrophic_expenditure_pct: catastrophicExpenditurePct, reported_year: reportedYear, reported_at: reportedAt, coverage_tier: if scoreValue &gt;= 80 then &quot;advanced&quot; else if scoreValue &gt;= 60 then &quot;developed&quot; else if scoreValue &gt;= 40 then &quot;progressing&quot; else &quot;foundational&quot;, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-universal-health-coverage&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-universal-health-coverage.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;open.universalHealthCoverage.reportUhcIndex&quot;" target="action"/><zeebe:input source="={vertexId: vertexId}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>