<?xml version="1.0" encoding="UTF-8"?>
<!--
  scheduleInspection — XRPC com.etzhayyim.apps.nogu.scheduleInspection で起動。
  対象農具の次回点検日を設定し inspection レコードを DB 予約、audit emit。

  Inputs:
    itemId
    inspectionType   (pre-season | annual | statutory | spot)
    scheduledDate
    inspectorDid
-->
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_nogu_schedule_inspection"
  targetNamespace="https://etzhayyim.ai/bpmn/nogu"
  exporter="hand-written"
  exporterVersion="1.0">
  <bpmn:process id="nogu_schedule_inspection" name="nogu Schedule Inspection" isExecutable="true">

    <bpmn:startEvent id="Start" name="inspection scheduled">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_FetchItem"/>

    <bpmn:serviceTask id="Task_FetchItem" name="fetch item record">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_nogu_item&quot;" target="table"/>
          <zeebe:input source="=&quot;item_id = %s&quot;" target="whereExpr"/>
          <zeebe:input source="=[itemId]" target="whereParams"/>
          <zeebe:input source="=&quot;item_id, name, status, owner_did&quot;" target="columns"/>
          <zeebe:input source="=1" target="limit"/>
          <zeebe:output source="=rows" target="itemRows"/>
          <zeebe:output source="=rowCount" target="itemFound"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_FetchItem" targetRef="Gate_Found"/>

    <bpmn:exclusiveGateway id="Gate_Found" name="item found?" default="Flow_NotFound">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Found</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotFound</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Found" sourceRef="Gate_Found" targetRef="Task_UpdateNextDate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=itemFound > 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotFound" sourceRef="Gate_Found" targetRef="Task_AuditNotFound"/>

    <bpmn:serviceTask id="Task_UpdateNextDate" name="update next inspection date">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_nogu_item&quot;" target="table"/>
          <zeebe:input source="={ item_id: itemId, next_inspection_date: scheduledDate }" target="row"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Found</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_UpdateNextDate" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="emit schedule audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:nogu.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;inspectionScheduled&quot;" target="action"/>
          <zeebe:input source="={ itemId: itemId, inspectionType: inspectionType, scheduledDate: scheduledDate, inspectorDid: inspectorDid }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:serviceTask id="Task_AuditNotFound" name="emit item-not-found audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:nogu.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;inspectionScheduleError&quot;" target="action"/>
          <zeebe:input source="={ itemId: itemId, error: &quot;item not found&quot; }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NotFound</bpmn:incoming>
      <bpmn:outgoing>Flow_ErrEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ErrEnd" sourceRef="Task_AuditNotFound" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_End</bpmn:incoming>
      <bpmn:incoming>Flow_ErrEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
