<?xml version="1.0" encoding="UTF-8"?>
<!--
  nogu daily pulse — 毎日 00:30 に農具在庫・点検期限を集計し audit emit。
  過期点検アイテム (nextInspectionDate <= TODAY) があれば alertOverdue audit を追加出力。
-->
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_nogu_daily_pulse"
  targetNamespace="https://etzhayyim.ai/bpmn/nogu"
  exporter="hand-written"
  exporterVersion="1.0">
  <bpmn:process id="nogu_daily_pulse" name="nogu Daily Pulse" isExecutable="true">

    <bpmn:startEvent id="Start" name="daily pulse">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 30 0 * * *</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_CountItems"/>

    <bpmn:serviceTask id="Task_CountItems" name="count active items">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_nogu_item&quot;" target="table"/>
          <zeebe:input source="=&quot;status != %s&quot;" target="whereExpr"/>
          <zeebe:input source="=[&quot;retired&quot;]" target="whereParams"/>
          <zeebe:input source="=&quot;status, count(*) as cnt&quot;" target="columns"/>
          <zeebe:input source="=10" target="limit"/>
          <zeebe:output source="=rows" target="itemStatusRows"/>
          <zeebe:output source="=rowCount" target="itemStatusCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CountItems" targetRef="Task_CheckOverdue"/>

    <bpmn:serviceTask id="Task_CheckOverdue" name="find overdue inspections">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_nogu_item&quot;" target="table"/>
          <zeebe:input source="=&quot;status = %s AND next_inspection_date &lt;= CURRENT_DATE&quot;" target="whereExpr"/>
          <zeebe:input source="=[&quot;active&quot;]" target="whereParams"/>
          <zeebe:input source="=&quot;item_id, name, owner_did, next_inspection_date&quot;" target="columns"/>
          <zeebe:input source="=50" target="limit"/>
          <zeebe:output source="=rows" target="overdueRows"/>
          <zeebe:output source="=rowCount" target="overdueCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_CheckOverdue" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="emit daily audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:nogu.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;dailyPulse&quot;" target="action"/>
          <zeebe:input source="={ itemStatusRows: itemStatusRows, overdueCount: overdueCount, bpmnProcessId: &quot;nogu_daily_pulse&quot; }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Gate" sourceRef="Task_Audit" targetRef="Gate_Overdue"/>

    <bpmn:exclusiveGateway id="Gate_Overdue" name="overdue items?" default="Flow_NoOverdue">
      <bpmn:incoming>Flow_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Overdue</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoOverdue</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Overdue" sourceRef="Gate_Overdue" targetRef="Task_AlertOverdue">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=overdueCount > 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoOverdue" sourceRef="Gate_Overdue" targetRef="End"/>

    <bpmn:serviceTask id="Task_AlertOverdue" name="emit overdue alert">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:nogu.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;inspectionOverdueAlert&quot;" target="action"/>
          <zeebe:input source="={ overdueCount: overdueCount, overdueRows: overdueRows }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Overdue</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_AlertOverdue" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_NoOverdue</bpmn:incoming>
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
