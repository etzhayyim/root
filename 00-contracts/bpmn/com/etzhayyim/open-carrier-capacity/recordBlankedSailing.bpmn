<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_carrier_capacity_blanked" targetNamespace="https://etzhayyim.ai/bpmn/open-carrier-capacity" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_carrier_capacity_blanked" name="Blanked sailing" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="blanked">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_carrier_capacity_blanked&quot;" target="table"/>
          <zeebe:input source="={vertex_id: vertexId, blanked_id: blankedId, carrier_code: carrierCode, string_code: stringCode, skipped_weeks: skippedWeeks, teu_removed_total: teuRemovedTotal, reason: reason, impact_tier: if skippedWeeks &gt;= 4 or (teuRemovedTotal != null and teuRemovedTotal &gt;= 100000) then &quot;major&quot; else if skippedWeeks &gt;= 2 then &quot;moderate&quot; else &quot;minor&quot;, require_shipper_notice: skippedWeeks &gt;= 2, effective_from: effectiveFrom, effective_until: effectiveUntil, status: &quot;announced&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-carrier-capacity&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-carrier-capacity.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openCarrierCapacity.blanked.record&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, blankedId: blankedId, carrierCode: carrierCode, skippedWeeks: skippedWeeks}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
