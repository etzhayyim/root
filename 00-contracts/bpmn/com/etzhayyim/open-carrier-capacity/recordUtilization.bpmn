<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_carrier_capacity_utilization" targetNamespace="https://etzhayyim.ai/bpmn/open-carrier-capacity" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_carrier_capacity_utilization" name="Utilization" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="utilization">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_carrier_capacity_utilization&quot;" target="table"/>
          <zeebe:input source="={vertex_id: vertexId, util_id: utilId, carrier_code: carrierCode, trade_lane: tradeLane, period_week: periodWeek, teu_offered: teuOffered, teu_lifted: teuLifted, utilization_pct: if teuOffered = 0 then 0 else (teuLifted / teuOffered) * 100, saturation_tier: if teuOffered = 0 then &quot;undersubscribed&quot; else if (teuLifted / teuOffered) * 100 &gt;= 95 then &quot;saturated&quot; else if (teuLifted / teuOffered) * 100 &gt;= 85 then &quot;tight&quot; else if (teuLifted / teuOffered) * 100 &gt;= 70 then &quot;balanced&quot; else &quot;undersubscribed&quot;, reported_at: reportedAt, status: &quot;published&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-carrier-capacity&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-carrier-capacity.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openCarrierCapacity.utilization.record&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, utilId: utilId, tradeLane: tradeLane, teuOffered: teuOffered, teuLifted: teuLifted}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
