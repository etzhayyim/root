<?xml version="1.0" encoding="UTF-8"?>
<!--
  gameka.proposeGame — XRPC-triggered LangGraph deliberation that lands
  one vertex_gameka_spec row per call (ADR 2604250900 P1).

  Pipeline (ADR-0056 generic primitives + LangGraph wrapper):
    Start (XRPC com.etzhayyim.apps.gameka.proposeGame)
      → Task_Deliberate    com.etzhayyim.agent.gameka.studio    (LangGraph 5-node)
      → Task_BuildRkey     scriptTask FEEL                 ("spec" + epoch ms)
      → Task_BuildCreatedAt scriptTask FEEL                ("now()" ISO)
      → Task_BuildVertexId scriptTask FEEL                 (at:// uri)
      → Task_PersistSpec   generic.db.insert vertex_gameka_spec
      → Task_Audit         generic.audit.emit gameka.spec.proposed
      → End

  P1 simplifications (deferred to P2/P3 per ADR §Migration):
    - Task_LoadMemory     generic.db.select vertex_gameka_spec (last 10)
                          deferred — proposeGame currently passes priorSpecs=[]
                          via input schema and the LangGraph dedupe is a no-op.
    - Task_ConsentGate    deferred — Path F consent middleware not wired yet.
    - Task_DeriveGenerate generic.pds.dispatch generateGame
                          deferred until generateGame.bpmn lands (P2).

  Task_Deliberate task type:
    Currently `com.etzhayyim.agent.gameka.studio` (mirrors com.etzhayyim.agent.plan
    pattern). When generic.langgraph.run lands per ADR 2604250836 step 2,
    swap to:
        <zeebe:taskDefinition type="generic.langgraph.run"/>
        ioMapping inputs: graph_id="gameka.studio.v1" + state={...} + mode="oneshot"

  NSID: com.etzhayyim.apps.gameka.proposeGame (XRPC procedure)
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/gameka-propose-game-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_gameka_propose_game"
    targetNamespace="https://etzhayyim.ai/bpmn/gameka"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="gameka_propose_game" name="gameka proposeGame" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.gameka.proposeGame", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="XRPC proposeGame">
      <bpmn:outgoing>Flow_ToDeliberate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToDeliberate" sourceRef="Start" targetRef="Task_Deliberate"/>

    <!-- Step 1: LangGraph deliberation. P1 transitional task type
         com.etzhayyim.agent.gameka.studio (see file header for migration path
         to generic.langgraph.run). 50s budget allows up to 3 inner
         iterations × 2 LLM calls each at Murakumo p95 (~7s/call). -->
    <bpmn:serviceTask id="Task_Deliberate" name="LangGraph deliberate (5-node)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.agent.gameka.studio" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=brief"                   target="brief"/>
          <zeebe:input source="=if priorSpecs = null then [] else priorSpecs"  target="priorSpecs"/>
          <zeebe:input source="=if iteration = null then 0 else iteration"     target="iteration"/>
          <zeebe:input source="=3"                         target="maxIterations"/>
          <zeebe:input source="=0.8"                       target="scoreThreshold"/>
          <zeebe:input source="=string(processInstanceKey)" target="threadId"/>
          <zeebe:output source="=specId"                   target="specId"/>
          <zeebe:output source="=title"                    target="title"/>
          <zeebe:output source="=slug"                     target="slug"/>
          <zeebe:output source="=genre"                    target="genre"/>
          <zeebe:output source="=mechanicJson"             target="mechanicJson"/>
          <zeebe:output source="=sceneJson"                target="sceneJson"/>
          <zeebe:output source="=budgetUsd"                target="budgetUsd"/>
          <zeebe:output source="=score"                    target="score"/>
          <zeebe:output source="=rationale"                target="rationale"/>
          <zeebe:output source="=iterations"               target="iterations"/>
          <zeebe:output source="=modelId"                  target="modelId"/>
          <zeebe:output source="=deliberateLatencyMs"      target="deliberateLatencyMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDeliberate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRkey</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToRkey" sourceRef="Task_Deliberate" targetRef="Task_BuildRkey"/>

    <!-- Step 2a: rkey = specId (already ULID-shape from finalizer). -->
    <bpmn:scriptTask id="Task_BuildRkey" name="rkey from specId">
      <bpmn:extensionElements>
        <zeebe:script
            expression='=specId'
            resultVariable="specRkey"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRkey</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCreatedAt</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ToCreatedAt" sourceRef="Task_BuildRkey" targetRef="Task_BuildCreatedAt"/>

    <!-- Step 2b: createdAt ISO. -->
    <bpmn:scriptTask id="Task_BuildCreatedAt" name="createdAt ISO">
      <bpmn:extensionElements>
        <zeebe:script
            expression='=string(now())'
            resultVariable="specCreatedAt"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCreatedAt</bpmn:incoming>
      <bpmn:outgoing>Flow_ToVid</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ToVid" sourceRef="Task_BuildCreatedAt" targetRef="Task_BuildVertexId"/>

    <!-- Step 2c: vertex_id = at://did:web:gameka.etzhayyim.com/com.etzhayyim.apps.gameka.gameSpec/{rkey} -->
    <bpmn:scriptTask id="Task_BuildVertexId" name="at:// vertex_id">
      <bpmn:extensionElements>
        <zeebe:script
            expression='=string join(["at://did:web:gameka.etzhayyim.com/com.etzhayyim.apps.gameka.gameSpec/", specRkey], "")'
            resultVariable="specVertexId"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToVid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToInsert</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ToInsert" sourceRef="Task_BuildVertexId" targetRef="Task_PersistSpec"/>

    <!-- Step 3: persist via generic.db.insert. ADR-0036 worker-direct
         Hyperdrive write path; no PDS commit. The graph-worker consumer
         that lands social derive runs on `app.bsky.feed.post` writes,
         not on this domain table — explicit social post is deferred to
         publishGame.bpmn (P4). -->
    <bpmn:serviceTask id="Task_PersistSpec" name="insert vertex_gameka_spec">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_gameka_spec&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id: specVertexId,
              owner_did: &quot;did:web:gameka.etzhayyim.com&quot;,
              rkey: specRkey,
              repo: &quot;did:web:gameka.etzhayyim.com&quot;,
              spec_id: specId,
              brief: brief,
              title: title,
              slug: slug,
              genre: genre,
              mechanic_json: mechanicJson,
              scene_json: sceneJson,
              budget_usd: budgetUsd,
              score: score,
              rationale: rationale,
              iteration: iterations,
              lineage_parent: if lineageParent = null then &quot;&quot; else lineageParent,
              model_id: modelId,
              created_at: specCreatedAt
          }" target="values"/>
          <zeebe:input source="=&quot;raise&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToInsert</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_PersistSpec" targetRef="Task_Audit"/>

    <!-- Step 4: OCEL audit emit. -->
    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:gameka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;gameka.spec.proposed&quot;"   target="action"/>
          <zeebe:input source="={
              specId: specId,
              slug: slug,
              score: score,
              iterations: iterations,
              modelId: modelId,
              deliberateLatencyMs: deliberateLatencyMs
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
