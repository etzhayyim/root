<?xml version="1.0" encoding="UTF-8"?>
<!--
  gameka.playtestGame — visual + perf QA loop. Closes the inner ideate
  loop: pass → derive publishGame, fail → derive proposeGame (revise)
  with structured priorSpecs[*].issues so the LangGraph studio's planner
  avoids the same trap on the next iteration. After MAX_ITERATION (3)
  the outcome flips to "exhausted" and the chain stops without publish.

  Pipeline (ADR 2604250900 P4):
    Start (XRPC com.etzhayyim.apps.gameka.playtestGame { specId, iteration })
      → Task_LoadArtifact   generic.db.select latest -built row by spec_id
      → Task_LoadSpec       generic.db.select scene description + genre
      → Task_OpenSession    generic.pds.dispatch com.etzhayyim.apps.playwright.sessionOpen
                            (target=local, viewport 1280x720)
      → Task_Goto           generic.pds.dispatch com.etzhayyim.apps.playwright.goto wasmUrl
      → Task_ProbeMetrics   generic.pds.dispatch com.etzhayyim.apps.playwright.evaluate
                            (in-page rAF probe → { fpsP50, fpsP95, sceneLoadMs,
                              consoleErrorCount }, runs ~5 seconds)
      → Task_Snap1          generic.pds.dispatch com.etzhayyim.apps.playwright.screenshot @ t=1s
      → Task_Snap2          generic.pds.dispatch com.etzhayyim.apps.playwright.screenshot @ t=3s
      → Task_Snap3          generic.pds.dispatch com.etzhayyim.apps.playwright.screenshot @ t=5s
      → Task_CloseSession   generic.pds.dispatch com.etzhayyim.apps.playwright.sessionClose
      → Task_VisualCritic   com.etzhayyim.agent.gameka.visualCritic (LangGraph 3-node)
      → Task_BuildQaRkey    scriptTask FEEL ("qa" + epoch ms)
      → Task_BuildQaCreatedAt scriptTask FEEL (now ISO)
      → Task_BuildQaVid     scriptTask FEEL (at:// vertex_id)
      → Task_PersistQa      generic.db.insert vertex_gameka_qa
      → Task_Audit          generic.audit.emit gameka.qa.{pass|revise|exhausted}
      → ExclusiveGateway    outcome ?
           "pass"      → Task_DerivePublish  generic.pds.dispatch publishGame
           "revise"    → Task_DeriveRevise   generic.pds.dispatch proposeGame
                                             (iteration+1, lineageParent=specId,
                                              priorSpecs=[{slug, title, score, issues}])
           "exhausted" → End (no derive — chain stops)

  NSID: com.etzhayyim.apps.gameka.playtestGame (XRPC procedure)
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/gameka-playtest-game-v1

  Notes:
   - Playwright session steps use generic.pds.dispatch, not generic.http.fetch,
     because the playwright actor exposes XRPC commands at
     com.etzhayyim.apps.playwright.* — same dispatch path used by every other
     cross-actor BPMN call in this repo.
   - Screenshots already upload to B2 inside playwright.screenshot;
     the QA row only stores the cid array. Vision LLM (when enabled)
     fetches by cid via the B2 presigner.
   - Console-error capture wires through evaluate() — the BPMN is the
     transport, the in-page JS is the sensor.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_gameka_playtest_game"
    targetNamespace="https://etzhayyim.ai/bpmn/gameka"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="gameka_playtest_game" name="gameka playtestGame" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.gameka.playtestGame", "version": 1, "resultTimeoutMs": 90000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="XRPC playtestGame">
      <bpmn:outgoing>Flow_ToLoadArtifact</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToLoadArtifact" sourceRef="Start" targetRef="Task_LoadArtifact"/>

    <!-- Step 1: load latest -built artifact for the spec. Event-sourced
         lookup: rows with -built suffix come after -sources in
         created_at, so ORDER BY created_at DESC + build_status='built'
         picks the most recent successful binary. -->
    <bpmn:serviceTask id="Task_LoadArtifact" name="load latest built artifact">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_gameka_artifact&quot;" target="table"/>
          <zeebe:input source="=&quot;artifact_id, spec_id, wasm_cid, wasm_url, js_url, build_status&quot;" target="columns"/>
          <zeebe:input source="=&quot;spec_id = %s AND build_status = %s&quot;" target="whereExpr"/>
          <zeebe:input source="=[specId, &quot;built&quot;]" target="whereParams"/>
          <zeebe:input source="=&quot;created_at DESC&quot;" target="orderBy"/>
          <zeebe:input source="=1" target="limit"/>
          <zeebe:output source="=rows[1].artifact_id" target="artifactId"/>
          <zeebe:output source="=rows[1].wasm_url"    target="wasmUrl"/>
          <zeebe:output source="=rows[1].js_url"      target="wasmJsUrl"/>
          <zeebe:output source="=rows[1].wasm_cid"    target="wasmCid"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToLoadArtifact</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLoadSpec</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToLoadSpec" sourceRef="Task_LoadArtifact" targetRef="Task_LoadSpec"/>

    <!-- Step 2: load spec for scene description + genre + title (input
         to the visual critic LangGraph). -->
    <bpmn:serviceTask id="Task_LoadSpec" name="load spec scene + genre">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_gameka_spec&quot;" target="table"/>
          <zeebe:input source="=&quot;title, slug, genre, scene_json, brief&quot;" target="columns"/>
          <zeebe:input source="=&quot;spec_id = %s&quot;" target="whereExpr"/>
          <zeebe:input source="=[specId]" target="whereParams"/>
          <zeebe:input source="=1" target="limit"/>
          <zeebe:output source="=rows[1].title"      target="specTitle"/>
          <zeebe:output source="=rows[1].slug"       target="specSlug"/>
          <zeebe:output source="=rows[1].genre"      target="specGenre"/>
          <zeebe:output source="=rows[1].scene_json" target="specSceneJson"/>
          <zeebe:output source="=rows[1].brief"      target="specBrief"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToLoadSpec</bpmn:incoming>
      <bpmn:outgoing>Flow_ToOpenSession</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToOpenSession" sourceRef="Task_LoadSpec" targetRef="Task_OpenSession"/>

    <!-- Step 3: open headless playwright session. target=local pins the
         session to a Linux runner with WebGPU enabled (Chromium 113+). -->
    <bpmn:serviceTask id="Task_OpenSession" name="playwright sessionOpen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.playwright.sessionOpen&quot;" target="nsid"/>
          <zeebe:input source="={
              target: &quot;local&quot;,
              viewport: { width: 1280, height: 720 }
          }" target="input"/>
          <zeebe:output source="=output.sessionId" target="ptSessionId"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToOpenSession</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGoto</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToGoto" sourceRef="Task_OpenSession" targetRef="Task_Goto"/>

    <!-- Step 4: navigate to the static playtest shell with all the
         loader inputs as query params. The shell at
         game-play.etzhayyim.com/__playtest__.html is a Workers Asset (no
         server logic) that:
           - reads ?w (wasmUrl) + ?j (jsUrl) + ?e (entryFn) + ?c (cid)
           - dynamic-imports the JS glue
           - calls init(wasmUrl) to override the default same-dir
             wasm fetch with the explicit presigned binary URL
           - calls window[entryFn]('canvas-id') to bootstrap kami-app
           - exposes window.__etzhayyimProbe(durationMs) for the rAF probe
         Slug → entryFn = "run_" + slug.replace("-", "_") (matches
         kami-codegen.entry_fn). Pre-P5 rows have empty js_url and the
         shell short-circuits to captureSucceeded=false. -->
    <bpmn:serviceTask id="Task_Goto" name="playwright goto playtest shell">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.playwright.goto&quot;" target="nsid"/>
          <zeebe:input source="={
              sessionId: ptSessionId,
              url: string join([
                  &quot;https://game-play.etzhayyim.com/__playtest__.html&quot;,
                  &quot;?c=&quot;, wasmCid,
                  &quot;&amp;w=&quot;, wasmUrl,
                  &quot;&amp;j=&quot;, if wasmJsUrl = null then &quot;&quot; else wasmJsUrl,
                  &quot;&amp;e=run_&quot;, replace(specSlug, &quot;-&quot;, &quot;_&quot;, &quot;s&quot;)
              ], &quot;&quot;),
              waitUntil: &quot;networkidle&quot;,
              timeout: 30000
          }" target="input"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToGoto</bpmn:incoming>
      <bpmn:outgoing>Flow_ToProbeMetrics</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToProbeMetrics" sourceRef="Task_Goto" targetRef="Task_ProbeMetrics"/>

    <!-- Step 5: in-page rAF probe (~5s). The shell page exposes
         window.__etzhayyimProbe(durationMs) which:
           - hooks console.error, increments a counter
           - samples performance.now() per rAF, computes p50/p95
           - records the time from goto to first non-blank canvas frame
           - returns { fpsP50, fpsP95, sceneLoadMs, consoleErrorCount }
         The evaluate lexicon is allowlist-restricted, so the shell
         exposes the exact API surface we need; no arbitrary JS. -->
    <bpmn:serviceTask id="Task_ProbeMetrics" name="evaluate __etzhayyimProbe(5000)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.playwright.evaluate&quot;" target="nsid"/>
          <zeebe:input source="={
              sessionId: ptSessionId,
              jsCode: &quot;return await window.__etzhayyimProbe(5000);&quot;
          }" target="input"/>
          <zeebe:output source="=output.value.fpsP50"            target="fpsP50"/>
          <zeebe:output source="=output.value.fpsP95"            target="fpsP95"/>
          <zeebe:output source="=output.value.sceneLoadMs"       target="sceneLoadMs"/>
          <zeebe:output source="=output.value.consoleErrorCount" target="consoleErrorCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToProbeMetrics</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSnap1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToSnap1" sourceRef="Task_ProbeMetrics" targetRef="Task_Snap1"/>

    <!-- Step 6a-c: 3 frames. The probe ran for ~5s already so the page
         is at steady state when the first snap fires. Capture order
         is sequential (BPMN sequenceFlow); we drop fullPage so each
         frame is exactly the viewport (1280x720). -->
    <bpmn:serviceTask id="Task_Snap1" name="screenshot frame 1 (post-probe)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.playwright.screenshot&quot;" target="nsid"/>
          <zeebe:input source="={ sessionId: ptSessionId, fullPage: false }" target="input"/>
          <zeebe:output source="=output.artifactCid" target="screenshotCid1"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSnap1</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSnap2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToSnap2" sourceRef="Task_Snap1" targetRef="Task_Wait1s"/>

    <!-- Half-second pause between frames so a moving camera / animated
         scene gives different content. FEEL has no sleep — we use the
         intermediate timer event. -->
    <bpmn:intermediateCatchEvent id="Task_Wait1s" name="wait 500ms">
      <bpmn:incoming>Flow_ToSnap2</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSnap2b</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT0.5S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_ToSnap2b" sourceRef="Task_Wait1s" targetRef="Task_Snap2"/>

    <bpmn:serviceTask id="Task_Snap2" name="screenshot frame 2">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.playwright.screenshot&quot;" target="nsid"/>
          <zeebe:input source="={ sessionId: ptSessionId, fullPage: false }" target="input"/>
          <zeebe:output source="=output.artifactCid" target="screenshotCid2"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSnap2b</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWait2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToWait2" sourceRef="Task_Snap2" targetRef="Task_Wait2s"/>

    <bpmn:intermediateCatchEvent id="Task_Wait2s" name="wait 500ms">
      <bpmn:incoming>Flow_ToWait2</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSnap3</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT0.5S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_ToSnap3" sourceRef="Task_Wait2s" targetRef="Task_Snap3"/>

    <bpmn:serviceTask id="Task_Snap3" name="screenshot frame 3">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.playwright.screenshot&quot;" target="nsid"/>
          <zeebe:input source="={ sessionId: ptSessionId, fullPage: false }" target="input"/>
          <zeebe:output source="=output.artifactCid" target="screenshotCid3"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSnap3</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCloseSession</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToCloseSession" sourceRef="Task_Snap3" targetRef="Task_CloseSession"/>

    <bpmn:serviceTask id="Task_CloseSession" name="playwright sessionClose">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.playwright.sessionClose&quot;" target="nsid"/>
          <zeebe:input source="={ sessionId: ptSessionId }" target="input"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCloseSession</bpmn:incoming>
      <bpmn:outgoing>Flow_ToVisualCritic</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToVisualCritic" sourceRef="Task_CloseSession" targetRef="Task_VisualCritic"/>

    <!-- Step 7: visual + perf critic LangGraph. 3 nodes (analyze_render
         → analyze_match → synthesize). 60s budget allows one vision-LLM
         call at p95 (~7s) + headroom. -->
    <bpmn:serviceTask id="Task_VisualCritic" name="visual + perf critic (LangGraph)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.agent.gameka.visualCritic" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=specId"            target="specId"/>
          <zeebe:input source="=artifactId"        target="artifactId"/>
          <zeebe:input source="=if iteration = null then 0 else iteration" target="iteration"/>
          <zeebe:input source="=specSceneJson"     target="sceneDescription"/>
          <zeebe:input source="=specGenre"         target="genre"/>
          <zeebe:input source="=specTitle"         target="title"/>
          <zeebe:input source="=specSlug"          target="slug"/>
          <zeebe:input source="=[screenshotCid1, screenshotCid2, screenshotCid3]" target="screenshotCids"/>
          <zeebe:input source="=[]"                target="screenshotUrls"/>
          <zeebe:input source="=if consoleErrorCount = null then 0 else consoleErrorCount" target="consoleErrorCount"/>
          <zeebe:input source="=if fpsP50 = null then 0 else fpsP50"     target="fpsP50"/>
          <zeebe:input source="=if fpsP95 = null then 0 else fpsP95"     target="fpsP95"/>
          <zeebe:input source="=if sceneLoadMs = null then 0 else sceneLoadMs" target="sceneLoadMs"/>
          <zeebe:input source="=true"              target="captureSucceeded"/>
          <zeebe:input source="=string(processInstanceKey)" target="threadId"/>
          <zeebe:output source="=visualScore"      target="visualScore"/>
          <zeebe:output source="=perfScore"        target="perfScore"/>
          <zeebe:output source="=combinedScore"    target="combinedScore"/>
          <zeebe:output source="=publish"          target="publish"/>
          <zeebe:output source="=outcome"          target="outcome"/>
          <zeebe:output source="=issuesJson"       target="issuesJson"/>
          <zeebe:output source="=criticModelId"    target="criticModelId"/>
          <zeebe:output source="=visualLatencyMs"  target="visualLatencyMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToVisualCritic</bpmn:incoming>
      <bpmn:outgoing>Flow_ToQaRkey</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToQaRkey" sourceRef="Task_VisualCritic" targetRef="Task_BuildQaRkey"/>

    <bpmn:scriptTask id="Task_BuildQaRkey" name="rkey from now()">
      <bpmn:extensionElements>
        <zeebe:script
            expression='=string join(["qa", replace(string(now()), "[^0-9]", "", "s")], "")'
            resultVariable="qaRkey"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToQaRkey</bpmn:incoming>
      <bpmn:outgoing>Flow_ToQaCreatedAt</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ToQaCreatedAt" sourceRef="Task_BuildQaRkey" targetRef="Task_BuildQaCreatedAt"/>

    <bpmn:scriptTask id="Task_BuildQaCreatedAt" name="createdAt ISO">
      <bpmn:extensionElements>
        <zeebe:script
            expression='=string(now())'
            resultVariable="qaCreatedAt"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToQaCreatedAt</bpmn:incoming>
      <bpmn:outgoing>Flow_ToQaVid</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ToQaVid" sourceRef="Task_BuildQaCreatedAt" targetRef="Task_BuildQaVid"/>

    <bpmn:scriptTask id="Task_BuildQaVid" name="at:// vertex_id">
      <bpmn:extensionElements>
        <zeebe:script
            expression='=string join(["at://did:web:gameka.etzhayyim.com/com.etzhayyim.apps.gameka.gameQa/", qaRkey], "")'
            resultVariable="qaVertexId"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToQaVid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToQaInsert</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ToQaInsert" sourceRef="Task_BuildQaVid" targetRef="Task_PersistQa"/>

    <!-- Step 8: persist QA row. Latest row by created_at DESC wins;
         the iteration column makes the loop's lineage queryable. -->
    <bpmn:serviceTask id="Task_PersistQa" name="insert vertex_gameka_qa">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_gameka_qa&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id: qaVertexId,
              owner_did: &quot;did:web:gameka.etzhayyim.com&quot;,
              rkey: qaRkey,
              repo: &quot;did:web:gameka.etzhayyim.com&quot;,
              qa_id: qaRkey,
              artifact_id: artifactId,
              fps_p50: fpsP50,
              crashes: consoleErrorCount,
              llm_score: visualScore,
              publish: publish,
              issues_json: issuesJson,
              created_at: qaCreatedAt
          }" target="values"/>
          <zeebe:input source="=&quot;raise&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToQaInsert</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_PersistQa" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit qa.{outcome}">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:gameka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=string join([&quot;gameka.qa.&quot;, outcome], &quot;&quot;)" target="action"/>
          <zeebe:input source="={
              specId: specId,
              artifactId: artifactId,
              qaId: qaRkey,
              iteration: iteration,
              visualScore: visualScore,
              perfScore: perfScore,
              combinedScore: combinedScore,
              publish: publish,
              outcome: outcome,
              fpsP50: fpsP50,
              consoleErrorCount: consoleErrorCount,
              criticModelId: criticModelId
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToOutcomeGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToOutcomeGate" sourceRef="Task_Audit" targetRef="Gateway_Outcome"/>

    <!-- Step 9: outcome gateway. The visual critic's outcome string
         drives one of three exits:
           pass      → derive publishGame
           revise    → derive proposeGame (loop iteration+1)
           exhausted → end without derive
    -->
    <bpmn:exclusiveGateway id="Gateway_Outcome" name="outcome?">
      <bpmn:incoming>Flow_ToOutcomeGate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPass</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToRevise</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToExhausted</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_ToPass" sourceRef="Gateway_Outcome" targetRef="Task_DerivePublish">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=outcome = "pass"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToRevise" sourceRef="Gateway_Outcome" targetRef="Task_DeriveRevise">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=outcome = "revise"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToExhausted" sourceRef="Gateway_Outcome" targetRef="End">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=outcome = "exhausted"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Step 10a: pass → derive publishGame. -->
    <bpmn:serviceTask id="Task_DerivePublish" name="derive publishGame">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.gameka.publishGame&quot;" target="nsid"/>
          <zeebe:input source="={
              specId: specId,
              artifactId: artifactId,
              qaId: qaRkey
          }" target="input"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPass</bpmn:incoming>
      <bpmn:outgoing>Flow_PassToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_PassToEnd" sourceRef="Task_DerivePublish" targetRef="End"/>

    <!-- Step 10b: revise → derive proposeGame with iteration+1 and
         priorSpecs[0] carrying the issues for this round. The
         LangGraph studio's planner consumes priorSpecs[*].issues to
         bias the next 3 candidates away from the same trap. -->
    <bpmn:serviceTask id="Task_DeriveRevise" name="derive proposeGame (revise)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.gameka.proposeGame&quot;" target="nsid"/>
          <zeebe:input source="={
              brief: specBrief,
              iteration: iteration + 1,
              lineageParent: specId,
              priorSpecs: [{
                  slug: specSlug,
                  title: specTitle,
                  score: combinedScore,
                  outcome: &quot;revise&quot;,
                  issuesJson: issuesJson
              }]
          }" target="input"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRevise</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviseToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ReviseToEnd" sourceRef="Task_DeriveRevise" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToExhausted</bpmn:incoming>
      <bpmn:incoming>Flow_PassToEnd</bpmn:incoming>
      <bpmn:incoming>Flow_ReviseToEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
