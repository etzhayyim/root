<?xml version="1.0" encoding="UTF-8"?>
<!--
  gameka.tickStudio — autonomous studio cadence (ADR 2604250900 P7).

  Fires every 2 hours (R/PT2H). Scans the last 24h of media-gamers
  posts, asks Murakumo to compose a one-line creative brief, then —
  if tick_live_mode=true in vertex_gameka_studio_config — derives
  proposeGame. During the 14-day soak (tick_live_mode=false, the
  migration's seed default), only an audit is emitted, no derive.

  Pipeline:
    Start (timerEventDefinition R/PT2H)
      → Task_LoadConfig        generic.db.select vertex_gameka_studio_config
                               (tick_live_mode flag)
      → Task_LoadPriorSpecs    generic.db.select vertex_gameka_spec
                               (last 10, fed to proposeGame as avoid-list
                                so the LangGraph studio's planner doesn't
                                repeat itself across ticks)
      → Task_TrendScan         generic.db.select vertex_repo_record
                               (last 24h media-gamers feed posts)
      → Task_BuildBrief        generic.llm.json
                               (tier=classifier, returns
                                {brief, themes:[]} from trend keywords)
      → ExclusiveGateway       tickLiveMode = true ?
           true   → Task_DeriveProposal  generic.pds.dispatch proposeGame
                                         (brief, iteration:0, priorSpecs)
                  → Task_AuditLive       generic.audit.emit gameka.tick.live
           false  → Task_AuditDryRun     generic.audit.emit gameka.tick.dryRun
      → End

  Bounded blast radius:
    - Idempotent: same brief twice produces two separate spec lineages —
      the LangGraph studio dedupes via priorSpecs on the second attempt.
    - Self-throttled: if media-gamers posts are stale (trendCount=0),
      the LLM produces a generic brief; the planner still avoids past
      slugs.
    - Failure-safe: BuildBrief LLM error → outcome=skipped (no derive,
      no dryRun audit — the audit captures the LLM failure under
      gameka.tick.briefError so operators can debug).

  NSID: com.etzhayyim.apps.gameka.tickStudio (timer-started, no XRPC caller)
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/gameka-tick-studio-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_gameka_tick_studio"
    targetNamespace="https://etzhayyim.ai/bpmn/gameka"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="gameka_tick_studio" name="gameka tickStudio" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.gameka.tickStudio", "version": 1, "resultTimeoutMs": 90000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="every 2h">
      <bpmn:outgoing>Flow_ToLoadConfig</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_2h">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT2H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToLoadConfig" sourceRef="Start" targetRef="Task_LoadConfig"/>

    <!-- Step 1: read the dry-run / live gate. Single-row table seeded
         by the P7 migration with tick_live_mode=false. -->
    <bpmn:serviceTask id="Task_LoadConfig" name="load studio config">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_gameka_studio_config&quot;" target="table"/>
          <zeebe:input source="=&quot;tick_live_mode&quot;" target="columns"/>
          <zeebe:input source="=&quot;config_id = %s&quot;" target="whereExpr"/>
          <zeebe:input source="=[&quot;global&quot;]" target="whereParams"/>
          <zeebe:input source="=1" target="limit"/>
          <zeebe:output source="=if rows[1] = null then false else rows[1].tick_live_mode" target="tickLiveMode"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToLoadConfig</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLoadPriorSpecs</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToLoadPriorSpecs" sourceRef="Task_LoadConfig" targetRef="Task_LoadPriorSpecs"/>

    <!-- Step 2: load the most recent 10 specs as the planner's
         avoid-list. proposeGame's input lexicon (post-P4) accepts
         priorSpecs[] so the LangGraph studio's planner consumes them
         directly. -->
    <bpmn:serviceTask id="Task_LoadPriorSpecs" name="load last 10 specs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_gameka_spec&quot;" target="table"/>
          <zeebe:input source="=&quot;spec_id, slug, title, score&quot;" target="columns"/>
          <zeebe:input source="=&quot;1=1&quot;" target="whereExpr"/>
          <zeebe:input source="=[]" target="whereParams"/>
          <zeebe:input source="=&quot;created_at DESC&quot;" target="orderBy"/>
          <zeebe:input source="=10" target="limit"/>
          <zeebe:output source="=if rows = null then [] else rows" target="priorSpecsRows"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToLoadPriorSpecs</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTrendScan</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToTrendScan" sourceRef="Task_LoadPriorSpecs" targetRef="Task_TrendScan"/>

    <!-- Step 3: 24h media-gamers feed scan. Limit 20 to bound the LLM
         prompt; ts_ms threshold is computed SQL-side (same trick as
         yoro.platformPulse). value_json holds the post text we'll
         join in the FEEL script before passing to the LLM. -->
    <bpmn:serviceTask id="Task_TrendScan" name="scan media-gamers 24h posts">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_repo_record&quot;" target="table"/>
          <zeebe:input source="=&quot;value_json&quot;" target="columns"/>
          <zeebe:input source="=&quot;collection = %s AND repo LIKE %s AND ts_ms > (EXTRACT(epoch FROM now()) * 1000 - 86400000)::bigint&quot;" target="whereExpr"/>
          <zeebe:input source='=["app.bsky.feed.post", "did:web:media-gamers.etzhayyim.com%"]' target="whereParams"/>
          <zeebe:input source="=&quot;ts_ms DESC&quot;" target="orderBy"/>
          <zeebe:input source="=20" target="limit"/>
          <zeebe:output source="=if rows = null then [] else rows" target="trendRows"/>
          <zeebe:output source="=if rows = null then 0 else count(rows)" target="trendCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToTrendScan</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTrendCorpus</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToTrendCorpus" sourceRef="Task_TrendScan" targetRef="Task_BuildTrendCorpus"/>

    <!-- Step 4a: flatten the trend rows into a single string the LLM
         consumes. FEEL string join + truncate; if trendCount=0 we
         feed a placeholder so the LLM still produces a usable brief. -->
    <bpmn:scriptTask id="Task_BuildTrendCorpus" name="flatten trend rows">
      <bpmn:extensionElements>
        <zeebe:script
            expression='=if trendCount = 0 then "no recent media-gamers posts" else string join(for r in trendRows return string(r.value_json), " | ")'
            resultVariable="trendCorpus"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToTrendCorpus</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBuildBrief</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ToBuildBrief" sourceRef="Task_BuildTrendCorpus" targetRef="Task_BuildBrief"/>

    <!-- Step 4b: LLM composes a one-line generative brief. Schema-
         constrained JSON so the FEEL gateway can read tickBrief safely.
         Failure mode: if the LLM tier is down, the BPMN fails fast on
         this task — no spurious dry-run audits, no derive. Operators
         see the Zeebe incident in Operate UI. -->
    <bpmn:serviceTask id="Task_BuildBrief" name="LLM compose brief">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.llm.json" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;classifier&quot;" target="tier"/>
          <zeebe:input source="=&quot;You are gameka.etzhayyim.com's autonomous studio brief composer. Read recent gaming-media posts (raw JSON corpus). Output ONE minified JSON object: {&apos;brief&apos;: a one-line creative seed for a new browser game (≤200 chars, English, mechanic+vibe only, no real IP names), &apos;themes&apos;: array of ≤5 short keyword strings}. No preamble. If the corpus is thin or empty, propose an original mechanic anyway.&quot;" target="system"/>
          <zeebe:input source="=string join([&quot;Corpus (last 24h, &quot;, string(trendCount), &quot; posts):\n&quot;, trendCorpus], &quot;&quot;)" target="user"/>
          <zeebe:input source="=350" target="maxTokens"/>
          <zeebe:input source="=0.6" target="temperature"/>
          <zeebe:output source="=data.brief"  target="tickBrief"/>
          <zeebe:output source="=data.themes" target="tickThemes"/>
          <zeebe:output source="=model"       target="tickModelId"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToBuildBrief</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLiveGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToLiveGate" sourceRef="Task_BuildBrief" targetRef="Gateway_Live"/>

    <!-- Step 5: 14-day soak gate. tick_live_mode=false → audit only.
         tick_live_mode=true → derive proposeGame + audit. -->
    <bpmn:exclusiveGateway id="Gateway_Live" name="tick_live_mode?">
      <bpmn:incoming>Flow_ToLiveGate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLive</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToDryRun</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToLive" sourceRef="Gateway_Live" targetRef="Task_DeriveProposal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=tickLiveMode = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToDryRun" sourceRef="Gateway_Live" targetRef="Task_AuditDryRun">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=tickLiveMode != true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Step 6a (live path): derive proposeGame. iteration=0 because
         this is an autonomous origin, not a revise. priorSpecs is the
         avoid-list from Task_LoadPriorSpecs. -->
    <bpmn:serviceTask id="Task_DeriveProposal" name="derive proposeGame">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.gameka.proposeGame&quot;" target="nsid"/>
          <zeebe:input source="={
              brief: tickBrief,
              iteration: 0,
              priorSpecs: priorSpecsRows
          }" target="input"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToLive</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAuditLive</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAuditLive" sourceRef="Task_DeriveProposal" targetRef="Task_AuditLive"/>

    <bpmn:serviceTask id="Task_AuditLive" name="audit emit (live)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:gameka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;gameka.tick.live&quot;" target="action"/>
          <zeebe:input source="={
              trendCount: trendCount,
              brief: tickBrief,
              themes: if tickThemes = null then [] else tickThemes,
              priorCount: count(priorSpecsRows),
              modelId: tickModelId
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAuditLive</bpmn:incoming>
      <bpmn:outgoing>Flow_LiveToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_LiveToEnd" sourceRef="Task_AuditLive" targetRef="End"/>

    <!-- Step 6b (dry-run path): audit only. Brief is preserved in the
         payload so operators can scrub the 14-day log for quality. -->
    <bpmn:serviceTask id="Task_AuditDryRun" name="audit emit (dryRun)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:gameka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;gameka.tick.dryRun&quot;" target="action"/>
          <zeebe:input source="={
              trendCount: trendCount,
              brief: tickBrief,
              themes: if tickThemes = null then [] else tickThemes,
              priorCount: count(priorSpecsRows),
              modelId: tickModelId
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDryRun</bpmn:incoming>
      <bpmn:outgoing>Flow_DryRunToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_DryRunToEnd" sourceRef="Task_AuditDryRun" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_LiveToEnd</bpmn:incoming>
      <bpmn:incoming>Flow_DryRunToEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
