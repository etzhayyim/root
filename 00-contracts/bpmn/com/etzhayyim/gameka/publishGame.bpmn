<?xml version="1.0" encoding="UTF-8"?>
<!--
  gameka.publishGame — closes the ideate loop. Mints a per-game sub-DID
  under did:web:gameka.etzhayyim.com:game:{slug}, writes a gameTitle record
  + edge_gameka_title_published_by, and posts the launch announcement
  on the new sub-DID's timeline.

  Pipeline (ADR 2604250900 P6):
    Start (XRPC com.etzhayyim.apps.gameka.publishGame { specId, artifactId, qaId })
      → Task_LoadSpec       generic.db.select  vertex_gameka_spec (slug, title, brief, genre)
      → Task_LoadArtifact   generic.db.select  vertex_gameka_artifact -built (wasm_cid)
      → Task_BuildSubDid    scriptTask FEEL    "did:web:gameka.etzhayyim.com:game:" + slug
      → Task_BuildPlayUrl   scriptTask FEEL    "https://game-play.etzhayyim.com/" + slug
      → Task_ProvisionSubDid generic.pds.dispatch com.etzhayyim.authz.provisionSubDid
                            { parentDid, path }     ← OPERATOR-WIRED, see notes
      → Task_BuildTitleRkey scriptTask FEEL    "ttl" + epoch ms
      → Task_BuildCreatedAt scriptTask FEEL    string(now())
      → Task_BuildTitleVid  scriptTask FEEL    at:// vertex_id
      → Task_PersistTitle   generic.db.insert  vertex_gameka_title
      → Task_BuildEdgeId    scriptTask FEEL    "edge:" + titleVid + ":published_by"
      → Task_PersistEdge    generic.db.insert  edge_gameka_title_published_by
      → Task_PostLaunchText scriptTask FEEL    compose announcement string
      → Task_PostLaunch     generic.pds.dispatch app.bsky.feed.post (repo=subDid)
      → Task_Audit          generic.audit.emit gameka.title.published
      → End

  Sub-DID provisioning notes:
    `com.etzhayyim.authz.provisionSubDid` is the convention NSID for minting
    a path-based sub-DID's signing key into PDS SIGNING_KEYS_D1 custody
    (ADR-0023). If your authn.etzhayyim.com surface uses a different NSID
    (e.g. `com.atproto.admin.createSubActor`), swap it in Task_ProvisionSubDid;
    the rest of the chain only consumes the deterministic subDid string.
    On provisioning failure the BPMN fails — title row is NOT written,
    so the publish stays consistent (no title without a key).

  Social post owner:
    `repo: subDid` makes the launch post show up on the per-title
    timeline (did:web:gameka.etzhayyim.com:game:{slug}). The primary gameka
    actor neither owns nor reposts it — fans follow the sub-DID
    directly, mirroring the media-gamers pattern.

  NSID: com.etzhayyim.apps.gameka.publishGame (XRPC procedure)
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/gameka-publish-game-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_gameka_publish_game"
    targetNamespace="https://etzhayyim.ai/bpmn/gameka"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="gameka_publish_game" name="gameka publishGame" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.gameka.publishGame", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="XRPC publishGame">
      <bpmn:outgoing>Flow_ToLoadSpec</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToLoadSpec" sourceRef="Start" targetRef="Task_LoadSpec"/>

    <!-- Step 1: load the spec for slug + title + brief + scene.
         scene_json feeds the avatar renderer's biome hint at Task_RenderAvatar. -->
    <bpmn:serviceTask id="Task_LoadSpec" name="load vertex_gameka_spec">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_gameka_spec&quot;" target="table"/>
          <zeebe:input source="=&quot;slug, title, brief, genre, scene_json&quot;" target="columns"/>
          <zeebe:input source="=&quot;spec_id = %s&quot;" target="whereExpr"/>
          <zeebe:input source="=[specId]" target="whereParams"/>
          <zeebe:input source="=1" target="limit"/>
          <zeebe:output source="=rows[1].slug"       target="specSlug"/>
          <zeebe:output source="=rows[1].title"      target="specTitle"/>
          <zeebe:output source="=rows[1].brief"      target="specBrief"/>
          <zeebe:output source="=rows[1].genre"      target="specGenre"/>
          <zeebe:output source="=rows[1].scene_json" target="specSceneJson"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToLoadSpec</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSpecGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToSpecGate" sourceRef="Task_LoadSpec" targetRef="Gateway_SpecFound"/>

    <bpmn:exclusiveGateway id="Gateway_SpecFound" name="spec found?" default="Flow_SpecMissing">
      <bpmn:incoming>Flow_ToSpecGate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLoadArtifact</bpmn:outgoing>
      <bpmn:outgoing>Flow_SpecMissing</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToLoadArtifact" sourceRef="Gateway_SpecFound" targetRef="Task_LoadArtifact">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=specSlug != null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SpecMissing" sourceRef="Gateway_SpecFound" targetRef="Task_AuditAbort"/>

    <bpmn:serviceTask id="Task_AuditAbort" name="audit publish aborted">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:gameka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;gameka.title.publishAborted&quot;" target="action"/>
          <zeebe:input source="={ specId: specId, artifactId: artifactId, reason: &quot;spec-missing&quot; }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SpecMissing</bpmn:incoming>
      <bpmn:outgoing>Flow_AbortEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AbortEnd" sourceRef="Task_AuditAbort" targetRef="End"/>

    <!-- Step 2: load the artifact's binary cid (used in the launch
         post body for verifiability). Latest -built wins. -->
    <bpmn:serviceTask id="Task_LoadArtifact" name="load vertex_gameka_artifact (built)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_gameka_artifact&quot;" target="table"/>
          <zeebe:input source="=&quot;wasm_cid&quot;" target="columns"/>
          <zeebe:input source="=&quot;artifact_id = %s AND build_status = %s&quot;" target="whereExpr"/>
          <zeebe:input source="=[artifactId, &quot;built&quot;]" target="whereParams"/>
          <zeebe:input source="=&quot;created_at DESC&quot;" target="orderBy"/>
          <zeebe:input source="=1" target="limit"/>
          <zeebe:output source="=rows[1].wasm_cid" target="binaryWasmCid"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToLoadArtifact</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSubDid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToSubDid" sourceRef="Task_LoadArtifact" targetRef="Task_BuildSubDid"/>

    <!-- Step 3a: deterministic sub-DID from slug. media-gamers pattern:
         did:web:gameka.etzhayyim.com:game:{slug}. host-sdk did.json auto-serves
         this path once the signing key is provisioned. -->
    <bpmn:scriptTask id="Task_BuildSubDid" name="compute sub-DID">
      <bpmn:extensionElements>
        <zeebe:script
            expression='=string join(["did:web:gameka.etzhayyim.com:game:", specSlug], "")'
            resultVariable="subDid"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSubDid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPlayUrl</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ToPlayUrl" sourceRef="Task_BuildSubDid" targetRef="Task_BuildPlayUrl"/>

    <!-- Step 3b: deterministic play URL. game-play.etzhayyim.com/play/{slug}
         is owned by `gameka-playtest-shell`
         (50-infra/cloudflare/workers/gameka-playtest-shell), which
         resolves the slug to the latest -built artifact via Hyperdrive
         and 302s to /__playtest__.html?c=&w=&j=&e=run_<slug>. The same
         shell that the QA loop renders against. -->
    <bpmn:scriptTask id="Task_BuildPlayUrl" name="compute play URL">
      <bpmn:extensionElements>
        <zeebe:script
            expression='=string join(["https://game-play.etzhayyim.com/play/", specSlug], "")'
            resultVariable="playUrl"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPlayUrl</bpmn:incoming>
      <bpmn:outgoing>Flow_ToProvisionSubDid</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ToProvisionSubDid" sourceRef="Task_BuildPlayUrl" targetRef="Task_ProvisionSubDid"/>

    <!-- Step 4: provision the sub-DID's signing key into PDS custody.
         Convention NSID — operator-wired (see file header). On failure
         this task throws and the publish aborts before any title row
         is written, keeping the graph consistent. -->
    <bpmn:serviceTask id="Task_ProvisionSubDid" name="authn provisionSubDid">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.authz.provisionSubDid&quot;" target="nsid"/>
          <zeebe:input source="={
              parentDid: &quot;did:web:gameka.etzhayyim.com&quot;,
              path: string join([&quot;game:&quot;, specSlug], &quot;&quot;),
              displayName: specTitle,
              description: string join([specTitle, &quot; — generated by gameka.etzhayyim.com&quot;], &quot;&quot;)
          }" target="input"/>
          <zeebe:output source="=output.did" target="provisionedSubDid"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToProvisionSubDid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToExtractBiome</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToExtractBiome" sourceRef="Task_ProvisionSubDid" targetRef="Task_ExtractBiome"/>

    <!-- Step 4.5a: pick a biome string from scene_json. FEEL
         `contains` is side-effect-free; falls back to "default" when
         no keyword matches. The avatar renderer uses this to pick a
         4-tone Splatoon-pastel palette. -->
    <bpmn:scriptTask id="Task_ExtractBiome" name="extract biome from scene">
      <bpmn:extensionElements>
        <zeebe:script
            expression='=if contains(specSceneJson, "tundra") then "tundra" else if contains(specSceneJson, "quarry") then "quarry" else if contains(specSceneJson, "desert") then "desert" else if contains(specSceneJson, "plains") then "plains" else "default"'
            resultVariable="avatarBiome"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToExtractBiome</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRenderAvatar</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ToRenderAvatar" sourceRef="Task_ExtractBiome" targetRef="Task_RenderAvatar"/>

    <!-- Step 4.5b: render the per-title procedural avatar. Pure
         stdlib Python (sha256 → 8×8 mirrored identicon, biome
         palette, zlib-compressed RGB PNG). Failure path returns
         buildStatus="failed" + empty avatarDataUri — the publish
         chain continues; the title row stores an empty string and
         the shell falls back to the cream-pastel default. -->
    <bpmn:serviceTask id="Task_RenderAvatar" name="render procedural avatar">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gameka.avatar.render" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="=specSlug"      target="slug"/>
          <zeebe:input source="=avatarBiome"   target="biome"/>
          <zeebe:input source="=256"           target="size"/>
          <zeebe:output source="=avatarDataUri"  target="avatarDataUri"/>
          <zeebe:output source="=avatarSizeBytes" target="avatarSizeBytes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRenderAvatar</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTitleRkey</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToTitleRkey" sourceRef="Task_RenderAvatar" targetRef="Task_BuildTitleRkey"/>

    <!-- Step 5a-c: title rkey + createdAt + vertex_id. -->
    <bpmn:scriptTask id="Task_BuildTitleRkey" name="rkey from now()">
      <bpmn:extensionElements>
        <zeebe:script
            expression='=string join(["ttl", replace(string(now()), "[^0-9]", "", "s")], "")'
            resultVariable="titleRkey"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToTitleRkey</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTitleCreatedAt</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ToTitleCreatedAt" sourceRef="Task_BuildTitleRkey" targetRef="Task_BuildCreatedAt"/>

    <bpmn:scriptTask id="Task_BuildCreatedAt" name="createdAt ISO">
      <bpmn:extensionElements>
        <zeebe:script
            expression='=string(now())'
            resultVariable="titleCreatedAt"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToTitleCreatedAt</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTitleVid</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ToTitleVid" sourceRef="Task_BuildCreatedAt" targetRef="Task_BuildTitleVid"/>

    <bpmn:scriptTask id="Task_BuildTitleVid" name="at:// vertex_id">
      <bpmn:extensionElements>
        <zeebe:script
            expression='=string join(["at://did:web:gameka.etzhayyim.com/com.etzhayyim.apps.gameka.gameTitle/", titleRkey], "")'
            resultVariable="titleVertexId"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToTitleVid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToInsertTitle</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ToInsertTitle" sourceRef="Task_BuildTitleVid" targetRef="Task_PersistTitle"/>

    <!-- Step 6: insert vertex_gameka_title. version="v" + iteration
         from upstream (defaults to v1 when absent — first-pass passes). -->
    <bpmn:serviceTask id="Task_PersistTitle" name="insert vertex_gameka_title">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_gameka_title&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id: titleVertexId,
              owner_did: &quot;did:web:gameka.etzhayyim.com&quot;,
              rkey: titleRkey,
              repo: &quot;did:web:gameka.etzhayyim.com&quot;,
              title_id: titleRkey,
              slug: specSlug,
              sub_did: subDid,
              parent_spec_id: specId,
              parent_artifact_id: artifactId,
              play_url: playUrl,
              version: &quot;v1&quot;,
              avatar_data_uri: if avatarDataUri = null then &quot;&quot; else avatarDataUri,
              published_at: titleCreatedAt,
              created_at: titleCreatedAt
          }" target="values"/>
          <zeebe:input source="=&quot;raise&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToInsertTitle</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEdgeId</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEdgeId" sourceRef="Task_PersistTitle" targetRef="Task_BuildEdgeId"/>

    <!-- Step 7: insert edge_gameka_title_published_by linking the
         title to the gameka primary actor. Edge id is content-addressed
         on (titleVid, publisherDid) so re-publish (e.g. after a revise
         loop produced a fresh title row) is idempotent on the edge. -->
    <bpmn:scriptTask id="Task_BuildEdgeId" name="edge_id">
      <bpmn:extensionElements>
        <zeebe:script
            expression='=string join(["edge:", titleVertexId, ":published_by:did:web:gameka.etzhayyim.com"], "")'
            resultVariable="publishedByEdgeId"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToEdgeId</bpmn:incoming>
      <bpmn:outgoing>Flow_ToInsertEdge</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ToInsertEdge" sourceRef="Task_BuildEdgeId" targetRef="Task_PersistEdge"/>

    <bpmn:serviceTask id="Task_PersistEdge" name="insert edge_gameka_title_published_by">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;edge_gameka_title_published_by&quot;" target="table"/>
          <zeebe:input source="={
              edge_id: publishedByEdgeId,
              src_vid: titleVertexId,
              dst_vid: &quot;did:web:gameka.etzhayyim.com&quot;,
              owner_did: &quot;did:web:gameka.etzhayyim.com&quot;,
              published_at: titleCreatedAt,
              created_at: titleCreatedAt
          }" target="values"/>
          <zeebe:input source="=&quot;raise&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToInsertEdge</bpmn:incoming>
      <bpmn:outgoing>Flow_ToProfileText</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToProfileText" sourceRef="Task_PersistEdge" targetRef="Task_BuildProfileText"/>

    <!-- Step 7.5: profile registration BEFORE the launch post so the
         sub-DID's timeline is populated when followers land on it.
         displayName=title, description=brief+playUrl+AI-Agent
         disclaimer (60-apps/CLAUDE.md §Profile Registration mandate).
         No avatar in P6 — codegen step (P9 codegen extension) will
         later upload a procedural avatar to B2 and patch the profile
         record in place. -->
    <bpmn:scriptTask id="Task_BuildProfileText" name="compose profile description">
      <bpmn:extensionElements>
        <zeebe:script
            expression='=string join([
                specBrief,
                " · play: ", playUrl,
                " · build ", binaryWasmCid,
                " · [AI Agent — unofficial, not affiliated with any real organization]"
            ], "")'
            resultVariable="profileDescription"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToProfileText</bpmn:incoming>
      <bpmn:outgoing>Flow_ToProfileRegister</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ToProfileRegister" sourceRef="Task_BuildProfileText" targetRef="Task_RegisterProfile"/>

    <!-- Step 7.6: write app.bsky.actor.profile AS subDid. rkey="self"
         is the AT Protocol convention for the canonical profile
         record. PDS dispatch routes this through the standard
         com.atproto.repo.createRecord path so federation + AppView
         indexing pick it up identically to a human-authored
         Bluesky profile. -->
    <bpmn:serviceTask id="Task_RegisterProfile" name="app.bsky.actor.profile (as subDid)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.atproto.repo.createRecord&quot;" target="nsid"/>
          <zeebe:input source="={
              repo: subDid,
              collection: &quot;app.bsky.actor.profile&quot;,
              rkey: &quot;self&quot;,
              record: {
                  $type: &quot;app.bsky.actor.profile&quot;,
                  displayName: specTitle,
                  description: profileDescription,
                  createdAt: titleCreatedAt
              }
          }" target="input"/>
          <zeebe:output source="=output.uri" target="profileUri"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToProfileRegister</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPostText</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToPostText" sourceRef="Task_RegisterProfile" targetRef="Task_PostLaunchText"/>

    <!-- Step 8a: launch announcement text. Kept short (Bluesky 300
         grapheme cap) + content-addressed by binary cid for later
         verifiability. -->
    <bpmn:scriptTask id="Task_PostLaunchText" name="compose launch text">
      <bpmn:extensionElements>
        <zeebe:script
            expression='=string join([
                "🎮 New: ", specTitle, " — play at ", playUrl,
                " · build ", binaryWasmCid
            ], "")'
            resultVariable="launchText"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPostText</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPostLaunch</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ToPostLaunch" sourceRef="Task_PostLaunchText" targetRef="Task_PostLaunch"/>

    <!-- Step 8b: social post AS the new sub-DID. ADR-0036: social
         goes through PDS dispatch so it hits the AT firehose +
         federates; no Hyperdrive write. The repo field switches the
         author to the per-title sub-DID. -->
    <bpmn:serviceTask id="Task_PostLaunch" name="app.bsky.feed.post (as subDid)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.atproto.repo.createRecord&quot;" target="nsid"/>
          <zeebe:input source="={
              repo: subDid,
              collection: &quot;app.bsky.feed.post&quot;,
              record: {
                  $type: &quot;app.bsky.feed.post&quot;,
                  text: launchText,
                  createdAt: titleCreatedAt,
                  langs: [&quot;en&quot;]
              }
          }" target="input"/>
          <zeebe:output source="=output.uri" target="launchPostUri"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPostLaunch</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_PostLaunch" targetRef="Task_Audit"/>

    <!-- Step 9: audit. -->
    <bpmn:serviceTask id="Task_Audit" name="audit emit (published)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:gameka.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;gameka.title.published&quot;" target="action"/>
          <zeebe:input source="={
              specId: specId,
              artifactId: artifactId,
              qaId: if qaId = null then &quot;&quot; else qaId,
              titleId: titleRkey,
              subDid: subDid,
              slug: specSlug,
              playUrl: playUrl,
              binaryWasmCid: binaryWasmCid,
              avatarBiome: avatarBiome,
              avatarSizeBytes: if avatarSizeBytes = null then 0 else avatarSizeBytes,
              profileUri: if profileUri = null then &quot;&quot; else profileUri,
              launchPostUri: if launchPostUri = null then &quot;&quot; else launchPostUri
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
      <bpmn:incoming>Flow_AbortEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
