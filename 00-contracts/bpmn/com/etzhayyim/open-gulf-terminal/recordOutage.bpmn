<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_gulf_terminal_record_outage"
    targetNamespace="https://etzhayyim.ai/bpmn/open-gulf-terminal"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_gulf_terminal_record_outage" name="Gulf terminal outage" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Classify"/>
    <bpmn:serviceTask id="Task_Classify" name="分類">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SELECT 1 AS ok LIMIT 1&quot;" target="query"/>
          <zeebe:input source="=[]" target="params"/>
          <zeebe:output source="=if cause = &quot;drone-attack&quot; or cause = &quot;cyber&quot; or (impactMbd != null and impactMbd &gt;= 1.0) then &quot;critical&quot; else if (impactMbd != null and impactMbd &gt;= 0.3) or severity = &quot;major&quot; then &quot;major&quot; else if severity = &quot;moderate&quot; then &quot;moderate&quot; else &quot;minor&quot;" target="severityDerived"/>
          <zeebe:output source="=cause = &quot;drone-attack&quot; or cause = &quot;cyber&quot; or (impactMbd != null and impactMbd &gt;= 0.3)" target="requireMarketNotice"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_Save</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Save" sourceRef="Task_Classify" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="outage 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_gulf_terminal_outage&quot;" target="table"/>
          <zeebe:input source="={vertex_id: vertexId, outage_id: outageId, terminal_code: terminalCode, cause: cause, impact_mbd: impactMbd, narrative: narrative, expected_duration_hours: expectedDurationHours, severity: severity, require_market_notice: requireMarketNotice, started_at: startedAt, resolved_at: resolvedAt, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-gulf-terminal&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Save</bpmn:incoming><bpmn:outgoing>Flow_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Gate" sourceRef="Task_Save" targetRef="Gate"/>
    <bpmn:exclusiveGateway id="Gate" default="Flow_Log">
      <bpmn:incoming>Flow_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Major</bpmn:outgoing>
      <bpmn:outgoing>Flow_Log</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Major" sourceRef="Gate" targetRef="Task_AuditMajor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=requireMarketNotice = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Log" sourceRef="Gate" targetRef="Task_AuditLog"/>
    <bpmn:serviceTask id="Task_AuditMajor" name="audit openGulfTerminal.outage.marketNotice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-gulf-terminal.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openGulfTerminal.outage.marketNotice&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, outageId: outageId, terminalCode: terminalCode, cause: cause, impactMbd: impactMbd, severity: severity}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Major</bpmn:incoming><bpmn:outgoing>Flow_EM</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EM" sourceRef="Task_AuditMajor" targetRef="End_M"/>
    <bpmn:serviceTask id="Task_AuditLog" name="audit openGulfTerminal.outage.log">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-gulf-terminal.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openGulfTerminal.outage.log&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, outageId: outageId, terminalCode: terminalCode, cause: cause, impactMbd: impactMbd, severity: severity}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Log</bpmn:incoming><bpmn:outgoing>Flow_EL</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EL" sourceRef="Task_AuditLog" targetRef="End_L"/>
    <bpmn:endEvent id="End_L"><bpmn:incoming>Flow_EL</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_M"><bpmn:incoming>Flow_EM</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
