<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_adr_create_case" targetNamespace="https://etzhayyim.ai/bpmn/adr" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="adr_create_case" name="createCase" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Insert"/>
    <bpmn:serviceTask id="Task_Insert" name="insert adr case (Tier 3)">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_adr_case&quot;" target="table"/>
          <zeebe:input source="={vertex_id: &quot;at://did:web:adr.etzhayyim.com:&quot; + institution + &quot;/com.etzhayyim.apps.adr.case/&quot; + caseRef, case_ref: caseRef, institution: institution, panel: panel, seat: seat, governing_law: governingLaw, parties_enc: partiesEnc, claim_amount_enc: claimAmountEnc, currency: currency, status: &quot;pending&quot;, opened_at: openedAt, owner_did: &quot;did:web:adr.etzhayyim.com&quot;, sensitivity_ord: 3, created_at: now}" target="row"/>
          <zeebe:output source="=vertex_id" target="vertexId"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Insert" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
