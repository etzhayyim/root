<?xml version="1.0" encoding="UTF-8"?>
<!--
  isbn.etzhayyim.com — Internet Archive (archive.org) daily.

  Timer-start: every 24h. Pulls 50 PD texts items per run with:
    - cover image  (services/img)
    - body text    (DjVu OCR)
    - per-page IIIF images capped at 10/book (fetchPageImages defaults
      to false for routine runs to keep the egress + B2 cost bounded;
      operator can run a manual fan-out for specific identifiers via
      kubectl exec).

  No XRPC entry. No CF Worker. Pure BPMN-as-actor + pyzeebe handler.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_isbn_ingest_internet_archive"
    targetNamespace="https://etzhayyim.ai/bpmn/isbn"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="isbn_ingest_internet_archive" name="isbn ingest Internet Archive (daily)" isExecutable="true">

    <bpmn:startEvent id="StartTimer" name="every 24h">
      <bpmn:outgoing>Flow_Ingest</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT24H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Ingest" name="ingest archive.org PD texts">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="isbn.internetArchive.ingest"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;mediatype:texts AND collection:opensource AND format:DjVuTXT&quot;" target="query"/>
          <zeebe:input source="=50" target="rows"/>
          <zeebe:input source="=true" target="fulltext"/>
          <zeebe:input source="=true" target="fetchCovers"/>
          <zeebe:input source="=false" target="fetchPageImages"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ingest</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Ingest" sourceRef="StartTimer" targetRef="Task_Ingest"/>

    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:isbn.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;isbn.ingest.internetArchive&quot;" target="action"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_Ingest" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
