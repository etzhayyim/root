<?xml version="1.0" encoding="UTF-8"?>
<!--
  isbn.etzhayyim.com — HathiTrust monthly hathifile (autonomous).

  Timer-start: every month on the 8th @ 00:00 UTC. HathiTrust drops
  hathifile_full_*.txt.gz on the 1st-3rd; the 8th gives buffer.
  publicDomainOnly=true filters to access=allow rows (~7M of 18M).

  hathifileUrl is intentionally unset → handler raises if not
  injected. This BPMN is the schedule contract; the actual URL
  must come from a K8s Secret / env / values.yaml override before
  the timer fires (see deps.toml `[[migrations]] isbn-global-library-bulk-ingest-bringup`).

  No XRPC entry. No CF Worker. Pure BPMN-as-actor + pyzeebe handler.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_isbn_ingest_hathitrust"
    targetNamespace="https://etzhayyim.ai/bpmn/isbn"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="isbn_ingest_hathitrust" name="isbn ingest HathiTrust (monthly)" isExecutable="true">

    <bpmn:startEvent id="StartTimer" name="monthly day 8">
      <bpmn:outgoing>Flow_Ingest</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 0 8 * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Ingest" name="ingest HathiTrust hathifile">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="isbn.hathitrust.ingest"/>
        <zeebe:ioMapping>
          <zeebe:input source="=true" target="publicDomainOnly"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ingest</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Ingest" sourceRef="StartTimer" targetRef="Task_Ingest"/>

    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:isbn.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;isbn.ingest.hathitrust&quot;" target="action"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_Ingest" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
