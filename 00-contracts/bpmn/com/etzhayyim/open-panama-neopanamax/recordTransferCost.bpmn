<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_open_panama_neopanamax_transfer"
    targetNamespace="https://etzhayyim.ai/bpmn/open-panama-neopanamax"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_panama_neopanamax_transfer" name="代替費用" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="transfer 保存">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_panama_transfer_cost&quot;" target="table"/>
          <zeebe:input source="={vertex_id: vertexId, cost_id: costId, imo: imo, alternative_route: alternativeRoute, days_penalty: daysPenalty, cost_delta_usd: costDeltaUsd, impact_tier: if daysPenalty &gt;= 20 or costDeltaUsd &gt;= 2000000 then &quot;major&quot; else if daysPenalty &gt;= 10 or costDeltaUsd &gt;= 500000 then &quot;moderate&quot; else &quot;minor&quot;, decided_at: decidedAt, status: &quot;recorded&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-panama-neopanamax&quot;}" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit openPanamaNeopanamax.transfer.record">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-panama-neopanamax.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;openPanamaNeopanamax.transfer.record&quot;" target="action"/>
          <zeebe:input source="={vertexId: vertexId, costId: costId, alternativeRoute: alternativeRoute}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
