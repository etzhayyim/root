<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_seiyaku_amend_batch"
    targetNamespace="https://etzhayyim.ai/bpmn/open-seiyaku"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="seiyaku_amend_batch" name="製薬バッチ変更" isExecutable="true">
    <bpmn:startEvent id="Start" name="変更開始">
      <bpmn:outgoing>Flow_S</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_AmendForm"/>

    <bpmn:userTask id="Task_AmendForm" name="変更申請入力">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:open-seiyaku-amend-v1"/>
        <zeebe:assignmentDefinition candidateGroups="plant-operator"/>
        <zeebe:taskSchedule dueDate="=now() + duration(&quot;P3D&quot;)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming>
      <bpmn:incoming>Flow_QARejectLoop</bpmn:incoming>
      <bpmn:outgoing>Flow_F1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_F1" sourceRef="Task_AmendForm" targetRef="Task_ClassifyAmendment"/>

    <bpmn:serviceTask id="Task_ClassifyAmendment" name="変更リスク分類">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.rules.evaluate"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;open-seiyaku.batch.amend.v1&quot;" target="ruleSet"/>
          <zeebe:input source="={
              vertexId:            vertexId,
              amendmentType:       amendmentType,
              batchNumber:         batchNumber,
              deviationPayload:    string(deviationPayload),
              amendmentPayload:    string(amendmentPayload),
              requiresQaApproval:  requiresQaApproval
          }" target="facts"/>
          <zeebe:output source="=coalesce(riskTier, if requiresQaApproval then &quot;major&quot; else &quot;minor&quot;)" target="amendmentRiskTier"/>
          <zeebe:output source="=coalesce(capaRequired, false)" target="capaRequired"/>
          <zeebe:output source="=coalesce(approvalRequired, requiresQaApproval)" target="effectiveQaApprovalRequired"/>
          <zeebe:output source="=findings" target="amendmentFindings"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F1</bpmn:incoming>
      <bpmn:outgoing>Flow_Classified</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Classified" sourceRef="Task_ClassifyAmendment" targetRef="Gate_ApprovalNeeded"/>

    <bpmn:exclusiveGateway id="Gate_ApprovalNeeded" name="QA 承認要?" default="Flow_NoApproval">
      <bpmn:incoming>Flow_Classified</bpmn:incoming>
      <bpmn:outgoing>Flow_Approval</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoApproval</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Approval" sourceRef="Gate_ApprovalNeeded" targetRef="Task_QAReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=effectiveQaApprovalRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoApproval" sourceRef="Gate_ApprovalNeeded" targetRef="Task_AppendAmendment"/>

    <bpmn:userTask id="Task_QAReview" name="QA 変更レビュー">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:open-seiyaku-batch-review-v1"/>
        <zeebe:assignmentDefinition candidateGroups="qa-officer"/>
        <zeebe:taskSchedule dueDate="=now() + duration(&quot;P5D&quot;)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approval</bpmn:incoming>
      <bpmn:outgoing>Flow_F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_F2" sourceRef="Task_QAReview" targetRef="Gate_QAApproved"/>

    <bpmn:exclusiveGateway id="Gate_QAApproved" name="変更承認?" default="Flow_QAReject">
      <bpmn:incoming>Flow_F2</bpmn:incoming>
      <bpmn:outgoing>Flow_QAApprove</bpmn:outgoing>
      <bpmn:outgoing>Flow_QAReject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_QAApprove" sourceRef="Gate_QAApproved" targetRef="Task_AppendAmendment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verdict = "approve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_QAReject" sourceRef="Gate_QAApproved" targetRef="Task_AuditQAReject"/>

    <bpmn:serviceTask id="Task_AuditQAReject" name="audit amendment rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-seiyaku.etzhayyim.com:manufacturing&quot;" target="actor"/>
          <zeebe:input source="=&quot;openSeiyaku.batch.amend.reject&quot;" target="action"/>
          <zeebe:input source="={
              vertexId:          vertexId,
              batchNumber:       batchNumber,
              amendmentType:     amendmentType,
              amendmentRiskTier: amendmentRiskTier,
              findings:          amendmentFindings,
              reviewFindings:    reviewFindings
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_QAReject</bpmn:incoming>
      <bpmn:outgoing>Flow_QARejectLoop</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_QARejectLoop" sourceRef="Task_AuditQAReject" targetRef="Task_AmendForm"/>

    <bpmn:serviceTask id="Task_AppendAmendment" name="変更ログ append">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_seiyaku_batch_confidential&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:              vertexId,
              manufacturer_org_id:    manufacturerOrgId,
              plant_org_id:           plantOrgId,
              master_formula_payload: string(masterFormulaPayload),
              material_payload:       string(materialPayload),
              batch_record_payload:   string(batchRecordPayload),
              quality_payload:        string(qualityPayload),
              deviation_payload:      string(deviationPayload),
              amendment_log:          string(amendmentPayload),
              retention_until:        string(now() + duration(&quot;P3650D&quot;)),
              created_at:             string(now()),
              owner_did:              callerDid,
              sensitivity_ord:        2,
              org_id:                 manufacturerOrgId,
              user_id:                callerDid,
              actor_id:               &quot;sys.bpmn.open-seiyaku&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;replace&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoApproval</bpmn:incoming>
      <bpmn:incoming>Flow_QAApprove</bpmn:incoming>
      <bpmn:outgoing>Flow_F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F3" sourceRef="Task_AppendAmendment" targetRef="Task_UpdateMeta"/>

    <bpmn:serviceTask id="Task_UpdateMeta" name="Tier 1 amendment 反映">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_seiyaku_batch&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:             vertexId,
              manufacturer_org_id:   manufacturerOrgId,
              plant_org_id:          plantOrgId,
              product_code:          productCode,
              batch_number:          batchNumber,
              process_type:          &quot;amend&quot;,
              status:                &quot;amended&quot;,
              batch_hash:            string(batchHash),
              qa_required:           effectiveQaApprovalRequired,
              qa_decision:           if effectiveQaApprovalRequired then string(verdict) else &quot;auto&quot;,
              amendment_risk_tier:   amendmentRiskTier,
              capa_required:         capaRequired,
              amendment_count:       1,
              submitted_at:          string(now()),
              created_at:            string(now()),
              owner_did:             callerDid,
              sensitivity_ord:       1,
              org_id:                manufacturerOrgId,
              user_id:               callerDid,
              actor_id:              &quot;sys.bpmn.open-seiyaku&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;replace&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F3</bpmn:incoming>
      <bpmn:outgoing>Flow_F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F4" sourceRef="Task_UpdateMeta" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit amendment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-seiyaku.etzhayyim.com:manufacturing&quot;" target="actor"/>
          <zeebe:input source="=&quot;openSeiyaku.batch.amend&quot;" target="action"/>
          <zeebe:input source="={
              vertexId:       vertexId,
              batchNumber:    batchNumber,
              amendmentType:  amendmentType,
              requiresQa:     effectiveQaApprovalRequired,
              riskTier:       amendmentRiskTier,
              capaRequired:   capaRequired,
              findings:       amendmentFindings
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F4</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="完了">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
