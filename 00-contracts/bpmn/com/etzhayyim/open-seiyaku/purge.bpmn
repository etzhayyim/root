<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_seiyaku_purge"
    targetNamespace="https://etzhayyim.ai/bpmn/open-seiyaku"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="seiyaku_purge" name="製薬 confidential purge" isExecutable="true">
    <bpmn:startEvent id="StartTimer" name="03:30 daily">
      <bpmn:outgoing>Flow_T</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 30 3 * * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_T" sourceRef="StartTimer" targetRef="Task_FindExpired"/>

    <bpmn:startEvent id="StartManual" name="manual purge">
      <bpmn:outgoing>Flow_M</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_M" sourceRef="StartManual" targetRef="Task_FindExpired"/>

    <bpmn:serviceTask id="Task_FindExpired" name="期限切れ検索">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_open_seiyaku_batch_confidential&quot;" target="table"/>
          <zeebe:input source="=&quot;retention_until &lt; %s&quot;" target="whereExpr"/>
          <zeebe:input source="=[string(now())]" target="whereParams"/>
          <zeebe:input source="=&quot;vertex_id, manufacturer_org_id, plant_org_id&quot;" target="columns"/>
          <zeebe:input source="=200" target="limit"/>
          <zeebe:output source="=rows" target="expiredRows"/>
          <zeebe:output source="=rowCount" target="purgedCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_T</bpmn:incoming>
      <bpmn:incoming>Flow_M</bpmn:incoming>
      <bpmn:outgoing>Flow_F1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F1" sourceRef="Task_FindExpired" targetRef="Gate_HasRows"/>

    <bpmn:exclusiveGateway id="Gate_HasRows" name="対象あり?" default="Flow_NoRows">
      <bpmn:incoming>Flow_F1</bpmn:incoming>
      <bpmn:outgoing>Flow_HasRows</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoRows</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_HasRows" sourceRef="Gate_HasRows" targetRef="Task_PurgeBatch">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=purgedCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoRows" sourceRef="Gate_HasRows" targetRef="Task_AuditNoOp"/>

    <bpmn:serviceTask id="Task_PurgeBatch" name="confidential payload hard delete">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.purgeSeiyakuConfidential"/>
        <zeebe:ioMapping>
          <zeebe:input source="=expiredRows" target="rows"/>
          <zeebe:output source="=deleted" target="deletedCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HasRows</bpmn:incoming>
      <bpmn:outgoing>Flow_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F2" sourceRef="Task_PurgeBatch" targetRef="Task_AuditPurged"/>

    <bpmn:serviceTask id="Task_AuditPurged" name="audit purged">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-seiyaku.etzhayyim.com:manufacturing&quot;" target="actor"/>
          <zeebe:input source="=&quot;openSeiyaku.purge&quot;" target="action"/>
          <zeebe:input source="={
              purgedCount:  purgedCount,
              deletedCount: deletedCount
          }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F2</bpmn:incoming>
      <bpmn:outgoing>Flow_EndA</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndA" sourceRef="Task_AuditPurged" targetRef="End"/>

    <bpmn:serviceTask id="Task_AuditNoOp" name="audit noop">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:open-seiyaku.etzhayyim.com:manufacturing&quot;" target="actor"/>
          <zeebe:input source="=&quot;openSeiyaku.purge.noop&quot;" target="action"/>
          <zeebe:input source="={ purgedCount: 0 }" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoRows</bpmn:incoming>
      <bpmn:outgoing>Flow_EndB</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndB" sourceRef="Task_AuditNoOp" targetRef="End"/>

    <bpmn:endEvent id="End" name="完了">
      <bpmn:incoming>Flow_EndA</bpmn:incoming>
      <bpmn:incoming>Flow_EndB</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
