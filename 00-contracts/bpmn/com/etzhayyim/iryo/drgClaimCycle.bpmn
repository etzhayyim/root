<?xml version="1.0" encoding="UTF-8"?>
<!--
  iryo.etzhayyim.com — DRG claim cycle.

  Two entry shapes:
    1. timer-start (cron 0 0 2 1 * ?) — monthly batch finalize all draft claims
    2. XRPC submitDrgClaim (claim_id-scoped finalize)

  This BPMN handles the XRPC variant; timer batch is a separate
  drgClaimCycleBatch.bpmn (deferred to Phase 1c).
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_iryo_drg_claim_cycle"
    targetNamespace="https://etzhayyim.ai/bpmn/iryo"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="iryo_drg_claim_cycle" name="iryo drg claim cycle" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.iryo.submitDrgClaim", "version": 1, "resultTimeoutMs": 30000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="submitDrgClaim">
      <bpmn:outgoing>Flow_ToFinalize</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Finalize" name="finalize drg claim">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="iryo.claim.finalize"/>
        <zeebe:ioMapping>
          <zeebe:input source="=claimId" target="claimId"/>
          <zeebe:input source="=drgCode" target="drgCode"/>
          <zeebe:input source="=packagePoints" target="packagePoints"/>
          <zeebe:input source="=tariffSystem" target="tariffSystem"/>
          <zeebe:input source="=auditorDid" target="auditorDid"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=claimId" target="claimId"/>
          <zeebe:output source="=status" target="status"/>
          <zeebe:output source="=submittedAtMs" target="submittedAtMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToFinalize</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToFinalize" sourceRef="Start" targetRef="Task_Finalize"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:iryo.etzhayyim.com:hospital&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.iryo.submitDrgClaim&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;claimId&quot;: claimId, &quot;status&quot;: status, &quot;packagePoints&quot;: packagePoints, &quot;tariffSystem&quot;: tariffSystem }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Finalize" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
