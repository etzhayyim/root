<?xml version="1.0" encoding="UTF-8"?>
<!--
  iryo.etzhayyim.com — listEncounters (XRPC com.etzhayyim.apps.iryo.listEncounters).
  Read-only encounter list via iryo.encounter.list.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_iryo_list_encounters"
    targetNamespace="https://etzhayyim.ai/bpmn/iryo"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="iryo_list_encounters" name="iryo list encounters" isExecutable="true">
    <bpmn:documentation>{ "nsid": "com.etzhayyim.apps.iryo.listEncounters", "version": 1, "resultTimeoutMs": 15000 }</bpmn:documentation>
    <bpmn:startEvent id="Start"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="Task_List" name="encounter list">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="iryo.encounter.list"/>
        <zeebe:ioMapping>
          <zeebe:input source="=deptSlug" target="deptSlug"/>
          <zeebe:input source="=wardSlug" target="wardSlug"/>
          <zeebe:input source="=status" target="status"/>
          <zeebe:input source="=admittedAfter" target="admittedAfter"/>
          <zeebe:input source="=admittedBefore" target="admittedBefore"/>
          <zeebe:input source="=limit" target="limit"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=encounters" target="encounters"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_List"/>
    <bpmn:endEvent id="End"><bpmn:incoming>F2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_List" targetRef="End"/>
  </bpmn:process>
</bpmn:definitions>
