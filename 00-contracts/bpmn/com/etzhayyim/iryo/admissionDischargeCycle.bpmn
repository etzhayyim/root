<?xml version="1.0" encoding="UTF-8"?>
<!--
  iryo.etzhayyim.com — admission/discharge cycle.

  Two XRPC entries share a single BPMN through the action input:
    submitEncounter    → action=admit    → encounter.upsert + bed.assign
    dischargeEncounter → action=discharge → encounter.upsert (close) + bed.release + claim.draft

  The input "action" comes from the dispatcher binding for each NSID.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_iryo_admission_discharge_cycle"
    targetNamespace="https://etzhayyim.ai/bpmn/iryo"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="iryo_admission_discharge_cycle" name="iryo admission discharge cycle" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.iryo.submitEncounter", "version": 1, "resultTimeoutMs": 30000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="encounter event">
      <bpmn:outgoing>Flow_ToUpsert</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Upsert" name="upsert vertex_iryo_encounter">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="iryo.encounter.upsert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=action" target="action"/>
          <zeebe:input source="=encounterId" target="encounterId"/>
          <zeebe:input source="=patientDid" target="patientDid"/>
          <zeebe:input source="=hospitalSlug" target="hospitalSlug"/>
          <zeebe:input source="=deptSlug" target="deptSlug"/>
          <zeebe:input source="=wardSlug" target="wardSlug"/>
          <zeebe:input source="=admissionType" target="admissionType"/>
          <zeebe:input source="=ageBand" target="ageBand"/>
          <zeebe:input source="=sex" target="sex"/>
          <zeebe:input source="=severityTier" target="severityTier"/>
          <zeebe:input source="=principalDiagnosisCode" target="principalDiagnosisCode"/>
          <zeebe:input source="=secondaryDiagnosisCodes" target="secondaryDiagnosisCodes"/>
          <zeebe:input source="=drgCode" target="drgCode"/>
          <zeebe:input source="=dischargeDisposition" target="dischargeDisposition"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=encounterId" target="encounterId"/>
          <zeebe:output source="=admittedAtMs" target="admittedAtMs"/>
          <zeebe:output source="=dischargedAtMs" target="dischargedAtMs"/>
          <zeebe:output source="=lengthOfStayDays" target="lengthOfStayDays"/>
          <zeebe:output source="=resolvedAction" target="resolvedAction"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToUpsert</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBedGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToUpsert" sourceRef="Start" targetRef="Task_Upsert"/>

    <bpmn:exclusiveGateway id="Gate_Action" name="admit or discharge?">
      <bpmn:incoming>Flow_ToBedGate</bpmn:incoming>
      <bpmn:outgoing>Flow_Admit</bpmn:outgoing>
      <bpmn:outgoing>Flow_Discharge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToBedGate" sourceRef="Task_Upsert" targetRef="Gate_Action"/>

    <bpmn:sequenceFlow id="Flow_Admit" sourceRef="Gate_Action" targetRef="Task_BedAssign">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=resolvedAction = "admit"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Discharge" sourceRef="Gate_Action" targetRef="Task_BedRelease">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=resolvedAction = "discharge"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_BedAssign" name="assign bed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="iryo.bed.assign"/>
        <zeebe:ioMapping>
          <zeebe:input source="=encounterId" target="encounterId"/>
          <zeebe:input source="=hospitalSlug" target="hospitalSlug"/>
          <zeebe:input source="=wardSlug" target="wardSlug"/>
          <zeebe:output source="=bedSlug" target="bedSlug"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Admit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAuditAdmit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAuditAdmit" sourceRef="Task_BedAssign" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_BedRelease" name="release bed + draft DRG claim">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="iryo.bed.release"/>
        <zeebe:ioMapping>
          <zeebe:input source="=encounterId" target="encounterId"/>
          <zeebe:input source="=hospitalSlug" target="hospitalSlug"/>
          <zeebe:input source="=principalDiagnosisCode" target="principalDiagnosisCode"/>
          <zeebe:input source="=secondaryDiagnosisCodes" target="secondaryDiagnosisCodes"/>
          <zeebe:input source="=drgCode" target="drgCode"/>
          <zeebe:output source="=bedSlug" target="bedSlug"/>
          <zeebe:output source="=claimId" target="claimId"/>
          <zeebe:output source="=drgCode" target="drgCode"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Discharge</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAuditDischarge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAuditDischarge" sourceRef="Task_BedRelease" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:iryo.etzhayyim.com:hospital&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.iryo.encounterEvent&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;encounterId&quot;: encounterId, &quot;action&quot;: resolvedAction, &quot;bedSlug&quot;: bedSlug, &quot;claimId&quot;: claimId, &quot;lengthOfStayDays&quot;: lengthOfStayDays }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAuditAdmit</bpmn:incoming>
      <bpmn:incoming>Flow_ToAuditDischarge</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
