<?xml version="1.0" encoding="UTF-8"?>
<!--
  iryo.etzhayyim.com — getBedOccupancy (XRPC com.etzhayyim.apps.iryo.getBedOccupancy).
  Read-only ward occupancy snapshot via iryo.bed.occupancySnapshot.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_iryo_get_bed_occupancy"
    targetNamespace="https://etzhayyim.ai/bpmn/iryo"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="iryo_get_bed_occupancy" name="iryo get bed occupancy" isExecutable="true">
    <bpmn:documentation>{ "nsid": "com.etzhayyim.apps.iryo.getBedOccupancy", "version": 1, "resultTimeoutMs": 15000 }</bpmn:documentation>
    <bpmn:startEvent id="Start"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="Task_Snapshot" name="bed occupancy snapshot">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="iryo.bed.occupancySnapshot"/>
        <zeebe:ioMapping>
          <zeebe:input source="=deptSlug" target="deptSlug"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=snapshotMs" target="snapshotMs"/>
          <zeebe:output source="=rows" target="rows"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Snapshot"/>
    <bpmn:endEvent id="End"><bpmn:incoming>F2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Snapshot" targetRef="End"/>
  </bpmn:process>
</bpmn:definitions>
