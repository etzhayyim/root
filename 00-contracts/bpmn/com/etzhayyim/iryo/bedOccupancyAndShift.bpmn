<?xml version="1.0" encoding="UTF-8"?>
<!--
  iryo.etzhayyim.com — bed occupancy + shift coverage gap.

  Timer-start R/PT1H. Recomputes bed occupancy snapshot (touches
  vertex_iryo_bed.last_changed_at_ms only when occupancy changes) and
  scans staff_shift for the next 24h to flag coverage gaps.

  No external IO; pure SELECT + UPDATE against RisingWave.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_iryo_bed_occupancy_and_shift"
    targetNamespace="https://etzhayyim.ai/bpmn/iryo"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="iryo_bed_occupancy_and_shift" name="iryo bed occupancy and shift" isExecutable="true">

    <bpmn:documentation>
      { "nsid": null, "version": 1, "trigger": "timer", "schedule": "R/PT1H" }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="hourly tick">
      <bpmn:outgoing>Flow_ToBed</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_Hourly">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">R/PT1H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Bed" name="recompute bed occupancy">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="iryo.bed.recompute_occupancy"/>
        <zeebe:ioMapping>
          <zeebe:output source="=wardsScanned" target="wardsScanned"/>
          <zeebe:output source="=occupancyMin" target="occupancyMin"/>
          <zeebe:output source="=occupancyMax" target="occupancyMax"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToBed</bpmn:incoming>
      <bpmn:outgoing>Flow_ToShift</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToBed" sourceRef="Start" targetRef="Task_Bed"/>

    <bpmn:serviceTask id="Task_Shift" name="scan staff coverage gap">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="iryo.shift.coverage_gap"/>
        <zeebe:ioMapping>
          <zeebe:output source="=shiftsScanned" target="shiftsScanned"/>
          <zeebe:output source="=gapsDetected" target="gapsDetected"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToShift</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToShift" sourceRef="Task_Bed" targetRef="Task_Shift"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:iryo.etzhayyim.com:hospital&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.iryo.bedOccupancyAndShift&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;wardsScanned&quot;: wardsScanned, &quot;shiftsScanned&quot;: shiftsScanned, &quot;gapsDetected&quot;: gapsDetected, &quot;occupancyMin&quot;: occupancyMin, &quot;occupancyMax&quot;: occupancyMax }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Shift" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
