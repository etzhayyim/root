<?xml version="1.0" encoding="UTF-8"?>
<!--
  iryo.etzhayyim.com — coverage (XRPC com.etzhayyim.apps.iryo.coverage).
  Read-only counts via iryo.coverage.snapshot.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_iryo_coverage"
    targetNamespace="https://etzhayyim.ai/bpmn/iryo"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="iryo_coverage" name="iryo coverage" isExecutable="true">
    <bpmn:documentation>{ "nsid": "com.etzhayyim.apps.iryo.coverage", "version": 1, "resultTimeoutMs": 15000 }</bpmn:documentation>
    <bpmn:startEvent id="Start"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="Task_Snapshot" name="coverage snapshot">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="iryo.coverage.snapshot"/>
        <zeebe:ioMapping>
          <zeebe:input source="=asOf" target="asOf"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=asOf" target="asOf"/>
          <zeebe:output source="=hospitals" target="hospitals"/>
          <zeebe:output source="=depts" target="depts"/>
          <zeebe:output source="=wards" target="wards"/>
          <zeebe:output source="=beds" target="beds"/>
          <zeebe:output source="=staff" target="staff"/>
          <zeebe:output source="=encountersOpen" target="encountersOpen"/>
          <zeebe:output source="=encountersClosed" target="encountersClosed"/>
          <zeebe:output source="=drgClaimsOpen" target="drgClaimsOpen"/>
          <zeebe:output source="=drgClaimsClosed" target="drgClaimsClosed"/>
          <zeebe:output source="=lastBedRecomputeMs" target="lastBedRecomputeMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Snapshot"/>
    <bpmn:endEvent id="End"><bpmn:incoming>F2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Snapshot" targetRef="End"/>
  </bpmn:process>
</bpmn:definitions>
