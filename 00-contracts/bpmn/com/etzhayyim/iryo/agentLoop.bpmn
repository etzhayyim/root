<?xml version="1.0" encoding="UTF-8"?>
<!--
  iryo.etzhayyim.com — agentLoop (XRPC com.etzhayyim.apps.iryo.agentLoop).

  Path F unified agent loop entry (ADR 260413). The pyzeebe handler
  iryo.agent.chat:
    1. fetches mv_iryo_bed_occupancy_now + mv_iryo_admission_count_by_dept (rolling 30d)
       + mv_iryo_drg_pnl_daily (last 7d) + recent vertex_iryo_health_kpi
    2. composes an iryo hospital-ops system prompt
    3. calls kotodama.llm.call_tier(tier, system, user)
    4. returns content / model / latency / row counts
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_iryo_agent_loop"
    targetNamespace="https://etzhayyim.ai/bpmn/iryo"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="iryo_agent_loop" name="iryo agent loop" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.iryo.agentLoop", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="agentLoop">
      <bpmn:outgoing>Flow_ToChat</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Chat" name="iryo agent chat (LLM)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="iryo.agent.chat"/>
        <zeebe:ioMapping>
          <zeebe:input source="=prompt" target="prompt"/>
          <zeebe:input source="=tier" target="tier"/>
          <zeebe:input source="=deptFocus" target="deptFocus"/>
          <zeebe:input source="=maxTokens" target="maxTokens"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=content" target="content"/>
          <zeebe:output source="=model" target="model"/>
          <zeebe:output source="=latencyMs" target="latencyMs"/>
          <zeebe:output source="=occupancyRowsUsed" target="occupancyRowsUsed"/>
          <zeebe:output source="=admissionRowsUsed" target="admissionRowsUsed"/>
          <zeebe:output source="=drgPnlRowsUsed" target="drgPnlRowsUsed"/>
          <zeebe:output source="=kpiRowsUsed" target="kpiRowsUsed"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToChat</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToChat" sourceRef="Start" targetRef="Task_Chat"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:iryo.etzhayyim.com:hospital&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.iryo.agentLoop&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;model&quot;: model, &quot;latencyMs&quot;: latencyMs, &quot;occupancyRowsUsed&quot;: occupancyRowsUsed, &quot;admissionRowsUsed&quot;: admissionRowsUsed, &quot;drgPnlRowsUsed&quot;: drgPnlRowsUsed, &quot;kpiRowsUsed&quot;: kpiRowsUsed }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Chat" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
