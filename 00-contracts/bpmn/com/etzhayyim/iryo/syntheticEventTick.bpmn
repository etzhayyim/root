<?xml version="1.0" encoding="UTF-8"?>
<!--
  iryo.etzhayyim.com — synthetic event tick.

  Phase 1 only. Timer-start R/PT15M. Generates ~25 admit/discharge/transfer
  events per tick to keep the 300-bed seed hospital busy enough that MVs
  reach steady state. Disable in Phase 2 by retiring this process_def.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_iryo_synthetic_event_tick"
    targetNamespace="https://etzhayyim.ai/bpmn/iryo"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="iryo_synthetic_event_tick" name="iryo synthetic event tick" isExecutable="true">

    <bpmn:documentation>
      { "nsid": null, "version": 1, "trigger": "timer", "schedule": "R/PT15M", "phase": "1-only" }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="15-min tick">
      <bpmn:outgoing>Flow_ToTick</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_15m">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">R/PT15M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Tick" name="advance synthetic clock">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="iryo.synthetic.advance_clock"/>
        <zeebe:ioMapping>
          <zeebe:output source="=admits" target="admits"/>
          <zeebe:output source="=discharges" target="discharges"/>
          <zeebe:output source="=transfers" target="transfers"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToTick</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToTick" sourceRef="Start" targetRef="Task_Tick"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:iryo.etzhayyim.com:hospital&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.iryo.syntheticTick&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;admits&quot;: admits, &quot;discharges&quot;: discharges, &quot;transfers&quot;: transfers }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Tick" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
