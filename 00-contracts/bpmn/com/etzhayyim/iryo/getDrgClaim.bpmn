<?xml version="1.0" encoding="UTF-8"?>
<!--
  iryo.etzhayyim.com — getDrgClaim (XRPC com.etzhayyim.apps.iryo.getDrgClaim).
  Read-only single-claim lookup via iryo.claim.get.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="Definitions_iryo_get_drg_claim"
    targetNamespace="https://etzhayyim.ai/bpmn/iryo"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="iryo_get_drg_claim" name="iryo get drg claim" isExecutable="true">
    <bpmn:documentation>{ "nsid": "com.etzhayyim.apps.iryo.getDrgClaim", "version": 1, "resultTimeoutMs": 15000 }</bpmn:documentation>
    <bpmn:startEvent id="Start"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="Task_Get" name="claim get">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="iryo.claim.get"/>
        <zeebe:ioMapping>
          <zeebe:input source="=claimId" target="claimId"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=claim" target="claim"/>
          <zeebe:output source="=error" target="error"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Get"/>
    <bpmn:endEvent id="End"><bpmn:incoming>F2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Get" targetRef="End"/>
  </bpmn:process>
</bpmn:definitions>
