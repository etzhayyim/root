<?xml version="1.0" encoding="UTF-8"?>
<!--
  yatabase.etzhayyim.com — putObject workflow (XRPC com.etzhayyim.apps.yata.putObject).
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_yata_put_object"
    targetNamespace="https://etzhayyim.ai/bpmn/yata"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="yata_put_object" name="yata put object" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.yata.putObject", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="putObject">
      <bpmn:outgoing>Flow_ToPut</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Put" name="upload to provider + INSERT vertex_yata_blob">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="yata.storage.put"/>
        <zeebe:ioMapping>
          <zeebe:input source="=bucketName" target="bucketName"/>
          <zeebe:input source="=objectKey" target="objectKey"/>
          <zeebe:input source="=data" target="data"/>
          <zeebe:input source="=contentType" target="contentType"/>
          <zeebe:input source="=encryption" target="encryption"/>
          <zeebe:input source="=vaultMemberDid" target="vaultMemberDid"/>
          <zeebe:input source="=metadataJson" target="metadataJson"/>
          <zeebe:input source="=ifNoneMatch" target="ifNoneMatch"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=blobId" target="blobId"/>
          <zeebe:output source="=etag" target="etag"/>
          <zeebe:output source="=cid" target="cid"/>
          <zeebe:output source="=sizeBytes" target="sizeBytes"/>
          <zeebe:output source="=storageTier" target="storageTier"/>
          <zeebe:output source="=storageProvider" target="storageProvider"/>
          <zeebe:output source="=versionId" target="versionId"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPut</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToPut" sourceRef="Start" targetRef="Task_Put"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:yatabase.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.yata.putObject&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;bucketName&quot;: bucketName, &quot;objectKey&quot;: objectKey, &quot;sizeBytes&quot;: sizeBytes, &quot;storageTier&quot;: storageTier }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Put" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
