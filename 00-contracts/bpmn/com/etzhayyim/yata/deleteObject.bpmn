<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_yata_delete_object"
    targetNamespace="https://etzhayyim.ai/bpmn/yata"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="yata_delete_object" name="yata delete object" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.yata.deleteObject", "version": 1, "resultTimeoutMs": 30000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="deleteObject">
      <bpmn:outgoing>Flow_ToDel</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Del" name="mark deleted / insert delete marker / purge">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="yata.storage.delete"/>
        <zeebe:ioMapping>
          <zeebe:input source="=bucketName" target="bucketName"/>
          <zeebe:input source="=objectKey" target="objectKey"/>
          <zeebe:input source="=versionId" target="versionId"/>
          <zeebe:input source="=purge" target="purge"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=deleteMarkerVersionId" target="deleteMarkerVersionId"/>
          <zeebe:output source="=purged" target="purged"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDel</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToDel" sourceRef="Start" targetRef="Task_Del"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:yatabase.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.yata.deleteObject&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;bucketName&quot;: bucketName, &quot;objectKey&quot;: objectKey, &quot;purged&quot;: purged }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Del" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
