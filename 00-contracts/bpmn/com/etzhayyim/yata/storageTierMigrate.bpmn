<?xml version="1.0" encoding="UTF-8"?>
<!--
  yatabase.etzhayyim.com — storage tier migration (autonomous, cron 0 0 5 * * ? = 05:00 UTC daily).

  For every blob in tier_policy='auto' bucket:
    - last_accessed_at > 30 days ago AND tier='warm' → migrate to 'cold'
      (B2 Standard → B2 Archive). Saves ~70% storage cost.
    - last_accessed_at > 90 days ago AND tier='hot'  → migrate to 'warm'
      (Vultr OS → B2 Standard). Saves ~80% storage cost.

  Migration is byte-copy on B2 / Vultr OS, then update storage_path +
  storage_provider + storage_tier columns on the row. Original blob
  bytes are deleted after the copy is verified by sha256 checksum.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_yata_storage_tier_migrate"
    targetNamespace="https://etzhayyim.ai/bpmn/yata"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="yata_storage_tier_migrate" name="yata storage tier migration (daily 05:00 UTC)" isExecutable="true">

    <bpmn:startEvent id="StartTimer" name="daily 05:00 UTC">
      <bpmn:outgoing>Flow_ToMigrate</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 5 * * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Migrate" name="migrate idle blobs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="yata.storage.tier.migrate"/>
        <zeebe:ioMapping>
          <zeebe:input source="=200" target="batchSize"/>
          <zeebe:output source="=hotToWarm" target="hotToWarm"/>
          <zeebe:output source="=warmToCold" target="warmToCold"/>
          <zeebe:output source="=bytesMigrated" target="bytesMigrated"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToMigrate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToMigrate" sourceRef="StartTimer" targetRef="Task_Migrate"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:yatabase.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.yata.storageTierMigrate&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;hotToWarm&quot;: hotToWarm, &quot;warmToCold&quot;: warmToCold, &quot;bytesMigrated&quot;: bytesMigrated }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Migrate" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
