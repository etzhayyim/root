<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_yata_multipart_complete"
    targetNamespace="https://etzhayyim.ai/bpmn/yata"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="yata_multipart_complete" name="yata multipart complete" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.yata.multipartComplete", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="multipartComplete">
      <bpmn:outgoing>Flow_ToComplete</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Complete" name="provider CompleteMultipartUpload + INSERT vertex_yata_blob">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="yata.storage.multipart.complete"/>
        <zeebe:ioMapping>
          <zeebe:input source="=uploadId" target="uploadId"/>
          <zeebe:input source="=parts" target="parts"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=bucketName" target="bucketName"/>
          <zeebe:output source="=objectKey" target="objectKey"/>
          <zeebe:output source="=blobId" target="blobId"/>
          <zeebe:output source="=etag" target="etag"/>
          <zeebe:output source="=cid" target="cid"/>
          <zeebe:output source="=sizeBytes" target="sizeBytes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToComplete</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToComplete" sourceRef="Start" targetRef="Task_Complete"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:yatabase.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.yata.multipartComplete&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;bucketName&quot;: bucketName, &quot;objectKey&quot;: objectKey, &quot;sizeBytes&quot;: sizeBytes }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Complete" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
