<?xml version="1.0" encoding="UTF-8"?>
<!--
  yatabase.etzhayyim.com — provisionDatabase workflow (XRPC, admin-only).

  Caller MUST be did:web:billing.etzhayyim.com admin or an internal-trust
  provisioning agent (gateway header check). Creates a per-tenant RW
  database `yata_<sha256(orgDid)[:16]>`, dedicated PG ROLE with
  CREATE/USAGE on that DB only, then applies the storage schema
  migration into the new DB so the customer's first SQL session sees
  vertex_yata_* tables alongside their own vertex_* graph tables.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_yata_provision_database"
    targetNamespace="https://etzhayyim.ai/bpmn/yata"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="yata_provision_database" name="yata provision database" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.yata.provisionDatabase", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="provisionDatabase">
      <bpmn:outgoing>Flow_ToProv</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Prov" name="CREATE DATABASE + ROLE + apply schema">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="yata.database.provision"/>
        <zeebe:ioMapping>
          <zeebe:input source="=orgDid" target="orgDid"/>
          <zeebe:input source="=plan" target="plan"/>
          <zeebe:input source="=region" target="region"/>
          <zeebe:input source="=force" target="force"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=dbName" target="dbName"/>
          <zeebe:output source="=endpointUrl" target="endpointUrl"/>
          <zeebe:output source="=pgUser" target="pgUser"/>
          <zeebe:output source="=pgPasswordOnce" target="pgPasswordOnce"/>
          <zeebe:output source="=alreadyExisted" target="alreadyExisted"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToProv</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToProv" sourceRef="Start" targetRef="Task_Prov"/>

    <bpmn:serviceTask id="Task_Audit" name="audit emit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:yatabase.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;com.etzhayyim.apps.yata.provisionDatabase&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;orgDid&quot;: orgDid, &quot;dbName&quot;: dbName, &quot;plan&quot;: plan, &quot;alreadyExisted&quot;: alreadyExisted }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_Prov" targetRef="Task_Audit"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
