<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_yata_run_cypher"
    targetNamespace="https://etzhayyim.ai/bpmn/yata"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="yata_run_cypher" name="yata run cypher" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.yata.runCypher", "version": 2, "resultTimeoutMs": 30000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="runCypher">
      <bpmn:outgoing>Flow_ToRun</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Run" name="translate openCypher → SQL/PGQ + execute">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="yata.cypher.run"/>
        <zeebe:ioMapping>
          <zeebe:input source="=statement" target="statement"/>
          <zeebe:input source="=parametersJson" target="parametersJson"/>
          <zeebe:input source="=format" target="format"/>
          <zeebe:input source="=limit" target="limit"/>
          <zeebe:input source="=timeoutMs" target="timeoutMs"/>
          <zeebe:output source="=ok" target="ok"/>
          <zeebe:output source="=rowCount" target="rowCount"/>
          <zeebe:output source="=columnsJson" target="columnsJson"/>
          <zeebe:output source="=rowsJson" target="rowsJson"/>
          <zeebe:output source="=translatedSql" target="translatedSql"/>
          <zeebe:output source="=elapsedMs" target="elapsedMs"/>
          <zeebe:output source="=error" target="error"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRun</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToRun" sourceRef="Start" targetRef="Task_Run"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Run" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
