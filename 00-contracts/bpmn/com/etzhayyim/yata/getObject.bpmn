<?xml version="1.0" encoding="UTF-8"?>
<!--
  yatabase.etzhayyim.com — getObject workflow (XRPC com.etzhayyim.apps.yata.getObject).
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_yata_get_object"
    targetNamespace="https://etzhayyim.ai/bpmn/yata"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="yata_get_object" name="yata get object" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.yata.getObject", "version": 1, "resultTimeoutMs": 30000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="getObject">
      <bpmn:outgoing>Flow_ToGet</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Get" name="SELECT metadata + (optional) fetch bytes">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="yata.storage.get"/>
        <zeebe:ioMapping>
          <zeebe:input source="=bucketName" target="bucketName"/>
          <zeebe:input source="=objectKey" target="objectKey"/>
          <zeebe:input source="=versionId" target="versionId"/>
          <zeebe:input source="=metadataOnly" target="metadataOnly"/>
          <zeebe:input source="=ifNoneMatch" target="ifNoneMatch"/>
          <zeebe:output source="=blobId" target="blobId"/>
          <zeebe:output source="=etag" target="etag"/>
          <zeebe:output source="=cid" target="cid"/>
          <zeebe:output source="=sizeBytes" target="sizeBytes"/>
          <zeebe:output source="=contentType" target="contentType"/>
          <zeebe:output source="=storageTier" target="storageTier"/>
          <zeebe:output source="=storageProvider" target="storageProvider"/>
          <zeebe:output source="=encryption" target="encryption"/>
          <zeebe:output source="=data" target="data"/>
          <zeebe:output source="=lastAccessedAt" target="lastAccessedAt"/>
          <zeebe:output source="=createdAt" target="createdAt"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToGet</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToGet" sourceRef="Start" targetRef="Task_Get"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Get" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
