<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_yata_presign_url"
    targetNamespace="https://etzhayyim.ai/bpmn/yata"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="yata_presign_url" name="yata presign url" isExecutable="true">

    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.yata.presignUrl", "version": 1, "resultTimeoutMs": 15000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="presignUrl">
      <bpmn:outgoing>Flow_ToSign</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Sign" name="mint SigV4 presigned URL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="yata.storage.presign"/>
        <zeebe:ioMapping>
          <zeebe:input source="=bucketName" target="bucketName"/>
          <zeebe:input source="=objectKey" target="objectKey"/>
          <zeebe:input source="=method" target="method"/>
          <zeebe:input source="=expiresInSec" target="expiresInSec"/>
          <zeebe:input source="=contentType" target="contentType"/>
          <zeebe:input source="=responseContentDisposition" target="responseContentDisposition"/>
          <zeebe:output source="=url" target="url"/>
          <zeebe:output source="=expiresAt" target="expiresAt"/>
          <zeebe:output source="=headers" target="headers"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSign</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToSign" sourceRef="Start" targetRef="Task_Sign"/>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Sign" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
