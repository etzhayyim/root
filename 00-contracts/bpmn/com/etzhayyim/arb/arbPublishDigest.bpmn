<?xml version="1.0" encoding="UTF-8"?>
<!--
  arb.arbPublishDigest — every PT15M, score the highest-edge active proposals
  then publish the top 5 to yoro social with disclaimer + cohort mention.

  EDUCATIONAL ONLY. Worker enforces score >= 0.5 + cohort allowlist + executed=false.

  NSID: com.etzhayyim.apps.arb.publishDigest
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/arb-publish-digest-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_arb_publish_digest"
    targetNamespace="https://etzhayyim.ai/bpmn/arb"
    exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="arb_publish_digest" name="arb publishDigest" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.arb.publishDigest", "version": 1, "resultTimeoutMs": 60000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="every 15 minutes">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_PT15M">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT15M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_Select"/>

    <bpmn:serviceTask id="Task_Select" name="select top-5 active opportunities">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;mv_arb_active_opps&quot;"                 target="table"/>
          <zeebe:input source="=&quot;proposal_id, asset_class, edge_bps, score&quot;" target="columns"/>
          <zeebe:input source="=5"                                              target="limit"/>
          <zeebe:input source="=&quot;edge_bps DESC&quot;"                       target="orderBy"/>
          <zeebe:input source="=&quot;executed = false AND edge_bps &gt;= 20 AND (expires_at IS NULL OR expires_at &gt; CURRENT_TIMESTAMP::varchar)&quot;" target="where"/>
          <zeebe:output source="=rows"     target="topRows"/>
          <zeebe:output source="=rowCount" target="topCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Select" targetRef="Gateway_Has"/>

    <bpmn:exclusiveGateway id="Gateway_Has" name="any?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Has</bpmn:outgoing>
      <bpmn:outgoing>Flow_None</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Has" sourceRef="Gateway_Has" targetRef="Task_Score">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=topCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_None" sourceRef="Gateway_Has" targetRef="End">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=topCount = 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_Score" name="scoreProposal (parallel fan-out)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.http.fetch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;https://arb.etzhayyim.com/xrpc/com.etzhayyim.apps.arb.scoreProposal&quot;" target="url"/>
          <zeebe:input source="=&quot;POST&quot;" target="method"/>
          <zeebe:input source="=&quot;application/json&quot;" target="contentType"/>
          <zeebe:input source="={ &quot;proposalId&quot;: row.proposal_id }" target="body"/>
          <zeebe:input source="=20000" target="timeoutMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Has</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=topRows" inputElement="row"/>
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Score" targetRef="Task_Publish"/>

    <bpmn:serviceTask id="Task_Publish" name="publishProposal (parallel fan-out)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.http.fetch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;https://arb.etzhayyim.com/xrpc/com.etzhayyim.apps.arb.publishProposal&quot;" target="url"/>
          <zeebe:input source="=&quot;POST&quot;" target="method"/>
          <zeebe:input source="=&quot;application/json&quot;" target="contentType"/>
          <zeebe:input source="={ &quot;proposalId&quot;: row.proposal_id, &quot;mentionCohort&quot;: &quot;trader.etzhayyim.com&quot; }" target="body"/>
          <zeebe:input source="=20000" target="timeoutMs"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=topRows" inputElement="row"/>
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Publish" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="emit arb.publishDigest OCEL">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.arb.publishDigest&quot;" target="eventType"/>
          <zeebe:input source="={ &quot;published&quot;: topCount }" target="attributes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_None</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
