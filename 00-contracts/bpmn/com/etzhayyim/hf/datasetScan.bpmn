<?xml version="1.0" encoding="UTF-8"?>
<!--
  hf.datasetScan — daily HuggingFace Hub catalog scan per enabled filter.

  Fires every 24h. Iterates all enabled vertex_hf_filter rows, invokes
  hf.dataset.scan per filter, then fetches splits for newly found datasets.

  NSID: com.etzhayyim.apps.hf.datasetScan
  vertex_id: at://did:web:bpmn.etzhayyim.com/com.etzhayyim.apps.bpmn.processDef/hf-dataset-scan-v1
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_hf_dataset_scan"
    targetNamespace="https://etzhayyim.ai/bpmn/hf"
    exporter="hand-written"
    exporterVersion="2.0">

  <bpmn:process id="hf_dataset_scan" name="HF Dataset Scan" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.hf.datasetScan", "version": 1, "resultTimeoutMs": 300000 }
    </bpmn:documentation>

    <!-- Timer: every 24h -->
    <bpmn:startEvent id="Start" name="every 24h">
      <bpmn:outgoing>Flow_ToListFilters</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_24h">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT24H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToListFilters" sourceRef="Start" targetRef="Task_ListFilters"/>

    <!-- Step 1: fetch enabled filter IDs from RW -->
    <bpmn:serviceTask id="Task_ListFilters" name="list enabled filters">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="hf.dataset.listFilters" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:output source="=filter_ids"   target="filterIds"/>
          <zeebe:output source="=filter_count" target="filterCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToListFilters</bpmn:incoming>
      <bpmn:outgoing>Flow_ToScanAll</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToScanAll" sourceRef="Task_ListFilters" targetRef="Task_ScanAll"/>

    <!-- Step 2: scan HF Hub per filter (serial, respects rate limits) -->
    <bpmn:serviceTask id="Task_ScanAll" name="scan HF Hub per filter">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="hf.dataset.scanAll" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input  source="=filterIds"    target="filter_ids"/>
          <zeebe:output source="=total_scanned" target="totalScanned"/>
          <zeebe:output source="=total_matched" target="totalMatched"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToScanAll</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFetchSplits</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToFetchSplits" sourceRef="Task_ScanAll" targetRef="Task_FetchSplits"/>

    <!-- Step 3: fetch split/parquet metadata for pending datasets -->
    <bpmn:serviceTask id="Task_FetchSplits" name="fetch splits for new datasets">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="hf.dataset.fetchSplitsBatch" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input  source="=50"           target="batch_size"/>
          <zeebe:output source="=splits_total" target="splitsTotal"/>
          <zeebe:output source="=files_total"  target="filesTotal"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToFetchSplits</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_FetchSplits" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
