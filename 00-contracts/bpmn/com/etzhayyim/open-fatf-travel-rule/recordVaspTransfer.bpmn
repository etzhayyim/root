<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_open_fatf_travel_rule_record_vasp_transfer" targetNamespace="https://etzhayyim.ai/bpmn/open-fatf-travel-rule" exporter="hand-written" exporterVersion="1.0">
  <bpmn:process id="open_fatf_travel_rule_record_vasp_transfer" name="recordVaspTransfer" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_S</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_Save"/>
    <bpmn:serviceTask id="Task_Save" name="save">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;vertex_open_fatf_travel_rule&quot;" target="table"/><zeebe:input source="={vertex_id: vertexId, transfer_id: transferId, originator_vasp_lei: originatorVaspLei, beneficiary_vasp_lei: beneficiaryVaspLei, originator_jurisdiction_iso3: originatorJurisdictionIso3, beneficiary_jurisdiction_iso3: beneficiaryJurisdictionIso3, amount_usd: amountUsd, chain: chain, tx_hash: txHash, messaging_protocol: messagingProtocol, transferred_at: transferredAt, risk_tier: if amountUsd &gt;= 1000 and beneficiaryVaspLei = null then &quot;unhosted_wallet&quot; else if amountUsd &gt;= 100000 then &quot;high_value&quot; else &quot;standard&quot;, status: &quot;active&quot;, created_at: string(now()), owner_did: callerDid, sensitivity_ord: 1, org_id: callerDid, user_id: callerDid, actor_id: &quot;sys.bpmn.open-fatf-travel-rule&quot;}" target="values"/><zeebe:input source="=&quot;ignore&quot;" target="onConflict"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming><bpmn:outgoing>Flow_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Task_Save" targetRef="Task_Audit"/>
    <bpmn:serviceTask id="Task_Audit" name="audit">
      <bpmn:extensionElements><zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping><zeebe:input source="=&quot;did:web:open-fatf-travel-rule.etzhayyim.com&quot;" target="actor"/><zeebe:input source="=&quot;open.fatfTravelRule.recordVaspTransfer&quot;" target="action"/><zeebe:input source="={vertexId: vertexId}" target="payload"/></zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>
    <bpmn:endEvent id="End"><bpmn:incoming>Flow_End</bpmn:incoming></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>