<?xml version="1.0" encoding="UTF-8"?>
<!--
  Influence scoring pipeline — pure SQL, no LLM.

  NSID:       com.etzhayyim.apps.businessPerson.scoreInfluence
  Owner DID:  did:web:business-person.etzhayyim.com
  Process ID: business_person_score_influence

  Fires every 24h (R/PT24H).
  Reads mv_influence_centrality, assigns faction_label via hub/bridge heuristic,
  writes vertex_influence_score rows.
  Phase 1: pure SQL centrality (hub_score / bridge_score / gov_score).
  Phase 2 (future): enrichCareerLLM adds career events with confidence≥0.6.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_business_person_score_influence"
    targetNamespace="https://etzhayyim.ai/bpmn/business-person"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="business_person_score_influence" name="business person score influence" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.businessPerson.scoreInfluence", "version": 1, "resultTimeoutMs": 120000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="every 24h">
      <bpmn:outgoing>Flow_ToSelectPersons</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_24h">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT24H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToSelectPersons" sourceRef="Start" targetRef="Task_SelectPersons"/>

    <bpmn:serviceTask id="Task_SelectPersons" name="select persons from centrality MV">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.selectPersonsFromCentralityMv" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:output source="=persons" target="persons"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSelectPersons</bpmn:incoming>
      <bpmn:outgoing>Flow_ToComputeScores</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToComputeScores" sourceRef="Task_SelectPersons" targetRef="Task_ComputeScores"/>

    <bpmn:serviceTask id="Task_ComputeScores" name="compute influence scores">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.computeInfluenceScores" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=persons" target="persons"/>
          <zeebe:output source="=scores" target="scores"/>
          <zeebe:output source="=scoresCount" target="scoresCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToComputeScores</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWriteScores</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToWriteScores" sourceRef="Task_ComputeScores" targetRef="Task_WriteScores"/>

    <bpmn:serviceTask id="Task_WriteScores" name="write influence scores to graph">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.writeInfluenceScores" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=scores" target="scores"/>
          <zeebe:output source="=recordsWritten" target="recordsWritten"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToWriteScores</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_WriteScores" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit influence scoring run">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:business-person.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;businessPerson.scoreInfluence.completed&quot;" target="action"/>
          <zeebe:input source="={scoresCount: scoresCount, recordsWritten: recordsWritten}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="scores written">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
