<?xml version="1.0" encoding="UTF-8"?>
<!--
  Global executive discovery pipeline.

  NSID:       com.etzhayyim.apps.businessPerson.enrichGlobalPersons
  Owner DID:  did:web:business-person.etzhayyim.com
  Process ID: business_person_enrich_global_persons

  Fires every 7 days (R/PT168H).
  For each global target org not yet covered in vertex_business_person:
    1. LLM discovers CISO/CSO/CTO per org
    2. Deduplicate + write new persons to vertex_business_person
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_business_person_enrich_global_persons"
    targetNamespace="https://etzhayyim.ai/bpmn/business-person"
    exporter="hand-written"
    exporterVersion="2.0">
  <bpmn:process id="business_person_enrich_global_persons" name="business person enrich global persons" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.businessPerson.enrichGlobalPersons", "version": 1, "resultTimeoutMs": 600000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="every 7 days">
      <bpmn:outgoing>Flow_ToSelectOrgs</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_168h">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT168H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToSelectOrgs" sourceRef="Start" targetRef="Task_SelectOrgs"/>

    <bpmn:serviceTask id="Task_SelectOrgs" name="select global target orgs not yet covered">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.selectGlobalTargetOrgs" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:output source="=orgs" target="orgs"/>
          <zeebe:output source="=pending" target="pending"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSelectOrgs</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDiscover</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToDiscover" sourceRef="Task_SelectOrgs" targetRef="Task_Discover"/>

    <bpmn:serviceTask id="Task_Discover" name="LLM-discover CISO/CSO/CTO per org">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.discoverGlobalExecs" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=orgs" target="orgs"/>
          <zeebe:output source="=persons" target="persons"/>
          <zeebe:output source="=discovered" target="discovered"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDiscover</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWrite</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToWrite" sourceRef="Task_Discover" targetRef="Task_Write"/>

    <bpmn:serviceTask id="Task_Write" name="write new persons to graph">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.writeGlobalExecs" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=persons" target="persons"/>
          <zeebe:output source="=written" target="written"/>
          <zeebe:output source="=skipped" target="skipped"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToWrite</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Write" targetRef="End"/>

    <bpmn:endEvent id="End" name="done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
