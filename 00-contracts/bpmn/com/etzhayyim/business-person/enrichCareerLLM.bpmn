<?xml version="1.0" encoding="UTF-8"?>
<!--
  LLM-driven career enrichment pipeline (RunPod Serverless).

  NSID:       com.etzhayyim.apps.businessPerson.enrichCareerLLM
  Owner DID:  did:web:business-person.etzhayyim.com
  Process ID: business_person_enrich_career_llm

  Fires every 7 days (R/PT7D).
  Selects persons whose career data is stale (last_enriched_at older than 7d or NULL).
  Fetches news / corporate HP pages, calls RunPod LLM to extract career events,
  writes to vertex_business_person_career_event with:
    confidence = 0.6, verification_status = 'llm_inferred'
  Provenance gate: only writes if rwHealthy and score data already exists in
  vertex_influence_score (Phase 1 scoreInfluence must have run first).
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_business_person_enrich_career_llm"
    targetNamespace="https://etzhayyim.ai/bpmn/business-person"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="business_person_enrich_career_llm" name="business person enrich career LLM" isExecutable="true">
    <bpmn:documentation>
      { "nsid": "com.etzhayyim.apps.businessPerson.enrichCareerLLM", "version": 1, "resultTimeoutMs": 300000 }
    </bpmn:documentation>

    <bpmn:startEvent id="Start" name="every 7 days">
      <bpmn:outgoing>Flow_ToSelectStale</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_7d">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT168H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToSelectStale" sourceRef="Start" targetRef="Task_SelectStale"/>

    <bpmn:serviceTask id="Task_SelectStale" name="select persons needing enrichment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.selectStalePersons" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:output source="=persons" target="persons"/>
          <zeebe:output source="=personsCount" target="personsCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSelectStale</bpmn:incoming>
      <bpmn:outgoing>Flow_ToStaleGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToStaleGate" sourceRef="Task_SelectStale" targetRef="Gateway_HasPersons"/>
    <bpmn:exclusiveGateway id="Gateway_HasPersons" name="has stale persons?">
      <bpmn:incoming>Flow_ToStaleGate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFetchNews</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoPersons</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToFetchNews" sourceRef="Gateway_HasPersons" targetRef="Task_FetchNews">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=personsCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoPersons" sourceRef="Gateway_HasPersons" targetRef="Task_AuditNoPersons"/>

    <bpmn:serviceTask id="Task_FetchNews" name="fetch news and corporate HP pages">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.fetchNewsCareer" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=persons" target="persons"/>
          <zeebe:output source="=pageTexts" target="pageTexts"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToFetchNews</bpmn:incoming>
      <bpmn:outgoing>Flow_ToExtractLLM</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToExtractLLM" sourceRef="Task_FetchNews" targetRef="Task_ExtractLLM"/>

    <bpmn:serviceTask id="Task_ExtractLLM" name="extract career events via RunPod LLM">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.extractCareerLLM" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="=pageTexts" target="pageTexts"/>
          <zeebe:input source="=persons" target="persons"/>
          <zeebe:output source="=extractions" target="extractions"/>
          <zeebe:output source="=extractionsCount" target="extractionsCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToExtractLLM</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWriteCareer</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToWriteCareer" sourceRef="Task_ExtractLLM" targetRef="Task_WriteCareer"/>

    <bpmn:serviceTask id="Task_WriteCareer" name="write career enrichment to graph">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.writeCareerEnrichment" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=extractions" target="extractions"/>
          <zeebe:output source="=recordsWritten" target="recordsWritten"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToWriteCareer</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAudit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToAudit" sourceRef="Task_WriteCareer" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit LLM career enrichment run">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:business-person.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;businessPerson.enrichCareerLLM.completed&quot;" target="action"/>
          <zeebe:input source="={personsCount: personsCount, extractionsCount: extractionsCount, recordsWritten: recordsWritten}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:serviceTask id="Task_AuditNoPersons" name="audit no stale persons">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:business-person.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;businessPerson.enrichCareerLLM.abort&quot;" target="action"/>
          <zeebe:input source="={reason: &quot;no_stale_persons&quot;, personsCount: personsCount}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoPersons</bpmn:incoming>
      <bpmn:outgoing>Flow_NoPersonsEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_NoPersonsEnd" sourceRef="Task_AuditNoPersons" targetRef="End"/>

    <bpmn:endEvent id="End" name="enrichment written">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
      <bpmn:incoming>Flow_NoPersonsEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
