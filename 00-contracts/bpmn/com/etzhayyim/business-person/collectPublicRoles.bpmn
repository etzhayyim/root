<?xml version="1.0" encoding="UTF-8"?>
<!--
  Business person public-role ingest wrapper.

  NSID:       com.etzhayyim.apps.businessPerson.collectPublicRoles
  Owner DID:  did:web:business-person.etzhayyim.com
  Process ID: business_person_collect_public_roles

  This process starts public-only collection jobs through the business-person
  PDS app and gates graph consumption on RisingWave health/visibility.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_business_person_collect_public_roles"
    targetNamespace="https://etzhayyim.ai/bpmn/business-person"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="business_person_collect_public_roles" name="business person collect public roles" isExecutable="true">
    <bpmn:startEvent id="Start" name="collection requested">
      <bpmn:outgoing>Flow_PlanSources</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_PlanSources" sourceRef="Start" targetRef="Task_PlanSources"/>

    <bpmn:serviceTask id="Task_PlanSources" name="plan public role sources">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.planPublicRoleSources" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PlanSources</bpmn:incoming>
      <bpmn:outgoing>Flow_DispatchCollectionJobs</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_DispatchCollectionJobs" sourceRef="Task_PlanSources" targetRef="Task_DispatchCollectionJobs"/>

    <bpmn:serviceTask id="Task_DispatchCollectionJobs" name="dispatch public collection jobs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.atproto.repo.createRecord&quot;" target="type"/>
          <zeebe:input source="={repo: &quot;did:web:business-person.etzhayyim.com&quot;, collection: &quot;com.etzhayyim.apps.businessPerson.collectionJob&quot;, record: {sourceId: sourceId, sourceUrl: sourceUrl, jurisdiction: jurisdiction, format: format, limit: limit, publicOnly: true, requestedBy: operatorDid}}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DispatchCollectionJobs</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepareSourceRequest</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_PrepareSourceRequest" sourceRef="Task_DispatchCollectionJobs" targetRef="Task_PrepareSourceRequest"/>

    <bpmn:serviceTask id="Task_PrepareSourceRequest" name="prepare source request">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.prepareSourceRequest" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PrepareSourceRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_FetchPublicSource</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_FetchPublicSource" sourceRef="Task_PrepareSourceRequest" targetRef="Task_FetchPublicSource"/>

    <bpmn:serviceTask id="Task_FetchPublicSource" name="fetch public source payload">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.fetchPublicSource" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FetchPublicSource</bpmn:incoming>
      <bpmn:outgoing>Flow_AdvanceSourceCursor</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AdvanceSourceCursor" sourceRef="Task_FetchPublicSource" targetRef="Task_AdvanceSourceCursor"/>

    <bpmn:serviceTask id="Task_AdvanceSourceCursor" name="advance source cursor">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.advanceSourceCursor" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AdvanceSourceCursor</bpmn:incoming>
      <bpmn:outgoing>Flow_ScheduleNextPage</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ScheduleNextPage" sourceRef="Task_AdvanceSourceCursor" targetRef="Task_ScheduleNextPage"/>

    <bpmn:serviceTask id="Task_ScheduleNextPage" name="schedule next source page">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.scheduleNextPage" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ScheduleNextPage</bpmn:incoming>
      <bpmn:outgoing>Flow_ExtractCorporateHpRoles</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ExtractCorporateHpRoles" sourceRef="Task_ScheduleNextPage" targetRef="Task_ExtractCorporateHpRoles"/>

    <bpmn:serviceTask id="Task_ExtractCorporateHpRoles" name="extract corporate HP public roles">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.extractCorporateHpRoles" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ExtractCorporateHpRoles</bpmn:incoming>
      <bpmn:outgoing>Flow_ExtractCompaniesHouseOfficers</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ExtractCompaniesHouseOfficers" sourceRef="Task_ExtractCorporateHpRoles" targetRef="Task_ExtractCompaniesHouseOfficers"/>

    <bpmn:serviceTask id="Task_ExtractCompaniesHouseOfficers" name="extract Companies House officers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.extractCompaniesHouseOfficers" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ExtractCompaniesHouseOfficers</bpmn:incoming>
      <bpmn:outgoing>Flow_ExtractGbizinfoRepresentatives</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ExtractGbizinfoRepresentatives" sourceRef="Task_ExtractCompaniesHouseOfficers" targetRef="Task_ExtractGbizinfoRepresentatives"/>

    <bpmn:serviceTask id="Task_ExtractGbizinfoRepresentatives" name="extract gBizINFO representatives">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.extractGbizinfoRepresentatives" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ExtractGbizinfoRepresentatives</bpmn:incoming>
      <bpmn:outgoing>Flow_ExtractEdinetOfficers</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ExtractEdinetOfficers" sourceRef="Task_ExtractGbizinfoRepresentatives" targetRef="Task_ExtractEdinetOfficers"/>

    <bpmn:serviceTask id="Task_ExtractEdinetOfficers" name="extract EDINET officers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.extractEdinetOfficers" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ExtractEdinetOfficers</bpmn:incoming>
      <bpmn:outgoing>Flow_ExtractSecEdgarOfficers</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ExtractSecEdgarOfficers" sourceRef="Task_ExtractEdinetOfficers" targetRef="Task_ExtractSecEdgarOfficers"/>

    <bpmn:serviceTask id="Task_ExtractSecEdgarOfficers" name="extract SEC EDGAR officers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.extractSecEdgarOfficers" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ExtractSecEdgarOfficers</bpmn:incoming>
      <bpmn:outgoing>Flow_ExtractHandelsregisterOfficers</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ExtractHandelsregisterOfficers" sourceRef="Task_ExtractSecEdgarOfficers" targetRef="Task_ExtractHandelsregisterOfficers"/>

    <bpmn:serviceTask id="Task_ExtractHandelsregisterOfficers" name="extract Handelsregister officers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.extractHandelsregisterOfficers" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ExtractHandelsregisterOfficers</bpmn:incoming>
      <bpmn:outgoing>Flow_NormalizePublicRoles</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_NormalizePublicRoles" sourceRef="Task_ExtractHandelsregisterOfficers" targetRef="Task_NormalizePublicRoles"/>

    <bpmn:serviceTask id="Task_NormalizePublicRoles" name="normalize public roles">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.normalizePublicRoles" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NormalizePublicRoles</bpmn:incoming>
      <bpmn:outgoing>Flow_Health</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Health" sourceRef="Task_NormalizePublicRoles" targetRef="Task_Health"/>

    <bpmn:serviceTask id="Task_Health" name="rw health gate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="rw.health.probe" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:output source="=healthy" target="rwHealthy"/>
          <zeebe:output source="=reason" target="rwHealthReason"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Health</bpmn:incoming>
      <bpmn:outgoing>Flow_HealthGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_HealthGate" sourceRef="Task_Health" targetRef="Gateway_RwHealthy"/>

    <bpmn:exclusiveGateway id="Gateway_RwHealthy" name="RisingWave healthy?" default="Flow_RwDegraded">
      <bpmn:incoming>Flow_HealthGate</bpmn:incoming>
      <bpmn:outgoing>Flow_WriteGraph</bpmn:outgoing>
      <bpmn:outgoing>Flow_RwDegraded</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_WriteGraph" sourceRef="Gateway_RwHealthy" targetRef="Task_WriteGraph">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rwHealthy = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RwDegraded" sourceRef="Gateway_RwHealthy" targetRef="Task_AuditRwDegraded"/>

    <bpmn:serviceTask id="Task_WriteGraph" name="write public-role graph">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.writeGraph" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="=false" target="dryRun"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_WriteGraph</bpmn:incoming>
      <bpmn:outgoing>Flow_VerifyCoverage</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_VerifyCoverage" sourceRef="Task_WriteGraph" targetRef="Task_VerifyCoverage"/>

    <bpmn:serviceTask id="Task_VerifyCoverage" name="verify public-role coverage">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="businessPerson.verifyCoverage" retries="2"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_VerifyCoverage</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_VerifyCoverage" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_AuditRwDegraded" name="audit rw degraded">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:business-person.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;businessPerson.collectPublicRoles.rwDegraded&quot;" target="action"/>
          <zeebe:input source="={sourceId: sourceId, jurisdiction: jurisdiction, sourceUrl: sourceUrl, publicOnly: true, rwHealthy: rwHealthy, rwHealthReason: rwHealthReason}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RwDegraded</bpmn:incoming>
      <bpmn:outgoing>Flow_DegradedEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_DegradedEnd" sourceRef="Task_AuditRwDegraded" targetRef="End"/>

    <bpmn:serviceTask id="Task_Audit" name="audit public-role collection">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit" retries="2"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:business-person.etzhayyim.com&quot;" target="actor"/>
          <zeebe:input source="=&quot;businessPerson.collectPublicRoles.completed&quot;" target="action"/>
          <zeebe:input source="={sourceId: sourceId, jurisdiction: jurisdiction, sourceUrl: sourceUrl, publicOnly: true}" target="payload"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="collection queued">
      <bpmn:incoming>Flow_End</bpmn:incoming>
      <bpmn:incoming>Flow_DegradedEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
