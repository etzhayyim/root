<?xml version="1.0" encoding="UTF-8"?>
<!--
  ADR-0056 — gstr3b_file_return.

  gst-officer form input → Tier 3 INSERT → Tier 1 INSERT → finance-controller
  review → XOR → portal-await user task → mark filed (with ARN) → kaikei
  propagate → audit.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_gstr3b_file_return"
    targetNamespace="https://etzhayyim.ai/bpmn/gstr3b"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="gstr3b_file_return" name="GSTR-3B file return" isExecutable="true">

    <bpmn:startEvent id="Start" name="Start">
      <bpmn:outgoing>Flow_S</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_FormInput"/>

    <bpmn:userTask id="Task_FormInput" name="GSTR-3B form input">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:gstr3b-form-v1"/>
        <zeebe:assignmentDefinition candidateGroups="gst-officer"/>
        <zeebe:taskSchedule dueDate="=now() + duration(&quot;P10D&quot;)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming>
      <bpmn:incoming>Flow_LoopBack</bpmn:incoming>
      <bpmn:outgoing>Flow_F1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_F1" sourceRef="Task_FormInput" targetRef="Task_PersistDraft"/>

    <bpmn:serviceTask id="Task_PersistDraft" name="Persist Tier 3 GSTR-3B data">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_gstr3b_return_pii&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:               vertexId,
              gstin_hash:              gstinHash,
              applicant_payload:       string(applicantPayload),
              supplies_payload:        string(suppliesPayload),
              itc_payload:             string(itcPayload),
              tax_payment_payload:     string(taxPaymentPayload),
              amendment_log:           &quot;[]&quot;,
              retention_until:         date and time(date(&quot;9999-12-31&quot;), time(&quot;00:00:00&quot;)),
              created_at:              string(now()),
              owner_did:               filerDid,
              sensitivity_ord:         3,
              org_id:                  gstinHash,
              user_id:                 filerDid,
              actor_id:                &quot;sys.bpmn.gstr3b&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F1</bpmn:incoming>
      <bpmn:outgoing>Flow_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F2" sourceRef="Task_PersistDraft" targetRef="Task_PersistTier1"/>

    <bpmn:serviceTask id="Task_PersistTier1" name="Persist Tier 1 totals">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_gstr3b_return&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:                       vertexId,
              gstin_hash:                      gstinHash,
              tax_period:                      taxPeriod,
              process_type:                    &quot;initial&quot;,
              status:                          &quot;draft&quot;,
              filing_hash:                     string(filingHash),
              total_outward_tax_inr_paise:     totalOutwardTaxInrPaise,
              total_inward_itc_inr_paise:      totalInwardItcInrPaise,
              total_net_tax_inr_paise:         totalNetTaxInrPaise,
              filing_frequency:                string(applicant.filingFrequency),
              created_at:                      string(now()),
              owner_did:                       filerDid,
              sensitivity_ord:                 1,
              org_id:                          gstinHash,
              user_id:                         filerDid,
              actor_id:                        &quot;sys.bpmn.gstr3b&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F2</bpmn:incoming>
      <bpmn:outgoing>Flow_F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F3" sourceRef="Task_PersistTier1" targetRef="Task_FinanceReview"/>

    <bpmn:userTask id="Task_FinanceReview" name="Finance review">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:gstr3b-review-v1"/>
        <zeebe:assignmentDefinition candidateGroups="finance-controller"/>
        <zeebe:taskSchedule dueDate="=now() + duration(&quot;P5D&quot;)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F3</bpmn:incoming>
      <bpmn:outgoing>Flow_F4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_F4" sourceRef="Task_FinanceReview" targetRef="Gate_Approved"/>

    <bpmn:exclusiveGateway id="Gate_Approved" name="Approved?" default="Flow_LoopBack">
      <bpmn:incoming>Flow_F4</bpmn:incoming>
      <bpmn:outgoing>Flow_AwaitArn</bpmn:outgoing>
      <bpmn:outgoing>Flow_LoopBack</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_AwaitArn" sourceRef="Gate_Approved" targetRef="Task_AwaitArn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verdict.decision = "approve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_LoopBack" sourceRef="Gate_Approved" targetRef="Task_FormInput"/>

    <bpmn:userTask id="Task_AwaitArn" name="File on portal + enter ARN">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="gst-officer"/>
        <zeebe:taskSchedule dueDate="=now() + duration(&quot;P5D&quot;)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AwaitArn</bpmn:incoming>
      <bpmn:outgoing>Flow_F5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_F5" sourceRef="Task_AwaitArn" targetRef="Task_MarkFiled"/>

    <bpmn:serviceTask id="Task_MarkFiled" name="Mark filed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_gstr3b_return&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:                       vertexId,
              gstin_hash:                      gstinHash,
              tax_period:                      taxPeriod,
              process_type:                    &quot;initial&quot;,
              status:                          &quot;filed&quot;,
              filing_hash:                     string(filingHash),
              total_outward_tax_inr_paise:     totalOutwardTaxInrPaise,
              total_inward_itc_inr_paise:      totalInwardItcInrPaise,
              total_net_tax_inr_paise:         totalNetTaxInrPaise,
              filing_frequency:                string(applicant.filingFrequency),
              arn:                             string(arn),
              filed_via:                       string(filedVia),
              filed_at:                        string(now()),
              created_at:                      string(now()),
              owner_did:                       filerDid,
              sensitivity_ord:                 1,
              org_id:                          gstinHash,
              user_id:                         filerDid,
              actor_id:                        &quot;sys.bpmn.gstr3b&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;replace&quot;" target="onConflict"/>
          <zeebe:output source="=&quot;filed&quot;" target="finalStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F5</bpmn:incoming>
      <bpmn:outgoing>Flow_Kaikei</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Kaikei" sourceRef="Task_MarkFiled" targetRef="Task_PropagateKaikei"/>

    <bpmn:serviceTask id="Task_PropagateKaikei" name="Propagate GST payable to kaikei">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.kaikei.recordGstPayable&quot;" target="type"/>
          <zeebe:input source="={
              gstinHash:                       gstinHash,
              taxPeriod:                       taxPeriod,
              totalOutwardTaxInrPaise:         totalOutwardTaxInrPaise,
              totalInwardItcInrPaise:          totalInwardItcInrPaise,
              totalNetTaxInrPaise:             totalNetTaxInrPaise,
              triggerVertexId:                 vertexId,
              triggerSource:                   &quot;com.etzhayyim.apps.gstr3b.fileReturn&quot;,
              arn:                             string(arn)
          }" target="payload"/>
          <zeebe:input source="=&quot;did:web:ind.union.etzhayyim.com:cbic:gstr3b&quot;" target="callerDid"/>
          <zeebe:output source="=ok" target="kaikeiPropagated"/>
          <zeebe:output source="=status" target="kaikeiHttpStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Kaikei</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_PropagateKaikei" targetRef="Task_AuditFiled"/>

    <bpmn:serviceTask id="Task_AuditFiled" name="audit: filed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:ind.union.etzhayyim.com:cbic:gstr3b&quot;" target="actor"/>
          <zeebe:input source="=&quot;gstr3b.fileReturn&quot;" target="action"/>
          <zeebe:input source="={
              vertexId:                vertexId,
              gstinHash:               gstinHash,
              taxPeriod:               taxPeriod,
              arn:                     string(arn),
              filedVia:                string(filedVia),
              totalNetTaxInrPaise:     totalNetTaxInrPaise,
              kaikeiPropagated:        kaikeiPropagated
          }" target="payload"/>
          <zeebe:output source="=rkey" target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_AuditFiled" targetRef="End"/>

    <bpmn:endEvent id="End" name="Done">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
