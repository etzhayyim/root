<?xml version="1.0" encoding="UTF-8"?>
<!--
  ADR-0056 — gstr3b_amend.

  DRC-03 voluntary disclosure / correction. Loads predecessor filed
  return, captures delta + interest + late fee, marks new vertex
  status='amended' linked via predecessor_vertex_id, and triggers
  kaikei delta journal.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_gstr3b_amend"
    targetNamespace="https://etzhayyim.ai/bpmn/gstr3b"
    exporter="hand-written"
    exporterVersion="1.0">
  <bpmn:process id="gstr3b_amend" name="GSTR-3B DRC-03 amendment" isExecutable="true">

    <bpmn:startEvent id="Start" name="DRC-03">
      <bpmn:outgoing>Flow_S</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S" sourceRef="Start" targetRef="Task_LoadPredecessor"/>

    <bpmn:serviceTask id="Task_LoadPredecessor" name="Load predecessor filed return">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.select"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_gstr3b_return&quot;" target="table"/>
          <zeebe:input source="=&quot;vertex_id = %s&quot;" target="whereExpr"/>
          <zeebe:input source="=[predecessorVertexId]" target="whereParams"/>
          <zeebe:input source="=&quot;vertex_id, gstin_hash, tax_period, arn, status, amendment_count&quot;" target="columns"/>
          <zeebe:input source="=1" target="limit"/>
          <zeebe:output source="=rows" target="predRows"/>
          <zeebe:output source="=rowCount" target="predCount"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S</bpmn:incoming>
      <bpmn:outgoing>Flow_F1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F1" sourceRef="Task_LoadPredecessor" targetRef="Task_FormAmend"/>

    <bpmn:userTask id="Task_FormAmend" name="DRC-03 form (deltas only)">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:gstr3b-amend-v1"/>
        <zeebe:assignmentDefinition candidateGroups="gst-officer"/>
        <zeebe:taskSchedule dueDate="=now() + duration(&quot;P14D&quot;)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F1</bpmn:incoming>
      <bpmn:outgoing>Flow_F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_F2" sourceRef="Task_FormAmend" targetRef="Task_AppendLog"/>

    <bpmn:serviceTask id="Task_AppendLog" name="Append amendment_log (Tier 3)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_gstr3b_return_pii&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:               vertexId + &quot;:amend:&quot; + string(now()),
              gstin_hash:              if predCount &gt; 0 then string(predRows[1].gstin_hash) else &quot;&quot;,
              applicant_payload:       &quot;&quot;,
              supplies_payload:        &quot;&quot;,
              itc_payload:             &quot;&quot;,
              tax_payment_payload:     &quot;&quot;,
              amendment_log:           string(amendmentPayload),
              retention_until:         date and time(date(&quot;9999-12-31&quot;), time(&quot;00:00:00&quot;)),
              created_at:              string(now()),
              owner_did:               filerDid,
              sensitivity_ord:         3,
              org_id:                  if predCount &gt; 0 then string(predRows[1].gstin_hash) else &quot;&quot;,
              user_id:                 filerDid,
              actor_id:                &quot;sys.bpmn.gstr3b.amend&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;ignore&quot;" target="onConflict"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F2</bpmn:incoming>
      <bpmn:outgoing>Flow_F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F3" sourceRef="Task_AppendLog" targetRef="Task_MarkAmended"/>

    <bpmn:serviceTask id="Task_MarkAmended" name="Mark new vertex as amended + chain">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.db.insert"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;vertex_gstr3b_return&quot;" target="table"/>
          <zeebe:input source="={
              vertex_id:                       vertexId,
              gstin_hash:                      if predCount &gt; 0 then string(predRows[1].gstin_hash) else &quot;&quot;,
              tax_period:                      if predCount &gt; 0 then string(predRows[1].tax_period) else &quot;&quot;,
              process_type:                    &quot;amend&quot;,
              status:                          &quot;amended&quot;,
              filing_hash:                     &quot;amend:&quot; + string(now()),
              predecessor_vertex_id:           predecessorVertexId,
              amendment_reason:                string(amendmentMeta.amendmentReason),
              amendment_count:                 if predCount &gt; 0 then number(predRows[1].amendment_count) + 1 else 1,
              total_outward_tax_inr_paise:     0,
              total_inward_itc_inr_paise:      0,
              total_net_tax_inr_paise:         number(deltas.totalDeltaInrPaise),
              created_at:                      string(now()),
              owner_did:                       filerDid,
              sensitivity_ord:                 1,
              org_id:                          if predCount &gt; 0 then string(predRows[1].gstin_hash) else &quot;&quot;,
              user_id:                         filerDid,
              actor_id:                        &quot;sys.bpmn.gstr3b.amend&quot;
          }" target="values"/>
          <zeebe:input source="=&quot;replace&quot;" target="onConflict"/>
          <zeebe:output source="=&quot;amended&quot;" target="finalStatus"/>
          <zeebe:output source="=number(deltas.totalDeltaInrPaise)" target="deltaTaxInrPaise"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F3</bpmn:incoming>
      <bpmn:outgoing>Flow_F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_F4" sourceRef="Task_MarkAmended" targetRef="Task_PropagateKaikei"/>

    <bpmn:serviceTask id="Task_PropagateKaikei" name="kaikei delta journal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.pds.dispatch"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;com.etzhayyim.apps.kaikei.recordGstPayable&quot;" target="type"/>
          <zeebe:input source="={
              gstinHash:               if predCount &gt; 0 then string(predRows[1].gstin_hash) else &quot;&quot;,
              taxPeriod:               if predCount &gt; 0 then string(predRows[1].tax_period) else &quot;&quot;,
              triggerVertexId:         vertexId,
              triggerSource:           &quot;com.etzhayyim.apps.gstr3b.fileAmendment&quot;,
              amendmentReason:         string(amendmentMeta.amendmentReason),
              deltaTaxInrPaise:        number(deltas.totalDeltaInrPaise)
          }" target="payload"/>
          <zeebe:input source="=&quot;did:web:ind.union.etzhayyim.com:cbic:gstr3b&quot;" target="callerDid"/>
          <zeebe:output source="=ok" target="kaikeiPropagated"/>
          <zeebe:output source="=status" target="kaikeiHttpStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_F4</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_PropagateKaikei" targetRef="Task_Audit"/>

    <bpmn:serviceTask id="Task_Audit" name="audit: amended">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generic.audit.emit"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;did:web:ind.union.etzhayyim.com:cbic:gstr3b&quot;" target="actor"/>
          <zeebe:input source="=&quot;gstr3b.fileAmendment&quot;" target="action"/>
          <zeebe:input source="={
              vertexId:               vertexId,
              predecessorVertexId:    predecessorVertexId,
              amendmentReason:        string(amendmentMeta.amendmentReason),
              deltaTaxInrPaise:       number(deltas.totalDeltaInrPaise),
              kaikeiPropagated:       kaikeiPropagated
          }" target="payload"/>
          <zeebe:output source="=rkey" target="auditRkey"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Audit" targetRef="End"/>

    <bpmn:endEvent id="End" name="Done">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
