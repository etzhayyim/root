<?xml version="1.0" encoding="UTF-8"?>
<!--
  outlookTriage — Outlook メール自動仕分けプロセス

  BPMN process id : outlook_triage
  Task types      : outlook.triage (→ pymagatama.agents.outlook_triage.register)
                    outlook.email.route (→ pymagatama.primitives.email_route.register)
  Engine          : SpiffWorkflow (ADR-2605081200) / Zeebe compat exporter
  Trigger         : TimerStartEvent every 5 minutes (ISO 8601 repeat)
  Owner DID       : did:web:pregel.gftd.ai

  Flow
  ────
  TimerStart → Triage (classify untriaged emails) → XOR (cleanCount > 0)
                ├── yes → RouteClean (email → projector convo)
                └── no  ┐
                         └─→ End
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_outlook_triage"
    targetNamespace="https://gftd.ai/bpmn/outlook"
    exporter="hand-written"
    exporterVersion="1.0">

  <bpmn:process id="outlook_triage" name="Outlook メール自動仕分け" isExecutable="true">

    <!-- ── Timer start (every 5 min) ──────────────────────────────────── -->
    <bpmn:startEvent id="Start" name="5分タイマー">
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT5M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
      <bpmn:outgoing>Flow_S_Triage</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S_Triage" sourceRef="Start" targetRef="Task_Triage"/>

    <!-- ── Triage: classify untriaged emails ──────────────────────────── -->
    <bpmn:serviceTask id="Task_Triage" name="Outlook メール仕分け">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="outlook.triage"/>
        <zeebe:ioMapping>
          <!-- batchSize / accountDid can be overridden per process instance -->
          <zeebe:input  source="=batchSize  != null ? batchSize  : 50"  target="batchSize"/>
          <zeebe:input  source="=accountDid != null ? accountDid : &quot;&quot;" target="accountDid"/>
          <zeebe:output source="=triagedTotal" target="triagedTotal"/>
          <zeebe:output source="=cleanTotal"   target="cleanTotal"/>
          <zeebe:output source="=spamTotal"    target="spamTotal"/>
          <zeebe:output source="=llmCalls"     target="llmCalls"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S_Triage</bpmn:incoming>
      <bpmn:outgoing>Flow_Triage_XOR</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Triage_XOR" sourceRef="Task_Triage" targetRef="XOR_HasClean"/>

    <!-- ── XOR: any clean emails to route? ───────────────────────────── -->
    <bpmn:exclusiveGateway id="XOR_HasClean" name="クリーンメール有り？">
      <bpmn:incoming>Flow_Triage_XOR</bpmn:incoming>
      <bpmn:outgoing>Flow_XOR_Route</bpmn:outgoing>
      <bpmn:outgoing>Flow_XOR_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_XOR_Route" name="yes" sourceRef="XOR_HasClean" targetRef="Task_Route">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=cleanTotal > 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_XOR_End" name="no" sourceRef="XOR_HasClean" targetRef="End">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=cleanTotal = 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- ── Route clean emails → projector convos ─────────────────────── -->
    <bpmn:serviceTask id="Task_Route" name="プロジェクターへ振り分け">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="outlook.email.route"/>
        <zeebe:ioMapping>
          <zeebe:input  source="=batchSize  != null ? batchSize  : 100" target="batchSize"/>
          <zeebe:input  source="=accountDid != null ? accountDid : &quot;&quot;" target="accountDid"/>
          <zeebe:output source="=routedTotal"  target="routedTotal"/>
          <zeebe:output source="=skippedTotal" target="skippedTotal"/>
          <zeebe:output source="=errors"       target="routeErrors"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_XOR_Route</bpmn:incoming>
      <bpmn:outgoing>Flow_Route_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Route_End" sourceRef="Task_Route" targetRef="End"/>

    <!-- ── End ───────────────────────────────────────────────────────── -->
    <bpmn:endEvent id="End" name="完了">
      <bpmn:incoming>Flow_XOR_End</bpmn:incoming>
      <bpmn:incoming>Flow_Route_End</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
