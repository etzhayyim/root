<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="ChildhoodVaccinationCHN" targetNamespace="http://etzhayyim.com/gov/CHN/health/vaccination">
  <bpmn:process id="Process_ChildhoodVaccination" isExecutable="true">
    <bpmn:startEvent id="Start_VaccinationSchedule" name="Child reaches vaccination age"/>
    <bpmn:task id="Task_RegisterChild" name="Register child in vaccination system"/>
    <bpmn:task id="Task_ScheduleAppointment" name="Schedule vaccination appointment"/>
    <bpmn:task id="Task_AdministerVaccine" name="Administer vaccine dose"/>
    <bpmn:task id="Task_RecordInRegistry" name="Record vaccination in provincial registry"/>
    <bpmn:exclusiveGateway id="Gateway_ScheduleNext" name="Next dose needed?"/>
    <bpmn:endEvent id="End_VaccinationComplete" name="Vaccination series complete"/>
  </bpmn:process>
</bpmn:definitions>
