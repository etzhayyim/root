        <inputEntry id="LitRule_5_ie00"><text>-</text></inputEntry>
        <inputEntry id="LitRule_5_ie01"><text>&gt; 0</text></inputEntry>
        <inputEntry id="LitRule_5_ie1"><text>"disposition"</text></inputEntry>
        <inputEntry id="LitRule_5_ie2"><text>"revocation"</text></inputEntry>
