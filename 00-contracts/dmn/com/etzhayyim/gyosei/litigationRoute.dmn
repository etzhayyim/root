      <rule id="LitRule_4">
        <inputEntry id="LitRule_4_ie0"><text>-</text></inputEntry>
        <inputEntry id="LitRule_4_ie00"><text>-</text></inputEntry>
        <inputEntry id="LitRule_4_ie01"><text>&gt; 0</text></inputEntry>
        <inputEntry id="LitRule_4_ie1"><text>-</text></inputEntry>
        <inputEntry id="LitRule_4_ie2"><text>-</text></inputEntry>
