<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
  id="Definitions_gyosei_appeal_route"
  name="gyosei_appeal_route"
  namespace="https://etzhayyim.ai/dmn/gyosei">
  <decision id="gyosei_appeal_route" name="gyosei_appeal_route">
    <decisionTable id="DecisionTable_gyosei_appeal_route" hitPolicy="FIRST">
      <input id="Input_statutoryAppealAvailability">
        <inputExpression id="InputExpression_statutoryAppealAvailability" typeRef="string"><text>statutoryAppealAvailability</text></inputExpression>
      </input>
      <input id="Input_specialAppealDeadlineDays">
        <inputExpression id="InputExpression_specialAppealDeadlineDays" typeRef="number"><text>specialAppealDeadlineDays</text></inputExpression>
      </input>
      <input id="Input_daysSinceNotice">
        <inputExpression id="InputExpression_daysSinceNotice" typeRef="number"><text>daysSinceNotice</text></inputExpression>
      </input>
      <input id="Input_hasJustifiableReason">
        <inputExpression id="InputExpression_hasJustifiableReason" typeRef="boolean"><text>hasJustifiableReason</text></inputExpression>
      </input>
      <input id="Input_hasNewEvidence">
        <inputExpression id="InputExpression_hasNewEvidence" typeRef="boolean"><text>hasNewEvidence</text></inputExpression>
      </input>
      <output id="Output_route" label="route" typeRef="string" name="route"/>
      <output id="Output_intakeStatus" label="intakeStatus" typeRef="string" name="intakeStatus"/>
      <output id="Output_timebarRisk" label="timebarRisk" typeRef="string" name="timebarRisk"/>
      <rule id="AppealRule_1">
        <inputEntry id="AppealRule_1_ie0"><text>"excluded"</text></inputEntry>
        <inputEntry id="AppealRule_1_ie00"><text>-</text></inputEntry>
        <inputEntry id="AppealRule_1_ie1"><text>-</text></inputEntry>
        <inputEntry id="AppealRule_1_ie15"><text>-</text></inputEntry>
        <inputEntry id="AppealRule_1_ie2"><text>-</text></inputEntry>
        <outputEntry id="AppealRule_1_oe1"><text>"appeal-not-available"</text></outputEntry>
        <outputEntry id="AppealRule_1_oe2"><text>"rejected-by-statute"</text></outputEntry>
        <outputEntry id="AppealRule_1_oe3"><text>"high"</text></outputEntry>
      </rule>
      <rule id="AppealRule_2">
        <inputEntry id="AppealRule_2_ie0"><text>-</text></inputEntry>
        <inputEntry id="AppealRule_2_ie00"><text>&gt; 0</text></inputEntry>
        <inputEntry id="AppealRule_2_ie1"><text>&gt; specialAppealDeadlineDays</text></inputEntry>
        <inputEntry id="AppealRule_2_ie15"><text>false</text></inputEntry>
        <inputEntry id="AppealRule_2_ie2"><text>-</text></inputEntry>
        <outputEntry id="AppealRule_2_oe1"><text>"manual-time-bar-check"</text></outputEntry>
        <outputEntry id="AppealRule_2_oe2"><text>"needs-manual-check"</text></outputEntry>
        <outputEntry id="AppealRule_2_oe3"><text>"high"</text></outputEntry>
      </rule>
      <rule id="AppealRule_3">
        <inputEntry id="AppealRule_3_ie0"><text>-</text></inputEntry>
        <inputEntry id="AppealRule_3_ie00"><text>&gt; 0</text></inputEntry>
        <inputEntry id="AppealRule_3_ie1"><text>&gt; specialAppealDeadlineDays</text></inputEntry>
        <inputEntry id="AppealRule_3_ie15"><text>true</text></inputEntry>
        <inputEntry id="AppealRule_3_ie2"><text>-</text></inputEntry>
        <outputEntry id="AppealRule_3_oe1"><text>"appeal-review-with-justification"</text></outputEntry>
        <outputEntry id="AppealRule_3_oe2"><text>"accepted-subject-to-review"</text></outputEntry>
        <outputEntry id="AppealRule_3_oe3"><text>"medium"</text></outputEntry>
      </rule>
      <rule id="AppealRule_4">
        <inputEntry id="AppealRule_4_ie0"><text>-</text></inputEntry>
        <inputEntry id="AppealRule_4_ie00"><text>-</text></inputEntry>
        <inputEntry id="AppealRule_4_ie1"><text>&lt;= 90</text></inputEntry>
        <inputEntry id="AppealRule_4_ie15"><text>-</text></inputEntry>
        <inputEntry id="AppealRule_4_ie2"><text>true</text></inputEntry>
        <outputEntry id="AppealRule_4_oe1"><text>"appeal-review-plus-evidence"</text></outputEntry>
        <outputEntry id="AppealRule_4_oe2"><text>"accepted"</text></outputEntry>
        <outputEntry id="AppealRule_4_oe3"><text>"low"</text></outputEntry>
      </rule>
      <rule id="AppealRule_5">
        <inputEntry id="AppealRule_5_ie0"><text>-</text></inputEntry>
        <inputEntry id="AppealRule_5_ie00"><text>-</text></inputEntry>
        <inputEntry id="AppealRule_5_ie1"><text>&lt;= 90</text></inputEntry>
        <inputEntry id="AppealRule_5_ie15"><text>-</text></inputEntry>
        <inputEntry id="AppealRule_5_ie2"><text>false</text></inputEntry>
        <outputEntry id="AppealRule_5_oe1"><text>"appeal-review"</text></outputEntry>
        <outputEntry id="AppealRule_5_oe2"><text>"accepted"</text></outputEntry>
        <outputEntry id="AppealRule_5_oe3"><text>"low"</text></outputEntry>
      </rule>
      <rule id="AppealRule_6">
        <inputEntry id="AppealRule_6_ie0"><text>-</text></inputEntry>
        <inputEntry id="AppealRule_6_ie00"><text>-</text></inputEntry>
        <inputEntry id="AppealRule_6_ie1"><text>&gt; 90</text></inputEntry>
        <inputEntry id="AppealRule_6_ie15"><text>true</text></inputEntry>
        <inputEntry id="AppealRule_6_ie2"><text>-</text></inputEntry>
        <outputEntry id="AppealRule_6_oe1"><text>"appeal-review-with-justification"</text></outputEntry>
        <outputEntry id="AppealRule_6_oe2"><text>"accepted-subject-to-review"</text></outputEntry>
        <outputEntry id="AppealRule_6_oe3"><text>"medium"</text></outputEntry>
      </rule>
      <rule id="AppealRule_7">
        <inputEntry id="AppealRule_7_ie0"><text>-</text></inputEntry>
        <inputEntry id="AppealRule_7_ie00"><text>-</text></inputEntry>
        <inputEntry id="AppealRule_7_ie1"><text>&gt; 90</text></inputEntry>
        <inputEntry id="AppealRule_7_ie15"><text>false</text></inputEntry>
        <inputEntry id="AppealRule_7_ie2"><text>-</text></inputEntry>
        <outputEntry id="AppealRule_7_oe1"><text>"late-review-or-litigation-guide"</text></outputEntry>
        <outputEntry id="AppealRule_7_oe2"><text>"needs-manual-check"</text></outputEntry>
        <outputEntry id="AppealRule_7_oe3"><text>"high"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
