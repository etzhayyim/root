<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
  id="Definitions_gyosei_precedent_handling"
  name="gyosei_precedent_handling"
  namespace="https://etzhayyim.ai/dmn/gyosei">
  <decision id="gyosei_precedent_handling" name="gyosei_precedent_handling">
    <decisionTable id="DecisionTable_gyosei_precedent_handling" hitPolicy="FIRST">
      <input id="Input_domain">
        <inputExpression id="InputExpression_domain" typeRef="string"><text>domain</text></inputExpression>
      </input>
      <input id="Input_dispositionType2">
        <inputExpression id="InputExpression_dispositionType2" typeRef="string"><text>dispositionType</text></inputExpression>
      </input>
      <input id="Input_needsPrecedentSearch">
        <inputExpression id="InputExpression_needsPrecedentSearch" typeRef="boolean"><text>needsPrecedentSearch</text></inputExpression>
      </input>
      <output id="Output_precedentRequired" label="precedentRequired" typeRef="boolean" name="precedentRequired"/>
      <output id="Output_reviewDepth" label="reviewDepth" typeRef="string" name="reviewDepth"/>
      <rule id="PrecedentRule_1">
        <inputEntry id="PrecedentRule_1_ie1"><text>"sanctions"</text></inputEntry>
        <inputEntry id="PrecedentRule_1_ie2"><text>-</text></inputEntry>
        <inputEntry id="PrecedentRule_1_ie3"><text>-</text></inputEntry>
        <outputEntry id="PrecedentRule_1_oe1"><text>true</text></outputEntry>
        <outputEntry id="PrecedentRule_1_oe2"><text>"deep"</text></outputEntry>
      </rule>
      <rule id="PrecedentRule_2">
        <inputEntry id="PrecedentRule_2_ie1"><text>-</text></inputEntry>
        <inputEntry id="PrecedentRule_2_ie2"><text>"license-revocation"</text></inputEntry>
        <inputEntry id="PrecedentRule_2_ie3"><text>-</text></inputEntry>
        <outputEntry id="PrecedentRule_2_oe1"><text>true</text></outputEntry>
        <outputEntry id="PrecedentRule_2_oe2"><text>"deep"</text></outputEntry>
      </rule>
      <rule id="PrecedentRule_3">
        <inputEntry id="PrecedentRule_3_ie1"><text>-</text></inputEntry>
        <inputEntry id="PrecedentRule_3_ie2"><text>-</text></inputEntry>
        <inputEntry id="PrecedentRule_3_ie3"><text>true</text></inputEntry>
        <outputEntry id="PrecedentRule_3_oe1"><text>true</text></outputEntry>
        <outputEntry id="PrecedentRule_3_oe2"><text>"standard"</text></outputEntry>
      </rule>
      <rule id="PrecedentRule_4">
        <inputEntry id="PrecedentRule_4_ie1"><text>-</text></inputEntry>
        <inputEntry id="PrecedentRule_4_ie2"><text>-</text></inputEntry>
        <inputEntry id="PrecedentRule_4_ie3"><text>-</text></inputEntry>
        <outputEntry id="PrecedentRule_4_oe1"><text>false</text></outputEntry>
        <outputEntry id="PrecedentRule_4_oe2"><text>"none"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
