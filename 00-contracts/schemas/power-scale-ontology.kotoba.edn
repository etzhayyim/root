;; Power-Scale Ontology — scale-agnostic 産官学報 (industry/government/academia/press)
;; power-dynamics overlay. The (A) extension of tsumugi 紡ぎ.
;; ADR-2606092000  (extends ADR-2606011800 tsumugi · ADR-2606011000 engi-organism-ontology
;;                  · ADR-2606011500 spirit-ontology · ADR-2605081300 edge-primary karma
;;                  · ADR-2606042330 entity-as-actor mirror invariant · ADR-2605262130 kotoba)
;;
;; PURPOSE. tsumugi's present-tense power-graph (seed-power-graph) is implicitly NATIONAL /
;; corporate-keiretsu scoped. This schema makes the SAME 縁-physics SCALE-AGNOSTIC: the same
;; 取-concentration lens runs uniformly at every scale — :global → :supranational → :national
;; → :regional → :local → :intra-org — and over every collective TYPE — a 法人, a 自治体, a
;; 学会 (academic society), a 報道機関 (press org), a department-level faction inside ONE org.
;;
;; The motivating instance is the LOCAL cross-sector cluster: e.g. in 長崎, the 造船所 (産) ·
;; the 県庁 + its 審議会 (官) · the 大学 (学) · the 地元紙 (報) are co-located public power
;; entities tied to one another. The "concentration" this schema computes is the EDGE-PRIMARY
;; integral of the cross-sector ties among co-located entities — a STRUCTURAL observation of
;; how much of a locality's 産官学報 is woven together, routed toward release / openness.
;; It is NOT an accusation, a target-list, or a verdict about any named entity.
;;
;; ════════════════════════════════════════════════════════════════════════════════════
;; Constitutional invariants this schema enforces BY CONSTRUCTION (read before edit):
;; ════════════════════════════════════════════════════════════════════════════════════
;;
;;   S1  EDGE-PRIMARY (反個人主義 / anatman; ADR-2605081300, inherits tsumugi N1/G2).
;;       Concentration lives ONLY on the 縁 (:tie/grasping-load). There is NO
;;       :pwr/power-score, :pwr/influence, or :pwr/rank on a node. A locality's or an
;;       entity's concentration is the INTEGRAL of its incident cross-sector ties, computed
;;       ON READ — never a stored scalar. (analyze_scale.py raises if such an attr appears.)
;;
;;   S2  PERSON-EXCLUDED / SEAT-ONLY (inherits tsumugi G1; keizu G1 no-doxxing).
;;       :pwr/standing ∈ {:institutional :public-seat}. A human appears ONLY as a public
;;       SEAT (議長 / 委員 / 首長 / 編集委員) — never as a private individual. :private-person
;;       / :individual / :citizen are UNREPRESENTABLE (validator raises). "長崎の三菱の人" is
;;       modeled as the 造船所 (institution) or a 公的 seat, never as that person.
;;
;;   S3  AGGREGATE-FIRST. Reports are per-LOCALITY and per-SCALE aggregates + ranked clusters,
;;       never a per-person exposure dump. Cross-sector brokers are surfaced as ORG/SEAT ids.
;;
;;   S4  SOURCING HONESTY (inherits tsumugi G5). Every :tie carries :tie/sources (≥2 public
;;       citations) + :tie/sourcing :authoritative | :representative. The committed seed is
;;       :representative — structurally-public facts (a plant exists, a paper is the local
;;       paper, an org is in the prefecture), a BOUNDED sample, NOT exhaustive, NOT fabricated.
;;       An under-sourced tie RAISES (not a silent drop).
;;
;;   S5  NON-ADJUDICATING (inherits keizu G2). :tie/kind is a FACTUAL closed vocab; verdict
;;       tokens (:corruption :collusion :capture :癒着 :汚職 :談合) are NOT enum members and
;;       are unrepresentable. Co-location + cross-sector density is a structural fact; any
;;       legal characterization routes to chigiri + external counsel. nonAdjudicating = const.
;;
;;   S6  MAP-NOT-TARGET. The output is a resilience/openness map of where 産官学報 is woven
;;       tightly (routed to opening / transparency / plurality), NEVER a target-list against a
;;       locality or entity. Live planet-scale ingest is G7/Council-gated.
;;
;; STATUS: R0 design-only (ADR-2606092000). Analyzer + schema + seed only; no live ingest.

[;; ════════════════════════════════════════════════════════════════════════════
 ;; :pwr/* — a scale-agnostic power node (overlays an :organism, ADR-2606011000)
 ;; ════════════════════════════════════════════════════════════════════════════
 {:db/ident :pwr/id        :db/doc "stable id; reuses org.* / seat.* address space"}
 {:db/ident :pwr/label     :db/doc "human label"}
 {:db/ident :pwr/standing
  :db/doc "S2 person-exclusion gate; CLOSED"
  :db/allowed [:institutional :public-seat]}
 {:db/ident :pwr/scale
  :db/doc "the SCALE at which this entity holds power; CLOSED"
  :db/allowed [:global :supranational :national :regional :local :intra-org]}
 {:db/ident :pwr/sector
  :db/doc "産官学報民金 sector; CLOSED. 産=industry 官=gov 学=academia 報=press 民=civil 金=finance"
  :db/allowed [:san :kan :gaku :hou :min :kin]}
 {:db/ident :pwr/locality  :db/doc "place ref (e.g. \"jp.nagasaki\"); the cross-sector cluster key"}
 {:db/ident :pwr/collective-kind
  :db/doc "the GRANULARITY type this node belongs to — the 組織/地域/コミュニティ/社内派閥/学閥
           axis the founder asked to detail. Optional; CLOSED. 学閥/社内派閥 are still
           seat/institution-level (S2): a 学閥 is a cross-institution CLIQUE of public SEATS,
           a 社内派閥 is a faction of public SEATS under one org — never a roster of persons."
  :db/allowed [:org              ;; 組織 — a single institution/法人
               :region           ;; 地域 — a geographic locality cluster
               :community         ;; コミュニティ — a local cooperative / civic community
               :intra-org-faction ;; 社内派閥 — a faction of seats inside ONE org
               :academic-clique   ;; 学閥 — a cross-institution academic clique (seats)
               :keiretsu          ;; 系列 — a corporate group
               :advisory-body]}   ;; 審議会/委員会 — a public deliberative body
 {:db/ident :pwr/parent    :db/doc "optional containing org (intra-org seats / plants nest in a parent)"}
 {:db/ident :pwr/sourcing  :db/allowed [:authoritative :representative]}

 ;; explicitly ABSENT — declaring them documents the S1/S2 prohibition:
 ;;   :pwr/power-score  :pwr/influence  :pwr/rank   (S1 — no per-node scalar)
 ;;   :private-person   :individual     :citizen    (S2 — unrepresentable standing)

 ;; ════════════════════════════════════════════════════════════════════════════
 ;; :tie/* — the first-class 縁 (cross-sector or intra-sector); concentration lives here
 ;; ════════════════════════════════════════════════════════════════════════════
 {:db/ident :tie/id   :db/doc "stable edge id"}
 {:db/ident :tie/kind
  :db/doc "FACTUAL relation kind (S5); CLOSED. No verdict tokens."
  :db/allowed [:custodies     ;; ownership / control custody
               :depends-on    ;; supply / funding / IP dependency
               :funds         ;; money flow (補助金 / 寄付 / 発注)
               :awards        ;; procurement award (調達)
               :seats-on      ;; sits on a 審議会 / 委員会 (public seat ← org)
               :co-member     ;; co-membership on the same body
               :supplies      ;; supply relation
               :covers        ;; press coverage relation (報道)
               :employs       ;; major local employer relation
               :follows]}     ;; attention / social
 {:db/ident :tie/from :db/doc "source :pwr/id"}
 {:db/ident :tie/to   :db/doc "target :pwr/id"}
 {:db/ident :tie/grasping-load
  :db/doc "S1 — ∈[0,1]; the しがらみ/lock-in the tie binds. THE edge-primary weight."
  :db/type :double}
 {:db/ident :tie/sources  :db/doc "S4 — ≥2 public citations; under-sourced RAISES" :db/type :vector}
 {:db/ident :tie/sourcing :db/allowed [:authoritative :representative]}

 ;; ════════════════════════════════════════════════════════════════════════════
 ;; const guards (S5/S6) — read by analyze_scale.py + test_scale.py
 ;; ════════════════════════════════════════════════════════════════════════════
 {:db/ident :scale/nonAdjudicating :db/const true
  :db/doc "S5 — concentration is a structural fact, never a verdict (癒着/談合/capture unrepresentable)"}
 {:db/ident :scale/mapNotTarget :db/const true
  :db/doc "S6 — resilience/openness map routed to opening, never a target-list"}
 {:db/ident :scale/verdict-tokens-forbidden
  :db/doc "S5 — these MUST NOT appear as :tie/kind or anywhere; validator raises"
  :db/value [:corruption :collusion :capture :癒着 :汚職 :談合 :guilt :不正]}]
