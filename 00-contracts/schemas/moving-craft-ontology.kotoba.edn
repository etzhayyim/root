;; moving-craft-ontology — kotoba EAVT vocabulary for live ship + aircraft positions
;; ADR-2606041827 · actor: watari 渡り (live moving-craft KG)
;;
;; PURPOSE
;;   A content-addressed Datom (EAVT) vocabulary describing the planet's MOVING public
;;   craft — ships (AIS) and aircraft (ADS-B) — as a live knowledge graph: each craft's
;;   stable IDENTITY plus an append-only stream of POSITION FIXES. The canonical "current
;;   position" is simply the LATEST as-of fix in the Datom log; the craft's whole TRAJECTORY
;;   is read off the EAVT history (非終末論 — fixes are appended, never overwritten, and there
;;   is no terminal "final position" datom).
;;
;;   The lens is SITUATIONAL RESILIENCE — where moving traffic concentrates onto a sea-lane,
;;   air-corridor, chokepoint, or port/airport approach — routed to safety, collision
;;   avoidance, congestion-easing, and redundancy. It is an aggregate situational map,
;;   NEVER a person-surveillance feed and NEVER a targeting feed (constitutional, see SCOPE
;;   GUARD below; mirrors watatsuna G2 + Charter Rider §2(a) force-separation + §2(d)).
;;
;; KOTOBA-NATIVE REWRITE (the reason this ontology exists):
;;   The legacy `maps` actor stored vessel/aircraft positions in RisingWave
;;   (vertex_vessel_position / vertex_aircraft_state) and the legacy `vessel` actor wrote
;;   them into a graph DB via graph.write SQL. Both violate the substrate boundary
;;   (ADR-2605262130: the kotoba Datom log is first-class canonical state; NO RisingWave /
;;   SQL) and route narration off-Murakumo. watari supersedes both: state = kotoba Datom
;;   log, narration = Murakumo-only (ADR-2605215000).
;;
;; SUBSTRATE (ADR-2605262130 + 2605312345): canonical state is the kotoba Datom log.
;;   IPFS = block backend, MST = ingress/interop wire, Base L2 = trust anchor. NO RisingWave,
;;   NO centralized SQL. Bulk position history (long fix streams, replay tiles) → DataLad →
;;   IPFS under 80-data/moving-craft (NO git-lfs; G8).
;;
;; SOURCING HONESTY (G5, mirrors watatsuna/tsumugi/spirit ontologies):
;;   :*/sourcing ∈ { :authoritative  ; a live public transponder broadcast (AIS message,
;;                                      ADS-B state vector) or a primary public registry
;;                                      (ITU MMSI, ICAO 24-bit allocation, national reg)
;;                   :representative  ; publicly documented but a bounded illustrative sample,
;;                                      NOT live coverage; coordinates/timestamps rounded
;;                   :synthesized }   ; derived/estimated by watari (e.g. interpolated leg);
;;                                      MUST be flagged, never presented as an observed fix
;;   Every node and edge in the seed graph carries an explicit sourcing keyword. No fabricated
;;   coverage; absence of a craft means "not yet ingested", not "not present in the world".
;;
;; SCOPE GUARD (constitutional):
;;   - PUBLIC TRANSPONDER BROADCASTS ONLY. AIS (ships) and ADS-B (aircraft) are open signals
;;     that craft lawfully broadcast in the clear; terrestrial/space receivers (AISStream,
;;     OpenSky, adsb.fi) aggregate them as public data. watari ingests ONLY these + public
;;     registries.
;;   - FORBIDDEN: any craft that is NOT publicly broadcasting; military / blocked-from-display
;;     aircraft (FAA LADD, PIA), naval vessels whose positions are not openly broadcast; any
;;     attempt to de-anonymize the PERSON behind a craft (private-yacht / private-jet owner,
;;     crew, passenger), build pattern-of-life on an individual, or answer "where is person X".
;;     A craft is a CRAFT, not a person (G4).
;;   - Output is AGGREGATE-FIRST (lane / corridor / chokepoint / approach density) framed
;;     toward safety + resilience — never "follow this specific craft" and never toward
;;     interdiction or targeting.

{:schema/id        "moving-craft-ontology"
 :schema/version   "0.1.0"
 :schema/adr       "2606041827"
 :schema/supersedes ["com.etzhayyim.apps.vessel.vesselPosition"
                     "com.etzhayyim.apps.vessel.tracking"
                     "com.etzhayyim.apps.maps.aismarine"
                     "com.etzhayyim.apps.maps.aircraftLive"]
 :schema/note      "kotoba-native successor to the legacy maps aismarine/aircraft_live RisingWave pipelines + vessel tracking:ais graph-DB store (see 00-contracts/lexicons/com/etzhayyim/watari/MIGRATION-NOTES.md). Couples to watatsuna chokepoint keywords (ADR-2606012600): a vessel's live chokepoint transit feeds the SAME maritime resilience map."

 :attributes
 [;; ── :craft/* — a MOVING craft's stable IDENTITY (ship or aircraft) ──
  {:db/ident :craft/id           :db/valueType :db.type/string  :db/unique :db.unique/identity :db/doc "stable id, e.g. \"craft.vessel.imo9811000\" or \"craft.aircraft.86d0a1\""}
  {:db/ident :craft/kind         :db/valueType :db.type/keyword :db/doc ":vessel | :aircraft"}
  {:db/ident :craft/name         :db/valueType :db.type/string  :db/doc "vessel name or aircraft type/operator label (NOT a person)"}
  {:db/ident :craft/callsign     :db/valueType :db.type/string  :db/doc "AIS/ADS-B callsign or scheduled flight number, if broadcast"}
  ;; vessel identity
  {:db/ident :craft/mmsi         :db/valueType :db.type/long    :db/doc "ITU MMSI (vessels) — public AIS identity"}
  {:db/ident :craft/imo          :db/valueType :db.type/long    :db/doc "IMO number (vessels), if known"}
  {:db/ident :craft/vessel-type  :db/valueType :db.type/keyword :db/doc ":container | :tanker | :bulk | :lng | :roro | :passenger | :other"}
  ;; aircraft identity
  {:db/ident :craft/icao24       :db/valueType :db.type/string  :db/doc "ICAO 24-bit hex (aircraft) — public ADS-B identity"}
  {:db/ident :craft/registration :db/valueType :db.type/string  :db/doc "national registration (tail), if public"}
  {:db/ident :craft/aircraft-type :db/valueType :db.type/keyword :db/doc ":widebody | :narrowbody | :regional | :freighter | :other (scheduled commercial preferred; private craft EXCLUDED by G4)"}
  ;; common
  {:db/ident :craft/flag         :db/valueType :db.type/string  :db/doc "ISO 3166-1 alpha-2 flag/registry state"}
  {:db/ident :craft/operator     :db/valueType :db.type/string  :db/doc "operator org id (links :organism/id where known); a company, never a person"}
  {:db/ident :craft/sourcing     :db/valueType :db.type/keyword :db/doc ":authoritative | :representative | :synthesized"}

  ;; ── :craft.fix/* — FIRST-CLASS append-only POSITION FIX (the heart of the log) ──
  ;;    The latest fix per craft (max :craft.fix/observed-at) IS its current position.
  ;;    The full set of fixes IS the trajectory. Appended, never overwritten (非終末論).
  {:db/ident :craft.fix/id       :db/valueType :db.type/string  :db/unique :db.unique/identity :db/doc "e.g. \"fix.craft.vessel.imo9811000.260604T0900Z\""}
  {:db/ident :craft.fix/craft    :db/valueType :db.type/ref     :db/doc ":craft/id"}
  {:db/ident :craft.fix/lat      :db/valueType :db.type/double  :db/doc "approx; :representative may round"}
  {:db/ident :craft.fix/lon      :db/valueType :db.type/double}
  {:db/ident :craft.fix/alt-m    :db/valueType :db.type/double  :db/doc "geometric altitude, metres (aircraft); nil/0 for surface craft"}
  {:db/ident :craft.fix/speed-kn :db/valueType :db.type/double  :db/doc "speed over ground, knots (SOG / ADS-B groundspeed)"}
  {:db/ident :craft.fix/course   :db/valueType :db.type/double  :db/doc "course/track over ground, degrees true (COG / ADS-B track)"}
  {:db/ident :craft.fix/heading  :db/valueType :db.type/double  :db/doc "true heading, degrees, if broadcast"}
  {:db/ident :craft.fix/nav-status :db/valueType :db.type/keyword :db/doc "AIS nav status: :under-way | :at-anchor | :moored | :aground | :restricted | :unknown"}
  {:db/ident :craft.fix/on-ground :db/valueType :db.type/boolean :db/doc "ADS-B on-ground flag (aircraft)"}
  {:db/ident :craft.fix/lane     :db/valueType :db.type/ref     :db/doc ":lane/id the craft is currently transiting (resilience signal; NOT a route-to-intercept)"}
  {:db/ident :craft.fix/observed-at :db/valueType :db.type/instant :db/doc "broadcast/observation time, ISO-8601 UTC (lexically sortable; max per craft = current)"}
  {:db/ident :craft.fix/source   :db/valueType :db.type/keyword :db/doc ":ais | :adsb — which public broadcast carried this fix"}
  {:db/ident :craft.fix/sourcing :db/valueType :db.type/keyword}

  ;; ── :craft.leg/* — an observed/derived VOYAGE (ship) or FLIGHT (aircraft) leg ──
  ;;    origin → destination; status mirrors public schedule/AIS-destination only.
  {:db/ident :craft.leg/id       :db/valueType :db.type/string  :db/unique :db.unique/identity}
  {:db/ident :craft.leg/craft    :db/valueType :db.type/ref     :db/doc ":craft/id"}
  {:db/ident :craft.leg/from      :db/valueType :db.type/string :db/doc "origin port LOCODE / airport ICAO (public)"}
  {:db/ident :craft.leg/to        :db/valueType :db.type/string :db/doc "destination port LOCODE / airport ICAO (AIS-declared / scheduled)"}
  {:db/ident :craft.leg/status    :db/valueType :db.type/keyword :db/doc ":planned | :under-way | :arrived (mirrors public declaration; watari does not adjudicate)"}
  {:db/ident :craft.leg/sourcing  :db/valueType :db.type/keyword}

  ;; ── :lane/* — a named sea-lane / air-corridor / chokepoint / approach (density unit) ──
  ;;    REUSES watatsuna chokepoint keywords (:malacca :luzon-strait :suez-red-sea …) so a
  ;;    vessel's LIVE transit load composes with watatsuna's STATIC cable chokepoint load
  ;;    into one maritime resilience picture (ADR-2606012600 coupling).
  {:db/ident :lane/id            :db/valueType :db.type/string  :db/unique :db.unique/identity :db/doc "e.g. \"lane.malacca\" \"lane.approach.tokyo-bay\""}
  {:db/ident :lane/name          :db/valueType :db.type/string}
  {:db/ident :lane/kind          :db/valueType :db.type/keyword :db/doc ":strait | :canal | :sea-lane | :air-corridor | :approach"}
  {:db/ident :lane/chokepoint    :db/valueType :db.type/keyword :db/doc "named chokepoint keyword shared with watatsuna :station/chokepoint, e.g. :malacca — nil for ordinary lanes"}
  {:db/ident :lane/sourcing      :db/valueType :db.type/keyword}]

 ;; ───────────────────────────── DERIVED (analyze.py, never stored as raw fact) ────
 ;; watari computes these and emits them flagged :derived; they are NOT re-ingested as
 ;; authoritative fact (mirrors watatsuna's resilience-derivation discipline).
 :derived-attributes
 [{:db/ident :movement/lane-load        :db/doc "# distinct craft whose LATEST fix transits a lane — live concentration surface"}
  {:db/ident :movement/lane-load-by-kind :db/doc "lane load split :vessel / :aircraft"}
  {:db/ident :movement/chokepoint-transit :db/doc "lane-load restricted to lanes carrying a watatsuna chokepoint keyword — composes with watatsuna static cable load"}
  {:db/ident :movement/approach-congestion :db/doc "# craft whose latest fix transits a :approach lane — routed to congestion-easing + safety, NEVER targeting"}
  {:db/ident :movement/track-freshness   :db/doc "per-craft latest-fix recency vs dataset latest; stale tail flagged honestly (no fabricated live coverage)"}]}
