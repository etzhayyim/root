;; ritual-hemp-ontology.kotoba.edn — vocabulary for nusa (幣)
;; ADR-2606039800 · actor: orgs/etzhayyim/com-etzhayyim-nusa/
;;
;; SCOPE: Japan's ritual + industrial HEMP (麻 / asa) heritage as a kotoba EAVT
;;   knowledge graph — the Shinto purification artifacts (注連縄 / 祓串 / 大幣),
;;   the imperial-accession 麁服 (aratae, Daijōsai hemp cloth), the 阿波忌部 lineage
;;   that 調進 it, and the LOW-THC fibre cultivars + regions whose licensed cultivation
;;   the 2023 reform (大麻草の栽培の規制に関する法律, 令和5年法律第84号) reopened.
;;
;; CONSTITUTIONAL INVARIANT (G1, enforced in schema + lexicon `const` + analyze.py):
;;   :hemp/thc-class takes ONLY :fiber | :low-thc. There is NO :psychoactive value.
;;   The data model cannot represent a recreational-cannabis catalog by construction.
;;   Recreational THC = prohibited (G2, 使用罪尊重). Cannabis-derived MEDICINE is a
;;   separate regulated lane (薬機法/医師法 → yakushi/iyashi/mitate), OUT of scope (G10).
;;
;; NON-ADJUDICATING (G3): legislative facts are recorded as facts (provenance-cited);
;;   legal characterization + advocacy belong to danjo/chigiri/moushibumi, never here.
;;   nusa takes no 推進/反対 stance on 解禁論.
;;
;; SOURCING (G7): every node carries :*/sourcing. This is a BOUNDED illustrative seed.
;;   Heritage facts (rites, the aratae/Imbe tradition, cultivar THC class) are matters of
;;   public/scholarly record; legal figures are :representative summaries that MUST be
;;   verified against primary sources (e-Gov 法令 / 官報) before any outward use (G8).
;;
;; HISTORY (非終末論): heritage + cultivation are :rite.event/as-of / :hemp.license/as-of
;;   trajectories — no final-state "restored" datom; Wellbecoming is the moving record.

{:ontology "com.etzhayyim.nusa.ritual-hemp"
 :version  1
 :graph    {:name "ritual-hemp-v1" :visibility :public}

 ;; ───────────────────────────── :hemp/* — cultivars / fibre ─────────────────
 :attributes
 {:hemp/id            {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
  :hemp/name          {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
  :hemp/kind          {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one
                       :db/doc "one of :cultivar :landrace"}
  :hemp/thc-class     {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one
                       :db/doc "G1 INVARIANT — one of :fiber | :low-thc ONLY. :psychoactive is NOT a permitted value."
                       :db/allowed [:fiber :low-thc]}
  :hemp/fiber-use     {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/many
                       :db/doc "e.g. :shimenawa :aratae :textile :rope :paper :seed-oil-food"}
  :hemp/region        {:db/valueType :db.type/string  :db/cardinality :db.cardinality/many
                       :db/doc "cultivation region, e.g. 栃木 / 阿波(徳島)"}
  :hemp/note          {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
  :hemp/sourcing      {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}

  ;; ─────────────────────────── :rite/* — ritual artifacts ───────────────────
  :rite/id            {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
  :rite/name          {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
  :rite/kind          {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one
                       :db/doc ":shimenawa :haraegushi :oonusa :aratae :nigitae :jingu-taima"}
  :rite/purpose       {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one
                       :db/doc "ritual purpose — overwhelmingly :purification; never intoxication"}
  :rite/material      {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one
                       :db/doc ":hemp-fiber :silk etc."}
  :rite/uses-cultivar {:db/valueType :db.type/string  :db/cardinality :db.cardinality/many
                       :db/doc "→ :hemp/id (fibre source); edge"}
  :rite/note          {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
  :rite/sourcing      {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}

  ;; ─────────────────────────── :rite.event/* — rites/ceremonies (as-of) ─────
  :rite.event/id      {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
  :rite.event/name    {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
  :rite.event/uses-artifact {:db/valueType :db.type/string :db/cardinality :db.cardinality/many
                       :db/doc "→ :rite/id"}
  :rite.event/lineage {:db/valueType :db.type/string  :db/cardinality :db.cardinality/many
                       :db/doc "→ :imbe/id (provisioning lineage)"}
  :rite.event/as-of   {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one
                       :db/doc "non-eschatological history marker; no final-state datom"}
  :rite.event/note    {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
  :rite.event/sourcing {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}

  ;; ─────────────────────────── :imbe/* — provisioning lineage ───────────────
  :imbe/id            {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
  :imbe/name          {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
  :imbe/role          {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one
                       :db/doc ":aratae-provision :shrine etc."}
  :imbe/region        {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
  :imbe/note          {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
  :imbe/sourcing      {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}

  ;; ─────────────────────────── :hemp.license/* — cultivation-revival design ─
  ;; member-principal (G4) · no-fiat-inflow · serverHeldKey=false (G5) · outward-gated (G8)
  :hemp.license/id          {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
  :hemp.license/cultivar    {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "→ :hemp/id (must be :fiber/:low-thc — G1)"}
  :hemp.license/purpose     {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":ritual-fiber :industrial-fiber"}
  :hemp.license/licensee-principal {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc "G4 — :member ONLY; never :org"}
  :hemp.license/funding     {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc "G4 — :member-okaimono ONLY; no org treasury / fiat processor"}
  :hemp.license/server-held-key {:db/valueType :db.type/boolean :db/cardinality :db.cardinality/one :db/doc "G5 — always false"}
  :hemp.license/outward-gated {:db/valueType :db.type/boolean :db/cardinality :db.cardinality/one :db/doc "G8 — always true; live filing Council Lv6+ + operator"}
  :hemp.license/legal-basis {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "大麻草の栽培の規制に関する法律 (要 primary-source 引用)"}
  :hemp.license/as-of       {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
  :hemp.license/sourcing    {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}}}
