;; finrisk-ontology — the systemic finance-risk (綻び) vocabulary for hokorobi 綻び
;; ADR-2606073400 · sibling of biosphere-ontology (ADR-2606073000) and asobi-ontology
;; (ADR-2606073200), specialised to SYSTEMIC FINANCIAL RISK — insurance / banking-lending /
;; pensions. OBSERVATION ONLY: finance PRODUCTION stays Charter-excluded (non-profit only);
;; hokorobi is the risk-observation sibling of kanjo / kanae / kabuto / danjo.
;;
;; PURPOSE: weave financial institutions / risk-sources / bearers and their 縁 (exposure,
;; interconnection, underfunding, protection-gap, backstop, capital-buffer) into the kotoba
;; Datom log. The lens is SYSTEMIC-RISK concentration (where fragility accumulates and
;; propagates) vs RESILIENCE (the buffers that absorb it), routed to RESILIENCE.
;;
;; CONSTITUTIONAL INVERSION (G1, read first): hokorobi is a RESILIENCE map, NEVER a panic /
;; bank-run trigger, NEVER a trading / short / market-moving signal, NEVER a per-institution
;; solvency verdict. No real-time market signal; aggregate-first; it NEVER trades. The
;; 取-holder is the RISK-SOURCE; the bearer is the public (depositors / pensioners / insured /
;; taxpayers); the routing is resilience (繕い).
;;
;; EDGE-PRIMARY (N1): systemic risk lives ONLY on edges (:en/risk-load). A node's
;; systemic-risk-concentration = the INTEGRAL of its incident inbound risk 縁, computed on
;; READ — never a stored per-institution score. There is no :hokorobi/solvency-of-bank.

{:schema/id "finrisk-ontology"
 :schema/version "0.1.0"
 :schema/adr "2606073400"

 ;; ── nodes ──────────────────────────────────────────────────────────────────
 :node/attrs
 [{:attr :organism/id        :doc "stable id, e.g. fin.inst.jpmorgan / fin.risk.leverage"}
  {:attr :organism/kind       :doc ":institution | :risk | :bearer"}
  {:attr :organism/label      :doc "common/display label"}
  {:attr :organism/sourcing   :doc ":authoritative (FSB/IAIS/regulator disclosure) | :representative (bounded seed)"}

  ;; institution facet
  {:attr :inst/sector         :doc ":bank | :insurer | :pension-fund | :ccp | :shadow-bank | :reinsurer"}
  {:attr :inst/sii            :doc "systemic-importance tier — :g-sib :d-sib :large :mid :small (DISCLOSED FSB/IAIS designation, not adjudicated)"}
  {:attr :inst/jurisdiction   :doc "ISO-3166 home jurisdiction"}

  ;; risk facet (the 取-holder; the channel of systemic fragility)
  {:attr :risk/kind           :doc ":leverage | :maturity-mismatch | :interconnection | :protection-gap | :underfunding | :concentration | :liquidity"}

  ;; bearer facet (who bears realized systemic risk)
  {:attr :bearer/kind         :doc ":depositors | :pensioners | :policyholders | :taxpayers | :real-economy"}]

 ;; ── edges (縁) ───────────────────────────────────────────────────────────────
 :edge/attrs
 [{:attr :en/from            :doc "source organism id"}
  {:attr :en/to              :doc "target organism id"}
  {:attr :en/kind            :doc ":exposes | :interconnects | :underfunds | :protection-gap | :backstops | :capitalizes | :diversifies"}
  {:attr :en/risk-load       :doc "0..1 — for RISK 縁: severity of systemic fragility imposed; for RESILIENCE 縁 (:backstops/:capitalizes/:diversifies): buffer afforded. karma lives HERE (N1)."}
  {:attr :en/sourcing        :doc ":authoritative | :representative"}]

 ;; ── derived (transient, computed on READ — NEVER stored; N1/G2) ──────────────
 :derived/attrs
 [{:attr :bond/systemic-risk-concentration :doc "node integral of incident inbound risk 縁 × disclosed systemic-importance weight — the resilience surface"}
  {:attr :bond/resilience-buffer           :doc "node integral of incident :backstops/:capitalizes/:diversifies loads — absorptive capacity"}
  {:attr :bond/is-transient                :doc "const true — derived readout, not a stored datom"}]

 ;; ── disclosed systemic-importance tier → representative weight (NOT a verdict) ──
 :sii/weight
 {:g-sib 1.0 :d-sib 0.7 :large 0.5 :mid 0.3 :small 0.1}}
