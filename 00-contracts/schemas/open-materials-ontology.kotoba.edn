;; open-materials-ontology — the open materials-discovery (公開材料) vocabulary for masago 真砂
;; ADR-2606151027 · science-data sibling of genome-ontology (ADR-2606101000, rasen 螺旋) and
;; biosphere-ontology (ADR-2606073000, inochi 命). Where rasen mirrors the public reference text
;; of life and inochi the living world, masago mirrors the PUBLIC open-materials commons — the
;; computed properties + crystal structures of inorganic materials released openly by Meta FAIR
;; Chemistry (Open Materials 2024 / OMat24, CC-BY-4.0) and the Materials Project / OQMD / NOMAD /
;; AFLOW family — into the kotoba Datom log.
;;
;; PURPOSE: weave PUBLIC computed materials data — materials (formula + crystal structure),
;; their constituent elements, the computed PROPERTIES they carry, and the downstream
;; APPLICATION classes they are candidates for — into the kotoba Datom log. The lens is
;; integrated discovery EVIDENCE over a material (Σ incident property + candidacy 縁 weighted by
;; disclosed provenance confidence), routed to RESEARCH (a candidate shortlist surfaced to human
;; scientists), never to a make/buy decision and never to a synthesis recipe.
;;
;; CONSTITUTIONAL INVERSION (G1, read first): masago is a RESEARCH map of PUBLIC computed
;; materials data, NEVER a weapons-design or synthesis-recipe tool. It mirrors computed
;; PROPERTIES + STRUCTURES only. It carries NO synthesis route, NO precursor list, NO enrichment
;; or processing procedure — those fields are structurally unrepresentable (not schema members).
;; Dual-use materials (energetics, CW/biological precursors, fissile / enrichment-relevant
;; species) are mirrored at the property level only; weaponizable APPLICATION classes are not
;; enum members. It routes materials knowledge to open research, never to fabrication or force
;; (Charter §1.12; mirrors hotaru's no-fabrication / open-IP-only stance, ADR-2606051200).
;;
;; EDGE-PRIMARY (N1): discovery evidence lives ONLY on edges (:en/grasping-load, weighted by
;; DISCLOSED :en/confidence provenance). A material's discovery-priority = the INTEGRAL of its
;; incident :has-property + :candidate-for 縁, computed on READ — never a stored per-material
;; score. There is no :material/score. The raw computed VALUE rides the edge as :en/value, a
;; DISCLOSED fact, never re-judged.
;;
;; NON-ADJUDICATING (N3): property values + stability are DISCLOSED from the source's DFT / MLIP
;; calculation, never masago verdicts. masago datafies the material–property–application
;; structure; it never asserts "this material is best", never recommends synthesis, never trades.

{:schema/id "open-materials-ontology"
 :schema/version "0.1.0"
 :schema/adr "2606151027"

 ;; ── nodes ──────────────────────────────────────────────────────────────────
 :node/attrs
 [{:attr :mat/id            :doc "stable id, e.g. mat.lifepo4 / el.fe / prop.band-gap / app.battery-cathode / src.omat24"}
  {:attr :mat/kind          :doc ":material | :element | :property | :application | :dataset-source"}
  {:attr :mat/label         :doc "common/display label"}
  {:attr :mat/sourcing      :doc ":authoritative (disclosed in an open source: OMat24/Materials-Project/OQMD/NOMAD/AFLOW) | :representative (bounded public seed)"}
  {:attr :mat/links         :doc "optional cross-actor id — e.g. an iwakura silicon node, a hikari battery cell, a hotaru substrate; aggregate-first"}

  ;; material facet (PUBLIC computed structure — no privacy concern; crystal data is open)
  {:attr :material/formula        :doc "reduced/pretty formula, e.g. \"LiFePO4\""}
  {:attr :material/spacegroup     :doc "Hermann-Mauguin space-group symbol, e.g. \"Pnma\" (public crystal structure)"}
  {:attr :material/crystal-system :doc ":cubic | :tetragonal | :orthorhombic | :hexagonal | :trigonal | :monoclinic | :triclinic"}
  {:attr :material/source-id      :doc "id in the open source, e.g. \"mp-19017\" (Materials Project) / OMat24 structure id (public reference)"}

  ;; element facet
  {:attr :element/symbol     :doc "IUPAC element symbol, e.g. \"Fe\""}
  {:attr :element/z          :doc "atomic number"}

  ;; property facet — the property TYPE; the VALUE lives on the :has-property edge (N1)
  {:attr :property/kind      :doc ":formation-energy | :energy-above-hull | :band-gap | :bulk-modulus | :shear-modulus | :density | :ionic-conductivity | :seebeck | :magnetization | :dielectric | :critical-temperature"}
  {:attr :property/unit      :doc "physical unit, e.g. \"eV/atom\" | \"eV\" | \"GPa\" | \"g/cm^3\" | \"S/cm\" | \"K\""}

  ;; application facet — downstream use class (weaponizable classes are NOT enum members, G1)
  {:attr :application/class  :doc ":battery-cathode | :battery-anode | :solid-electrolyte | :semiconductor | :photovoltaic | :catalyst | :thermoelectric | :superconductor | :dielectric | :structural | :magnet | :hydrogen-storage"}

  ;; dataset-source facet (the open commons this material is mirrored from; G4/G5)
  {:attr :source/license    :doc "open license string, e.g. \"CC-BY-4.0\" — G4: open-license only"}
  {:attr :source/doi        :doc "DOI / arXiv id of the dataset release (G5 provenance)"}
  {:attr :source/url        :doc "canonical public URL of the dataset"}]

 ;; ── edges (縁) ───────────────────────────────────────────────────────────────
 :edge/attrs
 [{:attr :en/from           :doc "source materials-node id"}
  {:attr :en/to             :doc "target materials-node id"}
  {:attr :en/kind           :doc ":composed-of (material→element, provenance) | :has-property (material→property, carries :en/value) | :candidate-for (material→application) | :derived-from (material→dataset-source, provenance) | :similar-to (material→material)"}
  {:attr :en/grasping-load  :doc "0..1 — the discovery-evidence/relevance weight this 縁 carries (property quality / candidacy strength). karma lives HERE (N1)."}
  {:attr :en/value          :doc "the DISCLOSED computed property value carried by a :has-property edge (raw fact, never re-judged, N3). NOT used in the discovery integral."}
  {:attr :en/confidence     :doc "DISCLOSED provenance of the datum: :experimental | :dft | :mlip-predicted | :mlip-screened | :estimated (never a masago verdict, N3)"}
  {:attr :en/sourcing       :doc ":authoritative | :representative"}]

 ;; ── derived (transient, computed on READ — NEVER stored; N1/G2) ──────────────
 :derived/attrs
 [{:attr :bond/discovery-priority   :doc "material integral of incident :has-property + :candidate-for loads × disclosed confidence weight — the research surface (routed to RESEARCH, never make/buy)"}
  {:attr :bond/application-readiness :doc "application integral of inbound :candidate-for load × confidence — which application class has the most candidate evidence"}
  {:attr :bond/composition-breadth  :doc "node integral of incident :composed-of / :candidate-for / :similar-to 縁 — connectivity/cascade breadth"}
  {:attr :bond/is-transient         :doc "const true — derived readout, not a stored datom"}]

 ;; ── provenance confidence → representative evidence weight (DISCLOSED scale, not a verdict) ──
 ;; mirrors genome-ontology :clinsig/weight. experimental > DFT > MLIP-predicted > MLIP-screened.
 :confidence/weight
 {:experimental 1.0 :dft 0.8 :mlip-predicted 0.6 :mlip-screened 0.5 :estimated 0.3}}
