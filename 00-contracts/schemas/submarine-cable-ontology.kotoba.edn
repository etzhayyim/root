;; submarine-cable-ontology — kotoba EAVT vocabulary for the world submarine cable network
;; ADR-2606012600 · actor: watatsuna 綿津綱 (KG) · operated alongside watatsumi 綿津見 (敷設 robotics)
;;
;; PURPOSE
;;   A content-addressed Datom (EAVT) vocabulary describing the planet's submarine cable
;;   network as a knowledge graph: cable SYSTEMS, their LANDING STATIONS, the physical
;;   SEGMENTS that join stations, and observed FAULT events. The lens is RESILIENCE —
;;   where the network concentrates onto chokepoints / single-points-of-failure, routed
;;   to redundancy and repair. It is an accountability/resilience map, NEVER a target-list
;;   (constitutional, see SCOPE GUARD below + watatsumi N8 anti-sabotage invariant).
;;
;; SUBSTRATE (ADR-2605262130 + 2605312345): the canonical state is the kotoba Datom log.
;;   IPFS = block backend, MST = ingress/interop wire, Base L2 = trust anchor. NO RisingWave,
;;   NO centralized SQL. Large geo assets (route GeoJSON, satellite tiles) → DataLad → IPFS
;;   under 80-data/submarine-cable (NO git-lfs; G8).
;;
;; SOURCING HONESTY (G5, mirrors tsumugi/spirit ontologies):
;;   :*/sourcing ∈ { :authoritative  ; from a primary registry/filing (TeleGeography, ITU,
;;                                      consortium RFS notice, cable-ship AIS, fault bulletin)
;;                   :representative  ; publicly documented but a bounded illustrative sample,
;;                                      NOT exhaustive coverage; coordinates may be approximate
;;                   :synthesized }   ; derived/estimated by watatsuna; MUST be flagged, never
;;                                      presented as observed fact
;;   Every node and edge in the seed graph carries an explicit sourcing keyword. No fabricated
;;   coverage; absence of a cable from the graph means "not yet ingested", not "does not exist".
;;
;; SCOPE GUARD (constitutional):
;;   - PUBLIC infrastructure only. Cable systems, consortium owners, landing-station siting,
;;     and capacity are matters of public record (regulatory filings, marine charts, press).
;;   - Precise armoring depth, repair-vessel live position beyond public AIS, classified
;;     military cable routes, and any data that would aid interdiction are OUT OF SCOPE and
;;     MUST NOT be ingested (§ aligns with watatsumi N8 + Charter Rider §2(d) infra-attack).
;;   - Criticality / chokepoint analysis is emitted AGGREGATE-FIRST and framed toward
;;     redundancy, diversity-routing, and faster repair — never toward where to cut.

{:schema/id        "submarine-cable-ontology"
 :schema/version   "0.1.0"
 :schema/adr       "2606012600"
 :schema/supersedes ["com.etzhayyim.apps.telecom.registerSubmarineCableSystem"
                     "com.etzhayyim.apps.telecomInfra.registerCable"
                     "com.etzhayyim.apps.telecomInfra.flagCableFault"]
 :schema/note      "kotoba-native successor to the legacy etzhayyim telecom/telecomInfra/cableRepairFleet lexicons (see 00-contracts/lexicons/com/etzhayyim/cable/MIGRATION-NOTES.md)."

 ;; ───────────────────────────── ENTITY: cable system ─────────────────────────────
 :attributes
 [;; ── :cable/* — a submarine cable SYSTEM (e.g. JUPITER, 2Africa, MAREA) ──
  {:db/ident :cable/id            :db/valueType :db.type/string  :db/unique :db.unique/identity :db/doc "stable id, e.g. \"cable.jupiter\""}
  {:db/ident :cable/name          :db/valueType :db.type/string  :db/doc "system display name"}
  {:db/ident :cable/owner-consortium :db/valueType :db.type/string :db/cardinality :db.cardinality/many :db/doc "consortium member org ids (links to :organism/id where known)"}
  {:db/ident :cable/length-km     :db/valueType :db.type/long    :db/doc "total system route length, km"}
  {:db/ident :cable/design-capacity-tbps :db/valueType :db.type/double :db/doc "design capacity, Tbps"}
  {:db/ident :cable/lit-capacity-tbps    :db/valueType :db.type/double :db/doc "currently lit capacity, Tbps (often <<design)"}
  {:db/ident :cable/rfs-year      :db/valueType :db.type/long    :db/doc "ready-for-service year"}
  {:db/ident :cable/status        :db/valueType :db.type/keyword :db/doc ":planned | :under-construction | :in-service | :retired"}
  {:db/ident :cable/fiber-pairs   :db/valueType :db.type/long    :db/doc "fiber pair count, if public"}
  {:db/ident :cable/sourcing      :db/valueType :db.type/keyword :db/doc ":authoritative | :representative | :synthesized"}

  ;; ── :station/* — a cable LANDING STATION (beach manhole + landing building) ──
  {:db/ident :station/id          :db/valueType :db.type/string  :db/unique :db.unique/identity :db/doc "stable id, e.g. \"station.jp.chikura\""}
  {:db/ident :station/name        :db/valueType :db.type/string}
  {:db/ident :station/country     :db/valueType :db.type/string  :db/doc "ISO 3166-1 alpha-2"}
  {:db/ident :station/lat         :db/valueType :db.type/double  :db/doc "approx; :representative may round"}
  {:db/ident :station/lon         :db/valueType :db.type/double}
  {:db/ident :station/chokepoint  :db/valueType :db.type/keyword :db/cardinality :db.cardinality/many
   :db/doc "named geographic chokepoint(s) this station sits behind, e.g. :luzon-strait :malacca :suez-red-sea :hormuz :gibraltar — drives resilience analysis"}
  {:db/ident :station/sourcing    :db/valueType :db.type/keyword}

  ;; ── :cable.link/* — FIRST-CLASS edge: a cable lands at a station ──
  ;;    (cable ⇄ station incidence; the bipartite backbone of the KG)
  {:db/ident :cable.link/id       :db/valueType :db.type/string  :db/unique :db.unique/identity}
  {:db/ident :cable.link/cable    :db/valueType :db.type/ref     :db/doc ":cable/id"}
  {:db/ident :cable.link/station  :db/valueType :db.type/ref     :db/doc ":station/id"}
  {:db/ident :cable.link/sourcing :db/valueType :db.type/keyword}

  ;; ── :cable.seg/* — FIRST-CLASS edge: a physical segment joining two stations ──
  ;;    (station ⇄ station; carries the chokepoint a segment must traverse)
  {:db/ident :cable.seg/id        :db/valueType :db.type/string  :db/unique :db.unique/identity}
  {:db/ident :cable.seg/cable     :db/valueType :db.type/ref     :db/doc ":cable/id"}
  {:db/ident :cable.seg/from      :db/valueType :db.type/ref     :db/doc ":station/id"}
  {:db/ident :cable.seg/to        :db/valueType :db.type/ref     :db/doc ":station/id"}
  {:db/ident :cable.seg/traverses :db/valueType :db.type/keyword :db/cardinality :db.cardinality/many
   :db/doc "chokepoint(s) the segment crosses (resilience signal; NOT a route-to-cut)"}
  {:db/ident :cable.seg/sourcing  :db/valueType :db.type/keyword}

  ;; ── :cable.fault/* — an OBSERVED fault/cut/repair event (public bulletin only) ──
  ;;    Wellbecoming = Datom as-of history: faults are appended, never overwritten;
  ;;    a cable's resilience trajectory is read off the EAVT log over time (非終末論).
  {:db/ident :cable.fault/id      :db/valueType :db.type/string  :db/unique :db.unique/identity}
  {:db/ident :cable.fault/cable   :db/valueType :db.type/ref     :db/doc ":cable/id affected"}
  {:db/ident :cable.fault/segment :db/valueType :db.type/ref     :db/doc ":cable.seg/id if localized"}
  {:db/ident :cable.fault/kind    :db/valueType :db.type/keyword
   :db/doc ":anchor-drag | :fishing | :earthquake | :landslide | :equipment | :abrasion | :unknown | :under-investigation — note: watatsuna does NOT adjudicate intent; sabotage is a state matter, recorded only as a public bulletin's own classification, never asserted by watatsuna"}
  {:db/ident :cable.fault/detected-at :db/valueType :db.type/instant}
  {:db/ident :cable.fault/restored-at :db/valueType :db.type/instant :db/doc "nil while open"}
  {:db/ident :cable.fault/repair-vessel :db/valueType :db.type/string :db/doc "public AIS-named cable ship, if disclosed"}
  {:db/ident :cable.fault/sourcing :db/valueType :db.type/keyword}
  {:db/ident :watatsuna/note :db/valueType :db.type/string :db/doc "Free-text provenance/routing annotation (e.g. landing changes, Team-Telecom objections, reroutes). Declared so seed data conforms (etzhayyim.kotoba.schema)."}]

 ;; ───────────────────────────── DERIVED (analyze.py, never stored as raw fact) ────
 ;; watatsuna computes these and emits them flagged as :derived; they are not ingested
 ;; back as authoritative facts (mirrors tsumugi's edge-integral discipline).
 :derived-attributes
 [{:db/ident :resilience/station-degree     :db/doc "# distinct cables landing at a station"}
  {:db/ident :resilience/station-capacity-tbps :db/doc "Σ design-capacity of cables landing at a station"}
  {:db/ident :resilience/chokepoint-load     :db/doc "Σ capacity of segments traversing a named chokepoint — the single-point-of-failure surface"}
  {:db/ident :resilience/cable-diversity     :db/doc "# distinct chokepoints a cable depends on (lower = more brittle)"}
  {:db/ident :resilience/redundancy-gap      :db/doc "stations/regions whose cable-count ≤ threshold — routed to redundancy, NOT to interdiction"}]}
