;; orbit-ontology — the off-Earth / orbital (軌道) vocabulary for hoshimori 星守
;; ADR-2606073600 · sibling of finrisk-ontology (ADR-2606073400), asobi-ontology
;; (ADR-2606073200) and biosphere-ontology (ADR-2606073000), specialised to EARTH ORBIT —
;; the orbital sibling of watari (live ship/aircraft KG) and watatsuna (cable chokepoints).
;; Sits under the orbital land-sovereignty claim (ADR-2605192330).
;;
;; PURPOSE: mirror PUBLIC orbital catalogs (already-published object catalogs / regime
;; definitions / disposal-compliance + debris-event records) into the kotoba Datom log. The
;; lens is ORBITAL-CONGESTION concentration (which regimes bear the most crowding / collision
;; / debris risk, and which operators concentrate occupancy) vs STEWARDSHIP (remediation /
;; deconfliction / disposal), routed to STEWARDSHIP (orbital sustainability).
;;
;; CONSTITUTIONAL INVERSION (G1, read first): hoshimori is a STEWARDSHIP / sustainability map,
;; NEVER a targeting / interception / weaponization aid. It mirrors ONLY already-public
;; catalogs; it emits NO precise predictive ephemeris (no interception-grade state vector);
;; readouts are orbital-shell / regime-AGGREGATE. ASAT / kinetic-intercept / collision-causing
;; uses are unrepresentable (Charter §1.12 Transparent-Force, open + on-chain + 1 SBT=1 vote).
;;
;; EDGE-PRIMARY (N1): congestion/risk lives ONLY on edges (:en/orbit-load). A regime's
;; congestion-concentration = the INTEGRAL of its incident inbound hazard/occupancy 縁,
;; computed on READ — never a stored per-object score. There is no :hoshimori/threat-of-object.

{:schema/id "orbit-ontology"
 :schema/version "0.1.0"
 :schema/adr "2606073600"

 ;; ── nodes ──────────────────────────────────────────────────────────────────
 :node/attrs
 [{:attr :organism/id        :doc "stable id, e.g. orbit.shell.leo-low / orbit.op.starlink"}
  {:attr :organism/kind       :doc ":shell | :operator | :hazard | :service"}
  {:attr :organism/label      :doc "common/display label"}
  {:attr :organism/sourcing   :doc ":authoritative (public catalog / regime def / disposal rule) | :representative (bounded seed)"}

  ;; shell facet (an orbital regime — the bearer of congestion)
  {:attr :shell/regime        :doc ":leo-low | :leo-high | :sso | :meo | :geo | :heo"}
  {:attr :shell/alt-band-km   :doc "representative altitude band label, e.g. \"340-550\" (NOT a per-object ephemeris)"}

  ;; operator facet (the occupant / constellation)
  {:attr :op/kind             :doc ":constellation | :single-asset | :station | :agency"}
  {:attr :op/jurisdiction     :doc "ISO-3166 home jurisdiction (public registry fact)"}

  ;; hazard facet (the 取-holder; channel of orbital risk)
  {:attr :hazard/kind         :doc ":debris-density | :conjunction | :congestion | :asat-debris-event | :space-weather | :deorbit-shortfall"}

  ;; service facet (what depends on the regime — the public utility borne)
  {:attr :service/kind        :doc ":pnt | :broadband | :earth-observation | :weather | :science"}]

 ;; ── edges (縁) ───────────────────────────────────────────────────────────────
 :edge/attrs
 [{:attr :en/from            :doc "source organism id"}
  {:attr :en/to              :doc "target organism id"}
  {:attr :en/kind            :doc ":congests | :imperils | :depends-on | :remediates | :deconflicts | :deorbits"}
  {:attr :en/orbit-load      :doc "0..1 — for HAZARD 縁 (:congests/:imperils): occupancy/collision severity; for STEWARDSHIP 縁 (:remediates/:deconflicts/:deorbits): sustainability afforded; for :depends-on: service criticality. karma lives HERE (N1)."}
  {:attr :en/sourcing        :doc ":authoritative | :representative"}]

 ;; ── derived (transient, computed on READ — NEVER stored; N1/G2) ──────────────
 :derived/attrs
 [{:attr :bond/congestion-concentration :doc "shell integral of incident inbound hazard/occupancy 縁 × disclosed regime weight — the stewardship surface"}
  {:attr :bond/stewardship-buffer       :doc "node integral of incident :remediates/:deconflicts/:deorbits loads — sustainability capacity"}
  {:attr :bond/dependency-fragility     :doc "node integral of incident :depends-on loads — service cascade risk"}
  {:attr :bond/is-transient             :doc "const true — derived readout, not a stored datom"}]

 ;; ── disclosed orbital-regime → representative criticality/crowding weight (NOT a verdict) ──
 :regime/weight
 {:leo-low 1.0 :sso 0.9 :geo 0.8 :leo-high 0.7 :meo 0.6 :heo 0.4}}
