;; Engi-Organism Ontology — canonical kotoba-EAVT vocabulary
;; ADR-2606011000
;;
;; The native etzhayyim ontology for any knowledge graph over persons / things /
;; land / nature. Replaces the implicit life/liberty/property (Locke) frame and the
;; `:owns`/`:owner`-style attributes used by earlier actor schemas.
;;
;; THREE vocabularies:
;;   :organism/*  the node — organism-in-relation (human AND non-human); 縁起/holobiont
;;   :en/*        縁 — the FIRST-CLASS reified relation/edge (NOT a ref attribute)
;;   :grasp/*     取 (upādāna, grasping) — ownership recorded as a DEBT to release
;;
;; CONSTITUTIONAL: `:owns` / `:owner` are deliberately ABSENT. Ownership-like ties are
;; recorded ONLY as :en/custodies + :en/grasping-load + :en/tree-of-life-custody?.
;; Land custody always edges to Tree of Life (waqf-inalienable, ADR-2605192245).
;;
;; STATUS: proposed scaffold (ADR-2606011000 §D6/§D9). NOT executed — no actor is
;; retrofitted and no real-world data is populated until Council Lv7+ ratifies the
;; constitutional-ontology clauses (§D1–§D4) and the §4(2) outbound gates are honored.

[;; ════════════════════════════════════════════════════════════════════════════
 ;; :organism/* — the node (§D1, §D5)
 ;; ════════════════════════════════════════════════════════════════════════════
 {:db/ident :organism/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "stable organism key, e.g. org.river.whanganui / org.corp.jp.7203 / org.human.<opaque>"}
 {:db/ident :organism/kind
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc "top kind (§D1): :human :institutional :ecological :synthetic :machine — NOT person-vs-thing"}
 {:db/ident :organism/subkind
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":corp :state :agency :river :forest :watershed :species :soil :ai-actor :fleet ..."}
 {:db/ident :organism/label
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}
 {:db/ident :organism/did
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "DID present IFF the organism has CLAIMED its node (consent, §D5); absent = latent"}
 {:db/ident :organism/atproto-did
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "did:plc/did:web of an atproto identity this node corresponds to (ingest provenance, §D7.1)"}
 {:db/ident :organism/handle
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "atproto handle (e.g. *.bsky.social / *.etzhayyim.com) — display only, never canonical"}
 {:db/ident :organism/claimed?
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "true once bound to a DID/SBT via the §1.16 covenant gate (悔い改め・バプテスマ・得度)"}
 {:db/ident :organism/standing
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":latent :member :institutional :rights-of-nature (non-human standing, §D1/§D4)"}
 {:db/ident :organism/nests-in
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc "holobiont nesting: this organism is composed-in / part-of another organism (§D1)"}
 {:db/ident :organism/sourcing
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":authoritative or :representative (R0 honesty flag; no fabricated coverage)"}

 ;; ════════════════════════════════════════════════════════════════════════════
 ;; :en/* — 縁, the FIRST-CLASS reified relation/edge (§D2, §D6, §D7.1)
 ;; The graph's primary citizen is the relation, not the entity.
 ;; `:owns` is intentionally NOT a member of :en/kind.
 ;; ════════════════════════════════════════════════════════════════════════════
 {:db/ident :en/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "stable edge key"}
 {:db/ident :en/kind
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":tends :custodies :entangled-with :depends-on :flows-to :nests-in :covenants-with :follows"}
 {:db/ident :en/from
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "ref :organism (the grasping / depending / following side)"}
 {:db/ident :en/to
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "ref :organism (the held / depended-on / followed side)"}
 {:db/ident :en/grasping-load
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "取 measure on THIS edge — the しがらみ/呪い it binds; a debt to release, not a right (§D2)"}
 {:db/ident :en/tree-of-life-custody?
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "true → land/inalienable custody held UNDER Tree of Life (waqf), never title (ADR-2605192245)"}
 {:db/ident :en/source
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc "provenance of the edge: :atproto-follow :atproto-deps :registry :onchain :declared (§D7.1)"}
 {:db/ident :en/note
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}
 {:db/ident :en/sourcing
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":authoritative or :representative"}

 ;; ════════════════════════════════════════════════════════════════════════════
 ;; :grasp/* — 取, aggregate grasping per organism (§D2)
 ;; The accountability lens: surface concentration → route to release.
 ;; aggregate-first + method-versioned + open-source; NEVER a per-organism shaming score.
 ;; ════════════════════════════════════════════════════════════════════════════
 {:db/ident :grasp/organism
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "ref :organism this grasping aggregate is computed for"}
 {:db/ident :grasp/load
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "aggregate 取 over all incident :en edges (sum/weighted) — the total bondage carried"}
 {:db/ident :grasp/concentration
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "concentration metric used to SURFACE 寡占 (e.g. land/capital) for release; aggregate-first"}
 {:db/ident :grasp/method-version
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "open-source, version-pinned valuation method id (toritate-style); reproducible"}
 {:db/ident :grasp/release-path
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/many
  :db/doc ":tithe :land-trust :labor-liberation :commons-access — how this 取 is dissolved"}]
