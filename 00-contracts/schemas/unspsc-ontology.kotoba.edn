;; unspsc-ontology — kotoba EAVT vocabulary for the Open-UNSPSC commodity-agent fleet
;; ADR-2605171300 (Open-UNSPSC Generative Agent Fleet) · actor family: kotodama unispsc_agents
;;
;; PURPOSE
;;   A content-addressed Datom (EAVT) vocabulary registering the UNSPSC commodity
;;   taxonomy (United Nations Standard Products and Services Code) and its per-code
;;   generative agents into the kotoba Datom log. Each 8-digit UNSPSC code
;;   (SS·FF·CC·PP = Segment·Family·Class·Commodity) is an entity with a stable
;;   did:web:etzhayyim.com:actor:c<code> identity, so the 18,342-agent fleet is
;;   queryable as first-class Datomic entities rather than only k8s queue files.
;;
;; SUBSTRATE (ADR-2605262130 + 2605312345): canonical state is the kotoba Datom log.
;;   This SUPERSEDES the NDJSON post-sink queue (ADR-2605240100) as the system-of-record
;;   for the commodity registry (the queue remains the Shinka social-post egress path).
;;
;; SOURCING HONESTY (G5): titles are sector-derived representative labels extracted from
;;   the generative-agent definitions (not the official UNSPSC licensed dictionary), so
;;   `:unspsc/sourcing` is :representative. A licensed-dictionary ingest would tag
;;   :authoritative. Absence of a code = "not yet ingested", never "does not exist".

{:schema/id        "unspsc-ontology"
 :schema/version   "0.1.0"
 :schema/adr       "2605171300"
 :schema/note      "kotoba-native registry for the Open-UNSPSC commodity-agent fleet; supersedes the NDJSON post-sink as the commodity system-of-record (ADR-2605240100 keeps social egress)."

 :attributes
 [;; ── :unspsc.seg/* — a top-level UNSPSC SEGMENT (2-digit) ──
  {:db/ident :unspsc.seg/id      :db/valueType :db.type/string  :db/unique :db.unique/identity :db/doc "stable id, e.g. \"seg.10\""}
  {:db/ident :unspsc.seg/code    :db/valueType :db.type/string  :db/doc "2-digit segment code, e.g. \"10\""}
  {:db/ident :unspsc.seg/title   :db/valueType :db.type/string  :db/doc "segment label"}
  {:db/ident :unspsc.seg/sourcing :db/valueType :db.type/keyword}

  ;; ── :unspsc/* — a UNSPSC commodity code + its generative agent ──
  {:db/ident :unspsc/id          :db/valueType :db.type/string  :db/unique :db.unique/identity :db/doc "stable id = the 8-digit code, e.g. \"10101500\""}
  {:db/ident :unspsc/code        :db/valueType :db.type/string  :db/doc "8-digit UNSPSC code"}
  {:db/ident :unspsc/title       :db/valueType :db.type/string  :db/doc "commodity title (sector-derived; :representative)"}
  {:db/ident :unspsc/segment     :db/valueType :db.type/ref     :db/doc ":unspsc.seg/id of the enclosing 2-digit segment"}
  {:db/ident :unspsc/did         :db/valueType :db.type/string  :db/doc "agent DID = did:web:etzhayyim.com:actor:c<code>"}
  {:db/ident :unspsc/agent       :db/valueType :db.type/boolean :db/doc "true = a deployed generative agent exists (UnispscOrganism, ADR-2605232345)"}
  {:db/ident :unspsc/sourcing    :db/valueType :db.type/keyword :db/doc ":authoritative (licensed UNSPSC) | :representative (agent-derived)"}]}
