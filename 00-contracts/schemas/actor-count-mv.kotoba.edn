;; actor-count-mv.kotoba.edn — kotoba-native MATERIALIZED VIEW declaration for
;; entity-as-actor counts (ADR-2606042330 + ADR-2606041151 B + ADR-2605262130).
;;
;; PURPOSE — answer "how is the `totalActors` / per-namespace count obtained in
;; kotoba Datomic without a heavy query?" The apex Worker today returns the
;; precomputed `ENTITY_TOTAL_COUNT` constant (cheapest: zero query). This file is
;; the kotoba-native form for when the mirror actors live in the Datom log: a
;; MATERIALIZED VIEW maintained incrementally by `kotoba-kqe` `MvRegistry`
;; (`crates/kotoba-kqe/src/mv.rs`) — fed each commit's Δ via `MvRegistry::maintain`,
;; read O(1) via `MvRegistry::result`, NEVER a per-request full EAVT scan.
;;
;; Three count tiers (see ADR-2606042330 follow-up note):
;;   1. whole-universe / per-namespace count  → THIS MV (incremental, O(1) read)
;;   2. exact-value facet (e.g. jurisdiction)  → AVET index-range (kotoba-kqe `pos`)
;;   3. text / substring (e.g. q="tokyo")      → BM25 inverted index (`cc/bm25/*`)
;;
;; kotoba HAS the substrates this needs (verified in 40-engine/kotoba):
;;   - tx-function:  `:db.fn/cas` + `transact_with_tx_fns` (kotoba-server/xrpc.rs,
;;     kotoba-datomic/distributed.rs) — the manual counter-datom alternative.
;;   - log-consumer: KSE Journal `subscribe()->Cursor` (kotoba-kse/journal.rs) +
;;     firehose egress + jetstream/subscribeRepos ingress (kotoba-graph).
;;   - incremental MV: `MvRegistry` + `Delta` + `SqlMvCompiler` (kotoba-kqe) —
;;     the layer vanilla Datomic LACKS; this declaration targets it.

{:mv/version 1
 :mv/adr ["2606042330" "2606041151" "2605262130" "2605215000"]
 :mv/graph "actors-v1"

 ;; ── source datoms (the mirror actors, once ingested via kg.ingest_batch) ──
 ;; emit_ingest_batch.mjs materializes one entity per mirror actor with these
 ;; attributes. `:actor/namespace` is the GROUP-BY key of the count MV.
 :mv/source-schema
 {:actor/handle        {:type :string  :unique :identity}
  :actor/namespace     {:type :keyword :doc "#{:gov :corp :cable :station :craft} — count GROUP-BY key"}
  :actor/display-name  {:type :string}
  :actor/is-mirror     {:type :boolean :doc "const true (G1)"}
  :actor/performer-type {:type :keyword :doc "#{:organization :system} — never :person (G3)"}}

 ;; ── the count MaterializedView ──
 ;; Registered once via `MvRegistry::register("actor-ns-count", program)`. The
 ;; program is the SQL below compiled by `SqlMvCompiler::compile(sql, out)`
 ;; (kotoba-kqe/src/sql.rs) → DatalogProgram. Every committed transaction's
 ;; Δ flows through `maintain(&deltas)`; the per-namespace tally is advanced
 ;; incrementally (assert → +1, retract → −1), never recomputed from scratch.
 :mv/views
 [{:mv/name   "actor-ns-count"
   :mv/output-relation ":actor.ns.count"
   ;; GROUP BY the namespace key. SqlMvCompiler accepts COUNT(*) GROUP BY
   ;; (kotoba-kqe `aggregate_count_by_role` / `population_count_by_status` are
   ;; the proven shapes).
   :mv/sql    "SELECT a.namespace, COUNT(*) FROM actor AS a GROUP BY a.namespace"
   ;; derived datoms the MV maintains (read O(1) by a point query / kg.query):
   ;;   :actor.ns.count/gov 7106  :actor.ns.count/corp 1733  … per namespace
   :mv/derived-pred ":actor.ns.count/<namespace>"}

  {:mv/name   "actor-total-count"
   :mv/output-relation ":actor.count"
   :mv/sql    "SELECT COUNT(*) FROM actor"
   ;; single maintained scalar — the Worker's `totalActors` for the browse view:
   ;;   :actor.count/total 8888
   :mv/derived-pred ":actor.count/total"}]

 ;; ── as-of correctness (why Datomic itself avoids global MVs) ──
 ;; The MV is materialized at a specific commit-DAG root. A query `as-of` an older
 ;; root either reads that root's snapshot MV or recomputes — so the count datom
 ;; is itself commit-root-versioned (非終末論: every count has an as-of, there is
 ;; no single mutable "current count" row). ADR-2605312345.
 :mv/as-of-note "count datoms are commit-root-versioned; read latest root for current, as-of <root> for historical"

 ;; ── tx-function alternative (Datomic-compatible minimal path) ──
 ;; If the MV layer is not used, maintain the counters in-band with a tx-function
 ;; in the same transaction that adds/removes a mirror:
 ;;   [[:db.fn/cas [:actor.ns.count/gov] :count <old> <new>]]
 ;; (kotoba supports :db.fn/cas natively — kotoba-server/xrpc.rs). Atomic read-
 ;; modify-write, single-point read. The MV is preferred (no manual counter code).
 :mv/tx-fn-alternative "[[:db.fn/cas [:actor.ns.count/<ns>] :count <old> <new>]]"

 ;; ── Worker integration (gated, fail-open — mirrors ADR-2606013800 tiering) ──
 ;; entity-actors.ts ENTITY_TOTAL_COUNT is the compiled fallback (zero query).
 ;; When KOTOBA_ENDPOINT is configured, the Worker MAY point-read
 ;; :actor.count/total / :actor.ns.count/<ns> from this MV instead. Until then the
 ;; compiled constant serves (identical value; the MV just promotes it to a live,
 ;; incrementally-maintained source). Live read is G8 outward-gated.
 :mv/worker-fallback ":entity-actors/ENTITY_TOTAL_COUNT (compiled; MV promotes to live when KOTOBA_ENDPOINT set)"}
