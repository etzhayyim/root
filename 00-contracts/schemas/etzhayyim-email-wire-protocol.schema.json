{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.etzhayyim.com/gewp/v1/schema.json",
  "title": "etzhayyim Email Wire Protocol (GEWP) v1.0 — Core Schema",
  "description": "Open standard (Apache-2.0) for structured agent/human email message passing over SMTP/MIME. Spec: https://spec.etzhayyim.com/gewp/v1/. MIME type: application/vnd.gewp+json.",
  "type": "object",
  "required": ["gewp", "type", "thread", "sender", "to"],
  "additionalProperties": false,
  "properties": {
    "gewp": {
      "type": "string",
      "const": "1.0",
      "description": "Protocol version. REQUIRED."
    },
    "type": {
      "type": "string",
      "enum": ["pregel.message", "pregel.barrier", "human.intent"],
      "description": "Message type. 'human.intent' is synthesized by the receiving agent from unstructured human email; senders MUST NOT use it."
    },
    "performative": {
      "type": "string",
      "enum": ["inform", "request", "query-if", "propose", "confirm", "refuse", "failure"],
      "description": "Draws vocabulary from FIPA-ACL SC00061. REQUIRED when sender is an agent (type != human.intent)."
    },
    "extensions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Declared extensions in this message. E.g. ['ext:pregel', 'ext:atproto', 'ext:langgraph']."
    },

    "thread": {
      "type": "object",
      "required": ["id", "step"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "description": "Partition key. Stable across all steps of one conversation. REQUIRED."
        },
        "step": {
          "type": "integer",
          "minimum": 0,
          "description": "Pregel superstep counter. Monotonically increasing. REQUIRED."
        },
        "root_message_id": {
          "type": "string",
          "description": "[ext:pregel] RFC 5322 Message-ID of the thread root email."
        },
        "barrier": {
          "type": "object",
          "description": "[ext:pregel] Superstep barrier parameters.",
          "additionalProperties": false,
          "required": ["total_vertices"],
          "properties": {
            "total_vertices": { "type": "integer", "minimum": 1 },
            "timeout_seconds": { "type": "integer", "minimum": 1, "default": 300 }
          }
        },
        "graph": {
          "type": "string",
          "description": "[ext:langgraph] LangGraph graph name."
        },
        "run_id": {
          "type": "string",
          "description": "[ext:langgraph] LangGraph run ID."
        }
      }
    },

    "sender": {
      "$ref": "#/$defs/actor",
      "description": "ActivityStreams 2.0 actor vocabulary. REQUIRED."
    },

    "to": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/recipient" },
      "description": "Direct recipients. REQUIRED."
    },
    "cc": {
      "type": "array",
      "items": { "$ref": "#/$defs/recipient" },
      "description": "CC recipients. Observers only."
    },

    "payload": {
      "type": "object",
      "description": "Application-specific message content. Schema is defined by the graph/application. May be signal:v1:{ciphertext} encrypted under BEC Tier-2. REQUIRED."
    },

    "state": {
      "type": "object",
      "description": "Pregel vertex state snapshot. OPTIONAL.",
      "additionalProperties": false,
      "properties": {
        "inline": {
          "oneOf": [{ "type": "object" }, { "type": "null" }],
          "description": "State inlined when < 4KB."
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "cid": { "type": "string", "description": "[ext:atproto] AT Protocol CID." }
          }
        }
      }
    },

    "auth": {
      "type": "object",
      "description": "Integrity token. OPTIONAL.",
      "required": ["nonce", "issued_at"],
      "additionalProperties": false,
      "properties": {
        "nonce": { "type": "string" },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "sig": {
          "type": "string",
          "description": "HMAC-SHA256(canonical JSON of payload, thread.id + nonce)."
        }
      }
    }
  },

  "$defs": {
    "actor": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "@type": {
          "type": "string",
          "enum": ["Person", "Service", "Application"],
          "description": "ActivityStreams 2.0 actor type."
        },
        "id": {
          "type": "string",
          "format": "uri",
          "description": "Actor IRI. REQUIRED."
        },
        "email": { "type": "string", "format": "email" },
        "did": {
          "type": "string",
          "pattern": "^did:",
          "description": "[ext:atproto] AT Protocol DID."
        },
        "handle": {
          "type": "string",
          "description": "[ext:atproto] AT Protocol handle."
        },
        "model": {
          "type": "string",
          "description": "[ext:langgraph] LLM model ID. Use resolveModelId() / MURAKUMO_DEFAULT_MODEL. Agent senders only."
        }
      }
    },
    "recipient": {
      "type": "object",
      "required": ["role"],
      "additionalProperties": true,
      "properties": {
        "@type": {
          "type": "string",
          "enum": ["Person", "Service", "Application"]
        },
        "id": { "type": "string", "format": "uri" },
        "email": { "type": "string", "format": "email" },
        "role": {
          "type": "string",
          "enum": ["vertex", "observer", "human"],
          "description": "vertex: next Pregel node (receives full payload). observer: CC only, no payload. human: PII-safe text only, payload omitted."
        },
        "did": {
          "type": "string",
          "pattern": "^did:",
          "description": "[ext:atproto] AT Protocol DID."
        },
        "handle": { "type": "string" },
        "node": {
          "type": "string",
          "description": "[ext:langgraph] LangGraph node name. REQUIRED when role=vertex and ext:langgraph is declared."
        }
      }
    }
  }
}
