;; passive-dns-cti-ontology — kotoba EAVT vocabulary for passive-DNS + CTI observations
;; ADR-2605301400 T3 (yabai CTI/DNS/IP-history/access-audit SQL → kotoba) · actor: yabai.etzhayyim.com
;;
;; PURPOSE
;;   A content-addressed Datom (EAVT) vocabulary for the cyber-threat-intelligence
;;   graph: domains and their DNS resolution history (passive DNS), the IP hosting /
;;   location HISTORY of an address over time, TLS certificate observations (CT logs),
;;   and a unified IOC indicator store. The lens is DEFENSIVE attribution + risk
;;   context — who an infrastructure node belongs to and how it has moved — framed
;;   toward protection / takedown-routing / abuse reporting, NEVER offensive targeting.
;;
;;   This vocabulary REPLACES the legacy yabai RisingWave / yata Workers-RPC SQL graph
;;   (WhoisRecord / DnsRecord / IpHostingHistory / IpLocationHistory / TlsCertificate /
;;   IocIndicator / IntelAccessLog …). Per ADR-2605262130 + 2605312345 the canonical
;;   state is the kotoba Datom log; IPFS = block backend, MST = ingress/interop wire,
;;   Base L2 = trust anchor. NO RisingWave, NO centralized SQL as system-of-record.
;;
;; ACTIVE COLLECTION (能動的) — authorized for this actor, defensive CTI:
;;   yabai MAY actively pull PUBLIC threat-intel surfaces: Certificate Transparency
;;   logs (crt.sh / CT log API), passive-DNS history (operator-staged archives /
;;   compatible feeds), public IOC/abuse feeds, and BGP route-collector events. Active
;;   collection is GATE-G7 operator-gated and offline-default in code. Proprietary
;;   feeds (SecurityTrails / DNSDB / Recorded Future) are accepted ONLY as
;;   :feature-flagged-input, never :system-of-record (mirrors tadori ingest discipline).
;;   Tor exit-node lists MAY be ingested as public infrastructure indicators.
;;   BitTorrent observations are case-bound only: victim-provided captures,
;;   operator-staged evidence, or Council-authorized defensive mandates. yabai
;;   must not run broad swarm surveillance or infer private-person identity from
;;   torrent participation.
;;
;; SOURCING HONESTY (G5):
;;   :*/sourcing ∈ { :authoritative      ; from a primary public log (CT log, RDAP,
;;                                          route collector, the org's own abuse feed)
;;                   :representative      ; publicly documented bounded sample
;;                   :feature-flagged-input ; vendor-compatible feed; NEVER system-of-record
;;                   :synthesized }       ; derived/estimated by yabai; MUST be flagged
;;
;; PII / CONFIDENTIALITY (constitutional — tadori G6/G10 lineage):
;;   - Access-audit records (who queried the intel) and any record mapping infrastructure
;;     to a private natural person MUST set :cti.attr/encrypted true; the payload then
;;     lives under com.etzhayyim.encrypted.* (XChaCha20-Poly1305 envelope, Signal-wrapped
;;     to case-member DIDs, ADR-2605181100) — NEVER plaintext on the Datom log.
;;   - yabai does NOT de-anonymise etzhayyim adherents and does NOT run untargeted mass
;;     surveillance. Public infrastructure attribution only.
;;   - Tor/torrent evidence supports defensive routing, abuse reporting, and
;;     case evidence preservation. It is NOT an actor-identification oracle.
;;   - SCORING / ENFORCEMENT separation: yabai scores risk; only the Council authorizes
;;     enforcement. tadori produces case-anchored evidence; yabai is the risk organ.

{:schema/id        "passive-dns-cti-ontology"
 :schema/version   "0.1.0"
 :schema/adr       "2605301400"
 :schema/supersedes ["WhoisRecord" "DnsRecord" "AsnInfo" "GeoipEnrichment"
                     "IpHostingHistory" "IpLocationHistory" "TlsCertificate"
                     "IocIndicator" "IntelAccessLog" "IntelSession" "IntelDevice"]
 :schema/note      "kotoba-native successor to the yabai RisingWave CTI/DNS/IP-history/access-audit SQL graph. ADR-2605301400 §T3."

 :attributes
 [;; ── :domain/* — a DNS domain/FQDN observed in the threat graph ──
  {:db/ident :domain/id           :db/valueType :db.type/string  :db/unique :db.unique/identity :db/doc "stable id, e.g. \"domain.example-com\""}
  {:db/ident :domain/fqdn         :db/valueType :db.type/string  :db/doc "fully-qualified name, e.g. \"example.com\""}
  {:db/ident :domain/tld          :db/valueType :db.type/string}
  {:db/ident :domain/registrar    :db/valueType :db.type/string  :db/doc "public registrar (WHOIS/RDAP)"}
  {:db/ident :domain/created-at   :db/valueType :db.type/string  :db/doc "registration date; very-recent = short-lived-domain risk signal"}
  {:db/ident :domain/sourcing     :db/valueType :db.type/keyword}

  ;; ── :pdns/* — a PASSIVE DNS observation (domain --rrtype--> rrdata, as-of) ──
  ;;    Wellbecoming = as-of history: appended, never overwritten (非終末論).
  {:db/ident :pdns/id             :db/valueType :db.type/string  :db/unique :db.unique/identity}
  {:db/ident :pdns/domain         :db/valueType :db.type/ref     :db/doc ":domain/id"}
  {:db/ident :pdns/rrtype         :db/valueType :db.type/keyword :db/doc ":a | :aaaa | :ns | :mx | :cname | :txt | :soa"}
  {:db/ident :pdns/rrdata         :db/valueType :db.type/string  :db/cardinality :db.cardinality/many :db/doc "answer value(s); for :a/:aaaa this is the IP"}
  {:db/ident :pdns/ip             :db/valueType :db.type/ref     :db/doc ":ip/id when rrtype is :a/:aaaa (links to the ipaddress graph)"}
  {:db/ident :pdns/ttl            :db/valueType :db.type/long    :db/doc "TTL seconds; tiny TTL + many IPs = fast-flux signal"}
  {:db/ident :pdns/first-seen-at  :db/valueType :db.type/string}
  {:db/ident :pdns/last-seen-at   :db/valueType :db.type/string}
  {:db/ident :pdns/sourcing       :db/valueType :db.type/keyword}

  ;; ── :iphist/* — IP hosting / location HISTORY over time (as-of) ──
  ;;    Replaces yabai IpHostingHistory + IpLocationHistory. Append-only timeline.
  {:db/ident :iphist/id           :db/valueType :db.type/string  :db/unique :db.unique/identity}
  {:db/ident :iphist/ip           :db/valueType :db.type/ref     :db/doc ":ip/id (ipaddress graph)"}
  {:db/ident :iphist/asn          :db/valueType :db.type/ref     :db/doc ":asn/id hosting the IP at observation time"}
  {:db/ident :iphist/provider     :db/valueType :db.type/string  :db/doc "hosting provider org (public)"}
  {:db/ident :iphist/provider-type :db/valueType :db.type/keyword :db/doc ":cloud | :vps | :dedicated | :cdn | :residential | :bulletproof | :unknown"}
  {:db/ident :iphist/country      :db/valueType :db.type/string}
  {:db/ident :iphist/observed-at  :db/valueType :db.type/string}
  {:db/ident :iphist/previous     :db/valueType :db.type/ref     :db/doc ":iphist/id of the prior observation (movement chain)"}
  {:db/ident :iphist/sourcing     :db/valueType :db.type/keyword}

  ;; ── :tlscert/* — a TLS certificate observation (Certificate Transparency log) ──
  {:db/ident :tlscert/id          :db/valueType :db.type/string  :db/unique :db.unique/identity}
  {:db/ident :tlscert/sha256      :db/valueType :db.type/string  :db/doc "cert fingerprint"}
  {:db/ident :tlscert/issuer      :db/valueType :db.type/string}
  {:db/ident :tlscert/subject     :db/valueType :db.type/string  :db/doc "CN"}
  {:db/ident :tlscert/san         :db/valueType :db.type/string  :db/cardinality :db.cardinality/many :db/doc "subject-alt-names (pivot surface)"}
  {:db/ident :tlscert/not-before  :db/valueType :db.type/string}
  {:db/ident :tlscert/not-after   :db/valueType :db.type/string}
  {:db/ident :tlscert/ct-log      :db/valueType :db.type/string  :db/doc "CT log source, e.g. crt.sh / a log name"}
  {:db/ident :tlscert/anomaly     :db/valueType :db.type/keyword :db/doc ":self-signed | :expired | :san-mismatch | :short-lived | :none"}
  {:db/ident :tlscert/sourcing    :db/valueType :db.type/keyword}

  ;; ── :indicator/* — unified IOC store (ip/domain/url/hash/email) ──
  {:db/ident :indicator/id        :db/valueType :db.type/string  :db/unique :db.unique/identity}
  {:db/ident :indicator/type      :db/valueType :db.type/keyword :db/doc ":ip | :domain | :url | :hash | :email | :cert"}
  {:db/ident :indicator/value     :db/valueType :db.type/string}
  {:db/ident :indicator/category  :db/valueType :db.type/keyword :db/doc ":phishing | :c2 | :malware | :botnet | :scanner | :tor-exit | :brute-force | :benign | :unknown"}
  {:db/ident :indicator/tlp       :db/valueType :db.type/keyword :db/doc ":clear | :green | :amber | :red (TLP 2.0)"}
  {:db/ident :indicator/confidence :db/valueType :db.type/long   :db/doc "0..1000 per-mille"}
  {:db/ident :indicator/status    :db/valueType :db.type/keyword :db/doc ":candidate | :confirmed | :retracted | :superseded"}
  {:db/ident :indicator/first-seen-at :db/valueType :db.type/string}
  {:db/ident :indicator/last-seen-at  :db/valueType :db.type/string}
  {:db/ident :indicator/source    :db/valueType :db.type/string  :db/doc "feed/source id"}
  {:db/ident :indicator/sourcing  :db/valueType :db.type/keyword}

  ;; ── :btobs/* — BitTorrent case-bound observation, not mass surveillance ──
  {:db/ident :btobs/id            :db/valueType :db.type/string  :db/unique :db.unique/identity}
  {:db/ident :btobs/infohash      :db/valueType :db.type/string  :db/doc "torrent infohash from case evidence or operator-staged defensive capture"}
  {:db/ident :btobs/display-name  :db/valueType :db.type/string  :db/doc "optional torrent/display name when present in supplied evidence"}
  {:db/ident :btobs/peer-ip       :db/valueType :db.type/ref     :db/doc ":ip/id for a public infrastructure peer observed in a case-bound capture"}
  {:db/ident :btobs/observed-at   :db/valueType :db.type/string}
  {:db/ident :btobs/evidence-cid  :db/valueType :db.type/string  :db/doc "CID of the preserved supplied/case-mandated evidence envelope"}
  {:db/ident :btobs/case-mandate  :db/valueType :db.type/string  :db/doc "case or Council mandate id; required for non-victim-supplied capture"}
  {:db/ident :btobs/sourcing      :db/valueType :db.type/keyword}

  ;; ── :access/* — intel ACCESS-AUDIT record (who queried the intel) — ALWAYS encrypted ──
  ;;    Replaces yabai IntelAccessLog/IntelSession/IntelDevice. PII-bearing by nature:
  ;;    accessor identity / IP / device fingerprint. MUST be encrypted (G6/G10).
  {:db/ident :access/id           :db/valueType :db.type/string  :db/unique :db.unique/identity}
  {:db/ident :access/action       :db/valueType :db.type/keyword :db/doc ":query | :view | :export | :bulk-query"}
  {:db/ident :access/resource     :db/valueType :db.type/ref     :db/doc "what was accessed (:domain/id, :indicator/id, …)"}
  {:db/ident :access/accessed-at  :db/valueType :db.type/string}
  {:db/ident :access/envelope-cid :db/valueType :db.type/string  :db/doc "CID of the com.etzhayyim.encrypted.* envelope holding accessor identity/IP/device"}
  {:db/ident :access/sourcing     :db/valueType :db.type/keyword}

  ;; ── PII guard: any record mapping infra → private person, or any access record ──
  {:db/ident :cti.attr/encrypted  :db/valueType :db.type/boolean
   :db/doc "MUST be true for :access/* and for any record attributing infrastructure to a private natural person; payload then under com.etzhayyim.encrypted.* (ADR-2605181100). Public org/provider names are NOT PII."}]

 ;; ── DERIVED (analyze.py, never re-ingested as authoritative fact) ──
 :derived-attributes
 [{:db/ident :cti/fast-flux-domain   :db/doc "domains whose A-record set churns across many IPs at low TTL"}
  {:db/ident :cti/hosting-concentration :db/doc "Σ observed infra per hosting provider / provider-type"}
  {:db/ident :cti/ioc-tlp-load       :db/doc "indicator count per TLP / category"}
  {:db/ident :cti/ip-movement        :db/doc "IPs whose hosting/location history shows the most moves (migration churn)"}
  {:db/ident :cti/cert-pivot         :db/doc "certs whose SAN set bridges many domains (shared-infra pivot)"}]}
