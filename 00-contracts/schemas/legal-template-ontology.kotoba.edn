;; legal-template-ontology — the legal-document-template-commons (法律文書雛形) vocabulary
;; for hinagata 雛形 · ADR-2606111954. The fairness/access sibling of the legal lineage:
;; where chigiri 契 (ADR-2605262700) runs the legal-PROCEDURE substrate and the global
;; legal-corpus (ADR-2605262800) ingests the statutes themselves, hinagata holds the
;; PUBLISHED, FAIR, REUSABLE DOCUMENT TEMPLATES — and binds each template clause to the
;; ACTUAL STATUTE it rests on, so a template is never free-floating boilerplate but a
;; structure traceable to public law.
;;
;; PURPOSE: weave fair, neutral, openly-licensed legal-document templates (contracts,
;; agreements, covenants, notices) — decomposed into reusable CLAUSES — into the kotoba
;; Datom log, and link every clause to the public STATUTE / instrument it cites or is
;; mandated by (:cites-statute / :mandated-by 縁). The lens is integrated STATUTORY
;; GROUNDEDNESS over a template, routed to PUBLIC RELEASE (anyone may use it freely),
;; never to legal advice.
;;
;; CONSTITUTIONAL INVERSION (G1, read first): hinagata is a COMMONS of public, openly-
;; licensed templates that ANYONE may copy and adapt, NEVER the practice of law. It issues
;; NO advice, NO opinion on a specific situation, NO representation, NO "this is legal for
;; you" verdict. A template's statute citation is a DISCLOSED structural fact (this clause
;; cites this article), never a hinagata adjudication that the clause is valid or sufficient
;; in any jurisdiction. UPL (unauthorized practice of law) is structurally excluded: the unit
;; is ALWAYS a template / clause / statute-link, never a party, a matter, or a recommendation.
;; It inverts the proprietary-legal-forms apparatus (paywalled boilerplate, vendor lock-in):
;; it routes drafting knowledge to free public use and equal access, never to gatekeeping.
;;
;; EDGE-PRIMARY (N1): statutory grounding lives ONLY on edges (:en/binding-load, weighted by
;; the DISCLOSED clause :clause/optionality). A template's groundedness = the INTEGRAL of its
;; incident clause :cites-statute / :mandated-by + direct template :cites-statute 縁, computed
;; on READ — never a stored per-template score. There is no :lt/score-of-template.
;;
;; NON-ADJUDICATING (N3): a statute citation, an instrument name, an optionality category
;; (:mandatory / :recommended / :optional) are DISCLOSED facts sourced from the public
;; instrument or its official guidance, never hinagata verdicts. hinagata datafies the
;; template–clause–statute structure; it never advises, never certifies enforceability,
;; never tells a person what to sign.

{:schema/id "legal-template-ontology"
 :schema/version "0.1.0"
 :schema/adr "2606111954"

 ;; ── nodes ──────────────────────────────────────────────────────────────────
 :node/attrs
 [{:attr :lt/id          :doc "stable id, e.g. tmpl.nda-mutual / cl.confidentiality / st.gdpr-28 / jx.eu / concept.data-protection"}
  {:attr :lt/kind        :doc ":template | :clause | :statute | :jurisdiction | :concept | :license"}
  {:attr :lt/label       :doc "common/display label"}
  {:attr :lt/sourcing    :doc ":authoritative (official instrument / its published guidance) | :representative (bounded illustrative seed)"}
  {:attr :lt/links       :doc "optional cross-actor id — e.g. a chigiri procedure, a musubi ceremony, an esign envelope shape; aggregate-first"}

  ;; template facet (a publishable legal-document template — the unit anyone may reuse)
  {:attr :template/title       :doc "human title, e.g. \"Mutual Non-Disclosure Agreement\""}
  {:attr :template/lang        :doc "BCP-47 language tag of THIS template's text, e.g. \"en\" / \"ja\""}
  {:attr :template/license     :doc "SPDX id of the open license the template is published under (default \"Apache-2.0\" + Charter Rider, per repo policy)"}
  {:attr :template/version     :doc "semver of the template text, e.g. \"1.0.0\""}
  {:attr :template/stance      :doc "DISCLOSED editorial fairness stance — :balanced | :neutral | :pro-consumer | :pro-weaker-party. A disclosed drafting choice, NEVER a hinagata verdict (N3)"}
  {:attr :template/body-cid    :doc "kotoba IPFS CIDv1 (raw/sha2-256) of the canonical template body text — content-addressed, anyone may fetch + verify + reuse (G4)"}

  ;; clause facet (a reusable building block shared across templates)
  {:attr :clause/role          :doc ":definitions :recitals :payment :term :termination :confidentiality :ip-assignment :ip-license :warranty :liability :indemnity :governing-law :dispute :privacy :data-rights :force-majeure :no-interest :cooling-off :signature :boilerplate"}
  {:attr :clause/optionality   :doc "DISCLOSED — :mandatory (statute-required) | :recommended | :optional. Where a statute mandates the clause this is sourced from the instrument, not a hinagata opinion (N3)"}

  ;; statute facet (the ACTUAL public law / instrument a clause rests on — never re-judged)
  {:attr :statute/citation     :doc "canonical public citation, e.g. \"GDPR Art. 28\" / \"民法601条\" / \"CISG Art. 35\""}
  {:attr :statute/instrument   :doc "the instrument it belongs to, e.g. \"Regulation (EU) 2016/679\" / \"借地借家法\" / \"UN Convention on Contracts for the International Sale of Goods (1980)\""}
  {:attr :statute/jurisdiction :doc "id of the :jurisdiction node the statute belongs to (e.g. jx.eu / jx.jp / jx.intl)"}
  {:attr :statute/url          :doc "PUBLIC official source URL (legislation.gov / eur-lex / e-Gov / treaty depositary) — the disclosed primary, never paywalled secondary"}

  ;; jurisdiction facet
  {:attr :jurisdiction/code    :doc "ISO 3166-1 alpha-2 (\"JP\" \"US\" \"FR\"), a bloc (\"EU\"), or \"INTL\" for treaties / model laws"}
  {:attr :jurisdiction/system  :doc ":civil-law | :common-law | :mixed | :religious | :customary | :international"}

  ;; concept facet (a controlled legal concept the clause instantiates — the cross-template spine)
  {:attr :concept/code         :doc "controlled concept id, e.g. \"sale-of-goods\" / \"electronic-signature\" / \"data-protection\""}

  ;; license facet
  {:attr :license/spdx         :doc "SPDX license id, e.g. \"Apache-2.0\" / \"CC0-1.0\" / \"CC-BY-4.0\""}]

 ;; ── edges (縁) ───────────────────────────────────────────────────────────────
 :edge/attrs
 [{:attr :en/from            :doc "source legal-template-node id"}
  {:attr :en/to              :doc "target legal-template-node id"}
  {:attr :en/kind            :doc ":has-clause (template→clause) | :cites-statute (clause OR template→statute) | :mandated-by (clause→statute, statute REQUIRES this clause) | :instantiates (clause→concept) | :governed-by (template→jurisdiction) | :applies-in (statute→jurisdiction) | :translates (template→template, cross-language) | :supersedes (template→template, version) | :conflicts-with (clause→clause) | :derived-from (template→source)"}
  {:attr :en/binding-load    :doc "0..1 — strength of the statutory anchoring this 縁 carries (how directly/mandatorily the clause rests on the cited law; or reuse strength on :has-clause). karma lives HERE (N1)."}
  {:attr :en/force           :doc "DISCLOSED citation force on a statute edge — :mandated (statute requires the clause) | :cited (clause rests on / references the article) | :referenced (informational cross-reference). A disclosed structural fact, never a hinagata verdict (N3)"}
  {:attr :en/sourcing        :doc ":authoritative | :representative"}]

 ;; ── derived (transient, computed on READ — NEVER stored; N1/G2) ──────────────
 :derived/attrs
 [{:attr :bond/groundedness     :doc "template integral of incident clause :cites-statute/:mandated-by + direct :cites-statute loads × disclosed optionality weight — how well-anchored in actual public law the template is; the publish-readiness surface"}
  {:attr :bond/reusability      :doc "clause integral of incident :has-clause loads — how many templates across the commons reuse this clause (the shared backbone)"}
  {:attr :bond/statute-pull     :doc "statute integral of inbound :cites-statute/:mandated-by loads — which laws the commons most rests on (load-bearing instruments)"}
  {:attr :bond/jurisdiction-reach :doc "template/concept integral of incident :governed-by/:applies-in 縁 — how many jurisdictions it spans"}
  {:attr :bond/is-transient     :doc "const true — derived readout, not a stored datom"}]

 ;; ── clause optionality → disclosed grounding weight (DISCLOSED scale, not a verdict) ──
 ;; mirrors genome-ontology :clinsig/weight; sourced from each instrument's own mandatory/
 ;; recommended/optional framing, never a hinagata opinion (N3).
 :optionality/weight
 {:mandatory 1.0 :recommended 0.6 :optional 0.3}}
