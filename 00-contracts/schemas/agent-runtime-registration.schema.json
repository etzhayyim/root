{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etzhayyim.com/schemas/agent-runtime-registration/v1.json",
  "title": "etzhayyim ERC-8004 Agent Runtime Registration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "erc8004", "identity", "runtime", "mcp", "registries"],
  "properties": {
    "schema": {
      "const": "https://etzhayyim.com/schemas/agent-runtime-registration/v1.json"
    },
    "erc8004": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chainId", "agentTokenId", "identityRegistry"],
      "properties": {
        "chainId": { "type": "integer", "minimum": 1 },
        "agentTokenId": { "type": "string", "minLength": 1 },
        "identityRegistry": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "validationRegistry": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "reputationRegistry": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootDid", "erc725", "facadeDid"],
      "properties": {
        "rootDid": { "type": "string", "pattern": "^did:erc725:" },
        "erc725": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "facadeDid": { "type": "string", "pattern": "^did:(plc|web):" },
        "didPkh": { "type": "string", "pattern": "^did:pkh:" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": true,
      "required": ["runtimeKind", "artifactId", "artifactUri", "artifactSha256", "policyHash", "containerImage", "kubernetes"],
      "properties": {
        "runtimeKind": {
          "type": "string",
          "enum": ["k8s-langserver", "mcp-adapter", "wasm-wasi", "browser-pod", "langgraph", "holochain"]
        },
        "artifactId": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "artifactUri": { "type": "string", "pattern": "^(ipfs://|https://)" },
        "artifactSha256": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "policyHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "containerImage": { "type": "string", "minLength": 1 },
        "kubernetes": { "$ref": "#/$defs/kubernetesRef" }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "transport", "auth"],
      "properties": {
        "endpoint": { "type": "string", "format": "uri" },
        "transport": { "type": "string", "enum": ["streamable-http", "stdio", "sse"] },
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "required": ["method"],
          "properties": {
            "method": { "type": "string", "enum": ["oauth2-dpop", "service-auth-es256", "cacao", "none"] },
            "issuer": { "type": "string" },
            "resource": { "type": "string" },
            "scopes": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "a2a": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "endpoint": { "type": "string" },
        "auth": { "type": "string" }
      }
    },
    "registries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorRegistryRow", "mcpRegistryRow", "toolRegistryRows"],
      "properties": {
        "actorRegistryRow": { "type": "string", "minLength": 1 },
        "mcpRegistryRow": { "type": "string", "minLength": 1 },
        "toolRegistryRows": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "kubernetesRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster", "namespace", "workloadKind", "workloadName"],
      "properties": {
        "cluster": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "not": { "const": "default" } },
        "workloadKind": { "type": "string", "enum": ["Deployment", "StatefulSet", "Job", "CronJob"] },
        "workloadName": { "type": "string", "minLength": 1 },
        "serviceName": { "type": "string" }
      }
    }
  }
}
