{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etzhayyim.com/schemas/k8s-runtime-public/v1.json",
  "title": "etzhayyim Public k8s Runtime Projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cluster", "namespace", "workload", "image", "runtime", "redactions"],
  "properties": {
    "schema": {
      "const": "https://etzhayyim.com/schemas/k8s-runtime-public/v1.json"
    },
    "cluster": { "type": "string", "minLength": 1 },
    "namespace": { "type": "string", "not": { "const": "default" } },
    "agent": { "type": "string" },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "name"],
      "properties": {
        "apiVersion": { "type": "string" },
        "kind": { "type": "string", "enum": ["Deployment", "StatefulSet", "Job", "CronJob"] },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "image": { "type": "string", "minLength": 1 },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "public"],
        "properties": {
          "name": { "type": "string" },
          "public": { "type": "boolean" },
          "url": { "type": "string" }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "resourceProfile"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["k8s-langserver", "mcp-adapter", "wasm-wasi", "browser-pod", "langgraph", "holochain"]
        },
        "taskTypes": { "type": "array", "items": { "type": "string" } },
        "resourceProfile": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "redactions": {
      "type": "array",
      "items": { "type": "string", "enum": ["env", "secretRef", "serviceAccountToken", "privateUrl"] }
    }
  }
}
