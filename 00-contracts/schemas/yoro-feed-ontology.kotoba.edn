;; yoro-feed-ontology.kotoba.edn
;;
;; kotoba Datom schema for the yoro AppView social feed (Phase 2.5 read-path
;; migration, ADR-2606013200). The yoro feed (posts / profiles / follows) is
;; stored as Datoms in a dedicated kotoba graph and read back by
;; `@etzhayyim/yoro-rw-free` via the kotoba `datomic.datoms` XRPC, replacing the
;; superseded kotoba-datomic-projection + single-actor PDS read path
;; (ADR-2605231500 → ADR-2605262130 / 2605312345).
;;
;; Graph addressing (CRITICAL — shared by ingest + reader + kotoba boot):
;;   graph name  = "yoro-social-v1"
;;   graph CID   = KotobaCid::from_bytes(b"yoro-social-v1").to_multibase()
;;               = bafyreibljg5gzye47fldkfq6m4vgy55kcjyez2vx432dubttou36g5yryq
;;   visibility  = Public (registered at kotoba-server boot; reads need no auth)
;;
;; Conventions:
;;   - one entity per post / profile / follow, keyed by a `:db.unique/identity`
;;     attribute so ingest is idempotent (upsert by uri / did).
;;   - all scalar values are EDN strings except counts (integers).
;;   - timestamps are ISO-8601 strings (atproto `createdAt`), used for ordering
;;     via the `:avet` index on `:yoro.post/createdAt`.

{:graph    {:name       "yoro-social-v1"
            :cid        "bafyreibljg5gzye47fldkfq6m4vgy55kcjyez2vx432dubttou36g5yryq"
            :visibility :public}

 ;; ── schema install tx (run once by ingest before first upsert) ──────────
 ;; Declares the unique-identity attributes so re-ingest upserts in place.
 :schema-tx
 [{:db/id ":yoro.post/uri"    :db/ident :yoro.post/uri    :db/unique :db.unique/identity}
  {:db/id ":yoro.profile/did" :db/ident :yoro.profile/did :db/unique :db.unique/identity}
  {:db/id ":yoro.follow/uri"  :db/ident :yoro.follow/uri  :db/unique :db.unique/identity}]

 ;; ── post (app.bsky.feed.post projection) ────────────────────────────────
 :post
 {:yoro.post/uri         {:type :string :unique :identity :doc "at://<did>/app.bsky.feed.post/<rkey>"}
  :yoro.post/cid         {:type :string :doc "record CID (atproto)"}
  :yoro.post/author      {:type :string :doc "author DID"}
  :yoro.post/text        {:type :string :doc "post body text"}
  :yoro.post/createdAt   {:type :string :doc "ISO-8601 createdAt; :avet order key"}
  :yoro.post/record      {:type :string :doc "full app.bsky.feed.post record, JSON-encoded"}
  :yoro.post/replyParent {:type :string :optional true :doc "parent post uri (thread)"}
  :yoro.post/replyRoot   {:type :string :optional true :doc "root post uri (thread)"}}

 ;; ── profile (app.bsky.actor.profile projection) ─────────────────────────
 :profile
 {:yoro.profile/did         {:type :string :unique :identity :doc "actor DID"}
  :yoro.profile/handle      {:type :string :doc "handle (did:web → dotted host)"}
  :yoro.profile/displayName {:type :string :optional true}
  :yoro.profile/description {:type :string :optional true}
  :yoro.profile/avatar      {:type :string :optional true :doc "avatar blob ref / url"}}

 ;; ── follow (app.bsky.graph.follow projection) ───────────────────────────
 :follow
 {:yoro.follow/uri       {:type :string :unique :identity :doc "at://<follower>/app.bsky.graph.follow/<rkey>"}
  :yoro.follow/follower  {:type :string :doc "follower DID; :avet key for getFollows"}
  :yoro.follow/subject   {:type :string :doc "followed DID; :avet key for getFollowers"}
  :yoro.follow/createdAt {:type :string :doc "ISO-8601 createdAt"}}}
