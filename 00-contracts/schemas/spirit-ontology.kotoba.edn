 {:db/ident :spirit.bond/conductance
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "channel conductance (inverse separation; ADR-2605170000). Σ over incident bonds = node :spirit/connectivity"}
 {:db/ident :spirit.bond/source
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc "provenance: :assay (word-association) :anchor :spectral :declared :onchain"}
