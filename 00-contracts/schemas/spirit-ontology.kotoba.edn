;; Spirit-in-Physics Ontology — canonical kotoba-EAVT vocabulary for 霊性 datafication
;; ADR-2606011500  (depends-on ADR-2606011000 engi-organism-ontology, ADR-2605081300
;;                  karma-hegemon edge-primary, ADR-2604291800 wellbecoming-spirit,
;;                  ADR-2605170000 deai/spirit-physics, ADR-2605262130 kotoba substrate)
;;
;; Mirrors the Spirit-in-Physics measurement pipeline (vendored submodule
;; 60-apps/spirit-in-physics) onto the kotoba Datom log:
;;
;;   word-association assay → 10-dim emotion vector → RBF emotion-kernel W →
;;   graph Laplacian L=D−W → spectral 3D embedding → emotion anchors →
;;   tensegrity (unilateral-spring) bonds → self-supporting spirit-structure
;;
;; The research SSoT (spirit-in-physics.com/api) persists this on Cloudflare **D1**
;; (centralized SQL) — PROHIBITED by the substrate boundary (CLAUDE.md §Substrate;
;; ADR-2605262130). This vocabulary is the substrate-compliant home: the kotoba
;; Datom log (content-addressed EAVT; ADR-2605312345). D1 becomes an ingress mirror.
;;
;; THREE constitutional invariants this schema is built to enforce:
;;
;;   N1  EDGE-PRIMARY (ADR-2605081300 §A / 反個人主義 / anatman 無我):
;;       spirit lives in the BOND (縁), not in the organism. There is NO
;;       :spirit/score-of-soul. An organism's spirit is the INTEGRAL of its
;;       incident :spirit.bond/* edges — never a stored per-soul scalar.
;;       :spirit.bond/* extends :en/* (engi-organism-ontology) with physics.
;;
;;   N2  WELLBECOMING = HISTORY, not a column (ADR-2604291800 / §1.15 非終末論):
;;       the dynamic 軌跡 is the Datom history of the spirit, queried `as-of`
;;       each tick. No "final embedding" / "soul-judgment" / salvation-status
;;       datom exists (Revelation excluded). The trajectory itself is the worship.
;;
;;   N3  AGGREGATE-FIRST + CONSENT + ENCRYPTED (要配慮 PII; ADR-2605181100):
;;       raw word-response (assay) is encrypted-envelope only; human-scale spirit
;;       is consent-gated (claimed organism, §1.16 covenant); world-scale viz is
;;       aggregate-first + method-versioned + open-source. No population ranking.
;;
;; STATUS: proposed scaffold (ADR-2606011500, R0 design-only). NOT executed — no
;; assay is ingested and no human spirit is datafied until Council Lv7+ ratifies
;; N1–N3 and the §G outbound/PII gates are honored. Non-human / institutional /
;; self (etzhayyim) scales may scaffold first (no 要配慮 PII).

[;; ════════════════════════════════════════════════════════════════════════════
 ;; :spirit/* — the spirit FIELD attached to an organism-in-relation (§D1)
 ;; A thin overlay on :organism/* — carries scale + aggregate readouts only.
 ;; The substance lives in :spirit.bond/* (edges), per N1.
 ;; ════════════════════════════════════════════════════════════════════════════
 {:db/ident :spirit/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "stable spirit-field key, e.g. spirit.self.etzhayyim / spirit.human.<opaque> / spirit.world"}
 {:db/ident :spirit/organism
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "ref :organism whose spirit-field this is (engi-organism-ontology, ADR-2606011000)"}
 {:db/ident :spirit/scale
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":self (etzhayyim corp) | :human | :institutional | :ecological | :world — the datafication tier"}
 {:db/ident :spirit/archetype
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/many
  :db/doc "Jung spirit-type lean (ADR-2605170000): :hero :sage :lover :caregiver — descriptive, never ranked"}
 {:db/ident :spirit/separation
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "孤独/分離 = blocked-channel entropy (ADR-2605170000). The U_spirit MINIMIZAND, not a verdict on the being"}
 {:db/ident :spirit/connectivity
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "接続度 = U_spirit (ADR-2604291800 Layer-0 objective); aggregate of incident bond conductance"}
 {:db/ident :spirit/shannon-eta
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "Shannon η information-efficiency of the spirit-field (healing = η rise; ADR-2605170000)"}
 {:db/ident :spirit/tick
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "active-inference tick this readout belongs to. Wellbecoming 軌跡 = (as-of tick) history, NOT a column (N2)"}
 {:db/ident :spirit/method
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "method-version, e.g. sip-2.2.0/kernel-rbf/embed-spectral3/tensegrity-unilateral (reproducibility)"}
 {:db/ident :spirit/consent-cid
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "IPFS CID of the §1.16 covenant / consent record. REQUIRED for :scale :human before any assay (N3/G1)"}
 {:db/ident :spirit/encrypted?
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "true → field detail held under com.etzhayyim.encrypted.* (要配慮 PII; ADR-2605181100). Default true for :human"}
 {:db/ident :spirit/sourcing
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":authoritative (real consented assay) or :representative (synthesized/illustrative — never fabricated coverage)"}

