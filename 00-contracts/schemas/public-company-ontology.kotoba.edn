;; public-company-ontology — kotoba EAVT vocabulary for the world's PUBLIC (listed) companies
;; ADR-2606022000 · actor: kabuto 兜 (兜町 = Tokyo's financial district / Wall St)
;;
;; PURPOSE
;;   A content-addressed Datom (EAVT) vocabulary describing the world's PUBLIC (exchange-listed)
;;   companies as a knowledge graph: the COMPANY itself (name, ticker, exchange, LEI/ISIN,
;;   sector), its registered HQ ADDRESS, its public CONTACT points (website, IR email/phone),
;;   the first-class SUPPLY edges that connect a supplier to a customer, and the BPMN PROCESS
;;   models that describe a company's public procurement / disclosure workflow. The lens is
;;   SUPPLY-CHAIN RESILIENCE + corporate-power TRANSPARENCY — where production concentrates onto
;;   a single-source supplier or a single jurisdiction, routed to redundancy + accountability.
;;   An aggregate-first accountability / resilience map, NEVER a target-list (kabuto G2).
;;
;; SUBSTRATE (ADR-2605262130 + 2605312345): the canonical state is the kotoba Datom log.
;;   IPFS = block backend, MST = ingress/interop wire, Base L2 = trust anchor. NO RisingWave,
;;   NO centralized SQL. Large assets (filings PDFs, org charts) → DataLad → IPFS under
;;   80-data/public-company (NO git-lfs; G8). BPMN XML is anchored as a kotoba CID block.
;;
;; SOURCING HONESTY (G5, mirrors tsumugi/watatsuna/spirit ontologies):
;;   :*/sourcing ∈ { :authoritative  ; from a primary registry/filing (SEC EDGAR, EU BRIS,
;;                                      exchange listing, GLEIF LEI record, company IR filing)
;;                   :representative  ; publicly documented but a bounded illustrative sample;
;;                                      supplier edges inferred from public disclosure / press,
;;                                      NOT exhaustive bill-of-materials
;;                   :synthesized }   ; derived/estimated by kabuto; MUST be flagged, never
;;                                      presented as observed fact
;;   Every node and edge in the seed graph carries an explicit sourcing keyword. No fabricated
;;   coverage; absence of a company from the graph means "not yet ingested", not "does not exist".
;;
;; SCOPE GUARD (constitutional):
;;   - PUBLIC companies + PUBLIC-RECORD data only. Name, ticker, exchange, LEI, registered HQ
;;     address, IR contact, sector, and DISCLOSED material supplier relationships are matters of
;;     public record (filings, exchange listings, GLEIF, company IR pages, press).
;;   - NO private individuals' PII, NO non-public commercial terms / contract prices, NO trade
;;     secrets, NO data that would aid a takeover/raid or interdiction. Supply concentration is
;;     emitted AGGREGATE-FIRST and framed toward redundancy + accountability, never "who to hit".
;;   - kabuto does NOT adjudicate (G4). It records public facts; it does not rule on legality.

{:schema/id        "public-company-ontology"
 :schema/version   "0.1.0"
 :schema/adr       "2606022000"
 :schema/note      "kotoba-native vocabulary for kabuto 兜; sibling of submarine-cable-ontology (watatsuna) and engi-organism-ontology (tsumugi). Companies link to :organism/id where a tsumugi power-entity already exists (shared :org.corp.* id space)."

 :attributes
 [;; ── :company/* — a PUBLIC (listed) company ──
  {:db/ident :company/id            :db/valueType :db.type/string  :db/unique :db.unique/identity :db/doc "stable id, reuses tsumugi org space, e.g. \"org.corp.tw.tsmc\""}
  {:db/ident :company/name          :db/valueType :db.type/string  :db/doc "legal / display name"}
  {:db/ident :company/ticker        :db/valueType :db.type/string  :db/doc "primary listing ticker, e.g. \"2330.TW\", \"AAPL\""}
  {:db/ident :company/exchange      :db/valueType :db.type/keyword :db/doc ":tse | :nasdaq | :nyse | :krx | :euronext | :hkex | :lse | :sse | :tadawul | … (primary listing venue)"}
  {:db/ident :company/lei           :db/valueType :db.type/string  :db/doc "GLEIF Legal Entity Identifier (ISO 17442), 20 chars, if public"}
  {:db/ident :company/isin          :db/valueType :db.type/string  :db/doc "ISIN of the primary listed security, if public"}
  {:db/ident :company/country       :db/valueType :db.type/string  :db/doc "ISO 3166-1 alpha-2 of domicile"}
  {:db/ident :company/sector        :db/valueType :db.type/keyword :db/doc ":semiconductors | :automotive | :electronics | :energy | :pharma | :shipping | :materials | :industrials | :consumer | :financials | :telecom | :software | :utilities | :healthcare | :real-estate (GICS-flavoured)"}
  {:db/ident :company/industry      :db/valueType :db.type/string  :db/doc "finer industry label, free text"}
  {:db/ident :company/status        :db/valueType :db.type/keyword :db/doc ":listed | :delisted | :acquired | :private (was-listed). Delisted/acquired companies are RETAINED as history (Datomic as-of, 非終末論 — facts are not deleted, only superseded)"}
  {:db/ident :company/delisted-year :db/valueType :db.type/long :db/doc "year the listing ended (delisting / take-private / acquisition); present only when :company/status ≠ :listed. The as-of marker for the status transition"}
  {:db/ident :company/market-cap-busd :db/valueType :db.type/double :db/doc "approx market cap in billion USD; :representative snapshot, NOT live quote"}
  {:db/ident :company/sourcing      :db/valueType :db.type/keyword :db/doc ":authoritative | :representative | :synthesized"}

  ;; ── :company.address/* — registered HQ ADDRESS (first-class so an entity can hold several) ──
  {:db/ident :company.address/id       :db/valueType :db.type/string  :db/unique :db.unique/identity :db/doc "e.g. \"addr.org.corp.tw.tsmc.hq\""}
  {:db/ident :company.address/company  :db/valueType :db.type/ref     :db/doc ":company/id"}
  {:db/ident :company.address/kind     :db/valueType :db.type/keyword :db/doc ":hq | :registered | :ir | :plant (public-record sites only)"}
  {:db/ident :company.address/street   :db/valueType :db.type/string}
  {:db/ident :company.address/city     :db/valueType :db.type/string}
  {:db/ident :company.address/region   :db/valueType :db.type/string  :db/doc "state / prefecture / province"}
  {:db/ident :company.address/country  :db/valueType :db.type/string  :db/doc "ISO 3166-1 alpha-2"}
  {:db/ident :company.address/postal   :db/valueType :db.type/string}
  {:db/ident :company.address/lat      :db/valueType :db.type/double  :db/doc "approx; :representative rounds to the city/campus"}
  {:db/ident :company.address/lon      :db/valueType :db.type/double}
  {:db/ident :company.address/sourcing :db/valueType :db.type/keyword}

  ;; ── :company.contact/* — PUBLIC contact points only (IR / corporate, never personal PII) ──
  {:db/ident :company.contact/id       :db/valueType :db.type/string  :db/unique :db.unique/identity}
  {:db/ident :company.contact/company  :db/valueType :db.type/ref     :db/doc ":company/id"}
  {:db/ident :company.contact/website  :db/valueType :db.type/string  :db/doc "corporate website"}
  {:db/ident :company.contact/ir-url   :db/valueType :db.type/string  :db/doc "investor-relations page"}
  {:db/ident :company.contact/ir-email :db/valueType :db.type/string  :db/doc "published IR / general-enquiry email (corporate, not personal)"}
  {:db/ident :company.contact/ir-phone :db/valueType :db.type/string  :db/doc "published corporate switchboard / IR phone"}
  {:db/ident :company.contact/sourcing :db/valueType :db.type/keyword}

  ;; ── :supply.edge/* — FIRST-CLASS edge: a supplier supplies a customer ──
  ;;    (the directed backbone of the supply-chain KG; from = supplier, to = customer)
  {:db/ident :supply.edge/id          :db/valueType :db.type/string  :db/unique :db.unique/identity :db/doc "e.g. \"supply.tsmc->apple\""}
  {:db/ident :supply.edge/from        :db/valueType :db.type/ref     :db/doc ":company/id of the SUPPLIER"}
  {:db/ident :supply.edge/to          :db/valueType :db.type/ref     :db/doc ":company/id of the CUSTOMER"}
  {:db/ident :supply.edge/tier        :db/valueType :db.type/long    :db/doc "supplier tier relative to customer (1 = direct), if disclosed"}
  {:db/ident :supply.edge/commodity   :db/valueType :db.type/keyword :db/doc ":foundry | :lithography | :assembly | :memory | :display | :battery | :sensor | :logistics | :steel | :polysilicon | :wafer | :photoresist | :mask-blank | :substrate | :gas | :composite | :eda | :copper | :aluminium | :rare-earth | :api (active pharmaceutical ingredient / CDMO drug substance) | … what flows along the edge"}
  {:db/ident :supply.edge/criticality :db/valueType :db.type/double  :db/doc "0.0..1.0 disclosed dependency strength; high = customer is concentrated on this supplier (:representative / :synthesized — never a contract figure)"}
  {:db/ident :supply.edge/sourcing    :db/valueType :db.type/keyword}

  ;; ── :company.process/* — a BPMN 2.0 process model for a company workflow ──
  ;;    The BPMN XML itself is anchored as a kotoba CID block; this datom is the queryable handle.
  {:db/ident :company.process/id      :db/valueType :db.type/string  :db/unique :db.unique/identity :db/doc "e.g. \"proc.org.corp.tw.tsmc.procurement\""}
  {:db/ident :company.process/company :db/valueType :db.type/ref     :db/doc ":company/id"}
  {:db/ident :company.process/name    :db/valueType :db.type/string}
  {:db/ident :company.process/kind    :db/valueType :db.type/keyword :db/doc ":procurement | :disclosure | :supply-onboarding (generic public workflow templates)"}
  {:db/ident :company.process/bpmn-cid :db/valueType :db.type/string :db/doc "KotobaCid of the framed BPMN 2.0 XML block"}
  {:db/ident :company.process/sourcing :db/valueType :db.type/keyword :db/doc "BPMN templates are :synthesized (generic models), never asserted as a company's actual internal process"}]

 ;; ───────────────────────────── DERIVED (analyze.py, never stored as raw fact) ────
 ;; kabuto computes these and emits them flagged :derived; not re-ingested as authoritative.
 :derived-attributes
 [{:db/ident :supply/in-degree        :db/doc "# distinct disclosed suppliers a company depends on (lower at high criticality = brittle)"}
  {:db/ident :supply/out-degree       :db/doc "# distinct disclosed customers a company supplies (high = systemic supplier)"}
  {:db/ident :supply/single-source    :db/doc "customers whose critical commodity is met by exactly one disclosed supplier — routed to redundancy, NOT to interdiction"}
  {:db/ident :supply/sector-concentration :db/doc "Σ criticality flowing through a (sector, commodity) — where the world's production fate concentrates"}
  {:db/ident :supply/jurisdiction-load :db/doc "Σ criticality of edges whose supplier domiciles in a country — geographic concentration surface"}
  {:db/ident :supply/diversification-index :db/doc "distinct-supplier-sectors ÷ Σ inbound criticality per customer — low = brittle (dependency concentrated in few sectors)"}
  {:db/ident :supply/betweenness :db/doc "in-degree × out-degree for nodes that are both customer and supplier — supply-chain middle-layer systemic-ness (transparency signal, NEVER a target, G2)"}
  {:db/ident :supply/tier-depth :db/doc "longest DISCLOSED upstream supplier chain reaching a node (hops back toward raw inputs) — multi-tier-visibility signal, NEVER a target (G2)"}
  {:db/ident :supply/bloc-load :db/doc "Σ criticality of edges whose supplier domiciles in a macro-region bloc (East Asia / Europe / North America / …) — regional concentration surface routed to cross-region diversification (G2)"}
  {:db/ident :supply/commodity-hhi :db/doc "Herfindahl-Hirschman Index of supplier shares within a commodity (Σ share² by criticality) ∈ (0,1]; 1.0 = single disclosed supplier (monopoly), low = fragmented — the headline redundancy-priority signal (G2)"}
  {:db/ident :supply/cross-bloc-load :db/doc "Σ criticality of edges crossing a macro-region bloc boundary (supplier bloc ≠ customer bloc), per supplier→customer corridor — geopolitical / reshoring exposure surface routed to diversification (G2)"}
  {:db/ident :supply/resilience-score :db/doc "composite per-customer supply-resilience score = 100/(1+fragility); fragility ↑ with single-source inputs, inbound criticality concentrated in few supplier sectors, and cross-bloc inbound share. LOW = most fragile — aggregate-first redundancy/accountability ranking, NEVER a target-list (G2)"}]}
