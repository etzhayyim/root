;; dns-domain-ontology.kotoba.edn
;;
;; Canonical kotoba EAVT vocabulary for the yadori (宿り) actor — DNS-availability + domain
;; acquisition (ADR-2606038400). SSoT for the per-actor schema mirrored at
;; orgs/etzhayyim/com-etzhayyim-yadori/kotoba/schema.edn. Availability is read-only via RDAP (G1); acquisition is
;; member-principal (G2, okaimono ADR-2606012100) and server-keyless (G5, ADR-2605231525);
;; Cloudflare Registrar is the default (G3). as-of availability history is non-eschatological
;; (no final domain state).
[;; ── availability (read-only, G1) ──────────────────────────────────────────
 {:db/ident :domain/fqdn            :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :domain/ascii-fqdn      :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :domain/tld             :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :domain/availability    :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
 {:db/ident :domain/rdap-url        :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :domain/checked-at      :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :domain/source          :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}

 ;; ── naming (G4 Murakumo-only; G6 no-squatting screen) ─────────────────────
 {:db/ident :domain/brief           :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :domain/candidate       :db/valueType :db.type/ref     :db/cardinality :db.cardinality/many}
 {:db/ident :candidate/fqdn         :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :candidate/charter-clean :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}
 {:db/ident :candidate/squat-clear  :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}
 {:db/ident :candidate/rank         :db/valueType :db.type/long    :db/cardinality :db.cardinality/one}

 ;; ── registrar (G3 cloudflare default) ─────────────────────────────────────
 {:db/ident :registrar/id           :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :registrar/pricing      :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
 {:db/ident :registrar/markup       :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}
 {:db/ident :registrar/council-gated :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}
 {:db/ident :registrar/policy       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :domain/quote           :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one}

 ;; ── reservation (G2 member-principal + G5 no-server-key) ──────────────────
 {:db/ident :domain/reservation-intent :db/valueType :db.type/ref  :db/cardinality :db.cardinality/one}
 {:db/ident :reservation/registrant-principal :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
 {:db/ident :reservation/payer      :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
 {:db/ident :reservation/funding-source :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
 {:db/ident :reservation/server-held-key :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}
 {:db/ident :domain/authorization   :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one}
 {:db/ident :authorization/authorized-by :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
 {:db/ident :authorization/server-signed :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}
 {:db/ident :authorization/outward-gated :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}

 ;; ── zone provision plan (G7 plan-only; did:web wiring ADR-2606013800) ──────
 {:db/ident :zone/record-plan       :db/valueType :db.type/ref     :db/cardinality :db.cardinality/many}
 {:db/ident :zone/record-type       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :zone/record-name       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :zone/record-value      :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :zone/didweb-target     :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}]
