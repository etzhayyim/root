;; photonic-convergence-ontology.kotoba.edn
;; Canonical kotoba EAVT vocabulary for noroshi (烽) — photonics-electronics convergence (光電融合)
;; communication chips + ISAC (Integrated Sensing And Communication) + photonic packaging robotics.
;; SSoT for the :pdev/* :budget/* :wave/* :sense/* :probot/* :pkg/* attributes; the actor's deployable
;; copy is 20-actors/noroshi/kotoba/schema.edn. Per ADR-2606051600.
;;
;; Constitutional shape (immutable): force class is CIVILIAN-only — there is no :weaponizable value and
;; no :person target class anywhere in this vocabulary (G3/G4/N1/N2). Canonical state lives in the
;; kotoba Datom log (ADR-2605312345); no RisingWave.
{:ontology/id   "com.etzhayyim.photonic-convergence"
 :ontology/adr  "2606051600"
 :ontology/note "光電融合 comms chip + ISAC + photonic packaging robotics; civilian by construction"

 :ontology/force-classes
 [:civilian-comms        ;; an optical communication device
  :civilian-sensing      ;; an ISAC sensing function (objects, never persons)
  :fab-process-laser]    ;; a packaging-robot process laser (alignment/soldering)
 ;; NOTE: :weaponizable is intentionally ABSENT and unrepresentable (N1, Mission Charter §1.12).

 :ontology/device-kinds
 [:modulator :grating-coupler :photodetector :laser :waveguide :pic-link :cpo-module]

 :ontology/target-classes
 [:object]                ;; ISAC senses OBJECTS only; :person is intentionally ABSENT (G4/N2).

 :ontology/attributes
 {;; chip face
  :pdev/id            {:type :string  :unique :identity}
  :pdev/kind          {:type :keyword :enum :ontology/device-kinds}
  :pdev/platform      {:type :keyword :note ":silicon-photonics at R0"}
  :pdev/force-class   {:type :keyword :enum :ontology/force-classes :const :civilian-comms}
  :pdev/line-rate-gbps {:type :double}
  :pdev/energy-pj-bit {:type :double :note "the CPO figure of merit"}
  :pdev/process       {:type :keyword :const :open-pdk :note "G1 — never an NDA foundry PDK"}
  :pdev/eda           {:type :keyword :enum [:gdsfactory :meep :klayout :openlane] :note "G1 open EPDA"}
  :pdev/representative {:type :boolean :note "G10"}

  :budget/id          {:type :string :unique :identity}
  :budget/device      {:type :ref}
  :budget/received-dbm {:type :double}
  :budget/total-loss-db {:type :double}
  :budget/margin-db   {:type :double}
  :budget/closes      {:type :boolean}
  :budget/energy-pj-bit {:type :double}

  ;; isac face
  :wave/id            {:type :string :unique :identity}
  :wave/n-sub         {:type :long}
  :wave/n-sym         {:type :long}
  :wave/bandwidth-mhz {:type :double}
  :wave/range-res-m   {:type :double}
  :wave/vel-res-mps   {:type :double}
  :wave/power-split   {:type :double :note "ρ ∈ [0,1] comms fraction (the JCAS knob)"}
  :wave/capacity-gbps {:type :double}
  :wave/civilian      {:type :boolean :const true :note "G3/N1"}

  :sense/id           {:type :string :unique :identity}
  :sense/wave         {:type :ref}
  :sense/target-class {:type :keyword :enum :ontology/target-classes :const :object :note "G4/N2 — never :person"}
  :sense/range-m      {:type :double}
  :sense/velocity-mps {:type :double}
  :sense/range-bin    {:type :long :note "aliases beyond R_max — honest (N4)"}
  :sense/doppler-bin  {:type :long :note "aliases beyond the Doppler interval — honest (N4)"}

  ;; packaging face
  :probot/id          {:type :string :unique :identity}
  :probot/role        {:type :keyword :enum [:fibre-aligner :wire-bonder :inspector]}
  :probot/force-class {:type :keyword :enum :ontology/force-classes :const :fab-process-laser}
  :probot/laser-class {:type :string :note "IEC 60825 class"}
  :probot/edge-envelope {:type :boolean}
  :probot/dividend-cohort-ref {:type :string :note "G2 — Displacement Dividend (ADR-2606032130)"}
  :probot/representative {:type :boolean :note "G10"}

  :pkg/id             {:type :string :unique :identity}
  :pkg/robot          {:type :ref}
  :pkg/op             {:type :keyword :enum [:active-align :wire-bond :inspect]}
  :pkg/use            {:type :keyword :enum [:alignment :soldering :inspection] :note "G3 civilian fab use"}
  :pkg/laser-class    {:type :string :note "IEC 60825"}
  :pkg/interlock      {:type :boolean :note "G5 enclosure interlock"}
  :pkg/attestation-ref {:type :string :note "G5 safety attestation"}
  :pkg/coupling-loss-db {:type :double}
  :pkg/member-sig     {:type :string :note "G7 member/operator signs"}
  :pkg/server-held-key {:type :boolean :const false :note "G7 — platform never holds the key"}
  :pkg/dry-run        {:type :boolean :const true :note "G8 — R0 plan/replay only"}

  ;; packaging face — reliability qualification (Telcordia GR-468 SHAPE only)
  :qual/id            {:type :string :unique :identity}
  :qual/device        {:type :ref}
  :qual/suite         {:type :keyword :cardinality :many :note "GR-468-SHAPE test types; representative thresholds only (G10)"}
  :qual/acceptance    {:type :keyword :enum [:pass :fail]}
  :qual/dry-run       {:type :boolean :const true :note "G8 — R0 plan/replay only; no live chamber"}
  :qual/representative {:type :boolean :note "G10"}}}
