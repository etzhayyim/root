;; wellbecoming-ontology — the human-wellbecoming-detraction (人を不幸にする構造的要因) vocabulary
;; for shiori 栞. ADR-2606082100 · sibling of peoples-ontology (ADR-2606073800),
;; biosphere-ontology (ADR-2606073000), asobi-ontology (ADR-2606073200) and finrisk-ontology
;; (ADR-2606073400), specialised to the STRUCTURAL DETRACTORS of human Wellbecoming (§1.13) and
;; the MITIGATORS that relieve them.
;;
;; PURPOSE: weave the structural factors that DIMINISH human Wellbecoming (precarity / overwork /
;; isolation / addictive-design / debt / housing-insecurity / chronic-pain / information-pollution
;; / discrimination / care-deprivation / meaning-deficit), the aggregate COHORTS that bear them,
;; the structural DRIVERS that impose them, and the MITIGATORS (havens) that relieve them into the
;; kotoba Datom log. The lens is DETRACTION pressure vs RELIEF, routed to RELIEF / 救い — a
;; transparent Wellbecoming intervention carried by ossekai (ADR-2605264000), never coercion.
;;
;; CONSTITUTIONAL INVERSION (G1, read first): shiori is a WELLBECOMING-RELIEF map at AGGREGATE /
;; cohort scale, NEVER a per-person affect / happiness / sentiment scoring or manipulation engine.
;; There are NO individual records, NO per-person happiness/mood/affect score, NO biometric. The
;; bearer is ALWAYS a cohort (:cohort/scope :aggregate). It inverts the persuasion-optimisation
;; apparatus: it routes detraction to relief, and shiori may NOT itself use engagement-maximising
;; / dark-pattern technique (anti-addictive, §1.13). Any member-linked datum is consent-bound +
;; PII-enveloped (himotoki/ossekai discipline, ADR-2605181100). Relief is routed to STRUCTURAL
;; change first, never to individual blame (§1.4 anti-individualism, §1.7 multi-generational).
;;
;; EDGE-PRIMARY (N1): detraction lives ONLY on edges (:en/load). A cohort's wellbecoming-burden =
;; the INTEGRAL of its incident inbound detraction 縁 × disclosed severity weight, computed on
;; READ — never a stored per-cohort/per-person score. There is no :shiori/score-of-cohort.

{:schema/id "wellbecoming-ontology"
 :schema/version "0.1.0"
 :schema/adr "2606082100"

 ;; ── nodes ──────────────────────────────────────────────────────────────────
 :node/attrs
 [{:attr :organism/id         :doc "stable id, e.g. wb.cohort.gig-workers / wb.detr.overwork — COHORT/STRUCTURAL only"}
  {:attr :organism/kind       :doc ":cohort | :detractor | :driver | :mitigator"}
  {:attr :organism/label      :doc "common/display label"}
  {:attr :organism/sourcing   :doc ":authoritative (OECD Better Life / WHO / public wellbeing research) | :representative (bounded seed)"}

  ;; cohort facet (a COLLECTIVE / aggregate population — never an individual)
  {:attr :cohort/kind         :doc ":workers | :gig-workers | :youth | :students | :elderly | :isolated-aged | :unpaid-carers | :low-income | :chronically-ill | :new-parents"}
  {:attr :cohort/scope        :doc ":aggregate const — aggregate-only marker (G1); per-person scope is unrepresentable"}

  ;; detractor facet (the structural wellbecoming-detractor; the immediate 取-holder)
  {:attr :detractor/kind      :doc ":precarity | :overwork | :isolation | :addictive-design | :debt-burden | :housing-insecurity | :chronic-pain | :information-pollution | :discrimination | :care-deprivation | :meaning-deficit | :sleep-deprivation"}
  {:attr :detractor/severity  :doc "DISCLOSED severity band — :critical :severe :moderate :mild (from public wellbeing research, NOT a shiori adjudication, N3)"}

  ;; driver facet (the deeper structural SOURCE/pattern that drives detractors — a PATTERN,
  ;; never a named org/person; G1 = map-not-target)
  {:attr :driver/kind         :doc ":always-on-work-culture | :engagement-maximizing-design | :high-cost-credit | :thin-safety-net | :unaffordable-housing-market | :care-infrastructure-gap | :algorithmic-feed | :job-insecurity-norm"}

  ;; mitigator facet (the relief/haven that absorbs detraction; the 守り)
  {:attr :mitigator/kind      :doc ":social-connection | :secure-housing | :meaningful-work | :rest-recovery | :mutual-aid | :treatment-access | :financial-stability | :information-hygiene | :care-support | :time-sovereignty"}]

 ;; ── edges (縁) ───────────────────────────────────────────────────────────────
 :edge/attrs
 [{:attr :en/from            :doc "source organism id"}
  {:attr :en/to              :doc "target organism id"}
  {:attr :en/kind            :doc ":diminishes (detractor→cohort) | :drives (driver→detractor) | :relieves (mitigator→cohort) | :routes-to (detractor→mitigator, the intervention path)"}
  {:attr :en/load            :doc "0..1 — for :diminishes: detraction severity borne by the cohort; for :drives: how strongly the driver imposes the detractor; for :relieves: relief afforded; for :routes-to: applicability of the relief route. karma lives HERE (N1)."}
  {:attr :en/sourcing        :doc ":authoritative | :representative"}]

 ;; ── derived (transient, computed on READ — NEVER stored; N1/G2) ──────────────
 :derived/attrs
 [{:attr :bond/wellbecoming-burden :doc "cohort integral of incident inbound :diminishes 縁 × disclosed severity weight — the detraction surface"}
  {:attr :bond/relief-buffer       :doc "cohort integral of incident inbound :relieves loads — protective capacity (the 守り)"}
  {:attr :bond/relief-gap          :doc "burden − buffer; >0 = under-served cohort, the routing signal to ossekai (intervention need)"}
  {:attr :bond/detraction-imposed  :doc "driver/detractor integral of outbound :drives + :diminishes loads — the 取-holder concentration, routed to transparency (danjo/tsumugi/keizu)"}
  {:attr :bond/route-coverage      :doc "detractor integral of outbound :routes-to loads — whether a known relief route exists (0 = intervention-design gap)"}
  {:attr :bond/is-transient        :doc "const true — derived readout, not a stored datom"}]

 ;; ── disclosed detractor-severity → representative weight (NOT a verdict) ──
 :severity/weight
 {:critical 1.0 :severe 0.8 :moderate 0.5 :mild 0.25}}
