;; tsubasa 翼 — flight-route / fare discovery commons ontology (ADR-2606072800)
;; ============================================================================
;; The Skyscanner inversion. Honest fare/route meta-search: every onward link is
;; AFFILIATE-STRIPPED and the member SELF-BOOKS on the airline's OWN site (no inflow).
;; Ranks by TRUE total cost (fare + baggage) with CO₂ emissions SURFACED on every
;; option, never hidden or de-ranked away. Sibling of watari 渡り (live aircraft
;; POSITION): tsubasa PLANS, watari TRACKS — both observational, neither an OTA.
;;
;; Substrate: kotoba Datom log (EAVT, content-addressed, append-only — 非終末論).
;; Every node carries :fare/sourcing ∈ :authoritative | :representative | :synthesized.
;;
;; ── CONSTITUTIONAL boundary (read this) ─────────────────────────────────────────
;; The defining invariants are STRUCTURAL, not policy — the attributes that would
;; let tsubasa become a commission-taking OTA or a surveillance fare-tracker DO NOT
;; EXIST in this ontology, so they are unrepresentable by construction (proven by
;; tests):
;;   G1  no-affiliate-no-inflow — there is NO :fare/commission, :fare/affiliate-link,
;;       :fare/affiliate, or :fare/merchant attribute. tsubasa is never the
;;       merchant-of-record; the member books on the airline's own page. (§1.3)
;;   G3  anti-dark — there is NO :fare/urgency, :fare/scarcity, :fare/price-will-rise,
;;       or :fare/seats-left attribute. Honest availability only. (Wellbecoming §1.13)
;;   G4  emissions-honest — :fare/co2-kg is REQUIRED on every fare and is a first-class
;;       ranking axis; a high-CO₂ option cannot be ranked away invisibly.
;;   G5  no-person-tracking — there is NO :searcher/*, :person/*, :fare/searcher-id, or
;;       :search/profile attribute. A search is STATELESS w.r.t. the searcher; no
;;       pattern-of-life, no fare-watch on a person. (Rider §2(c) reciprocity axis)
;; A route/carrier CONCENTRATION reading (:tsubasa.obs/*) is a COMPETITION map routed
;; to OPENING (surface alternatives), NEVER a target-list and NEVER a paid ranking.
;; ============================================================================

[;; ── fare (a published, bookable flight option) ──────────────────────────────
 {:db/ident :fare/id            :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity
  :db/doc "Stable fare id, e.g. \"fare.jfk-nrt-aa-eco\"."}
 {:db/ident :fare/origin        :db/valueType :db.type/string  :db/cardinality :db.cardinality/one
  :db/doc "Origin airport IATA code."}
 {:db/ident :fare/destination   :db/valueType :db.type/string  :db/cardinality :db.cardinality/one
  :db/doc "Destination airport IATA code."}
 {:db/ident :fare/depart-date   :db/valueType :db.type/string  :db/cardinality :db.cardinality/one
  :db/doc "Departure date (ISO-8601). A date, never a per-searcher timestamp (G5)."}
 {:db/ident :fare/carrier       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one
  :db/doc "Operating airline IATA code (e.g. \"AA\")."}
 {:db/ident :fare/stops         :db/valueType :db.type/long    :db/cardinality :db.cardinality/one
  :db/doc "0 = direct."}
 {:db/ident :fare/duration-min  :db/valueType :db.type/long    :db/cardinality :db.cardinality/one
  :db/doc "Total trip duration in minutes (a ranking axis)."}
 {:db/ident :fare/fare-minor    :db/valueType :db.type/long    :db/cardinality :db.cardinality/one
  :db/doc "Base fare in minor currency units (e.g. USD cents). DISCLOSED, not a verdict."}
 {:db/ident :fare/baggage-minor :db/valueType :db.type/long    :db/cardinality :db.cardinality/one
  :db/doc "Checked-bag fee in minor units — TRUE total-cost honesty (G4): ranking uses fare+baggage."}
 {:db/ident :fare/currency      :db/valueType :db.type/string  :db/cardinality :db.cardinality/one
  :db/doc "ISO-4217 currency of the minor-unit amounts."}
 {:db/ident :fare/co2-kg        :db/valueType :db.type/double  :db/cardinality :db.cardinality/one
  :db/doc "REQUIRED — per-passenger CO₂ (kg), SURFACED on every option, a first-class ranking axis (G4)."}
 {:db/ident :fare/cabin         :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one
  :db/doc ":economy | :premium | :business | :first."}
 {:db/ident :fare/book-url      :db/valueType :db.type/string  :db/cardinality :db.cardinality/one
  :db/doc "The airline's OWN booking page — AFFILIATE-STRIPPED at handoff (G1). Not a tsubasa redirect."}
 {:db/ident :fare/sourcing      :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one
  :db/doc ":authoritative | :representative | :synthesized — provenance honesty (G8)."}
 {:db/ident :fare/source       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one
  :db/doc "Cited provenance for an :authoritative fare folded by live ingest (R3): the PUBLIC source URL or the member-principal account it was read from. NOT a paid GDS terminal (Rider §2(e); see ontology header / ADR R3)."}
 {:db/ident :fare/ingested-at  :db/valueType :db.type/string  :db/cardinality :db.cardinality/one
  :db/doc "As-of stamp supplied by the operator/member fetch leg (caller-supplied; the loop holds no wall clock). A date/run id, never a per-searcher timestamp (G5)."}

 ;; ── airport (a coverage node; region drives the coverage report) ────────────
 {:db/ident :airport/iata       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity
  :db/doc "Airport IATA code."}
 {:db/ident :airport/name       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one
  :db/doc "Human-readable airport / city name."}
 {:db/ident :airport/country    :db/valueType :db.type/string  :db/cardinality :db.cardinality/one
  :db/doc "ISO-3166 alpha-2 country."}
 {:db/ident :airport/region     :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one
  :db/doc "World region for coverage rollup: :north-america | :europe | :east-asia | :south-asia | :southeast-asia | :middle-east | :oceania | :south-america | :africa."}

 ;; ── carrier (an airline coverage node) ──────────────────────────────────────
 {:db/ident :carrier/iata       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity
  :db/doc "Airline IATA code."}
 {:db/ident :carrier/name       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one
  :db/doc "Airline name."}

 ;; ── derived OBSERVATIONS (append-only; every datom :tsubasa/derived true) ────
 ;; A route-competition map routed to OPENING — never a target-list, never a paid rank.
 {:db/ident :tsubasa.route/origin        :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :tsubasa.route/destination   :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :tsubasa.route/carrier-count :db/valueType :db.type/long   :db/cardinality :db.cardinality/one
  :db/doc "Distinct carriers serving the route (choice diversity)."}
 {:db/ident :tsubasa.obs/carrier-hhi     :db/valueType :db.type/double :db/cardinality :db.cardinality/one
  :db/doc "Herfindahl–Hirschman index over carrier presence on the route, 0..1 (competition concentration)."}
 {:db/ident :tsubasa.obs/concentration   :db/valueType :db.type/string :db/cardinality :db.cardinality/one
  :db/doc ":competitive | :concentrated | :monopoly — a competition reading, not a verdict on any airline."}
 {:db/ident :tsubasa.obs/cheapest-total-minor :db/valueType :db.type/long   :db/cardinality :db.cardinality/one
  :db/doc "Lowest TRUE total cost (fare+baggage) on the route (G4)."}
 {:db/ident :tsubasa.obs/greenest-co2-kg :db/valueType :db.type/double :db/cardinality :db.cardinality/one
  :db/doc "Lowest CO₂ option on the route — emissions is first-class (G4)."}
 {:db/ident :tsubasa.obs/fastest-min     :db/valueType :db.type/long   :db/cardinality :db.cardinality/one
  :db/doc "Shortest duration on the route."}
 {:db/ident :tsubasa.obs/route           :db/valueType :db.type/string :db/cardinality :db.cardinality/one
  :db/doc ":served | :opening — :opening = concentrated/monopoly route where alternatives should be surfaced."}
 {:db/ident :tsubasa.carrier/route-count :db/valueType :db.type/long   :db/cardinality :db.cardinality/one}
 {:db/ident :tsubasa.carrier/fare-count  :db/valueType :db.type/long   :db/cardinality :db.cardinality/one}
 {:db/ident :tsubasa.carrier/mean-co2-kg :db/valueType :db.type/double :db/cardinality :db.cardinality/one}
 {:db/ident :tsubasa/sourcing            :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
 {:db/ident :tsubasa/derived             :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one
  :db/doc "Marks a derived observation (vs a fact row). The reading describes the INPUT fares, not a verdict."}]
