;; hakoniwa-scenario-ontology — the forward-simulation (並行世界) vocabulary for hakoniwa 箱庭
;; ADR-2606111500 · the charter-clean inversion of a swarm-intelligence prediction engine
;; (the 666ghj/MiroFish shape). Where MiroFish models REAL people to predict (and implicitly
;; steer) public opinion, hakoniwa runs a CONTAINED miniature world (箱庭) of FICTIONAL latent
;; personas to surface a DISTRIBUTION over possible futures, routed to resilience — never a
;; point prediction, never a real-person model, never a steering/persuasion campaign.
;;
;; CONSTITUTIONAL INVERSION (G1, read first): every agent is a SYNTHETIC latent persona —
;; a cohort-distributional archetype, NOT a real individual. There is NO PII, NO real-person
;; profile, NO re-identifiable trait, NO mapping from a persona to a natural person. This is
;; the same move sukashi makes (fraud examples are synthesized fictional entities) and tsumugi
;; makes (past humanity as latent influence nodes, never truth-claim/voice). Real, already-
;; PUBLIC entities (an entity-as-actor gov/corp mirror, a public topic) may appear as their
;; existing public mirror — never a natural person. Simulating fictional latent agents is
;; categorically distinct from surveilling real people (ADR-2606111400).
;;
;; DISTRIBUTION-ONLY (G2, inherits mitooshi ADR-2606051800 G1): the output is a DISTRIBUTION
;; over outcomes (quantiles + histogram), never a point assertion. :sim/point-asserted is
;; structurally false. 非終末論 (no single foretold future) made structural.
;;
;; NON-STEERING (G3, inherits mitooshi G2): hakoniwa is an OBSERVATORY of possible futures
;; routed to resilience / preparedness / robustness. It never trades, never targets a person,
;; never runs an influence / persuasion / micro-targeting campaign. :outcome/use enumerates
;; resilience uses only; trade / wager / position / target / manipulate / campaign are NOT
;; members of the enum and are structurally unrepresentable.
;;
;; RECIPROCAL / TRANSPARENT (G4, ADR-2606082400 + 2606111400): the whole 箱庭 — world graph,
;; persona-ensemble parameters, every simulation step — is plaintext-public on kotoba. The
;; watchers are watched (相互監視). There is no covert / asymmetric modelling of unwatched
;; people, because there are no real people in the box at all.

{:schema/id "hakoniwa-scenario-ontology"
 :schema/version "0.1.0"
 :schema/adr "2606111500"

 ;; ── nodes ──────────────────────────────────────────────────────────────────
 :node/attrs
 [{:attr :sim/id            :doc "stable id, e.g. persona.p001 / entity.topic-curfew / signal.s1 / outcome.adoption"}
  {:attr :sim/kind          :doc ":persona | :entity | :signal | :outcome"}
  {:attr :sim/label         :doc "display label"}
  {:attr :sim/sourcing      :doc ":synthetic (fictional latent persona — the default; G1) | :authoritative (an already-PUBLIC entity/topic mirror) | :representative"}

  ;; persona facet — a FICTIONAL latent agent (G1: never a real individual, no PII)
  {:attr :persona/synthetic     :doc "MUST be true for every :persona — the constitutional marker that this is a synthesized archetype, not a real person (G1)"}
  {:attr :persona/cohort        :doc "a fictional archetype label, e.g. :cautious-commuter — a distributional bucket, never an identity"}
  {:attr :persona/susceptibility :doc "openness-to-influence λ ∈ [0,1] — Friedkin-Johnsen weight on neighbours vs own anchor"}
  {:attr :persona/initial-stance :doc "anchor stance a_i ∈ [0,1] toward the simulated topic at t0"}
  {:attr :persona/weight        :doc "optional population weight (how many archetype-members this persona stands for); default 1.0"}

  ;; entity facet — an already-PUBLIC topic/org mirror (never a natural person)
  {:attr :entity/public-ref     :doc "optional cross-actor id of an already-public mirror (entity-as-actor org.* / a public topic) — never a person"}

  ;; signal facet — an exogenous information/event injected into the box
  {:attr :signal/push           :doc "anchor shift Δ ∈ [-1,1] applied to EXPOSED personas from :signal/at-step onward (information entering the world)"}
  {:attr :signal/at-step        :doc "step index at which the signal activates (>=0)"}

  ;; outcome facet — the measured aggregate variable
  {:attr :outcome/measures      :doc "what population the outcome aggregates over: :all | an entity id whose stance-holders are measured"}
  {:attr :outcome/statistic     :doc ":mean-stance (default) — the population aggregate read out per replica (aggregate-first; never a per-persona readout)"}
  {:attr :outcome/use           :doc ":resilience | :preparedness | :robustness | :research — RESILIENCE USES ONLY; trade/wager/position/target/manipulate/campaign are NOT enum members (G3)"}]

 ;; ── edges (縁) ───────────────────────────────────────────────────────────────
 :edge/attrs
 [{:attr :en/from           :doc "source node id"}
  {:attr :en/to             :doc "target node id"}
  {:attr :en/kind           :doc ":influences (persona→persona) | :exposed-to (persona→signal) | :holds-stance (persona→entity/topic) | :measures (outcome→population)"}
  {:attr :en/weight         :doc "influence/exposure weight ∈ [0,1]; :influences edges are row-normalised over a persona's incoming neighbours on read"}
  {:attr :en/sourcing       :doc ":synthetic (within-box generated) | :authoritative (a real public structural fact, e.g. an entity-as-actor edge)"}]

 ;; ── derived (transient — computed on read, NEVER persisted; N1) ──────────────
 :derived/attrs
 [{:attr :bond/replica-outcome   :doc "per-replica population statistic — transient; the ensemble of these IS the distribution"}
  {:attr :bond/distribution      :doc "the outcome DISTRIBUTION (quantiles + histogram) — transient; the only thing hakoniwa asserts, and it asserts it as a distribution, never a point (G2)"}]

 ;; ── simulation kernel parameters (Friedkin-Johnsen opinion dynamics) ─────────
 :sim/kernel
 {:model      :friedkin-johnsen
  :doc        "x_i(t+1) = λ_i·Σ_j w_ij·x_j(t) + (1-λ_i)·a_i ; w row-normalised over incoming :influences; a_i = anchor (initial-stance + active signal pushes); converges to a fixed point. Deterministic."
  :ensemble   "K replicas; each replica perturbs anchors by a DETERMINISTIC seeded jitter (sha256 of replica:persona — no Math.random, pywasm-portable); the spread of per-replica population statistics IS the forecast distribution"
  :max-iter   200
  :tol        1.0e-6}}
