 {:db/ident :gov.unit/sourcing
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc "G5: :authoritative (verified against the official source) | :representative (illustrative/synthesized — NEVER counted as coverage)"}
 {:db/ident :gov.unit/provenance
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "G5: source URL/citation the node was derived from"}
 {:db/ident :gov.unit/last-verified
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "G5: ISO-8601 last verification timestamp; freshness cell re-checks within the window"}
 {:db/ident :gov.unit/verification-status
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":unverified-seed | :maintainer-verified | :stale — downstream (toritsugi G14) MUST refuse action on :unverified-seed/:stale"}

