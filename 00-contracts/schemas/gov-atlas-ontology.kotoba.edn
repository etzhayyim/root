 {:db/ident :gov.unit/organism
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "ref :organism/id (engi-organism-ontology, ADR-2606011000) — the SAME unit as a node-in-relation for tsumugi's 縁/取 power-graph. Atlas = structure; engi = karma. Never duplicate the karma here"}
 {:db/ident :gov.unit/geo
