;; news-medium-ontology.kotoba.edn — vocabulary for kawaraban (瓦版)
;; ADR-2606061900 · actor: orgs/etzhayyim/com-etzhayyim-kawaraban/
;;
;; SCOPE: a NEWS MEDIUM. Two faces, one substrate:
;;   (1) MIRROR — datafies the world's real news media (outlets · 面/sections ·
;;       headlines · bylines · links) into the kotoba Datom log as an append-only
;;       as-of trail (:news.outlet/* :news.section/* :news.article/* with
;;       :article/kind :mirror), matching the SURFACE (面) of actual news media:
;;       一面 / 政治 / 経済 / 国際 / 社会 / 文化 / 科学 / スポーツ.
;;   (2) MEDIUM — the connective wire BETWEEN etzhayyim actors. Each first-party
;;       actor's own Datom as-of events project into the matching 面 as
;;       :article/kind :actor-event, and every article carries :news.mention
;;       edges to the actors/entities it concerns. The graph of (articles ×
;;       mentions × 面) is the medium that connects actor to actor: danjo finds →
;;       kawaraban carries → kanae renders; an article about a chokepoint links
;;       watari + watatsuna + mitooshi in one 面.
;;
;; WHY kawaraban (瓦版): the original Japanese news medium — Edo-period clay-block
;;   broadsheets cried and sold in the street. It is a SHEET (面), not an oracle:
;;   it carries what was said and who it concerns, it does not rule what is true.
;;   Sibling boundary: kataribe 語部 IS etzhayyim's own press (a primary voice);
;;   kawaraban MIRRORS the world's press + WIRES etzhayyim's actors together (a
;;   medium, never a primary source — G11).
;;
;; CONSTITUTIONAL CONTEXT: a naive "news app" is ad-funded (Charter-Rider §2),
;;   engagement-optimized / addictive (Charter §1.13), reader-surveilling, an
;;   adjudicator of truth (ake/danjo boundary), and a republisher of copyrighted
;;   text. ALL prohibited. kawaraban is the charter-clean inverse (okaimono /
;;   mitooshi / kamado pattern): a public-square MIRROR + connective MEDIUM that
;;   links out, never adjudicates, never advertises, never profiles a reader,
;;   never republishes full text, and never speaks AS anyone.
;;
;; INVARIANT #1 — MIRROR-NOT-ADJUDICATOR (G1; schema :db/allowed + lexicon const +
;;   article_mirror/state_machine.py ValueError): :news.article/verdict and
;;   :news.article/truth-rating are :db/allowed [false]. kawaraban records that
;;   outlet X published headline H at T; it CANNOT express that H is true or false
;;   (that is ake's community-edit / danjo's discrepancy boundary, never news).
;;
;; INVARIANT #2 — NO-ADS / NO-ENGAGEMENT-RANK (G2; 3 places): :news.rank/signal
;;   takes ONLY {:recency :section-fit :source-diversity :actor-relevance
;;   :geo-proximity}. :paid-placement / :sponsored / :engagement / :dwell-time are
;;   NOT enum members — a feed ranked to sell attention is UNREPRESENTABLE
;;   (Charter §1.13 addictive-design + Charter-Rider §2 ad prohibition).
;;
;; INVARIANT #3 — NO-READER-SURVEILLANCE (G3): there is NO :reader entity in this
;;   ontology and :news.article/personalized-for is :db/allowed [false]. The 面 is
;;   the SAME public square for everyone — no per-reader profile, no behavioral
;;   recommendation (watari's person-exclusion invariant, applied to the reader).
;;
;; INVARIANT #4 — COPYRIGHT / LINK-OUT (G4): :news.article/full-text is
;;   :db/allowed [false]. A mirrored article is headline + canonical :url +
;;   bounded fair-use :excerpt + :outlet attribution ONLY. Republishing the
;;   outlet's full body is unrepresentable (read the public facing page, link to
;;   it — kanjo §2(c) anti-gatekeeping precedent).
;;
;; INVARIANT #5 — MIRROR-NOT-IMPERSONATION (G9): :news.article/speak-as is
;;   :db/allowed [false]. kawaraban mirrors outlets AND actors as observations; it
;;   never posts AS an outlet or AS another etzhayyim actor (the entity-mirror
;;   invariant, ADR-2606042330).
;;
;; INVARIANT #6 — NON-ESCHATOLOGICAL AS-OF (G10): :news.issue/final is :db/allowed
;;   [false]. An "edition" is a dated snapshot, not a last word; the latest issue
;;   is current, the issue stream is the trail (非終末論 — no final-state datom).
;;
;; INVARIANT #7 — CONNECTIVE-BY-CONSTRUCTION (G11; the MEDIUM gate): every
;;   :news.article is EITHER :article/kind :mirror (requires :outlet + :url — a
;;   real-media mirror) OR :article/kind :actor-event (requires :source-actor +
;;   :source-tid — a projected first-party actor Datom event). kawaraban authors
;;   no :article/kind :original first-person claim (that enum value does not
;;   exist) — it is a medium, not a source. Both kinds MUST carry ≥0 :news.mention
;;   edges; the article×mention×面 graph IS the actor-to-actor wire.

{:ontology "news-medium"
 :version 1
 :actor "kawaraban"
 :adr "2606061900"

 ;; ───────────────────────── :news.outlet — a real news-media organization ──
 :attributes
 [{:db/ident :news.outlet/id          :db/valueType :db.type/string   :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
  {:db/ident :news.outlet/name        :db/valueType :db.type/string   :db/cardinality :db.cardinality/one}
  {:db/ident :news.outlet/country     :db/valueType :db.type/string   :db/cardinality :db.cardinality/one}
  {:db/ident :news.outlet/lang        :db/valueType :db.type/string   :db/cardinality :db.cardinality/many}
  {:db/ident :news.outlet/kind        :db/valueType :db.type/keyword  :db/cardinality :db.cardinality/one
   :db/doc "enum" :db/allowed [:public-broadcaster :wire-agency :newspaper :magazine :digital-native :ngo-press]}
  {:db/ident :news.outlet/homepage    :db/valueType :db.type/string   :db/cardinality :db.cardinality/one}
  {:db/ident :news.outlet/access      :db/valueType :db.type/keyword  :db/cardinality :db.cardinality/one
   :db/doc "G4 — only public/open facing pages are mirrored; paywalled/proprietary terminal feeds are NOT mirrored"
   :db/allowed [:open :registration-wall]} ;; :paywall and :proprietary-terminal are intentionally ABSENT (G4)
  {:db/ident :news.outlet/sourcing    :db/valueType :db.type/keyword  :db/cardinality :db.cardinality/one :db/allowed [:representative :verified]}

  ;; ───────────────────── :news.section — a newspaper 面 (the surface mirror) ──
  {:db/ident :news.section/id         :db/valueType :db.type/string   :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
  {:db/ident :news.section/men        :db/valueType :db.type/keyword  :db/cardinality :db.cardinality/one
   :db/doc "the 面 — mirrors real news-media sectioning"
   :db/allowed [:front :politics :economy :international :society :culture :science :sports :local :opinion]}
  {:db/ident :news.section/name-ja    :db/valueType :db.type/string   :db/cardinality :db.cardinality/one}
  {:db/ident :news.section/name-en    :db/valueType :db.type/string   :db/cardinality :db.cardinality/one}

  ;; ───────────────────── :news.article — a mirrored OR projected article ─────
  {:db/ident :news.article/id         :db/valueType :db.type/string   :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
  {:db/ident :news.article/kind       :db/valueType :db.type/keyword  :db/cardinality :db.cardinality/one
   :db/doc "G11 — :mirror (real outlet) | :actor-event (first-party actor Datom). :original is intentionally ABSENT: kawaraban is a medium, not a source"
   :db/allowed [:mirror :actor-event]}
  {:db/ident :news.article/section    :db/valueType :db.type/ref      :db/cardinality :db.cardinality/one :db/doc "→ :news.section/id (the 面)"}
  {:db/ident :news.article/headline   :db/valueType :db.type/string   :db/cardinality :db.cardinality/one}
  {:db/ident :news.article/excerpt    :db/valueType :db.type/string   :db/cardinality :db.cardinality/one :db/doc "G4 — bounded fair-use quotation only (≤ 280 chars), NEVER the full body"}
  {:db/ident :news.article/url        :db/valueType :db.type/string   :db/cardinality :db.cardinality/one :db/doc "canonical link-out to the source page (required for :mirror)"}
  {:db/ident :news.article/outlet     :db/valueType :db.type/ref      :db/cardinality :db.cardinality/one :db/doc "→ :news.outlet/id (required for :mirror)"}
  {:db/ident :news.article/source-actor :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/doc "did:web actor (required for :actor-event) — the first-party actor whose Datom event this projects"}
  {:db/ident :news.article/source-tid :db/valueType :db.type/string   :db/cardinality :db.cardinality/one :db/doc "the source Datom tid (required for :actor-event) — provenance back to the canonical event"}
  {:db/ident :news.article/lang       :db/valueType :db.type/string   :db/cardinality :db.cardinality/one}
  {:db/ident :news.article/as-of      :db/valueType :db.type/long     :db/cardinality :db.cardinality/one :db/doc "epoch — append-only; latest = current, the stream = the trail (非終末論)"}
  {:db/ident :news.article/sourcing   :db/valueType :db.type/keyword  :db/cardinality :db.cardinality/one :db/allowed [:representative :verified]}
  ;; ── G1 / G3 / G4 / G9 unrepresentable fields (the structural invariants) ──
  {:db/ident :news.article/verdict        :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one :db/allowed [false] :db/doc "G1 — kawaraban never rules a report true/false (ake/danjo boundary)"}
  {:db/ident :news.article/truth-rating   :db/valueType :db.type/long    :db/cardinality :db.cardinality/one :db/allowed [false] :db/doc "G1 — no fact-check score; mirror, not adjudicator"}
  {:db/ident :news.article/full-text      :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/allowed [false] :db/doc "G4 — copyright; headline + link + excerpt only"}
  {:db/ident :news.article/personalized-for :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/allowed [false] :db/doc "G3 — the 面 is identical for all readers; no per-reader feed"}
  {:db/ident :news.article/speak-as       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/allowed [false] :db/doc "G9 — never post AS an outlet or AS another actor (mirror, ADR-2606042330)"}

  ;; ───────────────────── :news.mention — the connective edge (G11 wire) ──────
  {:db/ident :news.mention/id         :db/valueType :db.type/string   :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
  {:db/ident :news.mention/article    :db/valueType :db.type/ref      :db/cardinality :db.cardinality/one :db/doc "→ :news.article/id"}
  {:db/ident :news.mention/target     :db/valueType :db.type/string   :db/cardinality :db.cardinality/one :db/doc "did:web actor OR org.* / gov.* entity id — who this article connects to"}
  {:db/ident :news.mention/target-kind :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/allowed [:actor :entity]}
  {:db/ident :news.mention/role       :db/valueType :db.type/keyword  :db/cardinality :db.cardinality/one
   :db/doc "how the target relates — observational only, never an accusation (watari/watatsuna resilience-not-target precedent)"
   :db/allowed [:subject :source :mentioned :affected :responding]}

  ;; ───────────────────── :news.wire — actor → 面 routing (medium config) ─────
  {:db/ident :news.wire/id            :db/valueType :db.type/string   :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
  {:db/ident :news.wire/actor         :db/valueType :db.type/string   :db/cardinality :db.cardinality/one :db/doc "did:web first-party actor"}
  {:db/ident :news.wire/section       :db/valueType :db.type/ref      :db/cardinality :db.cardinality/one :db/doc "→ :news.section/id — the 面 this actor's events route into"}
  {:db/ident :news.wire/basis         :db/valueType :db.type/string   :db/cardinality :db.cardinality/one :db/doc "why this actor maps to this 面 (e.g. 'fiscal-flow → 経済')"}

  ;; ───────────────────── :news.rank — ranking signal (G2 anti-ad) ────────────
  {:db/ident :news.rank/signal        :db/valueType :db.type/keyword  :db/cardinality :db.cardinality/many
   :db/doc "G2 INVARIANT — only public-good signals; :paid-placement/:sponsored/:engagement/:dwell-time are NOT members"
   :db/allowed [:recency :section-fit :source-diversity :actor-relevance :geo-proximity]}

  ;; ───────────────────── :news.issue — a composed front-面 edition ───────────
  {:db/ident :news.issue/id           :db/valueType :db.type/string   :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
  {:db/ident :news.issue/as-of        :db/valueType :db.type/long     :db/cardinality :db.cardinality/one}
  {:db/ident :news.issue/sections     :db/valueType :db.type/ref      :db/cardinality :db.cardinality/many :db/doc "→ :news.section/id, in 面 order"}
  {:db/ident :news.issue/lead         :db/valueType :db.type/ref      :db/cardinality :db.cardinality/many :db/doc "→ :news.article/id — the 一面 leads (ranked by G2 signals only)"}
  {:db/ident :news.issue/published    :db/valueType :db.type/boolean  :db/cardinality :db.cardinality/one :db/doc "G7/G8 — false until member-signed + operator-gated"}
  {:db/ident :news.issue/server-held-key :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one :db/allowed [false] :db/doc "G7 — server never signs an edition (ADR-2605231525)"}
  {:db/ident :news.issue/final        :db/valueType :db.type/boolean  :db/cardinality :db.cardinality/one :db/allowed [false] :db/doc "G10 — no last edition (非終末論)"}]

 ;; ───────────────────── gate catalog (11 immutable gates) ───────────────────
 :gates
 {:G1  "Mirror-not-adjudicator — :article/verdict + :article/truth-rating :db/allowed [false]; records what an outlet published, never rules truth (ake/danjo boundary)"
  :G2  "No-ads / no-engagement-rank — :news.rank/signal excludes :paid-placement/:sponsored/:engagement/:dwell-time (Charter §1.13 + Charter-Rider §2)"
  :G3  "No-reader-surveillance — no :reader entity; :article/personalized-for :db/allowed [false]; the 面 is identical for all (watari person-exclusion)"
  :G4  "Copyright / link-out — :article/full-text :db/allowed [false]; headline + canonical :url + bounded fair-use :excerpt + :outlet only (kanjo §2(c))"
  :G5  "Source-provenance-honest — :mirror requires :outlet + :url + :as-of; :representative seed flagged; fabricated coverage refused (watari freshness)"
  :G6  "Murakumo-only — any summarization/translation via LiteLLM 127.0.0.1:4000 (ADR-2605215000)"
  :G7  "No-server-key — actor-event projection + issue publication member/operator-signed; :server-held-key const false (ADR-2605231525)"
  :G8  "Outward-gated — live outlet/RSS ingest + live publish = Council Lv6+ + operator (watari/mitooshi G10)"
  :G9  "Mirror-not-impersonation — :article/speak-as :db/allowed [false]; mirrors outlets AND actors as observations, never speaks AS them (ADR-2606042330)"
  :G10 "Non-eschatological as-of — :news.issue/final :db/allowed [false]; append-only edition trail (非終末論)"
  :G11 "Connective-by-construction (the MEDIUM gate) — every article is :mirror (real outlet) OR :actor-event (projected first-party Datom); :original is unrepresentable; the article×mention×面 graph is the actor-to-actor wire"}}
