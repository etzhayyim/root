;; forecasting-ontology.kotoba.edn — vocabulary for mitooshi (見通し)
;; ADR-2606051800 · actor: orgs/etzhayyim/com-etzhayyim-mitooshi/
;;
;; SCOPE: a probabilistic FORECASTING OBSERVATORY. Datafies public time-series
;;   (:series/*), their realized observations (:obs/*), probabilistic forecasts over
;;   them (:forecast/*), the proper-scoring-rule residuals that fall out when fact
;;   meets forecast (:fc.score/*), per-model calibration (:fc.calib/*) and the online
;;   weight-correction the residuals drive (:fc.model/* :fc.update/*) — all into the
;;   kotoba Datom log with as-of history. The answer to "事実からモデル誤差・weight を
;;   修正・学習する architecture": the forecast carries its information-AS-OF stamp, the
;;   observation arrives later as an append-only datom, and the score is the join of
;;   the two across `as-of` — so a backtest can never see future data (look-ahead leak
;;   is STRUCTURALLY impossible on an append-only log).
;;
;; WHY mitooshi (見通し, outlook / foresight / visibility): a forecast is *visibility*
;;   into a distribution of possible futures, NOT a prophecy of one. The name is
;;   deliberately non-occult (G12 anti-pseudoscience) and deliberately probabilistic
;;   (非終末論 — there is no asserted final state).
;;
;; CONSTITUTIONAL CONTEXT: a naive "quant market prediction" actor would be a trading
;;   bot — which is profit speculation (Charter §1.3 non-profit-only + Charter-Rider
;;   §2; yobel explicitly prohibits "predictive market / derivative speculation").
;;   mitooshi is the inverse: an OBSERVATORY that emits probabilistic forecasts routed
;;   to resilience / planning / early-warning (danjo / kanae / watari / watatsuna
;;   siblings), and NEVER places a trade, holds a position, or derives P&L. It does not
;;   adjudicate or advise (kanjo boundary — 投資助言業 ではない).
;;
;; INVARIANT #1 — DISTRIBUTION-ONLY / NO POINT-ASSERTION (G1, enforced in schema
;;   :db/allowed + lexicon `const` + forecast_issue/state_machine.py ValueError):
;;   :forecast/point-asserted is :db/allowed [false]. A forecast that asserts a single
;;   deterministic future is NOT representable. Every forecast is a probability
;;   distribution (:forecast/dist-kind ∈ {:gaussian :quantile :categorical :ensemble}).
;;   This is the 非終末論 invariant made structural: no final-state datom.
;;
;; INVARIANT #2 — NON-SPECULATIVE / NO-TRADING (G2, enforced 3 places):
;;   :forecast/use takes ONLY {:resilience :planning :nowcast :early-warning :research}.
;;   :trade / :speculation / :wager / :position are NOT enum members. The data model
;;   cannot express a forecast made to place a bet. mitooshi never settles money.
;;
;; INVARIANT #3 — PRIMARY-PUBLIC-SOURCE-ONLY (G4):
;;   :series/source-class ∈ {:public-broadcast :primary-disclosure :open-commons
;;   :gov-open-data :member-principal}. Proprietary terminals (Bloomberg / CapIQ /
;;   Refinitiv / 四季報) and scraped Google-Trends are NOT enum members (kanjo §2(c)/(e)
;;   anti-gatekeeping precedent). Google Trends only via karakuri member-principal
;;   ToS-honest path, recorded as :member-principal and G10-gated.
;;
;; INVARIANT #4 — LEAK-FREE / SKILL-HONEST SCORING (G5):
;;   every :forecast carries :forecast/info-as-of (the latest observation timestamp the
;;   forecaster was allowed to see). A :fc.score MUST reference an :obs whose
;;   :obs/observed-at is STRICTLY AFTER :forecast/info-as-of, else it is a leak and
;;   score.py raises. Scoring uses proper scoring rules ONLY (CRPS / pinball / Brier /
;;   log-score); a model is :fc.model/skilled true ONLY if it beats a documented
;;   baseline (:baseline/* climatology / persistence / random-walk) on a proper score.
;;
;; SOURCING (G11): every node carries :*/sourcing. BOUNDED illustrative seed; figures
;;   are :representative and MUST be verified against the cited primary source before
;;   any outward use (G10-gated).
;;
;; HISTORY (非終末論): a forecast, its outcome, its score, and every model weight-update
;;   are an :as-of trajectory — no final "correct model" datom; calibration drift is
;;   the moving record. The model is never finished; it is continually corrected.

{:ontology "com.etzhayyim.mitooshi.forecasting"
 :version  1
 :graph    {:name "forecasting-v1" :visibility :public}

 :attributes
 {;; ───────────────────────── :series/* — a public time-series ───────────────
  :series/id            {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
  :series/name          {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
  :series/kind          {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one
                         :db/doc "{:transit-load :congestion :availability :price-index :search-interest :flow-rate :outage-count} — the observable, never a person"}
  :series/unit          {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
  :series/freq          {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one
                         :db/doc "{:hourly :daily :weekly :monthly}"}
  :series/source        {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "primary public source (AISStream / OpenSky / EDINET / Common-Crawl / gov-open-data)"}
  :series/source-class  {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one
                         :db/doc "G4 INVARIANT — {:public-broadcast :primary-disclosure :open-commons :gov-open-data :member-principal}; proprietary terminals + scraped Google-Trends NOT representable"
                         :db/allowed [:public-broadcast :primary-disclosure :open-commons :gov-open-data :member-principal]}
  :series/sourcing      {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc "{:representative :verified}"}

  ;; ───────────────────────── :obs/* — a realized observation (ground truth) ──
  :obs/id               {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
  :obs/series           {:db/valueType :db.type/ref     :db/cardinality :db.cardinality/one}
  :obs/observed-at      {:db/valueType :db.type/long    :db/cardinality :db.cardinality/one :db/doc "epoch — append-only; latest = current value, the stream = the trail (非終末論, no overwrite)"}
  :obs/value            {:db/valueType :db.type/double  :db/cardinality :db.cardinality/one}
  :obs/class            {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "for categorical series — the realized class label"}
  :obs/source-actor     {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "provenance — the actor whose public roll-up this observation was bridged from (e.g. watari/watatsuna); the obs is :representative, never authoritative"}

  ;; ───────────────────────── :forecast/* — a probabilistic forecast ─────────
  :forecast/id          {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
  :forecast/series      {:db/valueType :db.type/ref     :db/cardinality :db.cardinality/one}
  :forecast/model       {:db/valueType :db.type/ref     :db/cardinality :db.cardinality/one}
  :forecast/issued-at   {:db/valueType :db.type/long    :db/cardinality :db.cardinality/one :db/doc "epoch the forecast was emitted"}
  :forecast/info-as-of  {:db/valueType :db.type/long    :db/cardinality :db.cardinality/one
                         :db/doc "G5 INVARIANT — latest observation ts the forecaster could see; a score's :obs MUST be strictly after this or it is a leak"}
  :forecast/target-at   {:db/valueType :db.type/long    :db/cardinality :db.cardinality/one :db/doc "epoch the forecast is about (info-as-of + horizon)"}
  :forecast/horizon     {:db/valueType :db.type/long    :db/cardinality :db.cardinality/one :db/doc "lead time in series-freq steps"}
  :forecast/dist-kind   {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one
                         :db/doc "{:gaussian :quantile :categorical :ensemble}"
                         :db/allowed [:gaussian :quantile :categorical :ensemble]}
  :forecast/mean        {:db/valueType :db.type/double  :db/cardinality :db.cardinality/one :db/doc "for :gaussian"}
  :forecast/sd          {:db/valueType :db.type/double  :db/cardinality :db.cardinality/one :db/doc "for :gaussian — strictly > 0"}
  :forecast/quantiles   {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "for :quantile — edn map level→value, e.g. {0.1 .. 0.5 .. 0.9 ..}"}
  :forecast/probs       {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "for :categorical — edn map class→prob (Σ=1)"}
  :forecast/members     {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "for :ensemble — edn vector of member values; scored by energy-form CRPS"}
  :forecast/point-asserted {:db/valueType :db.type/boolean :db/cardinality :db.cardinality/one
                            :db/doc "G1 INVARIANT — :db/allowed [false]. A deterministic single-future assertion is unrepresentable (非終末論). Only false is valid."
                            :db/allowed [false]}
  :forecast/use         {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one
                         :db/doc "G2 INVARIANT — {:resilience :planning :nowcast :early-warning :research}; :trade/:speculation/:wager/:position NOT representable"
                         :db/allowed [:resilience :planning :nowcast :early-warning :research]}
  :forecast/sourcing    {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}

  ;; ───────────────────────── :fc.score/* — proper-scoring residual ──────────
  :fc.score/id          {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
  :fc.score/forecast    {:db/valueType :db.type/ref     :db/cardinality :db.cardinality/one}
  :fc.score/obs         {:db/valueType :db.type/ref     :db/cardinality :db.cardinality/one :db/doc "G5 — :obs/observed-at MUST be > forecast :info-as-of"}
  :fc.score/crps        {:db/valueType :db.type/double  :db/cardinality :db.cardinality/one :db/doc "Continuous Ranked Probability Score (lower better)"}
  :fc.score/pinball     {:db/valueType :db.type/double  :db/cardinality :db.cardinality/one :db/doc "mean pinball / quantile loss"}
  :fc.score/log-score   {:db/valueType :db.type/double  :db/cardinality :db.cardinality/one :db/doc "negative log predictive density (lower better)"}
  :fc.score/brier       {:db/valueType :db.type/double  :db/cardinality :db.cardinality/one :db/doc "categorical only"}
  :fc.score/pit         {:db/valueType :db.type/double  :db/cardinality :db.cardinality/one :db/doc "probability integral transform F(y) ∈ [0,1] — Uniform if calibrated"}
  :fc.score/skill       {:db/valueType :db.type/double  :db/cardinality :db.cardinality/one :db/doc "1 − score_model/score_baseline; >0 = beats baseline"}
  :fc.score/baseline    {:db/valueType :db.type/ref     :db/cardinality :db.cardinality/one}
  :fc.score/derived     {:db/valueType :db.type/boolean :db/cardinality :db.cardinality/one :db/doc "true — never re-ingested as authoritative fact"}

  ;; ───────────────────────── :baseline/* — the skill yardstick ──────────────
  :baseline/id          {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
  :baseline/kind        {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one
                         :db/doc "{:climatology :persistence :random-walk}"
                         :db/allowed [:climatology :persistence :random-walk]}

  ;; ───────────────────────── :fc.model/* — a forecasting model ──────────────
  :fc.model/id          {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
  :fc.model/name        {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
  :fc.model/method      {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc "{:ewma :gradient-boost :baien-edge :ar :state-space}"}
  :fc.model/version     {:db/valueType :db.type/long    :db/cardinality :db.cardinality/one}
  :fc.model/params-cid  {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "content-addressed weights blob (IPFS CID); empty until trained"}
  :fc.model/runtime     {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc "{:baien-edge :wasm} — Murakumo-only / edge envelope (ADR-2605241900/2605215000)"}
  :fc.model/skilled     {:db/valueType :db.type/boolean :db/cardinality :db.cardinality/one :db/doc "G5/G12 — true ONLY if it beats baseline on a proper score; honest false otherwise"}
  :fc.model/promoted    {:db/valueType :db.type/boolean :db/cardinality :db.cardinality/one :db/doc "live? — promotion requires member/operator signature (G9 no-server-key); server signature refused"}

  ;; ───────────────────────── :fc.calib/* — calibration record ───────────────
  :fc.calib/id          {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
  :fc.calib/model       {:db/valueType :db.type/ref     :db/cardinality :db.cardinality/one}
  :fc.calib/pit-mean    {:db/valueType :db.type/double  :db/cardinality :db.cardinality/one :db/doc "≈0.5 if calibrated"}
  :fc.calib/deviation   {:db/valueType :db.type/double  :db/cardinality :db.cardinality/one :db/doc "uniformity deviation of the PIT histogram; high = miscalibrated"}
  :fc.calib/as-of       {:db/valueType :db.type/long    :db/cardinality :db.cardinality/one}

  ;; ───────────────────────── :fc.update/* — online weight correction ────────
  :fc.update/id         {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
  :fc.update/model      {:db/valueType :db.type/ref     :db/cardinality :db.cardinality/one}
  :fc.update/from-version {:db/valueType :db.type/long  :db/cardinality :db.cardinality/one}
  :fc.update/to-version {:db/valueType :db.type/long    :db/cardinality :db.cardinality/one}
  :fc.update/trigger    {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc "{:residual-drift :calibration-drift :scheduled}"}
  :fc.update/bias-corr  {:db/valueType :db.type/double  :db/cardinality :db.cardinality/one :db/doc "EWMA bias correction applied to mean"}
  :fc.update/var-infl   {:db/valueType :db.type/double  :db/cardinality :db.cardinality/one :db/doc "variance inflation factor restoring calibration"}
  :fc.update/runtime    {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc "G8 — :baien-edge (federated, ADR-2605242600/2630); NO commercial GPU"}
  :fc.update/signed-by  {:db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "G9 — member/operator DID; promotion never server-signed"}
  :fc.update/as-of      {:db/valueType :db.type/long    :db/cardinality :db.cardinality/one}}}
