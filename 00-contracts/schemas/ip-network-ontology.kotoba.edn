;; ip-network-ontology — kotoba EAVT vocabulary for the world IP / DNS-attribution graph
;; ADR-2605301400 T2 (ipaddress SQL → kotoba) · actor: ipaddress.etzhayyim.com (1次 collector)
;;
;; PURPOSE
;;   A content-addressed Datom (EAVT) vocabulary describing the planet's IP-number
;;   resource hierarchy as a knowledge graph: the 5 RIRs → their delegated CIDR
;;   RANGES → the ASNs that announce them → individual observed IP ADDRESSES, with
;;   GEO / reverse-DNS / WHOIS enrichment hung off each. The lens is the same as
;;   the rest of the observation family (kabuto/watatsuna/tsumugi): a RESILIENCE +
;;   accountability map of how Internet number resources concentrate, NEVER a
;;   target-list or a scan-the-world weapon.
;;
;;   This vocabulary REPLACES the legacy ipaddress RisingWave / yata Workers-RPC SQL
;;   graph (vertex_ip_address / vertex_ipaddress_asn / vertex_ipaddress_range / …).
;;   Per ADR-2605262130 + 2605312345 the canonical state is the kotoba Datom log;
;;   IPFS = block backend, MST = ingress/interop wire, Base L2 = trust anchor.
;;   NO RisingWave, NO centralized SQL as system-of-record.
;;
;; ACTIVE COLLECTION (能動的) — authorized for this actor:
;;   ipaddress is a 1次ソース collector and MAY actively pull PUBLIC number-resource
;;   registries: RIR delegated-stats files (ftp.{apnic,ripe,arin,lacnic,afrinic}…),
;;   RDAP / WHOIS (RFC 7482), BGP route-collector tables, and reverse-DNS (PTR).
;;   Active collection is GATE-G7 operator-gated and offline-default in code; even
;;   when enabled it touches only public registry/measurement data. It does NOT
;;   port-scan / probe / fingerprint hosts at planet scale (that is the akuma/aratame
;;   AUTHORIZED-mandate boundary, not 1次 number-resource collection — see SCOPE GUARD).
;;
;; SOURCING HONESTY (G5, mirrors kabuto/watatsuna/tsumugi):
;;   :*/sourcing ∈ { :authoritative  ; from a primary registry (RIR delegated-stats,
;;                                      RDAP/WHOIS response, route-collector table, PTR)
;;                   :representative  ; publicly documented but a bounded illustrative
;;                                      sample, NOT exhaustive; coordinates approximate
;;                   :synthesized }   ; derived/estimated by ipaddress; MUST be flagged
;;   Absence of a resource from the graph means "not yet ingested", never "does not exist".
;;
;; SCOPE GUARD (constitutional):
;;   - PUBLIC number-resource record only. RIR allocations, ASN registrations, BGP
;;     announcements, GeoIP, and PTR are matters of public record / public measurement.
;;   - FORBIDDEN inputs: planet-scale port/vuln scan banners as a primary store
;;     (that belongs to an akuma/aratame caseMandate, not 1次 collection), de-anonymising
;;     etzhayyim adherents, and any payload that maps a number resource to a private
;;     natural person without the encrypted envelope (see :ip.attr/encrypted + tadori G6/G10).
;;   - Concentration analysis is emitted AGGREGATE-FIRST and framed toward routing
;;     diversity / accountability — never "which prefix to attack".

{:schema/id        "ip-network-ontology"
 :schema/version   "0.1.0"
 :schema/adr       "2605301400"
 :schema/supersedes ["com.etzhayyim.apps.ipaddress.ip_address"
                     "com.etzhayyim.apps.ipaddress.ip_range"
                     "com.etzhayyim.apps.ipaddress.asn"
                     "com.etzhayyim.apps.ipaddress.geolocation"
                     "com.etzhayyim.apps.ipaddress.reverse_dns"
                     "com.etzhayyim.apps.ipaddress.whois_snapshot"]
 :schema/note      "kotoba-native successor to the ipaddress RisingWave SQL graph (vertex_ip_address / vertex_ipaddress_asn / vertex_ipaddress_range). ADR-2605301400 §T2."

 :attributes
 [;; ── :rir/* — a Regional Internet Registry (5 + NRO coordination) ──
  {:db/ident :rir/id            :db/valueType :db.type/string  :db/unique :db.unique/identity :db/doc "stable id, e.g. \"rir.apnic\""}
  {:db/ident :rir/name          :db/valueType :db.type/string  :db/doc "e.g. \"APNIC\""}
  {:db/ident :rir/region        :db/valueType :db.type/string  :db/doc "service region, e.g. \"Asia-Pacific\""}
  {:db/ident :rir/delegated-stats-url :db/valueType :db.type/string :db/doc "public delegated-stats file URL (collection source-of-record)"}
  {:db/ident :rir/sourcing      :db/valueType :db.type/keyword}

  ;; ── :asn/* — an Autonomous System (operator of one BGP origin) ──
  {:db/ident :asn/id            :db/valueType :db.type/string  :db/unique :db.unique/identity :db/doc "stable id, e.g. \"asn.13335\""}
  {:db/ident :asn/number        :db/valueType :db.type/long    :db/doc "AS number, e.g. 13335"}
  {:db/ident :asn/name          :db/valueType :db.type/string  :db/doc "registered AS name / org, e.g. \"CLOUDFLARENET\""}
  {:db/ident :asn/country       :db/valueType :db.type/string  :db/doc "ISO 3166-1 alpha-2 of the registrant"}
  {:db/ident :asn/rir           :db/valueType :db.type/ref     :db/doc ":rir/id that delegated the ASN"}
  {:db/ident :asn/prefix-count  :db/valueType :db.type/long    :db/doc "count of announced prefixes (BGP table; :authoritative from a route collector, else :representative)"}
  {:db/ident :asn/hosting-class :db/valueType :db.type/keyword :db/doc ":residential | :cloud | :hosting | :cdn | :transit | :enterprise | :academic | :unknown"}
  {:db/ident :asn/sourcing      :db/valueType :db.type/keyword}

  ;; ── :iprange/* — a delegated CIDR block (RIR/NIR allocation) ──
  {:db/ident :iprange/id        :db/valueType :db.type/string  :db/unique :db.unique/identity :db/doc "stable id, e.g. \"range.v4.104-16-0-0-13\""}
  {:db/ident :iprange/cidr      :db/valueType :db.type/string  :db/doc "e.g. \"104.16.0.0/13\""}
  {:db/ident :iprange/version   :db/valueType :db.type/long    :db/doc "4 | 6"}
  {:db/ident :iprange/country   :db/valueType :db.type/string  :db/doc "ISO 3166-1 alpha-2 of the allocation"}
  {:db/ident :iprange/rir       :db/valueType :db.type/ref     :db/doc ":rir/id that delegated it"}
  {:db/ident :iprange/status    :db/valueType :db.type/keyword :db/doc ":allocated | :assigned | :reserved | :available"}
  {:db/ident :iprange/alloc-date :db/valueType :db.type/string :db/doc "allocation/registration date (delegated-stats column)"}
  {:db/ident :iprange/host-count :db/valueType :db.type/long   :db/doc "address count in the block (delegated-stats value column)"}
  {:db/ident :iprange/sourcing  :db/valueType :db.type/keyword}

  ;; ── :ip/* — an observed individual IP address (on-demand, observation-time) ──
  {:db/ident :ip/id             :db/valueType :db.type/string  :db/unique :db.unique/identity :db/doc "stable id, e.g. \"ip.v4.104-16-1-1\""}
  {:db/ident :ip/address        :db/valueType :db.type/string  :db/doc "canonical text form, e.g. \"104.16.1.1\""}
  {:db/ident :ip/version        :db/valueType :db.type/long    :db/doc "4 | 6"}
  {:db/ident :ip/first-seen-at  :db/valueType :db.type/string  :db/doc "first observation (as-of history; appended, never overwritten — 非終末論)"}
  {:db/ident :ip/last-seen-at   :db/valueType :db.type/string}
  {:db/ident :ip/sourcing       :db/valueType :db.type/keyword}

  ;; ── FIRST-CLASS edges ────────────────────────────────────────────────────
  ;; a range is announced by an ASN (prefix ⇄ origin AS; the BGP backbone)
  {:db/ident :net.announce/id   :db/valueType :db.type/string  :db/unique :db.unique/identity}
  {:db/ident :net.announce/range :db/valueType :db.type/ref    :db/doc ":iprange/id"}
  {:db/ident :net.announce/asn  :db/valueType :db.type/ref     :db/doc ":asn/id origin"}
  {:db/ident :net.announce/sourcing :db/valueType :db.type/keyword}
  ;; an IP belongs to a range (address ⇄ enclosing CIDR)
  {:db/ident :net.member/id     :db/valueType :db.type/string  :db/unique :db.unique/identity}
  {:db/ident :net.member/ip     :db/valueType :db.type/ref     :db/doc ":ip/id"}
  {:db/ident :net.member/range  :db/valueType :db.type/ref     :db/doc ":iprange/id"}
  {:db/ident :net.member/sourcing :db/valueType :db.type/keyword}

  ;; ── :geo/* — GeoIP enrichment of an IP or range (as-of; can move over time) ──
  {:db/ident :geo/id            :db/valueType :db.type/string  :db/unique :db.unique/identity}
  {:db/ident :geo/ip            :db/valueType :db.type/ref     :db/doc ":ip/id or :iprange/id this geo describes"}
  {:db/ident :geo/country       :db/valueType :db.type/string  :db/doc "ISO 3166-1 alpha-2"}
  {:db/ident :geo/city          :db/valueType :db.type/string}
  {:db/ident :geo/lat           :db/valueType :db.type/double  :db/doc "approx; :representative may round"}
  {:db/ident :geo/lon           :db/valueType :db.type/double}
  {:db/ident :geo/is-datacenter :db/valueType :db.type/boolean}
  {:db/ident :geo/is-proxy      :db/valueType :db.type/boolean :db/doc "VPN/anonymizing-proxy flag (public GeoIP enrichment, NOT adherent de-anon)"}
  {:db/ident :geo/observed-at   :db/valueType :db.type/string}
  {:db/ident :geo/sourcing      :db/valueType :db.type/keyword}

  ;; ── :rdns/* — a reverse-DNS PTR observation for an IP ──
  {:db/ident :rdns/id           :db/valueType :db.type/string  :db/unique :db.unique/identity}
  {:db/ident :rdns/ip           :db/valueType :db.type/ref     :db/doc ":ip/id"}
  {:db/ident :rdns/ptr          :db/valueType :db.type/string  :db/doc "PTR hostname, e.g. \"one.one.one.one\""}
  {:db/ident :rdns/verified     :db/valueType :db.type/boolean :db/doc "forward-confirmed (FCrDNS) when the A/AAAA round-trips"}
  {:db/ident :rdns/observed-at  :db/valueType :db.type/string}
  {:db/ident :rdns/sourcing     :db/valueType :db.type/keyword}

  ;; ── :whois/* — a WHOIS/RDAP snapshot of a range/ASN (public registry record) ──
  {:db/ident :whois/id          :db/valueType :db.type/string  :db/unique :db.unique/identity}
  {:db/ident :whois/subject     :db/valueType :db.type/ref     :db/doc ":iprange/id or :asn/id"}
  {:db/ident :whois/registrant-org :db/valueType :db.type/string :db/doc "public org name only; natural-person registrant fields MUST go encrypted (:ip.attr/encrypted)"}
  {:db/ident :whois/abuse-email :db/valueType :db.type/string  :db/doc "public abuse contact (RIR-published)"}
  {:db/ident :whois/registrar   :db/valueType :db.type/string}
  {:db/ident :whois/updated-at  :db/valueType :db.type/string}
  {:db/ident :whois/sourcing    :db/valueType :db.type/keyword}

  ;; ── PII guard: any datom carrying a natural-person attribution must set this ──
  {:db/ident :ip.attr/encrypted :db/valueType :db.type/boolean
   :db/doc "true when the record maps a number resource to a private natural person; payload then lives under com.etzhayyim.encrypted.* (ADR-2605181100), never plaintext. Public org/abuse contacts are NOT PII."}]

 ;; ── DERIVED (analyze.py, never re-ingested as authoritative fact) ──
 :derived-attributes
 [{:db/ident :ipnet/rir-coverage       :db/doc "address count + range count delegated per RIR"}
  {:db/ident :ipnet/asn-prefix-load    :db/doc "Σ announced prefixes per ASN — origin-concentration"}
  {:db/ident :ipnet/hosting-class-load :db/doc "Σ address space per hosting-class (cloud/cdn/residential/…)"}
  {:db/ident :ipnet/country-load       :db/doc "Σ delegated address space per country"}
  {:db/ident :ipnet/space-hhi          :db/doc "Herfindahl concentration of address space across operators/blocs"}]}
