{
  "method_policy": {
    "com.etzhayyim.apps.arms.registerFirearm": {
      "requiresAuth": true,
      "allowedScopes": ["rpc?lxm=com.etzhayyim.apps.arms.registerFirearm"],
      "allowedPermissionSets": ["arms:authority", "arms:system"],
      "publicRead": false
    },
    "com.etzhayyim.apps.arms.authenticateHolder": {
      "requiresAuth": false,
      "allowedScopes": ["rpc?lxm=*"],
      "allowedPermissionSets": [],
      "publicRead": true
    },
    "com.etzhayyim.apps.arms.verifyAuthChallenge": {
      "requiresAuth": true,
      "allowedScopes": ["rpc?lxm=com.etzhayyim.apps.arms.verifyAuthChallenge"],
      "allowedPermissionSets": [],
      "publicRead": false
    },
    "com.etzhayyim.apps.arms.issuePermit": {
      "requiresAuth": true,
      "allowedScopes": ["rpc?lxm=com.etzhayyim.apps.arms.issuePermit"],
      "allowedPermissionSets": ["arms:authority"],
      "publicRead": false
    },
    "com.etzhayyim.apps.arms.transferCustody": {
      "requiresAuth": true,
      "allowedScopes": ["rpc?lxm=com.etzhayyim.apps.arms.transferCustody"],
      "allowedPermissionSets": ["arms:holder", "arms:authority"],
      "publicRead": false,
      "requiresHolderAuthSession": true
    },
    "com.etzhayyim.apps.arms.checkOutFirearm": {
      "requiresAuth": true,
      "allowedScopes": ["rpc?lxm=com.etzhayyim.apps.arms.checkOutFirearm"],
      "allowedPermissionSets": ["arms:holder", "arms:authority"],
      "publicRead": false,
      "requiresHolderAuthSession": true
    },
    "com.etzhayyim.apps.arms.checkInFirearm": {
      "requiresAuth": true,
      "allowedScopes": ["rpc?lxm=com.etzhayyim.apps.arms.checkInFirearm"],
      "allowedPermissionSets": ["arms:holder", "arms:authority"],
      "publicRead": false
    },
    "com.etzhayyim.apps.arms.reportIncident": {
      "requiresAuth": true,
      "allowedScopes": ["rpc?lxm=com.etzhayyim.apps.arms.reportIncident"],
      "allowedPermissionSets": ["arms:holder", "arms:authority", "arms:law-enforcement"],
      "publicRead": false
    },
    "com.etzhayyim.apps.arms.getFirearm": {
      "requiresAuth": true,
      "allowedScopes": ["rpc?lxm=com.etzhayyim.apps.arms.getFirearm"],
      "allowedPermissionSets": ["arms:holder", "arms:authority", "arms:law-enforcement"],
      "publicRead": false
    },
    "com.etzhayyim.apps.arms.listFirearms": {
      "requiresAuth": true,
      "allowedScopes": ["rpc?lxm=com.etzhayyim.apps.arms.listFirearms"],
      "allowedPermissionSets": ["arms:holder", "arms:authority", "arms:law-enforcement"],
      "publicRead": false
    },
    "com.etzhayyim.apps.arms.listPermits": {
      "requiresAuth": true,
      "allowedScopes": ["rpc?lxm=com.etzhayyim.apps.arms.listPermits"],
      "allowedPermissionSets": ["arms:holder", "arms:authority", "arms:law-enforcement"],
      "publicRead": false
    },
    "com.etzhayyim.apps.arms.getAuditLog": {
      "requiresAuth": true,
      "allowedScopes": ["rpc?lxm=com.etzhayyim.apps.arms.getAuditLog"],
      "allowedPermissionSets": ["arms:authority", "arms:law-enforcement"],
      "publicRead": false
    }
  },
  "export_restricted_jurisdictions": [
    "KP", "IR", "SY", "RU", "BY", "MM", "SD", "CF", "LY", "SO", "YE", "SS"
  ],
  "permit_types": {
    "military": {
      "issuingAuthority": ["arms:authority"],
      "requiredPermissionSets": ["arms:military-registry"]
    },
    "law-enforcement": {
      "issuingAuthority": ["arms:authority", "arms:law-enforcement"],
      "requiredPermissionSets": ["arms:law-enforcement"]
    },
    "civilian-possession": {
      "issuingAuthority": ["arms:authority"],
      "requiredPermissionSets": [],
      "maxFirearms": 1
    },
    "licensed-dealer": {
      "issuingAuthority": ["arms:authority"],
      "requiredPermissionSets": ["arms:dealer"]
    }
  }
}