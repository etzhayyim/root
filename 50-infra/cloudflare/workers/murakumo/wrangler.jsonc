{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "etzhayyim-murakumo",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "LITELLM_URL": "https://murakumo-serve.etzhayyim.com",
    "MURAKUMO_DID": "did:web:murakumo.etzhayyim.com"
  },
  "routes": [
    {
      "pattern": "murakumo.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "etzhayyim-murakumo"
    }
  ],
  "_etzhayyim_substrate_notes": "ADR-2605191358 — no HYPERDRIVE binding; durable state via @etzhayyim/sdk to PDS + IPFS + L2. Secrets to set via `wrangler secret put`: LITELLM_MASTER, MURAKUMO_CHAT_SECRET, MURAKUMO_PDS_SESSION (or MURAKUMO_PDS_AUTH)."
}
