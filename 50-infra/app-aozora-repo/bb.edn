{;; app-aozora-repo — AT Protocol repo layer (dag-cbor / CIDv1 / blocks / commit)
 ;; on the kotoba Datom log. babashka runner, no external deps.
 :paths ["src" "test"]
 :deps {
        ;; kotoba.lang.error replaced clojure.lang.ExceptionInfo here (2026-09-25).
        ;; An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/error
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4383a49bbf59dc9370e9771c2d7321cada8c37d0"
         :deps/root "lib/kotoba.error"}
        ;; kotoba.bytes replaced java.util.Base64 here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4383a49bbf59dc9370e9771c2d7321cada8c37d0"
         :deps/root "lib/kotoba.bytes"}}
 :tasks
 {test
  {:doc "Spec-conformance + round-trip suite (CIDs vs go-ipfs; MST vs @atproto/repo)."
   :requires ([clojure.test :as t]
              [etzhayyim.aozora.repo.repo-test]
              [etzhayyim.aozora.repo.dag-cbor-test]
              [etzhayyim.aozora.repo.mst-test]
              [etzhayyim.aozora.repo.commit-sync-test]
              [etzhayyim.aozora.repo.firehose-test])
   :task (let [{:keys [fail error]}
               (t/run-tests 'etzhayyim.aozora.repo.repo-test
                            'etzhayyim.aozora.repo.dag-cbor-test
                            'etzhayyim.aozora.repo.mst-test
                            'etzhayyim.aozora.repo.commit-sync-test
                            'etzhayyim.aozora.repo.firehose-test)]
           (System/exit (if (pos? (+ fail error)) 1 0)))}}}
