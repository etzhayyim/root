 {:proc/id \"proc:uk-bankruptcy\" :proc/label \"Bankruptcy (England & Wales, own petition)\"
  :proc/jurisdiction :uk :proc/track :self-filing
  :proc/forum \"Adjudicator (online application via gov.uk) — no court hearing needed since the 2016 reform\"
  :proc/official-forms-url \"https://www.gov.uk/apply-for-bankruptcy\"
  :proc/eligibility-signals
  [\"debtor is unable to pay their debts as they fall due — no minimum debt threshold for a debtor's own application (unlike creditor petitions, which have a statutory minimum)\"
   \"must be domiciled/present/have a place of residence or business in England & Wales\"]
  :proc/mandatory-preconditions []
  :proc/required-docs [\"online bankruptcy application (gov.uk)\" \"statement of affairs (assets/income/expenditure)\"]
  :proc/fee {:fee/label \"adjudicator fee + official receiver's deposit\" :fee/note \"£130 adjudicator fee + £550 official receiver deposit (as of the current fee order) — no fee-exempt route for the deposit portion at present\"}
  :proc/fee-waiver \"none for the deposit; the adjudicator fee may have limited remission in specific circumstances — verify current Insolvency Service guidance\"
  :proc/timeline-rules
  [{:tl/label \"Automatic discharge\" :tl/rule \"discharge is automatic after 12 months from the bankruptcy order (can be earlier via early-discharge certificate from the official receiver) — discharge releases most debts but not all categories (e.g. certain fines, student loans, family court orders)\"
    :tl/anchor \"Insolvency Act 1986 Pt IX s.279, as amended by the Enterprise and Regulatory Reform Act 2013 s.71\" :tl/source-url \"https://www.legislation.gov.uk/ukpga/1986/45/part/IX\"}]
  :proc/options
  [{:opt/id :self-file :opt/kind :self-submit :opt/protective true
    :opt/label \"apply online via gov.uk (self-file — no solicitor required for the application itself)\"}]
  :proc/refer-when [\"business assets / trading debts\" \"prior bankruptcy within the relevant look-back period\" \"disputed debt figures\"]
  :proc/verify-current-law true}

 {:proc/id \"proc:uk-dro\" :proc/label \"Debt Relief Order (DRO)\"
  :proc/jurisdiction :uk :proc/track :self-filing
  :proc/forum \"Insolvency Service (application MUST go through an approved intermediary — not a direct self-file portal)\"
  :proc/official-forms-url \"https://www.moneyhelper.org.uk/en/money-troubles/dealing-with-debt/debt-advice-locator\"
  :proc/eligibility-signals
  [\"total debts below the statutory DRO ceiling, disposable income below the statutory monthly threshold, assets (excl. certain exempt items and one vehicle below a value cap) below the statutory threshold — all figures periodically adjusted, verify current Insolvency Service figures\"]
  :proc/mandatory-preconditions
  [{:pre/label \"Approved intermediary\" :pre/detail \"a DRO application CANNOT be self-filed directly — it must be submitted via an FCA/Insolvency-Service-approved intermediary (typically a free debt-advice charity adviser), who assesses eligibility and submits on the debtor's behalf with the debtor's information\"
    :pre/anchor \"Insolvency Act 1986 Pt 7A\"}]
  :proc/required-docs [\"intermediary intake assessment\" \"full income/expenditure/asset statement\"]
  :proc/fee {:fee/label \"application fee\" :fee/note \"£90 (as of the current fee order)\"}
  :proc/fee-waiver \"none currently — the fee itself is set low relative to bankruptcy specifically to keep this route accessible\"
  :proc/timeline-rules
  [{:tl/label \"Automatic discharge\" :tl/rule \"discharge is automatic 12 months after the DRO is made, provided circumstances have not changed materially (a moratorium period during which creditors cannot pursue the debts)\"
    :tl/anchor \"Insolvency Act 1986 Pt 7A\" :tl/source-url \"https://www.legislation.gov.uk/ukpga/1986/45/part/7A\"}]
  :proc/options
  [{:opt/id :find-intermediary :opt/kind :self-submit :opt/protective true
    :opt/label \"contact a free debt-advice charity (MoneyHelper locator) to find an approved intermediary — this step IS the filing route, not optional pre-work\"}]
  :proc/refer-when [\"always — DRO structurally requires the intermediary; there is no self-submit-without-intermediary path\"]
  :proc/verify-current-law true}

 ;; ── :de ──────────────────────────────────────────────────────────────────────
 {:proc/id \"proc:de-verbraucherinsolvenz\" :proc/label \"Verbraucherinsolvenzverfahren + Restschuldbefreiung\"
  :proc/jurisdiction :de :proc/track :self-filing
  :proc/forum \"Insolvenzgericht (Amtsgericht am Wohnsitz)\"
