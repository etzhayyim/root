    :tl/anchor \"§287 Abs. 2, §300, §302, §290 InsO (Fassung nach dem Gesetz zur weiteren Verkürzung des Restschuldbefreiungsverfahrens, 2021)\" :tl/source-url \"https://www.gesetze-im-internet.de/inso/\"}]
  :proc/options
  [{:opt/id :schuldnerberatung :opt/kind :self-submit :opt/protective true
    :opt/label \"anerkannte Schuldnerberatungsstelle aufsuchen — dieser Schritt IST der verpflichtende Verfahrenseinstieg, nicht optional (§305 InsO)\"}
   {:opt/id :self-file :opt/kind :self-submit :opt/protective true
    :opt/label \"nach gescheitertem außergerichtlichem Einigungsversuch: Antrag beim Insolvenzgericht selbst einreichen (amtliches Formular, Beratungsstelle unterstützt regelmäßig beim Ausfüllen)\"}]
  :proc/refer-when [\"selbständige Nebentätigkeit unklar (Regel- vs. Verbraucherinsolvenz-Abgrenzung)\" \"Versagungsgründe nach §290 InsO im Raum\" \"komplexe Gläubigerstruktur\"]
  :proc/verify-current-law true}]
