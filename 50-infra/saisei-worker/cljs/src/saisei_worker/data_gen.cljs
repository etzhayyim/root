 {:proc/id \"proc:us-chapter7\" :proc/label \"Chapter 7 (liquidation)\"
  :proc/jurisdiction :us :proc/track :self-filing
  :proc/forum \"United States Bankruptcy Court (federal, per judicial district)\"
  :proc/official-forms-url \"https://www.uscourts.gov/forms-rules/forms/bankruptcy-forms\"
  :proc/eligibility-signals
  [\"means test: current monthly income vs. state median — above-median filers face a further disposable-income test before Chapter 7 eligibility (11 U.S.C. §707(b))\"
   \"no minimum debt/asset threshold, but exempt-property schedules (state or federal exemptions) determine what stays with the debtor\"]
  :proc/mandatory-preconditions
  [{:pre/label \"Credit counseling (pre-filing)\"
    :pre/detail \"an individual must complete credit counseling from a USTP-approved agency within 180 days before filing — the certificate is a required attachment to the petition\"
    :pre/anchor \"11 U.S.C. §109(h)\"}]
  :proc/required-docs [\"Voluntary Petition (Official Form 101)\" \"Schedules A/B–J\" \"Statement of Financial Affairs\" \"means test forms (122A-1/122A-2)\" \"credit counseling certificate\"]
  :proc/fee {:fee/label \"filing fee\" :fee/note \"$338 (as of the current fee schedule) — periodically adjusted by the Judicial Conference\"}
  :proc/fee-waiver \"fee waiver under 28 U.S.C. §1930(f) for income below 150% of the federal poverty line, or installment payment of the fee\"
  :proc/timeline-rules
  [{:tl/label \"Discharge order\" :tl/rule \"absent an objection (11 U.S.C. §727) or a §523 nondischargeability finding, the court enters a discharge order after the §341 meeting of creditors and the applicable objection period run — discharge extinguishes covered debts except the §523(a) nondischargeable categories (most tax debt, student loans absent undue hardship, domestic support, etc.)\"
    :tl/anchor \"11 U.S.C. §727, §523\" :tl/source-url \"https://www.uscourts.gov/forms-rules/current-rules-practice-procedure/federal-rules-bankruptcy-procedure\"}]
  :proc/options
  [{:opt/id :self-file :opt/kind :self-submit :opt/protective true
    :opt/label \"file pro se via the court's CM/ECF or paper petition (Official Form 101 + schedules)\"}]
  :proc/refer-when [\"above-median income (means-test complexity)\" \"business assets / multiple properties\" \"anticipated §727/§523 objection\"]
  :proc/verify-current-law true}

 {:proc/id \"proc:us-chapter13\" :proc/label \"Chapter 13 (wage-earner plan)\"
  :proc/jurisdiction :us :proc/track :self-filing
  :proc/forum \"United States Bankruptcy Court (federal, per judicial district)\"
  :proc/official-forms-url \"https://www.uscourts.gov/forms-rules/forms/bankruptcy-forms\"
  :proc/eligibility-signals
  [\"individual with regular income; unsecured and secured debt below the statutory caps in 11 U.S.C. §109(e) (periodically adjusted)\"
   \"proposes a 3-to-5-year repayment plan rather than liquidation\"]
  :proc/mandatory-preconditions
  [{:pre/label \"Credit counseling (pre-filing)\"
    :pre/detail \"same §109(h) requirement as Chapter 7 — certificate required before filing\"
    :pre/anchor \"11 U.S.C. §109(h)\"}]
  :proc/required-docs [\"Voluntary Petition (Official Form 101)\" \"Schedules A/B–J\" \"Chapter 13 Plan (Official Form 113 or local form)\" \"Statement of Financial Affairs\" \"credit counseling certificate\"]
  :proc/fee {:fee/label \"filing fee\" :fee/note \"$313 (as of the current fee schedule) — periodically adjusted\"}
  :proc/fee-waiver \"installment payment of the fee (§1930 does not permit a full §1930(f) waiver for Chapter 13, unlike Chapter 7)\"
  :proc/timeline-rules
  [{:tl/label \"Plan confirmation + discharge\" :tl/rule \"after the §341 meeting, the court confirms a feasible plan meeting §1325's requirements; discharge follows completion of all plan payments (typically 3-5 years), broader than Chapter 7's discharge for some debt categories\"
    :tl/anchor \"11 U.S.C. §1301 et seq., §1325, §1328\" :tl/source-url \"https://www.uscourts.gov/forms-rules/current-rules-practice-procedure/federal-rules-bankruptcy-procedure\"}]
  :proc/options
  [{:opt/id :self-file :opt/kind :self-submit :opt/protective true
    :opt/label \"file pro se, propose a plan (Official Form 113 or local district form)\"}]
  :proc/refer-when [\"plan feasibility disputes\" \"secured-creditor cramdown questions\" \"co-debtor stay complications\"]
  :proc/verify-current-law true}

