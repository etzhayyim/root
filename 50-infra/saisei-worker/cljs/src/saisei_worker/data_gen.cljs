 {:proc/id \"proc:jp-jiko-hasan\" :proc/label \"自己破産 (self-bankruptcy petition)\"
  :proc/jurisdiction :jp :proc/track :self-filing
  :proc/forum \"地方裁判所 (破産部)\"
  :proc/official-forms-url \"https://www.courts.go.jp/saiban/syosiki/syosiki_hasan/hasan/index.html\"
  :proc/eligibility-signals
  [\"支払不能 (支払能力を欠くため弁済期にある債務を一般的継続的に弁済できない状態、破産法2条11項) — 債務超過とは別概念\"
   \"免責不許可事由 (破産法252条1項各号: 浪費・賭博等による著しい財産減少、財産の隠匿・損壊、詐術による信用取引 等) に該当しないか要確認 — 該当しても裁量免責の余地あり(同条2項)\"]
  :proc/mandatory-preconditions []
  :proc/required-docs [\"破産手続開始・免責許可申立書\" \"債権者一覧表\" \"財産目録\" \"家計収支表\" \"陳述書\"]
  :proc/fee {:fee/label \"予納金\" :fee/note \"申立手数料 収入印紙1,000-1,500円 + 予納郵券。同時廃止事件の引継予納金は庁により目安1-3万円、管財事件は原則20万円以上(少額管財運用があれば庁により20万円程度に圧縮)\"}
  :proc/fee-waiver \"訴訟上の救助 (民事訴訟費用等に関する法律5条、破産法にも準用) / 法テラス民事法律扶助の立替制度\"
  :proc/timeline-rules
  [{:tl/label \"免責許可決定の確定\" :tl/rule \"破産手続廃止(同時廃止)または終結後、免責審尋を経て免責許可決定 → 確定により非免責債権(破産法253条1項各号: 租税・悪意による不法行為に基づく損害賠償・養育費 等)を除き債務が消滅\"
    :tl/anchor \"破産法248条以下・252条・253条\" :tl/source-url \"https://laws.e-gov.go.jp/law/416AC0000000075\"}]
  :proc/options
  [{:opt/id :self-file :opt/kind :self-submit :opt/protective true
    :opt/label \"地方裁判所に申立書一式を提出 (本人申立て可。書式は各庁の書式集を利用)\"}]
  :proc/refer-when [\"管財事件が見込まれる(相当額の財産・免責不許可事由あり)\" \"債権者が多数・複雑な権利関係\"]
  :proc/verify-current-law true}

