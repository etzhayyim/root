package etzhayyimcojp:svelte-adapter;

interface js-runtime {
    // JSコードとリクエストオブジェクト(JSON)を渡し、レスポンス(JSON)を受け取る
    evaluate: func(code: string, request-json: string) -> string;
}

world svelte-performer {
    // wasmCloud standard Go component imports (WASI + wasmCloud runtime)
    include wasmcloud:component-go/imports@0.1.0;

    // JS engine linked from external QuickJS/Boa component
    import js-runtime;

    // HTTP server entry point
    export wasi:http/incoming-handler@0.2.0;
}
