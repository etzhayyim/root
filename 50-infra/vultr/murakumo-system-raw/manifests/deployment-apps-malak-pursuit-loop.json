      "spec": {
        "containers": [
          {
            "command": [
              "python",
              "-m",
              "kotodama.malak.langgraph.pursuit_loop",
              "--case-id",
              "$(CASE_ID)",
              "--tick-interval",
              "$(TICK_INTERVAL)"
            ],
            "env": [
              {
                "name": "CASE_ID",
                "valueFrom": {
                  "configMapKeyRef": {
                    "key": "CASE_ID",
                    "name": "malak-pursuit-loop-config"
                  }
                }
              },
              {
                "name": "TICK_INTERVAL",
                "valueFrom": {
                  "configMapKeyRef": {
                    "key": "TICK_INTERVAL",
                    "name": "malak-pursuit-loop-config"
                  }
                }
              },
              {
                "name": "etzhayyim_LLM_URL",
                "valueFrom": {
                  "configMapKeyRef": {
                    "key": "etzhayyim_LLM_URL",
                    "name": "malak-pursuit-loop-config"
                  }
                }
              },
              {
                "name": "etzhayyim_LLM_MODEL",
                "valueFrom": {
                  "configMapKeyRef": {
                    "key": "etzhayyim_LLM_MODEL",
                    "name": "malak-pursuit-loop-config"
                  }
                }
              },
              {
                "name": "PURSUIT_DISABLE_LLM",
                "valueFrom": {
                  "configMapKeyRef": {
                    "key": "PURSUIT_DISABLE_LLM",
                    "name": "malak-pursuit-loop-config"
                  }
                }
              },
              {
                "name": "KOTOBA_URL",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "KOTOBA_URL",
                    "name": "malak-pursuit-loop-secrets"
                  }
                }
              },
              {
                "name": "etzhayyim_LLM_API_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "etzhayyim_LLM_API_KEY",
                    "name": "malak-pursuit-loop-secrets"
                  }
                }
              },
              {
                "name": "PYTHONUNBUFFERED",
                "value": "1"
              }
            ],
            "image": "ghcr.io/etzhayyim/malak-pursuit-loop:latest",
            "imagePullPolicy": "Always",
            "livenessProbe": {
              "exec": {
                "command": [
                  "python",
                  "-c",
                  "import os,psycopg; c=psycopg.connect(os.environ['KOTOBA_URL'], connect_timeout=5); c.close()"
                ]
              },
              "failureThreshold": 3,
              "initialDelaySeconds": 60,
              "periodSeconds": 120,
              "successThreshold": 1,
              "timeoutSeconds": 15
            },
            "name": "pursuit-loop",
            "resources": {
              "limits": {
                "cpu": "1",
                "memory": "512Mi"
