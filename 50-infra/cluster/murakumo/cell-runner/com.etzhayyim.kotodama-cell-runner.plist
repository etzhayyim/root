<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd template for kotodama-cell-runner on a Murakumo Mac mini.
  Per ADR-2605192415 §7.1 (Religious-Corp Daemon Architecture — Tier 1 launchd 常駐).

  This template carries placeholders that install.sh substitutes per host:
    @@NODE_NAME@@       — Murakumo tribe name (naphtali / simeon / judah / zebulun /
                          levi / joseph / issachar / dan / benjamin / asher)
    @@USERNAME@@        — macOS user that owns the LaunchAgent
    @@REPO_PATH@@       — Absolute path to the etzhayyim/root checkout on this mac
    @@UV_PATH@@         — Absolute path to the `uv` binary (e.g., /opt/homebrew/bin/uv)
    @@LOG_DIR@@         — Log directory (default /Users/@@USERNAME@@/.etzhayyim/log)
    @@PYTHONPATH@@      — Extra PYTHONPATH segments if any (default empty)

  EnvironmentVariables set:
    ETZHAYYIM_NODE      — legacy alias for @@NODE_NAME@@ (used by cell_runner_main.py start_cell)
    ETZHAYYIM_NODE_NAME — node name read by load_cell_registry / cells_for_node (cells.toml registry)

  Install / status / stop:
    ./install.sh --node <NODE_NAME>
    launchctl list | grep kotodama-cell-runner
    tail -f @@LOG_DIR@@/kotodama-cell-runner.{stdout,stderr}.log
    launchctl unload ~/Library/LaunchAgents/com.etzhayyim.kotodama-cell-runner.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.etzhayyim.kotodama-cell-runner</string>

  <key>ProgramArguments</key>
  <array>
    <string>@@UV_PATH@@</string>
    <string>run</string>
    <string>--project</string>
    <string>@@REPO_PATH@@/40-engine/kotoba/crates/kotoba-kotodama/py</string>
    <string>kotoba-kotodama-cell-runner</string>
    <string>--node</string>
    <string>@@NODE_NAME@@</string>
    <string>--log-level</string>
    <string>INFO</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>ETZHAYYIM_REPO</key>
    <string>@@REPO_PATH@@</string>
    <key>ETZHAYYIM_NODE</key>
    <string>@@NODE_NAME@@</string>
    <key>ETZHAYYIM_NODE_NAME</key>
    <string>@@NODE_NAME@@</string>
    <key>ETZHAYYIM_LOG_DIR</key>
    <string>@@LOG_DIR@@</string>
    <key>PYTHONPATH</key>
    <string>@@PYTHONPATH@@</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>@@REPO_PATH@@</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>NetworkState</key>
    <true/>
  </dict>

  <key>StandardOutPath</key>
  <string>@@LOG_DIR@@/kotodama-cell-runner.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>@@LOG_DIR@@/kotodama-cell-runner.stderr.log</string>

  <key>ThrottleInterval</key>
  <integer>15</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>Nice</key>
  <integer>5</integer>
</dict>
</plist>
