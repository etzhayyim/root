---
# lg-ses-secrets — copy to secret.yaml, fill values, apply once:
#   kubectl apply -f secret.yaml -n mitama-udf
# DO NOT commit secret.yaml to git.
apiVersion: v1
kind: Secret
metadata:
  name: lg-ses-secrets
  namespace: mitama-udf
type: Opaque
stringData:
  # RisingWave PG :4566 root role URL
  RW_URL: "REDACTED_USE_DATABASE_URL_ENV"
  # x-api-key for /runs and /cron/outlook-pull
  LG_SES_API_KEY: ""
  # Microsoft 365 app-only credentials (Mail.Read + Mail.ReadBasic)
  M365_TENANT_ID: ""
  M365_CLIENT_ID: ""
  M365_CLIENT_SECRET: ""
  # Mailbox UPN to poll for SES candidate emails
  SES_MAILBOX_UPN: "ses-inbox@etzhayyim.com"
  # AT Protocol identity for SES pipeline records
  SES_ACTOR_DID: "did:web:ses.etzhayyim.com"
  SES_ORG_DID: "did:erc725:etzhayyim:260425:etzhayyim-co-jp"
  # Optional LLM API key (murakumo / openrouter)
  Etzhayyim_LLM_API_KEY: ""
