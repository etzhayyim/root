---
# Template only — DO NOT COMMIT real values. Apply via:
#
#   kubectl -n mitama-udf create secret generic lg-yatabase-secrets \
#     --from-literal=RW_URL="$(security find-generic-password -s etzhayyim.rw -a ROOT_URL -w)" \
#     --from-literal=DISPATCHER_INTERNAL_SECRET="$(op item get '<secret name>' --fields label=credential)" \
#     --from-literal=LG_YATABASE_API_KEY="$(uuidgen)" \
#     --from-literal=OPENROUTER_API_KEY="$(op item get OPENROUTER_API_KEY --fields label=credential)" \
#     --from-literal=STRIPE_SECRET_KEY=""
#
# Rotation: re-run with --dry-run=client -o yaml | kubectl apply -f -
apiVersion: v1
kind: Secret
metadata:
  name: lg-yatabase-secrets
  namespace: mitama-udf
type: Opaque
stringData:
  RW_URL: "REDACTED_USE_DATABASE_URL_ENV"
  DISPATCHER_INTERNAL_SECRET: "CHANGE_ME"
  LG_YATABASE_API_KEY: "CHANGE_ME"
  OPENROUTER_API_KEY: "CHANGE_ME"
  STRIPE_SECRET_KEY: ""
