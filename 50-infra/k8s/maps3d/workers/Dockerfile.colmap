# colmap-worker image. Adds COLMAP CPU + Open3D + B2 SDK on top of the
# shared light image. CUDA stack omitted — CPU-only build, ~1.4 GB total.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# COLMAP via apt (Debian bookworm ships colmap 3.7 CPU-only).
# Plus the Open3D runtime deps (libgomp, libgl1) we'd otherwise hit
# with ImportError at first call.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates \
        colmap \
        libgomp1 \
        libgl1 \
        libxrender1 \
        libxext6 \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY . /app/workers
ENV PYTHONPATH=/app
ENV COLMAP_BIN=/usr/bin/colmap

CMD ["python", "-m", "workers.colmap_worker"]
