{:manifest {:version "1" :adr_refs ["2605192415 §7.1 (Tier 1 launchd 常駐)"]} :on_disk {:stdout_path_template "/Users/<tribe>/.etzhayyim/log/langserver.<lang>.stdout.log" :stderr_path_template "/Users/<tribe>/.etzhayyim/log/langserver.<lang>.stderr.log" :plist_keys_responsible ["StandardOutPath" "StandardErrorPath"] :format "LSP-native (rust-analyzer/pyright/etc. each have their own format)" :format_note "etzhayyim does not force JSON on third-party LSP servers; structured wrappers can re-emit in L9 cell"} :rotation {:mechanism "macOS newsyslog (system-provided)" :config_template "newsyslog.d/etzhayyim-langserver.conf" :config_install_path "/etc/newsyslog.d/etzhayyim-langserver.conf" :config_install_requires_sudo true :size_limit_mb 50 :keep_count 5 :mode "0640" :flags "Z"} :metrics {:endpoint_path "/metrics" :serve_via "healthz-sidecar.py (extended)" :format "Prometheus textfile (text/plain version=0.0.4)" :scrape_target_template "http://<mesh-ip>:<port_healthz>/metrics" :recommended_prometheus_job_name "etzhayyim_langserver" :existing_prometheus_endpoint "http://murakumo.etzhayyim.local:9090" :metrics_exposed ["etzhayyim_langserver_up{lang,host}" "etzhayyim_langserver_uptime_seconds{lang,host}" "etzhayyim_langserver_probe_latency_seconds{lang,host,probe='tcp'|'deep'}" "etzhayyim_langserver_probe_failures_total{lang,host}"]} :stream_nats {:enabled_default false :forwarder_script "scripts/ship-logs-to-nats.sh" :forwarder_mechanism "tail -F | nats pub (one subject per file per lang per host)" :subject_template "etzhayyim.langserver.<host>.<lang>.<stream>" :retention_policy_recommendation "Limits stream, 7d max-age, 1GiB max-bytes per subject" :substrate_constraint "Compute-time logs; NOT persistent state. Per [platform.substrate] this is allowed since it does not bypass MST/IPFS/L2 for state."}}
