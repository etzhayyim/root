{
  "//": "etzhayyim-langserver/editor-configs/zed/settings.partial.json",
  "//1": "Merge these keys into ~/.config/zed/settings.json. Zed overrides the bundled LSP binary path with `lsp.<server>.binary` — we point it at attach-langserver.sh which proxies stdio over socat to the fleet LSP. Replace /path/to/etzhayyim/root with your actual checkout.",

  "lsp": {
    "rust-analyzer": {
      "binary": {
        "path": "/path/to/etzhayyim/root/50-infra/etzhayyim-langserver/scripts/attach-langserver.sh",
        "arguments": ["rust"]
      }
    },
    "pyright": {
      "binary": {
        "path": "/path/to/etzhayyim/root/50-infra/etzhayyim-langserver/scripts/attach-langserver.sh",
        "arguments": ["python"]
      }
    },
    "typescript-language-server": {
      "binary": {
        "path": "/path/to/etzhayyim/root/50-infra/etzhayyim-langserver/scripts/attach-langserver.sh",
        "arguments": ["typescript"]
      }
    },
    "gopls": {
      "binary": {
        "path": "/path/to/etzhayyim/root/50-infra/etzhayyim-langserver/scripts/attach-langserver.sh",
        "arguments": ["go"]
      }
    },
    "lua-language-server": {
      "binary": {
        "path": "/path/to/etzhayyim/root/50-infra/etzhayyim-langserver/scripts/attach-langserver.sh",
        "arguments": ["lua"]
      }
    },
    "ruby-lsp": {
      "binary": {
        "path": "/path/to/etzhayyim/root/50-infra/etzhayyim-langserver/scripts/attach-langserver.sh",
        "arguments": ["ruby"]
      }
    }
  }
}
