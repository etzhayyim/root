# etzhayyim-langserver/editor-configs/helix/languages.toml.partial
#
# Drop these blocks into your Helix `~/.config/helix/languages.toml`
# (Helix loads it on next launch).
#
# Mesh-IPs below are placeholders that get rewritten by
# scripts/generate-fleet-registry.sh + scripts/render-editor-configs.sh
# (the latter to be added if needed). Until then, you can either:
#   (a) hand-edit IPs from `cat scripts/lsp-fleet.json | jq`, or
#   (b) use the attach-langserver.sh shim, which resolves at invocation time
#       (no IP duplication in this file).
#
# Approach (b) is preferred — single source of truth in lsp-fleet.json.

# ── Language servers (using attach-langserver.sh) ────────────────────────

[language-server.etzhayyim-rust]
command = "/path/to/etzhayyim/root/50-infra/etzhayyim-langserver/scripts/attach-langserver.sh"
args = ["rust"]

[language-server.etzhayyim-python]
command = "/path/to/etzhayyim/root/50-infra/etzhayyim-langserver/scripts/attach-langserver.sh"
args = ["python"]

[language-server.etzhayyim-typescript]
command = "/path/to/etzhayyim/root/50-infra/etzhayyim-langserver/scripts/attach-langserver.sh"
args = ["typescript"]

[language-server.etzhayyim-go]
command = "/path/to/etzhayyim/root/50-infra/etzhayyim-langserver/scripts/attach-langserver.sh"
args = ["go"]

[language-server.etzhayyim-lua]
command = "/path/to/etzhayyim/root/50-infra/etzhayyim-langserver/scripts/attach-langserver.sh"
args = ["lua"]

[language-server.etzhayyim-ruby]
command = "/path/to/etzhayyim/root/50-infra/etzhayyim-langserver/scripts/attach-langserver.sh"
args = ["ruby"]

# ── Bind each language to the fleet server ───────────────────────────────

[[language]]
name = "rust"
language-servers = ["etzhayyim-rust"]

[[language]]
name = "python"
language-servers = ["etzhayyim-python"]

[[language]]
name = "typescript"
language-servers = ["etzhayyim-typescript"]

[[language]]
name = "tsx"
language-servers = ["etzhayyim-typescript"]

[[language]]
name = "javascript"
language-servers = ["etzhayyim-typescript"]

[[language]]
name = "go"
language-servers = ["etzhayyim-go"]

[[language]]
name = "lua"
language-servers = ["etzhayyim-lua"]

[[language]]
name = "ruby"
language-servers = ["etzhayyim-ruby"]
