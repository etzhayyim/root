{;; Independent etzhayyim atproto PDS — babashka runner (no external deps; uses
 ;; bb built-in org.httpkit.server / cheshire / babashka.http-client).
 :paths ["src" "test"]
 :tasks
 {serve
  {:doc "Run the PDS HTTP server (PORT, PDS_HOST, KOTOBA_URL env overridable)."
   :requires ([etzhayyim.pds.server :as server])
   :task (server/-main)}

  test
  {:doc "Run the PDS test suite (server + util + xrpc + datom + config + keys + actorkeys)."
   :requires ([clojure.test :as t] [etzhayyim.pds.server-test]
              [etzhayyim.pds.util-test] [etzhayyim.pds.xrpc-test]
              [etzhayyim.pds.datom-test] [etzhayyim.pds.config-test]
              [etzhayyim.pds.keys-test] [etzhayyim.pds.actorkeys-test]
              [etzhayyim.pds.client-test] [etzhayyim.pds.drain-test])
   :task (let [{:keys [fail error]} (t/run-tests 'etzhayyim.pds.server-test
                                                 'etzhayyim.pds.util-test
                                                 'etzhayyim.pds.xrpc-test
                                                 'etzhayyim.pds.datom-test
                                                 'etzhayyim.pds.config-test
                                                 'etzhayyim.pds.keys-test
                                                 'etzhayyim.pds.actorkeys-test
                                                 'etzhayyim.pds.client-test
                                                 'etzhayyim.pds.drain-test)]
           (System/exit (if (pos? (+ fail error)) 1 0)))}

  keys-test
  {:doc "Run the actor-sealed key invariants (etzhayyim.pds.keys)."
   :requires ([clojure.test :as t] [etzhayyim.pds.keys-test])
   :task (let [{:keys [fail error]} (t/run-tests 'etzhayyim.pds.keys-test)]
           (System/exit (if (pos? (+ fail error)) 1 0)))}

  drain
  {:doc "Drain an ibuki NDJSON post-queue to the PDS. Env: PDS_DRAIN_BASE (PDS url) +
         PDS_DRAIN_QUEUE (queue file) + optional PDS_DRAIN_CURSOR / PDS_DRAIN_RECEIPTS."
   :requires ([etzhayyim.pds.drain :as drain])
   :task (let [res (drain/run-file! {:base (System/getenv "PDS_DRAIN_BASE")
                                     :queue-path (System/getenv "PDS_DRAIN_QUEUE")
                                     :cursor-path (System/getenv "PDS_DRAIN_CURSOR")
                                     :receipts-path (System/getenv "PDS_DRAIN_RECEIPTS")})]
           (println (format "[drain] posted=%d errors=%d parse-errors=%d"
                            (count (:receipts res)) (count (:errors res))
                            (count (:parse-errors res)))))}

  drain-preview
  {:doc "Dry-run: show what `bb drain` WOULD post (PDS_DRAIN_QUEUE) — no posting, no key."
   :requires ([clojure.java.io :as io] [etzhayyim.pds.drain :as drain])
   :task (let [pv (drain/preview (slurp (System/getenv "PDS_DRAIN_QUEUE")))]
           (println (format "[drain-preview] would-post=%d parse-errors=%d actors=%d"
                            (count (:would-post pv)) (count (:parse-errors pv))
                            (count (:by-actor pv))))
           (doseq [w (:would-post pv)]
             (println "  " (:repo w) (:collection w) "rkey=" (:rkey w))))}}}
