# etzhayyim chain-contracts deploy — operator env
#
# Copy to .env (gitignored) and fill in. Loaded by foundry.toml via
# ${VAR} syntax. NEVER commit .env. All values are loaded into
# process env when forge invokes scripts; broadcast keys are spent
# at tx time.
#
# Per ADR-2605192415 §10 S2 testnet deploy + RUNBOOK §"Religious-Corp
# Wave Deploy".

# ─── Base network RPCs ──────────────────────────────────────────────
# Public endpoints work but rate-limited. For production use Alchemy /
# Infura / CDP / QuickNode with API key.
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ─── geth-private internal chain (chainId 2605) ─────────────────────
# Provided by founder-operated validator set per ADR-2605191346.
# Format: http(s)://geth.etzhayyim.com or http://<validator-ip>:8545
ETZHAYYIM_PRIVATE_RPC=

# ─── Deploy key ──────────────────────────────────────────────────────
# The deployer's private key. NEVER commit. For Anvil smoke tests use:
#   0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# For Base Sepolia / mainnet use a hardware-wallet-derived key or a
# secret-manager (1Password / AWS KMS / GCP Secret Manager) value.
PRIVATE_KEY=

# ─── Block explorer keys (optional, for --verify) ────────────────────
BASESCAN_KEY=

# ─── Religious-corp wave deploy inputs ──────────────────────────────
# Required by `forge script DeployReligiousCorp.s.sol --sig run(...)`.

# USDC contract address.
#   Base mainnet : 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913 (Coinbase Bridged USDC)
#   Base Sepolia : 0x036CbD53842c5426634e7929541eC2318f3dCF7e (Circle native USDC)
#   Local Anvil  : deploy MockUsdc via `forge script script/MockUsdc.sol` or use any 0x address
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Public Fund Safe (Gnosis Safe 5-of-7 on Base).
# Deploy via https://app.safe.global/ FIRST, record the resulting address here.
# See 50-infra/etzhayyim-chain-contracts/DEPLOY-CHECKLIST.md §2 for the
# Safe deploy procedure + signer selection criteria.
PUBLIC_FUND_SAFE_ADDRESS=

# Initial officers (founder + co-founders) — comma-separated, parsed as
# Solidity address[] by --sig arg. Min length 1.
INITIAL_OFFICERS=

# Bootstrap Council 5 seats — comma-separated 0x-prefixed addresses.
# MUST be exactly 5 entries. Selected post-2026-06-19 from public RFP
# (see COUNCIL-BOOTSTRAP-RFP.md). Seat ordering:
#   1 = Founder
#   2 = Substrate / Technology
#   3 = Legal / Ethics
#   4 = Economics
#   5 = Stewardship / Land
BOOTSTRAP_COUNCIL=

# ─── Religious-corp wave: deployed addresses (set after deploy) ──────
# Populate AFTER first deploy for downstream tooling (Pregel cells,
# kotodama-cell-runner, AppView lookups). Re-deploy = re-populate.
CONSTITUTION_ADDRESS=
ADHERENT_REGISTRY_ADDRESS=
CHARTERS_COMPLIANCE_REGISTRY_ADDRESS=
TITHE_ROUTER_ADDRESS=
LAND_REGISTRY_ADDRESS=

# ─── etzhayyim-paymaster ERC-4337 paymaster ──────────────────────────
# Per ADR-2605172100. Funded by anchor-batch fee skim.
PAYMASTER_ADDRESS=

# ─── Operator preferences ────────────────────────────────────────────
DEPLOY_DRY_RUN_FIRST=true   # set false to skip --simulate-only safety check
