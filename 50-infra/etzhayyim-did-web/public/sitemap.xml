<?xml version="1.0" encoding="UTF-8"?>
<!--
  etzhayyim.com sitemap index.
  Fixed 2026-07-21: this file (and the two it references) previously served
  YORO's (a retired etzhayyim sub-app, now redirected to aozora.app) leftover
  static assets instead of etzhayyim.com's own content, because no local route
  or ./public file matched /sitemap.xml, /sitemaps/static.xml, or
  /sitemaps/actors/index.xml — so every request fell through this Worker's
  catch-all reverse-proxy to the retired YORO service binding.
  See src/worker.ts's tsFetch tail comment ("All other paths — reverse-proxy
  to the yoro Worker") for the fallback this file now short-circuits.
-->
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <sitemap><loc>https://etzhayyim.com/sitemaps/static.xml</loc></sitemap>
  <sitemap><loc>https://etzhayyim.com/sitemaps/actors/index.xml</loc></sitemap>
</sitemapindex>
