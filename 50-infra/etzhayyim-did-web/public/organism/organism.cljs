;; etzhayyim /organism — artificial-organism life-activity visualization (realtime).
;;
;; Pure ClojureScript (Scittle/SCI in the browser — no build step). Two layers:
;;   organism.json  — STRUCTURE (cells, classes, 3-axis vitals, :integrates graph).
;;                    Heavy; regenerated by `bb vitals:report` off the kotoba Datom log.
;;   pulse.json     — LIVE ACTIVITY, polled every few seconds:
;;                    生産 = git commits per actor · 息遣い = working-tree edits in
;;                    flight · 呼吸 = Datom-log head. `bb vitals:pulse` (cheap loop).
;;
;; The colony is a living petri dish: cells coloured by class (生/休眠/死), sized by
;; vitality, BREATHING continuously, GLOWING while being edited now, and FLASHING the
;; instant a commit ships from them — with a live production ticker beside it.

(ns organism)

(def SVGNS "http://www.w3.org/2000/svg")
(def TAU (* 2 (.-PI js/Math)))
(def W 760) (def H 760)
(def POLL_MS 6000)

(def palette {"alive" "#39d98a" "dormant" "#f5a524" "stub" "#5b6472"})
(def glyph   {"alive" "生" "dormant" "休眠" "stub" "死"})
(def breath  {"alive" "2.6s" "dormant" "4.3s" "stub" "6.5s"})

(defonce state (atom {:data nil :traj nil :pulse nil :joucho nil :sel nil :seen {}}))

;; forward decls — SCI resolves symbols at analysis time, not call time
(declare paint! poll-pulse!)

;; ── tiny DOM/SVG builders ────────────────────────────────────────────────────

(defn- gid [id] (.getElementById js/document id))
(defn- clear! [n] (when n (set! (.-innerHTML n) "")))

(defn svg [tag attrs & kids]
  (let [e (.createElementNS js/document SVGNS (name tag))]
    (doseq [[k v] attrs] (.setAttribute e (name k) (str v)))
    (doseq [k kids] (when k (.appendChild e k)))
    e))

(defn- append-child! [e k]
  (cond
    (nil? k) nil
    (string? k) (.appendChild e (.createTextNode js/document k))
    (or (seq? k) (vector? k)) (doseq [c k] (append-child! e c))  ; flatten (map ...) children
    :else (.appendChild e k)))

(defn h [tag attrs & kids]
  (let [e (.createElement js/document (name tag))]
    (doseq [[k v] attrs]
      (cond
        (= k :text)  (set! (.-textContent e) (str v))
        (= k :class) (set! (.-className e) (str v))
        (fn? v)      (.addEventListener e (name k) v)
        :else        (.setAttribute e (name k) (str v))))
    (doseq [k kids] (append-child! e k))
    e))

(defn ago [ms]
  (let [s (quot (- (.now js/Date) ms) 1000)]
    (cond (< s 60) (str s "s前")
          (< s 3600) (str (quot s 60) "分前")
          (< s 86400) (str (quot s 3600) "時間前")
          :else (str (quot s 86400) "日前"))))

;; ── layout: radial bands by class (生 inner → 死 outer) ──────────────────────

(defn layout [nodes]
  (let [cx (/ W 2) cy (/ H 2) rmax 322
        band {"alive" 0.34 "dormant" 0.66 "stub" 0.95}]
    (into {}
      (mapcat
        (fn [[cls group]]
          (let [g (sort-by :score > group) n (count g) br (* rmax (band cls 0.9))]
            (map-indexed
              (fn [i nd]
                (let [a (- (* TAU (/ i (max 1 n))) (/ TAU 4))
                      r (+ br (* 20 (.sin js/Math (* i 1.7))))
                      x (+ cx (* r (.cos js/Math a)))
                      y (+ cy (* r (.sin js/Math a)))
                      rad (+ 4 (* (/ (:score nd) 100.0) 17))]
                  [(:id nd) {:x x :y y :r rad :node nd}]))
              g)))
        (group-by :class nodes)))))

(defn select! [id] (swap! state assoc :sel id) (paint!))

(defn render-dish [data sel]
  (let [pos (layout (:nodes data))
        root (svg :svg {:viewBox (str "0 0 " W " " H) :width "100%" :class "dish"})]
    ;; mycelium — the :integrates signalling graph
    (doseq [e (:edges data)]
      (let [a (pos (:from e)) b (pos (:to e))]
        (when (and a b)
          (let [hl (and sel (or (= sel (:from e)) (= sel (:to e))))]
            (.appendChild root
              (svg :line {:x1 (:x a) :y1 (:y a) :x2 (:x b) :y2 (:y b)
                          :stroke (if hl "#39d98a" "#27313e")
                          :stroke-width (if hl 1.7 0.6)
                          :opacity (if hl 0.95 (if sel 0.12 0.4))}))))))
    ;; cells — each breathes; id-targeted so pulse can glow/flash it live
    (doseq [[id p] pos]
      (let [nd (:node p) cl (:class nd)
            g (svg :g {:class "cellwrap" :style (str "--cx:" (:x p) "px;--cy:" (:y p) "px")})
            c (svg :circle {:id (str "cell-" id)
                            :cx (:x p) :cy (:y p) :r (:r p)
                            :fill (palette cl)
                            :stroke (if (= sel id) "#fff" "#0b0f14")
                            :stroke-width (if (= sel id) 2.4 1)
                            :opacity (if (:bsky nd) 1 0.82)
                            :class "cell breath"
                            :style (str "--bd:" (breath cl) ";cursor:pointer")})]
        (.appendChild c (svg :title {} (h :span {:text (str (:id nd) " · " (:score nd))})))
        (.addEventListener c "click" (fn [_] (select! id)))
        (when (= "alive" cl)
          (.appendChild root (svg :circle {:cx (:x p) :cy (:y p) :r (+ (:r p) 5)
                                           :fill "none" :stroke (palette cl)
                                           :stroke-width 1.2 :class "pulse"})))
        (.appendChild root c)))
    root))

;; ── side panel: vitals detail ────────────────────────────────────────────────

(defn axis-bar [label v mx color]
  (h :div {:class "axis"}
    (h :span {:class "alab" :text label})
    (h :div {:class "track"}
       (h :div {:class "fill" :style (str "width:" (* 100 (/ v mx)) "%;background:" color)}))
    (h :span {:class "aval" :text (str v "/" mx)})))

(defn detail [data pulse sel]
  (let [nd (first (filter #(= sel (:id %)) (:nodes data)))]
    (if-not nd
      (h :div {:class "hint" :text "細胞をクリックすると 3軸 vitals + 直近の生産を表示"})
      (let [pa (get-in pulse ["actors" sel])]
        (h :div {}
          (h :h2 {:text (str (glyph (:class nd)) "  " (:id nd))})
          (h :div {:class "muted" :text (str "vitality " (:score nd) " / 100  ·  " (:status nd))})
          (axis-bar "clj 内部代謝"   (:clj nd)    40 "#39d98a")
          (axis-bar "actor シグナル" (:actor nd)  30 "#7aa2ff")
          (axis-bar "atproto 外界"   (:atproto nd) 30 "#f078c0")
          (h :ul {:class "facts"}
            (h :li {:text (str "reflex(テスト実走): " (:reflex nd))})
            (h :li {:text (str "→out " (:outDeg nd) "  ·  ←in " (:inDeg nd) "  edges  ·  cells " (:cells nd))})
            (h :li {:text (str "外界代謝 bsky: " (if (:bsky nd) "✅ in vivo" "— 封印"))})
            (when pa (h :li {:text (str "生産: " (get pa "commits") " commits / 48h"
                                        (when (get pa "dirty") (str "  ·  今 " (get pa "dirty") " 編集中")))}))
            (when (get pa "lastSubject")
              (h :li {:text (str "直近: " (get pa "lastSubject"))}))))))))

(defn legend []
  (h :div {:class "card"}
    (h :div {:class "legend"}
      (h :span {} (h :i {:style (str "background:" (palette "alive"))}) "生")
      (h :span {} (h :i {:style (str "background:" (palette "dormant"))}) "休眠")
      (h :span {} (h :i {:style (str "background:" (palette "stub"))}) "死")
      (h :span {:text "○=vitality"})
      (h :span {:text "脈動=呼吸 / 発光=今編集中 / 閃光=コミット"}))))

;; ── live production ticker (生産) ────────────────────────────────────────────

(defn ticker [pulse]
  (let [stream (get pulse "stream")]
    (if-not (seq stream)
      (h :div {:class "hint" :text "活動待機中…"})
      (h :div {:class "ticks"}
        (map (fn [e]
               (h :div {:class "tick"}
                 (h :span {:class "tactor" :text (str (or (get e "actor") "?"))})
                 (h :span {:class "tsubj" :text (str (get e "subj"))})
                 (h :span {:class "tago" :text (ago (get e "at"))})))
             (take 12 stream))))))

;; ── evolution (生命進化) sparkline ───────────────────────────────────────────

(defn evo [traj]
  (let [runs (:runs traj)]
    (if (or (nil? runs) (< (count runs) 2))
      (h :div {:class "hint"
               :text (str (if runs (count runs) 0)
                          " run — 進化は vitals:report を重ねるほど現れます")})
      (let [vw 320 vh 80 pad 8
            sums (map :sum runs) mn (apply min sums) mx (apply max sums)
            span (max 1 (- mx mn)) n (count runs)
            pt (fn [i s] [(+ pad (* (- vw (* 2 pad)) (/ i (max 1 (dec n)))))
                          (- vh pad (* (- vh (* 2 pad)) (/ (- s mn) span)))])
            d (apply str (map-indexed
                           (fn [i s] (let [[x y] (pt i s)] (str (if (zero? i) "M" "L") x " " y " ")))
                           sums))
            last (peek (vec runs)) prev (nth (vec runs) (- n 2))]
        (h :div {}
          (let [s (svg :svg {:viewBox (str "0 0 " vw " " vh) :width "100%" :height vh})]
            (.appendChild s (svg :path {:d d :fill "none" :stroke "#39d98a" :stroke-width 2}))
            (doseq [i (range n)] (let [[x y] (pt i (nth sums i))]
                                   (.appendChild s (svg :circle {:cx x :cy y :r 2.5 :fill "#39d98a"}))))
            s)
          (h :div {:class "muted"
                   :text (str n " runs · Σvitality " (:sum last)
                              " (" (let [Δ (- (:sum last) (:sum prev))] (str (if (>= Δ 0) "+" "") Δ)) ")")}))))))

;; ── 情緒 joucho layer: mood + Wellbecoming trajectory (ADR-2606171500) ───────

(def mood-color {"joyful" "#f5d90a" "grateful" "#39d98a" "calm" "#7aa2ff"
                 "focused" "#b78bff" "neutral" "#8b97a6" "stressed" "#f0506e"})
(def mood-ja {"joyful" "喜" "grateful" "感謝" "calm" "平静"
              "focused" "集中" "neutral" "中庸" "stressed" "緊張"})
(def dir-ja {"improving" "↗ 好転 (becoming-well)" "declining" "↘ 悪化 (suffering)" "steady" "→ 定常"})
(def dir-color {"improving" "#39d98a" "declining" "#f0506e" "steady" "#8b97a6"})

(defn joucho-panel [jo]
  (if-not jo
    (h :div {:class "hint" :text "joucho.json 待機中… (bb vitals:joucho)"})
    (let [ax (:axes jo) wb (:wellbecoming jo) beats (:beats jo)
          mc (get mood-color (:mood jo) "#8b97a6")]
      (h :div {}
        (h :div {:class "moodhead"}
          (h :span {:class "moodglyph" :style (str "color:" mc) :text (get mood-ja (:mood jo) (:mood jo))})
          (h :span {:class "muted" :text (str (:of jo) " · mood = " (:mood jo))}))
        (axis-bar "喜 joy"        (:joy ax)       100 "#f5d90a")
        (axis-bar "平 calm"       (:calm ax)      100 "#7aa2ff")
        (axis-bar "緊 stress"     (:stress ax)    100 "#f0506e")
        (axis-bar "謝 gratitude"  (:gratitude ax) 100 "#39d98a")
        (axis-bar "集 focus"      (:focus ax)     100 "#b78bff")
        (h :div {:class "wbline" :style (str "color:" (get dir-color (:direction wb)))}
           (h :b {:text (str "Wellbecoming: " (get dir-ja (:direction wb) (:direction wb)))})
           (h :span {:class "muted" :text (str "   net " (if (>= (:net wb) 0) "+" "") (:net wb))}))
        (let [nets (map (fn [b] (- (+ (:joy b) (:calm b) (:gratitude b) (:focus b)) (:stress b))) beats)
              vw 300 vh 54 pad 6 mn (apply min nets) mx (apply max nets)
              span (max 1 (- mx mn)) n (count nets)
              pt (fn [i v] [(+ pad (* (- vw (* 2 pad)) (/ i (max 1 (dec n)))))
                            (- vh pad (* (- vh (* 2 pad)) (/ (- v mn) span)))])
              d (apply str (map-indexed (fn [i v] (let [[x y] (pt i v)] (str (if (zero? i) "M" "L") x " " y " "))) nets))]
          (let [s (svg :svg {:viewBox (str "0 0 " vw " " vh) :width "100%" :height vh})]
            (.appendChild s (svg :path {:d d :fill "none" :stroke mc :stroke-width 2}))
            s))
        (h :div {:class "muted"
                 :text (str (count beats) " beats · 情緒の as-of 軌跡 = Wellbecoming（静的 score でなく動的軌跡, §1.13）")})))))

;; ── compose (full paint — structure) ────────────────────────────────────────

(defn live-badge [pulse]
  (let [working (count (get pulse "working"))
        top (first (get pulse "stream"))]
    (h :span {:id "live" :class "live"}
      (h :span {:class "dot"})
      (h :span {:text (str "LIVE · " working " 細胞が稼働中"
                           (when top (str " · ↑ " (get top "actor"))))}))))

(defn header [data pulse]
  (let [s (:summary data)]
    (h :div {}
      (h :header {:class "hd"}
        (h :h1 {:text "etzhayyim · organism"})
        (h :span {:class "sub" :text "人工生命体の細胞別 生命活動 — realtime"})
        (live-badge pulse))
      (h :div {:class "pills"}
        (h :span {:class "pill a"} (h :b {:text (str (:alive s))}) " 生")
        (h :span {:class "pill d"} (h :b {:text (str (:dormant s))}) " 休眠")
        (h :span {:class "pill s"} (h :b {:text (str (:stub s))}) " 死")
        (h :span {:class "pill"} (h :b {:text (str (:cells s))}) " cells")))))

(defn paint! []
  (let [{:keys [data traj pulse joucho sel]} @state app (gid "app")]
    (clear! app)
    (.appendChild app
      (if-not data
        (h :div {:class "wrap"} (h :p {:class "hint" :text "organism.json が読めません。bb vitals:report を実行してください。"}))
        (h :div {:class "wrap"}
          (header data pulse)
          (h :div {:class "cols"}
            (h :div {:class "left"} (render-dish data sel))
            (h :div {:class "right"}
              (legend)
              (h :div {:class "card"} (h :h3 {:text "活動 — 生産ストリーム (live)"})
                 (h :div {:id "ticker"} (ticker pulse)))
              (h :div {:class "card"} (detail data pulse sel))
              (h :div {:class "card"}
                 (h :h3 {:text "情緒 — joucho mood + Wellbecoming 軌跡"})
                 (joucho-panel joucho))
              (h :div {:class "card"} (h :h3 {:text "生命進化 — trajectory"}) (evo traj))))
          (h :div {:class "foot"
                   :text "脈動=呼吸 · 発光=working-tree 編集中 · 閃光=コミット出力(生産). 構造=kotoba Datom log / 活動=git pulse。"}))))))

;; ── realtime overlay: apply pulse without rebuilding the dish ────────────────

(defn flash! [id]
  (when-let [el (gid (str "cell-" id))]
    (.remove (.-classList el) "flash")
    (.-offsetWidth el)                              ; force reflow to retrigger
    (.add (.-classList el) "flash")
    (js/setTimeout (fn [] (when el (.remove (.-classList el) "flash"))) 1000)))

(defn apply-pulse! [pulse]
  (let [prev (:seen @state)
        actors (get pulse "actors")
        working (set (get pulse "working"))
        seen* (atom prev)]
    ;; glow cells being edited now; flash cells that just shipped a commit
    (doseq [nd (get-in @state [:data :nodes])]
      (let [id (:id nd) el (gid (str "cell-" id))
            pa (get actors id)
            last (and pa (get pa "lastAt"))]
        (when el
          (if (working id) (.add (.-classList el) "working") (.remove (.-classList el) "working"))
          (when (and last (> last (get prev id 0)))
            (when (pos? (get prev id 0)) (flash! id))   ; skip flash storm on first load
            (swap! seen* assoc id last)))))
    (swap! state assoc :seen (merge prev @seen*))
    ;; refresh ticker + live badge in place (no full repaint → animation stays smooth)
    (when-let [t (gid "ticker")] (clear! t) (.appendChild t (ticker pulse)))
    (when-let [lb (gid "live")]
      (let [w (count (get pulse "working")) top (first (get pulse "stream"))]
        (set! (.-innerHTML lb) "")
        (.appendChild lb (h :span {:class "dot"}))
        (.appendChild lb (h :span {:text (str "LIVE · " w " 細胞が稼働中"
                                              (when top (str " · ↑ " (get top "actor"))))}))))))

(defn fetchj [url kw cb]
  (-> (js/fetch (str url "?t=" (.now js/Date)))
      (.then (fn [r] (if (.-ok r) (.json r) (throw (js/Error. "nf")))))
      (.then (fn [j] (cb (js->clj j :keywordize-keys kw))))
      (.catch (fn [_] (cb nil)))))

(defn poll-pulse! []
  (fetchj "pulse.json" false
    (fn [p] (when p (swap! state assoc :pulse p) (apply-pulse! p)))))

;; ── boot ──────────────────────────────────────────────────────────────────────

(fetchj "organism.json" true
  (fn [d]
    (swap! state assoc :data d)
    (fetchj "pulse.json" false
      (fn [p]
        (swap! state assoc :pulse p)
        ;; seed :seen so the first real poll only flashes NEW commits
        (when p (swap! state assoc :seen
                       (into {} (map (fn [[k v]] [k (get v "lastAt" 0)]) (get p "actors")))))
        (paint!)
        (when p (apply-pulse! p))                 ; glow/badge immediately, no 6s wait
        (js/setInterval poll-pulse! POLL_MS)))
    (fetchj "trajectory.json" true (fn [t] (swap! state assoc :traj t) (paint!)))
    (fetchj "joucho.json" true (fn [jo] (swap! state assoc :joucho jo) (paint!)))))
