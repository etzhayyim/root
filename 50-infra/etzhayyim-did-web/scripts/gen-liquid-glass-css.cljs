#!/usr/bin/env nbb
;; --- nbb shims (auto, ADR-2607173000) ---------------------------------
(def ^:private __fs (js/require "node:fs"))
(def ^:private __path (js/require "node:path"))
(def ^:private __cp (js/require "node:child_process"))
(def ^:private __os (js/require "node:os"))
(def ^:private __crypto (js/require "node:crypto"))
(defn- __sh [& args]
  (let [opts (when (map? (last args)) (last args))
        cmd (if opts (butlast args) args)
        r (.spawnSync __cp (first cmd) (to-array (rest cmd))
                      (clj->js (merge {:encoding "utf8"} (when opts {:cwd (:dir opts)}))))]
    {:exit (or (.-status r) 1) :out (or (.-stdout r) "") :err (or (.-stderr r) "")}))
(defn- __shell [& args]
  (let [opts (when (map? (first args)) (first args))
        cmd (if opts (rest args) args)
        r (.spawnSync __cp (first cmd) (to-array (rest cmd))
                      (clj->js (merge {:stdio "inherit" :encoding "utf8"}
                                      (when opts {:cwd (:dir opts)}))))]
    (when-not (zero? (or (.-status r) 1))
      (throw (js/Error. (str "shell failed: " (pr-str cmd)))))
    {:exit (or (.-status r) 0) :out "" :err ""}))
;; -----------------------------------------------------------------------
;; Regenerate public/_shell/liquid-glass.css from kotoba-lang/liquid-glass-ui.
;;
;; liquid-glass.css is the kotoba-lang/liquid-glass-ui material served same-origin
;; at /_shell/liquid-glass.css: Tier A :root token vars (+ prefers-color-scheme dark
;; override) + Tier B liquid-glass__* component rules (blur/saturate/tint/specular
;; rim/elevation/motion), built from css.core EDN rule data — NOT hand-typed CSS.
;; The committed file is the artifact; this script regenerates it when the lib
;; changes so the lib pin stays the single source of truth.
;;
;; Run from anywhere inside the com-junkawasaki superproject (it walks up to find
;; orgs/kotoba-lang/liquid-glass-ui). Override with LIQUID_GLASS_UI=/path. Needs
;; the `clojure` CLI on PATH (the lib's :local alias resolves shitsuke + css).
;;
;;   nbb scripts/gen-liquid-glass-css.bb
;;
;; ADR: etzhayyim-did-web liquid-glass skin (kotoba-lang/liquid-glass-ui adoption).
(ns etzhayyim-did-web.gen-liquid-glass-css
  (:require                         [clojure.string :as str]))

(def header
  (str/join
   "\n"
   ["/* liquid-glass.css — kotoba-lang/liquid-glass-ui material (tokens + component CSS)."
    " * GENERATED by scripts/gen-liquid-glass-css.nbb — do not hand-edit (regen instead)."
    " * Source: orgs/kotoba-lang/liquid-glass-ui (liquid-glass.style/root-css +"
    " * component-css, built from css.core EDN rule data, not hand-typed CSS)."
    " * Tier A :root token vars + prefers-color-scheme dark override; Tier B"
    " * liquid-glass__* rules (blur/saturate/tint/specular rim/elevation/motion)"
    " * + @supports fallbacks + prefers-reduced-motion guard."
    " * Served same-origin at /_shell/liquid-glass.css (style-src 'self')."
    " */"]))

;; Run this script from the etzhayyim-did-web dir (the CWD). did-web-dir = CWD;
;; lib-dir walks up from CWD to find orgs/kotoba-lang/liquid-glass-ui.
(defn did-web-dir []
  (fs/file (System/getProperty "user.dir")))

(defn lib-dir []
  (or (some-> (aget (.-env js/process) "LIQUID_GLASS_UI") not-empty fs/file)
      (let [candidates
            (->> (take-while some? (iterate fs/parent (did-web-dir)))
                 (take 12)
                 (map #(fs/file % "orgs" "kotoba-lang" "liquid-glass-ui"))
                 (filter fs/exists?))]
        (or (first candidates)
            (throw (ex-info "liquid-glass-ui checkout not found under superproject; set LIQUID_GLASS_UI"
                            {}))))))

(defn generate! []
  (let [lib (lib-dir)
        out (fs/file (did-web-dir) "public" "_shell" "liquid-glass.css")
        expr "(require '[liquid-glass.style :as s]) (print (str (s/root-css) \"\\n\\n\" (s/component-css)))"
        res (p/shell {:dir (str lib) :out :string :err :string}
                     "clojure -M:local -e" expr)]
    (when-not (zero? (:exit res))
      (binding [*out* *err*] (println "clojure failed:" (:err res)))
      (.exit js/process (:exit res)))
    (fs/create-dirs (fs/parent out))
    (spit (str out) (str header "\n" (:out res)))
    (printf "Wrote %s (%d bytes) from %s\n" (str out) (count (:out res)) (str lib))))

(when (= *file* *file*)
  (generate!))
