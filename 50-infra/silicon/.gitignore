# Open-source EDA sim artifacts (Verilator + cocotb). Per ADR-2605242500 the
# committed flow is yosys + Verilator + cocotb; build products are not tracked.
.venv-sim/
sim_build/
results.xml
*.fst
*.vcd
dump.fst
__pycache__/
*.pyc

# Synthesis outputs (regenerated by synth/run_synth*.sh).
synth/out/
synth/out-sky130/
# sky130 open PDK liberty (fetched on demand by run_synth_sky130.sh, ~12 MB).
synth/pdk/

# OpenLane P&R run artifacts (huge: GDS/DEF/LEF/logs). Regenerated by the flow.
# The committed design is config.json + src/ + the extracted metrics report.
pnr/*/runs/
pnr/*/src/

# PDK files are under NDA and must never be committed (CLAUDE.md rule 1).
pdk-*/
