# Per /CHARTER-RIDER.md v2.0
#
# Generic, technology-independent synthesis script template for the silicon
# tree. Driven by run_synth.sh, which substitutes @SOURCES@ / @TOP@ / @JSON@.
#
# Flow: read → coarse synth (flatten) → ABC map to a 2-input generic gate
# library → emit cell-count statistics as JSON. No PDK / liberty (open-source
# only, per ADR-2605242500 Decision 1 + 50-infra/silicon/CLAUDE.md rule 1).
# The gate set is technology-independent; absolute counts are a proxy, the
# ternary-vs-INT8 *ratio* is the validated figure.

read_verilog -sv @SOURCES@
synth -top @TOP@ -flatten
abc -g AND,NAND,OR,NOR,XOR,XNOR,ANDNOT,ORNOT,MUX,AOI3,OAI3,AOI4,OAI4
tee -o @JSON@ stat -json
