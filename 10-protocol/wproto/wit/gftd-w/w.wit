package gftd:w@0.1.0;

/// W Protocol core types.
/// Wire format: Component Model binary (wRPC standard).
/// Storage: CBOR (MDAG CAS). Federation: Lexicon JSON (derived).
interface types {
    enum encryption-state {
        plaintext,
        signal-1to1,
        signal-group,
        client-encrypted,
    }

    enum channel-kind {
        public,
        private,
        direct,
        group-dm,
        bot,
        a2a,
    }

    enum member-role { owner, admin, member }
    enum presence-status { online, away, dnd, offline }

    record w-envelope {
        id: string,
        kind: string,
        mdag-cid: string,
        at-uri: string,
        rkey: string,
        sender-did: string,
        org-id: string,
        channel-id: string,
        thread-id: string,
        reply-to: string,
        payload: list<u8>,
        content-type: string,
        encryption: encryption-state,
        causation-id: string,
        correlation-id: string,
        created-at: string,
    }

    record w-channel {
        channel-id: string,
        org-id: string,
        name: string,
        description: string,
        kind: channel-kind,
        encryption-mode: encryption-state,
        creator-did: string,
        member-count: s32,
        at-uri: string,
        mdag-root-cid: string,
        created-at: string,
    }

    record w-member {
        channel-id: string,
        did: string,
        role: member-role,
        joined-at: string,
    }

    record w-presence {
        did: string,
        status: presence-status,
        status-text: string,
        last-active: string,
    }

    record w-page {
        cursor: string,
        limit: s32,
    }

    record w-prekey-bundle {
        did: string,
        device-id: string,
        identity-key: list<u8>,
        signed-pre-key: list<u8>,
        signed-pre-key-sig: list<u8>,
        signed-pre-key-id: u32,
        one-time-pre-key: option<list<u8>>,
        one-time-pre-key-id: u32,
    }

    record w-sync-state {
        channel-id: string,
        root-cid: string,
        version: u64,
        timestamp-ns: s64,
    }

    record w-diff {
        added-envelope-cids: list<string>,
        removed-envelope-cids: list<string>,
        added-member-cids: list<string>,
        removed-member-cids: list<string>,
        added-kinds: list<string>,
        removed-kinds: list<string>,
        channel-changed: bool,
    }
}

/// W Protocol command — mutations.
/// wRPC instance: "gftd:w/w-command"
interface w-command {
    use types.{
        w-envelope, w-channel, w-member,
        channel-kind, encryption-state,
        member-role, presence-status,
        w-prekey-bundle,
    };

    send: func(
        channel-id: string,
        kind: string,
        payload: list<u8>,
        content-type: string,
        reply-to: option<string>,
        thread-id: option<string>,
    ) -> result<w-envelope, string>;

    edit: func(
        channel-id: string,
        rkey: string,
        payload: list<u8>,
        content-type: string,
    ) -> result<w-envelope, string>;

    redact: func(channel-id: string, rkey: string, reason: string) -> result<_, string>;
    react: func(channel-id: string, target-rkey: string, emoji: string) -> result<_, string>;
    unreact: func(channel-id: string, target-rkey: string, emoji: string) -> result<_, string>;
    mark-read: func(channel-id: string, last-rkey: string) -> result<_, string>;

    create-channel: func(
        name: string,
        description: string,
        kind: channel-kind,
        invite-dids: list<string>,
    ) -> result<w-channel, string>;

    update-channel: func(
        channel-id: string,
        name: option<string>,
        description: option<string>,
    ) -> result<w-channel, string>;

    archive-channel: func(channel-id: string) -> result<_, string>;
    join-channel: func(channel-id: string) -> result<w-member, string>;
    leave-channel: func(channel-id: string) -> result<_, string>;
    invite-member: func(channel-id: string, invite-did: string) -> result<w-member, string>;
    update-member-role: func(channel-id: string, target-did: string, role: member-role) -> result<w-member, string>;

    create-dm: func(
        peer-did: string,
        kind: string,
        payload: list<u8>,
        content-type: string,
    ) -> result<tuple<w-channel, w-envelope>, string>;

    update-presence: func(status: presence-status, status-text: string) -> result<_, string>;
    register-prekeys: func(bundle: w-prekey-bundle) -> result<_, string>;
    replenish-otpks: func(device-id: string, keys: list<list<u8>>, key-ids: list<u32>) -> result<s32, string>;
    rotate-group-key: func(channel-id: string) -> result<_, string>;
}

/// W Protocol query — reads.
/// wRPC instance: "gftd:w/w-query"
interface w-query {
    use types.{
        w-envelope, w-channel, w-member, w-presence,
        w-prekey-bundle, w-page, w-sync-state, w-diff,
        channel-kind,
    };

    list-channels: func(filter-kind: option<channel-kind>, page: option<w-page>) -> result<list<w-channel>, string>;
    get-channel: func(channel-id: string) -> result<w-channel, string>;

    list-envelopes: func(
        channel-id: string,
        page: option<w-page>,
        before-rkey: option<string>,
        after-rkey: option<string>,
    ) -> result<list<w-envelope>, string>;

    get-thread: func(channel-id: string, root-rkey: string) -> result<list<w-envelope>, string>;
    search: func(query: string, channel-id: option<string>, page: option<w-page>) -> result<list<w-envelope>, string>;
    list-members: func(channel-id: string) -> result<list<w-member>, string>;
    get-unread: func() -> result<list<tuple<string, s32>>, string>;
    get-prekey-bundle: func(target-did: string) -> result<w-prekey-bundle, string>;
    get-prekey-bundles: func(target-dids: list<string>) -> result<list<w-prekey-bundle>, string>;
    list-presence: func(dids: list<string>) -> result<list<w-presence>, string>;

    /// MDAG sync state.
    get-sync-state: func(channel-id: string) -> result<w-sync-state, string>;
    /// MDAG Merkle diff.
    diff: func(channel-id: string, old-root-cid: string, new-root-cid: string) -> result<w-diff, string>;
    /// Fetch MDAG CAS blocks by CID.
    fetch-blocks: func(cids: list<string>) -> result<list<list<u8>>, string>;
}

/// W Protocol federation — MDAG-based cross-instance sync.
/// wRPC instance: "gftd:w/w-federation"
interface w-federation {
    use types.{w-sync-state, w-diff};

    announce: func(states: list<w-sync-state>) -> result<_, string>;
    request-diff: func(peer-did: string, channel-id: string, local-root-cid: string) -> result<w-diff, string>;
    pull-blocks: func(peer-did: string, cids: list<string>) -> result<list<list<u8>>, string>;
    push-blocks: func(peer-did: string, blocks: list<list<u8>>) -> result<_, string>;
    sync-channel: func(peer-did: string, channel-id: string) -> result<w-sync-state, string>;
}

/// W Protocol handler — component export.
interface w-handler {
    use types.{w-envelope};

    handle: func(envelope: w-envelope) -> result<option<list<u8>>, string>;
}

/// W Protocol world — wRPC-native.
world w-protocol {
    import w-command;
    import w-query;
    import w-federation;

    export w-handler;
}
