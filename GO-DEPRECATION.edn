{:policy/id :etzhayyim.language/go-deprecation
 :policy/status :accepted
 :policy/effective-date "2026-07-17"
 :policy/authority :canonical
 :language :go
 :lifecycle :deprecated
 :disposition :pruned
 :scope {:repository "etzhayyim/root"
