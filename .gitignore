# Lexicon + BPMN dirs named "coverage" are not test output — keep them tracked
# (mirrors etzhayyim-apps-etzhayyimcojp .gitignore exceptions; ADR-2605181400)
!00-contracts/lexicons/**/coverage/
!00-contracts/lexicons/**/coverage/**
!00-contracts/bpmn/**/coverage/
!00-contracts/bpmn/**/coverage/**

# Working
_working/
tmp/
.tmp/

# Daemon output — running etzhayyim-organism CNS daemon writes cycle
# observations here continuously. Per ADR-2605221411, observations are
# ephemeral runtime state, not source.
_observations/

# Agent scratch — root-level codegen / patch scripts produced by background
# agents during exploratory work. Promote to a real location if kept.
/active_patch.py
/apply_patches.py
/codegen.py
/codegen_substrate.py

# Foundry transient lockfile (held during `forge` invocations; persists if forge crashes)
foundry.lock

# npm auth (NEVER commit — GH Packages token)
.npmrc

# dataset substrate (ADR-2605241500): staging is machine-local.
# DataLad / git-annex objects live OUTSIDE the worktree
# (annex.objectdir → /Volumes/<vol>/etzhayyim/annex-store/), so no in-tree
# git-annex ignore patterns are needed.
**/datasets-staging/

# Claude Code agent worktrees (full repo copies for parallel agents — never commit)
.claude/worktrees/
.claude/scheduled_tasks.lock

# torch.utils.cpp_extension build dirs (kernel shootout, ADR-2605242000)
**/_build_cpu/

# Clojure tooling caches (classpath cache + claire agent worktree state) — never commit
.cpcache/
**/.cpcache/
.claire/

# ── Charter Rider §2(c) / ADR-2605192115 §1.2 — ad-tech-free build outputs ──
# Deploy-output snapshots (SvelteKit/Vite client builds) regenerated from source
# by the deploy pipeline. NOT committed: a bundled GA/gtag dependency would
# otherwise ship via stale committed builds. Source is GA-free. Untracked 2026-06-04.
60-apps/etzhayyim-project-email-service-adapter/appview/outlook-mcp-component/static-ui/
60-apps/etzhayyim-project-mailer/appview/mailer-mcp-component/static-ui/
60-apps/etzhayyim-project-yoro/appview/yoro-ui-g00h5zto/_svelte/
60-apps/etzhayyim-project-pachinko/wasm/pachinko-mcp-component/static/_app/

# kotoba is consumed as the external etzhayyim/kotoba repo (the in-tree submodule
# was removed, ADR-2606131645). CI/dev clone it into this path on demand.
40-engine/kotoba/

# matsurigoto tax-collect 一次資料は DataLad/git-annex の nested dataset (ADR-2605241500):
# bytes は annex→IPFS、monorepo git には catalog (80-data/matsurigoto-gensen-sources.md) のみ。
80-data/matsurigoto-gensen-sources/

# Council-authorised live-ingest DataLad datasets (data → DataLad/git-annex/IPFS, not git).
# Git-tracked pointer = 80-data/coverage-manifests/<name>-manifest.json (ADR-2605241500 + 2606111330).
/80-data/*-coverage/

# sops/age (ADR-2606241500): plaintext actor secrets are NEVER committed — only
# the sops *.enc.* ciphertext siblings are. The global `secrets/` rule above
# ignores the whole directory, and git cannot re-include a file whose PARENT dir
# is excluded — so re-include the directory FIRST, then re-ignore its contents,
# then re-include only the ciphertext (+ a .gitkeep).
!20-actors/*/secrets/
20-actors/*/secrets/*
!20-actors/*/secrets/*.enc.*
!20-actors/*/secrets/.gitkeep
20-actors/monosashi/data/*.datoms.kotoba.edn

# manimani personal-knowledge-router intake (ADR-2606302038 + 2605291100 §D5):
# PII tier-3 / confidential. This repo is PUBLIC, so the interim Phase-0 intake
# journals that hold real Gmail/PC correspondence (subjects, parties, legal/tax
# detail) are kept LOCAL and never committed — they are the plaintext hot tier
# that the eventual kotoba QuadStore + E2E Vault (CID-over-ciphertext, pinned to
# kotobase.net) replaces. Only the PII-free README pointer is tracked.
/80-data/manimani/*
!/80-data/manimani/README.md

# kotoba-genome W2 — organism learning runtime artifacts (local memory + projection;
# deployed from the working tree by the publish agent, not tracked). ADR-2606302205 D1.
80-data/organism/genome.state.edn
50-infra/etzhayyim-did-web/public/organism/genome.json
60-apps/etzhayyim-project-organism/public/genome.json

# kotoba-genome W4-live R0 — generated first-party observatory registry (reproducible via bb observatory:regen)
80-data/observatory/registry.r0.edn
