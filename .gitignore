# Lexicon + BPMN dirs named "coverage" are not test output — keep them tracked
# (mirrors etzhayyim-apps-etzhayyimcojp .gitignore exceptions; ADR-2605181400)
!00-contracts/lexicons/**/coverage/
!00-contracts/lexicons/**/coverage/**
!00-contracts/bpmn/**/coverage/
!00-contracts/bpmn/**/coverage/**

# Working
_working/
tmp/
.tmp/

# Daemon output — running etzhayyim-organism CNS daemon writes cycle
# observations here continuously. Per ADR-2605221411, observations are
# ephemeral runtime state, not source.
_observations/

# Agent scratch — root-level codegen / patch scripts produced by background
# agents during exploratory work. Promote to a real location if kept.
/active_patch.py
/apply_patches.py
/codegen.py
/codegen_substrate.py

# Foundry transient lockfile (held during `forge` invocations; persists if forge crashes)
foundry.lock

# npm auth (NEVER commit — GH Packages token)
.npmrc

# dataset substrate (ADR-2605241500): staging is machine-local.
# DataLad / git-annex objects live OUTSIDE the worktree
# (annex.objectdir → /Volumes/<vol>/etzhayyim/annex-store/), so no in-tree
# git-annex ignore patterns are needed.
**/datasets-staging/

# Claude Code agent worktrees (full repo copies for parallel agents — never commit)
.claude/worktrees/
.claude/scheduled_tasks.lock

# torch.utils.cpp_extension build dirs (kernel shootout, ADR-2605242000)
**/_build_cpu/

# Clojure tooling caches (classpath cache + claire agent worktree state) — never commit
.cpcache/
**/.cpcache/
.claire/

# ── Charter Rider §2(c) / ADR-2605192115 §1.2 — ad-tech-free build outputs ──
# Deploy-output snapshots (SvelteKit/Vite client builds) regenerated from source
# by the deploy pipeline. NOT committed: a bundled GA/gtag dependency would
# otherwise ship via stale committed builds. Source is GA-free. Untracked 2026-06-04.
60-apps/etzhayyim-project-email-service-adapter/appview/outlook-mcp-component/static-ui/
60-apps/etzhayyim-project-mailer/appview/mailer-mcp-component/static-ui/
60-apps/etzhayyim-project-yoro/appview/yoro-ui-g00h5zto/_svelte/
60-apps/etzhayyim-project-pachinko/wasm/pachinko-mcp-component/static/_app/
