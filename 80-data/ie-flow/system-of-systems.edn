   :telos "capital-flow observatory — map order, never trade"}
  {:actor "kaname"   :weights {:phi 0.20 :eta 0.30 :wellbecoming 0.20 :efficiency 0.22 :surprise 0.08}
   :telos "SoS leverage synthesizer — leverage per unit drawn (efficiency up)"}
  {:actor "okaimono" :weights {:phi 0.18 :eta 0.27 :wellbecoming 0.35 :efficiency 0.12 :surprise 0.08}
   :telos "provisioning commons — value returned to members (子孫 dominant)"}
  {:actor "repo-git" :weights {:phi 0.30 :eta 0.30 :wellbecoming 0.20 :efficiency 0.12 :surprise 0.08}
   :telos "the monorepo's own development metabolism (measured, not seeded)"}
  ;; ── wave 2 (loop iteration 1): mirrors/observatories η-dominant · care/commons 子孫-dominant ·
