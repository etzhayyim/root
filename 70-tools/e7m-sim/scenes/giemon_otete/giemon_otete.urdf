<?xml version="1.0"?>
<!-- GIEMON OTETE — 6-axis arm + 1-axis gripper (7 DOF), fixed-base sim spec.

     Articulation model of the Giemon Otete kit (open-robo BOM-v1.md). Link
     lengths + joint limits are taken from the kit's Modified-DH parameters in
     cad-spec/mechanical-spec-v1.md (d1=85, J2 d=120, J3 a=160, J4 a=40,
     J5 d=80, J6 d=30 mm; reach 420 mm). This is a simplified SERIAL URDF that
     preserves those link lengths + limits for a physics-faithful sim — it is
     not a full MDH frame transcription (the alpha twists are approximated by
     the z/y axis choices). Driven by the kami-genesis 3-D spatial solver
     (mixed z/y axes + prismatic gripper → Spatial3d). Effort limits map to the
     spec servos (J1/J2 KRS-6013IHV 35 kg·cm ≈ 3.4 N·m; J3/J4 KRS-4014ICS 20 ≈
     2.0; J5/J6 KRS-2350IHV 8 ≈ 0.8; gripper Futaba S3003). Clean-room
     (ADR-2605261800). Units m / kg / kg·m². Joint/link names are the binding
     targets for open-robo/bom/parts.edn (:part/sim-feature). -->
<robot name="giemon_otete">

  <link name="base_link">
    <inertial><origin xyz="0 0 0.02"/><mass value="1.0"/>
      <inertia ixx="0.003" iyy="0.003" izz="0.003" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- J1 turntable: d1 = 85 mm -->
  <joint name="j1" type="revolute">
    <parent link="base_link"/><child link="link1"/>
    <origin xyz="0 0 0.085"/><axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="3.4" velocity="3"/><dynamics damping="0.08"/>
  </joint>
  <link name="link1"><inertial><origin xyz="0 0 0.02"/><mass value="0.17"/>
    <inertia ixx="0.0012" iyy="0.0012" izz="0.0008" ixy="0" ixz="0" iyz="0"/></inertial></link>

  <!-- J2 shoulder pitch: -10°..+100° -->
  <joint name="j2" type="revolute">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0 0 0.02"/><axis xyz="0 1 0"/>
    <limit lower="-0.17" upper="1.75" effort="3.4" velocity="3"/><dynamics damping="0.10"/>
  </joint>
  <!-- shoulder link: d2 = 120 mm -->
  <link name="link2"><inertial><origin xyz="0 0 0.06"/><mass value="0.16"/>
    <inertia ixx="0.0030" iyy="0.0030" izz="0.0006" ixy="0" ixz="0" iyz="0"/></inertial></link>

  <!-- J3 elbow: -10°..+120° -->
  <joint name="j3" type="revolute">
    <parent link="link2"/><child link="link3"/>
    <origin xyz="0 0 0.12"/><axis xyz="0 1 0"/>
    <limit lower="-0.17" upper="2.09" effort="2.0" velocity="3"/><dynamics damping="0.06"/>
  </joint>
  <!-- forearm: a3 = 160 mm -->
  <link name="link3"><inertial><origin xyz="0 0 0.08"/><mass value="0.12"/>
    <inertia ixx="0.0016" iyy="0.0016" izz="0.0004" ixy="0" ixz="0" iyz="0"/></inertial></link>

  <!-- J4 wrist pitch: ±90° -->
  <joint name="j4" type="revolute">
    <parent link="link3"/><child link="link4"/>
    <origin xyz="0 0 0.16"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="2.0" velocity="4"/><dynamics damping="0.04"/>
  </joint>
  <!-- wrist link: a4 = 40 mm -->
  <link name="link4"><inertial><origin xyz="0 0 0.02"/><mass value="0.06"/>
    <inertia ixx="0.0004" iyy="0.0004" izz="0.0002" ixy="0" ixz="0" iyz="0"/></inertial></link>

  <!-- J5 wrist roll: ±180° -->
  <joint name="j5" type="revolute">
    <parent link="link4"/><child link="link5"/>
    <origin xyz="0 0 0.04"/><axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="0.8" velocity="4"/><dynamics damping="0.03"/>
  </joint>
  <!-- roll link: d5 = 80 mm -->
  <link name="link5"><inertial><origin xyz="0 0 0.04"/><mass value="0.05"/>
    <inertia ixx="0.0002" iyy="0.0002" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial></link>

  <!-- J6 wrist yaw: ±180° -->
  <joint name="j6" type="revolute">
    <parent link="link5"/><child link="link6"/>
    <origin xyz="0 0 0.08"/><axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="0.8" velocity="5"/><dynamics damping="0.02"/>
  </joint>
  <!-- tool flange: d6 = 30 mm -->
  <link name="link6"><inertial><origin xyz="0 0 0.015"/><mass value="0.04"/>
    <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial></link>

  <!-- gripper finger travel (prismatic) -->
  <joint name="j_grip" type="prismatic">
    <parent link="link6"/><child link="link_grip"/>
    <origin xyz="0 0 0.03"/><axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.03" effort="0.6" velocity="0.1"/><dynamics damping="0.02"/>
  </joint>
  <link name="link_grip"><inertial><origin xyz="0.01 0 0"/><mass value="0.02"/>
    <inertia ixx="0.00004" iyy="0.00004" izz="0.00004" ixy="0" ixz="0" iyz="0"/></inertial></link>

</robot>
