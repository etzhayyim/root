;; sarutahiko-factory-r0 — 生産工程 (manufacturing line / 製造プロセス),
;; Datomic-style EDN. SSoT for HOW a finished truck is MADE — the ordered line
;; stations a truck body flows through, station-by-station, from receiving to
;; ship-out. This is the PRODUCTION counterpart of `construction.edn` (which
;; builds the PLANT); the two are distinct layers (ADR-2606013100 §1).
;;
;; `production_gen.py` validates this against the scene + building BOM and emits:
;;   - production.order.json — flat ordered station list consumed by the
;;     kami-app `run_sarutahiko_factory_produce_v1` entry (a truck body advances
;;     through these stations on kami-genesis physics; the assigned arm6 cell
;;     works it; at `paint` the body is recoloured; at `ship` a 積込ロボット
;;     loads it onto a carrier).
;;   - production_ingest.json — prod/* + mfgop/* kotoba EAVT datoms.
;;
;; :station/op       receive | frame-weld | cab-weld | paint | marriage | eol-test | stage | ship
;; :station/layer    maps to the ADR-2605252500 5-layer process (L1..L5 + 塗装 + 出荷)
;; :station/x :station/y  plan position the truck body occupies AT this station
;; :station/cell     the production robot servicing the station (scene cell or loader id)
;; :station/cycle-s  nominal takt dwell at the station (seconds)
;; :station/consumes building.edn :part/id of the equipment / kit used here

{:prod/meta
 {:prod/of      "sarutahiko-factory-r0"
  :prod/revision "v1"
  :prod/title   "猿田彦 Class-8 truck — R0 production line (受入→L1→L3→塗装→L4→L5→出荷)"
  :prod/takt-s  126
  :prod/note    "R0 design line for the ADR-2605252500 5-layer process. The body flows along the conveyor spine; the powertrain sub-line (L2) feeds the marriage station. Cycle times are representative takt figures, NOT a balanced line study. Capability inactive (cells are R0 scaffold); this is the production-flow SIMULATION."}

 :prod/stations
 [{:station/id "st:1-recv"     :station/seq 1 :station/layer "—"   :station/op "receive"
   :station/name "受入 Receiving" :station/x -86 :station/y 0 :station/cycle-s 8
   :station/consumes ["bld:F6-rack"]}

  {:station/id "st:2-frame"    :station/seq 2 :station/layer "L1"  :station/op "frame-weld"
   :station/name "フレーム溶接 Frame weld" :station/x -58 :station/y 0 :station/cell "cell_frame_1" :station/cycle-s 20
   :station/consumes ["bld:F1-framejig"]}

  {:station/id "st:3-cab"      :station/seq 3 :station/layer "L3"  :station/op "cab-weld"
   :station/name "キャブBIW溶接 Cab weld" :station/x -16 :station/y 0 :station/cell "cell_weld_1" :station/cycle-s 18
   :station/consumes ["bld:F2-press" "bld:F3-weldjig"]}

  {:station/id "st:4-paint"    :station/seq 4 :station/layer "塗装" :station/op "paint"
   :station/name "塗装 Paint (KTL→base→clear)" :station/x 10 :station/y 0 :station/cell "cell_paint_1" :station/cycle-s 24
   :station/consumes ["bld:F4-paintbooth"]}

  {:station/id "st:5-marriage" :station/seq 5 :station/layer "L4"  :station/op "marriage"
   :station/name "艤装・結合 Marriage (chassis↔cab↔powertrain)" :station/x 40 :station/y 0 :station/cell "cell_harness_1" :station/cycle-s 22
   :station/consumes ["bld:F11-marriage"]}

  {:station/id "st:6-eol"      :station/seq 6 :station/layer "L5"  :station/op "eol-test"
   :station/name "検査 EOL test (dyno + CMM)" :station/x 66 :station/y 0 :station/cell "cell_insp_1" :station/cycle-s 16
   :station/consumes ["bld:F7-dyno" "bld:F12-cmm"]}

  {:station/id "st:7-stage"    :station/seq 7 :station/layer "出荷" :station/op "stage"
   :station/name "完成車ステージング Finished staging" :station/x 88 :station/y -26 :station/cycle-s 6
   :station/consumes []}

  {:station/id "st:8-ship"     :station/seq 8 :station/layer "出荷" :station/op "ship"
   :station/name "積込・出荷 Load & ship" :station/x 111 :station/y -27 :station/cell "loader_1" :station/cycle-s 12
   :station/consumes ["bld:F10-loader"]}]}
