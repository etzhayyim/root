<?xml version="1.0"?>
<!-- GIEMON KABITORI (黴取り / mold-removal) probe — canonical articulation spec.

     A slender cleaning manipulator for removing EXISTING mold from confined
     surfaces: A/C drain pans + blower housings, building gaps/cavities, and
     HVAC ducts. Parsed at runtime by kami_articulated::parse_urdf and driven by
     the kami-genesis 3-D reduced-coordinate spatial solver (RNEA + CRBA + LDLᵀ)
     with the rigid contact/collision solver. Clean-room: no NVIDIA / PhysX /
     Isaac code (ADR-2605261800 N1..N9). Units: metres / kg / kg·m².

     Topology (mixed prismatic + revolute, 6 DOF):
       base_link  ── fixed to world
        └ j_feed    PRISMATIC +x  — linear feed: insert the probe into the gap
           └ j_yaw    REVOLUTE +z — aim left/right inside the gap
              └ j_pitch  REVOLUTE +y — dip the probe down toward the surface
                 └ j_seg1  REVOLUTE +y — flexible segment 1 (continuum approx)
                    └ j_seg2  REVOLUTE +y — flexible segment 2 (continuum approx)
                       └ j_brush REVOLUTE +x — rotary cleaning-brush spin

     The probe stacks along +x; revolute-y joints let the distal segments droop
     onto / conform to the target surface (the contact ground plane, which here
     stands in for the mold-laden surface). The brush head carries a capsule
     "bristle cross" whose endpoints contact the plane; spinning j_brush sweeps
     those endpoints horizontally across the surface — the Coulomb-friction
     scrub interaction. -->
<robot name="giemon_kabitori">

  <!-- Fixed base: the carriage mount / wrist of the host giemon platform. -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.002" iyy="0.002" izz="0.002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Linear feed: push the probe forward into the gap (0 → 300 mm). -->
  <joint name="j_feed" type="prismatic">
    <parent link="base_link"/>
    <child link="link_carriage"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.30" effort="80" velocity="0.5"/>
    <dynamics damping="0.5"/>
  </joint>
  <link name="link_carriage">
    <inertial>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <mass value="0.30"/>
      <inertia ixx="0.0006" iyy="0.0010" izz="0.0010" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Yaw: aim the probe sideways within the gap. -->
  <joint name="j_yaw" type="revolute">
    <parent link="link_carriage"/>
    <child link="link_neck"/>
    <origin xyz="0.04 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.4" upper="1.4" effort="25" velocity="3"/>
    <dynamics damping="0.10"/>
  </joint>
  <link name="link_neck">
    <inertial>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0003" iyy="0.0006" izz="0.0006" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Pitch (shoulder dip): rotate the probe down toward the surface. -->
  <joint name="j_pitch" type="revolute">
    <parent link="link_neck"/>
    <child link="link_arm"/>
    <origin xyz="0.04 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="30" velocity="3"/>
    <dynamics damping="0.10"/>
  </joint>
  <link name="link_arm">
    <inertial>
      <origin xyz="0.06 0 0" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.00015" iyy="0.0010" izz="0.0010" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Flexible segment 1. -->
  <joint name="j_seg1" type="revolute">
    <parent link="link_arm"/>
    <child link="link_seg1"/>
    <origin xyz="0.12 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="14" velocity="4"/>
    <dynamics damping="0.05"/>
  </joint>
  <link name="link_seg1">
    <inertial>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.00008" iyy="0.0006" izz="0.0006" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Flexible segment 2. -->
  <joint name="j_seg2" type="revolute">
    <parent link="link_seg1"/>
    <child link="link_seg2"/>
    <origin xyz="0.10 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="10" velocity="4"/>
    <dynamics damping="0.04"/>
  </joint>
  <link name="link_seg2">
    <inertial>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00005" iyy="0.0003" izz="0.0003" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Rotary cleaning-brush spin (about the probe axis). High velocity limit. -->
  <joint name="j_brush" type="revolute">
    <parent link="link_seg2"/>
    <child link="link_brush"/>
    <origin xyz="0.08 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-100" upper="100" effort="5" velocity="40"/>
    <dynamics damping="0.01"/>
  </joint>
  <link name="link_brush">
    <inertial>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <mass value="0.04"/>
      <inertia ixx="0.00006" iyy="0.00006" izz="0.00006" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

</robot>
