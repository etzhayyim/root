#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def DistantLight "Sun"
    {
        float inputs:intensity = 8000
        float xformOp:rotateY = -45
        uniform token[] xformOpOrder = ["xformOp:rotateY"]
    }

    def Mesh "Ground"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-15, -15, 0), (15, -15, 0), (15, 15, 0), (-15, 15, 0)]
        color3f[] primvars:displayColor = [(0.3, 0.45, 0.2)]
    }

    def Xform "Kusawake"
    {
        def Cube "Chassis"
        {
            color3f[] primvars:displayColor = [(0.2, 0.55, 0.2)]
            float3 xformOp:scale = (0.7, 0.45, 0.1)
            double3 xformOp:translate = (0, 0, 0.3)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Deck"
        {
            color3f[] primvars:displayColor = [(0.85, 0.85, 0.85)]
            float3 xformOp:scale = (0.55, 0.35, 0.04)
            double3 xformOp:translate = (0, 0, 0.48)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cylinder "Wheel_FL"
        {
            uniform token axis = "Y"
            double height = 0.12
            color3f[] primvars:displayColor = [(0.1, 0.1, 0.1)]
            double radius = 0.2
            double3 xformOp:translate = (0.55, 0.5, 0.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "Wheel_FR"
        {
            uniform token axis = "Y"
            double height = 0.12
            color3f[] primvars:displayColor = [(0.1, 0.1, 0.1)]
            double radius = 0.2
            double3 xformOp:translate = (0.55, -0.5, 0.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "Wheel_RL"
        {
            uniform token axis = "Y"
            double height = 0.12
            color3f[] primvars:displayColor = [(0.1, 0.1, 0.1)]
            double radius = 0.2
            double3 xformOp:translate = (-0.55, 0.5, 0.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "Wheel_RR"
        {
            uniform token axis = "Y"
            double height = 0.12
            color3f[] primvars:displayColor = [(0.1, 0.1, 0.1)]
            double radius = 0.2
            double3 xformOp:translate = (-0.55, -0.5, 0.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "Lidar"
        {
            uniform token axis = "Z"
            double height = 0.08
            color3f[] primvars:displayColor = [(0.95, 0.85, 0.1)]
            double radius = 0.06
            double3 xformOp:translate = (0.55, 0, 0.58)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

