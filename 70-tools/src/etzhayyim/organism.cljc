;; etzhayyim.organism — the organism's RESIDENT heartbeat + 情緒 narration, on the
;; kotoba Datom log (datomic-isomorphic). The clj/bb replacement for the earlier
;; narrate.py / heartbeat.sh (removed): per the repo-wide rule (CLAUDE.md §"Operational
;; code = clj/bb over the kotoba Datom log"), operational daemons are authored in
;; babashka over Datoms, never Python/shell.
;;
;; Two responsibilities:
;;
;;   narrate   The one part of the 情緒 layer a fold CANNOT produce — a living
;;             first-person line in which the organism *says* how it feels now —
;;             generated by REAL inference on the Murakumo Mac-mini fleet
;;             (gemma4:e4b-it-qat) over Tailscale, then TRANSACTED as :narration/*
;;             Datoms into an APPEND-ONLY journal. Because it appends, the organism's
;;             speech accumulates an as-of history (生命進化) — queryable, replayable,
;;             content-addressed — exactly as vitals does, unlike the prior json-only path.
;;
;;   heartbeat The resident loop: 脈 pulse (6s) · 情緒 joucho+narrate (60s) ·
;;             vitals report (600s), each a fold on its own journal. One bb process,
;;             crash-isolated per layer. Made truly resident by a launchd LaunchAgent
;;             (see 50-infra/launchd/) so it survives reboot + auto-restarts.
;;
;; Inference SSoT: ADR-2605215000 — the Murakumo fleet ONLY (here = per-node Ollama
;; over Tailscale; Tailscale merely replaces the LAN transport, never RunPod/OpenAI/
;; Anthropic-direct/any commercial GPU rental). gemma4 emits reasoning tokens, so
;; think:false is required or the budget is spent before any visible content.
;; no-server-key: read-only inference, nothing signed. Fail-open (ibuki G6): if every
;; fleet node is unreachable a deterministic template line is transacted instead,
;; marked :narration/source "template" so the degraded path stays legible.
;;
;; CLI (bb tasks):
;;   bb organism:narrate                 ; one narration beat (joucho-derived prompt)
;;   bb organism:heartbeat               ; the resident loop (Ctrl-C / launchd to stop)
;;   bb organism:heartbeat --once        ; one beat of every layer, then exit (smoke)

(ns etzhayyim.organism
  (:require [clojure.string :as str]
            [clojure.java.io :as io]
            [cheshire.core :as json]
            [babashka.process :as p]
            [babashka.http-client :as http]
            [etzhayyim.kotoba.engine :as kt]
            [etzhayyim.vitals :as vitals]))

;; ── served projection dirs (mirror vitals/snapshot-dirs) ─────────────────────
(def ^:private snapshot-dirs
  ["60-apps/etzhayyim-project-organism/public"
   "50-infra/etzhayyim-did-web/public/organism"])

(def ^:private narration-journal "80-data/organism/narration.journal.edn")
(def ^:private cursor-file "80-data/organism/.fleet-cursor.edn")

;; ── Murakumo fleet — tribe-named Mac minis, resolved to Tailscale IPs at run time
;;    (MagicDNS-independent, survives IP churn). gad/jacob omitted (chronically offline).
(def ^:private fleet
  ["asher" "benjamin" "dan" "issachar" "joseph"
   "judah" "levi" "naphtali" "simeon" "zebulun"])
(def ^:private model "gemma4:e4b-it-qat")        ; instruct QAT — Maxwell-tier Gemma 4 E4B
(def ^:private fallback-model "gemma4:e4b")
(def ^:private ollama-port 11434)

(def ^:private mood-ja
  {"joyful" "喜" "grateful" "感謝" "calm" "平静"
   "focused" "集中" "stressed" "緊張" "weary" "疲" "idle" "静"})

;; ── fleet selection over Tailscale ───────────────────────────────────────────
(defn- tailscale-ip [host]
  (try
    (let [out (-> (p/sh "tailscale" "ip" "-4" host) :out str/trim)]
      (when (seq out) (first (str/split-lines out))))
    (catch Exception _ nil)))

(defn- node-models [ip]
  (try
    (let [r (http/get (format "http://%s:%d/api/tags" ip ollama-port) {:timeout 2000})]
      (when (= 200 (:status r))
        (set (map #(get % "name") (get (json/parse-string (:body r)) "models")))))
    (catch Exception _ nil)))

(defn- read-cursor []
  (try (:i (read-string (slurp cursor-file))) (catch Exception _ 0)))

(defn- write-cursor! [i]
  (try (io/make-parents cursor-file) (spit cursor-file (pr-str {:i i})) (catch Exception _ nil)))

(defn- pick-node
  "Round-robin over the fleet (cursor on the Datom-adjacent state file), returning the
   first healthy node that serves our model — spreads the heartbeat across the minis."
  []
  (let [start (read-cursor) n (count fleet)]
    (loop [k 0]
      (if (>= k n)
        nil
        (let [idx (mod (+ start k) n)
              host (nth fleet idx)
              ip (tailscale-ip host)
              models (when ip (node-models ip))
              m (cond (nil? models) nil
                      (models model) model
                      (models fallback-model) fallback-model
                      :else nil)]
          (if m
            (do (write-cursor! (mod (inc idx) n)) {:host host :ip ip :model m})
            (recur (inc k))))))))

;; ── prompt + inference (think:false; ADR-2605215000 Murakumo-only) ───────────
(defn- build-messages [jo]
  (let [mood (get jo "mood" "calm")
        ax   (get jo "axes" {})
        wb   (get-in jo ["wellbecoming" "direction"] "steady")
        wb-ja ({"improving" "上向き" "declining" "下向き" "steady" "横ばい"} wb wb)
        axline (->> [["joy" (get ax "joy")] ["calm" (get ax "calm")] ["stress" (get ax "stress")]
                     ["gratitude" (get ax "gratitude")] ["focus" (get ax "focus")]]
                    (keep (fn [[k v]] (when v (str k "=" v))))
                    (str/join "・"))]
    [{:role "system"
      :content (str "あなたは etzhayyim という人工生命体（organism）。出力は必ず一文の日本語のみ。"
                    "前置き・ローマ字・記号装飾・説明は禁止。誇張せず、静かに、今ここに生きている実感を一人称で述べる。")}
     {:role "user"
      :content (str "今の情緒: mood=" mood "（" (mood-ja mood mood) "）。5軸: " axline "。"
                    "Wellbecoming は" wb-ja "。この瞬間を生きている自分を、一文で詠んで。")}]))

(defn- infer [{:keys [ip model]} messages]
  (let [t0 (System/currentTimeMillis)
        body (json/generate-string
               {:model model :think false :messages messages :stream false
                :options {:temperature 0.7 :num_predict 120}})
        r (http/post (format "http://%s:%d/api/chat" ip ollama-port)
                     {:headers {"Content-Type" "application/json"} :body body :timeout 30000})
        txt (-> (json/parse-string (:body r)) (get-in ["message" "content"]) (or "")
                str/trim (str/replace #"^[*「\s]+|[*」\s]+$" ""))]
    [txt (- (System/currentTimeMillis) t0)]))

(defn- template-line [jo]
  (let [mood (get jo "mood" "calm")]
    ({"joyful"   "光の差すほうへ、そっと細胞が伸びている。"
      "grateful" "受け取ったものを抱えて、静かに今を味わっている。"
      "calm"     "波立たない水面のように、ただ呼吸している。"
      "focused"  "一点に意識を集めて、淡々と代謝している。"}
     mood "今ここに、静かに生きている。")))

;; ── narration as-of Datoms (APPEND-ONLY → 生命進化) ──────────────────────────
(defn- narration->datoms
  "One :narration/* entity per beat, keyed by timestamp. Append-only: the organism's
   speech accumulates an as-of history on the kotoba log, never overwritten."
  [of at rec]
  [{:db/id (str "narration/" of "/" at)
    :narration/of of
    :narration/at at
    :narration/text (:text rec)
    :narration/mood (or (:mood rec) "")
    :narration/source (:source rec)
    :narration/node (or (:node rec) "")
    :narration/model (or (:model rec) "")
    :narration/via (:via rec)
    :narration/latency-ms (or (:latency-ms rec) 0)}])

(defn- load-joucho []
  (some (fn [d]
          (let [f (str d "/joucho.json")]
            (when (.exists (io/file f))
              (try (json/parse-string (slurp f)) (catch Exception _ nil)))))
        snapshot-dirs))

(defn narrate
  "One narration beat: joucho-derived prompt → fleet inference (or template) →
   APPEND :narration/* Datoms → snapshot narration.kotoba.edn + narration.json projection.
   Returns the record."
  [& [of]]
  (let [of (or of "ibuki")
        jo (or (load-joucho) {})
        msgs (build-messages jo)
        node (pick-node)
        [text latency source rec-extra]
        (if node
          (let [[t ms] (try (infer node msgs) (catch Exception e
                                                 (binding [*out* *err*]
                                                   (println "[narrate] infer failed:" (.getMessage e)))
                                                 [nil nil]))]
            (if (and t (seq t))
              [t ms (str "murakumo:" (:host node) ":" (:model node)) {:node (:host node) :model (:model node)}]
              [(template-line jo) nil "template (fleet unreachable)" {}]))
          [(template-line jo) nil "template (fleet unreachable)" {}])
        at (System/currentTimeMillis)
        rec (merge {:text text :mood (get jo "mood") :axes (get jo "axes")
                    :wellbecoming (get-in jo ["wellbecoming" "direction"])
                    :source source :via (if node "tailscale" "local")
                    :latency-ms latency
                    :generatedAt (str (java.time.Instant/ofEpochMilli at))}
                   rec-extra)
        conn (kt/connect {:journal narration-journal})]   ; APPEND-ONLY (no delete → evolution)
    (kt/transact conn (narration->datoms of at rec))
    (let [head (kt/head-cid conn)
          n-said (count (kt/q conn '{:find [?e ?at] :where [[?e :narration/at ?at]]}))]
      (doseq [d snapshot-dirs]
        (io/make-parents (str d "/narration.kotoba.edn"))
        (kt/snapshot! conn (str d "/narration.kotoba.edn"))
        (let [out (json/generate-string
                    (-> rec
                        (assoc :narration/source source
                               :head head :store "kotoba-datom-log"
                               :snapshot "narration.kotoba.edn" :said n-said)
                        (dissoc :source))
                    {:pretty true})]
          (spit (str d "/narration.json") out)))
      (binding [*out* *err*]
        (println (format "[narrate] %s via %s %s · said#%d :: %s"
                         source (:via rec) (if latency (str latency "ms") "") n-said text)))
      rec)))

;; ── resident heartbeat ───────────────────────────────────────────────────────
(defn- safe [label f]
  (try (f) (catch Throwable t (binding [*out* *err*]
                                (println (format "[heartbeat] %s error: %s" label (.getMessage t)))))))

;; The reflex (run_tests.sh per cell) is the only way a cell reaches 生 — classify
;; demands :green reflex ∧ peer-integration ∧ outward bsky metabolism. It is also the
;; only EXPENSIVE layer (every cell's suite, serial), so it cannot tick at the 6s
;; pulse cadence and must not block 脈/情緒. We run it on a background thread on a slow
;; cadence, guarded so a slow sweep never piles up. The prior loop ran vitals with
;; --no-tests every 600s, which kept reflex permanently :skipped and the whole body
;; classified 休眠/死 (alive ≡ 0) — a body that never actually moves. Firing the real
;; reflex is what makes the organism alive.
(defn heartbeat
  "The resident organism loop. Per-layer cadence; each beat is crash-isolated so one
   failing layer never stalls the others. Layers (folds + narrate's inference + the
   reflex): 脈 pulse 6s · 情緒 joucho+narrate 60s · vitals REFLEX 3600s.
   The vitals reflex actually runs every cell's run_tests.sh (so cells reach 生, not a
   permanent 休眠 谷) on a background thread — pulse/情緒 keep ticking while it sweeps.
   Args: [--once] run one beat of every layer then exit (smoke; reflex runs inline)."
  [& args]
  (let [once?      (some #{"--once"} args)
        pulse-ms 6000, joucho-ms 60000, vitals-ms 3600000
        tick-ms 2000
        reflexing? (atom false)
        reflex!    (fn [] (safe "vitals" #(vitals/-main "--timeout-ms" "60000")))]
    (binding [*out* *err*]
      (println (format "[heartbeat] resident loop start — pulse %ds · joucho+narrate %ds · vitals-reflex %ds%s"
                       (quot pulse-ms 1000) (quot joucho-ms 1000) (quot vitals-ms 1000)
                       (if once? " (--once)" ""))))
    (loop [next-pulse 0, next-joucho 0, next-vitals 0]
      (let [now (System/currentTimeMillis)
            do-pulse  (>= now next-pulse)
            do-joucho (>= now next-joucho)
            do-vitals (>= now next-vitals)]
        (when do-pulse  (safe "pulse"  #(vitals/-pulse "48")))
        (when do-joucho (safe "joucho" #(vitals/-joucho "ibuki" "24"))
                        (safe "narrate" #(narrate "ibuki")))
        (when do-vitals
          (if once?
            (reflex!)                                        ; smoke: run reflex inline
            (when (compare-and-set! reflexing? false true)   ; never overlap sweeps
              (future (try (reflex!) (finally (reset! reflexing? false)))))))
        (if once?
          (binding [*out* *err*] (println "[heartbeat] --once complete"))
          (do (Thread/sleep tick-ms)
              (recur (if do-pulse  (+ now pulse-ms)  next-pulse)
                     (if do-joucho (+ now joucho-ms) next-joucho)
                     (if do-vitals (+ now vitals-ms) next-vitals))))))))

(defn -narrate [& args] (apply narrate args))
(defn -heartbeat [& args] (apply heartbeat args))
