  ;; the quality verdict — split by mode, this is the substantive finding
  :quality
  {:single-shot-thinking-off
   {:verdict :GOOD
    :evidence "direct generation of service-request: faithful to original logic (init->process,
               utility_state, completionPct 0->100 all preserved), structurally valid, buildable, 481 tok / 145s.
               Comparable to claude/gemini first-shot. (My earlier 'low-fidelity/renamed' claim was WRONG —
               the original cell is genuinely a generic Cell template; gemma was faithful.)"}
   :thinking-on-default
   {:verdict :BROKEN
    :evidence "emits 2000+ reasoning tokens before any code, exhausts max_tokens -> EMPTY content ->
               empty agent.py. ~20 min/call. Heaviness directly causes output failure, not just latency."}
   :agentic-self-repair
   {:verdict :FRAGILE
    :evidence "in the build-error feedback loop, by iter 4 gemma DERAILED: instead of fixing the port it wrote a
               META-script (import os/subprocess + the port embedded as a STRING literal + try/except wrapper),
               which fails structurally. It does NOT converge the way claude/gemini self-repair do.
               See results/gemma-evidence/service-request-iter4-derailed.py"}}

  :rollup-2cell {:build-pass 0.0 :struct-ok 0.0 :judge 2.0 :wall-s 840.5 :usd 0.0
                 :note "0% build under the agentic loop — but this measures self-repair robustness, NOT raw
                        generation quality (which is fine single-shot). elv-body-shred errored on a server
