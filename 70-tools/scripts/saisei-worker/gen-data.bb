#!/usr/bin/env bb
;; Embeds 20-actors/saisei/data/{jurisdictions,procedure-registry}.edn as CLJS
;; string constants, generated so the saisei-worker Worker never needs a
;; runtime fetch/asset round-trip to load its own registries. Run from the
;; repo root: `bb 70-tools/scripts/saisei-worker/gen-data.bb`. Idempotent —
;; re-run any time the source EDN changes, before `npm run build`.
(require '[clojure.string :as str])

(defn- slurp-escaped [path]
  (-> (slurp path)
      (str/replace "\\" "\\\\")
      (str/replace "\"" "\\\"")))

(let [juris (slurp-escaped "20-actors/saisei/data/jurisdictions.edn")
      procs (slurp-escaped "20-actors/saisei/data/procedure-registry.edn")
      out-path "50-infra/saisei-worker/cljs/src/saisei_worker/data_gen.cljs"
      out (str
           ";; GENERATED by 70-tools/scripts/saisei-worker/gen-data.bb — do not hand-edit.\n"
           ";; Embeds 20-actors/saisei/data/*.edn verbatim as string constants so the\n"
           ";; Worker parses them at request time via the shared saisei.methods.edn\n"
           ";; reader (single source of truth stays the checked-in .edn files).\n"
           "(ns saisei-worker.data-gen)\n\n"
           "(def jurisdictions-edn-str\n  \"" juris "\")\n\n"
           "(def procedure-registry-edn-str\n  \"" procs "\")\n")]
  (spit out-path out)
  (println "wrote" out-path (str "(" (count out) " bytes)")))
