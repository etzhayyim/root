#!/usr/bin/env bb
;; Embeds 50-infra/saisei-worker/ui-src/page.html as a CLJS string constant.
;; Run from the repo root: `bb 70-tools/scripts/saisei-worker/gen-ui.bb`.
;; Kept as a separate plain .html source (not hand-escaped inline Clojure) so
;; the markup/JS is editable/lintable as normal HTML — this script does the
;; only escaping that matters (backslash, then double-quote).
(require '[clojure.string :as str])

(let [html (-> (slurp "50-infra/saisei-worker/ui-src/page.html")
               (str/replace "\\" "\\\\")
               (str/replace "\"" "\\\""))
      out-path "50-infra/saisei-worker/cljs/src/saisei_worker/ui.cljs"
      out (str
           ";; GENERATED by 70-tools/scripts/saisei-worker/gen-ui.bb — do not hand-edit.\n"
           ";; Source: 50-infra/saisei-worker/ui-src/page.html\n"
           "(ns saisei-worker.ui)\n\n"
           "(def page-html\n  \"" html "\")\n")]
  (spit out-path out)
  (println "wrote" out-path (str "(" (count out) " bytes)")))
