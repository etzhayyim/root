#!/usr/bin/env bb
;; Embeds 50-infra/meibo-worker/ui-src/page.html as a CLJS string constant.
;; Run from the repo root: `bb 70-tools/scripts/meibo-worker/gen-ui.bb`.
(require '[clojure.string :as str])

(let [html (-> (slurp "50-infra/meibo-worker/ui-src/page.html")
               (str/replace "\\" "\\\\")
               (str/replace "\"" "\\\""))
      out-path "50-infra/meibo-worker/cljs/src/meibo_worker/ui.cljs"
      out (str
           ";; GENERATED by 70-tools/scripts/meibo-worker/gen-ui.bb — do not hand-edit.\n"
           ";; Source: 50-infra/meibo-worker/ui-src/page.html\n"
           "(ns meibo-worker.ui)\n\n"
           "(def page-html\n  \"" html "\")\n")]
  (spit out-path out)
  (println "wrote" out-path (str "(" (count out) " bytes)")))
