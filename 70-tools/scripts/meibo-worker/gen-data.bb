#!/usr/bin/env bb
;; Embeds 20-actors/meibo/data/legal-directory.edn as a CLJS string constant.
;; Run from the repo root: `bb 70-tools/scripts/meibo-worker/gen-data.bb`.
(require '[clojure.string :as str])

(defn- slurp-escaped [path]
  (-> (slurp path)
      (str/replace "\\" "\\\\")
      (str/replace "\"" "\\\"")))

(let [legal-dir (slurp-escaped "20-actors/meibo/data/legal-directory.edn")
      out-path "50-infra/meibo-worker/cljs/src/meibo_worker/data_gen.cljs"
      out (str
           ";; GENERATED by 70-tools/scripts/meibo-worker/gen-data.bb — do not hand-edit.\n"
           ";; Embeds 20-actors/meibo/data/legal-directory.edn verbatim as a string constant.\n"
           "(ns meibo-worker.data-gen)\n\n"
           "(def legal-directory-edn-str\n  \"" legal-dir "\")\n")]
  (spit out-path out)
  (println "wrote" out-path (str "(" (count out) " bytes)")))
