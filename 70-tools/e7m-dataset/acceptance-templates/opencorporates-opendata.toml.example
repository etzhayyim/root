# OpenCorporates open-data fork acceptance template (Tier-B; REQUIRED at W3).
#
# Per ADR-2605263800 §2 source ladder. OpenCorporates publishes its
# public open-data fork under CC-BY-SA 4.0 — Share-Alike propagates,
# so any derivative training corpus + downstream artifact carries the
# `-tierB-` infix and CC-BY-SA + OpenCorporates attribution in NOTICE.
#
# CRITICAL: this acceptance covers the OPEN-DATA FORK ONLY. The
# paid-API tier of OpenCorporates (api.opencorporates.com behind a
# paid subscription) is CONSTITUTIONALLY PROHIBITED per Charter Rider
# §2(e) anti-gatekeeping + §2(c) vendor closed query-tracking exposing
# member investment-research posture. Operator MUST NOT use the paid
# API key path even if they hold one.
#
# To install:
#   cp opencorporates-opendata.toml.example \
#      ~/.etzhayyim/source-acceptance/opencorporates-opendata.toml
#
# Then edit accepted_by_did + accepted_at + notes.

[acceptance]
source                     = "opencorporates-opendata"
accepted_at                = "2026-05-26T00:00:00Z"
accepted_by_did            = "did:web:etzhayyim.com:actor:dataset-operator"
upstream_tos_url           = "https://opencorporates.com/info/open-data"
upstream_license           = "CC-BY-SA-4.0"
upstream_attribution       = "© OpenCorporates Ltd. CC-BY-SA 4.0"
notes                      = "OpenCorporates open-data fork only — paid-API tier PROHIBITED per Charter Rider §2(e)+§2(c)."
tier_b_infix_attested      = true
share_alike_propagation_ok = true
paid_api_tier_not_used     = true
derivative_artifact_pattern = "baien-server-corp-ownership-graph-tierB-r1"
