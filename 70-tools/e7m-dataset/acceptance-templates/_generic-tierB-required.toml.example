# Generic Tier-B acceptance template (REQUIRED at W3+ for -tierB-
# derivative corpora).
#
# Per ADR-2605262400 + ADR-2605263800 G4. Tier-B sources (typically
# CC-BY-SA — Share-Alike propagation) require the operator to attest
# they have read the upstream terms and accept the obligation to apply
# the `-tierB-` infix on any derivative artifact + propagate the
# share-alike license + carry attribution in NOTICE.
#
# To install:
#   cp _generic-tierB-required.toml.example \
#      ~/.etzhayyim/source-acceptance/<source-id>.toml
#
# Then edit the fields below. The fetcher will read this via
# _acceptance.require_acceptance() — missing / malformed = fail closed.

[acceptance]
source                     = "<source-id, e.g. opencorporates-opendata>"
accepted_at                = "2026-05-26T00:00:00Z"
accepted_by_did            = "did:web:etzhayyim.com:actor:dataset-operator"
upstream_tos_url           = "<URL to upstream license / ToS>"
notes                      = "Tier-B accepted; -tierB- derivative infix obligated; SA propagates."
tier_b_infix_attested      = true
share_alike_propagation_ok = true
derivative_artifact_pattern = "baien-server-<corpus>-tierB-r<n>"
