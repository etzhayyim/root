{
  "domain": "car_maker",
  "appHost": "kuruma",
  "repo": "did:web:kuruma.etzhayyim.com",
  "collection": "ai.gftd.apps.car_maker.maker",
  "source": {
    "url": "https://vpic.nhtsa.dot.gov/api/vehicles/GetAllMakes?format=json",
    "format": "json",
    "path": "Results"
  },
  "rkey": "nhtsa-{{Make_ID}}",
  "mapping": {
    "makeId": "{{Make_ID}}",
    "name": "{{Make_Name}}",
    "source": "nhtsa-vpic"
  },
  "chunkSize": 500,
  "note": "NHTSA vPIC GetAllMakes — ~11K vehicle makers (US registered). No auth. world_total=5000, will cap at 100%."
}
