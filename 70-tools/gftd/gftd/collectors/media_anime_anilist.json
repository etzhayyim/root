{
  "domain": "media_anime",
  "appHost": "media-anime",
  "repo": "did:web:media-anime.etzhayyim.com",
  "collection": "ai.gftd.apps.media_anime.title",
  "source": {
    "url": "https://graphql.anilist.co",
    "format": "json",
    "path": "data.Page.media",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json",
      "Accept": "application/json"
    },
    "body": "{\"query\":\"query { Page(page: 1, perPage: 50) { media(type: ANIME, sort: POPULARITY_DESC) { id title { romaji english native } format status seasonYear averageScore popularity } } }\"}"
  },
  "rkey": "anilist-{{id}}",
  "mapping": {
    "anilistId": "{{id}}",
    "title": "{{title.romaji}}",
    "titleEn": "{{title.english}}",
    "titleJa": "{{title.native}}",
    "format": "{{format}}",
    "year": "{{seasonYear}}",
    "averageScore": "{{averageScore}}",
    "popularity": "{{popularity}}",
    "source": "anilist"
  },
  "chunkSize": 200,
  "note": "AniList GraphQL POST. Single page sort-by-popularity. 50 entries per call."
}
