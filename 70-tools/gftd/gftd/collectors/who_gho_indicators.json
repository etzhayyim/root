{
  "domain": "who_gho",
  "appHost": "gho.etzhayyim.com",
  "repo": "did:web:gho.etzhayyim.com",
  "collection": "ai.gftd.apps.gho.indicator",
  "source": {
    "url": "https://ghoapi.azureedge.net/api/Indicator",
    "format": "json",
    "path": "value"
