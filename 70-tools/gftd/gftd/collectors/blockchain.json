{
  "domain": "blockchain",
  "appHost": "blockchain",
  "repo": "did:web:blockchain.etzhayyim.com",
  "collection": "ai.gftd.apps.blockchain.chain",
  "source": {
    "url": "https://chainid.network/chains.json",
    "format": "json",
    "path": "$"
  },
  "rkey": "chain-{{chainId}}",
  "mapping": {
    "chainId": "{{chainId}}",
    "name": "{{name}}",
    "shortName": "{{shortName}}",
    "chain": "{{chain}}",
    "network": "{{network}}",
    "networkId": "{{networkId}}",
    "infoURL": "{{infoURL}}"
  },
  "chunkSize": 100,
  "note": "EVM chain list from chainid.network (~1000 EVM-compatible chains)"
}
