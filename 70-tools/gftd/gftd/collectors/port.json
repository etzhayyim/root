{
  "domain": "port",
  "appHost": "port",
  "repo": "did:web:port.etzhayyim.com",
  "collection": "ai.gftd.apps.port.port",
  "source": {
    "url": "https://raw.githubusercontent.com/datasets/un-locode/master/data/code-list.csv",
    "format": "csv"
  },
  "rkey": "{{Country}}-{{Location}}",
  "mapping": {
    "country": "{{Country}}",
    "location": "{{Location}}",
    "name": "{{Name}}",
    "nameWoDiacritics": "{{NameWoDiacritics}}",
    "subdivision": "{{Subdivision}}",
    "status": "{{Status}}",
    "function": "{{Function}}",
    "date": "{{Date}}",
    "coordinates": "{{Coordinates}}"
  },
  "chunkSize": 500,
  "note": "UN/LOCODE Location Codes — ~100K entries (world_total=8500 = major ports subset)"
}
