{
  "domain": "media_anime",
  "appHost": "media-anime",
  "repo": "did:web:media-anime.etzhayyim.com",
  "collection": "ai.gftd.apps.media_anime.title",
  "source": {
    "url": "https://github.com/manami-project/anime-offline-database/releases/download/2026-14/anime-offline-database-minified.json",
    "format": "json",
    "path": "data"
  },
  "rkey": "anime-{{sources[0]}}",
  "mapping": {
    "title": "{{title}}",
    "type": "{{type}}",
    "episodes": "{{episodes}}",
    "status": "{{status}}",
    "year": "{{animeSeason.year}}",
    "season": "{{animeSeason.season}}",
    "picture": "{{picture}}",
    "thumbnail": "{{thumbnail}}",
    "sources": "{{sources[0]}}"
  },
  "chunkSize": 500,
  "note": "manami-project anime-offline-database (~40K entries aggregated from MAL, AniList, Kitsu, AniDB, Anime-Planet, Notify.moe, Livechart)"
}
