{
  "domain": "fda_ndc",
  "appHost": "ndc",
  "repo": "did:web:ndc.etzhayyim.com",
  "collection": "ai.gftd.apps.fda.ndc",
  "source": {
    "url": "https://api.fda.gov/drug/ndc.json?limit=1000&skip=132000",
    "format": "json",
    "path": "results"
  },
  "rkey": "ndc-{{product_ndc}}",
  "mapping": {
    "productNdc": "{{product_ndc}}",
    "genericName": "{{generic_name}}",
    "labelerName": "{{labeler_name}}",
    "brandName": "{{brand_name}}"
  },
  "chunkSize": 500,
  "note": "FDA NDC drug codes skip=132000"
}