;; com.etzhayyim.okaimono.order — lexicon (EDN form) — Ring 1 internal order
;; ADR-2606012100 §R1
{:lexicon 1
 :id "com.etzhayyim.okaimono.order"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["orderId" "basketId" "buyerDid" "makerActor" "state"]
    :properties
    {:orderId          {:type "string"}
     :basketId         {:type "string"}
     :buyerDid         {:type "string" :description "active Adherent SBT holder (§3/G2)"}
     :makerActor       {:type "string" :description "producing etzhayyim actor (SBT↔SBT counterpart)"}
     :state            {:type "string" :description "cart|placed|settle-intent|fulfilling|delivered|in-use|refused (no terminal consumed, G13)"}
     :settlementId     {:type "string"}
     :fulfillmentActor {:type "string" :description "haraedo|wadachi|sarutahiko — etzhayyim logistics, never gig (G8)"}
     :refusedReason    {:type "string" :description "set when state=refused (e.g. SBT ineligibility)"}}}}}}
