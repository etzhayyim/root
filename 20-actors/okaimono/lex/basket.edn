;; com.etzhayyim.okaimono.basket — lexicon (EDN form)
;; ADR-2606012100
{:lexicon 1
 :id "com.etzhayyim.okaimono.basket"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["basketId" "needId" "lines" "landedMinor"]
    :properties
    {:basketId    {:type "string"}
     :needId      {:type "string"}
     :landedMinor {:type "integer" :description "items + shipping + tariff + tithe, minor units"}
     :lines       {:type "array"
                   :items {:type "object"
                           :required ["productId" "qty"]
                           :properties
                           {:productId      {:type "string"}
                            :qty            {:type "integer"}
                            :shippingMinor  {:type "integer"}
                            :tariffMinor    {:type "integer"}}}}}}}}}
