;; com.etzhayyim.okaimono.settlement — lexicon (EDN form) — USDC + TitheRouter intent
;; ADR-2606012100 §R1  ·  intent only; broadcast is operator-gated (G11)
{:lexicon 1
 :id "com.etzhayyim.okaimono.settlement"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["settlementId" "rail" "grossMinor" "titheMinor" "makerPayoutMinor" "state"]
    :properties
    {:settlementId     {:type "string"}
     :rail             {:type "string" :description "usdc-base-l2 (ERC-4337 via warifu); no fiat (G7)"}
     :grossMinor       {:type "integer" :description "USDC minor (6-dp) gross landed cost"}
     :titheMinor       {:type "integer" :description "10% TitheRouter auto-split → Public Fund (G7)"}
     :makerPayoutMinor {:type "integer" :description "net to producing actor (gross − tithe)"}
     :titheRouter      {:type "string" :description "TitheRouter contract ref"}
     :state            {:type "string" :description "intent (computed, NOT broadcast) | executed (operator-broadcast, G11)"}
     :operatorRef      {:type "string" :description "operator/Council auth to broadcast; absent ⇒ stays intent"}}}}}}
