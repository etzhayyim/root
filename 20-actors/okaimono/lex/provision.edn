;; com.etzhayyim.okaimono.provision — lexicon (EDN form)
;; ADR-2606012100
{:lexicon 1
 :id "com.etzhayyim.okaimono.provision"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["provisionId" "ring" "settlement"]
    :properties
    {:provisionId  {:type "string"}
     :basketId     {:type "string"}
     :ring         {:type "string" :description "commons|internal|external"}
     :settlement   {:type "string" :description "commons-none|usdc-warifu|self-checkout-handoff|proxy-gated"}
     :titheMinor   {:type "integer" :description "10% TitheRouter auto-split (internal only; G7)"}
     :gateRef      {:type "string" :description "Council Lv7+/operator auth ref; required for proxy-gated (G11), else proxy refused"}
     :handoffUri   {:type "string" :description "Ring 2 R0 self-checkout deep-link; NO affiliate tag (G3)"}}}}}}
