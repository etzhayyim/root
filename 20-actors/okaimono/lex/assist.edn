;; com.etzhayyim.okaimono.assist — lexicon (EDN form) — R3 assisted secure checkout
;; ADR-2606012100 §R3  ·  member-principal (G14) · no-server-key (G15) · encrypted (G9)
{:lexicon 1
 :id "com.etzhayyim.okaimono.assist"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["assistId" "memberDid" "mode" "principal" "state"]
    :properties
    {:assistId      {:type "string"}
     :memberDid     {:type "string" :description "purchasing principal (G14) + the only valid payment signer (G15)"}
     :mode          {:type "string" :description "assisted-secure-checkout"}
     :principal     {:type "string" :description "always \"member\" — okaimono is never the buyer (G14)"}
     :state         {:type "string" :description "awaiting-member-authorization|authorized-pending-operator|submitted|refused"}
     :encryptedRef  {:type "string" :description "com.etzhayyim.encrypted.* envelope ref; no plaintext PII (G9)"}
     :handoffUri    {:type "string" :description "affiliate-stripped retailer deep-link (G3)"}
     :payment       {:type "object"
                     :required ["instrument" "principal" "serverHeldKey" "signed"]
                     :properties
                     {:instrument             {:type "string" :description "member-external-card|warifu"}
                      :rail                   {:type "string" :description "erc4337-user-op|member-card-direct"}
                      :amountMinor            {:type "integer"}
                      :currency               {:type "string"}
                      :principal              {:type "string" :description "member (G14)"}
                      :serverHeldKey          {:type "boolean" :description "MUST be false (G15)"}
                      :requiredSigner         {:type "string" :description "member-passkey-or-smart-account"}
                      :signed                 {:type "boolean"}
                      :requiresWarifuExternalGate {:type "boolean" :description "warifu @ external retailer → Phase-2 Lv7+ (ADR-2605302000)"}}}
     :delivery      {:type "object"
                     :properties
                     {:carrier {:type "string" :description "etzhayyim logistics actor or retailer-ship"}
                      :mode    {:type "string" :description "etzhayyim-logistics|retailer-shipping"}
                      :gig     {:type "boolean" :description "always false on the etzhayyim leg (G8)"}}}}}}}}
