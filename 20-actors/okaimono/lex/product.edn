;; com.etzhayyim.okaimono.product — lexicon (EDN form)
;; ADR-2606012100
{:lexicon 1
 :id "com.etzhayyim.okaimono.product"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["productId" "title" "ring" "source" "sourcing"]
    :properties
    {:productId        {:type "string"}
     :title            {:type "string"}
     :ring             {:type "string" :description "commons|internal|external"}
     :commonsMode      {:type "string" :description "Ring 0 only: borrow|repair|secondhand|surplus"}
     :unspsc           {:type "string"}
     :gtin             {:type "string"}
     :makerActor       {:type "string" :description "internal ring: producing etzhayyim actor id"}
     :source           {:type "string" :description "internal-actor|open-standard|vendor-direct|api-data-only|scraped"}
     :priceMinor       {:type "integer"}
     :currency         {:type "string" :description "ISO-4217; internal=USDC"}
     :durabilityYears  {:type "number"}
     :repairability    {:type "integer" :description "0..10 (iFixit-style)"}
     :laborProvenance  {:type "string" :description "etzhayyim-dignity|verified-fair|disclosed|unknown"}
     :carbonKg         {:type "number"}
     :lifecycleRoute   {:type "string" :description "hodoki|kanayama|haraedo|wakai|commons-return"}
     :retailerUrl      {:type "string" :description "external ring: AFFILIATE-STRIPPED retailer deep-link (G3)"}
     :availability     {:type "string" :description "external ring: in-stock|out-of-stock|preorder|unknown"}
     :tariffBps        {:type "integer" :description "external ring: cross-border tariff (basis points)"}
     :sourcing         {:type "string" :description "authoritative|representative"}}}}}}
