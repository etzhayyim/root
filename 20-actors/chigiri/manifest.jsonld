    "judicialPartyRedaction": "pymagatama.organism.sensors.legal.judicial_party_redactor (per-jurisdiction publication-redaction policy)",
    "inferencePath": "Murakumo only (ADR-2605215000) — judah LiteLLM 127.0.0.1:4000 → gemma4:e4b; NO vendor LLM API callout"
  },
  "constitutionalGates": {
    "description": "14 immutable gates per ADR-2605262700. Council Lv6+ supermajority + new ADR to amend (Lv7+ if constitutional invariant per Preamble §0.4).",
    "gates": {
      "G1": "Every legal document MUST pass Charter Rider §2(a)-(h) scan (etzhayyim_organism.sensors.charter_rider.scan); fail = block",
      "G2": "Every procedure MUST emit app.etzhayyim.chigiri.* Lexicon record with yatachain attestation lineage; missing = invisible",
      "G3": "Internal procedure MUST NOT require state-issued personal ID (DID + SBT only); state ID at external interface only",
      "G4": "Charter Rider amendment = Council Lv6+ ≥4/7",
      "G5": "Constitutional invariant amendment = Council Lv7+ unanimity (Preamble §0.4)",
      "G6": "Community governance decision = 1 SBT = 1 vote; plutocratic vote weighting prohibited",
      "G7": "Defensive Just War only — refuse to attest offensive force authorization; structural enforcement on posture ∈ {defensive, deterrent}",
      "G8": "Open-source legal templates only (Apache 2.0 + Charter Rider); no proprietary clauses; no NDAs",
      "G9": "Multi-jurisdictional fallback — procedures MUST NOT depend on a single state's religious-freedom protection",
      "G10": "Cooperative mediation precedes adversarial arbitration; disputeMediation schema enforces ≥1 mediation round before arbitration",
      "G11": "Murakumo-only inference (ADR-2605215000); no vendor LLM API callout",
      "G12": "Excommunication = Council Lv6+ ≥4/7 + 30-day cure period; schema enforces curePeriodEndsAt > createdAt + 30d",
      "G13": "Volunteer ≠ employee per ADR-2605261000; stewardLaborAttestation schema enforces L0..L6 classification; constructive-employment drift detection continuous",
      "G14": "UPL strictly prohibited; chigiri MUST NOT render legal advice; lint hook 70-tools/scripts/lint/no-chigiri-legal-advice.mjs scans code"
    }
  },
  "nonGoals": {
    "description": "12 explicitly excluded scopes",
    "goals": {
      "N1": "NOT a commercial law firm; no fee-for-service",
      "N2": "NOT a state-granted legal personality (一般社団 / NPO / 公益財団 / 宗教法人 法人格 NEVER per Preamble §0.4)",
      "N3": "NOT offensive force legal cover",
      "N4": "NOT a tax-avoidance scheme designer",
      "N5": "NOT a member surveillance system",
      "N6": "NOT commercial litigation representation (external counsel via Public Fund)",
      "N7": "NOT a closed-source template repository",
      "N8": "NOT a centralized enforcement authority (Council + 1 SBT = 1 vote only)",
      "N9": "NOT representation of non-members",
      "N10": "NOT fee-for-service",
      "N11": "NOT adversarial-first (mediation MANDATORY before arbitration)",
      "N12": "NOT dependent on a single jurisdiction's recognition"
    }
  },
