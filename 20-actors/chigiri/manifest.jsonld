  "@type": "ActorManifest",
  "id": "did:web:chigiri.etzhayyim.com",
  "name": "chigiri",
  "displayName": "契 — Covenant (legal procedure substrate)",
  "displayNameJa": "契",
  "displayNameEn": "Chigiri",
  "description": "Non-profit religious-corp legal procedure substrate. Procedural template + on-chain attestation + routing substrate for the 任意団体 internal procedures, external state-system interfaces, and Charter §1.12 state-function routing-around. NOT a commercial law firm and NOT an unauthorized practice of law (UPL constitutionally prohibited per G14). 12 cells / 9 Lexicons under app.etzhayyim.chigiri.* / 14 immutable gates / 12 non-goals. Consumes the global legal corpus from ADR-2605262800 (statutes / cases / treaties / procedures / templates). Replaces the legacy lawfirm.etzhayyim.com reference in hanrei.",
  "descriptionJa": "非営利 religious-corp の法的手続き substrate。任意団体 内部手続き + 国家システム interface + Charter §1.12 国家機能 routing-around を、手続きテンプレート + on-chain attestation + routing substrate として提供。商業 law firm ではなく、法律相談 (UPL) は G14 で構造的に禁止。12 cells / 9 Lexicons / 14 不変ゲート / 12 non-goals。Global legal corpus (ADR-2605262800) を消費。hanrei が参照していた lawfirm.etzhayyim.com を religious-corp ネイティブに置換。",
  "adr": {
    "master": "etzhayyim:adr:2605262700",
    "parent": "etzhayyim:adr:2605192100",
    "r0": "etzhayyim:adr:2605262700",
    "r1": "reserved",
    "r2": "reserved",
    "r3": "reserved"
  },
  "tier": "Tier-B",
  "parentActor": null,
  "crossActorData": [
    "did:web:hanrei.etzhayyim.com",
    "did:web:bunken.etzhayyim.com"
  ],
  "lexiconReadAccess": {
    "app.etzhayyim.gov.dataset.parliamentRecord": "ADR-2605263900; READ-ONLY publicly-recorded parliament procedure citations for Charter §1.12 state-function-routing-around evidence base. covenant_ceremony + inheritance + withdrawal cells cite publicly-recorded state procedure as substitution context — never as internal dependency per N2 (no state-granted legal personality). CN-sourced records carry stateAlignedFlag=true which chigiri MUST display in any derived document.",
    "app.etzhayyim.gov.dataset.openDatasetAttestation": "ADR-2605263900; READ-ONLY per-jurisdiction open-data portal catalog. Supports multi-jurisdictional template selection for tax_receipt + data_privacy + ip_licensing cells when state-published reference data is the most current source. UPL boundary preserved per G14 — chigiri renders procedure templates, NOT legal advice on those datasets.",
    "app.etzhayyim.corp.registryAttestation": "ADR-2605263800; READ-ONLY per-jurisdiction legal-entity registry for entity-identity verification before vendor-contract Rider scrutiny + ipLicenseClaim recipient validation. LEI cross-link via app.etzhayyim.corp.leiReference for cross-jurisdictional resolution.",
    "app.etzhayyim.corp.leiReference": "ADR-2605263800; READ-ONLY GLEIF LEI canonical for cross-jurisdiction entity-identity verification in ip_licensing + employment_compliance cells. CC0 1.0 license. Vendor commercial-terminal imports — Bloomberg Terminal / Refinitiv / FactSet / Moody's Orbis / D&B / Pitchbook / Crunchbase Pro — CONSTITUTIONALLY PROHIBITED per Charter Rider §2(e)+§2(c)."
  },
  "crossActorProcedure": [
    "did:web:musubi.etzhayyim.com (future — covenant ceremony)",
    "did:web:shidemori.etzhayyim.com (future — memorial / cemetery)",
    "did:web:mitate.etzhayyim.com (medical attestation interop)",
