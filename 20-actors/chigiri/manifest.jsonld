  "dataSubstrate": {
    "ingestion": "ADR-2605262800 — global legal corpus (statutes / cases / treaties / procedures / templates) via IPFS-pinned DataLad subdatasets",
    "buckets": [
      "90-docs/baien/datasets/law/statutes/",
