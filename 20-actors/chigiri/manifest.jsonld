  ],
  "replaces": "Legacy lawfirm.etzhayyim.com reference in 20-actors/hanrei/CLAUDE.md (religious-corp native, Murakumo-only, SBT-gated, Charter Rider §2-compliant; no gftd lineage)",
  "form": "任意団体 internal procedure substrate (NOT 一般社団 / NPO / 公益財団 / 宗教法人 法人格 — Preamble §0.4 Lv7+ unanimity lock)",
  "uplProhibition": {
    "constitutional": true,
    "rule": "chigiri MUST NOT render legal advice. Templates document procedure; advice happens via human counsel contracted through Public Fund per ADR-2605192145 (Council Lv6+ approval).",
    "structuralEnforcement": "Lint hook 70-tools/scripts/lint/no-chigiri-legal-advice.mjs (Wave 1) scans chigiri code for advice-issuing language; CI-blocks on hit."
  },
  "scope": {
    "phase": "R0 scaffold",
    "scopeBoundary": "Procedural substrate (internal + external + routing-around + force + content + financial + steward labor)",
    "exclusions": [
      "legal advice rendering (UPL prohibited per G14)",
      "commercial law firm operations",
      "fee-for-service legal work",
      "litigation representation (external counsel via Public Fund)",
      "state-granted legal personality acquisition (Preamble §0.4 invariant)",
      "tax-avoidance scheme design",
      "member surveillance beyond procedural necessity",
      "central enforcement authority (Council + 1 SBT = 1 vote only)",
      "non-member representation",
      "single-jurisdiction-recognition dependence",
      "adversarial-first dispute handling (mediation precedes)",
      "vendor LLM API callout (Murakumo-only)"
    ]
  },
