namespace kakao_talk {

    entity Token {
        id: string @unique
        accessToken: string
        tokenType: string
        expiresIn: integer
        refreshToken: string
        refreshTokenExpiresIn: integer
        scope: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity KakaoAccount {
        id: string @unique
        email: string
        ageRange: string
        birthday: string
        birthdayType: string
        isLeapMonth: boolean
        gender: string
        birthyear: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Profile {
        id: string @unique
        nickname: string
        thumbnailImageUrl: string
        profileImageUrl: string
        isDefaultImage: boolean
        createdAt: datetime
        updatedAt: datetime
    }

}
