{:lexicon 1
 :id "com.etzhayyim.funamori.salinityGradientSiteAttestation"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :description "River-mouth salinity-gradient site attestation — mizuho waterSupplySourceRegistry + Δsalinity baseline + estuarine ecosystem (ADR-2605265600 §1.3/§1.4/§6)"
    :required ["siteId" "drawGl" "feedGl" "salinityDiffGl" "technology" "ratedKw" "mizuhoAttested" "createdAt"]
    :properties
    {:siteId {:type "string"}
     :glyph {:type "string"}
     :drawGl {:type "number" :description "海水側 salinity g/L"}
     :feedGl {:type "number" :description "河川側 salinity g/L"}
     :salinityDiffGl {:type "number" :minimum 30
                      :description "G4 — Δsalinity ≥30 g/L required; brackish ≤15 g/L deferred R4+ (§1.4)"}
     :technology {:type "string" :enum ["pro" "red"] :description "PRO≥35 g/L deep estuary / RED intermediate (§1.7)"}
     :ratedKw {:type "number" :maximum 50
               :description "G6 — ≤50 kW per site, ≤1 site through R3 (§1.9 / parent §4)"}
     :mizuhoAttested {:type "boolean"
                      :description "G7 — mizuho.waterSupplySourceRegistry attested + Council Lv6+ ≥3 estuary baseline (§1.3)"}
     :estuaryBaselineCid {:type "string" :description "estuarine ecosystem baseline content-addressed CID"}
     :landsParcel {:type "string" :description "ADR-2605192330 marine parcel id"}
     :createdAt {:type "string" :format "datetime"}}}}}}
