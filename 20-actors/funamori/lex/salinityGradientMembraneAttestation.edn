{:lexicon 1
 :id "com.etzhayyim.funamori.salinityGradientMembraneAttestation"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :description "PRO/RED membrane attestation — technology + open-publication membrane formula CID + power-density characterization (ADR-2605265600 §1.1/§1.2/§6)"
    :required ["membraneId" "technology" "vendor" "chemistry" "license" "pfasFree" "createdAt"]
    :properties
    {:membraneId {:type "string"}
     :technology {:type "string" :enum ["pro" "red" "hybrid"]}
     :vendor {:type "string" :description "G2 — Toray/Hydranautics/GE-Power/Statkraft PROHIBITED (§2)"}
     :chemistry {:type "string" :description "e.g. tfc-polyamide-on-polysulfone (PRO) / speek-sulfonated (RED)"}
     :license {:type "string" :enum ["in-house" "open-publication" "openmta" "apache-2.0"]
               :description "G1 — open-publication OR in-house mandatory (§1.1)"}
     :formulaCid {:type "string" :description "open-publication 公開膜処方 (polymer+crosslinker+casting-solvent+post-treatment) content-addressed CID"}
     :pfasFree {:type "boolean" :const true :description "G3 invariant — PFAS/Nafion prohibited (§1.2 / Charter §2(c)); always true"}
     :powerDensityWm2 {:type "number" :description "characterized power density (W/m²); G5 R3 floor ≥1.0 (§1.6)"}
     :createdAt {:type "string" :format "datetime"}}}}}}
