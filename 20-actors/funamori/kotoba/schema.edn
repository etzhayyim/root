;; funamori (舫) kotoba EAVT schema — 淡水化発電 / salinity-gradient power (PRO/RED)
;; ADR-2605265600 (sub-ADR of 2605264100 §4) · R0
;; State is kotoba EAVT Datoms (:funamori.salinity.*); no SQL/RisingWave/Cypher.
[;; ── river-mouth site (mizuho R2+ attested) ──────────────────────────────────
 {:db/ident :funamori.site/id            :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :funamori.site/glyph         :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :funamori.site/draw-g-l      :db/valueType :db.type/double  :db/cardinality :db.cardinality/one} ;; 海水側 g/L
 {:db/ident :funamori.site/feed-g-l      :db/valueType :db.type/double  :db/cardinality :db.cardinality/one} ;; 河川側 g/L
 {:db/ident :funamori.site/temp-k        :db/valueType :db.type/double  :db/cardinality :db.cardinality/one}
 {:db/ident :funamori.site/salinity-diff-g-l :db/valueType :db.type/double :db/cardinality :db.cardinality/one}
 {:db/ident :funamori.site/technology    :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one} ;; :pro | :red | :defer
 {:db/ident :funamori.site/rated-kw      :db/valueType :db.type/double  :db/cardinality :db.cardinality/one} ;; ≤50 (§1.9)
 {:db/ident :funamori.site/mizuho-attested :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one} ;; §1.3 waterSupplySourceRegistry
 {:db/ident :funamori.site/estuary-baseline-cid :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :funamori.site/lands-parcel  :db/valueType :db.type/string  :db/cardinality :db.cardinality/one} ;; ADR-2605192330 marine parcel
 {:db/ident :funamori.site/permitted     :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}

 ;; ── membrane attestation (open-publication / in-house; §1.1/§1.2/§2) ─────────
 {:db/ident :funamori.membrane/id        :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :funamori.membrane/type      :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one} ;; :pro | :red
 {:db/ident :funamori.membrane/vendor    :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :funamori.membrane/chemistry :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :funamori.membrane/license   :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one} ;; :in-house|:open-publication|:openmta|:apache-2.0
 {:db/ident :funamori.membrane/formula-cid :db/valueType :db.type/string :db/cardinality :db.cardinality/one} ;; open-publication 公開膜処方 CID
 {:db/ident :funamori.membrane/pfas-free  :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}
 {:db/ident :funamori.membrane/permitted :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}

 ;; ── power-density characterization (§1.6 R3 ≥1 W/m² ゲート) ───────────────────
 {:db/ident :funamori.measure/id         :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
