 {:db/ident :funamori.measure/meets-r3-gate :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}
 {:db/ident :funamori.measure/witness-quorum :db/valueType :db.type/long :db/cardinality :db.cardinality/one} ;; Council Lv6+ ≥3

 ;; ── annual review (silenSalinityGradientReview; §1.10) ───────────────────────
 {:db/ident :funamori.review/id          :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
