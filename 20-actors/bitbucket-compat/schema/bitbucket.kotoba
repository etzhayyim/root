// Bitbucket clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace bitbucket {

    entity Repository {
        id: string @unique
        uuid: string
        fullName: string
        name: string
        description: string
        isPrivate: boolean
        scm: string
        size: integer
        language: string
        hasIssues: boolean
        hasWiki: boolean
        forkPolicy: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity PullRequest {
        id: string @unique
        title: string
        state: string
        commentCount: integer
        taskCount: integer
        closeSourceBranch: boolean
        reason: string
        draft: boolean
        queued: boolean
        mergeable: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Commit {
        id: string @unique
        hash: string
        date: datetime
        message: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Workspace {
        id: string @unique
        uuid: string
        name: string
        slug: string
        isPrivate: boolean
        isPrivacyEnforced: boolean
        forkingMode: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Issue {
        id: string @unique
        title: string
        state: string
        kind: string
        priority: string
        votes: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Project {
        id: string @unique
        uuid: string
        key: string
        name: string
        description: string
        isPrivate: boolean
        hasPubliclyVisibleRepos: boolean
        createdAt: datetime
        updatedAt: datetime
    }

}
