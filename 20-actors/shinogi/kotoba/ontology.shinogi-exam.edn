;; shinogi 鎬 — exam-competition involution ontology (kotoba EAVT schema, ADR-2606291200)
;;
;; The ANALYSIS-ONLY societal-systems-dynamics observer (the junkan 循環 method,
;; ADR-2605290927) applied to ONE question: which concrete policies / institutions
;; / practices / norms in a country's high-stakes examination system (China 高考 /
;; Korea 수능 / Japan 受験 / India JEE-NEET, …) INTENSIFY or RELIEVE the involution
;; (内卷) — the zero-sum effort arms-race — and the FAILURE cycle (受験失敗 →
;; stigma → wellbeing erosion → lost opportunity)? Each driver feeds a pressure
;; STOCK with a polarity; shinogi reads off which feedback LOOPS are spinning
;; 悪循環/好循環 + Meadows leverage candidates. It may ONLY look, never touch
;; (G4 — no outward channel; enforced by ABSENCE of any dispatch path).
;;
;; 名 鎬 (shinogi): 「鎬を削る」= to grind the ridge of one's blade against
;; another's — the idiom for fierce mutual competition that wears everyone down
;; for no relative gain. That is exactly 内卷 / involution: effort inflates, the
;; ranking is unchanged, the blades grow thin. shinogi maps that grinding spiral
;; SOBERLY, as a relief/leverage MAP — never a ranking-to-shame, never a roster of
;; "failing students" (G7 + G8).
;;
;; Discipline carried into the data model:
;;   G4  analysis-only — output is append-only findings + a local ledger; no actuation.
;;   G5  no causal overclaim — every loop/edge is :hypothesis (`:hypothesis? true`),
;;       correlation/structural-sign only, NEVER proven causation.
;;   G6  aggregate-only — drivers + INSTITUTIONAL/public enactors only; NEVER a
;;       private individual, NEVER a per-student record, NO PII, NO exam scores of
;;       any person (the junkan/danjo "on-record basis only" pattern).
;;   G7  wellbecoming-positive / non-eschatological — the failure cycle is stated
;;       SOBERLY and routed toward RELIEF (kokoro/shiori), never despair-amplified,
;;       never doom framing (§1.13 + §1.15).
;;   G8  relief/leverage MAP — never a student shame-list, school shame-ranking,
;;       or country ranking-to-shame.
;;   G9  append-only / immutable datoms.
;;   G11 no prescription — leverage points are CANDIDATES with uncertainty
;;       (`:prescription? false`), never directives.
;;
;; Attribute namespaces:
;;   :shinogi.exam.driver/*  — disclosed driver facts (policy/institution/practice/norm)
;;   :shinogi.exam.stock/*   — DERIVED pressure-stock aggregates + regime
;;   :shinogi.exam.loop/*    — DERIVED loop regime (hypothesis only)
;;   :shinogi.exam.era/*     — DERIVED temporal trajectory (intensify/relieve force per era)
;;   :shinogi/derived        — true on every derived datom
;;   :shinogi/sourcing       — ":authoritative" | ":representative" | ":synthetic"
;;   :shinogi/hypothesis     — ":true" on every loop/regime read-off (G5)

{:ontology/id "shinogi-exam"
 :ontology/version "0.1.0"
 :ontology/adr ["2606291200" "2605290927" "2605192100" "2605262130" "2605312345"]

 :node-kinds
 [{:kind :driver
   :doc "A concrete policy / institution / practice / norm that shapes the exam-competition involution + failure cycle."
   :keys [:id :name :jurisdiction :kind :year
          :enactor :origin :stakeholders            ;; 誰が定めたか / 経緯 / 関係者
          :stock :polarity :magnitude :reversibility :meadows
          :basis :sourcing :confidence :note]}]

 :enums
 {;; which pressure STOCK a driver feeds (the A–F structural categories)
  :stock        #{:positional-scarcity      ;; A 選抜の希少性 — zero-sum seats vs aspirants
                  :effort-inflation         ;; B 努力の軍拡 — hours/spend treadmill (内卷 core)
                  :credential-signaling     ;; C 学歴シグナル依存 — 文凭 inflation
                  :wellbeing-erosion        ;; D 心身ウェルビーイングの侵食 — sleep/anxiety/burnout
                  :family-capture           ;; E 家計資源の捕獲 — household spend/debt/expectation
                  :failure-penalty}         ;; F 失敗ペナルティ — stigma / no 敗者復活 (the failure cycle)
  ;; does the driver INTENSIFY the involution/pressure, RELIEVE it, or is it ambiguous
  :polarity     #{:intensify :relieve :ambiguous}
  ;; kind of driver
  :kind         #{:policy :institution :practice :norm}
  ;; how the driver could be flipped — informs which Meadows level applies
  :reversibility #{:policy :institutional :market :cultural :entrenched}
  ;; loop regime read-off (G5 hypothesis)
  :regime       #{:vicious :virtuous :neutral :transitioning}
  :loop-type    #{:reinforcing :balancing}
  :sourcing     #{:authoritative :representative :synthetic}}

 ;; canonical STRUCTURAL loops (HYPOTHESES, G5) linking the pressure stocks.
 ;; A loop's regime is read off the JOINT pressure of ALL its member stocks.
 :loops
 [{:id "R-involution-arms-race" :type :reinforcing :dominant-stock :effort-inflation
   :edges [[:positional-scarcity :effort-inflation :pos]
           [:effort-inflation :positional-scarcity :pos]]
   :doc "内卷: scarce seats → more effort → a higher baseline that re-creates effective scarcity → more effort (悪循環 when intensifying). No one advances; the spiral persists."}
  {:id "R-credential-inflation" :type :reinforcing :dominant-stock :credential-signaling
   :edges [[:credential-signaling :effort-inflation :pos]
           [:effort-inflation :credential-signaling :pos]]
   :doc "文凭インフレ: degrees signal less → chase more credentials → still more inflation."}
  {:id "R-family-capture" :type :reinforcing :dominant-stock :family-capture
   :edges [[:family-capture :effort-inflation :pos]
           [:effort-inflation :family-capture :pos]]
   :doc "家計の課金軍拡: status anxiety → shadow-education spend → arms-race → more anxiety/spend."}
  {:id "R-failure-despair" :type :reinforcing :dominant-stock :failure-penalty
   :edges [[:failure-penalty :wellbeing-erosion :pos]
           [:wellbeing-erosion :failure-penalty :pos]]
   :doc "受験失敗の system cycle: a single-shot loss → stigma + identity damage → wellbeing erosion → reduced next-attempt capacity/opportunity → reinforced penalty (悪循環). The cycle shinogi routes toward RELIEF (kokoro/shiori), never amplifies (G7)."}
  {:id "B-alternative-pathways" :type :balancing :dominant-stock :positional-scarcity
   :edges [[:positional-scarcity :positional-scarcity :neg]]
   :doc "敗者復活/代替経路: de-stigmatized vocational tracks, multiple attempts, holistic admission, and decoupling jobs from one exam push the scarcity stock back toward balance."}
  {:id "B-wellbeing-protection" :type :balancing :dominant-stock :wellbeing-erosion
   :edges [[:wellbeing-erosion :wellbeing-erosion :neg]]
   :doc "ウェルビーイング保護: load-reduction (双減), exam-stakes lowering, study-hour limits, and mental-health support push the wellbeing stock back toward balance."}]

 ;; Meadows' 12 leverage levels (referenced, not vendored) — lower number = deeper leverage.
 :meadows-levels
 {12 "Constants, parameters, numbers"
  11 "Buffer sizes"
  10 "Stock-and-flow structures"
  9  "Delays"
  8  "Balancing feedback loops"
  7  "Reinforcing feedback loops"
  6  "Information flows (who has access to what)"
  5  "Rules (incentives, punishments, constraints)"
  4  "Self-organization (power to add/change structure)"
  3  "Goals of the system"
  2  "Mindset/paradigm out of which the system arises"
  1  "Power to transcend paradigms"}

 ;; negative space — structurally absent (enforced by tests)
 :unrepresentable
 [":shinogi/actuate"             ;; G4 — shinogi never touches; no outward channel
  ":shinogi/dispatch"            ;; G4 — no post/mention/email/tx
  ":shinogi.exam.driver/person"        ;; G6 — no private-individual modeling
  ":shinogi.exam.student/score"        ;; G6 — never a per-student exam score / record
  ":shinogi.exam.student/ranking"      ;; G8 — never a student / school shame-ranking
  ":shinogi.exam.loop/proven-cause"    ;; G5 — never proven causation; loops are hypotheses
  ":shinogi/prescription"]}      ;; G11 — leverage points are candidates, never directives
