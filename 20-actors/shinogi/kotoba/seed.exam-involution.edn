 ;; CHINA 高考 — the primary subject
 ;; ═════════════════════════════════════════════════════════════════════════════
 {:type :driver :id "cn-gaokao" :name "普通高等学校招生全国统一考试 (Gaokao)" :jurisdiction "CN" :kind :institution :year 1952
  :enactor "Ministry of Education of the PRC (instituted 1952; suspended 1966–1976 in the Cultural Revolution; restored 1977 under Deng Xiaoping)"
  :origin "A single, once-a-year, nationally-unified university entrance examination. Restored in 1977 as a meritocratic access channel; in its current single-shot high-stakes form it concentrates a cohort's life chances into a few days, funneling ~13M annual candidates toward a fixed elite-seat pool."
  :stakeholders ["Ministry of Education" "provincial exam authorities" "~13M annual candidates" "families" "universities"]
  :stock :positional-scarcity :polarity :intensify :magnitude 0.8 :reversibility :entrenched :meadows 5
  :basis "教育部 高校招生统一考试制度 (1952/1977–)" :sourcing :representative :confidence 0.7}

 {:type :driver :id "cn-985-211-dfc" :name "985 / 211 / 双一流 university tiering" :jurisdiction "CN" :kind :institution :year 1995
  :enactor "State Council / Ministry of Education (Project 211 1995; Project 985 1998; Double First-Class 2017)"
  :origin "State programmes concentrating funding + prestige into a small set of universities. The sharp tiering turns admission into a steep prestige cliff, so the marginal value of one more point near the cutoff is enormous — sharpening the zero-sum scramble."
  :stakeholders ["State Council" "Ministry of Education" "tier-1 universities" "employers screening by tier" "candidates"]
  :stock :credential-signaling :polarity :intensify :magnitude 0.7 :reversibility :institutional :meadows 5
  :basis "211工程 (1995) / 985工程 (1998) / 双一流 (2017)" :sourcing :representative :confidence 0.6}

 {:type :driver :id "cn-hukou-quota" :name "户籍-linked provincial admission quotas" :jurisdiction "CN" :kind :policy :year 1977
  :enactor "Ministry of Education + provincial governments (quota system tied to the 户籍 household-registration regime)"
  :origin "University places are allocated by provincial quota and scored against one's registered province, so the effective cutoff varies sharply by hukou. The same score yields very different chances by province — a structural barrier that locks families into place-bound competition."
  :stakeholders ["provincial education bureaus" "户籍 holders" "migrant families" "universities"]
  :stock :positional-scarcity :polarity :intensify :magnitude 0.6 :reversibility :institutional :meadows 5
  :basis "分省定额录取 / 户籍制度 (1958–; applied to 高考 admission)" :sourcing :representative :confidence 0.55}

 {:type :driver :id "cn-shuangjian-2021" :name "双减 (Double Reduction) policy" :jurisdiction "CN" :kind :policy :year 2021
  :enactor "General Office of the CPC Central Committee + State Council (2021 双减 Opinion)"
  :origin "Banned for-profit academic tutoring for compulsory-education grades, capped homework, and limited weekend/holiday cramming — an explicit state attempt to deflate the shadow-education arms race and ease household burden. Effect is contested: some tutoring moved underground/one-to-one, so the relief is partial."
  :stakeholders ["CPC Central Committee" "State Council" "tutoring firms (新东方/好未来)" "families" "students"]
  :stock :family-capture :polarity :relieve :magnitude 0.5 :reversibility :policy :meadows 5
  :basis "关于进一步减轻义务教育阶段学生作业负担和校外培训负担的意见 (2021)" :sourcing :representative :confidence 0.5
  :note "Contested effect — drove some tutoring underground; relief is partial, not complete."}

 {:type :driver :id "cn-fudu-repeat" :name "复读 (repeat-year retake) culture" :jurisdiction "CN" :kind :practice :year 1977
  :enactor "Sustained by 复读 schools + families (no single enactor; an emergent response to the single-shot exam)"
  :origin "Because the gaokao is once-a-year and decisive, large numbers of candidates repeat the final year to retake it, adding a year of intensive cramming. The retake option both relieves a single failure AND inflates the effective effort everyone must match."
  :stakeholders ["复读 schools" "repeat candidates (往届生)" "families" "first-time candidates competing against them"]
  :stock :effort-inflation :polarity :intensify :magnitude 0.55 :reversibility :cultural :meadows 6
  :basis "复读 / 往届生 高考 participation (1977–)" :sourcing :representative :confidence 0.5}

 {:type :driver :id "cn-hengshui-model" :name "衡水模式 (exam-factory high schools)" :jurisdiction "CN" :kind :practice :year 2000
  :enactor "Exam-factory high schools (衡水中学 archetype) emulated nationwide; tolerated by local education bureaus for results"
  :origin "Highly regimented, militarized boarding schools optimizing every waking minute for gaokao score. The model's measurable success pressures other schools to emulate it, ratcheting up baseline study intensity and eroding sleep/rest."
  :stakeholders ["exam-factory schools" "local education bureaus" "students under regimented schedules" "parents seeking results"]
  :stock :wellbeing-erosion :polarity :intensify :magnitude 0.6 :reversibility :cultural :meadows 4
  :basis "衡水中学 model + nationwide emulation (c.2000–)" :sourcing :representative :confidence 0.5}

 {:type :driver :id "cn-neijuan-norm" :name "内卷 (involution) social norm" :jurisdiction "CN" :kind :norm :year 2018
  :enactor "Emergent cultural norm (no enactor); names the phenomenon — entered mass usage c.2018–2020"
  :origin "The normalization of zero-sum over-competition where everyone must invest ever more just to hold position. As a shared expectation it makes non-participation feel irrational, sustaining the arms race at the level of mindset (a deep Meadows leverage point)."
