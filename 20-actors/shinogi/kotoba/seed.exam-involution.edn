  :stock :effort-inflation :polarity :intensify :magnitude 0.5 :reversibility :cultural :meadows 2
  :basis "内卷 (involution) as mass-cultural concept (c.2018–)" :sourcing :representative :confidence 0.5}

 {:type :driver :id "cn-tangping-counter" :name "躺平 (lying flat) counter-norm" :jurisdiction "CN" :kind :norm :year 2021
  :enactor "Emergent youth counter-norm (no enactor); spread online 2021"
  :origin "A refusal/withdrawal stance — declining to run the arms race — that functions as a pressure-release valve on individual wellbeing and effort, while also signaling distress. Ambiguous: it eases the treadmill for those who opt out but is itself a symptom of the spiral."
  :stakeholders ["youth" "online communities" "employers" "state media (critical of it)"]
  :stock :wellbeing-erosion :polarity :relieve :magnitude 0.25 :reversibility :cultural :meadows 2
  :basis "躺平 (lying flat) movement (2021–)" :sourcing :representative :confidence 0.4
  :note "Ambiguous — a relief valve AND a distress signal; modeled as low-magnitude relief."}

 {:type :driver :id "cn-puzhi-fenliu" :name "普职分流 (academic / vocational streaming)" :jurisdiction "CN" :kind :policy :year 1985
  :enactor "Ministry of Education (vocational-streaming targets; ~50% diversion at upper-secondary, reaffirmed in the 2022 Vocational Education Law)"
  :origin "A large share of students are diverted after the 中考 (junior-high exam) into vocational rather than academic high school. In principle an alternative pathway, but vocational tracks carry stigma and weaker university access, so the 中考 becomes an early, high-stakes sort that intensifies pressure and failure penalty."
  :stakeholders ["Ministry of Education" "中考 candidates" "vocational high schools" "families fearing the vocational track"]
