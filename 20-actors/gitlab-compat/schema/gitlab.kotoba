// Gitlab clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace gitlab {

    entity Repository {
        id: string @unique
        name: string
        owner: string
        defaultBranch: string
        private: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Pipeline {
        id: string @unique
        repoId: string
        name: string
        trigger: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Build {
        id: string @unique
        pipelineId: string
        number: integer
        status: string
        commitSha: string
        durationMs: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Artifact {
        id: string @unique
        buildId: string
        name: string
        sizeBytes: integer
        contentRef: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Deployment {
        id: string @unique
        buildId: string
        environment: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Webhook {
        id: string @unique
        repoId: string
        url: string
        event: string
        active: boolean
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
