// Iterable clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace iterable {

    entity Campaign {
        id: string @unique
        name: string
        campaignState: string
        type: string
        createdAt: integer
        endedAt: integer
        startAt: integer
        sendSize: integer
        templateId: integer
        workflowId: integer
        messageMedium: string
        createdByUserId: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Channel {
        id: string @unique
        name: string
        channelType: string
        messageMedium: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Device {
        id: string @unique
        applicationName: string
        platform: string
        token: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Webhook {
        id: string @unique
        endpoint: string
        authType: string
        enabled: boolean
        blastSendEnabled: boolean
        triggeredSendEnabled: boolean
        createdAt: datetime
        updatedAt: datetime
    }

}
