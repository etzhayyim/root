;; soma 杣 — reference forest-stand seed (illustrative, :representative sourcing).
;; A small selective-harvest stand: trees with lean/diameter/species, exclusion
;; points (humans/road/watercourse), terrain slope, a price table, a forwarder.
;; Coords are metres in a landing-origin frame ([0 0] = the forwarder landing).
;; Per ADR-2606142010 (soma R0). No real stand; sim input only.
{:stand {:id "stand-ref-01" :name "reference selective-harvest stand" :sourcing :representative
         :slope-pct 18.0            ; terrain grade across the stand (%)
         :soil :firm}              ; :firm | :wet | :protected (regenerative gate, G2)

 ;; ── trees marked for selective harvest (杣 = the marked/worked forest) ─────────
 ;; :lean-deg   degrees of natural lean (0 = vertical)
 ;; :lean-az    azimuth (deg, 0 = +x) the crown leans toward
 ;; :diameter-m DBH (diameter at breast height)
 ;; :height-m   total tree height
 ;; :wind-az / :wind-mps   ambient wind vector at the stand
 ;; :protected / :no-cut   refusal flags (G7) — old-growth / protected species / seed-tree
 :trees
 [{:id "t-1" :species :pinus       :lean-deg 4.0  :lean-az 0.0   :diameter-m 0.45 :height-m 24.0 :wind-az 10.0 :wind-mps 2.0 :coord [12 4]}
  {:id "t-2" :species :picea       :lean-deg 8.0  :lean-az 90.0  :diameter-m 0.38 :height-m 21.0 :wind-az 95.0 :wind-mps 1.5 :coord [20 8]}
  {:id "t-3" :species :pinus       :lean-deg 2.0  :lean-az 180.0 :diameter-m 0.52 :height-m 27.0 :wind-az 175.0 :wind-mps 1.0 :coord [30 14]}
  {:id "t-4" :species :betula      :lean-deg 6.0  :lean-az 270.0 :diameter-m 0.30 :height-m 18.0 :wind-az 260.0 :wind-mps 2.5 :coord [8 20]}
  ;; an old-growth seed-tree retained for regeneration — felling MUST refuse (G7)
  {:id "t-keep" :species :quercus  :lean-deg 1.0  :lean-az 0.0   :diameter-m 0.90 :height-m 30.0 :wind-az 0.0  :wind-mps 1.0 :coord [40 25]
   :protected true :no-cut true}]

 ;; ── exclusion points (humans / road / watercourse) — fall-zone keep-out (G5) ──
 :exclusions
 [{:id "x-road"   :kind :road       :coord [60 0]}
  {:id "x-stream" :kind :watercourse :coord [5 60]}
  {:id "x-crew"   :kind :human      :coord [55 40]}]

 ;; ── cut-to-length log assortments: price by length class (currency/m³) ─────────
 ;; bucking the stem into these classes; sawlog pays more than pulp.
 :price-table
 [{:class :sawlog :length-m 5.0 :price 95.0}
  {:class :sawlog :length-m 4.0 :price 88.0}
  {:class :pulp   :length-m 3.0 :price 42.0}
  {:class :pulp   :length-m 2.0 :price 38.0}]

 ;; ── forwarder / skidder (electric; G2 zero-emission, low ground pressure) ─────
 :forwarder {:id "fwd-1" :kind :forwarder
             :max-grade-pct 35.0          ; refuse routes steeper than this (G2/safety)
             :ground-pressure-kpa 45.0    ; nominal track/tyre ground pressure
             :bearing-firm-kpa 80.0       ; firm-soil bearing limit
             :bearing-wet-kpa 30.0        ; wet/sensitive-soil bearing limit (lower)
             :reach-m 7.5}                ; grapple/boom reach (bucking feasibility)

 ;; ── a sample extraction route (segments to the landing) ──────────────────────
 :route {:id "route-1"
         :segments [{:from "t-1" :to "landing" :grade-pct 12.0 :length-m 14.0}
                    {:from "t-3" :to "landing" :grade-pct 28.0 :length-m 30.0}]}

 ;; ── day-operations fixtures (consumed by analyze/run-day full pipeline) ───────
 ;; processing head that delimbs felled stems (single-grip harvester head, G8)
 :head {:max-diameter-cm 60.0 :feed-rate-mps 5.0}
 ;; haul truck for the load-out leg (electric; payload + bunk-length limits)
 :truck {:max-weight-kg 24000.0 :max-length-m 13.0 :bunk-count 4}
 ;; graded log assortments to load + hand off to tatekata (bucked + delimbed)
 :assortments
 [{:log-id "l-1" :grade :sawlog :length-m 5.0 :weight-kg 9000.0 :volume-m3 0.42}
  {:log-id "l-2" :grade :sawlog :length-m 4.0 :weight-kg 8000.0 :volume-m3 0.31}
  {:log-id "l-3" :grade :pulp   :length-m 3.0 :weight-kg 7000.0 :volume-m3 0.18}
  {:log-id "l-4" :grade :pulp   :length-m 3.0 :weight-kg 6000.0 :volume-m3 0.15}]
 ;; the harvested area to prepare + replant (regenerative-only, G2)
 :replant {:area-ha 12.0 :species :cryptomeria :target-stems-per-ha 2500.0 :soil :wet}
 ;; terrain segments for the skid-trail / forest-road plan (landing → stand)
 :road {:landing "landing" :stand "stand"
        :segments [{:from "landing" :to "a" :grade-pct 8.0 :length-m 120.0}
                   {:from "a" :to "stand" :grade-pct 12.0 :length-m 80.0
                    :stream-crossing? true :culvert? true}
                   {:from "landing" :to "stand" :grade-pct 6.0 :length-m 260.0}]}}
