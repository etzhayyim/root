;; com.etzhayyim.soma.fellAttestation — lexicon (EDN form)
;; ADR-2606142010 · per-tree directional-felling + bucking + extraction attestation
{:lexicon 1
 :id "com.etzhayyim.soma.fellAttestation"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["fellId" "treeId" "standId" "machineId" "decision"]
    :properties
    {:fellId {:type "string" :description "unique felling-operation identifier"}
     :treeId {:type "string" :description "marked tree id (杣 = the marked/worked forest)"}
     :standId {:type "string" :description "forest-stand id"}
     :machineId {:type "string" :description "harvester/forwarder DID performing the operation"}
     :species {:type "string" :description "tree species (latin/common)"}
     :decision {:type "string" :description "felled | refused-protected | unsafe-no-clear-line"}
     :aimAz {:type "number" :description "intended fell aim azimuth (deg, 0=+x)"}
     :fallAz {:type "number" :description "predicted fall azimuth (deg) after lean + wind perturbation"}
     :hingeM {:type "number" :description "hinge holding-wood width left (m), steers the fall (G5)"}
     :diameterM {:type "number" :description "DBH (diameter at breast height, m)"}
     :heightM {:type "number" :description "tree height (m)"}
     :fallZoneRadiusM {:type "number" :description "fall-zone keep-out radius (≈1.5× height, m)"}
     :exclusionsClear {:type "boolean" :description "fall zone contained no human/road/watercourse (G5)"}
     :protected {:type "boolean" :description "protected species / old-growth / seed-tree — felling refused (G7)"}
     :stemLengthM {:type "number" :description "merchantable stem length bucked (m)"}
     :buckValue {:type "number" :description "cut-to-length bucked value (currency, sawlog>pulp)"}
     :extractionGradePct {:type "number" :description "max route grade for extraction (% — refused above machine max, G2)"}
     :soilClass {:type "string" :description "firm | wet | protected (regenerative bearing gate, G2)"}
     :timestamp {:type "string" :description "ISO-8601 attestation time"}}}}}}
