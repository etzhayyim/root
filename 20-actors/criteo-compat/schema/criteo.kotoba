namespace criteo {

    entity Ad {
        id: string @unique
        adSetId: string
        creativeId: string
        description: string
        endDate: datetime
        inventoryType: string
        name: string
        startDate: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Campaign {
        id: string @unique
        advertiserId: string
        goal: string
        name: string
        spendLimit: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity AdSet {
        id: string @unique
        name: string
        deliveryStatus: string
        frequency: string
        maximumImpressions: integer
        createdAt: datetime
        updatedAt: datetime
    }

}
