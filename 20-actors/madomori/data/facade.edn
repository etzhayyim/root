;; madomori 窓守 — reference building-façade seed (illustrative, :representative sourcing).
;; A high-rise office tower face modeled as a grid of glazing panes, with two
;; independent rope anchors (fall-arrest redundancy), a surface type, a wind reading,
;; and a façade-cleaning robot envelope. Coords/heights in metres.
;; Per ADR-2606142020 (madomori R0). No real building; sim input only.
{:facility {:id "tower-ref-01" :name "reference high-rise office tower" :sourcing :representative}

 ;; ── the building face (a single curtain-wall elevation) ────────────────────
 :face
 {:id "face-south"
  :height-m 120.0        ; ground → parapet
  :width-m  36.0
  :surface  :glass       ; :glass | :stone | :metal
  ;; pane grid: rows (bottom→top) × cols (left→right). Each pane is a unit of coverage.
  :rows 30
  :cols 12
  :pane-h-m 4.0          ; per-pane height
  :pane-w-m 3.0}         ; per-pane width

 ;; ── fall-arrest anchors (G5 — ≥2 independent anchors required for a descent) ──
 ;; Each anchor is an independent rooftop tie-back point.
 :anchors
 [{:id "anchor-a" :independent true :rated-kn 22.0}
  {:id "anchor-b" :independent true :rated-kn 22.0}]

 ;; ── live wind reading (G5 — work-stop threshold gate) ──────────────────────
 :wind {:speed-mps 6.0 :gust-mps 8.5 :stop-threshold-mps 10.0}

 ;; ── the robot envelope ─────────────────────────────────────────────────────
 ;; A BMU-suspended / façade-climbing cleaning unit.
 :robot
 {:id "madomori-unit-01"
  :mode :suction               ; :suction (façade-climbing) | :bmu (rope/cradle)
  :mass-kg 14.0                ; unit + payload mass borne by the adhesion system
  :suction-force-n 900.0       ; total available suction/adhesion force
  :pads 4                      ; independent suction pads
  :required-fos 2.5            ; required factor-of-safety on adhesion (G7)
  ;; water + cleaning-agent budget per pane (G2 — minimize)
  :water-l-per-pane 0.25
  :agent-ml-per-pane 4.0
  :agent :deionized-water-surfactant   ; G2 — no prohibited solvents
  ;; imagery (G3 — on-device only, NEVER off-device; no person/interior recognition)
  :imagery {:on-device-only true :recognition :pane-edge-only}}

 ;; ── day-ops fixtures (R1 full-pipeline run-day; geometric/structural only, G3) ──

 ;; multi-face campaign: a setback tower with three elevations to sequence.
 ;; Each face = purely positional access-point + a pane grid (no imagery/person).
 :faces
 [{:face-id :south :access-point [2 0]  :rows 30 :cols 12}
  {:face-id :east  :access-point [36 0] :rows 30 :cols 8}
  {:face-id :north :access-point [2 36] :rows 20 :cols 12}]

 ;; per-pane geometry shared across the campaign faces (metres)
 :pane {:pane-h-m 4.0 :pane-w-m 3.0}

 ;; working load borne by the descent rig (kN) — for anchor per-anchor load check
 :working-load-kn 4.0

 ;; rig anchors (anchor/* needs :rated-kn + :reachable?; two adequate, one short)
 :rig-anchors
 [{:anchor-id :a1 :rated-kn 12.0 :reachable? true}
  {:anchor-id :a2 :rated-kn 10.0 :reachable? true}
  {:anchor-id :a3 :rated-kn 6.0  :reachable? false}]

 ;; runoff/detergent capture water balance for one campaign day (litres / mL)
 :water {:applied-l 8.0 :captured-l 6.4 :detergent-ml 64.0}

 ;; a structural defect detected mid-sweep → tatekata repair handoff
 ;; (structural descriptor ONLY — pane id + defect kind + severity; no imagery, G3)
 :defect {:pane-id "p-12-04" :defect-kind :cracked-pane :severity :high}}
