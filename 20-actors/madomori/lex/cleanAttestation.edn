;; com.etzhayyim.madomori.cleanAttestation — lexicon (EDN form)
;; ADR-2606142020 · per-pass façade window-cleaning handling attestation
;; G3 STRUCTURAL: no imagery / interior / person / biometric field is representable here.
{:lexicon 1
 :id "com.etzhayyim.madomori.cleanAttestation"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["passId" "facilityId" "faceId" "robotId" "panesCleaned" "windPermitted" "adhesionSafe"]
    :properties
    {:passId {:type "string" :description "unique cleaning-pass identifier"}
     :facilityId {:type "string" :description "building id"}
     :faceId {:type "string" :description "façade elevation id"}
     :robotId {:type "string" :description "façade-cleaning unit DID performing the pass"}
     :robotMode {:type "string" :description "suction (façade-climbing) | bmu (rope/cradle)"}
     :panesCleaned {:type "integer" :description "count of panes covered in this pass"}
     :coverageComplete {:type "boolean" :description "every pane in the planned grid visited exactly once"}
     :pathLengthM {:type "number" :description "traversed coverage path length (m)"}
     :waterL {:type "number" :description "water consumed (L) — minimized per G2"}
     :agentMl {:type "number" :description "cleaning-agent consumed (mL) — minimized per G2"}
     :surface {:type "string" :description "glass | stone | metal (drives adhesion factor-of-safety)"}
     :peakWindMps {:type "number" :description "peak wind (speed or gust) during the pass (m/s)"}
     :windStopThresholdMps {:type "number" :description "work-stop threshold (m/s) — pass refused at/above it (G5)"}
     :windPermitted {:type "boolean" :description "wind envelope permitted the descent (G5 — false ⇒ no pass)"}
     :swayAmplitudeM {:type "number" :description "modeled rope/BMU sway amplitude at peak wind (m)"}
     :independentAnchors {:type "integer" :description "count of independent fall-arrest anchors (≥2 required, G5)"}
     :adhesionFos {:type "number" :description "achieved suction/adhesion factor-of-safety"}
     :requiredFos {:type "number" :description "required factor-of-safety on adhesion (G7)"}
     :adhesionSafe {:type "boolean" :description "adhesion margin met the required factor (G7 — false ⇒ no pass)"}
     :imageryOnDevice {:type "boolean" :description "imagery processed on-device only; never transmitted (G3 — always true)"}
     :timestamp {:type "string" :description "ISO-8601 attestation time"}}}}}}
