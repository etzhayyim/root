// Plaid clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace plaid {

    entity Item {
        id: string @unique
        institutionId: string
        status: string
        consentExpiresAt: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Account {
        id: string @unique
        itemId: string
        name: string
        type: string
        subtype: string
        currentBalance: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity Transaction {
        id: string @unique
        accountId: string
        amount: float
        currency: string
        category: string
        date: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Institution {
        id: string @unique
        name: string
        country: string
        products: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Identity {
        id: string @unique
        accountId: string
        ownerName: string
        email: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Liability {
        id: string @unique
        accountId: string
        type: string
        balance: float
        apr: float
        createdAt: datetime
        updatedAt: datetime
    }

}
