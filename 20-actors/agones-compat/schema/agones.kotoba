namespace agones {

    entity GameServer {
        id: string @unique
        state: string
        address: string
        nodeName: string
        reservedUntil: datetime
        container: string
        scheduling: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity GameServerPort {
        id: string @unique
        name: string
        portPolicy: string
        container: string
        containerPort: integer
        hostPort: integer
        protocol: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Fleet {
        id: string @unique
        replicas: integer
        readyReplicas: integer
        reservedReplicas: integer
        allocatedReplicas: integer
        scheduling: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity SdkServer {
        id: string @unique
        logLevel: string
        grpcPort: integer
        httpPort: integer
        createdAt: datetime
        updatedAt: datetime
    }

}
