namespace aws_braket {

    entity ExecutionWindow {
        id: string @unique
        executionDay: string
        windowStartHour: string
        windowEndHour: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity DeviceServiceProperties {
        id: string @unique
        deviceLocation: string
        updatedAt: datetime
        getTaskPollIntervalMillis: integer
        shotsRangeMin: integer
        shotsRangeMax: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity TaskMetadata {
        id: string @unique
        shots: integer
        deviceId: string
        createdAt: datetime
        endedAt: datetime
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

}
