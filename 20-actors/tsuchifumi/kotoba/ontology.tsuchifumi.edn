;; tsuchifumi 土踏み — ontology (kotoba EAVT schema, ADR-2606212000)
;; アーシング (earthing/grounding) under-institutionalization × 環境電磁界 (ambient
;; EMF) exposure → bioelectric-WELLBECOMING observatory + system-dynamics model +
;; risk analysis + transparent おせっかい (ossekai) nudge over social-proto/atproto.
;;
;; 土踏み = "treading the earth" (the barefoot-on-soil core of the earthing practice;
;; also 土踏まず, the arch of the foot). The biosphere/Wellbecoming sibling of inochi
;; 命 (ecology) and shiori 栞 (human detractors), pointed at the ENVIRONMENTAL-EMF +
;; earthing-access gap that no actor covered.
;;
;; ── EPISTEMIC HONESTY IS THE DEFINING INVARIANT (G2, anti-pseudoscience) ──
;; This is a SCIENTIFICALLY CONTESTED domain. Mainstream science establishes
;; THERMAL EMF limits (ICNIRP/WHO) and ambient-exposure FACTS, but NON-THERMAL
;; EMF health effects and EARTHING-THERAPY clinical benefits are NOT established.
;; tsuchifumi therefore separates, in the data model itself, what is MEASURED
;; (exposure-load, earthing-access — :established/:emerging) from what is
;; HYPOTHESIZED (the bioelectric health burden — :contested/:anecdotal). Every
;; derived burden carries an explicit :evidence-tier + confidence; a contested
;; claim is NEVER emitted as an established harm. The actor is OBSERVATORY +
;; MODEL + NUDGE only — NON-DIAGNOSTIC, NON-THERAPEUTIC, sells NOTHING.
;;
;; ── Edge-primary relief framing ──
;; exposure-load (ambient-EMF + device-hours + indoor-fraction) × earthing-deficit
;; (1 − weighted earthing access/policy) scored ON READ → routed to RELIEF (拡充):
;; the actionable target is the INSTITUTIONAL GAP — barefoot-friendly public green
;; space, grounded building design, screen-free outdoor time policy — NOT a product
;; to sell and NOT a fear to spread. ossekai PROPOSES no-regret low-risk practices;
;; the ossekai 御節介 actor CARRIES them (consent-bound + on-chain-logged).
;;
;; verdict ∈ {:relief-priority :await-evidence :await-consent
;;            :infrastructure-gap :monitor}
;;
;; Attribute namespaces:
;;   :tsuchifumi.region/*  — disclosed region/cohort facts (kind, population)
;;   :tsuchifumi.exp/*     — DISCLOSED exposure factors (ambient EMF, device, indoor)
;;   :tsuchifumi.earth/*   — DISCLOSED earthing-access / institutional grounding factors
;;   :tsuchifumi.rel/*     — DERIVED relief factors + verdict + reason + route + evidence-tier
;;   :tsuchifumi.ev/*      — evidence-catalog records (claim, tier, source) — the honesty layer
;;   :tsuchifumi.risk/*    — DERIVED risk-register entries (likelihood/impact/leverage)
;;   :tsuchifumi.hyp/*     — co-scientist IDENTIFIED hypotheses (track/mechanism/tier/score/elo)
;;   :tsuchifumi/derived   — true on every derived datom
;;   :tsuchifumi/sourcing  — ":authoritative" | ":representative" | ":synthetic"
;;
;; ── co-scientist (特定・分析) ──
;; The co-scientist (Generate→Reflect→Rank→Evolve→Meta-review over a charter-clean
;; CATALOG) IDENTIFIES the top no-regret ACTION (≥:emerging → ossekai) and the top
;; contested RESEARCH hypothesis (→ suimin/mitooshi, studied not asserted). A contested
;; candidate on the :action track is vetoed (study a contested claim, never act on it).

{:ontology/id "tsuchifumi"
 :ontology/version "0.1.0"
 :ontology/adr ["2606212000" "2605262130" "2605312345" "2606073000" "2606082102"
                "2605264000" "2605312700" "2606072800" "2606111500"]

 :node-kinds
 [{:kind :region
   :doc "A region / population cohort under earthing-EMF Wellbecoming assessment. Carries DISCLOSED exposure factors (ambient EMF, device-hours, indoor-fraction) + earthing-access / institutional-grounding factors. Aggregate only — no individual is representable (G3)."
   :keys [:id :name :kind :population-weight
          ;; exposure (disclosed, :established/:emerging measurement)
          :ambient-emf :device-hours :indoor-fraction
          ;; earthing access + institution (disclosed)
          :barefoot-access :greenspace-access :grounded-building
          :footwear-insulation :grounding-policy
          ;; consent for an ossekai outreach to this cohort
          :consent :note]}
  {:kind :evidence
   :doc "An evidence-catalog record: a CLAIM about earthing/EMF, its evidence TIER, domain, and DISCLOSED source. The honesty layer — analyze weights every burden by the tier of the claim it rests on; a :contested/:anecdotal claim is never asserted as established harm (G2)."
   :keys [:id :claim :tier :domain :source :note]}
  {:kind :driver
   :doc "A risk DRIVER of the earthing-EMF gap (e.g. urbanization, insulated footwear ubiquity, screen-time growth, missing grounding standards). Carries likelihood × impact × evidence-confidence + a Meadows leverage level + reversibility — the risk register + leverage-point input."
   :keys [:id :name :likelihood :impact :evidence-tier :leverage :reversibility :note]}]

 :enums
 {:region-kind   #{:urban :suburban :rural :dense-urban}
  :tier          #{:established :emerging :contested :anecdotal}   ;; evidence strength (G2)
  :verdict       #{:relief-priority :await-evidence :await-consent
                   :infrastructure-gap :monitor}
  :reversibility #{:reversible :slow-reversible :entrenched}
  ;; Meadows 12 leverage levels (12 = weakest/params … 1 = strongest/paradigm); we store the level int.
  :leverage-band #{:parameter :feedback :structure :goal :paradigm}
  ;; co-scientist hypothesis tracks + aligned mechanisms (the closed catalog vocabulary)
  :hyp-track     #{:action :research}
  :hyp-mechanism #{:open-publication :greenspace-advocacy :outdoor-time-nudge
                   :evening-light-info :reciprocal-measurement :evidence-synthesis-request}}

 ;; evidence-tier → confidence weight applied to any burden resting on a claim of that tier (G2)
 :tier-weights
 {:established 1.0
  :emerging   0.6
  :contested  0.35
  :anecdotal  0.15}

 :verdict-meanings
 {:relief-priority   "high exposure-load × high earthing-deficit, consent in hand, AND the resting evidence is at least :emerging → prioritize an institutional-relief proposal (greenspace / grounded design / screen-free outdoor policy) routed to ossekai"
  :await-evidence    "the burden rests only on :contested/:anecdotal claims → do NOT assert harm; route to suimin/mitooshi evidence-synthesis, watch (G2)"
  :await-consent     "cohort consent for an outreach is absent → no ossekai nudge (G4)"
  :infrastructure-gap "earthing-deficit is high (the institutional gap is real) even where the health link is uncertain — a no-regret access/greenspace proposal stands on its own Wellbecoming merit"
  :monitor           "low burden / low deficit → observe only"}

 ;; negative space — structurally absent (enforced by tests)
 :unrepresentable
 [":tsuchifumi/diagnose"          ;; G1 — never diagnoses (route to mitate/iyashi)
  ":tsuchifumi/treat"             ;; G1 — never treats/cures
  ":tsuchifumi/cure"              ;; G1
  ":tsuchifumi.person/biometric"  ;; G3 — no individual biometric / personal EMF dosimetry
  ":tsuchifumi.person/health"     ;; G3 — aggregate cohort only
  ":tsuchifumi/product"           ;; G5 — sells nothing; no earthing mat / device / affiliate
  ":tsuchifumi/buy"               ;; G5
  ":tsuchifumi/point-forecast"    ;; G6 — the system-dynamics model is distribution-only (非終末論)
  ":tsuchifumi/fear-appeal"]      ;; G4 — ossekai is no-regret nudge, never a fear/manipulation appeal

 ;; co-scientist forbidden mechanisms — UNREPRESENTABLE in the catalog + rejected by review
 :forbidden-mechanisms
 #{:fear-marketing :product-sales :clinical-claim :personal-dosimetry-surveillance
   :engagement-maximizing :manipulation :deception :ad-targeting}}
