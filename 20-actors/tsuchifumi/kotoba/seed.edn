;; tsuchifumi 土踏み — seed: regions/cohorts + evidence catalog + risk drivers.
;; ALL SYNTHETIC (:sourcing :synthetic). Illustrative of the relief-gate's decision
;; shape and of the evidence-honesty layer — NOT real measurements, NOT a person
;; registry. Real environmental-EMF + public-health + greenspace-access data is an
;; operator/Council step (G7).
;;
;; factors ∈ 0..1 unless noted:
;;   exposure:  ambient-emf (composite ambient field level) · device-hours (daily screen
;;              hours / 16, normalized) · indoor-fraction (share of waking time indoors)
;;   earthing:  barefoot-access (safe barefoot soil/grass/sand contact opportunity) ·
;;              greenspace-access · grounded-building (electrically grounded living/working
;;              fabric) · footwear-insulation (ubiquity of insulating rubber/synthetic soles —
;;              HIGHER = MORE deficit) · grounding-policy (institutional grounding/greenspace
;;              standard strength)
;;   population-weight ∈ 0..1 (relative cohort size) · consent ∈ bool (outreach consent)
[
 ;; ── regions / cohorts ───────────────────────────────────────────────────────
 ;; dense-urban, high exposure + high deficit + consent → :relief-priority candidate
 {:type :region :id "metro-dense-a" :name "高密度メガシティ中心部 (synthetic)" :kind :dense-urban :population-weight 0.95
  :ambient-emf 0.85 :device-hours 0.75 :indoor-fraction 0.92
  :barefoot-access 0.05 :greenspace-access 0.18 :grounded-building 0.4
  :footwear-insulation 0.95 :grounding-policy 0.15 :consent true
  :note "Insulated high-rise living + near-zero barefoot soil contact + heavy screen time = the canonical earthing-deficit cohort."}
 {:type :region :id "metro-dense-b" :name "アジア新興メガシティ (synthetic)" :kind :dense-urban :population-weight 0.9
  :ambient-emf 0.8 :device-hours 0.8 :indoor-fraction 0.88
  :barefoot-access 0.08 :greenspace-access 0.22 :grounded-building 0.35
  :footwear-insulation 0.9 :grounding-policy 0.1 :consent true}
 ;; urban with decent greenspace policy → lower deficit, :infrastructure-gap / monitor
 {:type :region :id "city-green-c" :name "公園緑地政策の強い都市 (synthetic)" :kind :urban :population-weight 0.6
  :ambient-emf 0.7 :device-hours 0.65 :indoor-fraction 0.8
  :barefoot-access 0.45 :greenspace-access 0.7 :grounded-building 0.6
  :footwear-insulation 0.85 :grounding-policy 0.65 :consent true
  :note "Strong greenspace + grounding standards blunt the deficit even at city density."}
 ;; suburban, consent absent → :await-consent
 {:type :region :id "suburb-noconsent-d" :name "郊外住宅地 (cohort未同意, synthetic)" :kind :suburban :population-weight 0.5
  :ambient-emf 0.55 :device-hours 0.6 :indoor-fraction 0.78
  :barefoot-access 0.4 :greenspace-access 0.55 :grounded-building 0.55
  :footwear-insulation 0.8 :grounding-policy 0.4 :consent false
  :note "Outreach consent for this cohort is not in hand → no ossekai nudge (G4)."}
 ;; rural, low deficit → :monitor
 {:type :region :id "rural-e" :name "農村部 (synthetic)" :kind :rural :population-weight 0.25
  :ambient-emf 0.3 :device-hours 0.45 :indoor-fraction 0.55
  :barefoot-access 0.8 :greenspace-access 0.9 :grounded-building 0.5
  :footwear-insulation 0.6 :grounding-policy 0.5 :consent true
  :note "Abundant soil contact + greenspace → minimal earthing deficit; observe only."}
 ;; high ambient-EMF but GOOD earthing access → the burden rests on the CONTESTED
 ;; EMF→health pathway → harm is NOT asserted (G2 :await-evidence)
 {:type :region :id "metro-emfheavy-f" :name "高 ambient-EMF・緑地アクセス良好 cohort (synthetic)" :kind :urban :population-weight 0.55
  :ambient-emf 0.95 :device-hours 0.6 :indoor-fraction 0.7
  :barefoot-access 0.6 :greenspace-access 0.65 :grounded-building 0.6
  :footwear-insulation 0.6 :grounding-policy 0.6 :consent true
  :note "Burden dominated by ambient-EMF (a :contested health pathway) while earthing ACCESS is good → tsuchifumi does NOT claim harm; route to evidence-synthesis (G2 :await-evidence)."}
 ;; high earthing-deficit but LOW exposure → the institutional access gap stands on its
 ;; own established greenspace/outdoor-time merit, independent of any EMF debate
 {:type :region :id "town-paved-g" :name "低EMG・全面舗装の高密度町 (土壌接触欠乏, synthetic)" :kind :urban :population-weight 0.4
  :ambient-emf 0.35 :device-hours 0.4 :indoor-fraction 0.85
  :barefoot-access 0.05 :greenspace-access 0.12 :grounded-building 0.35
  :footwear-insulation 0.95 :grounding-policy 0.1 :consent true
  :note "Little wireless density but near-zero soil contact + no greenspace → a real institutional access gap on established wellbecoming evidence (:infrastructure-gap), no harm claim needed."}

 ;; ── evidence catalog (the honesty layer, G2) ────────────────────────────────
 ;; ESTABLISHED — mainstream-accepted facts (thermal limits, exposure measurement, greenspace).
 {:type :evidence :id "ev-icnirp-thermal" :tier :established :domain :emf
  :claim "ICNIRP/WHO establish THERMAL exposure limits for RF/ELF fields; compliance with limits prevents established thermal effects."
  :source "ICNIRP 2020 RF guidelines; WHO EMF project (DISCLOSED, not re-judged)"}
 {:type :evidence :id "ev-ambient-rise" :tier :established :domain :emf
  :claim "Ambient anthropogenic RF/ELF field levels in dense-urban environments have risen with wireless/device density (an EXPOSURE fact, not a harm claim)."
  :source "Population RF-exposure surveys (DISCLOSED)"}
 {:type :evidence :id "ev-greenspace-wellbeing" :tier :established :domain :wellbecoming
  :claim "Access to green/natural space is associated with improved mental + physical wellbeing (independent of any EMF/earthing mechanism)."
  :source "Urban-greenspace public-health literature (DISCLOSED)"}
 {:type :evidence :id "ev-outdoor-time" :tier :established :domain :wellbecoming
  :claim "Outdoor activity + reduced sedentary screen time has well-established wellbeing benefits — the no-regret core of any ossekai nudge."
  :source "Physical-activity / sedentary-behaviour guidance (DISCLOSED)"}
 ;; EMERGING — some evidence, not settled.
 {:type :evidence :id "ev-circadian-light" :tier :emerging :domain :sleep
  :claim "Evening short-wavelength screen light can disrupt circadian timing + sleep onset (mechanism for an evening device-reduction nudge; routes to suimin)."
  :source "Circadian/sleep literature (DISCLOSED); GRADE: moderate"}
 ;; CONTESTED — claimed but NOT established; never asserted as harm.
 {:type :evidence :id "ev-earthing-inflammation" :tier :contested :domain :earthing
  :claim "CONTESTED: 'earthing/grounding reduces inflammation / improves HRV.' Small studies + strong product-marketing bias; NOT established. Treated as a hypothesis only (G2)."
  :source "Earthing-therapy primary studies (DISCLOSED, small-n, conflict-of-interest noted)"}
 {:type :evidence :id "ev-nonthermal-emf" :tier :contested :domain :emf
  :claim "CONTESTED: non-thermal EMF health effects below ICNIRP limits. Mainstream bodies (WHO/ICNIRP) do not find established non-thermal harm; tsuchifumi does NOT assert it."
  :source "WHO/ICNIRP reviews vs minority position (DISCLOSED, non-adjudicating)"}
 ;; ANECDOTAL — testimonial only.
 {:type :evidence :id "ev-earthing-testimonial" :tier :anecdotal :domain :earthing
  :claim "ANECDOTAL: personal testimonials of feeling better after barefoot earth contact. No controlled evidence; lowest weight (G2)."
  :source "Self-report / forum testimony (DISCLOSED)"}

 ;; ── risk drivers (risk register + Meadows leverage input) ───────────────────
 ;; leverage = Meadows level int (12 weakest … 1 strongest); reversibility ∈ {:reversible :slow-reversible :entrenched}
 {:type :driver :id "drv-urbanization" :name "都市化・高層化 (loss of soil contact)"
  :likelihood 0.95 :impact 0.7 :evidence-tier :established :leverage 4 :reversibility :slow-reversible
  :note "Structural driver of earthing-deficit; leverage at the level of system structure (Meadows 4: self-organization / built form)."}
 {:type :driver :id "drv-footwear" :name "絶縁靴底の遍在 (insulating soles)"
  :likelihood 0.9 :impact 0.4 :evidence-tier :emerging :leverage 6 :reversibility :reversible
  :note "Material/behavioural driver; high-leverage + reversible (information + simple practice change)."}
 {:type :driver :id "drv-screentime" :name "スクリーン時間の増大 (indoor + device)"
  :likelihood 0.92 :impact 0.55 :evidence-tier :emerging :leverage 6 :reversibility :reversible
  :note "Couples exposure + indoor-fraction; reversible via outdoor-time policy + evening light hygiene (suimin)."}
 {:type :driver :id "drv-no-grounding-standard" :name "接地・緑地 institutional 標準の欠如"
  :likelihood 0.85 :impact 0.6 :evidence-tier :established :leverage 3 :reversibility :slow-reversible
  :note "THE institutional gap the actor names: missing grounded-design + greenspace-access standards. Leverage at goals/rules (Meadows 3-5) — the highest-leverage no-regret intervention."}
 {:type :driver :id "drv-product-pseudoscience" :name "アーシング商法・疑似科学 (product fear-marketing)"
  :likelihood 0.8 :impact 0.45 :evidence-tier :contested :leverage 2 :reversibility :slow-reversible
  :note "A driver of HARM in the OTHER direction: fear-marketing of earthing products erodes trust + diverts from no-regret access. Countered by G2 honesty + G5 no-commerce + paradigm-level framing (Meadows 2)."}
]
