;; 澪 mio — ontology (kotoba EAVT schema, ADR-EnergyOrderProtocol)
;; Proof-of-Useful-Flow verification ledger. The BACKBONE of the Energy Order
;; Protocol suite (撓 tawami / 燠 okibi / 樋 toi / 委 yudane submit claims; mio
;; verifies + accounts). OBSERVATION + VERIFICATION ONLY — never trades, never
;; actuates. A RESILIENCE/REWARD map, NEVER a market/price signal.
;;
;; Core thesis (the Bitcoin → Energy translation):
;;   Proof of Work made CONSUMED energy the basis of scarcity.
;;   Proof of Useful Flow makes ORDERED energy-flow the basis of scarcity.
;;   Hashrate → Flowrate. The verified useful-flow score is the org's "Flowrate".
;;
;; The §9-verification problem is the DEFINING gate. A flow-improvement CLAIM
;; cannot reach :verified (and therefore cannot earn) unless it carries all five
;; verification facts:
;;   :baseline-method     — the counterfactual it is measured against
;;   :additionality       — degree it would NOT have happened anyway (0..1)
;;   :measurement-source  — signed-meter / third-party-audit / satellite / zk-proof
;;   :double-count-key    — content key; a collision is structurally rejected
;;   :leakage             — fraction offset by increased emissions elsewhere (0..1)
;;
;; Attribute namespaces (kango-named observatory sibling of busshi/shionome/kasa):
;;   :mio.claim/*    — disclosed flow-improvement claim facts (name, class, source-actor)
;;   :mio.obs/*      — DERIVED observations (verification-confidence, useful-flow-score, verdict, route)
;;   :mio.class/*    — per-flow-class aggregates
;;   :mio.ledger/*   — org-wide "Flowrate" (verified useful-flow total — the headline metric)
;;   :mio/derived    — true on every derived datom (never re-ingested as authoritative)
;;   :mio/sourcing   — ":authoritative" | ":representative" | ":synthesized"

{:ontology/id "mio"
 :ontology/version "0.1.0"
 :ontology/adr ["2606211200" "2605262130" "2605312345" "2606111400"]

 :node-kinds
 [{:kind :claim
   :doc "A flow-improvement CLAIM submitted by a suite actor (撓/燠/樋/委) or hikari: an assertion that some energy flow was ORDERED (waste heat delivered, peak shaved, surplus absorbed, compute routed to a heat/renewable sink). Carries the five verification facts."
   :keys [:id :name :flow-class :source-actor :order-delta-kwh
          :baseline-method :additionality :measurement-source :double-count-key :leakage
          :sourcing :source :note]}
  {:kind :class
   :doc "Derived aggregate over a flow class (:flexibility / :waste-heat / :compute-routing / :intention / :renewable-absorb / :peak-shave)."}]

 :flow-classes
 #{:flexibility :waste-heat :compute-routing :intention :renewable-absorb :peak-shave}

 ;; the §9 verification inputs and their confidence weight (the only path to reward)
 :measurement-weight
 {:third-party-audit 1.0
  :zk-proof          0.95
  :signed-meter      0.9
  :dual-sensor       0.9
  :satellite         0.85
  :self-report       0.3}   ;; self-report ALONE cannot reach the verified threshold → no reward

 :verdict-kinds
 {:verified               "all five verification facts satisfied + confidence ≥ threshold → routes to :reward (advisory, 1 SBT=1 vote)"
  :insufficient-evidence  "missing baseline / additionality < min / no trusted measurement / confidence < threshold → :review"
  :rejected-double-count  "double-count-key collides with an earlier claim → not counted twice (§9)"
  :rejected-leakage       "leakage above max — the improvement is offset elsewhere → not real order"}

 :route-kinds
 {:reward "verified ordered-flow → advisory reward proposal (drafted-unsent; actual issue = 1 SBT=1 vote + TitheRouter; hikari actuates)"
  :review "unverified / rejected → returned to the submitting actor with the failing verification fact"}

 ;; negative space — structurally absent attributes (enforced by tests)
 :unrepresentable
 [":mio/trade"                  ;; G1/G3: never a buy/sell/position/order
  ":mio/signal"                 ;; G3: never a market/price signal
  ":mio.obs/consumed-reward"    ;; G1 BACKBONE: reward NEVER derives from energy CONSUMED — only from ORDER
  ":mio.claim/consumed-reward-kwh"
  ":mio.claim/price-forecast-point" ;; G3: levels/deltas are facts, point forecasts are not emitted (mitooshi does distributions)
  ":mio.person/intention-content"]} ;; G5/委-G2: intention CLAIMS are content-free; no person-level intent text
