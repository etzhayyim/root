;; 澪 mio — seed (Proof-of-Useful-Flow claims; MIXED provenance per row).
;;
;; Each row is a flow-improvement CLAIM submitted to the verification ledger by a
;; suite actor (撓 tawami / 燠 okibi / 樋 toi / 委 yudane) or hikari. The five §9
;; verification facts decide whether the claim reaches :verified (and earns) or is
;; returned for :review. A SIZE (:order-delta-kwh) is a fact, never a signal.
;;
;; Rows without :sourcing default to :representative (public-knowledge shapes that
;; illustrate the verification topology). Rows carrying :sourcing :authoritative +
;; :source were folded from a cited measurement via an OPERATOR-TRIGGERED G7 ingest
;; — the order-delta on those rows is a real metered value.
;;
;; fields:
;;   :order-delta-kwh    the ORDERED flow (kWh-equiv): waste heat delivered, peak
;;                       shaved, surplus renewable absorbed, compute routed to a sink.
;;   :baseline-method    REQUIRED counterfactual (what the delta is measured against).
;;   :additionality      0..1 — degree the improvement would NOT have happened anyway.
;;   :measurement-source one of #{:third-party-audit :zk-proof :signed-meter
;;                       :dual-sensor :satellite :self-report}.
;;   :double-count-key   content key; a collision with an earlier claim is rejected.
;;   :leakage            0..1 — fraction offset by increased emissions elsewhere.
[
 ;; ── waste-heat (燠 okibi) ────────────────────────────────────────────────────
 {:type :claim :id "wh-dc-district-01" :name "Datacenter waste heat → district heating loop"
  :flow-class :waste-heat :source-actor "okibi" :order-delta-kwh 12000
  :baseline-method "counterfactual: server heat rejected to ambient via dry coolers (metered loop baseline)"
  :additionality 0.80 :measurement-source :signed-meter :double-count-key "wh:dc-a:district-b:2026Q2" :leakage 0.10
  :sourcing :authoritative :source "district-heat substation BTU meter (operator G7 ingest)"}
 {:type :claim :id "wh-food-greenhouse-01" :name "Food-plant condenser heat → adjacent greenhouse"
  :flow-class :waste-heat :source-actor "okibi" :order-delta-kwh 4200
  :baseline-method "counterfactual: condenser heat dumped to cooling tower (nameplate × runtime)"
  :additionality 0.70 :measurement-source :dual-sensor :double-count-key "wh:food-c:gh-d:2026Q2" :leakage 0.12}
 {:type :claim :id "wh-selfreport-01" :name "Bakery oven heat → claimed space heating (self-report only)"
  :flow-class :waste-heat :source-actor "okibi" :order-delta-kwh 3000
  :baseline-method "counterfactual: oven heat vented (operator estimate)"
  :additionality 0.60 :measurement-source :self-report :double-count-key "wh:bakery-e:room-f:2026Q2" :leakage 0.10}
 {:type :claim :id "wh-aircon-zone-01" :name "Waste heat to a region that needs COOLING (anti-pattern)"
  :flow-class :waste-heat :source-actor "okibi" :order-delta-kwh 5000
  :baseline-method "counterfactual: heat rejected outdoors"
  :additionality 0.50 :measurement-source :signed-meter :double-count-key "wh:dc-g:hot-zone-h:2026Q2" :leakage 0.70}

