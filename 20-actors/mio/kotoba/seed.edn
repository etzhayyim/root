 ;; ── intention (委 yudane) — CONTENT-FREE; only an aggregate flexibility offer ─
 {:type :claim :id "in-cohort-presence-01" :name "Consented cohort presence-shift → aggregate HVAC pre-conditioning"
  :flow-class :intention :source-actor "yudane" :order-delta-kwh 2600
  :baseline-method "counterfactual: fixed-schedule HVAC ignoring occupancy (aggregate kWh baseline)"
  :additionality 0.62 :measurement-source :signed-meter :double-count-key "in:cohort-s:hvac:2026-06-18" :leakage 0.10
