;; com.etzhayyim.mio.flowClaim — the Energy Order Protocol's central interface schema.
;; A flow-improvement CLAIM is what each suite leg (撓/燠/樋/委) submits to 澪 mio for
;; §9 verification. This lexicon is the TYPED CONTRACT for that write surface: a claim
;; that does not conform cannot be a valid submission. Validated by methods/lexicon.cljc.
;; ADR-2606211200.
{:lexicon/id "com.etzhayyim.mio.flowClaim"
 :lexicon/rev 1
 :doc "A flow-improvement claim: an assertion that some energy flow was ORDERED, carrying the five §9 verification facts so 澪 mio can verify + account it."

 ;; every field below must be present on a valid claim
 :required [:type :id :flow-class :source-actor :order-delta-kwh
            :baseline-method :additionality :measurement-source :double-count-key :leakage]

 :fields
 {:type               {:type :keyword :const :claim}
  :id                 {:type :string :non-blank true}
  :name               {:type :string :optional true}
  :flow-class         {:type :keyword
                       :enum #{:waste-heat :flexibility :compute-routing
                               :renewable-absorb :peak-shave :intention}}
  :source-actor       {:type :string :non-blank true
                       :enum-strings #{"tawami" "okibi" "toi" "yudane" "hikari"}}
  ;; the ORDERED flow (kWh-equiv) — a size, never negative, never a consumption-reward
  :order-delta-kwh    {:type :number :min 0}
  ;; the five §9 verification facts
  :baseline-method    {:type :string :non-blank true}
  :additionality      {:type :number :min 0 :max 1}
  :measurement-source {:type :keyword
                       :enum #{:third-party-audit :zk-proof :signed-meter
                               :dual-sensor :satellite :self-report}}
  :double-count-key   {:type :string :non-blank true}
  :leakage            {:type :number :min 0 :max 1}}

 ;; structurally forbidden on a claim (the PoW→PoUF pivot + map-not-market gates)
 :forbidden [:consumed-reward-kwh :cash :usd :money :equity :trade :signal :person]}
