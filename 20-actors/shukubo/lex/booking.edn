;; com.etzhayyim.shukubo.booking — lexicon (EDN form)
;; A reservation. Ring-1 settles internally (member-signed, warifu, TitheRouter).
;; Ring-2 booking is NOT executed here — it is a handoff to the operator's own page (G2).
;; ADR-2606071600
{:lexicon 1
 :id "com.etzhayyim.shukubo.booking"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["bookingId" "stayId" "guestDid" "ring" "checkIn" "checkOut" "consentRef"]
    :properties
    {:bookingId    {:type "string"}
     :stayId       {:type "string"}
     :guestDid     {:type "string" :description "member guest DID"}
     :ring         {:type "string" :description "commons|internal|external"}
     :checkIn      {:type "string" :format "datetime"}
     :checkOut     {:type "string" :format "datetime"}
     :guests       {:type "integer"}
     :consentRef   {:type "string" :description "DID-signed consent reference (G1)"}
     :costShareMinor {:type "integer" :description "flat cost-share owed (USDC minor); demand never raises this (G13)"}
     :settlementRef  {:type "string" :description "Ring-1 only: warifu settlement ref (member-signed; intent-only at R0)"}
     :titheMinor   {:type "integer" :description "Ring-1: 10% TitheRouter split (G7)"}
     :handoffUrl   {:type "string" :description "Ring-2 only: operator self-book URL returned to member; shukubo never charges (G2)"}
     :status       {:type "string" :description "requested|consented|confirmed|self-book-handoff|completed|cancelled"}
     :recordEnc    {:type "boolean" :description "const true — booking PII via com.etzhayyim.encrypted.* (G9)"}}}}}}
