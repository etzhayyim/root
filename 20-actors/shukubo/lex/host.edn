;; com.etzhayyim.shukubo.host — lexicon (EDN form)
;; A stay's host. Attests the SPACE's habitability (G12 — the space, never the person) and the
;; privacy invariant noSurveil (G14). There is deliberately NO host/guest score / rating / rank
;; field — persons are never scored (G12 pilgrim-welcome).
;; ADR-2606071600
{:lexicon 1
 :id "com.etzhayyim.shukubo.host"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["hostDid" "stayId" "habitability"]
    :properties
    {:hostDid      {:type "string" :description "member/actor host DID"}
     :stayId       {:type "string"}
     :ring         {:type "string" :description "commons|internal|external"}
     :habitability {:type "string" :description "attested SPACE safety: must include water+heat+egress (G12)"}
     :noSurveil    {:type "boolean" :description "const true — no in-stay cameras/biometrics (G14)"}
     ;; NO :score / :rating / :rank field — persons are never scored (G12)
     }}}}}
