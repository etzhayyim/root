;; com.etzhayyim.shukubo.stay — lexicon (EDN form)
;; A lodging offer. NOTE: there is deliberately NO commission, NO surge/dynamic-price,
;; and NO person-rating field — those are structurally unrepresentable (G2/G12/G13).
;; ADR-2606071600
{:lexicon 1
 :id "com.etzhayyim.shukubo.stay"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["stayId" "ring" "hostDid" "kind" "sourcing"]
    :properties
    {:stayId        {:type "string"}
     :ring          {:type "string" :description "commons|internal|external"}
     :kind          {:type "string" :description "pilgrim-shukubo|member-room|mutual-aid-shelter|actor-operated|external-mirror"}
     :hostDid       {:type "string" :description "member/actor host DID; external ring = operator DID"}
     :title         {:type "string"}
     :geoDid        {:type "string" :description "maps/region DID for location (coarse; exact addr encrypted)"}
     :capacity      {:type "integer" :description "guests"}
     :costMode      {:type "string" :description "free|cost-share|fixed (Ring0=free/cost-share; Ring1=fixed cost-share; NEVER demand-priced)"}
     :costMinor     {:type "integer" :description "USDC minor units for the WHOLE stay (flat); 0 for free"}
     :currency      {:type "string" :description "ISO-4217; internal=USDC"}
     :habitability  {:type "string" :description "attested space safety: water|heat|egress|accessibility flags (the SPACE is attested, never the person)"}
     :noSurveil     {:type "boolean" :description "const true — no in-stay cameras/biometrics (G14)"}
     :operatorUrl   {:type "string" :description "external ring ONLY: operator's OWN booking page (member self-books; affiliate-stripped)"}
     :availability  {:type "string" :description "external ring: available|unavailable|unknown (:representative honesty, G10)"}
     :sourcing      {:type "string" :description "authoritative|representative|synthesized (G10)"}}}}}}
