;; com.etzhayyim.talent.talentCohort — lexicon (EDN form)
;; An aggregate cohort (ISCO × country). Carries COUNT + non-identifying skill aggregates only,
;; and only when the cohort is at or above k (G2). No member list, no individual field exists.
;; ADR-2606072600
{:lexicon 1
 :id "com.etzhayyim.talent.talentCohort"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["cohortDid" "isco" "country" "count"]
    :properties
    {:cohortDid {:type "string" :description "did:web:talent.etzhayyim.com:cohort:{isco}:{country}"}
     :isco      {:type "string"}
     :country   {:type "string"}
     :count     {:type "integer" :description "members; only published when ≥ k (G2 k-anonymity)"}
     :topSkills {:type "array" :items {:type "string"} :description "non-identifying skill aggregate"}
     :kFloor    {:type "integer" :description "the k-anonymity floor enforced (default 5)"}}}}}}
