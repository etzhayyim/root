;; com.etzhayyim.talent.talentProfile — lexicon (EDN form)
;; A SELF-SOVEREIGN profile (caller = subject, G1). Identifying fields MUST be signal:v1:
;; ciphertext (G3). Keyed by a hash of the subject DID. Hard-deletable (G4 — no :_alive flag).
;; ADR-2606072600
{:lexicon 1
 :id "com.etzhayyim.talent.talentProfile"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["subjectDidHash" "isco" "country"]
    :properties
    {:subjectDidHash {:type "string" :description "hash of subject DID — self path profile:{hash}"}
     :isco           {:type "string" :description "ISCO-08 occupation code (cohort key)"}
     :country        {:type "string" :description "ISO-3166 (cohort key)"}
     :skills         {:type "array" :items {:type "string"} :description "non-identifying, cohort-aggregatable"}
     :seniority      {:type "string" :description "non-identifying band"}
     ;; identifying fields — MUST be signal:v1:{ciphertext} (G3); plaintext write refused
     :fullName       {:type "string" :description "signal:v1:{ciphertext} ONLY (G3)"}
     :email          {:type "string" :description "signal:v1:{ciphertext} ONLY (G3)"}
     :phone          {:type "string" :description "signal:v1:{ciphertext} ONLY (G3)"}
     :address        {:type "string" :description "signal:v1:{ciphertext} ONLY (G3)"}
     :dateOfBirth    {:type "string" :description "signal:v1:{ciphertext} ONLY (G3)"}
     :governmentId   {:type "string" :description "signal:v1:{ciphertext} ONLY (G3)"}
     :registeredBy   {:type "string" :description "caller DID — MUST equal subject (G1); member-signed (G6)"}
     :enrichmentSource {:type "string" :description "orcid|github-public|public-credential-registry ONLY"}}}}}}
