// Blender clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace blender {

    entity Object {
        id: string @unique
        name: string
        type: string
        parent: string
        upAxis: string
        locationX: float
        locationY: float
        locationZ: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity Scene {
        id: string @unique
        name: string
        frameStart: integer
        frameEnd: integer
        frameCurrent: integer
        frameStep: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Material {
        id: string @unique
        name: string
        useNodes: boolean
        metallic: float
        roughness: float
        blendMethod: string
        createdAt: datetime
        updatedAt: datetime
    }

}
