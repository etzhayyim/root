;; 樋 toi — ontology (kotoba EAVT schema, ADR-2606211200 Energy Order Protocol)
;; Compute as Thermal Routing. Deferrable compute is an energy-flow VALVE: route it
;; to where surplus-renewable × low-carbon × cooling-efficiency × heat-demand favour
;; it. OBSERVATION ONLY — a routing map, NEVER a forced job-kill / load-shedding
;; weapon. The theory's PoW critique made concrete: route USEFUL compute (not hashes)
;; to favourable energy/thermal sinks; its waste heat feeds 燠 okibi.
;;
;; Thesis (theory §5-D Compute as Thermal Routing): computing is a movable load —
;; send AI inference / training / render / backup to the cold region with surplus
;; hydro and a heat demand next door, turning the machine into an "information
;; processing heater" only where that helps.
;;
;; Attribute namespaces (kango-named observatory sibling of mio/tawami/okibi):
;;   :toi.job/*    — disclosed deferrable-compute job facts (class, kwh, deferrable, movable)
;;   :toi.site/*   — disclosed site facts (class, carbon-intensity, surplus-renewable, cooling, heat-sink)
;;   :toi.route/*  — DERIVED routings (job → site, avoided-carbon, heat-reuse)
;;   :toi.obs/*    — DERIVED per-node observations
;;   :toi.ledger/* — org-wide routed-compute + avoided-carbon total
;;   :toi/derived  — true on every derived datom
;;   :toi/sourcing — ":authoritative" | ":representative" | ":synthesized"

{:ontology/id "toi"
 :ontology/version "0.1.0"
 :ontology/adr ["2606211200" "2606172359" "2606051500" "2605262130" "2605312345"]

 :node-kinds
 [{:kind :job
   :doc "A deferrable / movable compute job (batch-inference / training / render / backup / indexing) with an energy need, a deferral window, and a movability flag."
   :keys [:id :name :job-class :kwh :deferrable-h :movable :deadline-h :sourcing :source :note]}
  {:kind :site
   :doc "A compute site (murakumo / donated-mesh / commercial-gpu) with a carbon intensity, surplus-renewable availability, cooling efficiency (PUE-like), a heat-demand-sink flag, and capacity."
   :keys [:id :name :site-class :region :carbon-intensity :surplus-renewable
          :cooling-efficiency :heat-demand-sink :capacity-kwh :availability :sourcing :source :note]}]

 :job-classes
 #{:batch-inference :training :render :backup :indexing}
 :site-classes
 #{:murakumo :donated-mesh :commercial-gpu}

 :route-params
 {:baseline-carbon-intensity 450.0 ;; gCO2/kWh — a warm grid-average node (the counterfactual)
  :baseline-cooling 1.5            ;; baseline PUE
  ;; G2 (Rider v3.3 §2(i) / ADR-2606172359): Murakumo DEFAULT-PREFERRED — transparency
  ;; weight scores opaque, lock-in commercial GPU low; not a vendor ban, a net score.
  :transparency {:murakumo 1.0 :donated-mesh 0.9 :commercial-gpu 0.3}}

 ;; negative space — structurally absent attributes (enforced by tests)
 :unrepresentable
 [":toi/dispatch"            ;; G1: never a forced dispatch/job-kill (Murakumo fleet + operator actuate)
  ":toi.job/kill-order"      ;; G1: never a load-shedding / DoS weapon
  ":toi/trade"               ;; never a market position
  ":toi/signal"]}            ;; never a price signal
