;; com.etzhayyim.kudamori.cleanAttestation — lexicon (EDN form)
;; ADR-2606142030 · per-segment sewer / confined-space cleaning attestation
{:lexicon 1
 :id "com.etzhayyim.kudamori.cleanAttestation"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["jobId" "facilityId" "robotId" "accessNode" "targetSegment" "entryPermitted"]
    :properties
    {:jobId {:type "string" :description "unique cleaning-job identifier"}
     :facilityId {:type "string" :description "sewer reach / facility id"}
     :robotId {:type "string" :description "in-pipe crawler DID performing the clean"}
     :robotKind {:type "string" :description "crawler (tracked/wheeled in-pipe)"}
     :accessNode {:type "string" :description "access manhole the crawler launched from"}
     :targetSegment {:type "string" :description "pipe segment cleaned"}
     :pipeMaterial {:type "string" :description "vcp | pvc | concrete | ductile-iron"}
     :pipeIdMm {:type "number" :description "pipe inner diameter (mm)"}
     ;; ── confined-space atmosphere (★ G5 — entry never permitted on unsafe air) ──
     :entryPermitted {:type "boolean" :description "atmosphere passed the confined-space entry gate (G5)"}
     :o2Pct {:type "number" :description "oxygen at entry (%) — safe band 19.5–23.5"}
     :h2sPpm {:type "number" :description "hydrogen sulfide at entry (ppm) — safe <10"}
     :ch4Lel {:type "number" :description "methane at entry (%LEL) — safe <10"}
     :coPpm {:type "number" :description "carbon monoxide at entry (ppm) — safe <35"}
     :purgeMinutes {:type "integer" :description "forced-ventilation minutes to reach a passing atmosphere (purge-to-entry)"}
     ;; ── jetting (★ G7 — never above the pipe-material rating) ──
     :nozzlePressureBar {:type "number" :description "hydro-jet nozzle pressure (bar) — must be ≤ pipe material rating (G7)"}
     :ratingBar {:type "number" :description "pipe-material working-pressure rating (bar)"}
     :debrisRemovedM3 {:type "number" :description "estimated debris volume removed (m³)"}
     ;; ── water balance (G2 — effluent → mizuho, never discharged untreated) ──
     :waterReuseFrac {:type "number" :description "fraction of jetting water reused (0..1, G2)"}
     :effluentL {:type "number" :description "residual effluent handed off to mizuho 水穂 for treatment (L)"}
     :timestamp {:type "string" :description "ISO-8601 attestation time"}}}}}}
