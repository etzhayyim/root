;; com.etzhayyim.googleads.campaign — lexicon (EDN form)
;; A campaign PROPOSAL record. Cohort-bound (G2 — cohort, never an individual), budget-capped (G4),
;; approval-gated (G1 — status :proposed until finance DID signs off). Creative refs MUST be G5-reviewed.
;; ADR-2606292130
{:lexicon 1
 :id "com.etzhayyim.googleads.campaign"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["id" "cohort" "purpose" "budgetCap" "status"]
    :properties
    {:id         {:type "string" :description "campaign id"}
     :cohort     {:type "string" :description "→ audience/cohort-id (G2 — cohort target only; no individual)"}
     :purpose    {:type "string" :description "mission-bound outreach purpose (event|publication|mutual-aid|land-sovereignty|donation)"}
     :budgetCap  {:type "integer" :description "hard ceiling; spend cannot exceed (G4)"}
     :status     {:type "string" :description "proposed|approved|publishing|paused|closed — :publishing requires approvedBy (G1)"}
     :approvedBy {:type "string" :description "finance/Council DID — required to enter :publishing (G1)"}
     :creative   {:type "array" :items {:type "string"} :description "→ creative/id refs; MUST be G5-reviewed"}}}}}}
