;; com.etzhayyim.googleads.proposal — lexicon (EDN form)
;; An actor proposal + its governance verdict + human disposition. The audit trail of every
;; propose→govern→approve/reject/hold decision (G1). :governorVerdict is from the independent
;; PolicyGovernor (G2/G3/G5 checks); :disposition is set by human finance sign-off (G1).
;; ADR-2606292130
{:lexicon 1
 :id "com.etzhayyim.googleads.proposal"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["id" "campaign" "kind" "payload" "governorVerdict" "disposition"]
    :properties
    {:id                 {:type "string" :description "proposal id"}
     :campaign           {:type "string" :description "→ campaign/id"}
     :kind               {:type "string" :description "create|adjust-bid|adjust-budget|swap-creative|pause"}
     :payload            {:type "string" :description "EDN proposal body (cohort, bid, budget, creative ref)"}
     :governorVerdict    {:type "string" :description "accept|reject|hold — independent PolicyGovernor (G2/G3/G5)"}
     :governorViolations {:type "array" :items {:type "string"} :description "gate violations if rejected/hold"}
     :disposition        {:type "string" :description "committed|held|rejected — set by human sign-off (G1)"}
     :dispositionBy      {:type "string" :description "finance/Council DID (G1)"}}}}}}
