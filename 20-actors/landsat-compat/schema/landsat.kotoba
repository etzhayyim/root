// Landsat clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace landsat {

    entity LandsatItemProperties {
        id: string @unique
        sceneId: string
        collectionCategory: string
        collectionNumber: string
        wrsType: string
        wrsPath: string
        wrsRow: string
        cloudCoverLand: float
        correction: string
        productGenerated: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity StacAsset {
        id: string @unique
        href: string
        title: string
        description: string
        type: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity InstrumentProperties {
        id: string @unique
        platform: string
        constellation: string
        mission: string
        gsd: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity EoBandProperties {
        id: string @unique
        cloudCover: float
        snowCover: float
        commonName: string
        centerWavelength: float
        fullWidthHalfMax: float
        solarIllumination: float
        createdAt: datetime
        updatedAt: datetime
    }

}
