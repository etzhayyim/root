namespace googleads {

    entity Campaign {
        id: string @unique
        name: string
        status: string
        servingStatus: string
        advertisingChannelType: string
        startDateTime: datetime
        endDateTime: datetime
        trackingUrlTemplate: string
        baseCampaign: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity AdGroup {
        id: string @unique
        name: string
        status: string
        type: string
        cpcBidMicros: integer
        trackingUrlTemplate: string
        baseAdGroup: string
        createdAt: datetime
        updatedAt: datetime
    }

}
