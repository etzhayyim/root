// Pagerduty clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace pagerduty {

    entity Incident {
        id: string @unique
        incidentNumber: integer
        title: string
        status: string
        incidentKey: string
        assignedVia: string
        lastStatusChangeAt: datetime
        resolvedAt: datetime
        isMergeable: boolean
        urgency: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Service {
        id: string @unique
        name: string
        description: string
        autoResolveTimeout: integer
        acknowledgementTimeout: integer
        status: string
        lastIncidentTimestamp: datetime
        alertCreation: string
        alertGrouping: string
        alertGroupingTimeout: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity EscalationPolicy {
        id: string @unique
        name: string
        description: string
        numLoops: integer
        onCallHandoffNotifications: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Schedule {
        id: string @unique
        name: string
        description: string
        timeZone: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity User {
        id: string @unique
        name: string
        email: string
        timeZone: string
        color: string
        role: string
        avatarUrl: string
        description: string
        invitationSent: boolean
        jobTitle: string
        createdViaSso: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Team {
        id: string @unique
        name: string
        description: string
        defaultRole: string
        createdAt: datetime
        updatedAt: datetime
    }

}
