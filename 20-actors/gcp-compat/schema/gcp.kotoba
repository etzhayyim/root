// Gcp clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace gcp {

    entity Instance {
        id: string @unique
        name: string
        machineType: string
        status: string
        zone: string
        creationTimestamp: datetime
        cpuPlatform: string
        hostname: string
        canIpForward: boolean
        deletionProtection: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Disk {
        id: string @unique
        name: string
        sizeGb: string
        status: string
        type: string
        zone: string
        creationTimestamp: datetime
        architecture: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Firewall {
        id: string @unique
        name: string
        network: string
        direction: string
        priority: integer
        creationTimestamp: datetime
        disabled: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Network {
        id: string @unique
        name: string
        description: string
        autoCreateSubnetworks: boolean
        mtu: integer
        creationTimestamp: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Operation {
        id: string @unique
        name: string
        status: string
        operationType: string
        progress: integer
        startTime: datetime
        endTime: datetime
        zone: string
        createdAt: datetime
        updatedAt: datetime
    }

}
