        creationDate: datetime
        lastUpdated: datetime
        name: string
        description: string
        token: string
        responseCode: integer
        verificationType: string
        castBuffersAs: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity ExperienceEndpoint {
