        createdAt: datetime
        updatedAt: datetime
    }

    entity ExperienceUser {
        id: string @unique
        experienceUserId: string
        applicationId: string
        creationDate: datetime
        lastUpdated: datetime
        passwordLastUpdated: datetime
        lastLogin: datetime
