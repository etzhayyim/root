        name: string
        description: string
        deviceClass: string
        gatewayId: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Application {
        id: string @unique
        applicationId: string
        creationDate: datetime
        lastUpdated: datetime
        ownerId: string
        ownerType: string
        organizationName: string
        name: string
        description: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Webhook {
        id: string @unique
