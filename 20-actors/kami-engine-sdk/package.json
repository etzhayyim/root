{
  "name": "@etzhayyim/kami-engine-sdk",
  "version": "0.1.0",
  "description": "KAMI Engine SDK: Svelte 5 VRM character components, headless builders, Genko manga editor, trackpad embeds, and manufacturing planning helpers.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/etzhayyim/root",
  "repository": {
    "type": "git",
    "url": "https://github.com/etzhayyim/root.git"
  },
  "bugs": {
    "url": "https://github.com/etzhayyim/rootissues"
  },
  "keywords": [
    "kami",
    "svelte",
    "vrm",
    "three",
    "manga",
    "genko",
    "manufacturing",
    "openusd",
    "materialx",
    "osl",
    "openexr",
    "ocio",
    "openvdb",
    "openimageio",
    "renderman",
    "pixar",
    "hydra",
    "scene-graph"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./builders": {
      "types": "./dist/builders/index.d.ts",
      "svelte": "./dist/builders/index.js",
      "default": "./dist/builders/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
