;; uzu 渦 — ontology (kotoba EAVT schema, ADR-2606211500)
;; The dissipative information-energy organism + the measured real-world energy field.
;;
;; Two ledgers, deliberately distinct (the design's central caveat — info ≠ energy):
;;   ENERGY  — conserved, depleting (the metabolic balance; :uzu.beat/energy)
;;   INFORMATION — copyable, append-only, non-conserved (the belief + free energy;
;;                 :uzu.beat/free-energy + the commit-DAG itself)
;;
;; Attribute namespaces:
;;   :uzu.organism/*  — a lived organism's outcome (survival, final energy, lifespan)
;;   :uzu.beat/*      — one beat of the dissipative loop (action, energy, free-energy)
;;   :uzu.flow/*      — a MEASURED real-world flow, in its NATIVE unit + class
;;   :uzu/derived     — true on every derived datom
;;   :uzu/sourcing    — ":synthetic" (organism) | ":representative" (measured flow)

{:ontology/id "uzu"
 :ontology/version "0.1.0"
 :ontology/adr ["2606211500" "2605262130" "2605312345" "2606011501" "2606101800"]

 :node-kinds
 [{:kind :organism
   :doc "A thermodynamic active-inference agent. :prefs (C) = what MATTERS to this subject (= meaning)."
   :keys [:id :prefs :temp :energy0 :prior :note]}
  {:kind :world-step
   :doc "One step of the environment tape: hidden :regime + noisy :signal observation."
   :keys [:step :regime :signal]}
  {:kind :flow
   :doc "A measured real-world energy-like flow in one of four incommensurable unit classes."
   :keys [:id :label :class :magnitude :unit :efficiency :source]}
  {:kind :circulation
   :doc "A coupling edge of the open dissipative system (energy→economy→information→meaning→…)."
   :keys [:from :to :coupling :cross-class]}]

 :enums
 {:regime      #{:scarce :benign :abundant :hostile}    ;; hidden environment states
  :action      #{:forage :flee :rest :explore}          ;; the organism's policy alphabet
  :flow-class  #{:physical :economic :informational :experiential}}

 :unit-classes
 {:physical      {:unit "W"      :conserved true  :doc "thermodynamic power; dissipates to heat"}
  :economic      {:unit "USD/yr" :conserved false :doc "money as economic free energy; NOT joules"}
  :informational {:unit "bit/s"  :conserved false :doc "information flux; free energy in nats; NOT joules"}
  :experiential  {:unit "index"  :conserved false :doc "attention/affect/meaning; subject-dependent; NOT joules"}}

 ;; THE invariant: the four unit classes are NEVER summed across classes; only within.
 ;; The :experiential class has NO physical (joule) conversion by design.
 :invariants
 [{:id "I1" :rule "energy (conserved) and free-energy (information) are distinct attributes — never conflated"}
  {:id "I2" :rule "flow magnitudes are summed only WITHIN a unit class; no cross-class grand total exists"}
  {:id "I3" :rule "experiential flows have no joule conversion (meaning is subject-dependent)"}
  {:id "I4" :rule "cross-class visual magnitudes are flagged :uzu.flow/reference-only — layout, not unit identity"}
  {:id "I5" :rule "self-maintenance is earned: an organism whose meaning misreads the world dies (no immortality)"}]

 :attributes
 {:uzu.organism/id           {:type :string}
  :uzu.organism/alive        {:type :boolean}
  :uzu.organism/final-energy {:type :double :unit "energy (conserved)"}
  :uzu.organism/lifespan     {:type :long}
  :uzu.organism/beats        {:type :long}
  :uzu.organism/final-belief {:type :string}
  :uzu.beat/of               {:type :string}
  :uzu.beat/age              {:type :long}
  :uzu.beat/regime           {:type :string :note "the TRUE (hidden) regime that beat"}
  :uzu.beat/action           {:type :string}
  :uzu.beat/belief-of        {:type :string :note "the regime the organism BELIEVED most likely"}
  :uzu.beat/free-energy      {:type :double :unit "nats (information)"}
  :uzu.beat/energy           {:type :double :unit "energy (conserved)"}
  :uzu.beat/gained           {:type :double}
  :uzu.beat/spent            {:type :double}
  :uzu.beat/alive            {:type :boolean}
  :uzu.flow/id               {:type :string}
  :uzu.flow/label            {:type :string}
  :uzu.flow/class            {:type :string :enum :flow-class}
  :uzu.flow/unit             {:type :string :note "the flow's NATIVE unit, never normalized away"}
  :uzu.flow/magnitude        {:type :double}
  :uzu.flow/source           {:type :string}
  :uzu.flow/visual-log10-W   {:type :double :note "log visual size; physical-equivalent for cross-class"}
  :uzu.flow/reference-only   {:type :boolean :note "true ⇒ the visual magnitude is layout, not a unit claim"}
  :uzu/derived               {:type :boolean}
  :uzu/sourcing              {:type :string}}}
