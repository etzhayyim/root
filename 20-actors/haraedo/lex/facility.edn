;; com.etzhayyim.haraedo.facility — lexicon (EDN form)
;; ADR-2606010200
{:lexicon 1
 :id "com.etzhayyim.haraedo.facility"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["facilityId" "jurisdiction" "name" "kind" "lat" "lon"]
    :properties
    {:facilityId          {:type "string"}
     :jurisdiction        {:type "string"}
     :name                {:type "string"}
     :kind                {:type "string" :description "incinerator|recycling-center|landfill|transfer-station|bulky-dismantle|compost|mrf"}
     :lat                 {:type "number"}
     :lon                 {:type "number"}
     :capacityTonnesDay   {:type "number"}
     :acceptedCategories  {:type "array" :items {:type "string"}}
     :operatingHours      {:type "string"}
     :gateFeePerTonne     {:type "integer"}
     :sourcing            {:type "string" :description "authoritative|representative"}}}}}}
