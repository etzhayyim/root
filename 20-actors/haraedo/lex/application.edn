;; com.etzhayyim.haraedo.application — lexicon (EDN form)
;; ADR-2606010200
{:lexicon 1
 :id "com.etzhayyim.haraedo.application"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["applicationId" "memberDid" "jurisdiction" "items" "consentSig"]
    :properties
    {:applicationId    {:type "string"}
     :memberDid        {:type "string" :description "DID-bound; address/PII held encrypted (com.etzhayyim.encrypted.*)"}
     :jurisdiction     {:type "string"}
     :items            {:type "array" :items {:type "string"} :description "item-category codes"}
     :collectionPoint  {:type "string"}
     :scheduledDate    {:type "string" :format "datetime"}
     :fee              {:type "integer" :description "minor units; settled non-fiat (G7)"}
     :stickerId        {:type "string"}
     :consentSig       {:type "string" :description "DID-signed consent proof (G1)"}
     :state            {:type "string" :description "quoted|scheduled|stickered|assigned|collected|delivered|closed"}}}}}}
