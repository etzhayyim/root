;; haraedo 祓戸 — dispatch cell (langgraph, WASM runtime) — operator side
;; ADR-2606010200
;; 受付 → クラスタリング → 配車 → 担当者割当 → ルート最適化 → 搬入先決定
{:cell/id "dispatch"
 :cell/glyph "祓戸"
 :cell/kind :langgraph
 :cell/runtime :wasm
 :cell/entry "py/agent.py"
 :cell/handler "handle_dispatch"
 :cell/doc "Operator dispatch: gather applications → cluster area → assign vehicle → assign crew → optimize route (NN+2-opt) → select facility"
 :cell/state-graph
 {:nodes [:gather :cluster :assign-vehicle :assign-crew :optimize-route :select-facility :emit-plan]
  :entry :gather
  :edges [[:gather :cluster] [:cluster :assign-vehicle] [:assign-vehicle :assign-crew]
          [:assign-crew :optimize-route] [:optimize-route :select-facility] [:select-facility :emit-plan] [:emit-plan :end]]}
 :cell/llm
 {:provider :murakumo
  :endpoint "127.0.0.1:4000"
  :model "gemma3:4b"
  :charter-rider true}
 :cell/gates ["G2" "G5" "G11" "G14" "G15"]
 :cell/kotoba
 {:reads [:application/id :application/items :application/collection-point :application/scheduled-date
          :collection-point/lat :collection-point/lon :collection-point/service-area
          :vehicle/id :vehicle/capacity-kg :vehicle/status :vehicle/depot-lat :vehicle/depot-lon
          :crew/id :crew/role :crew/shift :crew/certifications
          :facility/id :facility/kind :facility/accepted-categories :facility/capacity-tonnes-day :facility/load-tonnes-today]
  :writes [:route/id :route/vehicle :route/crew :route/stops :route/stop-order
           :route/facility-destination :route/distance-km :route/load-kg :route/state
           :application/state :facility/load-tonnes-today]}}
