;; haraedo 祓戸 — fleet_registry cell (datalog, kotoba runtime)
;; ADR-2606010200
;; Vehicle (配車) + crew (担当者) registry per jurisdiction
{:cell/id "fleet_registry"
 :cell/glyph "祓戸"
 :cell/kind :datalog
 :cell/runtime :kotoba
 :cell/doc "Per-jurisdiction fleet: vehicles (capacity/depot/status) + crew (role/shift/cert/labor-level)"
 :cell/queries
 [{:q/name "available-vehicles"
   :q/datalog "[:find ?id ?kind ?cap :in $ ?j :where [?v :vehicle/jurisdiction ?j] [?v :vehicle/status :available] [?v :vehicle/id ?id] [?v :vehicle/kind ?kind] [?v :vehicle/capacity-kg ?cap]]"}
  {:q/name "crew-by-shift"
   :q/datalog "[:find ?id ?role :in $ ?j ?shift :where [?c :crew/jurisdiction ?j] [?c :crew/shift ?shift] [?c :crew/role ?role] [?c :crew/id ?id]]"}
  {:q/name "crew-by-cert"
   :q/datalog "[:find ?id ?role :in $ ?j ?cert :where [?c :crew/jurisdiction ?j] [?c :crew/certifications ?cert] [?c :crew/role ?role] [?c :crew/id ?id]]"}]}
