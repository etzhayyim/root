;; haraedo 祓戸 — intake cell (langgraph, WASM runtime) — citizen side
;; ADR-2606010200
{:cell/id "intake"
 :cell/glyph "祓戸"
 :cell/kind :langgraph
 :cell/runtime :wasm
 :cell/entry "py/agent.py"
 :cell/handler "handle_intake"
 :cell/doc "Citizen bulky-waste application: classify → quote → match-facility → schedule → sticker"
 :cell/state-graph
 {:nodes [:classify :quote :match-facility :schedule :sticker]
  :entry :classify
  :edges [[:classify :quote] [:quote :match-facility] [:match-facility :schedule] [:schedule :sticker] [:sticker :end]]}
 :cell/llm
 {:provider :murakumo
  :endpoint "127.0.0.1:4000"
  :model "gemma3:4b"
  :charter-rider true}
 :cell/gates ["G1" "G3" "G6" "G7" "G14"]
 :cell/kotoba
 {:reads [:item-category/code :item-category/base-fee :item-category/hazardous
          :facility/id :facility/accepted-categories :facility/capacity-tonnes-day
          :collection-point/id :jurisdiction/bulky-fee-model]
  :writes [:application/id :application/items :application/fee :application/sticker-id
           :application/scheduled-date :application/state]}}
