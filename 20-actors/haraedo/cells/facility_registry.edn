;; haraedo 祓戸 — facility_registry cell (datalog, kotoba runtime)
;; ADR-2606010200
;; Worldwide waste-processing facility registry (ゴミ処理場: 位置/種別/処理能力/受入品目)
{:cell/id "facility_registry"
 :cell/glyph "祓戸"
 :cell/kind :datalog
 :cell/runtime :kotoba
 :cell/doc "Worldwide processing-facility registry — coded 位置/種別/処理能力/受入品目/ゲート料金"
 :cell/queries
 [{:q/name "by-jurisdiction"
   :q/datalog "[:find ?id ?name ?kind :in $ ?j :where [?f :facility/jurisdiction ?j] [?f :facility/id ?id] [?f :facility/name ?name] [?f :facility/kind ?kind]]"}
  {:q/name "accepts-category"
   :q/datalog "[:find ?id ?name :in $ ?j ?cat :where [?f :facility/jurisdiction ?j] [?f :facility/accepted-categories ?cat] [?f :facility/id ?id] [?f :facility/name ?name]]"}
  {:q/name "with-spare-capacity"
   :q/datalog "[:find ?id ?cap ?load :in $ ?j :where [?f :facility/jurisdiction ?j] [?f :facility/id ?id] [?f :facility/capacity-tonnes-day ?cap] [?f :facility/load-tonnes-today ?load]]"}
  {:q/name "geo-all"
   :q/datalog "[:find ?id ?lat ?lon ?kind :where [?f :facility/id ?id] [?f :facility/lat ?lat] [?f :facility/lon ?lon] [?f :facility/kind ?kind]]"}]}
