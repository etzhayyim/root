{
  "@context": {
    "@vocab": "https://etzhayyim.com/ns/actor#",
    "id": "@id",
    "type": "@type"
  },
  "id": "actor:hoshimori",
  "type": "Actor",
  "name": "hoshimori",
  "glyph": "星守",
  "purpose": "Off-Earth / orbital (軌道) stewardship mirror — weaves orbital regimes / operators / hazards / services from PUBLIC catalogs into the kotoba Datom log; surfaces orbital-congestion concentration vs stewardship routed to STEWARDSHIP (orbital sustainability); shell-aggregate, no-targeting, no precise ephemeris.",
  "status": "R0-design-only",
  "tier": "B",
  "adr": "2606073600",
  "dependsOnAdr": ["2606073000", "2606073200", "2606073400", "2605192330", "2606041827", "2606012600", "2605312345", "2605215000"],
  "schema": ["00-contracts/schemas/orbit-ontology.kotoba.edn"],
  "substrate": {
    "state": "kotoba Datom log (ADR-2605312345) — methods/datom_emit.py emits canonical EAVT",
    "largeAssets": "DataLad → IPFS (80-data/orbit) — NO git-lfs",
    "inference": "Murakumo-only (ADR-2605215000)",
    "runtime": "kotoba pywasm actor (componentize-py) — pure-stdlib methods, no numpy"
  },
  "integrates": ["actor:watari", "actor:watatsuna", "actor:kabuto", "actor:tsumugi"],
  "lineage": "orbital sibling of the live/infrastructure-resilience lineage (watari live ship/aircraft KG, watatsuna cable chokepoints); sits under the orbital land-sovereignty claim (ADR-2605192330); OBSERVATION ONLY",
  "cells": [
    {
      "id": "cell:hoshimori.analyze",
      "method": "methods/analyze.py",
      "input": "data/seed-orbit-graph.kotoba.edn",
      "output": ["out/congestion-report.md"],
      "pipeline": "load-edn → edge-primary integral (Σ incident inbound hazard/occupancy load × disclosed regime weight) → congestion-concentration + stewardship-buffer + service-dependency-fragility + occupancy/hazard-concentration, shell-aggregate",
      "doc": "edge-primary orbital-congestion vs stewardship; stewardship map, never a targeting aid"
    },
    {
      "id": "cell:hoshimori.datom-emit",
      "method": "methods/datom_emit.py",
      "input": "data/seed-orbit-graph.kotoba.edn",
      "output": ["out/orbit-datoms.kotoba.edn"],
      "pipeline": "ground EAVT datoms [e a v tx :add] (durable, shell-aggregate only) + derived readouts flagged :bond/is-transient (computed on read, N1/G2)",
      "doc": "kotoba Datom-log projection — first-class canonical state (ADR-2605312345); no precise ephemeris"
    },
    {
      "id": "cell:hoshimori.coverage",
      "method": "methods/coverage_report.py",
      "input": "data/seed-orbit-graph.kotoba.edn",
      "output": ["out/coverage-report.md"],
      "pipeline": "regime + operator-kind + hazard-kind + service-kind → gap map (object-population context, modelled as shells)",
      "doc": "honest coverage (all-objects ~0 BY DESIGN — shells not objects, G1); names thin/missing buckets per wave (G5)"
    }
  ],
  "gates": {
    "G1": "STEWARDSHIP / sustainability map, NEVER a targeting / interception / weaponization aid — mirrors ONLY already-public catalogs; NO precise predictive ephemeris (no interception-grade state vector); readouts are orbital-shell / regime-aggregate; ASAT / kinetic-intercept / collision-causing uses unrepresentable (Charter §1.12 Transparent-Force)",
    "G2": "edge-primary (N1) — congestion lives only on :en/orbit-load; regime congestion is the integral computed on read; no :hoshimori/threat-of-object",
    "G3": "non-adjudicating (N3) — orbital-regime defs + named public debris EVENTS are DISCLOSED facts, never hoshimori verdicts",
    "G4": "public venue — open-source + on-chain + 1 SBT = 1 vote; never a private/covert orbital registry",
    "G5": "sourcing honesty — every record :authoritative | :representative; orbit-load values are representative severities, not measured conjunction probabilities; no fabricated coverage",
    "G6": "Murakumo-only narration (ADR-2605215000)",
    "G7": "outward-gated — live catalog ingest (space-track/CelesTrak-shaped public feeds) requires Council + operator DID; R0 = analyzer + schema + seed only",
    "G8": "observation-only — hoshimori operates no spacecraft and conducts no maneuver; it observes the public orbital commons and routes to stewardship"
  }
}
