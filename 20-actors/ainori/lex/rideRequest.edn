;; com.etzhayyim.ainori.rideRequest — lexicon (EDN form)
;; A pooled-ride need. NOTE: no surge/dynamic-price field and no driver-payment field
;; are representable (G1/G2); gig:const=false mirrors todoke.deliveryJob.
;; ADR-2606071500
{:lexicon 1
 :id "com.etzhayyim.ainori.rideRequest"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["requestId" "riderDid" "origin" "destination" "consentRef"]
    :properties
    {:requestId    {:type "string"}
     :riderDid     {:type "string" :description "member rider DID"}
     :origin       {:type "string" :description "geo DID / coarse point (exact via encrypted envelope, G7)"}
     :destination  {:type "string" :description "geo DID / coarse point"}
     :seats        {:type "integer" :description "seats needed"}
     :poolable     {:type "boolean" :description "const true — pooling-first (G11); solo is the exception, deprioritized"}
     :departWindow {:type "string"  :description "earliest..latest ISO interval"}
     :consentRef   {:type "string"  :description "DID-signed consent reference (G8)"}
     :gig          {:type "boolean" :description "const false — never a gig dispatch (G1)"}
     :mode         {:type "string"  :description "human-pooled|autonomous-pooled"}}}}}}
