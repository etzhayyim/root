;; com.etzhayyim.ainori.rideMatch — lexicon (EDN form)
;; Result of pooling a rideRequest onto a trip a member is already making (or a shuttle loop).
;; Fare is cost-share only — split of real fuel/wear, never a margin (G2).
;; ADR-2606071500
{:lexicon 1
 :id "com.etzhayyim.ainori.rideMatch"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["matchId" "requestId" "carrierDid" "routeId" "occupancy" "costShareMinor"]
    :properties
    {:matchId        {:type "string"}
     :requestId      {:type "string"}
     :carrierDid     {:type "string" :description "member-driver DID (human-pooled) OR fleet shuttle DID (autonomous-pooled)"}
     :routeId        {:type "string" :description "pooledRoute id from todoke-route sequencer"}
     :occupancy      {:type "integer" :description "riders pooled onto this trip (G11: higher is better)"}
     :detourMeters   {:type "integer" :description "added distance vs carrier's solo trip (kept minimal)"}
     :costShareMinor {:type "integer" :description "this rider's flat cost-share (fuel/energy+wear / occupancy); USDC minor; NO margin (G2)"}
     :titheMinor     {:type "integer" :description "10% TitheRouter split (G4)"}
     :driverPaidMinor {:type "integer" :description "const 0 — platform pays driver cash≡0 (G1); driver compensation is dividend, not here"}
     :envelopeOk     {:type "boolean" :description "SAE-L4 safety envelope satisfied (G3); false ⇒ match refused"}
     :settlementRef  {:type "string"  :description "warifu settlement ref (member-signed; intent-only at R0)"}
     :status         {:type "string"  :description "proposed|consented|enroute|completed|cancelled"}}}}}}
