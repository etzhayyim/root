namespace dji_onboard_sdk {

    entity Status {
        id: string @unique
        flight: integer
        mode: integer
        gear: integer
        error: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Battery {
        id: string @unique
        capacity: integer
        voltage: integer
        current: integer
        percentage: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity GlobalPosition {
        id: string @unique
        latitude: float
        longitude: float
        altitude: float
        height: float
        health: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity GPSDetail {
        id: string @unique
        hdop: float
        pdop: float
        fix: float
        gnssStatus: float
        hacc: float
        sacc: float
        usedGPS: integer
        usedGLN: integer
        NSV: integer
        GPScounter: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity FlightAnomaly {
        id: string @unique
        impactInAir: boolean
        randomFly: boolean
        heightCtrlFail: boolean
        rollPitchCtrlFail: boolean
        yawCtrlFail: boolean
        aircraftIsFalling: boolean
        strongWindLevel1: boolean
        strongWindLevel2: boolean
        compassInstallationError: boolean
        imuInstallationError: boolean
        createdAt: datetime
        updatedAt: datetime
    }

}
