;; com.etzhayyim.omise.order — lexicon (EDN form)
;; An order against a storefront listing. Settlement is seller↔buyer + TitheRouter 10% only —
;; the platform takes nothing (G2). Customer PII is encrypted (G9); buyer signs (G12).
;; ADR-2606071400
{:lexicon 1
 :id "com.etzhayyim.omise.order"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["orderId" "listingId" "buyerDid" "qty" "consentRef"]
    :properties
    {:orderId        {:type "string"}
     :listingId      {:type "string"}
     :storefrontId   {:type "string"}
     :buyerDid       {:type "string" :description "SBT member buyer DID"}
     :qty            {:type "integer"}
     :consentRef     {:type "string" :description "DID-signed consent reference (G1)"}
     :subtotalMinor  {:type "integer" :description "qty × priceMinor (USDC minor)"}
     :commissionMinor {:type "integer" :description "const 0 — zero platform commission (G2)"}
     :titheMinor     {:type "integer" :description "10% TitheRouter split (G7)"}
     :sellerNetMinor {:type "integer" :description "subtotal − tithe; goes to seller directly (no platform cut)"}
     :fulfilmentRef  {:type "string" :description "todoke/logistics handoff ref (G8)"}
     :settlementRef  {:type "string" :description "warifu settlement ref (buyer-signed; intent-only at R0)"}
     :status         {:type "string" :description "placed|consented|settled|fulfilling|completed|cancelled"}
     :recordEnc      {:type "boolean" :description "const true — order PII via com.etzhayyim.encrypted.* (G9)"}}}}}}
