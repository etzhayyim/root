;; com.etzhayyim.omise.listing — lexicon (EDN form)
;; A storefront listing. Shape-compatible with com.etzhayyim.okaimono.product :ring "internal"
;; (G11) so it is discoverable in okaimono with no integration glue.
;; NOTE: no commission/take-rate field and no sponsored/boost field are representable (G2/G4).
;; ADR-2606071400
{:lexicon 1
 :id "com.etzhayyim.omise.listing"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["listingId" "storefrontId" "sellerDid" "title" "priceMinor" "laborProvenance"]
    :properties
    {:listingId        {:type "string"}
     :storefrontId     {:type "string"}
     :sellerDid        {:type "string" :description "producing-actor id OR SBT member DID (G3)"}
     :title            {:type "string"}
     :makerActor       {:type "string" :description "etzhayyim producing actor (maps to okaimono :product/maker-actor)"}
     :unspsc           {:type "string"}
     :gtin             {:type "string"}
     :priceMinor       {:type "integer" :description "USDC minor units; no take-rate added (G2)"}
     :currency         {:type "string" :description "const USDC for internal ring"}
     :inventory        {:type "integer" :description "on-hand units; honest count (no false scarcity, G5)"}
     :durabilityYears  {:type "number"}
     :repairability    {:type "integer" :description "0..10 iFixit-style (surfaced for Wellbecoming ordering, G5)"}
     :laborProvenance  {:type "string" :description "etzhayyim-dignity|verified-fair|disclosed (G8)"}
     :carbonKg         {:type "number"}
     :lifecycleRoute   {:type "string" :description "hodoki|kanayama|haraedo|wakai|commons-return"}
     :fulfilmentActor  {:type "string" :description "logistics actor for handoff (todoke/…), G8"}
     :ring             {:type "string" :description "const internal (okaimono Ring-1 coherence, G11)"}
     :sourcing         {:type "string" :description "authoritative|representative"}}}}}}
