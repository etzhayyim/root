namespace arm_isa {

    entity ConditionCode {
        id: string @unique
        suffix: string
        meaning: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity ExceptionLevel {
        id: string @unique
        level: string
        typicalUsage: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity PrivilegeModel {
        id: string @unique
        name: string
        description: string
        createdAt: datetime
        updatedAt: datetime
    }

}
