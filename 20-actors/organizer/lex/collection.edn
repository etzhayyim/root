;; com.etzhayyim.organizer.collection — lexicon (EDN form)
;; A collection (auto-organize bucket) within a vault. autoRules drive classification →
;; membership. Scoped to one vault (G3); no public-share / cross-vault field exists.
;; ADR-2606072400
{:lexicon 1
 :id "com.etzhayyim.organizer.collection"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["collectionId" "vaultDid" "name"]
    :properties
    {:collectionId {:type "string"}
     :vaultDid     {:type "string" :description "owner vault (G3)"}
     :name         {:type "string"}
     :description  {:type "string"}
     :autoRules    {:type "array"
                    :description "organize rules: condition (category|label) → this collection"
                    :items {:type "object"
                            :required ["condition"]
                            :properties {:id        {:type "string"}
                                         :condition {:type "object"}
                                         :priority  {:type "integer"}}}}}}}}}
