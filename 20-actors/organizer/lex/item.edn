;; com.etzhayyim.organizer.item — lexicon (EDN form)
;; A stored item. `itemId` is content-addressed (derived from blake3) so identical content
;; dedups to one item (G4). `vaultDid` isolates ownership (G3). The blob is referenced as an
;; encrypted envelope, never plaintext (G5). NO :*/profile, :*/ad-signal, :*/share-public field.
;; ADR-2606072400
{:lexicon 1
 :id "com.etzhayyim.organizer.item"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["itemId" "vaultDid" "blake3" "blobRef" "filename"]
    :properties
    {:itemId      {:type "string" :description "content-addressed: cid.{blake3-prefix} (G4 dedup key)"}
     :vaultDid    {:type "string" :description "did:web:organizer.etzhayyim.com:vault:{nanoid} — owner isolation (G3)"}
     :blake3      {:type "string" :description "Blake3 hex of content (dedup identity, G4)"}
     :blobRef     {:type "string" :description "com.etzhayyim.encrypted.* envelope ref — NO plaintext blob (G5)"}
     :filename    {:type "string"}
     :contentType {:type "string"}
     :sizeBytes   {:type "integer"}
     :postedBy    {:type "string" :description "member DID that signed the upload (G6)"}
     :postedSig   {:type "string" :description "member signature ref; server sig refused (G6)"}}}}}}
