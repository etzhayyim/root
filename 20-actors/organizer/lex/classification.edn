;; com.etzhayyim.organizer.classification — lexicon (EDN form)
;; AI classification of an item — for the OWNER's organization only (G2). Carries category /
;; labels / confidence, NEVER a user profile, ad signal, or cross-vault aggregate. Scoped to
;; the item's vault (G3). Model is a Murakumo model id (G7).
;; ADR-2606072400
{:lexicon 1
 :id "com.etzhayyim.organizer.classification"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["itemId" "vaultDid" "category"]
    :properties
    {:itemId      {:type "string"}
     :vaultDid    {:type "string" :description "same vault as the item (G3)"}
     :category    {:type "string" :description "top-level auto-organize category (document|image|receipt|media|archive|...)"}
     :subcategory {:type "string"}
     :labels      {:type "array" :items {:type "string"} :description "owner-facing labels only — never a behavioral/ad profile (G2)"}
     :confidence  {:type "number" :description "0..1"}
     :model       {:type "string" :description "Murakumo model id (G7); no external LLM"}
     :source      {:type "string" :description "rule | murakumo (deterministic rule first, LLM fallback)"}}}}}}
