namespace bis {

    entity DataQuery {
        id: string @unique
        flowRef: string
        key: string
        startPeriod: string
        endPeriod: string
        updatedAfter: datetime
        firstNObservations: integer
        lastNObservations: integer
        detail: string
        includeHistory: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Dataflow {
        id: string @unique
        agencyID: string
        version: string
        name: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Series {
        id: string @unique
        seriesKey: string
        frequency: string
        lastUpdated: datetime
        createdAt: datetime
        updatedAt: datetime
    }

}
