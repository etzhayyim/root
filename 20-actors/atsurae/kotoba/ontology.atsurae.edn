;; atsurae 誂え — ontology (kotoba EAVT schema, ADR-2606212010)
;; The Product Line Engineering (PLE) feature-model actor — the product-FAMILY layer the roster
;; lacked: open-kyber 開 = ERP, uchiwake 内訳 = per-product BOM, atsurae = the feature model from
;; which a FAMILY of variants is derived (誂え = bespoke, configured-to-order) with shared
;; commonality + bounded variability. A COMMONS spec, never a license key. SPEC + DERIVATION
;; only — atsurae never manufactures (sanae/giemon/sarutahiko/funadaiku build, under Council gate).
;;
;; Attribute namespaces:
;;   :atsurae.feature/*  — DERIVED per-feature analysis (commonality, role)
;;   :atsurae.line/*     — DERIVED product-line summary (n-features, n-variants, n-variation-points)
;;   :atsurae/derived    — true on every derived datom
;;   :atsurae/sourcing   — ":authoritative" | ":representative" | ":synthetic"

{:ontology/id "atsurae"
 :ontology/version "0.1.0"
 :ontology/adr ["2606212010" "2606037200" "2606081800" "2606032100" "2605262130"]

 :node-kinds
 [{:kind :feature
   :doc "A feature in the model. :kind governs a non-grouped child; :group imposes cardinality on its children."
   :keys [:id :parent :kind :group]}
  {:kind :constraint
   :doc "A cross-tree constraint between two features."
   :keys [:kind :from :to]}
  {:kind :binding
   :doc "A feature → parts binding for BOM derivation."
   :keys [:feature :parts]}]

 :enums
 {:feature-kind #{:root :mandatory :optional :grouped}  ;; :grouped = a child of a :xor/:or group
  :group        #{:xor :or nil}                          ;; :xor = exactly 1 child; :or = ≥1 child
  :constraint-kind #{:requires :excludes}
  :feature-role #{:platform :variation-point :dead}}     ;; commonality 1.0 / (0,1) / 0.0

 ;; negative space — structurally absent (enforced by tests)
 :unrepresentable
 [":atsurae/license-lock"  ;; G1 — a feature model is a COMMONS spec, never a vendor license key
  ":atsurae/drm"           ;; G1 — no configuration-locking / entitlement gating
  ":atsurae/manufacture"   ;; G2 — atsurae never builds; sanae/giemon/sarutahiko/funadaiku build under Council gate
  ":atsurae.product/verdict"]} ;; G3 — validity is STRUCTURAL, never a good/bad product adjudication
