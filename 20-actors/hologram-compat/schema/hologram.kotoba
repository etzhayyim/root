// Hologram clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace hologram {

    entity Device {
        id: string @unique
        orgid: integer
        name: string
        type: string
        whencreated: datetime
        phonenumber: string
        tunnelable: boolean
        imei: string
        hidden: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity CellularLink {
        id: string @unique
        deviceid: integer
        devicename: string
        orgid: integer
        sim: string
        msisdn: string
        state: string
        whenclaimed: datetime
        whenexpires: datetime
        euiccType: string
        euiccState: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity DataPlan {
        id: string @unique
        name: string
        partnerid: integer
        description: string
        data: integer
        recurring: boolean
        enabled: boolean
        billingperiod: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity SmsRecord {
        id: string @unique
        linkid: integer
        recordId: integer
        timestamp: datetime
        direction: string
        otherNumber: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Tag {
        id: string @unique
        name: string
        createdAt: datetime
        updatedAt: datetime
    }

}
