        bkclass: string
        active: boolean
        charter: string
        insdate: datetime
        effdate: datetime
        webaddr: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Failure {
        id: string @unique
        name: string
        cert: integer
        city: string
