// Elevenlabs clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace elevenlabs {

    entity Voice {
        id: string @unique
        voiceId: string
        name: string
        category: string
        description: string
        previewUrl: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Sample {
        id: string @unique
        sampleId: string
        fileName: string
        mimeType: string
        hash: string
        sizeBytes: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity HistoryItem {
        id: string @unique
        historyItemId: string
        voiceId: string
        voiceName: string
        text: string
        contentType: string
        state: string
        dateUnix: integer
        requestId: string
        characterCountChangeFrom: integer
        characterCountChangeTo: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity TTSModel {
        id: string @unique
        modelId: string
        displayName: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Subscription {
        id: string @unique
        tier: string
        status: string
        currency: string
        characterCount: integer
        characterLimit: integer
        voiceLimit: integer
        professionalVoiceLimit: integer
        canUseInstantVoiceCloning: boolean
        canUseProfessionalVoiceCloning: boolean
        canExtendCharacterLimit: boolean
        canExtendVoiceLimit: boolean
        nextCharacterCountResetUnix: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity User {
        id: string @unique
        isNewUser: boolean
        createdAt: datetime
        updatedAt: datetime
    }

}
