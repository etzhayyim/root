  :proc/trigger-keywords ["procédure collective" "déclaration de créance"]
  :proc/genuine-channels [:mail :formal-service]
  :proc/deadline-rules
  [{:dl/label "Déclaration de créance"
    :dl/rule "BODACC 公告から2か月以内 (国外債権者は+2か月) に mandataire judiciaire へ déclaration — 徒過は forclusion (失権; relevé de forclusion は例外的)"
    :dl/anchor "Code de commerce L.622-24・R.622-24" :dl/critical true :dl/verify-service-date true}]
  :proc/options
  [{:opt/id :declarer :opt/kind :self-submit :opt/protective true
    :opt/label "déclaration de créance を期限内に (オンライン可) — 前払金・avoir も債権 (kaiyaku 縁-ledger 突合)"}
   {:opt/id :check-bodacc :opt/kind :self-decide :opt/label "BODACC 公告日を確認 (起算点)"}]
  :proc/refer-when ["担保付き・高額 → avocat"]
  :proc/verify-current-law true}

 ;; ── :pl ──────────────────────────────────────────────────────────────────────
 {:proc/id "proc:pl-nakaz-zaplaty" :proc/label "Nakaz zapłaty (支払命令・ポーランド)"
  :proc/jurisdiction :pl
  :proc/trigger-keywords ["nakaz zapłaty"]
  :proc/genuine-channels [:formal-service :mail]
  :proc/deadline-rules
  [{:dl/label "Sprzeciw / zarzuty (異議)"
    :dl/rule "doręczenie (送達) から2週間以内に sprzeciw (upominawcze) または zarzuty (nakazowe)"
    :dl/anchor "KPC art. 480² § 1 / art. 505" :dl/verify-service-date true}]
  :proc/options
  [{:opt/id :sprzeciw :opt/kind :self-submit :opt/label "sprzeciw を発令裁判所へ提出 (→ 通常手続へ)"}
   {:opt/id :pay-or-settle :opt/kind :self-decide :opt/label "請求に理由がある場合: 支払い/分割交渉"}]
  :proc/refer-when ["nakazowe (手形等) は zarzuty に手数料 — 早めに専門家へ"]
  :proc/verify-current-law true}

 ;; ── :se ──────────────────────────────────────────────────────────────────────
 {:proc/id "proc:se-betalningsforelaggande" :proc/label "Betalningsföreläggande (支払督促・スウェーデン)"
  :proc/jurisdiction :se
  :proc/trigger-keywords ["betalningsföreläggande"]
  :proc/genuine-channels [:formal-service :mail]
  :proc/deadline-rules
  [{:dl/label "Bestrida (異議)"
    :dl/rule "föreläggande 記載の förklaringstid (回答期限 — 通常2週間程度) 内に書面で bestrida"
    :dl/anchor "Lag (1990:746) om betalningsföreläggande och handräckning" :dl/verify-service-date true}]
  :proc/options
  [{:opt/id :bestrida :opt/kind :self-submit :opt/label "Kronofogden へ書面で bestrida (→ 申立人が裁判所移行を選択)"}
   {:opt/id :pay-or-settle :opt/kind :self-decide :opt/label "請求に理由がある場合: 支払い (記録に注意 — betalningsanmärkning)"}]
  :proc/refer-when ["異議後 tingsrätt へ移行した場合"]
  :proc/verify-current-law true}

 ;; ── :br ──────────────────────────────────────────────────────────────────────
 {:proc/id "proc:br-dispensa" :proc/label "Comunicação de dispensa (解雇・労働・ブラジル)"
  :proc/jurisdiction :br :proc/track :labor
  :proc/trigger-keywords ["dispensa" "aviso prévio"]
  :proc/genuine-channels [:mail :personal-service]
  :proc/deadline-rules
  [{:dl/label "Prescrição (時効)"
    :dl/rule "reclamação trabalhista は contrato 終了から2 anos 以内 (遡及できる債権は5 anos 分) — verbas rescisórias の支払は終了から10日以内 (CLT 477)"
    :dl/anchor "CF art. 7º XXIX / CLT art. 477" :dl/verify-service-date true}]
  :proc/options
  [{:opt/id :verbas-check :opt/kind :self-decide :opt/protective true
    :opt/label "verbas rescisórias (aviso prévio・férias・13º・FGTS+40%) の計算を点検 — TRCT サイン前に"}
   {:opt/id :seguro-desemprego :opt/kind :self-submit :opt/label "seguro-desemprego を申請 (dispensa sem justa causa)"}]
  :proc/refer-when ["justa causa に争い → advogado trabalhista / sindicato"
                    "kokoro 心 (精神的サポート)"]
  :proc/verify-current-law true}

 {:proc/id "proc:br-citacao" :proc/label "Citação (訴状送達・ブラジル)"
  :proc/jurisdiction :br
  :proc/trigger-keywords ["citação"]
  :proc/genuine-channels [:formal-service :mail]
  :proc/deadline-rules
  [{:dl/label "Contestação (答弁)"
    :dl/rule "15日 (dias úteis・営業日) 以内に contestação — 起算は CPC art. 231 の送達態様による"
    :dl/anchor "CPC 2015 arts. 335・231" :dl/verify-service-date true}]
  :proc/options
  [{:opt/id :contestacao :opt/kind :self-submit :opt/label "contestação を提出 (revelia = 欠席擬制の回避)"}
   {:opt/id :pay-or-settle :opt/kind :self-decide :opt/label "請求に理由がある場合: 支払い/acordo"}]
  :proc/refer-when ["Juizados 20 salários mínimos 超は advogado 必須 (Lei 9.099/1995 art. 9)"]
  :proc/verify-current-law true}]
