 {:proc/id "proc:us-eviction" :proc/label "Eviction notice (notice to quit, 住居・米国)"
  :proc/jurisdiction :us :proc/track :housing
  :proc/trigger-keywords ["notice to quit" "pay rent or quit"]
  :proc/genuine-channels [:personal-service :mail]
  :proc/deadline-rules
  [{:dl/label "通知期間 (州法)"
    :dl/rule "通知種別 (pay-or-quit / cure-or-quit / no-fault) と日数は州法による — 期限内の支払/是正で多くは解消 (例 CA 3-day pay-or-quit)"
    :dl/anchor "州 landlord-tenant law (例 Cal. CCP §1161)" :dl/verify-service-date true}
   {:dl/label "強制退去の発生時点"
    :dl/rule "強制退去は unlawful detainer 訴訟 + 裁判所命令 + sheriff によってのみ — self-help eviction (鍵交換・電気停止) はほぼ全州で違法"
    :dl/anchor "州法 (例 Cal. Civ. Code §789.3)" :dl/verify-service-date true}]
  :proc/options
  [{:opt/id :cure :opt/kind :self-decide :opt/label "期限内に支払/是正して通知を解消 (領収記録を残す)"}
   {:opt/id :answer-ud :opt/kind :self-submit :opt/label "unlawful detainer が提起されたら answer を期限内に提出 (期限は極端に短い — 例 CA 10日)"}
