  [{:opt/id :oposicion :opt/kind :self-submit :opt/protective true :opt/label "salario mínimo inembargable・excedente の30%上限を超える embargo には juez へ異議を提出 (pensión alimenticia を除く)"}
   {:opt/id :verify :opt/kind :self-decide :opt/protective true :opt/label "descuento/embargo が salario mínimo 床・excedente の30%上限を超えていないか empleador/expediente で確認"}]
