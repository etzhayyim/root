   {:dl/label "賃金請求権の消滅時効"
    :dl/rule "未払賃金の請求権は3年で時効 (当分の間) — 異議・交渉は早いほど良い"
    :dl/anchor "労働基準法115条" :dl/source-url "https://laws.e-gov.go.jp/law/322AC0000000049" :dl/verify-service-date true}]
