  :proc/refer-when ["請求額が大きい" "退職・不動産・名誉毀損など専門領域"]
  :proc/verify-current-law true}

 ;; ── :us ──────────────────────────────────────────────────────────────────────
 {:proc/id "proc:us-summons" :proc/label "Summons + Complaint (民事訴訟・米国)"
  :proc/jurisdiction :us
  :proc/trigger-keywords ["summons" "complaint has been filed against you"]
  :proc/genuine-channels [:personal-service :certified-mail :sheriff-service]
  :proc/deadline-rules
  [{:dl/label "Answer の提出"
    :dl/rule "連邦: 送達から21日以内 (FRCP 12(a)(1)(A)); 州裁判所は概ね20〜30日 — サモンズ記載の期限と州規則を確認"
    :dl/anchor "FRCP 12(a) / 各州 Rules of Civil Procedure" :dl/verify-service-date true}]
  :proc/options
  [{:opt/id :answer :opt/kind :self-submit :opt/label "Answer (認否 + affirmative defenses) を裁判所へ提出"}
   {:opt/id :appear :opt/kind :self-decide :opt/label "default judgment 回避のため必ず応答 (欠席 = 敗訴扱い)"}]
  :proc/refer-when ["claim が大きい" "連邦訴訟・クラスアクション → 常に弁護士"]
  :proc/verify-current-law true}

 {:proc/id "proc:us-small-claims" :proc/label "Small Claims 通知 (米国・州裁判所)"
  :proc/jurisdiction :us
  :proc/trigger-keywords ["small claims"]
  :proc/genuine-channels [:personal-service :certified-mail]
  :proc/deadline-rules
  [{:dl/label "応答/出頭"
    :dl/rule "州により異なる (上限額も $2,500〜$25,000 程度で州差) — 通知記載の期日と州規則を確認"
    :dl/anchor "各州 small-claims rules" :dl/verify-service-date true}]
  :proc/options
  [{:opt/id :appear :opt/kind :self-decide :opt/label "期日に出頭して主張 (多くの州で弁護士なし前提の手続)"}
   {:opt/id :answer :opt/kind :self-submit :opt/label "州が求める場合: 書面 Answer を提出"}]
  :proc/refer-when ["反訴 (counterclaim) を検討する"]
  :proc/verify-current-law true}

