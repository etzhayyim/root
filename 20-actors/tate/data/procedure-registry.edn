  [{:dl/label "督促異議の申立て"
    :dl/rule "支払督促の送達を受けた日から2週間以内 (経過後も仮執行宣言送達から2週間は申立て可)"
    :dl/anchor "民事訴訟法391条・393条" :dl/source-url "https://laws.e-gov.go.jp/law/408AC0000000109" :dl/critical true :dl/verify-service-date true}]
