;; tate 盾 — coded clause-pattern registry (ADR-2606112300). :representative — a bounded,
;; honest subset of common disadvantageous-clause SHAPES in consumer ToS / credit-card
;; member agreements / B2B contracts. NOT a verdict table: each entry carries a DISCLOSED
;; statutory anchor the member (or their professional) checks against; tate never asserts
;; invalidity (G2 non-adjudicating). :verify-current-law true on every entry — statutes
;; amend; the anchor is a pointer, not legal advice.
;;
;; :clause/context :consumer | :card | :b2b   (consumer anchors NEVER applied to :b2b — G5)
;; :clause/route   where a hit goes: :kurashimori (rights) | :kaiyaku (sever the tie)
;;                 | :referral (professional) | :info

[{:clause/id "cl:auto-renewal-trap" :clause/label "自動更新 + 狭い解約通知窓"
  :clause/context :consumer :clause/risk :mid
  :clause/keywords ["自動的に更新" "更新月の前月までに" "申出がない限り更新"]
  :clause/anchor "民法548条の2第2項 (定型約款・不当条項の組入制限)"
  :clause/route :kaiyaku :clause/verify-current-law true}

