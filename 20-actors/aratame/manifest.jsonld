  "dataSubstrate": {
    "engine": "kotoba (ADR-2605262130) — datom/EAVT on kotoba-kqe + MST records com.etzhayyim.aratame.*; NOT akuma's older RisingWave plane",
    "vault": "Raw scan payloads + detected secrets + owner-issued read-only credentials ciphertext in vault.etzhayyim.com (zero-knowledge invariant); secrets as com.etzhayyim.encrypted.* envelopes only (ADR-2605181100, G7)",
    "egressNamespace": "aratame-scan — NetworkPolicy reconciled from active mandates; egress only to the owner-attested git source endpoint (read), never elsewhere; no code execution (G3, G11)",
    "inferencePath": "Murakumo only (ADR-2605215000) — judah LiteLLM 127.0.0.1:4000 → gemma4-26b-a4b (Gemma 4 MoE ~26B total / ~4B active); NO vendor LLM API callout (G10). NEW fleet registration required (fleet serves gemma4:e4b today)."
  },
  "constitutionalGates": {
    "description": "14 immutable gates per ADR-2606024000. Council Lv6+ supermajority + new ADR to amend (Lv7+ if constitutional invariant per Preamble §0.4).",
    "gates": {
      "G1": "Every emitted text MUST pass Charter Rider §2(a)-(h) scan (etzhayyim_organism.sensors.charter_rider.scan); fail = block",
      "G2": "kotoba datom lineage — append-only EAVT, no soft delete",
      "G3": "READ-ONLY / STATIC-ONLY — never executes the target code, never writes the repo; codeExecutionCount=0, writeToTargetCount=0; inspectionMandate.readOnly const true + inspectionReport.executedCode const false",
      "G4": "Dual-signature InspectionMandate (owner + authority ∈ etzhayyim chain), parallel to akuma scope",
      "G5": "OSS-TOOLING-ONLY — Semgrep OSS / CodeQL OSS terms / OSV-Scanner / Trivy / gitleaks / trufflehog OSS; commercial SAST/SCA SaaS PROHIBITED (§2(e))",
      "G6": "NO PLATFORM-HELD KEY (ADR-2605231525) — private-repo read via owner-issued least-privilege read-only expiring credential (vault ciphertext); platformHeldKeyCount=0",
      "G7": "Secret-encryption — detected secrets stored only as com.etzhayyim.encrypted.* envelope refs (Signal-wrapped, DID-bound, ADR-2605181100), never plaintext; plaintextSecretCount=0",
      "G8": "NON-ADJUDICATING — findings are evidence / accountability map, not a verdict or exploitation target-list; vulnFinding.nonAdjudicating const true",
      "G9": "DEFENSIVE-ONLY / NO EXPLOIT — Charter Rider §2(a); no PoC/exploit generation even as a test fixture; vulnFinding.defensiveContextOnly const true",
      "G10": "Murakumo-only inference (ADR-2605215000) — triage_synthesis via judah LiteLLM 127.0.0.1:4000, model gemma4-26b-a4b; no vendor LLM API",
      "G11": "Egress-restricted sandbox — clone + scan in aratame-scan namespace; egress only to the owner-attested git source (read), never elsewhere",
      "G12": "Rate limit — maxReposPerWindow per mandate",
      "G13": "PROPOSE-ONLY HANDOFF — aratame emits findings only; remediation is tsukuroi's (propose-only); aratame never patches/commits/merges/opens a PR",
      "G14": "Bonsai pruning (ADR-2605091800) — out-of-mandate repo / code execution / plaintext secret / vendor inference → seed-tier prune (full freeze + human review)"
    }
  },
  "nonGoals": {
    "description": "12 explicitly excluded scopes",
    "goals": {
      "N1": "NOT a runtime / blackbox scanner (that is akuma) — static source only",
      "N2": "NOT a patch generator / remediation actor (that is tsukuroi)",
      "N3": "NOT a code executor / dynamic analysis / DAST / fuzzer",
      "N4": "NOT an exploit / PoC generator",
      "N5": "NOT a commercial SAST/SCA SaaS (Snyk / Veracode / Checkmarx / Black Duck / GHAS-paid / SonarQube-paid PROHIBITED §2(e); OSS only)",
      "N6": "NOT a platform-key / credential holder",
      "N7": "NOT operating outside an owner-attested mandate (no inspecting arbitrary / third-party repos)",
      "N8": "NOT a target-list / attack-surface-for-offense producer (non-adjudicating accountability + resilience map only)",
      "N9": "NOT a substitute for human security review (it surfaces evidence; humans decide)",
      "N10": "NOT Murakumo-bypass",
      "N11": "NOT Charter Rider §2 bypass",
      "N12": "NOT a state-aligned / military code-audit operation (Charter §1.12; all inspection logged on-chain + open-source — Transparent Force discipline)"
    }
  },
