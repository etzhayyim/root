  "@type": "ActorManifest",
  "id": "did:web:aratame.etzhayyim.com",
  "name": "aratame",
  "displayName": "改め — Inspect (authorized GitHub-repo source-code vulnerability inspection)",
  "displayNameJa": "改め",
  "displayNameEn": "Aratame",
  "nanoid": "4r4t4m3i",
  "description": "Non-profit religious-corp authorized static-source vulnerability-inspection actor; the static-source diagnosis sibling of akuma (悪魔, ADR-2605151400, runtime/blackbox) and the upstream finding source for tsukuroi (繕い, ADR-2605291500, remediation). Takes an owner-attested GitHub repo → READ-ONLY clone repo@ref into an egress-restricted sandbox → OSS SAST (Semgrep OSS / CodeQL OSS) + SCA (OSV-Scanner / Trivy + giemon purl→CVE) + secret scan (gitleaks / trufflehog OSS) → Murakumo-only LLM triage (gemma4-26b-a4b, dedup/severity/false-positive, NON-adjudicating) → emit tsukuroi-compatible com.etzhayyim.aratame.vulnFinding + an aggregate inspectionReport. READ-ONLY + STATIC-ONLY: aratame NEVER executes the target code, NEVER writes to the repo, holds NO platform master key; remediation is tsukuroi's (propose-only). 8 cells / 6 Lexicons under com.etzhayyim.aratame.* / 14 immutable gates / 12 non-goals. kotoba-native (datom/EAVT + MST; NOT akuma's older RisingWave plane).",
  "descriptionJa": "非営利 religious-corp の許可済み静的ソース脆弱性検査 actor。akuma (悪魔, runtime/blackbox) の静的ソース診断 sibling であり、tsukuroi (繕い, remediation) の上流 finding source。owner 署名済み GitHub repo を受け、repo@ref を READ-ONLY で egress 制限 sandbox に clone し、OSS の SAST (Semgrep OSS / CodeQL OSS) + SCA (OSV-Scanner / Trivy + giemon purl→CVE) + secret scan (gitleaks / trufflehog OSS) を実行し、Murakumo-only LLM (gemma4-26b-a4b) で dedup/severity/false-positive triage(非裁定)し、tsukuroi 互換の com.etzhayyim.aratame.vulnFinding と inspectionReport を発行する。READ-ONLY + STATIC-ONLY: 対象コードを実行せず、repo に書き込まず、platform master key も保持しない。修復は tsukuroi(propose-only)。8 cells / 6 Lexicons / 14 不変ゲート / 12 non-goals。kotoba-native (datom/EAVT + MST)。推論モデル gemma4-26b-a4b は Murakumo fleet への新規登録が必要(現状 gemma4:e4b)。",
  "adr": {
    "master": "etzhayyim:adr:2606024000",
    "runtimeDiagnosisSibling": "etzhayyim:adr:2605151400",
    "remediationSibling": "etzhayyim:adr:2605291500",
    "parent": "etzhayyim:adr:2605192100",
    "r0": "etzhayyim:adr:2606024000",
    "r1": "reserved",
    "r2": "reserved",
    "r3": "reserved"
  },
  "tier": "Tier-B",
  "parentActor": null,
  "siblingActor": "did:web:akuma.etzhayyim.com",
  "crossActorData": [
    "did:web:akuma.etzhayyim.com"
  ],
  "crossActorProcedure": [
    "did:web:tsukuroi.etzhayyim.com (downstream remediation — consumes com.etzhayyim.aratame.vulnFinding as a finding source alongside akuma's runtime VulnFinding)",
    "did:web:akuma.etzhayyim.com (runtime-diagnosis sibling — complementary blackbox finding source; distinct egress namespace)",
    "did:web:chigiri.etzhayyim.com (dispute mediation sink — any zero-counter violation routes to chigiri.disputeMediation)",
    "did:web:toritate.etzhayyim.com (future R3 — on-chain inspection audit trail)",
    "did:web:kataribe.etzhayyim.com (future R3 — coordinated public disclosure)"
  ],
  "form": "任意団体 internal source-inspection substrate (NOT a commercial managed SAST/SCA SaaS; non-profit only — Preamble §0.4 Lv7+ unanimity lock)",
  "capabilityCeiling": {
    "constitutional": true,
    "readOnlyStaticOnly": "aratame clones source READ-ONLY and runs STATIC analyzers. It MUST NOT execute the target code, run dynamic analysis / DAST / fuzzing, or write/commit/push to the repo. Structural: inspectionMandate.readOnly const true + inspectionReport.executedCode const false (G3); silenAratameReview.codeExecutionCount=0 + writeToTargetCount=0.",
    "ossToolingOnly": "Scanners are OSS under an OSS-permitted license (Semgrep OSS / CodeQL OSS terms / OSV-Scanner / Trivy / gitleaks / trufflehog OSS). Commercial SAST/SCA SaaS is PROHIBITED (Charter Rider §2(e)). (G5)",
    "nonAdjudicating": "Findings are evidence / an accountability + resilience map for the owner to act on — NOT a verdict, NOT an exploitation target-list. Structural: vulnFinding.nonAdjudicating const true + inspectionReport.nonAdjudicating const true (G8).",
    "defensiveOnly": "Describes a weakness; NO PoC / exploit / offensive payload, even as a test fixture (Charter Rider §2(a)). Structural: vulnFinding.defensiveContextOnly const true (G9).",
    "noPlatformHeldKey": "aratame never holds a platform master credential (ADR-2605231525). Private-repo read access uses an owner-issued, least-privilege, READ-ONLY, expiring credential referenced (not stored) by accessCredentialRef; vault ciphertext. (G6)"
  },
  "scope": {
    "phase": "R0 scaffold",
    "scopeBoundary": "Authorized static-source vulnerability inspection of an owner-attested GitHub repository, scoped to a dual-signed InspectionMandate pinned to a repo@ref",
    "exclusions": [
      "runtime / blackbox probing / active security testing (that is akuma)",
      "patch generation / remediation / PR submission (that is tsukuroi)",
      "code execution / dynamic analysis / DAST / fuzzing",
      "exploit / PoC / offensive payload generation (Charter Rider §2(a))",
      "writing / committing / pushing to the target repo",
      "holding any platform master credential (ADR-2605231525)",
      "operating outside an active owner+authority dual-signed mandate",
      "inspecting arbitrary / third-party repos without owner attestation",
      "producing a target-list / attack-surface-for-offense (non-adjudicating only)",
      "commercial SAST/SCA SaaS (Snyk / Veracode / Checkmarx / Black Duck / GHAS-paid / SonarQube-paid — Charter Rider §2(e))",
      "vendor LLM API callout (Murakumo-only per ADR-2605215000)",
      "state-aligned / military code-audit operations (Charter §1.12)"
    ]
  },
  "cells": [
    {
      "name": "repo_intake",
      "module": "magatama.cells.aratame_repo_intake",
      "murakumoNode": "levi",
      "phase": "event",
      "io": "dual-sig InspectionMandate → read-only clone repo@ref into egress-restricted aratame-scan sandbox",
      "gate": "G3 (read-only/static-only) + G4 (dual-sig mandate) + G6 (no platform-held key) + G11 (egress-restricted sandbox)"
    },
    {
      "name": "sast_scan",
      "module": "magatama.cells.aratame_sast_scan",
      "murakumoNode": "levi",
      "phase": "event",
      "io": "cloned source → OSS SAST (Semgrep OSS / CodeQL OSS) → candidate SAST vulnFindings",
      "gate": "G3 (read-only) + G5 (OSS-tooling-only) + G9 (defensive-only)"
    },
    {
      "name": "sca_scan",
      "module": "magatama.cells.aratame_sca_scan",
      "murakumoNode": "levi",
      "phase": "event",
      "io": "dependency manifests → OSS SCA (OSV-Scanner / Trivy) + giemon purl→CVE → dependencyFindings",
      "gate": "G3 (read-only) + G5 (OSS-tooling-only)",
      "crossActorPair": "giemon (purl_vuln_match, ADR-2605312330)"
    },
    {
      "name": "secret_scan",
      "module": "magatama.cells.aratame_secret_scan",
      "murakumoNode": "levi",
      "phase": "event",
      "io": "source → OSS secret detection (gitleaks / trufflehog OSS) → secretFindings (encrypted envelope refs only)",
      "gate": "G3 (read-only) + G7 (secret-encryption)"
    },
    {
      "name": "triage_synthesis",
      "module": "magatama.cells.aratame_triage_synthesis",
      "murakumoNode": "levi",
      "phase": "event",
      "io": "candidate findings → Murakumo gemma4-26b-a4b dedup/severity/false-positive triage (non-adjudicating)",
      "gate": "G8 (non-adjudicating) + G10 (Murakumo-only)"
    },
    {
      "name": "charter_rider_scan",
      "module": "magatama.cells.aratame_charter_rider_scan",
      "murakumoNode": "levi",
      "phase": "event",
      "io": "emitted text → §2(a)..(h) + offensive/PoC scan PASS/BLOCK",
      "gate": "G1 (Charter Rider scan) + G9 (defensive-only / no exploit)"
    },
    {
      "name": "finding_emit",
      "module": "magatama.cells.aratame_finding_emit",
      "murakumoNode": "levi",
      "phase": "event",
      "io": "triaged findings → tsukuroi-compatible vulnFinding + aggregate inspectionReport (kotoba datom + MST)",
      "gate": "G2 (append-only datom) + G13 (propose-only handoff to tsukuroi)",
      "crossActorPair": "tsukuroi (finding_intake consumes vulnFinding)"
    },
    {
      "name": "silen_aratame_review",
      "module": "magatama.cells.aratame_silen_aratame_review",
      "murakumoNode": "levi",
      "phase": "quarterly",
      "io": "period → silenAratameReview zero-counters (any nonzero ⇒ halt + chigiri.disputeMediation + Bonsai seed-tier prune)",
      "gate": "G14 (silen review + Bonsai seed-tier prune on violation)"
    }
  ],
  "lexiconNamespaces": [
    "com.etzhayyim.aratame.inspectionMandate",
