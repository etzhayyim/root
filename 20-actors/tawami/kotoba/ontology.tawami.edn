;; 撓 tawami — ontology (kotoba EAVT schema, ADR-2606211200 Energy Order Protocol)
;; Proof-of-Flexibility asset KG. The value here is not generation but the ABILITY
;; TO BEND a future energy flow in time (shiftability). OBSERVATION ONLY — tawami
;; maps flexibility; hikari actuates under Council gate. A flexibility map, NEVER a
;; dispatch order and NEVER a per-person load profile.
;;
;; Thesis (theory §5-B Proof of Flexibility): the asset is "the right to bend a
;; future energy flow". flex-value rewards fast, sustained, time-shiftable,
;; available capacity. tawami feeds 澪 mio: a USED flexibility becomes a
;; flow-improvement claim (R1); at R0 tawami publishes the flexibility KG + the
;; recommended mio flow-class per asset.
;;
;; Attribute namespaces (kango-named observatory sibling of mio/busshi):
;;   :tawami.asset/*  — disclosed flexibility-asset facts (resource-class, response, duration, kw, windows, availability)
;;   :tawami.obs/*    — DERIVED observations (responsiveness, energy-capacity, shiftability, flex-value, tier, best-use)
;;   :tawami.class/*  — per-resource-class aggregates
;;   :tawami.ledger/* — org-wide dispatchable flexibility total
;;   :tawami/derived  — true on every derived datom
;;   :tawami/sourcing — ":authoritative" | ":representative" | ":synthesized"

{:ontology/id "tawami"
 :ontology/version "0.1.0"
 :ontology/adr ["2606211200" "2605262130" "2605312345" "2606062101"]

 :node-kinds
 [{:kind :asset
   :doc "A flexibility asset: a load/store that can shift WHEN it uses energy (battery, EV fleet, cold store, datacenter, heat pump, industrial process)."
   :keys [:id :name :resource-class :response-time-min :duration-min :shiftable-kw
          :advance-window-h :defer-window-h :availability :sourcing :source :note]}
  {:kind :class
   :doc "Derived aggregate over a resource class."}]

 :resource-classes
 #{:battery :ev-fleet :cold-store :datacenter :heat-pump :industrial-process}

 ;; recommended mio flow-class per resource class (where this flexibility helps most)
 :best-use
 {:battery :peak-shave
  :heat-pump :peak-shave
  :ev-fleet :renewable-absorb
  :cold-store :renewable-absorb
  :datacenter :compute-routing
  :industrial-process :flexibility}

 :tier-kinds
 {:fast-flex "responsiveness ≥ 0.9 — sub-10-minute response, grid-balancing grade"
  :mid-flex  "responsiveness ≥ 0.5 — within the hour"
  :slow-flex "responsiveness < 0.5 — multi-hour, planning-grade only"}

 ;; negative space — structurally absent attributes (enforced by tests)
 :unrepresentable
 [":tawami/dispatch"            ;; G1: tawami never issues a dispatch/control order (hikari actuates)
  ":tawami/curtail-order"
  ":tawami.person/load-profile" ;; G2: aggregate-first — no per-person load profile
  ":tawami/trade"               ;; never a market position
  ":tawami/signal"]}            ;; never a price signal
