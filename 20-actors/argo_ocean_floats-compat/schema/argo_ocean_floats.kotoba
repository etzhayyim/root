namespace argo_ocean_floats {

    entity Profile {
        id: string @unique
        platformNumber: string
        projectName: string
        piName: string
        cycleNumber: integer
        direction: string
        dataMode: string
        juld: float
        latitude: float
        longitude: float
        positionQc: integer
        dataCentre: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Measurement {
        id: string @unique
        pres: float
        presQc: integer
        temp: float
        tempQc: integer
        psal: float
        psalQc: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Calibration {
        id: string @unique
        equation: string
        coefficient: string
        comment: string
        createdAt: datetime
        updatedAt: datetime
    }

}
