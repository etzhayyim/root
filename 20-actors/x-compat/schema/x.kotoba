namespace x {

    entity Tweet {
        id: string @unique
        text: string
        lang: string
        source: string
        paidPartnership: boolean
        possiblySensitive: boolean
        replySettings: string
        conversationId: string
        authorId: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity User {
        id: string @unique
        name: string
        description: string
        location: string
        url: string
        protected: boolean
        verified: boolean
        verifiedType: string
        subscriptionType: string
        profileImageUrl: string
        profileBannerUrl: string
        receivesYourDm: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Space {
        id: string @unique
        title: string
        state: string
        lang: string
        isTicketed: boolean
        participantCount: integer
        subscriberCount: integer
        scheduledStart: datetime
        startedAt: datetime
        endedAt: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity List {
        id: string @unique
        name: string
        description: string
        private: boolean
        followerCount: integer
        memberCount: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Media {
        id: string @unique
        type: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Poll {
        id: string @unique
        durationMinutes: integer
        endDatetime: datetime
        votingStatus: string
        createdAt: datetime
        updatedAt: datetime
    }

}
