;; yakushi 薬師 — adverse_event_cell
{:cell/id          "adverse-event"
 :cell/glyph       "⚠️"
 :cell/kind        :langgraph
 :cell/runtime     :wasm
 :cell/doc         "Post-market adverse event collection and aggregation (lot + severity + outcome only; no patient identity). Aggregates by lot, not patient DID."
 :cell/gates       [{:gate/id "G5" :gate/name "adverse-event-reporting"}
                    {:gate/id "G10" :gate/name "patient-identity-non-traceable"}
                    {:gate/id "G20" :gate/name "pii-encrypted-envelope"}]
 :cell/llm         {:provider :murakumo :endpoint "127.0.0.1:4000" :model "gemma3:4b" :charter-rider true}
 :cell/kotoba      {:reads    []
                    :writes   []}
 :cell/state-graph {:nodes [{:id "start" :type "llm-prompt" :prompt "Aggregate adverse events by lot, severity, outcome (no patient identity)."}
                           {:id "record_ae" :type "function" :func "record_ae"}
                           {:id "end" :type "return"}]
                    :entry    "start"
                    :edges    [{:from "start" :to "record_ae"}
                               {:from "record_ae" :to "end"}]}}
