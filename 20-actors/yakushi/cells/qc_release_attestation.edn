;; yakushi 薬師 — qc_release_attestation cell
{:cell/id          "qc-release"
 :cell/glyph       "✅"
 :cell/kind        :langgraph
 :cell/runtime     :wasm
 :cell/doc         "QC testing + lot release signature by QP-equivalent (薬機法 製造管理者 / EU GMP QP 相当). Witness N>=2 required."
 :cell/gates       [{:gate/id "G4" :gate/name "qp-equivalent-cosign"}
                    {:gate/id "G9" :gate/name "witness-invariant"}
                    {:gate/id "G13" :gate/name "no-server-held-qp-key"}]
 :cell/llm         {:provider :murakumo :endpoint "127.0.0.1:4000" :model "gemma3:4b" :charter-rider true}
 :cell/kotoba      {:reads    []
                    :writes   []}
 :cell/state-graph {:nodes [{:id "start" :type "llm-prompt" :prompt "Record QC results and collect QP signature for lot release."}
                           {:id "record_qc" :type "function" :func "record_qc"}
                           {:id "end" :type "return"}]
                    :entry    "start"
                    :edges    [{:from "start" :to "record_qc"}
                               {:from "record_qc" :to "end"}]}}
