;; yakushi 薬師 — formulation_attestation cell (Wave 2 disinfectants, ADR-2606171400)
{:cell/id          "formulation"
 :cell/glyph       "🧴"
 :cell/kind        :langgraph
 :cell/runtime     :wasm
 :cell/doc         "Attest a disinfectant/antiseptic FORMULATION (dilution/blend of a generic off-patent active). Enforces the efficacy window (G21), toxic-gas refusal (G22), flammable labelling (G23), use class (G24) and witness N>=2 (G9)."
 :cell/gates       [{:gate/id "G1"  :gate/name "wave2-disinfectant-reference"}
                    {:gate/id "G21" :gate/name "efficacy-window"}
                    {:gate/id "G22" :gate/name "no-toxic-gas-formulation"}
                    {:gate/id "G23" :gate/name "flammable-labeling"}
                    {:gate/id "G24" :gate/name "use-class"}
                    {:gate/id "G9"  :gate/name "witness-invariant"}]
 :cell/llm         {:provider :murakumo :endpoint "127.0.0.1:4000" :model "gemma3:4b" :charter-rider true}
 :cell/kotoba      {:reads    []
                    :writes   [:formulationAttestation/id
                               :formulationAttestation/activeName
                               :formulationAttestation/concPercent
                               :formulationAttestation/useClass
                               :formulationAttestation/coFormulants
                               :formulationAttestation/witness1
                               :formulationAttestation/witness2]}
 :cell/state-graph {:nodes [{:id "start" :type "llm-prompt" :prompt "Record a disinfectant formulation attestation with witness DID signatures."}
                            {:id "record_formulation" :type "function" :func "record_formulation"}
                            {:id "end" :type "return"}]
                    :entry    "start"
                    :edges    [{:from "start" :to "record_formulation"}
                               {:from "record_formulation" :to "end"}]}}
