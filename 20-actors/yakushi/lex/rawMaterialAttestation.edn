{:lexicon 1
 :id "com.etzhayyim.yakushi.rawMaterialAttestation"
 :defs
 {:main
  {:type "record"
   :key  "tid"
   :record
   {:type       "object"
    :required   ["tid" "materialName" "grade" "hazardClass"]
    :properties {:tid          {:type "string" :description "Transaction ID"}
                 :materialName {:type "string" :description "Raw material name"}
                 :grade        {:type "string" :description "Grade (公定 or 劇物)"}
                 :hazardClass  {:type "string" :description "Hazard classification"}
                 :cwcStatus    {:type "string" :description "CWC Schedule status if applicable"}}}}}}
