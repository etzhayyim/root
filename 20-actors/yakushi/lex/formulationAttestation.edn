{:lexicon 1
 :id "com.etzhayyim.yakushi.formulationAttestation"
 :defs
 {:main
  {:type "record"
   :key  "tid"
   :record
   {:type       "object"
    :required   ["tid" "activeName" "concPercent" "useClass" "witness1" "witness2"]
    :properties {:tid          {:type "string" :description "Transaction ID"}
                 :activeName   {:type "string" :description "Disinfectant active INN slug (ethanol, sodium-hypochlorite, povidone-iodine, …)"}
                 :concPercent  {:type "number" :description "Active concentration in percent (must fall inside the G21 efficacy window)"}
                 :useClass     {:type "string" :description "Use class: surface | skin-antiseptic | hand-hygiene (G24)" :knownValues ["surface" "skin-antiseptic" "hand-hygiene"]}
                 :coFormulants {:type "string" :description "Comma-joined co-formulants (G22 toxic-gas screen — hypochlorite + acid/ammonia is refused)"}
                 :witness1     {:type "string" :description "First witness DID (operator or sensor)"}
                 :witness2     {:type "string" :description "Second witness DID (QP or independent sensor)"}
                 :sig1         {:type "string" :description "Witness 1 signature"}
                 :sig2         {:type "string" :description "Witness 2 signature"}}}}}}
