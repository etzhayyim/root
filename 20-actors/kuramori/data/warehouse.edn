;; kuramori 倉守 — reference warehouse seed (illustrative, :representative sourcing).
;; A small mixed-temperature distribution centre: receiving → storage zones → dispatch.
;; Coords are metres in a dock-origin frame ([0 0] = dispatch/pick face).
;; Per ADR-2606142000 (kuramori R0). No real facility; sim input only.
{:facility {:id "dc-ref-01" :name "reference distribution centre" :sourcing :representative}

 ;; ── zones ────────────────────────────────────────────────────────────────
 :zones
 [{:id "z-golden"   :kind :golden  :temps #{:ambient} :desc "fast-mover face, closest to dispatch"}
  {:id "z-bulk"     :kind :bulk    :temps #{:ambient} :desc "slow movers, deep storage"}
  {:id "z-reefer"   :kind :reefer  :temps #{:reefer}  :desc "0–4°C cold chain"}
  {:id "z-hazmat"   :kind :hazmat  :temps #{:ambient} :hazmat-rated true :desc "IMDG-segregated"}]

 ;; ── slots (one SKU each in R0) ─────────────────────────────────────────────
 :slots
 [{:id "s-g1" :zone "z-golden" :dist-from-face 5.0  :max-kg 50  :temps #{:ambient} :coord [5 2]}
  {:id "s-g2" :zone "z-golden" :dist-from-face 7.0  :max-kg 50  :temps #{:ambient} :coord [7 2]}
  {:id "s-g3" :zone "z-golden" :dist-from-face 9.0  :max-kg 50  :temps #{:ambient} :coord [9 2]}
  {:id "s-b1" :zone "z-bulk"   :dist-from-face 40.0 :max-kg 800 :temps #{:ambient} :coord [40 10]}
  {:id "s-b2" :zone "z-bulk"   :dist-from-face 45.0 :max-kg 800 :temps #{:ambient} :coord [45 10]}
  {:id "s-r1" :zone "z-reefer" :dist-from-face 20.0 :max-kg 60  :temps #{:reefer}  :coord [20 18]}
  {:id "s-h1" :zone "z-hazmat" :dist-from-face 30.0 :max-kg 40  :temps #{:ambient}
   :hazmat-rated true :segregate-from #{:oxidizer} :coord [30 25]}]

 ;; ── SKUs awaiting putaway (velocity = picks/period) ─────────────────────────
 :skus
 [{:id "sku-fast"   :velocity 220 :weight-kg 8   :temp :ambient}
  {:id "sku-mid"    :velocity 60  :weight-kg 12  :temp :ambient}
  {:id "sku-slow"   :velocity 5   :weight-kg 500 :temp :ambient}
  {:id "sku-cold"   :velocity 40  :weight-kg 9   :temp :reefer}
  {:id "sku-flam"   :velocity 15  :weight-kg 20  :temp :ambient :hazmat :flammable}]

 ;; ── fleet (electric AGV + AMR; G2 zero-emission) ───────────────────────────
 :fleet
 [{:id "agv-1" :kind :agv}
  {:id "amr-1" :kind :amr}
  {:id "amr-2" :kind :amr}]

 ;; ── a sample outbound order (pick list = slot coords) ──────────────────────
 :order {:id "ord-1" :picks ["s-g1" "s-r1" "s-b1"]}}
