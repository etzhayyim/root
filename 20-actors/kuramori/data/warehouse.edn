;; kuramori 倉守 — reference warehouse seed (illustrative, :representative sourcing).
;; A small mixed-temperature distribution centre: receiving → storage zones → dispatch.
;; Coords are metres in a dock-origin frame ([0 0] = dispatch/pick face).
;; Per ADR-2606142000 (kuramori R0). No real facility; sim input only.
{:facility {:id "dc-ref-01" :name "reference distribution centre" :sourcing :representative}

 ;; ── zones ────────────────────────────────────────────────────────────────
 :zones
 [{:id "z-golden"   :kind :golden  :temps #{:ambient} :desc "fast-mover face, closest to dispatch"}
  {:id "z-bulk"     :kind :bulk    :temps #{:ambient} :desc "slow movers, deep storage"}
  {:id "z-reefer"   :kind :reefer  :temps #{:reefer}  :desc "0–4°C cold chain"}
  {:id "z-hazmat"   :kind :hazmat  :temps #{:ambient} :hazmat-rated true :desc "IMDG-segregated"}]

 ;; ── slots (one SKU each in R0) ─────────────────────────────────────────────
 :slots
 [{:id "s-g1" :zone "z-golden" :dist-from-face 5.0  :max-kg 50  :temps #{:ambient} :coord [5 2]}
  {:id "s-g2" :zone "z-golden" :dist-from-face 7.0  :max-kg 50  :temps #{:ambient} :coord [7 2]}
  {:id "s-g3" :zone "z-golden" :dist-from-face 9.0  :max-kg 50  :temps #{:ambient} :coord [9 2]}
  {:id "s-b1" :zone "z-bulk"   :dist-from-face 40.0 :max-kg 800 :temps #{:ambient} :coord [40 10]}
  {:id "s-b2" :zone "z-bulk"   :dist-from-face 45.0 :max-kg 800 :temps #{:ambient} :coord [45 10]}
  {:id "s-r1" :zone "z-reefer" :dist-from-face 20.0 :max-kg 60  :temps #{:reefer}  :coord [20 18]}
  {:id "s-h1" :zone "z-hazmat" :dist-from-face 30.0 :max-kg 40  :temps #{:ambient}
   :hazmat-rated true :segregate-from #{:oxidizer} :coord [30 25]}]

 ;; ── SKUs awaiting putaway (velocity = picks/period; vol-cm3 for cartonization) ─
 :skus
 [{:id "sku-fast"   :velocity 220 :weight-kg 8   :temp :ambient :vol-cm3 8000}
  {:id "sku-mid"    :velocity 60  :weight-kg 12  :temp :ambient :vol-cm3 15000}
  {:id "sku-slow"   :velocity 5   :weight-kg 500 :temp :ambient :vol-cm3 90000}
  {:id "sku-cold"   :velocity 40  :weight-kg 9   :temp :reefer  :vol-cm3 6000}
  {:id "sku-flam"   :velocity 15  :weight-kg 20  :temp :ambient :hazmat :flammable :vol-cm3 12000}]

 ;; ── fleet (electric AGV + AMR; G2 zero-emission) ───────────────────────────
 :fleet
 [{:id "agv-1" :kind :agv}
  {:id "amr-1" :kind :amr}
  {:id "amr-2" :kind :amr}]

 ;; ── a sample outbound order (pick list = slot coords) ──────────────────────
 :order {:id "ord-1" :picks ["s-g1" "s-r1" "s-b1"]}

 ;; ── day-operations fixtures (consumed by analyze/run-day full pipeline) ─────
 ;; forward pick-face on-hand (replenishment: :qty < :min needs topping up)
 :forward-slots
 [{:slot-id "f-g1" :sku-id "sku-fast" :qty 4  :min 10 :max 30}
  {:slot-id "f-g2" :sku-id "sku-mid"  :qty 18 :min 10 :max 30}]
 ;; reserve/bulk available to replenish from
 :bulk
 [{:bulk-id "blk-1" :sku-id "sku-fast" :qty 48}]
 ;; shipping carton types for cartonization (vol-cm3 + weight cap)
 :cartons
 [{:id "ctn-s" :vol-cm3 20000  :max-kg 15}
  {:id "ctn-m" :vol-cm3 60000  :max-kg 30}
  {:id "ctn-l" :vol-cm3 150000 :max-kg 600}]
 ;; returned items awaiting disposition (condition-grade 1..5)
 :returns
 [{:id "ret-1" :sku-id "sku-fast" :condition-grade 5}
  {:id "ret-2" :sku-id "sku-mid"  :condition-grade 3}
  {:id "ret-3" :sku-id "sku-cold" :condition-grade 1}]
 ;; cycle-count audit: system :expected vs physical :counted
 :count-slots
 [{:slot-id "s-g1" :expected 30 :counted 30}
  {:slot-id "s-g2" :expected 22 :counted 19}]
 ;; inbound discharge from niyaku (box landed on the apron → putaway)
 :inbound
 [{:box-id "box-1" :sku-id "sku-fast" :weight-kg 8 :temp :ambient}
  {:box-id "box-2" :sku-id "sku-cold" :weight-kg 9 :temp :reefer}]}
