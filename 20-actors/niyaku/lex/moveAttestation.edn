;; com.etzhayyim.niyaku.moveAttestation — lexicon (EDN form)
;; ADR-2606082000 · terminal per-move container-handling attestation
{:lexicon 1
 :id "com.etzhayyim.niyaku.moveAttestation"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["moveId" "boxId" "vesselId" "terminalId" "direction" "fromSlot" "toSlot"]
    :properties
    {:moveId {:type "string" :description "unique handling-move identifier"}
     :boxId {:type "string" :description "ISO container number"}
     :vesselId {:type "string" :description "vessel DID"}
     :terminalId {:type "string" :description "terminal UN/LOCODE + berth"}
     :direction {:type "string" :description "discharge (ship→shore) | load (shore→ship)"}
     :fromSlot {:type "string" :description "origin slot: bay/row/tier or yard address"}
     :toSlot {:type "string" :description "destination slot"}
     :craneId {:type "string" :description "STS crane DID performing the lift"}
     :residualSwayRad {:type "number" :description "load sway at landing (rad); gated < threshold per G4"}
     :antiSwayVerified {:type "boolean" :description "anti-sway settle confirmed before landing"}
     :liftWitness {:type "string" :description "spreader-engage robot DID + landing robot DID (≥2, G3)"}
     :energyKwh {:type "number" :description "net electric energy for the move (regen-credited, G8)"}
     :hazmatClass {:type "string" :description "IMDG class if dangerous goods (segregation per G9)"}
     :timestamp {:type "string" :description "ISO-8601 attestation time"}}}}}}
