{:lexicon 1
 :id "com.etzhayyim.utsushie.video"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["videoId" "sourceArticleId" "kind" "section" "headline" "asOf"]
    :properties
    {:videoId         {:type "string" :description "→ :news.video/id"}
     :sourceArticleId {:type "string" :description "→ :news.article/id — the kawaraban :article this video narrates (never an :original)"}
     :kind            {:type "string" :enum ["mirror" "actor-event"]
                       :description "U? = kawaraban G11 INVARIANT — inherits the source article's kind. 'original' is NOT an enum member: utsushie narrates a mirror/actor-event, it is never itself a source"}
     :section         {:type "string" :description "→ :news.section/id (the 面)"}
     :headline        {:type "string"}
     :narrationScript {:type "string" :maxLength 280
                       :description "U2 (= kawaraban G4) — the spoken script is bounded to the source article's fair-use excerpt (≤280); the full body is NEVER narrated (see fullTextNarration below)"}
     :linkUrl         {:type "string" :description "canonical link-out, carried in the post description (required when kind='mirror')"}
     :outlet          {:type "string" :description "→ :news.outlet/id (required when kind='mirror')"}
     :lang            {:type "string" :description "narration language (i18n supplies the per-language script; ADR-2606161536 D3)"}
     :blobMime        {:type "string" :enum ["video/mp4"] :description "rendered embed mime (render is R0-gated; see G8/U5)"}
     :asOf            {:type "integer" :description "epoch — append-only; latest = current, the stream = the trail (非終末論)"}
     ;; ── structural-invariant fields: const false / forbidden (ADR-2606161536 §D2 U1–U6) ──
     :verdict            {:type "boolean" :const false :description "U1 (= G1) — the narrator states 'outlet X reported H at T', never 'H is true/false'"}
     :fullTextNarration  {:type "boolean" :const false :description "U2 (= G4) — narrating the full copyrighted body is unrepresentable; script ≤ bounded excerpt only"}
     :depictsPerson      {:type "boolean" :const false :description "U3 (= G9) ANTI-DEEPFAKE — no photoreal likeness of any named real person"}
     :voiceClone         {:type "boolean" :const false :description "U3 (= G9) ANTI-DEEPFAKE — no cloned voice of any named real person; neutral synthetic narrator only"}
     :engagementOptimized {:type "boolean" :const false :description "U4 (= G2) — no hook/retention edit driven by a dwell metric; recency / 面-fit only"}
     :externalGpuRender  {:type "boolean" :const false :description "U5 (= G6, ADR-2605215000) — inference is Murakumo-fleet only; RunPod/external-GPU render is unrepresentable at R0 (live render is G8-gated)"}
     :serverHeldKey      {:type "boolean" :const false :description "U6 (= G7, ADR-2605231525) — publish is member-signed; no server-held private key"}}}}}}
