namespace digitalocean {

    entity Droplet {
        id: string @unique
        name: string
        memory: integer
        vcpus: integer
        disk: integer
        locked: boolean
        status: string
        sizeSlug: string
        vpcUuid: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Volume {
        id: string @unique
        name: string
        description: string
        sizeGigabytes: integer
        filesystemType: string
        filesystemLabel: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Image {
        id: string @unique
        name: string
        type: string
        distribution: string
        slug: string
        public: boolean
        minDiskSize: integer
        sizeGigabytes: float
        description: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Project {
        id: string @unique
        ownerUuid: string
        ownerId: integer
        name: string
        description: string
        purpose: string
        environment: string
        isDefault: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Region {
        id: string @unique
        slug: string
        name: string
        available: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Database {
        id: string @unique
        name: string
        engine: string
        version: string
        semanticVersion: string
        status: string
        region: string
        size: string
        numNodes: integer
        createdAt: datetime
        updatedAt: datetime
    }

}
