// Contentful clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace contentful {

    entity ContentType {
        id: string @unique
        name: string
        description: string
        displayField: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Space {
        id: string @unique
        name: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Environment {
        id: string @unique
        name: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Locale {
        id: string @unique
        name: string
        code: string
        fallbackCode: string
        default: boolean
        optional: boolean
        contentDeliveryApi: boolean
        contentManagementApi: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity ApiKey {
        id: string @unique
        name: string
        description: string
        accessToken: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Webhook {
        id: string @unique
        name: string
        url: string
        httpBasicUsername: string
        active: boolean
        createdAt: datetime
        updatedAt: datetime
    }

}
