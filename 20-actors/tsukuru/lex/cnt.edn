 {:lexicon 1
  :id "com.etzhayyim.apps.tsukuru.cnt.getProcessCatalog"
  :defs
  {:main
   {:type "query"
    :description "Return the concrete CNT/CNT fiber manufacturing process, equipment, device, sensor, actuator, MES, SCADA, and QMS catalog."
    :parameters
    {:type "params"
     :properties
     {:stage {:type "string" :knownValues ["intake" "synthesis" "fiber-formation" "post-treatment" "quality-release"]}
      :equipment_id {:type "string"}}}
    :output
    {:encoding "application/json"
     :schema
     {:type "object"
      :properties
      {:status {:type "string"}
       :schema {:type "string"}
       :processId {:type "string"}
       :productFamilies {:type "array" :items {:type "string"}}
       :equipment {:type "array" :items {:type "unknown"}}
       :steps {:type "array" :items {:type "unknown"}}
       :dataRecords {:type "array" :items {:type "string"}}
       :plcTags {:type "array" :items {:type "string"}}
       :mesEntities {:type "array" :items {:type "string"}}
       :qmsArtifacts {:type "array" :items {:type "string"}}
       :sourcePaths {:type "unknown"}}}}}}}

 {:lexicon 1
  :id "com.etzhayyim.apps.tsukuru.cnt.prepareRunPackage"
  :defs
  {:main
   {:type "query"
    :description "Prepare a machine-readable CNT/CNT fiber run package for MES, SCADA, PLC, QMS, and EHS execution gates."
    :parameters
    {:type "params"
     :properties
     {:run_id {:type "string"}
      :production_order_id {:type "string"}
      :recipe_revision {:type "string"}
      :product_family {:type "string"}
      :target_spool_length_m {:type "integer"}
      :target_strength_gpa {:type "float"}
      :target_conductivity_s_m {:type "integer"}
      :target_thermal_conductivity_w_mk {:type "integer"}
      :operator_did {:type "string"}
      :equipment_overrides {:type "unknown"}}}
    :output
    {:encoding "application/json"
     :schema
     {:type "object"
      :properties
      {:status {:type "string"}
       :runId {:type "string"}
       :schema {:type "string"}
       :processId {:type "string"}
       :recipeRevision {:type "string"}
       :recipe {:type "array" :items {:type "unknown"}}
       :equipmentBinding {:type "array" :items {:type "unknown"}}
       :telemetryBinding {:type "array" :items {:type "unknown"}}
       :releasePlan {:type "unknown"}
       :ehsInterlocks {:type "array" :items {:type "string"}}
       :approvals {:type "array" :items {:type "unknown"}}}}}}}}

 {:lexicon 1
  :id "com.etzhayyim.apps.tsukuru.cnt.validateRunPackage"
  :defs
  {:main
   {:type "query"
    :description "Validate a CNT/CNT fiber run package before execution, including equipment bindings, telemetry, EHS interlocks, approvals, and dry-run metrics."
    :parameters
    {:type "params"
     :properties
     {:run_package {:type "unknown"}
      :run_id {:type "string"}
      :production_order_id {:type "string"}
      :recipe_revision {:type "string"}
      :product_family {:type "string"}
      :target_spool_length_m {:type "integer"}
      :target_strength_gpa {:type "float"}
      :target_conductivity_s_m {:type "integer"}
      :target_thermal_conductivity_w_mk {:type "integer"}
      :operator_did {:type "string"}
      :equipment_overrides {:type "unknown"}}}
    :output
    {:encoding "application/json"
     ;; kotoba/agent.cljc's `(validate-run-package "cnt" run-package)` computes exactly this
     ;; shape for real (business-rule checks, not structural key presence) — minus
     ;; "recordId", a host-persistence concern out of scope for a pure fn.
     :schema
     {:type "object"
      :properties
      {:schema {:type "string"}
       :runId {:type "string"}
       :status {:type "string"}
       :blockers {:type "array" :items {:type "string"}}
       :warnings {:type "array" :items {:type "string"}}
       :checks {:type "array" :items {:type "unknown"}}
       :dryRun {:type "unknown"}
       :recordId {:type "string"}}}}}}}]
