;; com.etzhayyim.apps.tsukuru.cnt.* — CNT (carbon-nanotube fiber manufacturing) lexicons,
;; EDN form. Unlike lex/factory.edn / lex/quality.edn / etc. (single `record`-type lexicon
;; per file), the CNT vertical is a set of 7 `query`-type XRPC lexicons, so this file is a
;; vector of lexicon maps — one entry per source file, each keeping the same {:lexicon 1 :id
;; .. :defs {:main {...}}} shape as the record lexicons (structural keys as EDN keywords,
;; :type/:description/:knownValues values kept as plain strings/vectors to match the JSON
;; 1:1). Source of truth (read-only reference, do not edit from here):
;;   00-contracts/lexicons/com/etzhayyim/apps/tsukuru/cnt/designManufacturingFlow.json
;;   00-contracts/lexicons/com/etzhayyim/apps/tsukuru/cnt/planAutomation.json
;;   00-contracts/lexicons/com/etzhayyim/apps/tsukuru/cnt/prepareOrderPackage.json
;;   00-contracts/lexicons/com/etzhayyim/apps/tsukuru/cnt/getAutomationCoverage.json
;;   00-contracts/lexicons/com/etzhayyim/apps/tsukuru/cnt/getProcessCatalog.json
;;   00-contracts/lexicons/com/etzhayyim/apps/tsukuru/cnt/prepareRunPackage.json
;;   00-contracts/lexicons/com/etzhayyim/apps/tsukuru/cnt/validateRunPackage.json
;; validateRunPackage's output shape ("schema"/"runId"/"status"/"blockers"/"warnings"/
;; "checks"/"dryRun") is exactly what kotoba/agent.cljc's `validate-run-package` now computes for
;; real (minus "recordId", a host-persistence concern out of scope for a pure fn).
[{:lexicon 1
  :id "com.etzhayyim.apps.tsukuru.cnt.designManufacturingFlow"
  :defs
  {:main
   {:type "query"
    :description "Design a CNT/CNT fiber manufacturing flow with integrated synthesis, spinning, post-treatment, QA, and open-* signal bindings."
    :parameters
    {:type "params"
     :properties
     {:flow_id {:type "string"}
      :production_order_id {:type "string"}
      :product_kind {:type "string"}
      :cnt_type {:type "string"}
      :synthesis_method {:type "string"}
      :spinning_method {:type "string"}
      :target_strength_gpa {:type "float"}
      :target_conductivity_s_m {:type "integer"}
      :target_thermal_conductivity_w_mk {:type "integer"}
      :line_rate_m_per_min {:type "float"}
      :design_formats {:type "array" :items {:type "string"}}
      :supplier_exchange_format {:type "string"}
      :supplier_did {:type "string"}
      :artifacts {:type "array" :items {:type "unknown"}}
      :requirements {:type "unknown"}
      :open_actor_dids {:type "array" :items {:type "string"}}}}
    :output
    {:encoding "application/json"
     :schema
     {:type "object"
      :properties
      {:status {:type "string"}
       :flowId {:type "string"}
       :bpmnProcessId {:type "string"}
       :processIntegration {:type "array" :items {:type "unknown"}}
       :automationRequirements {:type "array" :items {:type "string"}}
       :openSignals {:type "unknown"}
       :riskControls {:type "array" :items {:type "string"}}}}}}}}

 {:lexicon 1
