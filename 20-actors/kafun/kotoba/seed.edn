  :replant true :carbon :net-neutral :consent true :protected false :sapling-supply :sufficient}
 {:type :stand :id "hinoki-gifu-k" :name "岐阜 ヒノキ人工林 (苗木供給 partial)" :species :hinoki :area-ha 15000 :prefecture :synthetic-chubu
  :emission-density 0.85 :exposed-pop-weight 0.6 :reforest-viability 0.65
  :replant true :carbon :net-neutral :consent true :protected false :sapling-supply :partial
  :note "Partial 無花粉苗木 supply still proceeds (flagged); only :none blocks."}

 ;; — blocked on the 無花粉苗木 (L1-1) bottleneck → :await-sapling-supply —
 {:type :stand :id "sugi-tochigi-c" :name "栃木 スギ人工林 (苗木供給なし)" :species :sugi :area-ha 9000 :prefecture :synthetic-kanto
  :emission-density 0.85 :exposed-pop-weight 0.8 :reforest-viability 0.7
  :replant true :carbon :net-neutral :consent true :protected false :sapling-supply :none
  :note "High burden, ready to reforest, but no pollen-free saplings → routes to 無花粉苗木 production (L1-1)."}

