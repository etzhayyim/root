;; kafun 花粉 — ontology (kotoba EAVT schema, ADR-2606211712)
;; 花粉撲滅 remediation actor: 撲滅 = ecological RESTORATION (主伐再造林), never
;; deforestation-for-profit. The clj-native Tier-B actor-ization of the legacy
;; 60-apps/etzhayyim-project-public-kafun-bokumetsu pipeline (ADR-2605100100 +
;; 2605210928), folded onto the kotoba Datom log.
;;
;; Edge-primary pollen-source CONCENTRATION (stand-area × emission-density ×
;; exposed-population-weight, on read) routed to REMEDIATION. ASSESSMENT + R0
;; DESIGN ONLY — kafun never cuts and never plants (live forestry is the
;; landowner's + operator/Council step; unrepresentable here).
;;
;; Verdict ∈ {:refuse :reforest-priority :await-sapling-supply
;;            :await-consent :protected-selective :monitor}
;;   :refuse                — hard fail: a cut WITHOUT mandated 再造林 (clearcut)
;;                            OR net-positive carbon (G1/G4). 撲滅 is restoration,
;;                            so 主伐 without 再造林 is structurally unrepresentable.
;;   :await-consent         — landowner/community consent absent (G3, can come)
;;   :protected-selective   — watershed/steep/habitat → selective/gradual only,
;;                            never clearcut (route to inochi-aware gradual)
;;   :await-sapling-supply  — blocked on 無花粉苗木 supply (the L1-1 bottleneck)
;;   :reforest-priority     — high pollen burden + viable replant + consent →
;;                            prioritize 主伐再造林 (the L3-1 bottleneck)
;;   :monitor               — low burden → observe only
;;
;; Attribute namespaces:
;;   :kafun.stand/*  — disclosed forest-stand facts (species, area, prefecture)
;;   :kafun.rem/*    — DERIVED remediation factors + verdict + reason + route
;;   :kafun/derived  — true on every derived datom
;;   :kafun/sourcing — ":authoritative" | ":representative" | ":synthetic"

{:ontology/id "kafun"
 :ontology/version "0.1.0"
 :ontology/adr ["2606211712" "2605100100" "2605210928" "2605262130" "2605192245" "2606073000"]

 :node-kinds
 [{:kind :stand
   :doc "A forest stand under 花粉撲滅 remediation assessment — a cedar/cypress (スギ/ヒノキ) plantation that is a pollen SOURCE, or a candidate for 主伐再造林."
   :keys [:id :name :species :area-ha :prefecture
          :emission-density :exposed-pop-weight :reforest-viability
          :replant :carbon :consent :protected :sapling-supply :note]}]

 :enums
 {:species         #{:sugi :hinoki :mixed-conifer :broadleaf}   ;; スギ/ヒノキ = the pollen sources
  :carbon          #{:net-negative :net-neutral :net-positive}  ;; net of the 再造林 recapture
  :sapling-supply  #{:none :partial :sufficient}                ;; 無花粉苗木 availability (L1-1 gate)
  :verdict         #{:refuse :reforest-priority :await-sapling-supply
                     :await-consent :protected-selective :monitor}}

 :refuse-reasons
 #{:clearcut-without-reforest  ;; G1/G4 — 主伐 without 再造林; 撲滅 is restoration, not deforestation
   :carbon-positive}          ;; G4 / §2(d) — net-positive CO₂e after replant

 ;; negative space — structurally absent (enforced by tests)
 :unrepresentable
 [":kafun/actuate"            ;; G5 — kafun never cuts/plants (assessment + R0 design only)
  ":kafun/clearcut"           ;; G1 — indiscriminate clearcut has no representation
  ":kafun.person/health"      ;; G2 — no person-level health/biometric; cohorts are aggregate
  ":kafun.stand/eradicate-species"]} ;; 撲滅 targets the 花粉 burden via restoration, never species extermination
