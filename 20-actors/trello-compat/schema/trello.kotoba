        memberType: string
        email: string
        avatarUrl: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Label {
        id: string @unique
        idBoard: string
        name: string
        color: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Organization {
        id: string @unique
        name: string
