        subscribed: boolean
        dateLastActivity: datetime
        creationMethod: string
        enterpriseOwned: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity List {
        id: string @unique
        name: string
        closed: boolean
        pos: float
        softLimit: string
        idBoard: string
        subscribed: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Card {
        id: string @unique
        name: string
        desc: string
        closed: boolean
        cardRole: string
        due: datetime
        dueReminder: string
