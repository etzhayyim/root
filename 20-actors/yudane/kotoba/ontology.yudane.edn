;; 委 yudane — ontology (kotoba EAVT schema, ADR-2606211200 Energy Order Protocol)
;; Human Intention Energy Engine — the 意味変換 (meaning-translation) leg. Consented,
;; AGGREGATE member intention ("today WFH", "this load can wait", "heatwave tomorrow")
;; is translated into controllable energy variables → 撓 tawami / 澪 mio. The MOST
;; charter-sensitive actor — it touches human signal, so privacy is structural, not
;; aspirational.
;;
;; 委 = entrust. Intention only enters via a member-signed, scoped, expiring,
;; REVOCABLE capability (the ibuki revocable-leash pattern, ADR-2606111400). The
;; engine is CONTENT-FREE: only an intention CLASS + an AGGREGATE cohort signal
;; crosses the membrane — never per-person intent text. The surveillance
;; degeneration series (五人組 → 隣組 → Stasi → social-credit) is structurally
;; UNREPRESENTABLE: no denunciation, no per-person score, k-anonymity floor,
;; symmetric/reciprocal visibility (Rider §2(c), ADR-2606082400).
;;
;; Attribute namespaces:
;;   :yudane.offer/*  — a consented COHORT intention→flex offer (intent-class, cohort-size, best-use)
;;   :yudane.obs/*    — DERIVED observations (verdict, flex-kwh, route)
;;   :yudane.class/*  — per-intent-class aggregates
;;   :yudane.ledger/* — org-wide consented aggregate flex total
;;   :yudane/derived  — true on every derived datom
;;   :yudane/sourcing — ":authoritative" | ":representative" | ":synthesized"

{:ontology/id "yudane"
 :ontology/version "0.1.0"
 :ontology/adr ["2606211200" "2606111400" "2606082400" "2606112300" "2605262130" "2605312345"]

 :node-kinds
 [{:kind :offer
   :doc "A CONSENTED, AGGREGATE cohort intention→flex offer. NOT a person. Carries an intention CLASS (never content), an aggregate cohort size, a consent capability reference, and the implied aggregate shiftable energy."
   :keys [:id :name :intent-class :cohort-size :capability :cap-expiry-h :reciprocal
          :flex-kwh :best-use :sourcing :source :note]}
  {:kind :class
   :doc "Derived aggregate over an intention class."}]

 :intent-classes
 #{:presence-shift :defer-flexible :schedule-known :seasonal-prep}

 ;; recommended mio flow-class per intention class (where the translated flex helps)
 :best-use
 {:presence-shift :peak-shave
  :defer-flexible :renewable-absorb
  :schedule-known :flexibility
  :seasonal-prep :renewable-absorb}

 :consent-params
 {:k-anon-min 5} ;; a cohort below this is refused — no individual may be identifiable

 :verdict-kinds
 {:consented              "capability present + unexpired + reciprocal + cohort ≥ k-anon → aggregate flex offer crosses to tawami/mio"
  :refused-no-capability  "no member-signed capability → nothing is read (consent-bound)"
  :refused-expired        "the capability has expired → refused (revocable-leash)"
  :refused-not-reciprocal "the exchange is not reciprocal/logged → refused (Rider §2(c))"
  :refused-below-k-anon   "cohort below the k-anonymity floor → refused (an individual could be identified)"}

 ;; negative space — structurally absent (enforced by tests). The degeneration series.
 :unrepresentable
 [":yudane.person/intent-content"  ;; G2: never per-person intent text
  ":yudane.person/score"           ;; no per-person score (social-credit unrepresentable)
  ":yudane/denunciation"           ;; no denunciation (隣組/Stasi unrepresentable)
  ":yudane/surveil"                ;; asymmetric/covert watching unrepresentable (§2(c))
  ":yudane/dispatch"               ;; G4: translation only — never controls (hikari actuates)
  ":yudane/trade"]}                ;; never a market position
