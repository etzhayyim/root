namespace launchdarkly {

    entity FeatureFlag {
        id: string @unique
        key: string
        name: string
        kind: string
        description: string
        includeInSnippet: boolean
        temporary: boolean
        maintainerId: string
        maintainerTeamKey: string
        archived: boolean
        deprecated: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Project {
        id: string @unique
        key: string
        name: string
        includeInSnippetByDefault: boolean
        defaultReleasePipelineKey: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Environment {
        id: string @unique
        key: string
        name: string
        color: string
        defaultTtl: integer
        secureMode: boolean
        defaultTrackEvents: boolean
        requireComments: boolean
        confirmChanges: boolean
        critical: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Member {
        id: string @unique
        firstName: string
        lastName: string
        role: string
        email: string
        mfa: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Webhook {
        id: string @unique
        name: string
        url: string
        on: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity UserSegment {
        id: string @unique
        key: string
        name: string
        description: string
        unbounded: boolean
        unboundedContextKind: string
        deleted: boolean
        generation: integer
        createdAt: datetime
        updatedAt: datetime
    }

}
