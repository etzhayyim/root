{:lexicon 1
 :id "com.etzhayyim.karakuri.serviceCapabilityRecord"
 :description "A :representative capability + ToS record for one target service. Drives adapter-tier selection and the G2 ToS gate. Policy/capability data, not an endorsement; operator-verify before live use (G6)."
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["serviceId" "name" "officialApi" "authModel" "tosStance" "tier" "representative"]
    :properties
    {:serviceId {:type "string"}
     :name {:type "string"}
     :category {:type "string" :enum ["site-builder" "cms" "commerce" "payments" "dev" "productivity"]}
     :officialApi {:type "boolean" :description "true if the service publishes a usable API (favours T1)"}
     :authModel {:type "string" :enum ["oauth2" "api-key" "session-cookie" "pat"]}
     :tosStance {:type "string" :enum ["api-ok" "automation-allowed" "automation-restricted" "automation-prohibited"] :description "G2 gate — :automation-prohibited refuses the T2 headless adapter"}
     :tier {:type "string" :enum ["t1-official-api" "t2-headless-browser" "t3-structured-export"]}
     :rateLimit {:type "string"}
     :representative {:type "boolean" :const true :description "G8 — bounded :representative subset; operator-verify before live use"}}}}}}
