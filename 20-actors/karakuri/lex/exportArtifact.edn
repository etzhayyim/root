{:lexicon 1
 :id "com.etzhayyim.karakuri.exportArtifact"
 :description "A T3 structured export of the MEMBER's OWN data (the data-portability / anti-lock-in leg). Own-data-only + encrypted (G9)."
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["service" "format" "owner" "encrypted" "createdAt"]
    :properties
    {:service {:type "string"}
     :format {:type "string" :enum ["kotoba-edn" "json" "csv" "markdown"]}
     :owner {:type "string" :const "member" :description "G9 invariant — the member's OWN data only; no third-party PII"}
     :encrypted {:type "boolean" :const true :description "G9 invariant — encrypted (com.etzhayyim.encrypted.*, ADR-2605181100)"}
     :cid {:type "string" :description "content-addressed CID of the encrypted export"}
     :createdAt {:type "string" :format "datetime"}}}}}}
