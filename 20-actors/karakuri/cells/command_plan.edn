{:cell/id "command_plan"
 :cell/glyph "繰"
 :cell/kind :langgraph
 :cell/runtime :wasm
 :cell/node "simeon"
 :cell/doc "NL brief -> ordered normalized ServiceOps (Murakumo-only, G4), each safety-classified (:read/:create/:update/:delete) and Charter-Rider scanned (N6). Emits a dry-run plan with mutate ops marked :awaiting-member-sig (G5). Plan only at R0 (G6)."
 :cell/entry "cells/command_plan/cell.py"
 :cell/handler "CommandPlanCell"
 :cell/state-graph
 {:nodes [:parse :classify :charter-scan :plan] :entry :parse
  :edges [[:parse :classify] [:classify :charter-scan] [:charter-scan :plan] [:plan :end]]}
 :cell/llm {:provider :murakumo :endpoint "127.0.0.1:4000" :model "gemma3:4b" :charter-rider true}
 :cell/gates ["G4" "G5" "G6" "G7"]
 :cell/kotoba {:reads [:service/id] :writes [:plan/op :op/safety :op/mutate-gate :plan/charter-clean]}}
