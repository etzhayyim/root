// Alchemy clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace alchemy {

    entity Block {
        id: string @unique
        hash: string
        parentHash: string
        miner: string
        stateRoot: string
        transactionsRoot: string
        receiptsRoot: string
        number: string
        gasLimit: string
        gasUsed: string
        timestamp: string
        baseFeePerGas: string
        blobGasUsed: string
        excessBlobGas: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity BlockQuery {
        id: string @unique
        blockTag: string
        hydrated: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Receipt {
        id: string @unique
        transactionHash: string
        transactionIndex: string
        blockHash: string
        blockNumber: string
        gasUsed: string
        cumulativeGasUsed: string
        contractAddress: string
        status: string
        effectiveGasPrice: string
        type: string
        createdAt: datetime
        updatedAt: datetime
    }

}
