// Langchain clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace langchain {

    entity BaseMessage {
        id: string @unique
        content: string
        additionalKwargs: string
        responseMetadata: string
        type: string
        name: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity AIMessage {
        id: string @unique
        content: string
        type: string
        name: string
        toolCalls: string
        invalidToolCalls: string
        usageMetadata: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity ToolMessage {
        id: string @unique
        content: string
        type: string
        name: string
        toolCallId: string
        artifact: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity ToolCall {
        id: string @unique
        name: string
        args: string
        type: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity UsageMetadata {
        id: string @unique
        inputTokens: integer
        outputTokens: integer
        totalTokens: integer
        inputTokenDetails: string
        outputTokenDetails: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity LogEntry {
        id: string @unique
        name: string
        type: string
        tags: string
        metadata: string
        startTime: datetime
        streamedOutputStr: string
        streamedOutput: string
        inputs: string
        finalOutput: string
        endTime: datetime
        createdAt: datetime
        updatedAt: datetime
    }

}
