// Fastly clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace fastly {

    entity Service {
        id: string @unique
        name: string
        type: string
        comment: string
        customerId: string
        activeVersion: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Backend {
        id: string @unique
        name: string
        address: string
        hostname: string
        port: integer
        useSsl: boolean
        sslCertHostname: string
        weight: integer
        shield: string
        comment: string
        connectTimeout: integer
        maxConn: integer
        autoLoadbalance: boolean
        overrideHost: string
        minTlsVersion: string
        maxTlsVersion: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Domain {
        id: string @unique
        serviceId: string
        serviceVersion: integer
        name: string
        comment: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity HealthCheck {
        id: string @unique
        serviceId: string
        serviceVersion: integer
        name: string
        method: string
        host: string
        path: string
        expectedResponse: integer
        checkInterval: integer
        timeout: integer
        threshold: integer
        window: integer
        initial: integer
        httpVersion: string
        comment: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity ACL {
        id: string @unique
        serviceId: string
        serviceVersion: integer
        name: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Dictionary {
        id: string @unique
        serviceId: string
        serviceVersion: integer
        name: string
        writeOnly: boolean
        createdAt: datetime
        updatedAt: datetime
    }

}
