  "@type": "ActorManifest",
  "id": "did:web:etzhayyim.com:actor:meisai",
  "name": "meisai",
  "displayName": "明細 — Member Card-Statement Ingestion",
  "displayNameJa": "明細",
  "displayNameEn": "Meisai",
  "description": "Member-own card-statement (利用明細) ingestion into the local kotoba Datom log. The member runs a READ-ONLY computer-use fetch leg on their OWN machine against their OWN card account (com-junkawasaki/computer-use-clj sumitclub_meisai — karakuri T2 posture, vault-injected credentials, Murakumo-conformant local inference per ADR-2605215000); meisai ingests the resulting local statement EDN into append-only :meisai.stmt/* + :meisai.row/* EAVT datoms. NO network I/O, NO credential held, credential/PAN shapes UNREPRESENTABLE (raise at ingest), personal financial data stays under the gitignored data/ (never committed, pinned, or published).",
  "descriptionJa": "メンバー自身のカード利用明細を local kotoba Datom log に取り込む actor。取得レグはメンバーが自分の機械で自分の口座に対して走らせる読み取り専用 computer-use エージェント (com-junkawasaki/computer-use-clj sumitclub_meisai — karakuri 絡繰 T2 姿勢、資格情報は vault 注入、推論は ADR-2605215000 適合のローカル Ollama gemma 4 QAT)。meisai 自体はネットワーク I/O ゼロ・資格情報非保持で、credential/PAN 形状は ingest 時に構造的に RAISE(表現不能)。個人金融データは gitignore された data/ 配下のみ(commit / pin / 公開なし)。",
  "adr": {
    "master": "etzhayyim:adr:2606122400",
    "r0": "etzhayyim:adr:2606122400",
    "r1": "etzhayyim:adr:2606122400"
  },
  "tier": "Tier-B",
  "parentActor": null,
  "crossActorBoundary": [
    "did:web:etzhayyim.com:actor:karakuri (the fetch leg IS a karakuri-shaped T2 ToS-permitted browser/computer-use of the member's OWN account; meisai is the ingestion side)",
    "did:web:etzhayyim.com:actor:kaiyaku (statement rows are the GROUND TRUTH for recurring-charge ties — meisai feeds kaiyaku's 縁-ledger worklist)",
    "did:web:etzhayyim.com:actor:organizer (organizer detects ご利用明細 mail patterns; meisai holds the statement TABLE itself)",
    "did:web:toritate.etzhayyim.com (BOUNDARY: toritate = the corp's OWN on-chain books; meisai = a MEMBER's personal card statements — never conflate)",
    "did:web:warifu.etzhayyim.com (BOUNDARY: warifu is the corp's own card rails; meisai reads external bank-issued cards)"
  ],
  "constitutionalDiscipline": {
    "memberOwnDataOnly": "G1 — ingests ONLY the member's own statements, fetched by the member themselves on their own machine. Another person's account is not an input this actor has any path to.",
    "credentialUnrepresentable": "G2 — meisai holds no credential; the fetch leg vault-injects secrets at the member's host (type_secret) so they never reach a model, a log, or this actor. Structurally: ingest.guard RAISES on credential-shaped keys and PAN-shaped values (test-enforced).",
    "localOnlyPersonalData": "G3 — personal financial records live under the gitignored data/ only. No IPFS pin, no MST publication, no social emission, no aggregate sharing at R0. The autorun loop persists to the LOCAL log and nothing else.",
    "readOnlyAtSource": "G4 — the fetch leg's system prompt forbids every state-changing control on the card site (支払い方法/リボ/分割/変更/登録/解約/申込); meisai itself never talks to the source at all.",
    "provenance": "G5 — every statement tx carries the intake file's content CID; row entities are deterministic content hashes; re-ingest is a no-op (dedup by CID); the log is a verifiable commit-DAG.",
    "murakumoOnlyInference": "G6 — the fetch leg defaults to local Ollama gemma 4 QAT (ADR-2605215000-conformant). Vendor-LLM code paths in the generic library are NOT used in the etzhayyim context.",
    "liveLegOperatorGated": "G7 — the live browser fetch is an operator step the member runs explicitly; meisai's own loop does no network I/O (test-enforced)."
  },
  "nonGoals": [
    "N1 — not a household-accounting app or budgeting advisor (no advice, no scoring of spending)",
    "N2 — not a scraper service for third parties (member-own, member-run only)",
    "N3 — not a payment instrument (warifu is the corp's card rail; meisai only reads statements)",
    "N4 — not a publication pipeline (statements are private; aggregate publication would be a future Council-gated ADR)",
    "N5 — not a credential store (vault stays at the member's host)"
  ],
  "methods": {
    "kotoba.cljc": "content-addressed append-only Datom-log writer + EDN reader (family pattern)",
    "ingest.cljc": "statement EDN → :meisai.stmt/* + :meisai.row/* datoms; G2 guard; multi-currency",
    "autorun.cljc": "autonomous intake-sweep heartbeat; dedup by intake CID; local-only",
    "sources.cljc": "worldwide card-company coverage registry → :meisai.source/* datoms + coverage + resolve + normalize (any issuer → canonical)",
    "recurring.cljc": "recurring-charge detection over :meisai.row/* → kaiyaku handoff (advisory :review; meisai surfaces, kaiyaku decides)",
    "fx.cljc": "REPORT-TIME foreign-exchange conversion (minor units → JPY-equivalent); never persisted as a Datom"
  },
  "lexicons": [
    "com.etzhayyim.meisai.statement (cells/lex/meisai.statement.json — statement header; PERSONAL, local-only, no PAN/credential)",
    "com.etzhayyim.meisai.source (cells/lex/meisai.source.json — coverage source; PUBLIC metadata)",
    "com.etzhayyim.meisai.recurringHandoff (cells/lex/meisai.recurringHandoff.json — the meisai→kaiyaku recurring-charge handoff; PERSONAL, local-only)"
  ],
  "residence": "com.etzhayyim.meisai.heartbeat (50-infra/launchd/com.etzhayyim.meisai.heartbeat.plist) — a per-member launchd LaunchAgent that runs the local autorun intake sweep hourly on the MEMBER's OWN machine. NOT a shared murakumo fleet cell: meisai is member-local personal data with no network I/O (G1/G3/G7), so it must not run on shared fleet nodes.",
  "fetchLeg": {
    "repo": "https://github.com/com-junkawasaki/computer-use-clj",
    "entry": "examples/sumitclub_meisai.clj",
    "stack": "langgraph-clj StateGraph + langchain-clj openai-model (Ollama gemma 4 QAT) + IComputer macOS host + IVault (1Password/Bitwarden)",
    "posture": "read-only, vault-injected credentials, member-principal, operator-run"
  },
  "status": "R1 — worldwide coverage registry (101 sources) + multi-currency normalize + recurring-charge → kaiyaku handoff (round-trip closed) + report-time FX + 3 lexicons + member-local launchd heartbeat; 28 bb tests green. Per-issuer fetch adapters (member-side) are the remaining R1 work; first supported source = sumitclub.jp (SuMi TRUST CLUB)."
}
