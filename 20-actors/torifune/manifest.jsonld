{
  "@context": {
    "@vocab": "https://etzhayyim.com/ns/actor#",
    "id": "@id",
    "type": "@type"
  },
  "id": "actor:torifune",
  "type": "Actor",
  "name": "torifune",
  "glyph": "鳥船",
  "purpose": "Zero-net-carbon open launch-vehicle manufacturing + Transparent space access — the 船大工 of the sky (funadaiku/sarutahiko/giemon build-pattern). Designs + (Council-gated) builds a reusable open-design launch vehicle (Ama 天 class, two-stage hydrolox), runs the plant (4D-BIM) + ascent/staging/recovery GNC sim on kami-genesis. Civilian launch ONLY; weapon-delivery / ballistic-strike structurally unrepresentable.",
  "status": "R0-design-only",
  "tier": "B",
  "adr": "2606162355",
  "dependsOnAdr": ["2605192100", "2605192330", "2606073600", "2606013400", "2606032130", "2605312345", "2605215000"],
  "schema": ["00-contracts/schemas/launch-vehicle-ontology.kotoba.edn"],
  "substrate": {
    "state": "kotoba Datom log (ADR-2605312345) — methods/datom_emit.py emits canonical EAVT (R1)",
    "largeAssets": "DataLad → IPFS (80-data/launch) — NO git-lfs",
    "inference": "Murakumo-only (ADR-2605215000)",
    "physics": "kami-genesis (clean-room isaacsim.core.api, NO NVIDIA binary) — Featherstone rigid-body ascent/staging/recovery sim, the funadaiku ShipHydro / niyaku Cartpole engine",
    "runtime": "kotoba pywasm actor (componentize-py) — pure-stdlib methods, no numpy (R1)"
  },
  "integrates": ["actor:subaru", "actor:hoshimori", "actor:funadaiku", "actor:sarutahiko", "actor:kamado", "actor:hydrogen_electrolysis"],
  "lineage": "the 船大工 of the sky — funadaiku (ships) / sarutahiko (trucks) / giemon-factory build-pattern pointed at space access; builds the bus subaru operates; debris-responsibility couples hoshimori; named 天鳥船 (Ame-no-Torifune, the heavenly bird-boat)",
  "vehicleClass": "Ama 天 — reusable two-stage hydrolox (green-H₂ LH₂/LOX); kamado-synthetic methalox permitted at net≤0",
  "cells": [
    {
      "id": "cell:torifune.ascent-sim",
      "method": "methods/ascent_sim.py",
      "input": "data/seed-ama-vehicle.kotoba.edn",
      "output": ["out/ascent-report.md"],
      "pipeline": "kami-genesis rigid-body ascent → staging → orbit-insertion → recovery; Δv budget, gravity/drag losses, payload-to-orbit; trajectory class ∈ {ascent, orbit-insertion, rendezvous, deorbit} ONLY (no strike member exists)",
      "doc": "civilian ascent GNC sim; weaponizable flight profiles structurally unrepresentable (G1)"
    },
    {
      "id": "cell:torifune.carbon-balance",
      "method": "methods/carbon_balance.py",
      "input": "data/seed-ama-vehicle.kotoba.edn",
      "output": ["out/carbon-report.md"],
      "pipeline": "propellant lifecycle carbon (green-H₂ electrolysis | kamado synthetic-methalox) → net balance; flags any fossil/toxic-hypergolic path as disfavored",
      "doc": "zero-net-carbon propellant accounting, measured not assumed (G2, Rider §2(d))"
    },
    {
      "id": "cell:torifune.disposal-plan",
      "method": "methods/disposal_plan.py",
      "input": "data/seed-ama-vehicle.kotoba.edn",
      "output": ["out/disposal-plan.kotoba.edn"],
      "pipeline": "per-mission stage-recovery + payload deorbit/disposal plan → emits a hoshimori-consumable stewardship input; refuses a mission with no disposal plan",
      "doc": "debris-responsibility (G5) — couples hoshimori; torifune may not create the congestion hoshimori routes around"
    },
    {
      "id": "cell:torifune.datom-emit",
      "method": "methods/datom_emit.py",
      "input": "data/seed-ama-vehicle.kotoba.edn",
      "output": ["out/launch-datoms.kotoba.edn"],
      "pipeline": "ground EAVT datoms [e a v tx :add] (durable) + derived readouts (Δv margin, carbon balance, deorbit debt) flagged :bond/is-transient (computed on read)",
      "doc": "kotoba Datom-log projection — first-class canonical state (ADR-2605312345)"
    }
  ],
  "gates": {
    "G1": "civilian launch ONLY, NEVER a weapon-delivery / ballistic-strike vehicle — depressed/suborbital-strike trajectories, MIRV/PBV buses, kinetic re-entry-vehicle delivery, FOBS are UNREPRESENTABLE (trajectory + payload class enums have no strike/munition member); payloads restricted to civilian classes (connectivity/EO-at-hoshimori-posture/science/crewed/cargo) (Charter §1.12 + Rider §2(a))",
    "G2": "zero-net-carbon propellant only — green-H₂ hydrolox primary; kamado-synthetic methalox at net≤0 permitted; fossil/toxic-hypergolic disfavored; carbon-balance MEASURED (Rider §2(d))",
    "G3": "open-design (open-source vehicle + GNC + plant) + dividend-coupled (Displacement Dividend ADR-2606032130)",
    "G4": "Transparent space access — open-source + on-chain flight/ops log + 1 SBT = 1 vote (§1.12); never covert/proprietary/state-military-aligned",
    "G5": "debris-responsibility — mandatory per-mission disposal/deorbit plan; no intentional debris; stage recovery preferred; plan feeds hoshimori stewardship",
    "G6": "no-server-key — sim is dry-run; actual launch operation is Council + operator-DID gated (R0 = sim + plant + ontology only)",
    "G7": "Murakumo-only narration (ADR-2605215000)",
    "G8": "sourcing honesty — every record :authoritative | :representative; sim numbers are representative engineering estimates, never measured flight data, pre-campaign"
  }
}
