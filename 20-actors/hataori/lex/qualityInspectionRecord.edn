{:lexicon 1
 :id "com.etzhayyim.hataori.qualityInspectionRecord"
 :defs
 {:main
  {:type "record" :key "tid"
   :record
   {:type "object"
    :required ["garmentId" "needleClear" "result" "createdAt"]
    :properties
    {:garmentId {:type "string"}
     :needleClear {:type "boolean" :description "kenshin: no broken-needle fragment in product (safety-critical)"}
     :seamStrengthOk {:type "boolean"}
     :result {:type "string" :enum ["PASS" "REWORK" "FAIL"]}
     :createdAt {:type "string" :format "datetime"}}}}}}
