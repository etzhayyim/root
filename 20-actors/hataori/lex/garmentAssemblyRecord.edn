{:lexicon 1
 :id "com.etzhayyim.hataori.garmentAssemblyRecord"
 :defs
 {:main
  {:type "record" :key "tid"
   :record
   {:type "object"
    :required ["garmentId" "seamsCompleted" "createdAt"]
    :properties
    {:garmentId {:type "string"}
     :seamsCompleted {:type "integer" :minimum 0}
     :seamsTotal {:type "integer" :minimum 0}
     :reworkFlag {:type "boolean" :description "honest QC (no defect hiding, G8)"}
     :createdAt {:type "string" :format "datetime"}}}}}}
