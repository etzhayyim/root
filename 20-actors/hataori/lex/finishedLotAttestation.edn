{:lexicon 1
 :id "com.etzhayyim.hataori.finishedLotAttestation"
 :defs
 {:main
  {:type "record" :key "tid"
   :record
   {:type "object"
    :required ["lotId" "garmentType" "quantity" "createdAt"]
    :properties
    {:lotId {:type "string"}
     :garmentType {:type "string"}
     :quantity {:type "integer" :minimum 0 :description "no fast-fashion overproduction (N4): made-to-need"}
     :offcutWastePermille {:type "integer" :description "fabric offcut waste ×1000 (resource ethics)"}
     :robotSigs {:type "array" :items {:type "string"}}
     :provenanceRef {:type "string" :format "at-uri" :description "AT URI of the fairLaborProvenance record (G9)"}
     :createdAt {:type "string" :format "datetime"}}}}}}
