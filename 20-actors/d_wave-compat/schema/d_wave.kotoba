// D_wave clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace d_wave {

    entity ProblemMetadata {
        id: string @unique
        type: string
        label: string
        status: string
        submittedBy: string
        submittedOn: datetime
        solvedOn: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity SolverConfiguration {
        id: string @unique
        status: string
        description: string
        avgLoad: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity StructuredProblemData {
        id: string @unique
        format: string
        lin: string
        quad: string
        offset: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity StructuredProblemAnswer {
        id: string @unique
        format: string
        activeVariables: string
        energies: string
        solutions: string
        numOccurrences: string
        numVariables: integer
        timing: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Region {
        id: string @unique
        code: string
        name: string
        endpoint: string
        createdAt: datetime
        updatedAt: datetime
    }

}
