// Aptos_pos clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace aptos_pos {

    entity Block {
        id: string @unique
        blockHeight: string
        blockHash: string
        blockTimestamp: string
        firstVersion: string
        lastVersion: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity LedgerInfo {
        id: string @unique
        chainId: integer
        epoch: string
        ledgerVersion: string
        oldestLedgerVersion: string
        ledgerTimestamp: string
        nodeRole: string
        blockHeight: string
        gitHash: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity UserTransaction {
        id: string @unique
        version: string
        hash: string
        gasUsed: string
        success: boolean
        vmStatus: string
        sender: string
        sequenceNumber: string
        maxGasAmount: string
        gasUnitPrice: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity MoveFunction {
        id: string @unique
        name: string
        visibility: string
        isEntry: boolean
        isView: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity AccountData {
        id: string @unique
        sequenceNumber: string
        authenticationKey: string
        createdAt: datetime
        updatedAt: datetime
    }

}
