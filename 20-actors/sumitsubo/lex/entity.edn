     :geom      {:type "string" :description "compact coordinate encoding (mm)"}
     :closed    {:type "boolean" :description "polyline only"}
     :verts     {:type "integer" :description "mesh only"}
     :tris      {:type "integer" :description "mesh only"}}}}}}
