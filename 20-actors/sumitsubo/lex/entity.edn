{:lexicon 1
 :id "com.etzhayyim.sumitsubo.entity"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["entityId" "drawingId" "kind" "layer"]
    :properties
    {:entityId  {:type "string"}
     :drawingId {:type "string" :description "owning drawing"}
     :kind      {:type "string" :description "point|line|polyline|circle|arc|mesh"}
