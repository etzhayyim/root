        revision: string
        state: string
        proxyDeploymentType: string
        deployStartTime: integer
        serviceAccount: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity DataCollector {
        id: string @unique
        name: string
        description: string
        type: string
        createdAt: integer
        lastModifiedAt: integer
        createdAt: datetime
        updatedAt: datetime
    }

}
