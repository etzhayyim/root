namespace macos_darwin {

    entity ProcessInfo {
        id: string @unique
        processName: string
        processIdentifier: integer
        operatingSystemVersionString: string
        physicalMemory: integer
        processorCount: integer
        activeProcessorCount: integer
        thermalState: string
        isLowPowerModeEnabled: boolean
        systemUptime: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity OperatingSystemVersion {
        id: string @unique
        majorVersion: integer
        minorVersion: integer
        patchVersion: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity ComparisonResult {
        id: string @unique
        result: string
        createdAt: datetime
        updatedAt: datetime
    }

}
