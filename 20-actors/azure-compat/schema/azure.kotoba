// Azure clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace azure {

    entity VirtualMachine {
        id: string @unique
        vmId: string
        provisioningState: string
        priority: string
        evictionPolicy: string
        licenseType: string
        extensionsTimeBudget: string
        platformFaultDomain: integer
        userData: string
        timeCreated: datetime
        vmSize: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity OsDisk {
        id: string @unique
        osType: string
        name: string
        caching: string
        writeAcceleratorEnabled: boolean
        createOption: string
        diskSizeGB: integer
        deleteOption: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity InstanceViewStatus {
        id: string @unique
        code: string
        level: string
        displayStatus: string
        message: string
        time: datetime
        createdAt: datetime
        updatedAt: datetime
    }

}
