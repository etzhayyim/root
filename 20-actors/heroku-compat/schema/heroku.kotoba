// Heroku clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace heroku {

    entity App {
        id: string @unique
        name: string
        acm: boolean
        gitUrl: string
        webUrl: string
        maintenance: boolean
        internalRouting: boolean
        buildpackProvidedDescription: string
        repoSize: integer
        slugSize: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Dyno {
        id: string @unique
        name: string
        command: string
        size: string
        state: string
        type: string
        attachUrl: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Addon {
        id: string @unique
        name: string
        providerId: string
        state: string
        webUrl: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Release {
        id: string @unique
        description: string
        status: string
        version: integer
        current: boolean
        outputStreamUrl: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Build {
        id: string @unique
        status: string
        stack: string
        outputStreamUrl: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Domain {
        id: string @unique
        hostname: string
        cname: string
        kind: string
        status: string
        acmStatus: string
        acmStatusReason: string
        createdAt: datetime
        updatedAt: datetime
    }

}
