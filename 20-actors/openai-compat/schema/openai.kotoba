// Openai clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace openai {

    entity Model {
        id: string @unique
        name: string
        ownedBy: string
        contextWindow: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity ChatCompletion {
        id: string @unique
        modelId: string
        prompt: string
        output: string
        promptTokens: integer
        completionTokens: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Embedding {
        id: string @unique
        modelId: string
        input: string
        dimensions: integer
        vectorRef: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity FineTuningJob {
        id: string @unique
        baseModel: string
        trainingFile: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity File {
        id: string @unique
        purpose: string
        filename: string
        bytes: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Assistant {
        id: string @unique
        name: string
        modelId: string
        instructions: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Thread {
        id: string @unique
        assistantId: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }

