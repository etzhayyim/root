// Openai clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace openai {

    entity Model {
        id: string @unique
        ownedBy: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity File {
        id: string @unique
        bytes: integer
        filename: string
        purpose: string
        status: string
        statusDetails: string
        expiresAt: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity FineTuningJob {
        id: string @unique
        model: string
        organizationId: string
        status: string
        trainingFile: string
        seed: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Assistant {
        id: string @unique
        model: string
        name: string
        description: string
        instructions: string
        temperature: float
        topP: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity VectorStore {
        id: string @unique
        name: string
        usageBytes: integer
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Batch {
        id: string @unique
        endpoint: string
        model: string
        inputFileId: string
        completionWindow: string
        status: string
        outputFileId: string
        errorFileId: string
        createdAt: datetime
        updatedAt: datetime
    }

}
