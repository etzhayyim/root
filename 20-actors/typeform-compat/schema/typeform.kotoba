// Typeform clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace typeform {

    entity Form {
        id: string @unique
        title: string
        language: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Response {
        id: string @unique
        responseId: string
        landedAt: datetime
        submittedAt: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Theme {
        id: string @unique
        name: string
        hasTransparentButton: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Image {
        id: string @unique
        src: string
        fileName: string
        width: integer
        height: integer
        hasAlpha: boolean
        avgColor: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Webhook {
        id: string @unique
        formId: string
        tag: string
        url: string
        enabled: boolean
        verifySsl: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Workspace {
        id: string @unique
        name: string
        default: boolean
        shared: boolean
        accountId: string
        createdAt: datetime
        updatedAt: datetime
    }

}
