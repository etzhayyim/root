namespace webflow {

    entity Site {
        id: string @unique
        workspaceId: string
        displayName: string
        shortName: string
        previewUrl: string
        timeZone: string
        parentFolderId: string
        lastPublished: datetime
        dataCollectionEnabled: boolean
        dataCollectionType: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Page {
        id: string @unique
        siteId: string
        title: string
        slug: string
        parentId: string
        collectionId: string
        localeId: string
        publishedPath: string
        archived: boolean
        draft: boolean
        canBranch: boolean
        isBranch: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Collection {
        id: string @unique
        displayName: string
        singularName: string
        slug: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity CollectionItem {
        id: string @unique
        cmsLocaleId: string
        lastPublished: datetime
        isArchived: boolean
        isDraft: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Asset {
        id: string @unique
        contentType: string
        size: integer
        siteId: string
        hostedUrl: string
        originalFileName: string
        displayName: string
        altText: string
        folderId: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Order {
        id: string @unique
        orderId: string
        status: string
        comment: string
        orderComment: string
        disputeLastStatus: string
        shippingProvider: string
        shippingTracking: string
        purchasedItemsCount: float
        isCustomerDeleted: boolean
        isShippingRequired: boolean
        hasDownloads: boolean
        paymentProcessor: string
        createdAt: datetime
        updatedAt: datetime
    }

}
