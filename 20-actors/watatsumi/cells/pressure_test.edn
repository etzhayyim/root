;; watatsumi 綿津見 — pressure_test cell (L5b)
;; 1.25× design depth water pressure test
{:cell/id "pressure_test"
 :cell/glyph "✠"
 :cell/kind :langgraph
 :cell/runtime :wasm
 :cell/entry "py/agent.py"
 :cell/handler "handle_pressure_test"
 :cell/doc "L5b: Hydrotest at 1.25× design depth with Hibiki acoustic-emission monitoring continuous. Depth cap ≤6500m enforced (G12). Output = pressureTestRecord."
 :cell/state-graph
 {:nodes [:fill-chamber :ramp-pressure :monitor-acoustic :verify-pass :record-test]
  :entry :fill-chamber
  :edges [[:fill-chamber :ramp-pressure]
          [:ramp-pressure :monitor-acoustic]
          [:monitor-acoustic :verify-pass]
          [:verify-pass :record-test]
          [:record-test :end]]}
 :cell/llm
 {:provider :murakumo
  :endpoint "127.0.0.1:4000"
  :model "gemma3:4b"
  :charter-rider true}
 :cell/gates ["G3" "G12" "G15" "G16"]
 :cell/kotoba
 {:reads [:section-join/id :section-join/attestation :design-depth-m :acoustic-emission/db]
  :writes [:pressure-test/id :pressure-test/depth-tested :pressure-test/duration-h :pressure-test/acoustic-log :pressure-test/pass]}}
