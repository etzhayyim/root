;; watatsumi 綿津見 — section_joining cell (L5a)
;; Final multi-pass ring-to-ring weld + 100% RT + PWHT
{:cell/id "section_joining"
 :cell/glyph "⚒"
 :cell/kind :langgraph
 :cell/runtime :wasm
 :cell/entry "py/agent.py"
 :cell/handler "handle_section_joining"
 :cell/doc "L5a: Join integrated sections via multi-pass TIG weld with 100% RT on every final ring weld. PWHT (Post-Weld Heat Treatment) mandatory. Witness quorum ≥2 robots (G4). IPFS-pinned every pass + RT (G3). Output = sectionJoiningAttestation."
 :cell/state-graph
 {:nodes [:setup-welding :perform-welding-passes :perform-radiography :heat-treat :record-joining]
  :entry :setup-welding
  :edges [[:setup-welding :perform-welding-passes]
          [:perform-welding-passes :perform-radiography]
          [:perform-radiography :heat-treat]
          [:heat-treat :record-joining]
          [:record-joining :end]]}
 :cell/llm
 {:provider :murakumo
  :endpoint "127.0.0.1:4000"
  :model "gemma3:4b"
  :charter-rider true}
 :cell/gates ["G3" "G4" "G15" "G16"]
 :cell/kotoba
 {:reads [:system/id :system/attestation :ndt-result/type :ndt-result/pass]
  :writes [:section-join/id :section-join/passes :section-join/rt-passes :section-join/pwht-temp :section-join/attestation]}}
