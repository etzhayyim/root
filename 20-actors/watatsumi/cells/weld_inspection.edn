;; watatsumi 綿津見 — weld_inspection cell (L3)
;; 100% NDT (RT/UT/PT) per ASME BPVC §VIII Div 3
{:cell/id "weld_inspection"
 :cell/glyph "⧉"
 :cell/kind :langgraph
 :cell/runtime :wasm
 :cell/entry "py/agent.py"
 :cell/handler "handle_weld_inspection"
 :cell/doc "L3: 100% RT/UT/PT inspection of all section welds per ASME BPVC §VIII Div 3 equivalent. Sango AUV swarm witness in-process + radiographer SBT-gate. Every pass + test result IPFS-pinned (G3). Output = weldInspectionRecord."
 :cell/state-graph
 {:nodes [:stage-inspection :perform-radiography :perform-ultrasonic :analyze-defects :record-inspection]
  :entry :stage-inspection
  :edges [[:stage-inspection :perform-radiography]
          [:perform-radiography :perform-ultrasonic]
          [:perform-ultrasonic :analyze-defects]
          [:analyze-defects :record-inspection]
          [:record-inspection :end]]}
 :cell/llm
 {:provider :murakumo
  :endpoint "127.0.0.1:4000"
  :model "gemma3:4b"
  :charter-rider true}
 :cell/gates ["G3" "G4" "G15" "G16"]
 :cell/kotoba
 {:reads [:section/id :section/penetrators :ndt-result/type :ndt-result/pass]
  :writes [:weld-inspection/id :weld-inspection/results :weld-inspection/ipfs-cid :weld-inspection/pass]}}
