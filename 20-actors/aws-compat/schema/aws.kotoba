// Aws clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace aws {

    entity Instance {
        id: string @unique
        instanceId: string
        instanceType: string
        state: string
        architecture: string
        hypervisor: string
        ebsOptimized: boolean
        enaSupport: boolean
        rootDeviceName: string
        rootDeviceType: string
        outpostArn: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Volume {
        id: string @unique
        volumeId: string
        size: integer
        state: string
        volumeType: string
        iops: integer
        throughput: integer
        multiAttachEnabled: boolean
        fastRestored: boolean
        createTime: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Vpc {
        id: string @unique
        vpcId: string
        state: string
        cidrBlock: string
        isDefault: boolean
        ownerId: string
        instanceTenancy: string
        dhcpOptionsId: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity SecurityGroup {
        id: string @unique
        groupId: string
        groupName: string
        description: string
        vpcId: string
        ownerId: string
        securityGroupArn: string
        createdAt: datetime
        updatedAt: datetime
    }

}
