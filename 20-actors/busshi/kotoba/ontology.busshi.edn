;; busshi 物資 — ontology (kotoba EAVT schema, ADR-2606161730)
;; World commodity & raw-materials KG mirror. OBSERVATION ONLY — never trades,
;; never extracts. §2(l) multi-generational (子・孫) × wellbecoming risk axis
;; (ADR-2606161700): concentration + multi-gen risk routed to RESILIENCE /
;; de-monopolization / restoration — a resilience map, NEVER a target-list,
;; NEVER a trade/price signal.
;;
;; Attribute namespaces (kango-named observatory sibling of kabuto/kanjō/kasa/shionome):
;;   :busshi.commodity/*  — disclosed commodity facts (symbol, name, class, unit)
;;   :busshi.producer/*   — disclosed producer-share facts (country, share-pct)
;;   :busshi.obs/*        — DERIVED observations (hhi, top-share, chokepoint, multigen-risk, route)
;;   :busshi.class/*      — per-class aggregates
;;   :busshi/derived      — true on every derived datom (never re-ingested as authoritative)
;;   :busshi/sourcing     — ":authoritative" | ":representative" | ":synthesized"
;;
;; A producer SHARE and a price LEVEL are FACTS (disclosed), never a verdict and
;; never a signal (shionome pattern). No :trade / :forecast-point attribute exists.

{:ontology/id "busshi"
 :ontology/version "0.1.0"
 :ontology/adr ["2606161730" "2606161700" "2605262130" "2605312345"]

 :node-kinds
 [{:kind :commodity
   :doc "A tradable commodity / raw material (precious metal, base metal, rare/critical metal, energy carrier, agricultural soft)."
   :keys [:id :symbol :name :class :unit :producers :recyclability :carbon-intensity :irreversibility :ref-level :note]}
  {:kind :class
   :doc "Derived aggregate over a commodity class (precious-metal / base-metal / rare-metal / energy / ag-soft)."}]

 :commodity-classes
 #{:precious-metal :base-metal :rare-metal :energy :ag-soft}

 :route-kinds
 {:resilience       "diversify supply + build stock/recovery buffers (default)"
  :de-monopolization "monopoly/chokepoint dominant → route to abaki/kabuto/tsumugi (route-around, not punishment)"
  :restoration      "irreversible multi-gen environmental footprint dominant → route to inochi/kamado/kanayama (circular path)"}

 ;; negative space — structurally absent attributes (enforced by tests)
 :unrepresentable
 [":busshi/trade"            ;; G1: never a buy/sell/position
  ":busshi/signal"           ;; G3: never a market signal
  ":busshi.obs/price-forecast-point" ;; G3: levels are facts, point forecasts are not emitted (mitooshi does distributions)
  ":busshi.producer/mine-coordinates"]} ;; G5: no precise extraction coordinates (never a target-list)
