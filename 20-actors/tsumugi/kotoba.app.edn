;; kotoba.app.edn — actor:tsumugi 紡ぎ KOTOBA Mesh application manifest (generated scaffold).
;; Deploy:  kotoba app deploy kotoba.app.edn  (compiles methods/mesh.clj → CID → control datoms)
{:kotoba.app/name    "tsumugi"
 :kotoba.app/version "0.1.0"
 :kotoba.app/components
 [{:name     "tsumugi"
   :src      "methods/mesh.clj"                  ; Clojure default → run + on-kse
   :scale    1
   :triggers [{:type :kse :topic "etzhayyim/actor/tsumugi"}]  ; observatory on-kse (ADR-2606230001 §4)
   :requires #{:cap/kqe}}
  ;; self-publication: the actor periodically drafts its OWN history (source-cited
  ;; 取-concentration findings over public power-entities + the RELEASE routing +
  ;; 産官学報 scale clusters) as DRY-RUN social posts, and — once it holds its own
  ;; mesh-runtime key (self-custodied, no-server-key, ADR-2605231525) under a member
  ;; CACAO leash — signs + emits them itself. Live broadcast stays Council Lv6+ +
  ;; operator gated (§1.12/G11); R0 = dry-run. ADR-2606272355.
  {:name     "tsumugi-social"
   :src      "methods/social.cljc"
   :scale    1
   :triggers [{:type :tick :cron "0 */6 * * *"}                 ; every 6h: self-publish backlog
              {:type :kse  :topic "etzhayyim/actor/tsumugi/publish"}]
   :requires #{:cap/kqe :cap/atproto}}]

 :kotoba.app/placement {:spread  :zone
                        :require {:tier "edge"}}}
