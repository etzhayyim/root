namespace chainlink {

    entity PriceFeed {
        id: string @unique
        decimals: integer
        description: string
        version: integer
        address: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity RoundData {
        id: string @unique
        roundId: string
        answer: string
        startedAt: integer
        updatedAt: integer
        answeredInRound: string
        createdAt: datetime
        updatedAt: datetime
    }

}
