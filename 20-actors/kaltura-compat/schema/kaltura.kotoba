namespace kaltura {

    entity BaseEntry {
        id: string @unique
        name: string
        description: string
        partnerId: integer
        userId: string
        creatorId: string
        tags: string
        status: string
        moderationStatus: integer
        moderationCount: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity MediaEntry {
        id: string @unique
        mediaType: integer
        sourceType: string
        dataUrl: string
        mediaDate: integer
        creditUserName: string
        creditUrl: string
        conversionQuality: string
        isTrimDisabled: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity SessionInfo {
        id: string @unique
        ks: string
        sessionType: integer
        partnerId: integer
        userId: string
        expiry: integer
        privileges: string
        createdAt: datetime
        updatedAt: datetime
    }

}
