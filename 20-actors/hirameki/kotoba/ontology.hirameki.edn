{:ontology/id "hirameki"
 :ontology/version "0.1.0"
 :ontology/adr ["2606212200" "2604251024" "2606171300" "2605262130" "2605312345" "2605241500"]

 :node-kinds
 [{:kind :field
   :doc "A technology field (CPC/IPC subclass or section) — the concentration UNIT. Carries assignee exclusivity shares + an aggregate release profile (expiring-soon / open-licensed buffers) + a disclosed standard-essentiality weight."
   :keys [:id :name :cpc-section :cpc-subclass :patents-est :assignees
          :essentiality :expiring-soon-share :open-license-share :expired-share
          :ref-year :sourcing :source :note]}
  {:kind :patent
   :doc "An exemplar PUBLIC patent / patent-family record (the corpus row materialized to the DataLad dataset). A patent is the GATED OBJECT, never a 取-holder (G2) — only its assignee/holder imposes exclusivity."
   :keys [:id :title :jurisdiction :field :assignee :filing-year :grant-year
          :term-years :status :open-license :essentiality :sourcing :source]}
  {:kind :field-agg
   :doc "Derived aggregate over a CPC section (A..H, Y) — count, mean exclusivity-load, release-ready count."}]

 ;; CPC sections (the coarse technology taxonomy; subclass is finer-grained on :field rows)
 :cpc-sections
 {:A "Human necessities"
  :B "Performing operations; transporting"
  :C "Chemistry; metallurgy"
  :D "Textiles; paper"
  :E "Fixed constructions"
  :F "Mechanical engineering; lighting; heating; weapons; blasting"
  :G "Physics"
  :H "Electricity"
  :Y "Emerging cross-sectional (climate-mitigation Y02 etc.)"}

 ;; patent lifecycle status (disclosed fact from the issuing office, never re-judged — G3)
 :patent-status
 #{:pending :granted :expired :public-domain :lapsed :withdrawn}

 ;; lawful release routes only (G4) — exclusivity → commons
 :open-license-kinds
 {:none                  "no voluntary opening; release waits on statutory term expiry"
  :pledge               "defensive/non-assertion pledge (e.g. Open Invention Network, Tesla-style)"
  :pool                 "patent pool / cross-licensing pool (royalty-bearing but open-terms)"
  :royalty-free-standard "FRAND-zero / royalty-free standards-essential commitment"
  :mpp                  "voluntary licensing via a pool intermediary (Medicines-Patent-Pool analogue)"
  :public-domain        "term-expired or dedicated to the public"}

 :route-kinds
 {:release          "expiry/public-domain handoff is near or done — track the 解放 to the commons (default for high release-readiness)"
  :open-license     "on-patent but pledgeable → route to voluntary open licensing / patent pool / non-assertion pledge"
  :de-monopolization "exclusivity concentration entrenched in an essential field → route-around (abaki / tsumugi / kabuto), never punishment"
  :monitor          "early-life, diversified, low essentiality → observe the release clock"}

 ;; negative space — structurally absent attributes (enforced by tests)
 :unrepresentable
 [":hirameki/infringement-verdict"     ;; G1: never an infringement determination
  ":hirameki/fto-opinion"              ;; G1: never a freedom-to-operate / patentability opinion (UPL boundary, chigiri)
  ":hirameki/equity-signal"            ;; G3: never a patent-equity / litigation-prediction signal
  ":hirameki.patent/imposes-on"        ;; G2: a patent never imposes — only an assignee/holder does
  ":hirameki.patent/design-around"     ;; G4: never a circumvention/evasion recipe
  ":hirameki.inventor/person"]}        ;; G6: no person-level inventor targeting (assignee-org aggregate only)
