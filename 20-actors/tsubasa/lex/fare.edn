;; com.etzhayyim.tsubasa.fare — lexicon (EDN form)
;; A published flight fare option. CO₂ emissions are a REQUIRED field (G4 — surfaced, never
;; hidden). NO :*/commission, :*/affiliate, :*/sponsored, or :*/price-will-rise field exists
;; (G1/G2/G3). bookUrl is the airline's OWN page, affiliate-stripped at handoff.
;; ADR-2606072800
{:lexicon 1
 :id "com.etzhayyim.tsubasa.fare"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["fareId" "origin" "destination" "departDate" "carrier" "fareMinor" "co2Kg" "sourcing"]
    :properties
    {:fareId        {:type "string"}
     :origin        {:type "string" :description "IATA airport code"}
     :destination   {:type "string" :description "IATA airport code"}
     :departDate    {:type "string" :format "date"}
     :carrier       {:type "string" :description "operating airline (IATA)"}
     :stops         {:type "integer" :description "0 = direct"}
     :durationMin   {:type "integer"}
     :fareMinor     {:type "integer" :description "base fare, minor units"}
     :baggageMinor  {:type "integer" :description "checked-bag fee (total-cost honesty, G4)"}
     :currency      {:type "string" :description "ISO-4217"}
     :co2Kg         {:type "number" :description "REQUIRED — per-passenger CO₂; surfaced on every option (G4)"}
     :cabin         {:type "string" :description "economy|premium|business|first"}
     :bookUrl       {:type "string" :description "airline's OWN booking page — affiliate-stripped at handoff (G1)"}
     :sourcing      {:type "string" :description "authoritative|representative|synthesized (G8 honesty)"}}}}}}
