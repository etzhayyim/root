;; com.etzhayyim.tsubasa.searchResult — lexicon (EDN form)
;; A ranked search result. Carries totalMinor (fare+baggage) and co2Kg on EVERY option (G4).
;; NO sponsored / commission / urgency field exists (G1/G2/G3).
;; ADR-2606072800
{:lexicon 1
 :id "com.etzhayyim.tsubasa.searchResult"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["fareId" "totalMinor" "co2Kg"]
    :properties
    {:fareId      {:type "string"}
     :totalMinor  {:type "integer" :description "fare + baggage (true total cost, G4)"}
     :co2Kg       {:type "number" :description "REQUIRED — surfaced on every result (G4)"}
     :durationMin {:type "integer"}
     :stops       {:type "integer"}
     :rank        {:type "string" :description "cheapest|greenest|fastest (compare axis); emissions is first-class"}}}}}}
