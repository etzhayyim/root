;; tadori — kotoba Datomic schema for passive threat-intel observations.
;; ADR-2605301400 T3 bridge: yabai CTI/DNS/IP-history/access-audit -> kotoba.
;;
;; This schema holds SecurityTrails/DNSDB/Recorded Future-shaped observations
;; only as operator-staged evidence datoms. Proprietary/vendor feeds are never
;; the system of record; source role must be recorded on every observation.

[;; Source metadata ---------------------------------------------------------
 {:db/id "tadori.source/id"
  :db/ident :tadori.source/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable source id, e.g. source:public-ct-log:crtsh or source:vendor-compatible:securitytrails"}
 {:db/id "tadori.source/name"
  :db/ident :tadori.source/name
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}
 {:db/id "tadori.source/vendor-family"
  :db/ident :tadori.source/vendor-family
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":public-archive | :securitytrails-compatible | :dnsdb-compatible | :recordedfuture-compatible | :operator-staged"}
 {:db/id "tadori.source/source-role"
  :db/ident :tadori.source/source-role
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":system-of-record is allowed only for open/public archives; proprietary families must use :feature-flagged-input"}
 {:db/id "tadori.source/license-tier"
  :db/ident :tadori.source/license-tier
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":A | :B | :C | :D. Tier-D requires explicit operator override and remains non-SoR."}
 {:db/id "tadori.source/dataset-cid"
  :db/ident :tadori.source/dataset-cid
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "CID of the operator-staged snapshot or archive shard."}
 {:db/id "tadori.source/captured-at"
  :db/ident :tadori.source/captured-at
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}
 {:db/id "tadori.source/notes"
  :db/ident :tadori.source/notes
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}

 ;; Observation common ------------------------------------------------------
 {:db/id "tadori.obs/id"
  :db/ident :tadori.obs/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/id "tadori.obs/kind"
  :db/ident :tadori.obs/kind
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":dns-obs | :ip-obs | :indicator"}
 {:db/id "tadori.obs/source"
  :db/ident :tadori.obs/source
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one}
 {:db/id "tadori.obs/case-id"
  :db/ident :tadori.obs/case-id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "caseMandate id. Live writes require this unless the operator only transacts schema."}
 {:db/id "tadori.obs/observed-at"
  :db/ident :tadori.obs/observed-at
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}
 {:db/id "tadori.obs/first-seen-at"
  :db/ident :tadori.obs/first-seen-at
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}
 {:db/id "tadori.obs/last-seen-at"
  :db/ident :tadori.obs/last-seen-at
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}
 {:db/id "tadori.obs/confidence"
  :db/ident :tadori.obs/confidence
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "0..1000 per-mille confidence."}
 {:db/id "tadori.obs/tlp"
  :db/ident :tadori.obs/tlp
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":clear | :green | :amber | :red"}
 {:db/id "tadori.obs/evidence-cid"
  :db/ident :tadori.obs/evidence-cid
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/many}
 {:db/id "tadori.obs/encrypted"
  :db/ident :tadori.obs/encrypted
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "true when payload contains PII-sensitive IP/device/person details."}
 {:db/id "tadori.obs/collection-mode"
  :db/ident :tadori.obs/collection-mode
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":operator-staged-passive-archive only in this ingest path; no live probes."}

 ;; DNS observation ---------------------------------------------------------
 {:db/id "tadori.dns/domain"
  :db/ident :tadori.dns/domain
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}
 {:db/id "tadori.dns/rrtype"
  :db/ident :tadori.dns/rrtype
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one}
 {:db/id "tadori.dns/rrdata"
  :db/ident :tadori.dns/rrdata
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/many}
 {:db/id "tadori.dns/passive-pivot"
  :db/ident :tadori.dns/passive-pivot
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":forward | :reverse-ip | :passive-history | :ct-log"}

 ;; IP observation ----------------------------------------------------------
 {:db/id "tadori.ip/address"
  :db/ident :tadori.ip/address
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}
 {:db/id "tadori.ip/asn"
  :db/ident :tadori.ip/asn
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one}
 {:db/id "tadori.ip/prefix"
  :db/ident :tadori.ip/prefix
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}
 {:db/id "tadori.ip/geo"
  :db/ident :tadori.ip/geo
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}
 {:db/id "tadori.ip/hosting-class"
  :db/ident :tadori.ip/hosting-class
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":residential | :cloud | :hosting | :cdn | :unknown"}

 ;; Indicator ---------------------------------------------------------------
 {:db/id "tadori.indicator/id"
  :db/ident :tadori.indicator/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/id "tadori.indicator/type"
  :db/ident :tadori.indicator/type
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":domain | :ip | :url | :hash | :email | :wallet"}
 {:db/id "tadori.indicator/value"
  :db/ident :tadori.indicator/value
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}
 {:db/id "tadori.indicator/status"
  :db/ident :tadori.indicator/status
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":candidate | :confirmed | :retracted | :superseded"}
 {:db/id "tadori.indicator/context"
  :db/ident :tadori.indicator/context
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}]
