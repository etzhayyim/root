        recurringProcessingModel: string
        storePaymentMethod: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity PaymentResponse {
        id: string @unique
        pspReference: string
        resultCode: string
        merchantReference: string
        refusalReason: string
        refusalReasonCode: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Amount {
        id: string @unique
        currency: string
        value: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity PaymentRefundRequest {
        id: string @unique
        merchantAccount: string
        reference: string
        merchantRefundReason: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity PaymentRefundResponse {
        id: string @unique
        pspReference: string
        paymentPspReference: string
        status: string
        merchantRefundReason: string
        reference: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity PaymentCaptureResponse {
        id: string @unique
        pspReference: string
        paymentPspReference: string
        status: string
        merchantAccount: string
        reference: string
        createdAt: datetime
        updatedAt: datetime
    }

}
