{
  "@context": {
    "@vocab": "https://etzhayyim.com/ns/actor#",
    "id": "@id",
    "type": "@type"
  },
  "id": "actor:kasa",
  "type": "Actor",
  "name": "kasa",
  "glyph": "嵩",
  "displayNameJa": "嵩 (かさ)",
  "displayNameEn": "Kasa — Worldwide Computing-Capacity Growth Observatory",
  "purpose": "Datafies, from PUBLIC information, the WORLDWIDE annual MAGNITUDE and GROWTH of computing capacity across four domains: STORAGE (HDD + SSD exabytes shipped), MEMORY (DRAM + NAND market revenue + bit-shipment growth), GPU/CPU (discrete-GPU + client-CPU units shipped, datacenter-accelerator revenue) and COMPUTE/FLOPS (TOP500 aggregate Rmax, frontier-model training compute), plus DATACENTER total power capacity. Reads public headline figures + open datasets only (WSTS/SIA semiconductor sales, TrendForce DRAM/NAND, IDC HDD/SSD, JPR GPU, TOP500 public list, Epoch AI CC-BY, Our World in Data CC-BY) into the kotoba Datom log as :compute.obs/*, then computes the annual increase (年間増加量) — YoY + CAGR — and coverage-honest domain aggregates. The industry-aggregate sibling of kanjō 勘定 (per-company 決算) and the demand-side counterpart of the silicon actors (handotai / iwakura / fuigo). Feeds measured actuals to mitooshi 見通し (the forecaster) but NEVER forecasts itself. NON-ADJUDICATING + PLANNING-LENS (sizes the compute commons, never a country/company ranking or an export-control / targeting list) + NO investment advice. Paid market-research terminals (Bloomberg / Gartner / IDC-report / Omdia / S&P / Statista-Pro) PROHIBITED per Charter Rider §2(e) anti-gatekeeping + §2(c): read the press release, never the terminal.",
  "purposeJa": "全世界の年間コンピューティング能力の規模と増加量を、公開情報のみから kotoba Datom log にデータ化するアクター。4 ドメイン — ストレージ（HDD+SSD 出荷容量 exabytes）・メモリ（DRAM+NAND 市場売上高+ビット出荷成長）・GPU/CPU（単体GPU+クライアントCPU 出荷台数、データセンター向けアクセラレータ売上高）・演算/FLOPS（TOP500 合計性能、フロンティアモデル学習計算量）— に加えてデータセンター総電力容量を扱う。WSTS/SIA 半導体売上高・TrendForce メモリ・IDC ストレージ・JPR GPU・TOP500 公開リスト・Epoch AI（CC-BY）・Our World in Data（CC-BY）の公開ヘッドライン数値+オープンデータのみを :compute.obs/* として登録し、年間増加量（YoY+CAGR）とカバレッジ正直な集計を算出。kanjō 勘定（企業別決算）の業界集計版、シリコン系アクター（handotai / iwakura / fuigo）の需要側カウンターパート。mitooshi 見通し（予測アクター）に実測値を供給するが、自らは予測しない（非予測）。非裁定・計画レンズ（コンピュート・コモンズのサイジング用途であり、国・企業のランキングや輸出規制・ターゲットリストではない）・投資助言なし。有料市場調査端末（Bloomberg / Gartner / IDC-report / Omdia / S&P / Statista-Pro）は Charter Rider §2(e) 反ゲートキーピング + §2(c) 取り込み禁止：プレスリリースを読む、端末は読まない。",
  "status": "R0-design-only",
  "tier": "B",
  "adr": "2606072000",
  "dependsOnAdr": ["2606032000", "2606022000", "2606051800", "2605263800", "2605262130", "2605312345", "2605215000", "2606013600", "2606013800"],
  "schema": ["00-contracts/schemas/compute-capacity-ontology.kotoba.edn"],
  "substrate": {
    "state": "kotoba Datom log (ADR-2605312345) — IPFS block backend, MST ingress, Base L2 anchor",
    "largeAssets": "source CSV / PDF dataset snapshots → DataLad → IPFS (80-data/compute-capacity) — NO git-lfs; CID anchored on :compute.source/doc-cid",
    "inference": "Murakumo-only (ADR-2605215000)",
    "render": "in-browser kotoba-wasm node (ADR-2606013600) — /search queries the :compute.obs graph client-side"
  },
  "integrates": ["actor:kanjo", "actor:kabuto", "actor:mitooshi", "actor:handotai", "actor:iwakura", "actor:fuigo"],
  "cells": [
    {
      "id": "cell:kasa.sources",
      "method": "methods/sources.py",
      "input": "(none — the admissible/prohibited publisher catalogue is in-code)",
      "output": ["out/source-catalogue.kotoba.edn"],
      "pipeline": "admissible public publishers (WSTS/SIA/TrendForce/JPR/TOP500/Epoch-AI/OWID/company-filing) + prohibited paid terminals → :compute.source-shaped catalogue. The G1 admissibility layer; admissible(publisher, access) gates ingest. Encodes Charter Rider §2(e)+§2(c)."
    },
    {
      "id": "cell:kasa.ingest",
      "method": "methods/ingest.py",
      "input": "data/ingest/*.json (rows-shaped public data points) or seed",
      "output": ["data/capacity.merged.kotoba.edn"],
      "pipeline": "public rows-JSON → G1 admissibility gate (sources.admissible) → :compute.series + :compute.obs EAVT → merge with seed (:authoritative wins over :estimated/:representative)",
      "gate": "G7 — live Epoch AI CC-BY fetch requires KASA_OPERATOR_GATE=1 + explicit --fetch-epoch (single polite request, never a scrape; passive-only per ADR-2605262400 §7). Offline/seed default, tagged :representative/:estimated (G5)"
    },
    {
      "id": "cell:kasa.analyze",
      "method": "methods/analyze.py",
      "input": "data/seed-compute-capacity.kotoba.edn (or data/capacity.merged.kotoba.edn)",
      "output": ["out/intel-report.md", "out/compute-growth.kotoba.edn"],
      "pipeline": "obs → per-series YoY (consecutive years) + full-span CAGR (:compute.growth :synthesized) → domain aggregates (:compute.agg, coverage-honest, single domain×metric×unit×scale, no double-count) → aggregate-first 年間増加量 report. Non-adjudicating, no forecast, no ranking."
    }
  ],
  "lexiconNamespaces": [
    "com.etzhayyim.kasa.registerSource",
    "com.etzhayyim.kasa.registerSeries",
    "com.etzhayyim.kasa.registerObservation",
    "com.etzhayyim.kasa.publishGrowthReport"
  ],
  "display": {
    "did": "did:web:etzhayyim.com:actor:kasa",
    "didDoc": "https://etzhayyim.com/actor/kasa/did.json",
    "search": "https://etzhayyim.com/search (in-browser kotoba-wasm node)",
    "registry": "50-infra/etzhayyim-did-web/src/registry/infra-actors.ts (INFRA_ACTORS.kasa — pending registration)"
  },
  "gates": {
    "G1": "PUBLIC sources ONLY — public/redistributable HEADLINE figures + open datasets (WSTS/SIA, TrendForce, JPR press releases; TOP500 public list; Epoch AI / Our World in Data CC-BY; company filings). PROHIBITED inputs: paid copyrighted FULL reports + subscription terminals (Gartner / IDC-report / Omdia / Bloomberg / S&P / Statista-Pro / Yole) per Charter Rider §2(e) anti-gatekeeping + §2(c). The free press-release headline is admissible; the paid terminal compilation is not. Encoded in methods/sources.py::admissible().",
    "G2": "NON-ADJUDICATING — records measured quantities + transparent growth rates. Does NOT rank countries/companies ahead/behind, call a winner, or rule on dominance. Sibling of kanjō G2 / kabuto G4.",
    "G3": "aggregate-first — domain / coverage aggregates surface first; per-series observations mirror the source verbatim.",
    "G4": "NO forecasting — PAST/PRESENT actuals + measured growth ONLY. Future projection is mitooshi 見通し (ADR-2606051800). :estimated sourcing is a nowcast of a knowable PRESENT/PAST quantity (with method), NEVER a future forecast.",
    "G5": "sourcing honesty (:authoritative parsed-from-dataset | :representative headline/rounded seed | :estimated nowcast-with-method | :synthesized derived). Growth + aggregates are :synthesized, never re-ingested as observations. Σ aggregates are coverage-bounded, never a market total.",
    "G6": "Murakumo-only narration (ADR-2605215000).",
    "G7": "outward-gated INGEST — live dataset fetch = KASA_OPERATOR_GATE + Council; full open-dataset parse is R1. Passive-only (ADR-2605262400 §7), no scraping.",
    "G8": "no git-lfs — source CSV/PDF snapshots → DataLad → IPFS (80-data/compute-capacity); CID on :compute.source/doc-cid.",
    "G9": "PLANNING-LENS, NOT a targeting list — capacity figures route to compute-commons sizing + labor-liberation planning, NEVER to export-control / sanctions / weaponization targeting. Society-scale aggregates only; no per-person data.",
    "G11": "revision-as-history (非終末論) — a source restatement asserts a NEW obs via :compute.obs/superseded-by; the prior Datom is RETAINED, never deleted. Read as-of.",
    "G12": "coverage-honest aggregates — aggregation ONLY within one (domain × metric × unit × scale). Memory (:dram/:nand) is a SUBSET of :semiconductor in a distinct domain key → structurally never double-counted; TOP500 :petaflops never summed with raw :flops.",
    "G13": "read-only — never mutates upstream sources; kasa is an observer."
  },
  "nonGoals": [
    "N1 — NOT a forecaster (future projection is mitooshi 見通し; kasa records measured/estimated actuals).",
    "N2 — NOT a market-research vendor / no paywalled report or terminal redistribution.",
    "N3 — NOT investment advice / 投資判断 (no buy/sell, no targets).",
    "N4 — NOT an export-control / sanctions / targeting list (planning lens, not a weapon).",
    "N5 — NOT per-company financials (that is kanjō 勘定) — kasa is industry/world aggregate capacity.",
    "N6 — NOT a chip benchmark (individual silicon benchmarking is e7m bench / baien).",
    "N7 — NOT a country ranking / dominance verdict (non-adjudicating, G2).",
    "N8 — NOT real-time / per-transaction data (annual cadence, public-source bound)."
  ]
}
