  "constitutionalGates": {
    "description": "14 immutable gates per ADR-2606021200. G2 (feedstock provenance) + G4 (renewable-only process heat, inherits hikari G4/G5) + G12 (no external commercial sale) are the structural anchors.",
    "gates": {
      "G1": "All process-control + robot + loader + transport firmware open-source WASM/Rust Apache 2.0 + Charter Rider",
      "G2": "Feedstock provenance on-chain per lot — NO XUAR/forced-labor polysilicon ever; no conflict-mineral In/Ga; full chain-of-custody CID-anchored (closes hikari §G2)",
      "G3": "Process-chemistry safety — NF₃/SF₆/CF₄ high-GWP gas ≥99% abated or substituted; closed-loop slurry+acid recovery; no uncontrolled fluorinated venting",
      "G4": "Fab process heat + power from hikari renewable only — NO fossil/nuclear (inherits hikari G4/G5); net-positive lifecycle energy (EPBT < service life)",
      "G5": "≥90% recyclable/circular — kerf-Si + glass + Al frame + Cu recovery; design-for-disassembly; EOL couples to hodoki; recycler Council-attested",
      "G6": "Low-toxicity metallization — Ag→Cu paste roadmap; no lead solder ribbon R2+; RoHS-equivalent consumables",
      "G7": "Labor-liberation transparency — every human task removed by automation logged to Liberation Metric (ADR-2605261000); no opaque displacement",
      "G8": "Full SBOM on-chain — CycloneDX → kotoba EAVT per ADR-2605312330; feedstock + consumables + BOM purl-keyed",
      "G9": "Land-trust integration — brownfield/existing-industrial LANDS parcel only; no greenfield; water-balance + effluent attestation",
      "G10": "Murakumo mesh placement declared 30 days prior + 1 km community feedback",
      "G11": "Deterministic yield + provenance — flash IV + EL image Ed25519-signed per module; serial ↔ feedstock lot traceable",
      "G12": "NO external commercial PV sale — modules for internal hikari install only (SBT↔SBT carve-out); surplus → community-benefit",
      "G13": "Outbound transport bound by wadachi/kami-autodrive gates — no weaponization, encrypted telemetry, own-module → hikari sites only",
      "G14": "Charter Rider §2(h) Wellbecoming — fab worker safety (no toxic exposure), no dark-pattern, acoustic + light neighborhood audit"
    }
  },
