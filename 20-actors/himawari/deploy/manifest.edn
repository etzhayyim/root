;; himawari 向日葵 — WASM Component deploy manifest (ADR-2606222100, 2026-06-23)
;;
;; This is the kotoba-native DEPLOY descriptor for the himawari WASM Component.
;; It captures the build artefact, cell→WIT export wiring, and mesh-tier placement.
;;
;; Distinct from 20-actors/himawari/manifest.jsonld which is the ACTOR manifest
;; (lexicon declarations, cells, gates, ADR refs) consumed by the repo-wide
;; manifest-lexicon-drift audit (70-tools/scripts/audit/manifest-lexicon-drift.py).
;; That audit requires manifest.jsonld; this file is the EDN-native DEPLOY layer.
;;
;; Build: bb himawari:build-wasm  (or: bb 20-actors/himawari/deploy/build_wasm.clj)
;; Validate: bb -e "(clojure.edn/read-string (slurp \"20-actors/himawari/deploy/manifest.edn\"))"

{:deploy/actor         "himawari"
 :deploy/did           "did:web:etzhayyim.com:actor:himawari"
 :deploy/adr           "etzhayyim:adr:2606021200"
 :deploy/phase         :r0.2

 ;; WASM Component artefact (kotoba-clj compiled)
 :deploy/component
 {:component/source    "deploy/agent.cljc"
  :component/output    "deploy/agent.wasm"
  :component/compiler  "kotoba-clj"
  :component/features  ["component" "cli"]
  :component/model     :wasm-component-model
  ;; CID is populated by operator after build + ipfs add --raw-leaves --cid-version=1
  :component/cid       nil  ; operator fills in after: bb himawari:build-wasm
  :component/validated? false  ; set true after: wasm-tools validate --features component-model
  :component/smoke-run? false  ; set true after: wasmtime run --wasm component-model agent.wasm
  :component/cells-ok   7}

 ;; 7-cell WIT exports (one export per Pregel cell)
 :deploy/cells
 [{:cell/name          :polysilicon-refine
   :cell/ns            "himawari.cells.polysilicon-refine"
   :cell/wit-export    "polysilicon-refine"
   :cell/murakumo-node "judah"
   :cell/gates         [:G2 :N1 :N6 :G8 :G11]}
  {:cell/name          :ingot-wafer
   :cell/ns            "himawari.cells.ingot-wafer"
   :cell/wit-export    "ingot-wafer"
   :cell/murakumo-node "issachar"
   :cell/gates         [:G4 :G5 :G8 :G11]}
  {:cell/name          :cell-process
   :cell/ns            "himawari.cells.cell-process"
   :cell/wit-export    "cell-process"
   :cell/murakumo-node "benjamin"
   :cell/gates         [:G1 :G3 :G6 :G7 :G11]}
  {:cell/name          :module-assembly
   :cell/ns            "himawari.cells.module-assembly"
   :cell/wit-export    "module-assembly"
   :cell/murakumo-node "asher"
   :cell/gates         [:G4 :G5 :G11 :G12]}
  {:cell/name          :panel-loading
   :cell/ns            "himawari.cells.panel-loading"
   :cell/wit-export    "panel-loading"
   :cell/murakumo-node "gad"
   :cell/gates         [:G6 :G7 :G12]}
  {:cell/name          :outbound-logistics
   :cell/ns            "himawari.cells.outbound-logistics"
   :cell/wit-export    "outbound-logistics"
   :cell/murakumo-node "dan"
   :cell/gates         [:G12 :G13 :N10]}
  {:cell/name          :supply-procurement
   :cell/ns            "himawari.cells.supply-procurement"
   :cell/wit-export    "supply-procurement"
   :cell/murakumo-node "simeon"
   :cell/gates         [:G2 :N1 :N6 :G8 :G11]}]

 ;; Tier classification (ADR-2606014500/014600)
 ;; T1 = raw wasm, browser-local (ameno); T2 = dag-pb CAR, mesh (e7m-wasm-runner)
 :deploy/tier :t1

 ;; Mesh activation gate — NOT operationally active until R1
 ;; R1 triggers: Council Lv6+ ratify + PV-process engineer + LANDS brownfield parcel
 :deploy/activated?    false
 :deploy/activation-gate "ADR-2606021200 §R1 (post-Council)"

 ;; Build toolchain
 :deploy/build
 {:build/script        "deploy/build_wasm.clj"
  :build/task          "himawari:build-wasm"
  :build/prereqs       ["cargo + wasm32-wasip1 target"
                        "wasm-tools (cargo install wasm-tools)"
                        "wasmtime (cargo install wasmtime-cli --features component-model)"
                        "kotoba submodule populated (40-engine/kotoba/)"]}}
