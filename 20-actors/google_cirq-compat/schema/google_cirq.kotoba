namespace google_cirq {

    entity QuantumJob {
        id: string @unique
        name: string
        createTime: datetime
        updateTime: datetime
        labelFingerprint: string
        description: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity ExecutionStatus {
        id: string @unique
        state: string
        processorName: string
        calibrationName: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity QuantumProcessor {
        id: string @unique
        name: string
        health: string
        expectedDownTime: datetime
        expectedRecoveryTime: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity QuantumProgram {
        id: string @unique
        name: string
        createTime: datetime
        updateTime: datetime
        labelFingerprint: string
        description: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity QuantumTimeSlot {
        id: string @unique
        processorName: string
        startTime: datetime
        endTime: datetime
        timeSlotType: string
        createdAt: datetime
        updatedAt: datetime
    }

}
