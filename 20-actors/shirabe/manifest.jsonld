{
  "@context": {
    "@vocab": "https://etzhayyim.com/ns/actor#",
    "id": "@id",
    "type": "@type"
  },
  "id": "actor:shirabe",
  "type": "Actor",
  "name": "shirabe",
  "glyph": "調べ",
  "purpose": "Live research-concierge membrane — answers a natural-language question by planning → reading the read-only public web → grounding a Murakumo gemma4 answer in cited sources → persisting the transparent session to the kotoba Datom log. The LLM/answer layer over web search the roster lacked; looks things up, never acts outward.",
  "status": "R1-live-verified",
  "tier": "B",
  "adr": "2606131600",
  "dependsOnAdr": ["2605215000", "2605262130", "2605312345", "2606012300", "2606039200", "2606061000", "2606122400", "2606131300"],
  "lang": "kotoba-clj",
  "schema": ["00-contracts/lexicons/com/etzhayyim/shirabe/researchSession.json"],
  "substrate": {
    "state": "kotoba Datomic (ADR-2605312345) — methods/kotoba.cljc emits [:db/add e a v] tx-data + content-addressed commit-DAG; live transact via com.etzhayyim.apps.kotoba.datomic.transact (live.clj, operator-gated)",
    "inference": "Murakumo-only (ADR-2605215000) — LiteLLM 127.0.0.1:4000 / EVO-X2 192.168.1.70 / per-node Ollama gemma 4 E4B QAT; allowlist-enforced (synthesize/allowed-infer-hosts)",
    "web": "read-only public web (G1) — DuckDuckGo HTML over babashka.http-client; never authenticated, never a write",
    "runtime": "kotoba-clj — pure .cljc methods run under babashka + the kotoba Clojure engine (ADR-2606131300)"
  },
  "integrates": ["actor:maps", "actor:kawaraban", "actor:danjo", "actor:karakuri"],
  "lineage": "the LLM/answer layer over kotoba web search (ADR-2606012300); read-only-external-fetch sibling of kawaraban (news mirror) / tsubasa (fare meta-search) / watari (AIS ingest); inference discipline shared with meisai (ADR-2606122400 local-Ollama = Murakumo-conformant)",
  "cells": [
    {
      "id": "cell:shirabe.analyze",
      "method": "methods/analyze.cljc",
      "input": "<question string>",
      "output": ["plan {:question :lang :qtype :freshness :entities :subqueries}"],
      "pipeline": "question → freshness/qtype classification + entity extraction + bounded sub-query decomposition (≤4, G5)",
      "doc": "the PLAN leg; pure, no network I/O (G7); no personalization (G3)"
    },
    {
      "id": "cell:shirabe.retrieve",
      "method": "methods/retrieve.cljc",
      "input": "plan + injected read-only web fetcher",
      "output": ["ranked evidence [{:rank :url :title :snippet :snippet-cid :retrieved-at}]"],
      "pipeline": "per-subquery fetch → dedup by url → rank by token-overlap → cap top-k → content-address each snippet",
      "doc": "the SEARCH leg; read-only public web (G1); bounded + sourced (G5); fetcher injected (G7)"
    },
    {
      "id": "cell:shirabe.synthesize",
      "method": "methods/synthesize.cljc",
      "input": "question + evidence + injected Murakumo infer + as-of",
      "output": ["{:answer :model :citations :sources :insufficient :charter-ok}"],
      "pipeline": "citation-grounded prompt (+ resolved 本日 date fact) → Murakumo gemma4 → parse citations + INSUFFICIENT honesty",
      "doc": "the gemma4 leg; Murakumo-only allowlist (G2); citation-grounded non-fabricating (G4)"
    },
    {
      "id": "cell:shirabe.session",
      "method": "methods/session.cljc",
      "input": "question + fetcher + infer + as-of",
      "output": ["research session {:id :plan :evidence :result :rounds}"],
      "pipeline": "plan → retrieve → synthesize, bounded ReAct loop (max-rounds 2, loop-until-confident)",
      "doc": "the orchestrator; pure control-flow; both live legs injected (G7)"
    },
    {
      "id": "cell:shirabe.kotoba",
      "method": "methods/kotoba.cljc",
      "input": "research session",
      "output": ["data/persisted/shirabe.datoms.kotoba.edn (append-only commit-DAG)"],
      "pipeline": "session → [:db/add e a v] tx-data → content-addressed tx (tx-cid/make-tx) → append-only log + verify-chain",
      "doc": "kotoba Datomic write path (ADR-2605312345); transparent session (G5); member bound only when signed (G6); model host Murakumo-fleet (G2)"
    },
    {
      "id": "cell:shirabe.live",
      "method": "methods/live.clj",
      "input": "<question> [--asof] [--evidence FILE] [--infer URL]",
      "output": ["cited answer (stdout) + kotoba Datomic tx (persisted)"],
      "pipeline": "wires DuckDuckGo fetcher (G1) + Murakumo infer (G2) into session/research; persists + verifies chain",
      "doc": "the G7-gated operator/member LIVE leg; never a cron; the pure loop never calls it"
    }
  ],
  "gates": {
    "G1": "read-only public web, LOOK-UP never ACT — shirabe never authenticates, submits a form, books, buys, or transacts; a purchasing/booking flow is a different member-principal actor (okaimono/shukubo/tsubasa)",
    "G2": "Murakumo-only inference (ADR-2605215000) — synthesize/allowed-infer-hosts allowlists LiteLLM/EVO-X2/local-Ollama; every commercial LLM API is unrepresentable (validate-host! raises); enforced again at persist time (kotoba/session-datoms)",
    "G3": "no personalization / no surveillance — the loop carries the query and nothing about who asked; no profile, cookies, history, or behavioural ranking (kawaraban/tsubasa lineage)",
    "G4": "citation-grounded, non-fabricating — the prompt forbids unsourced claims and answers INSUFFICIENT when sources do not suffice; the resolved 本日 date is a FACT injected for reasoning, not a fabrication",
    "G5": "bounded + sourced — sub-queries ≤4, evidence ≤ top-k, ReAct ≤ max-rounds; every snippet keeps its source URL + retrieved-at",
    "G6": "privacy — :shirabe.session/member is bound ONLY when a member signed the session; an anonymous research session binds no identity; the persisted log is local by default (publication is a separate gated step)",
    "G7": "loop does no implicit network I/O — the web fetcher + the gemma4 infer are both injected; the live legs (live.clj, datomic.transact to a live node) are explicit operator/member steps, never a cron"
  }
}
