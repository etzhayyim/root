namespace shippo {

    entity Shipment {
        id: string @unique
        shipmentDate: datetime
        status: string
        test: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Rate {
        id: string @unique
        amount: string
        currency: string
        amountLocal: string
        currencyLocal: string
        arrivesBy: datetime
        carrierAccount: string
        durationTerms: string
        estimatedDays: integer
        provider: string
        shipment: string
        zone: string
        test: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Transaction {
        id: string @unique
        labelUrl: string
        trackingNumber: string
        trackingUrlProvider: string
        commercialInvoiceUrl: string
        eta: datetime
        qrCodeUrl: string
        parcel: string
        test: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Address {
        id: string @unique
        name: string
        company: string
        street1: string
        street2: string
        streetNo: string
        city: string
        state: string
        zip: string
        country: string
        phone: string
        email: string
        isResidential: boolean
        isComplete: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Parcel {
        id: string @unique
        weight: string
        height: string
        length: string
        width: string
        objectState: string
        test: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity CarrierAccount {
        id: string @unique
        accountId: string
        active: boolean
        carrier: string
        isShippoAccount: boolean
        test: boolean
        createdAt: datetime
        updatedAt: datetime
    }

}
