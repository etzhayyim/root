// Ipsec clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace ipsec {

    entity Prefix {
        id: string @unique
        cidr: string
        originAsn: string
        validity: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Route {
        id: string @unique
        prefixId: string
        nextHop: string
        asPath: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Peer {
        id: string @unique
        asn: string
        ipAddress: string
        state: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Zone {
        id: string @unique
        name: string
        serial: integer
        refreshSec: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Record {
        id: string @unique
        zoneId: string
        name: string
        type: string
        value: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Tunnel {
        id: string @unique
        localAddr: string
        remoteAddr: string
        protocol: string
        active: boolean
        createdAt: datetime
        updatedAt: datetime
    }

}
