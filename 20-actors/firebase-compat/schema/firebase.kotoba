namespace firebase {

    entity Document {
        id: string @unique
        name: string
        createTime: datetime
        updateTime: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Value {
        id: string @unique
        booleanValue: boolean
        stringValue: string
        integerValue: integer
        doubleValue: float
        timestampValue: datetime
        referenceValue: string
        bytesValue: string
        nullValue: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Index {
        id: string @unique
        name: string
        state: string
        queryScope: string
        apiScope: string
        multikey: boolean
        unique: boolean
        shardCount: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity IndexField {
        id: string @unique
        fieldPath: string
        order: string
        arrayConfig: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Order {
        id: string @unique
        direction: string
        createdAt: datetime
        updatedAt: datetime
    }

}
