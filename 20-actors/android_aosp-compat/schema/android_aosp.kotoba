namespace android_aosp {

    entity BatteryStatus {
        id: string @unique
        status: integer
        health: integer
        plugged: integer
        level: integer
        scale: integer
        temperature: integer
        voltage: integer
        present: boolean
        technology: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Build {
        id: string @unique
        board: string
        brand: string
        device: string
        hardware: string
        manufacturer: string
        model: string
        product: string
        fingerprint: string
