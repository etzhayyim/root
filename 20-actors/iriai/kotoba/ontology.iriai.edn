;; iriai 入会 — EAVT ontology (kotoba-Datom-native). ADR-2606272200.
;; The lifeline-commons (電気/水道/ガス/通信) coverage + funding + governance schema.
;; The NEGATIVE SPACE (forbidden attrs) is declared explicitly — it is the charter
;; inversion made structural (a lifeline is a commons, never a metered product/leverage).
{:ontology/id "iriai"
 :ontology/adr "2606272200"

 :ontology/entities
 [{:entity :region        :note "a lifeline service area (the commons boundary)"}
  {:entity :lifeline-cell :note "one region × one lifeline (electric/water/gas/telecom)"}
  {:entity :proposal      :note "a §1.16 in-kind funding proposal for a cell (advisory)"}
  {:entity :decision      :note "a 1-SBT-1-vote governance decision for a proposal (advisory)"}]

 :ontology/lifelines
 [{:lifeline :water    :source "mizuho"  :essentiality 1.0}
  {:lifeline :electric :source "hikari"  :essentiality 0.9}
  {:lifeline :telecom  :source "noroshi" :essentiality 0.7}
  {:lifeline :gas      :source "kamado"  :essentiality 0.6}]

 :ontology/verdicts
 [:await-consent :provision :reinforce :redundancy :maintain :monitor]

 :ontology/instruments
 [:grant :milestone-escrow :in-kind] ; G2: give-only (no equity/debt/revenue-share)

 :ontology/attributes
 [;; cell identity
  {:attr ":iriai.cell/region"   :type :string}
  {:attr ":iriai.cell/lifeline" :type :keyword-str}
  {:attr ":iriai.cell/source"   :type :string :note "producer actor (hikari/mizuho/kamado/noroshi)"}
  ;; infra (coverage/resilience)
  {:attr ":iriai.infra/coverage"     :type :float :range [0.0 1.0]}
  {:attr ":iriai.infra/commons-gap"  :type :float :range [0.0 1.0] :note "edge-primary, on read"}
  {:attr ":iriai.infra/unserved-pop" :type :long}
  {:attr ":iriai.infra/single-source" :type :bool}
  {:attr ":iriai.infra/n1-margin"    :type :float :note "N-1 contingency margin; <0 = chokepoint"}
  {:attr ":iriai.infra/verdict"      :type :keyword-str}
  {:attr ":iriai.infra/route"        :type :keyword-str}
  ;; fund (§1.16 in-kind)
  {:attr ":iriai.fund/lifeline"    :type :keyword-str}
  {:attr ":iriai.fund/instrument"  :type :keyword-str :enum [:grant :milestone-escrow :in-kind]}
  {:attr ":iriai.fund/imputed-annual-usd" :type :float :note "market-equivalent, aggregate, transparency-only — NOT a price"}
  {:attr ":iriai.fund/reach-pop"   :type :long}
  {:attr ":iriai.fund/funding-source" :type :string :const "donation->tithe-10%->public-fund"}
  {:attr ":iriai.fund/delivery"    :type :string :const "§1.16-social-security-in-kind"}
  {:attr ":iriai.fund/cash-to-consumer" :type :long :const 0 :note "G2: cash ≡ 0"}
  {:attr ":iriai.fund/displacement-dividend-coupled" :type :bool}
  {:attr ":iriai.fund/advisory"    :type :bool :const true}
  {:attr ":iriai.fund/binds-fund"  :type :bool :const false :note "G3: the Public Fund decides"}
  {:attr ":iriai.fund/decided-by"  :type :string :const "1-sbt-1-vote"}
  ;; manage (governance/actuation/accountability)
  {:attr ":iriai.manage/lifeline"   :type :keyword-str}
  {:attr ":iriai.manage/governance" :type :string :const "1-sbt-1-vote"}
  {:attr ":iriai.manage/council-attestation" :type :string :enum ["council-lv6+" "council-lv7+"]}
  {:attr ":iriai.manage/timelock"   :type :string}
  {:attr ":iriai.manage/actuation-class" :type :keyword-str :const ":intent" :note "G5: compute-only R0"}
  {:attr ":iriai.manage/live-actuation-gate" :type :string}
  {:attr ":iriai.manage/server-held-key" :type :bool :const false :note "G6: no-server-key"}
  {:attr ":iriai.manage/attribution" :type :string :const "member-cacao-leash"}
  {:attr ":iriai.manage/advisory"   :type :bool :const true}
  ;; provenance
  {:attr ":iriai/sourcing" :type :keyword-str :note ":synthetic at R0"}
  {:attr ":iriai/derived"  :type :bool}]

 ;; ── NEGATIVE SPACE — structurally unrepresentable (the charter inversions) ──
 :ontology/forbidden
 [;; G1 — a lifeline is a commons right, never withheld as leverage
  {:attr ":iriai/shutoff"          :gate "G1" :why "a lifeline is never withheld"}
  {:attr ":iriai/disconnect"       :gate "G1" :why "a lifeline is never withheld"}
  {:attr ":iriai.region/deny"      :gate "G1" :why "no region is denied the commons"}
  {:attr ":iriai.cell/withhold"    :gate "G1" :why "no cell is withheld"}
  {:attr ":iriai.person/connection" :gate "G1" :why "aggregate region-scale only; no per-person connection record"}
  {:attr ":iriai.person/location"  :gate "G1" :why "no precise per-person location"}
  ;; G2 — commons, never a market
  {:attr ":iriai.fund/tariff"      :gate "G2" :why "no tariff/price — §1.16 in-kind"}
  {:attr ":iriai.fund/price"       :gate "G2" :why "no price"}
  {:attr ":iriai.fund/subscription" :gate "G2" :why "no subscription"}
  {:attr ":iriai.fund/meter-bill"  :gate "G2" :why "no metered bill"}
  {:attr ":iriai.fund/equity"      :gate "G2" :why "give-only; no equity"}
  {:attr ":iriai.fund/debt"        :gate "G2" :why "give-only; no debt"}
  {:attr ":iriai.fund/revenue-share" :gate "G2" :why "give-only; no revenue-share"}
  {:attr ":iriai.fund/disconnect-for-nonpayment" :gate "G2" :why "never disconnected for non-payment"}
  ;; G3 — steward, not sovereign
  {:attr ":iriai/fund"             :gate "G3" :why "no self-fund route; 1 SBT = 1 vote decides"}
  {:attr ":iriai.manage/decide"    :gate "G3" :why "iriai proposes; the commons decides"}
  {:attr ":iriai.manage/dispatch"  :gate "G3" :why "iriai never dispatches"}
  ;; G5 — assessment only, never acts
  {:attr ":iriai/actuate"          :gate "G5" :why "no actuation; producer cell under Council Lv7+"}
  {:attr ":iriai.infra/energize"   :gate "G5" :why "iriai never energizes a grid"}
  {:attr ":iriai.infra/open-valve" :gate "G5" :why "iriai never opens a valve"}
  {:attr ":iriai.infra/ignite"     :gate "G5" :why "iriai never ignites gas"}
  {:attr ":iriai.infra/activate-link" :gate "G5" :why "iriai never activates a link"}]}
