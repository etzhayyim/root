;; matsurigoto 政 — tax-collect / 源泉所得税まわりの政府側手続き registry (JPN)。ADR-2606062300。
;; 法人 (源泉徴収義務者) が 税務署 等へ行う届出・申請・法定調書の提出手続きを網羅する。
;; G2 spec-derived: 所得税法 + 同施行規則 + 国税庁様式。G5: 各手続きに出典 URL。
;; deadline.kind:
;;   :months-after        n か月以内 (起算日 + n か月)
;;   :fixed-next-year     翌年の固定日 (:month :day)
;;   :before-first-salary その年最初の給与支払日の前日まで (従業員→事業者, 保管)
;;   :before-last-salary  本年最後の給与支払日の前日まで
;;   :year-end            本年最後の給与支払時 (年末調整)
;;   :before-payment      支払を受ける時まで
;;   :anytime-approval    随時 (申請月の翌月末までに却下なければ承認, 翌々月分から適用)
{:jurisdiction "JPN"
 :procedures
 [{:id :payroll-office-open
   :ja "給与支払事務所等の開設・移転・廃止届出書"
   :trigger :open-payroll-office
   :filed-to "所轄税務署"
   :submitted-by "給与支払者(法人)"
   :deadline {:kind :months-after :n 1 :from "開設・移転・廃止の事実があった日"}
   :method ["e-Tax" "書面"]
   :statute "所得税法230条"
   :source-url "https://www.nta.go.jp/taxes/tetsuzuki/shinsei/annai/gensen/annai/1648_47.htm"}

  {:id :nokitokurei-application
   :ja "源泉所得税の納期の特例の承認に関する申請書"
   :trigger :apply-payment-special
   :filed-to "所轄税務署"
   :submitted-by "給与支払者(法人)"
   :condition "給与の支給人員が常時10人未満"
   :deadline {:kind :anytime-approval}
   :effect "申請月の翌月末日までに却下通知がなければ承認、翌々月の納付分から適用"
   :method ["e-Tax" "書面"]
   :statute "所得税法216条・217条"
   :source-url "https://www.nta.go.jp/taxes/tetsuzuki/shinsei/annai/gensen/annai/1648_48.htm"}

  {:id :dependents-declaration
   :ja "給与所得者の扶養控除等(異動)申告書"
   :trigger :employment-start
   :filed-to "給与支払者が保管 (税務署提出不要・要求時提示)"
   :submitted-by "給与所得者(従業員) → 事業者"
   :deadline {:kind :before-first-salary}
   :method ["書面" "電子 (源泉徴収義務者の承認)"]
   :statute "所得税法194条"
   :source-url "https://www.nta.go.jp/taxes/tetsuzuki/shinsei/annai/gensen/annai/1648_01.htm"}

  {:id :basic-spouse-insurance-declaration
   :ja "基礎控除申告書 兼 配偶者控除等申告書 兼 所得金額調整控除申告書 / 保険料控除申告書"
   :trigger :year-end-adjustment
   :filed-to "給与支払者が保管"
   :submitted-by "給与所得者(従業員) → 事業者"
   :deadline {:kind :before-last-salary}
   :method ["書面" "電子"]
   :statute "所得税法195条の2・196条"
   :source-url "https://www.nta.go.jp/taxes/tetsuzuki/shinsei/annai/gensen/annai/1648_02.htm"}

  {:id :year-end-adjustment
   :ja "年末調整 (源泉徴収税額の過不足の精算)"
   :trigger :year-end-adjustment
   :filed-to "給与支払者が実施 (差額を還付・徴収)"
   :submitted-by "給与支払者(法人)"
   :deadline {:kind :year-end}
   :statute "所得税法190条〜193条"
   :source-url "https://www.nta.go.jp/publication/pamph/gensen/nencho.htm"}

  {:id :retirement-income-declaration
   :ja "退職所得の受給に関する申告書"
   :trigger :retirement-payment
   :filed-to "給与支払者が保管"
   :submitted-by "退職手当の受給者 → 事業者"
   :deadline {:kind :before-payment}
   :statute "所得税法203条"
   :source-url "https://www.nta.go.jp/taxes/tetsuzuki/shinsei/annai/gensen/annai/1648_07.htm"}

  {:id :salary-withholding-slip
   :ja "給与所得の源泉徴収票 (+ 給与支払報告書 → 市区町村)"
   :trigger :annual-statutory-report
   :filed-to "所轄税務署 (一定額以上) + 受給者本人交付 + 市区町村"
   :submitted-by "給与支払者(法人)"
   :deadline {:kind :fixed-next-year :month 1 :day 31}
   :method ["e-Tax" "光ディスク" "書面" "eLTAX(給与支払報告書)"]
   :statute "所得税法226条"
   :source-url "https://www.nta.go.jp/taxes/tetsuzuki/shinsei/annai/hotei/annai/23100051.htm"}

  {:id :retirement-withholding-slip
   :ja "退職所得の源泉徴収票・特別徴収票"
   :trigger :annual-statutory-report
   :filed-to "所轄税務署 (役員等) + 受給者本人交付 + 市区町村"
   :submitted-by "給与支払者(法人)"
   :deadline {:kind :fixed-next-year :month 1 :day 31}
   :statute "所得税法226条"
   :source-url "https://www.nta.go.jp/taxes/tetsuzuki/shinsei/annai/hotei/annai/23100052.htm"}

  {:id :fee-payment-record
   :ja "報酬、料金、契約金及び賞金の支払調書"
   :trigger :annual-statutory-report
   :filed-to "所轄税務署"
   :submitted-by "報酬等の支払者(法人)"
   :deadline {:kind :fixed-next-year :month 1 :day 31}
   :method ["e-Tax" "光ディスク" "書面"]
   :statute "所得税法225条"
   :source-url "https://www.nta.go.jp/taxes/tetsuzuki/shinsei/annai/hotei/annai/23100038.htm"}

  {:id :legal-records-summary
   :ja "給与所得の源泉徴収票等の法定調書合計表"
   :trigger :annual-statutory-report
   :filed-to "所轄税務署"
   :submitted-by "支払者(法人)"
   :deadline {:kind :fixed-next-year :month 1 :day 31}
   :method ["e-Tax" "光ディスク" "書面"]
   :statute "所得税法施行規則"
   :source-url "https://www.nta.go.jp/taxes/tetsuzuki/shinsei/annai/hotei/annai/23100053.htm"}]}
