;; matsurigoto 政 — tax-collect / 源泉所得税・復興特別所得税 率パラメータ (JPN)。ADR-2606062300。
;; G2 spec-derived / G5 sourcing-honest:
;;   一律税率・控除額 (報酬10.21%/20.42%, 配当15.315%, 退職速算表, 復興2.1%) は法令・国税庁
;;   合計税率表に基づく :authoritative。
;;   給与月額表(甲欄)の別表 (:salary-monthly-kou) は年次改定されるため :representative。
;;   汎用アルゴリズムは withholding.clj、年次の authoritative 値は deployment が供給する
;;   (tax_assess の bracket-table と同じ「universal algorithm + localized parameter」方式)。
{:jurisdiction "JPN"
 :reconstruction
 {:surtax-rate "2.1%"  :multiplier "102.1%"
  :period {:from "2013-01-01" :to "2037-12-31"}
  :statute "復興財源確保法 (平成23年法律第117号) 第28条"
  :sourcing :authoritative
  :source-url "https://www.nta.go.jp/publication/pamph/gensen/aramashi/"}

 ;; 源泉徴収のための復興特別所得税及び所得税の合計税率 (基準% → 合計%)。官報・国税庁表と一致。
 :combined-rates
 {:r5  "5.105%"  :r7 "7.147%"  :r10 "10.21%" :r15 "15.315%"
  :r16 "16.336%" :r18 "18.378%" :r20 "20.42%"
  :sourcing :authoritative
  :source-url "https://www.nta.go.jp/taxes/shiraberu/shinkoku/tebiki/2012/yokuaru_qa/02.htm"}

 ;; 退職所得の所得税速算表 (復興前。withholding.clj に埋め込み済の参照値) — :authoritative
 :retirement
 {:deduction "20年以下: 40万×年(最低80万) / 20年超: 800万+70万×(年−20)"
  :statute "所得税法30条・201条"
  :sourcing :authoritative
  :source-url "https://www.nta.go.jp/taxes/shiraberu/taxanswer/shotoku/1420.htm"}

 ;; 給与 甲欄 月額の電算特例パラメータ — :representative (年次改定 / deployment が authoritative 供給)。
 ;; 下記は「電子計算機等を使用して源泉徴収税額を計算する方法」の別表構造を表す代表値であり、
 ;; 当年の確定値ではない。テストはアルゴリズムの正しさのみを検証する (値の authoritative 性は非主張)。
 :salary-monthly-kou
 {:sourcing :representative
  :source-url "https://www.nta.go.jp/publication/pamph/gensen/zeigaku/index.htm"
  :note "別表第一(給与所得控除)/第二(扶養控除)/第四(税額速算) の構造を表す簡易月額近似。
         当年の確定値ではない。テストはアルゴリズム合成 (控除→課税→速算→切捨て) のみを検証する。"
  ;; 別表第一相当(簡易月額近似): 給与所得控除 = floor(社保控除後給与 × 率/1000) + 加減算 (区分線形)
  :salary-deduction-brackets [[0      300 0]        ; ~30% (低中所得帯, 簡易)
                              [550000 100 110000]   ; 高所得帯は逓減・頭打ち
                              [1625000 0 162500]]   ; 上限 162,500円/月相当で頭打ち
  :dependent-deduction 31667     ; 別表第二相当 (控除対象扶養親族等 1人/月 ≒ 年38万÷12)
  :basic-deduction     40000     ; 基礎控除 月額相当 (年48万円 ÷ 12)
  ;; 別表第四相当: 課税給与所得金額 → 税額 = floor(A × 合計税率ppm/1e6 − 控除額)。率は復興込み。
  :tax-brackets [[0        51050  0]
                 [162501   102100 8296]
                 [275001   204200 36374]
                 [579167   234830 54113]
                 [750001   336930 130688]
                 [1500001  408400 237893]
                 [3333334  459450 408061]]}}
