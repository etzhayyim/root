;; 燠 okibi — ontology (kotoba EAVT schema, ADR-2606211200 Energy Order Protocol)
;; Thermal Matching Market. Heat is LOCAL (distance-weak) — so this is a matching
;; observatory over waste-heat SOURCES and heat-demand SINKS, gated by the
;; temperature cascade (a source can only serve a sink it is hot enough for) and
;; distance. OBSERVATION ONLY — a matching map, NEVER a dispatch order.
;;
;; Thesis (theory §5-C / §7-2 Thermal Matching Market): find where N°C of waste
;; heat at M kW sits near a demand that needs it, and route it there. A realized
;; match becomes a 澪 mio flow-improvement claim (R1, signed BTU meter).
;;
;; Attribute namespaces (kango-named observatory sibling of mio/tawami):
;;   :okibi.source/* — disclosed waste-heat source facts (class, supply temp-c, kw, site)
;;   :okibi.sink/*   — disclosed heat-demand sink facts (class, required temp-c, kw-demand, site)
;;   :okibi.match/*  — DERIVED matches (matched-kw, quality, distance-m)
;;   :okibi.obs/*    — DERIVED per-node observations (matched-kw / surplus-kw / met-kw / unmet-kw / coverage)
;;   :okibi.ledger/* — org-wide matched thermal total
;;   :okibi/derived  — true on every derived datom
;;   :okibi/sourcing — ":authoritative" | ":representative" | ":synthesized"

{:ontology/id "okibi"
 :ontology/version "0.1.0"
 :ontology/adr ["2606211200" "2605262130" "2605312345" "2606051500"]

 :node-kinds
 [{:kind :source
   :doc "A waste-heat source (datacenter / food-plant / geothermal / sewage / refrigeration / industrial) with a supply temperature, available thermal kW, and a location."
   :keys [:id :name :source-class :temp-c :kw :lat :lon :availability :sourcing :source :note]}
  {:kind :sink
   :doc "A heat-demand sink (district-heat / greenhouse / hot-water / drying / absorption-cooling / space-heat) with a required temperature, demanded kW, and a location. NOTE absorption-cooling is a legitimate heat sink (heat DRIVES the chiller)."
   :keys [:id :name :sink-class :temp-req-c :kw-demand :lat :lon :availability :sourcing :source :note]}]

 :source-classes
 #{:datacenter :food-plant :geothermal :sewage :refrigeration :industrial}
 :sink-classes
 #{:district-heat :greenhouse :hot-water :drying :absorption-cooling :space-heat}

 :match-params
 {:approach-temp-c 5.0    ;; a source must exceed a sink's required temp by ≥ this (cascade)
  :max-distance-m 5000.0} ;; beyond this, heat is not deliverable (locality)

 ;; negative space — structurally absent attributes (enforced by tests)
 :unrepresentable
 [":okibi/dispatch"           ;; G1: never a dispatch/control order (hikari actuates)
  ":okibi.match/fabricated"   ;; G2: a match must pass the temp cascade + distance — never fabricated
  ":okibi/trade"              ;; never a market position
  ":okibi/signal"             ;; never a price signal
  ":okibi.sink/cooling-load"]} ;; a cooling LOAD is not a heat sink — the §1 anti-pattern is unrepresentable
