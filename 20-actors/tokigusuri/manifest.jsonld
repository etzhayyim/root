{
  "@context": {
    "@vocab": "https://etzhayyim.com/ns/actor#",
    "id": "@id",
    "type": "@type"
  },
  "id": "actor:tokigusuri",
  "type": "Actor",
  "name": "tokigusuri",
  "glyph": "時薬",
  "purpose": "Pharmaceutical patent-cliff / off-patent-access observatory — weaves drugs / exclusivity-barriers / patent-or-generic holders / bearers into the kotoba Datom log; surfaces which essential medicines are gated by remaining exclusivity vs where generic/biosimilar release has restored access, routed to RELEASE (解放); observation→handoff only, non-adjudicating, no-FTO-opinion, lawful-routes-only.",
  "status": "R0-design-only",
  "tier": "B",
  "adr": "2606171300",
  "dependsOnAdr": ["2606073400", "2606073000", "2605250500", "2604271830", "2606011800", "2605262800", "2605312345", "2605215000"],
  "schema": ["00-contracts/schemas/pharma-patent-ontology.kotoba.edn"],
  "substrate": {
    "state": "kotoba Datom log (ADR-2605312345) — methods/datom_emit.cljc emits canonical EAVT",
    "largeAssets": "DataLad → IPFS (80-data/pharma-patent) — NO git-lfs",
    "inference": "Murakumo-only (ADR-2605215000)",
    "runtime": "kotoba pywasm actor (componentize-py) — pure .cljc methods, no numpy"
  },
  "integrates": ["actor:yakushi", "actor:tsumugi", "actor:danjo", "actor:kanjo", "actor:mitate"],
  "lineage": "medicine-access sibling of the KG-mirror lineage (hokorobi/inochi/tsumugi); pharmaceutical-exclusivity scope; OBSERVATION→HANDOFF only (manufacture is yakushi 薬師 + ADR-2604271830)",
  "cells": [
    {
      "id": "cell:tokigusuri.analyze",
      "method": "methods/analyze.cljc",
      "input": "data/seed-pharma-patent-graph.kotoba.edn",
      "output": ["out/patent-cliff-report.md"],
      "pipeline": "load-edn → edge-primary integral (Σ incident inbound barrier-load × disclosed essentiality weight) → access-barrier-concentration + release-buffer + exclusivity-barrier-concentration, aggregate-first",
      "doc": "edge-primary access-barrier vs release; release map, never a patent-busting / FTO / trading signal"
    },
    {
      "id": "cell:tokigusuri.datom-emit",
      "method": "methods/datom_emit.cljc",
      "input": "data/seed-pharma-patent-graph.kotoba.edn",
      "output": ["out/patent-cliff-datoms.kotoba.edn"],
      "pipeline": "ground EAVT datoms [e a v tx :add] (durable) + derived readouts flagged :bond/is-transient (computed on read, N1/G2)",
      "doc": "kotoba Datom-log projection — first-class canonical state (ADR-2605312345)"
    },
    {
      "id": "cell:tokigusuri.coverage",
      "method": "methods/coverage_report.cljc",
      "input": "data/seed-pharma-patent-graph.kotoba.edn",
      "output": ["out/coverage-report.md"],
      "pipeline": "denominator (WHO EML / Orange Book / all-marketed) + modality + exclusivity-status + essentiality + barrier-kind + bearer-kind → gap map",
      "doc": "honest coverage (all-drugs ~0 by design); names thin/missing buckets per wave (G6)"
    }
  ],
  "gates": {
    "G1": "RELEASE map, NEVER a patent-busting / FTO-opinion / infringement-determination / per-company-verdict / pharma-equity-signal — aggregate-first; the 取-holder is the exclusivity-barrier, the bearer is patients/the public, the routing is lawful release (解放)",
    "G2": "edge-primary (N1) — barrier lives only on :en/barrier-load; node access-barrier is the integral computed on read; no :tokigusuri/monopoly-of-drug; a medicine is never a 取-holder source",
    "G3": "non-adjudicating (N3) — patent/exclusivity/expiry are DISCLOSED facts (Orange Book/WHO EML/MPP), never tokigusuri verdicts; no FTO/infringement determination, no investment advice",
    "G4": "lawful-routes-only — generic/biosimilar entry only for off-patent/expiring; on-patent routes limited to disclosed MPP voluntary licensing + TRIPS/Doha flexibilities; circumvention/infringement-inducement unrepresentable",
    "G5": "public venue — open-source + on-chain + 1 SBT = 1 vote; never a paid drug-patent terminal (Rider §2(e))",
    "G6": "sourcing honesty — every record :authoritative | :representative; barrier-load values are representative severities, not measured exclusivity terms; no fabricated coverage",
    "G7": "Murakumo-only narration (ADR-2605215000)",
    "G8": "outward-gated, observation→handoff only — live ingest (Orange Book/WHO EML/MPP) requires Council + operator DID; tokigusuri never manufactures (yakushi + ADR-2604271830 do); R0 = analyzer + schema + seed only"
  }
}
