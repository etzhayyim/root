// Censusgov clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace censusgov {

    entity Dataset {
        id: string @unique
        title: string
        description: string
        identifier: string
        accessLevel: string
        modified: datetime
        cVintage: integer
        cIsAggregate: boolean
        cIsCube: boolean
        cIsAvailable: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Variable {
        id: string @unique
        label: string
        concept: string
        predicateType: string
        group: string
        limit: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Geography {
        id: string @unique
        name: string
        geoLevelDisplay: string
        referenceDate: datetime
        createdAt: datetime
        updatedAt: datetime
    }

}
