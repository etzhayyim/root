// Netlify clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace netlify {

    entity Site {
        id: string @unique
        name: string
        url: string
        adminUrl: string
        customDomain: string
        state: string
        plan: string
        accountId: string
        accountSlug: string
        gitProvider: string
        buildImage: string
        sslUrl: string
        ssl: boolean
        forceSsl: boolean
        userId: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Deploy {
        id: string @unique
        siteId: string
        name: string
        state: string
        branch: string
        context: string
        commitRef: string
        deployUrl: string
        sslUrl: string
        draft: boolean
        locked: boolean
        buildId: string
        errorMessage: string
        title: string
        url: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Build {
        id: string @unique
        deployId: string
        sha: string
        done: boolean
        error: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Form {
        id: string @unique
        siteId: string
        name: string
        submissionCount: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Submission {
        id: string @unique
        siteUrl: string
        name: string
        email: string
        firstName: string
        lastName: string
        company: string
        summary: string
        body: string
        number: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Hook {
        id: string @unique
        siteId: string
        type: string
        event: string
        disabled: boolean
        createdAt: datetime
        updatedAt: datetime
    }

}
