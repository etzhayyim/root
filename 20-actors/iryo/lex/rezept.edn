;; com.etzhayyim.apps.iryo.rezept — lexicon (EDN form)
;; A computed レセプト (診療報酬請求明細書). Codes + points only; PHI (氏名/生年月日) lives in
;; the encrypted envelope referenced by encryptedPayloadCid, never inline (G2).
{:lexicon 1
 :id "com.etzhayyim.apps.iryo.rezept"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["patientDid" "hokenshaBango" "shinryoYm" "totalTen" "patientPayYen"]
    :properties
    {:patientDid            {:type "string" :description "rotating pseudonym DID (no MRN)"}
     :encryptedPayloadCid   {:type "string" :description "氏名/生年月日 envelope CID (PHI; ADR-2605181100)"}
     :hokenshaBango         {:type "string" :description "保険者番号 (8桁社保/6桁国保)"}
     :shinryoYm             {:type "string" :description "診療年月 YYYY-MM"}
     :futanWari             {:type "number" :description "負担割合 0.3/0.2/0.1/0.0"}
     :totalTen              {:type "integer" :description "合計点数 (1点=10円)"}
     :totalIryohiYen        {:type "integer" :description "総医療費 10割"}
     :ichibuFutanYen        {:type "integer" :description "一部負担金(算定, 高額療養費適用前)"}
     :kogakuKubun           {:type "string" :description "高額療養費 所得区分 ア/イ/ウ/エ/オ"}
     :kogakuApplied         {:type "boolean"}
     :patientPayYen         {:type "integer" :description "窓口負担(高額療養費適用後)"}
     :state                 {:type "string" :description "draft|submitted (online請求 operator-gated)"}
     :observedAt            {:type "string"}}}}}}
