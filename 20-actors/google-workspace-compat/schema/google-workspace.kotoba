namespace google_workspace {

    entity User {
        id: string @unique
        primaryEmail: string
        suspended: boolean
        isAdmin: boolean
        isDelegatedAdmin: boolean
        orgUnitPath: string
        creationTime: datetime
        lastLoginTime: datetime
        agreedToTerms: boolean
        archived: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Group {
        id: string @unique
        email: string
        name: string
        directMembersCount: string
        adminCreated: boolean
        description: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Member {
        id: string @unique
        email: string
        role: string
        type: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity OrgUnit {
        id: string @unique
        name: string
        orgUnitPath: string
        parentOrgUnitPath: string
        description: string
        blockInheritance: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity ChromeOsDevice {
        id: string @unique
        serialNumber: string
        status: string
        chromeOsType: string
        osVersionCompliance: string
        deviceLicenseType: string
        lastSync: datetime
        createdAt: datetime
        updatedAt: datetime
    }

}
