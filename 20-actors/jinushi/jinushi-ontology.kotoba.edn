;; jinushi 地主 — world land-ownership ACQUISITION ontology (kotoba EAVT schema).
;; Tree-of-Life land doctrine: ADR-2605192100 §1.11 + ADR-2605192245.
;; The data-acquisition (取得) feeder of the on-chain LandRegistry; jinushi observes/normalizes
;; PUBLIC land-ownership, it never moves land (G3).
{:ontology/name "jinushi.land-acquisition"
 :ontology/version "0.1.0"

 ;; ── GROUND (durable :add) — disclosed registry records ──────────────────────
 :node/owner
 {:owner/key       {:db/type :string  :db/doc "stable owner key (e.g. o.gov.jp.mlit / agg.natural.jp)"}
  :owner/name      {:db/type :string  :db/doc "display name (preserved verbatim)"}
  :owner/name-norm {:db/type :string  :db/doc "normalized name for dedup (suffix/case folded)"}
  :owner/type      {:db/type :keyword :db/doc ":public | :private | :ngo | :cooperative | :unknown"}
  :owner/aggregate {:db/type :boolean :db/doc "G1: true = an aggregate bucket (natural persons), NOT an individual"}}

 :node/parcel
 {:parcel/id            {:db/type :string  :db/doc "registry parcel id"}
  :parcel/country       {:db/type :string  :db/doc "ISO-3166-1 alpha-2"}
  :parcel/region        {:db/type :string  :db/doc "sub-national region"}
  :parcel/area-m2       {:db/type :double  :db/doc "parcel area (m²)"}
  :parcel/owner         {:db/type :ref     :db/doc "owner/key"}
  :parcel/source        {:db/type :keyword :db/doc ":registry-api | :municipality-notice | :manual"}
  :parcel/centroid-lat  {:db/type :double  :db/doc "G1: COARSE region centroid latitude, never a dwelling fix"}
  :parcel/centroid-lon  {:db/type :double  :db/doc "G1: COARSE region centroid longitude, never a dwelling fix"}
  :record/id            {:db/type :string  :db/doc "sha256(country|parcel-id|owner-name-norm|source) — upsert key"}}

 ;; ── DERIVED (:bond/is-transient true) — read-time aggregates, never facts/verdicts (G2) ──
 :derived/world-land
 {:jinushi/hhi                  {:db/type :double  :db/transient true :db/doc "land 取-concentration HHI over owners by area (0..10000)"}
  :jinushi/owner-count          {:db/type :long    :db/transient true}
  :jinushi/top-holder           {:db/type :ref     :db/transient true :db/doc "largest single owner by area"}
  :jinushi/top-holder-share     {:db/type :double  :db/transient true}
  :jinushi/countries-touched    {:db/type :long    :db/transient true}
  :jinushi/acquired-area-km2    {:db/type :double  :db/transient true}
  :jinushi/world-coverage-frac  {:db/type :double  :db/transient true :db/doc "acquired ÷ world land area"}
  :jinushi/return-candidate     {:db/type :ref     :db/transient true :db/doc "G1/G3: ADVISORY commons-return review (Council), never a write-back/seizure"}}

 ;; ── negative space (structurally absent) ────────────────────────────────────
 :ontology/forbidden
 {:person/*        "G1: no individual/natural-person dimension; persons fold to :owner/aggregate"
  :parcel/occupant "G1: no occupant/resident attribution"
  :land/transfer   "G3: jinushi asserts no transfer; only the on-chain LandRegistry moves land (member donation, no-server-key)"
  :land/mint       "G3: jinushi asserts no mint/donation"
  :owner/score     "G2: no per-owner verdict/score; concentration is an aggregate, not a judgment"}}
