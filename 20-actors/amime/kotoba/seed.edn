;; amime 網目 — synthetic multi-site energy MESH seed (ALL :synthetic, NOT real sites).
;; Illustrative of the flow-network solve — NOT a real grid, NOT a target-list.
;; Real-site modelling is an operator/Council step (G5/G7).
;;
;; SITE : :gen / :load in kW; net = gen − load (signed injection); :role is descriptive.
;; LINK : :capacity kW (bounds SENT kW, undirected); :loss ∈ 0..1 (fraction lost in transit).
;;
;; The mesh: three surplus generators (solar / wind / hydro) + a discharging storage hub
;; feed two deficit loads (a datacenter — toi 樋 compute — and a microgrid city). The link
;; topology makes solar→datacenter the high-throughput path whose loss in N-1 hurts most.
[
 ;; — surplus sites (generation > load) —
 {:type :site :id :solar-a   :role :solar    :gen 800 :load 100}   ;; net +700
 {:type :site :id :wind-b    :role :wind     :gen 600 :load  50}   ;; net +550
 {:type :site :id :hydro-c   :role :hydro    :gen 300 :load  50}   ;; net +250
 {:type :site :id :storage-f :role :storage  :gen 200 :load   0}   ;; net +200 (discharging)

 ;; — deficit sites (load > generation) —
 {:type :site :id :dc-load-d :role :datacenter :gen   0 :load 900} ;; net −900 (toi compute)
 {:type :site :id :city-e    :role :microgrid  :gen  50 :load 500} ;; net −450

 ;; — links (the mesh) —
 {:type :link :id :l-sa-dc  :from :solar-a   :to :dc-load-d :capacity 600 :loss 0.03}
 {:type :link :id :l-wb-dc  :from :wind-b    :to :dc-load-d :capacity 500 :loss 0.05}
 {:type :link :id :l-sf-dc  :from :storage-f :to :dc-load-d :capacity 200 :loss 0.02}
 {:type :link :id :l-hc-dc  :from :hydro-c   :to :dc-load-d :capacity 150 :loss 0.03}
 {:type :link :id :l-wb-ct  :from :wind-b    :to :city-e    :capacity 300 :loss 0.04}
 {:type :link :id :l-hc-ct  :from :hydro-c   :to :city-e    :capacity 300 :loss 0.02}
 {:type :link :id :l-sa-ct  :from :solar-a   :to :city-e    :capacity 200 :loss 0.06}
]
