;; amime 網目 — ontology (kotoba EAVT schema, ADR-2606212020)
;; The multi-site energy MESH flow-network actor — the SoS energy-flow layer the Energy
;; Order suite (ADR-2606211200) lacked: hikari designs ONE site, mio verifies the aggregate
;; Flowrate, amime models how ORDERED flow moves BETWEEN sites over capacity-bounded lossy
;; links. A COMMONS mesh, never a market (no price / no trade). SIM ONLY — amime never
;; dispatches; hikari actuates under Council gate.
;;
;; Attribute namespaces:
;;   :amime.site/*  — per-site solve result (role, net, served, unserved, curtailed)
;;   :amime.link/*  — per-link result (flow, utilisation, loss, critical?)
;;   :amime.mesh/*  — DERIVED mesh summary (served-fraction, loss, curtailed, critical-link)
;;   :amime/derived — true on every derived datom
;;   :amime/sourcing — ":authoritative" | ":representative" | ":synthetic"
;;   :en/*          — kaname-facing :energy mirror 縁 (concentration / depends-on), domain :energy

{:ontology/id "amime"
 :ontology/version "0.1.0"
 :ontology/adr ["2606212020" "2606211200" "2606091800" "2606172100" "2605262130"]

 :node-kinds
 [{:kind :site
   :doc "An energy site (generator / load / storage hub) in the mesh. net = gen − load."
   :keys [:id :name :role :gen :load]}
  {:kind :link
   :doc "An undirected inter-site link. :capacity bounds SENT kW; :loss ∈ 0..1 lost in transit."
   :keys [:id :from :to :capacity :loss]}]

 :enums
 {:role #{:solar :wind :hydro :geothermal :storage :microgrid :datacenter :load :industrial}
  :verdict-of-link #{:nominal :critical}}   ;; critical = worst N-1 chokepoint → REDUNDANCY

 ;; negative space — structurally absent (enforced by tests)
 :unrepresentable
 [":amime/price"      ;; G1 — a COMMONS mesh, never a market: no price
  ":amime/trade"      ;; G1 — no buy/sell/bid; rewards ORDERED FLOW, never consumed energy (mio PoUF)
  ":amime/dispatch"   ;; G4 — amime never actuates; hikari dispatches under Council gate
  ":amime.site/person"]} ;; G3 — aggregate sites only; no person-level metering
