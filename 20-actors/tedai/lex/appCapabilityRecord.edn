{:lexicon 1
 :id "com.etzhayyim.tedai.appCapabilityRecord"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["appId" "t1Available" "t2Stance" "tier" "representative"]
    :properties
    {:appId {:type "string" :description "app id (finder / mail / excel / legacy-win-app …)"}
     :appName {:type "string"}
     :category {:type "string" :description "file-manager / mail / spreadsheet / game / browser …"}
     :t1Available {:type "boolean" :description "the app exposes an official scripting/accessibility automation surface"}
     :t1Surface {:type "string" :description "applescript+ax / uia / at-spi / cli — the OS-sanctioned surface (G2)"}
     :t2Stance {:type "string" :enum ["permitted" "restricted" "prohibited"] :description "synthetic-input stance; :prohibited (anti-cheat/DRM/terms) refuses T2 by construction, default-deny when missing (G2)"}
     :tier {:type "string" :enum ["t1-scripting-api" "t2-vision-pointer" "t3-file-level"] :description "selected safest tier"}
     :route {:type "string" :enum ["karakuri"] :description "N7 — browser apps belong to karakuri"}
     :representative {:type "boolean" :const true :description "G8 — bounded :representative subset; operator MUST verify a stance before live use"}}}}}}
