{
  "name": "@etzhayyim/graph-schema",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Graph schema definitions for etzhayyim graph layer (P10v2 GraphAr).",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./helpers": "./src/helpers.ts",
    "./database": "./src/database.ts",
    "./database-strict": "./src/database-strict.ts",
    "./db": "./src/db.ts",
    "./vertex-tier": "./src/vertex-tier.gen.ts"
  },
  "scripts": {
    "test": "vitest run",
    "db:migrate": "uv run alembic upgrade head",
    "db:migrate:up": "uv run alembic upgrade +1",
    "db:migrate:down": "uv run alembic downgrade -1",
    "db:migrate:list": "uv run alembic history --verbose",
    "db:migrate:new": "uv run alembic revision -m",
    "db:drift": "uv run python -m graph_schema.drift",
    "db:gen": "uv run python -m graph_schema.generate_database_ts",
    "db:kysely:migrate": "node --loader=ts-node/esm scripts/migrate.ts latest",
    "db:kysely:migrate:list": "node --loader=ts-node/esm scripts/migrate.ts list",
    "db:kysely:audit": "uv run python -m graph_schema.audit_kysely_migrations",
    "db:kysely:convert": "uv run python -m graph_schema.kysely_to_alembic --write",
    "sqlmesh:plan": "uv run sqlmesh -p sqlmesh plan prod",
    "sqlmesh:run": "uv run sqlmesh -p sqlmesh run prod",
    "sqlc:gen": "cd sqlc && sqlc generate",
    "sqlc:verify": "cd sqlc && sqlc vet && sqlc diff",
    "rag:evaluate": "node scripts/evaluate-schema-aware-rag.mjs",
    "rag:llm": "node scripts/run-schema-rag-llm.mjs",
    "rag:retrieve": "node scripts/schema-rag-runtime.mjs",
    "rag:train": "node scripts/train-schema-rag-reranker.mjs",
    "tier:gen": "node scripts/gen-vertex-tier.mjs",
    "tier:lint": "node scripts/lint-vertex-tier.mjs",
    "verify:gov-zaf": "node scripts/verify-gov-zaf-coverage.mjs",
    "verify:gov-ago": "node scripts/verify-gov-ago-coverage.mjs",
    "verify:gov-fetch": "node scripts/verify-gov-fetch-coverage.mjs",
    "jp-fiscal:sources:sync": "node --loader=ts-node/esm scripts/sync-jp-fiscal-sources.ts",
    "jp-fiscal:documents:sync": "node --loader=ts-node/esm scripts/sync-jp-fiscal-documents.ts",
    "jp-fiscal:budget-books:sync": "node --loader=ts-node/esm scripts/sync-jp-fiscal-budget-books.ts",
    "jp-fiscal:appropriations:sync": "node --loader=ts-node/esm scripts/sync-jp-fiscal-appropriations.ts",
    "jp-fiscal:appropriation-flows:sync": "node --loader=ts-node/esm scripts/sync-jp-fiscal-appropriation-flows.ts",
    "jp-fiscal:record-evidence:sync": "node --loader=ts-node/esm scripts/sync-jp-fiscal-record-evidence.ts",
    "jp-fiscal:procurement-bids:sync": "node --loader=ts-node/esm scripts/sync-jp-fiscal-procurement-bids.ts",
    "malak:traps:health": "node scripts/check-malak-trap-health.mjs",
    "malak:traps:sync": "node scripts/sync-malak-inbound-email-traps.mjs",
    "identity:migrate-rw-root": "node scripts/migrate-rw-erc725-root.mjs",
    "sync:agent-runtime-events": "node scripts/sync-rw-agent-runtime-events.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "kysely": "^0.27.4",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  }
}
