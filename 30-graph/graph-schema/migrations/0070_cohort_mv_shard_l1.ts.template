// SKELETON / TEMPLATE — not applied. Becomes a real migration when ADR-0028
// Phase 3 trigger fires (cohort_total > 500K).
//
// Generates 13 sub-MVs by pcfL1 prefix, replacing the single
// mv_cohort_identity_posterior + mv_cohort_k_drift + mv_cohort_lineage_depth.
//
// File is named `.template` so the migrator skips it. Renaming to
// `0070_cohort_mv_shard_l1.ts` activates the migration.
//
// Pre-flight before activating:
//   1. Confirm cohort_total > 500K via `etzhayyim cohort dashboard`
//   2. Compute cardinality per L1 — none should exceed 500K (sharding's whole point)
//   3. Increase compute pod RAM to 32Gi+ during initial backfill
//   4. Run during off-peak hours; create MVs one-at-a-time, watch `kubectl top pod`
//   5. Drop legacy 3 MVs only after all 13 sub-MVs backfilled and reading correctly

import { Kysely, sql } from 'kysely';

const APQC_L1_SLUGS: ReadonlyArray<string> = [
  '1-vision-strategy',
  '2-product-service',
  '3-market-sell',
  '4-supply-chain',
  '5-production-ops',
  '6-customer-service',
  '7-human-capital',
  '8-info-technology',
  '9-financial-resources',
  '10-asset-management',
  '11-risk-compliance',
  '12-external-relations',
  '13-business-capability',
];

function l1Suffix(slug: string): string {
  // "3-market-sell" → "3_market_sell" (PostgreSQL identifier compatible)
  return slug.replace(/-/g, '_');
}

export async function up(db: Kysely<any>): Promise<void> {
  for (const slug of APQC_L1_SLUGS) {
    const suf = l1Suffix(slug);
    const pattern = `%pcfL1=${slug}%`;

    await db.executeQuery(sql`CREATE MATERIALIZED VIEW IF NOT EXISTS ${sql.raw(`mv_cohort_identity_posterior_l1_${suf}`)} AS
      SELECT
        cohort_did,
        COUNT(*)::BIGINT                                              AS evidence_count,
        AVG(posterior)::DOUBLE PRECISION                              AS avg_posterior,
        MAX(posterior)::DOUBLE PRECISION                              AS max_posterior,
        SUM(CASE WHEN judge_agreement THEN 1 ELSE 0 END)::BIGINT      AS judge_agree_count,
        SUM(CASE WHEN posterior > 0.95 AND judge_agreement
                 THEN 1 ELSE 0 END)::BIGINT                           AS fission_ready_count,
        MAX(observed_at)                                              AS last_evidence_at
      FROM vertex_repo_record
      WHERE collection = 'com.etzhayyim.cohort.evidence'
        AND cohort_did IN (
          SELECT cohort_did FROM vertex_cohort_actor
          WHERE segment_hash LIKE ${pattern}
        )
      GROUP BY cohort_did`.compile(db));

    await db.executeQuery(sql`CREATE MATERIALIZED VIEW IF NOT EXISTS ${sql.raw(`mv_cohort_k_drift_l1_${suf}`)} AS
      SELECT
        cohort_did,
        COUNT(DISTINCT signal_kind)::BIGINT AS distinct_signal_kinds,
        COUNT(*)::BIGINT                    AS evidence_count,
        CASE WHEN COUNT(DISTINCT signal_kind) = 0 THEN 0
             ELSE COUNT(*) / COUNT(DISTINCT signal_kind)
        END::BIGINT                         AS k_proxy
      FROM vertex_repo_record
      WHERE collection = 'com.etzhayyim.cohort.evidence'
        AND cohort_did IN (
          SELECT cohort_did FROM vertex_cohort_actor
          WHERE segment_hash LIKE ${pattern}
        )
      GROUP BY cohort_did`.compile(db));
  }

  // After all 13 backfilled successfully, drop the legacy single MVs.
  // Commented out — must verify reads work first.
  // await db.executeQuery(sql`DROP MATERIALIZED VIEW IF EXISTS mv_cohort_identity_posterior`.compile(db));
  // await db.executeQuery(sql`DROP MATERIALIZED VIEW IF EXISTS mv_cohort_k_drift`.compile(db));
}

export async function down(db: Kysely<any>): Promise<void> {
  for (const slug of APQC_L1_SLUGS) {
    const suf = l1Suffix(slug);
    await db.executeQuery(sql`DROP MATERIALIZED VIEW IF EXISTS ${sql.raw(`mv_cohort_k_drift_l1_${suf}`)}`.compile(db));
    await db.executeQuery(sql`DROP MATERIALIZED VIEW IF EXISTS ${sql.raw(`mv_cohort_identity_posterior_l1_${suf}`)}`.compile(db));
  }
}
