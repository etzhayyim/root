{
  "name": "magatama-m33tr3c0",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_NANOID": "m33tr3c0",
    "APP_DISPLAY_NAME": "Meeting Recorder",
    "APP_DESCRIPTION": "User-delegated meeting recorder for Teams / Meet / Zoom. Consent-gated, PII Tier 3, Murakumo MLX whisper-large-v3. ADR-0050.",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "appview",
    "APP_CAPABILITIES": "[\"meeting-join-teams\",\"meeting-join-meet\",\"meeting-join-zoom\",\"audio-record\",\"video-record\",\"transcript-e2e-encrypted\",\"consent-gated-join\",\"pii-tier-3\"]",
    "RECORDER_SELF_URL": "https://meeting-recorder.gftd.ai",
    "PDS_DID": "did:web:atproto.gftd.ai",
    "DID_GFTD_RESOLVER": "https://did.gftd.ai",
    "DID_PLC_RESOLVER": "https://plc.directory",
    "RECORDER_CHUNK_SECONDS_DEFAULT": "60",
    "CONSENT_MAX_EXPIRY_SECONDS": "600",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.gftd.ai/xrpc/ai.gftd.mcp.message"
  },
  "routes": [
    {
      "pattern": "m33tr3c0.gftd.ai/*",
      "zone_name": "gftd.ai"
    },
    {
      "pattern": "meeting-recorder.gftd.ai/*",
      "zone_name": "gftd.ai"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
