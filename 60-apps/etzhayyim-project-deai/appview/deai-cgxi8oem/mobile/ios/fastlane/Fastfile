default_platform(:ios)

ASC_KEY_ID      = "62BW4Q57AB"
ASC_ISSUER_ID   = "69a6de81-326a-47e3-e053-5b8c7c11a4d1"
ASC_KEY_FILEPATH = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_62BW4Q57AB.p8")

def asc_api_key
  app_store_connect_api_key(
    key_id:        ASC_KEY_ID,
    issuer_id:     ASC_ISSUER_ID,
    key_filepath:  ASC_KEY_FILEPATH,
    duration:      1200,
    in_house:      false,
  )
end

platform :ios do
  # ── Certificates & Provisioning ──────────────────────────────────────────
  desc "Sync AppStore certificates and provisioning profiles (read-only)"
  lane :sync_certs do
    api_key = asc_api_key
    match(
      type:                        "appstore",
      app_identifier:              "com.etzhayyim.deai",
      api_key:                     api_key,
      readonly:                    true,
      git_url:                     "git@github.com:com-junkawasaki/deai-certificates.git",
    )
  end

  desc "Create (or rotate) AppStore certificates and provisioning profiles"
  lane :create_certs do
    api_key = asc_api_key
    match(
      type:                        "appstore",
      app_identifier:              "com.etzhayyim.deai",
      api_key:                     api_key,
      readonly:                    false,
      force_for_new_devices:       true,
      git_url:                     "git@github.com:com-junkawasaki/deai-certificates.git",
    )
  end

  # ── Build helper ─────────────────────────────────────────────────────────
  def build_app_store(export_method: "app-store")
    sync_certs

    increment_build_number(
      xcodeproj: "App/App.xcodeproj",
    )

    build_app(
      workspace:         "App/App.xcworkspace",
      scheme:            "App",
      export_method:     export_method,
      export_options: {
        provisioningProfiles: {
          "com.etzhayyim.deai" => "match AppStore com.etzhayyim.deai",
        },
        signingStyle:    "manual",
        teamID:          "3A5CBTEBFP",
      },
      clean:             true,
      output_directory:  "./build",
      output_name:       "deai.ipa",
    )
  end

  # ── TestFlight (beta) ─────────────────────────────────────────────────────
  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = asc_api_key
    build_app_store

    upload_to_testflight(
      api_key:                     api_key,
      app_identifier:              "com.etzhayyim.deai",
      ipa:                         "./build/deai.ipa",
      skip_waiting_for_build_processing: true,
    )
  end

  # ── App Store release ─────────────────────────────────────────────────────
  desc "Build and upload to App Store (manual review submission)"
  lane :release do
    api_key = asc_api_key
    build_app_store

    upload_to_app_store(
      api_key:                     api_key,
      app_identifier:              "com.etzhayyim.deai",
      ipa:                         "./build/deai.ipa",
      metadata_path:               "./fastlane/metadata",
      screenshots_path:            "./fastlane/screenshots",
      skip_screenshots:            false,
      skip_metadata:               false,
      submit_for_review:           false,
      automatic_release:           false,
      force:                       true,
      precheck_include_in_app_purchases: false,
    )
  end

  # ── Metadata / Screenshots ────────────────────────────────────────────────
  desc "Download current App Store metadata"
  lane :fetch_metadata do
    api_key = asc_api_key
    deliver(
      api_key:           api_key,
      app_identifier:    "com.etzhayyim.deai",
      metadata_path:     "./fastlane/metadata",
      screenshots_path:  "./fastlane/screenshots",
      skip_binary_upload: true,
      skip_screenshots:  false,
      skip_metadata:     false,
      download_screenshots: true,
    )
  end

  desc "Upload screenshots only"
  lane :upload_screenshots do
    api_key = asc_api_key
    upload_to_app_store(
      api_key:           api_key,
      app_identifier:    "com.etzhayyim.deai",
      screenshots_path:  "./fastlane/screenshots",
      skip_binary_upload: true,
      skip_metadata:     true,
      skip_screenshots:  false,
      force:             true,
    )
  end

  desc "Upload metadata only (no binary)"
  lane :upload_metadata do
    api_key = asc_api_key
    upload_to_app_store(
      api_key:           api_key,
      app_identifier:    "com.etzhayyim.deai",
      metadata_path:     "./fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots:  true,
      skip_metadata:     false,
      force:             true,
    )
  end

  desc "Submit the latest uploaded build for App Store review"
  lane :submit_for_review do
    api_key = asc_api_key
    upload_to_app_store(
      api_key:               api_key,
      app_identifier:        "com.etzhayyim.deai",
      skip_binary_upload:    true,
      skip_screenshots:      true,
      skip_metadata:         true,
      submit_for_review:     true,
      automatic_release:     false,
      submission_information: {
        add_id_info_uses_idfa:                   false,
        add_id_info_serves_ads:                  false,
        add_id_info_tracks_action:               false,
        add_id_info_tracks_install:              false,
        add_id_info_limits_tracking:             true,
        export_compliance_uses_encryption:       false,
        export_compliance_is_exempt:             false,
        content_rights_has_rights:               true,
        content_rights_contains_third_party_content: false,
      },
    )
  end

  # ── Full release pipeline ─────────────────────────────────────────────────
  desc "Full pipeline: build → upload binary + metadata + screenshots → submit for review"
  lane :full_release do
    api_key = asc_api_key
    build_app_store

    upload_to_app_store(
      api_key:           api_key,
      app_identifier:    "com.etzhayyim.deai",
      ipa:               "./build/deai.ipa",
      metadata_path:     "./fastlane/metadata",
      screenshots_path:  "./fastlane/screenshots",
      skip_screenshots:  false,
      skip_metadata:     false,
      submit_for_review: true,
      automatic_release: false,
      force:             true,
      submission_information: {
        add_id_info_uses_idfa:                   false,
        add_id_info_serves_ads:                  false,
        add_id_info_tracks_action:               false,
        add_id_info_tracks_install:              false,
        add_id_info_limits_tracking:             true,
        export_compliance_uses_encryption:       false,
        export_compliance_is_exempt:             false,
        content_rights_has_rights:               true,
        content_rights_contains_third_party_content: false,
      },
      precheck_include_in_app_purchases: false,
    )
  end
end
