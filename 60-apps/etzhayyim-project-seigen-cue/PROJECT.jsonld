{
  "@context": {
    "etzhayyim": "https://resources.etzhayyim.com/etzhayyim-project-resources/id/",
    "schema": "https://schema.org/",
    "dodaf": "https://resources.etzhayyim.com/etzhayyim-project-resources/id/DM2/"
  },
  "@type": "etzhayyim:Project",
  "@id": "https://resources.etzhayyim.com/etzhayyim-project-seigen-cue/id/Project/etzhayyim-project-seigen-cue",
  "schema:name": "etzhayyim-project-seigen-cue",
  "schema:description": "Seigen DID actor project. Stores constraint policies as CUE and SQL, and applies them via CLI and MCP with build-failing validation.",
  "dodaf:capability": [
    {
      "@type": "dodaf:Capability",
      "schema:name": "Constraint Validation",
      "schema:description": "Validate Cloudflare Pipelines configuration against hard platform limits and immutability constraints."
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Policy Persistence",
      "schema:description": "Persist CUE policy source and metadata into graph storage via parameterized SQL."
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Multi Interface",
      "schema:description": "Expose the same validation engine from CLI and MCP actor interface."
    }
  ],
  "dodaf:performer": [
    {
      "@type": "dodaf:Performer",
      "schema:name": "seigen-did-actor",
      "schema:description": "DID actor runtime exposing seigen.validate and seigen.policy.exportSql tools"
    }
  ]
}
