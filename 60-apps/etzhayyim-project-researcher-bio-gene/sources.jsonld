{
  "@context": "https://schema.org/",
  "@type": "Dataset",
  "name": "Bio Gene Research Ingest Sources",
  "description": "Primary source design for bio/gene literature, genomic evidence, pathway context, and omics datasets.",
  "distribution": [
    {
      "@type": "DataFeed",
      "identifier": "src:bio-gene:pubmed",
      "name": "PubMed",
      "description": "Primary indexed biomedical literature feed for peer-reviewed gene, disease, assay, and mechanism papers.",
      "contentUrl": "https://pubmed.ncbi.nlm.nih.gov/",
      "keywords": [
        "literature",
        "peer-reviewed",
        "biomedical"
      ],
      "variableMeasured": [
        "gene mention",
        "variant mention",
        "disease association",
        "assay evidence"
      ],
      "temporalCoverage": "daily"
    },
    {
      "@type": "DataFeed",
      "identifier": "src:bio-gene:biorxiv",
      "name": "bioRxiv",
      "description": "Preprint source for fast-moving molecular biology, genomics, and systems biology updates.",
      "contentUrl": "https://www.biorxiv.org/",
      "keywords": [
        "preprint",
        "genomics",
        "molecular-biology"
      ],
      "temporalCoverage": "daily"
    },
    {
      "@type": "DataFeed",
      "identifier": "src:bio-gene:medrxiv",
      "name": "medRxiv",
      "description": "Preprint source for translational and clinically adjacent genomics findings.",
      "contentUrl": "https://www.medrxiv.org/",
      "keywords": [
        "preprint",
        "clinical-genomics",
        "translational"
      ],
      "temporalCoverage": "daily"
    },
    {
      "@type": "Dataset",
      "identifier": "src:bio-gene:clinvar",
      "name": "ClinVar",
      "description": "Variant interpretation assertions and supporting metadata for clinical and translational genomics use cases.",
      "contentUrl": "https://www.ncbi.nlm.nih.gov/clinvar/",
      "keywords": [
        "variant",
        "clinical-significance",
        "assertion"
      ],
      "temporalCoverage": "weekly"
    },
    {
      "@type": "Dataset",
      "identifier": "src:bio-gene:dbsnp",
      "name": "dbSNP",
      "description": "Reference catalog for known short genetic variation identifiers and normalization.",
      "contentUrl": "https://www.ncbi.nlm.nih.gov/snp/",
      "keywords": [
        "rsid",
        "variant-normalization",
        "reference"
      ],
      "temporalCoverage": "monthly"
    },
    {
      "@type": "Dataset",
      "identifier": "src:bio-gene:gnomad",
      "name": "gnomAD",
      "description": "Population allele frequency reference used to contextualize rarity and cohort prevalence of candidate variants.",
      "contentUrl": "https://gnomad.broadinstitute.org/",
      "keywords": [
        "population-frequency",
        "rare-variant",
        "cohort-reference"
      ],
      "temporalCoverage": "release-based"
    },
    {
      "@type": "Dataset",
      "identifier": "src:bio-gene:omim",
      "name": "OMIM",
      "description": "Curated gene-disease and phenotype relationships for Mendelian and inherited disease interpretation.",
      "contentUrl": "https://omim.org/",
      "keywords": [
        "gene-disease",
        "phenotype",
        "mendelian"
      ],
      "temporalCoverage": "release-based"
    },
    {
      "@type": "Dataset",
      "identifier": "src:bio-gene:uniprot",
      "name": "UniProt",
      "description": "Protein-level functional reference including sequence, domains, and curated biological annotations.",
      "contentUrl": "https://www.uniprot.org/",
      "keywords": [
        "protein",
        "function",
        "annotation"
      ],
      "temporalCoverage": "release-based"
    },
    {
      "@type": "Dataset",
      "identifier": "src:bio-gene:kegg",
      "name": "KEGG",
      "description": "Pathway and molecular interaction context for mechanism interpretation and biomarker framing.",
      "contentUrl": "https://www.genome.jp/kegg/",
      "keywords": [
        "pathway",
        "mechanism",
        "network"
      ],
      "temporalCoverage": "release-based"
    },
    {
      "@type": "Dataset",
      "identifier": "src:bio-gene:reactome",
      "name": "Reactome",
      "description": "Curated pathway and reaction knowledge for cross-modal interpretation and enrichment analysis.",
      "contentUrl": "https://reactome.org/",
      "keywords": [
        "pathway",
        "reaction",
        "enrichment"
      ],
      "temporalCoverage": "release-based"
    },
    {
      "@type": "Dataset",
      "identifier": "src:bio-gene:geo",
      "name": "NCBI GEO",
      "description": "Expression and functional genomics repository for cohort re-analysis and validation signal discovery.",
      "contentUrl": "https://www.ncbi.nlm.nih.gov/geo/",
      "keywords": [
        "expression",
        "functional-genomics",
        "cohort"
      ],
      "temporalCoverage": "daily"
    },
    {
      "@type": "Dataset",
      "identifier": "src:bio-gene:ena",
      "name": "European Nucleotide Archive",
      "description": "Archive for raw sequencing and assembled nucleotide data used for secondary analysis and reprocessing workflows.",
      "contentUrl": "https://www.ebi.ac.uk/ena/browser/home",
      "keywords": [
        "raw-sequencing",
        "archive",
        "reprocessing"
      ],
      "temporalCoverage": "daily"
    },
    {
      "@type": "Dataset",
      "identifier": "src:bio-gene:arrayexpress",
      "name": "ArrayExpress",
      "description": "Functional genomics archive useful for expression and assay-oriented validation datasets.",
      "contentUrl": "https://www.ebi.ac.uk/biostudies/arrayexpress",
      "keywords": [
        "expression",
        "microarray",
        "functional-genomics"
      ],
      "temporalCoverage": "release-based"
    },
    {
      "@type": "Dataset",
      "identifier": "src:bio-gene:single-cell-portal",
      "name": "Single Cell Portal",
      "description": "Single-cell datasets for cell-state specific biomarker and mechanism interpretation.",
      "contentUrl": "https://singlecell.broadinstitute.org/single_cell",
      "keywords": [
        "single-cell",
        "cell-state",
        "atlas"
      ],
      "temporalCoverage": "release-based"
    }
  ],
  "measurementTechnique": [
    "scheduled metadata pulls",
    "identifier normalization",
    "claim extraction",
    "dataset delta detection",
    "provenance stamping"
  ]
}
