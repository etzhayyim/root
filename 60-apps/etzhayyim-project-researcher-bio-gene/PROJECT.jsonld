  "@type": "dodaf:Project",
  "@id": "etzhayyim:project/etzhayyim-project-researcher-bio-gene",
  "schema:name": "etzhayyim-project-researcher-bio-gene",
  "schema:description": "Bio/gene research operator for genomic literature intelligence, variant interpretation, multi-omics synthesis, assay planning, translational research decision support, and provenance-safe evidence delivery.",
  "etzhayyim:domains": [
    "bio-gene.etzhayyim.com",
    "genomics.etzhayyim.com",
    "variant.etzhayyim.com",
    "omics.etzhayyim.com"
  ],
  "etzhayyim:nanoid": "b10g3n3r",
  "hasPart": [
