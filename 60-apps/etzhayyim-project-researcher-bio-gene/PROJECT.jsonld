    }
  ],
  "dodaf:capability": [
    {
      "@type": "dodaf:Capability",
      "@id": "etzhayyim:capability/bio-gene-literature-intelligence",
      "schema:name": "Genomic Literature Intelligence",
      "schema:description": "Continuously ingest and normalize papers, preprints, databases, and protocol updates related to genes, variants, pathways, phenotypes, and disease mechanisms."
    },
    {
      "@type": "dodaf:Capability",
      "@id": "etzhayyim:capability/bio-gene-variant-interpretation",
      "schema:name": "Variant Interpretation",
      "schema:description": "Aggregate evidence for SNV, indel, CNV, fusion, and structural variant interpretation with explicit evidence provenance and confidence scoring."
    },
    {
      "@type": "dodaf:Capability",
      "@id": "etzhayyim:capability/bio-gene-multiomics-synthesis",
      "schema:name": "Multi-Omics Synthesis",
      "schema:description": "Link genomics, transcriptomics, proteomics, epigenomics, and phenotype data into cross-modal research hypotheses and biomarker candidates."
    },
    {
      "@type": "dodaf:Capability",
      "@id": "etzhayyim:capability/bio-gene-assay-planning",
      "schema:name": "Assay and Validation Planning",
      "schema:description": "Translate research questions into candidate assays, controls, validation checkpoints, and downstream analysis plans for wet-lab collaboration."
    },
    {
      "@type": "dodaf:Capability",
      "@id": "etzhayyim:capability/bio-gene-governance",
      "schema:name": "Research Governance and Reproducibility",
      "schema:description": "Maintain provenance, dataset lineage, biosafety boundaries, PHI handling rules, and reproducible evidence packets for every conclusion."
    }
  ],
  "dodaf:performer": [
    {
      "@type": "dodaf:Performer",
      "@id": "etzhayyim:performer/bio-gene-orchestrator",
      "schema:name": "bio-gene-orchestrator",
      "schema:description": "Top-level research planner that routes questions across variant, omics, literature, assay, and compliance actors and emits research briefs."
    },
    {
      "@type": "dodaf:Performer",
      "@id": "etzhayyim:performer/bio-gene-mcp-component",
      "schema:name": "bio-gene-mcp-component",
      "schema:description": "Research-facing MCP facade exposing gene dossier, variant brief, biomarker memo, and experiment planning tools."
    }
  ],
  "dodaf:activity": [
    {
      "@type": "dodaf:Activity",
      "schema:name": "Collect Evidence",
      "schema:description": "Ingest papers, datasets, and knowledge base deltas for target genes, diseases, variants, and assays."
    },
    {
      "@type": "dodaf:Activity",
      "schema:name": "Interpret Signal",
      "schema:description": "Rank evidence, resolve conflicts, map mechanisms, and score candidate findings by novelty, reproducibility, and translational value."
    },
    {
      "@type": "dodaf:Activity",
      "schema:name": "Plan Validation",
      "schema:description": "Convert prioritized findings into candidate assay designs, cohort plans, QC gates, and expected decision criteria."
    },
    {
      "@type": "dodaf:Activity",
      "schema:name": "Publish Research Packet",
      "schema:description": "Emit a provenance-rich packet with gene/variant summary, evidence table, recommended next experiments, and compliance notes."
    }
  ]
}
