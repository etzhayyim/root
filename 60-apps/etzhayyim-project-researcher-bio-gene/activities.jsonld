{
  "@context": "https://schema.org/",
  "@type": "CreativeWork",
  "name": "Bio Gene Research Activities",
  "description": "Primary execution flows for the bio/gene research operator.",
  "activities": [
    {
      "@type": "Action",
      "identifier": "act:bio-gene:source-ingest",
      "name": "Source Ingest and Normalization",
      "description": "Pull updates from literature, variant databases, pathway references, and omics repositories; normalize identifiers and provenance.",
      "performer": "Literature Scout Actor"
    },
    {
      "@type": "Action",
      "identifier": "act:bio-gene:variant-evidence-curation",
      "name": "Variant Evidence Curation",
      "description": "Aggregate and score evidence for target variants, including supportive and conflicting assertions.",
      "performer": "Variant Curator Actor"
    },
    {
      "@type": "Action",
      "identifier": "act:bio-gene:multiomics-fusion",
      "name": "Multi-Omics Fusion",
      "description": "Fuse genomics, expression, protein, epigenetic, and phenotype signals into mechanism and biomarker hypotheses.",
      "performer": "Multi-Omics Integrator Actor"
    },
    {
      "@type": "Action",
      "identifier": "act:bio-gene:cohort-design",
      "name": "Cohort and Stratification Design",
      "description": "Define cohort slices, subgroup logic, and validation-ready patient or sample partitions.",
      "performer": "Cohort Strategist Actor"
    },
    {
      "@type": "Action",
      "identifier": "act:bio-gene:assay-planning",
      "name": "Assay Planning and Wet-Lab Handoff",
      "description": "Prepare assay options, controls, QC thresholds, and experimental success criteria for validation studies.",
      "performer": "Assay Architect Actor"
    },
    {
      "@type": "Action",
      "identifier": "act:bio-gene:governance-review",
      "name": "Governance and Release Review",
      "description": "Run consent, PHI, biosafety, provenance, and reproducibility checks before research packets are released.",
      "performer": "Governance Guardian Actor"
    },
    {
      "@type": "Action",
      "identifier": "act:bio-gene:research-brief-publication",
      "name": "Research Brief Publication",
      "description": "Publish gene dossiers, variant briefs, biomarker memos, and experiment proposals for downstream researchers or agents.",
      "performer": "Research Briefing Actor"
    }
  ]
}
