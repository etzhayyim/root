{
  "@context": {
    "schema": "https://schema.org/",
    "etzhayyim": "https://etzhayyim.com/ontology/"
  },
  "@type": "DefinedTermSet",
  "name": "Bio Gene Research Domains",
  "description": "Domain partitioning for bio/gene-focused research workflows.",
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "@id": "etzhayyim:domain/bio-gene-literature-intelligence",
      "identifier": "domain:bio-gene:literature-intelligence",
      "name": "Literature Intelligence",
      "description": "Paper/preprint surveillance, knowledge extraction, ontology normalization, and evidence freshness tracking for genes, variants, pathways, and diseases."
    },
    {
      "@type": "DefinedTerm",
      "@id": "etzhayyim:domain/bio-gene-sequencing-and-qc",
      "identifier": "domain:bio-gene:sequencing-and-qc",
      "name": "Sequencing and QC",
      "description": "Sample metadata review, sequencing modality selection, QC threshold design, contamination checks, and pipeline readiness for raw omics inputs."
    },
    {
      "@type": "DefinedTerm",
      "@id": "etzhayyim:domain/bio-gene-variant-interpretation",
      "identifier": "domain:bio-gene:variant-interpretation",
      "name": "Variant Interpretation",
      "description": "Clinical/research interpretation of SNV, indel, CNV, SV, fusion, haplotype, and regulatory variants using functional, population, and disease evidence."
    },
    {
      "@type": "DefinedTerm",
      "@id": "etzhayyim:domain/bio-gene-multiomics-integration",
      "identifier": "domain:bio-gene:multiomics-integration",
      "name": "Multi-Omics Integration",
      "description": "Cross-modal synthesis across DNA, RNA, protein, methylation, chromatin, metabolite, and phenotype data for mechanism discovery."
    },
    {
      "@type": "DefinedTerm",
      "@id": "etzhayyim:domain/bio-gene-biomarker-discovery",
      "identifier": "domain:bio-gene:biomarker-discovery",
      "name": "Biomarker Discovery",
      "description": "Prioritization of diagnostic, prognostic, predictive, and pharmacogenomic biomarker candidates and their evidence packages."
    },
    {
      "@type": "DefinedTerm",
      "@id": "etzhayyim:domain/bio-gene-assay-design",
      "identifier": "domain:bio-gene:assay-design",
      "name": "Assay Design and Validation",
      "description": "Primer/probe panel strategy, CRISPR perturbation planning, validation controls, replication design, and wet-lab handoff packets."
    },
    {
      "@type": "DefinedTerm",
      "@id": "etzhayyim:domain/bio-gene-translational-research",
      "identifier": "domain:bio-gene:translational-research",
      "name": "Translational and Clinical Genomics",
      "description": "Mapping research findings to disease models, patient stratification logic, therapeutic hypotheses, and report-ready conclusions."
    },
    {
      "@type": "DefinedTerm",
      "@id": "etzhayyim:domain/bio-gene-governance",
      "identifier": "domain:bio-gene:governance",
      "name": "Data Governance and Bioethics",
      "description": "Consent boundary checks, PHI-safe handling, provenance tracking, biosafety review, reproducibility controls, and release policy enforcement."
    }
  ]
}
