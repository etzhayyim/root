{
  "@context": {
    "schema": "https://schema.org/",
    "etzhayyim": "https://etzhayyim.com/ontology/"
  },
  "@type": "ItemList",
  "name": "Bio Gene Research Actors",
  "description": "Specialized actors for bio/gene research execution.",
  "itemListElement": [
    {
      "@type": "Service",
      "@id": "etzhayyim:actor/bio-gene-literature-scout",
      "identifier": "actor:bio-gene:literature-scout",
      "name": "Literature Scout Actor",
      "description": "Monitors PubMed, bioRxiv, medRxiv, benchmark datasets, and curated databases; normalizes genes, variants, diseases, pathways, and assay terms.",
      "areaServed": [
        "Literature Intelligence"
      ],
      "knowsAbout": [
        "gene synonym resolution",
        "paper triage",
        "database diffing",
        "evidence freshness"
      ]
    },
    {
      "@type": "Service",
      "@id": "etzhayyim:actor/bio-gene-variant-curator",
      "identifier": "actor:bio-gene:variant-curator",
      "name": "Variant Curator Actor",
      "description": "Builds explicit evidence ledgers for variants, including population frequency, computational impact, segregation, functional assay, and disease association support.",
      "areaServed": [
        "Variant Interpretation",
        "Translational and Clinical Genomics"
      ],
      "knowsAbout": [
        "ACMG-like evidence logic",
        "functional evidence",
        "conflict resolution",
        "pathogenicity confidence"
      ]
    },
    {
      "@type": "Service",
      "@id": "etzhayyim:actor/bio-gene-multiomics-integrator",
      "identifier": "actor:bio-gene:multiomics-integrator",
      "name": "Multi-Omics Integrator Actor",
      "description": "Combines DNA, RNA, protein, methylation, chromatin, and phenotype signals into coherent mechanism and biomarker hypotheses.",
      "areaServed": [
        "Multi-Omics Integration",
        "Biomarker Discovery"
      ],
      "knowsAbout": [
        "cohort stratification",
        "feature convergence",
        "pathway enrichment",
        "cross-modal ranking"
      ]
    },
    {
      "@type": "Service",
      "@id": "etzhayyim:actor/bio-gene-assay-architect",
      "identifier": "actor:bio-gene:assay-architect",
      "name": "Assay Architect Actor",
      "description": "Translates prioritized findings into feasible wet-lab validation strategies, including assay modality choice, controls, replication, and success criteria.",
      "areaServed": [
        "Assay Design and Validation",
        "Sequencing and QC"
      ],
      "knowsAbout": [
        "PCR/panel design",
        "single-cell follow-up",
        "CRISPR validation",
        "wet-lab handoff"
      ]
    },
    {
      "@type": "Service",
      "@id": "etzhayyim:actor/bio-gene-cohort-strategist",
      "identifier": "actor:bio-gene:cohort-strategist",
      "name": "Cohort Strategist Actor",
      "description": "Designs inclusion/exclusion logic, phenotype slices, case-control balances, and subgroup definitions for discovery and validation studies.",
      "areaServed": [
        "Translational and Clinical Genomics",
        "Biomarker Discovery"
      ],
      "knowsAbout": [
        "phenotype modeling",
        "stratification bias",
        "sample power heuristics",
        "clinical utility framing"
      ]
    },
    {
      "@type": "Service",
      "@id": "etzhayyim:actor/bio-gene-knowledge-graph-curator",
      "identifier": "actor:bio-gene:knowledge-graph-curator",
      "name": "Knowledge Graph Curator Actor",
      "description": "Maintains a graph linking gene, transcript, protein, variant, pathway, phenotype, disease, drug, and assay entities with provenance-preserving edges.",
      "areaServed": [
        "Literature Intelligence",
        "Multi-Omics Integration",
        "Data Governance and Bioethics"
      ],
      "knowsAbout": [
        "entity resolution",
        "provenance edges",
        "ontology mapping",
        "versioned evidence graph"
      ]
    },
    {
      "@type": "Service",
      "@id": "etzhayyim:actor/bio-gene-governance-guardian",
      "identifier": "actor:bio-gene:governance-guardian",
      "name": "Governance Guardian Actor",
      "description": "Checks consent scope, de-identification boundaries, reproducibility requirements, biosafety concerns, and release constraints before outputs are shared.",
      "areaServed": [
        "Data Governance and Bioethics"
      ],
      "knowsAbout": [
        "PHI handling",
        "biosafety review",
        "auditability",
        "evidence packet release control"
      ]
    },
    {
      "@type": "Service",
      "@id": "etzhayyim:actor/bio-gene-research-briefing",
      "identifier": "actor:bio-gene:research-briefing",
      "name": "Research Briefing Actor",
      "description": "Produces final researcher-facing outputs: gene dossiers, variant briefs, biomarker memos, experiment proposals, and decision-ready evidence summaries.",
      "areaServed": [
        "Literature Intelligence",
        "Variant Interpretation",
        "Multi-Omics Integration",
        "Assay Design and Validation",
        "Translational and Clinical Genomics"
      ],
      "knowsAbout": [
        "evidence summarization",
        "uncertainty communication",
        "next-step recommendation",
        "executive scientific briefing"
      ]
    }
  ]
}
