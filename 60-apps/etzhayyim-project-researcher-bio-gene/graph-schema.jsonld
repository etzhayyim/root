{
  "@context": {
    "schema": "https://schema.org/",
    "etzhayyim": "https://etzhayyim.com/ontology/",
    "sh": "http://www.w3.org/ns/shacl#"
  },
  "@type": "CreativeWork",
  "name": "Bio Gene Research Graph Schema",
  "description": "Logical node and edge schema for persisted bio-gene research packets and derived evidence.",
  "hasPart": [
    {
      "@type": "DefinedTerm",
      "identifier": "node:research-packet",
      "name": "ResearchPacket",
      "description": "Top-level packet containing normalized inputs and derived literature, variant, omics, assay, and governance sections."
    },
    {
      "@type": "DefinedTerm",
      "identifier": "node:variant-brief",
      "name": "VariantBrief",
      "description": "Evidence-ledger-backed variant summary with recommendation and confidence."
    },
    {
      "@type": "DefinedTerm",
      "identifier": "node:biomarker-ranking",
      "name": "BiomarkerRanking",
      "description": "Ranked biomarker candidates for a disease/cohort slice."
    },
    {
      "@type": "DefinedTerm",
      "identifier": "node:validation-packet",
      "name": "ValidationPacket",
      "description": "Wet-lab handoff packet containing assay modality and QC gates."
    },
    {
      "@type": "DefinedTerm",
      "identifier": "node:governance-review",
      "name": "GovernanceReview",
      "description": "Policy review result for release scope, provenance completeness, and biosafety constraints."
    }
  ]
}
