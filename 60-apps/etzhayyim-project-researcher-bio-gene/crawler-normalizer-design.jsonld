{
  "@context": "https://schema.org/",
  "@type": "CreativeWork",
  "name": "Bio Gene Crawler and Normalizer Design",
  "description": "Execution design for source crawling, normalization, evidence extraction, and routing into bio-gene research components.",
  "softwareRequirements": [
    "Deterministic source polling",
    "Gene and variant identifier normalization",
    "Provenance-preserving evidence rows",
    "Conflict-aware evidence merge",
    "PHI-safe release shaping"
  ],
  "about": [
    {
      "@type": "HowTo",
      "name": "Crawler pipeline",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schedule pull",
          "text": "Poll literature feeds daily, curated databases weekly or release-based, and queue source delta jobs keyed by source identifier and watermark."
        },
        {
          "@type": "HowToStep",
          "name": "Raw capture",
          "text": "Persist raw source payloads and metadata snapshots before transformation so evidence rows can be re-derived."
        },
        {
          "@type": "HowToStep",
          "name": "Normalize identifiers",
          "text": "Map genes, transcripts, proteins, diseases, pathways, and variants into canonical IDs and preserve source-native IDs as aliases."
        },
        {
          "@type": "HowToStep",
          "name": "Extract claims",
          "text": "Produce structured evidence rows for gene-disease, variant-effect, pathway-mechanism, assay-result, and biomarker-cohort claims."
        },
        {
          "@type": "HowToStep",
          "name": "Route evidence",
          "text": "Send claim rows to literature, variant, or omics workers; send policy-sensitive rows through governance checks before publication."
        }
      ]
    }
  ],
  "abstract": [
    {
      "@type": "DefinedTerm",
      "identifier": "norm:gene",
      "name": "Gene normalization",
      "description": "Resolve HGNC-style symbols, aliases, previous symbols, and source-local names into one canonical entity."
    },
    {
      "@type": "DefinedTerm",
      "identifier": "norm:variant",
      "name": "Variant normalization",
      "description": "Map rsIDs, HGVS strings, genomic coordinates, and source-specific identifiers into a canonical variant key."
    },
    {
      "@type": "DefinedTerm",
      "identifier": "norm:disease",
      "name": "Disease normalization",
      "description": "Map disease and phenotype labels into normalized disease entities while keeping source wording for quote-safe provenance."
    }
  ],
  "citation": [
    "sources.jsonld",
    "domains.jsonld",
    "actors.jsonld",
    "components.jsonld"
  ]
}
