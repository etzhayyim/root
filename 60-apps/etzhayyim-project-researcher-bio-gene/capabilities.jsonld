{
  "@context": "https://schema.org/",
  "@type": "DefinedTermSet",
  "name": "Bio Gene Research Capabilities",
  "description": "Operational capabilities delivered by the bio/gene research project.",
  "terms": [
    {
      "@type": "DefinedTerm",
      "identifier": "cap:bio-gene:gene-dossier-generation",
      "name": "Gene Dossier Generation",
      "description": "Generate provenance-rich gene dossiers that summarize function, pathways, disease links, key variants, and evidence freshness."
    },
    {
      "@type": "DefinedTerm",
      "identifier": "cap:bio-gene:variant-briefing",
      "name": "Variant Briefing",
      "description": "Produce conflict-aware variant briefs covering evidence categories, confidence, open questions, and recommended validation paths."
    },
    {
      "@type": "DefinedTerm",
      "identifier": "cap:bio-gene:biomarker-prioritization",
      "name": "Biomarker Prioritization",
      "description": "Rank candidate biomarkers from multi-omics and phenotype signals with cohort context and translational rationale."
    },
    {
      "@type": "DefinedTerm",
      "identifier": "cap:bio-gene:experiment-planning",
      "name": "Experiment Planning",
      "description": "Draft assay plans, controls, replication logic, and QC thresholds for follow-up wet-lab or translational studies."
    },
    {
      "@type": "DefinedTerm",
      "identifier": "cap:bio-gene:evidence-governance",
      "name": "Evidence Governance",
      "description": "Enforce provenance completeness, PHI-safe handling, biosafety review gates, and reproducibility standards across all outputs."
    },
    {
      "@type": "DefinedTerm",
      "identifier": "cap:bio-gene:source-monitoring",
      "name": "Source Monitoring and Delta Tracking",
      "description": "Track updates from literature, reference databases, pathway resources, and omics repositories and trigger targeted refresh workflows."
    }
  ]
}
