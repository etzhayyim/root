{
  "@context": {
    "schema": "https://schema.org/",
    "etzhayyim": "https://etzhayyim.com/ontology/"
  },
  "@type": "ItemList",
  "name": "Bio Gene Research Components",
  "description": "WASM/component decomposition for the actor set.",
  "itemListElement": [
    {
      "@type": "SoftwareApplication",
      "@id": "etzhayyim:component/bio-gene-mcp-gateway",
      "identifier": "component:bio-gene:mcp-gateway",
      "name": "bio-gene-mcp-gateway",
      "applicationCategory": "mcp",
      "description": "External entrypoint that exposes search-gene, brief-variant, compare-biomarkers, and plan-validation-study tools to researchers and upstream agents.",
      "etzhayyim:realizesActors": [
        "Research Briefing Actor"
      ]
    },
    {
      "@type": "SoftwareApplication",
      "@id": "etzhayyim:component/bio-gene-literature-worker",
      "identifier": "component:bio-gene:literature-worker",
      "name": "bio-gene-literature-worker",
      "applicationCategory": "wasm-worker",
      "description": "Fetches and normalizes literature and curated knowledge sources; emits claim tables and evidence deltas.",
      "etzhayyim:realizesActors": [
        "Literature Scout Actor",
        "Knowledge Graph Curator Actor"
      ]
    },
    {
      "@type": "SoftwareApplication",
      "@id": "etzhayyim:component/bio-gene-variant-worker",
      "identifier": "component:bio-gene:variant-worker",
      "name": "bio-gene-variant-worker",
      "applicationCategory": "wasm-worker",
      "description": "Runs variant evidence aggregation, conflict detection, and dossier generation over normalized evidence records.",
      "etzhayyim:realizesActors": [
        "Variant Curator Actor"
      ]
    },
    {
      "@type": "SoftwareApplication",
      "@id": "etzhayyim:component/bio-gene-omics-worker",
      "identifier": "component:bio-gene:omics-worker",
      "name": "bio-gene-omics-worker",
      "applicationCategory": "wasm-worker",
      "description": "Integrates omics matrices, pathway results, and phenotype cohorts into ranked biomarker and mechanism hypotheses.",
      "etzhayyim:realizesActors": [
        "Multi-Omics Integrator Actor",
        "Cohort Strategist Actor"
      ]
    },
    {
      "@type": "SoftwareApplication",
      "@id": "etzhayyim:component/bio-gene-assay-planner",
      "identifier": "component:bio-gene:assay-planner",
      "name": "bio-gene-assay-planner",
      "applicationCategory": "wasm-worker",
      "description": "Converts prioritized findings into assay modalities, controls, replication plans, and wet-lab handoff packets.",
      "etzhayyim:realizesActors": [
        "Assay Architect Actor"
      ]
    },
    {
      "@type": "SoftwareApplication",
      "@id": "etzhayyim:component/bio-gene-governance-policy",
      "identifier": "component:bio-gene:governance-policy",
      "name": "bio-gene-governance-policy",
      "applicationCategory": "policy-engine",
      "description": "Policy and provenance gate for consent checks, PHI-safe output shaping, reproducibility stamps, and release approvals.",
      "etzhayyim:realizesActors": [
        "Governance Guardian Actor"
      ]
    },
    {
      "@type": "SoftwareApplication",
      "@id": "etzhayyim:component/bio-gene-evidence-store",
      "identifier": "component:bio-gene:evidence-store",
      "name": "bio-gene-evidence-store",
      "applicationCategory": "data-service",
      "description": "Versioned store for evidence rows, claim tables, graph edges, dataset provenance, and research packet snapshots.",
      "etzhayyim:realizesActors": [
        "Knowledge Graph Curator Actor",
        "Research Briefing Actor"
      ]
    }
  ]
}
