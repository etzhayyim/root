/// Standalone compute world for jco transpile validation.
/// Pattern C: WIT Component Model (P2) + Rust + cargo-component + jco → JS.
///
/// No kotodama imports — self-contained pure-compute component.
/// Transpile: jco transpile shannon-jco.wasm --instantiation async → ESM JS
/// CF Workers: CompiledWasm rule bundles shannon-jco.core.wasm as WebAssembly.Module.
///
/// NSID: com.etzhayyim.apps.hoge.witShannonJco
package etzhayyim:hoge-compute@1.0.0;

world compute-world {
    export compute;
}

interface compute {
    /// Compute Shannon entropy of input text.
    /// params: raw text string
    /// returns: JSON {"score": f64, "len": usize, "pattern": "jco"}
    shannon-score: func(params: string) -> result<string, string>;
}
