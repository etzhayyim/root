{
  "targets": {
    "release": {
      "outFile": "build/plugin.wasm",
      "optimizeLevel": 3,
      "shrinkLevel": 0,
      "noAssert": true,
      "initialMemory": 4,
      "maximumMemory": 32768,
      "use": "abort=assembly/index/myAbort"
    },
    "debug": {
      "outFile": "build/plugin-debug.wasm",
      "debug": true,
      "use": "abort=assembly/index/myAbort"
    }
  }
}
