        "performers/etzhayyim-performer-org-etzhayyim-sys-svc-hrse-6c3f9e2d/migrations/20251206220003_create_resources.sql",
        "performers/etzhayyim-performer-org-etzhayyim-sys-svc-hrse-6c3f9e2d/migrations/20251206220004_create_performers.sql",
