        "performers/etzhayyim-performer-org-etzhayyim-sys-app-hrse-pba7d22f/scripts/create-full-schema.sql",
        "performers/etzhayyim-performer-org-etzhayyim-sys-svc-hrse-6c3f9e2d/schema.graphql",
        "performers/etzhayyim-performer-org-etzhayyim-sys-svc-hrse-6c3f9e2d/src/schema/types_async/master_data.rs",
