# kotoba-datomic-projection manifest — external-hrse migration / seed scripts
#
# Per ADR-2605231500. The scripts in this directory are one-shot
# operational migration / seed / verification tools that read or write
# directly to the legacy external-hrse Postgres instance. They are NOT
# production runtime code paths — they exist to bridge legacy data into
# the substrate seam during cutover and are removed when the cutover
# completes per the migration plan referenced below.
#
# This manifest exempts the substrate-boundary storage rule for direct
# `from "postgres"` imports in this directory. The exemption is
# conditional on the migration plan below remaining executable.

[projection]
name = "external-hrse-migration-scripts"
level = "L0-operator-script"
rebuild_runbook = "../README.md"
adr = "2605231500"
kotoba-datomic_companion_adr = "2605172000"
owner = "external-hrse maintainers"
last_reviewed = "2026-05-23"

# These scripts target the legacy external-hrse Postgres directly.
# After cutover to MST PDS write path (ETZHAYYIM_SUBSTRATE_MODE=mst),
# the scripts in this directory are deleted as a single commit.
source_collections = [
  "com.etzhayyim.hrse.legacy-postgres",
]

projection_tables = [
  "freelancers",
  "proposals",
  "jobSeekers",
  "applications",
]

storage_substrates = [
  { kind = "postgres", note = "legacy external-hrse instance — operator-only migration scope" },
]

rebuild_estimated_minutes = 30
rebuild_estimated_minutes_note = "one-shot cutover; not part of steady-state operations"

[[non_determinism]]
field = "*"
reason = "scripts are one-shot — re-running after cutover is a no-op or error by design"

[promotion_to_l1]
required = [
  "Scripts deleted after ETZHAYYIM_SUBSTRATE_MODE=mst cutover ratified by Council",
]
target_quarter = "post-cutover (no promotion path — directory disappears)"
