{
  "name": "etzhayyim-performer-org-etzhayyim-sys-app-hrse-pba7d22f",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prebuild": "pnpm check:env && pnpm db:migrate && pnpm seed:master-data",
    "check:env": "tsx scripts/check-env.ts",
    "db:migrate": "bash scripts/run-atlas-migrations.sh",
    "db:migrate:legacy": "tsx scripts/run-migrations.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "codegen:proto": "buf generate",
    "codegen:proto:lint": "buf lint",
    "seed:master-data": "tsx scripts/seed-master-data.ts",
    "seed:production": "bash scripts/run-seed-production.sh",
    "seed:check": "bash scripts/check-seed-status.sh",
    "seed:verify": "tsx scripts/verify-seed-data.ts",
    "migrate:data": "tsx scripts/migrate-data.ts",
    "atlas:migrate:diff": "atlas migrate diff --env local",
    "atlas:migrate:apply": "atlas migrate apply --env local",
    "atlas:schema:apply": "atlas schema apply --env local",
    "sqlc:generate": "sqlc generate",
    "verify:build": "bash scripts/verify-vercel-build.sh",
    "test:build": "bash scripts/test-vercel-build.sh",
    "generate:atdd": "tsx scripts/generate-atdd-from-capabilities.ts",
    "generate:bdd": "tsx scripts/generate-bdd-from-capabilities.ts",
    "check:bdd-coverage": "tsx scripts/check-capability-bdd-coverage.ts",
    "test": "NODE_OPTIONS='--max-old-space-size=2048 --expose-gc' vitest",
    "test:ui": "NODE_OPTIONS='--max-old-space-size=2048 --expose-gc' vitest --ui",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=2048 --expose-gc' vitest --coverage",
    "test:coverage:report": "vitest --coverage --reporter=json --reporter=html",
    "test:bdd:vitest:coverage": "VITEST_COVERAGE_THRESHOLD=0 NODE_OPTIONS='--max-old-space-size=2048 --expose-gc' vitest --coverage --run src/lib/services/__tests__",
    "test:bdd": "NODE_OPTIONS='--import tsx/esm' cucumber-js --require-module tsx/esm --require 'features/**/*.ts' --format json:reports/cucumber-report.json --format @cucumber/pretty-formatter",
    "test:bdd:coverage": "NODE_OPTIONS='--import tsx/esm' NODE_V8_COVERAGE=.nyc_output c8 --all cucumber-js --require-module tsx/esm --require 'features/**/*.ts' --format json:reports/cucumber-report.json --format @cucumber/pretty-formatter",
    "test:bdd:frontend": "NODE_OPTIONS='--import tsx/esm' cucumber-js --require-module tsx/esm --require 'features/**/*.ts' --format json:reports/cucumber-report.json --format @cucumber/pretty-formatter --tags '@frontend' --timeout 60000",
    "test:bdd:frontend:coverage": "NODE_OPTIONS='--import tsx/esm' c8 cucumber-js --require-module tsx/esm --require 'features/**/*.ts' --format json:reports/cucumber-report.json --format @cucumber/pretty-formatter --tags '@frontend' --timeout 60000",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:tdd": "playwright test e2e/capabilities",
    "test:e2e:bdd": "NODE_OPTIONS='--import tsx/esm' cucumber-js --config cucumber-e2e.config.ts --require-module tsx/esm",
    "test:e2e:bdd:coverage": "NODE_OPTIONS='--import tsx/esm' c8 cucumber-js --config cucumber-e2e.config.ts --require-module tsx/esm",
    "test:e2e:bdd:headed": "HEADLESS=false NODE_OPTIONS='--import tsx/esm' cucumber-js --config cucumber-e2e.config.ts --require-module tsx/esm",
    "generate:e2e": "tsx scripts/generate-e2e-from-capabilities.ts",
    "test:e2e:all": "pnpm test:e2e && pnpm test:e2e:bdd",
    "test:bdd:coverage:report": "c8 report",
    "test:bdd:coverage:all": "pnpm test:bdd:coverage && pnpm test:e2e:bdd:coverage && pnpm test:bdd:coverage:report && pnpm check:bdd-coverage",
    "test:bdd:integration:setup": "bash scripts/setup-bdd-integration.sh",
    "test:bdd:integration": "pnpm test:bdd:integration:setup && pnpm test:bdd:coverage",
    "generate:go:tdd": "tsx scripts/generate-go-tdd-from-capabilities.ts",
    "generate:go:bdd": "tsx scripts/generate-go-bdd-from-capabilities.ts",
    "test:go": "go test ./pkg/service/... -v",
    "test:go:coverage": "go test ./pkg/service/... -coverprofile=coverage.out && go tool cover -html=coverage.out",
    "test:go:bdd": "cd features/go && godog"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
