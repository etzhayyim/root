{
  "name": "magatama-sb4n0j1c",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_ACTOR_HANDLE": "saiban",
    "APP_CAPABILITIES": "[\"court-registry\",\"judge-registry\",\"jiken-management\",\"trial-events\",\"jurisdiction-mapping\"]",
    "APP_DESCRIPTION": "Judicial intelligence — 33 court-level DIDs (JP 8 + USA 5 + UK 6 + DE 8 + FR 6), judge profiles, jiken (case) DID management (11 types), trial event tracking (7 types), jurisdiction mapping. Bridges lawfirm.gftd.ai and hanrei.gftd.ai.",
    "APP_DISPLAY_NAME": "裁判 Intelligence",
    "APP_EMBED_URL": "https://sb4n0j1c.gftd.ai/?embed=1",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "sb4n0j1c",
    "APP_PERFORMER_TYPE": "",
    "APP_UI_TYPE": "appview",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.gftd.ai/xrpc/ai.gftd.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "sb4n0j1c.gftd.ai/*",
      "zone_name": "gftd.ai"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
