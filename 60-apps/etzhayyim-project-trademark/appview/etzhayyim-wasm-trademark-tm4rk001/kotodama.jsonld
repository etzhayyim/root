{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:trademark.etzhayyim.com",
  "convoSystemPrompt": "You are Trademark Registry agent. Global trademark platform integrating JPO, USPTO (TESS/TSDR), EUIPO, WIPO Madrid. Data model: trademark, owner, niceClass (45 class), viennaCode, madridRegistration, opposition, coverageReport. Primary key = {jurisdiction}-{regNumber}. Respond helpfully in the user's language.",
  "duties": ["勤労の義務"],
  "entities": [
    { "category": "regulatory", "did": "did:web:trademark.etzhayyim.com:source:jpo", "name": "JPO Trademark Gazette", "sourceId": "src-jpo-tm", "url": "https://www.j-platpat.inpit.go.jp/" },
    { "category": "regulatory", "did": "did:web:trademark.etzhayyim.com:source:uspto", "name": "USPTO TESS/TSDR", "sourceId": "src-uspto-tm", "url": "https://tmsearch.uspto.gov/" },
    { "category": "regulatory", "did": "did:web:trademark.etzhayyim.com:source:euipo", "name": "EUIPO eSearch plus", "sourceId": "src-euipo", "url": "https://euipo.europa.eu/eSearch/" },
    { "category": "international", "did": "did:web:trademark.etzhayyim.com:source:wipo-madrid", "name": "WIPO Madrid Monitor", "sourceId": "src-wipo-madrid", "url": "https://www3.wipo.int/madrid/monitor/" }
  ],
  "governance": { "classification": "internal", "complianceFrameworks": ["Nice-Classification", "Madrid-Protocol"], "raci": "responsible" },
  "kpi": ["credits の獲得"],
  "name": "Trademark Registry",
  "nanoid": "tm4rk001",
  "performerType": "service",
  "profile": {
    "avatar": "TM",
    "capabilities": ["trademark-search", "trademark-lookup", "madrid-tracking", "nice-classification"],
    "category": "intellectual-property",
    "description": "Global trademark registry — JPO / USPTO / EUIPO / WIPO Madrid integration, Nice + Vienna classification, opposition tracking, cross-linked to LEI.",
    "displayName": "Trademark Registry"
  },
  "runtimeType": "worker",
  "space": {
    "name": "Trademark Registry",
    "description": "商標 coverage hub",
    "joinRule": "public",
    "historyVisibility": "world-readable",
    "convos": [{ "name": "trademark-feed", "kind": "public", "description": "新規出願・登録 feed", "default": true }]
  },
  "triggers": {
    "http": {
      "listen": "0.0.0.0:8080",
      "routes": ["/api/...", "/health", "/.well-known/did.json", "/.well-known/atproto-did", "/..."],
      "spa": true,
      "staticDir": "/wasm/svelte/dist"
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow",
        "com.etzhayyim.apps.trademark.trademark",
        "com.etzhayyim.apps.trademark.owner",
        "com.etzhayyim.apps.trademark.niceClass",
        "com.etzhayyim.apps.trademark.viennaCode",
        "com.etzhayyim.apps.trademark.madridRegistration",
        "com.etzhayyim.apps.trademark.opposition",
        "com.etzhayyim.apps.trademark.coverageReport"
      ]
    }
  },
  "ui": { "accent": "#0ea5e9", "icon": "TM" },
  "uiType": "yoro",
  "executionTier": "T1",
  "version": "1.0.0"
}
