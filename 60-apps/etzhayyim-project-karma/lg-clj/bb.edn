{;; lg-karma — clj-native port of the Python LangGraph server (ADR-2606280030,
 ;; langgraph-python → langgraph-clj). Scoped to THIS app only — does NOT touch
 ;; the repo-root bb.edn. langgraph-clj pinned to the same SHA as the repo root.
 ;;
 ;;   src   — lg-karma.* namespaces (handlers + graphs + server)
 ;;   test  — lg-karma.smoke-test (clojure.test)
 ;;
 ;; Run the suite:   bb test          (or:  bb run_tests.clj)
 ;; Start the server: bb serve [port]
 :paths ["src" "test"]
 :deps {com-junkawasaki/langgraph-clj
        {:git/url "https://github.com/com-junkawasaki/langgraph-clj"
         :git/sha "c7daa07d4e50f55d7e2a02e4b89dbeb2b200961d"}}
 :tasks
 {test  {:doc  "Run the lg-karma clojure.test suite under bb."
         :task (load-file "run_tests.clj")}
  serve {:doc      "Start the lg-karma /runs + /xrpc HTTP server (httpkit)."
         :requires ([org.httpkit.server :as httpkit]
                    [lg-karma.server :as server])
         :task
         (let [port (Integer/parseInt
                     (or (first *command-line-args*)
                         (System/getenv "PORT")
                         "2024"))]
           (server/start! httpkit/run-server {:port port})
           (deref (promise)))}}}
