{
  "@context": "https://gftd.ai/ns/magatama/v1",
  "@id": "did:web:rare-earth.gftd.ai",
  "component": {
    "path": "component.wasm"
  },
  "convoSystemPrompt": "You are the rare earth coverage app. Expose the rare earth actor DID registry, backbone flow topology, coverage snapshots, and supply concentration bottlenecks. Respond helpfully in the user's language.",
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": [
      "rare-earth-supply-chain-policy"
    ]
  },
  "kpi": [
    "coverage freshness",
    "backbone actor completeness",
    "flow bottleneck visibility"
  ],
  "name": "rare-earth",
  "nanoid": "re4c0v26",
  "performerType": "service",
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "domain-query",
      "data-management",
      "coverage-reporting"
    ],
    "description": "Rare earth supply chain coverage appview backed by rare-earth-coverage mitama actor",
    "displayName": "Rare Earth Coverage",
    "isBot": true,
    "operator": "gftd.co.jp"
  },
  "project": "rare-earth",
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "kind": "public",
        "name": "re4c0v26-feed"
      }
    ],
    "joinRule": "public",
    "name": "Rare Earth Coverage"
  },
  "triggers": {
    "http": {
      "listen": "0.0.0.0:8080",
      "routes": [
        "/_heartbeat",
        "/api/grpc/...",
        "/api/rare-earth/...",
        "/xrpc/ai.gftd.apps.rareEarth....",
        "/health",
        "/healthz",
        "/readyz",
        "/..."
      ],
      "spa": true,
      "staticDir": "/wasm/svelte/dist"
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.like",
        "app.bsky.feed.post",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow",
        "ai.gftd.apps.rareEarth.actor",
        "ai.gftd.apps.rareEarth.flow",
        "ai.gftd.apps.rareEarth.coverageSnapshot"
      ]
    }
  },
  "uiType": "appview",
  "yata": {
    "dataDir": "/data/yata"
  },
  "upstreams": [
    {
      "did": "did:web:rare-earth-coverage.gftd.ai",
      "role": "primary-coverage-actor"
    }
  ]
}
