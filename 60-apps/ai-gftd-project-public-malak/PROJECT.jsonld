  "@id": "https://gftd.ai/projects/ai-gftd-project-public-malak",
  "@type": "prov:Entity",
  "name": "Public Malak — Social Ad Crawling & Intelligence Analysis",
  "description": "Public-facing social advertisement intelligence platform. Crawls Facebook Ad Library and Instagram Ad Library for ad creatives, targeting data, spend estimates, and advertiser metadata. Stores results as JSON-LD and performs LLM-powered competitive/threat analysis.",
  "gftd:category": "ai-gftd-project-public-malak",
  "gftd:appId": "public-malak",
  "status": "In Progress",
  "prov:wasGeneratedBy": {
    "@type": "prov:Activity",
    "name": "Social Ad Intelligence Infrastructure Development",
    "prov:startedAtTime": "2026-02-20T00:00:00Z"
  },
  "gftd:milestones": [
    {
      "name": "Social Ad Crawler MCP Component",
      "status": "In Progress",
      "description": "SpinApp MCP component for Facebook/Instagram Ad Library crawling, storage, and analysis via MCP tools."
    },
    {
      "name": "Ad Data JSON-LD Schema",
      "status": "Planned",
      "description": "JSON-LD schema definitions for crawled ad data (SocialAd, AdCreative, AdTargeting, AdSpend)."
    },
    {
      "name": "LLM Ad Analysis Integration",
      "status": "Planned",
      "description": "OpenRouter LLM integration for ad content analysis, competitor benchmarking, and trend detection."
    }
  ],
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "activities.jsonld",
        "content": {
          "@context": "https://schema.gftd.ai/context.jsonld",
          "@type": "OperationalActivity",
          "id": "act:social-ad-intelligence",
          "name": "Social Ad Intelligence Operations",
          "description": "Continuous crawling, storage, and analysis of public social media advertisements across Meta/Facebook/Instagram/WhatsApp, Google, LinkedIn, TikTok, X, LINE, and Telegram transparency surfaces.",
          "subActivities": [
            {
              "id": "act:crawl-facebook-ads",
              "name": "Facebook Ad Library Crawling",
              "description": "Querying the Facebook Ad Library API for ads by advertiser page ID, keyword, country, or ad category. Retrieves ad creatives, funding entities, impressions, and spend ranges."
            },
            {
              "id": "act:crawl-instagram-ads",
              "name": "Instagram Ad Library Crawling",
              "description": "Querying the Meta Ad Library for Instagram-platform ads. Retrieves visual creatives, caption text, reach estimates, and targeting metadata."
            },
            {
              "id": "act:store-ad-data",
              "name": "Ad Data Storage",
              "description": "Persisting crawled ad data into RisingWave graph tables with full provenance (crawl timestamp, source URL, platform, advertiser). Stored in vertex_ads_* for retrieval and analysis."
            },
            {
              "id": "act:analyze-ad-content",
              "name": "Ad Content Analysis",
              "description": "Intel analysis of ad creatives and targeting patterns to identify trends, competitive positioning, adversarial campaigns, and policy violations."
            },
            {
              "id": "act:generate-ad-reports",
              "name": "Ad Intelligence Report Generation",
              "description": "Generating structured intelligence reports summarizing ad activity, spend trends, creative strategies, and threat indicators across monitored advertisers."
            }
          ]
        }
      },
      {
        "fileName": "capabilities.jsonld",
        "content": {
          "@context": "https://schema.gftd.ai/context.jsonld",
          "@type": "Capability",
          "id": "cap:social-ad-crawling-and-analysis",
          "name": "Social Advertisement Crawling, Storage, and Intelligence Analysis",
          "description": "Capability to crawl public ad libraries and transparency surfaces for advertisement data including creatives, targeting parameters, spend estimates, and advertiser metadata. Stores crawled data in RisingWave graph tables and performs intel analysis for competitive intelligence, threat assessment, and trend detection.",
          "goals": [
            "Crawl public ad transparency surfaces for active and inactive ads by advertiser, keyword, or region",
            "Track Meta/Facebook/Instagram/WhatsApp, Google, LinkedIn, TikTok, X, LINE, and Telegram platform observations",
            "Store crawled ad data as structured RisingWave graph rows with provenance tracking",
            "Analyze ad content and targeting patterns as public-malak intel",
            "Detect adversarial or fraudulent ad campaigns across platforms",
            "Generate competitive intelligence reports and trend analysis"
          ],
          "performers": [
            "perf:social-ad-crawler-component"
          ]
        }
      },
      {
        "fileName": "scheduler.jsonld",
        "content": {
          "@context": [
            "https://schema.org/",
            {
              "gftd": "https://gftd.ai/schemas/",
              "milestones": "gftd:milestones",
              "blockers": "gftd:blockers"
            }
          ],
          "@type": "CreativeWork",
          "name": "Public Malak — Social Ad Crawling & Intelligence Analysis Scheduler",
          "identifier": "ai-gftd-project-public-malak/scheduler",
          "description": "Project schedule (milestones) and blockers for social ad crawling capability.",
          "dateCreated": "2026-02-20T00:00:00+00:00",
          "milestones": [
            {
              "name": "MCP Component Implementation",
              "status": "In Progress",
              "description": "Implement social-ad-crawler-component with Facebook/Instagram Ad Library API integration, in-memory store, LLM analysis, and JSON-LD export."
            },
            {
              "name": "Meta Ad Library Token Provisioning",
              "status": "Planned",
              "description": "Obtain and configure META_AD_LIBRARY_TOKEN via SpinApp named config."
            },
            {
              "name": "ClickHouse Persistence Integration",
              "status": "Planned",
              "description": "Replace in-memory adStore with ClickHouse ORM (performer/rdbms) for persistent ad storage."
            },
            {
              "name": "Scheduler Automation",
              "status": "Implemented",
              "description": "Periodic ad library crawling is owned by LangServer BPMN-contract (`public_malak_crawl_ads`) and the pymagatama Python worker tasks `publicMalak.ads.queueSeedRuns` / `publicMalak.ads.processQueue`; on-demand analysis is owned by `public_malak_analyze_ad` / `publicMalak.ads.analyzeCreative`."
            }
          ],
          "blockers": []
        }
      }
    ]
  }
