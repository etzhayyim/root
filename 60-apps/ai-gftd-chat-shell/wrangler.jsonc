{
  "name": "ai-gftd-chat-shell",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "gftd.ai/*",
      "zone_name": "gftd.ai"
    },
    {
      "pattern": "chat.gftd.ai/*",
      "zone_name": "gftd.ai"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "CHAT_VERSION": "0.1.0",
    "CHAT_AGENT_URL": "https://chat-agent.gftd.ai",
    "CHAT_ACTOR_DID": "did:web:gftd.ai",
    "AUTHN_URL": "https://authn.gftd.ai",
    "DEFAULT_MODEL": "gemma-4-e4b-it",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.gftd.ai/xrpc/ai.gftd.mcp.message"
  },
  "observability": {
    "enabled": true
  }
}
