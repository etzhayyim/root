# ai-gftd-chat-shell — build artifacts, caches, and machine-local state.
# Source-only is tracked; everything generated/secret stays out of git.

# JS / SvelteKit / wrangler build output
node_modules/
.svelte-kit/
build/
dist/
.wrangler/

# inlang/paraglide GENERATED i18n output (regenerated from svelte/messages/*.json)
svelte/src/paraglide/
svelte/project.inlang/cache/

# Python caches / virtualenvs
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.mypy_cache/
.ruff_cache/

# machine-local browser automation profile — CONTAINS SECRETS (cookies/login-data); never commit
.sodai-chrome-profile/

# OS junk
.DS_Store
