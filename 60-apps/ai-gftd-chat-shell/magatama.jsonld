{
  "@context": "https://gftd.ai/ld/magatama/v1",
  "name": "ai-gftd-chat-shell",
  "displayName": "Gftd Chat",
  "description": "ChatGPT/Claude.ai-style chat at gftd.ai apex. Thin CF Worker shell over Hono+Svelte; agent loop runs in mitama-chat-pool (LangGraph). Tools: code_exec, image_gen, file_save, rag_search, web_search, schedule_report.",
  "did": "did:web:gftd.ai",
  "tier": "T3",
  "uiType": "appview",
  "embedUrl": "https://gftd.ai/embed",
  "routes": ["gftd.ai"],
  "layer": "chat-shell",
  "atStandard": false,
  "nsidPrefixes": ["ai.gftd.apps.chat"],
  "backendDependencies": {
    "chatAgent": "https://chat-agent.gftd.ai",
    "authn": "https://authn.gftd.ai",
    "atproto": "https://atproto.gftd.ai",
    "comfyui": "https://comfyui.gftd.ai",
    "bpmn": "https://dispatcher.gftd.ai"
  },
  "adr": [
    "2604282300",
    "2604241038",
    "0049",
    "0036",
    "0056",
    "260413"
  ]
}
