<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- registerProvider -->
  <bpmn:process id="provider-pod-register-provider" name="Provider Pod Register Provider" isExecutable="true">
    <bpmn:startEvent id="start-register-provider"/>
    <bpmn:sequenceFlow id="sf-rp-1" sourceRef="start-register-provider" targetRef="task-register-provider"/>
    <bpmn:serviceTask id="task-register-provider" name="Register Provider">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.providerPod.register.provider"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-rp-2" sourceRef="task-register-provider" targetRef="end-register-provider"/>
    <bpmn:endEvent id="end-register-provider"/>
  </bpmn:process>

  <!-- listProviders -->
  <bpmn:process id="provider-pod-list-providers" name="Provider Pod List Providers" isExecutable="true">
    <bpmn:startEvent id="start-list-providers"/>
    <bpmn:sequenceFlow id="sf-lpr-1" sourceRef="start-list-providers" targetRef="task-list-providers"/>
    <bpmn:serviceTask id="task-list-providers" name="List Providers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.providerPod.list.providers"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lpr-2" sourceRef="task-list-providers" targetRef="end-list-providers"/>
    <bpmn:endEvent id="end-list-providers"/>
  </bpmn:process>

  <!-- getProvider -->
  <bpmn:process id="provider-pod-get-provider" name="Provider Pod Get Provider" isExecutable="true">
    <bpmn:startEvent id="start-get-provider"/>
    <bpmn:sequenceFlow id="sf-gpr-1" sourceRef="start-get-provider" targetRef="task-get-provider"/>
    <bpmn:serviceTask id="task-get-provider" name="Get Provider">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.providerPod.get.provider"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gpr-2" sourceRef="task-get-provider" targetRef="end-get-provider"/>
    <bpmn:endEvent id="end-get-provider"/>
  </bpmn:process>

  <!-- updateHealth -->
  <bpmn:process id="provider-pod-update-health" name="Provider Pod Update Health" isExecutable="true">
    <bpmn:startEvent id="start-update-health"/>
    <bpmn:sequenceFlow id="sf-uh-1" sourceRef="start-update-health" targetRef="task-update-health"/>
    <bpmn:serviceTask id="task-update-health" name="Update Health">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.providerPod.update.health"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-uh-2" sourceRef="task-update-health" targetRef="end-update-health"/>
    <bpmn:endEvent id="end-update-health"/>
  </bpmn:process>

  <!-- listCapabilities -->
  <bpmn:process id="provider-pod-list-capabilities" name="Provider Pod List Capabilities" isExecutable="true">
    <bpmn:startEvent id="start-list-capabilities"/>
    <bpmn:sequenceFlow id="sf-lc-1" sourceRef="start-list-capabilities" targetRef="task-list-capabilities"/>
    <bpmn:serviceTask id="task-list-capabilities" name="List Capabilities">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.providerPod.list.capabilities"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lc-2" sourceRef="task-list-capabilities" targetRef="end-list-capabilities"/>
    <bpmn:endEvent id="end-list-capabilities"/>
  </bpmn:process>

  <!-- createPod -->
  <bpmn:process id="provider-pod-create-pod" name="Provider Pod Create Pod" isExecutable="true">
    <bpmn:startEvent id="start-create-pod"/>
    <bpmn:sequenceFlow id="sf-cpod-1" sourceRef="start-create-pod" targetRef="task-create-pod"/>
    <bpmn:serviceTask id="task-create-pod" name="Create Pod">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.providerPod.create.pod"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-cpod-2" sourceRef="task-create-pod" targetRef="end-create-pod"/>
    <bpmn:endEvent id="end-create-pod"/>
  </bpmn:process>

  <!-- listPods -->
  <bpmn:process id="provider-pod-list-pods" name="Provider Pod List Pods" isExecutable="true">
    <bpmn:startEvent id="start-list-pods"/>
    <bpmn:sequenceFlow id="sf-lpod-1" sourceRef="start-list-pods" targetRef="task-list-pods"/>
    <bpmn:serviceTask id="task-list-pods" name="List Pods">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.providerPod.list.pods"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lpod-2" sourceRef="task-list-pods" targetRef="end-list-pods"/>
    <bpmn:endEvent id="end-list-pods"/>
  </bpmn:process>

  <!-- getPodStatus -->
  <bpmn:process id="provider-pod-get-pod-status" name="Provider Pod Get Pod Status" isExecutable="true">
    <bpmn:startEvent id="start-get-pod-status"/>
    <bpmn:sequenceFlow id="sf-gps-1" sourceRef="start-get-pod-status" targetRef="task-get-pod-status"/>
    <bpmn:serviceTask id="task-get-pod-status" name="Get Pod Status">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.providerPod.get.pod.status"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gps-2" sourceRef="task-get-pod-status" targetRef="end-get-pod-status"/>
    <bpmn:endEvent id="end-get-pod-status"/>
  </bpmn:process>

</bpmn:definitions>
