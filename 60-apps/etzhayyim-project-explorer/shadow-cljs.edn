;; etzhayyim-project-explorer — apex SPA (ADR-2606201610)
;;
;; Three browser-side, serverless views over the organism:
;;   /          → Organism   (Tree-of-Life + aliveness 5-tuple, default landing)
;;   /explorer  → kotoba CommitDag / Datom explorer (kotoba-wasm, lazy)
;;   /nodes     → node distribution (分散状況) mesh + fleet
;;
;; Stack mirrors the yoro cljs harness: Reagent 1.2 + re-frame 1.4 + shadow-cljs
;; :browser. All reads are content-addressed/static (served by the apex
;; etzhayyim-did-web Worker at /kotoba/* and /organism/*); the browser does the
;; decode/compute/layout. No backend in this app.
;;
;; dev:   npm run dev    (shadow-cljs watch app → :dev-http 8710, push-state)
;; build: npm run build  (shadow-cljs release app → public/js)
;; test:  npm test       (shadow-cljs :node-test)
{:source-paths
 ["src" "test"
  ;; portable kotoba datom codec (.cljc, ADR-2605312345) — CommitDag/tx shapes
  "../../orgs/kotoba-lang/kotodama/src"]

 :dev-http
 {8710 {:root "public"
        :push-state/index "index.html"}}

 :dependencies
 [[reagent "1.2.0"]
  [re-frame "1.4.3"]
  ;; Transit (transit+json) — the Datomic-client wire standard, for the
  ;; query/sync path (live Datom tail + Datom query responses). On-disk
  ;; snapshots stay EDN; the CID preimage stays canonical-JSON.
  [com.cognitect/transit-cljs "0.8.280"]]

 :builds
 {:app
  {:target :browser
   :output-dir "public/js"
   :asset-path "/js"
   :modules {:main {:init-fn etzhayyim.explorer.core/init!}}
   :devtools {:after-load etzhayyim.explorer.core/mount-root}
   :closure-defines
   ;; Same-origin in production (apex Worker serves the SPA + /organism + /kotoba).
   ;; Override for local dev:  shadow-cljs watch app --config-merge ...
   ;; or set window.__DATA_BASE__ in index.html.
   {etzhayyim.explorer.data/DATA-BASE ""}}

  :test
  {:target :node-test
   :output-to "out/node-tests.js"
   :ns-regexp "-test$"}}}
