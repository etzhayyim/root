(ns etzhayyim.explorer.data
  "Browser-side, serverless data plane (ADR-2606201610).

   Every read is content-addressed / static and served by the apex
   etzhayyim-did-web Worker:
     /organism/*.json|*.edn   — heartbeat snapshots (pulse ~6s, joucho ~60s,
                                 vitals ~1h) generated by etzhayyim-project-organism
     /kotoba/<genesis>.root.json — CommitDag head pointer
     /kotoba/blocks/<cid>        — content-addressed block (KV/IPFS), CID-verified

   The edge is an untrusted cache: the browser is the only authority (the kotoba
   block reader CID-verifies every block; ADR-2606013600). This namespace just
   does the fetch + parse — JSON via js->clj, EDN via cljs.reader (native, the
   whole reason this app is ClojureScript)."
  (:require [cljs.reader :as edn]
            [clojure.string :as str]))

;; Same-origin in production; overridable for local dev via window.__DATA_BASE__
;; or the shadow-cljs :closure-define.
(goog-define DATA-BASE "")

(defn data-base []
  (let [win (some-> (.-__DATA_BASE__ js/window))]
    (cond
      (and win (not (str/blank? win))) win
      (not (str/blank? DATA-BASE)) DATA-BASE
      :else "")))

(defn url [path]
  (str (data-base) path))

;; ── fetch helpers ──────────────────────────────────────────────────────────
;; All return a JS Promise; callers wire them into re-frame effects.

(defn- ->error [resp]
  (js/Error. (str "HTTP " (.-status resp) " " (.-url resp))))

(defn fetch-text
  "Fetch a resource as text. Resolves to the body string."
  [path]
  (-> (js/fetch (url path) #js {:cache "no-cache"})
      (.then (fn [resp]
               (if (.-ok resp)
                 (.text resp)
                 (throw (->error resp)))))))

(defn fetch-json
  "Fetch + parse JSON → Clojure data (keywordized keys)."
  [path]
  (-> (fetch-text path)
      (.then (fn [t] (js->clj (js/JSON.parse t) :keywordize-keys true)))))

(defn fetch-edn
  "Fetch + parse an EDN (.kotoba.edn) snapshot → Clojure data.

   Unknown tagged literals (e.g. #inst, #cid) degrade to their raw form instead
   of throwing, so a viewer never blanks on an unfamiliar tag."
  [path]
  (-> (fetch-text path)
      (.then (fn [t]
               ;; cljs.reader/*default-data-reader-fn* holds an ATOM (the reader
               ;; derefs it); bind it to an atom-wrapped fn so unknown tags
               ;; degrade instead of throwing. (Binding it to a bare fn throws
               ;; "No protocol method IDeref.-deref" — the bug the visual react
               ;; loop caught on the Organism view.)
               (binding [edn/*default-data-reader-fn* (atom (fn [_tag v] v))]
                 (edn/read-string t))))))

;; ── content-addressed block reads ──────────────────────────────────────────

(def ^:const default-genesis "yoro-social-v1")

(defn root-pointer
  "GET /kotoba/<genesis>.root.json — the CommitDag head pointer JSON."
  ([] (root-pointer default-genesis))
  ([genesis] (fetch-json (str "/kotoba/" genesis ".root.json"))))

(defn block-bytes
  "GET /kotoba/blocks/<cid> as a Uint8Array. The caller (kotoba-wasm, lazy)
   verifies the bytes hash to <cid> before trusting them."
  [cid]
  (-> (js/fetch (url (str "/kotoba/blocks/" cid)) #js {:cache "force-cache"})
      (.then (fn [resp]
               (if (.-ok resp)
                 (.arrayBuffer resp)
                 (throw (->error resp)))))
      (.then (fn [buf] (js/Uint8Array. buf)))))
