;; Visual test react loop for the etzhayyim explorer SPA (ADR-2606201610).
;;
;; Uses computer-use-clj's IComputer host capability (computeruse.computer +
;; computeruse.macos) for the real screenshot leg, a local Ollama gemma-4 vision
;; model for the visual judgement, and the canonical kotoba.datom codec to record
;; each verdict on a content-addressed append-only log (so the explorer itself can
;; read its own visual-test results — same codec the /explorer view verifies).
;;
;; We put the library + codec sources directly on :paths (rather than depending on
;; computer-use-clj's deps.edn) so this dev tool needs NO git-dep resolution and no
;; network — only the namespaces it actually requires (computeruse.computer,
;; computeruse.macos — clojure.string only) plus kotoba.datom.
{:paths ["src"
         ;; computer-use-clj host capability (IComputer + macOS host)
         "../../../../../com-junkawasaki/computer-use-clj/src"
         ;; canonical kotoba Datom codec (portable .cljc)
         "../../../orgs/kotoba-lang/kotodama/src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.1"}}
 :aliases
 {;; offline self-test: mock computer + stub judge, no desktop/Ollama needed
  :smoke {:main-opts ["-m" "etzhayyim.explorer.visual.react-loop" "--smoke"]}
  ;; real run: macOS screencapture + live Ollama gemma vision over the dev server
  :run {:main-opts ["-m" "etzhayyim.explorer.visual.react-loop"]}}}
