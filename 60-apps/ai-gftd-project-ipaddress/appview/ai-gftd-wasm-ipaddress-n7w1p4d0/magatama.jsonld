        "ai.gftd.apps.ipaddress.asn",
        "ai.gftd.apps.ipaddress.whoisSnapshot",
        "ai.gftd.apps.ipaddress.geolocation",
        "ai.gftd.apps.ipaddress.reverseDns",
        "ai.gftd.apps.ipaddress.hostingProvider",
        "ai.gftd.apps.ipaddress.abuseContact",
        "ai.gftd.apps.ipaddress.delegationEvent",
        "ai.gftd.apps.ipaddress.governanceRule",
        "ai.gftd.apps.ipaddress.ipAnalysis",
        "ai.gftd.apps.ipaddress.scanResult",
        "ai.gftd.yoro.browsingHistory",
        "ai.gftd.yoro.searchHistory"
