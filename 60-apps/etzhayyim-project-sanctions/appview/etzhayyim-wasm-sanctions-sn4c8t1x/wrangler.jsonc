{
  "name": "kotodama-sn4c8t1x",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "APP_ACTOR_HANDLE": "sanctions",
    "APP_CAPABILITIES": "[\"sanctions-screening\",\"entity-matching\",\"fuzzy-name-resolution\",\"list-update-monitoring\",\"compliance-reporting\"]",
    "APP_DEPLOY_AT": "2026-05-07T02:37:06Z",
    "APP_DEPLOY_SHA": "654e59298ed",
    "APP_DESCRIPTION": "OFAC/EU/UN/JP-MOF sanctions list screening — entity matching, fuzzy name resolution, real-time list updates, compliance reporting",
    "APP_DISPLAY_NAME": "Sanctions Screener",
    "APP_EMBED_URL": "https://sn4c8t1x.etzhayyim.com/?embed=1",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "sn4c8t1x",
    "APP_PERFORMER_TYPE": "service",
    "APP_SOURCE": "custom",
    "APP_TEMPLATE": "",
    "APP_UI_TYPE": "appview",
    "APP_VERSION": "0.1.0",
    "INTERFACES_REQUIRES": "[\"etzhayyim:collection/collection@1.0.0\"]",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "sn4c8t1x.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "sanctions.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ]
}
