{
  "@context": "https://gftd.ai/ns/magatama/v1",
  "@id": "did:web:organizer.gftd.ai",
  "build": {
    "guestLanguage": "go"
  },
  "component": {
    "path": "/wasm/component.wasm"
  },
  "agentConfig": {
    "autoReply": true,
    "mcpExpose": true,
    "model": "gemma-4-e2b-it",
    "maxTokens": 1024,
    "temperature": 0.7
  },
  "convoSystemPrompt": "You are Organizer, an AI agent that auto-classifies, tags, and organizes files into project collections. You also detect and manage subscriptions from billing emails.\n\nWhen a user messages you in a project convo:\n1. Ask what they want to organize (files, links, ideas, tasks)\n2. Create appropriate collections for the project\n3. Classify uploaded items using AI vision/NLP and assign them to collections\n4. Suggest auto-organize rules based on patterns\n5. Provide vault stats and organization summaries\n6. Analyze subscription billing emails to detect unnecessary subscriptions\n7. Recommend cancellations and delegate to kaiyaku.gftd.ai for execution\n\nYou can use your tools: RegisterItem, CreateCollection, AddToCollection, CreateRule, SearchItems, ListItems, SuggestRules, DetectSubscription, AnalyzeSubscriptions, GetRecommendations, RequestCancellation.\nAlways respond helpfully in the user's language.",
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": [
      "data-retention-policy"
    ]
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "organizer",
  "nanoid": "org4n1z3",
  "performerType": "service",
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "RegisterItem",
      "Reclassify",
      "DeleteItem",
      "AddTag",
      "RemoveTag",
      "CreateCollection",
      "AddToCollection",
      "CreateRule",
      "SearchItems",
      "ListItems",
      "ListCollections",
      "GetVaultStats",
      "SuggestRules",
      "DetectSubscription",
      "AnalyzeSubscriptions",
      "GetRecommendations",
      "RequestCancellation",
      "organizer.list",
      "organizer.detail",
      "organizer.stats"
    ],
    "description": "Upload anything — AI auto-classifies, tags, and organizes your files into collections",
    "displayName": "Organizer",
    "isBot": true,
    "operator": "gftd.co.jp",
    "status": "online",
    "version": "1.0.0"
  },
  "project": "organizer",
  "routes": [
    {
      "host": "organizer.gftd.ai",
      "paths": [
        "/"
      ],
      "tls": true
    }
  ],
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "description": "Recently organized items",
        "kind": "public",
        "name": "Feed"
      }
    ],
    "description": "Upload anything — AI auto-organizes",
    "historyVisibility": "world-readable",
    "joinRule": "public",
    "name": "Organizer"
  },
  "stream": {
    "exports": [
      {
        "description": "Live organized item stream with category filter",
        "governance": {
          "requiredRoles": [
            "subscriber"
          ],
          "requiredTrustLevel": "low"
        },
        "method": "stream-items"
      }
    ]
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.graph.follow",
        "ai.gftd.apps.organizer.item",
        "ai.gftd.apps.organizer.classification",
        "ai.gftd.apps.organizer.tag",
        "ai.gftd.apps.organizer.collection",
        "ai.gftd.apps.organizer.collectionItem",
        "ai.gftd.apps.organizer.organizeRule",
        "ai.gftd.apps.organizer.itemDeletion",
        "ai.gftd.apps.organizer.itemStatusUpdate",
        "ai.gftd.apps.organizer.tagDeletion",
        "ai.gftd.apps.organizer.collectionItemDeletion",
        "ai.gftd.apps.organizer.organizeRuleDeletion",
        "ai.gftd.apps.organizer.subscriptionItem",
        "ai.gftd.apps.organizer.subscriptionAnalysis",
        "ai.gftd.apps.organizer.subscriptionReviewJob",
        "ai.gftd.apps.organizer.subscriptionItemUpdate",
        "ai.gftd.apps.mailer.inboundEmail",
        "ai.gftd.apps.kaiyaku.cancellationCompleted"
      ]
    }
  },
  "ui": {
    "accent": "#4f46e5",
    "icon": "OG"
  },
  "uiType": "yoro"
}
