{
  "@context": {
    "@vocab": "https://schema.org/",
    "etzhayyim": "https://etzhayyim.com/schema/",
    "geo": "http://www.w3.org/2003/01/geo/wgs84_pos#"
  },
  "@type": "DefinedTerm",
  "name": "RealEstateProperty",
  "description": "Schema definition for global real estate property and land rights data",
  "inDefinedTermSet": {
    "@type": "DefinedTermSet",
    "name": "Etzhayyim Real Estate Data Schema",
    "hasDefinedTerm": [
      {
        "@type": "PropertyValue",
        "name": "propertyId",
        "description": "Unique identifier for the property",
        "valueRequired": true
      },
      {
        "@type": "PropertyValue",
        "name": "propertyType",
        "description": "Type of property (land, building, condominium, commercial, residential, agricultural)",
        "valueRequired": true
      },
      {
        "@type": "PropertyValue",
        "name": "address",
        "description": "Full address of the property",
        "valueRequired": true
      },
      {
        "@type": "PropertyValue",
        "name": "country",
        "description": "ISO 3166-1 alpha-2 country code",
        "valueRequired": true
      },
      {
        "@type": "PropertyValue",
        "name": "region",
        "description": "State, province, or region",
        "valueRequired": false
      },
      {
        "@type": "PropertyValue",
        "name": "city",
        "description": "City or municipality",
        "valueRequired": false
      },
      {
        "@type": "PropertyValue",
        "name": "postalCode",
        "description": "Postal or ZIP code",
        "valueRequired": false
      },
      {
        "@type": "PropertyValue",
        "name": "coordinates",
        "description": "Geographic coordinates (latitude, longitude)",
        "valueRequired": false
      },
      {
        "@type": "PropertyValue",
        "name": "area",
        "description": "Property area in square meters",
        "valueRequired": false
      },
      {
        "@type": "PropertyValue",
        "name": "assessedValue",
        "description": "Assessed value in local currency",
        "valueRequired": false
      },
      {
        "@type": "PropertyValue",
        "name": "currency",
        "description": "ISO 4217 currency code",
        "valueRequired": false
      },
      {
        "@type": "PropertyValue",
        "name": "owners",
        "description": "Array of property owners/land rights holders",
        "valueRequired": true
      },
      {
        "@type": "PropertyValue",
        "name": "registrationDate",
        "description": "Property registration date (ISO 8601)",
        "valueRequired": false
      },
      {
        "@type": "PropertyValue",
        "name": "registrationNumber",
        "description": "Official registration/deed number",
        "valueRequired": false
      },
      {
        "@type": "PropertyValue",
        "name": "landRightsType",
        "description": "Type of land rights (freehold, leasehold, customary, state-owned)",
        "valueRequired": false
      },
      {
        "@type": "PropertyValue",
        "name": "dataSource",
        "description": "Source of the data (government registry, public records, etc.)",
        "valueRequired": true
      },
      {
        "@type": "PropertyValue",
        "name": "lastUpdated",
        "description": "Last update timestamp (ISO 8601)",
        "valueRequired": true
      }
    ]
  }
}
