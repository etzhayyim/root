{
  "@context": "https://etzhayyim.com/kotodama/context/v1",
  "@type": "KotodamaApp",
  "id": "real-estate-r3alestate",
  "name": "Real Estate MCP",
  "description": "Global real-estate source, property, listing, and transaction MCP facade.",
  "primaryDid": "did:web:real-estate.etzhayyim.com",
  "runtimeType": "worker",
  "framework": "ts-thin-edge",
  "component": { "path": "src/app.ts" },
  "build": {
    "role": "thin-edge",
    "businessLogic": "40-engine/kotoba/crates/kotoba-kotodama/py/src/kotodama/ingest/real_estate.py",
    "bpmn": "etzhayyim-root/00-contracts/bpmn/com/etzhayyim/real-estate"
  },
  "routes": [
    {
      "host": "etzhayyim.com",
      "paths": ["/r3alestate/api/mcp", "/xrpc/com.etzhayyim.apps.realEstate.*"]
    }
  ],
  "capabilities": ["mcp", "xrpc", "bpmn-dispatch"],
  "tools": [
    "com.etzhayyim.apps.realEstate.registerSource",
    "com.etzhayyim.apps.realEstate.registerProperty",
    "com.etzhayyim.apps.realEstate.publishListing",
    "com.etzhayyim.apps.realEstate.recordTransaction",
    "com.etzhayyim.apps.realEstate.searchListings",
    "com.etzhayyim.apps.realEstate.getProperty",
    "com.etzhayyim.apps.realEstate.getMarketStats"
  ]
}
