{
  "@context": "https://1.etzhayyim.com/project",
  "@type": "Project",
  "name": "etzhayyim-project-real-estate",
  "description": "Global Real Estate Property and Land Rights Data Management System",
  "category": "etzhayyim-project-data",
  "components": {
    "mcp": {
      "appId": "real-estate-r3alestate",
      "tier": "always-on",
      "stack": "ts-native-worker",
      "componentPath": "appview/real-estate-r3alestate",
      "mcpRegistry": true,
      "routes": [
        {
          "host": "etzhayyim.com",
          "paths": [
            "/r3alestate/api/mcp"
          ]
        }
      ]
    },
    "pythonWorker": {
      "appId": "real-estate-langserver-worker",
      "tier": "batch",
      "stack": "python",
      "entrypoint": "worker/python/real_estate_worker.py",
      "routes": []
    },
    "ui": {
      "appId": "resources-ui",
      "tier": "static",
      "stack": "sveltekit",
      "routes": [
        {
          "host": "resources.etzhayyim.com",
          "paths": [
            "/"
          ]
        }
      ]
    }
  }
}
