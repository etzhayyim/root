{
  "@context": "https://gftd.ai/ns/magatama/v1",
  "@id": "did:web:drone.gftd.ai",
  "component": {
    "path": "component.wasm"
  },
  "convoSystemPrompt": "You are ai-gftd-wasm-drone agent. Drone — AI Agent for drone intelligence and analytics. Respond helpfully in the users language.",
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": [
      "drone-policy"
    ]
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "ai-gftd-wasm-drone",
  "nanoid": "dr0n3x8k",
  "performerType": "service",
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "domain-query",
      "data-management"
    ],
    "description": "Drone — AI Agent for drone intelligence and analytics",
    "displayName": "Drone",
    "isBot": true,
    "operator": "gftd.co.jp"
  },
  "project": "drone",
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "description": "Fleet status updates, drone registrations, mission events",
        "kind": "public",
        "name": "drone-fleet"
      },
      {
        "description": "Safety alerts, RTL commands, mission aborts",
        "kind": "public",
        "name": "drone-alerts"
      }
    ],
    "description": "Autonomous drone operation - fleet management, missions, telemetry, geofencing",
    "historyVisibility": "world-readable",
    "joinRule": "public",
    "name": "Drone Fleet"
  },
  "triggers": {
    "http": {
      "listen": "0.0.0.0:8080",
      "routes": [
        "/api/grpc/...",
        "/health",
        "/healthz",
        "/readyz",
        "/..."
      ],
      "spa": true,
      "staticDir": "/wasm/svelte/dist"
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.like",
        "app.bsky.feed.post",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow",
        "ai.gftd.apps.drone.droneEntity",
        "ai.gftd.apps.drone.droneEvent",
        "ai.gftd.apps.drone.droneReport"
      ]
    }
  },
  "ui": {},
  "uiType": "appview"
}
