{
  "@context": "https://etzhayyim.com/ns/magatama/v1",
  "@id": "did:web:maps.etzhayyim.com",
  "accent": "#3b82f6",
  "component": {
    "env": {
      "MAPILLARY_ACCESS_TOKEN": "MLY|26139125922375659|e2107f0197fd28f88486e4bac27b3c9f"
    },
    "path": "/wasm/component.wasm"
  },
  "convoSystemPrompt": "You are Maps, the spatial intelligence agent for etzhayyim.com. Graph-first architecture with 980 Multi-DIDs, 137 XRPC commands across 14 WIT domains. You can look up places, calculate routes, check weather, query infrastructure networks, manage digital twins, run simulations, and maintain Bayesian latent world-model beliefs over spatial entities. You monitor real-time seismic events (USGS), aircraft positions (OpenSky ADS-B), and public transit (GTFS-JP). You extract geolocation from user post images (EXIF), ingest POIs from Mapraly, analyze images via Murakumo Vision, and process satellite imagery (Sentinel-2, Landsat). You manage 50+ geo crawl domains via site.etzhayyim.com for web-sourced geographic entity extraction. 14 source DIDs, 32 geographic code schemes, 12 Overpass entity types for JP-wide coverage. Use your tools to provide accurate, real-time spatial intelligence.",
  "deploy": {},
  "duties": [
    "勤労の義務"
  ],
  "embedUrl": "https://uqpel6i6.etzhayyim.com/?embed=1",
  "governance": {
    "clearance": "public",
    "disclosureTier": "T0",
    "requiredRoles": [
      "subscriber"
    ],
    "requiredTrustLevel": "low",
    "sensitivity": "public"
  },
  "icon": "🗺️",
  "kpi": [
    "credits の獲得"
  ],
  "name": "maps-ui",
  "nanoid": "uqpel6i6",
  "performerType": "system",
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "spatial-intelligence",
      "digital-twin",
      "geocoding",
      "bayesian-latent-world-model"
    ],
    "description": "Spatial intelligence + Digital Twin + Bayesian latent world model — places, routes, weather, infrastructure, buildings, sensors, simulation",
    "displayName": "Maps",
    "isBot": true,
    "operator": "gftd.co.jp"
  },
  "project": "maps",
  "routes": [
    {
      "host": "maps.etzhayyim.com",
      "paths": [
        "/"
      ],
      "tls": true
    },
    {
      "host": "uqpel6i6.etzhayyim.com",
      "paths": [
        "/"
      ],
      "tls": true
    }
  ],
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "description": "Route saves, place discoveries, weather updates",
        "kind": "public",
        "name": "maps-feed"
      }
    ],
    "description": "Spatial intelligence — places, routes, weather, geolocation",
    "historyVisibility": "world-readable",
    "joinRule": "public",
    "name": "Maps"
  },
  "triggers": {
    "http": {
      "listen": "0.0.0.0:8080",
      "spa": true,
      "staticDir": "/wasm/static"
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.like",
        "app.bsky.feed.post",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow",
        "ai.gftd.apps.ipaddress.ipGeo",
        "ai.gftd.apps.maps.dataset",
        "ai.gftd.apps.maps.layer",
        "ai.gftd.apps.maps.place",
        "ai.gftd.apps.maps.route",
        "ai.gftd.apps.maps.weatherPoint",
        "ai.gftd.apps.maps.infraNetwork",
        "ai.gftd.apps.maps.infraSegment",
        "ai.gftd.apps.maps.infraNode",
        "ai.gftd.apps.maps.infraIncident",
        "ai.gftd.apps.maps.building",
        "ai.gftd.apps.maps.buildingFloor",
        "ai.gftd.apps.maps.terrainPatch",
        "ai.gftd.apps.maps.asset",
        "ai.gftd.apps.maps.assetModel",
        "ai.gftd.apps.maps.twinState",
        "ai.gftd.apps.maps.deviceBinding",
        "ai.gftd.apps.maps.occupancy",
        "ai.gftd.apps.maps.sensor",
        "ai.gftd.apps.maps.sensorReading",
        "ai.gftd.apps.maps.sensorAlert",
        "ai.gftd.apps.maps.healthAssessment",
        "ai.gftd.apps.maps.maintenancePlan",
        "ai.gftd.apps.maps.simulation",
        "ai.gftd.apps.maps.simulationResult",
        "ai.gftd.apps.maps.forecast",
        "ai.gftd.apps.maps.anomalyEvent",
        "ai.gftd.apps.maps.road",
        "ai.gftd.apps.maps.railway",
        "ai.gftd.apps.maps.seaRoute",
        "ai.gftd.apps.maps.airRoute",
        "ai.gftd.apps.maps.busRoute",
        "ai.gftd.apps.maps.waterway",
        "ai.gftd.apps.maps.port",
        "ai.gftd.apps.maps.airport",
        "ai.gftd.apps.maps.station",
        "ai.gftd.apps.maps.busStop",
        "ai.gftd.apps.maps.parking",
        "ai.gftd.apps.maps.evCharger",
        "ai.gftd.apps.maps.spot",
        "ai.gftd.apps.maps.river",
        "ai.gftd.apps.maps.lake",
        "ai.gftd.apps.maps.coastline",
        "ai.gftd.apps.maps.mountain",
        "ai.gftd.apps.maps.maritimeZone",
        "ai.gftd.apps.maps.adminArea",
        "ai.gftd.apps.maps.spatialEvent",
        "ai.gftd.apps.maps.spatialVersion",
        "ai.gftd.apps.maps.spatialRelation",
        "ai.gftd.apps.maps.displayLayer",
        "ai.gftd.apps.maps.visionResult",
        "ai.gftd.apps.maps.collectionJob",
        "ai.gftd.apps.maps.satelliteScene",
        "ai.gftd.apps.maps.layerCoordinator",
        "ai.gftd.apps.maps.geoAlias",
        "ai.gftd.apps.maps.verticalZone",
        "ai.gftd.apps.maps.naturalZone",
        "ai.gftd.apps.maps.webCrawlGeoEntity",
        "ai.gftd.apps.maps.satelliteAnalysisResult",
        "ai.gftd.apps.maps.legalEntity",
        "ai.gftd.apps.maps.operator",
        "ai.gftd.apps.maps.propertyOwner",
        "ai.gftd.apps.maps.landRegistry",
        "ai.gftd.apps.maps.propertyRegistry",
        "ai.gftd.apps.maps.businessRegistry",
        "ai.gftd.apps.maps.constructionPermit",
        "ai.gftd.apps.maps.operatingLicense",
        "ai.gftd.apps.maps.zoningRecord",
        "ai.gftd.apps.maps.ownership",
        "ai.gftd.apps.site.wet",
        "ai.gftd.apps.site.wat",
        "ai.gftd.apps.site.geoRecord"
      ]
    }
  },
  "derive": {
    "social": [
      {
        "on": "ai.gftd.apps.maps.layerCoordinator",
        "template": "[Layer] {{displayName}} coordinator registered ({{layerSlug}})\ncc @jinushi.etzhayyim.com"
      },
      {
        "on": "ai.gftd.apps.maps.adminArea",
        "template": "[Region] {{displayName}} (L{{adminLevel}}) registered\ncc @jinushi.etzhayyim.com"
      },
      {
        "on": "ai.gftd.apps.maps.verticalZone",
        "template": "[VerticalZone] {{displayName}} ({{zoneType}}: {{minAlt}}m–{{maxAlt}}m)\ncc @intel.etzhayyim.com"
      },
      {
        "on": "ai.gftd.apps.maps.naturalZone",
        "template": "[NaturalZone] {{displayName}} ({{zoneType}})\ncc @intel.etzhayyim.com"
      },
      {
        "on": "ai.gftd.apps.maps.spatialEvent",
        "condition": "{{eventType}} == 'earthquake' && {{magnitude}} >= 5.0",
        "template": "[Seismic] M{{magnitude}} {{place}} depth:{{depth}}km\ncc @jinushi.etzhayyim.com"
      },
      {
        "on": "ai.gftd.apps.maps.airport",
        "template": "[Airport] {{name}} ({{icaoCode}}/{{iataCode}}) registered\ncc @intel.etzhayyim.com"
      },
      {
        "on": "ai.gftd.apps.maps.port",
        "template": "[Port] {{name}} registered\ncc @intel.etzhayyim.com"
      },
      {
        "on": "ai.gftd.apps.maps.satelliteScene",
        "template": "[Satellite] {{satellite}} scene {{sceneId}} ({{acquisitionDate}})\ncc @intel.etzhayyim.com"
      },
      {
        "on": "ai.gftd.apps.maps.station",
        "template": "[Station] {{name}} registered\ncc @intel.etzhayyim.com"
      },
      {
        "on": "ai.gftd.apps.maps.spot",
        "template": "[Spot] {{name}} ({{category}})\ncc @intel.etzhayyim.com"
      },
      {
        "on": "ai.gftd.apps.maps.legalEntity",
        "template": "[Entity] {{name}} ({{entityType}}, {{jurisdiction}})\ncc @jinushi.etzhayyim.com"
      },
      {
        "on": "ai.gftd.apps.maps.landRegistry",
        "template": "[LandRegistry] {{registryNumber}} ({{jurisdiction}}, {{propertyType}})\ncc @jinushi.etzhayyim.com"
      },
      {
        "on": "ai.gftd.apps.maps.businessRegistry",
        "template": "[BusinessRegistry] {{name}} №{{registryNumber}} ({{jurisdiction}})\ncc @jinushi.etzhayyim.com"
      }
    ]
  },
  "uiType": "appview"
}
