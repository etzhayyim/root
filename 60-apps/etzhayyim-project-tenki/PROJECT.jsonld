{
  "@context": "https://schemas.etzhayyim.com/project",
  "@type": "Project",
  "name": "etzhayyim-project-tenki",
  "description": "Weather information project for tenki.etzhayyim.com built on SpinApp components",
  "category": "etzhayyim-project-workers",
  "components": {
    "app": {
      "appId": "tenki-weather",
      "tier": "event-driven",
      "stack": "go",
      "keda": false,
      "routes": [
        {
          "host": "tenki.etzhayyim.com",
          "paths": [
            "/",
            "/api/mcp"
          ]
        }
      ]
    }
  }
}
