<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- analyzeIntent -->
  <bpmn:process id="tia-analyze-intent" name="TIA Analyze Intent" isExecutable="true">
    <bpmn:startEvent id="start-analyze-intent"/>
    <bpmn:sequenceFlow id="sf-ai-1" sourceRef="start-analyze-intent" targetRef="task-analyze-intent"/>
    <bpmn:serviceTask id="task-analyze-intent" name="Analyze Intent">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.tia.analyzeIntent"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-ai-2" sourceRef="task-analyze-intent" targetRef="end-analyze-intent"/>
    <bpmn:endEvent id="end-analyze-intent"/>
  </bpmn:process>

  <!-- classifySignal -->
  <bpmn:process id="tia-classify-signal" name="TIA Classify Signal" isExecutable="true">
    <bpmn:startEvent id="start-classify-signal"/>
    <bpmn:sequenceFlow id="sf-cs-1" sourceRef="start-classify-signal" targetRef="task-classify-signal"/>
    <bpmn:serviceTask id="task-classify-signal" name="Classify Signal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.tia.classifySignal"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-cs-2" sourceRef="task-classify-signal" targetRef="end-classify-signal"/>
    <bpmn:endEvent id="end-classify-signal"/>
  </bpmn:process>

  <!-- extractEntities -->
  <bpmn:process id="tia-extract-entities" name="TIA Extract Entities" isExecutable="true">
    <bpmn:startEvent id="start-extract-entities"/>
    <bpmn:sequenceFlow id="sf-ee-1" sourceRef="start-extract-entities" targetRef="task-extract-entities"/>
    <bpmn:serviceTask id="task-extract-entities" name="Extract Entities">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.tia.extractEntities"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-ee-2" sourceRef="task-extract-entities" targetRef="end-extract-entities"/>
    <bpmn:endEvent id="end-extract-entities"/>
  </bpmn:process>

  <!-- scoreRisk -->
  <bpmn:process id="tia-score-risk" name="TIA Score Risk" isExecutable="true">
    <bpmn:startEvent id="start-score-risk"/>
    <bpmn:sequenceFlow id="sf-sr-1" sourceRef="start-score-risk" targetRef="task-score-risk"/>
    <bpmn:serviceTask id="task-score-risk" name="Score Risk">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.tia.scoreRisk"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-sr-2" sourceRef="task-score-risk" targetRef="end-score-risk"/>
    <bpmn:endEvent id="end-score-risk"/>
  </bpmn:process>

  <!-- generateSummary -->
  <bpmn:process id="tia-generate-summary" name="TIA Generate Summary" isExecutable="true">
    <bpmn:startEvent id="start-generate-summary"/>
    <bpmn:sequenceFlow id="sf-gs-1" sourceRef="start-generate-summary" targetRef="task-generate-summary"/>
    <bpmn:serviceTask id="task-generate-summary" name="Generate Summary">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.tia.generateSummary"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gs-2" sourceRef="task-generate-summary" targetRef="end-generate-summary"/>
    <bpmn:endEvent id="end-generate-summary"/>
  </bpmn:process>

  <!-- lookupProfile -->
  <bpmn:process id="tia-lookup-profile" name="TIA Lookup Profile" isExecutable="true">
    <bpmn:startEvent id="start-lookup-profile"/>
    <bpmn:sequenceFlow id="sf-lp-1" sourceRef="start-lookup-profile" targetRef="task-lookup-profile"/>
    <bpmn:serviceTask id="task-lookup-profile" name="Lookup Profile">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.tia.lookupProfile"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lp-2" sourceRef="task-lookup-profile" targetRef="end-lookup-profile"/>
    <bpmn:endEvent id="end-lookup-profile"/>
  </bpmn:process>

  <!-- submitFeedback -->
  <bpmn:process id="tia-submit-feedback" name="TIA Submit Feedback" isExecutable="true">
    <bpmn:startEvent id="start-submit-feedback"/>
    <bpmn:sequenceFlow id="sf-sf-1" sourceRef="start-submit-feedback" targetRef="task-submit-feedback"/>
    <bpmn:serviceTask id="task-submit-feedback" name="Submit Feedback">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.tia.submitFeedback"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-sf-2" sourceRef="task-submit-feedback" targetRef="end-submit-feedback"/>
    <bpmn:endEvent id="end-submit-feedback"/>
  </bpmn:process>

  <!-- getInsights -->
  <bpmn:process id="tia-get-insights" name="TIA Get Insights" isExecutable="true">
    <bpmn:startEvent id="start-get-insights"/>
    <bpmn:sequenceFlow id="sf-gi-1" sourceRef="start-get-insights" targetRef="task-get-insights"/>
    <bpmn:serviceTask id="task-get-insights" name="Get Insights">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.tia.getInsights"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gi-2" sourceRef="task-get-insights" targetRef="end-get-insights"/>
    <bpmn:endEvent id="end-get-insights"/>
  </bpmn:process>

</bpmn:definitions>
