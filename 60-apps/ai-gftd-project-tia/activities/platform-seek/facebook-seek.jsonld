{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://gftd.ai/tia/activities#",
    "id": "@id",
    "type": "@type",
    "dct": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "name": "dct:title",
    "description": "dct:description",
    "consumer": {
      "@id": "tia:consumer",
      "@type": "@id"
    },
    "producer": {
      "@id": "tia:producer",
      "@type": "@id"
    },
    "measure": {
      "@id": "tia:measure",
      "@container": "@set"
    },
    "rule": {
      "@id": "tia:rule",
      "@container": "@set"
    },
    "condition": {
      "@id": "tia:condition",
      "@container": "@set"
    },
    "realizes": {
      "@id": "prov:wasInfluencedBy",
      "@type": "@id"
    },
    "project": {
      "@id": "tia:project",
      "@type": "@id"
    },
    "uses": {
      "@id": "prov:used",
      "@type": "@id",
      "@container": "@set"
    },
    "extends": {
      "@id": "rdfs:subClassOf",
      "@type": "@id"
    },
    "searchUrl": "tia:searchUrl",
    "platform": "tia:platform"
  },
  "id": "https://gftd.ai/tia/activities/platform-seek/facebook-seek",
  "type": "tia:Activity",
  "name": "Facebook Account Seek",
  "description": "Facebookプラットフォームでの保護対象アカウント探索活動",
  "extends": "https://gftd.ai/tia/activities/account-seek",
  "consumer": "https://gftd.ai/tia/performers/actors/seeker",
  "producer": "https://gftd.ai/tia/performers/systems/recorder",
  "realizes": "https://gftd.ai/tia/capabilities/monitoring",
  "project": "https://gftd.ai/tia/resources/schemas/projects",
  "platform": "facebook",
  "searchUrl": "https://www.facebook.com/search/top/?q={accountName}",
  "uses": [
    "https://gftd.ai/tia/resources/internet-account",
    "https://gftd.ai/tia/ports/services/graphql",
    "https://gftd.ai/tia/performers/systems/recorder#chrome-extension"
  ],
  "measure": [
    {
      "id": "measure_facebook_seek_coverage",
      "name": "Facebook Seek Coverage",
      "description": "Facebookでの探索対象アカウントのカバレッジ",
      "target": "> 80%"
    },
    {
      "id": "measure_facebook_screenshot_quality",
      "name": "Facebook Screenshot Quality",
      "description": "Facebook検索結果ページのスクリーンショット品質",
      "target": "> 90%"
    }
  ],
  "rule": [
    {
      "id": "rule_facebook_manual_only",
      "name": "Facebook Manual Collection Only",
      "description": "Facebookは自動スクレイピング禁止のため手動収集のみ",
      "severity": "error"
    },
    {
      "id": "rule_facebook_search_url_format",
      "name": "Facebook Search URL Format",
      "description": "検索URLは https://www.facebook.com/search/top/?q={accountName} 形式である必要がある",
      "severity": "warning"
    }
  ],
  "condition": [
    {
      "id": "condition_facebook_account_name",
      "name": "Facebook Account Name",
      "description": "探索対象のFacebookアカウント名が必要",
      "type": "prerequisite"
    }
  ]
}
