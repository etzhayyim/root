  "dct:title": "Storyboard Editor (Ghibli Style)",
  "dct:description": "ジブリスタイルの絵コンテ編集アプリ。storyboard.jsonldを編集・更新できるSvelte + Go + Temporal + MCP + gRPCアプリ",
  "dct:created": "2026-01-23",
  "gh:status": "completed",
  "gh:architecture": {
    "frontend": "SvelteKit 5 + ConnectRPC (connect-web)",
    "backend": "Go + ConnectRPC (connect-go) + Temporal",
    "protocol": "gRPC (via ConnectRPC)",
    "dataFormat": "JSON-LD"
  },
  "gh:components": [
    {
      "@id": "gh:component/storyboard-service",
      "dct:title": "StoryboardService",
      "gh:methods": [
        "LoadStoryboard",
        "UpdatePanel",
        "SaveStoryboard",
        "GetEpisodes",
        "GetEpisodePanels",
        "StreamUpdates"
      ]
    },
    {
      "@id": "gh:component/storyboard-editor-ui",
      "dct:title": "StoryboardEditor UI",
      "gh:features": [
        "4-column Ghibli-style layout (カット/画/内容/秒)",
        "Panel editing (double-click to edit)",
        "Episode/page navigation",
        "Real-time JSON-LD updates"
      ]
    },
    {
      "@id": "gh:component/temporal-workflows",
      "dct:title": "Temporal Workflows",
      "gh:workflows": [
        "StoryboardUpdateWorkflow"
      ]
