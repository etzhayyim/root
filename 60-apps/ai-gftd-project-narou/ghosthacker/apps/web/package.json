{
  "name": "storyboard-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --threshold error",
    "typecheck": "tsc --noEmit && svelte-kit sync && svelte-check --threshold error",
    "dev:backend": "export WORKSPACE_ROOT=../../.. && export PORT=8081 && cd backend && go run cmd/server/main.go",
    "dev:worker": "export WORKSPACE_ROOT=../../.. && cd backend && go run cmd/worker/main.go",
    "buf:generate": "cd backend && buf generate"
  },
  "devDependencies": {
    "@atproto/api": "^0.13.35",
    "@bufbuild/protobuf": "^2.11.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^25.6.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1",
    "@types/marked": "^6.0.0",
    "html2canvas": "^1.4.1",
    "lucide-svelte": "^0.562.0",
    "marked": "^17.0.1"
  }
}
