{
  "@context": {
    "@base": "https://gftd.ai/ghost-hacker/",
    "schema": "https://schema.org/",
    "gh": "https://gftd.ai/gh#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "Season": "gh:Season",
    "Episode": "gh:Episode",
    "Arc": "gh:Arc",
    "Motif": "gh:Motif",
    "Person": "schema:Person",
    "hasArc": {
      "@id": "gh:hasArc",
      "@type": "@id"
    },
    "hasEpisode": {
      "@id": "gh:hasEpisode",
      "@type": "@id"
    },
    "hasCharacter": {
      "@id": "gh:hasCharacter",
      "@type": "@id"
    },
    "hasMotif": {
      "@id": "gh:hasMotif",
      "@type": "@id"
    },
    "precedes": {
      "@id": "gh:precedes",
      "@type": "@id"
    },
    "sameAs": {
      "@id": "schema:sameAs",
      "@type": "@id"
    },
    "name": {
      "@id": "schema:name"
    },
    "description": {
      "@id": "schema:description"
    }
  },
  "@graph": [
    {
      "@id": "gh:Ontology",
      "@type": "owl:Ontology",
      "name": "Ghost Hacker Story Ontology (Lite)"
    },
    {
      "@id": "gh:hasEpisode",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "Season"
      },
      "rdfs:range": {
        "@id": "Episode"
      }
    },
    {
      "@id": "gh:hasArc",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "Episode"
      },
      "rdfs:range": {
        "@id": "Arc"
      }
    },
    {
      "@id": "gh:hasCharacter",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "Episode"
      },
      "rdfs:range": {
        "@id": "Person"
      }
    },
    {
      "@id": "gh:hasMotif",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "Episode"
      },
      "rdfs:range": {
        "@id": "Motif"
      }
    },
    {
      "@id": "gh:precedes",
      "@type": "owl:TransitiveProperty",
      "rdfs:domain": {
        "@id": "Episode"
      },
      "rdfs:range": {
        "@id": "Episode"
      }
    },
    {
      "@id": "gh:Season/1",
      "@type": "Season",
      "name": "Season 1"
    },
    {
      "@id": "gh:Season/2",
      "@type": "Season",
      "name": "Season 2"
    },
    {
      "@id": "gh:Season/3",
      "@type": "Season",
      "name": "Season 3"
    },
    {
      "@id": "gh:Season/4",
      "@type": "Season",
      "name": "Season 4"
    },
    {
      "@id": "gh:Season/5",
      "@type": "Season",
      "name": "Season 5"
    },
    {
      "@id": "gh:Season/6",
      "@type": "Season",
      "name": "Season 6"
    },
    {
      "@id": "gh:Episode/S1E1",
      "@type": "Episode",
      "name": "The Loneliness of a Physicist",
      "hasArc": [
        {
          "@id": "gh:Arc/Loneliness-Archipelago"
        },
        {
          "@id": "gh:Arc/Case-E01"
        }
      ],
      "hasCharacter": [
        {
          "@id": "character:tamaki"
        },
        {
          "@id": "character:Nei-chan"
        },
        {
          "@id": "character:kaede"
        },
        {
          "@id": "character:hibiki"
        },
        {
          "@id": "character:elias"
        },
        {
          "@id": "character:logos"
        }
      ],
      "hasMotif": [
        {
          "@id": "gh:Motif/Library"
        },
        {
          "@id": "gh:Motif/NonSeparation"
        },
        {
          "@id": "gh:Motif/Water"
        }
      ]
    },
    {
      "@id": "gh:Episode/S2E1",
      "@type": "Episode",
      "name": "The Fear of Immortality",
      "hasArc": [
        {
          "@id": "gh:Arc/TamakiGrowth"
        }
      ],
      "hasCharacter": [
        {
          "@id": "character:tamaki"
