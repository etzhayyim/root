        {
          "@id": "character:Nei-chan"
        },
        {
          "@id": "character:arjun-patel"
        },
        {
          "@id": "character:dualist"
        }
      ],
      "hasMotif": [
        {
          "@id": "gh:Motif/Reincarnation"
        },
        {
          "@id": "gh:Motif/GoodFeeling"
        }
      ],
      "precedes": {
        "@id": "gh:Episode/S3E1"
      }
    },
    {
      "@id": "gh:Episode/S3E1",
      "@type": "Episode",
      "name": "代償の可視化",
      "hasArc": [
        {
          "@id": "gh:Arc/NeiChanDebt"
        }
      ],
      "hasCharacter": [
        {
          "@id": "character:tamaki"
        },
        {
          "@id": "character:Nei-chan"
        }
      ],
      "hasMotif": [
        {
          "@id": "gh:Motif/Debt"
        }
      ],
      "precedes": {
