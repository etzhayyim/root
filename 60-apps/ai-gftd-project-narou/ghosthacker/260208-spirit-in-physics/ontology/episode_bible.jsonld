    { "@id": "gh:Season/3:outline3", "@type": "Episode", "episodeNumber": 3, "season": {"@id": "gh:Season/3"},
      "name": "S3E3: 魂の外科手術",
      "logline": "魂の癒着（Complex）の切除。Hibikiの“麻酔”とDr.イタコの執刀で、“家”の鎖はほどけ、愛は非分離へ戻る。",
      "hasArc": [ {"@id": "gh:Arc/TamakiGrowth"} ],
