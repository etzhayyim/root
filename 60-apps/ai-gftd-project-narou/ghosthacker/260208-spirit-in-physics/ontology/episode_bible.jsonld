    { "@id": "gh:Episode/S1E1", "@type": "Episode",
      "episodeNumber": 1,
      "season": {"@id": "gh:Season/1"},
      "name": "Episode 1: The Fear of Individuality",
      "logline": "Ghost Hackerタマキは、自らの死を恐れる孤独な物理学者の精神に潜り、生命が個人を超えた『meme』の繋がりであることを解き明かす。",
      "hasArc": [ {"@id": "gh:Arc/Case-E01"}, {"@id": "gh:Arc/Loneliness-Archipelago"} ],
      "antagonist": [ {"@id": "character:lonely-rationalist"}, {"@id": "ghost:silent-librarian"} ],
      "motifRefs": [
        {"@id": "gh:Motif/Library"}, {"@id": "gh:Motif/Light"}, {"@id": "gh:Motif/Static"}, {"@id": "gh:Motif/NonSeparation"}, {"@id": "gh:Motif/Water"}, {"@id": "gh:Motif/Meme"}, {"@id": "gh:Motif/Gene"}
      ],
      "hasCharacter": [
        {"@id": "character:tamaki"}, {"@id": "character:Nei-chan"}, {"@id": "character:kaede"}, {"@id": "character:hibiki"}, {"@id": "character:elias"}, {"@id": "character:logos"}
      ],
      "hasScene": [
        {"@id": "gh:Scene/Opening/op01"}, {"@id": "gh:Scene/Opening/op02"}, {"@id": "gh:Scene/Opening/op03"}, {"@id": "gh:Scene/Opening/op04"}, {"@id": "gh:Scene/Opening/op05"}, {"@id": "gh:Scene/Opening/op06"}, {"@id": "gh:Scene/Opening/op07"}, {"@id": "gh:Scene/Opening/op08"}, {"@id": "gh:Scene/Opening/op09"}, {"@id": "gh:Scene/Opening/op10"}, {"@id": "gh:Scene/Opening/op11"}
      ],
      "source": {"@id": "gh:Source/ep1"}
    },

