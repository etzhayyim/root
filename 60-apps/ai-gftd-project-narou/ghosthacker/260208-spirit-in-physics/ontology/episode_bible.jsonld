    { "@id": "gh:Episode/S2E1", "@type": "Episode",
      "episodeNumber": 1,
      "season": {"@id": "gh:Season/2"},
      "name": "Episode 1: The Fear of Immortality",
      "logline": "タマキは、無限の輪廻を恐れるクライアントと対峙し、自らが「いい感じ」を追求する理由——次の宇宙をより良くするため——を語る。",
      "hasArc": [ {"@id": "gh:Arc/TamakiGrowth"} ],
      "antagonist": [ {"@id": "character:dualist"} ],
      "motifRefs": [ {"@id": "gh:Motif/Reincarnation"}, {"@id": "gh:Motif/GoodFeeling"} ],
      "hasCharacter": [ {"@id": "character:tamaki"}, {"@id": "character:Nei-chan"}, {"@id": "character:arjun-patel"}, {"@id": "character:dualist"} ],
      "source": {"@id": "gh:Source/ep_new_dualist"}
    },

    { "@id": "gh:Timeline/Akito", "@type": "Timeline", "name": "Akito年代記",
      "description": "Off-Thread: アキトの人生の出来事と啓示の年表。",
      "influences": [ {"@id": "gh:Episode/S1E1"}, {"@id": "gh:Episode/S2E1"} ],
      "source": {"@id": "gh:Source/akito-timeline"}
    },

    { "@id": "gh:Season/3:outline", "@type": "Episode", "episodeNumber": 1, "season": {"@id": "gh:Season/3"},
      "name": "S3E1: 自由と愛",
      "logline": "『あなたはどこからどこまで？』— コップの水の問いを通じて、自己と世界の境界がほどける。ジョン・ロックの『自己所有』から“わかれていない”への橋渡し。",
      "hasArc": [ {"@id": "gh:Arc/TamakiGrowth"} ],
      "antagonist": [ {"@id": "character:lachlan-keyes"}, {"@id": "ghost:john-locke"} ] },
    { "@id": "gh:Season/3:outline2", "@type": "Episode", "episodeNumber": 2, "season": {"@id": "gh:Season/3"},
      "name": "S3E2: 友達と親友、家族の経済",
      "logline": "100円の水から"冷蔵庫"の共有へ— Tamakiの問いと行為で開示が進み、他人/友達/家族の経済を行き来しながら『信用・信頼・愛』と"拡張された自己"に気づく（セッション予約はMillia）",
      "hasArc": [ {"@id": "gh:Arc/TamakiGrowth"} ],
      "antagonist": [ {"@id": "character:leo-kazan"}, {"@id": "character:millia-stuart"}, {"@id": "ghost:adam-smith"}, {"@id": "ghost:js-mill"}, {"@id": "ghost:the-ancestors-chain"} ],
      "gh:context": {
        "gh:sessionBookedBy": {"@id": "character:millia-stuart"},
        "gh:promptingStyle": "tamakiQuestions",
        "gh:disclosurePolicy": "clientDoesNotSelfDisclose",
        "gh:familyContrast": [
          {"@id": "character:leo-kazan", "gh:familySupport": true},
          {"@id": "character:millia-stuart", "gh:familyIssue": "家父長制起因の癒着（秘匿）"}
        ]
      },
      "gh:emotionalPlan": {
        "@type": "gh:EmotionalPlan",
        "gh:beats": [
          {
            "@type": "gh:EmotionalBeat",
            "gh:position": 1,
            "gh:targetEmotions": {
              "curiosity": 0.25,
              "surprise": 0.20,
              "anticipation": 0.15
            }
          },
          {
            "@type": "gh:EmotionalBeat",
            "gh:position": 2,
            "gh:targetEmotions": {
              "curiosity": 0.20,
              "surprise": 0.25,
              "anticipation": 0.20
            }
          },
          {
            "@type": "gh:EmotionalBeat",
