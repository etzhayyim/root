@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix gh: <https://ghosthacker.junkawasaki.com/gh#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Episode Part structural constraints (validated against episode-structure.jsonld)
gh:EpisodePartShape a sh:NodeShape ;
  sh:targetClass gh:EpisodePart ;
  sh:property [ sh:path gh:episode ; sh:minCount 1 ] ;
  sh:property [ sh:path gh:position ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
  # wordCountは "reading units"（CJKは約2文字=1単位、非CJKは空白区切り語数）
  # 言語によって下限を分岐（jaは>=600、その他>=800）
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "wordCount (reading units) must be within language-aware bounds" ;
    sh:select """
      PREFIX gh: <https://ghosthacker.junkawasaki.com/gh#>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT ?this WHERE {
        ?this gh:wordCount ?wc .
        OPTIONAL { ?this gh:language ?lang }
        BIND(xsd:integer(?wc) AS ?w)
        FILTER(
          (
            bound(?lang) && ?lang = "ja" && ( ?w < 600 || ?w > 1500 )
          ) || (
            (!bound(?lang) || ?lang != "ja") && ( ?w < 800 || ?w > 1500 )
          )
        )
      }
    """
  ] ;
  sh:property [ sh:path gh:beatsCount ; sh:datatype xsd:integer ; sh:minInclusive 1 ] .

# Ensure part1 has antagonist block annotated
gh:EpisodePartAntagonistShape a sh:NodeShape ;
  sh:targetClass gh:EpisodePart ;
  sh:rule [ a sh:TripleRule ; sh:subject sh:this ; sh:predicate gh:position ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "part1 must include JSON-LD antagonist block." ;
    sh:select """
      PREFIX gh: <https://ghosthacker.junkawasaki.com/gh#>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT ?this WHERE {
        ?this gh:position ?p .
        FILTER(xsd:integer(?p) = 1)
        FILTER NOT EXISTS { ?this gh:antagonistBlock ?ab . FILTER(?ab = true) }
      }
    """
  ] .


# Dialogue quality (lightweight, optional if properties absent)
gh:DialogueRatioShape a sh:NodeShape ;
  sh:targetClass gh:EpisodePart ;
  sh:property [ sh:path gh:dialogueRatio ; sh:minInclusive 0.50 ; sh:maxInclusive 0.75 ;
    sh:message "対話比率は50–75%に" ] .

gh:TurnDensityShape a sh:NodeShape ;
  sh:targetClass gh:EpisodePart ;
  sh:property [ sh:path gh:turnsPer200RU ; sh:minInclusive 6 ; sh:maxInclusive 12 ;
    sh:message "200RUあたりターン数は6–12に" ] .

gh:MicroTurnShape a sh:NodeShape ;
  sh:targetClass gh:EpisodePart ;
  sh:property [ sh:path gh:microTurnCount ; sh:minInclusive 2 ; sh:maxInclusive 4 ;
    sh:message "各part 2–4の小転回" ] .

gh:AntagonistSubjectivityShape a sh:NodeShape ;
  sh:targetClass gh:EpisodePart ;
  sh:property [ sh:path gh:antagonistFirstPersonLines ; sh:minInclusive 6 ;
    sh:message "アンタゴニストの一人称発話を増やす" ] ;
  sh:property [ sh:path gh:antagonistAffectLines ; sh:minInclusive 3 ;
    sh:message "感情語を含む発話を確保" ] .

gh:ContextDripShape a sh:NodeShape ;
  sh:targetClass gh:EpisodePart ;
  sh:property [ sh:path gh:newProperNouns ; sh:maxInclusive 3 ;
    sh:message "新規固有名の導入は3件以内" ] .

gh:ASCShape a sh:NodeShape ;
  sh:targetClass gh:EpisodePart ;
  sh:property [ sh:path gh:ascCueCount ; sh:minInclusive 1 ;
    sh:message "各partにASC合図を1回以上" ] .

# Prompted disclosure policy (optional, validates only if metrics are present)
gh:PromptedDisclosureShape a sh:NodeShape ;
  sh:targetClass gh:EpisodePart ;
  sh:property [ sh:path gh:promptedDisclosureCount ; sh:minInclusive 1 ;
    sh:message "Tamakiの質問/行為による開示（prompted）を最低1つ" ] ;
  sh:property [ sh:path gh:unpromptedDisclosureCount ; sh:maxInclusive 0 ;
    sh:message "クライアントの無誘導の自己開示は避ける（0推奨）" ] .

