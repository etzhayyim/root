{
  "@context": {
    "@base": "https://ghosthacker.junkawasaki.com/",
    "gh": "https://ghosthacker.junkawasaki.com/gh#",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "EmotionAnalysis": "gh:EmotionAnalysis",
    "EmotionProfile": "gh:EmotionProfile",
    "EmotionScore": "gh:EmotionScore",
    "EmotionTrajectory": "gh:EmotionTrajectory",
    "EmotionalPlan": "gh:EmotionalPlan",
    "EmotionalBeat": "gh:EmotionalBeat",
    "EmotionalBenchmark": "gh:EmotionalBenchmark",
    "EpisodeStructure": "gh:EpisodeStructure",
    "EpisodePart": "gh:EpisodePart",
    "ProcessScore": "gh:ProcessScore",
    "episode": {
      "@id": "gh:episode",
      "@type": "@id"
    },
    "part": {
      "@id": "gh:part",
      "@type": "@id"
    },
    "subject": {
      "@id": "gh:subject",
      "@type": "@id"
    },
    "emotionVector": {
      "@id": "gh:emotionVector",
      "@type": "@id"
    },
    "trajectory": {
      "@id": "gh:trajectory",
      "@type": "@id"
    },
    "emotion": {
      "@id": "gh:emotion",
      "@type": "xsd:string"
    },
    "score": {
      "@id": "gh:score",
      "@type": "xsd:float"
    },
    "position": {
      "@id": "gh:position",
      "@type": "xsd:integer"
    },
    "segmentText": {
      "@id": "gh:segmentText",
      "@type": "xsd:string"
    },
    "sourcePath": {
      "@id": "gh:sourcePath",
      "@type": "xsd:string"
    },
    "language": {
      "@id": "gh:language",
      "@type": "xsd:string"
    },
    "createdAt": {
      "@id": "gh:createdAt",
      "@type": "xsd:dateTime"
    },
    "emotionalPlan": {
      "@id": "gh:emotionalPlan",
      "@type": "@id"
    },
    "beats": {
      "@id": "gh:beats",
      "@type": "@id"
    },
    "targetEmotions": {
      "@id": "gh:targetEmotions",
      "@type": "@id"
    },
    "wordCount": {
      "@id": "gh:wordCount",
      "@type": "xsd:integer"
    },
    "readingUnits": {
      "@id": "gh:readingUnits",
      "@type": "xsd:integer"
    },
    "beatsCount": {
      "@id": "gh:beatsCount",
      "@type": "xsd:integer"
    },
    "antagonistBlock": {
      "@id": "gh:antagonistBlock",
      "@type": "xsd:boolean"
    },
    "finalSimilarity": {
      "@id": "gh:finalSimilarity",
      "@type": "xsd:float"
    },
    "finalPenalties": {
      "@id": "gh:finalPenalties",
      "@type": "xsd:float"
    },
    "posGrowth": {
      "@id": "gh:posGrowth",
      "@type": "xsd:float"
    },
    "negDecline": {
      "@id": "gh:negDecline",
      "@type": "xsd:float"
    },
    "smoothness": {
      "@id": "gh:smoothness",
      "@type": "xsd:float"
    },
    "processScore": {
      "@id": "gh:processScore",
      "@type": "xsd:float"
    },
    "hasEmotionProfile": {
      "@id": "gh:hasEmotionProfile",
      "@type": "@id"
    },
    "hasStructure": {
      "@id": "gh:hasStructure",
      "@type": "@id"
    },
    "hasProcessScore": {
      "@id": "gh:hasProcessScore",
      "@type": "@id"
    },
    "conformsTo": {
      "@id": "gh:conformsTo",
      "@type": "@id"
    },
    "benchmarkedAgainst": {
      "@id": "gh:benchmarkedAgainst",
      "@type": "@id"
    }
  },
  "@graph": [
    {
      "@id": "gh:EmotionAnalysis",
      "@type": "owl:Class",
      "rdfs:label": "Emotion Analysis",
      "rdfs:comment": "統合された感情分析結果。エピソードの感情プロファイル、構造、スコアを関連付ける。"
    },
    {
      "@id": "gh:EmotionProfile",
      "@type": "owl:Class",
      "rdfs:label": "Emotion Profile",
      "rdfs:comment": "テキストセグメント（文、段落、パート、エピソード）の感情プロファイル。"
    },
    {
      "@id": "gh:EmotionScore",
      "@type": "owl:Class",
      "rdfs:label": "Emotion Score",
      "rdfs:comment": "特定の感情の強度スコア（0.0-1.0）。"
    },
    {
      "@id": "gh:EmotionTrajectory",
      "@type": "owl:Class",
      "rdfs:label": "Emotion Trajectory",
      "rdfs:comment": "時系列での感情の変化（trajectory）。"
    },
    {
      "@id": "gh:ProcessScore",
      "@type": "owl:Class",
      "rdfs:label": "Process Score",
      "rdfs:comment": "感情プロセス全体の評価スコア。最終状態、成長、遷移の滑らかさを含む。"
    },
    {
      "@id": "gh:EpisodeStructure",
      "@type": "owl:Class",
      "rdfs:label": "Episode Structure",
      "rdfs:comment": "エピソードの構造メトリクス（語数、Beat数、antagonist注釈など）。"
    },
    {
      "@id": "gh:hasEmotionProfile",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": "gh:Episode",
      "rdfs:range": "gh:EmotionProfile",
      "rdfs:label": "has emotion profile",
      "rdfs:comment": "エピソードが持つ感情プロファイル。"
    },
    {
      "@id": "gh:hasStructure",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": "gh:Episode",
      "rdfs:range": "gh:EpisodeStructure",
      "rdfs:label": "has structure",
      "rdfs:comment": "エピソードが持つ構造メトリクス。"
    },
    {
      "@id": "gh:hasProcessScore",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": "gh:Episode",
      "rdfs:range": "gh:ProcessScore",
      "rdfs:label": "has process score",
      "rdfs:comment": "エピソードが持つプロセススコア。"
    },
    {
      "@id": "gh:conformsTo",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": "gh:EmotionProfile",
      "rdfs:range": "gh:EmotionalPlan",
      "rdfs:label": "conforms to",
      "rdfs:comment": "感情プロファイルが準拠する感情計画。"
    },
    {
      "@id": "gh:benchmarkedAgainst",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": "gh:ProcessScore",
      "rdfs:range": "gh:EmotionalBenchmark",
      "rdfs:label": "benchmarked against",
      "rdfs:comment": "プロセススコアが比較されるベンチマーク。"
    }
  ]
}
