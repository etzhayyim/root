        },
        {
          "@id": "character:hibiki"
        },
        {
          "@id": "character:lachlan-keyes"
        }
      ]
    },
    {
      "@id": "gh:Episode/S3E1",
      "@type": "Episode",
      "episodeNumber": 5,
      "season": {
        "@id": "gh:Season/3"
      },
      "name": "二人の水面",
      "logline": "共依存カップルLeoとMillia。愛と依存の違いを見つける旅が始まる。",
      "hasArc": [
        {
          "@id": "gh:Arc/Love"
        },
        {
          "@id": "gh:Arc/NeiChanGrowth"
        }
      ],
      "client": [
        {
          "@id": "character:leo-kazan"
        },
        {
          "@id": "character:millia-stuart"
        }
      ],
      "fixedMeme": "救済者コンプレックス（Leo）、自己犠牲による愛の証明（Millia）",
      "atmosphere": "川霧の朝、キッチンの温かさ、コーヒーの香り、静かな緊張",
      "healingApproach": "関係性の中の自己を見つめる",
      "keyDialogue": "愛って何？——信頼と依存は、どう違う？",
      "realization": "本当の愛は、相手を「救う」ことではない",
      "motifRefs": [
        {
          "@id": "gh:Motif/Water"
        },
        {
          "@id": "gh:Motif/Light"
        }
      ],
