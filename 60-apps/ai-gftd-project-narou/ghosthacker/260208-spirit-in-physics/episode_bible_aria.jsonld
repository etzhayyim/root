    {
      "@id": "gh:Episode/S4E2",
      "@type": "Episode",
      "episodeNumber": 8,
      "season": {
        "@id": "gh:Season/4"
      },
      "name": "魂の外科",
      "logline": "家系の癒着（Complex）を抱える人。Hibikiの音とDr.イタコの導きで、家の鎖がほどける。",
      "hasArc": [
        {
          "@id": "gh:Arc/Forgiveness"
        }
      ],
      "atmosphere": "静かな夜の運河、蛍の光、遠くの虫の声、深い静寂",
      "healingApproach": "祖霊の鎖を解きほぐす——愛が非分離へ戻る",
      "keyDialogue": "家族の愛は、時に鎖になる。でも、鎖はほどける",
      "realization": "愛は所有ではない。愛は、わかれていないこと",
      "motifRefs": [
        {
          "@id": "gh:Motif/Sound"
        },
        {
          "@id": "gh:Motif/Light"
        },
        {
          "@id": "gh:Motif/NonSeparation"
        }
      ],
