    {
      "@id": "gh:Episode/S4E1",
      "@type": "Episode",
      "episodeNumber": 7,
      "season": {
        "@id": "gh:Season/4"
      },
      "name": "組織の人",
      "logline": "企業の不正に巻き込まれた人の心。正しさだけでは呼吸ができない。",
      "hasArc": [
        {
          "@id": "gh:Arc/Forgiveness"
        }
      ],
      "atmosphere": "オフィス街の夜景、静かなビルの隙間、街灯の下の孤独",
      "healingApproach": "正義と赦しの間を歩く",
      "keyDialogue": "正しさは大事。でも、呼吸が先",
      "realization": "赦しは相手のためではなく、自分のための解放",
      "motifRefs": [
        {
          "@id": "gh:Motif/Light"
        },
        {
          "@id": "gh:Motif/Breath"
