    {
      "@id": "gh:Episode/S3E2",
      "@type": "Episode",
      "episodeNumber": 6,
      "season": {
        "@id": "gh:Season/3"
      },
      "name": "冷蔵庫の経済学",
      "logline": "他人・友達・家族の経済の違い。拡張された自己への気づき。",
      "hasArc": [
        {
          "@id": "gh:Arc/Love"
