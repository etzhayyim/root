        },
        {
          "@id": "character:Nei-chan"
        },
        {
          "@id": "character:kaede"
        },
        {
          "@id": "character:hibiki"
        }
      ],
      "hasScene": [
        {
          "@id": "gh:Scene/S1E1/morning"
        },
        {
          "@id": "gh:Scene/S1E1/breakfast"
        },
        {
          "@id": "gh:Scene/S1E1/canal"
        }
      ]
    },
    {
      "@id": "gh:Episode/S1E2",
      "@type": "Episode",
      "episodeNumber": 2,
      "season": {
        "@id": "gh:Season/1"
      },
      "name": "図書館の静けさ",
      "logline": "孤独な物理学者Eliasとの出会い。死への恐怖を、memeの繋がりで解きほぐす。",
      "hasArc": [
        {
          "@id": "gh:Arc/Encounter"
        }
      ],
      "client": {
        "@id": "character:elias"
      },
      "fixedMeme": "個としての死への恐怖、知識が消えることへの執着",
      "atmosphere": "古い図書館、天まで届く書架、埃の中を踊る光、本の香り",
      "healingApproach": "対話による気づき——memeは個人を超えて流れ続ける",
      "keyDialogue": "死は終わりじゃない。ただの変化なのにね",
      "realization": "私たちはmemeを通じて繋がっている。孤独は幻想",
      "motifRefs": [
        {
          "@id": "gh:Motif/Light"
        },
        {
          "@id": "gh:Motif/Meme"
        },
        {
          "@id": "gh:Motif/NonSeparation"
        },
        {
          "@id": "gh:Motif/Notebook"
        }
      ],
      "hasCharacter": [
        {
          "@id": "character:tamaki"
        },
        {
          "@id": "character:Nei-chan"
        },
        {
          "@id": "character:elias"
        },
        {
          "@id": "character:logos"
        }
      ]
    },
    {
      "@id": "gh:Episode/S2E1",
      "@type": "Episode",
      "episodeNumber": 3,
      "season": {
        "@id": "gh:Season/2"
      },
      "name": "無限回廊の人",
      "logline": "無限の輪廻を恐れるDualist。自己と宇宙の境界が融ける体験へ導く。",
      "hasArc": [
        {
          "@id": "gh:Arc/Breath"
        }
      ],
      "client": {
        "@id": "character:dualist"
      },
      "fixedMeme": "個別の存在としての自己への執着、終わりなき輪廻への恐怖",
      "atmosphere": "夕暮れの運河、水面に映る無限の空、オレンジと紫のグラデーション",
      "healingApproach": "境界の融解——あなたは宇宙の一部",
      "keyDialogue": "境界は、幻想。あなたは形を変えながら、ずっと在り続ける",
      "realization": "死も生も、ただの波。自己と世界はわかれていない",
      "motifRefs": [
        {
          "@id": "gh:Motif/Water"
        },
        {
          "@id": "gh:Motif/NonSeparation"
        },
        {
          "@id": "gh:Motif/Breath"
        }
      ],
      "hasCharacter": [
        {
          "@id": "character:tamaki"
        },
        {
          "@id": "character:Nei-chan"
        },
        {
          "@id": "character:dualist"
        }
      ]
    },
    {
      "@id": "gh:Episode/S2E2",
      "@type": "Episode",
      "episodeNumber": 4,
      "season": {
        "@id": "gh:Season/2"
      },
      "name": "壁の中の宇宙飛行士",
      "logline": "元宇宙飛行士Lachlan。コップの水の問いで、自己と世界の境界がほどける。",
      "hasArc": [
        {
          "@id": "gh:Arc/Breath"
        }
      ],
      "client": {
        "@id": "character:lachlan-keyes"
      },
      "fixedMeme": "身体を唯一の所有物とする自己所有論、感情を切り離すことで生き延びた過去",
      "atmosphere": "夕立上がりの渋谷、光る路面、静かな夜、遠くのメトロノームの音",
      "healingApproach": "問いかけによる気づき——コップの水はあなた？",
      "keyDialogue": "あなたは、どこからどこまで？",
      "realization": "わかれていない。水も、空気も、私も",
      "motifRefs": [
        {
          "@id": "gh:Motif/Water"
        },
        {
          "@id": "gh:Motif/NonSeparation"
        },
        {
          "@id": "gh:Motif/Breath"
        },
        {
          "@id": "gh:Motif/Sound"
        }
      ],
      "hasCharacter": [
