  "@graph": [
    {
      "@id": "gh:SeriesStyle",
      "@type": "aria:StyleGuide",
      "name": "ARIA-Style Ghost Healer",
      "description": "水の都を舞台に、対話と空気感で心を癒すヒーリング・ストーリー",
      "aria:coreElements": [
        "静謐な水辺の風景",
        "やわらかな自然光",
        "ゆっくりと流れる時間",
        "日常の何気ない会話",
        "深い気づきへの導き",
        "戦わずして解きほぐす"
      ],
      "aria:forbiddenElements": [
        "バトル・戦闘シーン",
        "敵対的なGhost",
        "勝敗・対決構造",
        "緊迫した危機的状況",
        "暴力的な解決"
      ]
    },
    {
      "@id": "gh:Season/1",
      "@type": "Season",
      "name": "Season 1: 出会いの水脈",
      "theme": "孤独から繋がりへ——Ghost Healerとしての始まり",
      "featuredThemes": [
        "孤独",
        "繋がり",
        "meme",
        "非分離"
      ],
      "atmosphere": "春の運河、朝霧と新緑、出会いの予感"
    },
    {
      "@id": "gh:Season/2",
      "@type": "Season",
      "name": "Season 2: 呼吸の水路",
      "theme": "恐れを手放す——呼吸で解きほぐす心",
      "featuredThemes": [
        "恐れ",
        "呼吸",
        "境界",
        "変容"
      ],
      "atmosphere": "初夏の夕暮れ、水面に映る空、静かな変化"
    },
    {
      "@id": "gh:Season/3",
      "@type": "Season",
      "name": "Season 3: 愛の水鏡",
      "theme": "依存から自由へ——本当の繋がりを見つける",
      "featuredThemes": [
        "愛",
        "依存",
        "信頼",
        "自由"
      ],
      "atmosphere": "梅雨の川霧、温かいキッチン、関係性の深まり"
    },
    {
      "@id": "gh:Season/4",
      "@type": "Season",
      "name": "Season 4: 正義の水底",
      "theme": "赦しの源へ——傷ついた心を癒す",
      "featuredThemes": [
        "正義",
        "赦し",
        "制度",
        "解放"
      ],
      "atmosphere": "秋の夜長、月光と蛍、内省の時間"
    },
    {
      "@id": "gh:Season/5",
      "@type": "Season",
      "name": "Season 5: 名の水源",
      "theme": "問いの深みへ——存在の本質を探る",
      "featuredThemes": [
        "名",
        "存在",
        "I AM",
        "非二元"
      ],
      "atmosphere": "冬の夜明け、星と静寂、哲学的な深み"
    },
    {
      "@id": "gh:Season/6",
      "@type": "Season",
      "name": "Season 6: I AM の海",
      "theme": "統合と主体化——全ての旅の収束",
      "featuredThemes": [
        "統合",
        "主体",
        "I AM",
        "日常への回帰"
      ],
      "atmosphere": "早春の朝、最初と同じ風景、しかし深まった視点"
    },
    {
      "@id": "gh:Arc/Encounter",
      "@type": "Arc",
      "name": "出会いと気づき",
      "spansSeasons": [
        {
          "@id": "gh:Season/1"
        }
      ],
      "description": "孤独を抱えた人々との出会い、Ghost Healerとしての第一歩"
    },
    {
      "@id": "gh:Arc/Breath",
      "@type": "Arc",
      "name": "呼吸と解放",
      "spansSeasons": [
        {
          "@id": "gh:Season/2"
        }
      ],
      "description": "恐れに囚われた心を、呼吸で解きほぐす"
    },
    {
      "@id": "gh:Arc/Love",
      "@type": "Arc",
      "name": "愛と自由",
      "spansSeasons": [
        {
          "@id": "gh:Season/3"
        }
      ],
      "description": "依存と愛の違いを見つける旅"
    },
    {
      "@id": "gh:Arc/Forgiveness",
      "@type": "Arc",
      "name": "赦しと癒し",
      "spansSeasons": [
        {
          "@id": "gh:Season/4"
        }
      ],
      "description": "社会や家系の傷を癒す"
    },
    {
      "@id": "gh:Arc/Inquiry",
      "@type": "Arc",
      "name": "問いと深化",
      "spansSeasons": [
        {
          "@id": "gh:Season/5"
        }
      ],
      "description": "存在の本質を問う哲学的な旅"
    },
    {
      "@id": "gh:Arc/Integration",
      "@type": "Arc",
      "name": "統合と回帰",
      "spansSeasons": [
        {
          "@id": "gh:Season/6"
        }
      ],
      "description": "全ての気づきが日常に溶け込む"
    },
    {
      "@id": "gh:Arc/NeiChanGrowth",
      "@type": "Arc",
      "name": "Nei-chanの成長",
      "spansSeasons": [
        {
          "@id": "gh:Season/1"
        },
        {
          "@id": "gh:Season/2"
        },
        {
          "@id": "gh:Season/3"
        },
        {
          "@id": "gh:Season/4"
        },
        {
          "@id": "gh:Season/5"
        },
        {
          "@id": "gh:Season/6"
        }
      ],
      "description": "愛とアイデンティティを学ぶNei-chanの物語"
    },
    {
      "@id": "gh:Motif/Water",
      "@type": "Motif",
      "name": "水",
      "description": "運河、雨、霧、コップの水——境界がない、流れる、形を変えるメタファー"
    },
    {
      "@id": "gh:Motif/Light",
      "@type": "Motif",
      "name": "光",
      "description": "朝日、夕日、月光、蛍——気づき、温かさ、希望のメタファー"
    },
    {
      "@id": "gh:Motif/Breath",
      "@type": "Motif",
      "name": "呼吸",
      "description": "いい感じの呼吸、今ここにいることの確認"
    },
    {
      "@id": "gh:Motif/Sound",
      "@type": "Motif",
      "name": "音",
      "description": "Hibikiの処方箋、運河の波音、鳥の声、風鈴"
    },
    {
      "@id": "gh:Motif/Notebook",
      "@type": "Motif",
      "name": "手帳",
      "description": "Tamakiの気づきを記す手帳、各話の終わりに一行"
    },
    {
      "@id": "gh:Motif/NonSeparation",
      "@type": "Motif",
      "name": "非分離",
      "description": "わかれていない——全ての核心となる気づき"
    },
    {
      "@id": "gh:Motif/GoodFeeling",
      "@type": "Motif",
      "name": "いい感じ",
      "description": "Tamakiの哲学、全ての基盤"
    },
    {
      "@id": "gh:Motif/Meme",
      "@type": "Motif",
      "name": "meme",
      "description": "文化・思想の流れ、個を超えた繋がり"
    },
    {
      "@id": "gh:Motif/Canal",
      "@type": "Motif",
      "name": "運河",
      "description": "水の都の象徴、ARIAの世界観"
    },
    {
      "@id": "gh:Episode/S1E1",
      "@type": "Episode",
      "episodeNumber": 1,
      "season": {
        "@id": "gh:Season/1"
      },
      "name": "水の都の朝",
      "logline": "運河の朝霧の中、TamakiとNei-chanの一日が始まる。いい感じでいることの大切さ。",
      "hasArc": [
        {
          "@id": "gh:Arc/Encounter"
        }
      ],
      "atmosphere": "運河の朝霧、橙色の日の出、やわらかな光、静かな街の目覚め",
      "healingApproach": "日常の描写、チームの紹介",
      "keyDialogue": "いい感じでいる——呼吸を一つ置き、私の足場を確認する",
      "realization": "全ての始まりは「いい感じ」から",
      "motifRefs": [
        {
          "@id": "gh:Motif/Water"
        },
        {
          "@id": "gh:Motif/Light"
        },
        {
          "@id": "gh:Motif/GoodFeeling"
