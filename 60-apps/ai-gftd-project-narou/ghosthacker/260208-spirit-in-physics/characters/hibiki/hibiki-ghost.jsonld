{
  "@context": {
    "@base": "https://gftd.ai/ghost-hacker/",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "gh": "https://gftd.ai/gh#",
    "Person": "https://schema.org/Person",
    "Ghost": "gh:Ghost",
    "Ability": "gh:Ability",
    "name": {
      "@id": "schema:name",
      "@type": "xsd:string"
    },
    "description": {
      "@id": "schema:description",
      "@type": "xsd:string"
    },
    "ghostType": {
      "@id": "gh:ghostType",
      "@type": "xsd:string"
    },
    "master": {
      "@id": "gh:master",
      "@type": "@id"
    },
    "hasAbility": {
      "@id": "gh:hasAbility",
      "@type": "@id"
    },
    "sameAs": {
      "@id": "schema:sameAs",
      "@type": "@id"
    },
    "fullText": {
      "@id": "gh:fullText",
      "@type": "xsd:string"
    }
  },
  "@graph": [
    {
      "@id": "ghost:serpente-da-floresta",
      "@type": [
        "Person",
        "Ghost"
      ],
      "name": "Serpente da Floresta",
      "ghostType": "自然共生型",
      "description": "アマゾン起源の植物・自然由来データと共生する蛇型Ghost。幻覚的データで精神構造を可視化・再構築する。",
      "master": {
        "@id": "character:hibiki"
      },
      "hasAbility": [
        {
          "@id": "gh:Ability/HallucinatoryInjection",
          "@type": "Ability",
          "name": "幻覚データ注入",
          "description": "対象Ghostの構造を可視化し再構築へ導く。"
        }
      ],
      "fullText": "(ヒビキ本体の md に統合済み)"
    }
  ],
  "gh:image": [
    {
      "@id": "gh:Image/Character/hibiki/portrait_gen4"
    }
  ]
}
