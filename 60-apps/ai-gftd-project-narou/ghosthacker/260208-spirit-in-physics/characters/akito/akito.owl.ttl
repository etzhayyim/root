@prefix gh: <https://gftd.ai/gh#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .

# Classes
gh:Ghost a rdfs:Class ; rdfs:label "Ghost"@en .
gh:Ability a rdfs:Class ; rdfs:label "Ability"@en .
gh:PortraitPrompt a rdfs:Class ; rdfs:label "Portrait Prompt"@en .

# Properties
gh:master a rdf:Property ;
  rdfs:label "master"@en ;
  rdfs:domain gh:Ghost ;
  rdfs:range schema:Person .

gh:ghostType a rdf:Property ;
  rdfs:label "ghost type"@en ;
  rdfs:domain gh:Ghost ;
  rdfs:range xsd:string .

gh:hasAbility a rdf:Property ;
  rdfs:label "has ability"@en ;
  rdfs:domain gh:Ghost ;
  rdfs:range gh:Ability .

gh:appearance a rdf:Property ;
  rdfs:label "appearance"@en ;
  rdfs:domain gh:Ghost , gh:PortraitPrompt ;
  rdfs:range xsd:string .

gh:subject a rdf:Property ;
  rdfs:label "subject"@en ;
  rdfs:domain gh:PortraitPrompt ;
  rdfs:range xsd:string .

gh:style a rdf:Property ;
  rdfs:label "style"@en ;
  rdfs:domain gh:PortraitPrompt ;
  rdfs:range xsd:string .

gh:lighting a rdf:Property ;
  rdfs:label "lighting"@en ;
  rdfs:domain gh:PortraitPrompt ;
  rdfs:range xsd:string .

gh:composition a rdf:Property ;
  rdfs:label "composition"@en ;
  rdfs:domain gh:PortraitPrompt ;
  rdfs:range xsd:string .

gh:quality a rdf:Property ;
  rdfs:label "quality"@en ;
  rdfs:domain gh:PortraitPrompt ;
  rdfs:range xsd:string .


