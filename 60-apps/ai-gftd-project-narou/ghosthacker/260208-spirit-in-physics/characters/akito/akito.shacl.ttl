@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix gh: <https://gftd.ai/gh#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .

# Ghost shape
gh:GhostShape a sh:NodeShape ;
  sh:targetClass gh:Ghost ;
  sh:property [ sh:path gh:ghostType ; sh:datatype xsd:string ; sh:minCount 1 ] ;
  sh:property [ sh:path gh:master ; sh:class schema:Person ; sh:minCount 1 ] ;
  sh:property [ sh:path gh:hasAbility ; sh:node gh:AbilityShape ; sh:minCount 1 ] ;
  sh:property [ sh:path gh:appearance ; sh:datatype xsd:string ; sh:minCount 1 ] .

# Ability shape
gh:AbilityShape a sh:NodeShape ;
  sh:targetClass gh:Ability ;
  sh:property [ sh:path <https://schema.org/name> ; sh:datatype xsd:string ; sh:minCount 1 ] ;
  sh:property [ sh:path <https://schema.org/description> ; sh:datatype xsd:string ; sh:minCount 1 ] .

# Portrait prompt shape
gh:PortraitPromptShape a sh:NodeShape ;
  sh:targetClass gh:PortraitPrompt ;
  sh:property [ sh:path <https://schema.org/about> ; sh:minCount 1 ] ;
  sh:property [ sh:path gh:subject ; sh:datatype xsd:string ; sh:minCount 1 ] ;
  sh:property [ sh:path gh:appearance ; sh:datatype xsd:string ; sh:minCount 1 ] ;
  sh:property [ sh:path gh:style ; sh:datatype xsd:string ; sh:minCount 1 ] ;
  sh:property [ sh:path gh:lighting ; sh:datatype xsd:string ; sh:minCount 1 ] ;
  sh:property [ sh:path gh:composition ; sh:datatype xsd:string ; sh:minCount 1 ] ;
  sh:property [ sh:path gh:quality ; sh:datatype xsd:string ; sh:minCount 1 ] .


