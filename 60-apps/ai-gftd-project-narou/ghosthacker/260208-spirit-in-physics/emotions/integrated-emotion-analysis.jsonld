                  "emotion": "hope",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 6,
              "segmentText": "Kaede「彼はそれで生き延びた。でも今は……それが彼を閉じ込めてる」\n\n私は壁に触れる。冷たさは温度ではなく、意味の欠落だ。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
