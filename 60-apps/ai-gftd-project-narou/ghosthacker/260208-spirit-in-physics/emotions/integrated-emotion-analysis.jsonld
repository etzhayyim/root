                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 4,
              "segmentText": "Nei-chan『この壁、もう“守ってない”。閉じ込めてる』\n\nKaedeの声が通信に入る。彼女の声には、深い理解がある。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
