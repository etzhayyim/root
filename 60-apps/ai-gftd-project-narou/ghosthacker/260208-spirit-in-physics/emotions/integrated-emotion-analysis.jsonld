              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 5,
              "segmentText": "Kaede「ジョン・ロックの自己所有……身体を唯一の所有物とする哲学。絶対境界」\n\n彼女は少し間を置く。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
