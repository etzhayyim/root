                  "emotion": "relief",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "hope",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 6,
              "segmentText": "Aoi「十分。今日はここまででいい」\n私はうなずく。胸の緊張がほどけ、安堵が広がる。小さな笑顔が返ってくる。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "relief",
                  "score": 1
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
