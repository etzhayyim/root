              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 14,
              "segmentText": "「……私は、わかっていなかったんだな」\n\nメトロノームの音が近づき、セッションの終わりを告げる。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
