                },
                {
                  "@type": "EmotionScore",
                  "emotion": "surprise",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "trust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "disgust",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 2,
              "segmentText": "「信じて、待とう。いっしょに」\n光の網が低く鳴り、部屋に静けさが敷かれる。遠くで水音。私は短く神楽を一拍。今日のスロットルを閉じる合図。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "hope",
                  "score": 0.5357
                },
