            {
              "@type": "EmotionProfile",
              "position": 4,
              "segmentText": "Kaede「今朝の気圧は……安定してる」\n\n彼女の声は静かだが、緊張が滲んでいる。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
