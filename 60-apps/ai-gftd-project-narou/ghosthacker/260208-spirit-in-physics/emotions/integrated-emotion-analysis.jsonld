                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 12,
              "segmentText": "彼は胸に手を当て、一歩だけ前へ出る。閉じていた拳がほどけ、指先が震えた。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
