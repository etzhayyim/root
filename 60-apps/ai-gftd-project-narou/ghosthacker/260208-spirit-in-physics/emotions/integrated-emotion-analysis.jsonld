                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 3,
              "segmentText": "夜の帯域、いい感じだよ。ピークカットは入ってるけど、音は十分に流せる」\n\n彼の声には、いつもの陽気さがある。でも、少し真剣な響きも混じっている。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
