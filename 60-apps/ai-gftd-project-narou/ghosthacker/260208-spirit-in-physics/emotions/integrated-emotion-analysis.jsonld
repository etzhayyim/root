                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 13,
              "segmentText": "時間がゆっくり通過する。数刻分の体感。実際には、数分。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
