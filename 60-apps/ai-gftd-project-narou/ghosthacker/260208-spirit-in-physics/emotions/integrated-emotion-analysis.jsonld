                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 8,
              "segmentText": "敵は“ゾンビ・ループ”——誰の意思でもない排除の規範だ。私はそれを一つずつ外していく。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
