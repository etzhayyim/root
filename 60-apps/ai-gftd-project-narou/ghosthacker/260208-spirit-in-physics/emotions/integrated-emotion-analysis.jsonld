                  "emotion": "disgust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "relief",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 5,
              "segmentText": "冷たい完璧は下がり、やわらかな信頼が入ってくる。静けさが合図になる。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "trust",
                  "score": 1
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
                  "score": 0
                },
