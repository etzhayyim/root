                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 3,
              "segmentText": "「この時代は“AIに生命権を認めるか”で揉めてる。だが私は反対だ」\n\n「わかった。今日はあなたの話を聞く」\n\n彼は肩をすくめる。「聞いて、どうなる？」\n\n少し間を置いて、私はコップを指した。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
                  "score": 0
                },
                {
