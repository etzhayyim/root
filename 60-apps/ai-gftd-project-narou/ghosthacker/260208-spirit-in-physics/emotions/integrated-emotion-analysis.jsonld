                  "emotion": "hope",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 6,
              "segmentText": "それとも縛るため？」\n\nAoiの喉仏が上下する。正直さは強さだ。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
