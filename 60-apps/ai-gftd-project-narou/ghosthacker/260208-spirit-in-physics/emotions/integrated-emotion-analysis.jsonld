                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "hope",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 15,
              "segmentText": "彼は静かに頭を下げる。「ありがとう。そして、すまなかった」\n\nNei-chanが小さく微笑む。『うん。ここから』\n\n---\n\n小さな回想が、彼の口から零れた。幼少期、鉱山町。硬い父、厳格な母。身体を鍛え、感情を削ることで生き延びた年月。軌道上の“完全な分離”は、彼が最後に手に入れた安息だった。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0.5
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "hope",
                  "score": 0.5
                },
