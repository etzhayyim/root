            {
              "@type": "EmotionProfile",
              "position": 2,
              "segmentText": "Kaede「今は彼に集中。マップは後で見る」\n\nNei-chan『タマ、呼吸いっしょに』\n\n壁が崩れ、彼は初めて本当の姿を見せる。震え、そして泣く。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
                  "score": 1
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "fear",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "anger",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "surprise",
                  "score": 0
