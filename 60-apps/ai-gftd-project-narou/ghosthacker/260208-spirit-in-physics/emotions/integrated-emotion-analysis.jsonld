                  "@type": "EmotionScore",
                  "emotion": "hope",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 9,
              "segmentText": "「あなたは“身体の自由”を、失うことで生き延びた。だから心も、自由を諦めた」\n\n彼は苛立ちを滲ませる。「あなたのGhostはAIです。生命ではない。裏切らないのは、意思がないからだ。プログラムだ」\n\nNei-chanの羽が震える。私は彼女の手を握る。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "relief",
                  "score": 1
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "fear",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "anger",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "surprise",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "trust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "anticipation",
                  "score": 0
