      "@id": "gh:Scene/Opening/op01",
      "@type": "Scene",
      "name": "水の都",
      "orderInOpening": 1,
      "durationSeconds": 10,
      "hasCut": [
        {
          "@id": "gh:Scene/Opening/op01#start",
          "@type": "Cut",
          "phase": "start",
          "timeOfDay": "早朝",
          "place": "未来的東京、運河の上空",
          "emotion": "静寂、希望、世界の美しさ",
          "visualPrompt": "傑作、感情豊かな映画的アニメスタイル。水の都ベネチアと日本の近代建築が融合した、ガラス張りの超高層ビルが立ち並ぶ未来の東京の壮大なパノラマショット。街は透き通った青い運河が縦横に走り、鮮やかな空を完璧に反射している。ドラマチックな光、雲を貫く光芒が、都市全体の清潔で明るく、平和な雰囲気を強調している。"
        },
        {
          "@id": "gh:Scene/Opening/op01#end",
          "@type": "Cut",
          "phase": "end",
          "timeOfDay": "早朝",
          "place": "未来的東京、運河",
          "emotion": "都市の穏やかな生活感と、そこに流れる空気感",
          "visualPrompt": "傑作、インダストリアルデザイン。現代の洗練された路面電車のような、機能的で直線的なデザインの箱型水上バス（パブリッククルーザー）に焦点を合わせたショット。側面は全面ガラス張りで、多くの乗客のシルエットが見える。停留所で人々が乗り降りしており、都市の穏やかな生活感を切り取る。"
        }
      ],
      "musicCue": {
        "@id": "gh:Scene/Opening/op01#music",
        "@type": "MusicCue",
        "bpm": 70,
        "cueText": "幻想的で穏やかなアンビエント音楽。温かいシンセパッドと、シンプルで反響するピアノのメロディが続く。"
      },
      "sameAs": "scene:op01",
      "source": {
        "@id": "gh:Source/opening"
      }
    },
