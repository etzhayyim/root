@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix gh: <https://gftd.ai/gh#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Scene shape
gh:SceneDetailShape a sh:NodeShape ;
  sh:targetClass gh:Scene ;
  sh:property [
    sh:path gh:orderInOpening ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path gh:durationSeconds ;
    sh:datatype xsd:integer ;
    sh:minInclusive 1 ;
    sh:maxInclusive 20 ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path gh:hasCut ;
    sh:node gh:CutShape ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path gh:musicCue ;
    sh:node gh:MusicCueShape ;
    sh:minCount 1 ;
  ] .

# Cut shape
gh:CutShape a sh:NodeShape ;
  sh:targetClass gh:Cut ;
  sh:property [ sh:path gh:phase ; sh:datatype xsd:string ; sh:minCount 1 ] ;
  sh:property [ sh:path gh:timeOfDay ; sh:datatype xsd:string ; sh:minCount 1 ] ;
  sh:property [ sh:path gh:place ; sh:datatype xsd:string ; sh:minCount 1 ] ;
  sh:property [ sh:path gh:visualPrompt ; sh:datatype xsd:string ; sh:minCount 1 ] .

# Music cue shape
gh:MusicCueShape a sh:NodeShape ;
  sh:targetClass gh:MusicCue ;
  sh:property [ sh:path gh:bpm ; sh:datatype xsd:integer ; sh:minCount 0 ] ;
  sh:property [ sh:path gh:cueText ; sh:datatype xsd:string ; sh:minCount 1 ] .


