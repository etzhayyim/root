@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix gh: <https://gftd.ai/gh#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gh:ObjectDesignShape a sh:NodeShape ;
  sh:targetClass gh:ObjectDesign ;
  sh:property [ sh:path gh:concept ; sh:datatype xsd:string ; sh:minCount 1 ] ;
  sh:property [ sh:path gh:designPrinciples ; sh:minCount 1 ] ;
  sh:property [ sh:path gh:generationPrompt ; sh:datatype xsd:string ; sh:minCount 1 ] .

gh:VehicleDesignShape a sh:NodeShape ;
  sh:targetClass gh:VehicleDesign ;
  sh:property [ sh:path gh:propulsionSystem ; sh:datatype xsd:string ; sh:minCount 1 ] ;
  sh:property [ sh:path gh:structure ; sh:datatype xsd:string ; sh:minCount 1 ] ;
  sh:property [ sh:path gh:energy ; sh:datatype xsd:string ; sh:minCount 1 ] ;
  sh:property [ sh:path gh:interior ; sh:datatype xsd:string ; sh:minCount 1 ] .


