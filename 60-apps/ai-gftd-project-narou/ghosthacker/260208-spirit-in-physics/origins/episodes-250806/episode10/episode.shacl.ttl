@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix gh: <https://ghosthacker.junkawasaki.com/gh#> .
@prefix schema: <http://schema.org/> .

gh:EpisodeShape a sh:NodeShape ;
  sh:targetNode <https://gftd.ai/ghost-hacker/Episode/S1E10> ;
  sh:property [ sh:path schema:name ; sh:minCount 1 ] ;
  sh:property [ sh:path gh:hasCharacter ; sh:hasValue gh:character:tamaki ] ;
  sh:property [ sh:path gh:techRefs ; sh:hasValue gh:Tech/SIP ] ;
  sh:property [ sh:path gh:processRefs ; sh:hasValue gh:Process/MemorySpace1024D ] ;
  sh:property [ sh:path <https://gftd.ai/gh#programRefs> ; sh:minCount 1 ] .

