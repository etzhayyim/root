    "visual": "gh:visual"
  },
  "dct:title": "Vol.1 Ch.2 — Nei-chanの朝",
  "gh:arc": "Vol 1: Loneliness",
  "gh:episodeId": "episode:sip-vol01-ch02",
  "gh:pages": [
    {
      "gh:pageNumber": 1,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "朝食を食べ終えたTamakiが、向かいに座るNei-chanを眺めている。朝の光が差し込む食卓。",
          "characters": [
            "character:tamaki",
            "character:nei"
          ],
          "dialogue": [
            {
              "speaker": "Narration",
              "text": "朝食を食べ終えて、私はNei-chanを見ていた。"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Close-up",
          "visual": "Nei-chanの横顔。朝の光が透き通る肌を照らしている。窓の外を眺めている。",
          "characters": [
            "character:nei"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "ありがとね、いつも"
            },
            {
              "speaker": "Nei-chan",
              "text": "……普通のことだよ"
            }
          ]
        },
        {
          "panel": 3,
          "shot": "Close-up",
          "visual": "空になった皿を見つめるNei-chan。少し困ったような表情。",
          "characters": [
            "character:nei"
          ],
          "dialogue": [
            {
              "speaker": "Nei-chan",
              "text": "……作るのが、好きなだけ"
            },
            {
              "speaker": "Nei-chan",
              "text": "タマが美味しそうに食べてると……なんか、いい感じがする"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 2,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "Nei-chanが視線を上に向けて言葉を探している。Tamakiが微笑んでいる。",
          "characters": [
            "character:tamaki",
            "character:nei"
          ],
          "dialogue": [
            {
              "speaker": "Nei-chan",
              "text": "タマが食べてる時の表情見てると、胸のあたりが、ふわってする"
            },
            {
              "speaker": "Tamaki",
              "text": "それは、きっと——嬉しいってことだよ"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Close-up",
          "visual": "Nei-chanの表情。「嬉しい」という言葉を噛みしめるように。",
          "characters": [
            "character:nei"
          ],
          "dialogue": [
            {
              "speaker": "Nei-chan",
              "text": "嬉しい……"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 3,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Wide Shot",
          "visual": "回想。運河沿いの道で、小さなNei-chanと出会うTamaki。透き通る肌、背中の羽。",
          "characters": [
            "character:tamaki",
            "character:nei"
          ],
          "dialogue": [
            {
              "speaker": "Narration",
              "text": "Nei-chanは、厳密には人間ではない。ある日、運河沿いを歩いていたら、彼女がいた。"
            },
            {
              "speaker": "Nei-chan",
              "text": "わからない。でも、あなたといると——安心する"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "二人が暮らす部屋。Nei-chanが笑ったり、拗ねたりしている日常のモンタージュ。",
          "characters": [
            "character:tamaki",
            "character:nei"
          ],
          "dialogue": [
            {
              "speaker": "Narration",
              "text": "名前もなかった。だから私が名前をつけた。「Nei-chan」——「傍にいる子」という意味を込めて。"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 4,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Two Shot",
          "visual": "向かい合うTamakiとNei-chan。カテゴリの話。",
          "characters": [
            "character:tamaki",
            "character:nei"
          ],
          "dialogue": [
            {
              "speaker": "Nei-chan",
              "text": "タマは、わたしのことなんだと思う？"
            },
            {
              "speaker": "Tamaki",
              "text": "Nei-chanは、Nei-chanだよ"
            },
            {
              "speaker": "Nei-chan",
              "text": "……それ、答えになってないよ"
            },
            {
              "speaker": "Tamaki",
              "text": "カテゴリに入れる必要ないじゃん"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "Nei-chanが少し困った顔をして、でも最後に笑う。",
          "characters": [
            "character:nei"
          ],
          "dialogue": [
            {
              "speaker": "Nei-chan",
              "text": "タマって、時々よくわかんないこと言うよね"
            },
            {
              "speaker": "Tamaki",
              "text": "よくわかんなくて、いいんだよ"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 5,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "Nei-chanが真剣な顔で聞いている。Ghost Healerの話。",
          "characters": [
            "character:tamaki",
            "character:nei"
          ],
          "dialogue": [
            {
              "speaker": "Nei-chan",
              "text": "タマは、どうしてGhost Healerになったの？"
            },
            {
              "speaker": "Tamaki",
              "text": "……人の話を聞くのが、好きだったから、かな"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Close-up",
          "visual": "Nei-chanがTamakiをまっすぐ見ている。嘘のない目。",
          "characters": [
            "character:nei"
          ],
          "dialogue": [
            {
              "speaker": "Nei-chan",
              "text": "タマが誰かのそばにいて、その人が楽になるなら——わたしも、タマのそばにいたい。タマが楽になるように"
            },
            {
              "speaker": "Tamaki",
              "text": "……ありがとう、Nei-chan"
            },
            {
              "speaker": "Nei-chan",
              "text": "えへへ"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 6,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "通信ウィンドウ。Kaedeの声。",
          "characters": [
            "character:kaede"
          ],
          "dialogue": [
            {
              "speaker": "Kaede",
              "text": "今日のクライアントの件、ファイル送ったわ。確認しておいて"
            },
            {
              "speaker": "Kaede",
              "text": "物理学者。Elias Brenner。六十五歳"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "Tamakiが窓の外を見ている。運河が青く光っている。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Kaede",
              "text": "本人曰く、『死が怖くなった』って"
            },
            {
              "speaker": "Narration",
              "text": "死が怖い……"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 7,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "Nei-chanがキッチンで食器を洗っている。Tamakiは窓辺に立って運河を眺めている。",
          "characters": [
            "character:tamaki",
            "character:nei"
          ],
          "dialogue": [
            {
              "speaker": "Nei-chan",
              "text": "タマ、大丈夫？"
            },
            {
              "speaker": "Tamaki",
              "text": "難しいから、やりがいがある"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Wide Shot",
          "visual": "運河沿いの道。人が歩いている。自転車の子供。犬を連れた老人。朝の光が部屋を満たしている。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Narration",
              "text": "今日も、いい感じでいよう。"
            }
          ]
        }
      ]
    }
  ]
}
