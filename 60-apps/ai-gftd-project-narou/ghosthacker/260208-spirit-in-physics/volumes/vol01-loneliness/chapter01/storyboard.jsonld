  "@id": "gh:storyboard/sip-vol01-ch01",
  "@type": "gh:Storyboard",
  "schema:name": "Chapter 01 — 水の都の依頼",
  "gh:volume": "vol01-loneliness",
  "gh:episode": "EP1",
  "gh:part": "Part 1",
  "gh:beat": "Opening / Call / Team Setup",
  "gh:pageCount": 12,
  "gh:pages": [
    {
      "@type": "Page",
      "gh:pageNumber": 1,
      "layout": "splash",
      "gh:description": "見開き風スプラッシュ。水の都・東京2065の全景",
      "panels": [
        {
          "@type": "Panel",
          "gh:panelId": "01-01",
          "gh:size": "full-page",
          "camera": "extreme-wide / bird's-eye",
          "location": "水の都・東京2065、運河の全景",
          "gh:description": "海面上昇後の東京。運河が道路を置き換え、撤去された高架の跡は緑に覆われている。光の網が街に編み込まれ、静かな脈動がある。夕方の青い光。",
          "narration": "運河は青い。窓をなぞる指先の体温が、ガラス越しに街へ融けていく。",
          "characters": [],
          "emotion": "静寂、期待",
          "colorNote": "群青のウォッシュ。光の網は琥珀。紙の白を活かした透明感。"
        }
      ]
    },
    {
      "@type": "Page",
      "gh:pageNumber": 2,
      "layout": "3-panel-vertical",
      "gh:description": "Tamakiの導入。窓辺→足元→いい感じの準備",
      "panels": [
        {
          "@type": "Panel",
          "gh:panelId": "01-02a",
          "gh:size": "wide",
          "camera": "medium-shot / profile",
          "location": "Tamakiの部屋、窓辺",
          "gh:description": "Tamakiが窓ガラスに指を触れている。運河の反射が顔に揺れる。",
          "narration": "いい感じでいる——呼吸を一つ置き、私の足場を確認する。",
          "characters": ["tamaki"],
          "emotion": "内省、集中",
          "colorNote": "室内は灰白。窓の外だけ群青。ガラスの境界が二つの世界を分ける。"
        },
        {
          "@type": "Panel",
          "gh:panelId": "01-02b",
          "gh:size": "narrow",
          "camera": "close-up / feet",
          "gh:description": "Tamakiの足元。神楽の一拍。小さな振動が床を走る。",
          "narration": "Tree of Life（生命の樹）に錨を下ろす感覚。ここから始める。",
          "characters": ["tamaki"],
          "emotion": "覚悟、集中",
          "sfx": "神楽の一拍 → 水の波紋として視覚化"
        },
        {
          "@type": "Panel",
          "gh:panelId": "01-02c",
          "gh:size": "narrow",
          "camera": "close-up / Nei-chan on shoulder",
          "gh:description": "Nei-chanがTamakiの肩で光の羽をひとあおぎ。ASCの制御が合う瞬間。",
          "dialogue": [
            {"speaker": "Nei-chan", "text": "うん。タマ、今なら静かに潜れる"}
          ],
          "characters": ["tamaki", "nei"],
          "emotion": "信頼、安心"
        }
      ]
    },
    {
      "@type": "Page",
      "gh:pageNumber": 3,
      "layout": "4-panel-grid",
      "gh:description": "チームメンバーの声が入る。Kaede→Hibiki→準備完了",
      "panels": [
        {
          "@type": "Panel",
          "gh:panelId": "01-03a",
          "gh:size": "half",
          "camera": "medium-shot / comms overlay",
          "gh:description": "Kaedeの通信。半透明の通信ウィンドウ越し。",
          "dialogue": [
            {"speaker": "Kaede", "text": "汚染レベル、上がってる……"},
            {"speaker": "Kaede", "text": "Tamaki、慎重に。救急で言えば、これは"要注意"レベル"}
          ],
          "characters": ["kaede"],
          "emotion": "緊張、冷静"
        },
        {
          "@type": "Panel",
          "gh:panelId": "01-03b",
          "gh:size": "half",
          "camera": "medium-shot / warm tone",
          "gh:description": "Hibikiの周波数が部屋に流れ込む。温かい音色を光の粒子で表現。",
          "dialogue": [
            {"speaker": "Hibiki", "text": "Tudo bem, Tamaki。音の処方箋、調律したよ"}
          ],
          "characters": ["hibiki"],
          "emotion": "温かさ、陽気",
          "sfx": "Hibikiの低い周波 → 床を滑る光の粒子"
        },
        {
          "@type": "Panel",
          "gh:panelId": "01-03c",
          "gh:size": "half",
          "camera": "wide / room",
          "gh:description": "空気が柔らかくなった部屋。Nei-chanが光の羽をあおぐ。チーム全員の存在が感じられる。",
          "narration": "空気が少し柔らかくなる。",
          "characters": ["tamaki", "nei"],
          "emotion": "安堵"
        },
        {
          "@type": "Panel",
          "gh:panelId": "01-03d",
          "gh:size": "half",
          "camera": "close-up / holographic call",
          "gh:description": "半透明の着信。微細なノイズが散る。",
          "dialogue": [
            {"speaker": "Nei-chan", "text": "ToLのトリアージ担当から"}
          ],
          "characters": ["nei"],
          "emotion": "緊張の予兆",
          "colorNote": "ノイズは群青の細かい粒子として表現"
        }
      ]
    },
    {
      "@type": "Page",
      "gh:pageNumber": 4,
      "layout": "2-panel-horizontal",
      "gh:description": "Logosの登場。不安定な輪郭。",
      "panels": [
        {
          "@type": "Panel",
          "gh:panelId": "01-04a",
          "gh:size": "two-thirds",
          "camera": "medium-shot / frontal",
          "gh:description": "Logos登場。黒いスーツの青年。輪郭が不安定——灯が強いほど影が濃くなる。指先で円を描いて応答するTamaki。",
          "narration": "現れたのは、黒いスーツの青年——Logos。その輪郭は、灯が強いほど影が濃くなる絵のように不安定だった。",
          "characters": ["tamaki", "logos"],
          "emotion": "不穏、観察",
          "colorNote": "Logosの輪郭は二重線で揺れる。影が通常と逆方向。"
        },
        {
          "@type": "Panel",
          "gh:panelId": "01-04b",
          "gh:size": "one-third",
          "camera": "close-up / Nei-chan whisper",
          "gh:description": "Nei-chanがTamakiの意識にだけ聞こえる声で囁く。吹き出しなし、テキストが浮遊。",
          "dialogue": [
            {"speaker": "Nei-chan", "text": "タマ、この人、すごく「正しい」匂いがする。でも、なんで苦しいの？", "gh:style": "spirit-voice"}
          ],
          "characters": ["nei"],
          "emotion": "直感、疑問",
          "colorNote": "Nei-chanの声は手書き風フォント、半透明で浮遊"
        }
      ]
    },
    {
      "@type": "Page",
      "gh:pageNumber": 5,
      "layout": "3-panel-asymmetric",
      "gh:description": "Eliasの名前が与えられる。世界が輪郭を得る。",
      "panels": [
        {
          "@type": "Panel",
          "gh:panelId": "01-05a",
          "gh:size": "wide",
          "camera": "close-up / lips",
          "gh:description": "Logosの唇。「主は……Elias」と名を告げる瞬間。",
          "dialogue": [
            {"speaker": "Logos", "text": "主は……Elias"}
          ],
          "characters": ["logos"],
          "emotion": "荘厳、静か"
        },
        {
          "@type": "Panel",
          "gh:panelId": "01-05b",
          "gh:size": "medium",
          "camera": "medium-wide / room shift",
          "gh:description": "名が与えられた瞬間、部屋の空気が微かに変わる。輪郭が少しだけ明確になる。",
          "narration": "名が与えられた瞬間、世界は少し輪郭を得る。私はうなずき、簡潔に手順を確認する。聞く／整える／潜る。",
          "characters": ["tamaki"],
          "emotion": "集中、決意"
        },
        {
          "@type": "Panel",
          "gh:panelId": "01-05c",
          "gh:size": "small",
          "camera": "close-up / Nei-chan diagnostic",
          "gh:description": "Nei-chanの分析。精神の声として浮遊テキスト。",
          "dialogue": [
            {"speaker": "Nei-chan", "text": "彼のghostは、肉体の死とgeneの断絶を極端に恐れている。あなたという主体が消えることへの恐怖。それが彼のバグの核心みたい", "gh:style": "spirit-voice"}
          ],
          "characters": ["nei"],
          "emotion": "分析、理解"
        }
      ]
    },
    {
      "@type": "Page",
      "gh:pageNumber": 6,
      "layout": "2-panel-vertical",
      "gh:description": "Tamakiの哲学。Ghost Hackerの定義。",
      "panels": [
        {
          "@type": "Panel",
          "gh:panelId": "01-06a",
          "gh:size": "two-thirds",
          "camera": "medium-shot / reflective",
          "gh:description": "Tamakiが窓に背を預け、小さく息を吐く。運河の光が背後で揺れる。",
          "dialogue": [
            {"speaker": "Tamaki", "text": "死は終わりじゃない。ただの変化なのにね"},
            {"speaker": "Tamaki", "text": "私たちは、私たちのmemeを子や文化や社会に繋いでいく。そうやって、孤独からも解放される。彼の苦しみは、その繋がりが見えなくなっていること"}
          ],
          "characters": ["tamaki"],
          "emotion": "慈しみ、確信"
        },
        {
          "@type": "Panel",
          "gh:panelId": "01-06b",
          "gh:size": "one-third",
          "camera": "wide / conceptual",
          "gh:description": "抽象的なビジュアル。memeの流れを水彩の滲みで表現。個人の輪郭が水に溶けて繋がっていくイメージ。",
          "narration": "Ghost Hackerの仕事は、そういう固まったmemeを解放して、流れに戻すことだ。",
          "characters": [],
          "emotion": "概念的、広がり",
          "colorNote": "群青と琥珀の水彩が滲み合い、人の形が流れに溶ける抽象画。"
        }
      ]
    },
    {
      "@type": "Page",
      "gh:pageNumber": 7,
      "layout": "4-panel-vertical",
      "gh:description": "チーム準備の最終段階。神楽→Hibiki→Kaede→礼",
      "panels": [
        {
          "@type": "Panel",
          "gh:panelId": "01-07a",
          "gh:size": "narrow",
          "camera": "close-up / hand gesture",
          "gh:description": "Tamakiの神楽の一拍。スロットルを開ける。",
          "sfx": "神楽 → 空気の振動として可視化",
          "characters": ["tamaki"],
          "emotion": "集中"
        },
        {
          "@type": "Panel",
          "gh:panelId": "01-07b",
          "gh:size": "narrow",
          "camera": "medium / sound visualization",
          "gh:description": "Hibikiの低い周波が床を滑る。光の粒子が足元を流れる。",
          "narration": "Hibikiの低い周波が床を滑る。彼の音は、いつも優しく、安心感がある。",
          "characters": ["hibiki"],
          "emotion": "温かさ"
        },
        {
          "@type": "Panel",
          "gh:panelId": "01-07c",
          "gh:size": "narrow",
          "camera": "medium / precise movement",
          "gh:description": "Kaedeがセキュリティレールを敷設。救急医の迅速で確実な動き。",
          "narration": "Kaedeがセキュリティレールを敷設する。彼女の動きは、救急医のそれ——迅速で、確実。",
          "characters": ["kaede"],
          "emotion": "信頼、プロフェッショナル"
        },
        {
          "@type": "Panel",
          "gh:panelId": "01-07d",
          "gh:size": "narrow",
          "camera": "close-up / eye contact",
          "gh:description": "Tamakiが視線で礼を送る。アイコンタクト。",
          "narration": "いい感じは、だいたいチーム戦だ。独りで無理をしないのが、最良の勇気になる時がある。",
          "characters": ["tamaki"],
          "emotion": "感謝、連帯"
        }
      ]
    },
    {
      "@type": "Page",
      "gh:pageNumber": 8,
      "layout": "2-panel-dramatic",
      "gh:description": "ダイブへの決断。Logos との対話。",
      "panels": [
        {
          "@type": "Panel",
          "gh:panelId": "01-08a",
          "gh:size": "half",
          "camera": "two-shot / facing",
          "gh:description": "TamakiとLogosが向き合う。",
          "dialogue": [
            {"speaker": "Tamaki", "text": "行こう、Logos"},
            {"speaker": "Logos", "text": "Tamaki、僕は……主を救いたい"}
          ],
          "characters": ["tamaki", "logos"],
          "emotion": "決意、願い"
        },
        {
          "@type": "Panel",
          "gh:panelId": "01-08b",
          "gh:size": "half",
          "camera": "close-up / hands",
          "gh:description": "Tamakiの指先にフォトンが集まる。光の粒子が渦を巻く。目を閉じるTamaki。",
          "narration": "願いは矢印だ。矢印が揃えば、ダイブは安定する。私は目を閉じ、フォトンを指先に集めた。",
          "characters": ["tamaki"],
          "emotion": "集中、覚悟",
          "colorNote": "琥珀の光が指先から広がる。ページの白が琥珀に染まり始める。"
        }
      ]
    },
    {
      "@type": "Page",
      "gh:pageNumber": 9,
      "layout": "splash",
      "gh:description": "チャプター最終ページ。背後に潜むバグの暗示。",
      "panels": [
        {
          "@type": "Panel",
          "gh:panelId": "01-09",
          "gh:size": "full-page",
          "camera": "over-shoulder / into darkness",
          "gh:description": "Tamakiの背後。光の指先の先に広がる暗闇。その奥に、孤独を正当化する理性——静かなバグの気配。影の中に微かな図書館のシルエット。",
          "narration": "背後には、孤独を正当化する理性——静かなバグがいる。私はそれを忘れない。",
          "characters": ["tamaki"],
          "emotion": "緊張、予感",
          "colorNote": "上部は琥珀の光、下部は群青の深い闇。境界で二色が滲み合う。闇の中に図書館の書架のシルエットがうっすら。",
          "transition": "次章（Chapter02）の精神世界ダイブへ"
        }
      ]
    }
  ]
}
