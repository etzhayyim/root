  "dct:title": "Vol.1 Ch.4 — 夕暮れの運河",
  "gh:arc": "Vol 1: Loneliness",
  "gh:episodeId": "episode:sip-vol01-ch04",
  "gh:pages": [
    {
      "gh:pageNumber": 1,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Extreme Wide Shot",
          "visual": "夕暮れの運河。水面がオレンジと紫に染まっている。空が水の中に溶けているような境界の曖昧な風景。",
          "characters": [],
          "dialogue": [
            {
              "speaker": "Narration",
              "text": "夕暮れ。運河の水面が、オレンジと紫に染まっている。どこまでが空で、どこまでが水なのか——境界が曖昧になっていく時間。"
            }
          ],
          "environment": "env:water-city-tokyo-2065"
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "Tamakiが窓辺に立って風景を眺めている。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "きれい……"
            },
            {
              "speaker": "Narration",
              "text": "こういう瞬間が好きだ。一日が終わろうとして、夜が始まろうとする——その狭間の時間。"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 2,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Two Shot",
          "visual": "Nei-chanが窓際に来た。夕陽の光が彼女の羽を照らしてオレンジ色に輝いている。",
          "characters": [
            "character:tamaki",
            "character:nei"
          ],
          "dialogue": [
            {
              "speaker": "Nei-chan",
              "text": "タマ、空が——水に映ってる"
            },
            {
              "speaker": "Tamaki",
              "text": "どっちも本物だよ"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Close-up",
          "visual": "Nei-chanが首を傾げている。難しい顔。",
          "characters": [
            "character:nei"
          ],
          "dialogue": [
            {
              "speaker": "Nei-chan",
              "text": "でも、水面のは——本当の空じゃないよね"
            },
            {
              "speaker": "Tamaki",
              "text": "本当、って何だろうね"
            },
            {
              "speaker": "Nei-chan",
              "text": "……タマ、時々——よくわかんないこと言うね。でも——嫌いじゃない"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 3,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "Nei-chanが少し不安そうな顔をしている。",
          "characters": [
            "character:nei"
          ],
          "dialogue": [
            {
              "speaker": "Nei-chan",
              "text": "タマ、今日の人……ちょっと、変な感じがする"
            },
            {
              "speaker": "Nei-chan",
              "text": "怖がってるんだけど、何を怖がってるのか——わたしにも、わかんないの"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Close-up",
          "visual": "Nei-chanの目。何かを感じ取っている。",
          "characters": [
            "character:nei"
          ],
          "dialogue": [
            {
              "speaker": "Nei-chan",
              "text": "Eliasさんは——死ぬのが怖かった。自分が消えちゃうのが"
            },
            {
              "speaker": "Nei-chan",
              "text": "でも、今日の人は——消えないのが怖いみたい"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 4,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "通信が入る。Kaedeの声。いつもより緊張している。",
          "characters": [
            "character:kaede"
          ],
          "dialogue": [
            {
              "speaker": "Kaede",
              "text": "Tamaki、今日のクライアントについて——少し話がある"
            },
            {
              "speaker": "Kaede",
              "text": "彼は……Soraという名前。二十八歳。男性"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Close-up",
          "visual": "Tamakiがソファに座っている。Nei-chanが隣にいる。",
          "characters": [
            "character:tamaki",
            "character:nei"
          ],
          "dialogue": [
            {
              "speaker": "Kaede",
              "text": "彼は——死を恐れていない"
            },
            {
              "speaker": "Kaede",
              "text": "彼が恐れているのは——死ねないこと"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 5,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "Tamakiの表情。死ねないことを恐れるという言葉を噛みしめている。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Kaede",
              "text": "彼は——無限の輪廻を恐れている。終わりのない繰り返し。永遠に続く存在"
            },
            {
              "speaker": "Kaede",
              "text": "……Tamaki。彼は——とても繊細よ。言葉を、慎重に選んで"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "窓の外。夕陽が少しずつ沈んでいく。空がオレンジから紫へ。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "わかった。会ってみる"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 6,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "Hibikiの通信。",
          "characters": [
            "character:hibiki"
          ],
          "dialogue": [
            {
              "speaker": "Hibiki",
              "text": "Tamaki、今日の音——準備できたよ。波の音。ゆっくりした、穏やかな波"
            },
            {
              "speaker": "Hibiki",
              "text": "無限の輪廻——か。僕も、考えたことあるよ"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Close-up",
          "visual": "Hibikiの回想。ツアーで世界中を回っていた頃。同じステージ、同じ曲——でも全部違う。",
          "characters": [
            "character:hibiki"
          ],
          "dialogue": [
            {
              "speaker": "Hibiki",
              "text": "繰り返しに見えても——全部、違うってこと。同じ曲でも、同じステージでも——聴いてる人は違う"
            },
            {
              "speaker": "Hibiki",
              "text": "だから——繰り返しじゃないんだ。毎回、新しいんだ"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 7,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Wide Shot",
          "visual": "窓の外。夕陽がほとんど沈んだ。空は紫と藍色。最初の星が見え始めている。",
          "characters": [
            "character:tamaki",
            "character:nei"
          ],
          "dialogue": [
            {
              "speaker": "Nei-chan",
              "text": "タマ、そろそろ——来るよ"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "Tamakiが立ち上がる。玄関のチャイムが鳴る。深呼吸。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Narration",
              "text": "今日のクライアント。Sora。死ねないことを——恐れる人。"
            },
            {
              "speaker": "Narration",
              "text": "いい感じでいよう。ドアを開ける。"
            }
          ]
        }
      ]
    }
  ]
}
