{
  "@context": {
    "character": "gh:character/",
    "characters": "gh:characters",
    "dct": "http://purl.org/dc/terms/",
    "dialogue": "gh:dialogue",
    "env": "gh:environment/",
    "environment": "gh:environment",
    "gh": "https://ghosthacker.gftd.ai/ns/",
    "panel": "gh:panelIndex",
    "schema": "http://schema.org/",
    "shot": "gh:shotType",
    "speaker": "gh:speaker",
    "text": "gh:text",
    "visual": "gh:visual"
  },
  "dct:title": "Vol.1 Ch.5 — Soraとの出会い",
  "gh:arc": "Vol 1: Loneliness",
  "gh:episodeId": "episode:sip-vol01-ch05",
  "gh:pages": [
    {
      "gh:pageNumber": 1,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "ドアを開けると、痩せた男性が立っている。目の下に深い影。髪は少し乱れ、服装はきちんとしているが疲れた印象。",
          "characters": [
            "character:tamaki",
            "character:sora"
          ],
          "dialogue": [
            {
              "speaker": "Sora",
              "text": "……どうも"
            },
            {
              "speaker": "Tamaki",
              "text": "ようこそ。中へどうぞ"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "Soraが窓の外を見る。運河が夕陽の最後の光を反射している。",
          "characters": [
            "character:sora"
          ],
          "dialogue": [
            {
              "speaker": "Sora",
              "text": "……きれいですね"
            },
            {
              "speaker": "Tamaki",
              "text": "この時間が、一番好きなんです。昼と夜の境界が——曖昧になる時間だから"
            },
            {
              "speaker": "Sora",
              "text": "……境界が、曖昧……"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 2,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "ソファに座るSora。膝の上で組んだ手。指が震えている。Tamakiが向かいの椅子に座る。",
          "characters": [
            "character:tamaki",
            "character:sora"
          ],
          "dialogue": [
            {
              "speaker": "Narration",
              "text": "沈黙が流れた。一分。二分。三分——。私は急かさなかった。話したくなるまで、待つ。"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Close-up",
          "visual": "Soraの深い青色の目。その奥に恐怖がある。",
          "characters": [
            "character:sora"
          ],
          "dialogue": [
            {
              "speaker": "Sora",
              "text": "私は……おかしいんでしょうか"
            },
            {
              "speaker": "Sora",
              "text": "みんな、死を恐れる。でも私は……死ねないことが、怖いんです"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 3,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Close-up",
          "visual": "Soraの声が震えている。目に力がない。",
          "characters": [
            "character:sora"
          ],
          "dialogue": [
            {
              "speaker": "Sora",
              "text": "私は……永遠に続くんです。このまま、何度も、何度も。同じ人生を——違う人生を——永遠に"
            },
            {
              "speaker": "Sora",
              "text": "終わりが——ないんです。休めない。止まれない。ずっと、ずっと——続いていく"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Close-up",
          "visual": "Nei-chanがTamakiの耳元で囁く。",
          "characters": [
            "character:nei"
          ],
          "dialogue": [
            {
              "speaker": "Nei-chan",
              "text": "タマ……彼、すごく疲れてる。体も、心も……"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 4,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Two Shot",
          "visual": "TamakiとSoraが向き合っている。Tamakiが呼吸を合わせることを提案。",
          "characters": [
            "character:tamaki",
            "character:sora"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "今日は——ゆっくり話しましょう。急がなくていい"
            },
            {
              "speaker": "Sora",
              "text": "……いいんですか。私の話、聞いても——わからないと思いますよ"
            },
            {
              "speaker": "Tamaki",
              "text": "わからなくても、聞きます"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "TamakiがSoraに呼吸を合わせる見本を見せている。深く息を吸い、ゆっくり吐く。",
          "characters": [
            "character:tamaki",
            "character:sora"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "まず——呼吸を合わせましょう。深く吸って——ゆっくり吐いて"
            },
            {
              "speaker": "Sora",
              "text": "……こんなことで、何が変わるんですか？"
            },
            {
              "speaker": "Tamaki",
              "text": "呼吸が深くなると、心も——少しだけ、落ち着きます"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 5,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "柔らかい沈黙。さっきとは違う。窓の外で星が一つ見え始めている。",
          "characters": [
            "character:tamaki",
            "character:sora"
          ],
          "dialogue": [
            {
              "speaker": "Sora",
              "text": "私は……ずっと、考えていました。死んだら——どうなるのか"
            },
            {
              "speaker": "Sora",
              "text": "もし——死んでも、終わらなかったら。また——始まるんです。別の人生が"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Close-up",
          "visual": "Soraの目。恐怖と疲労。",
          "characters": [
            "character:sora"
          ],
          "dialogue": [
            {
              "speaker": "Sora",
              "text": "永遠に——繰り返す。終わりなく——続いていく。それが——私の恐怖なんです"
            },
            {
              "speaker": "Nei-chan",
              "text": "タマ、彼——輪廻を、牢獄だと思ってる"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 6,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Close-up",
          "visual": "Soraの回想。幼い頃の記憶。",
          "characters": [
            "character:sora"
          ],
          "dialogue": [
            {
              "speaker": "Sora",
              "text": "……子供の頃から、だと思います。祖母が——亡くなったとき"
            },
            {
              "speaker": "Sora",
              "text": "周りの人は言いました。『大丈夫、おばあちゃんは天国で待ってるよ』——と"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Close-up",
          "visual": "Soraの静かな声。涙が滲んでいる。",
          "characters": [
            "character:sora"
          ],
          "dialogue": [
            {
              "speaker": "Sora",
              "text": "永遠に待っている——ということは、永遠に——終わらないということだから"
            },
            {
              "speaker": "Sora",
              "text": "私は——天国を、牢獄のように感じたんです"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 7,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Close-up",
          "visual": "Soraの目に涙。",
          "characters": [
            "character:sora"
          ],
          "dialogue": [
            {
              "speaker": "Sora",
              "text": "……誰にも——言えませんでした"
            },
            {
              "speaker": "Sora",
              "text": "みんな——死を恐れているから。私だけが——違う。私だけが——おかしい"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "Tamakiが窓際に行く。運河を見下ろす。水面に星が映り始めている。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "あなたは——おかしくないですよ"
            },
            {
              "speaker": "Tamaki",
              "text": "恐怖は——人それぞれです。どちらも——人間として、自然な感情です"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 8,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Two Shot",
          "visual": "セッションの終わり。Soraが立ち上がる。窓の外の星を見ている。",
          "characters": [
            "character:tamaki",
            "character:sora"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "今日は——ここまでにしましょう。また、来てください"
            },
            {
              "speaker": "Sora",
              "text": "……星が、きれいですね"
            },
            {
              "speaker": "Sora",
              "text": "私——ずっと、星が怖かった。永遠に——輝いているように見えたから"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Close-up",
          "visual": "Tamakiの微笑み。Soraが小さく笑う。",
          "characters": [
            "character:tamaki",
            "character:sora"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "でも——星も、いつかは消えます。すべてのものには——終わりがある"
            },
            {
              "speaker": "Sora",
              "text": "……また、来ていいですか"
            },
            {
              "speaker": "Tamaki",
              "text": "いつでも"
            },
            {
              "speaker": "Sora",
              "text": "……ありがとう。Tamakiさん"
            }
          ]
        }
      ]
    }
  ]
}
