  "dct:title": "Vol.5 Ch.32 — いい感じの朝（日常）",
  "gh:arc": "Vol 5: Beyond",
  "gh:episodeId": "episode:sip-vol05-ch32",
  "gh:pages": [
    {
      "gh:pageNumber": 1,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Wide Shot",
          "visual": "運河の朝霧。。橙色の日の出。。最初の朝と、同じ風景。。でも、何かが——違う。",
          "characters": [],
          "dialogue": [
            {
              "speaker": "Narration",
              "text": "運河の朝霧。。橙色の日の出。。最初の朝と、同じ風景。。でも、何かが——違う。"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 2,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "私は窓辺に立っている。コーヒーの香りが、部屋を満たしている。。Nei-chanが私の隣に来る。",
          "characters": [
            "character:nei",
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "タマ、おはよう"
            },
            {
              "speaker": "Tamaki",
              "text": "おはよう、Nei-chan"
            },
            {
              "speaker": "Tamaki",
              "text": "今日は——何をするの？"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "私は窓の外を見る。運河の水面が、朝霧の中でゆっくりと輝いている。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "今日は——特別なことは、ないかな"
            },
            {
              "speaker": "Tamaki",
              "text": "ないの？"
            },
            {
              "speaker": "Tamaki",
              "text": "うん。でも——それが、いい"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 3,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "Kaedeの声が通信に入る。",
          "characters": [
            "character:kaede"
          ],
          "dialogue": [
            {
              "speaker": "Kaede",
              "text": "おはよう、Tamaki。今日は——静かな日よ"
            },
            {
              "speaker": "Kaede",
              "text": "うん"
            },
            {
              "speaker": "Kaede",
              "text": "クライアントは、いない。でも——それもいいわね"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "Hibikiの声が加わる。",
          "characters": [
            "character:hibiki"
          ],
          "dialogue": [
            {
              "speaker": "Hibiki",
              "text": "Tamaki、今日の音……静かだけど、満ちてる"
            },
            {
              "speaker": "Hibiki",
              "text": "満ちてる？"
            },
            {
              "speaker": "Hibiki",
              "text": "うん。何も起きてないけど、全部がある感じ"
            }
          ]
        },
        {
          "panel": 3,
          "shot": "Medium Shot",
          "visual": "私は微笑む。",
          "characters": [
            "character:hibiki"
          ],
          "dialogue": [
            {
              "speaker": "Hibiki",
              "text": "いい感じだね"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 4,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "Nei-chanが窓を見つめている。。私は考える。",
          "characters": [
            "character:nei",
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "タマ、この朝——前と同じ？"
            },
            {
              "speaker": "Tamaki",
              "text": "同じ風景。でも——違う"
            },
            {
              "speaker": "Tamaki",
              "text": "何が違うの？"
            },
            {
              "speaker": "Tamaki",
              "text": "見え方、かな"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "彼女は首を傾げる。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "見え方？"
            },
            {
              "speaker": "Tamaki",
              "text": "うん。同じ運河、同じ朝霧、同じ日の出。でも、私の中が——変わった"
            },
            {
              "speaker": "Tamaki",
              "text": "どう変わったの？"
            }
          ]
        },
        {
          "panel": 3,
          "shot": "Medium Shot",
          "visual": "私は深く息を吸う。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "……深くなった、かな"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 5,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Wide Shot",
          "visual": "朝霧が、少しずつ晴れていく。運河の水面が、はっきりと見えてくる。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "タマ、霧が晴れてきたよ"
            },
            {
              "speaker": "Tamaki",
              "text": "うん"
            },
            {
              "speaker": "Tamaki",
              "text": "でも、また明日も、霧が出るんでしょ？"
            },
            {
              "speaker": "Tamaki",
              "text": "多分ね"
            },
            {
              "speaker": "Tamaki",
              "text": "それって——繰り返し？"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "私は微笑む。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "繰り返しだけど、同じじゃない。毎日が——少しずつ、違う"
            },
            {
              "speaker": "Tamaki",
              "text": "違うの？"
            },
            {
              "speaker": "Tamaki",
              "text": "うん。私たちが、変わるから"
            }
          ]
        },
        {
          "panel": 3,
          "shot": "Medium Shot",
          "visual": "彼女は頷く。。運河の水面が、朝日を反射してきらめいている。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "じゃあ——明日の朝は、また違うんだね"
            },
            {
              "speaker": "Tamaki",
              "text": "うん。また違う"
            }
          ]
        }
      ]
    }
  ]
}
