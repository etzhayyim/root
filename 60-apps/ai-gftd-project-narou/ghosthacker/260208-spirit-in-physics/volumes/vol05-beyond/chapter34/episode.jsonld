  "dct:title": "Vol.5 Ch.34 — 次の朝へ（余韻）",
  "gh:arc": "Vol 5: Beyond",
  "gh:episodeId": "episode:sip-vol05-ch34",
  "gh:pages": [
    {
      "gh:pageNumber": 1,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Wide Shot",
          "visual": "夕暮れ。。空がオレンジ色に染まっている。一日が、終わろうとしている。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "タマ、今日——何もなかったけど、いい日だったね"
            },
            {
              "speaker": "Tamaki",
              "text": "うん。いい日だった"
            },
            {
              "speaker": "Tamaki",
              "text": "何もないのに、いいって——変じゃない？"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "私は微笑む。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "変じゃないよ。何もないことが——いいこと"
            },
            {
              "speaker": "Tamaki",
              "text": "どうして？"
            },
            {
              "speaker": "Tamaki",
              "text": "呼吸できるから"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 2,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "Kaedeの声が通信に入る。",
          "characters": [
            "character:kaede"
          ],
          "dialogue": [
            {
              "speaker": "Kaede",
              "text": "Tamaki、明日は——新しいクライアントがいるわ"
            },
            {
              "speaker": "Kaede",
              "text": "どんな人？"
            },
            {
              "speaker": "Kaede",
              "text": "まだ、わからない。でも——きっと、何か問いを持ってる"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Two Shot",
          "visual": "私は頷く。。Hibikiの声が加わる。",
          "characters": [
            "character:hibiki",
            "character:kaede"
          ],
          "dialogue": [
            {
              "speaker": "Kaede",
              "text": "うん。聞いてみるよ"
            },
            {
              "speaker": "Hibiki",
              "text": "Tamaki、また——一緒に行こう"
            },
            {
              "speaker": "Hibiki",
              "text": "もちろん"
            },
            {
              "speaker": "Hibiki",
              "text": "呼吸、合わせるよ"
            },
            {
              "speaker": "Hibiki",
              "text": "ありがとう、Hibiki"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 3,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Wide Shot",
          "visual": "夕陽が沈んでいく。空が、オレンジから紫へと変わっていく。。私は微笑む。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "タマ、また明日も——いい感じから始まる？"
            },
            {
              "speaker": "Tamaki",
              "text": "うん。いい感じから始める"
            },
            {
              "speaker": "Tamaki",
              "text": "それって——決まってるの？"
            },
            {
              "speaker": "Tamaki",
              "text": "決まってない。でも——選ぶことはできる"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "彼女は首を傾げる。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "選ぶ？"
            },
            {
              "speaker": "Tamaki",
              "text": "うん。いい感じでいることを、選ぶ"
            },
            {
              "speaker": "Tamaki",
              "text": "選ぶだけで、いい感じになれるの？"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 4,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "私は考える。。彼女は少し考える。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "なれるとは限らない。でも——選ぶことが、第一歩"
            },
            {
              "speaker": "Tamaki",
              "text": "ふーん……"
            },
            {
              "speaker": "Tamaki",
              "text": "じゃあ——わたしも、選ぶ"
            },
            {
              "speaker": "Tamaki",
              "text": "何を？"
            },
            {
              "speaker": "Tamaki",
              "text": "タマと一緒に、いい感じでいること"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "私は笑う。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "ありがとう、Nei-chan"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 5,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "星が、一つずつ見え始めている。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "タマ、明日の朝——また、運河を見に行こうね"
            },
            {
              "speaker": "Tamaki",
              "text": "うん"
            },
            {
              "speaker": "Tamaki",
              "text": "また、霧が出てるかな"
            },
            {
              "speaker": "Tamaki",
              "text": "出てるかもしれない"
            },
            {
              "speaker": "Tamaki",
              "text": "楽しみ"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "私は彼女の手を握る。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "うん。楽しみだね"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 6,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Wide Shot",
          "visual": "私は手帳を取り出し、今日の一行を書く。。ページを閉じる。。夜空に、星が輝いている。。明日も、いい感じから始めよう。",
          "characters": [
            "character:nei"
          ],
          "dialogue": [
            {
              "speaker": "Nei-chan",
              "text": "いい感じでいることを、選ぶ。それが、全ての始まり"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 7,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "**[手帳の一行: いい感じでいることを、選ぶ。それが、全ての始まり]**",
          "characters": [],
          "dialogue": [
            {
              "speaker": "Narration",
              "text": "**[手帳の一行: いい感じでいることを、選ぶ。それが、全ての始まり]**"
            }
          ]
        }
      ]
    }
  ]
