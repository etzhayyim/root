{
  "@context": {
    "character": "gh:character/",
    "characters": "gh:characters",
    "dct": "http://purl.org/dc/terms/",
    "dialogue": "gh:dialogue",
    "env": "gh:environment/",
    "environment": "gh:environment",
    "gh": "https://ghosthacker.gftd.ai/ns/",
    "panel": "gh:panelIndex",
    "schema": "http://schema.org/",
    "shot": "gh:shotType",
    "speaker": "gh:speaker",
    "text": "gh:text",
    "visual": "gh:visual"
  },
  "dct:title": "Vol.3 Ch.18 — 正しさの重さ（対話）",
  "gh:arc": "Vol 3: Justice",
  "gh:episodeId": "episode:sip-vol03-ch18",
  "gh:pages": [
    {
      "gh:pageNumber": 1,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "Kenjiが話し始める。。彼の声は低い。疲れている。。彼は言葉を切る。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "私は……経理部にいました"
            },
            {
              "speaker": "Tamaki",
              "text": "ある日、数字がおかしいことに気づいた。上司が、取引先に——"
            },
            {
              "speaker": "Tamaki",
              "text": "……不正な支払いをしていた。裏金、と呼ばれるもの"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Close-up",
          "visual": "私は頷く。。Nei-chanが私の肩で囁く。『タマ、彼の声……怒りと悲しみが混ざってる』。私は静かに待つ。",
          "characters": [
            "character:nei",
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "見つけてしまったんだね"
            },
            {
              "speaker": "Tamaki",
              "text": "見つけてしまった。そして……報告しました。コンプライアンス部門に"
            },
            {
              "speaker": "Tamaki",
              "text": "……報告した翌週、私の部署が変わりました"
            },
            {
              "speaker": "Tamaki",
              "text": "左遷？"
            },
            {
              "speaker": "Tamaki",
              "text": "いいえ。表向きは『適正配置』。でも、実際は——窓際です"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 2,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Close-up",
          "visual": "彼の手が、わずかに震えている。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "毎日、何もない仕事。周りからは距離を置かれる。『裏切り者』と呼ばれる"
            },
            {
              "speaker": "Tamaki",
              "text": "……正しいことをしたのに"
            },
            {
              "speaker": "Tamaki",
              "text": "はい"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Close-up",
          "visual": "彼の目に、涙が浮かぶ。でも、落ちない。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "私は——間違っていたのでしょうか"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 3,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "私は深く息を吸う。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "Kenji、一つ聞いていい？"
            },
            {
              "speaker": "Tamaki",
              "text": "……はい"
            },
            {
              "speaker": "Tamaki",
              "text": "今、あなたの中で——何が一番重い？"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "彼は考える。長い沈黙。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "……怒り、です"
            },
            {
              "speaker": "Tamaki",
              "text": "怒り"
            },
            {
              "speaker": "Tamaki",
              "text": "はい。会社に対する怒り。上司に対する怒り。何も変わらなかったことへの怒り"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 4,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "私は頷く。。彼が顔を上げる。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "その怒りは、正しい"
            },
            {
              "speaker": "Tamaki",
              "text": "……正しい？"
            },
            {
              "speaker": "Tamaki",
              "text": "うん。あなたの怒りは、正義から来ている。間違いを正そうとした。それは、正しいこと"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Close-up",
          "visual": "彼の目が揺れる。。彼が俯く。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "でも——"
            },
            {
              "speaker": "Tamaki",
              "text": "でも、怒りは重い。ずっと持っていると、自分が潰れる"
            },
            {
              "speaker": "Tamaki",
              "text": "……はい。潰れそうです"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 5,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "Kaedeの声が通信に入る。。私は頷く。。彼が顔を上げる。",
          "characters": [
            "character:kaede"
          ],
          "dialogue": [
            {
              "speaker": "Kaede",
              "text": "Tamaki……彼の心拍、少し落ち着いてきてる。話せてる"
            },
            {
              "speaker": "Kaede",
              "text": "Kenji、怒りを手放すことと、正しさを諦めることは——違うんだよ"
            },
            {
              "speaker": "Kaede",
              "text": "……どう違うんですか？"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 6,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Wide Shot",
          "visual": "私は街灯を見上げる。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "この街灯、見える？"
            },
            {
              "speaker": "Tamaki",
              "text": "……はい"
            },
            {
              "speaker": "Tamaki",
              "text": "光を出している。でも、街灯自身は——光を『持って』いない"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "彼は首を傾げる。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "光は、通り過ぎていくもの。街灯は、それを『通す』だけ"
            },
            {
              "speaker": "Tamaki",
              "text": "……"
            },
            {
              "speaker": "Tamaki",
              "text": "正しさも、同じかもしれない"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 7,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Close-up",
          "visual": "私は彼を見る。。彼の目が揺れる。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "あなたは、正しいことをした。でも、その『正しさ』を——ずっと握りしめる必要はない"
            },
            {
              "speaker": "Tamaki",
              "text": "手放しても……正しかったことは、消えない？"
            },
            {
              "speaker": "Tamaki",
              "text": "消えない。あなたがしたことは、残っている。証拠も、記録も、あなたの勇気も"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Close-up",
          "visual": "Nei-chanが囁く。『タマ……彼、少し呼吸が楽になってる』。彼が目を閉じる。",
          "characters": [
            "character:nei",
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "でも——怒りを持ち続けると、あなた自身が傷つく"
            },
            {
              "speaker": "Tamaki",
              "text": "……疲れました"
            },
            {
              "speaker": "Tamaki",
              "text": "うん。疲れたよね"
            },
            {
              "speaker": "Tamaki",
              "text": "毎日、怒っている自分に——疲れました"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 8,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Wide Shot",
          "visual": "私は静かに言う。。街灯の光が、ゆっくりと揺れている。秋の夜風が、二人の間を通り抜ける。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "それなら——少し、休んでいい"
            }
          ]
        }
      ]
    }
  ]
}
