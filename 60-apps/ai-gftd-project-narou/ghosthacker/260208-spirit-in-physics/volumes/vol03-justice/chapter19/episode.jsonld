{
  "@context": {
    "character": "gh:character/",
    "characters": "gh:characters",
    "dct": "http://purl.org/dc/terms/",
    "dialogue": "gh:dialogue",
    "env": "gh:environment/",
    "environment": "gh:environment",
    "gh": "https://ghosthacker.gftd.ai/ns/",
    "panel": "gh:panelIndex",
    "schema": "http://schema.org/",
    "shot": "gh:shotType",
    "speaker": "gh:speaker",
    "text": "gh:text",
    "visual": "gh:visual"
  },
  "dct:title": "Vol.3 Ch.19 — 息を吐く（余韻）",
  "gh:arc": "Vol 3: Justice",
  "gh:episodeId": "episode:sip-vol03-ch19",
  "gh:pages": [
    {
      "gh:pageNumber": 1,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Close-up",
          "visual": "Kenjiが目を閉じたまま、深く息を吐いた。。長い、長い息。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "……こうやって、息を吐いたの——久しぶりです"
            },
            {
              "speaker": "Tamaki",
              "text": "うん"
            },
            {
              "speaker": "Tamaki",
              "text": "ずっと……息を止めていた気がする"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Close-up",
          "visual": "私は頷く。。彼が目を開ける。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "怒りを持っていると、息が浅くなる。いつも戦闘態勢だから"
            },
            {
              "speaker": "Tamaki",
              "text": "戦闘態勢……"
            },
            {
              "speaker": "Tamaki",
              "text": "うん。いつでも反撃できるように。いつでも正しさを証明できるように"
            }
          ]
        },
        {
          "panel": 3,
          "shot": "Medium Shot",
          "visual": "彼は苦笑する。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "……その通りです。会議でも、廊下でも、家でも——ずっと"
            },
            {
              "speaker": "Tamaki",
              "text": "疲れるよね"
            },
            {
              "speaker": "Tamaki",
              "text": "疲れます"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 2,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "Hibikiの声が通信に入る。。私は小さく頷く。",
          "characters": [
            "character:hibiki"
          ],
          "dialogue": [
            {
              "speaker": "Hibiki",
              "text": "Tamaki、いい音が聞こえてきた。彼の呼吸……落ち着いてる"
            },
            {
              "speaker": "Hibiki",
              "text": "Kenji、もう一つ聞いていい？"
            },
            {
              "speaker": "Hibiki",
              "text": "……はい"
            },
            {
              "speaker": "Hibiki",
              "text": "あなたが怒っている相手——上司や、会社——は、今、どこにいる？"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "彼は考える。。彼は周りを見渡す。小さな公園。街灯。夜空。",
          "characters": [
            "character:hibiki"
          ],
          "dialogue": [
            {
              "speaker": "Hibiki",
              "text": "……オフィスに、いると思います"
            },
            {
              "speaker": "Hibiki",
              "text": "うん。でも、今——あなたの目の前には？"
            },
            {
              "speaker": "Hibiki",
              "text": "……誰もいません"
            },
            {
              "speaker": "Hibiki",
              "text": "うん"
            }
          ]
        },
        {
          "panel": 3,
          "shot": "Close-up",
          "visual": "私は静かに言う。。彼の目が揺れる。",
          "characters": [
            "character:hibiki"
          ],
          "dialogue": [
            {
              "speaker": "Hibiki",
              "text": "怒りの相手は、ここにいない。でも、怒りは——ここにある"
            },
            {
              "speaker": "Hibiki",
              "text": "あなたの中に、ずっと住み続けている"
            },
            {
              "speaker": "Hibiki",
              "text": "……"
            },
            {
              "speaker": "Hibiki",
              "text": "それを、追い出す必要はない。でも——少し、距離を置いてもいい"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 3,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Wide Shot",
          "visual": "Nei-chanが私の肩で囁く。『タマ、空……星が見えてきたよ』。私は空を見上げる。オフィス街でも、いくつかの星が瞬いている。。彼も空を見上げる。",
          "characters": [
            "character:nei",
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "Kenji、見て"
            },
            {
              "speaker": "Tamaki",
              "text": "……星だ"
            },
            {
              "speaker": "Tamaki",
              "text": "うん。いつもあるのに、普段は見えない"
            },
            {
              "speaker": "Tamaki",
              "text": "明るすぎて"
            },
            {
              "speaker": "Tamaki",
              "text": "そう。街が明るいと、見えない。でも、今日は——見える"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "彼は長い間、空を見ていた。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "……私は、見えなくなっていたのかもしれない"
            },
            {
              "speaker": "Tamaki",
              "text": "何が？"
            },
            {
              "speaker": "Tamaki",
              "text": "怒り以外のもの。星とか、風とか、息をすることとか"
            }
          ]
        },
        {
          "panel": 3,
          "shot": "Medium Shot",
          "visual": "私は微笑む。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "今は——見える？"
            },
            {
              "speaker": "Tamaki",
              "text": "……少しだけ"
            },
            {
              "speaker": "Tamaki",
              "text": "少しでいい。それで十分"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 4,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "Kaedeの声が通信に入る。。私は頷く。。彼が頷く。",
          "characters": [
            "character:kaede"
          ],
          "dialogue": [
            {
              "speaker": "Kaede",
              "text": "Tamaki……彼、今日は——ここまでにした方がいいわ"
            },
            {
              "speaker": "Kaede",
              "text": "Kenji、今日は——ここまでにしよう"
            },
            {
              "speaker": "Kaede",
              "text": "……ありがとうございます"
            },
            {
              "speaker": "Kaede",
              "text": "また、話しに来て。いつでも"
            },
            {
              "speaker": "Kaede",
              "text": "……また、来てもいいんですか？"
            },
            {
              "speaker": "Kaede",
              "text": "もちろん。怒りの話でも、星の話でも"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "彼は少し笑う。初めて見る笑顔。。私たちはベンチから立ち上がる。",
          "characters": [
            "character:kaede"
          ],
          "dialogue": [
            {
              "speaker": "Kaede",
              "text": "……星の話、いいですね"
            },
            {
              "speaker": "Kaede",
              "text": "Kenji、一つだけ"
            },
            {
              "speaker": "Kaede",
              "text": "はい"
            },
            {
              "speaker": "Kaede",
              "text": "正しいことをした——それは、変わらない"
            }
          ]
        },
        {
          "panel": 3,
          "shot": "Close-up",
          "visual": "彼の目が潤む。。彼が深く頷く。",
          "characters": [
            "character:kaede"
          ],
          "dialogue": [
            {
              "speaker": "Kaede",
              "text": "……ありがとうございます"
            },
            {
              "speaker": "Kaede",
              "text": "ただ、正しさを——ずっと証明し続ける必要はない。あなたは、もう証明した"
            },
            {
              "speaker": "Kaede",
              "text": "……はい"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 5,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "彼を見送った後、私はNei-chanと公園のベンチに座る。",
          "characters": [
            "character:nei",
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "タマ"
            },
            {
              "speaker": "Tamaki",
              "text": "うん？"
            },
            {
              "speaker": "Tamaki",
              "text": "怒りって……重いの？"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "私は考える。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "重い。でも、最初は——守ってくれるもの"
            },
            {
              "speaker": "Tamaki",
              "text": "守る？"
            },
            {
              "speaker": "Tamaki",
              "text": "うん。傷つかないように。でも、ずっと持っていると——重くなる"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 6,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "Nei-chanは首を傾げる。",
          "characters": [
            "character:nei",
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "じゃあ、どうすればいいの？"
            },
            {
              "speaker": "Tamaki",
              "text": "時々、置いてみる。なくすんじゃなくて、置いてみる"
            },
            {
              "speaker": "Tamaki",
              "text": "置く……"
            },
            {
              "speaker": "Tamaki",
              "text": "うん。また必要なら、持てばいい。でも、ずっと持っている必要はない"
            }
          ]
        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "彼女は空を見上げる。。私も空を見上げる。",
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Tamaki",
              "text": "タマ、あの星——名前ある？"
            },
            {
              "speaker": "Tamaki",
              "text": "……わからない。でも、きれいだね"
            },
            {
              "speaker": "Tamaki",
              "text": "うん"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 7,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Wide Shot",
          "visual": "私は手帳を取り出し、今日の一行を書く。。ページを閉じる。。秋の夜空に、星が静かに瞬いている。。次も、いい感じから始めよう。",
          "characters": [
            "character:nei"
          ],
          "dialogue": [
            {
              "speaker": "Nei-chan",
              "text": "正しさは、証明し終えたら、置いていい"
            }
          ]
        }
      ]
    },
    {
      "gh:pageNumber": 8,
      "gh:panels": [
        {
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "**[手帳の一行: 正しさは、証明し終えたら、置いていい]**",
          "characters": [],
          "dialogue": [
            {
              "speaker": "Narration",
              "text": "**[手帳の一行: 正しさは、証明し終えたら、置いていい]**"
            }
          ]
        }
      ]
    }
  ]
}
