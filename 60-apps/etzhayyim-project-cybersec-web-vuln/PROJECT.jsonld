{
  "@context": "https://schema.org/",
  "@type": "Project",
  "name": "Cybersecurity Division Web Vulnerability Assessment Section (サイバーセキュリティ事業部ウェブ脆弱性診断課)",
  "status": "Integrated",
  "identifier": "etzhayyim-project-cybersec-web-vuln",
  "description": "Automated and manual web vulnerability assessments to ensure the security of web applications and infrastructure.",
  "hasPart": [
    {
      "@type": "CreativeWork",
      "name": "Capabilities",
      "url": "capabilities.jsonld"
    },
    {
      "@type": "CreativeWork",
      "name": "Activities",
      "url": "activities.jsonld"
    },
    {
      "@type": "CreativeWork",
      "name": "UI/UX Design",
      "url": "uiux.jsonld"
    },
    {
      "@type": "CreativeWork",
      "name": "Strategy",
      "url": "STRATEGY.jsonld"
    }
  ],
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "STRATEGY.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "dct": "http://purl.org/dc/terms/",
            "etzhayyim": "https://etzhayyim.com/schemas/"
          },
          "id": "https://etzhayyim.com/projects/etzhayyim-project-cybersec-web-vuln/strategy/vulnerability-assessment-strategy",
          "type": "dodaf:StrategicPlan",
          "dct:title": "Web Vulnerability Assessment Strategy",
          "dct:description": "Strategic plan for continuous web vulnerability monitoring and rapid remediation response.",
          "etzhayyim:objectives": [
            {
              "name": "Continuous Monitoring Coverage",
              "description": "Ensure 100% of public-facing web assets are scanned weekly.",
              "priority": "High"
            },
            {
              "name": "Rapid Vulnerability Triage",
              "description": "Critical vulnerabilities must be triaged within 4 hours of detection.",
              "priority": "High"
            }
          ],
          "etzhayyim:triggers": [
            {
              "condition": "Critical vulnerability detected",
              "action": "Trigger 'Emergency Remediation Task Force' activity."
            }
          ]
        }
      },
      {
        "fileName": "activities.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "dct": "http://purl.org/dc/terms/",
            "etzhayyim": "https://etzhayyim.com/schemas/"
          },
          "id": "https://etzhayyim.com/projects/etzhayyim-project-cybersec-web-vuln/activities/vulnerability-assessment",
          "type": "dodaf:OperationalActivity",
          "dct:title": "Web Vulnerability Assessment Process (OV-5b)",
          "dct:description": "Process for automated scanning and analysis of web vulnerabilities.",
          "etzhayyim:steps": [
            {
              "activity": "Automated Scan Trigger",
              "performer": "etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-svc-apqc-10-3-vulnerability-mgmt",
              "action": "Initiate automated vulnerability scans on target systems.",
              "input": "Target URL/IP",
              "output": "Raw Scan Data"
            },
            {
              "activity": "Vulnerability Analysis",
              "performer": "etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-psn-isco-2511-security-analyst",
              "action": "Analyze raw scan data to identify and prioritize vulnerabilities.",
              "input": "Raw Scan Data",
              "output": "Prioritized Vulnerability List"
            },
            {
              "activity": "Report Synthesis",
              "performer": "etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-svc-apqc-10-3-vulnerability-mgmt",
              "action": "Generate comprehensive security assessment reports.",
              "input": "Prioritized Vulnerability List",
              "output": "Vulnerability Assessment Report"
            }
          ]
        }
      },
      {
        "fileName": "capabilities.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "etzhayyim": "https://etzhayyim.com/schemas/"
          },
          "@type": "dodaf:Capability",
          "name": "Web Vulnerability Assessment",
          "description": "Ability to perform comprehensive security assessments and vulnerability management for web applications.",
          "etzhayyim:actors": [
            {
              "@id": "etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-svc-apqc-10-3-vulnerability-mgmt",
              "name": "Vulnerability Management Service",
              "type": "Service",
              "apqc": "10.3",
              "description": "Orchestrates automated scanning and report generation."
            },
            {
              "@id": "etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-psn-isco-2511-security-analyst",
              "name": "Security Analyst",
              "type": "Person",
              "isco": "2511",
              "description": "Performs manual analysis and prioritization of vulnerabilities."
            }
          ],
          "etzhayyim:features": [
            "Automated Vulnerability Scanning",
            "Manual Penetration Testing Integration",
            "Security Compliance Reporting"
          ]
        }
      },
      {
        "fileName": "scheduler.jsonld",
        "content": {
          "@context": [
            "https://schema.org/",
            {
              "etzhayyim": "https://etzhayyim.com/schemas/",
              "capabilities": "etzhayyim:capabilities",
              "survivalIndicators": "etzhayyim:survivalIndicators",
              "scheduler": "etzhayyim:scheduler",
              "milestones": "etzhayyim:milestones",
              "blockers": "etzhayyim:blockers",
              "dependsOn": {
                "@id": "etzhayyim:dependsOn",
                "@type": "@id"
              },
              "ingestKey": "etzhayyim:ingestKey",
              "window": "etzhayyim:window",
              "valueUpdatedAt": "etzhayyim:valueUpdatedAt"
            }
          ],
          "@type": "CreativeWork",
          "name": "Cybersecurity Division Web Vulnerability Assessment Section (サイバーセキュリティ事業部ウェブ脆弱性診断課) Scheduler",
          "identifier": "etzhayyim-project-cybersec-web-vuln/scheduler",
          "description": "Project schedule (milestones) and blockers.",
          "dateCreated": "2026-02-15T04:25:26+00:00",
          "milestones": [],
          "blockers": []
        }
      },
      {
        "fileName": "uiux.jsonld",
        "content": {
          "@context": "https://schema.org/",
          "@type": "CreativeWork",
          "name": "Cybersec Web Vuln UI/UX Design",
          "description": "Security scanner dashboard and vulnerability explorer for web applications.",
          "etzhayyim:designPrinciples": [
            "Clear severity-based color coding",
            "Deep-dive vulnerability details",
            "iPad Sidecar/Multi-window for report drafting"
          ],
          "etzhayyim:uiComponents": [
            {
              "name": "Scan Management Center",
              "type": "Dashboard",
              "features": [
                "Active scan status",
                "Target management",
                "Quick report generation"
              ]
            },
            {
              "name": "Vulnerability Explorer",
              "type": "Explorer",
              "features": [
                "Searchable vulnerability database",
                "Remediation guidance",
                "Proof-of-concept logs"
              ]
            }
          ],
          "etzhayyim:uxFlows": [
            {
              "name": "Vulnerability Assessment Flow",
              "steps": [
                "Define target",
                "Start scan",
                "Analyze results",
                "Generate report"
              ]
            }
          ]
        }
      }
    ]
  }
}
