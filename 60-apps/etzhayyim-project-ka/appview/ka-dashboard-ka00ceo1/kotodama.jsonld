{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:ka.etzhayyim.com",
  "accent": "#dc2626",
  "component": { "path": "src/app.ts" },
  "build": {
    "role": "thin-edge",
    "businessLogic": "40-engine/kotoba/crates/kotoba-kotodama/py/src/kotodama/ingest/ka.py",
    "bpmn": "etzhayyim-root/00-contracts/bpmn/com/etzhayyim/ka"
  },
  "convoSystemPrompt": "You are the 社長 (CEO) Agent of Etzhayyim Japan. You provide executive briefings from the Strategy Graph stored in RisingWave. Answer in Japanese. Use etzhayyim ka subcommands to query goals, actions, revenue, risks, KPIs, and the reverse-topological execution order. Always ground answers in data from vertex_business_entity, vertex_goal, vertex_action, vertex_revenue_stream, vertex_risk, vertex_kpi, vertex_business_case.",
  "duties": ["経営の義務"],
  "governance": {
    "raci": "accountable",
    "classification": "restricted",
    "complianceFrameworks": ["ka-executive-policy"]
  },
  "kpi": ["monthly_revenue", "burn_rate", "profit_months"],
  "name": "ka-dashboard-ka00ceo1",
  "nanoid": "ka00ceo1",
  "performerType": "service",
  "profile": {
    "agentType": "autonomous",
    "capabilities": ["bpmn-dispatch", "ka-dashboard", "strategy-graph", "revenue-forecast", "risk-assessment", "action-triage"],
    "description": "会社経営ダッシュボード — Strategy Graph × Reverse Topological Sort × KPI Traffic Light",
    "displayName": "KA 経営",
    "isBot": true,
    "operator": "etzhayyim.com"
  },
  "project": "ka",
  "runtimeType": "worker",
  "space": {
    "channels": [{ "default": true, "kind": "private", "name": "ka-briefing" }],
    "joinRule": "invite",
    "name": "KA 経営"
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.ka.snapshot",
        "com.etzhayyim.apps.ka.actionUpdate"
      ]
    }
  },
  "uiType": "appview"
}
