{
  "name": "magatama-it0n4m1x",
  "main": "src/app.ts",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": ["nodejs_compat", "nodejs_als"],
  "alias": {
    "@gftd/magatama-host-sdk": "/Users/junkawasaki/gftdcojp/ai-gftd-apps-gftdcojp/20-actors/magatama/sdk/magatama-host-sdk/src/index.ts",
    "pg": "/Users/junkawasaki/gftdcojp/ai-gftd-apps-gftdcojp/node_modules/.pnpm/pg@8.20.0/node_modules/pg/lib/index.js",
    "@gftd/xrpc/transport": "/Users/junkawasaki/gftdcojp/ai-gftd-apps-gftdcojp/10-protocol/xrpc/src/transport.ts",
    "@gftd/xrpc/auth": "/Users/junkawasaki/gftdcojp/ai-gftd-apps-gftdcojp/10-protocol/xrpc/src/auth.ts",
    "@gftd/xrpc/error": "/Users/junkawasaki/gftdcojp/ai-gftd-apps-gftdcojp/10-protocol/xrpc/src/error.ts",
    "@gftd/xrpc/nsid": "/Users/junkawasaki/gftdcojp/ai-gftd-apps-gftdcojp/10-protocol/xrpc/src/nsid.ts",
    "@gftd/xrpc/encode": "/Users/junkawasaki/gftdcojp/ai-gftd-apps-gftdcojp/10-protocol/xrpc/src/encode.ts"
  },
  "assets": {
    "directory": "../../svelte/build",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_ACTOR_HANDLE": "itonami",
    "APP_CAPABILITIES": "[\"aircraft-lifecycle-simulation\",\"unspsc-bom\",\"isic-supplier\",\"digital-twin\"]",
    "APP_DESCRIPTION": "Aircraft engine lifecycle simulation — design, procurement, assembly, testing, and digital twin flight operation",
    "APP_DISPLAY_NAME": "Itonami",
    "APP_EMBED_URL": "https://itonami.gftd.ai/?embed=1",
    "APP_FRAMEWORK": "ts-native",
    "APP_NANOID": "it0n4m1x",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "appview"
  },
  "r2_buckets": [
    { "binding": "YATA_R2", "bucket_name": "ai-gftd-cache" },
    { "binding": "CACHE_R2", "bucket_name": "ai-gftd-cache" }
  ],
  "services": [
    { "binding": "PDS_SERVICE", "service": "ai-gftd-pds-2603241700" },
    { "binding": "PDS_RPC", "service": "ai-gftd-pds-2603241700", "entrypoint": "PdsRPC" },
    { "binding": "MURAKUMO_SERVICE", "service": "ai-gftd-murakumo-2603241700" }
  ],
  "secrets_store_secrets": [
    { "binding": "SS_YATA_S3_KEY_ID", "store_id": "1824561668fe47cc9127d493961885af", "secret_name": "yata_s3_key_id" },
    { "binding": "SS_YATA_S3_SECRET_KEY", "store_id": "1824561668fe47cc9127d493961885af", "secret_name": "yata_s3_secret_key" },
    { "binding": "SS_SIGNING_KEY", "store_id": "1824561668fe47cc9127d493961885af", "secret_name": "signing_key" }
  ],
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"] }
  ],
  "routes": [
    { "pattern": "it0n4m1x.gftd.ai/*", "zone_name": "gftd.ai" },
    { "pattern": "itonami.gftd.ai/*", "zone_name": "gftd.ai" }
  ]
}
