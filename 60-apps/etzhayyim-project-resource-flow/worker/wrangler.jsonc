{
  "name": "kotodama-r3s0fl0w",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"resource-flow-projection\",\"sankey-aggregation\",\"adr-0028\"]",
    "APP_DESCRIPTION": "12-class resource flow visualization platform (ADR-0028). Consumes legal-entity flow firehose, materializes sankey-ready aggregations.",
    "APP_DISPLAY_NAME": "Resource Flow",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "r3s0fl0w",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "r3s0fl0w.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "resource-flow.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
