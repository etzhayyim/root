;; Resource-flow datom schema for the yoro-social-v1 kotoba graph.
;;
;; The Resource Flow tab (src/lib/fiscal/ResourceFlowTab.svelte) reads these
;; attributes from the kotoba Datom log via kotoba-sw.js — the kotoba-canonical
;; successor to the deprecated kagami `edge_etzhayyim_fiscal_flow` /
;; `edge_etzhayyim_ownership` SQL tables (ADR-2605262130 — no Kotoba/Datomic;
;; ADR-2605312345 — the Datom log is first-class canonical state).
;;
;; Append-only: a past fact is never overwritten, so the tab's as-of control
;; (filter `:yoro.fiscal/observedAt <= T`) is real time-travel over the log.
;; `observedAt` is the observed/recorded fact-time (ISO-8601). The transaction
;; -time (basis-t CID) as-of via `com.etzhayyim.apps.kotoba.datomic.asOf` swaps in
;; at the SW layer once the wasm node exposes an as-of root — no schema change.

{:graph "yoro-social-v1"

 ;; A directed fund-flow edge. Entity id convention: "fiscal:<from>:<to>:<fy>:<program>".
 :yoro.fiscal
 {:from        {:doc "source actor DID"                    :type :string}
  :to          {:doc "destination actor DID"               :type :string}
  :stage       {:doc "flow stage L0..L7 (受給者..国庫)"     :type :string}
  :fiscalYear  {:doc "fiscal year"                          :type :long}
  :amountJpy   {:doc "amount in JPY"                         :type :long}
  :basis       {:doc "legal/appropriation basis"            :type :string}
  :programCode {:doc "program / appropriation code"         :type :string}
  :sourceUrl   {:doc "primary public-source URL"            :type :string}
  :observedAt  {:doc "ISO-8601 observed/recorded time (as-of dimension)" :type :string}}

 ;; A beneficial-ownership / control edge. Entity id: "ownership:<parent>:<child>".
 :yoro.ownership
 {:parent       {:doc "controlling (parent) actor DID"      :type :string}
  :child        {:doc "controlled (child) actor DID"        :type :string}
  :pct          {:doc "ownership percentage"                :type :double}
  :votingPct    {:doc "voting percentage"                   :type :double}
  :evidenceKind {:doc "evidence kind (registry/filing/…)"   :type :string}
  :evidenceUrl  {:doc "primary public-source URL"           :type :string}
  :observedAt   {:doc "ISO-8601 observed/recorded time (as-of dimension)" :type :string}}}
