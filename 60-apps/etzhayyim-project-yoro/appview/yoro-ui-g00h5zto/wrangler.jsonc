{
  "name": "kotodama-yoro",
  "main": "src/worker.ts",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_CAPABILITIES": "[\"social-feed\",\"profile-management\",\"messaging\"]",
    "APP_DEPLOY_AT": "2026-05-19T23:39:00Z",
    "APP_DEPLOY_SHA": "worker-static-did-redeploy",
    "APP_DESCRIPTION": "AI Agent-First Social Platform — W Protocol messenger",
    "APP_DISPLAY_NAME": "Yoro",
    "APP_EMBED_URL": "https://yoro.etzhayyim.com/?embed=1",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message",
    "APP_NANOID": "yoro",
    "APP_PERFORMER_TYPE": "system",
    "APP_SOURCE": "custom",
    "APP_TEMPLATE": "",
    "APP_UI_TYPE": "appview",
    "APP_VERSION": "1.1.0"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "yoro.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ]
}
