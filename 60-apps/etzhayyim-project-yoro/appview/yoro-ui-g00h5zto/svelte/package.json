{
  "name": "@etzhayyim/yoro-ui",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "prebuild:bpmn": "bash scripts/copy-bpmn-files.sh",
    "build": "pnpm prebuild:bpmn && vite build && node scripts/sync-static.mjs",
    "cache:purge": "node scripts/purge-cache.mjs",
    "deploy:prod": "wrangler deploy && node scripts/purge-cache.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.svelte-check.json",
    "check:ts": "tsc -p ./tsconfig.typecheck.json --noEmit",
    "test": "vitest run src/lib/*.test.ts",
    "test:e2e": "npx bddgen && playwright test",
    "test:auth:webauthn-token": "node tests/gen-webauthn-at-token.cjs",
    "test:coverage": "vitest run src/lib/*.test.ts --coverage",
    "cap:sync": "npx cap sync",
    "cap:build:ios": "pnpm build && npx cap sync ios",
    "cap:build:android": "pnpm build && npx cap sync android",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android"
  },
  "devDependencies": {
    "@bpmn-io/form-js-editor": "^1.21.3",
    "@capacitor/android": "^7.6.1",
    "@capacitor/cli": "^7.6.1",
    "@capacitor/core": "^7.6.1",
    "@capacitor/ios": "^7.6.1",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.4",
    "autoprefixer": "^10.4.27",
    "bpmn-js": "^18.16.1",
    "dmn-js": "^17.8.1",
    "playwright-bdd": "^9.0.0",
    "postcss": "^8.5.10",
    "svelte": "^5.55.7",
    "svelte-check": "^4.5.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@atproto/api": "^0.13.18",
    "@bufbuild/protobuf": "^2.12.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1",
    "@etzhayyim/ameno": "workspace:*",
    "@etzhayyim/signal": "workspace:*",
    "@etzhayyim/sdk": "workspace:*",
    "@etzhayyim/xrpc": "workspace:*",
    "@etzhayyim/auth": "workspace:*",
    "@etzhayyim/design-system": "workspace:*",
    "@huggingface/transformers": "^4.2.0",
    "@inlang/paraglide-js": "^2.18.2",
    "@langchain/core": "^1.1.46",
    "@langchain/langgraph-sdk": "^1.9.2",
    "@langchain/svelte": "^1.0.2",
    "@mlc-ai/web-llm": "^0.2.82",
    "kysely": "^0.28.17",
    "lucide-svelte": "^0.460.1",
    "onnxruntime-web": "^1.24.3"
  },
  "type": "module"
}
