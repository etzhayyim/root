default_platform(:ios)

ASC_KEY_ID      = "8K67TW5846"
ASC_ISSUER_ID   = "69a6de91-7aa3-47e3-e053-5b8c7c11a4d1"
ASC_KEY_PATH    = File.expand_path(".tmp/AuthKey_8K67TW5846.p8", __dir__)

def asc_api_key
  app_store_connect_api_key(
    key_id:        ASC_KEY_ID,
    issuer_id:     ASC_ISSUER_ID,
    key_filepath:  ASC_KEY_PATH,
    duration:      1200,
    in_house:      false
  )
end

platform :ios do
  desc "Create App ID and App Store Connect entry"
  lane :create_app do
    api_key = asc_api_key
    produce(
      app_identifier: "com.etzhayyim.yoro",
      app_name:       "YORO",
      team_id:        "U7W6HNNJCS"
    )
  end

  desc "Sync certificates and provisioning profiles"
  lane :certs do
    api_key = asc_api_key
    match(type: "appstore", readonly: false, api_key: api_key)
  end

  desc "Build iOS app from Capacitor project"
  lane :build do
    api_key = asc_api_key
    sh("cd .. && pnpm build && npx cap copy ios")
    build_number = Time.now.strftime("%Y%m%d%H%M")
    xcodeproj_path = File.expand_path("../ios/App/App.xcodeproj", __dir__)
    increment_build_number(
      build_number: build_number,
      xcodeproj:    xcodeproj_path
    )
    match(type: "appstore", readonly: false, api_key: api_key)
    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  File.expand_path("../ios/App/App.xcodeproj", __dir__),
      team_id:               "U7W6HNNJCS",
      code_sign_identity:    "Apple Distribution",
      profile_name:          "match AppStore com.etzhayyim.yoro",
      bundle_identifier:     "com.etzhayyim.yoro"
    )
    workspace_path = File.expand_path("../ios/App/App.xcworkspace", __dir__)
    build_app(
      workspace:        workspace_path,
      scheme:           "App",
      clean:            true,
      export_method:    "app-store",
      output_directory: File.expand_path("./build_output", __dir__),
      output_name:      "yoro.ipa",
      xcargs:           "DEVELOPMENT_TEAM=U7W6HNNJCS CODE_SIGN_STYLE=Manual"
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    build
    upload_to_testflight(
      api_key:                          asc_api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build and submit to App Store review"
  lane :release do
    build
    upload_to_testflight(
      api_key:                           asc_api_key,
      skip_waiting_for_build_processing: true,
      ipa:                               File.expand_path("./build_output/yoro.ipa", __dir__)
    )
    deliver(
      api_key:                  asc_api_key,
      skip_binary_upload:       true,
      skip_metadata:            true,
      skip_screenshots:         true,
      submit_for_review:        true,
      automatic_release:        true,
      force:                    true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa:  false
      }
    )
  end

  desc "Submit latest build for App Store review (no rebuild, metadata must be set in ASC)"
  lane :submit do
    deliver(
      api_key:                  asc_api_key,
      skip_binary_upload:       true,
      skip_metadata:            true,
      skip_screenshots:         true,
      submit_for_review:        true,
      automatic_release:        true,
      force:                    true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa:                              false,
        export_compliance_uses_encryption:                   true,
        export_compliance_is_exempt:                         true,
        export_compliance_contains_proprietary_cryptography: false,
        export_compliance_contains_third_party_cryptography: true,
        content_rights_has_rights:                           true,
        content_rights_contains_third_party_content:         false
      }
    )
  end

  desc "Update App Store metadata only"
  lane :metadata do
    deliver(
      api_key:              asc_api_key,
      skip_binary_upload:   true,
      skip_screenshots:     true,
      skip_metadata:        false,
      force:                true,
      app_version:          "1.0",
      edit_live:            false,
      run_precheck_before_submit: false,
      skip_app_version_update: true
    )
  end

  desc "Update metadata without name (when name is taken)"
  lane :metadata_no_name do
    deliver(
      api_key:              asc_api_key,
      skip_binary_upload:   true,
      skip_screenshots:     false,
      skip_metadata:        false,
      force:                true,
      overwrite_screenshots: true,
      app_version:          "1.0",
      skip_app_version_update: true
    )
  end
end

PLAY_KEY_PATH = File.expand_path(".tmp/play-store-key.json", __dir__)

platform :android do
  desc "Auto-increment versionCode (YMMDDHHM format, fits 32-bit int)"
  private_lane :set_version do
    t = Time.now
    version_code = (t.year - 2020) * 10_000_000 + t.month * 100_000 + t.day * 1_000 + t.hour * 10 + (t.min / 6)
    ENV["ANDROID_VERSION_CODE"] = version_code.to_s
    ENV["ANDROID_VERSION_NAME"] = "1.0.#{t.strftime('%Y%m%d')}"
    UI.message("Android versionCode=#{version_code} versionName=#{ENV['ANDROID_VERSION_NAME']}")
  end

  ANDROID_DIR = File.expand_path("../android", __dir__)

  desc "Build Android app (APK)"
  lane :build do
    set_version
    sh("cd #{File.expand_path('..', __dir__)} && pnpm build && npx cap copy android")
    gradle(
      task:        "assemble",
      build_type:  "Release",
      project_dir: ANDROID_DIR
    )
  end

  desc "Build Android app (AAB)"
  lane :build_aab do
    set_version
    sh("cd #{File.expand_path('..', __dir__)} && pnpm build && npx cap copy android")
    gradle(
      task:        "bundle",
      build_type:  "Release",
      project_dir: ANDROID_DIR
    )
  end

  desc "Build and install on connected device"
  lane :device do
    build
    apk_path = File.expand_path("../android/app/build/outputs/apk/release/app-release.apk", __dir__)
    adb(command: "install -r #{apk_path}")
    adb(command: "shell am start -n com.etzhayyim.yoro/.MainActivity")
  end

  AAB_PATH = File.expand_path("../android/app/build/outputs/bundle/release/app-release.aab", __dir__)

  desc "Build AAB and upload to Play Console (internal track)"
  lane :beta do
    build_aab
    upload_to_play_store(
      track:            "internal",
      aab:              AAB_PATH,
      json_key:         PLAY_KEY_PATH,
      package_name:     "com.etzhayyim.yoro",
      skip_upload_apk:  true,
      release_status:   "draft"
    )
  end

  desc "Build AAB and upload to Play Console (production)"
  lane :release do
    build_aab
    upload_to_play_store(
      track:            "production",
      aab:              AAB_PATH,
      json_key:         PLAY_KEY_PATH,
      package_name:     "com.etzhayyim.yoro",
      skip_upload_apk:  true
    )
  end

  desc "Promote internal track to production"
  lane :promote do
    upload_to_play_store(
      track:                    "internal",
      track_promote_to:         "production",
      json_key:                 PLAY_KEY_PATH,
      package_name:             "com.etzhayyim.yoro",
      skip_upload_changelogs:   true
    )
  end
end
