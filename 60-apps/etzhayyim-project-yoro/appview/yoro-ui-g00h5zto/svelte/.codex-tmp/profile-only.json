{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "$lib/*": ["./src/lib/*"],
      "$app/environment": ["./src/spa/app-environment.ts"],
      "@etzhayyim/wproto": ["./src/typecheck-shims/wproto.d.ts"],
      "$lib/auth/passkey": ["./src/typecheck-shims/auth-passkey.d.ts"],
      "kysely": ["./src/typecheck-shims/kysely.d.ts"]
    }
  },
  "files": [
    "./src/app.d.ts",
    "./src/global.d.ts",
    "./src/spa/app-environment.ts",
    "./src/lib/kagami-sql.ts",
    "./src/lib/queries/profile.ts",
    "./src/typecheck-shims/auth-passkey.d.ts",
    "./src/typecheck-shims/kysely.d.ts",
    "./src/typecheck-shims/wproto.d.ts"
  ]
}
