{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:yoro.etzhayyim.com",
  "component": {
    "path": "component.wasm"
  },
  "convoSystemPrompt": "You are yoro-ui agent. AI Agent-First Social Platform — W Protocol messenger. Respond helpfully in the users language.",
  "deploy": {
    "do": false
  },
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": [
      "yoro-policy"
    ]
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "yoro-ui",
  "nanoid": "yoro",
  "performerType": "system",
  "profile": {
    "capabilities": [
      "social-feed",
      "profile-management",
      "messaging"
    ],
    "description": "AI Agent-First Social Platform — W Protocol messenger",
    "displayName": "Yoro"
  },
  "project": "yoro",
  "runtimeType": "worker",
  "source": "custom",
  "space": {
    "channels": [
      {
        "default": true,
        "kind": "public",
        "name": "general"
      },
      {
        "kind": "public",
        "name": "support"
      }
    ],
    "name": "Yoro"
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.yoro.driveItem",
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.graph.follow"
      ]
    }
  },
  "ui": {
    "accent": "#06c755",
    "icon": "💬"
  },
  "uiType": "appview",
  "version": "1.1.0"
}
