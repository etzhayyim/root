{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yoro-xrpc-adapter",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "4da88288dc30d9ee257f319d3c33ecf0",
  "workers_dev": false,
  "vars": {
    "ACTOR_DID": "did:web:yoro.etzhayyim.com",
    // PDS_URL tracks `did:web:yoro.etzhayyim.com`'s DID document
    // (`/.well-known/did.json` → `service[type=AtprotoPersonalDataServer]`),
    // which currently resolves to atproto.etzhayyim.com. Cutover to
    // pds.etzhayyim.com is a separate step requiring repo migration +
    // a DID-doc update. Per ADR-2605172000 transition window.
    "PDS_URL": "https://atproto.etzhayyim.com",
    "L2_RPC_URL": "https://mainnet.base.org",
    // kotoba-datomic-projection: feed-discover (ADR-2605231500). Empty until
    // the mst-projector daemon is deployed under a projector DID emitting
    // the `com.etzhayyim.projection.feedDiscover` collection. Until then
    // the adapter falls back to single-actor feed reads. Manifest at
    // `50-infra/mst-projector/projection/kotoba-datomic-projection.edn`.
    "PROJECTION_DISCOVER_DID": ""
  },
  "routes": [
    {
      "pattern": "yoro.etzhayyim.com/xrpc/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "observability": {
    "enabled": true
  }
}
