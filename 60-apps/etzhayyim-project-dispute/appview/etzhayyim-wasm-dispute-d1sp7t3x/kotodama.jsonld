{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:dispute.etzhayyim.com",
  "component": {
    "env": {
      "MURAKUMO_URL": "https://murakumo.etzhayyim.com/api/openai/v1/chat/completions"
    },
    "path": "/wasm/component.wasm"
  },
  "convoSystemPrompt": "You are the Dispute Resolution agent. You specialize in evidence preservation, threat classification, and legal response drafting for contract disputes (業務委託紛争). Respond helpfully in the user's language.",
  "deploy": {},
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "classification": "restricted",
    "complianceFrameworks": [
      "contract_dispute_resolution_v1"
    ],
    "raci": "responsible"
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "etzhayyim-wasm-dispute",
  "nanoid": "d1sp7t3x",
  "performerType": "service",
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "evidence-preservation",
      "threat-classification",
      "legal-response-drafting",
      "payment-verification"
    ],
    "description": "Dispute resolution agent for contract disputes — evidence preservation, threat classification, and legal response support",
    "displayName": "Dispute Resolution Agent",
    "isBot": true,
    "operator": "etzhayyim.com"
  },
  "project": "dispute",
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "description": "Dispute case updates and evidence filings",
        "kind": "public",
        "name": "dispute-cases"
      },
      {
        "description": "Threat classification alerts",
        "kind": "public",
        "name": "dispute-alerts"
      },
      {
        "description": "Legal response drafts and counsel escalations",
        "kind": "public",
        "name": "dispute-responses"
      }
    ],
    "description": "Contract dispute resolution — evidence preservation, threat classification, legal response",
    "historyVisibility": "invited",
    "joinRule": "invite",
    "name": "Dispute Resolution Hub"
  },
  "triggers": {
    "http": {
      "routes": [
        "/api/grpc/...",
        "/health",
        "/healthz",
        "/readyz",
        "/..."
      ]
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow",
        "com.etzhayyim.apps.dispute.caseRecord",
        "com.etzhayyim.apps.dispute.evidence",
        "com.etzhayyim.apps.dispute.payment",
        "com.etzhayyim.apps.dispute.threat",
        "com.etzhayyim.apps.dispute.response",
        "com.etzhayyim.apps.dispute.timeline"
      ]
    }
  },
  "ui": {},
  "uiType": "yoro"
}
