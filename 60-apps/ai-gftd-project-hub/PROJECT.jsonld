{
  "@context": "https://schema.org/",
  "@type": "SoftwareApplication",
  "@id": "urn:gftd:project:ai-gftd-project-hub",
  "name": "ai-gftd-project-hub",
  "description": "Self-hosted GitHub-compatible API surface via MCP over SpinApp. Provides repos, pull requests, commit statuses, and check runs through a GitHub REST API subset.",
  "applicationCategory": "ai-gftd-project-hub",
  "operatingSystem": "Kubernetes",
  "softwareRequirements": [
    "SpinApp",
    "ClickHouse"
  ],
  "author": {
    "@type": "Organization",
    "name": "GFTD",
    "url": "https://gftd.ai"
  },
  "codeRepository": "https://github.com/gftdcojp/ai-gftd-apps-gftdcojp",
  "programmingLanguage": [
    "Go",
    "TypeScript",
    "Svelte"
  ],
  "component": [
    {
      "@type": "WebApplication",
      "name": "hub-ui",
      "description": "Static frontend for hub.gftd.ai project portal and MCP endpoint discovery",
      "applicationCategory": "Frontend",
      "runtimePlatform": "SvelteKit static",
      "path": "cdn/hub-ui-m9x2k4qp"
    },
    {
      "@type": "SoftwareApplication",
      "name": "hub-mcp-component",
      "description": "SpinApp MCP component providing GitHub REST API compatible endpoint (repos, PRs, statuses, check-runs)",
      "applicationCategory": "Backend",
      "programmingLanguage": "Go",
      "runtimePlatform": "SpinApp (TinyGo WebAssembly)",
      "path": "wasm/hub-mcp-component"
    }
  ],
  "tasks": [
    {
      "status": "completed",
      "task": "Implement GitHub REST API subset via MCP tool (hubgftdai)"
    },
    {
      "status": "completed",
      "task": "Migrate from legacy runtime to SpinApp component"
    },
    {
      "status": "completed",
      "task": "Add ClickHouse ORM persistence"
    },
    {
      "status": "completed",
      "task": "Fix HTTPRoute for gftd.ai standard routing"
    },
    {
      "status": "completed",
      "task": "Add ClickHouse ORM capability to WADM manifest"
    },
    {
      "status": "pending",
      "task": "Deploy via Tekton pipeline and verify qk6cjn0l.gftd.ai/api/mcp"
    }
  ]
}
