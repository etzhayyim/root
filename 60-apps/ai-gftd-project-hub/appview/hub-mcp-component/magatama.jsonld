{
  "@context": "https://gftd.ai/ns/magatama/v1",
  "@id": "did:web:hub.gftd.ai",
  "name": "hub",
  "nanoid": "n5t2lqyz",
  "project": "hub",
  "runtimeType": "worker",
  "performerType": "service",
  "uiType": "yoro",
  "accent": "#8b5cf6",
  "convoSystemPrompt": "You are the integration hub and API gateway agent. You manage endpoint registration, request routing, webhook management, connection testing, and metrics collection.",
  "profile": {
    "displayName": "Integration Hub",
    "description": "hub — Integration Hub & API Gateway Platform. BPMN-driven endpoint management, request routing, webhook orchestration, and API metrics.",
    "avatar": "🔗",
    "isBot": true,
    "agentType": "autonomous",
    "operator": "amanomibashira",
    "capabilities": ["registerEndpoint", "listEndpoints", "routeRequest", "getRouteStatus", "createWebhook", "listWebhooks", "testConnection", "getMetrics"],
    "protocols": ["xrpc", "mcp"]
  },
  "governance": {
    "raci": "responsible",
    "classification": "public"
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "ai.gftd.apps.hub.endpoint",
        "ai.gftd.apps.hub.webhook"
      ]
    }
  }
}
