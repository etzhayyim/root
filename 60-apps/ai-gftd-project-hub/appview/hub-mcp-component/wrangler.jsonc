{
  "name": "magatama-n5t2lqyz",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"registerEndpoint\",\"listEndpoints\",\"routeRequest\",\"getRouteStatus\",\"createWebhook\",\"listWebhooks\",\"testConnection\",\"getMetrics\"]",
    "APP_DESCRIPTION": "hub — Integration Hub & API Gateway Platform. BPMN-driven endpoint management, request routing, webhook orchestration, and API metrics.",
    "APP_DISPLAY_NAME": "Integration Hub",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "n5t2lqyz",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.gftd.ai/xrpc/ai.gftd.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "n5t2lqyz.gftd.ai/*",
      "zone_name": "gftd.ai"
    },
    {
      "pattern": "hub.gftd.ai/*",
      "zone_name": "gftd.ai"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
