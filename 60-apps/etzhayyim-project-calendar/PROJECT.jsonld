                "https://github.com/etzhayyim/etzhayyim-calendar/resources/adapters/terminusdb"
              ],
              "consumer": "https://github.com/etzhayyim/etzhayyim-calendar/ports/services/graphql",
              "producer": "https://github.com/etzhayyim/etzhayyim-calendar/ports/services/graphql",
              "operations": [
                {
                  "id": "https://github.com/etzhayyim/etzhayyim-calendar/activities/event-management#list",
                  "name": "List Events",
                  "description": "指定されたカレンダーのイベント一覧を取得",
                  "implementation": "internal/process/src/event-handler.ts::EventHandler.listEvents"
                },
                {
                  "id": "https://github.com/etzhayyim/etzhayyim-calendar/activities/event-management#get",
                  "name": "Get Event",
                  "description": "指定されたIDのイベントを取得",
