                },
                {
                  "id": "https://github.com/etzhayyim/etzhayyim-calendar/activities/event-management#move",
                  "name": "Move Event",
                  "description": "イベントを別のカレンダーに移動",
                  "implementation": "internal/process/src/event-handler.ts::EventHandler.moveEvent"
                },
                {
                  "id": "https://github.com/etzhayyim/etzhayyim-calendar/activities/event-management#quickAdd",
                  "name": "Quick Add Event",
                  "description": "自然言語テキストからイベントをクイック追加",
                  "implementation": "internal/process/src/event-handler.ts::EventHandler.quickAddEvent"
                }
              ],
              "createdAt": "2025-01-27T00:00:00+09:00",
              "updatedAt": "2025-01-27T00:00:00+09:00"
            },
            {
