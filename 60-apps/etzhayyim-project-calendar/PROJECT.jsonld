          },
          "id": "https://github.com/etzhayyim/etzhayyim-calendar/goal",
          "type": "cpm:Goal",
          "name": "AI Etzhayyim Calendar Project Goal",
          "description": "Google Calendar API完全互換のカレンダーアプリケーションを、RDF/OWLベースのセマンティックデータベース（TerminusDB）とGraphQL APIを用いて実現する",
          "desiredEffect": "https://github.com/etzhayyim/etzhayyim-calendar/goal#effect-calendar-management",
          "realizedBy": [
            "https://github.com/etzhayyim/etzhayyim-calendar/capabilities#calendar-management",
            "https://github.com/etzhayyim/etzhayyim-calendar/capabilities#event-management",
            "https://github.com/etzhayyim/etzhayyim-calendar/capabilities#calendar-list-management",
            "https://github.com/etzhayyim/etzhayyim-calendar/capabilities#settings-management",
            "https://github.com/etzhayyim/etzhayyim-calendar/capabilities#freebusy-query"
          ],
          "createdAt": "2025-01-27T00:00:00+09:00",
          "updatedAt": "2025-01-27T00:00:00+09:00"
        }
      },
