                },
                {
                  "id": "https://github.com/etzhayyim/etzhayyim-calendar/activities/event-management#create",
                  "name": "Create Event",
                  "description": "新しいイベントを作成",
                  "implementation": "internal/process/src/event-handler.ts::EventHandler.createEvent"
                },
                {
                  "id": "https://github.com/etzhayyim/etzhayyim-calendar/activities/event-management#update",
                  "name": "Update Event",
                  "description": "イベントを更新",
                  "implementation": "internal/process/src/event-handler.ts::EventHandler.updateEvent"
                },
                {
                  "id": "https://github.com/etzhayyim/etzhayyim-calendar/activities/event-management#patch",
                  "name": "Patch Event",
                  "description": "イベントを部分更新",
                  "implementation": "internal/process/src/event-handler.ts::EventHandler.patchEvent"
                },
                {
                  "id": "https://github.com/etzhayyim/etzhayyim-calendar/activities/event-management#delete",
                  "name": "Delete Event",
                  "description": "イベントを削除",
