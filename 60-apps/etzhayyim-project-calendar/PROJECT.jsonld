{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": "https://calendar.etzhayyim.com",
  "name": "etzhayyim-project-calendar",
  "description": "Etzhayyim Calendar - Google Calendar API compatible calendar application with Rust GraphQL microservice and Next.js UI",
  "url": "https://calendar.etzhayyim.com",
  "applicationCategory": "Productivity",
  "operatingSystem": "Kubernetes",
  "author": {
    "@type": "Organization",
    "name": "etzhayyim",
    "url": "https://etzhayyim.com"
  },
  "component": [
    {
      "@type": "SoftwareApplication",
      "name": "calendar",
      "description": "Rust GraphQL microservice - Google Calendar API compatible backend with App runtime integration",
      "applicationCategory": "Backend",
      "programmingLanguage": "Rust",
      "runtimePlatform": "App runtime (Tier 2, Event-Driven)"
    },
    {
      "@type": "SoftwareApplication",
      "name": "calendar-ui",
      "description": "Next.js App Router calendar UI served via nginx",
      "applicationCategory": "Frontend",
      "programmingLanguage": "TypeScript",
      "runtimePlatform": "nginx (Tier 3, Static)"
    }
  ],
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
