          },
          "id": "https://github.com/etzhayyim/etzhayyim-calendar/activities",
          "type": "cpm:ActivityCollection",
          "name": "Calendar Management Activities",
          "description": "カレンダー管理システムの全アクティビティ定義",
          "createdAt": "2025-01-27T00:00:00+09:00",
          "updatedAt": "2025-01-27T00:00:00+09:00",
          "activities": [
            {
              "id": "https://github.com/etzhayyim/etzhayyim-calendar/activities/calendar-management",
              "type": "cpm:Activity",
              "name": "Calendar Management Activity",
              "description": "カレンダーの作成、取得、更新、削除操作を提供するアクティビティ",
              "realizesCapability": "https://github.com/etzhayyim/etzhayyim-calendar/capabilities#calendar-crud",
              "performedBy": [
                "https://github.com/etzhayyim/etzhayyim-calendar/performers/services/calendar-service",
                "https://github.com/etzhayyim/etzhayyim-calendar/performers/actors/calendar-user"
              ],
              "usesResource": [
                "https://github.com/etzhayyim/etzhayyim-calendar/resources/schemas/calendar",
                "https://github.com/etzhayyim/etzhayyim-calendar/resources/adapters/terminusdb"
              ],
              "consumer": "https://github.com/etzhayyim/etzhayyim-calendar/ports/services/graphql",
              "producer": "https://github.com/etzhayyim/etzhayyim-calendar/ports/services/graphql",
              "operations": [
                {
                  "id": "https://github.com/etzhayyim/etzhayyim-calendar/activities/calendar-management#list",
                  "name": "List Calendars",
                  "description": "カレンダー一覧を取得",
                  "implementation": "internal/process/src/calendar-handler.ts::CalendarHandler.listCalendars"
                },
                {
                  "id": "https://github.com/etzhayyim/etzhayyim-calendar/activities/calendar-management#get",
                  "name": "Get Calendar",
                  "description": "指定されたIDのカレンダーを取得",
                  "implementation": "internal/process/src/calendar-handler.ts::CalendarHandler.getCalendar"
                },
                {
                  "id": "https://github.com/etzhayyim/etzhayyim-calendar/activities/calendar-management#create",
                  "name": "Create Calendar",
                  "description": "新しいカレンダーを作成",
                  "implementation": "internal/process/src/calendar-handler.ts::CalendarHandler.createCalendar"
                },
                {
                  "id": "https://github.com/etzhayyim/etzhayyim-calendar/activities/calendar-management#update",
                  "name": "Update Calendar",
                  "description": "カレンダーを更新",
                  "implementation": "internal/process/src/calendar-handler.ts::CalendarHandler.updateCalendar"
                },
                {
                  "id": "https://github.com/etzhayyim/etzhayyim-calendar/activities/calendar-management#patch",
                  "name": "Patch Calendar",
                  "description": "カレンダーを部分更新",
                  "implementation": "internal/process/src/calendar-handler.ts::CalendarHandler.patchCalendar"
                },
                {
                  "id": "https://github.com/etzhayyim/etzhayyim-calendar/activities/calendar-management#delete",
                  "name": "Delete Calendar",
                  "description": "カレンダーを削除",
                  "implementation": "internal/process/src/calendar-handler.ts::CalendarHandler.deleteCalendar"
                }
              ],
              "createdAt": "2025-01-27T00:00:00+09:00",
              "updatedAt": "2025-01-27T00:00:00+09:00"
            },
            {
              "id": "https://github.com/etzhayyim/etzhayyim-calendar/activities/event-management",
              "type": "cpm:Activity",
              "name": "Event Management Activity",
              "description": "イベントの作成、取得、更新、削除、移動操作を提供するアクティビティ",
              "realizesCapability": [
                "https://github.com/etzhayyim/etzhayyim-calendar/capabilities#event-crud",
                "https://github.com/etzhayyim/etzhayyim-calendar/capabilities#event-move",
                "https://github.com/etzhayyim/etzhayyim-calendar/capabilities#event-quick-add"
              ],
              "performedBy": [
                "https://github.com/etzhayyim/etzhayyim-calendar/performers/services/calendar-service",
