{
  "@context": {
    "kyber": "https://kyber-services.etzhayyim.com/schema#",
    "mcp": "https://modelcontextprotocol.io/schema#",
    "schema": "https://schema.org/"
  },
  "@id": "kyber:capability:sheets",
  "@type": "kyber:Capability",
  "name": "Sheets Capability",
  "description": "Collaborative spreadsheet capability for data analysis and management",
  "standard": "CPC-48221",
  "acceptanceCriteria": [
    {
      "id": "AC-1",
      "description": "Users can enter strings and numbers into cells",
      "feature": "cell-editing.feature"
    },
    {
      "id": "AC-2",
      "description": "Formulas starting with '=' are calculated automatically",
      "feature": "cell-editing.feature"
    },
    {
      "id": "AC-3",
      "description": "Workbooks can be created and managed",
      "feature": "workbook-management.feature"
    },
    {
      "id": "AC-4",
      "description": "Data can be visualized through charts",
      "feature": "charts.feature"
    },
    {
      "id": "AC-5",
      "description": "Multiple users can collaborate in real-time with presence indicators",
      "feature": "collaboration.feature"
    },
    {
      "id": "AC-6",
      "description": "Workbooks can be saved as and created from templates",
      "feature": "templates.feature"
    },
    {
      "id": "AC-7",
      "description": "External data can be imported from CSV/Excel files",
      "feature": "import-export.feature"
    },
    {
      "id": "AC-8",
      "description": "Named ranges can be used to reference cell groups easily",
      "feature": "advanced-features.feature"
    },
    {
      "id": "AC-9",
      "description": "Conditional formatting can be applied based on cell values",
      "feature": "advanced-features.feature"
    },
    {
      "id": "AC-10",
      "description": "Data validation rules can be set to ensure data quality",
      "feature": "advanced-features.feature"
    },
    {
      "id": "AC-11",
      "description": "Pivot tables can be created to summarize large datasets",
      "feature": "advanced-features.feature"
    },
    {
      "id": "AC-12",
      "description": "Users and AI can communicate via cell-level comment threads",
      "feature": "advanced-features.feature"
    },
    {
      "id": "AC-13",
      "description": "Advanced formulas like VLOOKUP support 2D grid searching",
      "feature": "advanced-features.feature"
    },
    {
      "id": "AC-14",
      "description": "Hidden developer metadata can be attached to resources for AI context",
      "feature": "advanced-features.feature"
    },
    {
      "id": "AC-15",
      "description": "Critical ranges can be protected from unauthorized edits",
      "feature": "advanced-features.feature"
    },
    {
      "id": "AC-16",
      "description": "Array formulas can dynamically expand results into multiple cells",
      "feature": "advanced-features.feature"
    },
    {
      "id": "AC-17",
      "description": "External data can be dynamically referenced from other workbooks using IMPORTRANGE",
      "feature": "advanced-features.feature"
    },
    {
      "id": "AC-18",
      "description": "Rich text formatting allows multiple styles within a single cell",
      "feature": "advanced-features.feature"
    },
    {
      "id": "AC-19",
      "description": "Users and AI agents can be mentioned in comments to trigger notifications",
      "feature": "advanced-features.feature"
    }
  ]
}
