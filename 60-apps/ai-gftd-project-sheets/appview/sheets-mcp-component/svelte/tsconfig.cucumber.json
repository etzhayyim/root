{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "$lib/*": [
        "./src/lib/*"
      ]
    }
  },
  "include": [
    "tests/**/*.ts"
  ]
}
