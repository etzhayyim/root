{
  "@context": "https://schema.org",
  "@type": "Project",
  "name": "AGI Sheets Project",
  "identifier": "ai-gftd-project-sheets",
  "description": "Collaborative spreadsheet platform with real-time editing, formula engine, charts, and AGI-powered data analysis.",
  "hasPart": [
    {
      "@type": "CreativeWork",
      "name": "Strategy",
      "url": "STRATEGY.jsonld"
    },
    {
      "@type": "CreativeWork",
      "name": "Capabilities",
      "url": "capabilities.jsonld"
    },
    {
      "@type": "CreativeWork",
      "name": "Activities",
      "url": "activities.jsonld"
    },
    {
      "@type": "WebApplication",
      "name": "Sheets",
      "url": "https://sheets.gftd.ai"
    }
  ],
  "performers": [
    {
      "@type": "Service",
      "name": "Sheets App",
      "identifier": "sheets-app",
      "description": "Sheets backend service handling workbook operations, formulas, and collaboration."
    },
    {
      "@type": "Service",
      "name": "Sheets UI",
      "identifier": "sheets-ui",
      "description": "Svelte-based spreadsheet frontend with real-time collaboration."
    }
  ],
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "STRATEGY.jsonld",
        "content": {
          "@context": "https://schema.org",
          "@type": "CreativeWork",
          "name": "Sheets Strategy",
          "description": "Cloud-native collaborative spreadsheet with AGI-assisted data analysis and real-time multi-user editing.",
          "mainEntity": {
            "@type": "PlanAction",
            "goal": [
              "Real-time collaborative spreadsheet editing with CRDT-based conflict resolution.",
              "Full formula engine with VLOOKUP, IMPORTRANGE, and array formula support.",
              "Chart and pivot table visualization for data analysis.",
              "AGI-powered data validation, formatting suggestions, and formula generation."
            ]
          }
        }
      },
      {
        "fileName": "activities.jsonld",
        "content": {
          "@context": {
            "kyber": "https://kyber-services.gftd.ai/schema#",
            "prov": "http://www.w3.org/ns/prov#",
            "schema": "https://schema.org/"
          },
          "@id": "kyber:activity-model:sheets",
          "@type": "kyber:OperationalActivityModel",
          "view": "OV-5b",
          "operationalActivities": [
            {
              "@id": "kyber:activity:edit-cell",
              "name": "Edit Cell Content",
              "description": "The process of selecting a cell and updating its value or formula",
              "performer": "kyber:performer:user",
              "sv4Mapping": "sv:service:sheets:update-cell"
            },
            {
              "@id": "kyber:activity:manage-workbook",
              "name": "Manage Workbook",
              "description": "The process of creating or deleting spreadsheet workbooks",
              "performer": "kyber:performer:user",
              "sv4Mapping": "sv:service:sheets:workbook-api"
            },
            {
              "@id": "kyber:activity:visualize-data",
              "name": "Visualize Data",
              "description": "The process of creating charts from a range of cells",
              "performer": "kyber:performer:user",
              "sv4Mapping": "sv:service:sheets:chart-renderer"
            },
            {
              "@id": "kyber:activity:collaborate",
              "name": "Collaborate in Real-time",
              "description": "The process of multiple users editing the same sheet simultaneously",
              "performer": "kyber:performer:user",
              "sv4Mapping": "sv:service:sheets:collaboration-api"
            },
            {
              "@id": "kyber:activity:use-templates",
              "name": "Use Templates",
              "description": "The process of creating new workbooks from standardized templates",
              "performer": "kyber:performer:user",
              "sv4Mapping": "sv:service:sheets:template-api"
            },
            {
              "@id": "kyber:activity:manage-named-ranges",
              "name": "Manage Named Ranges",
              "description": "The process of naming specific cell ranges for easier reference",
              "performer": "kyber:performer:user",
              "sv4Mapping": "sv:service:sheets:named-range-api"
            },
            {
              "@id": "kyber:activity:apply-conditional-formatting",
              "name": "Apply Conditional Formatting",
              "description": "The process of setting rules to format cells based on their content",
              "performer": "kyber:performer:user",
              "sv4Mapping": "sv:service:sheets:conditional-format-api"
            },
            {
              "@id": "kyber:activity:validate-data",
              "name": "Validate Data",
              "description": "The process of setting rules to restrict data entry in cells",
              "performer": "kyber:performer:user",
              "sv4Mapping": "sv:service:sheets:data-validation-api"
            },
            {
              "@id": "kyber:activity:analyze-with-pivot",
              "name": "Analyze with Pivot Tables",
              "description": "The process of summarizing and aggregating data using pivot tables",
              "performer": "kyber:performer:user",
              "sv4Mapping": "sv:service:sheets:pivot-table-api"
            },
            {
              "@id": "kyber:activity:communicate-via-comments",
              "name": "Communicate via Comments",
              "description": "The process of discussing cell data through threaded comments",
              "performer": "kyber:performer:user",
              "sv4Mapping": "sv:service:sheets:comment-api"
            },
            {
              "@id": "kyber:activity:manage-metadata",
              "name": "Manage Developer Metadata",
              "description": "The process of attaching hidden metadata to cells and sheets",
              "performer": "kyber:performer:user",
              "sv4Mapping": "sv:service:sheets:metadata-api"
            },
            {
              "@id": "kyber:activity:protect-ranges",
              "name": "Protect Cell Ranges",
              "description": "The process of restricting edit access to specific cell ranges",
              "performer": "kyber:performer:user",
              "sv4Mapping": "sv:service:sheets:protection-api"
            },
            {
              "@id": "kyber:activity:reference-external-data",
              "name": "Reference External Data",
              "description": "The process of linking data between different workbooks",
              "performer": "kyber:performer:user",
              "sv4Mapping": "sv:service:sheets:external-reference-api"
            },
            {
              "@id": "kyber:activity:format-rich-text",
              "name": "Format Rich Text",
              "description": "The process of applying multiple styles to text within a single cell",
              "performer": "kyber:performer:user",
              "sv4Mapping": "sv:service:sheets:rich-text-api"
            }
          ]
        }
      },
      {
        "fileName": "capabilities.jsonld",
        "content": {
          "@context": {
            "kyber": "https://kyber-services.gftd.ai/schema#",
            "mcp": "https://modelcontextprotocol.io/schema#",
            "schema": "https://schema.org/"
          },
          "@id": "kyber:capability:sheets",
          "@type": "kyber:Capability",
          "name": "Sheets Capability",
          "description": "Collaborative spreadsheet capability for data analysis and management",
          "standard": "CPC-48221",
          "acceptanceCriteria": [
            {
              "id": "AC-1",
              "description": "Users can enter strings and numbers into cells",
              "feature": "cell-editing.feature"
            },
            {
              "id": "AC-2",
              "description": "Formulas starting with '=' are calculated automatically",
              "feature": "cell-editing.feature"
            },
            {
              "id": "AC-3",
              "description": "Workbooks can be created and managed",
              "feature": "workbook-management.feature"
            },
            {
              "id": "AC-4",
              "description": "Data can be visualized through charts",
              "feature": "charts.feature"
            },
            {
              "id": "AC-5",
              "description": "Multiple users can collaborate in real-time with presence indicators",
              "feature": "collaboration.feature"
            },
            {
              "id": "AC-6",
              "description": "Workbooks can be saved as and created from templates",
              "feature": "templates.feature"
            },
            {
              "id": "AC-7",
              "description": "External data can be imported from CSV/Excel files",
              "feature": "import-export.feature"
            },
            {
              "id": "AC-8",
              "description": "Named ranges can be used to reference cell groups easily",
              "feature": "advanced-features.feature"
            },
            {
              "id": "AC-9",
              "description": "Conditional formatting can be applied based on cell values",
              "feature": "advanced-features.feature"
            },
            {
              "id": "AC-10",
              "description": "Data validation rules can be set to ensure data quality",
              "feature": "advanced-features.feature"
            },
            {
              "id": "AC-11",
              "description": "Pivot tables can be created to summarize large datasets",
              "feature": "advanced-features.feature"
            },
            {
              "id": "AC-12",
              "description": "Users and AI can communicate via cell-level comment threads",
              "feature": "advanced-features.feature"
            },
            {
              "id": "AC-13",
              "description": "Advanced formulas like VLOOKUP support 2D grid searching",
              "feature": "advanced-features.feature"
            },
            {
              "id": "AC-14",
              "description": "Hidden developer metadata can be attached to resources for AI context",
              "feature": "advanced-features.feature"
            },
            {
              "id": "AC-15",
              "description": "Critical ranges can be protected from unauthorized edits",
              "feature": "advanced-features.feature"
            },
            {
              "id": "AC-16",
              "description": "Array formulas can dynamically expand results into multiple cells",
              "feature": "advanced-features.feature"
            },
            {
              "id": "AC-17",
              "description": "External data can be dynamically referenced from other workbooks using IMPORTRANGE",
              "feature": "advanced-features.feature"
            },
            {
              "id": "AC-18",
              "description": "Rich text formatting allows multiple styles within a single cell",
              "feature": "advanced-features.feature"
            },
            {
              "id": "AC-19",
              "description": "Users and AI agents can be mentioned in comments to trigger notifications",
              "feature": "advanced-features.feature"
            }
          ]
        }
      },
      {
        "fileName": "scheduler.jsonld",
        "content": {
          "@context": [
            "https://schema.org/",
            {
              "gftd": "https://gftd.ai/schemas/",
              "capabilities": "gftd:capabilities",
              "survivalIndicators": "gftd:survivalIndicators",
              "scheduler": "gftd:scheduler",
              "milestones": "gftd:milestones",
              "blockers": "gftd:blockers",
              "dependsOn": {
                "@id": "gftd:dependsOn",
                "@type": "@id"
              },
              "ingestKey": "gftd:ingestKey",
              "window": "gftd:window",
              "valueUpdatedAt": "gftd:valueUpdatedAt"
            }
          ],
          "@type": "CreativeWork",
          "name": "AGI Sheets Project Scheduler",
          "identifier": "ai-gftd-project-sheets/scheduler",
          "description": "Project schedule (milestones) and blockers.",
          "dateCreated": "2026-02-15T04:25:26+00:00",
          "milestones": [],
          "blockers": []
        }
      }
    ]
  }
}
