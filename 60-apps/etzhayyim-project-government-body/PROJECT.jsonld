                  "name": "Basic research",
                  "implementation": "Research funding allocation via governance vote, arxiv integration"
                },
                {
                  "termCode": "01.5",
                  "name": "R&D general public services",
                  "implementation": "Autonomous R&D performers, experiment orchestration"
                },
                {
