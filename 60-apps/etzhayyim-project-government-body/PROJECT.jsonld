                  "termCode": "01.7",
                  "name": "Public debt transactions",
                  "implementation": "GCC bond smart contracts, sovereign debt management"
                },
                {
                  "termCode": "01.8",
                  "name": "Transfers of a general character between different levels of government",
                  "implementation": "Inter-ministry GCC transfer protocols, budget reallocation algorithms"
                }
              ]
            },
            {
