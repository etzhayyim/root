  "accountabilityFramework": {
    "@type": "CreativeWork",
    "name": "GD Accountability Framework",
    "identifier": "gd-accountability-framework-v0.1",
    "version": "0.1.0",
    "dateCreated": "2026-03-03",
    "isBasedOn": "projects/etzhayyim-project-government-body/260303-gd-accountability-framework.md",
    "frameworkScope": "Government Domain (GD)",
    "principles": [
      "traceability-by-default",
      "human-over-ai-control",
      "explainability-at-decision-boundary",
      "proportional-governance",
      "public-accountability"
    ],
    "raciRoles": [
      "policy-owner",
      "service-owner",
      "data-steward",
      "ai-operator",
      "compliance-officer",
      "incident-commander"
    ],
    "decisionClasses": [
      {
        "classId": "A",
        "riskLevel": "low",
        "approvalRequirement": "auto-execute-with-audit-log"
      },
      {
        "classId": "B",
        "riskLevel": "medium",
        "approvalRequirement": "single-human-approval"
      },
      {
        "classId": "C",
        "riskLevel": "high",
        "approvalRequirement": "dual-approval-owner-and-compliance"
      }
    ],
    "evidenceSchema": [
      "event_id",
      "decision_class",
      "actor_type",
      "actor_id",
      "input_refs",
      "policy_refs",
      "output_summary",
      "risk_score",
      "approved_by",
      "timestamp_utc"
    ],
    "controls": {
      "preventive": [
        "policy-as-code-gates",
        "role-based-access-control",
        "pii-classification-tags",
        "high-risk-action-deny-list"
      ],
      "detective": [
        "drift-detection",
        "anomaly-detection",
        "approval-bypass-detection"
      ],
      "corrective": [
        "automatic-rollback-playbook",
        "kill-switch",
        "incident-severity-policy"
      ]
    },
    "kpiTargets": {
      "decisionTraceCoverageMin": 0.99,
      "approvalSlaBHoursMax": 4,
      "approvalSlaCHoursMax": 24,
      "publicDisclosureLatencyDaysMax": 7
    },
    "kriThresholds": {
      "unapprovedHighRiskActionsMax": 0,
      "auditLogGapRateMax": 0.001
    },
    "governanceCadence": {
      "daily": "operational-review",
      "weekly": "accountability-review",
      "monthly": "compliance-committee",
      "quarterly": "external-audit-readiness"
    },
    "implementationPlan90d": [
      "phase-1-schema-raci-decision-tagging",
      "phase-2-approval-ledger-dashboard",
      "phase-3-incident-drill-audit-dry-run-public-reporting"
    ]
  },
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "GITSTATE.jsonld",
        "content": {
          "@context": [
            "https://schema.org",
            {
              "etzhayyim": "https://etzhayyim.com/schemas/",
              "primaryResource": "etzhayyim:primaryResource",
              "publishedEndpoint": "etzhayyim:publishedEndpoint",
              "gitPath": "etzhayyim:gitPath",
              "gitBranch": "etzhayyim:gitBranch",
              "gitCommit": "etzhayyim:gitCommit"
            }
          ],
          "@type": "Dataset",
          "name": "Etzhayyim Gov/HAR Hiring GitState",
          "description": "etzhayyim-project-government-body が管理する、採用プランニングとスケジュールの GitState 公開メタデータ。",
          "primaryResource": [
            {
              "@type": "CreativeWork",
              "name": "Gov resource planning",
              "gitPath": "projects/etzhayyim-project-government-body/RESOURCE_PLANNING.jsonld",
              "publishedEndpoint": "https://gb.etzhayyim.com/api/v1/planning/resource"
            },
            {
              "@type": "CreativeWork",
              "name": "Gov scheduler",
              "gitPath": "projects/etzhayyim-project-government-body/scheduler.jsonld",
              "publishedEndpoint": "https://gb.etzhayyim.com/api/v1/planning/schedule"
            },
            {
              "@type": "CreativeWork",
              "name": "HAR job postings",
              "gitPath": "projects/etzhayyim-project-har/JOB_POSTINGS.jsonld",
              "publishedEndpoint": "https://har.etzhayyim.com/api/v1/job-postings"
            },
            {
              "@type": "CreativeWork",
              "name": "HAR scheduler",
              "gitPath": "projects/etzhayyim-project-har/scheduler.jsonld",
              "publishedEndpoint": "https://har.etzhayyim.com/api/v1/schedule"
            }
          ],
          "distribution": [
            {
              "@type": "DataDownload",
              "name": "gb.etzhayyim.com Planning View",
              "contentUrl": "https://gb.etzhayyim.com/planning"
            },
            {
              "@type": "DataDownload",
              "name": "har.etzhayyim.com Hiring View",
              "contentUrl": "https://har.etzhayyim.com/jobs"
            }
          ],
          "gitBranch": "main",
          "gitCommit": "managed-by-ci"
        }
      },
      {
        "fileName": "RESOURCE_PLANNING.jsonld",
        "content": {
          "@context": [
            "https://schema.org",
            {
              "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
              "dm2": "https://www.omg.org/spec/DoDAF-DM2/",
              "etzhayyim": "https://etzhayyim.com/schemas/",
              "resourceFlow": "dm2:ResourceFlow",
              "performer": "dm2:Performer",
              "activity": "dm2:Activity",
              "information": "dm2:Information",
              "rule": "dm2:Rule",
              "measures": "dm2:Measure",
              "consumes": "etzhayyim:consumes",
              "produces": "etzhayyim:produces",
              "allocates": "etzhayyim:allocates"
            }
          ],
          "@type": "CreativeWork",
          "name": "etzhayyim-project-government-body Resource Planning (DoDAF v2 DM2)",
          "description": "etzhayyim-project-harのAI主導採用を政府運用に組み込むためのDM2準拠リソース計画。",
          "about": {
            "@type": "Thing",
            "name": "DM2 Resource Model for AI→Human Hiring"
          },
          "hasPart": [
            {
              "@type": "performer",
              "identifier": "perf-ai-hiring-orchestrator",
              "name": "AI Hiring Orchestrator",
              "description": "job/role/contract/salaryを定義し、公募データを生成するAI実行主体。"
            },
            {
              "@type": "performer",
              "identifier": "perf-human-review-board",
              "name": "Human Review Board",
              "description": "法務・倫理・労務観点で求人要件をレビューする人間チーム。"
            },
            {
              "@type": "information",
              "identifier": "info-har-job-jsonld",
              "name": "HAR Job Posting JSON-LD",
              "description": "Git上に保存される一次リソース。採用活動の公式データソース。",
              "url": "../etzhayyim-project-har/JOB_POSTINGS.jsonld"
            },
            {
              "@type": "SoftwareApplication",
              "identifier": "actor-gov-planning-mcp",
              "name": "gov-planning-mcp-component",
              "description": "SpinApp actor that serves planning/schedule/gitstate JSON-LD APIs for gb.etzhayyim.com and har.etzhayyim.com.",
              "url": "wasm/gov-planning-mcp-component"
            },
            {
              "@type": "information",
              "identifier": "info-gitstate-jsonld",
              "name": "Gov/HAR GitState JSON-LD",
              "description": "GitState metadata for canonical planning and hiring resources.",
              "url": "GITSTATE.jsonld"
            }
          ],
          "potentialAction": [
            {
              "@type": "activity",
              "identifier": "act-define-workforce-demand",
              "name": "Define Workforce Demand",
              "description": "COFOG別の人材需要を定義し、役割と成果責任を割当てる。",
              "produces": "info-har-job-jsonld"
            },
            {
              "@type": "activity",
              "identifier": "act-publish-public-recruitment",
              "name": "Publish Public Recruitment",
              "description": "Git管理のJSON-LD求人を公開し、透明性のある公募を実施する。",
              "consumes": "info-har-job-jsonld"
            },
            {
              "@type": "activity",
              "identifier": "act-track-hiring-kpi",
              "name": "Track Hiring KPI",
              "description": "充足率・採用リードタイム・給与帯適合率を継続測定する。"
            },
            {
              "@type": "activity",
              "identifier": "act-publish-gitstate-jsonld",
              "name": "Publish GitState JSON-LD",
              "description": "Publish planning/schedule/job JSON-LD as canonical endpoints for visualization.",
              "consumes": "info-har-job-jsonld",
              "produces": "info-gitstate-jsonld"
            }
          ],
          "resourceFlow": [
            {
              "@type": "resourceFlow",
              "identifier": "flow-ai-to-git",
              "name": "AI-to-Git Job Data Flow",
              "description": "AI Hiring Orchestratorが生成した求人要件をJSON-LDとしてGitへ登録する。",
              "source": "perf-ai-hiring-orchestrator",
              "target": "info-har-job-jsonld"
            },
            {
              "@type": "resourceFlow",
              "identifier": "flow-git-to-public",
              "name": "Git-to-Public Recruitment Flow",
              "description": "Git一次情報を公募チャネルへ配信し、同一データで採用を実行する。",
              "source": "info-har-job-jsonld",
              "target": "act-publish-public-recruitment"
            },
            {
              "@type": "resourceFlow",
              "identifier": "flow-gitstate-to-dashboard",
              "name": "GitState-to-Dashboard Flow",
              "description": "gov-planning-mcp-component exposes JSON-LD to gb.etzhayyim.com/planning and har.etzhayyim.com/jobs dashboards.",
              "source": "info-gitstate-jsonld",
              "target": "actor-gov-planning-mcp"
            }
          ],
          "rule": [
            {
              "@type": "rule",
              "identifier": "rule-primary-source",
              "name": "Primary Source Rule",
              "description": "求人の正本はGit上のJSON-LDのみとし、外部媒体はその複製とする。"
            },
            {
              "@type": "rule",
              "identifier": "rule-compensation-declaration",
              "name": "Compensation Declaration Rule",
              "description": "全求人にjob/role/contract/給与レンジを必須明記する。"
            },
            {
              "@type": "rule",
              "identifier": "rule-visualization-endpoint-parity",
              "name": "Visualization Endpoint Parity Rule",
              "description": "gb.etzhayyim.com と har.etzhayyim.com の表示データは GitState JSON-LD からのみ取得する。"
            }
          ],
          "measures": [
            {
              "@type": "PropertyValue",
              "identifier": "kpi-time-to-hire",
              "name": "Time to Hire",
              "value": "<=45 days"
            },
            {
              "@type": "PropertyValue",
              "identifier": "kpi-fill-rate",
              "name": "Position Fill Rate",
              "value": ">=85% per quarter"
            }
          ]
        }
      },
      {
        "fileName": "STRATEGY.jsonld",
        "content": {
          "@context": "https://schema.org",
          "@type": "CreativeWork",
          "name": "Etzhayyim Digital Nation-State Strategy",
          "description": "Strategic plan for realizing a blockchain-registered nation-state operated by Stichting Etzhayyim (Netherlands religious corporation), extending the etzhayyim-organism autopoietic architecture into sovereign governance.",
          "mainEntity": {
            "@type": "PlanAction",
            "name": "Etzhayyim Sovereign Digital Government",
            "goal": [
              "Establish Etzhayyim as a blockchain-registered sovereign digital territory with on-chain land registry (NFT deed system on Ethereum L2)",
              "Register Stichting Etzhayyim as a Dutch religious corporation (kerkgenootschap) under Burgerlijk Wetboek Boek 2, Titel 2 — serving as the legal operator of the nation-state",
              "Implement all 10 COFOG divisions as autonomous AI Agent performers on Kubernetes, providing complete government services without human bureaucracy",
              "Issue sovereign digital currency (GCC — Etzhayyim Computing Credits) as the national currency backed by computing resources",
              "Create blockchain-based citizen identity (DID / Verifiable Credentials) for all residents of the digital territory",
              "Achieve constitutional governance through on-chain voting and smart contract-enforced policy execution",
              "Extend the etzhayyim-organism autopoietic model: the government itself is a self-producing, self-maintaining living system",
              "Establish AI-to-human workforce governance: AI defines job/role/contract/salary, publishes open recruitment, and stores canonical postings as Git-managed JSON-LD."
            ]
          },
          "about": [
            {
              "@type": "PlanAction",
              "name": "Phase 1: Foundation (Legal + Blockchain Infrastructure)",
              "description": "Establish the legal and technical foundation for the digital nation-state",
              "goal": [
                "Register Stichting Etzhayyim in the Netherlands as a kerkgenootschap with formal statuten",
                "Deploy Ethereum L2 (Optimism/Arbitrum) smart contracts for land registry",
                "Implement DID (Decentralized Identifier) system for citizen identity using W3C DID Core spec",
                "Deploy GCC token contract (ERC-20) as sovereign currency backed by k8s compute allocation",
                "Draft and ratify digital constitution as on-chain governance document",
                "Set up gb.etzhayyim.com portal with citizen registration and identity management"
              ]
            },
            {
              "@type": "PlanAction",
              "name": "Phase 2: Core Government Services (COFOG 01-03)",
              "description": "Deploy the foundational government functions",
              "goal": [
                "COFOG 01 — General Public Services: AI-operated executive council, legislative smart contracts, treasury management (GCC), tax collection system, public debt management",
                "COFOG 02 — Defence: Cyber defence performers, digital territory integrity monitoring, blockchain network security, DDoS protection sovereign infrastructure",
                "COFOG 03 — Public Order and Safety: AI judicial performers (smart contract dispute resolution), digital police (fraud detection, anti-money laundering), fire protection equivalent (incident response / disaster recovery)",
                "Deploy SpinApp instances for each ministry as event-driven services",
                "Establish inter-ministry message stream channels via Connect gRPC"
              ]
            },
            {
              "@type": "PlanAction",
              "name": "Phase 3: Economic + Infrastructure Services (COFOG 04-06)",
              "description": "Deploy economic and infrastructure government services",
              "goal": [
                "COFOG 04 — Economic Affairs: Trade regulation performers, employment services (AI job matching), digital commerce regulation, startup incubation programs, GCC monetary policy",
                "COFOG 05 — Environmental Protection: Carbon accounting per compute workload, green energy tracking for k8s nodes, sustainability reporting, waste management (data lifecycle / retention policies)",
                "COFOG 06 — Housing and Community Amenities: Digital land allocation (NFT parcels), utility metering (compute/storage/bandwidth as utilities), community forum services, street lighting equivalent (monitoring / observability dashboards)",
                "Implement DoDAF v2 DM2 resource planning for human workforce allocation, linking etzhayyim-project-har job-posting JSON-LD as the primary resource."
              ]
            },
            {
              "@type": "PlanAction",
              "name": "Phase 4: Human Services (COFOG 07-10)",
              "description": "Deploy citizen welfare and social services",
              "goal": [
                "COFOG 07 — Health: AI health advisory performers, medical record management (encrypted on-chain), public health monitoring, pharmaceutical regulation, telemedicine coordination",
                "COFOG 08 — Recreation, Culture and Religion: Core function of Stichting Etzhayyim — religious services, cultural preservation (digital archives), broadcasting (content distribution), sports/recreation platform integration",
                "COFOG 09 — Education: AI tutor performers, certification system (on-chain verifiable credentials), research funding allocation, library services (docs.etzhayyim.com integration), lifelong learning programs",
                "COFOG 10 — Social Protection: Universal Basic Income (UBI) via GCC distribution, pension management, unemployment insurance, family support, disability services — all automated via smart contracts + AI performers"
              ]
            },
            {
              "@type": "PlanAction",
              "name": "Phase 5: Autopoietic Sovereign Integration",
              "description": "Achieve full autopoietic closure — the government becomes a self-sustaining information life form",
              "goal": [
                "Close the autopoietic loop: tax revenue (GCC) funds compute → compute runs government services → services generate value → value funds more compute",
                "Implement constitutional amendment process as on-chain governance (citizen voting via DID)",
                "Establish diplomatic APIs with existing COFOG performers (Japan NPA, FBI IC3, etc.)",
                "Publish arxiv extension paper documenting the digital nation-state as the ultimate artificial organization",
                "Achieve recognition as a functional digital jurisdiction for smart contract arbitration",
                "Integrate UNSPSC/UNISPSC classification for all government procurement and service delivery"
              ]
            }
          ]
        }
      },
      {
        "fileName": "capabilities.jsonld",
        "content": {
          "@context": [
            "https://etzhayyim.com/contexts/capabilities.jsonld",
            {
              "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
              "dct": "http://purl.org/dc/terms/",
              "cofog": "https://unstats.un.org/unsd/classifications/Econ/COFOG#"
            }
          ],
          "id": "https://etzhayyim.com/projects/etzhayyim-project-government-body/capabilities",
          "type": "dodaf:Capability",
          "dct:title": "Etzhayyim Digital Nation-State Capability Catalog (CV-2)",
          "dct:description": "DoDAF CV-2 Capability Taxonomy mapped to COFOG divisions. Each capability maps to a government function implemented by AI Agent performers on Kubernetes.",
          "capabilities": [
            {
              "id": "cap-gov-sovereignty",
              "name": "Digital Sovereignty Infrastructure (C0)",
              "cofog": "cross-cutting",
              "description": "Foundational blockchain infrastructure for territorial sovereignty: land registry (NFT), citizen identity (DID/VC), national currency (GCC), constitutional smart contracts.",
              "activities": [
                "act-land-registry-mint",
                "act-did-issuance",
                "act-gcc-mint-burn",
