          "@type": "CreativeWork",
          "name": "etzhayyim-project-government-body Scheduler",
          "identifier": "etzhayyim-project-government-body/scheduler",
          "description": "DoDAF v2 DM2 resource planning / scheduling for AI-led human hiring and GitState publication.",
          "dateCreated": "2026-02-15T04:25:26+00:00",
          "milestones": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Model resource planning",
              "description": "Define DM2 resource model and workforce planning in RESOURCE_PLANNING.jsonld",
              "startDate": "2026-02-17",
              "endDate": "2026-02-18",
              "status": "Completed"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Implement SpinApp planning actor",
              "description": "Deploy gov-planning-mcp-component to publish planning/schedule/gitstate APIs",
              "startDate": "2026-02-18",
              "endDate": "2026-02-20",
              "status": "Planned"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": "Publish GitState JSON-LD",
              "description": "Expose canonical JSON-LD over gb.etzhayyim.com and har.etzhayyim.com",
              "startDate": "2026-02-20",
              "endDate": "2026-02-21",
              "status": "Planned"
            },
            {
              "@type": "ListItem",
              "position": 4,
              "name": "Enable visual dashboards",
              "description": "Render planning at https://gb.etzhayyim.com/planning and hiring data at https://har.etzhayyim.com/jobs",
              "startDate": "2026-02-21",
              "endDate": "2026-02-23",
              "status": "Planned"
            }
          ],
          "blockers": []
        }
      },
