          "@type": "DefinedTermSet",
          "name": "COFOG Classification for Etzhayyim Digital Nation-State",
          "description": "Complete UN Classification of the Functions of Government (COFOG) mapped to Etzhayyim AI Agent performer implementation. Each division represents a ministry operated by autonomous AI performers on Kubernetes.",
          "url": "https://unstats.un.org/unsd/classifications/Econ/Download/In%20Text/COFOG_english.pdf",
          "hasDefinedTerm": [
            {
              "@type": "DefinedTerm",
              "termCode": "01",
              "name": "General public services",
              "description": "Executive and legislative organs, financial and fiscal affairs, external affairs, foreign economic aid, general services, basic research, R&D, public debt transactions, transfers of a general character between different levels of government.",
              "skos:narrower": [
                {
                  "termCode": "01.1",
                  "name": "Executive and legislative organs, financial and fiscal affairs, external affairs",
                  "skos:narrower": [
                    {
