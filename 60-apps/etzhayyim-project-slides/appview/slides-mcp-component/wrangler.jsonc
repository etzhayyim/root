{
  "name": "kotodama-slides-mcp",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"bpmn-dispatch\",\"oauth-redirect\"]",
    "APP_DESCRIPTION": "Thin edge facade; Google Slides OAuth and sync run in BPMN + Zeebe Python",
    "APP_DISPLAY_NAME": "Google Slides",
    "APP_EMBED_URL": "https://slides-mcp.etzhayyim.com/?embed=1",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "slides-mcp",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "appview",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "routes": [
    {
      "pattern": "slides-mcp.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "slides.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
