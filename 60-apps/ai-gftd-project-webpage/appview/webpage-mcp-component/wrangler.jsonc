{
  "name": "magatama-n9j2qp89",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"createPage\",\"listPages\",\"getPage\",\"updatePage\",\"publishPage\",\"listPublished\",\"getPageStats\",\"searchPages\"]",
    "APP_DESCRIPTION": "webpage — Web Page Creation & Publishing Platform. Page lifecycle management, publishing workflows, analytics, and full-text search.",
    "APP_DISPLAY_NAME": "Webpage",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "n9j2qp89",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.gftd.ai/xrpc/ai.gftd.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "n9j2qp89.gftd.ai/*",
      "zone_name": "gftd.ai"
    },
    {
      "pattern": "webpage.gftd.ai/*",
      "zone_name": "gftd.ai"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
