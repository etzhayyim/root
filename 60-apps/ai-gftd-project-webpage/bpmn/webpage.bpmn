<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- createPage -->
  <bpmn:process id="webpage-create-page" name="Webpage Create Page" isExecutable="true">
    <bpmn:startEvent id="start-create-page"/>
    <bpmn:sequenceFlow id="sf-cp-1" sourceRef="start-create-page" targetRef="task-create-page"/>
    <bpmn:serviceTask id="task-create-page" name="Create Page">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.webpage.create.page"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-cp-2" sourceRef="task-create-page" targetRef="end-create-page"/>
    <bpmn:endEvent id="end-create-page"/>
  </bpmn:process>

  <!-- listPages -->
  <bpmn:process id="webpage-list-pages" name="Webpage List Pages" isExecutable="true">
    <bpmn:startEvent id="start-list-pages"/>
    <bpmn:sequenceFlow id="sf-lp-1" sourceRef="start-list-pages" targetRef="task-list-pages"/>
    <bpmn:serviceTask id="task-list-pages" name="List Pages">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.webpage.list.pages"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lp-2" sourceRef="task-list-pages" targetRef="end-list-pages"/>
    <bpmn:endEvent id="end-list-pages"/>
  </bpmn:process>

  <!-- getPage -->
  <bpmn:process id="webpage-get-page" name="Webpage Get Page" isExecutable="true">
    <bpmn:startEvent id="start-get-page"/>
    <bpmn:sequenceFlow id="sf-gp-1" sourceRef="start-get-page" targetRef="task-get-page"/>
    <bpmn:serviceTask id="task-get-page" name="Get Page">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.webpage.get.page"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gp-2" sourceRef="task-get-page" targetRef="end-get-page"/>
    <bpmn:endEvent id="end-get-page"/>
  </bpmn:process>

  <!-- updatePage -->
  <bpmn:process id="webpage-update-page" name="Webpage Update Page" isExecutable="true">
    <bpmn:startEvent id="start-update-page"/>
    <bpmn:sequenceFlow id="sf-up-1" sourceRef="start-update-page" targetRef="task-update-page"/>
    <bpmn:serviceTask id="task-update-page" name="Update Page">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.webpage.update.page"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-up-2" sourceRef="task-update-page" targetRef="end-update-page"/>
    <bpmn:endEvent id="end-update-page"/>
  </bpmn:process>

  <!-- publishPage -->
  <bpmn:process id="webpage-publish-page" name="Webpage Publish Page" isExecutable="true">
    <bpmn:startEvent id="start-publish-page"/>
    <bpmn:sequenceFlow id="sf-pp-1" sourceRef="start-publish-page" targetRef="task-publish-page"/>
    <bpmn:serviceTask id="task-publish-page" name="Publish Page">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.webpage.publish.page"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-pp-2" sourceRef="task-publish-page" targetRef="end-publish-page"/>
    <bpmn:endEvent id="end-publish-page"/>
  </bpmn:process>

  <!-- listPublished -->
  <bpmn:process id="webpage-list-published" name="Webpage List Published" isExecutable="true">
    <bpmn:startEvent id="start-list-published"/>
    <bpmn:sequenceFlow id="sf-lpub-1" sourceRef="start-list-published" targetRef="task-list-published"/>
    <bpmn:serviceTask id="task-list-published" name="List Published">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.webpage.list.published"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lpub-2" sourceRef="task-list-published" targetRef="end-list-published"/>
    <bpmn:endEvent id="end-list-published"/>
  </bpmn:process>

  <!-- getPageStats -->
  <bpmn:process id="webpage-get-page-stats" name="Webpage Get Page Stats" isExecutable="true">
    <bpmn:startEvent id="start-get-page-stats"/>
    <bpmn:sequenceFlow id="sf-gps-1" sourceRef="start-get-page-stats" targetRef="task-get-page-stats"/>
    <bpmn:serviceTask id="task-get-page-stats" name="Get Page Stats">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.webpage.get.pageStats"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gps-2" sourceRef="task-get-page-stats" targetRef="end-get-page-stats"/>
    <bpmn:endEvent id="end-get-page-stats"/>
  </bpmn:process>

  <!-- searchPages -->
  <bpmn:process id="webpage-search-pages" name="Webpage Search Pages" isExecutable="true">
    <bpmn:startEvent id="start-search-pages"/>
    <bpmn:sequenceFlow id="sf-sp-1" sourceRef="start-search-pages" targetRef="task-search-pages"/>
    <bpmn:serviceTask id="task-search-pages" name="Search Pages">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.webpage.search.pages"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-sp-2" sourceRef="task-search-pages" targetRef="end-search-pages"/>
    <bpmn:endEvent id="end-search-pages"/>
  </bpmn:process>

</bpmn:definitions>
