{
  "@context": "https://schema.org/",
  "@type": "SoftwareApplication",
  "@id": "urn:gftd:project:ai-gftd-project-swe",
  "name": "ai-gftd-project-swe",
  "description": "AI Software Engineering agent powered by Claude Opus 4.6. Autonomously designs, implements, tests, reviews, and deploys SpinApp components per project. Uses gftd:agent for durable LLM workflow, gftd:store for git object persistence via hub, and performer framework for virtual actor lifecycle.",
  "applicationCategory": "ai-gftd-project-swe",
  "operatingSystem": "Kubernetes",
  "softwareRequirements": [
    "SpinApp",
    "NATS KV",
    "Claude Opus 4.6 (Anthropic API)",
    "ai-gftd-project-hub (git object store)"
  ],
  "author": {
    "@type": "Organization",
    "name": "GFTD",
    "url": "https://gftd.ai"
  },
  "codeRepository": "https://github.com/gftdcojp/ai-gftd-apps-gftdcojp",
  "programmingLanguage": [
    "Go",
    "TypeScript",
    "Svelte"
  ],
  "component": [
    {
      "@type": "WebApplication",
      "name": "swe-ui",
      "description": "SvelteKit frontend for swe.gftd.ai — IDE-like UI with project explorer, conversation panel, code diff viewer, and deployment status",
      "applicationCategory": "Frontend",
      "runtimePlatform": "SvelteKit static (R2 Custom Domain: swe-gftd-ai)",
      "path": "wasm/ai-gftd-wasm-swe-sw3ng1n3/svelte"
    },
    {
      "@type": "SoftwareApplication",
      "name": "ai-gftd-wasm-swe-sw3ng1n3",
      "description": "SpinApp component — SWE agent orchestrator. Exports gftd:swe/swe via wRPC. Imports gftd:agent (LLM), gftd:store (git), gftd:workflow (durable execution). Uses performer framework for state management.",
      "applicationCategory": "Backend",
      "programmingLanguage": "Go",
      "runtimePlatform": "SpinApp (TinyGo WebAssembly)",
      "path": "wasm/ai-gftd-wasm-swe-sw3ng1n3"
    }
  ],
  "dependency": [
    {
      "@type": "SoftwareApplication",
      "name": "ai-gftd-project-hub",
      "description": "Git-compatible object store for repos, PRs, commits, check runs",
      "link": "wRPC (gftd:store/store)"
    },
    {
      "@type": "SoftwareApplication",
      "name": "gftd-agent-provider",
      "description": "LLM durable agent execution (Opus 4.6)",
      "link": "wRPC (gftd:agent/agent)"
    }
  ],
  "tasks": [
    {
      "status": "completed",
      "task": "Design gftd:swe WIT interface (swe.wit)"
    },
    {
      "status": "completed",
      "task": "Add gftd-swe-provider/consumer worlds to gftd-component.wit"
    },
    {
      "status": "completed",
      "task": "Create proto/gftd/swe/v1/swe.proto (WIT-aligned)"
    },
    {
      "status": "completed",
      "task": "Create PROJECT.jsonld and WADM manifest"
    },
    {
      "status": "pending",
      "task": "Implement SWE agent main.go with performer framework"
    },
    {
      "status": "pending",
      "task": "Implement SvelteKit UI (IDE-like SWE agent dashboard)"
    },
    {
      "status": "pending",
      "task": "Build and deploy to spinkube namespace"
    },
    {
      "status": "pending",
      "task": "Verify 1.gftd.ai/api/mcp endpoint"
    }
  ]
}
