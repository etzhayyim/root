{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": "https://web4.etzhayyim.ai",
  "name": "etzhayyim-project-web4",
  "description": "Browser MoE Coordinator - Distributed LLM inference via browser-based Expert workers. Central coordinator routes k=1 MoE inference to browser workers holding int4-quantized expert weights over WebSocket.",
  "url": "https://web4.etzhayyim.ai",
  "applicationCategory": "AI/ML Infrastructure",
  "operatingSystem": "Kubernetes",
  "author": {
    "@type": "Organization",
    "name": "etzhayyimcojp",
    "url": "https://etzhayyim.ai"
  },
  "component": [
    {
      "@type": "SoftwareApplication",
      "name": "web4-mcp-component",
      "identifier": "1ydveg1m",
      "description": "MCP facade — REST/JSON-RPC gateway for web4 services. Exposes web3.*, provider.*, network.*, generate.*, console.* MCP tools.",
      "applicationCategory": "Backend",
      "programmingLanguage": "Go (TinyGo)",
      "runtimePlatform": "SpinApp"
    },
    {
      "@type": "SoftwareApplication",
      "name": "web4-router-component",
      "identifier": "nvt1itnc",
      "description": "Distributed MoE inference router — Routes k=1 expert inference requests to browser GPU providers. Manages expert affinity mapping, provider scoring, and real-time dispatch with sub-second latency.",
      "applicationCategory": "Backend",
      "programmingLanguage": "Go (TinyGo)",
      "runtimePlatform": "SpinApp"
    },
    {
      "@type": "SoftwareApplication",
      "name": "web4-scheduler-component",
      "identifier": "wycuoljt",
      "description": "Provider allocation and job scheduler — Browser GPU provider lifecycle management, reputation scoring (0.4×price + 0.3×latency + 0.3×failrate), two-part CC pricing, and 2% probabilistic audit.",
      "applicationCategory": "Backend",
      "programmingLanguage": "Go (TinyGo)",
      "runtimePlatform": "SpinApp"
    },
    {
      "@type": "SoftwareApplication",
      "name": "control-plane-component",
      "identifier": "25primzm",
      "description": "MoE control plane — Host-side orchestrator for Qwen3-30B-A3B Expert FFN dispatch. Manages expert weight distribution via S3 blobstore.",
      "applicationCategory": "Backend",
      "programmingLanguage": "Go (TinyGo)",
      "runtimePlatform": "SpinApp"
    },
    {
      "@type": "SoftwareApplication",
      "name": "web4-ui",
      "description": "SvelteKit browser worker UI — Join the distributed Expert network, monitor market state, earn Compute Credits. Pages: Dashboard, Provider, Generate, Network, Console.",
      "applicationCategory": "Frontend",
      "programmingLanguage": "TypeScript",
      "runtimePlatform": "SpinApp"
    }
  ],
  "keywords": [
    "MoE",
    "Mixture of Experts",
    "distributed inference",
    "browser GPU",
    "WebLLM",
    "WebGPU",
    "int4 quantization",
    "compute marketplace",
    "WebSocket",
    "scale-to-zero",
    "SpinApp",
    "MCP"
  ],
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "STRATEGY.jsonld",
        "content": {
          "@context": "https://schema.org",
          "@type": "CreativeWork",
          "name": "Browser MoE Distributed Inference Strategy",
          "description": "Economic resource optimization through browser-based distributed MoE inference. Monetize idle browser GPU/compute as Expert workers in a centrally coordinated network.",
          "mainEntity": {
            "@type": "PlanAction",
            "goal": [
              "Central coordinator routes k=1 MoE inference to browser Expert workers over WebSocket.",
              "Each browser holds one expert_id (all MoE layers, int4, ~33MB) - page-open participation.",
              "Compute spot market with two-part pricing: availability fee + execution fee in Compute Credits.",
              "Worker scoring: 0.4*price + 0.3*latency + 0.3*failrate, reputation-weighted.",
              "2% probabilistic audit for result integrity, exponential reputation decay.",
              "Scale from coordinator-relay (WebSocket) to optional WebRTC direct when stable."
            ],
            "instrument": [
              "Go Coordinator (performer framework) - shared trunk + router + scheduler + market",
              "SvelteKit Worker UI - browser worker interface at web4.etzhayyim.ai",
              "WebSocket for coordinator-worker transport (upgrade to WebRTC optional)",
              "WebLLM / WebGPU for in-browser expert FFN execution",
              "ClickHouse ORM for job/worker persistence, natad gRPC message stream for events"
            ]
          }
        }
      },
      {
        "fileName": "capabilities.jsonld",
        "content": {
          "@context": {
            "@version": 1.1,
            "id": "@id",
            "type": "@type",
            "skos": "http://www.w3.org/2004/02/skos/core#",
            "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
            "dct": "http://purl.org/dc/terms/",
            "xsd": "http://www.w3.org/2001/XMLSchema#",
            "name": "skos:prefLabel",
            "description": "dct:description",
            "broader": {
              "@id": "skos:broader",
              "@type": "@id"
            },
            "narrower": {
              "@id": "skos:narrower",
              "@type": "@id",
              "@container": "@set"
            },
            "performedBy": {
              "@id": "rdfs:seeAlso",
              "@type": "@id"
            },
            "createdAt": {
              "@id": "dct:created",
              "@type": "xsd:dateTime"
            },
            "updatedAt": {
              "@id": "dct:modified",
              "@type": "xsd:dateTime"
            }
          },
          "id": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities",
          "type": "skos:ConceptScheme",
          "name": "Browser MoE Distributed Inference Capabilities",
          "createdAt": "2026-02-13T00:00:00+09:00",
          "updatedAt": "2026-02-21T00:00:00+09:00",
          "concepts": [
            {
              "id": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#coordination",
              "type": "skos:Concept",
              "name": "MoE Coordination",
              "description": "Central coordinator managing shared trunk inference, k=1 expert routing, and worker dispatch",
              "narrower": [
                "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#expert-routing",
                "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#worker-scheduling",
                "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#shared-trunk",
                "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#inference-dispatch",
                "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#provider-allocation"
              ]
            },
            {
              "id": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#expert-routing",
              "type": "skos:Concept",
              "name": "Expert Routing (k=1)",
              "description": "Router selects single expert_id per token, minimizing communication overhead",
              "broader": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#coordination",
              "performedBy": "web4-router-nvt1itnc"
            },
            {
              "id": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#worker-scheduling",
              "type": "skos:Concept",
              "name": "Worker Scheduling",
              "description": "Score-based worker selection: price * 0.4 + latency * 0.3 + failrate * 0.3, reputation-weighted",
              "broader": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#coordination",
              "performedBy": "web4-scheduler-wycuoljt"
            },
            {
              "id": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#shared-trunk",
              "type": "skos:Concept",
              "name": "Shared Trunk Inference",
              "description": "Coordinator holds embedding, attention, layernorm (non-MoE layers) and runs them centrally",
              "broader": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#coordination",
              "performedBy": "control-plane-25primzm"
            },
            {
              "id": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#inference-dispatch",
              "type": "skos:Concept",
              "name": "Inference Request Dispatch",
              "description": "Routes incoming inference requests to the best available browser GPU provider based on expert affinity and provider scoring. Manages expert_id → provider mapping with sub-second latency.",
              "broader": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#coordination",
              "performedBy": "web4-router-nvt1itnc"
            },
            {
              "id": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#provider-allocation",
              "type": "skos:Concept",
              "name": "Provider Allocation",
              "description": "Manages browser GPU provider lifecycle: registration, expert_id assignment, capacity tracking, and graceful deregistration. Balances expert set coverage across the provider pool.",
              "broader": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#coordination",
              "performedBy": "web4-scheduler-wycuoljt"
            },
            {
              "id": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#browser-worker",
              "type": "skos:Concept",
              "name": "Browser Expert Worker",
              "description": "Browser-based worker holding int4-quantized expert FFN weights for all MoE layers (~33MB)",
              "narrower": [
                "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#webllm-execution",
                "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#expert-persistence"
              ]
            },
            {
              "id": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#webllm-execution",
              "type": "skos:Concept",
              "name": "WebLLM/WebGPU Expert Execution",
              "description": "Expert FFN computation via WebGPU in the browser. One browser = one expert_id across all MoE layers.",
              "broader": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#browser-worker"
            },
            {
              "id": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#expert-persistence",
              "type": "skos:Concept",
              "name": "Expert Weight Persistence",
              "description": "int4 quantized expert weights (~33MB) cached in browser for fast reconnection",
              "broader": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#browser-worker"
            },
            {
              "id": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#market",
              "type": "skos:Concept",
              "name": "Compute Market",
              "description": "Spot market for compute resources with two-part pricing (availability + execution)",
              "narrower": [
                "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#pricing",
                "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#reputation",
                "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#audit"
              ]
            },
            {
              "id": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#pricing",
              "type": "skos:Concept",
              "name": "Two-Part Pricing",
              "description": "Availability fee (online waiting) + execution fee (per-job CC). Workers set their own price.",
              "broader": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#market",
              "performedBy": "web4-scheduler-wycuoljt"
            },
            {
              "id": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#reputation",
              "type": "skos:Concept",
              "name": "Reputation System",
              "description": "Exponential smoothing reputation with decay. Success +0.01, failure -0.05, idle decay toward 0.5.",
              "broader": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#market",
              "performedBy": "web4-scheduler-wycuoljt"
            },
            {
              "id": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#audit",
              "type": "skos:Concept",
              "name": "Probabilistic Audit",
              "description": "2% random audit rate with duplicate execution for result verification",
              "broader": "https://github.com/etzhayyimcojp/etzhayyim-web3-llm/capabilities#market",
              "performedBy": "web4-scheduler-wycuoljt"
            }
          ]
        }
      },
