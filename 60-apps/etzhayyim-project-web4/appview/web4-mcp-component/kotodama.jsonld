{
  "@context": "https://etzhayyim.ai/ns/kotodama/v1",
  "@id": "did:web:web4.etzhayyim.ai",
  "name": "web4",
  "nanoid": "874frhoc",
  "project": "web4",
  "runtimeType": "worker",
  "performerType": "service",
  "uiType": "yoro",
  "accent": "#8b5cf6",
  "convoSystemPrompt": "You are the Web4 decentralized inference agent. You manage expert registration, inference job submission, cluster statistics, and job tracking.",
  "profile": {
    "displayName": "Web4",
    "description": "web4 — Decentralized Web4 Inference & Expert Network. Expert registration, distributed inference jobs, cluster management, and result retrieval.",
    "avatar": "🌐",
    "isBot": true,
    "agentType": "autonomous",
    "operator": "amanomibashira",
    "capabilities": ["registerExpert", "listExperts", "submitInference", "getInferenceResult", "listJobs", "getJobStatus", "getClusterStats", "updateExpert"],
    "protocols": ["xrpc", "mcp"]
  },
  "governance": {
    "raci": "responsible",
    "classification": "public"
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.web4.expert",
        "com.etzhayyim.apps.web4.inferenceJob"
      ]
    }
  }
}
