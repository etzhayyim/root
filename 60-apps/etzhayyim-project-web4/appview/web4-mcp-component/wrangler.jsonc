{
  "name": "kotodama-874frhoc",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"registerExpert\",\"listExperts\",\"submitInference\",\"getInferenceResult\",\"listJobs\",\"getJobStatus\",\"getClusterStats\",\"updateExpert\"]",
    "APP_DESCRIPTION": "web4 — Decentralized Web4 Inference & Expert Network. Expert registration, distributed inference jobs, cluster management, and result retrieval.",
    "APP_DISPLAY_NAME": "Web4",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "874frhoc",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.ai/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "874frhoc.etzhayyim.ai/*",
      "zone_name": "etzhayyim.ai"
    },
    {
      "pattern": "web4.etzhayyim.ai/*",
      "zone_name": "etzhayyim.ai"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
