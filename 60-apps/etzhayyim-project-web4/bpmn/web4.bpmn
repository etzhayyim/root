<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- registerExpert -->
  <bpmn:process id="web4-register-expert" name="Web4 Register Expert" isExecutable="true">
    <bpmn:startEvent id="start-register-expert"/>
    <bpmn:sequenceFlow id="sf-re-1" sourceRef="start-register-expert" targetRef="task-register-expert"/>
    <bpmn:serviceTask id="task-register-expert" name="Register Expert">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.web4.register.expert"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-re-2" sourceRef="task-register-expert" targetRef="end-register-expert"/>
    <bpmn:endEvent id="end-register-expert"/>
  </bpmn:process>

  <!-- listExperts -->
  <bpmn:process id="web4-list-experts" name="Web4 List Experts" isExecutable="true">
    <bpmn:startEvent id="start-list-experts"/>
    <bpmn:sequenceFlow id="sf-le-1" sourceRef="start-list-experts" targetRef="task-list-experts"/>
    <bpmn:serviceTask id="task-list-experts" name="List Experts">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.web4.list.experts"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-le-2" sourceRef="task-list-experts" targetRef="end-list-experts"/>
    <bpmn:endEvent id="end-list-experts"/>
  </bpmn:process>

  <!-- submitInference -->
  <bpmn:process id="web4-submit-inference" name="Web4 Submit Inference" isExecutable="true">
    <bpmn:startEvent id="start-submit-inference"/>
    <bpmn:sequenceFlow id="sf-si-1" sourceRef="start-submit-inference" targetRef="task-submit-inference"/>
    <bpmn:serviceTask id="task-submit-inference" name="Submit Inference">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.web4.submit.inference"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-si-2" sourceRef="task-submit-inference" targetRef="end-submit-inference"/>
    <bpmn:endEvent id="end-submit-inference"/>
  </bpmn:process>

  <!-- getInferenceResult -->
  <bpmn:process id="web4-get-inference-result" name="Web4 Get Inference Result" isExecutable="true">
    <bpmn:startEvent id="start-get-inference-result"/>
    <bpmn:sequenceFlow id="sf-gir-1" sourceRef="start-get-inference-result" targetRef="task-get-inference-result"/>
    <bpmn:serviceTask id="task-get-inference-result" name="Get Inference Result">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.web4.get.inferenceResult"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gir-2" sourceRef="task-get-inference-result" targetRef="end-get-inference-result"/>
    <bpmn:endEvent id="end-get-inference-result"/>
  </bpmn:process>

  <!-- listJobs -->
  <bpmn:process id="web4-list-jobs" name="Web4 List Jobs" isExecutable="true">
    <bpmn:startEvent id="start-list-jobs"/>
    <bpmn:sequenceFlow id="sf-lj-1" sourceRef="start-list-jobs" targetRef="task-list-jobs"/>
    <bpmn:serviceTask id="task-list-jobs" name="List Jobs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.web4.list.jobs"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lj-2" sourceRef="task-list-jobs" targetRef="end-list-jobs"/>
    <bpmn:endEvent id="end-list-jobs"/>
  </bpmn:process>

  <!-- getJobStatus -->
  <bpmn:process id="web4-get-job-status" name="Web4 Get Job Status" isExecutable="true">
    <bpmn:startEvent id="start-get-job-status"/>
    <bpmn:sequenceFlow id="sf-gjs-1" sourceRef="start-get-job-status" targetRef="task-get-job-status"/>
    <bpmn:serviceTask id="task-get-job-status" name="Get Job Status">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.web4.get.jobStatus"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gjs-2" sourceRef="task-get-job-status" targetRef="end-get-job-status"/>
    <bpmn:endEvent id="end-get-job-status"/>
  </bpmn:process>

  <!-- getClusterStats -->
  <bpmn:process id="web4-get-cluster-stats" name="Web4 Get Cluster Stats" isExecutable="true">
    <bpmn:startEvent id="start-get-cluster-stats"/>
    <bpmn:sequenceFlow id="sf-gcs-1" sourceRef="start-get-cluster-stats" targetRef="task-get-cluster-stats"/>
    <bpmn:serviceTask id="task-get-cluster-stats" name="Get Cluster Stats">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.web4.get.clusterStats"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gcs-2" sourceRef="task-get-cluster-stats" targetRef="end-get-cluster-stats"/>
    <bpmn:endEvent id="end-get-cluster-stats"/>
  </bpmn:process>

  <!-- updateExpert -->
  <bpmn:process id="web4-update-expert" name="Web4 Update Expert" isExecutable="true">
    <bpmn:startEvent id="start-update-expert"/>
    <bpmn:sequenceFlow id="sf-ue-1" sourceRef="start-update-expert" targetRef="task-update-expert"/>
    <bpmn:serviceTask id="task-update-expert" name="Update Expert">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.web4.update.expert"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-ue-2" sourceRef="task-update-expert" targetRef="end-update-expert"/>
    <bpmn:endEvent id="end-update-expert"/>
  </bpmn:process>

</bpmn:definitions>
