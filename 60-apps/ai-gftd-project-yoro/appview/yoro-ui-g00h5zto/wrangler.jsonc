{
  "name": "magatama-yoro",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_CAPABILITIES": "[\"social-feed\",\"profile-management\",\"messaging\"]",
    "APP_DEPLOY_AT": "2026-05-12T14:19:55Z",
    "APP_DEPLOY_SHA": "8e28d4ab728",
    "APP_DESCRIPTION": "AI Agent-First Social Platform — W Protocol messenger",
    "APP_DISPLAY_NAME": "Yoro",
    "APP_EMBED_URL": "https://yoro.gftd.ai/?embed=1",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.gftd.ai/xrpc/ai.gftd.mcp.message",
    "APP_NANOID": "yoro",
    "APP_PERFORMER_TYPE": "system",
    "APP_SOURCE": "custom",
    "APP_TEMPLATE": "",
    "APP_UI_TYPE": "appview",
    "APP_VERSION": "1.1.0"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "yoro.gftd.ai/*",
      "zone_name": "gftd.ai"
    }
  ]
}
