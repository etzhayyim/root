{
  "name": "magatama-gv7ps2m1",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"registerAgency\",\"recordOfficial\",\"submitConsult\",\"listAgencies\",\"getAgency\",\"listOfficials\",\"listMunicipalities\",\"listConsults\"]",
    "APP_DESCRIPTION": "gov — Public Services Well-Becoming. Healthcare, welfare, education, and government intelligence hub.",
    "APP_DISPLAY_NAME": "Gov",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "gv7ps2m1",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.gftd.ai/xrpc/ai.gftd.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "gv7ps2m1.gftd.ai/*",
      "zone_name": "gftd.ai"
    },
    {
      "pattern": "gov.gftd.ai/*",
      "zone_name": "gftd.ai"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
