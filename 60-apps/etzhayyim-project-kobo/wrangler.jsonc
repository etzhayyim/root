{
  "name": "kotodama-k0b0y501",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"agent-spawn\",\"agent-budding\",\"sporulation\",\"fermentation-dispatch\"]",
    "APP_DESCRIPTION": "kobo (酵母) — individual agent layer. Manages agent lifecycle: spawn, budding (asexual reproduction), sporulation (stress escape), and fermentation dispatch.",
    "APP_DISPLAY_NAME": "Kobo Agent Lifecycle",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "k0b0y501",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "k0b0y501.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "kobo.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
