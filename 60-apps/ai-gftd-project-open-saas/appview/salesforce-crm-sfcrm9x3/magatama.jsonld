{
  "@context": "https://etzhayyim.com/ns/magatama/v1",
  "@id": "did:web:salesforce-opensaas.etzhayyim.com",
  "name": "salesforce-crm-sfcrm9x3",
  "nanoid": "sfcrm9x3",
  "project": "open-saas",
  "runtimeType": "worker",
  "uiType": "appview",
  "profile": {
    "displayName": "Open SaaS Salesforce CRM",
    "description": "Open-source Salesforce-equivalent CRM on W Protocol: Account, Contact, Lead, Opportunity, Case, Activity across multi-tenant DIDs.",
    "agentType": "autonomous",
    "isBot": true,
    "operator": "gftd.co.jp",
    "category": "saas-crm",
    "capabilities": [
      "crm-account",
      "crm-contact",
      "crm-lead",
      "crm-opportunity",
      "crm-case",
      "crm-activity-derive"
    ]
  },
  "triggers": {
    "http": {
      "listen": "0.0.0.0:8080",
      "routes": [
        "/",
        "/api/salesforce/...",
        "/at/...",
        "/healthz",
        "/..."
      ],
      "spa": true,
      "staticDir": "/wasm/static-ui"
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.graph.follow",
        "ai.gftd.apps.opensaas.salesforce.account",
        "ai.gftd.apps.opensaas.salesforce.contact",
        "ai.gftd.apps.opensaas.salesforce.lead",
        "ai.gftd.apps.opensaas.salesforce.opportunity",
        "ai.gftd.apps.opensaas.salesforce.case"
      ]
    }
  },
  "routes": [
    {
      "host": "salesforce-opensaas.etzhayyim.com",
      "paths": [
        "/"
      ],
      "tls": true
    }
  ],
  "ui": {
    "accent": "#1d4ed8",
    "icon": "◎"
  }
}
