{
  "@context": {
    "etzhayyim": "https://resources.etzhayyim.com/etzhayyim-project-resources/id/",
    "schema": "https://schema.org/",
    "dodaf": "https://resources.etzhayyim.com/etzhayyim-project-resources/id/DM2/"
  },
  "@type": "etzhayyim:Project",
  "@id": "https://resources.etzhayyim.com/etzhayyim-project-wellness/id/Project/etzhayyim-project-wellness",
  "schema:name": "etzhayyim-project-wellness",
  "schema:description": "Wellness competency platform — 122-bit evaluation across 8 Dimensions of Wellness (Syracuse University). Physical, Emotional, Spiritual, Intellectual, Environmental, Financial, Occupational, Social. Cross-cut by 5 specializations: Somatic Intelligence, Feldenkrais, Alexander Technique, OT, Public Health.",
  "schema:url": "https://wellness.etzhayyim.com",
  "dodaf:capability": [
    {
      "@type": "dodaf:Capability",
      "schema:name": "122-Bit Competency Evaluation",
      "schema:description": "Atomic competency assessment across 122 bits distributed over 8 wellness dimensions, with independent understanding (理解度, 0-5) and practice (実践度, 0-5) tiers. Score = understanding × practice per bit."
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "8-Dimension Wellness Model",
      "schema:description": "Physical (Move, Nourish, Rest), Emotional (Feel, Understand, Cope), Spiritual (Reflect and Align), Intellectual (Stimulate and Grow), Environmental (Refresh Your Space), Financial (Plan and Empower), Occupational (Align and Purpose), Social (Connect and Belong)."
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Specialization Cross-Cut",
      "schema:description": "5 professional specializations cross-cutting dimensions: 身体知性, フェルデンクライス, アレクサンダーテクニーク, 作業療法, 公衆衛生."
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Practice Session Tracking",
      "schema:description": "Record and review wellness practice sessions with dimension, technique, duration, quality, and competency bit linkage."
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Learning Path Guidance",
      "schema:description": "Dimension-specific learning paths with prerequisite DAG-aware personalized next-step recommendations."
    }
  ],
  "dodaf:performer": [
    {
      "@type": "dodaf:Performer",
      "schema:name": "wellness-component",
      "schema:description": "SpinApp component at w3lln3sx.etzhayyim.com/api/grpc (port 21080) with parent-owned static site delivery for wellness.etzhayyim.com."
    }
  ]
}
