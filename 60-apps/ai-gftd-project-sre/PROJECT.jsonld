{
  "@context": {
    "@vocab": "https://schema.org/",
    "gftd": "https://gftd.ai/ns/"
  },
  "@type": "SoftwareApplication",
  "@id": "https://gftd.ai/projects/ai-gftd-project-sre",
  "name": "ai-gftd-project-sre",
  "description": "Site Reliability Engineering project - SRE toolbar extension and monitoring tools for the gftd.ai ecosystem.",
  "url": "https://sre.gftd.ai",
  "applicationCategory": "ai-gftd-project-sre",
  "gftd:projectCategory": "ai-gftd-project-sre",
  "gftd:status": "development",
  "gftd:components": [
    {
      "@type": "SoftwareApplication",
      "name": "sre-toolbar-backend",
      "description": "Go MCP backend for SRE toolbar tools (sre_toolbar.submit_feedback, sre_toolbar.get_system_status, sre_toolbar.update_theme).",
      "gftd:path": "app/",
      "gftd:technology": [
        "Go",
        "MCP",
        "legacy runtime"
      ],
      "gftd:port": 8080
    },
    {
      "@type": "SoftwareApplication",
      "name": "sre-toolbar-extension",
      "description": "Chrome Manifest V3 browser extension providing SRE toolbar overlay on gftd.ai domains.",
      "gftd:path": "extension/",
      "gftd:technology": [
        "Chrome Extension",
        "Svelte 5",
        "MCP",
        "Vite"
      ]
    },
    {
      "@type": "WebSite",
      "name": "sre-ui",
      "description": "Landing page at sre.gftd.ai for downloading the SRE toolbar extension.",
      "url": "https://sre.gftd.ai",
      "gftd:path": "ui/",
      "gftd:technology": [
        "SvelteKit",
        "SSG"
      ],
      "gftd:tier": "static",
      "gftd:hostname": "sre.gftd.ai"
    }
  ],
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "scheduler.jsonld",
        "content": {
          "@context": [
            "https://schema.org/",
            {
              "gftd": "https://gftd.ai/schemas/",
              "capabilities": "gftd:capabilities",
              "survivalIndicators": "gftd:survivalIndicators",
              "scheduler": "gftd:scheduler",
              "milestones": "gftd:milestones",
              "blockers": "gftd:blockers",
              "dependsOn": {
                "@id": "gftd:dependsOn",
                "@type": "@id"
              },
              "ingestKey": "gftd:ingestKey",
              "window": "gftd:window",
              "valueUpdatedAt": "gftd:valueUpdatedAt"
            }
          ],
          "@type": "CreativeWork",
          "name": "ai-gftd-project-sre Scheduler",
          "identifier": "ai-gftd-project-sre/scheduler",
          "description": "Project schedule (milestones) and blockers.",
          "dateCreated": "2026-02-15T04:25:26+00:00",
          "milestones": [],
          "blockers": []
        }
      }
    ]
  }
}
