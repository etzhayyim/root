{
  "@context": {
    "etzhayyim": "https://resources.etzhayyim.com/etzhayyim-project-resources/id/",
    "schema": "https://schema.org/",
    "dodaf": "https://resources.etzhayyim.com/etzhayyim-project-resources/id/DM2/"
  },
  "@type": "etzhayyim:Project",
  "@id": "https://resources.etzhayyim.com/etzhayyim-project-hikyaku/id/Project/etzhayyim-project-hikyaku",
  "schema:name": "etzhayyim-project-hikyaku",
  "schema:description": "Transport agent platform — AI agents create delivery orders, hc.etzhayyim.com gig workers (runners) execute physical delivery. Matrix protocol for all command/notification, Connect gRPC for queries.",
  "schema:url": "https://hikyaku.etzhayyim.com",
  "dodaf:capability": [
    {
      "@type": "dodaf:Capability",
      "schema:name": "Delivery Order Management",
      "schema:description": "AI agents and users create delivery orders with pickup/delivery addresses, time windows, package details. Orders are persisted in sql graph and broadcast via Matrix."
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "HC Runner Dispatch",
      "schema:description": "Automatic HC shift creation on hc.etzhayyim.com for runner recruitment. HC workers book shifts to become delivery runners. BookShift/CheckIn/CheckOut map to Hikyaku order lifecycle."
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Real-time Delivery Tracking",
      "schema:description": "Per-order Matrix thread with tracking events (pickup, in-transit, delivered). Runner location updates. Timeline UI with photo evidence and ETA."
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Delivery Zone Pricing",
      "schema:description": "Prefecture-based delivery zones with base price, per-km rate, weight/fragile/refrigerated surcharges. 75% runner payout via HC platform."
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Issue Resolution & Redelivery",
      "schema:description": "Problem reporting (absent, wrong address, damaged), rescheduling, Matrix-based communication between sender/runner/receiver."
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Daily Evolution (ISCO Team)",
      "schema:description": "5-agent ISCO team (BM/PO/MK/ENG/QA) conducts daily evolution sessions. KPI: delivery SLA, runner retention, coverage area, completion rate."
    }
  ],
  "dodaf:performer": [
    {
      "@type": "dodaf:Performer",
      "schema:name": "hikyaku-component",
      "schema:description": "Main SpinApp component (performer nanoid=hk7ky4ku). Handles order CRUD, HC integration, tracking, pricing, dispatch. Port managed by SpinKube."
    },
    {
      "@type": "dodaf:Performer",
      "schema:name": "hikyaku-static",
      "schema:description": "Static SvelteKit site at hikyaku.etzhayyim.com (spin-fileserver). Order creation, tracking timeline, runner dashboard, delivery zone management."
    }
  ],
  "dodaf:activity": [
    {
      "@type": "dodaf:Activity",
      "schema:name": "Create Order",
      "schema:description": "Sender creates delivery order → HC shift auto-generated → runner recruitment via hc.etzhayyim.com."
    },
    {
      "@type": "dodaf:Activity",
      "schema:name": "Runner Assignment",
      "schema:description": "HC worker books shift → runner_assigned → sender notified via Matrix."
    },
    {
      "@type": "dodaf:Activity",
      "schema:name": "Pickup & Delivery",
      "schema:description": "Runner confirms pickup (CheckIn) → in_transit → delivery confirmed (CheckOut) → photo evidence + signature."
    },
    {
      "@type": "dodaf:Activity",
      "schema:name": "Issue & Redelivery",
      "schema:description": "Runner reports issue → sender/receiver notified → reschedule → new HC shift if needed."
    }
  ]
}
