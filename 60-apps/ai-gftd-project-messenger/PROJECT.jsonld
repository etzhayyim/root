{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": "https://messenger.gftd.ai",
  "name": "ai-gftd-project-messenger",
  "description": "GFTD Messenger - real-time messaging platform for team communication with channels, direct messages, and thread replies",
  "url": "https://messenger.gftd.ai",
  "applicationCategory": "Communication",
  "operatingSystem": "Kubernetes",
  "author": {
    "@type": "Organization",
    "name": "gftdcojp",
    "url": "https://gftd.ai"
  },
  "component": [
    {
      "@type": "SoftwareApplication",
      "name": "messenger-mcp",
      "description": "SpinApp MCP component - messaging backend with channel/DM management, message persistence via sql graph ORM (performer/rdbms)",
      "applicationCategory": "Backend",
      "programmingLanguage": "TinyGo",
      "runtimePlatform": "SpinApp (WebAssembly Component Model)"
    },
    {
      "@type": "SoftwareApplication",
      "name": "messenger-ui",
      "description": "SvelteKit SSG frontend - real-time messaging UI with channel sidebar, message timeline, and thread view",
      "applicationCategory": "Frontend",
      "programmingLanguage": "TypeScript",
      "runtimePlatform": "CDN (Linode Object Storage via Envoy Gateway)"
    }
  ],
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "scheduler.jsonld",
        "content": {
          "@context": [
            "https://schema.org/",
            {
              "gftd": "https://gftd.ai/schemas/",
              "capabilities": "gftd:capabilities",
              "survivalIndicators": "gftd:survivalIndicators",
              "scheduler": "gftd:scheduler",
              "milestones": "gftd:milestones",
              "blockers": "gftd:blockers",
              "dependsOn": {
                "@id": "gftd:dependsOn",
                "@type": "@id"
              },
              "ingestKey": "gftd:ingestKey",
              "window": "gftd:window",
              "valueUpdatedAt": "gftd:valueUpdatedAt"
            }
          ],
          "@type": "CreativeWork",
          "name": "ai-gftd-project-messenger Scheduler",
          "identifier": "ai-gftd-project-messenger/scheduler",
          "description": "Project schedule (milestones) and blockers.",
          "dateCreated": "2026-02-17T00:00:00+00:00",
          "milestones": [],
          "blockers": []
        }
      }
    ]
  }
}
