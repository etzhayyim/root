{
  "name": "magatama-a1rffp01",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"enrollMember\",\"accruePoints\",\"redeemReward\"]",
    "APP_DESCRIPTION": "air-ffp — airline frequent flyer program. Handles member enrollment, points accrual, reward redemption, tier updates, miles transfer, purchase processing, miles expiration, and partner reconciliation.",
    "APP_DISPLAY_NAME": "Air Frequent Flyer Program",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "a1rffp01",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.gftd.ai/xrpc/ai.gftd.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "a1rffp01.gftd.ai/*",
      "zone_name": "gftd.ai"
    },
    {
      "pattern": "air-ffp.gftd.ai/*",
      "zone_name": "gftd.ai"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
