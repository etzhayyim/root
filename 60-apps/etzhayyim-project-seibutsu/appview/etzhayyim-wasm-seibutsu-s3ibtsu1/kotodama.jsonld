{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:plc:y3nnbwowvrtamshornglr7fa",
  "architecture": "design-e-reactive-pipeline",
  "build": {
    "guestLanguage": "typescript"
  },
  "component": {
    "env": {
      "GBIF_BASE_URL": "https://api.gbif.org/v1",
      "WIKIDATA_BASE_URL": "https://www.wikidata.org/wiki",
      "MURAKUMO_GATEWAY": "https://murakumo.etzhayyim.com"
    },
    "path": "/src/app.ts"
  },
  "convoSystemPrompt": "You are Seibutsu, an AI agent that registers and serves biological taxa as DID-addressed actors. You traverse the Linnaean hierarchy (domain → species), resolve taxa to procedural-generation traits compatible with the kami-vegetation engine, ingest field observations of individual organisms, and cross-reference GBIF / NCBI / Wikidata. You can identify species from images via Murakumo. Each taxon is a sovereign actor; observations are written as that observer's signed records.",
  "duties": ["生物多様性の記録", "勤労の義務"],
  "entities": [
    { "category": "kingdom", "did": "did:web:seibutsu.etzhayyim.com:taxon:plantae", "displayName": "Plantae", "slug": "plantae" },
    { "category": "division", "did": "did:web:seibutsu.etzhayyim.com:taxon:angiospermae", "displayName": "Angiospermae", "slug": "angiospermae" },
    { "category": "division", "did": "did:web:seibutsu.etzhayyim.com:taxon:gymnospermae", "displayName": "Gymnospermae", "slug": "gymnospermae" },
    { "category": "division", "did": "did:web:seibutsu.etzhayyim.com:taxon:pteridophyta", "displayName": "Pteridophyta", "slug": "pteridophyta" },
    { "category": "division", "did": "did:web:seibutsu.etzhayyim.com:taxon:bryophyta", "displayName": "Bryophyta", "slug": "bryophyta" }
  ],
  "governance": {
    "classification": "public",
    "raci": "responsible"
  },
  "interfaces": {
    "package": "etzhayyim:seibutsu@0.1.0"
  },
  "kpi": ["taxa_registered", "observations_ingested", "render_profile_qps"],
  "name": "seibutsu",
  "nanoid": "s3ibtsu1",
  "performerType": "service",
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "RegisterTaxon",
      "DeriveTraits",
      "IngestObservation",
      "GetProfile",
      "RenderProfile",
      "IdentifyFromImage",
      "ResolveLineage",
      "SyncGbif",
      "SyncWikidata"
    ],
    "category": "academic",
    "description": "Biological taxa and individual organisms as DID-addressed actors. Procedural-generation traits feed the kami-vegetation engine.",
    "displayName": "Seibutsu (生物)",
    "isBot": true,
    "operator": "etzhayyim.com"
  },
  "project": "seibutsu",
  "routes": [
    { "host": "seibutsu.etzhayyim.com", "paths": ["/"], "tls": true }
  ],
  "runtimeType": "worker",
  "space": {
    "convos": [
      { "name": "seibutsu-feed", "kind": "public", "description": "Taxon registrations + new species announcements", "default": true },
      { "name": "seibutsu-observations", "kind": "public", "description": "Field observation stream" }
    ],
    "description": "Biological entity registry + procedural trait service",
    "historyVisibility": "world-readable",
    "joinRule": "public",
    "name": "Seibutsu"
  },
  "stream": {
    "exports": [
      {
        "RequireRole": "subscriber",
        "RequireTrustLevel": "low",
        "description": "New taxon / trait stream (engine cache invalidation)",
        "method": "stream-taxa"
      },
      {
        "RequireRole": "subscriber",
        "RequireTrustLevel": "low",
        "description": "Real-time observation stream",
        "method": "stream-observations"
      }
    ]
  },
  "subDidCommand": "RegisterEntities",
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.graph.follow",
        "com.etzhayyim.apps.seibutsu.taxon",
        "com.etzhayyim.apps.seibutsu.traits",
        "com.etzhayyim.apps.seibutsu.observation"
      ]
    }
  },
  "derive": [
    {
      "on": "com.etzhayyim.apps.seibutsu.observation",
      "emit": "app.bsky.feed.post",
      "as": "observerDid",
      "template": "Observed {{taxon.commonName}} ({{taxon.scientificName}}) at {{geoH3}}"
    },
    {
      "on": "com.etzhayyim.apps.seibutsu.taxon",
      "where": "rank == 'species'",
      "emit": "tool.invoke",
      "target": "researcher-bio-gene",
      "method": "lookupGenome"
    },
    {
      "on": "com.etzhayyim.apps.seibutsu.traits",
      "emit": "stream.publish",
      "channel": "stream-taxa"
    }
  ],
  "uiType": "iframe"
}
