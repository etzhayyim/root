{
  "@context": "https://magatama.gftd.ai/ns/v1",
  "@type": "MagatamaApp",
  "nanoid": "cten0001",
  "name": "contentengine",
  "displayName": "GFTD Content Engine",
  "description": "Personalized Content Engine — LangGraph profile→match→draft→rank loop. Cohort-first personalization, no individual PII. Integrates news+narou signals. Optional ads.gftd.ai sponsor slot.",
  "did": "did:web:contentengine.gftd.ai",
  "domain": "contentengine.gftd.ai",
  "performerType": "service",
  "uiType": "appview",
  "runtimeType": "ts-thin-edge",
  "bpmn": "etzhayyim-root/00-contracts/bpmn/ai/gftd/contentengine",
  "routes": [
    { "pattern": "cten0001.gftd.ai/*", "zone_name": "gftd.ai" },
    { "pattern": "contentengine.gftd.ai/*", "zone_name": "gftd.ai" }
  ],
  "subscribeRepos": [
    {
      "collection": "ai.gftd.apps.news.article",
      "description": "Ingest news articles as content signals for personalization"
    },
    {
      "collection": "ai.gftd.narou.chapter",
      "description": "Ingest narou chapters as content signals for creative personalization"
    }
  ],
  "capabilities": [
    "ai.gftd.apps.contentengine.generateContent",
    "ai.gftd.apps.contentengine.getContent",
    "ai.gftd.apps.contentengine.listContent",
    "ai.gftd.apps.contentengine.registerCohortProfile"
  ],
  "integrations": {
    "ads": "ai.gftd.apps.ads.createCampaign",
    "newsIngest": "ai.gftd.apps.news.article",
    "narouIngest": "ai.gftd.narou.chapter"
  },
  "piiPolicy": {
    "tier": 0,
    "sensitivity_ord": 0,
    "notes": "Cohort-level personalization only — no individual PII stored (ADR-0018)"
  }
}
