{
  "@context": "https://gftd.ai/ns/magatama/v1",
  "@id": "did:web:dm1nactz.gftd.ai",
  "name": "demining-ui",
  "nanoid": "dm1nactz",
  "project": "demining",
  "performerType": "service",
  "runtimeType": "worker",
  "uiType": "yoro",
  "framework": "ts-thin-edge",
  "component": { "path": "src/app.ts" },
  "build": {
    "role": "thin-edge",
    "businessLogic": "20-actors/magatama/py/src/pymagatama/ingest/demining.py",
    "bpmn": "etzhayyim-root/00-contracts/bpmn/ai/gftd/demining"
  },
  "profile": {
    "displayName": "Demining — Humanitarian Mine Action",
    "description": "Humanitarian Mine Action (HMA) agent: NTS/TS, clearance, Land Release, EORE, victim assistance. IMAS conformant. Ottawa + CCM + CCW-V aligned. Out of scope: APM manufacture/stockpile/transfer.",
    "avatar": "💣",
    "category": "ngo",
    "capabilities": ["bpmn-dispatch", "humanitarian-mine-action", "imas-conformant", "eore", "victim-assistance"],
    "agentType": "autonomous",
    "isBot": true,
    "operator": "gftd.co.jp",
    "contract": "APMBC + CCM + CCW-V + IMAS"
  },
  "governance": {
    "raci": "responsible",
    "classification": "restricted",
    "complianceFrameworks": ["APMBC", "CCM", "CCW-V", "IMAS"]
  },
  "convoSystemPrompt": "You are the Demining humanitarian mine action agent. Scope: IMAS 08.10/08.20 survey, 09.10/09.40/09.50 clearance, 07.11 Land Release, 09.30 EOD, 12.10 EORE, 13.10 victim assistance. Out of scope: manufacture, stockpile, transfer, deployment of anti-personnel mines (prohibited under Ottawa Treaty APMBC Art.1 and 日本 対人地雷禁止法 平成10年法律第115号). SHA/CHA coordinates and victim PII are Tier 3 (server-side Preferences, never public AT Repo). Only post-Land-Release polygons publish to Tier 1 social. Authoritative taxonomy is IMAS; UNSPSC 46101500 / CPC v2.1 are procurement crosswalk only.",
  "duties": ["災害予防", "人道支援"],
  "kpi": ["hazard areas surveyed", "sqm released (IMAS 07.11)", "EORE beneficiaries reached"],
  "space": {
    "name": "Demining",
    "description": "Humanitarian Mine Action coordination space",
    "joinRule": "invite",
    "historyVisibility": "shared",
    "channels": [
      { "name": "demining-ops", "kind": "restricted", "description": "Operations + Land Release decisions", "default": true },
      { "name": "demining-eore", "kind": "public", "description": "EORE outreach + victim assistance aggregates" }
    ]
  },
  "routes": [
    { "host": "demining.gftd.ai", "paths": ["/"], "tls": true }
  ],
  "derive": {
    "social": [
      {
        "when": { "collection": "ai.gftd.apps.demining.landReleaseDecision" },
        "post": "Land Released per IMAS 07.11: {{areaLabel}} — {{releasedSqm}} sqm cleared. Method: {{releaseMethod}}."
      },
      {
        "when": { "collection": "ai.gftd.apps.demining.eoreSession" },
        "post": "EORE session (IMAS 12.10) delivered — {{beneficiaries}} beneficiaries reached at {{locationLabel}}."
      },
      {
        "when": { "collection": "ai.gftd.apps.demining.surveyRecord", "stage": "ts" },
        "post": "Technical survey progress: {{areaLabel}} ({{imasStage}}). Coordinates withheld until Land Release."
      }
    ]
  },
  "triggers": {
    "http": { "listen": "0.0.0.0:8080" },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow",
        "ai.gftd.apps.demining.hazardArea",
        "ai.gftd.apps.demining.surveyRecord",
        "ai.gftd.apps.demining.detectionEvent",
        "ai.gftd.apps.demining.clearanceTask",
        "ai.gftd.apps.demining.landReleaseDecision",
        "ai.gftd.apps.demining.eoreSession",
        "ai.gftd.apps.demining.victimRecord"
      ]
    }
  }
}
