{
  "@context": "https://schema.org/",
  "@type": "Dataset",
  "name": "Humanitarian Mine Action — Classification Crosswalk",
  "description": "Crosswalk of IMAS / UNSPSC / CPC v2.1 / ISIC Rev.4 / HS2022 / APMBC Art.7 categories relevant to detection and clearance. IMAS is authoritative for activity taxonomy; UNSPSC/CPC are used for procurement and statistics.",
  "note": "Exact numeric codes should be verified against UNSPSC v26, CPC v2.1 official publications, and ISIC Rev.4 before procurement binding. Codes below are the best-fit anchors.",
  "imas": [
    { "series": "04.10", "title": "Glossary of mine action terms, definitions and abbreviations", "activity": "terminology" },
    { "series": "05.10", "title": "Information Management for Mine Action", "activity": "IMSMA interop, information security" },
    { "series": "07.10", "title": "Management of Mine Action Operations", "activity": "programme management" },
    { "series": "07.11", "title": "Land Release", "activity": "NTS → TS → clearance → release decision" },
    { "series": "07.14", "title": "Risk management in mine action", "activity": "risk assessment" },
    { "series": "08.10", "title": "Non-Technical Survey", "activity": "desk + field evidence gathering, no ground intrusion" },
    { "series": "08.20", "title": "Technical Survey", "activity": "limited clearance to confirm/cancel hazard" },
    { "series": "09.10", "title": "Clearance Requirements", "activity": "full clearance to agreed depth" },
    { "series": "09.20", "title": "Inspection of cleared land", "activity": "QA / QC" },
    { "series": "09.30", "title": "Explosive Ordnance Disposal", "activity": "item destruction (humanitarian EOD)" },
    { "series": "09.40", "title": "Mine Detection Dogs (MDD)", "activity": "MDD operations" },
    { "series": "09.50", "title": "Mechanical clearance", "activity": "flails, tillers, armored excavators" },
    { "series": "10.10", "title": "Safety & Occupational Health", "activity": "PPE, medical" },
    { "series": "12.10", "title": "Explosive Ordnance Risk Education (EORE, formerly MRE)", "activity": "risk education" },
    { "series": "13.10", "title": "Victim Assistance", "activity": "survivor referral & rehabilitation" }
  ],
  "unspsc": {
    "note": "UNSPSC v26 anchors. Family 46101500 = Mine clearing equipment. Verify children in authoritative UNSPSC publication.",
    "entries": [
      { "code": "46101500", "title": "Mine clearing equipment", "tier": "family", "actor": "assets" },
      { "code": "46101501", "title": "Mine detectors / metal detectors for demining", "tier": "commodity", "actor": "assets", "note": "anchor for handheld / vehicle-mounted metal detectors and dual-sensor (GPR+metal) detectors" },
      { "code": "46101502", "title": "Mine destroyers / flails / tillers", "tier": "commodity", "actor": "assets" },
      { "code": "46101503", "title": "Mine probing tools", "tier": "commodity", "actor": "assets" },
      { "code": "46101600", "title": "Bomb disposal equipment", "tier": "family", "actor": "clearance" },
      { "code": "46181500", "title": "Personal safety & protection — PPE (blast vest, visor)", "tier": "family", "actor": "assets" },
      { "code": "85101600", "title": "Emergency medical services", "tier": "family", "actor": "victim-assistance" },
      { "code": "93141500", "title": "Humanitarian aid services", "tier": "family", "actor": "eore / victim-assistance" }
    ]
  },
  "cpc_v2_1": {
    "note": "CPC v2.1 has no dedicated Mine Action class. Best fits below. Explicitly n.e.c. — confirm jurisdictional use before procurement.",
    "entries": [
      { "code": "91290", "title": "Other public administrative services n.e.c.", "fit": "mine action as state-contracted public service" },
      { "code": "94900", "title": "Other community, social and personal services n.e.c.", "fit": "NGO-delivered EORE / victim assistance" },
      { "code": "85990", "title": "Other support services n.e.c.", "fit": "commercial clearance contracts" },
      { "code": "48265", "title": "Measuring, checking, testing, navigating and other-purpose instruments and appliances", "fit": "detectors — procurement code" },
      { "code": "44915", "title": "Parts of bombs, torpedoes, mines, missiles and similar munitions of war", "fit": "explicitly EXCLUDED from project scope (procurement of munitions is prohibited under APMBC Art.1)" }
    ]
  },
  "isic_rev4": {
    "entries": [
      { "code": "8412", "title": "Regulation of the activities of providing health care, education, cultural services and other social services, excluding social security", "fit": "state mine action authority" },
      { "code": "8422", "title": "Defence activities", "fit": "military EOD units performing humanitarian demining (host-nation)" },
      { "code": "8423", "title": "Public order and safety activities", "fit": "national mine action centre / police EOD" },
      { "code": "9499", "title": "Activities of other membership organizations n.e.c.", "fit": "demining NGOs (MAG, HALO, NPA, JMAS)" },
      { "code": "8690", "title": "Other human health activities", "fit": "victim assistance medical follow-up" },
      { "code": "8532", "title": "Technical and vocational secondary education", "fit": "EORE delivered in school" }
    ]
  },
  "hs2022": {
    "note": "Harmonized System for cross-border logistics of demining equipment.",
    "entries": [
      { "code": "9031.80", "title": "Other measuring instruments n.e.c.", "fit": "metal detectors, GPR" },
      { "code": "9022.19", "title": "X-ray apparatus — other uses", "fit": "portable X-ray for IED diagnostics" },
      { "code": "8430.69", "title": "Other earth-moving machinery, not self-propelled", "fit": "mine rollers, tillers" },
      { "code": "8705.90", "title": "Special purpose motor vehicles", "fit": "armored demining vehicle (flail carrier)" },
      { "code": "6506.10", "title": "Safety headgear", "fit": "blast visor / helmet" },
      { "code": "9020.00", "title": "Other breathing appliances and gas masks", "fit": "PPE respirators" }
    ]
  },
  "apmbcTreatyCategories": {
    "note": "APMBC Art.7 transparency reporting categories (reporting obligation under Ottawa Treaty).",
    "entries": [
      { "form": "A", "title": "National implementation measures" },
      { "form": "B", "title": "Stockpiled APM (destruction obligation)" },
      { "form": "C", "title": "Mined areas (location, type, extent)" },
      { "form": "D", "title": "APM retained for training (Art.3)" },
      { "form": "E", "title": "Conversion / decommissioning of APM production facilities" },
      { "form": "F", "title": "Status of programmes for destruction of APM" },
      { "form": "G", "title": "Status of stockpile destruction" },
      { "form": "H", "title": "Characteristics of each type of APM produced or owned" },
      { "form": "I", "title": "Measures taken to provide warning to civilians (EORE)" },
      { "form": "J", "title": "Victim assistance and mine action cooperation" }
    ]
  },
  "explosiveOrdnanceTaxonomy": {
    "note": "Item taxonomy used in `recordDetection` / `ExplosiveOrdnanceItem` graph node. Aligned with IMAS 04.10.",
    "entries": [
      { "code": "APM", "title": "Anti-Personnel Mine", "banned": true, "treaty": "APMBC" },
      { "code": "ATM", "title": "Anti-Tank / Anti-Vehicle Mine", "banned": false },
      { "code": "UXO", "title": "Unexploded Ordnance" },
      { "code": "AXO", "title": "Abandoned Explosive Ordnance" },
      { "code": "ERW", "title": "Explosive Remnants of War (UXO+AXO)", "treaty": "CCW Protocol V" },
      { "code": "CMR", "title": "Cluster Munition Remnants", "treaty": "CCM" },
      { "code": "IED", "title": "Improvised Explosive Device" },
      { "code": "BAC", "title": "Battle Area Clearance target (fragmentation / sub-calibre)" }
    ]
  }
}
