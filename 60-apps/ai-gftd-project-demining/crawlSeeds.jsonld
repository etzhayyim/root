{
  "@context": "https://etzhayyim.com/schemas/crawl-seed/v1",
  "@type": "CrawlSeedBundle",
  "name": "Demining — official gazette + treaty-body + HMA source seeds",
  "description": "Seed URLs for `site.etzhayyim.com:seedForProject` to fetch primary legal sources and HMA authoritative data. Marked entries in `legalInstruments.jsonld` with `verifyCitation: true` should be resolved by cross-referencing the crawl output against the draft citation.",
  "consumer": "site.etzhayyim.com",
  "projectDid": "did:web:demining.etzhayyim.com",
  "targetCollection": "com.etzhayyim.apps.demining.legalSource",
  "priority": "P0",
  "groups": [
    {
      "group": "treaty-bodies",
      "description": "Multilateral treaty depositaries and implementation support units",
      "seeds": [
        { "name": "UN Treaty Collection — APMBC", "url": "https://treaties.un.org/pages/ViewDetails.aspx?src=TREATY&mtdsg_no=XXVI-5&chapter=26", "doc": "APMBC text + parties + reservations" },
        { "name": "UN Treaty Collection — CCM", "url": "https://treaties.un.org/Pages/ViewDetails.aspx?src=TREATY&mtdsg_no=XXVI-6&chapter=26", "doc": "CCM text + parties" },
        { "name": "UNODA — APMBC", "url": "https://disarmament.unoda.org/anti-personnel-landmines-convention/", "doc": "APMBC ISU portal" },
        { "name": "UNODA — CCW", "url": "https://disarmament.unoda.org/the-convention-on-certain-conventional-weapons/", "doc": "CCW + Protocols" },
        { "name": "CCM ISU", "url": "https://www.clusterconvention.org/", "doc": "CCM implementation support unit" },
        { "name": "APMBC ISU", "url": "https://www.apminebanconvention.org/", "doc": "Ottawa ISU + Art.7 transparency reports" }
      ]
    },
    {
      "group": "hma-authoritative",
      "description": "IMAS / GICHD / UNMAS / monitor",
      "seeds": [
        { "name": "IMAS standards portal", "url": "https://www.mineactionstandards.org/", "doc": "IMAS series full text + amendments" },
        { "name": "GICHD", "url": "https://www.gichd.org/", "doc": "Geneva International Centre for Humanitarian Demining" },
        { "name": "UNMAS", "url": "https://www.unmas.org/", "doc": "UN Mine Action Service" },
        { "name": "Landmine Monitor", "url": "https://backend.icbl.org/resources/monitor/", "doc": "Annual global assessment (APMBC + CCM)" },
        { "name": "IMSMA Core", "url": "https://www.gichd.org/en/our-response/information-management/imsma-core/", "doc": "IMSMA schema + latest release" }
      ]
    },
    {
      "group": "national-gazettes-verified",
      "description": "Primary-source crawl targets to verify entries with verifyCitation:true in legalInstruments.jsonld",
      "seeds": [
        { "jurisdiction": "JP", "name": "e-Gov — 対人地雷禁止法", "url": "https://laws.e-gov.go.jp/law/410AC0000000115", "verifies": "JP APMBC" },
        { "jurisdiction": "JP", "name": "e-Gov — クラスター弾禁止法", "url": "https://laws.e-gov.go.jp/law/421AC0000000085", "verifies": "JP CCM" },
        { "jurisdiction": "GB", "name": "legislation.gov.uk — Landmines Act 1998", "url": "https://www.legislation.gov.uk/ukpga/1998/33/data.xml", "verifies": "GB APMBC" },
        { "jurisdiction": "GB", "name": "legislation.gov.uk — Cluster Munitions (Prohibitions) Act 2010", "url": "https://www.legislation.gov.uk/ukpga/2010/11/data.xml", "verifies": "GB CCM" },
        { "jurisdiction": "CA", "name": "Justice Laws — APMC Implementation Act", "url": "https://laws-lois.justice.gc.ca/eng/acts/A-11.5/FullText.html", "verifies": "CA APMBC" },
        { "jurisdiction": "CA", "name": "Justice Laws — Prohibiting Cluster Munitions Act", "url": "https://laws-lois.justice.gc.ca/eng/acts/P-25.4/FullText.html", "verifies": "CA CCM" },
        { "jurisdiction": "AU", "name": "Federal Register of Legislation — APM Convention Act 1998", "url": "https://www.legislation.gov.au/C2004A00425/latest/text", "verifies": "AU APMBC" },
        { "jurisdiction": "AU", "name": "Federal Register of Legislation — Criminal Code Amendment (CM Prohibition) 2012", "url": "https://www.legislation.gov.au/C2012A00114/latest/text", "verifies": "AU CCM" },
        { "jurisdiction": "NZ", "name": "NZ Legislation — APM Prohibition Act 1998", "url": "https://www.legislation.govt.nz/act/public/1998/0111/latest/whole.html", "verifies": "NZ APMBC" },
        { "jurisdiction": "NZ", "name": "NZ Legislation — Cluster Munitions Prohibition Act 2009", "url": "https://www.legislation.govt.nz/act/public/2009/0068/latest/whole.html", "verifies": "NZ CCM" },
        { "jurisdiction": "DE", "name": "Gesetze im Internet — AntiPersMinenÜbkAG", "url": "https://www.gesetze-im-internet.de/antipersmin_bkag/", "verifies": "DE APMBC" },
        { "jurisdiction": "DE", "name": "Gesetze im Internet — KrWaffKontrG", "url": "https://www.gesetze-im-internet.de/krwaffkontrg/", "verifies": "DE general" },
        { "jurisdiction": "FR", "name": "Légifrance — Loi 98-564", "url": "https://www.legifrance.gouv.fr/loda/id/LEGITEXT000005626127/", "verifies": "FR APMBC" },
        { "jurisdiction": "FR", "name": "Légifrance — Loi 2010-819", "url": "https://www.legifrance.gouv.fr/loda/id/JORFTEXT000022500365/", "verifies": "FR CCM" }
      ]
    },
    {
      "group": "national-gazettes-pending",
      "description": "Jurisdictions with verifyCitation:true in legalInstruments.jsonld awaiting primary-source URL resolution",
      "seeds": [
        { "jurisdiction": "IT", "name": "Gazzetta Ufficiale — Legge 374/1997", "url": "https://www.gazzettaufficiale.it/", "verifies": "IT APMBC", "status": "locate" },
        { "jurisdiction": "IT", "name": "Gazzetta Ufficiale — Legge 95/2011", "url": "https://www.gazzettaufficiale.it/", "verifies": "IT CCM", "status": "locate" },
        { "jurisdiction": "ES", "name": "BOE — Ley 33/1998", "url": "https://www.boe.es/buscar/act.php?id=BOE-A-1998-23179", "verifies": "ES APMBC", "status": "locate" },
        { "jurisdiction": "NL", "name": "overheid.nl — APM Verdrag uitvoeringswet 1999", "url": "https://wetten.overheid.nl/", "verifies": "NL APMBC", "status": "locate" },
        { "jurisdiction": "BE", "name": "Moniteur belge — Loi 1995-03-09", "url": "https://www.ejustice.just.fgov.be/", "verifies": "BE APMBC", "status": "locate" },
        { "jurisdiction": "CH", "name": "Fedlex — KMG SR 514.51", "url": "https://www.fedlex.admin.ch/eli/cc/1998/808_808_808/de", "verifies": "CH APMBC/CCM", "status": "locate" },
        { "jurisdiction": "NO", "name": "Lovdata — 2009 klasevåpen", "url": "https://lovdata.no/", "verifies": "NO CCM", "status": "locate" },
        { "jurisdiction": "SE", "name": "Riksdagen — Lag 1998:1700/1707", "url": "https://www.riksdagen.se/sv/dokument-och-lagar/", "verifies": "SE APMBC", "status": "locate" },
        { "jurisdiction": "ZA", "name": "South Africa Gov — APM Prohibition Act 36 of 2003", "url": "https://www.gov.za/documents/anti-personnel-mines-prohibition-act", "verifies": "ZA APMBC", "status": "locate" },
        { "jurisdiction": "BR", "name": "Planalto — Lei 10.300/2001", "url": "https://www.planalto.gov.br/ccivil_03/leis/leis_2001/l10300.htm", "verifies": "BR APMBC", "status": "locate" },
        { "jurisdiction": "CO", "name": "SUIN — Ley 554/2000 + 759/2002", "url": "https://www.suin-juriscol.gov.co/", "verifies": "CO APMBC", "status": "locate" },
        { "jurisdiction": "UA", "name": "Verkhovna Rada — Закон про протимінну діяльність", "url": "https://zakon.rada.gov.ua/laws/show/2642-19", "verifies": "UA APMBC", "status": "locate" }
      ]
    },
    {
      "group": "state-art7-reports",
      "description": "APMBC Art.7 + CCM Art.7 transparency report portals (annual national obligations)",
      "seeds": [
        { "name": "APMBC Art.7 reports", "url": "https://www.apminebanconvention.org/en/home/", "doc": "Article 7 reports index" },
        { "name": "CCM Art.7 reports", "url": "https://www.clusterconvention.org/transparency-reports/", "doc": "CCM transparency reports" }
      ]
    }
  ],
  "crawlContract": {
    "adapter": "site.etzhayyim.com:seedForProject",
    "wetExtraction": ["lawTitle", "lawNumber", "datePublished", "articles", "treatyRef"],
    "watExtraction": ["pdfLinks", "amendingActs", "officialGazetteRefs"],
    "outputCollection": "com.etzhayyim.apps.demining.legalSource",
    "tier": 1,
    "consentGate": "public-legal-gazette",
    "rateLimit": "respect robots.txt + 1 req/s per host"
  }
}
