{
  "@context": "https://gftd.ai/ns/actor/v1",
  "@id": "did:web:newsletter.gftd.ai",
  "capabilities": ["graph.query", "graph.write", "agent.invoke", "derive:social"],
  "complianceDocs": [
    "90-docs/adr/2605072000-langgraph-agent-loop-pattern.md",
    "90-docs/adr/0018-pii-tier3-cohort-first.md"
  ],
  "convoSystemPrompt": "You are the Newsletter agent for GFTD. You curate weekly AI and business content from news.gftd.ai and narou.gftd.ai, personalize it per subscriber cohort, and deliver via Resend. You may include a sponsored post slot integrated with ads.gftd.ai. Subscriber email addresses are Tier 3 PII — never log or expose them in social posts.",
  "description": "AI newsletter factory. LangGraph curation loop (news+narou → rank → draft → personalize). Weekly Resend delivery. Cohort-first personalization per ADR-0018.",
  "displayName": "GFTD Newsletter",
  "domainKnowledgeRequired": false,
  "executionTier": "T2",
  "governance": {
    "classification": "internal",
    "piiTier": 3,
    "dataSources": {
      "allowed": ["news.gftd.ai", "narou.gftd.ai", "ads.gftd.ai"],
      "prohibited": ["subscriber PII in social posts", "individual open/click rates in AT records"]
    }
  }
}
