{
  "@context": [
    "https://schema.org/",
    {
      "@version": 1.1,
      "@vocab": "https://resources.etzhayyim.com/ontology#",
      "@base": "https://resources.etzhayyim.com/ontology#",
      "id": "@id",
      "type": "@type",
      "schema": "https://schema.org/",
      "etzhayyim": "https://etzhayyim.com/schemas/",
      "dct": "http://purl.org/dc/terms/",
      "xsd": "http://www.w3.org/2001/XMLSchema#",
      "name": "dct:title",
      "description": "dct:description",
      "createdAt": {
        "@id": "dct:created",
        "@type": "xsd:dateTime"
      },
      "updatedAt": {
        "@id": "dct:modified",
        "@type": "xsd:dateTime"
      },
      "version": "dct:hasVersion"
    }
  ],
  "@type": "Dataset",
  "@id": "urn:etzhayyim:project:etzhayyim-project-resources",
  "name": "ETZHAYYIM Resources",
  "identifier": "etzhayyim-project-resources",
  "description": "Project / Org / Contract / Activity / Blocker などの状態を JSON-LD で保持する git-backed リソース基盤。resources.etzhayyim.com 経由で公開。",
  "url": "https://resources.etzhayyim.com/etzhayyim-project-resources/",
  "version": "1.3.0",
  "codeRepository": "https://github.com/etzhayyim/etzhayyim-apps-etzhayyim",
  "author": {
    "@type": "Organization",
    "name": "etzhayyim",
    "url": "https://etzhayyim.com"
  },
  "hasPart": [
    {
      "@type": "WebAPI",
      "name": "resources-etzhayyim-endpoint",
      "url": "https://resources.etzhayyim.com"
    }
  ],
  "etzhayyim:resourceBoundary": "project",
  "etzhayyim:capability": [
    "Resource and agreement state publishing",
    "Crawler-derived JSON-LD ingestion normalization",
    "SHACL validation and artifact storage"
  ],
  "etzhayyim:resourceModel": {
    "computeResources": [
      "storage",
      "cpu",
      "gpu",
      "memory"
    ],
    "extendedResources": [
      "time",
      "duration",
      "contracts",
      "relationships",
      "rights",
      "equipment",
      "socialCapital"
    ],
    "socialCapital": {
      "@type": "DefinedTerm",
      "name": "Social Capital (Branding Value)",
      "description": "個人の時間投下をブランディング価値として定量化する。branding_value_jpy = hourly_rate_jpy × duration_seconds / 3600",
      "unitText": "JPY",
      "schema": "content/capital/social-capital.jsonld",
      "shaclShape": "shacl/capital/social-capital-shapes.jsonld"
    }
  },
  "etzhayyim:dodafMapping": {
    "DIV-2": "etzhayyim data classes and jsonld artifacts",
    "StdV-1": "JSON-LD/SHACL/Accept negotiation"
  },
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "ARCHITECTURE.jsonld",
        "content": {
          "@context": "https://schema.org/",
          "@type": "TechArticle",
          "name": "Architecture: etzhayyim-project-resources",
          "description": "Repository-backed JSON-LD resources and SHACL shapes. Writers are schedulers/collectors; readers are UIs, agents, and downstream pipelines.",
          "keywords": [
            "jsonld",
            "rdf",
            "shacl",
            "gitstate",
            "crawler"
          ],
          "hasPart": [
            {
              "@type": "TechArticle",
              "name": "Crawler Data Flow",
              "description": "crawler.etzhayyim.com (SpinApp MCP component) produces CrawlJob and CrawlResult objects in memory. A resource-writer component calls the crawler MCP endpoint (o0dqx491.etzhayyim.com/api/mcp), normalizes responses to etzhayyim:CrawlJob, etzhayyim:CrawlPage, and schema:WebSite JSON-LD, validates against shacl/crawler/shapes.jsonld, and persists to content/crawl/ via gitstate. The deterministic key scheme is: crawl/job/<job_id>, crawl/page/<result_id>, crawl/site/<domain>.",
              "keywords": [
                "crawler.etzhayyim.com",
                "MCP",
                "gitstate",
                "CrawlJob",
                "CrawlPage",
                "WebSite"
              ]
            }
          ]
        }
      },
      {
        "fileName": "TECH_STACK.jsonld",
        "content": {
          "@context": {
            "@version": 1.1,
            "@vocab": "https://resources.etzhayyim.com/ontology#",
            "@base": "https://resources.etzhayyim.com/ontology#",
            "id": "@id",
            "type": "@type",
            "dct": "http://purl.org/dc/terms/",
            "xsd": "http://www.w3.org/2001/XMLSchema#",
            "name": "dct:title",
            "description": "dct:description",
            "createdAt": {
              "@id": "dct:created",
              "@type": "xsd:dateTime"
            },
            "updatedAt": {
              "@id": "dct:modified",
              "@type": "xsd:dateTime"
            },
            "schema": "https://schema.org/"
          },
          "id": "https://resources.etzhayyim.com/etzhayyim-project-resources/TECH_STACK.jsonld",
          "type": "schema:TechArticle",
          "name": "Technology Stack: etzhayyim-project-resources",
          "description": "Operational and publishing stack for public JSON-LD resources, including ingestion tooling, validation, CI/CD, and static publication pipeline.",
          "createdAt": "2026-02-17T00:00:00Z",
          "updatedAt": "2026-02-17T00:00:00Z",
          "keywords": [
            "jsonld",
            "shacl",
            "pulumi",
            "kubernetes",
            "cdci",
            "github-actions",
            "tekton",
            "cdn",
            "gitstate"
          ],
          "mainEntity": {
            "@type": "schema:ItemList",
            "schema:name": "Technology Stack Components",
            "name": "Technology Stack Components",
            "itemListElement": [
              {
                "@type": "schema:ListItem",
                "position": 1,
                "name": "Language",
                "item": {
                  "@type": "schema:DefinedTerm",
                  "schema:name": "Go",
                  "name": "Go",
                  "url": "https://go.dev",
                  "schema:description": "Primary language for resource normalization tooling and crawler ingest component."
                }
              },
              {
                "@type": "schema:ListItem",
                "position": 2,
                "name": "Language",
                "item": {
                  "@type": "schema:DefinedTerm",
                  "schema:name": "TypeScript",
                  "name": "TypeScript",
                  "url": "https://www.typescriptlang.org",
                  "schema:description": "Used for SSG/CDN site script and static build tooling within the CDN app."
                }
              },
              {
                "@type": "schema:ListItem",
                "position": 3,
                "name": "Package Manager",
                "item": {
                  "@type": "schema:DefinedTerm",
                  "schema:name": "Go modules",
                  "name": "Go modules",
                  "url": "https://go.dev/ref/mod",
                  "schema:description": "Dependency management for crawler-ingest Go tooling via tools/crawl-ingest/go.mod."
                }
              },
              {
                "@type": "schema:ListItem",
                "position": 4,
                "name": "Package Manager",
                "item": {
                  "@type": "schema:DefinedTerm",
                  "schema:name": "pnpm",
                  "name": "pnpm",
                  "url": "https://pnpm.io",
                  "schema:description": "Used for CDN build/app packaging, including JSON-LD static site generation task for resources.etzhayyim.com."
                }
              },
              {
                "@type": "schema:ListItem",
                "position": 5,
                "name": "Infrastructure / Stack Management",
                "item": {
                  "@type": "schema:DefinedTerm",
                  "schema:name": "Pulumi",
                  "name": "Pulumi",
                  "url": "https://www.pulumi.com",
                  "schema:description": "CDN route definitions are generated from `infra/pulumi/config/cdnroutes.go` and deployed through Pulumi-backed infrastructure stack."
                }
              },
              {
                "@type": "schema:ListItem",
                "position": 6,
                "name": "Kubernetes",
                "item": {
                  "@type": "schema:DefinedTerm",
                  "schema:name": "Kubernetes",
                  "name": "Kubernetes",
                  "url": "https://kubernetes.io",
                  "schema:description": "HTTPRoute resources for host routing and object-storage-backed CDN entrypoints are created in the cluster."
                }
              },
              {
                "@type": "schema:ListItem",
                "position": 7,
                "name": "CDCI",
                "item": {
                  "@type": "schema:DefinedTerm",
                  "schema:name": "CDCI",
                  "name": "CDCI",
                  "url": "https://github.com/features/actions",
                  "schema:description": "GitHub Actions + Tekton pipeline (`cdn-publish-changed`) publishes changed CDN apps and syncs build artifacts to Linode Object Storage."
                }
              },
              {
                "@type": "schema:ListItem",
                "position": 8,
                "name": "Data Storage and Publish Target",
                "item": {
                  "@type": "schema:DefinedTerm",
                  "schema:name": "Linode Object Storage",
                  "name": "Linode Object Storage",
                  "schema:description": "Static JSON-LD outputs are synced to CDN buckets by `projects/*/cdn` build pipeline and served via wildcard route rules."
                }
              },
              {
                "@type": "schema:ListItem",
                "position": 9,
                "name": "Database",
                "item": {
                  "@type": "schema:DefinedTerm",
                  "schema:name": "Git-backed content store",
                  "name": "Git repository",
                  "schema:description": "No dedicated runtime database in this project. JSON-LD records are persisted in repo content paths (e.g., content/crawl/*) and published as static files.",
                  "schema:url": "https://resources.etzhayyim.com/etzhayyim-project-resources/content/crawl/"
                }
              },
              {
                "@type": "schema:ListItem",
                "position": 10,
                "name": "Validation",
                "item": {
                  "@type": "schema:DefinedTerm",
                  "schema:name": "SHACL Validation",
                  "name": "SHACL validation",
                  "schema:description": "Crawler data models validated against shacl/crawler/shapes.jsonld before persistence."
                }
              }
            ]
          }
        }
      },
      {
        "fileName": "activities.jsonld",
        "content": {
          "@context": "https://schema.org/",
          "@type": "ItemList",
          "name": "Activities: etzhayyim-project-resources",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "item": {
                "@type": "HowTo",
                "name": "Publish JSON-LD resources",
                "description": "Accept JSON-LD graphs, validate against SHACL shapes, and store them under content/ with deterministic keys."
              }
            },
            {
              "@type": "ListItem",
              "position": 2,
              "item": {
                "@type": "HowTo",
                "name": "Ingest crawler data",
                "description": "Receive crawl results from crawler.etzhayyim.com (via MCP tool call or batch export), normalize to etzhayyim:CrawlJob / etzhayyim:CrawlPage / schema:WebSite JSON-LD, validate against shacl/crawler/shapes.jsonld, and write to content/crawl/{job,page,site}/<id>.jsonld using gitstate."
              }
            }
          ]
        }
      },
      {
        "fileName": "capabilities.jsonld",
        "content": {
          "@context": "https://schema.org/",
          "@type": "ItemList",
          "name": "Capabilities: etzhayyim-project-resources",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "item": {
                "@type": "DefinedTerm",
                "name": "Resource Persistence",
                "description": "Persist normalized JSON-LD resources deterministically in git."
              }
            },
            {
              "@type": "ListItem",
              "position": 2,
              "item": {
                "@type": "DefinedTerm",
                "name": "Schema Validation",
                "description": "Define SHACL shapes for data quality gates and interoperability."
              }
            },
            {
              "@type": "ListItem",
              "position": 3,
              "item": {
                "@type": "DefinedTerm",
                "name": "Crawler Data Persistence",
                "description": "Persist crawler.etzhayyim.com crawl results as JSON-LD under content/crawl/. Jobs, pages, and site summaries are stored with deterministic keys and validated against shacl/crawler/shapes.jsonld."
              }
            },
            {
              "@type": "ListItem",
              "position": 4,
              "item": {
                "@type": "DefinedTerm",
                "name": "Social Capital Calculation",
                "description": "個人の時間投下をブランディング価値として定量化するソーシャルキャピタル計算。branding_value_jpy = hourly_rate_jpy × duration_seconds / 3600。SHACL shape: shacl/capital/social-capital-shapes.jsonld。"
              }
            }
          ]
        }
      },
      {
        "fileName": "scheduler.jsonld",
        "content": {
          "@context": [
            "https://schema.org/",
            {
              "etzhayyim": "https://etzhayyim.com/schemas/",
              "capabilities": "etzhayyim:capabilities",
              "survivalIndicators": "etzhayyim:survivalIndicators",
              "scheduler": "etzhayyim:scheduler",
              "milestones": "etzhayyim:milestones",
              "blockers": "etzhayyim:blockers",
              "dependsOn": {
                "@id": "etzhayyim:dependsOn",
                "@type": "@id"
              },
              "ingestKey": "etzhayyim:ingestKey",
              "window": "etzhayyim:window",
              "valueUpdatedAt": "etzhayyim:valueUpdatedAt"
            }
          ],
          "@type": "CreativeWork",
          "name": "ETZHAYYIM Resources Scheduler",
          "identifier": "etzhayyim-project-resources/scheduler",
          "description": "Project schedule (milestones) and blockers.",
          "dateCreated": "2026-02-15T04:25:26+00:00",
          "milestones": [
            {
              "@type": "CreativeWork",
              "name": "Periodic collector ingest to resources",
              "description": "Run collector.export_jsonld from etzhayyim-project-collector and normalize into content/ti/{indicator,host,locale}.",
              "dueDate": "2026-02-22",
              "status": "Done"
            }
          ],
          "scheduler": {
            "@type": "etzhayyim:SchedulerConfig",
            "automations": [
              {
                "name": "resources-collector-export-ingest",
                "description": "Periodic ingest from network-intel collector MCP endpoint into resources content/ti.",
                "cron": "15 */6 * * *",
                "target": "github-actions:.github/workflows/resources-collector-ingest.yml",
                "method": "workflow_dispatch|schedule",
                "enabled": true
              }
            ]
          },
          "blockers": []
        }
      }
    ]
  }
}
