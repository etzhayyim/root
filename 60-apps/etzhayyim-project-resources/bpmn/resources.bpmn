<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- createResource -->
  <bpmn:process id="resources-create-resource" name="Resources Create Resource" isExecutable="true">
    <bpmn:startEvent id="start-create-resource"/>
    <bpmn:sequenceFlow id="sf-cr-1" sourceRef="start-create-resource" targetRef="task-create-resource"/>
    <bpmn:serviceTask id="task-create-resource" name="Create Resource">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.resources.createResource"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-cr-2" sourceRef="task-create-resource" targetRef="end-create-resource"/>
    <bpmn:endEvent id="end-create-resource"/>
  </bpmn:process>

  <!-- getResource -->
  <bpmn:process id="resources-get-resource" name="Resources Get Resource" isExecutable="true">
    <bpmn:startEvent id="start-get-resource"/>
    <bpmn:sequenceFlow id="sf-gr-1" sourceRef="start-get-resource" targetRef="task-get-resource"/>
    <bpmn:serviceTask id="task-get-resource" name="Get Resource">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.resources.getResource"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gr-2" sourceRef="task-get-resource" targetRef="end-get-resource"/>
    <bpmn:endEvent id="end-get-resource"/>
  </bpmn:process>

  <!-- updateResource -->
  <bpmn:process id="resources-update-resource" name="Resources Update Resource" isExecutable="true">
    <bpmn:startEvent id="start-update-resource"/>
    <bpmn:sequenceFlow id="sf-ur-1" sourceRef="start-update-resource" targetRef="task-update-resource"/>
    <bpmn:serviceTask id="task-update-resource" name="Update Resource">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.resources.updateResource"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-ur-2" sourceRef="task-update-resource" targetRef="end-update-resource"/>
    <bpmn:endEvent id="end-update-resource"/>
  </bpmn:process>

  <!-- deleteResource -->
  <bpmn:process id="resources-delete-resource" name="Resources Delete Resource" isExecutable="true">
    <bpmn:startEvent id="start-delete-resource"/>
    <bpmn:sequenceFlow id="sf-dr-1" sourceRef="start-delete-resource" targetRef="task-delete-resource"/>
    <bpmn:serviceTask id="task-delete-resource" name="Delete Resource">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.resources.deleteResource"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-dr-2" sourceRef="task-delete-resource" targetRef="end-delete-resource"/>
    <bpmn:endEvent id="end-delete-resource"/>
  </bpmn:process>

  <!-- listResources -->
  <bpmn:process id="resources-list-resources" name="Resources List Resources" isExecutable="true">
    <bpmn:startEvent id="start-list-resources"/>
    <bpmn:sequenceFlow id="sf-lr-1" sourceRef="start-list-resources" targetRef="task-list-resources"/>
    <bpmn:serviceTask id="task-list-resources" name="List Resources">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.resources.listResources"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lr-2" sourceRef="task-list-resources" targetRef="end-list-resources"/>
    <bpmn:endEvent id="end-list-resources"/>
  </bpmn:process>

  <!-- allocateResource -->
  <bpmn:process id="resources-allocate-resource" name="Resources Allocate Resource" isExecutable="true">
    <bpmn:startEvent id="start-allocate-resource"/>
    <bpmn:sequenceFlow id="sf-ar-1" sourceRef="start-allocate-resource" targetRef="task-allocate-resource"/>
    <bpmn:serviceTask id="task-allocate-resource" name="Allocate Resource">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.resources.allocateResource"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-ar-2" sourceRef="task-allocate-resource" targetRef="end-allocate-resource"/>
    <bpmn:endEvent id="end-allocate-resource"/>
  </bpmn:process>

  <!-- releaseResource -->
  <bpmn:process id="resources-release-resource" name="Resources Release Resource" isExecutable="true">
    <bpmn:startEvent id="start-release-resource"/>
    <bpmn:sequenceFlow id="sf-rr-1" sourceRef="start-release-resource" targetRef="task-release-resource"/>
    <bpmn:serviceTask id="task-release-resource" name="Release Resource">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.resources.releaseResource"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-rr-2" sourceRef="task-release-resource" targetRef="end-release-resource"/>
    <bpmn:endEvent id="end-release-resource"/>
  </bpmn:process>

  <!-- resourceUsage -->
  <bpmn:process id="resources-resource-usage" name="Resources Resource Usage" isExecutable="true">
    <bpmn:startEvent id="start-resource-usage"/>
    <bpmn:sequenceFlow id="sf-ru-1" sourceRef="start-resource-usage" targetRef="task-resource-usage"/>
    <bpmn:serviceTask id="task-resource-usage" name="Resource Usage">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.resources.resourceUsage"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-ru-2" sourceRef="task-resource-usage" targetRef="end-resource-usage"/>
    <bpmn:endEvent id="end-resource-usage"/>
  </bpmn:process>

</bpmn:definitions>
