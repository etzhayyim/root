{
  "@context": [
    "https://resources.etzhayyim.com/ontology/cybersecurity/context.jsonld",
    {
      "sh": "http://www.w3.org/ns/shacl#",
      "xsd": "http://www.w3.org/2001/XMLSchema#"
    }
  ],
  "@graph": [
    {
      "@id": "etzhayyim:CybersecProductKeywordShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "etzhayyim:CybersecProductKeyword",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "etzhayyim:keyword",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "etzhayyim:keywordJa",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "etzhayyim:productCategory",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:in": [
            "endpoint-security",
            "network-security",
            "cloud-security",
            "identity-access",
            "data-protection",
            "security-operations",
            "application-security",
            "governance-risk-compliance",
            "threat-intelligence",
            "security-testing"
          ]
        },
        {
          "sh:path": "etzhayyim:cpcCode",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:pattern": "^[0-9]{5}$"
        },
        {
          "sh:path": "etzhayyim:cpcJpy",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 1
        },
        {
          "sh:path": "etzhayyim:cpcUsd",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 1
        },
        {
          "sh:path": "etzhayyim:searchVolumeMonthly",
          "sh:datatype": "xsd:integer",
          "sh:minCount": 1
        },
        {
          "sh:path": "etzhayyim:competitionLevel",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:in": [
            "low",
            "medium",
            "high",
            "very-high"
          ]
        },
        {
          "sh:path": "etzhayyim:marketSegment",
          "sh:datatype": "xsd:string",
          "sh:in": [
            "enterprise",
            "mid-market",
            "smb",
            "consumer"
          ]
        },
        {
          "sh:path": "etzhayyim:deploymentModel",
          "sh:datatype": "xsd:string",
          "sh:in": [
            "saas",
            "on-premise",
            "hybrid",
            "agent-based",
            "agentless"
          ]
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    }
  ]
}
