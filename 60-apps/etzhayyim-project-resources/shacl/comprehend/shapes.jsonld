{
  "@context": {
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "sh": "http://www.w3.org/ns/shacl#",
    "prov": "http://www.w3.org/ns/prov#",
    "schema": "https://schema.org/",
    "etzhayyim": "https://resources.etzhayyim.com/ontology#"
  },
  "@graph": [
    {
      "@id": "etzhayyim:ComprehendObservationShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "etzhayyim:Observation",
      "sh:property": [
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "etzhayyim:DomainObservationShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "etzhayyim:DomainObservation",
      "sh:property": [
        {
          "sh:path": "etzhayyim:domain",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "etzhayyim:source",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "etzhayyim:IPObservationShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "etzhayyim:IPObservation",
      "sh:property": [
        {
          "sh:path": "etzhayyim:ip",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "etzhayyim:source",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "etzhayyim:CrawlRequestShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "etzhayyim:CrawlRequest",
      "sh:property": [
        {
          "sh:path": "schema:url",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "etzhayyim:maxDepth",
          "sh:datatype": "xsd:integer",
          "sh:minCount": 0
        }
      ]
    }
  ]
}
