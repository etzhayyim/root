{
  "@context": [
    "https://resources.etzhayyim.com/ontology/supply-chain/context.jsonld",
    {
      "sh": "http://www.w3.org/ns/shacl#",
      "xsd": "http://www.w3.org/2001/XMLSchema#"
    }
  ],
  "@graph": [
    {
      "@id": "etzhayyim:MaterialSourceShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "etzhayyim:MaterialSource",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "etzhayyim:materialCategory",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:in": [
            "iron",
            "petroleum",
            "fiber",
            "food"
          ]
        },
        {
          "sh:path": "etzhayyim:materialType",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "schema:latitude",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 1
        },
        {
          "sh:path": "schema:longitude",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 1
        },
        {
          "sh:path": "etzhayyim:countryCode",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:pattern": "^[A-Z]{2}$"
        },
        {
          "sh:path": "etzhayyim:estimatedReserves",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 0
        },
        {
          "sh:path": "etzhayyim:dailyOutput",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 0
        },
        {
          "sh:path": "etzhayyim:unitOfMeasure",
          "sh:datatype": "xsd:string"
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "etzhayyim:SupplyCompanyShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "etzhayyim:SupplyCompany",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "etzhayyim:countryCode",
          "sh:datatype": "xsd:string",
          "sh:pattern": "^[A-Z]{2}$"
        },
        {
          "sh:path": "etzhayyim:isicSection",
          "sh:datatype": "xsd:string"
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "etzhayyim:SupplyPersonShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "etzhayyim:SupplyPerson",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "etzhayyim:affiliatedCompanyIds",
          "sh:datatype": "xsd:string"
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "etzhayyim:SupplyFamilyShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "etzhayyim:SupplyFamily",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "etzhayyim:countryCode",
          "sh:datatype": "xsd:string"
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "etzhayyim:ManufacturingPlantShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "etzhayyim:ManufacturingPlant",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "etzhayyim:plantType",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:in": [
            "assembly",
            "processing",
            "fabrication"
          ]
        },
        {
          "sh:path": "etzhayyim:isicDivision",
          "sh:datatype": "xsd:string"
        },
        {
          "sh:path": "schema:latitude",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 1
        },
        {
          "sh:path": "schema:longitude",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 1
        },
        {
          "sh:path": "etzhayyim:inputMaterials",
          "sh:datatype": "xsd:string"
        },
        {
          "sh:path": "etzhayyim:outputProducts",
          "sh:datatype": "xsd:string"
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "etzhayyim:ProcessingPlantShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "etzhayyim:ProcessingPlant",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "etzhayyim:processType",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:in": [
            "smelting",
            "refining",
            "milling",
            "spinning"
          ]
        },
        {
          "sh:path": "schema:latitude",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 1
        },
        {
          "sh:path": "schema:longitude",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 1
        },
        {
          "sh:path": "etzhayyim:inputMaterials",
          "sh:datatype": "xsd:string"
        },
        {
          "sh:path": "etzhayyim:outputMaterials",
          "sh:datatype": "xsd:string"
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "etzhayyim:LogisticsHubShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "etzhayyim:LogisticsHub",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "etzhayyim:hubType",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:in": [
            "warehouse",
            "port",
            "terminal",
            "distribution-center",
            "airport"
          ]
        },
        {
          "sh:path": "schema:latitude",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 1
        },
        {
          "sh:path": "schema:longitude",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 1
        },
        {
          "sh:path": "etzhayyim:capacityTonnes",
          "sh:datatype": "xsd:decimal"
        },
        {
          "sh:path": "etzhayyim:unLocode",
          "sh:datatype": "xsd:string",
          "sh:pattern": "^[A-Z]{2}[A-Z0-9]{3}$"
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "etzhayyim:LogisticsVehicleShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "etzhayyim:LogisticsVehicle",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "etzhayyim:vehicleType",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:in": [
            "truck",
            "tanker",
            "flatbed",
            "van",
            "reefer"
          ]
        },
        {
          "sh:path": "etzhayyim:registrationNumber",
          "sh:datatype": "xsd:string"
        },
        {
          "sh:path": "etzhayyim:capacityTonnes",
          "sh:datatype": "xsd:decimal"
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "etzhayyim:LogisticsVesselShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "etzhayyim:LogisticsVessel",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "etzhayyim:vesselType",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:in": [
            "container",
            "bulk",
            "tanker",
            "roro",
            "general"
          ]
        },
        {
          "sh:path": "etzhayyim:imoNumber",
          "sh:datatype": "xsd:string",
          "sh:pattern": "^[0-9]{7}$"
        },
        {
          "sh:path": "etzhayyim:deadweightTonnes",
          "sh:datatype": "xsd:decimal"
        },
        {
          "sh:path": "etzhayyim:flagState",
          "sh:datatype": "xsd:string",
          "sh:pattern": "^[A-Z]{2}$"
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "etzhayyim:LogisticsRailwayShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "etzhayyim:LogisticsRailway",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "etzhayyim:serviceType",
          "sh:datatype": "xsd:string",
          "sh:in": [
            "freight",
            "intermodal",
            "unit-train"
          ]
        },
        {
          "sh:path": "etzhayyim:capacityTonnes",
          "sh:datatype": "xsd:decimal"
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "etzhayyim:LogisticsContainerShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "etzhayyim:LogisticsContainer",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "etzhayyim:containerNumber",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:pattern": "^[A-Z]{4}[0-9]{7}$"
        },
        {
          "sh:path": "etzhayyim:containerType",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:in": [
            "dry",
            "reefer",
            "tank",
            "open-top",
            "flat-rack"
          ]
        },
        {
          "sh:path": "etzhayyim:sizeTeu",
          "sh:datatype": "xsd:decimal",
          "sh:minCount": 1,
          "sh:in": [
            1,
            2
          ]
        },
        {
          "sh:path": "etzhayyim:maxPayloadKg",
          "sh:datatype": "xsd:decimal"
        },
        {
          "sh:path": "etzhayyim:transportMode",
          "sh:datatype": "xsd:string",
          "sh:in": [
            "sea",
            "rail",
            "road",
            "yard"
          ]
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    }
  ]
}
