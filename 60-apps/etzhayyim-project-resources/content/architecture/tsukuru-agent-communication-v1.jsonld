      "@type": "Thing",
      "identifier": "communication-message-event",
      "name": "Communication Message Event",
      "description": "Auditable inbound or outbound message event linked to an entity, contact point, invite, and performer envelope.",
      "supportedOperations": [
        "append",
        "list",
        "acknowledge"
      ],
      "dependsOnIds": [
