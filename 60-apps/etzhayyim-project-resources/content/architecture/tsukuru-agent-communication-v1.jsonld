      "name": "Agent Delegate Policy",
      "description": "Policy object that binds a verified organization to a performer actor mailbox and defines approval requirements for outreach and operations.",
      "verificationStage": "verified_owner",
      "approvalBoundary": "price commitment, contract acceptance, and purchase order confirmation require human approval",
      "supportedOperations": [
        "draft_only",
        "send_invites",
        "send_operational",
        "receive_mail"
