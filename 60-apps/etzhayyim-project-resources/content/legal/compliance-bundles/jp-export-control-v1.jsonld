  },
  "@type": "etzhayyim:ComplianceRuleBundle",
  "@id": "https://resources.etzhayyim.com/content/legal/compliance-bundles/jp-export-control-v1",
  "identifier": "jp-export-control-v1",
  "name": "Japan export-control baseline",
  "jurisdiction": "JP",
  "dateModified": "2026-03-11T10:16:11+00:00",
  "etzhayyim:compiledFrom": [
    {
      "name": "外国為替及び外国貿易法",
      "url": "https://laws.e-gov.go.jp/law/324AC0000000228"
    },
    {
      "name": "輸出入取引法",
      "url": "https://laws.e-gov.go.jp/law/327AC0000000299"
    }
  ],
  "rules": [
    {
      "ruleId": "jp-export-control-license-review",
      "title": "Cross-border export-control review",
      "summary": "Cross-border transfers of code, models, or controlled datasets with Japanese nexus require export-control review.",
      "rationale": "Derived from 外国為替及び外国貿易法, 輸出入取引法 metadata in resources/contracts corpus. Full article-level parsing is not implemented yet.",
      "jurisdiction": "JP",
      "sourceKind": "legal-resource",
      "sourceUri": "https://laws.e-gov.go.jp/law/324AC0000000228",
      "version": "2026-02-18T08:29:11.510864+00:00",
      "mandatory": true,
      "riskLevel": "high",
      "appliesTo": [
        "action:share",
        "action:transfer",
        "action:export",
        "action:publish",
        "resource:model",
        "resource:weights",
        "resource:dataset",
        "resource:source-code"
      ],
      "crossBorderOnly": true,
      "obligations": [
        {
          "kind": "license-check",
          "title": "Export-license check required",
          "description": "Verify that the transfer is permitted under JP export-control obligations before proceeding.",
          "mandatory": true
        },
        {
          "kind": "record-audit",
          "title": "Record compliance evidence",
          "description": "Attach audit evidence for JP export-control review before relying on the operation.",
          "mandatory": true
        },
        {
          "kind": "human-approval",
          "title": "Human approval required",
          "description": "A human reviewer must approve JP export-control review before execution.",
          "mandatory": true
        }
      ]
    }
  ]
}
