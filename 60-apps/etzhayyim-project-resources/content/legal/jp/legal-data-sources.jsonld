{
  "@context": {
    "@vocab": "https://schema.org/",
    "etzhayyim": "https://resources.etzhayyim.com/ontology#",
    "dct": "http://purl.org/dc/terms/"
  },
  "@type": "Dataset",
  "@id": "https://resources.etzhayyim.com/content/legal/jp/legal-data-sources",
  "identifier": "jp-legal-data-sources",
  "name": "日本法律情報データソース管理",
  "description": "日本の判例・裁判所・裁判官・弁護士等の公開法律情報を管理するデータソース定義。各情報の管理責任は etzhayyim-project-states の org-gov-jpn actor が持ち、情報収集・開示・MCP提供を行う。resources.etzhayyim.com はそれらの actor から受け取った情報を JSON-LD として保持・公開する。",
  "inLanguage": "ja",
  "dateModified": "2026-02-20T00:00:00Z",
  "etzhayyim:dataFlowArchitecture": {
    "description": "states (org-gov-jpn actors) → MCP export → resources (JSON-LD storage & publication)",
    "managementResponsibility": "etzhayyim-project-states/wasm/org-gov-jpn-*",
    "publicationTarget": "etzhayyim-project-resources/content/legal/jp/",
    "publicEndpoint": "https://resources.etzhayyim.com/etzhayyim-project-resources/id/"
  },
  "etzhayyim:dataSources": [
    {
      "@type": "etzhayyim:DataSource",
      "name": "裁判官 Actor (Judge Actor)",
      "description": "裁判所・裁判官・判例の管理責任を持つ actor。裁判所組織法・官報・courts.go.jp の公開情報に基づき情報を収集・開示する。",
      "etzhayyim:actorComponent": "gov-jpn-90000000-judge-component",
      "etzhayyim:actorNanoid": "f6yqzna7",
      "etzhayyim:mcpEndpoint": "https://f6yqzna7.etzhayyim.com/api/mcp",
      "etzhayyim:actorPath": "projects/etzhayyim-project-states/wasm/etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-org-gov-jpn-90000000-judge-f6yqzna7/",
      "etzhayyim:disclosureTools": [
        "list_courts",
        "get_court",
        "list_judges",
        "get_judge",
        "list_court_cases",
        "get_court_case",
        "export_legal_resources_jsonld"
      ],
      "etzhayyim:resourceTypes": [
        "Court",
        "Judge",
        "CourtCase"
      ],
      "etzhayyim:outputFiles": [
        "content/legal/jp/court/courts.jsonld",
        "content/legal/jp/judge/judges.jsonld",
        "content/legal/jp/case/landmark-cases.jsonld"
      ]
    },
    {
      "@type": "etzhayyim:DataSource",
      "name": "法律専門職 Actor (Legal Professionals Actor)",
      "description": "弁護士・弁護士会の登録情報管理責任を持つ actor。日本弁護士連合会(JFBA)の公開登録情報に基づき情報を収集・開示する。",
      "etzhayyim:actorComponent": "gov-jpn-03000000-legal-professionals-component",
      "etzhayyim:actorNanoid": "9031dd84",
      "etzhayyim:mcpEndpoint": "https://9031dd84.etzhayyim.com/api/mcp",
      "etzhayyim:actorPath": "projects/etzhayyim-project-states/wasm/etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-org-gov-jpn-03000000-legal-professionals/",
      "etzhayyim:disclosureTools": [
        "list_bar_associations",
        "get_bar_association",
        "search_lawyers",
        "get_lawyer",
        "export_legal_professionals_jsonld"
      ],
      "etzhayyim:resourceTypes": [
        "BarAssociation",
        "Lawyer"
      ],
      "etzhayyim:outputFiles": [
        "content/legal/jp/bar-association/bar-associations.jsonld"
      ]
    },
    {
      "@type": "etzhayyim:DataSource",
      "name": "法務省 Actor (MOJ Actor)",
      "description": "法務省管轄の法令情報管理責任を持つ actor。e-Gov法令APIを通じて日本の公開法令一覧を収集・開示する。",
      "etzhayyim:actorComponent": "gov-jpn-03000000-moj-component",
      "etzhayyim:actorPath": "projects/etzhayyim-project-states/wasm/etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-org-gov-jpn-03000000-moj/",
      "etzhayyim:resourceTypes": [
        "Legislation"
      ],
      "etzhayyim:outputFiles": [
        "content/legal/jp/laws.jsonld"
      ]
    }
  ],
  "etzhayyim:externalSources": [
    {
      "name": "裁判所ウェブサイト (courts.go.jp)",
      "url": "https://www.courts.go.jp/app/hanrei_jp/search1",
      "description": "最高裁判所が運営する判例検索システム。判例の事件番号・裁判年月日・裁判所名・裁判種別・判決要旨等を公開。"
    },
    {
      "name": "e-Gov法令検索",
      "url": "https://elaws.e-gov.go.jp/",
      "description": "総務省行政管理局が運営する法令検索・閲覧システム。現行法令のXMLデータをAPIで提供。"
    },
    {
      "name": "日本弁護士連合会 弁護士検索",
      "url": "https://www.nichibenren.or.jp/member_search/",
      "description": "JFBA が提供する弁護士公開検索システム。登録番号・氏名・所属弁護士会・事務所名等で検索可能。"
    },
    {
      "name": "官報 (Official Gazette)",
      "url": "https://kanpou.npb.go.jp/",
      "description": "裁判官の任命・退官等の公示情報源。国立印刷局が発行。"
    }
  ]
}
