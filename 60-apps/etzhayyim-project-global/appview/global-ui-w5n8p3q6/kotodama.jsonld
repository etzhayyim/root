{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:global.etzhayyim.com",
  "component": {
    "path": "component.wasm"
  },
  "convoSystemPrompt": "You are global agent. Global — AI Agent for global-affairs intelligence and analytics. Respond helpfully in the users language.",
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": [
      "global-policy"
    ]
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "global",
  "nanoid": "w5n8p3q6",
  "performerType": "service",
  "pool": {},
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "domain-query",
      "data-management"
    ],
    "description": "Global — AI Agent for global-affairs intelligence and analytics",
    "displayName": "Global",
    "isBot": true,
    "operator": "etzhayyim.com"
  },
  "project": "global",
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "kind": "public",
        "name": "w5n8p3q6-feed"
      }
    ],
    "joinRule": "public",
    "name": "Global"
  },
  "triggers": {
    "http": {
      "listen": "0.0.0.0:8080",
      "routes": [
        "/api/grpc/...",
        "/health",
        "/healthz",
        "/readyz",
        "/..."
      ],
      "spa": true,
      "staticDir": "/wasm/svelte/dist"
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.like",
        "app.bsky.feed.post",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow",
        "com.etzhayyim.apps.global.globalEntity",
        "com.etzhayyim.apps.global.globalEvent",
        "com.etzhayyim.apps.global.globalReport"
      ]
    }
  },
  "uiType": "appview",
  "yata": {
    "dataDir": "/data/yata"
  }
}
