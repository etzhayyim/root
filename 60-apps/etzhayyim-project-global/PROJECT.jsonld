{
  "@context": "https://schema.org/",
  "@type": "Project",
  "name": "Global Resource Flow Intelligence Platform",
  "identifier": "etzhayyim-project-global",
  "status": "In Progress",
  "description": "Global resource flow visualization platform using App actors, graph theory, and systems thinking. Aggregates worldwide resource statistics by year, infers time-series flows, and renders interactive 3D visualizations with Svelte Threlte (Three.js).",
  "url": "https://global.etzhayyim.com",
  "hasPart": [
    {
      "@type": "CreativeWork",
      "name": "Strategy",
      "url": "STRATEGY.jsonld"
    },
    {
      "@type": "WebApplication",
      "name": "Global Systems View",
      "url": "https://global.etzhayyim.com/systems"
    },
    {
      "@type": "WebApplication",
      "name": "Resource Flow Visualization",
      "url": "https://global.etzhayyim.com/resource-flow"
    },
    {
      "@type": "WebApplication",
      "name": "Resource Explorer",
      "url": "https://global.etzhayyim.com/resources"
    }
  ],
  "component": [
    {
      "@type": "SoftwareApplication",
      "name": "global-app",
      "description": "Go backend with App actors representing global resources. Fetches and aggregates statistics data, serves resource flow APIs via Connect-Web.",
      "applicationCategory": "Backend",
      "programmingLanguage": "Go",
      "runtimePlatform": "App runtime (Tier 2, Event-Driven)"
    },
    {
      "@type": "SoftwareApplication",
      "name": "global-ui",
      "description": "SvelteKit + Threlte (Three.js) UI for 3D resource flow visualization. Graph theory-based node-edge rendering with systems thinking causal loop diagrams.",
      "applicationCategory": "Frontend",
      "programmingLanguage": "TypeScript",
      "runtimePlatform": "nginx (Tier 3, Static)"
    }
  ],
  "keywords": [
    "resource-flow",
    "systems-thinking",
    "graph-theory",
    "three.js",
    "threlte",
    "legacy-runtime-actors",
    "time-series",
    "global-resources"
  ],
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "scheduler.jsonld",
        "content": {
          "@context": [
            "https://schema.org/",
            {
              "etzhayyim": "https://etzhayyim.com/schemas/",
              "capabilities": "etzhayyim:capabilities",
              "survivalIndicators": "etzhayyim:survivalIndicators",
              "scheduler": "etzhayyim:scheduler",
              "milestones": "etzhayyim:milestones",
              "blockers": "etzhayyim:blockers",
              "dependsOn": {
                "@id": "etzhayyim:dependsOn",
                "@type": "@id"
              },
              "ingestKey": "etzhayyim:ingestKey",
              "window": "etzhayyim:window",
              "valueUpdatedAt": "etzhayyim:valueUpdatedAt"
            }
          ],
          "@type": "CreativeWork",
          "name": "Global Resource Flow Intelligence Platform Scheduler",
          "identifier": "etzhayyim-project-global/scheduler",
          "description": "Project schedule (milestones) and blockers.",
          "dateCreated": "2026-02-15T04:25:26+00:00",
          "milestones": [
            {
              "@type": "CreativeWork",
              "name": "Document MCP tool contract",
              "description": "Write a stable tool list + args/results + curl examples for /api/mcp to unblock UI and external integrations.",
              "dueDate": "2026-02-16",
              "status": "Done"
            },
            {
              "@type": "CreativeWork",
              "name": "Show live/demo API status in UI",
              "description": "Make it visible when UI is using live MCP data vs embedded demo fallback.",
              "dueDate": "2026-02-16",
              "status": "Done"
            },
            {
              "@type": "CreativeWork",
              "name": "Production access verification",
              "description": "Verify DNS and HTTP reachability for global.etzhayyim.com endpoints and record status (site/routes reachable; /api/mcp expects POST).",
              "dueDate": "2026-02-15",
              "status": "Done"
            },
            {
              "@type": "CreativeWork",
              "name": "Production smoke against global domain",
              "description": "Verify resource-flow and /api/mcp behavior against https://global.etzhayyim.com.",
              "dueDate": "2026-02-17",
              "status": "Done"
            },
            {
              "@type": "CreativeWork",
              "name": "Deploy global-app and expose /api/mcp",
              "description": "Ensure the App service is reachable and /api/mcp responds on the public domain.",
              "dueDate": "2026-02-19",
              "status": "Done"
            },
            {
              "@type": "CreativeWork",
              "name": "Deploy global-ui routes (/resource-flow, /systems, /resources)",
              "description": "Publish the static UI and route the main entrypoint to /resource-flow (or equivalent).",
              "dueDate": "2026-02-19",
              "status": "Done"
            },
            {
              "@type": "CreativeWork",
              "name": "Resource collector SpinApp actor",
              "description": "SpinApp component that fetches global resource data from World Bank API, normalizes to JSON-LD, and publishes to etzhayyim/resources repo.",
              "dueDate": "2026-02-20",
              "status": "In Progress"
            },
            {
              "@type": "CreativeWork",
              "name": "Scheduler-driven periodic collection",
              "description": "Configure cron-based scheduler to trigger resource-collector-component every 6 hours via /scheduler/trigger endpoint.",
              "dueDate": "2026-02-22",
              "status": "Planned"
            },
            {
              "@type": "CreativeWork",
              "name": "Public repo sync (etzhayyim/resources)",
              "description": "Export collected JSON-LD to etzhayyim/resources content/ directory via collector.export_jsonld and git push.",
              "dueDate": "2026-02-24",
              "status": "Planned"
            }
          ],
          "scheduler": {
            "@type": "etzhayyim:SchedulerConfig",
            "automations": [
              {
                "name": "global-resource-collection",
                "description": "Periodic collection of global resource data from World Bank API",
                "cron": "0 */6 * * *",
                "targetUrl": "https://1.etzhayyim.com/scheduler/trigger",
                "method": "POST",
                "enabled": true
              },
              {
                "name": "global-resource-jsonld-export",
                "description": "Export collected resources as JSON-LD after each collection run",
                "cron": "30 */6 * * *",
                "targetUrl": "https://{nanoid}.etzhayyim.com/api/grpc",
                "method": "POST",
                "body": {
                  "jsonrpc": "2.0",
                  "id": "scheduled-export",
                  "method": "tools/call",
                  "params": {
                    "name": "collector.export_jsonld",
                    "arguments": {}
                  }
                },
                "enabled": true
              }
            ]
          },
          "blockers": [
            {
              "@type": "CreativeWork",
              "name": "Remote deploy via control plane can time out",
              "description": "etzhayyim deploy may fail with a control plane dial timeout in some environments; local deploy path may be required as a fallback.",
              "status": "Open"
            }
          ]
        }
      }
    ]
  }
}
