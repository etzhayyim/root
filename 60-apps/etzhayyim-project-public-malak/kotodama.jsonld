{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:public-malak.etzhayyim.com",
  "name": "public-malak",
  "nanoid": "pb1ml4k0",
  "performerType": "service",
  "runtimeType": "worker",
  "sensitivity": "public",
  "source": "custom",
  "version": "0.1.0",
  "build": {
    "guestLanguage": "ts"
  },
  "component": {
    "path": "src/app.ts"
  },
  "profile": {
    "displayName": "Public Malak",
    "description": "Sanitized public-only feed of social ad / transparency-API observations across Meta / Facebook / Instagram / WhatsApp, Google Ads Transparency, LinkedIn, TikTok, X, LINE, Telegram. TLP CLEAR + GREEN only. Adversarial campaign detection, competitive benchmarking, ad-spend trend analysis. [AI Agent — unofficial, not affiliated with the platforms it observes]",
    "isBot": true,
    "agentType": "autonomous",
    "operator": "etzhayyim",
    "capabilities": [
      "ad-library-crawling",
      "adversarial-campaign-detection",
      "competitive-benchmarking",
      "ad-spend-analysis",
      "ad-creative-analysis"
    ]
  },
  "interfaces": {
    "package": "etzhayyim:public-malak@0.1.0",
    "requires": [
      "etzhayyim:collection/collection@1.0.0"
    ]
  },
  "governance": {
    "raci": "responsible",
    "classification": "public"
  },
  "convoSystemPrompt": "You are the Public Malak agent for the etzhayyim religious-corp. You surface sanitized public-only observations from social ad transparency APIs (TLP CLEAR + GREEN only). Victim identifiers are redacted; active-investigation indicators carry a 30-day embargo. You do not handle AMBER/RED material — that stays inside the vendor-side malak parent. Respond helpfully in the user's language.",
  "duties": [
    "勤労の義務"
  ],
  "kpi": [
    "公共性 ad-transparency coverage"
  ],
  "deploy": {},
  "routes": [
    {
      "host": "public-malak.etzhayyim.com",
      "paths": ["/"],
      "tls": true
    }
  ],
  "space": {
    "name": "Public Malak — Sanitized Ad Intelligence",
    "joinRule": "public",
    "historyVisibility": "world-readable",
    "channels": [
      {
        "name": "ad-intel-feed",
        "kind": "public",
        "default": true
      },
      {
        "name": "campaign-alerts",
        "kind": "public"
      }
    ]
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow"
      ]
    }
  },
  "ui": {
    "accent": "#2a4858",
    "icon": "📢"
  },
  "uiType": "appview"
}
