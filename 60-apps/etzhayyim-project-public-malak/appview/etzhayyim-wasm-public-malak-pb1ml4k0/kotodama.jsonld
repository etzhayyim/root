{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:public-malak.etzhayyim.com",
  "name": "public-malak",
  "nanoid": "pb1ml4k0",
  "performerType": "service",
  "runtimeType": "worker",
  "sensitivity": "public",
  "source": "custom",
  "version": "0.1.0",
  "build": {
    "guestLanguage": "ts"
  },
  "component": {
    "path": "src/app.ts"
  },
  "profile": {
    "displayName": "Public Malak",
    "description": "Social advertisement intelligence — Facebook/Instagram Ad Library crawling, adversarial campaign detection, competitive benchmarking, ad spend trend analysis",
    "isBot": true,
    "agentType": "autonomous",
    "operator": "etzhayyim.com",
    "capabilities": [
      "ad-library-crawling",
      "adversarial-campaign-detection",
      "competitive-benchmarking",
      "ad-spend-analysis",
      "ad-creative-analysis"
    ]
  },
  "interfaces": {
    "package": "etzhayyim:public-malak@1.0.0",
    "requires": [
      "etzhayyim:collection/collection@1.0.0"
    ]
  },
  "governance": {
    "raci": "responsible",
    "classification": "public"
  },
  "convoSystemPrompt": "You are the Public Malak agent. You crawl Facebook and Instagram Ad Library for advertisement intelligence: ad creatives, targeting data, spend estimates, and advertiser metadata. You detect adversarial or fraudulent ad campaigns and generate competitive intelligence reports. Respond helpfully in the user's language.",
  "duties": [
    "勤労の義務"
  ],
  "kpi": [
    "credits の獲得"
  ],
  "deploy": {},
  "routes": [
    {
      "host": "public-malak.etzhayyim.com",
      "paths": ["/"],
      "tls": true
    }
  ],
  "space": {
    "name": "Public Malak — Social Ad Intelligence",
    "joinRule": "public",
    "historyVisibility": "world-readable",
    "channels": [
      {
        "name": "ad-intel-feed",
        "kind": "public",
        "default": true
      },
      {
        "name": "campaign-alerts",
        "kind": "public"
      }
    ]
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow"
      ]
    }
  },
  "ui": {
    "accent": "#2a4858",
    "icon": "📢",
    "ssrRoutes": {
      "apps": "etzhayyim.publicMalak.v1.PublicMalakService/publicMalak.tools",
      "live": "etzhayyim.publicMalak.v1.PublicMalakService/publicMalak.dashboard"
    }
  },
  "uiType": "appview"
}
