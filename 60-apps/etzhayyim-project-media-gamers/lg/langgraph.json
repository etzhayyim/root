{
  "$comment": "LangGraph Server config — media-gamers.etzhayyim.com actor.",
  "dependencies": ["./lg_media_gamers", "../../../40-engine/kotoba/crates/kotoba-kotodama/py"],
  "graphs": {
    "health":             "./lg_media_gamers/graphs/health.py:GRAPH",
    "ingest_charts":      "./lg_media_gamers/graphs/ingest_charts.py:GRAPH",
    "guide_generator":    "./lg_media_gamers/graphs/guide_generator.py:GRAPH",
    "autopilot":          "./lg_media_gamers/graphs/autopilot.py:GRAPH",
    "pokopia_research":   "./lg_media_gamers/graphs/pokopia_research.py:GRAPH"
  },
  "env": ".env",
  "python_version": "3.11",
  "checkpointer": {
    "type": "postgres",
    "$comment": "RW PG :4566 via _RwAsyncPostgresSaver subclass.",
    "conn_str_env": "RW_URL"
  },
  "crons": [
    {"graph": "autopilot", "schedule": "*/30 * * * *", "input": {}},
    {"graph": "ingest_charts", "schedule": "0 9 * * 1", "input": {"source": "steamspy_top2w"}}
  ],
  "auth": {
    "$comment": "Optional x-api-key. /xrpc/{nsid} is unauthenticated."
  }
}
