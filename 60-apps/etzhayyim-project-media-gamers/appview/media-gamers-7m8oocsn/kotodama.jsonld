{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:gamers.etzhayyim.com",
  "component": {
    "path": "/wasm/component.wasm"
  },
  "convoSystemPrompt": "You are media-gamers agent. Media Gamers — AI Agent for gaming intelligence and analytics. Respond helpfully in the users language.",
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": [
      "media-gamers-policy"
    ]
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "media-gamers",
  "nanoid": "a7m8oocs",
  "performerType": "service",
  "pool": {},
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "game-intelligence",
      "content-catalog"
    ],
    "description": "Media Gamers — AI Agent for gaming intelligence and analytics",
    "displayName": "Media Gamers",
    "isBot": true,
    "operator": "etzhayyim.co.jp",
    "tools": [
      {
        "name": "media-gamers.health",
        "description": "Health check for media-gamers LangGraph service",
        "nsid": "com.etzhayyim.apps.a7m8oocs.health"
      },
      {
        "name": "media-gamers.ingestCharts",
        "description": "Ingest and process game chart data for media-gamers analytics",
        "nsid": "com.etzhayyim.apps.a7m8oocs.ingestCharts"
      },
      {
        "name": "media-gamers.generateGuide",
        "description": "Generate a game guide article using LangGraph for media-gamers",
        "nsid": "com.etzhayyim.apps.a7m8oocs.generateGuide"
      },
      {
        "name": "media-gamers.autopilot",
        "description": "Run the media-gamers autopilot LangGraph agent for autonomous content generation",
        "nsid": "com.etzhayyim.apps.a7m8oocs.autopilot"
      }
    ]
  },
  "project": "gamers",
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "kind": "public",
        "name": "7m8oocsn-feed"
      }
    ],
    "joinRule": "public",
    "name": "Media Gamers"
  },
  "triggers": {
    "http": {
      "listen": "0.0.0.0:8080",
      "spa": true,
      "staticDir": "/wasm/static"
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow",
        "com.etzhayyim.apps.mediaUgamers.media_gamers_entity",
        "com.etzhayyim.apps.mediaUgamers.media_gamers_event",
        "com.etzhayyim.apps.mediaUgamers.media_gamers_report"
      ]
    }
  },
  "ui": {
    "accent": "#6c5ce7",
    "icon": "🎮"
  },
  "embedUrl": "https://a7m8oocs.etzhayyim.com/embed",
  "uiType": "appview",
  "yata": {
    "dataDir": "/data/yata",
    "graphUri": "/data/graph"
  }
}
