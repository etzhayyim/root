  "meta": {
    "id": "did:web:resource-flow.etzhayyim.com:dataset:rare-earth-supply-chain:2026-04-13",
    "title": "Rare Earth Supply Chain Actor and Resource Flow Graph",
    "asOf": "2026-04-13",
    "generatedBy": "Codex",
    "scope": "Publicly documented major rare earth mining, separation, magnet, policy, finance, and demand actors relevant to the China-US-Australia-EU-Japan supply chain.",
    "coveragePolicy": {
      "included": [
        "operating major mines and processors",
        "policy and regulatory actors with current influence on trade or investment",
        "major public diversification projects and offtake anchors",
        "major downstream demand clusters for magnets"
      ],
      "excluded": [
        "small explorers without current strategic flow relevance",
        "undisclosed brokers and traders without authoritative sourcing",
        "illicit and conflict-linked subflows without stable public attribution"
      ],
      "notes": [
        "Some edges are marked inferred when public sources establish dependency but not exact commercial contract structure.",
        "Myanmar heavy rare earth feed flows are represented as a sector-to-China processing dependency cluster rather than named individual mines because public attribution is incomplete."
      ]
    }
  },
