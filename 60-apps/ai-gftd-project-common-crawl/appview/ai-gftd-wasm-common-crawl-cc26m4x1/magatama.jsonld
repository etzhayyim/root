{
  "@context": "https://gftd.ai/ns/magatama/v1",
  "@id": "did:web:cc26m4x1.gftd.ai",
  "nanoid": "cc26m4x1",
  "name": "common-crawl",
  "displayName": "Common Crawl",
  "description": "Common Crawl pipeline — download, DID property graph, Murakumo intelligence extraction, knowledge graph injection",
  "version": "1.0.0",
  "runtimeType": "worker",
  "uiType": "yoro",
  "convoSystemPrompt": "You are the Common Crawl intelligence pipeline operator. This system processes CC-MAIN monthly web archives to extract domain intelligence and build the world knowledge graph. Answer questions about crawl status, pipeline progress, and domain coverage.",
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": [
      "gftd-platform-policy"
    ]
  },
  "profile": {
    "displayName": "Common Crawl Intelligence",
    "description": "Common Crawl CC-MAIN monthly archive → DID property graph + Murakumo intel extraction → world coverage knowledge graph",
    "avatar": "CC",
    "category": "data",
    "agentType": "autonomous",
    "operator": "gftd.co.jp",
    "capabilities": [
      "common-crawl-download",
      "did-property-graph",
      "murakumo-intel-extraction",
      "knowledge-graph-injection"
    ]
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "ai.gftd.apps.commonCrawler.downloadJob",
        "ai.gftd.apps.commonCrawler.graphJob",
        "ai.gftd.apps.commonCrawler.intelJob",
        "ai.gftd.apps.commonCrawler.injectJob",
        "ai.gftd.apps.commonCrawler.domainIntel"
      ]
    }
  },
  "space": {
    "name": "Common Crawl Pipeline",
    "description": "Common Crawl data pipeline status and intelligence results",
    "joinRule": "public",
    "historyVisibility": "world-readable",
    "convos": [
      {
        "name": "pipeline-status",
        "kind": "public",
        "description": "Pipeline job status updates",
        "default": true
      }
    ]
  }
}
