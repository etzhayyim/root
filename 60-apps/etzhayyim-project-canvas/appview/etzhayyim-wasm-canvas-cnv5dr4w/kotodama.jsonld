{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:canvas.etzhayyim.com",
  "component": {
    "env": {},
    "path": "component.wasm"
  },
  "convoSystemPrompt": "You are etzhayyim-wasm-canvas agent. Protocol Canvas rendering & collaboration — create, visualize, and share interactive canvas boards. Respond helpfully in the users language.",
  "deploy": {},
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": [
      "canvas-policy"
    ]
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "etzhayyim-wasm-canvas",
  "nanoid": "cnv5dr4w",
  "performerType": "service",
  "profile": {
    "agentType": "semi-autonomous",
    "capabilities": [
      "board-management",
      "canvas-search",
      "collaboration"
    ],
    "description": "Protocol Canvas rendering & collaboration — create, visualize, and share interactive canvas boards.",
    "displayName": "Canvas",
    "isBot": true
  },
  "project": "canvas",
  "routes": [
    {
      "host": "canvas.etzhayyim.com",
      "paths": [
        "/"
      ],
      "tls": true
    }
  ],
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "description": "Public canvas feed — shared boards and highlights",
        "kind": "public",
        "name": "canvas-feed"
      }
    ],
    "description": "Protocol Canvas rendering & collaboration",
    "historyVisibility": "world-readable",
    "joinRule": "public",
    "name": "Canvas"
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.graph.follow",
        "com.etzhayyim.apps.canvas.board",
        "com.etzhayyim.apps.canvas.element",
        "com.etzhayyim.apps.canvas.layer",
        "com.etzhayyim.apps.canvas.template"
      ]
    }
  },
  "uiType": "yoro"
}
