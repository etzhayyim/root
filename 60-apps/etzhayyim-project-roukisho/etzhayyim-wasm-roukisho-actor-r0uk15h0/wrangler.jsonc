{
  "name": "kotodama-r0uk15h0",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "APP_CAPABILITIES": "[\"directory-lookup\",\"jurisdiction-match\",\"communication-tracking\"]",
    "APP_DESCRIPTION": "厚生労働省 → 47都道府県労働局 → ~320 労働基準監督署の階層 registry + 通信記録 tracker。労働基準法申告・労災・労働条件相談の窓口を統合管理。民事紛争(業務委託等)は管轄外のため適切に escalate。",
    "APP_DISPLAY_NAME": "労働基準監督署 Registry (労基署)",
    "APP_EMBED_URL": "https://r0uk15h0.etzhayyim.com/?embed=1",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "r0uk15h0",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "appview",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "r0uk15h0.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "roukisho.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ]
}
