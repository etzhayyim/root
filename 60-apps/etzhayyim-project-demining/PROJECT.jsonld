{
  "@context": "https://schema.org/",
  "@type": "Project",
  "name": "Humanitarian Mine Action Platform (etzhayyim-project-demining)",
  "status": "Design",
  "identifier": "etzhayyim-project-demining",
  "description": "Humanitarian Mine Action (HMA) data + agent platform: Non-Technical Survey, Technical Survey, clearance, Explosive Ordnance Risk Education (EORE), and victim assistance. IMAS 04.10 / 07.10 / 09.10 / 12.10 conformant. Ottawa Treaty (APMBC) + CCM + CCW Protocol V aligned. Scope excludes manufacture, possession, or transfer of anti-personnel mines (prohibited under 日本 対人地雷禁止法 and APMBC Art.1).",
  "scope": {
    "inScope": [
      "Suspected Hazardous Area (SHA) / Confirmed Hazardous Area (CHA) registry",
      "Non-Technical Survey (NTS) + Technical Survey (TS)",
      "Clearance operations (manual, MDD, mechanical)",
      "Land Release per IMAS 07.11",
      "Detector / PPE / mechanical asset inventory",
      "Explosive Ordnance (EO) detection records + item classification (AP mine, AT mine, UXO, ERW, IED, cluster submunition)",
      "EORE (formerly MRE) sessions + beneficiaries",
      "Victim assistance referrals",
      "IMSMA (Information Management System for Mine Action) interop"
    ],
    "outOfScope": [
      "Manufacture, stockpile, transfer, or deployment of anti-personnel mines (prohibited)",
      "Offensive EOD / counter-mobility operations",
      "Real-time targeting"
    ]
  },
  "sensitivity": {
    "tier1Social": "Cleared / released areas, EORE outreach summaries, aggregated statistics",
    "tier2Domain": "Detector/asset inventory, task records, operator certifications",
    "tier3Preferences": "SHA/CHA coordinates until released, victim PII, operator PII, exact detector hit coordinates",
    "rationale": "AT Repo = always public federable. Publishing uncleared minefield coordinates endangers civilians (IMAS 05.10 information security). Only post-release polygons move to Tier 1."
  },
  "standards": [
    { "@type": "DefinedTerm", "name": "IMAS 04.10 Glossary", "inDefinedTermSet": "IMAS" },
    { "@type": "DefinedTerm", "name": "IMAS 05.10 Information Management", "inDefinedTermSet": "IMAS" },
    { "@type": "DefinedTerm", "name": "IMAS 07.10 Management of Mine Action Operations", "inDefinedTermSet": "IMAS" },
    { "@type": "DefinedTerm", "name": "IMAS 07.11 Land Release", "inDefinedTermSet": "IMAS" },
    { "@type": "DefinedTerm", "name": "IMAS 08.10 Non-Technical Survey", "inDefinedTermSet": "IMAS" },
    { "@type": "DefinedTerm", "name": "IMAS 08.20 Technical Survey", "inDefinedTermSet": "IMAS" },
    { "@type": "DefinedTerm", "name": "IMAS 09.10 Clearance Requirements", "inDefinedTermSet": "IMAS" },
    { "@type": "DefinedTerm", "name": "IMAS 10.10 Safety & Occupational Health", "inDefinedTermSet": "IMAS" },
    { "@type": "DefinedTerm", "name": "IMAS 12.10 Explosive Ordnance Risk Education", "inDefinedTermSet": "IMAS" },
    { "@type": "DefinedTerm", "name": "Anti-Personnel Mine Ban Convention (Ottawa Treaty, 1997)", "inDefinedTermSet": "Treaty" },
    { "@type": "DefinedTerm", "name": "Convention on Cluster Munitions (2008)", "inDefinedTermSet": "Treaty" },
    { "@type": "DefinedTerm", "name": "CCW Protocol V (Explosive Remnants of War)", "inDefinedTermSet": "Treaty" },
    { "@type": "DefinedTerm", "name": "対人地雷の製造の禁止及び所持の規制等に関する法律 (平成10年法律第115号)", "inDefinedTermSet": "JP-Law" }
  ],
  "hasPart": [
    { "@type": "CreativeWork", "name": "Classification crosswalk", "url": "classifications.jsonld" },
    { "@type": "CreativeWork", "name": "Actor manifest", "url": "../../20-actors/demining/actor-manifest.jsonld" },
    { "@type": "CreativeWork", "name": "Lexicon contracts", "url": "../../00-contracts/lexicons/com/etzhayyim/apps/demining/" }
  ],
  "performers": [
    { "@type": "Service", "name": "Demining Coordinator Actor", "identifier": "did:web:demining.etzhayyim.com" },
    { "@type": "Service", "name": "Survey Actor (NTS/TS)", "identifier": "did:web:demining.etzhayyim.com:actor:survey" },
    { "@type": "Service", "name": "Clearance Operations Actor", "identifier": "did:web:demining.etzhayyim.com:actor:clearance" },
    { "@type": "Service", "name": "EORE Actor", "identifier": "did:web:demining.etzhayyim.com:actor:eore" },
    { "@type": "Service", "name": "Victim Assistance Actor", "identifier": "did:web:demining.etzhayyim.com:actor:victim-assistance" },
    { "@type": "Service", "name": "Asset Inventory Actor (detectors, PPE, MDD, flails)", "identifier": "did:web:demining.etzhayyim.com:actor:assets" }
  ],
  "tasks": [
    { "status": "pending", "task": "Register nanoid via `etzhayyim actor register` for demining.etzhayyim.com" },
    { "status": "pending", "task": "Expand lexicon stubs (SHA schema, EO item taxonomy, IMSMA XML import)" },
    { "status": "pending", "task": "Graph schema: HazardArea / ExplosiveOrdnanceItem / ClearanceTask / LandReleaseDecision / EoreSession / Victim" },
    { "status": "pending", "task": "Implement T1 pipelines (survey → clearance → release → social summary)" },
    { "status": "pending", "task": "Tier 3 Preferences store for SHA coords + victim PII (no AT Repo)" }
  ]
}
