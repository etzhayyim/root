{
  "@context": "https://schema.org/",
  "@type": "Dataset",
  "name": "Humanitarian Mine Action — Global Legal Instruments",
  "description": "Multilateral treaties, regional instruments, customary IHL, and national implementation statutes relevant to landmine / cluster-munition / ERW / IED domain. Complements classifications.jsonld (technical/procurement) with the LEGAL layer. Repository corpus `60-apps/etzhayyim-project-resources/content/legal/` currently holds only the JP domestic acts — this file lists what should be loaded / cross-referenced as the project expands.",
  "status": "scaffold — jurisdictional citations should be verified against official gazettes before binding use",
  "multilateralTreaties": [
    {
      "@type": "Legislation",
      "name": "Convention on the Prohibition of the Use, Stockpiling, Production and Transfer of Anti-Personnel Mines and on Their Destruction (APMBC / Ottawa Treaty)",
      "signed": "1997-12-03",
      "entryIntoForce": "1999-03-01",
      "depositary": "UN Secretary-General",
      "scope": "Anti-personnel mines",
      "keyObligations": ["Art.1 use/produce/transfer/stockpile ban", "Art.4 stockpile destruction 4y", "Art.5 mined area clearance 10y + extensions", "Art.6 cooperation + VA", "Art.7 transparency reporting"],
      "stateParties": "164 (as of 2024)",
      "nonParties": ["US", "RU", "CN", "IN", "PK", "IR", "IL", "KP", "SY", "EG", "VN", "LA", "MM", "UZ", "SA"]
    },
    {
      "@type": "Legislation",
