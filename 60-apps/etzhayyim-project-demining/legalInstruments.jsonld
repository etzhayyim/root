        { "protocol": "II (as amended 1996)", "scope": "Mines, Booby-Traps, Other Devices — retained for non-APMBC states" },
        { "protocol": "III", "scope": "Incendiary weapons (peripheral)" },
        { "protocol": "V", "scope": "Explosive Remnants of War (ERW) — clearance + record-keeping + risk education", "entryIntoForce": "2006-11-12" }
      ]
    },
