      "signed": "2008-05-30",
      "entryIntoForce": "2010-08-01",
      "scope": "Cluster munitions and submunitions",
      "keyObligations": ["Art.1 use/produce/transfer/stockpile ban", "Art.3 stockpile destruction 8y", "Art.4 CMR clearance 10y", "Art.5 victim assistance"],
      "stateParties": "112 (as of 2024)",
      "nonParties": ["US", "RU", "CN", "IN", "PK", "IR", "IL", "KP", "BR", "EG", "KR", "TR"]
    },
