{
  "name": "magatama-outlook",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": ["nodejs_compat","nodejs_als"],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "APP_CAPABILITIES": "[\"bpmn-dispatch\",\"oauth-redirect\",\"mailbox-sync\"]",
    "APP_DESCRIPTION": "Thin edge facade; Outlook OAuth and Graph sync run in BPMN + Zeebe Python",
    "APP_DISPLAY_NAME": "Outlook",
    "APP_EMBED_URL": "https://outlook.gftd.ai/?embed=1",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.gftd.ai/xrpc/ai.gftd.mcp.message",
    "APP_NANOID": "outlook",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "appview"
  },
  "routes": [
    { "pattern": "outlook.gftd.ai/*", "zone_name": "gftd.ai" }
  ]
}
