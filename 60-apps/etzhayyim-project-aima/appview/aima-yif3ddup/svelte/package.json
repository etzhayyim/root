{
  "name": "etzhayyim-aima-ui",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "gen": "buf generate proto/aima-matching/v1 --template buf.gen.web.yaml && buf generate proto/aima-concierge/v1 --template buf.gen.web.yaml",
    "cap:sync": "cap sync",
    "cap:ios": "pnpm build && cap sync ios && cap open ios",
    "cap:android": "pnpm build && cap sync android && cap open android",
    "cap:build:ios": "pnpm build && cap sync ios",
    "cap:build:android": "pnpm build && cap sync android",
    "mobile:sync": "pnpm build && cap sync",
    "fastlane:ios:beta": "bundle exec fastlane ios beta",
    "fastlane:ios:release": "bundle exec fastlane ios release",
    "fastlane:android:beta": "bundle exec fastlane android beta",
    "fastlane:android:release": "bundle exec fastlane android release"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.11.0",
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.9",
    "svelte": "^5.55.3",
    "svelte-check": "^3.8.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vite-plugin-kit-routes": "^1.0.3"
  },
  "type": "module",
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/status-bar": "^8.0.2",
    "@connectrpc/connect": "^1.7.0",
    "@connectrpc/connect-web": "^1.7.0",
    "@etzhayyim/design-system": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-svelte": "^0.400.0",
    "tailwind-merge": "^2.6.1"
  }
}
