<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- listCasinos -->
  <bpmn:process id="casino-list-casinos" name="Casino List Casinos" isExecutable="true">
    <bpmn:startEvent id="start-list-casinos"/>
    <bpmn:sequenceFlow id="sf-lca-1" sourceRef="start-list-casinos" targetRef="task-list-casinos"/>
    <bpmn:serviceTask id="task-list-casinos" name="List Casinos">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.casino.listCasinos"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lca-2" sourceRef="task-list-casinos" targetRef="end-list-casinos"/>
    <bpmn:endEvent id="end-list-casinos"/>
  </bpmn:process>

  <!-- getCasino -->
  <bpmn:process id="casino-get-casino" name="Casino Get Casino" isExecutable="true">
    <bpmn:startEvent id="start-get-casino"/>
    <bpmn:sequenceFlow id="sf-gca-1" sourceRef="start-get-casino" targetRef="task-get-casino"/>
    <bpmn:serviceTask id="task-get-casino" name="Get Casino">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.casino.getCasino"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gca-2" sourceRef="task-get-casino" targetRef="end-get-casino"/>
    <bpmn:endEvent id="end-get-casino"/>
  </bpmn:process>

  <!-- createReview -->
  <bpmn:process id="casino-create-review" name="Casino Create Review" isExecutable="true">
    <bpmn:startEvent id="start-create-review"/>
    <bpmn:sequenceFlow id="sf-crev-1" sourceRef="start-create-review" targetRef="task-create-review"/>
    <bpmn:serviceTask id="task-create-review" name="Create Review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.casino.createReview"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-crev-2" sourceRef="task-create-review" targetRef="end-create-review"/>
    <bpmn:endEvent id="end-create-review"/>
  </bpmn:process>

  <!-- listReviews -->
  <bpmn:process id="casino-list-reviews" name="Casino List Reviews" isExecutable="true">
    <bpmn:startEvent id="start-list-reviews"/>
    <bpmn:sequenceFlow id="sf-lrev-1" sourceRef="start-list-reviews" targetRef="task-list-reviews"/>
    <bpmn:serviceTask id="task-list-reviews" name="List Reviews">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.casino.listReviews"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lrev-2" sourceRef="task-list-reviews" targetRef="end-list-reviews"/>
    <bpmn:endEvent id="end-list-reviews"/>
  </bpmn:process>

  <!-- listJurisdictions -->
  <bpmn:process id="casino-list-jurisdictions" name="Casino List Jurisdictions" isExecutable="true">
    <bpmn:startEvent id="start-list-jurisdictions"/>
    <bpmn:sequenceFlow id="sf-lj-1" sourceRef="start-list-jurisdictions" targetRef="task-list-jurisdictions"/>
    <bpmn:serviceTask id="task-list-jurisdictions" name="List Jurisdictions">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.casino.listJurisdictions"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lj-2" sourceRef="task-list-jurisdictions" targetRef="end-list-jurisdictions"/>
    <bpmn:endEvent id="end-list-jurisdictions"/>
  </bpmn:process>

  <!-- getJurisdiction -->
  <bpmn:process id="casino-get-jurisdiction" name="Casino Get Jurisdiction" isExecutable="true">
    <bpmn:startEvent id="start-get-jurisdiction"/>
    <bpmn:sequenceFlow id="sf-gj-1" sourceRef="start-get-jurisdiction" targetRef="task-get-jurisdiction"/>
    <bpmn:serviceTask id="task-get-jurisdiction" name="Get Jurisdiction">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.casino.getJurisdiction"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gj-2" sourceRef="task-get-jurisdiction" targetRef="end-get-jurisdiction"/>
    <bpmn:endEvent id="end-get-jurisdiction"/>
  </bpmn:process>

  <!-- searchCasinos -->
  <bpmn:process id="casino-search-casinos" name="Casino Search Casinos" isExecutable="true">
    <bpmn:startEvent id="start-search-casinos"/>
    <bpmn:sequenceFlow id="sf-sca-1" sourceRef="start-search-casinos" targetRef="task-search-casinos"/>
    <bpmn:serviceTask id="task-search-casinos" name="Search Casinos">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.casino.searchCasinos"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-sca-2" sourceRef="task-search-casinos" targetRef="end-search-casinos"/>
    <bpmn:endEvent id="end-search-casinos"/>
  </bpmn:process>

  <!-- listCities -->
  <bpmn:process id="casino-list-cities" name="Casino List Cities" isExecutable="true">
    <bpmn:startEvent id="start-list-cities"/>
    <bpmn:sequenceFlow id="sf-lcit-1" sourceRef="start-list-cities" targetRef="task-list-cities"/>
    <bpmn:serviceTask id="task-list-cities" name="List Cities">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.casino.listCities"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lcit-2" sourceRef="task-list-cities" targetRef="end-list-cities"/>
    <bpmn:endEvent id="end-list-cities"/>
  </bpmn:process>

</bpmn:definitions>
