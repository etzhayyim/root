{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:pharma.etzhayyim.com",
  "component": {
    "path": "component.wasm"
  },
  "convoSystemPrompt": "You are pharma agent. Pharma — AI Agent for pharmacy intelligence and analytics. Respond helpfully in the users language.",
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": [
      "pharma-policy"
    ]
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "pharma",
  "nanoid": "f0963b54",
  "performerType": "service",
  "pool": {},
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "domain-query",
      "data-management"
    ],
    "description": "Pharma — AI Agent for pharmacy intelligence and analytics",
    "displayName": "Pharma",
    "isBot": true,
    "operator": "etzhayyim.com"
  },
  "project": "pharma",
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "kind": "public",
        "name": "f0963b54-feed"
      }
    ],
    "joinRule": "public",
    "name": "Pharma"
  },
  "triggers": {
    "http": {
      "listen": "0.0.0.0:8080",
      "routes": [
        "/api/grpc/...",
        "/health",
        "/healthz",
        "/readyz",
        "/..."
      ],
      "spa": true,
      "staticDir": "/wasm/svelte/dist"
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.like",
        "app.bsky.feed.post",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow",
        "com.etzhayyim.apps.pharma.pharmaEntity",
        "com.etzhayyim.apps.pharma.pharmaEvent",
        "com.etzhayyim.apps.pharma.pharmaReport"
      ]
    }
  },
  "uiType": "appview"
}
