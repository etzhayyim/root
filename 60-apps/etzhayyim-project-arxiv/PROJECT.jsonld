{
  "@context": [
    "https://schema.org/",
    {
      "etzhayyim": "https://etzhayyim.com/schemas/",
      "capabilities": "etzhayyim:capabilities",
      "survivalIndicators": "etzhayyim:survivalIndicators",
      "scheduler": "etzhayyim:scheduler",
      "ingestKey": "etzhayyim:ingestKey",
      "window": "etzhayyim:window",
      "valueUpdatedAt": "etzhayyim:valueUpdatedAt"
    }
  ],
  "@type": "Project",
  "identifier": "etzhayyim-project-arxiv",
  "name": "arXiv Paper Submission Management",
  "status": "Active",
  "description": "arXiv 論文投稿の管理・パッケージング・検証を行うプロジェクト。Etzhayyim Research の研究成果を arXiv に公開するためのスクリプトと論文ソースを管理する。",
  "capabilities": {
    "@type": "DefinedTermSet",
    "name": "Capabilities",
    "description": "Summary of the capabilities this project is responsible for (CV-1).",
    "terms": [
      {
        "@type": "DefinedTerm",
        "identifier": "cap:arxiv:submission-packaging",
        "name": "arXiv Submission Packaging",
        "description": "LaTeX ソースから arXiv 投稿用 tarball を生成する"
      },
      {
        "@type": "DefinedTerm",
        "identifier": "cap:arxiv:tex-validation",
        "name": "LaTeX Compilation Validation",
        "description": "pdflatex コンパイルの成功・警告・エラーを検証する"
      },
      {
        "@type": "DefinedTerm",
        "identifier": "cap:arxiv:paper-management",
        "name": "Paper Source Management",
        "description": "研究論文のソースファイルをバージョン管理する"
      }
    ]
  },
  "survivalIndicators": [
    {
      "@type": "PropertyValue",
      "identifier": "si:arxiv:requests",
      "name": "requests",
      "description": "Number of script invocations",
      "unitText": "count",
      "value": null,
      "ingestKey": "arxiv.requests",
      "window": "1d",
      "valueUpdatedAt": null
    },
    {
      "@type": "PropertyValue",
      "identifier": "si:arxiv:gccCredit",
      "name": "gccCredit",
      "description": "GCC credit balance",
      "unitText": "GCC",
      "value": null,
      "ingestKey": "arxiv.gccCredit",
      "window": "1d",
      "valueUpdatedAt": null
    }
  ],
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "capabilities.jsonld",
        "content": {
          "@context": {
            "skos": "http://www.w3.org/2004/02/skos/core#",
            "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
            "dct": "http://purl.org/dc/terms/",
            "xsd": "http://www.w3.org/2001/XMLSchema#"
          },
          "id": "https://github.com/etzhayyim/root/tree/main/60-apps/etzhayyim-project-arxiv/capabilities",
          "type": "skos:ConceptScheme",
          "name": "arXiv Paper Submission Capabilities",
          "dct:created": "2026-02-19T00:00:00Z",
          "dct:modified": "2026-02-19T00:00:00Z",
          "concepts": [
            {
              "id": "cap:arxiv:root",
              "type": "skos:Concept",
              "name": "arXiv Paper Management",
              "description": "研究論文の arXiv 投稿を管理する能力",
              "narrower": [
                "cap:arxiv:submission-packaging",
                "cap:arxiv:tex-validation",
                "cap:arxiv:paper-management"
              ]
            },
            {
              "id": "cap:arxiv:submission-packaging",
              "type": "skos:Concept",
              "name": "Submission Packaging",
              "description": "LaTeX ソースから arXiv 投稿用 tarball (.tar.gz) を生成する",
              "broader": "cap:arxiv:root"
            },
            {
              "id": "cap:arxiv:tex-validation",
              "type": "skos:Concept",
              "name": "TeX Validation",
              "description": "pdflatex コンパイルの成功・警告・エラーを検証し品質を担保する",
              "broader": "cap:arxiv:root"
            },
            {
              "id": "cap:arxiv:paper-management",
              "type": "skos:Concept",
              "name": "Paper Source Management",
              "description": "研究論文のソースファイル (TeX, figures, bib) をバージョン管理する",
              "broader": "cap:arxiv:root"
            }
          ]
        }
      }
    ]
  }
}
