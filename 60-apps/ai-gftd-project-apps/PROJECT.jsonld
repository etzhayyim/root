{
  "@context": [
    "https://schema.org/",
    {
      "gftd": "https://gftd.ai/schemas/",
      "capabilities": "gftd:capabilities"
    }
  ],
  "@type": "Project",
  "identifier": "ai-gftd-project-apps",
  "name": "GFTD Apps Directory (apps.gftd.ai)",
  "status": "In Progress",
  "description": "Apple App Store style listing page for all gftd.ai apps. Showcases the full GFTD ecosystem with categories, search, and featured apps at apps.gftd.ai.",
  "capabilities": {
    "@type": "DefinedTermSet",
    "name": "Capabilities",
    "terms": [
      {
        "@type": "DefinedTerm",
        "name": "App Directory",
        "description": "Browsable directory of all GFTD apps with category filtering and search."
      },
      {
        "@type": "DefinedTerm",
        "name": "Category Navigation",
        "description": "Apple App Store style category taxonomy for organizing apps."
      }
    ]
  }
}
