{
  "name": "kotodama-v1n0g10b",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"bpmn-dispatch\",\"vin-decode\",\"plate-lookup\",\"production-flow\",\"shipment-analytics\",\"cohort-registration\"]",
    "APP_DESCRIPTION": "Global VIN / vehicle registration intelligence",
    "APP_DISPLAY_NAME": "VIN / Vehicle Registration Intelligence",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "v1n0g10b",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "routes": [
    {
      "pattern": "v1n0g10b.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "vin.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
