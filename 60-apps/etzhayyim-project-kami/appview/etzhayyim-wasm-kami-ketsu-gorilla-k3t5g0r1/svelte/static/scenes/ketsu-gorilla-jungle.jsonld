{
  "@context": "https://etzhayyim.co.jp/ns/kami/scene",
  "@type": "IslandScene",
  "@id": "urn:kami:island:ketsu-gorilla-jungle",
  "name": "Zettai Zetsumei!! Goriketsu Dash!!",
  "genre": "brainrot",
  "description": "Neteru gorilla no ketsu wo hippatake! Banana atsumete nigero! Mori wa modoru ka?",
  "max_players": 10,

  "characters": [
