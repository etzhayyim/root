  "sfx": {
    "sfx_slap_ketsu": {"description": "Loud meaty slap on gorilla butt, resonant bass thud + skin clap", "duration_ms": 400},
    "sfx_gorilla_roar": {"description": "Furious silverback roar, deep guttural with chest resonance, escalating", "duration_ms": 1800},
    "sfx_snore": {"description": "Deep rhythmic gorilla snore, rumbling inhale + whistling exhale", "duration_ms": 2000},
    "sfx_gorilla_grunt": {"description": "Low warning grunt, gorilla stirring in sleep", "duration_ms": 600},
    "sfx_chest_beat": {"description": "Rapid chest beating (4 hits), hollow resonant drumming (DODODODO)", "duration_ms": 1200},
    "sfx_ground_pound": {"description": "Massive fist slamming ground, earth-shaking bass impact + debris scatter", "duration_ms": 800},
    "sfx_banana_get": {"description": "Bright cheerful pickup chime, ascending arpeggio + peel sound", "duration_ms": 300},
    "sfx_combo": {"description": "Escalating combo fanfare, each hit higher pitch, crowd cheering", "duration_ms": 500},
    "sfx_whiff": {"description": "Comedic swing-and-miss whoosh, deflating sound", "duration_ms": 250},
    "sfx_caught": {"description": "Dramatic capture sting, gorilla grabbing + player yelp + comedy bonk", "duration_ms": 1000},
    "sfx_gorilla_victory": {"description": "Gorilla triumphant chest-beat celebration + satisfied grunt", "duration_ms": 1500},
    "sfx_victory": {"description": "Grand victory fanfare, brass + jungle drums + bird calls", "duration_ms": 3000},
    "sfx_baby_gorilla": {"description": "Cute baby gorilla coo + happy chirping sounds", "duration_ms": 800},
    "sfx_footstep_jungle": {"description": "Soft footsteps on jungle floor, leaf crunch + twig snap", "duration_ms": 200},
    "sfx_clap_rhythm": {"description": "4-beat hand clap rhythm matching chorus (Clap clap clap clap)", "duration_ms": 1000},
    "bgm_jungle_ambient": {"description": "Ambient jungle loop: distant birds, insect chirps, flowing water, wind in canopy", "duration_ms": -1},
    "bgm_chase": {"description": "Intense chase music: tribal drums accelerating, bass drops, gorilla percussion, tension strings. Rhythm matches 'goriririri gorigori ketsu dasshu' tempo", "duration_ms": -1},
    "bgm_ending": {"description": "Bittersweet ending: gentle marimba melody, soft jungle sounds returning, hopeful but questioning. 'banana wa modoru ka? mori wa modoru ka?'", "duration_ms": -1}
  },

  "ambient_color": [0.05, 0.08, 0.03],
  "sun_direction": [-0.5, -2.0, -1.0],
  "sun_intensity": 2.0
}
