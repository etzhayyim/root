{
  "name": "kotodama-k3t5g0r1",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "APP_CAPABILITIES": "[\"bpmn-dispatch\",\"game-lifecycle\",\"leaderboard\",\"score-submission\"]",
    "APP_DESCRIPTION": "Goriketsu Dash appview. Score and leaderboard business logic runs in BPMN + Zeebe Python.",
    "APP_DISPLAY_NAME": "Goriketsu Dash!!",
    "APP_EMBED_URL": "ketsu-game.htm",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message",
    "APP_NANOID": "k3t5g0r1",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "appview"
  },
  "routes": [
    {
      "pattern": "k3t5g0r1.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "gorigori-ketsu-dasshu.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "ketsu-gorilla-kami.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ]
}
