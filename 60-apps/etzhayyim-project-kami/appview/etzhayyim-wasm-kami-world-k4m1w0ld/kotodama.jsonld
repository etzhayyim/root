{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:worlds.etzhayyim.com",
  "auth": {
    "guestAccess": true,
    "guestCommands": [
      "guest-join",
      "guest-leave",
      "list-portals",
      "hub-stats"
    ],
    "guestDIDPrefix": "did:web:kami.etzhayyim.com:guest:"
  },
  "component": {
    "path": "component.wasm"
  },
  "convoSystemPrompt": "You are etzhayyim-wasm-kami-world agent. KAMI World Hub — shared world portal, matchmaking, multiplayer. Respond helpfully in the users language.",
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": [
      "content-rating"
    ]
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "etzhayyim-wasm-kami-world",
  "nanoid": "k4m1w0ld",
  "performerType": "service",
  "pool": {},
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "game-engine",
      "3d-rendering"
    ],
    "description": "KAMI World Hub — shared world portal, matchmaking, multiplayer",
    "displayName": "KAMI Worlds",
    "isBot": true,
    "operator": "etzhayyim.co.jp"
  },
  "project": "worlds",
  "routes": [
    {
      "host": "worlds.etzhayyim.com",
      "paths": [
        "/"
      ],
      "tls": true
    },
    {
      "host": "k4m1w0ld.etzhayyim.com",
      "paths": [
        "/"
      ],
      "tls": true
    }
  ],
  "runtimeType": "worker",
  "source": "template",
  "space": {
    "channels": [
      {
        "default": true,
        "description": "Hub Island global chat",
        "kind": "public",
        "name": "hub-chat"
      },
      {
        "description": "Island matchmaking events",
        "kind": "public",
        "name": "matchmaking"
      }
    ],
    "description": "Shared world hub — portals, matchmaking. Play without login!",
    "historyVisibility": "world-readable",
    "joinRule": "public",
    "name": "KAMI World Hub"
  },
  "template": "ohsi-v1b3s0h1",
  "triggers": {
    "http": {
      "listen": "0.0.0.0:8080",
      "routes": [
        "/api/grpc/...",
        "/health",
        "/healthz",
        "/readyz",
        "/..."
      ]
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow",
        "com.etzhayyim.apps.kami.kamiEntity",
        "com.etzhayyim.apps.kami.kamiEvent",
        "com.etzhayyim.apps.kami.kamiReport"
      ]
    }
  },
  "ui": {},
  "uiType": "yoro",
  "version": "1.0.0",
  "yata": {
    "dataDir": "/data/yata"
  }
}
