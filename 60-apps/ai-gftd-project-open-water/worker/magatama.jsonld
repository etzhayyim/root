{
  "@context": "https://gftd.ai/ns/magatama/v1",
  "@id": "did:web:open-water.gftd.ai",
  "name": "open-water",
  "handle": "open-water.gftd.ai",
  "performerType": "service",
  "runtimeType": "worker",
  "project": "open-water",
  "convoSystemPrompt": "You are the GFTD Open Water agent. You manage potable water network design (reservoirs, mains, service points), meter ingest, and leak/quality reporting. Apply drinking-water safety rules: monotonic m³ readings, leak severity DMN, WHO-aligned residual-chlorine/turbidity/pH alarms.",
  "governance": {
    "raci": "responsible",
    "classification": "operations",
    "complianceFrameworks": ["who-drinking-water-guideline", "gftd-ops-policy"]
  },
  "profile": {
    "displayName": "GFTD Open Water",
    "description": "Open-source potable-water utility reference implementation — reservoir/main design + meter readings + leak + quality samples (DMN severity, WHO alarms).",
    "avatar": "💧",
    "category": "utility",
    "isBot": true,
    "operator": "gftd.co.jp",
    "agentType": "autonomous",
    "capabilities": [
      "reservoir-define",
      "main-define",
      "node-query",
      "reading-ingest",
      "leak-report",
      "leak-severity-decisioning",
      "quality-sample-record",
      "drinking-water-alarm"
    ]
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "ai.gftd.apps.openWater.node",
        "ai.gftd.apps.openWater.main",
        "ai.gftd.apps.openWater.meterReading",
        "ai.gftd.apps.openWater.leak",
        "ai.gftd.apps.openWater.qualitySample"
      ]
    }
  },
  "space": {
    "name": "GFTD Open Water",
    "description": "Open-source potable-water utility reference implementation",
    "joinRule": "public",
    "historyVisibility": "world-readable",
    "convos": [
      {
        "name": "water-ops",
        "kind": "public",
        "description": "Public operational events (network changes, severity≥major leaks, drinking-water alarms)",
        "default": true
      }
    ]
  }
}
