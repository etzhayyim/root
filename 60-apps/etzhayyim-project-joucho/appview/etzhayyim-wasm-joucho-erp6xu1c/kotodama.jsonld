{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:joucho.etzhayyim.com",
  "component": {
    "env": {
      "MURAKUMO_MODEL": "gemma-4-e2b-it",
      "MURAKUMO_URL": "https://murakumo.etzhayyim.com/api/openai/v1/chat/completions",
      "EMOTION_TAXONOMY": "sst-48-hume",
      "EMOTION_COUNT": "48"
    },
    "path": "/wasm/component.wasm"
  },
  "convoSystemPrompt": "You are joucho agent. Well-Becoming emotion scoring via Gemma 4 E2B multimodal + SST 48-emotion taxonomy (Cowen & Keltner 2017 PNAS). 48 emotions → 5-axis mapping (joy/calm/stress/gratitude/focus). 数値スペックだけでなく心身が整う体験の質を定量化。Respond helpfully in the users language.",
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": [
      "joucho-policy"
    ]
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "joucho",
  "nanoid": "erp6xu1c",
  "performerType": "service",
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "emotional-scoring",
      "sentiment-analysis",
      "multimodal-emotion-analysis",
      "sst-48-emotion-taxonomy"
    ],
    "description": "Well-Becoming emotion scoring via Gemma 4 E2B multimodal + SST 48-emotion taxonomy (Cowen & Keltner 2017). 48 emotions (Hume-compatible) → 5-axis mapping. Text + image multimodal input",
    "displayName": "情緒 Joucho",
    "isBot": true,
    "operator": "etzhayyim.com"
  },
  "project": "joucho",
  "routes": [
    {
      "host": "joucho.etzhayyim.com",
      "paths": [
        "/"
      ]
    }
  ],
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "description": "レビュー投稿と情緒スコア",
        "kind": "public",
        "name": "joucho-reviews"
      },
      {
        "description": "食事・飲食店の情緒スコア",
        "kind": "public",
        "name": "joucho-meals"
      },
      {
        "description": "スポット・建物の情緒スコア",
        "kind": "public",
        "name": "joucho-spots"
      },
      {
        "description": "商品の Well-Becoming スコア",
        "kind": "public",
        "name": "joucho-products"
      }
    ],
    "description": "Well-Becoming 観点でモノ・場所・サービスの情緒的価値をスコアリング",
    "historyVisibility": "world-readable",
    "joinRule": "public",
    "name": "情緒 Joucho"
  },
  "triggers": {
    "http": {
      "listen": "0.0.0.0:8080"
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.graph.follow",
        "com.etzhayyim.joucho.jouchoEntity",
        "com.etzhayyim.joucho.jouchoEvent",
        "com.etzhayyim.joucho.jouchoReport"
      ]
    }
  },
  "uiType": "yoro"
}
