      {
        "fileName": "osint_analysis_report.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "dct": "http://purl.org/dc/terms/",
            "gftd": "https://gftd.ai/schemas/"
          },
          "id": "https://gftd.ai/projects/ai-gftd-project-lcaas/analysis/osint-regional-report",
          "type": "dodaf:AnalysisResult",
          "dct:title": "OSINT & Regional Asset Intelligence Analysis: AG Life Partners",
          "dct:description": "Analysis of publicly available information and regional characteristics of Sagamihara/Kamimizo to identify hidden assets.",
          "gftd:targetEntity": "https://gftd.ai/entities/organizations/ag-life-partners",
          "gftd:regionalIntelligence": {
            "location": "相模原市中央区上溝周辺 (Sagamihara/Kamimizo)",
            "characteristics": [
              {
                "type": "Banking Network",
                "description": "相模原地域は横浜銀行(BOY)、さがみ信用金庫、きらぼし銀行の密度が極めて高い。特に法人口座はさがみ信金が第2地銀に次いで高いシェアを持つ。",
                "probableBanks": [
                  "さがみ信用金庫",
                  "山梨中央銀行 (相模原支店)",
                  "平塚信用金庫"
                ]
              },
              {
                "type": "Industrial Cluster",
                "description": "上溝周辺は中小の製造業・サービス業の事業所が多い。エージーライフパートナーズがサービス業の場合、近隣の相模原商工会議所経由の共済や融資口座の存在が推定される。"
              }
            ]
          },
          "gftd:osintStrategies": [
            {
              "method": "Real Estate Registry (Touhon) Analysis",
              "target": "Headquarters & Representative Address",
              "logic": "Check for ownership of land/building at the registered address or representative's residence in Sagamihara. Identify mortgage-free properties or excess equity."
            },
            {
              "method": "Accounts Receivable (AR) Identification",
              "dataSources": [
                "Official Website",
                "Hiring Ads",
                "Business Partner Logos"
              ],
              "logic": "Identify major clients from 'Our Partners' or 'Case Studies'. Seizing AR from these clients is often more effective than bank account seizure."
            },
            {
              "method": "Digital Footprint Analysis",
              "dataSources": [
                "Google Maps/Street View",
                "SNS (Twitter/Facebook)",
                "Recruitment Portals"
              ],
              "logic": "Identify company vehicles (lease or owned), heavy equipment, and office equipment. Check recruitment data for salary payment patterns."
            },
            {
              "method": "Public Gazette (Kanpou) Search",
              "logic": "Scan for past public notices related to the company name or its predecessors/subsidiaries to find linked entities or hidden history."
            }
          ],
          "gftd:nextActions": [
            "Execute 'Touhon' acquisition for head office and representative's home.",
            "Web crawl 'ag-life-partners' related domains for partner lists.",
            "Verify 'Sagamihara Chamber of Commerce' membership and related benefits."
          ]
        }
      },
