  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "STRATEGY.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "dct": "http://purl.org/dc/terms/",
            "gftd": "https://gftd.ai/schemas/"
          },
          "id": "https://gftd.ai/projects/ai-gftd-project-lcaas/strategy/asset-recovery-pivot",
          "type": "dodaf:StrategicPlan",
          "dct:title": "Asset Recovery Strategic Pivot: AG Life Partners",
          "dct:description": "Strategy to expand asset investigation after discovering insufficient funds at Kiraboshi Bank.",
          "gftd:objectives": [
            {
              "name": "Expand Inquiry Scope",
              "description": "Perform Bar Association Inquiry or Third-party Information Acquisition for 5-10 additional banks.",
              "priority": "High"
            },
            {
              "name": "Identify Probable Assets",
              "description": "Use intelligence actors to predict which banks are likely used by AG Life Partners based on industry and transaction metadata.",
              "performer": "svc-apqc-10-3-4-asset-intelligence"
            }
          ],
          "gftd:triggers": [
            {
              "condition": "Kiraboshi Bank balance < 10,000 JPY",
              "action": "Trigger 'Secondary Bank Target Identification' activity."
            }
          ]
        }
      },
      {
        "fileName": "activities.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "dct": "http://purl.org/dc/terms/",
            "gftd": "https://gftd.ai/schemas/"
          },
          "id": "https://gftd.ai/projects/ai-gftd-project-lcaas/activities/asset-investigation",
          "type": "dodaf:OperationalActivity",
          "dct:title": "Asset Investigation and Recovery Process (OV-5b)",
          "dct:description": "Operational process to analyze bank responses and coordinate follow-up asset inquiries.",
          "gftd:steps": [
            {
              "activity": "Inquiry Response Ingestion",
              "performer": "ai-gftd-performer-sys-gftd-actors-pba7d22f-psn-isco-2421-legal-analyst",
              "action": "Ingest lawyer email response into structured data format.",
              "input": "Email from TMI (Kiraboshi Bank, ~5k JPY)",
              "output": "Structured Asset Data"
            },
            {
              "activity": "Asset Sufficiency Evaluation",
              "performer": "ai-gftd-performer-sys-gftd-actors-pba7d22f-svc-apqc-10-3-4-asset-intelligence",
              "logic": "Compare detected balance with judgment debt amount. Flag as 'Insufficient' for Kiraboshi Bank.",
              "status": "Completed for Kiraboshi",
              "output": "Analysis: Insufficient Funds"
            },
            {
              "activity": "Next-Phase Strategy Selection",
              "performer": "ai-gftd-performer-sys-gftd-actors-pba7d22f-svc-apqc-10-3-4-asset-intelligence",
              "decision": "Select between (1) Bar Association Inquiry or (2) Third-party Information Acquisition.",
              "targetCount": "5-10 additional financial institutions",
              "output": "Secondary Inquiry Plan"
            },
            {
              "activity": "Target Bank Intelligence Gathering",
              "performer": "ai-gftd-performer-sys-gftd-actors-pba7d22f-svc-apqc-3-1-2-intelligence-email-epb47ybv",
              "action": "Analyze past payment history, registration data, and industry patterns to identify probable banks for AG Life Partners.",
              "output": "Prioritized Bank List"
            },
            {
              "activity": "Draft Inquiry Preparation",
              "performer": "ai-gftd-performer-sys-gftd-actors-pba7d22f-sys-cpc-843-docs-4x2uuhvp",
              "action": "Generate document drafts for the selected 5-10 banks.",
              "output": "Draft Legal Documents (.docx/Markdown)"
            },
            {
              "activity": "Investigation Company Coordination",
              "performer": "ai-gftd-project-lcaas-investigation-actor",
              "action": "Trigger API/Portal request to Teikoku Databank for 'Business Investigation Report' focus on assets.",
              "target": "https://gftd.ai/entities/organizations/teikoku-databank",
              "output": "TDB Investigation Request Sent"
            },
            {
              "activity": "OSINT & Regional Intelligence Analysis",
              "performer": "ai-gftd-project-lcaas-investigation-actor",
              "action": "Analyze digital footprint, registry data, and Sagamihara regional patterns for AR and property discovery.",
              "output": "OSINT Analysis Report Generated"
            }
          ]
        }
      },
      {
        "fileName": "analysis_report.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "dct": "http://purl.org/dc/terms/",
            "gftd": "https://gftd.ai/schemas/"
          },
          "id": "https://gftd.ai/projects/ai-gftd-project-lcaas/analysis/ag-life-partners-report",
          "type": "dodaf:AnalysisResult",
          "dct:title": "Asset Intelligence Analysis Report: AG Life Partners",
          "dct:description": "Automated identification of probable asset locations and selection of investigation strategy.",
          "gftd:targetEntity": "https://gftd.ai/entities/organizations/ag-life-partners",
          "gftd:analysisResults": {
            "status": "Insufficient Assets at Kiraboshi Bank",
            "recommendedStrategy": "Dual Approach: Bar Association Inquiry + TDB Business Investigation",
            "prioritizedBankTargets": [
              {
                "rank": 1,
                "bankName": "三菱UFJ銀行",
                "rationale": "Primary mega-bank for corporate credit services."
              },
              {
                "rank": 2,
                "bankName": "三井住友銀行",
                "rationale": "High correlation with consumer finance sectors."
              },
              {
                "rank": 3,
                "bankName": "みずほ銀行",
                "rationale": "Common for established corporate entities."
              },
              {
                "rank": 4,
                "bankName": "横浜銀行",
                "rationale": "Regional proximity to Sagamihara/Kamimizo operations."
              },
              {
                "rank": 5,
                "bankName": "楽天銀行",
                "rationale": "High usage in modern service/fintech adjacent companies."
              },
              {
                "rank": 6,
                "bankName": "住信SBIネット銀行",
                "rationale": "Secondary digital settlement account probability."
              },
              {
                "rank": 7,
                "bankName": "ゆうちょ銀行",
                "rationale": "Common for diversified regional payment collection."
              },
              {
                "rank": 8,
                "bankName": "東京都民銀行 (Kiraboshi merged)",
                "rationale": "Verify other accounts within the same group under different branch codes."
              },
              {
                "rank": 9,
                "bankName": "りそな銀行",
                "rationale": "Corporate lending and trust service integration."
              },
              {
                "rank": 10,
                "bankName": "GMOあおぞらネット銀行",
                "rationale": "Emerging favorite for tech-oriented service firms."
              }
            ]
          },
          "gftd:investigationPartner": {
            "selectedFirm": "https://gftd.ai/entities/organizations/teikoku-databank",
            "task": "Asset & Real Estate Investigation (Property/Collateral Check)",
            "reason": "Highest coverage of corporate bank relationship data in Japan."
          }
        }
      },
