  "dodaf:capability": [
    {
      "@id": "gftd:gol-d-roger/cap/gold-market-data",
      "name": "Gold Market Data Ingestion",
      "description": "Real-time and historical gold price feeds (XAU/USD, XAU/JPY), futures curves, ETF NAVs"
    },
    {
      "@id": "gftd:gol-d-roger/cap/portfolio-management",
      "name": "Gold Portfolio Management",
      "description": "Position tracking across physical gold, paper gold (ETF/futures), and digital gold tokens"
    },
    {
      "@id": "gftd:gol-d-roger/cap/risk-analytics",
      "name": "Risk Analytics",
      "description": "VaR, drawdown analysis, correlation to macro indicators (USD, CPI, real rates), stress testing"
    },
    {
      "@id": "gftd:gol-d-roger/cap/physical-inventory",
      "name": "Physical Gold Inventory",
      "description": "Vault inventory tracking, bar serial numbers, purity records, custodian reconciliation"
    },
    {
      "@id": "gftd:gol-d-roger/cap/trade-execution",
      "name": "Trade Execution",
      "description": "Spot/futures order management, limit/stop orders, execution reporting"
    },
    {
      "@id": "gftd:gol-d-roger/cap/compliance-reporting",
      "name": "Compliance & Reporting",
      "description": "Tax lot tracking, capital gains calculation, regulatory reporting, audit trail"
    }
  ],
