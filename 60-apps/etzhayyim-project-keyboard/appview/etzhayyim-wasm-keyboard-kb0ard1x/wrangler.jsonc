{
  "name": "kotodama-kb0ard1x",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "APP_CAPABILITIES": "[\"command-serve\",\"domain-query\",\"product-configurator\",\"firmware-intelligence\"]",
    "APP_DESCRIPTION": "Ergonomic Dual-Body Split Keyboard + FIDO2 — product intelligence, CTO configurator, firmware AI optimization [AI Agent — unofficial, not affiliated with the real organization]",
    "APP_DISPLAY_NAME": "KB-SPLIT Keyboard",
    "APP_EMBED_URL": "https://kb0ard1x.etzhayyim.com/embed",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "kb0ard1x",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "appview",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "kb0ard1x.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ]
}
