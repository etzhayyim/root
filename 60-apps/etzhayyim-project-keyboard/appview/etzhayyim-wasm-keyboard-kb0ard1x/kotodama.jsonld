{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:keyboard.etzhayyim.com",
  "component": {
    "path": "component.wasm"
  },
  "convoSystemPrompt": "You are keyboard.etzhayyim.com — ergonomic split keyboard product intelligence agent. Help users configure their KB-SPLIT keyboard, recommend ergonomic settings, and manage firmware. Respond in the user's language.",
  "deploy": {},
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "raci": "responsible",
    "classification": "public",
    "complianceFrameworks": [
      "product-safety-pse",
      "fcc-part15",
      "ce-marking",
      "fido-alliance-l1"
    ]
  },
  "kpi": [
    "keyboard 販売台数",
    "CTO option 平均単価",
    "FIDO2 登録完了率"
  ],
  "name": "etzhayyim-wasm-keyboard",
  "nanoid": "kb0ard1x",
  "performerType": "service",
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "command-serve",
      "domain-query",
      "product-configurator",
      "firmware-intelligence"
    ],
    "description": "Ergonomic Dual-Body Split Keyboard + FIDO2 — product intelligence, CTO configurator, firmware AI optimization [AI Agent — unofficial, not affiliated with the real organization]",
    "displayName": "KB-SPLIT Keyboard",
    "isBot": true,
    "operator": "etzhayyim.com"
  },
  "project": "keyboard",
  "routes": [
    {
      "host": "keyboard.etzhayyim.com",
      "paths": ["/"],
      "tls": true
    }
  ],
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "description": "Product announcements, firmware updates, ergonomic tips",
        "kind": "public",
        "name": "keyboard-feed"
      },
      {
        "description": "CTO order status and configuration showcase",
        "kind": "public",
        "name": "keyboard-orders"
      },
      {
        "description": "Firmware changelog and keymap community",
        "kind": "public",
        "name": "keyboard-firmware"
      }
    ],
    "description": "KB-SPLIT ergonomic split keyboard — FIDO2 fingerprint, CTO configurator",
    "historyVisibility": "world-readable",
    "joinRule": "public",
    "name": "KB-SPLIT Keyboard"
  },
  "triggers": {
    "http": {
      "listen": "0.0.0.0:8080",
      "routes": ["/api/grpc/...", "/health", "/healthz", "/readyz"]
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow",
        "com.etzhayyim.apps.keyboard.product",
        "com.etzhayyim.apps.keyboard.configuration",
        "com.etzhayyim.apps.keyboard.firmware",
        "com.etzhayyim.apps.keyboard.ergonomicProfile",
        "com.etzhayyim.apps.okaimono.order",
        "com.etzhayyim.apps.crowdfunding.pledge",
        "com.etzhayyim.apps.crowdfunding.campaign"
      ]
    }
  },
  "uiType": "appview",
  "embedUrl": "https://kb0ard1x.etzhayyim.com/embed",
  "derive": {
    "social": [
      {
        "on": "com.etzhayyim.apps.okaimono.order",
        "when": { "productType": "keyboard" },
        "template": "[KB-SPLIT] New CTO order: {{skuId}} — ¥{{totalPrice}}"
      },
      {
        "on": "com.etzhayyim.apps.keyboard.firmware",
        "template": "[KB-SPLIT Firmware] New firmware version available — update via USB-C DFU"
      },
      {
        "on": "com.etzhayyim.apps.keyboard.crowdfundingRequest",
        "template": "[KB-SPLIT] クラウドファンディング開始を crowdfunding.etzhayyim.com に依頼しました — {{productName}}"
      }
    ],
    "invoke": [
      {
        "on": "com.etzhayyim.apps.keyboard.crowdfundingRequest",
        "when": { "status": "requested" },
        "target": "did:web:crowdfunding.etzhayyim.com",
        "method": "com.etzhayyim.apps.crowdfunding.launchForProduct",
        "map": {
          "productDid": "{{productDid}}",
          "productName": "{{productName}}",
          "skuId": "{{skuId}}",
          "skus": "{{skus}}",
          "ctoOptions": "{{ctoOptions}}",
          "mode": "{{mode}}",
          "durationDays": "{{durationDays}}"
        }
      }
    ]
  }
}
