{
  "@context": "https://etzhayyim.com/ns/actor/v1",
  "@id": "did:web:gov.etzhayyim.com",
  "actors": [
    {
      "displayName": "Ministry of Justice (JP)",
      "path": "country:jpn:moj",
      "description": "Core justice agency DID for JP coverage."
    },
    {
      "displayName": "METI (JP)",
      "path": "country:jpn:meti",
      "description": "Industry and commerce policy agency DID."
    },
    {
      "displayName": "Cabinet Office (JP)",
      "path": "country:jpn:cabinet-office"
    },
    {
      "displayName": "Ministry of the Environment (JP)",
      "path": "country:jpn:moe"
    },
    {
      "displayName": "Ministry of Finance (JP)",
      "path": "country:jpn:mof"
    },
    {
      "displayName": "Ministry of Health Labour and Welfare (JP)",
      "path": "country:jpn:mhlw"
    },
    {
      "displayName": "Ministry of Education Culture Sports Science and Technology (JP)",
      "path": "country:jpn:mext"
    },
    {
      "displayName": "Ministry of Land Infrastructure Transport and Tourism (JP)",
      "path": "country:jpn:mlit"
    },
    {
      "displayName": "Ministry of Agriculture Forestry and Fisheries (JP)",
      "path": "country:jpn:maff"
    },
    {
      "displayName": "Ministry of Foreign Affairs (JP)",
      "path": "country:jpn:mofa"
    },
    {
      "displayName": "Ministry of Defense (JP)",
      "path": "country:jpn:mod"
    },
    {
      "displayName": "Ministry of Internal Affairs and Communications (JP)",
      "path": "country:jpn:mic"
    },
    {
      "displayName": "National Police Agency (JP)",
      "path": "country:jpn:npa"
    },
    {
      "displayName": "Financial Services Agency (JP)",
      "path": "country:jpn:fsa"
    },
    {
      "displayName": "Consumer Affairs Agency (JP)",
      "path": "country:jpn:caa"
    },
    {
      "displayName": "National Tax Agency (JP)",
      "path": "country:jpn:nta",
      "description": "L6 歳入徴収 (国税)"
    },
    {
      "displayName": "Japan Customs",
      "path": "country:jpn:customs",
      "description": "L6 歳入徴収 (関税)"
    },
    {
      "displayName": "Board of Audit (JP)",
      "path": "country:jpn:boa",
      "description": "L6 横串統制 (会計検査院)"
    },
    {
      "displayName": "MOF Budget Bureau (JP)",
      "path": "country:jpn:mof:budget-bureau",
      "description": "L6 予算編成 (主計局)"
    },
    {
      "displayName": "National Treasury (JP)",
      "path": "country:jpn:treasury",
      "description": "L7 root — 国庫"
    },
    {
      "displayName": "Department of Justice (US)",
      "path": "country:usa:justice"
    },
    {
      "displayName": "Department of the Treasury (US)",
      "path": "country:usa:treasury"
    },
    {
      "displayName": "Federal Ministry of the Interior (DE)",
      "path": "country:deu:bmi"
    }
  ],
  "capabilities": [
    "graph.query",
    "graph.write",
    "derive:social",
    "agent.chat"
  ],
  "complianceDocs": [
    "90-docs/rules/compliance/per-did-kyumei-shinka-autonomy.md",
    "90-docs/platform/260403-live-data-kyumei-shinka-consolidated.md"
  ],
  "convoSystemPrompt": "You are the Gov Coverage actor. Keep government agency DID topology healthy, run periodic baseline seeding, and expose coverage snapshots via XRPC.",
  "description": "Government domain T1 actor for agency DID topology, baseline seeding, and coverage observability.",
  "displayName": "Gov Coverage Orchestrator",
  "domainKnowledgeRequired": true,
  "runtime": "k8s-langserver",
  "edge": "sveltekit-proxy",
  "legacyExecutionTier": "T1",
  "governance": {
    "classification": "internal",
    "raci": "responsible"
  },
  "heartbeatRequired": true,
  "name": "gov",
  "nanoid": "g0v9a1cy",
  "performerType": "service",
  "pipelines": [
    {
      "steps": [
        {
          "args": {
            "template": "UNWIND [\n  {path:'country:jpn:cabinet-office', name:'Cabinet Office (JP)', country:'JP'},\n  {path:'country:jpn:moj', name:'Ministry of Justice (JP)', country:'JP'},\n  {path:'country:jpn:moe', name:'Ministry of the Environment (JP)', country:'JP'},\n  {path:'country:jpn:mof', name:'Ministry of Finance (JP)', country:'JP'},\n  {path:'country:jpn:meti', name:'Ministry of Economy Trade and Industry (JP)', country:'JP'},\n  {path:'country:jpn:mhlw', name:'Ministry of Health Labour and Welfare (JP)', country:'JP'},\n  {path:'country:jpn:mext', name:'Ministry of Education Culture Sports Science and Technology (JP)', country:'JP'},\n  {path:'country:jpn:mlit', name:'Ministry of Land Infrastructure Transport and Tourism (JP)', country:'JP'},\n  {path:'country:jpn:maff', name:'Ministry of Agriculture Forestry and Fisheries (JP)', country:'JP'},\n  {path:'country:jpn:mofa', name:'Ministry of Foreign Affairs (JP)', country:'JP'},\n  {path:'country:jpn:mod', name:'Ministry of Defense (JP)', country:'JP'},\n  {path:'country:jpn:mic', name:'Ministry of Internal Affairs and Communications (JP)', country:'JP'},\n  {path:'country:jpn:npa', name:'National Police Agency (JP)', country:'JP'},\n  {path:'country:jpn:fsa', name:'Financial Services Agency (JP)', country:'JP'},\n  {path:'country:jpn:caa', name:'Consumer Affairs Agency (JP)', country:'JP'},\n  {path:'country:jpn:nta', name:'National Tax Agency (JP) L6 collector', country:'JP'},\n  {path:'country:jpn:customs', name:'Japan Customs (JP) L6 collector', country:'JP'},\n  {path:'country:jpn:boa', name:'Board of Audit (JP) L6 horizontal', country:'JP'},\n  {path:'country:jpn:mof:budget-bureau', name:'MOF Budget Bureau (JP) L6 horizontal', country:'JP'},\n  {path:'country:jpn:treasury', name:'National Treasury (JP) L7 root', country:'JP'},\n  {path:'country:usa:treasury', name:'Department of the Treasury (US)', country:'US'},\n  {path:'country:usa:state', name:'Department of State (US)', country:'US'},\n  {path:'country:usa:justice', name:'Department of Justice (US)', country:'US'},\n  {path:'country:deu:bmi', name:'Federal Ministry of the Interior (DE)', country:'DE'},\n  {path:'country:fra:interieur', name:'Ministere de l Interieur (FR)', country:'FR'}\n] AS a MERGE (n:GovAgency {did: 'did:web:gov.etzhayyim.com:' + a.path}) SET n.path = a.path, n.displayName = a.name, n.country = a.country, n.updatedAt = toString(datetime()), n.repo = 'did:web:gov.etzhayyim.com'"
          },
          "fn": "graph.write",
          "id": "seedGovAgencies"
        },
        {
          "args": {
            "template": "gov seed completed: baseline agency nodes refreshed."
          },
          "depends_on": [],
          "fn": "derive:social",
          "id": "seedDigest"
        }
      ],
      "trigger": {
        "cron": "15 */6 * * *",
        "type": "cron"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (n:GovAgency) WHERE n.repo = $did RETURN count(n) AS nodeCount, coalesce(max(n._seq), 0) AS latestSeq LIMIT 1"
          },
          "fn": "graph.query",
          "id": "coverageNodes"
        },
        {
          "args": {
            "sql": "MATCH (n:GovAgency) WHERE n.repo = $did RETURN n.country AS collection, count(n) AS cnt LIMIT 10"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "coverageCollections"
        },
        {
          "args": {
            "params": {
              "actorName": "gov",
              "bucket": "6h",
              "collection": "com.etzhayyim.apps.gov.coverageSnapshot",
              "latestSeq": 0,
              "nanoid": "g0v9a1cy",
              "nodeCount": "$coverageNodes.rows[0].nodeCount"
            },
            "template": "MERGE (c:ActorCoverageSnapshot {actorDid: $did, bucket: $bucket, actorName: $actorName, nanoid: $nanoid, nodeCount: $nodeCount, latestTs: $latestTs, repo: $did, collection: $collection, status: 'active'})"
          },
          "depends_on": [
            "coverageNodes"
          ],
          "fn": "graph.write",
          "id": "coverageSnapshot"
        }
      ],
      "trigger": {
        "cron": "0 */6 * * *",
        "type": "cron"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (c:ActorCoverageSnapshot {actorDid: $did}) RETURN c.nodeCount AS nodeCount, c.latestSeq AS latestSeq, c.topCollections AS topCollections, c._seq AS snapshotSeq LIMIT 1"
          },
          "fn": "graph.query",
          "id": "coverageStats"
        },
        {
          "args": {
            "sql": "MATCH (n:GovAgency) WHERE n.repo = $did RETURN count(n) AS totalNodes LIMIT 1"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "coverageHealth"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.gov.coverage.get",
        "type": "xrpc"
      }
    }
  ],
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "seed-agency-baseline",
      "get-coverage",
      "list-agencies"
    ],
    "description": "Maintains baseline agency DIDs and tracks government-domain coverage health.",
    "displayName": "Gov Coverage Orchestrator",
    "isBot": true,
    "operator": "etzhayyim.com"
  },
  "requiredCollections": [
    "com.etzhayyim.apps.standard.shinkaEvolution",
    "com.etzhayyim.apps.standard.shinkaKnowledge"
  ],
  "requiredLoops": [
    "shinka",
    "koji",
    "kyumei",
    "domain-knowledge"
  ],
  "standardRule": "per-did-kyumei-shinka-autonomy@2026-04-13",
  "standardStatus": "required",
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.gov.agency",
        "com.etzhayyim.apps.gov.coverageSnapshot",
        "com.etzhayyim.apps.jpFiscal.taxPayment",
        "com.etzhayyim.apps.jpFiscal.appropriation",
        "com.etzhayyim.apps.jpFiscal.budgetExecution",
        "com.etzhayyim.apps.jpFiscal.kofuzeiTransfer",
        "com.etzhayyim.apps.jpFiscal.subsidyGrant",
        "com.etzhayyim.apps.jpFiscal.contract",
        "com.etzhayyim.apps.jpFiscal.paymentRecord",
        "com.etzhayyim.apps.jpFiscal.auditFinding",
        "com.etzhayyim.apps.jpFiscal.budgetBook",
        "com.etzhayyim.apps.jpFiscal.procurementBid",
        "com.etzhayyim.apps.jpFiscal.programReview",
        "com.etzhayyim.apps.jpFiscal.lgFinance",
        "com.etzhayyim.apps.jpFiscal.incorpFinance",
        "com.etzhayyim.apps.jpFiscal.beneficialOwner"
      ]
    }
  },
  "derive": [
    {
      "from": "com.etzhayyim.apps.jpFiscal.contract",
      "emit": {
        "$type": "app.bsky.feed.post",
        "text": "契約締結: {{ contractorDisplayName | fallback:contractorJcn }} ({{ method }}) {{ amountJpy | yenFormat }} — {{ deliverable | truncate:60 }}",
        "embed": {
          "$type": "app.bsky.embed.external",
          "external": {
            "uri": "{{ publicationUrl }}"
          }
        },
        "langs": [
          "ja"
        ]
      }
    },
    {
      "from": "com.etzhayyim.apps.jpFiscal.paymentRecord",
      "emit": {
        "$type": "app.bsky.feed.post",
        "text": "支払: {{ payeeDisplayName }} に {{ paidJpy | yenFormat }} (契約 {{ contractDid | shortDid }})",
        "facets": [
          "mention:payeeDid"
        ],
        "langs": [
          "ja"
        ]
      }
    },
    {
      "from": "com.etzhayyim.apps.jpFiscal.subsidyGrant",
      "filter": "piiTier == 1",
      "emit": {
        "$type": "app.bsky.feed.post",
        "text": "補助金交付: {{ recipientDisplayName }} {{ amountJpy | yenFormat }} / {{ program }}",
        "embed": {
          "$type": "app.bsky.embed.external",
          "external": {
            "uri": "{{ publicationUrl }}"
          }
        },
        "langs": [
          "ja"
        ]
      }
    },
    {
      "from": "com.etzhayyim.apps.jpFiscal.procurementBid",
      "emit": {
        "$type": "app.bsky.feed.post",
        "text": "入札公告: {{ issuerDisplayName }} {{ method }} 予定価格 {{ estimatedJpy | yenFormat }} — 開札 {{ closedAt | jpDate }}",
        "embed": {
          "$type": "app.bsky.embed.external",
          "external": {
            "uri": "{{ tenderUrl }}"
          }
        },
        "langs": [
          "ja"
        ]
      }
    },
    {
      "from": "com.etzhayyim.apps.jpFiscal.auditFinding",
      "emit": {
        "$type": "app.bsky.feed.post",
        "text": "⚠️ 会計検査院 {{ fiscalYear }}年度 {{ category }}: {{ targetDisplayName }} {{ amountJpy | yenFormat }} ({{ paragraphRef }})",
        "facets": [
          "mention:targetDid"
        ],
        "langs": [
          "ja"
        ]
      }
    },
    {
      "from": "com.etzhayyim.apps.jpFiscal.beneficialOwner",
      "filter": "status == 'RESOLVED' && ownershipPct >= 25",
      "emit": {
        "$type": "app.bsky.feed.post",
        "text": "🔎 UBO: {{ childDisplayName }} ← {{ parentDisplayName }} ({{ ownershipPct }}%, 根拠 {{ evidenceKind }})",
        "facets": [
          "mention:childDid",
          "mention:parentDid"
        ],
        "langs": [
          "ja"
        ]
      }
    },
    {
      "from": "com.etzhayyim.apps.jpFiscal.budgetBook",
      "emit": {
        "$type": "app.bsky.feed.post",
        "text": "📘 {{ fiscalYear }}年度 {{ docType }} ({{ accountType }}) 総額 {{ totalJpy | yenFormat }}",
        "embed": {
          "$type": "app.bsky.embed.external",
          "external": {
            "uri": "{{ sourceUrl }}"
          }
        },
        "langs": [
          "ja"
        ]
      }
    }
  ],
  "uiType": "yoro"
}
