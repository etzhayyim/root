<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             targetNamespace="https://etzhayyim.com/bpmn">

  <!-- registerAgency -->
  <process id="registerAgency" name="Register Government Agency" isExecutable="true">
    <startEvent id="start_registerAgency"/>
    <sequenceFlow id="sf1_ra" sourceRef="start_registerAgency" targetRef="task_registerAgency"/>
    <serviceTask id="task_registerAgency" name="Register Agency">
      <extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.gov.registerAgency"/>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="sf2_ra" sourceRef="task_registerAgency" targetRef="end_registerAgency"/>
    <endEvent id="end_registerAgency"/>
  </process>

  <!-- recordOfficial -->
  <process id="recordOfficial" name="Record Public Official" isExecutable="true">
    <startEvent id="start_recordOfficial"/>
    <sequenceFlow id="sf1_ro" sourceRef="start_recordOfficial" targetRef="task_recordOfficial"/>
    <serviceTask id="task_recordOfficial" name="Record Official">
      <extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.gov.recordOfficial"/>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="sf2_ro" sourceRef="task_recordOfficial" targetRef="end_recordOfficial"/>
    <endEvent id="end_recordOfficial"/>
  </process>

  <!-- submitConsult -->
  <process id="submitConsult" name="Submit Government Consultation" isExecutable="true">
    <startEvent id="start_submitConsult"/>
    <sequenceFlow id="sf1_sc" sourceRef="start_submitConsult" targetRef="task_submitConsult"/>
    <serviceTask id="task_submitConsult" name="Submit Consult">
      <extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.gov.submitConsult"/>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="sf2_sc" sourceRef="task_submitConsult" targetRef="end_submitConsult"/>
    <endEvent id="end_submitConsult"/>
  </process>

  <!-- listAgencies -->
  <process id="listAgencies" name="List Agencies" isExecutable="true">
    <startEvent id="start_listAgencies"/>
    <sequenceFlow id="sf1_la" sourceRef="start_listAgencies" targetRef="task_listAgencies"/>
    <serviceTask id="task_listAgencies" name="List Agencies">
      <extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.gov.listAgencies"/>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="sf2_la" sourceRef="task_listAgencies" targetRef="end_listAgencies"/>
    <endEvent id="end_listAgencies"/>
  </process>

  <!-- getAgency -->
  <process id="getAgency" name="Get Agency" isExecutable="true">
    <startEvent id="start_getAgency"/>
    <sequenceFlow id="sf1_ga" sourceRef="start_getAgency" targetRef="task_getAgency"/>
    <serviceTask id="task_getAgency" name="Get Agency">
      <extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.gov.getAgency"/>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="sf2_ga" sourceRef="task_getAgency" targetRef="end_getAgency"/>
    <endEvent id="end_getAgency"/>
  </process>

  <!-- listOfficials -->
  <process id="listOfficials" name="List Officials" isExecutable="true">
    <startEvent id="start_listOfficials"/>
    <sequenceFlow id="sf1_lo" sourceRef="start_listOfficials" targetRef="task_listOfficials"/>
    <serviceTask id="task_listOfficials" name="List Officials">
      <extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.gov.listOfficials"/>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="sf2_lo" sourceRef="task_listOfficials" targetRef="end_listOfficials"/>
    <endEvent id="end_listOfficials"/>
  </process>

  <!-- listMunicipalities -->
  <process id="listMunicipalities" name="List Municipalities" isExecutable="true">
    <startEvent id="start_listMunicipalities"/>
    <sequenceFlow id="sf1_lm" sourceRef="start_listMunicipalities" targetRef="task_listMunicipalities"/>
    <serviceTask id="task_listMunicipalities" name="List Municipalities">
      <extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.gov.listMunicipalities"/>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="sf2_lm" sourceRef="task_listMunicipalities" targetRef="end_listMunicipalities"/>
    <endEvent id="end_listMunicipalities"/>
  </process>

  <!-- listConsults -->
  <process id="listConsults" name="List Consultations" isExecutable="true">
    <startEvent id="start_listConsults"/>
    <sequenceFlow id="sf1_lc" sourceRef="start_listConsults" targetRef="task_listConsults"/>
    <serviceTask id="task_listConsults" name="List Consults">
      <extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.gov.listConsults"/>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="sf2_lc" sourceRef="task_listConsults" targetRef="end_listConsults"/>
    <endEvent id="end_listConsults"/>
  </process>

</definitions>
