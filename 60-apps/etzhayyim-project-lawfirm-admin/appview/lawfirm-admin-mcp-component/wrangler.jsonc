{
  "name": "kotodama-ujv6oh9s",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"createCase\",\"updateCase\",\"listCases\",\"getCase\",\"createClient\",\"updateClient\",\"listClients\",\"getClient\"]",
    "APP_DESCRIPTION": "lawfirm-admin — Legal Administration Platform. Case and client management with BPMN-driven workflows.",
    "APP_DISPLAY_NAME": "Law Firm Admin",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "ujv6oh9s",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "ujv6oh9s.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "lawfirm-admin.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
