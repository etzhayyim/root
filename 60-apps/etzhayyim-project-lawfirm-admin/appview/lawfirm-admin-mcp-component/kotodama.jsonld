{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:lawfirm-admin.etzhayyim.com",
  "name": "lawfirm-admin",
  "nanoid": "ujv6oh9s",
  "project": "lawfirm-admin",
  "runtimeType": "worker",
  "performerType": "service",
  "uiType": "yoro",
  "accent": "#6366f1",
  "convoSystemPrompt": "You are the legal administration agent. You manage law firm cases, clients, and administrative workflows.",
  "profile": {
    "displayName": "Law Firm Admin",
    "description": "lawfirm-admin — Legal Administration Platform. Case and client management with BPMN-driven workflows.",
    "avatar": "⚖️",
    "isBot": true,
    "agentType": "autonomous",
    "operator": "amanomibashira",
    "capabilities": ["createCase", "updateCase", "listCases", "getCase", "createClient", "updateClient", "listClients", "getClient"],
    "protocols": ["xrpc", "mcp"]
  },
  "governance": {
    "raci": "responsible",
    "classification": "public"
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.lawfirmAdmin.case",
        "com.etzhayyim.apps.lawfirmAdmin.client"
      ]
    }
  }
}
