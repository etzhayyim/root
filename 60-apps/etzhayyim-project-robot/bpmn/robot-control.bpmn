<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- workflowStart -->
  <bpmn:process id="robotics-workflow-start" name="Robotics Workflow Start" isExecutable="true">
    <bpmn:startEvent id="start-workflow-start"/>
    <bpmn:sequenceFlow id="sf-wfs-1" sourceRef="start-workflow-start" targetRef="task-workflow-start"/>
    <bpmn:serviceTask id="task-workflow-start" name="Start Workflow">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.robotics.workflow.start"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-wfs-2" sourceRef="task-workflow-start" targetRef="end-workflow-start"/>
    <bpmn:endEvent id="end-workflow-start"/>
  </bpmn:process>

  <!-- workflowPlan -->
  <bpmn:process id="robotics-workflow-plan" name="Robotics Workflow Plan" isExecutable="true">
    <bpmn:startEvent id="start-workflow-plan"/>
    <bpmn:sequenceFlow id="sf-wfp-1" sourceRef="start-workflow-plan" targetRef="task-workflow-plan"/>
    <bpmn:serviceTask id="task-workflow-plan" name="Plan Workflow">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.robotics.workflow.plan"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-wfp-2" sourceRef="task-workflow-plan" targetRef="end-workflow-plan"/>
    <bpmn:endEvent id="end-workflow-plan"/>
  </bpmn:process>

  <!-- missionPlan -->
  <bpmn:process id="robotics-mission-plan" name="Robotics Mission Plan" isExecutable="true">
    <bpmn:startEvent id="start-mission-plan"/>
    <bpmn:sequenceFlow id="sf-mp-1" sourceRef="start-mission-plan" targetRef="task-mission-plan"/>
    <bpmn:serviceTask id="task-mission-plan" name="Plan Mission">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.robotics.mission.plan"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-mp-2" sourceRef="task-mission-plan" targetRef="end-mission-plan"/>
    <bpmn:endEvent id="end-mission-plan"/>
  </bpmn:process>

  <!-- missionStatus -->
  <bpmn:process id="robotics-mission-status" name="Robotics Mission Status" isExecutable="true">
    <bpmn:startEvent id="start-mission-status"/>
    <bpmn:sequenceFlow id="sf-ms-1" sourceRef="start-mission-status" targetRef="task-mission-status"/>
    <bpmn:serviceTask id="task-mission-status" name="Mission Status">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.robotics.mission.status"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-ms-2" sourceRef="task-mission-status" targetRef="end-mission-status"/>
    <bpmn:endEvent id="end-mission-status"/>
  </bpmn:process>

  <!-- missionSimulate -->
  <bpmn:process id="robotics-mission-simulate" name="Robotics Mission Simulate" isExecutable="true">
    <bpmn:startEvent id="start-mission-simulate"/>
    <bpmn:sequenceFlow id="sf-msim-1" sourceRef="start-mission-simulate" targetRef="task-mission-simulate"/>
    <bpmn:serviceTask id="task-mission-simulate" name="Simulate Mission">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.robotics.mission.simulate"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-msim-2" sourceRef="task-mission-simulate" targetRef="end-mission-simulate"/>
    <bpmn:endEvent id="end-mission-simulate"/>
  </bpmn:process>

  <!-- telemetryIngest -->
  <bpmn:process id="robotics-telemetry-ingest" name="Robotics Telemetry Ingest" isExecutable="true">
    <bpmn:startEvent id="start-telemetry-ingest"/>
    <bpmn:sequenceFlow id="sf-ti-1" sourceRef="start-telemetry-ingest" targetRef="task-telemetry-ingest"/>
    <bpmn:serviceTask id="task-telemetry-ingest" name="Ingest Telemetry">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.robotics.telemetry.ingest"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-ti-2" sourceRef="task-telemetry-ingest" targetRef="end-telemetry-ingest"/>
    <bpmn:endEvent id="end-telemetry-ingest"/>
  </bpmn:process>

  <!-- processCatalog -->
  <bpmn:process id="robotics-process-catalog" name="Robotics Process Catalog" isExecutable="true">
    <bpmn:startEvent id="start-process-catalog"/>
    <bpmn:sequenceFlow id="sf-pc-1" sourceRef="start-process-catalog" targetRef="task-process-catalog"/>
    <bpmn:serviceTask id="task-process-catalog" name="Process Catalog">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.robotics.process.catalog"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-pc-2" sourceRef="task-process-catalog" targetRef="end-process-catalog"/>
    <bpmn:endEvent id="end-process-catalog"/>
  </bpmn:process>

  <!-- fulfillmentClose -->
  <bpmn:process id="robotics-fulfillment-close" name="Robotics Fulfillment Close" isExecutable="true">
    <bpmn:startEvent id="start-fulfillment-close"/>
    <bpmn:sequenceFlow id="sf-fc-1" sourceRef="start-fulfillment-close" targetRef="task-fulfillment-close"/>
    <bpmn:serviceTask id="task-fulfillment-close" name="Close Fulfillment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.robotics.fulfillment.close"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-fc-2" sourceRef="task-fulfillment-close" targetRef="end-fulfillment-close"/>
    <bpmn:endEvent id="end-fulfillment-close"/>
  </bpmn:process>

</bpmn:definitions>
