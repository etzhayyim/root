{
  "@context": "https://schema.org",
  "@type": "Project",
  "name": "etzhayyim-project-robot",
  "description": "Physical robot control and dropshipping platform. Reachy Mini as primary product with SpinApp-based control plane.",
  "category": "robotics",
  "capabilities": [
    "robot-control",
    "robot-telemetry",
    "dropshipping",
    "spinapp-edge-compute",
    "robotics-mcp-tools",
    "bpmn-robotics-workflows",
    "kami-engine-robotics-review",
    "mcp-langserver-start-bridge",
    "robotics-dry-run-simulation",
    "robotics-approval-audit",
    "robotics-telemetry-contracts",
    "robotics-telemetry-ingest",
    "robotics-mission-status",
    "robotics-fulfillment-close"
  ],
  "performers": [
    {
      "@type": "SoftwareApplication",
      "name": "robot-ui",
      "nanoid": "k7m2p4x9",
      "deliveryMethod": "cdn",
      "description": "Robot control page and Reachy Mini LP/dropshipping storefront"
    },
    {
      "@type": "SoftwareApplication",
      "name": "robot-mcp-component",
      "deliveryMethod": "wasm",
      "description": "SpinApp MCP component for robot control API and telemetry"
    },
    {
      "@type": "SoftwareApplication",
      "name": "robotics-kami-review",
      "deliveryMethod": "static-html",
      "description": "KAMI Engine SDK review surface for robotics process forms, robot workcells, route nodes, safety zones, approval gates, telemetry topics, and MCP-to-BPMN start bridge mappings"
    },
    {
      "@type": "SoftwareApplication",
      "name": "robotics-mcp",
      "deliveryMethod": "kubernetes-mcp-server",
      "description": "MCP server exposing robotics process catalog, workflow planning, LangServer BPMN-contract start, KAMI scene planning, transport planning, sales planning, and mission planning tools"
    }
  ]
}
