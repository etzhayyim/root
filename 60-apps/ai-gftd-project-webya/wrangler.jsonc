{
  "name": "magatama-w3bya001",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"homepage-generation\",\"cf-for-saas-domain-provisioning\",\"seo-audit\",\"legal-disclosure-guard\",\"custom-domain-serving\"]",
    "APP_DESCRIPTION": "webya (ウェブ屋) — AI homepage generation for Japanese 士業 professionals and businesses.",
    "APP_DISPLAY_NAME": "Webya Homepage Generation",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "w3bya001",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.gftd.ai/xrpc/ai.gftd.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "w3bya001.gftd.ai/*",
      "zone_name": "gftd.ai"
    },
    {
      "pattern": "webya.gftd.ai/*",
      "zone_name": "gftd.ai"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
