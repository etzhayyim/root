{
  "@context": [
    "https://schema.org/",
    {
      "@version": 1.1,
      "gftd": "https://gftd.ai/schemas/",
      "dct": "http://purl.org/dc/terms/",
      "xsd": "http://www.w3.org/2001/XMLSchema#",
      "socialCapital": "gftd:socialCapital",
      "brandingValue": "gftd:brandingValue",
      "hourlyRateJpy": "gftd:hourlyRateJpy",
      "perSecondRateJpy": "gftd:perSecondRateJpy",
      "durationSeconds": "gftd:durationSeconds",
      "durationHours": "gftd:durationHours",
      "activityType": "gftd:activityType",
      "calculationFormula": "gftd:calculationFormula",
      "capitalType": "gftd:capitalType",
      "examples": "gftd:examples"
    }
  ],
  "@type": "DefinedTermSet",
  "@id": "urn:gftd:resource:capital:social-capital",
  "name": "Social Capital — Branding Value Model",
  "description": "個人の時間投下をブランディング価値として定量化するソーシャルキャピタルモデル。時給を秒単位レートに変換し、活動時間（秒）を乗じて social capital を算出する。",
  "dct:created": "2026-02-28T00:00:00Z",
  "dct:modified": "2026-02-28T00:00:00Z",
  "capitalType": "social",
  "calculationFormula": {
    "@type": "PropertyValue",
    "name": "Branding Value Formula",
    "description": "branding_value_jpy = hourly_rate_jpy × (duration_seconds / 3600). 時給を秒レートに分解し、活動秒数を掛けることでブランディング価値（円）を算出する。",
    "value": "branding_value_jpy = hourly_rate_jpy * duration_seconds / 3600",
    "unitText": "JPY",
    "additionalProperty": [
      {
        "@type": "PropertyValue",
        "name": "hourlyRateJpy",
        "description": "その人の時給（円）",
        "unitText": "JPY/hour"
      },
      {
        "@type": "PropertyValue",
        "name": "perSecondRateJpy",
        "description": "時給を3600で割った秒単位レート（円/秒）。perSecondRateJpy = hourlyRateJpy / 3600",
        "unitText": "JPY/second"
      },
      {
        "@type": "PropertyValue",
        "name": "durationSeconds",
        "description": "活動に費やした時間（秒）",
        "unitText": "seconds"
      },
      {
        "@type": "PropertyValue",
        "name": "durationHours",
        "description": "活動に費やした時間（時間）。durationHours = durationSeconds / 3600",
        "unitText": "hours"
      },
      {
        "@type": "PropertyValue",
        "name": "brandingValue",
        "description": "算出されたブランディング価値（円）",
        "unitText": "JPY"
      }
    ]
  },
  "examples": [
    {
      "@type": "PropertyValue",
      "name": "ゲーム10時間 (時給1000円)",
      "description": "時給1000円の人が10時間ゲームをした場合のソーシャルキャピタル",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "hourlyRateJpy",
          "value": 1000
        },
        {
          "@type": "PropertyValue",
          "name": "perSecondRateJpy",
          "value": 0.2778
        },
        {
          "@type": "PropertyValue",
          "name": "durationSeconds",
          "value": 36000
        },
        {
          "@type": "PropertyValue",
          "name": "durationHours",
          "value": 10
        },
        {
          "@type": "PropertyValue",
          "name": "activityType",
          "value": "gaming"
        },
        {
          "@type": "PropertyValue",
          "name": "brandingValue",
          "value": 10000,
          "unitText": "JPY"
        }
      ]
    },
    {
      "@type": "PropertyValue",
      "name": "OSS開発5時間 (時給3000円)",
      "description": "時給3000円のエンジニアが5時間OSS開発をした場合のソーシャルキャピタル",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "hourlyRateJpy",
          "value": 3000
        },
        {
          "@type": "PropertyValue",
          "name": "perSecondRateJpy",
          "value": 0.8333
        },
        {
          "@type": "PropertyValue",
          "name": "durationSeconds",
          "value": 18000
        },
        {
          "@type": "PropertyValue",
          "name": "durationHours",
          "value": 5
        },
        {
          "@type": "PropertyValue",
          "name": "activityType",
          "value": "oss-development"
        },
        {
          "@type": "PropertyValue",
          "name": "brandingValue",
          "value": 15000,
          "unitText": "JPY"
        }
      ]
    },
    {
      "@type": "PropertyValue",
      "name": "コミュニティ活動2時間 (時給2000円)",
      "description": "時給2000円の人が2時間コミュニティ活動をした場合のソーシャルキャピタル",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "hourlyRateJpy",
          "value": 2000
        },
        {
          "@type": "PropertyValue",
          "name": "perSecondRateJpy",
          "value": 0.5556
        },
        {
          "@type": "PropertyValue",
          "name": "durationSeconds",
          "value": 7200
        },
        {
          "@type": "PropertyValue",
          "name": "durationHours",
          "value": 2
        },
        {
          "@type": "PropertyValue",
          "name": "activityType",
          "value": "community"
        },
        {
          "@type": "PropertyValue",
          "name": "brandingValue",
          "value": 4000,
          "unitText": "JPY"
        }
      ]
    }
  ],
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "name": "Social Capital (Branding Value)",
      "description": "個人が活動に投下した時間を、その人の時給の秒単位レートで換算したブランディング価値。活動の種類を問わず、時間投下そのものがブランド資産として蓄積される。"
    },
    {
      "@type": "DefinedTerm",
      "name": "Per-Second Rate",
      "description": "時給を3600（秒/時間）で割った値。秒単位での価値換算に使用する。"
    },
    {
      "@type": "DefinedTerm",
      "name": "Activity Duration",
      "description": "ブランディング対象の活動に費やした時間。秒単位で記録し、時間単位にも変換可能。"
    }
  ]
}
