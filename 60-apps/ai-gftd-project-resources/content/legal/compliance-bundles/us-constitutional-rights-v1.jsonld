    {
      "ruleId": "us-constitutional-rights-v1:rights-impact-review",
      "title": "U.S. Constitution rights-impact review",
      "summary": "Rights-impacting moderation, surveillance, and access-control decisions should be reviewed against the applicable constitutional or treaty baseline.",
      "rationale": "Derived from U.S. Constitution metadata in resources/contracts corpus. Full article-level parsing is not implemented yet.",
      "jurisdiction": "US",
      "sourceKind": "social-contract",
      "sourceUri": "https://www.archives.gov/founding-docs/constitution-transcript",
      "version": "2026-02-17T00:00:00Z",
      "mandatory": true,
      "riskLevel": "high",
      "appliesTo": [
        "action:moderate",
        "action:suspend",
        "action:ban",
        "action:deny",
        "action:surveil",
        "action:identify",
        "action:censor",
        "action:adjudicate",
        "action:freeze",
        "action:enforce"
      ],
      "crossBorderOnly": false,
      "obligations": [
        {
          "kind": "record-audit",
          "title": "Record compliance evidence",
          "description": "Attach audit evidence for U.S. Constitution before relying on the operation.",
          "mandatory": true
        },
        {
          "kind": "human-approval",
          "title": "Human approval required",
          "description": "A human reviewer must approve U.S. Constitution before execution.",
          "mandatory": true
        }
      ]
