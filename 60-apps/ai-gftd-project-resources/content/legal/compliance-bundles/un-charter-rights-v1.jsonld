  "dateModified": "2026-03-11T10:16:11+00:00",
  "gftd:compiledFrom": [
    {
      "name": "Charter of the United Nations",
      "url": "https://www.un.org/en/about-us/un-charter/full-text"
    }
  ],
  "rules": [
    {
      "ruleId": "un-charter-rights-v1:rights-impact-review",
      "title": "UN Charter rights-impact review",
      "summary": "Rights-impacting moderation, surveillance, and access-control decisions should be reviewed against the applicable constitutional or treaty baseline.",
      "rationale": "Derived from UN Charter metadata in resources/contracts corpus. Full article-level parsing is not implemented yet.",
      "jurisdiction": "INTERNATIONAL",
      "sourceKind": "social-contract",
      "sourceUri": "https://www.un.org/en/about-us/un-charter/full-text",
      "version": "2026-02-17T00:00:00Z",
      "mandatory": true,
      "riskLevel": "high",
      "appliesTo": [
        "action:moderate",
        "action:suspend",
        "action:ban",
        "action:deny",
        "action:surveil",
        "action:identify",
        "action:censor",
        "action:adjudicate",
        "action:freeze",
        "action:enforce"
      ],
      "crossBorderOnly": false,
      "obligations": [
        {
          "kind": "record-audit",
          "title": "Record compliance evidence",
          "description": "Attach audit evidence for UN Charter before relying on the operation.",
          "mandatory": true
        },
        {
          "kind": "human-approval",
          "title": "Human approval required",
          "description": "A human reviewer must approve UN Charter before execution.",
          "mandatory": true
        }
      ]
    }
  ]
