  "identifier": "jp-finance-v1",
  "name": "Japan financial-services baseline",
  "jurisdiction": "JP",
  "dateModified": "2026-03-11T10:16:11+00:00",
  "gftd:compiledFrom": [
    {
      "name": "金融商品取引法",
      "url": "https://laws.e-gov.go.jp/law/323AC0000000025"
    },
    {
      "name": "銀行法",
      "url": "https://laws.e-gov.go.jp/law/356AC0000000059"
    },
    {
      "name": "資金決済に関する法律",
      "url": "https://laws.e-gov.go.jp/law/421AC0000000059"
    }
  ],
  "rules": [
    {
      "ruleId": "jp-finance-regulated-operation-review",
      "title": "Financial-services operation review",
      "summary": "Payments, custody, and trading operations with Japanese nexus should be reviewed against Japanese financial-services law.",
      "rationale": "Derived from 金融商品取引法, 銀行法, 資金決済に関する法律 metadata in resources/contracts corpus. Full article-level parsing is not implemented yet.",
      "jurisdiction": "JP",
      "sourceKind": "legal-resource",
      "sourceUri": "https://laws.e-gov.go.jp/law/323AC0000000025",
      "version": "2026-02-18T08:29:11.510864+00:00",
      "mandatory": false,
      "riskLevel": "high",
      "appliesTo": [
        "action:settle",
        "action:custody",
        "action:exchange",
        "action:trade",
        "action:lend",
        "action:transfer",
        "resource:wallet",
        "resource:payment",
        "resource:security",
        "resource:deposit",
        "capability:payments",
        "capability:exchange",
        "capability:trading",
        "capability:custody",
        "capability:lending",
        "data:financial-data"
      ],
      "crossBorderOnly": false,
      "obligations": [
        {
          "kind": "record-audit",
          "title": "Record compliance evidence",
          "description": "Attach audit evidence for JP financial-services review before relying on the operation.",
          "mandatory": true
        }
      ]
    }
  ]
}
