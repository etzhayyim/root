  },
  "@type": "gftd:ComplianceRuleBundle",
  "@id": "https://resources.gftd.ai/content/legal/compliance-bundles/jp-medical-v1",
  "identifier": "jp-medical-v1",
  "name": "Japan medical-data baseline",
  "jurisdiction": "JP",
  "dateModified": "2026-03-11T10:16:11+00:00",
  "gftd:compiledFrom": [
    {
      "name": "医療法",
      "url": "https://laws.e-gov.go.jp/law/323AC0000000205"
    },
    {
      "name": "医薬品、医療機器等の品質、有効性及び安全性の確保等に関する法律",
      "url": "https://laws.e-gov.go.jp/law/335AC0000000145"
    },
    {
      "name": "医療分野の研究開発に資するための匿名加工医療情報及び仮名加工医療情報に関する法律",
      "url": "https://laws.e-gov.go.jp/law/429AC0000000028"
    }
  ],
  "rules": [
    {
      "ruleId": "jp-medical-data-disclosure-review",
      "title": "Medical-data disclosure review",
      "summary": "Disclosure or transfer of health and medical data with Japanese nexus should be reviewed against Japanese medical and health-data law.",
      "rationale": "Derived from 医療法, 医薬品、医療機器等の品質、有効性及び安全性の確保等に関する法律, 医療分野の研究開発に資するための匿名加工医療情報及び仮名加工医療情報に関する法律 metadata in resources/contracts corpus. Full article-level parsing is not implemented yet.",
      "jurisdiction": "JP",
      "sourceKind": "legal-resource",
      "sourceUri": "https://laws.e-gov.go.jp/law/323AC0000000205",
      "version": "2026-02-18T08:29:11.510864+00:00",
      "mandatory": true,
      "riskLevel": "high",
      "appliesTo": [
        "action:share",
        "action:transfer",
        "action:publish",
        "resource:patient-record",
        "resource:medical-record",
        "resource:medical-device",
        "data:health-data",
        "data:medical-data",
        "data:patient-data",
        "data:genomic-data",
        "data:biometric-data"
      ],
      "crossBorderOnly": false,
      "obligations": [
        {
          "kind": "record-audit",
          "title": "Record compliance evidence",
          "description": "Attach audit evidence for JP medical-data review before relying on the operation.",
          "mandatory": true
        },
        {
          "kind": "human-approval",
          "title": "Human approval required",
          "description": "A human reviewer must approve JP medical-data review before execution.",
          "mandatory": true
        }
      ]
    }
  ]
}
