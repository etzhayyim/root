  },
  "@type": "gftd:ComplianceBundleSourceMap",
  "@id": "https://resources.gftd.ai/content/legal/jp/compliance/jp-privacy-article-map",
  "identifier": "jp-privacy-article-map-v1",
  "bundleId": "jp-privacy-v1",
  "bundleName": "Japan privacy baseline",
  "name": "Japan privacy article map",
  "jurisdiction": "JP",
  "sourceDocuments": [
    {
      "identifier": "jp-apppi",
      "title": "個人情報の保護に関する法律",
      "sourceKind": "legal-resource",
      "sourceUri": "https://laws.e-gov.go.jp/law/415AC0000000057"
    },
    {
      "identifier": "ppc-offshore-guideline",
      "title": "個人情報の保護に関する法律についてのガイドライン（外国にある第三者への提供編）",
      "sourceKind": "guidance",
      "sourceUri": "https://www.ppc.go.jp/personalinfo/legal/guidelines_offshore/"
    },
    {
      "identifier": "ppc-third-party-guideline",
      "title": "個人情報の保護に関する法律についてのガイドライン（第三者提供時の確認・記録義務編）",
      "sourceKind": "guidance",
      "sourceUri": "https://www.ppc.go.jp/personalinfo/legal/guidelines_daisansha/"
    }
  ],
  "legalBases": [
    {
      "basisId": "jp-apppi-art-28-1",
      "title": "Foreign third-party transfer consent or exception basis",
      "citation": "APPI Art. 28(1)",
      "sourceKind": "legal-resource",
      "sourceUri": "https://laws.e-gov.go.jp/law/415AC0000000057",
      "articleRef": "Art. 28(1)",
      "note": "Providing personal data to a third party in a foreign country requires prior consent unless a statutory exception applies."
    },
    {
      "basisId": "jp-apppi-rule-17-2",
      "title": "Pre-consent foreign transfer information items",
      "citation": "APPI Enforcement Rules Art. 17(2)",
      "sourceKind": "guidance",
      "sourceUri": "https://www.ppc.go.jp/personalinfo/legal/guidelines_offshore/",
      "articleRef": "Rule 17(2)",
      "sectionRef": "5-2",
      "note": "Before obtaining consent, disclose the destination country name, the destination country's personal-information protection system, and recipient safeguards."
    },
    {
      "basisId": "jp-apppi-art-28-3",
      "title": "Equivalent measures and periodic confirmation",
      "citation": "APPI Art. 28(3)",
      "sourceKind": "legal-resource",
      "sourceUri": "https://laws.e-gov.go.jp/law/415AC0000000057",
      "articleRef": "Art. 28(3)",
      "note": "When relying on equivalent measures, periodically confirm their implementation and provide information to the data subject."
    },
    {
      "basisId": "jp-apppi-rule-18-1",
      "title": "Equivalent-measures information items",
      "citation": "APPI Enforcement Rules Art. 18(1)",
      "sourceKind": "guidance",
      "sourceUri": "https://www.ppc.go.jp/personalinfo/legal/guidelines_offshore/",
      "articleRef": "Rule 18(1)",
      "sectionRef": "6",
      "note": "The guidance specifies the information items to confirm and disclose regarding equivalent measures taken by the foreign recipient."
    },
    {
      "basisId": "jp-apppi-art-29-1",
      "title": "Record of third-party provision",
      "citation": "APPI Art. 29(1)",
      "sourceKind": "legal-resource",
      "sourceUri": "https://laws.e-gov.go.jp/law/415AC0000000057",
      "articleRef": "Art. 29(1)",
      "note": "The provider must create a record when personal data is provided to a third party."
    },
    {
      "basisId": "jp-apppi-art-30-3",
      "title": "Record of third-party receipt",
      "citation": "APPI Art. 30(3)",
      "sourceKind": "legal-resource",
      "sourceUri": "https://laws.e-gov.go.jp/law/415AC0000000057",
      "articleRef": "Art. 30(3)",
      "note": "The recipient must create a confirmation record for third-party receipt."
    },
    {
      "basisId": "jp-ppc-offshore-5-2",
      "title": "PPC guidance on information before consent",
      "citation": "PPC Offshore Transfer Guideline 5-2",
      "sourceKind": "guidance",
      "sourceUri": "https://www.ppc.go.jp/personalinfo/legal/guidelines_offshore/",
      "sectionRef": "5-2",
      "note": "Explains the information to present before obtaining consent for foreign transfer."
    },
    {
      "basisId": "jp-ppc-offshore-6",
      "title": "PPC guidance on equivalent measures monitoring",
      "citation": "PPC Offshore Transfer Guideline 6",
      "sourceKind": "guidance",
      "sourceUri": "https://www.ppc.go.jp/personalinfo/legal/guidelines_offshore/",
      "sectionRef": "6",
      "note": "Explains periodic confirmation of equivalent measures and information disclosure."
    },
    {
      "basisId": "jp-ppc-daisansha-3-4-2",
      "title": "PPC guidance on third-party transfer records",
      "citation": "PPC Third-Party Provision Guideline 3-4-2",
      "sourceKind": "guidance",
      "sourceUri": "https://www.ppc.go.jp/personalinfo/legal/guidelines_daisansha/",
      "sectionRef": "3-4-2",
      "note": "Explains record items, creation method, and retention for APPI Arts. 29 and 30."
    }
  ],
  "rules": [
    {
      "ruleId": "jp-apppi-cross-border-transfer-review",
      "title": "Cross-border personal-data transfer review",
      "summary": "Cross-border transfers of personal data with Japanese nexus require transfer-basis review, destination-country disclosures, and equivalent-measures diligence under APPI.",
      "rationale": "Structured from APPI Arts. 28-30 and PPC offshore/third-party guidance for foreign third-party transfers and transfer records.",
      "jurisdiction": "JP",
      "sourceKind": "legal-resource",
      "sourceUri": "https://laws.e-gov.go.jp/law/415AC0000000057",
      "mandatory": true,
      "riskLevel": "high",
      "appliesTo": [
        "action:share",
        "action:transfer",
        "action:export",
        "data:personal-data",
        "data:employee-data",
        "data:customer-data",
        "data:financial-data",
        "data:health-data",
        "data:biometric-data"
      ],
      "crossBorderOnly": true,
      "legalBasisIds": [
        "jp-apppi-art-28-1",
        "jp-apppi-rule-17-2",
        "jp-apppi-art-28-3",
        "jp-apppi-rule-18-1",
        "jp-apppi-art-29-1",
        "jp-apppi-art-30-3",
        "jp-ppc-offshore-5-2",
        "jp-ppc-offshore-6",
        "jp-ppc-daisansha-3-4-2"
      ],
      "obligations": [
        {
          "kind": "consent",
          "title": "Confirm foreign transfer basis",
          "description": "Confirm a valid APPI basis for foreign third-party provision, including prior consent or a statutory exception, before transferring personal data overseas.",
          "mandatory": true,
          "sourceBasisIds": [
            "jp-apppi-art-28-1"
          ]
        },
        {
          "kind": "disclose",
          "title": "Disclose destination-country and safeguard information",
          "description": "Before relying on consent, disclose the destination country name, information about that country's personal-information protection system, and the recipient's safeguards.",
          "mandatory": true,
          "sourceBasisIds": [
            "jp-apppi-rule-17-2",
            "jp-ppc-offshore-5-2"
          ]
        },
        {
          "kind": "retain",
          "title": "Retain transfer due-diligence and recordkeeping evidence",
          "description": "Create and retain records covering the transfer basis, information provided to the data subject, and periodic confirmation of the foreign recipient's equivalent measures.",
          "mandatory": true,
          "sourceBasisIds": [
            "jp-apppi-art-28-3",
            "jp-apppi-rule-18-1",
            "jp-apppi-art-29-1",
            "jp-apppi-art-30-3",
            "jp-ppc-offshore-6",
            "jp-ppc-daisansha-3-4-2"
          ]
        },
        {
          "kind": "record-audit",
          "title": "Record compliance evidence",
          "description": "Attach evidence of the transfer basis, destination-country disclosures, equivalent-measures diligence, and transfer records before relying on the operation.",
          "mandatory": true,
          "sourceBasisIds": [
            "jp-apppi-art-28-1",
            "jp-apppi-rule-17-2",
            "jp-apppi-art-28-3",
            "jp-apppi-rule-18-1",
            "jp-apppi-art-29-1",
            "jp-apppi-art-30-3",
            "jp-ppc-offshore-5-2",
            "jp-ppc-offshore-6",
            "jp-ppc-daisansha-3-4-2"
          ]
        },
        {
          "kind": "human-approval",
          "title": "Human approval required",
          "description": "A human reviewer must approve the foreign transfer after verifying the APPI transfer basis, required disclosures, and recordkeeping evidence.",
          "mandatory": true,
          "sourceBasisIds": [
            "jp-apppi-art-28-1",
            "jp-apppi-rule-17-2",
            "jp-apppi-art-28-3",
            "jp-apppi-rule-18-1",
            "jp-ppc-offshore-5-2",
            "jp-ppc-offshore-6"
          ]
        }
      ]
    }
  ]
}
