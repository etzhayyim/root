{
  "@context": [
    "https://schema.org/",
    {
      "gftd": "https://gftd.ai/schemas/",
      "capabilities": "gftd:capabilities",
      "survivalIndicators": "gftd:survivalIndicators",
      "scheduler": "gftd:scheduler",
      "milestones": "gftd:milestones",
      "blockers": "gftd:blockers",
      "dependsOn": {
        "@id": "gftd:dependsOn",
        "@type": "@id"
      },
      "ingestKey": "gftd:ingestKey",
      "window": "gftd:window",
      "valueUpdatedAt": "gftd:valueUpdatedAt"
    }
  ],
  "@type": "Project",
  "identifier": "ai-gftd-project-entities",
  "name": "ai gftd project entities",
  "status": "In Progress",
  "description": "Supply chain entity graph: material sources (iron, petroleum, fiber, food), associated entities (companies, persons, families), intermediate production (manufacturing, processing, logistics hubs), and logistics assets (vehicles, vessels, railways, containers). All modeled as SpinApp components with WIT import/export dependencies for wRPC mesh communication.",
  "capabilities": {
    "@type": "DefinedTermSet",
    "name": "Capabilities",
    "description": "Summary of the capabilities this project is responsible for (CV-1).",
    "terms": [
      {
        "@type": "DefinedTerm",
        "name": "Material Source Registry",
        "description": "Register and track global material extraction sites (iron mines, oil fields, fiber farms, food production) with geospatial coordinates for maps.gftd.ai integration."
      },
      {
        "@type": "DefinedTerm",
        "name": "Supply Chain Entity Graph",
        "description": "Model relationships between companies, persons, and families involved in supply chains. Track ownership, control, and industry affiliations."
      },
      {
        "@type": "DefinedTerm",
        "name": "Intermediate Production Tracking",
        "description": "Track manufacturing plants, processing/refining facilities, and logistics hubs with input/output material flows."
      },
      {
        "@type": "DefinedTerm",
        "name": "Logistics Asset Management",
        "description": "Track vehicles, vessels, railways, and containers with real-time position data and intermodal transfer capabilities."
      },
      {
        "@type": "DefinedTerm",
        "name": "Supply Chain Orchestration",
        "description": "End-to-end material tracing from source to consumer via wRPC mesh connecting all supply chain entity components."
      }
    ]
  },
  "survivalIndicators": [
    {
      "@type": "PropertyValue",
      "identifier": "requests",
      "name": "Requests",
      "description": "Request count (traffic) as a basic survival indicator.",
      "unitText": "count",
      "value": null,
      "ingestKey": "requests",
      "window": "1d",
      "valueUpdatedAt": null
    },
    {
      "@type": "PropertyValue",
      "identifier": "gccCredit",
      "name": "GCC Credit",
      "description": "GCC credit balance (or net credit change) as a basic survival indicator.",
      "unitText": "GCC",
      "value": null,
      "ingestKey": "gccCredit",
      "window": "1d",
      "valueUpdatedAt": null
    }
  ],
  "scheduler": "scheduler.jsonld",
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "scheduler.jsonld",
        "content": {
          "@context": [
            "https://schema.org/",
            {
              "gftd": "https://gftd.ai/schemas/",
              "capabilities": "gftd:capabilities",
              "survivalIndicators": "gftd:survivalIndicators",
              "scheduler": "gftd:scheduler",
              "milestones": "gftd:milestones",
              "blockers": "gftd:blockers",
              "dependsOn": {
                "@id": "gftd:dependsOn",
                "@type": "@id"
              },
              "ingestKey": "gftd:ingestKey",
              "window": "gftd:window",
              "valueUpdatedAt": "gftd:valueUpdatedAt"
            }
          ],
          "@type": "CreativeWork",
          "name": "ai gftd project entities Scheduler",
          "identifier": "ai-gftd-project-entities/scheduler",
          "description": "Project schedule (milestones) and blockers.",
          "dateCreated": "2026-02-15T04:25:26+00:00",
          "milestones": [
            {
              "@type": "CreativeWork",
              "name": "Supply chain WIT interfaces and SHACL shapes",
              "description": "Define gftd:supply-chain WIT package with 16 interfaces covering material sources, entities, production, and logistics. SHACL validation shapes for all entity types.",
              "status": "Done",
              "dueDate": "2026-02-28"
            },
            {
              "@type": "CreativeWork",
              "name": "Material source entity components (iron, petroleum, fiber, food)",
              "description": "4 wasm components with crawler integration for collecting material source locations globally, plus maps.gftd.ai GeoJSON visualization.",
              "status": "Done",
              "dueDate": "2026-02-28"
            },
            {
              "@type": "CreativeWork",
              "name": "Associated entity components (company, person, family)",
              "description": "3 wasm components for companies, key persons, and families/dynasties in global supply chains.",
              "status": "Done",
              "dueDate": "2026-02-28"
            },
            {
              "@type": "CreativeWork",
              "name": "Production and logistics components",
              "description": "7 wasm components for manufacturing plants, processing plants, logistics hubs, vehicles, vessels, railways, and containers.",
              "status": "Done",
              "dueDate": "2026-02-28"
            },
            {
              "@type": "CreativeWork",
              "name": "Crawler data collection from public sources",
              "description": "Configure crawlers to collect data from USGS, OPEC, EIA, FAO, IMO, AIS, UN/LOCODE, and other public supply chain databases.",
              "status": "Planned",
              "dueDate": "2026-03-15"
            }
          ],
          "blockers": []
        }
      }
    ]
  }
}
