{
  "@context": {
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "sh": "http://www.w3.org/ns/shacl#",
    "prov": "http://www.w3.org/ns/prov#",
    "schema": "https://schema.org/",
    "gftd": "https://resources.gftd.ai/ontology#"
  },
  "@graph": [
    {
      "@id": "gftd:ComprehendObservationShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "gftd:Observation",
      "sh:property": [
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "gftd:DomainObservationShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "gftd:DomainObservation",
      "sh:property": [
        {
          "sh:path": "gftd:domain",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "gftd:source",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "gftd:IPObservationShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "gftd:IPObservation",
      "sh:property": [
        {
          "sh:path": "gftd:ip",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "gftd:source",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "gftd:CrawlRequestShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "gftd:CrawlRequest",
      "sh:property": [
        {
          "sh:path": "schema:url",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "gftd:maxDepth",
          "sh:datatype": "xsd:integer",
          "sh:minCount": 0
        }
      ]
    }
  ]
}
