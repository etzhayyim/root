{
  "@context": {
    "@version": 1.1,
    "schema": "https://schema.org/",
    "prov": "http://www.w3.org/ns/prov#",
    "gftd": "https://resources.gftd.ai/ontology#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "id": "@id",
    "type": "@type",
    "identifier": "schema:identifier",
    "url": {
      "@id": "schema:url",
      "@type": "@id"
    },
    "name": "schema:name",
    "actionStatus": "schema:actionStatus",
    "startTime": {
      "@id": "schema:startTime",
      "@type": "xsd:dateTime"
    },
    "contentSize": {
      "@id": "schema:contentSize",
      "@type": "xsd:integer"
    },
    "hasPart": {
      "@id": "schema:hasPart",
      "@type": "@id"
    },
    "isPartOf": {
      "@id": "schema:isPartOf",
      "@type": "@id"
    },
    "generatedAtTime": {
      "@id": "prov:generatedAtTime",
      "@type": "xsd:dateTime"
    },
    "wasGeneratedBy": {
      "@id": "prov:wasGeneratedBy",
      "@type": "@id"
    },
    "depth": {
      "@id": "gftd:depth",
      "@type": "xsd:integer"
    },
    "maxPages": {
      "@id": "gftd:maxPages",
      "@type": "xsd:integer"
    },
    "pagesFound": {
      "@id": "gftd:pagesFound",
      "@type": "xsd:integer"
    },
    "jobId": "gftd:jobId",
    "httpStatus": {
      "@id": "gftd:httpStatus",
      "@type": "xsd:integer"
    },
    "linkCount": {
      "@id": "gftd:linkCount",
      "@type": "xsd:integer"
    },
    "pageCount": {
      "@id": "gftd:pageCount",
      "@type": "xsd:integer"
    },
    "lastCrawledAt": {
      "@id": "gftd:lastCrawledAt",
      "@type": "xsd:dateTime"
    },
    "userAgent": "gftd:userAgent",
    "headers": "gftd:headers"
  }
}
