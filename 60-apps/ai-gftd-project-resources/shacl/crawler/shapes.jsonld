{
  "@context": {
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "sh": "http://www.w3.org/ns/shacl#",
    "prov": "http://www.w3.org/ns/prov#",
    "schema": "https://schema.org/",
    "gftd": "https://resources.gftd.ai/ontology#"
  },
  "@graph": [
    {
      "@id": "gftd:CrawlJobShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "gftd:CrawlJob",
      "rdfs:comment": "Validates a web crawl job record produced by crawler.gftd.ai.",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:url",
          "sh:datatype": "xsd:anyURI",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:actionStatus",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:in": {
            "@list": [
              "running",
              "completed",
              "failed"
            ]
          }
        },
        {
          "sh:path": "gftd:depth",
          "sh:datatype": "xsd:integer",
          "sh:minCount": 1
        },
        {
          "sh:path": "gftd:maxPages",
          "sh:datatype": "xsd:integer",
          "sh:minCount": 1
        },
        {
          "sh:path": "gftd:pagesFound",
          "sh:datatype": "xsd:integer",
          "sh:minCount": 0
        },
        {
          "sh:path": "schema:startTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "gftd:CrawlPageShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "gftd:CrawlPage",
      "rdfs:comment": "Validates a crawled web page record. Each page is one HTTP response captured by the crawler.",
      "sh:property": [
        {
          "sh:path": "schema:identifier",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:url",
          "sh:datatype": "xsd:anyURI",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "gftd:jobId",
          "sh:datatype": "xsd:string",
          "sh:minCount": 1
        },
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 0
        },
        {
          "sh:path": "gftd:httpStatus",
          "sh:datatype": "xsd:integer",
          "sh:minCount": 1
        },
        {
          "sh:path": "schema:contentSize",
          "sh:datatype": "xsd:integer",
          "sh:minCount": 0
        },
        {
          "sh:path": "gftd:linkCount",
          "sh:datatype": "xsd:integer",
          "sh:minCount": 0
        },
        {
          "sh:path": "prov:generatedAtTime",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        }
      ]
    },
    {
      "@id": "gftd:CrawlSiteShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": "schema:WebSite",
      "rdfs:comment": "Aggregated site-level summary produced after a crawl job completes.",
      "sh:property": [
        {
          "sh:path": "schema:url",
          "sh:datatype": "xsd:anyURI",
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": "schema:name",
          "sh:datatype": "xsd:string",
          "sh:minCount": 0
        },
        {
          "sh:path": "gftd:pageCount",
          "sh:datatype": "xsd:integer",
          "sh:minCount": 1
        },
        {
          "sh:path": "gftd:lastCrawledAt",
          "sh:datatype": "xsd:dateTime",
          "sh:minCount": 1
        },
        {
          "sh:path": "schema:hasPart",
          "sh:class": "gftd:CrawlPage",
          "sh:minCount": 0
        }
      ]
    }
  ]
}
