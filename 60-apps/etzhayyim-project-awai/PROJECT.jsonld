{
  "@context": {
    "etzhayyim": "https://resources.etzhayyim.com/etzhayyim-project-resources/id/",
    "schema": "https://schema.org/",
    "dodaf": "https://resources.etzhayyim.com/etzhayyim-project-resources/id/DM2/"
  },
  "@type": "etzhayyim:Project",
  "@id": "https://resources.etzhayyim.com/etzhayyim-project-awai/id/Project/etzhayyim-project-awai",
  "schema:name": "etzhayyim-project-awai",
  "schema:description": "Earth-scale 3D Gaussian Splatting viewer. Converts WebP images into 3DGS point clouds via SfM + 3DGS training pipeline, stores splat data in natad/LanceDB, and renders an interactive globe-scale 3D scene using Threlte (Three.js + Svelte). Published at awai.etzhayyim.com.",
  "schema:url": "https://awai.etzhayyim.com",
  "dodaf:capability": [
    {
      "@type": "dodaf:Capability",
      "schema:name": "WebP to Gaussian Splat Conversion",
      "schema:description": "Upload WebP images and run SfM feature extraction + 3D Gaussian Splatting training to produce PLY/splat/ksplat point cloud outputs."
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Splat Storage (natad/LanceDB)",
      "schema:description": "Store splat metadata and binary splat data (PLY/splat/ksplat) in natad/LanceDB for durable, query-ready access."
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Earth-Scale 3D Rendering (Threlte)",
      "schema:description": "Interactive globe-scale 3D scene rendering using Threlte (Three.js + Svelte). Place Gaussian Splats at WGS84 geo-coordinates with orientation and scale controls."
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "CDN Delivery (R2)",
      "schema:description": "Serve static Svelte frontend and public splat assets via Cloudflare R2 Custom Domain at awai.etzhayyim.com."
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Geo-Spatial Placement Management",
      "schema:description": "Place, update, and query Gaussian Splats on the earth-scale scene using WGS84 coordinates, quaternion orientation, and bounding-box spatial queries."
    }
  ],
  "dodaf:performer": [
    {
      "@type": "dodaf:Performer",
      "schema:name": "awai-component",
      "schema:description": "SpinApp backend component (port 21090). Handles 3DGS pipeline orchestration, splat CRUD, placement management. Exports etzhayyim:gaussian-splat interface via wRPC."
    },
    {
      "@type": "dodaf:Performer",
      "schema:name": "awai-frontend",
      "schema:description": "Svelte + Threlte frontend at awai.etzhayyim.com (R2 Custom Domain). Globe-scale 3D viewer with Gaussian Splat rendering, upload UI, and placement controls."
    }
  ]
}
