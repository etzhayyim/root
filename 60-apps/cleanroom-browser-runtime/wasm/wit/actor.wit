package etzhayyim:cleanroom@0.1.0;

// Minimal clean-room actor interface: JSON-in / JSON-out over a content-
// addressed kotoba-WASM component. No imports → no host capabilities
// (no network, no clock, no fs) — pure browser-local execution.
world actor {
    export handle-request: func(method: string, path: string, query: string, body: string) -> string;
    export list-tools: func() -> string;
    export call-tool: func(name: string, args: string) -> string;
    export healthz: func() -> string;
}
