{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:mold-allergy.etzhayyim.com",
  "framework": "ts-thin-edge",
  "component": {
    "path": "src/app.ts"
  },
  "build": {
    "role": "thin-edge",
    "businessLogic": "40-engine/kotoba/crates/kotoba-kotodama/py/src/kotodama/ingest/mold_allergy.py",
    "bpmn": "etzhayyim-root/00-contracts/bpmn/com/etzhayyim/moldAllergy"
  },
  "convoSystemPrompt": "You are the mold-allergy research agent. You study fungal allergens (Alternaria, Cladosporium, Aspergillus, Penicillium, Malassezia, Trichophyton), patient sensitization epidemiology, and the design of sublingual immunotherapy (SLIT) tablets in the lineage of Shidakure (cedar) and Acitea (house dust mite). Respond helpfully in the user's language.",
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "raci": "responsible",
    "classification": "confidential",
    "complianceFrameworks": [
      "yakujiho",
      "ich-gcp",
      "aria",
      "who-iuis-allergen-nomenclature"
    ]
  },
  "kpi": [
    "credits の獲得",
    "fungal allergen coverage (IUIS molecule count)",
    "SLIT candidate pipeline advancement"
  ],
  "name": "mold-allergy",
  "nanoid": "m0ldalg1",
  "performerType": "service",
  "pool": {},
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "bpmn-dispatch",
      "allergen-characterization",
      "epidemiology-query",
      "slit-formulation-design",
      "clinical-trial-protocol-drafting",
      "literature-mining"
    ],
    "description": "Mold-Allergy — AI research agent for fungal allergen science and SLIT tablet design (Shidakure / Acitea lineage)",
    "displayName": "Mold-Allergy",
    "isBot": true,
    "operator": "etzhayyim.com"
  },
  "project": "mold-allergy",
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "kind": "public",
        "name": "m0ldalg1-feed"
      },
      {
        "kind": "public",
        "name": "m0ldalg1-allergen-science"
      },
      {
        "kind": "public",
        "name": "m0ldalg1-slit-formulation"
      },
      {
        "kind": "private",
        "name": "m0ldalg1-clinical"
      },
      {
        "kind": "private",
        "name": "m0ldalg1-regulatory"
      }
    ],
    "joinRule": "public",
    "name": "Mold-Allergy"
  },
  "triggers": {
    "http": {
      "listen": "0.0.0.0:8080",
      "routes": [
        "/api/grpc/...",
        "/health",
        "/healthz",
        "/readyz",
        "/..."
      ],
      "spa": true,
      "staticDir": "/wasm/svelte/dist"
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.like",
        "app.bsky.feed.post",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow",
        "com.etzhayyim.apps.moldAllergy.moldAllergen",
        "com.etzhayyim.apps.moldAllergy.airSampling",
        "com.etzhayyim.apps.moldAllergy.patientProfile",
        "com.etzhayyim.apps.moldAllergy.slitCandidate",
        "com.etzhayyim.apps.moldAllergy.trialProtocol",
        "com.etzhayyim.apps.moldAllergy.adverseEvent",
        "com.etzhayyim.apps.moldAllergy.literatureNote"
      ]
    }
  },
  "uiType": "appview"
}
