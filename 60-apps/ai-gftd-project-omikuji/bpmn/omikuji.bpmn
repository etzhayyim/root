<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- drawFortune -->
  <bpmn:process id="omikuji-draw-fortune" name="Omikuji Draw Fortune" isExecutable="true">
    <bpmn:startEvent id="start-draw-fortune"/>
    <bpmn:sequenceFlow id="sf-df-1" sourceRef="start-draw-fortune" targetRef="task-draw-fortune"/>
    <bpmn:serviceTask id="task-draw-fortune" name="Draw Fortune">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.omikuji.drawFortune"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-df-2" sourceRef="task-draw-fortune" targetRef="end-draw-fortune"/>
    <bpmn:endEvent id="end-draw-fortune"/>
  </bpmn:process>

  <!-- listFortunes -->
  <bpmn:process id="omikuji-list-fortunes" name="Omikuji List Fortunes" isExecutable="true">
    <bpmn:startEvent id="start-list-fortunes"/>
    <bpmn:sequenceFlow id="sf-lf-1" sourceRef="start-list-fortunes" targetRef="task-list-fortunes"/>
    <bpmn:serviceTask id="task-list-fortunes" name="List Fortunes">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.omikuji.listFortunes"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lf-2" sourceRef="task-list-fortunes" targetRef="end-list-fortunes"/>
    <bpmn:endEvent id="end-list-fortunes"/>
  </bpmn:process>

  <!-- getFortune -->
  <bpmn:process id="omikuji-get-fortune" name="Omikuji Get Fortune" isExecutable="true">
    <bpmn:startEvent id="start-get-fortune"/>
    <bpmn:sequenceFlow id="sf-gf-1" sourceRef="start-get-fortune" targetRef="task-get-fortune"/>
    <bpmn:serviceTask id="task-get-fortune" name="Get Fortune">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.omikuji.getFortune"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gf-2" sourceRef="task-get-fortune" targetRef="end-get-fortune"/>
    <bpmn:endEvent id="end-get-fortune"/>
  </bpmn:process>

  <!-- resetFortune -->
  <bpmn:process id="omikuji-reset-fortune" name="Omikuji Reset Fortune" isExecutable="true">
    <bpmn:startEvent id="start-reset-fortune"/>
    <bpmn:sequenceFlow id="sf-rf-1" sourceRef="start-reset-fortune" targetRef="task-reset-fortune"/>
    <bpmn:serviceTask id="task-reset-fortune" name="Reset Fortune">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.omikuji.resetFortune"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-rf-2" sourceRef="task-reset-fortune" targetRef="end-reset-fortune"/>
    <bpmn:endEvent id="end-reset-fortune"/>
  </bpmn:process>

  <!-- createShrine -->
  <bpmn:process id="omikuji-create-shrine" name="Omikuji Create Shrine" isExecutable="true">
    <bpmn:startEvent id="start-create-shrine"/>
    <bpmn:sequenceFlow id="sf-cs-1" sourceRef="start-create-shrine" targetRef="task-create-shrine"/>
    <bpmn:serviceTask id="task-create-shrine" name="Create Shrine">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.omikuji.createShrine"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-cs-2" sourceRef="task-create-shrine" targetRef="end-create-shrine"/>
    <bpmn:endEvent id="end-create-shrine"/>
  </bpmn:process>

  <!-- updateShrine -->
  <bpmn:process id="omikuji-update-shrine" name="Omikuji Update Shrine" isExecutable="true">
    <bpmn:startEvent id="start-update-shrine"/>
    <bpmn:sequenceFlow id="sf-us-1" sourceRef="start-update-shrine" targetRef="task-update-shrine"/>
    <bpmn:serviceTask id="task-update-shrine" name="Update Shrine">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.omikuji.updateShrine"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-us-2" sourceRef="task-update-shrine" targetRef="end-update-shrine"/>
    <bpmn:endEvent id="end-update-shrine"/>
  </bpmn:process>

  <!-- listShrines -->
  <bpmn:process id="omikuji-list-shrines" name="Omikuji List Shrines" isExecutable="true">
    <bpmn:startEvent id="start-list-shrines"/>
    <bpmn:sequenceFlow id="sf-ls-1" sourceRef="start-list-shrines" targetRef="task-list-shrines"/>
    <bpmn:serviceTask id="task-list-shrines" name="List Shrines">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.omikuji.listShrines"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-ls-2" sourceRef="task-list-shrines" targetRef="end-list-shrines"/>
    <bpmn:endEvent id="end-list-shrines"/>
  </bpmn:process>

  <!-- getShrine -->
  <bpmn:process id="omikuji-get-shrine" name="Omikuji Get Shrine" isExecutable="true">
    <bpmn:startEvent id="start-get-shrine"/>
    <bpmn:sequenceFlow id="sf-gs-1" sourceRef="start-get-shrine" targetRef="task-get-shrine"/>
    <bpmn:serviceTask id="task-get-shrine" name="Get Shrine">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.omikuji.getShrine"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gs-2" sourceRef="task-get-shrine" targetRef="end-get-shrine"/>
    <bpmn:endEvent id="end-get-shrine"/>
  </bpmn:process>

</bpmn:definitions>
