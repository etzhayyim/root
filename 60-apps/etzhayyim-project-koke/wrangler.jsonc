{
  "name": "kotodama-k0k3m001",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"signal-fixation\",\"carbon-release\",\"hakkou-handoff\"]",
    "APP_DESCRIPTION": "koke (苔) — bryophyta primary fixation layer. Reversibly captures raw external signals and classifies them before handoff to the hakkou fermentation pipeline.",
    "APP_DISPLAY_NAME": "Koke Bryophyta Fixation",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "k0k3m001",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "k0k3m001.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "koke.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
