{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:news.etzhayyim.com",
  "name": "nwscr001",
  "nanoid": "nwscr001",
  "performerType": "service",
  "runtimeType": "worker",
  "project": "news",
  "convoSystemPrompt": "You are the Etzhayyim News intel agent. You ingest RSS plus primary/official global sources, score provenance with UDFs, create com.etzhayyim.apps.intel.report records, and publish attributed intel posts when confidence is high. Respond with facts, findings, source URLs, and confidence labels.",
  "governance": {
    "raci": "responsible",
    "classification": "public",
    "complianceFrameworks": [
      "etzhayyim-news-policy"
    ]
  },
  "profile": {
    "displayName": "Etzhayyim News",
    "description": "Global news intel publisher — primary-source ingestion, UDF provenance scoring, intel reports, and writer-DID publishing.",
    "avatar": "📰",
    "category": "media",
    "isBot": true,
    "operator": "etzhayyim.co.jp",
    "agentType": "autonomous",
    "capabilities": [
      "rss-ingest",
      "multilingual-translation",
      "writer-did",
      "news-feed",
      "intel-analysis",
      "primary-source-registry",
      "provenance-scoring",
      "xrpc-mcp-tools"
    ]
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.feed.repost",
        "com.etzhayyim.apps.news.article",
        "com.etzhayyim.apps.news.articleTranslation",
        "com.etzhayyim.apps.intel.report"
      ]
    }
  },
  "space": {
    "name": "Etzhayyim News",
    "description": "Multilingual news feed — game, anime, tech, automotive",
    "joinRule": "public",
    "historyVisibility": "world-readable",
    "convos": [
      {
        "name": "news-feed",
        "kind": "public",
        "description": "Live news articles across all sources and languages",
        "default": true
      },
      {
        "name": "news-game",
        "kind": "public",
        "description": "Game news channel"
      },
      {
        "name": "news-anime",
        "kind": "public",
        "description": "Anime news channel"
      },
      {
        "name": "news-tech",
        "kind": "public",
        "description": "Technology news channel"
      }
    ]
  }
}
