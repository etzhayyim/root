{
  "@context": [
    "https://schema.org/",
    {
      "etzhayyim": "https://etzhayyim.com/schemas/",
      "capabilities": "etzhayyim:capabilities",
      "survivalIndicators": "etzhayyim:survivalIndicators",
      "scheduler": "etzhayyim:scheduler",
      "milestones": "etzhayyim:milestones",
      "blockers": "etzhayyim:blockers",
      "coverageAudit": "etzhayyim:coverageAudit",
      "impact": "etzhayyim:impact",
      "dependsOn": {
        "@id": "etzhayyim:dependsOn",
        "@type": "@id"
      },
      "ingestKey": "etzhayyim:ingestKey",
      "window": "etzhayyim:window",
      "valueUpdatedAt": "etzhayyim:valueUpdatedAt"
    }
  ],
  "@type": "Project",
  "name": "Autonomous News Media (news.etzhayyim.com)",
  "status": "Active",
  "identifier": "etzhayyim-project-news",
  "description": "News media project for traffic acquisition and monetization via ads (ExoClick), focused on Japan game manufacturers, PS5/Switch coverage, and reusable title-specific news workflows.",
  "targetMakers": [
    "任天堂",
    "ソニー・インタラクティブエンタテインメント",
    "カプコン",
    "スクウェア・エニックス",
    "セガ",
    "バンダイナムコエンターテインメント",
    "コナミ",
    "コーエーテクモゲームス",
    "フロム・ソフトウェア",
    "コーエーテクモ",
    "アトラス",
    "レベルファイブ",
    "サイゲームス",
    "SQUARE ENIX",
    "NINTENDO"
  ],
  "targetPlatforms": [
    "PS5",
    "Switch",
    "Switch 2",
    "PlayStation Portal",
    "PlayStation App"
  ],
  "monetization": {
    "@type": "CreativeWork",
    "name": "ExoClick Ads",
    "description": "Primary ads revenue channel for this project."
  },
  "targetRevenue": {
    "@type": "MonetaryAmount",
    "currency": "JPY",
    "value": "1000000",
    "unit": "month"
  },
  "growthPlan": [
    {
      "@type": "HowTo",
      "name": "Reach 1,000,000 JPY/month ads revenue while expanding game vertical coverage",
      "step": [
        "Instrument requests + revenue + GCC credit (daily).",
        "Increase publishing cadence for Japanese game manufacturers (PS5/Switch-first templates).",
        "Stabilize content supply through title/platform-specific taxonomies and source dedupe.",
        "Strengthen SEO and topical authority pages (publisher pages, platform hubs).",
        "Ad layout optimization (placement, viewability, A/B test).",
        "Traffic acquisition loops (distribution, cross-post, referrals)."
      ]
    }
  ],
  "capabilities": {
    "@type": "DefinedTermSet",
    "name": "Capabilities",
    "description": "Summary of the capabilities this project is responsible for (CV-1).",
    "terms": [
      {
        "@type": "DefinedTerm",
        "identifier": "cap:news:content_pipeline",
        "name": "Content Pipeline",
        "description": "Ingest, generate, and publish news content at a stable cadence."
      },
      {
        "@type": "DefinedTerm",
        "identifier": "cap:news:seo_growth",
        "name": "SEO Growth",
        "description": "Indexation, internal linking, and Core Web Vitals improvements to grow organic traffic."
      },
      {
        "@type": "DefinedTerm",
        "identifier": "cap:news:game_vertical",
        "name": "Game Vertical Coverage",
        "description": "Maintain sustained coverage of Japanese game manufacturers and platform-specific news (PS5/Switch)."
      },
      {
        "@type": "DefinedTerm",
        "identifier": "cap:news:platform_intelligence",
        "name": "Platform Intelligence",
        "description": "Track PS5 and Switch specific launch/support/news timing signals and release cycles."
      },
      {
        "@type": "DefinedTerm",
        "identifier": "cap:news:ad_monetization",
        "name": "Ad Monetization",
        "description": "Optimize ad placement and layout to maximize ExoClick revenue while preserving UX."
      },
      {
        "@type": "DefinedTerm",
        "identifier": "cap:news:observability",
        "name": "Observability",
        "description": "Track requests, ad revenue, and GCC credit to steer execution."
      }
    ]
  },
  "survivalIndicators": [
    {
      "@type": "PropertyValue",
      "identifier": "requests",
      "name": "Requests",
      "description": "Request count (traffic) as a basic survival indicator.",
      "unitText": "count",
      "value": null,
      "ingestKey": "requests",
      "window": "1d",
      "valueUpdatedAt": null
    },
    {
      "@type": "PropertyValue",
      "identifier": "gccCredit",
      "name": "GCC Credit",
      "description": "GCC credit balance (or net credit change) as a basic survival indicator.",
      "unitText": "GCC",
      "value": null,
      "ingestKey": "gccCredit",
      "window": "1d",
      "valueUpdatedAt": null
    },
    {
      "@type": "PropertyValue",
      "identifier": "adsRevenueJPYDaily",
      "name": "Ads Revenue (Daily)",
      "description": "ExoClick ads revenue per day.",
      "unitText": "JPY",
      "value": null,
      "ingestKey": "adsRevenueJPYDaily",
      "window": "1d",
      "valueUpdatedAt": null
    },
    {
      "@type": "PropertyValue",
      "identifier": "adsRevenueJPYMonthly",
      "name": "Ads Revenue (Monthly)",
      "description": "ExoClick ads revenue per month.",
      "unitText": "JPY",
      "value": null,
      "ingestKey": "adsRevenueJPYMonthly",
      "window": "1mo",
      "valueUpdatedAt": null
    },
    {
      "@type": "PropertyValue",
      "identifier": "gameManufacturerCoverage",
      "name": "Game Manufacturer Coverage",
      "description": "Count of active Japanese game manufacturers with at least one validated item per day.",
      "unitText": "makers/day",
      "value": null,
      "ingestKey": "gameManufacturerCoverage",
      "window": "1d",
      "valueUpdatedAt": null
    },
    {
      "@type": "PropertyValue",
      "identifier": "ps5SwitchArticleShare",
      "name": "PS5/Switch Article Share",
      "description": "Share of daily published game articles that include PS5 and/or Switch.",
      "unitText": "percent",
      "value": null,
      "ingestKey": "ps5SwitchArticleShare",
      "window": "1d",
      "valueUpdatedAt": null
    },
    {
      "@type": "PropertyValue",
      "identifier": "ps5ArticleShare",
      "name": "PS5 Article Share",
      "description": "Share of daily published game articles that include PS5.",
      "unitText": "percent",
      "value": null,
      "ingestKey": "ps5ArticleShare",
      "window": "1d",
      "valueUpdatedAt": null
    },
    {
      "@type": "PropertyValue",
      "identifier": "switchArticleShare",
      "name": "Switch Article Share",
      "description": "Share of daily published game articles that include Nintendo Switch.",
      "unitText": "percent",
      "value": null,
      "ingestKey": "switchArticleShare",
      "window": "1d",
      "valueUpdatedAt": null
    }
  ],
  "scheduler": "scheduler.jsonld",
  "coverageAudit": {
    "@type": "DefinedTermSet",
    "name": "Project JSON-LD Coverage Audit",
    "description": "Detected gaps against requested Japan game + PS5/Switch scope and remediation status.",
    "terms": [
      {
        "@type": "DefinedTerm",
        "identifier": "audit:missing_scope_alignment",
        "name": "Scope alignment mismatch",
        "description": "Project metadata and growth goals referenced generic ad mechanics but did not explicitly document game manufacturer, PS5, and Switch scope.",
        "impact": "High",
        "status": "Mitigating"
      },
      {
        "@type": "DefinedTerm",
        "identifier": "audit:non_game_milestones",
        "name": "Automotive and non-game milestones",
        "description": "Milestones in scheduler contained automotive and multiple unrelated verticals; this dilutes execution confidence for game-focused coverage.",
        "impact": "High",
        "status": "Remediated"
      },
      {
        "@type": "DefinedTerm",
        "identifier": "audit:platform_focus_gap",
        "name": "Missing explicit PS5/Switch KPIs",
        "description": "No dedicated survival indicator existed for platform coverage rate, reducing measurable tracking of requested focus.",
        "impact": "Medium",
        "status": "Remediated"
      },
      {
        "@type": "DefinedTerm",
        "identifier": "audit:job_distribution_risk",
        "name": "Over-broad scheduler jobs",
        "description": "Current jobs include many unrelated categories that compete for crawl budget and content capacity.",
        "impact": "Medium",
        "status": "Remediated"
      }
    ]
  },
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "scheduler.jsonld",
        "content": {
          "raw": "{\n  \"@context\": [\n    \"https://schema.org/\",\n    {\n      \"etzhayyim\": \"https://etzhayyim.com/schemas/\",\n      \"capabilities\": \"etzhayyim:capabilities\",\n      \"survivalIndicators\": \"etzhayyim:survivalIndicators\",\n      \"scheduler\": \"etzhayyim:scheduler\",\n      \"milestones\": \"etzhayyim:milestones\",\n      \"blockers\": \"etzhayyim:blockers\",\n      \"dependsOn\": {\n        \"@id\": \"etzhayyim:dependsOn\",\n        \"@type\": \"@id\"\n      },\n      \"ingestKey\": \"etzhayyim:ingestKey\",\n      \"window\": \"etzhayyim:window\",\n      \"valueUpdatedAt\": \"etzhayyim:valueUpdatedAt\"\n    }\n  ],\n  \"@type\": \"CreativeWork\",\n  \"name\": \"Autonomous News Media (news.etzhayyim.com) Game & Platform Scheduler\",\n  \"identifier\": \"etzhayyim-project-news/scheduler\",\n  \"description\": \"Project schedule for comprehensive coverage of Japanese game manufacturers and PS5/Switch news.\",\n  \"dateCreated\": \"2026-02-17T00:00:00+00:00\",\n  \"dateModified\": \"2026-02-17T09:00:00Z\",\n  \"milestones\": [\n    {\n      \"id\": \"M0\",\n      \"name\": \"Game KPIs and platform instrumentation baseline\",\n      \"status\": \"Completed\",\n      \"eta\": \"2026-02-21\",\n      \"notes\": \"baseline KPI set is now reflected in PROJECT.jsonld: gameManufacturerCoverage, ps5SwitchArticleShare, ps5ArticleShare, switchArticleShare.\",\n      \"updatedAt\": \"2026-02-17T09:00:00Z\",\n      \"exitCriteria\": [\n        \"gameManufacturerCoverage (1d) を取得できる\",\n        \"ps5SwitchArticleShare (1d) を取得できる\",\n        \"requests/gccCredit/adsRevenueJPYDaily を日次更新できる\"\n      ]\n    },\n    {\n      \"id\": \"M1\",\n      \"name\": \"日本ゲームメーカー&ゲームタイトル分類の整備\",\n      \"status\": \"Completed\",\n      \"eta\": \"2026-02-23\",\n      \"notes\": \"Define manufacturer and title taxonomies (日本大手中心) has been implemented in scheduler/lexicon/resources layer: targetMakers in PROJECT.jsonld and japanese-game-manufacturer, ps5, switch normalization aliases are added.\",\n      \"updatedAt\": \"2026-02-17T09:00:00Z\",\n      \"exitCriteria\": [\n        \"メーカー別の同義語辞書(別名/略称/英語表記)を整備\",\n        \"タイトル別の優先度ルールを確定\",\n        \"PS5 / Switch のプラットフォームタグ運用ルールを確定\"\n      ]\n    },\n    {\n      \"id\": \"M2\",\n      \"name\": \"ソース収集基盤とPS5/Switch特化データパイプライン\",\n      \"status\": \"In Progress\",\n      \"eta\": \"2026-03-03\",\n      \"dependsOn\": [\n        \"M1\"\n      ],\n      \"notes\": \"Started execution: scheduler categories now include jp-game-manufacturer/ps5/switch and collector can target these directly.\",\n      \"updatedAt\": \"2026-02-17T09:00:00Z\",\n      \"exitCriteria\": [\n        \"Reliable source list curated per manufacturer and per platform\",\n        \"Deduplication and freshness scoring enabled\",\n        \"Scheduler cadence set (2時間刻み ingest、1日3回 publish batches)\"\n      ]\n    },\n    {\n      \"id\": \"M3\",\n      \"name\": \"メーカー/タイトルページの構造化配信導入\",\n      \"status\": \"Planned\",\n      \"eta\": \"2026-03-10\",\n      \"dependsOn\": [\n        \"M2\"\n      ],\n      \"exitCriteria\": [\n        \"日本ゲームメーカー別カテゴリページを公開\",\n        \"主要タイトルページを公開し、関連リンクを内部接続\",\n        \"PS5/Switch記事テンプレートに改稿日/発表元/ファクトチェック欄を固定\"\n      ]\n    },\n    {\n      \"id\": \"M4\",\n      \"name\": \"ゲーム縦断のSEO・収益最適化\",\n      \"status\": \"Planned\",\n      \"eta\": \"2026-03-31\",\n      \"dependsOn\": [\n        \"M3\"\n      ],\n      \"exitCriteria\": [\n        \"PS5/Switch検索ボリュームに対する新規着地率改善\",\n        \"ゲーム記事CTRとRPMベースライン確立\",\n        \"上位メーカー記事に配分重みを追加\"\n      ]\n    },\n    {\n      \"id\": \"M5\",\n      \"name\": \"ニュース品質ゲート導入（速報・事実根拠）\",\n      \"status\": \"Planned\",\n      \"eta\": \"2026-03-15\",\n      \"dependsOn\": [\n        \"M4\"\n      ],\n      \"exitCriteria\": [\n        \"sources.jsonld による未検証情報の除外ルール導入\",\n        \"出典リンク必須・日付明示・噂判定ラベルルールが稼働\"\n      ]\n    }\n  ],\n  \"blockers\": [\n    {\n      \"id\": \"B1\",\n      \"name\": \"Stable source coverage for all target manufacturers\",\n      \"status\": \"In Progress\",\n      \"severity\": \"High\",\n      \"notes\": \"Some makers have limited RSS/API coverage; fallback collection and manual validation standards are needed.\",\n      \"updatedAt\": \"2026-02-15T00:00:00Z\",\n      \"unblockCriteria\": [\n        \"At least one reliable upstream source per target manufacturer\",\n        \"Source quality SLA defined (latency, duplication rate, missing rate)\"\n      ]\n    },\n    {\n      \"id\": \"B2\",\n      \"name\": \"Model name normalization (同名・略称の曖昧性)\",\n      \"status\": \"In Progress\",\n      \"severity\": \"High\",\n      \"notes\": \"ゲームタイトルとメーカー名の表記揺れ（略称、英語名、旧作・続編名）が重複抑制を阻害。\",\n      \"updatedAt\": \"2026-02-15T00:00:00Z\",\n      \"unblockCriteria\": [\n        \"メーカー・タイトル・作品名の正規化辞書を実装\",\n        \"同一記事判定F1指標の目標値(>0.85)を満たす\"\n      ]\n    },\n    {\n      \"id\": \"B3\",\n      \"name\": \"ゲームニュースのファクトチェック運用\",\n      \"status\": \"In Progress\",\n      \"severity\": \"Medium\",\n      \"notes\": \"日本語圏ではファンサイト由来の誤情報が混入しやすいため、出典確度の判定フローが不足。\",\n      \"updatedAt\": \"2026-02-15T00:00:00Z\",\n      \"unblockCriteria\": [\n        \"confirmed/rumor/analysis の分類ルールを公開\",\n        \"公開前バリデーションで未確認記述を除外\"\n      ]\n    },\n    {\n      \"id\": \"B4\",\n      \"name\": \"ExoClick revenue tracking wiring\",\n      \"status\": \"In Progress\",\n      \"severity\": \"High\",\n      \"notes\": \"Added metrics keys + manual update flow (data/project-metrics.json, scripts/update_project_metrics.py). ExoClick CSV helper available in metrics/README.md.\",\n      \"updatedAt\": \"2026-02-15T00:00:00Z\",\n      \"unblockCriteria\": [\n        \"Daily revenue number available (manual or automated)\"\n      ]\n    },\n    {\n      \"id\": \"B5\",\n      \"name\": \"Baseline request counting source-of-truth\",\n      \"status\": \"In Progress\",\n      \"severity\": \"Medium\",\n      \"notes\": \"Documented proposed source-of-truth in metrics/sources.json.\",\n      \"updatedAt\": \"2026-02-15T00:00:00Z\",\n      \"unblockCriteria\": [\n        \"Requests metric mapped to a concrete data source (CDN logs, gateway metrics, or app metrics)\"\n      ]\n    },\n    {\n      \"id\": \"B6\",\n      \"name\": \"PS5/Switch固有指標の実行可視化\",\n      \"status\": \"In Progress\",\n      \"severity\": \"Medium\",\n      \"notes\": \"PS5/Switch coverage share keys are now declared; next step is dashboard wiring and publish-latency alerting.\",\n      \"updatedAt\": \"2026-02-17T09:00:00Z\",\n      \"unblockCriteria\": [\n        \"ps5SwitchArticleShare の日次取得パイプラインが追加\",\n        \"publish latency SLA を可視化\"\n      ]\n    }\n  ],\n  \"scheduler\": {\n    \"timezone\": \"Asia/Tokyo\",\n    \"languages\": [\n      \"ja\",\n      \"en\"\n    ],\n    \"prompt\": \"Use projects/etzhayyim-project-news/resources/source.jsonld as the primary crawler plan (feeds first). Prioritize Japanese game manufacturer official channels, major platform/industry portals, and game press releases. For each run: normalize maker/title labels, dedupe by canonical URL, validate PS5/Switch coverage tags, and only publish statements backed by source links. Use projects/etzhayyim-project-news/resources/writers.jsonld and prefer game-insider persona for game topics. Output must keep YYYY-MM-DD dates, explicit source links, and explicit label of confirmed/rumor for non-official claims.\",\n    \"jobs\": [\n      {\n        \"name\": \"cron-game-ingest-highfreq\",\n        \"route\": \"/jobs/game-generate\",\n        \"schedule\": \"*/2 * * * *\",\n        \"categories\": [\n          \"game\",\n          \"jp-game-manufacturer\",\n          \"ps5\",\n          \"switch\"\n        ],\n        \"notes\": \"高頻度の新着検知。取得優先順: sources.jsonld order + platform tags.\"\n      },\n      {\n        \"name\": \"cron-game-publish-ja-morning\",\n        \"route\": \"/jobs/game-generate\",\n        \"schedule\": \"20 6,12,18 * * *\",\n        \"categories\": [\n          \"game\",\n          \"game-title-specific\",\n          \"jp-game-manufacturer\"\n        ],\n        \"notes\": \"午前/昼/夕の3回配信。日本語優先、PS5/Switch関連記事を含める。\"\n      },\n      {\n        \"name\": \"cron-game-publish-shift\",\n        \"route\": \"/jobs/game-generate\",\n        \"schedule\": \"50 8,14,20 * * *\",\n        \"categories\": [\n          \"jp-game-manufacturer\",\n          \"ps5\",\n          \"switch\",\n          \"game-title-specific\"\n        ],\n        \"notes\": \"配信偏り補正。PS5/Switch記事比率を担保するために追加枠を確保。\"\n      },\n    ]\n  }\n}\n"
        }
      }
    ]
  }
}
