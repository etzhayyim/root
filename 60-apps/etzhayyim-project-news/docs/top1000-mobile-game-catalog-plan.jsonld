{
  "@context": [
    "https://schema.org/",
    {
      "etzhayyim": "https://etzhayyim.com/schemas/",
      "platformScope": "etzhayyim:platformScope",
      "snapshotVersion": "etzhayyim:snapshotVersion",
      "sourceQuality": "etzhayyim:sourceQuality",
      "updateCadence": "etzhayyim:updateCadence",
      "targetFile": "etzhayyim:targetFile",
      "dependsOn": {
        "@id": "etzhayyim:dependsOn",
        "@type": "@id"
      }
    }
  ],
  "@type": "Project",
  "name": "news.etzhayyim.com Mobile Top1000 Game Catalog",
  "identifier": "etzhayyim-project-news/top1000-catalog",
  "projectRef": "/Users/junkawasaki/github/etzhayyim-root/projects/etzhayyim-project-news/PROJECT.jsonld",
  "scope": {
    "@type": "ItemList",
    "name": "Top1000カバレッジスコープ",
    "numberOfItems": 2,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@type": "DefinedTerm",
          "name": "iOS Top 1000",
          "description": "App Store ランキング（日本 or 地域固定）からの1000件取得"
        }
      },
      {
        "@type": "ListItem",
        "position": 2,
        "item": {
          "@type": "DefinedTerm",
          "name": "Android Top 1000",
          "description": "Google Play ランキング（日本または地域固定）からの1000件取得"
        }
      }
    ]
  },
  "inLanguage": ["ja", "en"],
  "dateCreated": "2026-02-17",
  "status": "Planned",
  "sources": [
    {
      "@type": "DataFeed",
      "name": "iOS Top charts source",
      "url": "https://rss.applemarketingtools.com/api/v2/jp/apps/top-free/1000/apps.json",
      "platformScope": "ios",
      "sourceQuality": "Primary",
      "description": "Apple公式に近い公開RSS API。運用前に実レスポンスのヘッダ互換性を確認する。"
    },
    {
      "@type": "DataFeed",
      "name": "Android Top charts source",
      "platformScope": "android",
      "sourceQuality": "Fallback+Primary（検証中）",
      "url": "https://play.google.com/store/apps/collection/topselling_new_free?hl=ja&gl=JP",
      "description": "ページ・カテゴリ抽出を実装し、順位・URL・開発元・カテゴリ・更新日時を正規化して保存する。HTML構造変更に備えて2-3系の代替ソースを同時登録。"
    },
    {
      "@type": "DataFeed",
      "name": "Official game manufacturer pages",
      "platformScope": "ios+android",
      "sourceQuality": "High",
      "description": "重複排除・誤同定抑制のための補完ソース。既存の projects/etzhayyim-project-news/resources/source.jsonld と整合。"
    }
  ],
  "executionPlan": {
    "@type": "HowTo",
    "name": "実行計画（1週間）",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "データ取得基盤",
        "text": "iOS/Androidの個別コレクタースクリプトを設計。取得は1日1回フル収集（1000件）を基本とし、日中は2時間ごとに増分チェックのみ実施。"
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "正規化・重複統合",
        "text": "ゲーム名・開発元・パッケージ/App IDで同一性キーを作成。platform別順位は `rank_ios` / `rank_android` として保持し、片側のみ存在する件は null 非埋めで明示。",
        "dependsOn": "/Users/junkawasaki/github/etzhayyim-root/projects/etzhayyim-project-news/docs/top1000-mobile-game-catalog-plan.jsonld"
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "品質ゲート",
        "text": "欠損率（必須項目: name, platform, rank, url）を監視。iOS/Androidとも 1000件完全取得ならPASS、欠損時は該当チャネルを要再実行とする。"
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "JSON-LD整形と記事化",
        "text": "`/games/top1000/mobile/{snapshot}/dataset.jsonld` を生成し、schedulerから参照。記事本文は ""ランキング変化（新規/離脱/順位変動）"" を別JSON-LDで生成。"
      },
      {
        "@type": "HowToStep",
        "position": 5,
        "name": "公開・可視化",
        "text": "`/users/`/`/projects/etzhayyim-project-news` 内のデータパイプラインに反映し、公開差分は日次レポートで確認。"
      }
    ]
  },
  "integrationTargets": {
    "currentProject": "projects/etzhayyim-project-news",
    "projectConfig": "/Users/junkawasaki/github/etzhayyim-root/projects/etzhayyim-project-news/PROJECT.jsonld",
    "schedulerSeed": "/Users/junkawasaki/github/etzhayyim-root/projects/etzhayyim-project-news/scheduler.jsonld",
    "gameSources": "/Users/junkawasaki/github/etzhayyim-root/projects/etzhayyim-project-news/resources/source.jsonld",
    "currentGameRegistry": "/Users/junkawasaki/github/etzhayyim-root/projects/etzhayyim-project-news/resources/games.jsonld"
  },
  "datasetTemplate": {
    "@type": "ItemList",
    "name": "Top1000 Mobile Game Catalog",
    "targetFile": "/Users/junkawasaki/github/etzhayyim-root/projects/etzhayyim-project-news/resources/top1000-games.jsonld",
    "itemTemplate": {
      "@type": "VideoGame",
      "identifier": "<platform>:<bundleId or packageName>",
      "name": "Game title",
      "publisher": {"@type": "Organization", "name": "Publisher"},
      "applicationCategory": "Game category",
      "offers": {"@type": "Offer", "priceCurrency": "JPY", "price": "0", "category": "mobile app"},
      "url": "Store URL",
      "aggregateRating": {"@type": "AggregateRating", "ratingValue": 0, "reviewCount": 0},
      "dateModified": "ISO-8601",
      "platformScope": "ios|android|both",
      "rankIos": 1,
      "rankAndroid": 1,
      "rankDelta7d": 0,
      "snapshotAt": "2026-02-17T00:00:00+09:00"
    }
  },
  "kpi": {
    "@type": "ItemList",
    "numberOfItems": 3,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@type": "PropertyValue",
          "name": "Top1000Completeness",
          "description": "iOS/Android それぞれ 1000件に対する実取得件数比率",
          "value": 0
        }
      },
      {
        "@type": "ListItem",
        "position": 2,
        "item": {
          "@type": "PropertyValue",
          "name": "CrossPlatformCoverageRatio",
          "description": "iOS/Android双方に掲載されるタイトル比率",
          "value": 0
        }
      },
      {
        "@type": "ListItem",
        "position": 3,
        "item": {
          "@type": "PropertyValue",
          "name": "PipelineFreshnessHours",
          "description": "最終snapshotからの経過時間（h）",
          "value": 0
        }
      }
    ]
  },
  "schedulerRecommendation": {
    "@type": "HowTo",
    "name": "news.etzhayyim.com向け更新フロー",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "daily-full (Asia/Tokyo 02:10)",
        "text": "トップ1000フル取得を実行し、games/top1000 snapshotを作成。"
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "delta-check (毎時)",
        "text": "ランキングの差分（新規/離脱）を再取得可能なチャネルのみ検知し、監査ログへ追記。"
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "news publish cycle",
        "text": "scheduler.jsonld の既存 `cron-game-news` と整合する時間帯に `news` 配信を実行し、トップ1000変更要約をセクション化。"
      }
    ]
  },
  "statusSummary": {
    "@type": "DefinedTermSet",
    "terms": [
      {
        "@type": "DefinedTerm",
        "name": "既存資産",
        "description": "`PROJECT.jsonld` と `scheduler.jsonld` はニュース生成用で、トップ1000統合用ジョブは未定義。"
      },
      {
        "@type": "DefinedTerm",
        "name": "実装差分",
        "description": "今回の計画は Top1000 catalog 用の収集/整形/差分監査を追加し、収集ジョブと既存ニュース運用を接続する。"
      }
    ]
  }
}
