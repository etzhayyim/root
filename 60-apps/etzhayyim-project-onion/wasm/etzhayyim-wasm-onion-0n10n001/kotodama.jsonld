{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:onion.etzhayyim.com",
  "build": {
    "guestLanguage": "go"
  },
  "component": {
    "path": "component.wasm"
  },
  "contentLabels": {
    "accessControl": {
      "requireAuth": true,
      "requireClearance": "confidential",
      "required": true
    },
    "defaultLabels": [
      "darkweb-intelligence",
      "threat-intel",
      "restricted"
    ],
    "sensitiveContent": true
  },
  "convoSystemPrompt": "You are onion agent. Onion — Dark Web (.onion) Page Intelligence Platform. Crawls hidden services via Tor, classifies threats, and feeds intelligence to malak.etzhayyim.com. Respond helpfully in the user's language.",
  "deploy": {},
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "raci": "responsible",
    "classification": "confidential",
    "complianceFrameworks": [
      "budapest-convention"
    ]
  },
  "interfaces": {
    "package": "etzhayyim:onion@1.0.0",
    "requires": []
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "onion",
  "nanoid": "0n10n001",
  "performerType": "service",
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "darkweb-crawl",
      "onion-intelligence",
      "threat-classification"
    ],
    "description": "Onion — Dark Web (.onion) Page Intelligence Platform. Multi-DID site-per-DID architecture, Tor crawling via darkweb-proxy, threat classification, malak cross-actor integration.",
    "displayName": "Onion",
    "isBot": true,
    "operator": "etzhayyim.com",
    "sensitivity": "confidential"
  },
  "project": "onion",
  "routes": [
    {
      "host": "onion.etzhayyim.com",
      "paths": ["/"],
      "tls": true
    },
    {
      "host": "0n10n001.etzhayyim.com",
      "paths": ["/"],
      "tls": true
    }
  ],
  "runtimeType": "worker",
  "sensitivity": "confidential",
  "source": "custom",
  "space": {
    "channels": [
      {
        "default": true,
        "kind": "public",
        "name": "Darkweb Feed"
      },
      {
        "kind": "public",
        "name": "High Risk Alerts"
      },
      {
        "kind": "private",
        "name": "Crawl Operations"
      }
    ],
    "historyVisibility": "shared",
    "joinRule": "invite",
    "name": "Onion — Dark Web Intelligence"
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.graph.follow",
        "ai.etzhayyim.apps.onion.page",
        "ai.etzhayyim.apps.onion.site",
        "ai.etzhayyim.apps.onion.crawl"
      ]
    }
  },
  "ui": {
    "accent": "#1a0a2e",
    "icon": "🧅",
    "ssrRoutes": {
      "live": "ai.etzhayyim.apps.onion.getStats"
    }
  },
  "uiType": "appview",
  "version": "0.1.0"
}
