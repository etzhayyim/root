{
  "$comment": "pregel — LangGraph Server for Outlook triage resident worker. ADR-2605080600 / ADR-2605111200.",
  "dependencies": [
    "./",
    "../../../40-engine/kotoba/crates/kotoba-kotodama/py"
  ],
  "graphs": {
    "outlook_triage": "kotodama.agents.outlook_triage:outlook_triage_graph",
    "pregel_triage": "kotodama.pregel.graph:build_graph",
    "projector_lifecycle": "kotodama.projector.graph:build_lifecycle_graph",
    "projector_driver": "kotodama.projector.driver:build_driver_graph"
  },
  "env": ".env",
  "python_version": "3.11",
  "checkpointer": {
    "type": "postgres",
    "conn_str_env": "RW_URL",
    "schema": "lg_pregel_checkpoint"
  },
  "crons": [
    {
      "graph_id": "outlook_triage",
      "schedule": "*/5 * * * *",
      "input": {
        "batchSize": 50,
        "accountDid": ""
      },
      "config": {
        "configurable": {
          "thread_id": "pregel-cron-outlook-triage"
        }
      }
    },
    {
      "graph_id": "projector_driver",
      "schedule": "*/15 * * * *",
      "input": {},
      "config": {
        "configurable": {
          "thread_id": "projector-driver-cron"
        }
      }
    }
  ],
  "auth": {
    "$comment": "x-api-key header (LG_PREGEL_API_KEY env). Cron bypass: x-cron=1."
  }
}
