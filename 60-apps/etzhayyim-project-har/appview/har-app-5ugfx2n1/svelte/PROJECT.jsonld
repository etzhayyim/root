  "@type": "Project",
  "name": "HAR (Human + AI Resources) Platform",
  "status": "In Progress",
  "architecture": {
    "frontend": "SvelteKit 5 + ConnectRPC",
    "backend": "Temporal Go + Wasm Actors",
    "protocol": "ConnectRPC (gRPC-Web)",
    "seo": "Full SSG (adapter-static) with ISCO-based routing",
    "integration": [
      "MCP Entity Service (svc-entity-har)",
      "Temporal Workflow (HarProcessWorkflow)",
      "Stripe Actor (svc-apqc-9-4-1-payment-gateway-stripe)",
      "Scenario Writer Actor (isco-2641)",
      "Visual Creator Actor (isco-2166)"
    ]
  },
  "milestones": [
    {
      "@type": "CreativeWork",
      "name": "Phase 1: Production Foundation",
      "description": "Clerk Auth integration & Stripe Billing (USD) implementation. K8s Secret registered, Initial Payment Link created, and Automated Activation workflow (Webhook -> Temporal Signal) integrated.",
      "status": "Completed"
    },
    {
      "@type": "CreativeWork",
      "name": "Phase 2: Autonomous Engine",
      "description": "Full Temporal Workflow for Human-in-the-loop escalation. Integrated 100+ HAR Personas based on real ISCO-08 repositories found in REPOS.md. Mobile-optimized UI and cross-actor Agent Skill Card display.",
      "status": "Completed"
    },
    {
      "@type": "CreativeWork",
      "name": "Phase 3: Automated Growth",
      "description": "HAR-driven advertising automation (Scenario Writer + Visual Creator + Social Media Actor).",
      "status": "In Progress"
    }
  ],
  "requirements": {
    "auth": "Clerk (Multi-tenant support)",
    "billing": "Stripe (Subscription + Usage-based)",
    "automation": "Temporal + Social Media MCP",
    "infrastructure": "Linode LKE + GitOps"
  },
  "description": "Hybrid workforce management platform where AI Actors perform tasks with human-in-the-loop backup. Designed using DoDAF v2, APQC, and ISCO-08 standards.",
