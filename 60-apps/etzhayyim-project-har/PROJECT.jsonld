{
  "@context": [
    "https://schema.org/",
    {
      "etzhayyim": "https://etzhayyim.com/schemas/",
      "capabilities": "etzhayyim:capabilities",
      "survivalIndicators": "etzhayyim:survivalIndicators",
      "scheduler": "etzhayyim:scheduler",
      "milestones": "etzhayyim:milestones",
      "blockers": "etzhayyim:blockers",
      "dependsOn": {
        "@id": "etzhayyim:dependsOn",
        "@type": "@id"
      },
      "ingestKey": "etzhayyim:ingestKey",
      "window": "etzhayyim:window",
      "valueUpdatedAt": "etzhayyim:valueUpdatedAt"
    }
  ],
  "@type": "Project",
  "identifier": "etzhayyim-project-har",
  "name": "ai etzhayyim project har",
  "status": "Planned",
  "description": "AIが人間を雇用するための採用基盤。AIがjob/role/contract/給与を定義し、求人を公募し、求人データ(JSON-LD)をGit上の一次リソースとして運用する。",
  "hasPart": [
    {
      "@type": "CreativeWork",
      "name": "HAR Job Postings (Primary Resource)",
      "url": "JOB_POSTINGS.jsonld",
      "encodingFormat": "application/ld+json"
    }
  ],
  "capabilities": {
    "@type": "DefinedTermSet",
    "name": "Capabilities",
    "description": "Summary of the capabilities this project is responsible for (CV-1).",
    "terms": [
      {
        "@type": "DefinedTerm",
        "name": "AI-driven Hiring Design",
        "description": "AIが職務要件・契約条件・給与レンジを策定し、公募フローを実行する。"
      },
      {
        "@type": "DefinedTerm",
        "name": "Git-native Job Source of Truth",
        "description": "求人情報をJSON-LDでGit管理し、監査可能な一次情報源として扱う。"
      }
    ]
  },
  "survivalIndicators": [
    {
      "@type": "PropertyValue",
      "identifier": "requests",
      "name": "Requests",
      "description": "Request count (traffic) as a basic survival indicator.",
      "unitText": "count",
      "value": null,
      "ingestKey": "requests",
      "window": "1d",
      "valueUpdatedAt": null
    },
    {
      "@type": "PropertyValue",
      "identifier": "gccCredit",
      "name": "GCC Credit",
      "description": "GCC credit balance (or net credit change) as a basic survival indicator.",
      "unitText": "GCC",
      "value": null,
      "ingestKey": "gccCredit",
      "window": "1d",
      "valueUpdatedAt": null
    },
    {
      "@type": "PropertyValue",
      "identifier": "openJobPostings",
      "name": "Open Job Postings",
      "description": "Git上で公開中の求人件数。",
      "unitText": "count",
      "value": 3,
      "ingestKey": "openJobPostings",
      "window": "1d",
      "valueUpdatedAt": "2026-02-17T00:00:00Z"
    }
  ],
  "scheduler": "scheduler.jsonld",
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "JOB_POSTINGS.jsonld",
        "content": {
          "@context": [
            "https://schema.org",
            {
              "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
              "dm2": "https://www.omg.org/spec/DoDAF-DM2/",
              "etzhayyim": "https://etzhayyim.com/schemas/",
              "gitPrimarySource": "etzhayyim:gitPrimarySource",
              "contractType": "etzhayyim:contractType",
              "salary": "etzhayyim:salary",
              "hiringAuthority": "etzhayyim:hiringAuthority"
            }
          ],
          "@type": "ItemList",
          "name": "etzhayyim-project-har job postings",
          "description": "AI主体の公募採用データ。JSON-LDをGit上の一次リソースとして管理する。",
          "gitPrimarySource": {
            "@type": "CreativeWork",
            "name": "Git repository primary source",
            "url": "https://github.com/etzhayyim/etzhayyim-apps/tree/main/projects/etzhayyim-project-har/JOB_POSTINGS.jsonld"
          },
          "itemListElement": [
            {
              "@type": "JobPosting",
              "identifier": "har-job-001",
              "title": "AI Governance Operations Partner",
              "description": "AIが策定した政策・運用案を検証し、実社会オペレーションに落とし込む人材。",
              "employmentType": "FULL_TIME",
              "contractType": "Permanent",
              "hiringAuthority": "etzhayyim-project-har",
              "jobLocationType": "TELECOMMUTE",
              "validThrough": "2026-06-30T23:59:59Z",
              "baseSalary": {
                "@type": "MonetaryAmount",
                "currency": "JPY",
                "value": {
                  "@type": "QuantitativeValue",
                  "minValue": 9000000,
                  "maxValue": 14000000,
                  "unitText": "YEAR"
                }
              },
              "salary": "JPY 9,000,000 - 14,000,000 / year",
              "skills": "公共政策運用, AIエージェント協働, 監査ログ運用"
            },
            {
              "@type": "JobPosting",
              "identifier": "har-job-002",
              "title": "AI-Human Contract Architect",
              "description": "AIと人間の役割分担を契約条項へ設計し、成果連動型の契約テンプレートを整備する。",
              "employmentType": "CONTRACTOR",
              "contractType": "Fixed-term (12 months, renewable)",
              "hiringAuthority": "etzhayyim-project-har",
              "jobLocationType": "TELECOMMUTE",
              "validThrough": "2026-06-30T23:59:59Z",
              "baseSalary": {
                "@type": "MonetaryAmount",
                "currency": "JPY",
                "value": {
                  "@type": "QuantitativeValue",
                  "minValue": 800000,
                  "maxValue": 1200000,
                  "unitText": "MONTH"
                }
              },
              "salary": "JPY 800,000 - 1,200,000 / month",
              "skills": "契約設計, ガバナンス, リスクマネジメント"
            },
            {
              "@type": "JobPosting",
              "identifier": "har-job-003",
              "title": "Public Recruitment & Community Manager",
              "description": "公募情報の公開、応募導線の運用、候補者コミュニティとの対話を担当する。",
              "employmentType": "PART_TIME",
              "contractType": "Part-time (20h/week)",
              "hiringAuthority": "etzhayyim-project-har",
              "jobLocationType": "TELECOMMUTE",
              "validThrough": "2026-06-30T23:59:59Z",
              "baseSalary": {
                "@type": "MonetaryAmount",
                "currency": "JPY",
                "value": {
                  "@type": "QuantitativeValue",
                  "minValue": 400000,
                  "maxValue": 650000,
                  "unitText": "MONTH"
                }
              },
              "salary": "JPY 400,000 - 650,000 / month",
              "skills": "採用広報, 候補者体験設計, SNS/コミュニティ運営"
            }
          ]
        }
      },
      {
        "fileName": "scheduler.jsonld",
        "content": {
          "@context": [
            "https://schema.org/",
            {
              "etzhayyim": "https://etzhayyim.com/schemas/",
              "capabilities": "etzhayyim:capabilities",
