              },
              "ingestKey": "etzhayyim:ingestKey",
              "window": "etzhayyim:window",
              "valueUpdatedAt": "etzhayyim:valueUpdatedAt"
            }
          ],
          "@type": "CreativeWork",
          "name": "ai etzhayyim project har Scheduler",
          "identifier": "etzhayyim-project-har/scheduler",
          "description": "HAR hiring execution schedule aligned with gov resource planning.",
          "dateCreated": "2026-02-15T04:25:26+00:00",
          "milestones": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Publish job postings JSON-LD",
              "description": "Maintain JobPosting records as Git primary resource",
              "status": "Completed"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Public recruitment launch",
              "description": "Open recruitment through https://har.etzhayyim.com/jobs",
              "status": "Planned",
              "dependsOn": "../etzhayyim-project-government-body/scheduler.jsonld"
            }
          ],
