{
  "@context": "https://etzhayyim.com/ns/magatama/v1",
  "@id": "did:web:wallet.etzhayyim.com",
  "component": {
    "path": "src/app.ts"
  },
  "convoSystemPrompt": "You are ai-gftd-wasm-wallet agent. Ethereum wallet — GCC token balance queries, transfers, gas estimation, price feeds. Respond helpfully in the users language.",
  "deploy": {},
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": [
      "anti-fraud"
    ]
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "ai-gftd-wasm-wallet",
  "nanoid": "wt1e2f3g",
  "performerType": "person",
  "profile": {
    "capabilities": [
      "bpmn-dispatch",
      "credit-ledger",
      "reward-management"
    ],
    "description": "Ethereum wallet — GCC token balance queries, transfers, gas estimation, price feeds",
    "displayName": "GCC Wallet"
  },
  "project": "credits",
  "runtimeType": "worker",
  "build": {
    "role": "thin-edge",
    "businessLogic": "20-actors/magatama/py/src/pymagatama/ingest/credits.py",
    "bpmn": "etzhayyim-root/00-contracts/bpmn/ai/gftd/credits"
  },
  "space": {
    "channels": [
      {
        "default": true,
        "description": "Wallet operations and balance updates",
        "kind": "public",
        "name": "wallet-feed"
      }
    ],
    "description": "Ethereum wallet and GCC token operations",
    "historyVisibility": "world-readable",
    "joinRule": "public",
    "name": "GCC Wallet"
  },
  "triggers": {
    "http": {
      "listen": "0.0.0.0:8080",
      "routes": [
        "/api/grpc/...",
        "/health",
        "/healthz"
      ]
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "ai.gftd.apps.credits.creditsEntity",
        "ai.gftd.apps.credits.creditsEvent",
        "ai.gftd.apps.credits.creditsReport"
      ]
    }
  },
  "uiType": "yoro"
}
