{
  "@context": "https://schema.org",
  "@type": "Project",
  "name": "GFTD Computing Credits (GCC)",
  "identifier": "ai-gftd-project-credits",
  "description": "ATP-like computing resource currency for the GFTD Organism. Manages credit balances, purchase fee settlement, and public-fund routing for credit spend.",
  "hasPart": [
    {
      "@type": "WebApplication",
      "name": "Credits API",
      "url": "https://credits.gftd.ai"
    },
    {
      "@type": "WebApplication",
      "name": "Credits Console",
      "url": "https://credits.gftd.ai/",
      "description": "Preview console for 30% purchase fee and 10% public-fund allocation routing."
    }
  ],
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "scheduler.jsonld",
        "content": {
          "@context": [
            "https://schema.org/",
            {
              "gftd": "https://gftd.ai/schemas/",
              "capabilities": "gftd:capabilities",
              "survivalIndicators": "gftd:survivalIndicators",
              "scheduler": "gftd:scheduler",
              "milestones": "gftd:milestones",
              "blockers": "gftd:blockers",
              "dependsOn": {
                "@id": "gftd:dependsOn",
                "@type": "@id"
              },
              "ingestKey": "gftd:ingestKey",
              "window": "gftd:window",
              "valueUpdatedAt": "gftd:valueUpdatedAt"
            }
          ],
          "@type": "CreativeWork",
          "name": "GFTD Computing Credits (GCC) Scheduler",
          "identifier": "ai-gftd-project-credits/scheduler",
          "description": "Project schedule (milestones) and blockers.",
          "dateCreated": "2026-02-15T04:25:26+00:00",
          "milestones": [],
          "blockers": []
        }
      }
    ]
  }
}
