{
  "name": "kotodama-9t84azyt",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"drawFortune\",\"listFortunes\",\"getFortune\",\"resetFortune\",\"createShrine\",\"updateShrine\",\"listShrines\",\"getShrine\"]",
    "APP_DESCRIPTION": "omikuji — Omikuji Fortune Platform. Fortune draw and shrine management with BPMN-driven workflows.",
    "APP_DISPLAY_NAME": "Omikuji Fortune",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "9t84azyt",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "9t84azyt.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "omikuji.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
