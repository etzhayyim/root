      "shomeisyashin-policy"
    ]
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "etzhayyim-wasm-shomeisyashin",
  "nanoid": "f901c7i4",
  "performerType": "person",
  "pool": {},
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "domain-query",
      "data-management"
    ],
    "description": "Shomeisyashin — AI Agent for id-photo intelligence and analytics",
    "displayName": "Shomeisyashin",
    "isBot": true,
    "operator": "etzhayyim.com"
  },
  "project": "shomeisyashin",
  "routes": [
    {
      "host": "syomeisyashin.etzhayyim.com",
      "paths": [
