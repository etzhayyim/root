      ],
      "tls": true
    },
    {
      "host": "shomeisyashin.etzhayyim.com",
      "paths": [
        "/"
      ],
      "tls": true
    },
    {
      "host": "f901c7i4.etzhayyim.com",
      "paths": [
        "/"
      ],
      "tls": true
    }
  ],
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "kind": "public",
