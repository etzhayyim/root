{
  "@context": "https://schema.org/",
  "@type": "SoftwareApplication",
  "@id": "urn:etzhayyim:project:etzhayyim-project-swe",
  "name": "etzhayyim-project-swe",
  "description": "AI Software Engineering agent powered by Claude Opus 4.6. Autonomously designs, implements, tests, reviews, and deploys SpinApp components per project. Uses etzhayyim:agent for durable LLM workflow, etzhayyim:store for git object persistence via hub, and performer framework for virtual actor lifecycle.",
  "applicationCategory": "etzhayyim-project-swe",
  "operatingSystem": "Kubernetes",
  "softwareRequirements": [
    "SpinApp",
    "NATS KV",
    "Claude Opus 4.6 (Anthropic API)",
    "etzhayyim-project-hub (git object store)"
  ],
  "author": {
    "@type": "Organization",
    "name": "Etzhayyim",
    "url": "https://etzhayyim.com"
  },
  "codeRepository": "https://github.com/etzhayyim/etzhayyim-root",
  "programmingLanguage": [
    "Go",
    "TypeScript",
    "Svelte"
  ],
  "component": [
    {
      "@type": "WebApplication",
      "name": "swe-ui",
      "description": "SvelteKit frontend for swe.etzhayyim.com — IDE-like UI with project explorer, conversation panel, code diff viewer, and deployment status",
      "applicationCategory": "Frontend",
      "runtimePlatform": "SvelteKit static (R2 Custom Domain: swe-etzhayyim-ai)",
      "path": "wasm/etzhayyim-wasm-swe-sw3ng1n3/svelte"
    },
    {
      "@type": "SoftwareApplication",
      "name": "etzhayyim-wasm-swe-sw3ng1n3",
      "description": "SpinApp component — SWE agent orchestrator. Exports etzhayyim:swe/swe via wRPC. Imports etzhayyim:agent (LLM), etzhayyim:store (git), etzhayyim:workflow (durable execution). Uses performer framework for state management.",
      "applicationCategory": "Backend",
      "programmingLanguage": "Go",
      "runtimePlatform": "SpinApp (TinyGo WebAssembly)",
      "path": "wasm/etzhayyim-wasm-swe-sw3ng1n3"
    }
  ],
  "dependency": [
    {
      "@type": "SoftwareApplication",
      "name": "etzhayyim-project-hub",
      "description": "Git-compatible object store for repos, PRs, commits, check runs",
      "link": "wRPC (etzhayyim:store/store)"
    },
    {
      "@type": "SoftwareApplication",
      "name": "etzhayyim-agent-provider",
      "description": "LLM durable agent execution (Opus 4.6)",
      "link": "wRPC (etzhayyim:agent/agent)"
    }
  ],
  "tasks": [
    {
      "status": "completed",
      "task": "Design etzhayyim:swe WIT interface (swe.wit)"
    },
    {
      "status": "completed",
      "task": "Add etzhayyim-swe-provider/consumer worlds to etzhayyim-component.wit"
    },
    {
      "status": "completed",
      "task": "Create proto/etzhayyim/swe/v1/swe.proto (WIT-aligned)"
    },
    {
      "status": "completed",
      "task": "Create PROJECT.jsonld and WADM manifest"
    },
    {
      "status": "pending",
      "task": "Implement SWE agent main.go with performer framework"
    },
    {
      "status": "pending",
      "task": "Implement SvelteKit UI (IDE-like SWE agent dashboard)"
    },
    {
      "status": "pending",
      "task": "Build and deploy to spinkube namespace"
    },
    {
      "status": "pending",
      "task": "Verify 1.etzhayyim.com/api/mcp endpoint"
    }
  ]
}
