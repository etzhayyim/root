{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:swe.etzhayyim.com",
  "component": {
    "path": "component.wasm"
  },
  "convoSystemPrompt": "You are swe agent. Swe — AI Agent for software-engineering intelligence and analytics. Respond helpfully in the users language.",
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": [
      "swe-policy"
    ]
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "swe",
  "nanoid": "sw3ng1n3",
  "performerType": "service",
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "domain-query",
      "data-management"
    ],
    "description": "Swe — AI Agent for software-engineering intelligence and analytics",
    "displayName": "Swe",
    "isBot": true,
    "operator": "etzhayyim.com"
  },
  "project": "swe",
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "description": "SWE activity feed — reviews, analysis results",
        "kind": "public",
        "name": "swe-feed"
      }
    ],
    "description": "Software engineering — code analysis, review, CI/CD automation",
    "historyVisibility": "world-readable",
    "joinRule": "public",
    "name": "SWE Intelligence"
  },
  "triggers": {
    "http": {
      "listen": "0.0.0.0:8080",
      "routes": [
        "/api/grpc/...",
        "/health",
        "/healthz",
        "/readyz",
        "/..."
      ],
      "spa": true,
      "staticDir": "/wasm/svelte/dist"
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.like",
        "app.bsky.feed.post",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow",
        "com.etzhayyim.apps.swe.sweEntity",
        "com.etzhayyim.apps.swe.sweEvent",
        "com.etzhayyim.apps.swe.sweReport"
      ]
    }
  },
  "ui": {},
  "uiType": "appview"
}
