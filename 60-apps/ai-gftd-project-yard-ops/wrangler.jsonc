{
  "name": "magatama-y4rd0p5x",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"checkInTrailer\",\"assignDoor\",\"completeDockJob\",\"getDockSchedule\"]",
    "APP_DESCRIPTION": "yard-ops — gate-in / dock-door / gate-out coordination, drives loading-robot missions.",
    "APP_DISPLAY_NAME": "Yard Operations",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "y4rd0p5x",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.gftd.ai/xrpc/ai.gftd.mcp.message"
  },
  "routes": [
    {
      "pattern": "y4rd0p5x.gftd.ai/*",
      "zone_name": "gftd.ai"
    },
    {
      "pattern": "yard-ops.gftd.ai/*",
      "zone_name": "gftd.ai"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
