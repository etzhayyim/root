{
  "name": "kotodama-pht0hl9x",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"registerProvider\",\"listProviders\",\"getProvider\",\"updateHealth\",\"listCapabilities\",\"createPod\",\"listPods\",\"getPodStatus\"]",
    "APP_DESCRIPTION": "provider-pod — Provider Pod Registry & Health Management Platform. BPMN-driven provider lifecycle with pod orchestration and health tracking.",
    "APP_DISPLAY_NAME": "Provider Pod",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "pht0hl9x",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "pht0hl9x.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "provider-pod.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
