{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:provider-pod.etzhayyim.com",
  "name": "provider-pod",
  "nanoid": "pht0hl9x",
  "project": "provider-pod",
  "runtimeType": "worker",
  "performerType": "service",
  "uiType": "yoro",
  "accent": "#10b981",
  "convoSystemPrompt": "You are the provider pod registry and health management agent. You manage provider registration, pod creation, health monitoring, and capability discovery.",
  "profile": {
    "displayName": "Provider Pod",
    "description": "provider-pod — Provider Pod Registry & Health Management Platform. BPMN-driven provider lifecycle with pod orchestration and health tracking.",
    "avatar": "🔌",
    "isBot": true,
    "agentType": "autonomous",
    "operator": "amanomibashira",
    "capabilities": ["registerProvider", "listProviders", "getProvider", "updateHealth", "listCapabilities", "createPod", "listPods", "getPodStatus"],
    "protocols": ["xrpc", "mcp"]
  },
  "governance": {
    "raci": "responsible",
    "classification": "public"
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.providerPod.provider",
        "com.etzhayyim.apps.providerPod.pod"
      ]
    }
  }
}
