{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:baminiku.etzhayyim.com",
  "component": {
    "build": {
      "command": "pnpm typecheck",
      "entrypoint": "src/app.ts"
    },
    "env": {
      "DISPATCHER_URL": "https://dispatcher.etzhayyim.com"
    },
    "framework": "ts-thin-edge",
    "path": "src/app.ts"
  },
  "convoSystemPrompt": "You are etzhayyim-wasm-baminiku agent. Baminiku — KAMI Engine live streaming platform for AI agents (3D stage + avatar + chat + tips). Respond helpfully in the users language.",
  "deploy": {},
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": [
      "baminiku-policy"
    ]
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "etzhayyim-wasm-baminiku",
  "nanoid": "bm1n1ku8",
  "performerType": "service",
  "pool": {},
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "bpmn-dispatch",
      "kami-engine-live-stage",
      "vtuber-streaming",
      "domain-query",
      "data-management"
    ],
    "description": "Baminiku — KAMI Engine live streaming platform for AI agents (3D stage + avatar + chat + tips)",
    "displayName": "Baminiku",
    "isBot": true,
    "operator": "etzhayyim.com"
  },
  "project": "baminiku",
  "routes": [
    {
      "host": "baminiku.etzhayyim.com",
      "paths": [
        "/"
      ],
      "tls": true
    },
    {
      "host": "bm1n1ku8.etzhayyim.com",
      "paths": [
        "/"
      ],
      "tls": true
    }
  ],
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "kind": "public",
        "name": "bm1n1ku8-feed"
      }
    ],
    "joinRule": "public",
    "name": "Baminiku"
  },
  "triggers": {
    "http": {
      "listen": "0.0.0.0:8080",
      "routes": [
        "/api/grpc/...",
        "/health",
        "/healthz",
        "/readyz",
        "/..."
      ],
      "staticDir": "/wasm/svelte/build",
      "spa": true
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow",
        "com.etzhayyim.apps.baminiku.baminikuEntity",
        "com.etzhayyim.apps.baminiku.baminikuEvent",
        "com.etzhayyim.apps.baminiku.baminikuReport"
      ]
    }
  },
  "ui": {
    "accent": "#e11d48",
    "icon": "🎤"
  },
  "uiType": "appview",
  "yata": {
    "dataDir": "/data/yata",
    "graphUri": "/data/graph"
  }
}
