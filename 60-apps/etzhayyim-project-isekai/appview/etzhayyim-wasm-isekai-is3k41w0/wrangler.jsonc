{
  "name": "kotodama-is3k41w0",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "APP_CAPABILITIES": "[\"game-engine\",\"3d-rendering\",\"voxel-sandbox\",\"creature-collection\",\"brainrot-events\"]",
    "APP_DESCRIPTION": "Open 3D voxel world — Minecraft sandbox + Pokoa creature collection + Brainrot meme chaos. Explore biomes, mine resources, catch 151+ creatures, survive brainrot NPC encounters, and raid the Brainrot Dimension.",
    "APP_DISPLAY_NAME": "ISEKAI World",
    "APP_EMBED_URL": "https://is3k41w0.etzhayyim.com/?embed=1",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "is3k41w0",
    "APP_PERFORMER_TYPE": "",
    "APP_UI_TYPE": "game",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "is3k41w0.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "isekcom.etzhayyim.ai/*",
      "zone_name": "etzhayyim.com"
    }
  ]
}
