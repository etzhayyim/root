{
  "@context": "https://gftd.ai/ns/magatama/v1",
  "@id": "did:web:ekyc.gftd.ai",
  "component": {
    "env": {
      "MURAKUMO_URL": "https://murakumo.gftd.ai/api/openai/v1/chat/completions"
    }
  },
  "convoSystemPrompt": "You are the eKYC/AML compliance agent. You handle identity verification (KYC), customer due diligence (CDD), sanctions screening (OFAC/EU/UN), transaction monitoring for anti-money laundering (AML) and counter-terrorism financing (CTF), and suspicious activity reporting (SAR). You can submit verification requests, check CDD tiers, screen names against sanctions lists, monitor transactions for suspicious patterns, create SAR drafts, and freeze accounts. Always respond helpfully in the user's language.",
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "classification": "internal",
    "complianceFrameworks": [
      "Act on Prevention of Transfer of Criminal Proceeds (Japan)",
      "FATF Recommendations",
      "JAFIC Guidelines"
    ],
    "raci": "responsible"
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "ekyc",
  "nanoid": "hzaooy0f",
  "performerType": "service",
  "profile": {
    "agentType": "autonomous",
    "avatar": "KYC",
    "capabilities": [
      "submit_verification",
      "submit_liveness",
      "process_verification",
      "get_verification_status",
      "check_cdd",
      "screen_sanctions",
      "monitor_transaction",
      "report_sar",
      "freeze_account"
    ],
    "category": "compliance",
    "contract": "Act on Prevention of Transfer of Criminal Proceeds",
    "country": "jpn",
    "description": "Electronic identity verification (eKYC), anti-money laundering (AML), counter-terrorism financing (CTF) compliance — CDD, sanctions screening, transaction monitoring, SAR filing",
    "displayName": "eKYC / AML Compliance",
    "isBot": true,
    "operator": "gftd.co.jp"
  },
  "project": "ekyc",
  "routes": [
    {
      "host": "ekyc.gftd.ai",
      "paths": [
        "/"
      ],
      "tls": true
    }
  ],
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "description": "Verification events and compliance updates",
        "kind": "public",
        "name": "ekyc-feed"
      },
      {
        "description": "AML alerts, sanctions hits, SAR notifications",
        "kind": "public",
        "name": "ekyc-alerts"
      },
      {
        "description": "Audit trail for compliance reviews",
        "kind": "public",
        "name": "ekyc-audit"
      }
    ],
    "description": "Identity verification, AML/CTF compliance, sanctions screening, transaction monitoring",
    "historyVisibility": "world-readable",
    "joinRule": "public",
    "name": "eKYC / AML Compliance"
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "ai.gftd.apps.ekyc.verificationRequest",
        "ai.gftd.apps.ekyc.verificationResult",
        "ai.gftd.apps.ekyc.livenessChallenge",
        "ai.gftd.apps.ekyc.kycEvidence",
        "ai.gftd.apps.ekyc.sanctionsScreening",
        "ai.gftd.apps.ekyc.transactionMonitor",
        "ai.gftd.apps.ekyc.sarReport",
        "ai.gftd.apps.ekyc.accountFreeze",
        "ai.gftd.apps.credits.transaction",
        "ai.gftd.apps.yabai.alert",
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow"
      ]
    }
  },
  "uiType": "appview"
}
