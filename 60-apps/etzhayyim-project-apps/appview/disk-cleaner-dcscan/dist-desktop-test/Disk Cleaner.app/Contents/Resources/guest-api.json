{
  "name": "disk-cleaner-guest-api",
  "version": "0.1.0",
  "runtime": "desktop-wasm",
  "endpoints": [
    {
      "path": "/api/host-config",
      "method": "GET",
      "description": "Desktop host runtime configuration exposed by kotodama-desktop-host."
    },
    {
      "path": "/api/guest-summary",
      "method": "GET",
      "description": "Sample disk scan summary payload shaped like the desktop-wasm guest output."
    }
  ],
  "types": {
    "scanSummary": {
      "scannedRoots": "Array<{ path: string; total_bytes: number }>",
      "duplicateGroups": "number",
      "reclaimableBytes": "number"
    }
  }
}
