{
  "@context": "https://etzhayyim.com/ns/magatama/v1",
  "@id": "did:web:apps.etzhayyim.com",
  "accent": "#8b5cf6",
  "component": {
    "build": {
      "command": "pnpm typecheck",
      "entrypoint": "src/app.ts"
    },
    "env": {
      "DISPATCHER_URL": "https://dispatcher.etzhayyim.com"
    },
    "framework": "ts-thin-edge",
    "path": "src/app.ts"
  },
  "convoSystemPrompt": "You are apps agent. Apps — AI Agent for apps intelligence and analytics. Respond helpfully in the users language.",
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "classification": "internal",
    "complianceFrameworks": [
      "SLSA",
      "NIST SSDF",
      "SOC2"
    ],
    "raci": {
      "responsible": [
        "release-operator"
      ],
      "accountable": [
        "platform-release-owner"
      ],
      "consulted": [
        "security-engineer"
      ],
      "informed": [
        "support-desk"
      ]
    },
    "controlObjective": "Protect release distribution integrity and tenant-level accountability.",
    "dataResidency": "jp",
    "retentionPolicy": "4y",
    "approvalMatrix": [
      {
        "action": "planReleaseDistribution",
        "decisionClass": "B",
        "minApprovers": 2,
        "riskTier": "elevated"
      },
      {
        "action": "registerCdnTenantIdentity",
        "decisionClass": "A",
        "minApprovers": 2,
        "riskTier": "high"
      }
    ]
  },
  "icon": "🏪",
  "kpi": [
    "credits の獲得"
  ],
  "name": "apps",
  "nanoid": "a9p5l1st",
  "performerType": "service",
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "bpmn-dispatch",
      "app-directory",
      "app-listing-search",
      "domain-query",
      "data-management"
    ],
    "description": "Apps — AI Agent for apps intelligence and analytics",
    "displayName": "Apps",
    "isBot": true,
    "operator": "etzhayyim.co.jp"
  },
  "project": "apps",
  "routes": [
    {
      "host": "apps.etzhayyim.com",
      "paths": [
        "/"
      ],
      "tls": true
    }
  ],
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "description": "App installs, publishes, reviews",
        "kind": "public",
        "name": "apps-store"
      }
    ],
    "description": "Discover, install, and manage Apps",
    "historyVisibility": "world-readable",
    "joinRule": "public",
    "name": "App Store"
  },
  "triggers": {
    "http": {
      "listen": "0.0.0.0:8080",
      "spa": true,
      "staticDir": "/wasm/svelte/dist",
      "routes": [
        "/..."
      ]
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.like",
        "app.bsky.feed.post",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow",
        "com.etzhayyim.apps.apps.appsEntity",
        "com.etzhayyim.apps.apps.appsEvent",
        "com.etzhayyim.apps.apps.appsReport"
      ]
    }
  },
  "uiType": "appview"
}
