{
  "@context": [
    "https://schema.org/",
    {
      "etzhayyim": "https://etzhayyim.com/schemas/",
      "capabilities": "etzhayyim:capabilities"
    }
  ],
  "@type": "Project",
  "identifier": "etzhayyim-project-apps",
  "name": "Etzhayyim Apps Directory (apps.etzhayyim.com)",
  "status": "In Progress",
  "description": "Apple App Store style listing page for all etzhayyim.com apps. Showcases the full Etzhayyim ecosystem with categories, search, and featured apps at apps.etzhayyim.com.",
  "capabilities": {
    "@type": "DefinedTermSet",
    "name": "Capabilities",
    "terms": [
      {
        "@type": "DefinedTerm",
        "name": "App Directory",
        "description": "Browsable directory of all Etzhayyim apps with category filtering and search."
      },
      {
        "@type": "DefinedTerm",
        "name": "Category Navigation",
        "description": "Apple App Store style category taxonomy for organizing apps."
      }
    ]
  }
}
