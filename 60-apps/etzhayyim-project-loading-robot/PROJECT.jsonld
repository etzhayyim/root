{
  "@context": "https://schema.org",
  "@type": "Project",
  "name": "etzhayyim-project-loading-robot",
  "description": "Image-analysis-driven loading robot design and operations project for cargo, pallet, truck, container, and dock workflows.",
  "category": "manufacturing-logistics-robotics",
  "capabilities": [
    "image-analysis",
    "cargo-detection",
    "load-planning",
    "robot-cell-design",
    "mission-planning",
    "human-approval-gate",
    "kami-engine-3d-digital-twin",
    "robot-waypoint-json",
    "opcua-command",
    "ros2-action"
  ],
  "performers": [
    {
      "@type": "SoftwareApplication",
      "name": "loading-robot-bpmn",
      "deliveryMethod": "bpmn",
      "description": "BPMN workflows that connect vision analysis, load planning, robot cell design, and mission dispatch."
    },
    {
      "@type": "SoftwareApplication",
      "name": "kotodama-loading-robot-primitives",
      "deliveryMethod": "LangServer-worker",
      "description": "LangServer primitive tasks for loadingRobot.vision.analyze, loadingRobot.plan.load, loadingRobot.robot.design, and loadingRobot.mission.plan."
    },
    {
      "@type": "SoftwareApplication",
      "name": "kami-engine-loading-digital-twin",
      "deliveryMethod": "sdk",
      "description": "3D design target for dock, pallet, truck, container, robot arm, sensor, and safety-zone simulation."
    }
  ],
  "workflows": [
    "etzhayyim-root/00-contracts/bpmn/ai/etzhayyim/loading-robot/analyzeAndDesignLoadingRobot.bpmn",
    "etzhayyim-root/00-contracts/bpmn/ai/etzhayyim/loading-robot/executeLoadingMission.bpmn"
  ],
  "safety": {
    "defaultApprovalRequired": true,
    "humanPresenceRequiresReview": true,
    "supportedEmergencyStopPolicy": "stop-motion-drop-to-safe-hold"
  }
}
