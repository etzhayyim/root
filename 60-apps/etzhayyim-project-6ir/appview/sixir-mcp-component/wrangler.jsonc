{
  "name": "kotodama-xaji0y6d",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"listCompanies\",\"getCompany\",\"listFilings\",\"getFiling\",\"listEarnings\",\"submitAnalysis\",\"listAlerts\",\"searchCompanies\"]",
    "APP_DESCRIPTION": "6ir — 6-figure IR (investor relations) intelligence — company filings, earnings, analyst coverage",
    "APP_DISPLAY_NAME": "6-Figure IR",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "xaji0y6d",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "xaji0y6d.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "sixir.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
