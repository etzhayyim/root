<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- listCompanies -->
  <bpmn:process id="sixir-list-companies" name="6ir List Companies" isExecutable="true">
    <bpmn:startEvent id="start-list-companies"/>
    <bpmn:sequenceFlow id="sf-lc-1" sourceRef="start-list-companies" targetRef="task-list-companies"/>
    <bpmn:serviceTask id="task-list-companies" name="List Companies">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.sixir.listCompanies"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lc-2" sourceRef="task-list-companies" targetRef="end-list-companies"/>
    <bpmn:endEvent id="end-list-companies"/>
  </bpmn:process>

  <!-- getCompany -->
  <bpmn:process id="sixir-get-company" name="6ir Get Company" isExecutable="true">
    <bpmn:startEvent id="start-get-company"/>
    <bpmn:sequenceFlow id="sf-gc-1" sourceRef="start-get-company" targetRef="task-get-company"/>
    <bpmn:serviceTask id="task-get-company" name="Get Company">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.sixir.getCompany"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gc-2" sourceRef="task-get-company" targetRef="end-get-company"/>
    <bpmn:endEvent id="end-get-company"/>
  </bpmn:process>

  <!-- listFilings -->
  <bpmn:process id="sixir-list-filings" name="6ir List Filings" isExecutable="true">
    <bpmn:startEvent id="start-list-filings"/>
    <bpmn:sequenceFlow id="sf-lf-1" sourceRef="start-list-filings" targetRef="task-list-filings"/>
    <bpmn:serviceTask id="task-list-filings" name="List Filings">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.sixir.listFilings"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lf-2" sourceRef="task-list-filings" targetRef="end-list-filings"/>
    <bpmn:endEvent id="end-list-filings"/>
  </bpmn:process>

  <!-- getFiling -->
  <bpmn:process id="sixir-get-filing" name="6ir Get Filing" isExecutable="true">
    <bpmn:startEvent id="start-get-filing"/>
    <bpmn:sequenceFlow id="sf-gf-1" sourceRef="start-get-filing" targetRef="task-get-filing"/>
    <bpmn:serviceTask id="task-get-filing" name="Get Filing">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.sixir.getFiling"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gf-2" sourceRef="task-get-filing" targetRef="end-get-filing"/>
    <bpmn:endEvent id="end-get-filing"/>
  </bpmn:process>

  <!-- listEarnings -->
  <bpmn:process id="sixir-list-earnings" name="6ir List Earnings" isExecutable="true">
    <bpmn:startEvent id="start-list-earnings"/>
    <bpmn:sequenceFlow id="sf-le-1" sourceRef="start-list-earnings" targetRef="task-list-earnings"/>
    <bpmn:serviceTask id="task-list-earnings" name="List Earnings">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.sixir.listEarnings"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-le-2" sourceRef="task-list-earnings" targetRef="end-list-earnings"/>
    <bpmn:endEvent id="end-list-earnings"/>
