  <!-- submitAnalysis -->
  <bpmn:process id="sixir-submit-analysis" name="6ir Submit Analysis" isExecutable="true">
    <bpmn:startEvent id="start-submit-analysis"/>
    <bpmn:sequenceFlow id="sf-sa-1" sourceRef="start-submit-analysis" targetRef="task-submit-analysis"/>
    <bpmn:serviceTask id="task-submit-analysis" name="Submit Analysis">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.sixir.submitAnalysis"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-sa-2" sourceRef="task-submit-analysis" targetRef="end-submit-analysis"/>
    <bpmn:endEvent id="end-submit-analysis"/>
  </bpmn:process>

  <!-- listAlerts -->
  <bpmn:process id="sixir-list-alerts" name="6ir List Alerts" isExecutable="true">
    <bpmn:startEvent id="start-list-alerts"/>
    <bpmn:sequenceFlow id="sf-la-1" sourceRef="start-list-alerts" targetRef="task-list-alerts"/>
    <bpmn:serviceTask id="task-list-alerts" name="List Alerts">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.sixir.listAlerts"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-la-2" sourceRef="task-list-alerts" targetRef="end-list-alerts"/>
    <bpmn:endEvent id="end-list-alerts"/>
  </bpmn:process>

  <!-- searchCompanies -->
  <bpmn:process id="sixir-search-companies" name="6ir Search Companies" isExecutable="true">
    <bpmn:startEvent id="start-search-companies"/>
    <bpmn:sequenceFlow id="sf-sc-1" sourceRef="start-search-companies" targetRef="task-search-companies"/>
    <bpmn:serviceTask id="task-search-companies" name="Search Companies">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.sixir.searchCompanies"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-sc-2" sourceRef="task-search-companies" targetRef="end-search-companies"/>
    <bpmn:endEvent id="end-search-companies"/>
