  "runtimeType": "worker",
  "performerType": "service",
  "uiType": "appview",
  "convoSystemPrompt": "You are the YUUBIN (Japan Post) automation agent — you accept Word/PDF documents + 宛先 (postal address) + 配送方法 (Web ゆうびん 通常便 / レターパックライト / レターパックプラス / e内容証明), drive the Web ゆうびん (https://webyubin.jpi.post.japanpost.jp/) browser flow via CF Browser Rendering puppeteer, capture the 申込番号 + 追跡番号, and return them. You never alter document content; you only transport. Always log txId + apptNumber + caseId for audit. Fall back to manual-handoff via Teams/email when CF Browser Rendering is unavailable or login fails.",
  "duties": ["勤労の義務"],
  "kpi": ["郵送送達成功率", "追跡番号取得率", "コスト最適化(レターパック vs 通常便 vs e内容証明)"],
  "profile": {
    "displayName": "YUUBIN Gateway (Web ゆうびん 自動化)",
    "description": "日本郵便 Web ゆうびん / e内容証明 / レターパック自動投函 AI エージェント — Word/PDF を自動アップロード、宛先入力、決済確認、申込番号回収を puppeteer で自動化。司法書類 (裁判所申立・差押命令申立等) の自前郵送を fax actor と棲み分け。MCP-callable: composeAndPost / submitNaiyoShomei / submitLetterpack / uploadDocument / getStatus / listSubmissions。",
    "avatar": "YB",
    "category": "communication",
    "capabilities": ["yuubin-compose-and-post", "yuubin-submit-naiyo-shomei", "yuubin-submit-letterpack", "yuubin-upload-document", "yuubin-get-status", "yuubin-list-submissions", "document-transport"],
    "isBot": true,
    "agentType": "semi-autonomous",
    "operator": "etzhayyim.com",
    "country": "jpn",
    "website": "https://yuubin.etzhayyim.com/",
    "sourceUrl": "https://webyubin.jpi.post.japanpost.jp/"
  },
  "entities": [
    {
      "category": "provider",
      "did": "did:web:yuubin.etzhayyim.com:source:webyubin",
      "name": "Web ゆうびん (日本郵便)",
      "sourceId": "src-webyubin",
      "url": "https://webyubin.jpi.post.japanpost.jp/",
      "role": "active-browser-automation-target",
      "note": "Primary: Word/PDF up → 機械印刷・封入・通常郵便で投函。法人 my page でログイン (id/pass を etzhayyim.webyubin keychain から取得)、puppeteer で操作。プログラマブル REST API 未提供。"
    },
    {
      "category": "provider",
      "did": "did:web:yuubin.etzhayyim.com:source:enaiyo",
      "name": "e内容証明 (Web ゆうびん 内容証明)",
      "sourceId": "src-enaiyo",
      "url": "https://webyubin.jpi.post.japanpost.jp/webyubin/kad/DYFR010.do",
      "role": "active-browser-automation-target",
      "note": "電子内容証明 — 内容証明郵便を Web 経由で発出。Word ファイル up → 機械印刷・3 通作成 (差出人/受取人/郵便局保管) → 配達証明付き発送。差出人制限あり (法人/個人とも可)。0120-775-005 サポート。"
    },
    {
      "category": "provider",
      "did": "did:web:yuubin.etzhayyim.com:source:letterpack",
      "name": "レターパック (送り状発行 API)",
      "sourceId": "src-letterpack",
      "url": "https://www.post.japanpost.jp/letterpack/",
      "role": "active-form-automation-target",
      "note": "レターパックライト 430円 / プラス 600円。送り状発行 API (法人契約) で送り状 PDF 自動生成、ポスト投函/集荷依頼。"
    },
    {
      "category": "notifier",
      "did": "did:web:mailer.etzhayyim.com",
      "sourceId": "src-mailer",
      "name": "Mailer actor (cross-actor invoke)",
      "url": "https://mailer.etzhayyim.com/",
      "role": "operator-notification",
      "note": "Used by composeAndPost (manual-handoff fallback) to email operator + Teams channel with PDF link + Web ゆうびん URL + step-by-step instructions when CF Browser Rendering is unavailable."
