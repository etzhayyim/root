{
  "name": "magatama-pbhsahxt",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"createDashboard\",\"recordEvent\",\"listDashboards\",\"getDashboard\",\"listEvents\",\"getMetrics\",\"createReport\",\"listReports\"]",
    "APP_DESCRIPTION": "analytics — Analytics intelligence — metrics, dashboards, reports, funnel analysis",
    "APP_DISPLAY_NAME": "Analytics",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "pbhsahxt",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.gftd.ai/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "pbhsahxt.gftd.ai/*",
      "zone_name": "gftd.ai"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
