{
  "@context": {
    "@vocab": "https://schema.org/",
    "etzhayyim": "https://etzhayyim.com/ns/"
  },
  "@type": "SoftwareApplication",
  "@id": "https://etzhayyim.com/projects/etzhayyim-project-market",
  "name": "etzhayyim-project-market",
  "description": "Crypto market intelligence platform — transaction history tracking (KV-backed), CoinMarketCap-like market visualization, portfolio management, risk assessment, and resource-flow analysis for crypto assets.",
  "applicationCategory": "FinanceApplication",
  "etzhayyim:projectType": "market-intelligence",
  "etzhayyim:capabilities": [
    {
      "@type": "etzhayyim:Capability",
      "name": "crypto-transaction-history",
      "description": "Per-asset transaction history storage in NATS KV with buy/sell/transfer tracking"
    },
    {
      "@type": "etzhayyim:Capability",
      "name": "market-visualization",
      "description": "CoinMarketCap-like market board with real-time pricing, sparklines, and multi-asset-class support"
    },
    {
      "@type": "etzhayyim:Capability",
      "name": "portfolio-management",
      "description": "Portfolio tracking with holdings, PnL, allocation breakdown, and cost basis calculation"
    },
    {
      "@type": "etzhayyim:Capability",
      "name": "risk-assessment",
      "description": "Per-asset and portfolio-level risk scoring with volatility, liquidity, regulatory, and smart contract risk metrics"
    },
    {
      "@type": "etzhayyim:Capability",
      "name": "crypto-resource-flow",
      "description": "Visualization of crypto movement between exchanges, wallets, and DeFi protocols"
    }
  ],
  "etzhayyim:components": [
    {
      "@type": "etzhayyim:WasmComponent",
      "name": "global-ui-w5n8p3q6",
      "description": "Global UI component hosting market, portfolio, history, risk, and crypto-flow pages",
      "etzhayyim:project": "etzhayyim-project-global"
    }
  ],
  "etzhayyim:dataStorage": {
    "@type": "etzhayyim:KeyValueStore",
    "provider": "keyvalue-nats",
    "bucket": "global_crypto_history",
    "keyPrefix": "crypto.",
    "scope": "global"
  },
  "etzhayyim:externalAPIs": [
    {
      "@type": "etzhayyim:ExternalAPI",
      "name": "CoinGecko",
      "url": "https://api.coingecko.com/api/v3/",
      "purpose": "Market prices, market cap, volume, sparkline data"
    },
    {
      "@type": "etzhayyim:ExternalAPI",
      "name": "DEXScreener",
      "url": "https://api.dexscreener.com/",
      "purpose": "DEX pair pricing and liquidity data"
    }
  ],
  "etzhayyim:routes": [
    "/markets/ — CoinMarketCap-like market board",
    "/markets/portfolio/ — Crypto portfolio with holdings and PnL",
    "/markets/history/ — Transaction history timeline",
    "/markets/risk/ — Risk assessment dashboard",
    "/crypto-flow/ — Crypto resource flow visualization"
  ]
}
