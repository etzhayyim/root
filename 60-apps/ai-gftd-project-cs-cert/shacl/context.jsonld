{
  "@context": {
    "@version": 1.1,
    "schema": "https://schema.org/",
    "prov": "http://www.w3.org/ns/prov#",
    "gftd": "https://resources.gftd.ai/ontology#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "identifier": "schema:identifier",
    "url": "schema:url",
    "name": "schema:name",
    "description": "schema:description",
    "generatedAtTime": "prov:generatedAtTime",
    "certLevel": "gftd:certLevel",
    "certStatus": "gftd:certStatus",
    "issuedAt": "gftd:issuedAt",
    "expiresAt": "gftd:expiresAt",
    "validityDays": "gftd:validityDays",
    "subjectDomain": "gftd:subjectDomain",
    "subjectOrgName": "gftd:subjectOrgName",
    "assessmentId": "gftd:assessmentId",
    "assessorId": "gftd:assessorId",
    "checksCompleted": "gftd:checksCompleted",
    "checksFailed": "gftd:checksFailed",
    "overallScore": "gftd:overallScore",
    "findings": "gftd:findings",
    "findingSeverity": "gftd:findingSeverity",
    "findingCategory": "gftd:findingCategory",
    "findingStatus": "gftd:findingStatus",
    "badgeFormat": "gftd:badgeFormat",
    "badgeColor": "gftd:badgeColor",
    "embedScript": "gftd:embedScript",
    "verificationUrl": "gftd:verificationUrl"
  }
}
