{
  "@context": "https://schema.org/",
  "@type": "Project",
  "name": "ETZHAYYIM Kyber Gateway (etzhayyim-project-gateway)",
  "status": "In Progress",
  "identifier": "etzhayyim-project-gateway",
  "description": "A centralized gateway for the ETZHAYYIM Kyber ecosystem, providing unified authentication (Clerk), threat defense (IP blocking/WAF), caching, and observation feeds (logging to Analytics).",
  "hasPart": [
    {
      "@type": "CreativeWork",
      "name": "Strategy",
      "url": "STRATEGY.jsonld"
    },
    {
      "@type": "CreativeWork",
      "name": "Capabilities",
      "url": "capabilities.jsonld"
    },
    {
      "@type": "CreativeWork",
      "name": "Activities",
      "url": "activities.jsonld"
    },
    {
      "@type": "CreativeWork",
      "name": "Architecture",
      "url": "ARCHITECTURE.jsonld"
    }
  ],
  "tasks": [
    {
      "status": "completed",
      "id": "task-1",
      "content": "Design Gateway architecture with Envoy Gateway API and Clerk integration."
    },
    {
      "status": "completed",
      "id": "task-2",
      "content": "Implement Auth Proxy Actor for Clerk JWT validation."
    },
    {
      "status": "completed",
      "id": "task-3",
      "content": "Configure Envoy ALS (Access Log Service) to stream logs to Web Analytics Actor."
    },
    {
      "status": "in_progress",
      "id": "task-4",
      "content": "Apply security policies for IP blocking and rate limiting."
    }
  ],
  "performers": [
    {
      "@type": "Service",
      "name": "Auth Proxy Actor",
      "identifier": "etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-svc-auth-proxy",
      "description": "Sidecar/Service for validating Clerk JWTs and injecting user context."
    },
    {
      "@type": "Service",
      "name": "Security Guard Actor",
      "identifier": "etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-svc-security-guard",
      "description": "Actor for managing IP blocklists and threat intelligence."
    }
  ],
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "ARCHITECTURE.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "dct": "http://purl.org/dc/terms/"
          },
          "id": "https://etzhayyim.com/projects/etzhayyim-project-gateway/architecture",
          "type": "dodaf:Architecture",
          "dct:title": "Gateway Architecture (SV-4)",
          "components": [
            {
              "name": "Envoy Gateway (Control Plane)",
              "description": "Manages Gateway API resources and configures the data plane."
            },
            {
              "name": "Envoy Proxy (Data Plane)",
              "description": "High-performance proxy that handles actual traffic."
            },
            {
              "name": "Auth Proxy Actor (Go)",
              "description": "Sidecar service for Clerk-based authentication."
            },
            {
              "name": "Access Log Service (ALS) Integration",
              "description": "Direct bridge between Envoy and Analytics Actor."
            }
          ],
          "dataFlows": [
            {
              "from": "Internet",
              "to": "Envoy Proxy",
              "protocol": "HTTPS"
            },
            {
              "from": "Envoy Proxy",
              "to": "Auth Proxy Actor",
              "protocol": "gRPC (ExtAuthz)"
            },
            {
              "from": "Envoy Proxy",
              "to": "Internal App (etzhayyim-performers-org-org_34dKrNTTK3cNixZzHIzzFwLw1s4)",
              "protocol": "HTTP"
            },
            {
              "from": "Envoy Proxy",
              "to": "Analytics Actor",
              "protocol": "gRPC (ALS)"
            }
          ]
        }
      },
      {
        "fileName": "activities.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "dct": "http://purl.org/dc/terms/"
          },
          "id": "https://etzhayyim.com/projects/etzhayyim-project-gateway/activities",
          "type": "dodaf:OperationalActivity",
          "dct:title": "Gateway Activities (OV-5b)",
          "activities": [
            {
              "id": "A1",
              "name": "Identity Verification",
              "description": "Checking JWT validity and user permissions for every incoming request."
            },
            {
              "id": "A2",
              "name": "Traffic Inspection",
              "description": "Analyzing request patterns for DDoS or exploit attempts."
            },
            {
              "id": "A3",
              "name": "Metric/Log Export",
              "description": "Asynchronously pushing traffic data to the central Analytics service."
            },
            {
              "id": "A4",
              "name": "Routing & Load Balancing",
              "description": "Directing traffic to appropriate internal services based on hostname/path."
            }
          ]
        }
      },
      {
        "fileName": "capabilities.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "dct": "http://purl.org/dc/terms/"
          },
          "id": "https://etzhayyim.com/projects/etzhayyim-project-gateway/capabilities",
          "type": "dodaf:Capability",
          "dct:title": "Gateway Capability Catalog (CV-2)",
          "capabilities": [
            {
              "id": "C1",
              "name": "Edge Authentication",
              "description": "Unified authentication using Clerk at the edge (Envoy ExtAuthz)."
            },
            {
              "id": "C2",
              "name": "Intelligent Threat Defense",
              "description": "Proactive blocking of malicious IPs and WAF-like protection."
            },
            {
              "id": "C3",
              "name": "Unified Observability Feed",
              "description": "Streaming structured access logs from all applications to the Analytics ecosystem."
            },
            {
              "id": "C4",
              "name": "Global Caching & Optimization",
              "description": "Performance enhancement through edge caching and header optimization."
            }
          ]
        }
      },
      {
        "fileName": "scheduler.jsonld",
        "content": {
          "@context": [
            "https://schema.org/",
            {
              "etzhayyim": "https://etzhayyim.com/schemas/",
