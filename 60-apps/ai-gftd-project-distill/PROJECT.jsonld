{
  "@context": "https://schema.org",
  "@type": "Project",
  "name": "GFTD Knowledge Distillation",
  "identifier": "ai-gftd-project-distill",
  "description": "Multi-model knowledge distillation: Claude Opus 4.6 to Qwen3-VL-8B via MLX QLoRA. Produces 4 philosophically-distinct models.",
  "hasPart": [
    {
      "@type": "SoftwareApplication",
      "name": "gftd-distill",
      "identifier": "gftd-distill",
      "url": "app/",
      "description": "FastAPI + legacy runtime Actors service for MLX QLoRA distillation"
    }
  ],
  "performers": [
    {
      "@type": "Service",
      "name": "gftd-distill",
      "identifier": "gftd-distill",
      "description": "Knowledge distillation worker: dataset generation, QLoRA training, evaluation, model export, HuggingFace push"
    }
  ],
  "models": [
    {
      "@type": "CreativeWork",
      "name": "gftd-260213",
      "description": "Well-becoming model integrating GFTD philosophy",
      "url": "https://huggingface.co/gftd/gftd-260213"
    },
    {
      "@type": "CreativeWork",
      "name": "maxwell-260213",
      "description": "Maxwell electromagnetic field reasoning model",
      "url": "https://huggingface.co/gftd/maxwell-260213"
    },
    {
      "@type": "CreativeWork",
      "name": "landauer-260213",
      "description": "Landauer information-is-physical computation model",
      "url": "https://huggingface.co/gftd/landauer-260213"
    },
    {
      "@type": "CreativeWork",
      "name": "whitehead-260213",
      "description": "Whitehead process philosophy model",
      "url": "https://huggingface.co/gftd/whitehead-260213"
    }
  ],
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "scheduler.jsonld",
        "content": {
          "@context": [
            "https://schema.org/",
            {
              "gftd": "https://gftd.ai/schemas/",
              "capabilities": "gftd:capabilities",
              "survivalIndicators": "gftd:survivalIndicators",
              "scheduler": "gftd:scheduler",
              "milestones": "gftd:milestones",
              "blockers": "gftd:blockers",
              "dependsOn": {
                "@id": "gftd:dependsOn",
                "@type": "@id"
              },
              "ingestKey": "gftd:ingestKey",
              "window": "gftd:window",
              "valueUpdatedAt": "gftd:valueUpdatedAt"
            }
          ],
          "@type": "CreativeWork",
          "name": "GFTD Knowledge Distillation Scheduler",
          "identifier": "ai-gftd-project-distill/scheduler",
          "description": "Project schedule (milestones) and blockers.",
          "dateCreated": "2026-02-15T04:25:26+00:00",
          "milestones": [],
          "blockers": []
        }
      }
    ]
  }
}
