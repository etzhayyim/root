{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "etzhayyim-yadoya",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "account_id": "4da88288dc30d9ee257f319d3c33ecf0",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "yadoya.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "vars": {
    "APP_HANDLE": "yadoya.etzhayyim.com",
    "PRIMARY_DID": "did:web:yadoya.etzhayyim.com",
    "ERC725_ROOT_DID": "",
    "ERC725_ROOT_IDENTITY_ADDR": "",
    "APP_DISPLAY_NAME": "Yadoya — Autonomous Hotel Search & Reservation",
    "APP_DESCRIPTION": "Hotel search & reservation platform (AI Agent MCP + B2C + B2B). 16 langs, ISIC I5510, ADR-0028 hospitality bridge.",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "APP_MCP_REGISTRY": "1",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
