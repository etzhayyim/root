{
  "@context": [
    "https://schema.org/",
    {
      "etzhayyim": "https://etzhayyim.com/ns/",
      "apqc": "https://www.apqc.org/pcf/",
      "isic": "https://unstats.un.org/unsd/classifications/Econ/ISIC/",
      "isco": "https://www.ilo.org/public/english/bureau/stat/isco/"
    }
  ],
  "@type": "Project",
  "name": "Yadoya — Autonomous Hotel Search & Reservation Platform",
  "identifier": "etzhayyim-project-yadoya",
  "description": "Hotel search and reservation platform. AI Agent (MCP) + human (Web) dual-channel. Global catalog with 16-language coverage, APQC/ISIC/ISCO process taxonomy.",
  "url": "https://yadoya.etzhayyim.com",
  "status": "In Progress",
  "dateCreated": "2026-02-22",
  "dateModified": "2026-02-28",
  "etzhayyim:businessPlan": {
    "@type": "etzhayyim:BusinessPlan",
    "version": "1.0.0",
    "datePublished": "2026-02-28",
    "etzhayyim:vision": "世界中の宿泊施設を AI Agent と人間の両方が検索・予約できる自律型プラットフォーム。MCP ツール経由で AI Agent が直接予約操作を行い、Web UI で人間ユーザーがビジュアルに検索・予約を行う。プロセス標準 (APQC/ISIC/ISCO) によりホテル業務を構造化し、wRPC mesh で他の ETZHAYYIM サービスと連携する。",
    "etzhayyim:missionStatement": "Provide a unified, AI-agent-ready hotel discovery and booking experience across 7 global regions and 16 languages, with structured process taxonomy and zero-vendor-lock-in architecture.",
    "etzhayyim:targetMarket": [
      {
        "@type": "etzhayyim:MarketSegment",
        "name": "AI Agent 経由の自律予約",
        "description": "MCP protocol 対応 AI Agent が宿泊施設の検索・比較・予約を自律的に実行。ChatGPT/Claude/Gemini などの LLM Agent からのツール呼び出し。",
        "priority": "primary"
      },
      {
        "@type": "etzhayyim:MarketSegment",
        "name": "法人出張管理 (Corporate Travel)",
        "description": "APQC プロセスフレームワークに基づく出張宿泊の一元管理。組織承認フロー・予算管理・コンプライアンス。",
        "priority": "primary"
      },
      {
        "@type": "etzhayyim:MarketSegment",
        "name": "個人旅行者 (B2C Direct)",
        "description": "多言語対応 Web UI による直接検索・予約。yadoya.etzhayyim.com から 16 言語で世界のホテルを検索。",
        "priority": "secondary"
      },
      {
        "@type": "etzhayyim:MarketSegment",
        "name": "旅行代理店 API 連携 (B2B API)",
        "description": "Connect gRPC API 経由での在庫照会・一括予約。ホワイトラベル対応。",
        "priority": "tertiary"
      }
    ],
    "etzhayyim:revenueModel": [
      {
        "@type": "etzhayyim:RevenueStream",
        "name": "アフィリエイト手数料",
        "description": "予約成立時にホテル公式サイトからのアフィリエイトコミッション (3-12%)",
        "phase": "Phase 2"
      },
      {
        "@type": "etzhayyim:RevenueStream",
        "name": "MCP API 利用料",
        "description": "AI Agent からの MCP ツール呼び出し課金 (検索: 無料, 予約: 従量)",
        "phase": "Phase 3"
      },
      {
        "@type": "etzhayyim:RevenueStream",
        "name": "法人サブスクリプション",
        "description": "組織単位の出張管理ダッシュボード + 承認フロー + レポート",
        "phase": "Phase 4"
      },
      {
        "@type": "etzhayyim:RevenueStream",
        "name": "プレミアムデータ API",
        "description": "ホテル在庫・価格データのリアルタイムフィード (B2B 向け)",
        "phase": "Phase 4"
      }
    ],
    "etzhayyim:competitiveAdvantage": [
      "MCP/cross-actor 対応で AI Agent から直接予約可能 (業界初のネイティブ対応)",
      "APQC/ISIC/ISCO プロセス標準によるホテル業務の構造化 (監査・コンプライアンス対応)",
      "SpinApp + wRPC による vendor-lock-in 回避とエッジ分散",
      "16 言語ネイティブ対応 (翻訳 API 依存なし)",
      "R2 Custom Domain による低レイテンシ静的配信 + API 分離アーキテクチャ"
    ],
    "etzhayyim:kpi": [
      {
        "metric": "Monthly Active Hotels (MAH)",
        "target": "500+",
        "phase": "Phase 2"
      },
      {
        "metric": "MCP Tool Calls / month",
        "target": "10,000+",
        "phase": "Phase 3"
      },
      {
        "metric": "Booking Conversion Rate",
        "target": "2.5%+",
        "phase": "Phase 2"
      },
      {
        "metric": "Language Coverage",
        "target": "16 languages",
        "phase": "Phase 1 (achieved)"
      },
      {
        "metric": "Region Coverage",
        "target": "7 continents",
        "phase": "Phase 1 (achieved)"
      },
      {
        "metric": "API Uptime",
        "target": "99.9%",
        "phase": "Phase 2"
      }
    ]
  },
  "etzhayyim:implementationPlan": {
    "@type": "etzhayyim:ImplementationPlan",
    "etzhayyim:phases": [
      {
        "phase": "Phase 1 — Foundation (MVP)",
        "status": "completed",
        "dateCompleted": "2026-02-22",
        "deliverables": [
          "SpinApp component (yadoya-ui-b7r4n2xq) deployed to spinkube",
          "Static catalog: 20 hotels across 7 regions (Asia, Europe, Middle East, N/S America, Africa, Oceania)",
          "16-language i18n (en, ja, es, fr, de, pt, it, ru, zh, ko, ar, hi, bn, tr, id, vi)",
          "MCP tools: search, list, reserve, heartbeat, scheduler, process-map",
          "APQC/ISIC/ISCO process taxonomy mapping",
          "Auto-collection scheduler (interval-based health check probing)",
          "Static HTML frontend (vanilla JS, responsive grid)",
          "WADM manifest + CDN route (yadoya.etzhayyim.com)"
        ]
      },
      {
        "phase": "Phase 2 — Persistence & Scale",
        "status": "in_progress",
        "targetDate": "2026-Q2",
        "deliverables": [
          "NATS KV persistence for hotel catalog (replace in-memory hotelCatalog[])",
          "NATS KV persistence for reservations (replace in-memory reservationStore)",
          "Performer framework migration (packages/go/performer adapter)",
          "SvelteKit frontend (replace static/index.html with proper Svelte app)",
          "Per-site R2 bucket (yadoya-etzhayyim-ai) for SSG/API separation",
          "Connect gRPC API (proto/etzhayyim/yadoya/v1/yadoya.proto)",
          "Real-time price collection via wasi:http/outgoing-handler",
          "Hotel catalog expansion: 100+ properties",
          "Affiliate link integration (official hotel sites)",
          "etzhayyim.json deploy config",
          "Clerk JWT authentication for user/org scoping"
        ]
      },
      {
        "phase": "Phase 3 — wRPC Mesh & AI Agent Gateway",
        "status": "planned",
        "targetDate": "2026-Q3",
        "deliverables": [
          "WIT interface: etzhayyim:yadoya/booking@0.1.0 (search, reserve, cancel, list-reservations)",
          "WIT interface: etzhayyim:yadoya/catalog@0.1.0 (list-hotels, get-hotel, update-catalog)",
          "wRPC provider export (other components can import yadoya booking)",
          "MCP Gateway integration (performers-gateway-provider wRPC dispatch)",
          "cross-actor protocol support (Agent-to-Agent for multi-step booking workflows)",
          "Cross-service wRPC links: yadoya → calendar (check-in reminders), yadoya → mailer (confirmation)",
          "Payment gateway integration (Stripe Connect)",
          "Hotel catalog: 500+ properties with live pricing"
        ]
      },
      {
        "phase": "Phase 4 — Enterprise & B2B",
        "status": "planned",
        "targetDate": "2026-Q4",
        "deliverables": [
          "Organization-scoped booking management (Clerk org_id → KV boundary)",
          "Approval workflow (APQC 2.x sales intake → manager approval → booking)",
          "Travel policy enforcement (budget limits, preferred hotels, blackout dates)",
          "Reporting dashboard (booking analytics, spend by org/dept)",
          "B2B API (bulk search, allocation holds, group bookings)",
          "ISCO job-family linked concierge/support staffing model",
          "Hotel partner portal (inventory management, rate updates)"
        ]
      }
    ],
    "etzhayyim:architecture": {
      "runtime": "SpinApp (TinyGo WASM component)",
      "namespace": "spinkube",
      "component": "yadoya-ui-b7r4n2xq",
      "nanoid": "b7r4n2xq",
      "port": 8164,
      "domain": "yadoya.etzhayyim.com",
      "apiEndpoint": "https://{nanoid}.etzhayyim.com/api/grpc",
      "cdnBucket": "yadoya-etzhayyim-ai",
      "kvBucket": "yadoya-store",
      "componentTopology": {
        "description": "Phase 2+ component decomposition",
        "components": [
          {
            "name": "yadoya-ui-b7r4n2xq",
            "role": "API + Frontend entry point",
            "world": "etzhayyim-mcp (Phase 1) → etzhayyim-component (Phase 2)",
            "port": 8164,
            "capabilities": [
              "http-server",
              "http-client",
              "keyvalue-nats"
            ]
          }
        ],
        "wRPCLinks": [
          {
            "from": "yadoya-ui-b7r4n2xq",
            "to": "calendar-component",
            "interface": "etzhayyim:calendar/calendar@0.1.0",
            "purpose": "Check-in reminder scheduling",
            "phase": "Phase 3"
          },
          {
            "from": "yadoya-ui-b7r4n2xq",
            "to": "mailer-component",
            "interface": "etzhayyim:notify/notifier@0.1.0",
            "purpose": "Booking confirmation email",
            "phase": "Phase 3"
          },
          {
            "from": "any-consumer",
            "to": "yadoya-ui-b7r4n2xq",
            "interface": "etzhayyim:yadoya/booking@0.1.0",
            "purpose": "External components search/book hotels via wRPC",
            "phase": "Phase 3"
          }
        ]
      },
      "dataFlow": [
        "Browser → yadoya.etzhayyim.com (R2 Custom Domain) → static HTML/JS/CSS",
        "Browser → 1.etzhayyim.com/api/grpc → Envoy Gateway → SpinApp component",
        "AI Agent → MCP tools (yadoya.search_hotels, yadoya.create_reservation, ...)",
        "Scheduler → wasi:http/outgoing-handler → hotel official sites (price collection)",
        "Component → wasi:keyvalue/store → NATS KV (yadoya-store)"
      ]
    }
  },
