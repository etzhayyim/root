{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://app-reviewer.etzhayyim.com/ontology#",
    "id": "@id",
    "type": "@type",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "label": "rdfs:label",
    "comment": "rdfs:comment",
    "subClassOf": {
      "@id": "rdfs:subClassOf",
      "@type": "@id"
    },
    "domain": {
      "@id": "rdfs:domain",
      "@type": "@id"
    },
    "range": {
      "@id": "rdfs:range",
      "@type": "@id"
    }
  },
  "@id": "https://app-reviewer.etzhayyim.com/capabilities/ontology",
  "@type": "owl:Ontology",
  "label": "App Reviewer Ontology",
  "comment": "Core classes and properties for app publication review",
  "@graph": [
    {
      "@id": "https://app-reviewer.etzhayyim.com/ontology#ReviewSubmission",
      "@type": "owl:Class",
      "label": "Review Submission",
      "comment": "Submission under review"
    },
    {
      "@id": "https://app-reviewer.etzhayyim.com/ontology#AutomatedCheck",
      "@type": "owl:Class",
      "label": "Automated Check",
      "comment": "Machine-executed validation check"
    },
    {
      "@id": "https://app-reviewer.etzhayyim.com/ontology#ReviewFinding",
      "@type": "owl:Class",
      "label": "Review Finding",
      "comment": "Detected issue with severity and category"
    },
    {
      "@id": "https://app-reviewer.etzhayyim.com/ontology#ReviewDecision",
      "@type": "owl:Class",
      "label": "Review Decision",
      "comment": "Final reviewer decision for submission"
    },
    {
      "@id": "https://app-reviewer.etzhayyim.com/ontology#CapabilityProfile",
      "@type": "owl:Class",
      "label": "Capability Profile",
      "comment": "Declared app capabilities and permissions"
    },
    {
      "@id": "https://app-reviewer.etzhayyim.com/ontology#hasCheck",
      "@type": "owl:ObjectProperty",
      "domain": {
        "@id": "https://app-reviewer.etzhayyim.com/ontology#ReviewSubmission"
      },
      "range": {
        "@id": "https://app-reviewer.etzhayyim.com/ontology#AutomatedCheck"
      },
      "label": "has check",
      "comment": "Submission includes automated check records"
    },
    {
      "@id": "https://app-reviewer.etzhayyim.com/ontology#hasFinding",
      "@type": "owl:ObjectProperty",
      "domain": {
        "@id": "https://app-reviewer.etzhayyim.com/ontology#ReviewSubmission"
      },
      "range": {
        "@id": "https://app-reviewer.etzhayyim.com/ontology#ReviewFinding"
      },
      "label": "has finding",
      "comment": "Submission includes findings"
    },
    {
      "@id": "https://app-reviewer.etzhayyim.com/ontology#hasDecision",
      "@type": "owl:ObjectProperty",
      "domain": {
        "@id": "https://app-reviewer.etzhayyim.com/ontology#ReviewSubmission"
      },
      "range": {
        "@id": "https://app-reviewer.etzhayyim.com/ontology#ReviewDecision"
      },
      "label": "has decision",
      "comment": "Submission has final decision"
    },
    {
      "@id": "https://app-reviewer.etzhayyim.com/ontology#declaresCapabilityProfile",
      "@type": "owl:ObjectProperty",
      "domain": {
        "@id": "https://app-reviewer.etzhayyim.com/ontology#ReviewSubmission"
      },
      "range": {
        "@id": "https://app-reviewer.etzhayyim.com/ontology#CapabilityProfile"
      },
      "label": "declares capability profile",
      "comment": "Submission references declared capability profile"
    }
  ]
}
