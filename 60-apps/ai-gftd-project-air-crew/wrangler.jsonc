{
  "name": "magatama-a1rcr3w0",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"publishRoster\",\"buildPairing\",\"trackQualification\"]",
    "APP_DESCRIPTION": "air-crew — airline crew management and scheduling. Handles roster publication, pairing construction, qualification tracking, fatigue assessment, crew assignment, crew travel, duty time recording, and crew notifications.",
    "APP_DISPLAY_NAME": "Air Crew Management",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "a1rcr3w0",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.gftd.ai/xrpc/ai.gftd.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "a1rcr3w0.gftd.ai/*",
      "zone_name": "gftd.ai"
    },
    {
      "pattern": "air-crew.gftd.ai/*",
      "zone_name": "gftd.ai"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
