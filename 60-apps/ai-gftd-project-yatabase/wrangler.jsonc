{
  "name": "magatama-y4t4b4se",
  "main": "src/app.ts",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "assets": {
    "directory": "./svelte/build",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_CAPABILITIES": "null",
    "APP_DESCRIPTION": "Real-time graph DB + Supabase-style object storage. PG / SPARQL / S3-compat / XRPC / MCP — one bill, BWA-free egress.",
    "APP_DISPLAY_NAME": "Yatabase",
    "APP_EMBED_URL": "https://yatabase.etzhayyim.com/embed",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "y4t4b4se",
    "APP_PERFORMER_TYPE": "",
    "APP_UI_TYPE": "appview",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/app.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "y4t4b4se.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "yatabase.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "triggers": {
    // "0 */6 * * *"  — HN scraper (cron === "0 */6 * * *")
    // "30 */6 * * *" — lead enrichment (cron === "30 */6 * * *")
    // "45 */6 * * *" — GitHub stargazers (cron === "45 */6 * * *")
    // "0 8 * * *"    — day-7 retention email (P45)
    // "15 */6 * * *" — usage-alert batch (P50)
    "crons": [
      "0 */6 * * *",
      "30 */6 * * *",
      "45 */6 * * *",
      "0 8 * * *",
      "15 */6 * * *"
    ]
  }
}
