        }
      },
      {
        "fileName": "uiux.jsonld",
        "content": {
          "@context": "https://schema.org/",
          "@type": "CreativeWork",
          "name": "Cybersec ERP UI/UX Design",
          "description": "iPad-first dashboard design for ERP management within the Cybersecurity Division.",
          "etzhayyim:designPrinciples": [
            "Apple Human Interface Guidelines compliance",
            "iPad-optimized layout (Multi-window support)",
            "High-contrast security indicators",
            "Real-time resource monitoring visualizations"
          ],
          "etzhayyim:uiComponents": [
            {
              "name": "Resource Overview Dashboard",
              "type": "Dashboard",
              "features": [
                "Resource allocation charts",
                "Budget tracking",
                "Security status cards"
              ]
            },
            {
              "name": "Audit Logging View",
              "type": "List",
              "features": [
                "Compliance score",
                "Audit trail",
                "Flagged issues"
              ]
            }
          ],
          "etzhayyim:uxFlows": [
            {
              "name": "Resource Planning Flow",
              "steps": [
                "Input project details",
                "Allocate resources",
                "Review security compliance",
                "Submit plan"
              ]
            }
          ]
        }
      }
    ]
  }
}
