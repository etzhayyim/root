<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- listVideos -->
  <bpmn:process id="videos-legacy-list-videos" name="Videos Legacy List Videos" isExecutable="true">
    <bpmn:startEvent id="start-list-videos"/>
    <bpmn:sequenceFlow id="sf-lv-1" sourceRef="start-list-videos" targetRef="task-list-videos"/>
    <bpmn:serviceTask id="task-list-videos" name="List Videos">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.videosLegacy.list.videos"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lv-2" sourceRef="task-list-videos" targetRef="end-list-videos"/>
    <bpmn:endEvent id="end-list-videos"/>
  </bpmn:process>

  <!-- getVideo -->
  <bpmn:process id="videos-legacy-get-video" name="Videos Legacy Get Video" isExecutable="true">
    <bpmn:startEvent id="start-get-video"/>
    <bpmn:sequenceFlow id="sf-gv-1" sourceRef="start-get-video" targetRef="task-get-video"/>
    <bpmn:serviceTask id="task-get-video" name="Get Video">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.videosLegacy.get.video"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gv-2" sourceRef="task-get-video" targetRef="end-get-video"/>
    <bpmn:endEvent id="end-get-video"/>
  </bpmn:process>

  <!-- migrateVideo -->
  <bpmn:process id="videos-legacy-migrate-video" name="Videos Legacy Migrate Video" isExecutable="true">
    <bpmn:startEvent id="start-migrate-video"/>
    <bpmn:sequenceFlow id="sf-mv-1" sourceRef="start-migrate-video" targetRef="task-migrate-video"/>
    <bpmn:serviceTask id="task-migrate-video" name="Migrate Video">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.videosLegacy.migrate.video"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-mv-2" sourceRef="task-migrate-video" targetRef="end-migrate-video"/>
    <bpmn:endEvent id="end-migrate-video"/>
  </bpmn:process>

  <!-- listChannels -->
  <bpmn:process id="videos-legacy-list-channels" name="Videos Legacy List Channels" isExecutable="true">
    <bpmn:startEvent id="start-list-channels"/>
    <bpmn:sequenceFlow id="sf-lc-1" sourceRef="start-list-channels" targetRef="task-list-channels"/>
    <bpmn:serviceTask id="task-list-channels" name="List Channels">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.videosLegacy.list.channels"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lc-2" sourceRef="task-list-channels" targetRef="end-list-channels"/>
    <bpmn:endEvent id="end-list-channels"/>
  </bpmn:process>

  <!-- getChannel -->
  <bpmn:process id="videos-legacy-get-channel" name="Videos Legacy Get Channel" isExecutable="true">
    <bpmn:startEvent id="start-get-channel"/>
    <bpmn:sequenceFlow id="sf-gc-1" sourceRef="start-get-channel" targetRef="task-get-channel"/>
    <bpmn:serviceTask id="task-get-channel" name="Get Channel">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.videosLegacy.get.channel"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gc-2" sourceRef="task-get-channel" targetRef="end-get-channel"/>
    <bpmn:endEvent id="end-get-channel"/>
  </bpmn:process>

  <!-- searchVideos -->
  <bpmn:process id="videos-legacy-search-videos" name="Videos Legacy Search Videos" isExecutable="true">
    <bpmn:startEvent id="start-search-videos"/>
    <bpmn:sequenceFlow id="sf-sv-1" sourceRef="start-search-videos" targetRef="task-search-videos"/>
    <bpmn:serviceTask id="task-search-videos" name="Search Videos">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.videosLegacy.search.videos"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-sv-2" sourceRef="task-search-videos" targetRef="end-search-videos"/>
    <bpmn:endEvent id="end-search-videos"/>
  </bpmn:process>

  <!-- getMetadata -->
  <bpmn:process id="videos-legacy-get-metadata" name="Videos Legacy Get Metadata" isExecutable="true">
    <bpmn:startEvent id="start-get-metadata"/>
    <bpmn:sequenceFlow id="sf-gm-1" sourceRef="start-get-metadata" targetRef="task-get-metadata"/>
    <bpmn:serviceTask id="task-get-metadata" name="Get Metadata">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.videosLegacy.get.metadata"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gm-2" sourceRef="task-get-metadata" targetRef="end-get-metadata"/>
    <bpmn:endEvent id="end-get-metadata"/>
  </bpmn:process>

  <!-- listPlaylists -->
  <bpmn:process id="videos-legacy-list-playlists" name="Videos Legacy List Playlists" isExecutable="true">
    <bpmn:startEvent id="start-list-playlists"/>
    <bpmn:sequenceFlow id="sf-lp-1" sourceRef="start-list-playlists" targetRef="task-list-playlists"/>
    <bpmn:serviceTask id="task-list-playlists" name="List Playlists">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.videosLegacy.list.playlists"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lp-2" sourceRef="task-list-playlists" targetRef="end-list-playlists"/>
    <bpmn:endEvent id="end-list-playlists"/>
  </bpmn:process>

</bpmn:definitions>
