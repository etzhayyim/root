{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": "https://etzhayyim.com",
  "name": "etzhayyim-project-etzhayyim",
  "description": "Etzhayyim corporate website (etzhayyim.com)",
  "url": "https://etzhayyim.com",
  "applicationCategory": "Website",
  "operatingSystem": "Kubernetes",
  "author": {
    "@type": "Organization",
    "name": "etzhayyim",
    "url": "https://etzhayyim.com"
  },
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "news-agents-workflow.jsonld",
        "content": {
          "raw": "{\n  \"@context\": [\n    \"https://schema.org/\",\n    {\n      \"etzhayyim\": \"https://etzhayyim.com/schemas/\",\n      \"prov\": \"http://www.w3.org/ns/prov#\",\n      \"dependsOn\": {\n        \"@id\": \"etzhayyim:dependsOn\",\n        \"@type\": \"@id\"\n      },\n      \"pattern\": \"etzhayyim:agentPattern\",\n      \"schedule\": \"etzhayyim:schedule\",\n      \"cron\": \"etzhayyim:cron\",\n      \"maxRetries\": \"etzhayyim:maxRetries\",\n      \"timeout\": \"etzhayyim:timeout\",\n      \"fanOut\": \"etzhayyim:fanOut\",\n      \"qualityGate\": \"etzhayyim:qualityGate\",\n      \"publishTarget\": \"etzhayyim:publishTarget\",\n      \"dedupeKey\": \"etzhayyim:dedupeKey\"\n    }\n  ],\n  \"@type\": \"CreativeWork\",\n  \"name\": \"News Pipeline App agents Workflow\",\n  \"identifier\": \"etzhayyim-project-etzhayyim/news-agents-workflow\",\n  \"description\": \"App scheduler + App agents workflow design for collection, drafting, fact-checking, translation, and publishing.\",\n  \"pattern\": [\n    \"OrchestratorWorker\",\n    \"SequentialWorkflow\",\n    \"Parallelization\",\n    \"EvaluatorOptimizer\"\n  ],\n  \"schedule\": {\n    \"@type\": \"Schedule\",\n    \"name\": \"NewsDailyAndBreakingSchedule\",\n    \"cron\": [\n      \"0 */6 * * *\",\n      \"15 8 * * *\"\n    ],\n    \"description\": \"Every 6 hours for rolling updates and daily editorial batch at 08:15 JST.\"\n  },\n  \"@graph\": [\n    {\n      \"@id\": \"NewsOrchestratorAgent\",\n      \"@type\": \"SoftwareApplication\",\n      \"name\": \"news-orchestrator-agent\",\n      \"pattern\": \"OrchestratorWorker\",\n      \"description\": \"Entry-point agent triggered by scheduler. Builds candidate topics, enforces idempotency, and dispatches article pipelines.\",\n      \"dedupeKey\": \"topic+source+date\",\n      \"maxRetries\": 3,\n      \"timeout\": \"10m\",\n      \"implementation\": [\n        \"legacy-runtime/news-scheduler-go/cmd/server/main.go\",\n        \"legacy-runtime/news-scheduler-go/internal/pipeline/pipeline.go#Run\"\n      ]\n      \"timeout\": \"10m\"\n    },\n    {\n      \"@id\": \"NewsCollectorAgent\",\n      \"@type\": \"SoftwareApplication\",\n      \"name\": \"news-collector-agent\",\n      \"pattern\": \"Parallelization\",\n      \"description\": \"Collects candidate sources in parallel from RSS/API/search connectors, then normalizes metadata.\",\n      \"fanOut\": \"by-source\",\n      \"maxRetries\": 2,\n      \"timeout\": \"5m\",\n      \"prov:wasInformedBy\": \"NewsOrchestratorAgent\",\n      \"implementation\": [\n        \"legacy-runtime/news-scheduler-go/internal/pipeline/pipeline.go#collectArticles\"\n      ]\n      \"prov:wasInformedBy\": \"NewsOrchestratorAgent\"\n    },\n    {\n      \"@id\": \"NewsWriterAgent\",\n      \"@type\": \"SoftwareApplication\",\n      \"name\": \"news-writer-agent\",\n      \"pattern\": \"SequentialWorkflow\",\n      \"description\": \"Produces structured first draft with citations, headline options, and social excerpt.\",\n      \"maxRetries\": 2,\n      \"timeout\": \"8m\",\n      \"prov:wasInformedBy\": \"NewsCollectorAgent\",\n      \"implementation\": [\n        \"legacy-runtime/news-scheduler-go/internal/pipeline/pipeline.go#writeDraft\"\n      ]\n      \"prov:wasInformedBy\": \"NewsCollectorAgent\"\n    },\n    {\n      \"@id\": \"NewsFactCheckerAgent\",\n      \"@type\": \"SoftwareApplication\",\n      \"name\": \"news-factchecker-agent\",\n      \"pattern\": \"EvaluatorOptimizer\",\n      \"description\": \"Scores factual consistency against source evidence and requests rewrite when score is below threshold.\",\n      \"qualityGate\": {\n        \"scoreMin\": 0.85,\n        \"maxLoops\": 2\n      },\n      \"maxRetries\": 2,\n      \"timeout\": \"6m\",\n      \"prov:wasInformedBy\": \"NewsWriterAgent\",\n      \"implementation\": [\n        \"legacy-runtime/news-scheduler-go/internal/pipeline/pipeline.go#factCheck\"\n      ]\n      \"prov:wasInformedBy\": \"NewsWriterAgent\"\n    },\n    {\n      \"@id\": \"NewsTranslatorAgent\",\n      \"@type\": \"SoftwareApplication\",\n      \"name\": \"news-translator-agent\",\n      \"pattern\": \"Parallelization\",\n      \"description\": \"Translates approved draft in parallel for target locales and back-checks terminology consistency.\",\n      \"fanOut\": [\n        \"ja\",\n        \"en\"\n      ],\n      \"maxRetries\": 2,\n      \"timeout\": \"6m\",\n      \"prov:wasInformedBy\": \"NewsFactCheckerAgent\",\n      \"implementation\": [\n        \"legacy-runtime/news-scheduler-go/internal/pipeline/pipeline.go#translateDraft\"\n      ]\n      \"prov:wasInformedBy\": \"NewsFactCheckerAgent\"\n    },\n    {\n      \"@id\": \"NewsPublisherAgent\",\n      \"@type\": \"SoftwareApplication\",\n      \"name\": \"news-publisher-agent\",\n      \"pattern\": \"SequentialWorkflow\",\n      \"description\": \"Publishes to CMS and invalidates CDN cache when publication checks pass.\",\n      \"publishTarget\": \"etzhayyim.com/news\",\n      \"maxRetries\": 3,\n      \"timeout\": \"5m\",\n      \"prov:wasInformedBy\": \"NewsTranslatorAgent\",\n      \"implementation\": [\n        \"legacy-runtime/news-scheduler-go/internal/pipeline/pipeline.go#publish\"\n      ]\n    }\n  ],\n  \"implementation\": [\n    \"legacy-runtime/news-scheduler-go/cmd/server/main.go\",\n    \"legacy-runtime/news-scheduler-go/internal/pipeline/pipeline.go\",\n    \"legacy-runtime/news-scheduler-go/cmd/register-jobs/main.go\"\n      \"prov:wasInformedBy\": \"NewsTranslatorAgent\"\n    }\n  ]\n}\n"
        }
      },
      {
        "fileName": "scheduler.jsonld",
        "content": {
          "@context": [
            "https://schema.org/",
            {
              "etzhayyim": "https://etzhayyim.com/schemas/",
              "capabilities": "etzhayyim:capabilities",
              "survivalIndicators": "etzhayyim:survivalIndicators",
              "scheduler": "etzhayyim:scheduler",
              "milestones": "etzhayyim:milestones",
              "blockers": "etzhayyim:blockers",
              "dependsOn": {
                "@id": "etzhayyim:dependsOn",
                "@type": "@id"
              },
              "ingestKey": "etzhayyim:ingestKey",
              "window": "etzhayyim:window",
              "valueUpdatedAt": "etzhayyim:valueUpdatedAt"
            }
          ],
          "@type": "CreativeWork",
          "name": "etzhayyim-project-etzhayyim Scheduler",
          "identifier": "etzhayyim-project-etzhayyim/scheduler",
          "description": "Project schedule (milestones) and blockers.",
          "dateCreated": "2026-02-15T04:25:26+00:00",
          "milestones": [
            {
              "@type": "DefinedTerm",
              "identifier": "news-orchestrator-workflow-definition",
              "name": "Define legacy runtime agents workflow for News",
              "description": "Adopt Orchestrator/Worker with sequential editorial pipeline and parallel translation.",
              "dependsOn": [
                "etzhayyim-project-etzhayyim/news-agents-workflow"
              ],
              "implementation": [
                "legacy-runtime/news-scheduler-go/cmd/server/main.go",
                "legacy-runtime/news-scheduler-go/internal/pipeline/pipeline.go"
              ]
            },
            {
              "@type": "DefinedTerm",
              "identifier": "news-scheduler-job-registration",
              "name": "Register periodic scheduler jobs",
              "description": "Configure recurring jobs for daily batch and 6-hour rolling updates.",
              "dependsOn": [
                "news-orchestrator-workflow-definition"
              ],
              "implementation": [
                "legacy-runtime/news-scheduler-go/cmd/register-jobs/main.go"
              ]
            },
            {
              "@type": "DefinedTerm",
              "identifier": "news-factcheck-quality-gates",
              "name": "Enable fact-check quality gate",
              "description": "Use evaluator-optimizer loop with retry budget and score threshold before publication.",
              "dependsOn": [
                "news-scheduler-job-registration"
              ]
            }
          ],
          "blockers": [
            {
              "@type": "DefinedTerm",
              "identifier": "news-source-connector-credentials",
              "name": "Source connector credentials",
              "description": "RSS/API credentials and rate-limit policies for article collection connectors are required."
            },
            {
              "@type": "DefinedTerm",
              "identifier": "news-cms-publish-token",
              "name": "CMS publish token",
              "description": "Publisher agent needs CMS write scope and CDN cache invalidation permissions."
            }
          ]
        }
      }
    ]
  }
}
