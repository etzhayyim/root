{
  "default": {
    "import": [
      "step-definitions/**/*.ts",
      "support/**/*.ts"
    ],
    "paths": [
      "features/**/*.feature"
    ],
    "format": [
      "summary",
      "progress-bar",
      [
        "html",
        "reports/cucumber-report.html"
      ]
    ],
    "formatOptions": {
      "snippetInterface": "async-await"
    }
  }
}
