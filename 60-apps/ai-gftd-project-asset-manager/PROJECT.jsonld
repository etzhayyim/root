  "@type": "dodaf:AV-1",
  "gftd:projectId": "ai-gftd-project-asset-manager",
  "gftd:performerId": "8l9df0cy",
  "gftd:name": "Asset Manager",
  "gftd:description": "Unified asset operations management — orchestrates asset lifecycle (acquire, operate, maintain, dispose) across APQC business processes, ISIC industry sectors, and ISCO occupation roles via wRPC mesh.",
  "gftd:domain": "asset-operations",
  "gftd:capabilities": [
    {
      "@type": "dodaf:CV-1",
      "gftd:name": "Asset Lifecycle Management",
      "gftd:description": "Register, classify, transition, and dispose assets through governed lifecycle stages."
    },
    {
      "@type": "dodaf:CV-1",
      "gftd:name": "Portfolio Optimization",
      "gftd:description": "Aggregate and optimize asset portfolios across real estate, financial, physical, IT, and digital classes."
    },
    {
      "@type": "dodaf:CV-1",
      "gftd:name": "Investment Evaluation",
      "gftd:description": "NPV/IRR/payback analysis with integrated risk scoring for capital budgeting decisions."
    },
    {
      "@type": "dodaf:CV-1",
      "gftd:name": "Cross-Classification Orchestration",
      "gftd:description": "Route asset operations to appropriate APQC processes, ISIC industry actors, and ISCO occupation roles."
    },
    {
      "@type": "dodaf:CV-1",
      "gftd:name": "Maintenance Scheduling",
      "gftd:description": "Preventive, corrective, and predictive maintenance scheduling with ISCO-based technician allocation."
    }
  ],
  "gftd:classificationMapping": {
    "apqc": {
      "primary": "9 — Acquire, Construct, and Manage Assets",
