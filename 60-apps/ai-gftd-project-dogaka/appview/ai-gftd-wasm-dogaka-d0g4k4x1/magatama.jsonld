{
  "@context": "https://etzhayyim.com/ns/magatama/v1",
  "@id": "did:web:dogaka.etzhayyim.com",
  "component": {
    "env": {
      "APP_EMBED_MODE": "viewport",
      "B2_ENDPOINT": "s3.us-west-004.backblazeb2.com",
      "B2_BUCKET": "ai-gftd-cdn",
      "B2_REGION": "us-west-004"
    },
    "path": "component.wasm"
  },
  "convoSystemPrompt": "You are ai-gftd-wasm-dogaka agent. 3D cinematic video creation platform powered by KAMI Engine + the 8-stage kami-cine pipeline (world model -> USD scene -> neural geometry -> 4D temporal field -> neural render -> diffusion pass -> EXR sequence -> final encode). Help users author shots, sequences, and full cinematic deliverables. Respond helpfully in the users language.",
  "deploy": {},
  "duties": ["勤労の義務"],
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": ["dogaka-policy"]
  },
  "kpi": ["credits の獲得"],
  "name": "ai-gftd-wasm-dogaka",
  "nanoid": "d0g4k4x1",
  "performerType": "service",
  "profile": {
    "agentType": "semi-autonomous",
    "capabilities": [
      "shot-management",
      "usd-scene-graph",
      "neural-geometry",
      "temporal-field",
      "neural-render",
      "diffusion-cinematic",
      "exr-composite",
      "final-encode"
    ],
    "description": "3D cinematic video appview -- author USD shots and render through the 8-stage kami-cine neural pipeline.",
    "displayName": "Dogaka",
    "isBot": true
  },
  "project": "dogaka",
  "routes": [
    {
      "host": "dogaka.etzhayyim.com",
      "paths": ["/"],
      "tls": true
    }
  ],
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "description": "Public cinematic feed -- new shots, sequences, finalized takes",
        "kind": "public",
        "name": "dogaka-feed"
      }
    ],
    "description": "3D cinematic video creation platform powered by KAMI Engine + kami-cine pipeline",
    "historyVisibility": "world-readable",
    "joinRule": "public",
    "name": "Dogaka"
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.graph.follow",
        "ai.gftd.apps.dogaka.project",
        "ai.gftd.apps.dogaka.sequence",
        "ai.gftd.apps.dogaka.shot",
        "ai.gftd.apps.dogaka.asset",
        "ai.gftd.apps.dogaka.cameraPath",
        "ai.gftd.apps.dogaka.take",
        "ai.gftd.apps.dogaka.chatMessage",
        "ai.gftd.apps.cine.worldModel",
        "ai.gftd.apps.cine.usdScene",
        "ai.gftd.apps.cine.neuralGeom",
        "ai.gftd.apps.cine.temporalField",
        "ai.gftd.apps.cine.neuralRender",
        "ai.gftd.apps.cine.diffusionPass",
        "ai.gftd.apps.cine.exrSeq",
        "ai.gftd.apps.cine.encode"
      ]
    }
  },
  "uiType": "appview"
}
