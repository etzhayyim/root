  "schema:name": "ai-gftd-project-advectors",
  "schema:description": "LLM-first ad operations project for grounded creative submission and policy-aware delivery on advectors.etzhayyim.com",
  "dodaf:capability": [
    {
      "@type": "dodaf:Capability",
      "schema:name": "Grounded Text Ad Submission",
      "schema:description": "Build text ad drafts that explicitly reference publisher context snippets and source URLs"
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Publisher-Aware Image Prompt Generation",
      "schema:description": "Generate image-creative prompts that inject publisher content signals into generation instructions"
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Ad Delivery and Event Collection",
      "schema:description": "Serve registered creatives and collect impression/click telemetry"
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Split Routing on advectors.etzhayyim.com",
      "schema:description": "Route submission and delivery paths to dedicated SpinApp components"
    }
  ],
  "dodaf:performer": [
    {
      "@type": "dodaf:Performer",
      "schema:name": "advectors-submit-mcp-component",
