      "gftd:serviceEndpoint": "https://advectors.etzhayyim.com/api/v1/submit"
    },
    {
      "@type": "dodaf:Performer",
      "schema:name": "advectors-delivery-mcp-component",
      "schema:description": "Delivery endpoint and telemetry facade for serving approved creatives",
      "gftd:nanoid": "dz7q1n8r",
      "gftd:mcpEndpoint": "https://dz7q1n8r.etzhayyim.com/api/mcp",
      "gftd:serviceEndpoint": "https://advectors.etzhayyim.com/api/v1/serve"
    }
  ],
