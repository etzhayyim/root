<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- uploadVideo -->
  <bpmn:process id="videos-upload-video" name="Videos Upload Video" isExecutable="true">
    <bpmn:startEvent id="start-upload-video"/>
    <bpmn:sequenceFlow id="sf-uv-1" sourceRef="start-upload-video" targetRef="task-upload-video"/>
    <bpmn:serviceTask id="task-upload-video" name="Upload Video">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.videos.uploadVideo"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-uv-2" sourceRef="task-upload-video" targetRef="end-upload-video"/>
    <bpmn:endEvent id="end-upload-video"/>
  </bpmn:process>

  <!-- getVideo -->
  <bpmn:process id="videos-get-video" name="Videos Get Video" isExecutable="true">
    <bpmn:startEvent id="start-get-video"/>
    <bpmn:sequenceFlow id="sf-gv-1" sourceRef="start-get-video" targetRef="task-get-video"/>
    <bpmn:serviceTask id="task-get-video" name="Get Video">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.videos.getVideo"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gv-2" sourceRef="task-get-video" targetRef="end-get-video"/>
    <bpmn:endEvent id="end-get-video"/>
  </bpmn:process>

  <!-- updateVideo -->
  <bpmn:process id="videos-update-video" name="Videos Update Video" isExecutable="true">
    <bpmn:startEvent id="start-update-video"/>
    <bpmn:sequenceFlow id="sf-upv-1" sourceRef="start-update-video" targetRef="task-update-video"/>
    <bpmn:serviceTask id="task-update-video" name="Update Video">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.videos.updateVideo"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-upv-2" sourceRef="task-update-video" targetRef="end-update-video"/>
    <bpmn:endEvent id="end-update-video"/>
  </bpmn:process>

  <!-- deleteVideo -->
  <bpmn:process id="videos-delete-video" name="Videos Delete Video" isExecutable="true">
    <bpmn:startEvent id="start-delete-video"/>
    <bpmn:sequenceFlow id="sf-dv-1" sourceRef="start-delete-video" targetRef="task-delete-video"/>
    <bpmn:serviceTask id="task-delete-video" name="Delete Video">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.videos.deleteVideo"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-dv-2" sourceRef="task-delete-video" targetRef="end-delete-video"/>
    <bpmn:endEvent id="end-delete-video"/>
  </bpmn:process>

  <!-- listVideos -->
  <bpmn:process id="videos-list-videos" name="Videos List Videos" isExecutable="true">
    <bpmn:startEvent id="start-list-videos"/>
    <bpmn:sequenceFlow id="sf-lv-1" sourceRef="start-list-videos" targetRef="task-list-videos"/>
    <bpmn:serviceTask id="task-list-videos" name="List Videos">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.videos.listVideos"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lv-2" sourceRef="task-list-videos" targetRef="end-list-videos"/>
    <bpmn:endEvent id="end-list-videos"/>
  </bpmn:process>

  <!-- transcodeVideo -->
  <bpmn:process id="videos-transcode-video" name="Videos Transcode Video" isExecutable="true">
    <bpmn:startEvent id="start-transcode-video"/>
    <bpmn:sequenceFlow id="sf-tv-1" sourceRef="start-transcode-video" targetRef="task-transcode-video"/>
    <bpmn:serviceTask id="task-transcode-video" name="Transcode Video">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.videos.transcodeVideo"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-tv-2" sourceRef="task-transcode-video" targetRef="end-transcode-video"/>
    <bpmn:endEvent id="end-transcode-video"/>
  </bpmn:process>

  <!-- publishVideo -->
  <bpmn:process id="videos-publish-video" name="Videos Publish Video" isExecutable="true">
    <bpmn:startEvent id="start-publish-video"/>
    <bpmn:sequenceFlow id="sf-pv-1" sourceRef="start-publish-video" targetRef="task-publish-video"/>
    <bpmn:serviceTask id="task-publish-video" name="Publish Video">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.videos.publishVideo"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-pv-2" sourceRef="task-publish-video" targetRef="end-publish-video"/>
    <bpmn:endEvent id="end-publish-video"/>
  </bpmn:process>

  <!-- videoStats -->
  <bpmn:process id="videos-video-stats" name="Videos Video Stats" isExecutable="true">
    <bpmn:startEvent id="start-video-stats"/>
    <bpmn:sequenceFlow id="sf-vs-1" sourceRef="start-video-stats" targetRef="task-video-stats"/>
    <bpmn:serviceTask id="task-video-stats" name="Video Stats">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.videos.videoStats"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-vs-2" sourceRef="task-video-stats" targetRef="end-video-stats"/>
    <bpmn:endEvent id="end-video-stats"/>
  </bpmn:process>

</bpmn:definitions>
