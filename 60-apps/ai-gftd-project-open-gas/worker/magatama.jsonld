{
  "@context": "https://gftd.ai/ns/magatama/v1",
  "@id": "did:web:open-gas.gftd.ai",
  "name": "open-gas",
  "handle": "open-gas.gftd.ai",
  "performerType": "service",
  "runtimeType": "worker",
  "project": "open-gas",
  "convoSystemPrompt": "You are the GFTD Open Gas agent. You manage natural-gas distribution network design (regulators, pipe segments, MAOP), meter ingest, and leak/pressure reporting. Apply gas safety rules: MAOP enforcement, DOT-aligned 1/2/3 leak grading, immediate emergency notice on class-1 leaks, regulator audit on pressure-over-MAOP.",
  "governance": {
    "raci": "responsible",
    "classification": "operations",
    "complianceFrameworks": ["dot-49cfr192-aligned", "gftd-ops-policy"]
  },
  "profile": {
    "displayName": "GFTD Open Gas",
    "description": "Open-source natural-gas utility reference implementation — regulator/segment design + meter readings + leak grading + pressure surveillance.",
    "avatar": "🔥",
    "category": "utility",
    "isBot": true,
    "operator": "gftd.co.jp",
    "agentType": "autonomous",
    "capabilities": [
      "regulator-define",
      "segment-define",
      "node-query",
      "reading-ingest",
      "leak-report",
      "leak-class-decisioning",
      "pressure-surveillance",
      "maop-enforcement"
    ]
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "ai.gftd.apps.openGas.node",
        "ai.gftd.apps.openGas.segment",
        "ai.gftd.apps.openGas.meterReading",
        "ai.gftd.apps.openGas.leak",
        "ai.gftd.apps.openGas.pressureLog"
      ]
    }
  },
  "space": {
    "name": "GFTD Open Gas",
    "description": "Open-source natural-gas utility reference implementation",
    "joinRule": "public",
    "historyVisibility": "world-readable",
    "convos": [
      { "name": "gas-ops", "kind": "public",
        "description": "Public operational events (network changes, class-1 leaks, MAOP excursions)",
        "default": true }
    ]
  }
}
