{
  "name": "kotodama-otch0001",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"bpmn-dispatch\",\"createSequence\",\"getSequence\",\"listSequences\",\"addProspect\",\"addDnc\"]",
    "APP_DESCRIPTION": "Sales Outreach Automation — LangGraph research→draft loop + DNC gate + Resend multi-step sequence + reply detection via gmail/m365Ingest.",
    "APP_DISPLAY_NAME": "etzhayyim Sales Outreach",
    "APP_EMBED_URL": "https://otch0001.etzhayyim.com/?embed=1",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "otch0001",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "appview",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "routes": [
    {
      "pattern": "otch0001.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "outreach.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
