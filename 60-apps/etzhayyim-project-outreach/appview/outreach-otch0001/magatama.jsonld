{
  "@context": "https://magatama.etzhayyim.com/ns/v1",
  "@type": "MagatamaApp",
  "nanoid": "otch0001",
  "name": "outreach",
  "displayName": "Etzhayyim Sales Outreach",
  "description": "Sales Outreach Automation — LangGraph research→draft loop + DNC gate + Resend multi-step sequence + reply detection via gmail/m365Ingest.",
  "did": "did:web:outreach.etzhayyim.com",
  "domain": "outreach.etzhayyim.com",
  "performerType": "service",
  "uiType": "appview",
  "runtimeType": "ts-thin-edge",
  "bpmn": "etzhayyim-root/00-contracts/bpmn/com/etzhayyim/outreach",
  "routes": [
    { "pattern": "otch0001.etzhayyim.com/*", "zone_name": "etzhayyim.com" },
    { "pattern": "outreach.etzhayyim.com/*", "zone_name": "etzhayyim.com" }
  ],
  "subscribeRepos": [
    {
      "collection": "com.etzhayyim.apps.gmail.message",
      "description": "Reply detection from Gmail ingest — correlate thread to active outreach sequence"
    },
    {
      "collection": "com.etzhayyim.apps.m365Ingest.email",
      "description": "Reply detection from M365 ingest — correlate thread to active outreach sequence"
    }
  ],
  "capabilities": [
    "com.etzhayyim.apps.outreach.createSequence",
    "com.etzhayyim.apps.outreach.getSequence",
    "com.etzhayyim.apps.outreach.listSequences",
    "com.etzhayyim.apps.outreach.addProspect",
    "com.etzhayyim.apps.outreach.addDnc"
  ],
  "integrations": {
    "ads": "com.etzhayyim.apps.ads.createCampaign",
    "email": "resend",
    "replyIngest": ["com.etzhayyim.apps.gmail.message", "com.etzhayyim.apps.m365Ingest.email"]
  },
  "piiPolicy": {
    "tier": 3,
    "sensitivity_ord": 3,
    "fields": ["email", "prospectName", "title", "company"],
    "adr": "ADR-0018"
  }
}
