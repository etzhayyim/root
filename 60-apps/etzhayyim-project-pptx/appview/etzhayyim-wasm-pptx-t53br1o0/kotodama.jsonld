{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:pptx.etzhayyim.com",
  "component": {
    "env": {},
    "path": "component.wasm"
  },
  "convoSystemPrompt": "You are etzhayyim-wasm-pptx agent. PowerPoint editor — upload, edit via WebGPU/KAMI Engine, and export PPTX presentations. Kagami graph persistence with DuckDB-WASM client reads. Respond helpfully in the users language.",
  "deploy": {},
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": [
      "document-management-policy"
    ]
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "etzhayyim-wasm-pptx",
  "nanoid": "t53br1o0",
  "performerType": "service",
  "profile": {
    "agentType": "semi-autonomous",
    "capabilities": [
      "presentation-management",
      "slide-editing",
      "presentation-search",
      "image-conversion",
      "content-extraction"
    ],
    "description": "PowerPoint editor — upload, edit (WebGPU/KAMI Engine), export, image-to-shape conversion, content extraction.",
    "displayName": "PPTX Editor",
    "isBot": true
  },
  "project": "pptx",
  "routes": [
    {
      "host": "pptx.etzhayyim.com",
      "paths": [
        "/"
      ],
      "tls": true
    }
  ],
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "description": "Public presentation feed — shared slides and highlights",
        "kind": "public",
        "name": "pptx-feed"
      }
    ],
    "description": "PowerPoint editor — PPTX upload, WebGPU editing, export",
    "historyVisibility": "world-readable",
    "joinRule": "public",
    "name": "PPTX Editor"
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.graph.follow",
        "com.etzhayyim.apps.pptx.presentation",
        "com.etzhayyim.apps.pptx.slide",
        "com.etzhayyim.apps.pptx.shape",
        "com.etzhayyim.apps.pptx.textRun",
        "com.etzhayyim.apps.pptx.image",
        "com.etzhayyim.apps.pptx.slideTemplate"
      ]
    }
  },
  "uiType": "appview",
  "embedUrl": "https://t53br1o0.etzhayyim.com/embed"
}
