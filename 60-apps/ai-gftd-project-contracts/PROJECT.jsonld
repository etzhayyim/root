{
  "@context": "https://gftd.ai/schema/",
  "@type": "gftd:Project",
  "@id": "ai-gftd-project-contracts",
  "name": "Global Contracts Knowledge Base",
  "description": "全世界の契約情報を JSON-LD として構造化・管理するプロジェクト。Social contract、組織、自然人などを含む包括的な契約データベース。",
  "category": "knowledge",
  "capabilities": [
    "CV-1: Contract Knowledge Management",
    "CV-2: Global Organization Registry",
    "CV-3: Social Contract Tracking",
    "CV-4: Legal Entity Resolution"
  ],
  "performers": [
    {
      "@type": "gftd:AIActor",
      "@id": "contracts-crawler",
      "activity": "Contract data collection and normalization"
    },
    {
      "@type": "gftd:System",
      "@id": "contracts-api",
      "activity": "Contract data API service"
    }
  ],
  "dataSources": [
    "ai-gftd-project-crawler",
    "OpenCorporates",
    "GLEIF (Legal Entity Identifier)",
    "Government contract registries",
    "Social contract repositories"
  ],
  "publishedTo": [
    "ai-gftd-project-public-global"
  ],
  "maintainers": [
    "gftd.ai platform team"
  ],
  "version": "0.1.0",
  "created": "2026-02-17T00:00:00Z",
  "updated": "2026-02-17T00:00:00Z"
}
