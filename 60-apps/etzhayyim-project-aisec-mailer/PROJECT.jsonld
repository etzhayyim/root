  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "AUDIT-GFTD-AI.jsonld",
        "content": {
          "@context": "https://schema.org/",
          "@type": "AuditReport",
          "name": "Autonomous Security Audit: gftd.ai",
          "datePublished": "2026-01-20",
          "author": {
            "@type": "Organization",
            "name": "AI-SEC Mailer Design Actor"
          },
          "about": {
            "@type": "Organization",
            "name": "gftdcojp",
            "url": "https://gftd.ai"
          },
          "auditResult": [
            {
              "category": "SPF",
              "status": "Pass",
              "details": "Authorized senders correctly listed in DNS."
            },
            {
              "category": "DKIM",
              "status": "Pass",
              "details": "Cryptographic signatures active."
            },
            {
              "category": "DMARC",
              "status": "Warning",
              "details": "Policy set to p=none. Vulnerable to sophisticated BEC that mimics context rather than domain.",
              "recommendation": "Activate AI-SEC Mailer for context-aware interception."
            }
          ],
          "monetaryImpact": "Estimated risk of BEC loss: 50M JPY/year based on current industry trends."
        }
      },
      {
        "fileName": "STRATEGY-GROWTH.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "dct": "http://purl.org/dc/terms/",
            "gftd": "https://gftd.ai/schemas/",
            "id": "@id",
            "type": "@type"
          },
          "id": "https://gftd.ai/projects/ai-gftd-project-aisec-mailer/strategy/growth",
          "type": "dodaf:Strategy",
          "dct:title": "AI-SEC Mailer: Autonomous Growth Strategy (Design, Sales, Marketing)",
          "dct:description": "Strategic framework for zero-human growth through autonomous agents.",
          "gftd:growth_loop": [
            {
              "step": "1. Market Intelligence",
              "activity": "Find companies with vulnerable email configurations (e.g., weak SPF/DKIM/DMARC) using Browser Automation.",
              "performer": "svc-apqc-1-1-market-intelligence"
            },
            {
              "step": "2. Autonomous Outreach",
              "activity": "Send personalized security audit reports generated by AI to decision makers.",
              "performer": "svc-apqc-2-0-autonomous-sales"
            },
            {
              "step": "3. Self-Closing Sales",
              "activity": "Negotiate and close deals via Stripe Payment Links and eSignature.",
              "performer": "svc-apqc-2-1-sales-negotiation"
            },
            {
              "step": "4. Product Evolution",
              "activity": "Analyze intercepted attacks to update security models and generate new marketing case studies.",
              "performer": "svc-cpc-843-design-reificator"
            }
          ]
        }
      },
      {
        "fileName": "STRATEGY.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "dct": "http://purl.org/dc/terms/",
            "gftd": "https://gftd.ai/schemas/",
            "id": "@id",
            "type": "@type"
          },
          "id": "https://gftd.ai/projects/ai-gftd-project-aisec-mailer/strategy",
          "type": "dodaf:Strategy",
          "dct:title": "AI-SEC Mailer: 100B JPY Autonomous Growth Strategy",
          "dct:description": "Strategy to achieve 100B JPY monthly revenue by automating email security for 20M users with zero human operations.",
          "gftd:phases": [
            {
              "name": "Phase 1: Zero-Touch Onboarding",
              "focus": "Enable instant subscription via Stripe Payment Links. No sales team, no manual invoicing.",
              "implementation": "Direct redirect to Stripe Checkout from the Business Portal."
            },
            {
              "name": "Phase 2: Autonomous Interception",
              "focus": "Automate O365 integration via OAuth. AI actors handle all filtering decisions.",
              "keyActors": [
                "svc-apqc-8-3-outlook-integration",
                "svc-apqc-3-1-2-intelligence-email"
              ]
            },
            {
              "name": "Phase 3: Hyper-Scale Settlement",
              "focus": "Monthly recurring revenue (MRR) handled entirely by Stripe. Failed payments trigger automatic service suspension via K8s/GitOps.",
              "keyActors": [
                "svc-apqc-9-4-1-financial-core"
              ]
            }
          ],
          "gftd:monetization": {
            "model": "SaaS Subscription",
            "pricePerUser": "500 JPY/month",
            "targetUsers": 200000000,
            "paymentMethod": "Stripe (Direct URL Integration)"
          }
        }
      },
      {
        "fileName": "activities-growth.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "dct": "http://purl.org/dc/terms/",
