          "dct:title": "Operational Activities (OV-5b) for Autonomous Growth",
          "dct:description": "Growth loop activities for AI-SEC Mailer.",
          "@graph": [
            {
              "id": "activity:growth:market_scan",
              "type": "dodaf:OperationalActivity",
              "name": "Global Security Posture Scanning",
              "apqcId": "1.1.1",
              "description": "Scan global domains for email security vulnerabilities to identify potential leads."
            },
            {
              "id": "activity:growth:content_generation",
              "type": "dodaf:OperationalActivity",
              "name": "Autonomous Marketing Content Gen",
              "apqcId": "1.2.2",
              "description": "Generate marketing materials based on real-world BEC attack interceptions (Observations)."
            },
            {
              "id": "activity:growth:automated_closing",
              "type": "dodaf:OperationalActivity",
              "name": "Autonomous Closing & Settlement",
              "apqcId": "2.1.4",
              "description": "Automatically finalize contracts and confirm payment via Stripe."
            },
            {
              "id": "activity:design:lookalike_detection",
              "type": "dodaf:OperationalActivity",
              "name": "Implement Lookalike Domain Detection",
              "description": "Enhanced security feature triggered by BEC Observation 0.85.",
              "status": "In Development",
              "performer": "ai-gftd-performer-sys-gftd-actors-pba7d22f-svc-apqc-3-1-2-intelligence-email-epb47ybv"
            },
            {
              "id": "activity:ops:autonomous_provisioning",
              "type": "dodaf:OperationalActivity",
              "name": "Autonomous Tenant Provisioning",
              "description": "Trigger GitOps deployment of customer-specific security actors upon Stripe payment confirmation.",
              "performer": "ai-gftd-performer-sys-gftd-actors-pba7d22f-svc-apqc-1-1-growth-engine"
            }
          ]
        }
      },
