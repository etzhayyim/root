{
  "@context": "https://1.gftd.ai/project",
  "@type": "Project",
  "name": "ai-gftd-project-gyotaku",
  "description": "Time-series web archive project integrated with crawler and Common Crawl range retrieval",
  "category": "ai-gftd-project-workers",
  "components": {
    "app": {
      "appId": "gyotaku-mcp",
      "tier": "event-driven",
      "stack": "go",
      "keda": false,
      "routes": [
        {
          "host": "gftd.ai",
          "paths": [
            "/gy0taku1/api/grpc"
          ]
        },
        {
          "host": "gyotaku.gftd.ai",
          "paths": [
            "/api/grpc"
          ]
        }
      ]
    }
  }
}
