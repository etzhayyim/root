{
  "name": "magatama-k4b100m1",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"hypha-routing\",\"anastomosis-gate\",\"nutrient-flow-query\"]",
    "APP_DESCRIPTION": "kabi (カビ) — mycelium network layer. Manages hypha routing, anastomosis compatibility gates, and nutrient flow channels between kobo agents.",
    "APP_DISPLAY_NAME": "Kabi Mycelium Network",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "k4b100m1",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.gftd.ai/xrpc/ai.gftd.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "k4b100m1.gftd.ai/*",
      "zone_name": "gftd.ai"
    },
    {
      "pattern": "kabi.gftd.ai/*",
      "zone_name": "gftd.ai"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
