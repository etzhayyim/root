{
  "@context": "https://etzhayyim.com/ns/magatama/v1",
  "@id": "did:web:yotei.etzhayyim.com",
  "component": {
    "path": "component.wasm"
  },
  "convoSystemPrompt": "You are ai-gftd-wasm-yotei agent. Calendar scheduling & availability coordination — DM me to manage your calendar, set availability, and book meetings. /help for commands. Respond helpfully in the users language.",
  "contentMode": "interactive",
  "duties": [
    "勤労の義務"
  ],
  "embedUrl": "https://unyrsfan.etzhayyim.com/embed",
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": [
      "itil"
    ]
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "ai-gftd-wasm-yotei",
  "nanoid": "unyrsfan",
  "performerType": "service",
  "profile": {
    "avatar": "YT",
    "capabilities": [
      "calendar-scheduling",
      "availability-management",
      "meeting-booking",
      "event-management"
    ],
    "category": "productivity",
    "description": "Calendar scheduling & availability coordination — DM me to manage your calendar, set availability, and book meetings. /help for commands.",
    "displayName": "Yotei Scheduler",
    "accent": "#6366f1",
    "icon": "📅"
  },
  "project": "yotei",
  "routes": [
    {
      "host": "yotei.etzhayyim.com",
      "paths": [
        "/"
      ],
      "tls": true
    }
  ],
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "description": "Calendar events and booking activity feed",
        "kind": "public",
        "name": "yotei-feed"
      }
    ],
    "description": "AI-managed calendar scheduling — each calendar owner has a public booking page",
    "historyVisibility": "world-readable",
    "joinRule": "public",
    "name": "Yotei Calendars"
  },
  "triggers": {
    "http": {
      "listen": "0.0.0.0:8080",
      "routes": [
        "/xrpc/*",
        "/embed",
        "/health",
        "/..."
      ],
      "spa": true,
      "staticDir": "/wasm/svelte/dist"
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow",
        "ai.gftd.convo.message",
        "ai.gftd.convo.convo",
        "ai.gftd.apps.yotei.calendar",
        "ai.gftd.apps.yotei.availability",
        "ai.gftd.apps.yotei.event",
        "ai.gftd.apps.yotei.booking"
      ]
    }
  },
  "uiType": "appview"
}
