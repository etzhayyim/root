<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- createOrg -->
  <bpmn:process id="ge-create-org" name="GE Create Org" isExecutable="true">
    <bpmn:startEvent id="start-create-org"/>
    <bpmn:sequenceFlow id="sf-co-1" sourceRef="start-create-org" targetRef="task-create-org"/>
    <bpmn:serviceTask id="task-create-org" name="Create Org">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.ge.createOrg"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-co-2" sourceRef="task-create-org" targetRef="end-create-org"/>
    <bpmn:endEvent id="end-create-org"/>
  </bpmn:process>

  <!-- listOrgs -->
  <bpmn:process id="ge-list-orgs" name="GE List Orgs" isExecutable="true">
    <bpmn:startEvent id="start-list-orgs"/>
    <bpmn:sequenceFlow id="sf-lo-1" sourceRef="start-list-orgs" targetRef="task-list-orgs"/>
    <bpmn:serviceTask id="task-list-orgs" name="List Orgs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.ge.listOrgs"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lo-2" sourceRef="task-list-orgs" targetRef="end-list-orgs"/>
    <bpmn:endEvent id="end-list-orgs"/>
  </bpmn:process>

  <!-- createProject -->
  <bpmn:process id="ge-create-project" name="GE Create Project" isExecutable="true">
    <bpmn:startEvent id="start-create-project"/>
    <bpmn:sequenceFlow id="sf-cp-1" sourceRef="start-create-project" targetRef="task-create-project"/>
    <bpmn:serviceTask id="task-create-project" name="Create Project">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.ge.createProject"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-cp-2" sourceRef="task-create-project" targetRef="end-create-project"/>
    <bpmn:endEvent id="end-create-project"/>
  </bpmn:process>

  <!-- listProjects -->
  <bpmn:process id="ge-list-projects" name="GE List Projects" isExecutable="true">
    <bpmn:startEvent id="start-list-projects"/>
    <bpmn:sequenceFlow id="sf-lp-1" sourceRef="start-list-projects" targetRef="task-list-projects"/>
    <bpmn:serviceTask id="task-list-projects" name="List Projects">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.ge.listProjects"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lp-2" sourceRef="task-list-projects" targetRef="end-list-projects"/>
    <bpmn:endEvent id="end-list-projects"/>
  </bpmn:process>

  <!-- assignResource -->
  <bpmn:process id="ge-assign-resource" name="GE Assign Resource" isExecutable="true">
    <bpmn:startEvent id="start-assign-resource"/>
    <bpmn:sequenceFlow id="sf-ar-1" sourceRef="start-assign-resource" targetRef="task-assign-resource"/>
    <bpmn:serviceTask id="task-assign-resource" name="Assign Resource">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.ge.assignResource"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-ar-2" sourceRef="task-assign-resource" targetRef="end-assign-resource"/>
    <bpmn:endEvent id="end-assign-resource"/>
  </bpmn:process>

  <!-- listResources -->
  <bpmn:process id="ge-list-resources" name="GE List Resources" isExecutable="true">
    <bpmn:startEvent id="start-list-resources"/>
    <bpmn:sequenceFlow id="sf-lr-1" sourceRef="start-list-resources" targetRef="task-list-resources"/>
    <bpmn:serviceTask id="task-list-resources" name="List Resources">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.ge.listResources"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lr-2" sourceRef="task-list-resources" targetRef="end-list-resources"/>
    <bpmn:endEvent id="end-list-resources"/>
  </bpmn:process>

  <!-- getOrgMetrics -->
  <bpmn:process id="ge-get-org-metrics" name="GE Get Org Metrics" isExecutable="true">
    <bpmn:startEvent id="start-get-org-metrics"/>
    <bpmn:sequenceFlow id="sf-gom-1" sourceRef="start-get-org-metrics" targetRef="task-get-org-metrics"/>
    <bpmn:serviceTask id="task-get-org-metrics" name="Get Org Metrics">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.ge.getOrgMetrics"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gom-2" sourceRef="task-get-org-metrics" targetRef="end-get-org-metrics"/>
    <bpmn:endEvent id="end-get-org-metrics"/>
  </bpmn:process>

  <!-- planWorkforce -->
  <bpmn:process id="ge-plan-workforce" name="GE Plan Workforce" isExecutable="true">
    <bpmn:startEvent id="start-plan-workforce"/>
    <bpmn:sequenceFlow id="sf-pw-1" sourceRef="start-plan-workforce" targetRef="task-plan-workforce"/>
    <bpmn:serviceTask id="task-plan-workforce" name="Plan Workforce">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.ge.planWorkforce"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-pw-2" sourceRef="task-plan-workforce" targetRef="end-plan-workforce"/>
    <bpmn:endEvent id="end-plan-workforce"/>
  </bpmn:process>

</bpmn:definitions>
