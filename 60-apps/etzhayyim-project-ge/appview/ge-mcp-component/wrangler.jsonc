{
  "name": "kotodama-zbikcidk",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"createOrg\",\"listOrgs\",\"createProject\",\"listProjects\",\"assignResource\",\"listResources\",\"getOrgMetrics\",\"planWorkforce\"]",
    "APP_DESCRIPTION": "ge — Global Expansion & Organizational Intelligence Platform. BPMN-driven org management, project planning, resource allocation, and workforce analytics.",
    "APP_DISPLAY_NAME": "Global Expansion",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "zbikcidk",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "zbikcidk.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "ge.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
