    "勤労の義務"
  ],
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": [
      "document-management-policy"
    ]
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "ai-gftd-wasm-xlsx",
  "nanoid": "il0ndq6a",
  "performerType": "service",
  "profile": {
    "agentType": "semi-autonomous",
    "capabilities": [
      "workbook-management",
      "sheet-editing",
      "workbook-search"
    ],
    "description": "Excel editor — upload, edit spreadsheets with formula evaluation, and export XLSX workbooks.",
