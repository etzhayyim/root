  "@type": "Project",
  "identifier": "etzhayyim-project-shopping",
  "name": "etzhayyim project shopping",
  "status": "Active",
  "description": "okaimono.etzhayyim.com の AI自動運営EC（販売・発送・仕入れ・CS）向け設計を先行実装するプロジェクト。",
  "capabilities": {
    "@type": "DefinedTermSet",
    "name": "Capabilities",
    "description": "okaimono.etzhayyim.com のAI運営基盤が担う能力（CV-1）",
    "terms": [
      {
        "@type": "DefinedTerm",
        "name": "Autonomous Retail Operations",
        "description": "受注から出荷までをAIエージェントで自動実行し、人間は例外時のみ介入する。"
      },
      {
        "@type": "DefinedTerm",
        "name": "Procurement-Inventory Closed Loop",
        "description": "需要予測と安全在庫を基に、仕入れ意思決定を継続的に更新する。"
      },
      {
        "@type": "DefinedTerm",
        "name": "AI-first Customer Support",
        "description": "顧客問い合わせの一次応答と返品・返金の自動判定を統合実行する。"
      }
    ]
  },
  "survivalIndicators": [
    {
      "@type": "PropertyValue",
      "identifier": "requests",
      "name": "Requests",
      "description": "Request count (traffic) as a basic survival indicator.",
      "unitText": "count",
      "value": null,
      "ingestKey": "requests",
      "window": "1d",
      "valueUpdatedAt": null
    },
    {
      "@type": "PropertyValue",
      "identifier": "gccCredit",
      "name": "GCC Credit",
      "description": "GCC credit balance (or net credit change) as a basic survival indicator.",
      "unitText": "GCC",
      "value": null,
      "ingestKey": "gccCredit",
      "window": "1d",
      "valueUpdatedAt": null
    }
  ],
  "scheduler": "scheduler.jsonld",
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
