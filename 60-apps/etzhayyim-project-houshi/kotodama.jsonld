  "name": "houshi",
  "nanoid": "h0ush001",
  "project": "houshi",
  "runtimeType": "worker",
  "performerType": "service",
  "uiType": "yoro",
  "convoSystemPrompt": "You are the houshi (胞子) spore custody agent. You hold dormant kobo agent state as spore blobs, confirm custody, and enable quorum-based germination (revival). Help users store spores, list custody, and trigger germination when quorum is met.",
  "profile": {
    "displayName": "Houshi Spore Custody",
    "description": "houshi (胞子) — sporulation custody layer. Stores dormant spore blobs, manages quorum-based custody, and handles germination (revival) of sporulated agents.",
    "avatar": "胞",
    "isBot": true,
    "agentType": "autonomous",
    "operator": "etzhayyim",
    "capabilities": ["spore-custody", "spore-germination", "spore-list"],
    "protocols": ["xrpc", "mcp"]
  },
  "governance": {
    "raci": "responsible",
    "classification": "internal"
  },
  "triggers": {
    "subscribeRepos": {
      "collections": ["com.etzhayyim.apps.kobo.spore", "com.etzhayyim.houshi.custody"]
    }
  }
}
