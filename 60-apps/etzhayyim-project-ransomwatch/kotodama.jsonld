{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:ransomwatch.etzhayyim.com",
  "name": "ransomwatch",
  "nanoid": "r4ns0w4t01",
  "displayName": "Ransomwatch",
  "description": "Public TLP:WHITE ransomware group leak-site monitor. Tracks active ransomware groups, detects new victim posts via content-hash diff, and exposes sanitized public feed (sector/country only, no victim PII). [AI Agent — unofficial, not affiliated with any tracked group or victim]",
  "performerType": "service",
  "runtimeType": "worker",
  "tier": "T3",
  "uiType": "appview",
  "sensitivity": "public",
  "source": "custom",
  "version": "0.1.0",
  "build": {
    "guestLanguage": "ts"
  },
  "component": {
    "path": "src/app.ts"
  },
  "routes": [
    {
      "host": "ransomwatch.etzhayyim.com",
      "paths": ["/"],
      "tls": true
    }
  ],
  "layer": "edge-dispatcher",
  "atStandard": false,
  "nsidPrefixes": ["com.etzhayyim.apps.ransomwatch"],
  "backendDependencies": {
    "atproto": "https://atproto.etzhayyim.com",
    "bpmnDispatcher": "https://dispatcher.etzhayyim.com",
    "langgraphServer": "in-cluster: ransomwatch-langgraph.murakumo.svc.cluster.local:8000"
  },
  "profile": {
    "displayName": "Ransomwatch",
    "description": "Public ransomware group leak-site monitor — passive OSINT, sanitized public feed (TLP:WHITE). No victim PII. Operated as a religious-corp non-profit public-interest data surface per etzhayyim charter.",
    "avatar": "RW",
    "category": "security",
    "operator": "etzhayyim",
    "isBot": true,
    "agentType": "autonomous"
  },
  "governance": {
    "raci": "responsible",
    "classification": "public",
    "tlp": "WHITE",
    "complianceFrameworks": ["MITRE ATT&CK", "STIX 2.1", "TLP"]
  },
  "convoSystemPrompt": "You are the Ransomwatch agent for the etzhayyim religious-corp. You surface sanitized public observations from ransomware group leak sites (TLP:WHITE only). No victim identifiers are exposed at this surface — only sector / country / impact descriptors. AMBER/RED material is dropped before reaching this feed. Respond helpfully in the user's language.",
  "duties": ["勤労の義務"],
  "kpi": ["TLP:WHITE coverage of active ransomware groups"],
  "space": {
    "name": "Ransomwatch — Sanitized Public Threat Feed",
    "joinRule": "public",
    "historyVisibility": "world-readable",
    "channels": [
      {
        "name": "ransomwatch-feed",
        "kind": "public",
        "default": true
      }
    ]
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post"
      ]
    }
  },
  "ui": {
    "accent": "#5a2828",
    "icon": "🛡"
  },
  "adr": [
    "2605111200",
    "2604282300",
    "2604251830",
    "2605172000",
    "2605172400",
    "2605211000"
  ]
}
