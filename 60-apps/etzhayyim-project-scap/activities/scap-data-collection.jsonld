  "@id": "https://scap.etzhayyim.com/activities/scap-data-collection",
  "@type": [
    "dodaf:Activity",
    "prov:Activity"
  ],
  "name": "SCAP Data Collection",
  "description": "Activity for collecting SCAP data from external sources (NIST NVD, MITRE OVAL, OpenSCAP, DISA STIG) using Workflow DevKit workflows",
  "createdAt": "2024-01-01T00:00:00Z",
  "updatedAt": "2024-01-01T00:00:00Z",
  "performedBy": [
    {
      "@id": "https://scap.etzhayyim.com/performers/services/scap-data-service"
    },
    {
      "@id": "https://scap.etzhayyim.com/performers/services/workflow-engine"
    }
  ],
  "produces": [
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapContents"
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/cveData"
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/ovalDefinitions"
    }
  ],
  "consumes": [
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapDataSources"
    }
  ],
  "requires": [
    {
      "@id": "https://scap.etzhayyim.com/capabilities/security-content-automation"
    },
    {
      "@id": "https://scap.etzhayyim.com/capabilities/data-integration"
    }
  ],
  "enables": [
    {
      "@id": "https://scap.etzhayyim.com/activities/scap-scan-execution"
    },
    {
      "@id": "https://scap.etzhayyim.com/activities/scap-data-search"
    }
  ],
  "realizes": [
    {
      "@id": "https://scap.etzhayyim.com/goal/collect-scap-data"
    },
    {
      "@id": "https://scap.etzhayyim.com/goal/process-scap-data"
    }
  ],
  "step": [
    {
      "@id": "https://scap.etzhayyim.com/activities/scap-data-collection/fetch-nvd-data",
      "name": "Fetch NVD Data",
      "description": "Fetch CVE data from NIST National Vulnerability Database API",
      "wasDerivedFrom": "https://github.com/etzhayyim/etzhayyim-scap/blob/main/src/internal/workflows/steps/fetch-nvd-data.ts"
    },
    {
      "@id": "https://scap.etzhayyim.com/activities/scap-data-collection/fetch-oval-data",
      "name": "Fetch OVAL Data",
      "description": "Fetch OVAL definitions from MITRE OVAL Repository",
      "wasDerivedFrom": "https://github.com/etzhayyim/etzhayyim-scap/blob/main/src/internal/workflows/steps/fetch-oval-data.ts"
    },
    {
      "@id": "https://scap.etzhayyim.com/activities/scap-data-collection/save-to-database",
      "name": "Save to Database",
      "description": "Save collected SCAP data to PostgreSQL database via Rust GraphQL service (Diesel ORM)",
      "wasDerivedFrom": "https://github.com/etzhayyim/etzhayyim-scap/blob/main/src/internal/workflows/steps/save-to-database.ts"
    }
  ],
  "wasDerivedFrom": [
