    {
      "@id": "https://scap.etzhayyim.com/activities/scap-scan-execution/execute-scan",
      "name": "Execute Scan",
      "description": "Execute SCAP compliance scan against target using integration",
      "wasDerivedFrom": "https://github.com/etzhayyim/etzhayyim-scap/blob/main/services/scap-scan-service.ts"
    },
    {
      "@id": "https://scap.etzhayyim.com/activities/scap-scan-execution/evaluate-results",
