  "@id": "https://scap.etzhayyim.com/activities/scap-scan-execution",
  "@type": [
    "dodaf:Activity",
    "prov:Activity"
  ],
  "name": "SCAP Scan Execution",
  "description": "Activity for executing SCAP compliance scans against integrated targets (AWS, GCP, Azure, GitHub, GitLab)",
  "createdAt": "2024-01-01T00:00:00Z",
  "updatedAt": "2024-01-01T00:00:00Z",
  "performedBy": [
    {
      "@id": "https://scap.etzhayyim.com/performers/services/scap-scan-service"
    }
  ],
