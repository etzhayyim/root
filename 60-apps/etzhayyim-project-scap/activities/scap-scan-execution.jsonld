    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapScanResults"
    }
  ],
  "consumes": [
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapContents"
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/integrations"
