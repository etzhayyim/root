  "@id": "https://scap.etzhayyim.com/activities/worker-orchestration",
  "@type": [
    "dodaf:Activity",
    "prov:Activity"
  ],
  "name": "Worker Orchestration",
  "description": "Activity for orchestrating and managing SCAP activity services, including scheduling, health monitoring, and service lifecycle management",
  "createdAt": "2024-01-01T00:00:00Z",
  "updatedAt": "2024-01-01T00:00:00Z",
  "performedBy": [
    {
      "@id": "https://scap.etzhayyim.com/performers/systems/worker"
    }
  ],
  "produces": [
    {
      "@id": "https://scap.etzhayyim.com/resources/service-registry",
      "name": "Service Registry",
      "description": "Registry of active activity services and their status"
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/worker-stats",
      "name": "Worker Statistics",
      "description": "Statistics and metrics for worker system and managed services"
    }
  ],
  "consumes": [
    {
      "@id": "https://scap.etzhayyim.com/performers/services/scap-data-collection-service"
    },
    {
      "@id": "https://scap.etzhayyim.com/performers/services/scap-scan-execution-service"
    }
  ],
  "requires": [
    {
      "@id": "https://scap.etzhayyim.com/capabilities/security-content-automation"
    },
    {
      "@id": "https://scap.etzhayyim.com/capabilities/data-integration"
    }
  ],
  "enables": [
    {
      "@id": "https://scap.etzhayyim.com/activities/scap-data-collection"
    },
