      "@id": "https://scap.etzhayyim.com/activities/scap-scan-execution"
    }
  ],
  "realizes": [
    {
      "@id": "https://scap.etzhayyim.com/goal/orchestrate-scap-services"
    }
  ],
  "step": [
    {
      "@id": "https://scap.etzhayyim.com/activities/worker-orchestration/service-discovery",
      "name": "Service Discovery",
      "description": "Discover and register activity services",
      "wasDerivedFrom": "https://github.com/etzhayyim/etzhayyim-scap/blob/main/performers/systems/worker/src/manager.rs"
    },
    {
      "@id": "https://scap.etzhayyim.com/activities/worker-orchestration/scheduling",
      "name": "Job Scheduling",
      "description": "Schedule and coordinate periodic tasks for activity services",
      "wasDerivedFrom": "https://github.com/etzhayyim/etzhayyim-scap/blob/main/performers/systems/worker/src/scheduler.rs"
    },
    {
      "@id": "https://scap.etzhayyim.com/activities/worker-orchestration/health-monitoring",
      "name": "Health Monitoring",
      "description": "Monitor health and status of activity services",
      "wasDerivedFrom": "https://github.com/etzhayyim/etzhayyim-scap/blob/main/performers/systems/worker/src/health.rs"
    },
    {
      "@id": "https://scap.etzhayyim.com/activities/worker-orchestration/lifecycle-management",
      "name": "Lifecycle Management",
      "description": "Manage startup, shutdown, and restart of activity services",
      "wasDerivedFrom": "https://github.com/etzhayyim/etzhayyim-scap/blob/main/performers/systems/worker/src/worker.rs"
    }
  ],
