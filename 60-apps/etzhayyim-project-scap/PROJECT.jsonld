    "documents": [
      {
        "fileName": "GOAL.jsonld",
        "content": {
          "@context": {
            "@version": 1.1,
            "@vocab": "https://scap.etzhayyim.com/ontology#",
            "id": "@id",
            "type": "@type",
            "dodaf": "https://dod.af/dodaf/dm2#",
            "prov": "http://www.w3.org/ns/prov#",
            "dct": "http://purl.org/dc/terms/",
            "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
            "xsd": "http://www.w3.org/2001/XMLSchema#",
            "name": "dct:title",
            "description": "dct:description",
            "createdAt": {
              "@id": "dct:created",
              "@type": "xsd:dateTime"
            },
            "updatedAt": {
              "@id": "dct:modified",
              "@type": "xsd:dateTime"
            },
            "vision": "dodaf:vision",
            "goal": {
              "@id": "dodaf:goal",
              "@container": "@set"
            },
            "desiredEffect": {
              "@id": "dodaf:desiredEffect",
              "@container": "@set"
            },
            "realizedBy": {
              "@id": "dodaf:realizedBy",
              "@type": "@id",
              "@container": "@set"
            },
            "wasDerivedFrom": {
              "@id": "prov:wasDerivedFrom",
              "@type": "@id",
              "@container": "@set"
            }
          },
          "@id": "https://scap.etzhayyim.com/goal",
          "@type": [
            "dodaf:Goal",
            "prov:Entity"
          ],
          "name": "SCAP Security Content Automation Goal",
          "description": "Automate security content collection, processing, and compliance scanning through SCAP data sources",
          "createdAt": "2024-01-01T00:00:00Z",
          "updatedAt": "2024-01-01T00:00:00Z",
          "vision": "Enable automated security compliance scanning through continuous collection and processing of SCAP data from multiple authoritative sources",
          "goal": [
            {
              "@id": "https://scap.etzhayyim.com/goal/collect-scap-data",
              "name": "Collect SCAP Data from External Sources",
              "description": "Automatically collect SCAP data from NIST NVD, MITRE OVAL, OpenSCAP, and DISA STIG sources"
            },
            {
              "@id": "https://scap.etzhayyim.com/goal/process-scap-data",
              "name": "Process and Store SCAP Data",
              "description": "Process collected SCAP data using Workflow DevKit and store in PostgreSQL database via Rust GraphQL service (Diesel ORM)"
            },
            {
              "@id": "https://scap.etzhayyim.com/goal/execute-scap-scans",
              "name": "Execute SCAP Compliance Scans",
              "description": "Execute SCAP compliance scans against integrated targets (AWS, GCP, Azure, GitHub, GitLab)"
            },
            {
              "@id": "https://scap.etzhayyim.com/goal/search-scap-data",
              "name": "Search and Query SCAP Data",
              "description": "Provide search and query capabilities for SCAP data with filtering by type, source, severity, and other criteria"
            }
          ],
          "desiredEffect": [
            {
              "@id": "https://scap.etzhayyim.com/effect/automated-compliance",
              "name": "Automated Compliance Assessment",
              "description": "Reduce manual effort in security compliance assessment through automated data collection and scanning"
            },
            {
              "@id": "https://scap.etzhayyim.com/effect/unified-scap-platform",
              "name": "Unified SCAP Platform",
              "description": "Provide a single platform for accessing and managing SCAP data from multiple sources"
            },
            {
              "@id": "https://scap.etzhayyim.com/effect/real-time-monitoring",
              "name": "Real-time Security Monitoring",
              "description": "Enable real-time monitoring of security vulnerabilities and compliance status through Supabase Realtime"
            }
          ],
          "realizedBy": [
            {
              "@id": "https://scap.etzhayyim.com/capabilities/security-content-automation"
            },
            {
              "@id": "https://scap.etzhayyim.com/capabilities/vulnerability-assessment"
            },
            {
              "@id": "https://scap.etzhayyim.com/capabilities/compliance-scanning"
            },
            {
              "@id": "https://scap.etzhayyim.com/capabilities/data-integration"
            }
          ],
          "wasDerivedFrom": [
            "https://github.com/etzhayyim/etzhayyim-scap/blob/main/README.md"
          ]
        }
      },
