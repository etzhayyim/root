    "prov:Entity"
  ],
  "name": "SCAP Security Content Automation Protocol Platform",
  "description": "Automated SCAP data collection, processing, and compliance scanning platform using Workflow DevKit, Crawlee, Diesel ORM (Rust GraphQL), and Supabase",
  "version": "0.1.0",
