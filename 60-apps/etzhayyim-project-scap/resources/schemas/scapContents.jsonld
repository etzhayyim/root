{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://scap.etzhayyim.com/ontology#",
    "id": "@id",
    "type": "@type",
    "dodaf": "https://dod.af/dodaf/dm2#",
    "prov": "http://www.w3.org/ns/prov#",
    "dct": "http://purl.org/dc/terms/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "sh": "http://www.w3.org/ns/shacl#",
    "name": "dct:title",
    "description": "dct:description",
    "createdAt": {
      "@id": "dct:created",
      "@type": "xsd:dateTime"
    },
    "updatedAt": {
      "@id": "dct:modified",
      "@type": "xsd:dateTime"
    },
    "tableName": "dodaf:tableName",
    "column": {
      "@id": "dodaf:hasColumn",
      "@container": "@set"
    },
    "primaryKey": {
      "@id": "dodaf:primaryKey",
      "@container": "@set"
    },
    "index": {
      "@id": "dodaf:hasIndex",
      "@container": "@set"
    },
    "wasDerivedFrom": {
      "@id": "prov:wasDerivedFrom",
      "@type": "@id",
      "@container": "@set"
    }
  },
  "@id": "https://scap.etzhayyim.com/resources/schemas/scapContents",
  "@type": [
    "dodaf:Resource",
    "dodaf:DataType"
  ],
  "name": "SCAP Contents Schema",
  "description": "Database schema for storing SCAP content items from various sources (NIST, MITRE, etc.)",
  "tableName": "scap_contents",
  "createdAt": "2024-01-01T00:00:00Z",
  "updatedAt": "2024-01-01T00:00:00Z",
  "primaryKey": [
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapContents/id"
    }
  ],
  "column": [
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapContents/id",
      "name": "id",
      "description": "Primary key identifier",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapContents/title",
      "name": "title",
      "description": "Title of the SCAP content",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapContents/description",
      "name": "description",
      "description": "Description of the SCAP content",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapContents/type",
      "name": "type",
      "description": "SCAP content type (cve, oval, xccdf, cce, cpe, scap-benchmark, stig)",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true,
      "enum": [
        "cve",
        "oval",
        "xccdf",
        "cce",
        "cpe",
        "scap-benchmark",
        "stig"
      ]
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapContents/version",
      "name": "version",
      "description": "Version of the SCAP content",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapContents/status",
      "name": "status",
      "description": "Status of the SCAP content (active, inactive, deprecated)",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true,
      "default": "active",
      "enum": [
        "active",
        "inactive",
        "deprecated"
      ]
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapContents/source",
      "name": "source",
      "description": "Source of the SCAP content",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapContents/publishedDate",
      "name": "publishedDate",
      "description": "Date when the SCAP content was published",
      "dataType": {
        "@id": "xsd:dateTime"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapContents/lastUpdated",
      "name": "lastUpdated",
      "description": "Date when the SCAP content was last updated",
      "dataType": {
        "@id": "xsd:dateTime"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapContents/metadata",
      "name": "metadata",
      "description": "JSON metadata containing publisher, severity, platforms, tags, references",
      "dataType": {
        "@id": "xsd:anyType"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapContents/content",
      "name": "content",
      "description": "JSON content containing raw, parsed, checksum, and size",
      "dataType": {
        "@id": "xsd:anyType"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapContents/createdAt",
      "name": "createdAt",
      "description": "Timestamp when the record was created",
      "dataType": {
        "@id": "xsd:dateTime"
      },
      "required": true,
      "default": "now()"
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapContents/updatedAt",
      "name": "updatedAt",
      "description": "Timestamp when the record was last updated",
      "dataType": {
        "@id": "xsd:dateTime"
      },
      "required": true,
      "default": "now()"
    }
  ],
  "index": [
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapContents/typeIdx",
      "name": "scap_contents_type_idx",
      "columns": [
        "type"
      ]
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapContents/statusIdx",
      "name": "scap_contents_status_idx",
      "columns": [
        "status"
      ]
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapContents/sourceIdx",
      "name": "scap_contents_source_idx",
      "columns": [
        "source"
      ]
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapContents/publishedDateIdx",
      "name": "scap_contents_published_date_idx",
      "columns": [
        "publishedDate"
      ]
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapContents/lastUpdatedIdx",
      "name": "scap_contents_last_updated_idx",
      "columns": [
        "lastUpdated"
      ]
    }
  ],
  "wasDerivedFrom": [
    "https://github.com/etzhayyim/etzhayyim-scap/blob/main/performers/services/graphql/src/schema.rs",
    "https://github.com/etzhayyim/etzhayyim-scap/blob/main/src/internal/zod/scapContent.ts"
  ]
}
