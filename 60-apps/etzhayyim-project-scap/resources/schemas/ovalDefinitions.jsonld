  "@id": "https://scap.etzhayyim.com/resources/schemas/ovalDefinitions",
  "@type": [
    "dodaf:Resource",
    "dodaf:DataType"
  ],
  "name": "OVAL Definitions Schema",
  "description": "Database schema for storing OVAL (Open Vulnerability and Assessment Language) definitions from MITRE",
  "tableName": "oval_definitions",
  "createdAt": "2024-01-01T00:00:00Z",
  "updatedAt": "2024-01-01T00:00:00Z",
  "primaryKey": [
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/ovalDefinitions/id"
    }
  ],
  "column": [
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/ovalDefinitions/id",
      "name": "id",
      "description": "OVAL definition identifier",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/ovalDefinitions/title",
      "name": "title",
      "description": "Title of the OVAL definition",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/ovalDefinitions/description",
      "name": "description",
      "description": "Description of the OVAL definition",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/ovalDefinitions/class",
      "name": "class",
      "description": "OVAL class (vulnerability, compliance, inventory)",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true,
      "enum": [
        "vulnerability",
        "compliance",
        "inventory"
      ]
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/ovalDefinitions/affectedProducts",
      "name": "affectedProducts",
      "description": "Array of affected product identifiers",
      "dataType": {
        "@id": "xsd:anyType"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/ovalDefinitions/criteria",
      "name": "criteria",
      "description": "Criteria object with operator (AND/OR) and criterion array",
      "dataType": {
        "@id": "xsd:anyType"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/ovalDefinitions/metadata",
      "name": "metadata",
      "description": "JSON metadata containing title, affected platforms, and description",
      "dataType": {
        "@id": "xsd:anyType"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/ovalDefinitions/createdAt",
      "name": "createdAt",
      "description": "Timestamp when the record was created",
      "dataType": {
        "@id": "xsd:dateTime"
      },
      "required": true,
      "default": "now()"
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/ovalDefinitions/updatedAt",
      "name": "updatedAt",
      "description": "Timestamp when the record was last updated",
      "dataType": {
        "@id": "xsd:dateTime"
      },
      "required": true,
      "default": "now()"
    }
  ],
  "index": [
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/ovalDefinitions/classIdx",
      "name": "oval_definitions_class_idx",
      "columns": [
        "class"
      ]
    }
  ],
  "wasDerivedFrom": [
    "https://github.com/etzhayyim/etzhayyim-scap/blob/main/performers/services/graphql/src/schema.rs",
    "https://github.com/etzhayyim/etzhayyim-scap/blob/main/src/internal/zod/ovalDefinition.ts"
  ]
}
