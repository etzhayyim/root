  "@id": "https://scap.etzhayyim.com/resources/schemas/scapDataSources",
  "@type": [
    "dodaf:Resource",
    "dodaf:DataType"
  ],
  "name": "SCAP Data Sources Schema",
  "description": "Database schema for storing SCAP data source configurations",
  "tableName": "scap_data_sources",
  "createdAt": "2024-01-01T00:00:00Z",
  "updatedAt": "2024-01-01T00:00:00Z",
  "primaryKey": [
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapDataSources/id"
    }
  ],
  "column": [
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapDataSources/id",
      "name": "id",
      "description": "Primary key identifier",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapDataSources/name",
      "name": "name",
      "description": "Data source name",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapDataSources/type",
      "name": "type",
      "description": "Data source type (nist, mitre, oval, custom)",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true,
      "enum": [
        "nist",
        "mitre",
        "oval",
        "custom"
      ]
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapDataSources/url",
      "name": "url",
      "description": "Data source URL",
      "dataType": {
        "@id": "xsd:anyURI"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapDataSources/updateFrequency",
      "name": "updateFrequency",
      "description": "Update frequency (hourly, daily, weekly, monthly)",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true,
      "default": "daily",
      "enum": [
        "hourly",
        "daily",
        "weekly",
        "monthly"
      ]
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapDataSources/status",
      "name": "status",
      "description": "Data source status (active, inactive)",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true,
      "default": "active",
      "enum": [
        "active",
        "inactive"
      ]
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapDataSources/contentTypes",
      "name": "contentTypes",
      "description": "Array of content types supported by this data source",
      "dataType": {
        "@id": "xsd:anyType"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapDataSources/lastSync",
      "name": "lastSync",
      "description": "Timestamp of last synchronization",
      "dataType": {
        "@id": "xsd:dateTime"
      },
      "required": false
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapDataSources/createdAt",
      "name": "createdAt",
      "description": "Timestamp when the record was created",
      "dataType": {
        "@id": "xsd:dateTime"
      },
      "required": true,
      "default": "now()"
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapDataSources/updatedAt",
      "name": "updatedAt",
      "description": "Timestamp when the record was last updated",
      "dataType": {
        "@id": "xsd:dateTime"
      },
      "required": true,
      "default": "now()"
    }
  ],
  "index": [
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapDataSources/typeIdx",
      "name": "scap_data_sources_type_idx",
      "columns": [
        "type"
      ]
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapDataSources/statusIdx",
      "name": "scap_data_sources_status_idx",
      "columns": [
        "status"
      ]
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapDataSources/lastSyncIdx",
      "name": "scap_data_sources_last_sync_idx",
      "columns": [
        "lastSync"
      ]
    }
  ],
  "wasDerivedFrom": [
