{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://scap.etzhayyim.com/ontology#",
    "id": "@id",
    "type": "@type",
    "dodaf": "https://dod.af/dodaf/dm2#",
    "prov": "http://www.w3.org/ns/prov#",
    "dct": "http://purl.org/dc/terms/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "name": "dct:title",
    "description": "dct:description",
    "createdAt": {
      "@id": "dct:created",
      "@type": "xsd:dateTime"
    },
    "updatedAt": {
      "@id": "dct:modified",
      "@type": "xsd:dateTime"
    },
    "tableName": "dodaf:tableName",
    "column": {
      "@id": "dodaf:hasColumn",
      "@container": "@set"
    },
    "primaryKey": {
      "@id": "dodaf:primaryKey",
      "@container": "@set"
    },
    "index": {
      "@id": "dodaf:hasIndex",
      "@container": "@set"
    },
    "wasDerivedFrom": {
      "@id": "prov:wasDerivedFrom",
      "@type": "@id",
      "@container": "@set"
    }
  },
  "@id": "https://scap.etzhayyim.com/resources/schemas/cveData",
  "@type": [
    "dodaf:Resource",
    "dodaf:DataType"
  ],
  "name": "CVE Data Schema",
  "description": "Database schema for storing CVE (Common Vulnerabilities and Exposures) information from NIST NVD",
  "tableName": "cve_data",
  "createdAt": "2024-01-01T00:00:00Z",
  "updatedAt": "2024-01-01T00:00:00Z",
  "primaryKey": [
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/cveData/cveId"
    }
  ],
  "column": [
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/cveData/cveId",
      "name": "cveId",
      "description": "CVE identifier (e.g., CVE-2024-0001)",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true,
      "pattern": "^CVE-\\d{4}-\\d{4,}$"
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/cveData/description",
      "name": "description",
      "description": "Description of the vulnerability",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/cveData/publishedDate",
      "name": "publishedDate",
      "description": "Date when the CVE was published",
      "dataType": {
        "@id": "xsd:dateTime"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/cveData/lastModifiedDate",
      "name": "lastModifiedDate",
      "description": "Date when the CVE was last modified",
      "dataType": {
        "@id": "xsd:dateTime"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/cveData/cvssScore",
      "name": "cvssScore",
      "description": "CVSS score (0.0 to 10.0)",
      "dataType": {
        "@id": "xsd:double"
      },
      "required": false
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/cveData/cvssVector",
      "name": "cvssVector",
      "description": "CVSS vector string",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": false
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/cveData/severity",
      "name": "severity",
      "description": "Severity level (low, medium, high, critical)",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true,
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/cveData/cweIds",
      "name": "cweIds",
      "description": "Array of CWE (Common Weakness Enumeration) identifiers",
      "dataType": {
        "@id": "xsd:anyType"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/cveData/references",
      "name": "references",
      "description": "Array of reference objects with url, source, and tags",
      "dataType": {
        "@id": "xsd:anyType"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/cveData/affectedProducts",
      "name": "affectedProducts",
      "description": "Array of affected product objects with vendor, product, and versions",
      "dataType": {
        "@id": "xsd:anyType"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/cveData/status",
      "name": "status",
      "description": "CVE status (published, modified, rejected)",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true,
      "default": "published",
      "enum": [
        "published",
        "modified",
        "rejected"
      ]
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/cveData/createdAt",
      "name": "createdAt",
      "description": "Timestamp when the record was created",
      "dataType": {
        "@id": "xsd:dateTime"
      },
      "required": true,
      "default": "now()"
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/cveData/updatedAt",
      "name": "updatedAt",
      "description": "Timestamp when the record was last updated",
      "dataType": {
        "@id": "xsd:dateTime"
      },
      "required": true,
      "default": "now()"
    }
  ],
  "index": [
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/cveData/severityIdx",
      "name": "cve_data_severity_idx",
      "columns": [
        "severity"
      ]
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/cveData/statusIdx",
      "name": "cve_data_status_idx",
      "columns": [
        "status"
      ]
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/cveData/publishedDateIdx",
      "name": "cve_data_published_date_idx",
      "columns": [
        "publishedDate"
      ]
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/cveData/cvssScoreIdx",
      "name": "cve_data_cvss_score_idx",
      "columns": [
        "cvssScore"
      ]
    }
  ],
  "wasDerivedFrom": [
    "https://github.com/etzhayyim/etzhayyim-scap/blob/main/performers/services/graphql/src/schema.rs",
    "https://github.com/etzhayyim/etzhayyim-scap/blob/main/src/internal/zod/cveData.ts"
  ]
}
