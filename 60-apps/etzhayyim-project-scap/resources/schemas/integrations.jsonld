  "@id": "https://scap.etzhayyim.com/resources/schemas/integrations",
  "@type": [
    "dodaf:Resource",
    "dodaf:DataType"
  ],
  "name": "Integrations Schema",
  "description": "Database schema for storing integration configurations for cloud providers and services",
  "tableName": "integrations",
  "createdAt": "2024-01-01T00:00:00Z",
  "updatedAt": "2024-01-01T00:00:00Z",
  "primaryKey": [
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/integrations/id"
    }
  ],
  "column": [
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/integrations/id",
      "name": "id",
      "description": "Primary key identifier",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/integrations/type",
      "name": "type",
      "description": "Integration type (aws, gcp, azure, github, gitlab)",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true,
      "enum": [
        "aws",
        "gcp",
        "azure",
        "github",
        "gitlab"
      ]
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/integrations/name",
      "name": "name",
      "description": "Integration name",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/integrations/status",
      "name": "status",
      "description": "Integration status (active, inactive)",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true,
      "default": "active",
      "enum": [
        "active",
        "inactive"
      ]
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/integrations/config",
      "name": "config",
      "description": "JSON configuration object containing integration-specific settings",
      "dataType": {
        "@id": "xsd:anyType"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/integrations/createdAt",
      "name": "createdAt",
      "description": "Timestamp when the record was created",
      "dataType": {
        "@id": "xsd:dateTime"
      },
      "required": true,
      "default": "now()"
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/integrations/updatedAt",
      "name": "updatedAt",
      "description": "Timestamp when the record was last updated",
      "dataType": {
        "@id": "xsd:dateTime"
      },
      "required": true,
      "default": "now()"
    }
  ],
  "index": [
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/integrations/typeIdx",
      "name": "integrations_type_idx",
      "columns": [
        "type"
      ]
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/integrations/statusIdx",
