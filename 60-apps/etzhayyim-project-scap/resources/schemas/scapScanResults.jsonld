  "@id": "https://scap.etzhayyim.com/resources/schemas/scapScanResults",
  "@type": [
    "dodaf:Resource",
    "dodaf:DataType"
  ],
  "name": "SCAP Scan Results Schema",
  "description": "Database schema for storing SCAP scan execution results",
  "tableName": "scap_scan_results",
  "createdAt": "2024-01-01T00:00:00Z",
  "updatedAt": "2024-01-01T00:00:00Z",
  "primaryKey": [
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapScanResults/id"
    }
  ],
  "column": [
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapScanResults/id",
      "name": "id",
      "description": "Primary key identifier",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapScanResults/scanId",
      "name": "scanId",
      "description": "Scan identifier",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapScanResults/integrationId",
      "name": "integrationId",
      "description": "Integration identifier",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapScanResults/targetId",
      "name": "targetId",
      "description": "Target identifier",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapScanResults/targetType",
      "name": "targetType",
      "description": "Target type (host, container, configuration)",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true,
      "enum": [
        "host",
        "container",
        "configuration"
      ]
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapScanResults/scapContentId",
      "name": "scapContentId",
      "description": "SCAP content identifier used for the scan",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapScanResults/executedAt",
      "name": "executedAt",
      "description": "Timestamp when the scan was executed",
      "dataType": {
        "@id": "xsd:dateTime"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapScanResults/completedAt",
      "name": "completedAt",
      "description": "Timestamp when the scan was completed",
      "dataType": {
        "@id": "xsd:dateTime"
      },
      "required": false
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapScanResults/status",
      "name": "status",
      "description": "Scan status (pending, running, completed, failed)",
      "dataType": {
        "@id": "xsd:string"
      },
      "required": true,
      "default": "pending",
      "enum": [
        "pending",
        "running",
        "completed",
        "failed"
      ]
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapScanResults/results",
      "name": "results",
      "description": "Array of test result objects with ruleId, result, score, message, details, timestamp",
      "dataType": {
        "@id": "xsd:anyType"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapScanResults/summary",
      "name": "summary",
      "description": "Summary object with totalRules, passedRules, failedRules, errorRules, unknownRules, notApplicableRules, compliancePercentage",
      "dataType": {
        "@id": "xsd:anyType"
      },
      "required": true
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapScanResults/metadata",
      "name": "metadata",
      "description": "JSON metadata containing priority and requestedAt",
      "dataType": {
        "@id": "xsd:anyType"
      },
      "required": false
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapScanResults/createdAt",
      "name": "createdAt",
      "description": "Timestamp when the record was created",
      "dataType": {
        "@id": "xsd:dateTime"
      },
      "required": true,
      "default": "now()"
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapScanResults/updatedAt",
      "name": "updatedAt",
      "description": "Timestamp when the record was last updated",
      "dataType": {
        "@id": "xsd:dateTime"
      },
      "required": true,
      "default": "now()"
    }
  ],
  "index": [
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapScanResults/scanIdIdx",
