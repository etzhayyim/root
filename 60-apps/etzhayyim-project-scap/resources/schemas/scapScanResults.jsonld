      "name": "scap_scan_results_executed_at_idx",
      "columns": [
        "executedAt"
      ]
    },
    {
      "@id": "https://scap.etzhayyim.com/resources/schemas/scapScanResults/scapContentIdIdx",
      "name": "scap_scan_results_scap_content_id_idx",
      "columns": [
        "scapContentId"
      ]
    }
  ],
