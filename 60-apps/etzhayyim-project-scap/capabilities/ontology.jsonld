{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://scap.etzhayyim.com/ontology#",
    "id": "@id",
    "type": "@type",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dodaf": "https://dod.af/dodaf/dm2#",
    "prov": "http://www.w3.org/ns/prov#",
    "dct": "http://purl.org/dc/terms/",
    "label": "rdfs:label",
    "comment": "rdfs:comment",
    "subClassOf": {
      "@id": "rdfs:subClassOf",
      "@type": "@id"
    },
    "domain": {
      "@id": "rdfs:domain",
      "@type": "@id"
    },
    "range": {
      "@id": "rdfs:range",
      "@type": "@id"
    },
    "wasDerivedFrom": {
      "@id": "prov:wasDerivedFrom",
      "@type": "@id",
      "@container": "@set"
    }
  },
  "@id": "https://scap.etzhayyim.com/capabilities/ontology",
  "@type": "owl:Ontology",
  "label": "SCAP Platform Ontology",
  "comment": "OWL ontology defining core concepts and relationships for SCAP Security Content Automation Protocol platform",
  "@graph": [
    {
      "@id": "https://scap.etzhayyim.com/ontology#SecurityContentAutomation",
      "@type": "owl:Class",
      "subClassOf": {
        "@id": "dodaf:Capability"
      },
      "label": "Security Content Automation",
      "comment": "Capability to automatically collect, process, and manage SCAP data from multiple sources"
    },
    {
      "@id": "https://scap.etzhayyim.com/ontology#VulnerabilityAssessment",
      "@type": "owl:Class",
      "subClassOf": {
        "@id": "dodaf:Capability"
      },
      "label": "Vulnerability Assessment",
      "comment": "Capability to assess vulnerabilities using CVE data and OVAL definitions"
    },
    {
      "@id": "https://scap.etzhayyim.com/ontology#ComplianceScanning",
      "@type": "owl:Class",
      "subClassOf": {
        "@id": "dodaf:Capability"
      },
      "label": "Compliance Scanning",
      "comment": "Capability to execute compliance scans against targets using SCAP content"
    },
    {
      "@id": "https://scap.etzhayyim.com/ontology#DataIntegration",
      "@type": "owl:Class",
      "subClassOf": {
        "@id": "dodaf:Capability"
      },
      "label": "Data Integration",
      "comment": "Capability to integrate multiple SCAP data sources (NIST, MITRE, OpenSCAP, DISA STIG)"
    },
    {
      "@id": "https://scap.etzhayyim.com/ontology#SCAPContent",
      "@type": "owl:Class",
      "label": "SCAP Content",
      "comment": "Security Content Automation Protocol content item"
    },
    {
      "@id": "https://scap.etzhayyim.com/ontology#CVEData",
      "@type": "owl:Class",
      "subClassOf": {
        "@id": "https://scap.etzhayyim.com/ontology#SCAPContent"
      },
      "label": "CVE Data",
      "comment": "Common Vulnerabilities and Exposures data"
    },
    {
      "@id": "https://scap.etzhayyim.com/ontology#OVALDefinition",
      "@type": "owl:Class",
      "subClassOf": {
        "@id": "https://scap.etzhayyim.com/ontology#SCAPContent"
      },
      "label": "OVAL Definition",
      "comment": "OVAL (Open Vulnerability and Assessment Language) definition"
    },
    {
      "@id": "https://scap.etzhayyim.com/ontology#SCAPScanResult",
      "@type": "owl:Class",
      "label": "SCAP Scan Result",
      "comment": "Result of SCAP compliance scan execution"
    },
    {
      "@id": "https://scap.etzhayyim.com/ontology#SCAPDataSource",
      "@type": "owl:Class",
      "label": "SCAP Data Source",
      "comment": "External source of SCAP data (NIST, MITRE, etc.)"
    },
    {
      "@id": "https://scap.etzhayyim.com/ontology#Integration",
      "@type": "owl:Class",
      "label": "Integration",
      "comment": "Integration configuration for cloud providers and services"
    },
    {
      "@id": "https://scap.etzhayyim.com/ontology#collectsFrom",
      "@type": "owl:ObjectProperty",
      "domain": {
        "@id": "https://scap.etzhayyim.com/ontology#SecurityContentAutomation"
      },
      "range": {
        "@id": "https://scap.etzhayyim.com/ontology#SCAPDataSource"
      },
      "label": "collects from",
      "comment": "Indicates that a capability collects data from a data source"
    },
    {
      "@id": "https://scap.etzhayyim.com/ontology#produces",
      "@type": "owl:ObjectProperty",
      "domain": {
        "@id": "https://scap.etzhayyim.com/ontology#SecurityContentAutomation"
      },
      "range": {
        "@id": "https://scap.etzhayyim.com/ontology#SCAPContent"
      },
      "label": "Produces",
      "comment": "Indicates that a capability produces SCAP content"
    },
    {
      "@id": "https://scap.etzhayyim.com/ontology#assesses",
      "@type": "owl:ObjectProperty",
      "domain": {
        "@id": "https://scap.etzhayyim.com/ontology#VulnerabilityAssessment"
      },
      "range": {
        "@id": "https://scap.etzhayyim.com/ontology#CVEData"
      },
      "label": "Assesses",
      "comment": "Indicates that a capability assesses vulnerabilities using CVE data"
    },
    {
      "@id": "https://scap.etzhayyim.com/ontology#executesScan",
      "@type": "owl:ObjectProperty",
      "domain": {
        "@id": "https://scap.etzhayyim.com/ontology#ComplianceScanning"
      },
      "range": {
        "@id": "https://scap.etzhayyim.com/ontology#SCAPScanResult"
      },
      "label": "executes scan",
      "comment": "Indicates that a capability executes compliance scans"
    },
    {
      "@id": "https://scap.etzhayyim.com/ontology#integrates",
      "@type": "owl:ObjectProperty",
      "domain": {
        "@id": "https://scap.etzhayyim.com/ontology#DataIntegration"
      },
      "range": {
        "@id": "https://scap.etzhayyim.com/ontology#SCAPDataSource"
      },
      "label": "Integrates",
      "comment": "Indicates that a capability integrates multiple data sources"
    }
  ],
  "wasDerivedFrom": [
    "https://github.com/etzhayyim/etzhayyim-scap/blob/main/lib/types.ts",
    "https://github.com/etzhayyim/etzhayyim-scap/blob/main/performers/services/graphql/src/schema.rs"
  ]
}
