{
  "@context": "https://1.etzhayyim.com/project",
  "@type": "Project",
  "name": "ai-gftd-project-www-crawler",
  "description": "Go + legacy runtime web crawler: scheduler/frontier, fetcher+extractor, indexer with scale-to-zero",
  "category": "ai-gftd-project-workers",
  "components": {
    "app": {
      "appId": "www-crawler",
      "tier": "event-driven",
      "stack": "go",
      "keda": true,
      "routes": [
        {
          "host": "etzhayyim.com",
          "paths": [
            "/o0dqx491/api/"
          ]
        }
      ]
    },
    "ui": {
      "appId": "crawler-ui",
      "tier": "static",
      "stack": "sveltekit",
      "routes": [
        {
          "host": "etzhayyim.com",
          "paths": [
            "/o0dqx491/"
          ]
        }
      ]
    }
  },
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "scheduler.jsonld",
        "content": {
          "@context": [
            "https://schema.org/",
            {
              "gftd": "https://etzhayyim.com/schemas/",
              "capabilities": "gftd:capabilities",
              "survivalIndicators": "gftd:survivalIndicators",
              "scheduler": "gftd:scheduler",
              "milestones": "gftd:milestones",
              "blockers": "gftd:blockers",
              "dependsOn": {
                "@id": "gftd:dependsOn",
                "@type": "@id"
              },
              "ingestKey": "gftd:ingestKey",
              "window": "gftd:window",
              "valueUpdatedAt": "gftd:valueUpdatedAt"
            }
          ],
          "@type": "CreativeWork",
          "name": "ai-gftd-project-www-crawler Scheduler",
          "identifier": "ai-gftd-project-www-crawler/scheduler",
          "description": "Project schedule (milestones) and blockers.",
          "dateCreated": "2026-02-15T04:25:26+00:00",
          "milestones": [],
          "blockers": []
        }
      }
    ]
  }
}
