{
  "$comment": "LangGraph Server config — open-patent.etzhayyim.com. Graphs: ingest_multi (daily), synthesize_invention (weekly).",
  "dependencies": ["./lg_open_patent", "../../../40-engine/kotoba/crates/kotoba-kotodama/py"],
  "graphs": {
    "health":               "./lg_open_patent/graphs/health.py:GRAPH",
    "ingest_multi":         "./lg_open_patent/graphs/ingest_multi.py:GRAPH",
    "synthesize_invention": "./lg_open_patent/graphs/synthesize_invention.py:GRAPH"
  },
  "env": ".env",
  "python_version": "3.11",
  "checkpointer": {
    "type": "postgres",
    "$comment": "RW PG :4566 direct via _RwAsyncPostgresSaver subclass.",
    "conn_str_env": "RW_URL"
  },
  "crons": [
    {
      "graph": "ingest_multi",
      "schedule": "0 2 * * *",
      "input": {},
      "$comment": "Daily ingest of patent data from AT firehose"
    },
    {
      "graph": "synthesize_invention",
      "schedule": "0 3 * * 1",
      "input": {},
      "$comment": "Weekly invention synthesis from patent corpus"
    }
  ]
}
