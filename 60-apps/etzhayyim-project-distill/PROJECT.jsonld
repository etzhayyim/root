{
  "@context": "https://schema.org",
  "@type": "Project",
  "name": "ETZHAYYIM Knowledge Distillation",
  "identifier": "etzhayyim-project-distill",
  "description": "Multi-model knowledge distillation: Claude Opus 4.6 to Qwen3-VL-8B via MLX QLoRA. Produces 4 philosophically-distinct models.",
  "hasPart": [
    {
      "@type": "SoftwareApplication",
      "name": "etzhayyim-distill",
      "identifier": "etzhayyim-distill",
      "url": "app/",
      "description": "FastAPI + legacy runtime Actors service for MLX QLoRA distillation"
    }
  ],
  "performers": [
    {
      "@type": "Service",
      "name": "etzhayyim-distill",
      "identifier": "etzhayyim-distill",
      "description": "Knowledge distillation worker: dataset generation, QLoRA training, evaluation, model export, HuggingFace push"
    }
  ],
  "models": [
    {
      "@type": "CreativeWork",
      "name": "etzhayyim-260213",
      "description": "Well-becoming model integrating ETZHAYYIM philosophy",
      "url": "https://huggingface.co/etzhayyim/etzhayyim-260213"
    },
    {
      "@type": "CreativeWork",
      "name": "maxwell-260213",
      "description": "Maxwell electromagnetic field reasoning model",
      "url": "https://huggingface.co/etzhayyim/maxwell-260213"
    },
    {
      "@type": "CreativeWork",
      "name": "landauer-260213",
      "description": "Landauer information-is-physical computation model",
      "url": "https://huggingface.co/etzhayyim/landauer-260213"
    },
    {
      "@type": "CreativeWork",
      "name": "whitehead-260213",
      "description": "Whitehead process philosophy model",
      "url": "https://huggingface.co/etzhayyim/whitehead-260213"
    }
  ],
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "scheduler.jsonld",
