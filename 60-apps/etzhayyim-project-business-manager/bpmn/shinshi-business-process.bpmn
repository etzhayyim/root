<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_Shinshi"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.17.0"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.2.0">

  <bpmn:collaboration id="Collaboration_Shinshi">
    <bpmn:participant id="Pool_Shinshi" name="Shinshi Content Platform (sh1n5h1x)" processRef="Process_Shinshi" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Shinshi" name="Shinshi Business Management Process" isExecutable="true">

    <bpmn:laneSet id="LaneSet_Shinshi">
      <bpmn:lane id="Lane_ContentPipeline" name="Content Pipeline">
        <bpmn:flowNodeRef>StartEvent_Shinshi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelOpen_S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CrawlerHealth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContentVolume</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelClose_S</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QualityCompliance" name="Quality &amp; Compliance">
        <bpmn:flowNodeRef>Task_ModelPipeline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContentQuality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskLevel_S</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Distribution" name="Distribution">
        <bpmn:flowNodeRef>Task_PromoteSOP_S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DMNPolicy_S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PauseRollout_S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Shinshi</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start -->
    <bpmn:startEvent id="StartEvent_Shinshi" name="Business evaluation&#10;triggered">
      <bpmn:outgoing>Flow_S_StartToParallel</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel checks -->
    <bpmn:parallelGateway id="Gateway_ParallelOpen_S" name="Parallel checks start">
      <bpmn:incoming>Flow_S_StartToParallel</bpmn:incoming>
      <bpmn:outgoing>Flow_S_ToCrawler</bpmn:outgoing>
      <bpmn:outgoing>Flow_S_ToContent</bpmn:outgoing>
      <bpmn:outgoing>Flow_S_ToModel</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="Task_CrawlerHealth" name="Check Crawler Health&#10;(crawl_jobs, sources)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.shinshi.check_crawler_health" />
        <zeebe:taskHeaders>
          <zeebe:header key="nanoid" value="sh1n5h1x" />
          <zeebe:header key="kpi" value="crawler_health" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S_ToCrawler</bpmn:incoming>
      <bpmn:outgoing>Flow_S_CrawlerToJoin</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_ContentVolume" name="Check Content Volume&#10;(video_count, articles)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.shinshi.check_content_volume" />
        <zeebe:taskHeaders>
          <zeebe:header key="nanoid" value="sh1n5h1x" />
          <zeebe:header key="kpi" value="content_coverage" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S_ToContent</bpmn:incoming>
      <bpmn:outgoing>Flow_S_ContentToJoin</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_ModelPipeline" name="Check Model Pipeline&#10;(generation jobs, R2 assets)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.shinshi.check_model_pipeline" />
        <zeebe:taskHeaders>
          <zeebe:header key="nanoid" value="sh1n5h1x" />
          <zeebe:header key="kpi" value="model_pipeline" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S_ToModel</bpmn:incoming>
      <bpmn:outgoing>Flow_S_ModelToJoin</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:parallelGateway id="Gateway_ParallelClose_S" name="Checks complete">
      <bpmn:incoming>Flow_S_CrawlerToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_S_ContentToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_S_ModelToJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_S_JoinToQuality</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Quality assessment -->
    <bpmn:serviceTask id="Task_ContentQuality" name="Assess Content Quality&#10;&amp; Engagement Rate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.shinshi.assess_content_quality" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="engagement_rate" />
          <zeebe:header key="scoreThresholdHigh" value="85" />
          <zeebe:header key="scoreThresholdMedium" value="65" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S_JoinToQuality</bpmn:incoming>
      <bpmn:outgoing>Flow_S_QualityToRisk</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Risk classification -->
    <bpmn:exclusiveGateway id="Gateway_RiskLevel_S" name="Risk level?">
      <bpmn:incoming>Flow_S_QualityToRisk</bpmn:incoming>
      <bpmn:outgoing>Flow_S_ToPromoteSOP</bpmn:outgoing>
      <bpmn:outgoing>Flow_S_ToDMNPolicy</bpmn:outgoing>
      <bpmn:outgoing>Flow_S_ToPauseRollout</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Distribution actions -->
    <bpmn:serviceTask id="Task_PromoteSOP_S" name="Promote to SOP&#10;&amp; extend BPMN review cycle">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.shinshi.promote_sop" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="promote_to_sop" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S_ToPromoteSOP</bpmn:incoming>
      <bpmn:outgoing>Flow_S_SOPToEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_DMNPolicy_S" name="Run DMN Policy Evaluation&#10;&amp; validate fallback path">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.shinshi.dmn_policy_evaluation" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="dmn_policy_evaluation" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S_ToDMNPolicy</bpmn:incoming>
      <bpmn:outgoing>Flow_S_DMNToEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_PauseRollout_S" name="Pause rollout&#10;&amp; trigger manual review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.shinshi.pause_rollout" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="pause_and_manual_review" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S_ToPauseRollout</bpmn:incoming>
      <bpmn:outgoing>Flow_S_PauseToEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Shinshi" name="Evaluation report&#10;generated">
      <bpmn:incoming>Flow_S_SOPToEnd</bpmn:incoming>
      <bpmn:incoming>Flow_S_DMNToEnd</bpmn:incoming>
      <bpmn:incoming>Flow_S_PauseToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_S_StartToParallel" sourceRef="StartEvent_Shinshi" targetRef="Gateway_ParallelOpen_S" />
    <bpmn:sequenceFlow id="Flow_S_ToCrawler" sourceRef="Gateway_ParallelOpen_S" targetRef="Task_CrawlerHealth" />
    <bpmn:sequenceFlow id="Flow_S_ToContent" sourceRef="Gateway_ParallelOpen_S" targetRef="Task_ContentVolume" />
    <bpmn:sequenceFlow id="Flow_S_ToModel" sourceRef="Gateway_ParallelOpen_S" targetRef="Task_ModelPipeline" />
    <bpmn:sequenceFlow id="Flow_S_CrawlerToJoin" sourceRef="Task_CrawlerHealth" targetRef="Gateway_ParallelClose_S" />
    <bpmn:sequenceFlow id="Flow_S_ContentToJoin" sourceRef="Task_ContentVolume" targetRef="Gateway_ParallelClose_S" />
    <bpmn:sequenceFlow id="Flow_S_ModelToJoin" sourceRef="Task_ModelPipeline" targetRef="Gateway_ParallelClose_S" />
    <bpmn:sequenceFlow id="Flow_S_JoinToQuality" sourceRef="Gateway_ParallelClose_S" targetRef="Task_ContentQuality" />
    <bpmn:sequenceFlow id="Flow_S_QualityToRisk" sourceRef="Task_ContentQuality" targetRef="Gateway_RiskLevel_S" />
    <bpmn:sequenceFlow id="Flow_S_ToPromoteSOP" name="low risk (score ≥ 85)" sourceRef="Gateway_RiskLevel_S" targetRef="Task_PromoteSOP_S">
      <bpmn:conditionExpression>=riskLevel = "low"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S_ToDMNPolicy" name="medium risk (65–84)" sourceRef="Gateway_RiskLevel_S" targetRef="Task_DMNPolicy_S">
      <bpmn:conditionExpression>=riskLevel = "medium"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S_ToPauseRollout" name="high risk (score &lt; 65)" sourceRef="Gateway_RiskLevel_S" targetRef="Task_PauseRollout_S">
      <bpmn:conditionExpression>=riskLevel = "high"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S_SOPToEnd" sourceRef="Task_PromoteSOP_S" targetRef="EndEvent_Shinshi" />
    <bpmn:sequenceFlow id="Flow_S_DMNToEnd" sourceRef="Task_DMNPolicy_S" targetRef="EndEvent_Shinshi" />
    <bpmn:sequenceFlow id="Flow_S_PauseToEnd" sourceRef="Task_PauseRollout_S" targetRef="EndEvent_Shinshi" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Shinshi">
    <bpmndi:BPMNPlane id="BPMNPlane_Shinshi" bpmnElement="Collaboration_Shinshi">
      <bpmndi:BPMNShape id="Pool_Shinshi_di" bpmnElement="Pool_Shinshi" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1440" height="540" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ContentPipeline_di" bpmnElement="Lane_ContentPipeline" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1410" height="180" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_QualityCompliance_di" bpmnElement="Lane_QualityCompliance" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="1410" height="180" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Distribution_di" bpmnElement="Lane_Distribution" isHorizontal="true">
        <dc:Bounds x="190" y="440" width="1410" height="180" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <!-- Nodes -->
      <bpmndi:BPMNShape id="StartEvent_Shinshi_di" bpmnElement="StartEvent_Shinshi">
        <dc:Bounds x="242" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="218" y="195" width="84" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ParallelOpen_S_di" bpmnElement="Gateway_ParallelOpen_S">
        <dc:Bounds x="335" y="145" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="310" y="202" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CrawlerHealth_di" bpmnElement="Task_CrawlerHealth">
        <dc:Bounds x="460" y="100" width="120" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ContentVolume_di" bpmnElement="Task_ContentVolume">
        <dc:Bounds x="460" y="200" width="120" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ModelPipeline_di" bpmnElement="Task_ModelPipeline">
        <dc:Bounds x="460" y="290" width="120" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ParallelClose_S_di" bpmnElement="Gateway_ParallelClose_S">
        <dc:Bounds x="655" y="145" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="640" y="202" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ContentQuality_di" bpmnElement="Task_ContentQuality">
        <dc:Bounds x="780" y="290" width="120" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RiskLevel_S_di" bpmnElement="Gateway_RiskLevel_S" isMarkerVisible="true">
        <dc:Bounds x="975" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="970" y="372" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PromoteSOP_S_di" bpmnElement="Task_PromoteSOP_S">
        <dc:Bounds x="1100" y="100" width="120" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DMNPolicy_S_di" bpmnElement="Task_DMNPolicy_S">
        <dc:Bounds x="1100" y="300" width="120" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PauseRollout_S_di" bpmnElement="Task_PauseRollout_S">
        <dc:Bounds x="1100" y="490" width="120" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Shinshi_di" bpmnElement="EndEvent_Shinshi">
        <dc:Bounds x="1362" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1336" y="365" width="88" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <!-- Flows -->
      <bpmndi:BPMNEdge id="Flow_S_StartToParallel_di" bpmnElement="Flow_S_StartToParallel">
        <di:waypoint x="278" y="170" /><di:waypoint x="335" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S_ToCrawler_di" bpmnElement="Flow_S_ToCrawler">
        <di:waypoint x="360" y="145" /><di:waypoint x="360" y="140" /><di:waypoint x="460" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S_ToContent_di" bpmnElement="Flow_S_ToContent">
        <di:waypoint x="385" y="170" /><di:waypoint x="460" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S_ToModel_di" bpmnElement="Flow_S_ToModel">
        <di:waypoint x="360" y="195" /><di:waypoint x="360" y="330" /><di:waypoint x="460" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S_CrawlerToJoin_di" bpmnElement="Flow_S_CrawlerToJoin">
        <di:waypoint x="580" y="140" /><di:waypoint x="680" y="140" /><di:waypoint x="680" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S_ContentToJoin_di" bpmnElement="Flow_S_ContentToJoin">
        <di:waypoint x="580" y="240" /><di:waypoint x="680" y="240" /><di:waypoint x="680" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S_ModelToJoin_di" bpmnElement="Flow_S_ModelToJoin">
        <di:waypoint x="580" y="330" /><di:waypoint x="680" y="330" /><di:waypoint x="680" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S_JoinToQuality_di" bpmnElement="Flow_S_JoinToQuality">
        <di:waypoint x="680" y="195" /><di:waypoint x="680" y="330" /><di:waypoint x="780" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S_QualityToRisk_di" bpmnElement="Flow_S_QualityToRisk">
        <di:waypoint x="900" y="340" /><di:waypoint x="975" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S_ToPromoteSOP_di" bpmnElement="Flow_S_ToPromoteSOP">
        <di:waypoint x="1000" y="315" /><di:waypoint x="1000" y="140" /><di:waypoint x="1100" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S_ToDMNPolicy_di" bpmnElement="Flow_S_ToDMNPolicy">
        <di:waypoint x="1025" y="340" /><di:waypoint x="1100" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S_ToPauseRollout_di" bpmnElement="Flow_S_ToPauseRollout">
        <di:waypoint x="1000" y="365" /><di:waypoint x="1000" y="530" /><di:waypoint x="1100" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S_SOPToEnd_di" bpmnElement="Flow_S_SOPToEnd">
        <di:waypoint x="1220" y="140" /><di:waypoint x="1380" y="140" /><di:waypoint x="1380" y="322" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S_DMNToEnd_di" bpmnElement="Flow_S_DMNToEnd">
        <di:waypoint x="1220" y="340" /><di:waypoint x="1362" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S_PauseToEnd_di" bpmnElement="Flow_S_PauseToEnd">
        <di:waypoint x="1220" y="530" /><di:waypoint x="1380" y="530" /><di:waypoint x="1380" y="358" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
