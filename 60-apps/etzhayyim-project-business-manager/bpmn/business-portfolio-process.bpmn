<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_Portfolio"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.17.0"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.2.0">

  <bpmn:collaboration id="Collaboration_Portfolio">
    <bpmn:participant id="Pool_Portfolio" name="Business Portfolio (bm4f8k2d1)" processRef="Process_Portfolio" />
  </bpmn:collaboration>

  <!-- Portfolio process: evaluates shinshi, web4, and news in parallel, then aggregates -->
  <bpmn:process id="Process_Portfolio" name="Business Portfolio Management Process" isExecutable="true">

    <bpmn:laneSet id="LaneSet_Portfolio">
      <bpmn:lane id="Lane_PortfolioManager" name="Portfolio Manager">
        <bpmn:flowNodeRef>StartEvent_Portfolio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PortfolioParallelOpen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PortfolioParallelClose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AggregateScore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PortfolioRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Portfolio</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ProjectEvaluations" name="Project Evaluations">
        <bpmn:flowNodeRef>Task_EvaluateShinshi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateWeb4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateNews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PortfolioSOP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PortfolioDMN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PortfolioPause</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start -->
    <bpmn:startEvent id="StartEvent_Portfolio" name="Portfolio evaluation&#10;triggered">
      <bpmn:outgoing>Flow_P_StartToParallel</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel project evaluations -->
    <bpmn:parallelGateway id="Gateway_PortfolioParallelOpen" name="Launch project&#10;evaluations">
      <bpmn:incoming>Flow_P_StartToParallel</bpmn:incoming>
      <bpmn:outgoing>Flow_P_ToShinshi</bpmn:outgoing>
      <bpmn:outgoing>Flow_P_ToWeb4</bpmn:outgoing>
      <bpmn:outgoing>Flow_P_ToNews</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="Task_EvaluateShinshi" name="Evaluate Shinshi&#10;(shinshi-business-process)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.portfolio.evaluate_project" />
        <zeebe:taskHeaders>
          <zeebe:header key="project" value="shinshi" />
          <zeebe:header key="nanoid" value="sh1n5h1x" />
          <zeebe:header key="url" value="https://shinshi.etzhayyim.com" />
          <zeebe:header key="process" value="shinshi-business-process" />
          <zeebe:header key="kpis" value="content_coverage,crawler_health,model_pipeline,engagement_rate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_P_ToShinshi</bpmn:incoming>
      <bpmn:outgoing>Flow_P_ShinshiToJoin</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_EvaluateWeb4" name="Evaluate Web4&#10;(web4-business-process)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.portfolio.evaluate_project" />
        <zeebe:taskHeaders>
          <zeebe:header key="project" value="web4" />
          <zeebe:header key="nanoid" value="web4" />
          <zeebe:header key="url" value="https://web4.etzhayyim.com" />
          <zeebe:header key="process" value="web4-business-process" />
          <zeebe:header key="kpis" value="contract_health,model_distribution,inference_pipeline,token_economics" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_P_ToWeb4</bpmn:incoming>
      <bpmn:outgoing>Flow_P_Web4ToJoin</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_EvaluateNews" name="Evaluate News&#10;(news-business-process)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.portfolio.evaluate_project" />
        <zeebe:taskHeaders>
          <zeebe:header key="project" value="news" />
          <zeebe:header key="nanoid" value="r5wvpkot" />
          <zeebe:header key="url" value="https://news.etzhayyim.com" />
          <zeebe:header key="process" value="news-business-process" />
          <zeebe:header key="kpis" value="content_freshness,rss_coverage,writer_pipeline,category_health" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_P_ToNews</bpmn:incoming>
      <bpmn:outgoing>Flow_P_NewsToJoin</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Join -->
    <bpmn:parallelGateway id="Gateway_PortfolioParallelClose" name="All evaluations&#10;complete">
      <bpmn:incoming>Flow_P_ShinshiToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_P_Web4ToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_P_NewsToJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_P_JoinToAggregate</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Aggregate score -->
    <bpmn:serviceTask id="Task_AggregateScore" name="Aggregate Portfolio Score&#10;(weighted average of 3 domains)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.portfolio.aggregate_score" />
        <zeebe:taskHeaders>
          <zeebe:header key="weights" value="shinshi=0.35,web4=0.30,news=0.35" />
          <zeebe:header key="scoreThresholdHigh" value="85" />
          <zeebe:header key="scoreThresholdMedium" value="65" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_P_JoinToAggregate</bpmn:incoming>
      <bpmn:outgoing>Flow_P_AggregateToRisk</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Portfolio risk -->
    <bpmn:exclusiveGateway id="Gateway_PortfolioRisk" name="Portfolio risk?">
      <bpmn:incoming>Flow_P_AggregateToRisk</bpmn:incoming>
      <bpmn:outgoing>Flow_P_ToPortfolioSOP</bpmn:outgoing>
      <bpmn:outgoing>Flow_P_ToPortfolioDMN</bpmn:outgoing>
      <bpmn:outgoing>Flow_P_ToPortfolioPause</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Portfolio actions -->
    <bpmn:serviceTask id="Task_PortfolioSOP" name="Promote portfolio to SOP&#10;&amp; schedule next review cycle">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.portfolio.promote_sop" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="promote_to_sop" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_P_ToPortfolioSOP</bpmn:incoming>
      <bpmn:outgoing>Flow_P_SOPToReport</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_PortfolioDMN" name="Run DMN Policy Evaluation&#10;&amp; rebalance project weights">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.portfolio.dmn_policy_evaluation" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="dmn_policy_evaluation" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_P_ToPortfolioDMN</bpmn:incoming>
      <bpmn:outgoing>Flow_P_DMNToReport</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_PortfolioPause" name="Pause portfolio rollout&#10;&amp; trigger executive review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.portfolio.pause_rollout" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="pause_and_manual_review" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_P_ToPortfolioPause</bpmn:incoming>
      <bpmn:outgoing>Flow_P_PauseToReport</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Generate report -->
    <bpmn:serviceTask id="Task_GenerateReport" name="Generate Portfolio Report&#10;(shinshi + web4 + news summary)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.portfolio.generate_report" />
        <zeebe:taskHeaders>
          <zeebe:header key="projects" value="shinshi,web4,news" />
          <zeebe:header key="format" value="json" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_P_SOPToReport</bpmn:incoming>
      <bpmn:incoming>Flow_P_DMNToReport</bpmn:incoming>
      <bpmn:incoming>Flow_P_PauseToReport</bpmn:incoming>
      <bpmn:outgoing>Flow_P_ReportToEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Portfolio" name="Portfolio report&#10;delivered">
      <bpmn:incoming>Flow_P_ReportToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_P_StartToParallel" sourceRef="StartEvent_Portfolio" targetRef="Gateway_PortfolioParallelOpen" />
    <bpmn:sequenceFlow id="Flow_P_ToShinshi" sourceRef="Gateway_PortfolioParallelOpen" targetRef="Task_EvaluateShinshi" />
    <bpmn:sequenceFlow id="Flow_P_ToWeb4" sourceRef="Gateway_PortfolioParallelOpen" targetRef="Task_EvaluateWeb4" />
    <bpmn:sequenceFlow id="Flow_P_ToNews" sourceRef="Gateway_PortfolioParallelOpen" targetRef="Task_EvaluateNews" />
    <bpmn:sequenceFlow id="Flow_P_ShinshiToJoin" sourceRef="Task_EvaluateShinshi" targetRef="Gateway_PortfolioParallelClose" />
    <bpmn:sequenceFlow id="Flow_P_Web4ToJoin" sourceRef="Task_EvaluateWeb4" targetRef="Gateway_PortfolioParallelClose" />
    <bpmn:sequenceFlow id="Flow_P_NewsToJoin" sourceRef="Task_EvaluateNews" targetRef="Gateway_PortfolioParallelClose" />
    <bpmn:sequenceFlow id="Flow_P_JoinToAggregate" sourceRef="Gateway_PortfolioParallelClose" targetRef="Task_AggregateScore" />
    <bpmn:sequenceFlow id="Flow_P_AggregateToRisk" sourceRef="Task_AggregateScore" targetRef="Gateway_PortfolioRisk" />
    <bpmn:sequenceFlow id="Flow_P_ToPortfolioSOP" name="low risk (score ≥ 85)" sourceRef="Gateway_PortfolioRisk" targetRef="Task_PortfolioSOP">
      <bpmn:conditionExpression>=riskLevel = "low"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_P_ToPortfolioDMN" name="medium risk (65–84)" sourceRef="Gateway_PortfolioRisk" targetRef="Task_PortfolioDMN">
      <bpmn:conditionExpression>=riskLevel = "medium"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_P_ToPortfolioPause" name="high risk (score &lt; 65)" sourceRef="Gateway_PortfolioRisk" targetRef="Task_PortfolioPause">
      <bpmn:conditionExpression>=riskLevel = "high"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_P_SOPToReport" sourceRef="Task_PortfolioSOP" targetRef="Task_GenerateReport" />
    <bpmn:sequenceFlow id="Flow_P_DMNToReport" sourceRef="Task_PortfolioDMN" targetRef="Task_GenerateReport" />
    <bpmn:sequenceFlow id="Flow_P_PauseToReport" sourceRef="Task_PortfolioPause" targetRef="Task_GenerateReport" />
    <bpmn:sequenceFlow id="Flow_P_ReportToEnd" sourceRef="Task_GenerateReport" targetRef="EndEvent_Portfolio" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Portfolio">
    <bpmndi:BPMNPlane id="BPMNPlane_Portfolio" bpmnElement="Collaboration_Portfolio">
      <bpmndi:BPMNShape id="Pool_Portfolio_di" bpmnElement="Pool_Portfolio" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1760" height="540" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_PortfolioManager_di" bpmnElement="Lane_PortfolioManager" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1730" height="240" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ProjectEvaluations_di" bpmnElement="Lane_ProjectEvaluations" isHorizontal="true">
        <dc:Bounds x="190" y="320" width="1730" height="300" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <!-- Manager lane nodes -->
      <bpmndi:BPMNShape id="StartEvent_Portfolio_di" bpmnElement="StartEvent_Portfolio">
        <dc:Bounds x="242" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="218" y="225" width="84" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PortfolioParallelOpen_di" bpmnElement="Gateway_PortfolioParallelOpen">
        <dc:Bounds x="345" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="322" y="232" width="96" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PortfolioParallelClose_di" bpmnElement="Gateway_PortfolioParallelClose">
        <dc:Bounds x="845" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="820" y="232" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AggregateScore_di" bpmnElement="Task_AggregateScore">
        <dc:Bounds x="970" y="160" width="160" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PortfolioRisk_di" bpmnElement="Gateway_PortfolioRisk" isMarkerVisible="true">
        <dc:Bounds x="1205" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1196" y="232" width="68" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GenerateReport_di" bpmnElement="Task_GenerateReport">
        <dc:Bounds x="1500" y="160" width="160" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Portfolio_di" bpmnElement="EndEvent_Portfolio">
        <dc:Bounds x="1732" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1706" y="225" width="88" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <!-- Project evaluations lane nodes -->
      <bpmndi:BPMNShape id="Task_EvaluateShinshi_di" bpmnElement="Task_EvaluateShinshi">
        <dc:Bounds x="460" y="340" width="160" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EvaluateWeb4_di" bpmnElement="Task_EvaluateWeb4">
        <dc:Bounds x="460" y="450" width="160" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EvaluateNews_di" bpmnElement="Task_EvaluateNews">
        <dc:Bounds x="460" y="560" width="160" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PortfolioSOP_di" bpmnElement="Task_PortfolioSOP">
        <dc:Bounds x="1330" y="340" width="160" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PortfolioDMN_di" bpmnElement="Task_PortfolioDMN">
        <dc:Bounds x="1330" y="450" width="160" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PortfolioPause_di" bpmnElement="Task_PortfolioPause">
        <dc:Bounds x="1330" y="560" width="160" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <!-- Flows -->
      <bpmndi:BPMNEdge id="Flow_P_StartToParallel_di" bpmnElement="Flow_P_StartToParallel">
        <di:waypoint x="278" y="200" /><di:waypoint x="345" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P_ToShinshi_di" bpmnElement="Flow_P_ToShinshi">
        <di:waypoint x="370" y="225" /><di:waypoint x="370" y="380" /><di:waypoint x="460" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P_ToWeb4_di" bpmnElement="Flow_P_ToWeb4">
        <di:waypoint x="370" y="225" /><di:waypoint x="370" y="490" /><di:waypoint x="460" y="490" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P_ToNews_di" bpmnElement="Flow_P_ToNews">
        <di:waypoint x="370" y="225" /><di:waypoint x="370" y="600" /><di:waypoint x="460" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P_ShinshiToJoin_di" bpmnElement="Flow_P_ShinshiToJoin">
        <di:waypoint x="620" y="380" /><di:waypoint x="870" y="380" /><di:waypoint x="870" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P_Web4ToJoin_di" bpmnElement="Flow_P_Web4ToJoin">
        <di:waypoint x="620" y="490" /><di:waypoint x="870" y="490" /><di:waypoint x="870" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P_NewsToJoin_di" bpmnElement="Flow_P_NewsToJoin">
        <di:waypoint x="620" y="600" /><di:waypoint x="870" y="600" /><di:waypoint x="870" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P_JoinToAggregate_di" bpmnElement="Flow_P_JoinToAggregate">
        <di:waypoint x="895" y="200" /><di:waypoint x="970" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P_AggregateToRisk_di" bpmnElement="Flow_P_AggregateToRisk">
        <di:waypoint x="1130" y="200" /><di:waypoint x="1205" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P_ToPortfolioSOP_di" bpmnElement="Flow_P_ToPortfolioSOP">
        <di:waypoint x="1230" y="225" /><di:waypoint x="1230" y="380" /><di:waypoint x="1330" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P_ToPortfolioDMN_di" bpmnElement="Flow_P_ToPortfolioDMN">
        <di:waypoint x="1230" y="225" /><di:waypoint x="1230" y="490" /><di:waypoint x="1330" y="490" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P_ToPortfolioPause_di" bpmnElement="Flow_P_ToPortfolioPause">
        <di:waypoint x="1230" y="225" /><di:waypoint x="1230" y="600" /><di:waypoint x="1330" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P_SOPToReport_di" bpmnElement="Flow_P_SOPToReport">
        <di:waypoint x="1490" y="380" /><di:waypoint x="1580" y="380" /><di:waypoint x="1580" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P_DMNToReport_di" bpmnElement="Flow_P_DMNToReport">
        <di:waypoint x="1490" y="490" /><di:waypoint x="1580" y="490" /><di:waypoint x="1580" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P_PauseToReport_di" bpmnElement="Flow_P_PauseToReport">
        <di:waypoint x="1490" y="600" /><di:waypoint x="1580" y="600" /><di:waypoint x="1580" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P_ReportToEnd_di" bpmnElement="Flow_P_ReportToEnd">
        <di:waypoint x="1660" y="200" /><di:waypoint x="1732" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
