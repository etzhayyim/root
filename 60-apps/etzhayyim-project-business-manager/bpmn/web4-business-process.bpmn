<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_Web4"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.17.0"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.2.0">

  <bpmn:collaboration id="Collaboration_Web4">
    <bpmn:participant id="Pool_Web4" name="Web4 Platform (web4.etzhayyim.com)" processRef="Process_Web4" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Web4" name="Web4 Business Management Process" isExecutable="true">

    <bpmn:laneSet id="LaneSet_Web4">
      <bpmn:lane id="Lane_Blockchain" name="Blockchain Operations">
        <bpmn:flowNodeRef>StartEvent_Web4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelOpen_W</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContractMonitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelClose_W</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ModelDistribution" name="Model Distribution">
        <bpmn:flowNodeRef>Task_ModelDistribution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TokenEconomics</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskLevel_W</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_InferencePipeline" name="Inference Pipeline">
        <bpmn:flowNodeRef>Task_InferencePipeline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PromoteSOP_W</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DMNPolicy_W</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PauseRollout_W</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Web4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start -->
    <bpmn:startEvent id="StartEvent_Web4" name="Business evaluation&#10;triggered">
      <bpmn:outgoing>Flow_W_StartToParallel</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel checks -->
    <bpmn:parallelGateway id="Gateway_ParallelOpen_W" name="Parallel checks start">
      <bpmn:incoming>Flow_W_StartToParallel</bpmn:incoming>
      <bpmn:outgoing>Flow_W_ToContract</bpmn:outgoing>
      <bpmn:outgoing>Flow_W_ToModel</bpmn:outgoing>
      <bpmn:outgoing>Flow_W_ToInference</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="Task_ContractMonitor" name="Monitor Smart Contracts&#10;(GCC, GCCMinter, oracle)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.web4.monitor_smart_contracts" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="contract_health" />
          <zeebe:header key="contracts" value="0x799d24a6FFBb758C6E2Ed8f981822A17Eaa5F30B,0xAf80b152eD85067F8386416767b9658E86C253d9" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_W_ToContract</bpmn:incoming>
      <bpmn:outgoing>Flow_W_ContractToJoin</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_ModelDistribution" name="Check Model Distribution&#10;(Linode S3, 32 experts/model)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.web4.check_model_distribution" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="model_distribution" />
          <zeebe:header key="bucket" value="etzhayyim-static-sites" />
          <zeebe:header key="models" value="etzhayyim-distributed-moe-260222,etzhayyim-distributed-ti2v-moe-260222" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_W_ToModel</bpmn:incoming>
      <bpmn:outgoing>Flow_W_ModelToJoin</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_InferencePipeline" name="Check Inference Pipeline&#10;(inference-core, scheduler)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.web4.check_inference_pipeline" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="inference_pipeline" />
          <zeebe:header key="components" value="web4-inference-core-4v2q9m1k,web4-scheduler-wycuoljt" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_W_ToInference</bpmn:incoming>
      <bpmn:outgoing>Flow_W_InferenceToJoin</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:parallelGateway id="Gateway_ParallelClose_W" name="Checks complete">
      <bpmn:incoming>Flow_W_ContractToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_W_ModelToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_W_InferenceToJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_W_JoinToTokens</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Token economics -->
    <bpmn:serviceTask id="Task_TokenEconomics" name="Token Economics Assessment&#10;(GCC supply, USDC volume)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.web4.assess_token_economics" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="token_economics" />
          <zeebe:header key="scoreThresholdHigh" value="85" />
          <zeebe:header key="scoreThresholdMedium" value="65" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_W_JoinToTokens</bpmn:incoming>
      <bpmn:outgoing>Flow_W_TokensToRisk</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Risk classification -->
    <bpmn:exclusiveGateway id="Gateway_RiskLevel_W" name="Risk level?">
      <bpmn:incoming>Flow_W_TokensToRisk</bpmn:incoming>
      <bpmn:outgoing>Flow_W_ToPromoteSOP</bpmn:outgoing>
      <bpmn:outgoing>Flow_W_ToDMNPolicy</bpmn:outgoing>
      <bpmn:outgoing>Flow_W_ToPauseRollout</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Actions -->
    <bpmn:serviceTask id="Task_PromoteSOP_W" name="Promote to SOP&#10;&amp; schedule contract audit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.web4.promote_sop" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="promote_to_sop" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_W_ToPromoteSOP</bpmn:incoming>
      <bpmn:outgoing>Flow_W_SOPToEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_DMNPolicy_W" name="Run DMN Policy Evaluation&#10;&amp; validate inference scaling">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.web4.dmn_policy_evaluation" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="dmn_policy_evaluation" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_W_ToDMNPolicy</bpmn:incoming>
      <bpmn:outgoing>Flow_W_DMNToEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_PauseRollout_W" name="Pause rollout&#10;&amp; close missing DMN inputs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.web4.pause_rollout" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="pause_and_manual_review" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_W_ToPauseRollout</bpmn:incoming>
      <bpmn:outgoing>Flow_W_PauseToEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Web4" name="Evaluation report&#10;generated">
      <bpmn:incoming>Flow_W_SOPToEnd</bpmn:incoming>
      <bpmn:incoming>Flow_W_DMNToEnd</bpmn:incoming>
      <bpmn:incoming>Flow_W_PauseToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_W_StartToParallel" sourceRef="StartEvent_Web4" targetRef="Gateway_ParallelOpen_W" />
    <bpmn:sequenceFlow id="Flow_W_ToContract" sourceRef="Gateway_ParallelOpen_W" targetRef="Task_ContractMonitor" />
    <bpmn:sequenceFlow id="Flow_W_ToModel" sourceRef="Gateway_ParallelOpen_W" targetRef="Task_ModelDistribution" />
    <bpmn:sequenceFlow id="Flow_W_ToInference" sourceRef="Gateway_ParallelOpen_W" targetRef="Task_InferencePipeline" />
    <bpmn:sequenceFlow id="Flow_W_ContractToJoin" sourceRef="Task_ContractMonitor" targetRef="Gateway_ParallelClose_W" />
    <bpmn:sequenceFlow id="Flow_W_ModelToJoin" sourceRef="Task_ModelDistribution" targetRef="Gateway_ParallelClose_W" />
    <bpmn:sequenceFlow id="Flow_W_InferenceToJoin" sourceRef="Task_InferencePipeline" targetRef="Gateway_ParallelClose_W" />
    <bpmn:sequenceFlow id="Flow_W_JoinToTokens" sourceRef="Gateway_ParallelClose_W" targetRef="Task_TokenEconomics" />
    <bpmn:sequenceFlow id="Flow_W_TokensToRisk" sourceRef="Task_TokenEconomics" targetRef="Gateway_RiskLevel_W" />
    <bpmn:sequenceFlow id="Flow_W_ToPromoteSOP" name="low risk (score ≥ 85)" sourceRef="Gateway_RiskLevel_W" targetRef="Task_PromoteSOP_W">
      <bpmn:conditionExpression>=riskLevel = "low"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_W_ToDMNPolicy" name="medium risk (65–84)" sourceRef="Gateway_RiskLevel_W" targetRef="Task_DMNPolicy_W">
      <bpmn:conditionExpression>=riskLevel = "medium"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_W_ToPauseRollout" name="high risk (score &lt; 65)" sourceRef="Gateway_RiskLevel_W" targetRef="Task_PauseRollout_W">
      <bpmn:conditionExpression>=riskLevel = "high"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_W_SOPToEnd" sourceRef="Task_PromoteSOP_W" targetRef="EndEvent_Web4" />
    <bpmn:sequenceFlow id="Flow_W_DMNToEnd" sourceRef="Task_DMNPolicy_W" targetRef="EndEvent_Web4" />
    <bpmn:sequenceFlow id="Flow_W_PauseToEnd" sourceRef="Task_PauseRollout_W" targetRef="EndEvent_Web4" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Web4">
    <bpmndi:BPMNPlane id="BPMNPlane_Web4" bpmnElement="Collaboration_Web4">
      <bpmndi:BPMNShape id="Pool_Web4_di" bpmnElement="Pool_Web4" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1440" height="540" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Blockchain_di" bpmnElement="Lane_Blockchain" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1410" height="180" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ModelDistribution_di" bpmnElement="Lane_ModelDistribution" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="1410" height="180" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_InferencePipeline_di" bpmnElement="Lane_InferencePipeline" isHorizontal="true">
        <dc:Bounds x="190" y="440" width="1410" height="180" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Web4_di" bpmnElement="StartEvent_Web4">
        <dc:Bounds x="242" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="218" y="195" width="84" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ParallelOpen_W_di" bpmnElement="Gateway_ParallelOpen_W">
        <dc:Bounds x="335" y="145" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="310" y="202" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ContractMonitor_di" bpmnElement="Task_ContractMonitor">
        <dc:Bounds x="460" y="100" width="140" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ModelDistribution_di" bpmnElement="Task_ModelDistribution">
        <dc:Bounds x="460" y="290" width="140" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InferencePipeline_di" bpmnElement="Task_InferencePipeline">
        <dc:Bounds x="460" y="490" width="140" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ParallelClose_W_di" bpmnElement="Gateway_ParallelClose_W">
        <dc:Bounds x="675" y="145" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="660" y="202" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TokenEconomics_di" bpmnElement="Task_TokenEconomics">
        <dc:Bounds x="800" y="290" width="140" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RiskLevel_W_di" bpmnElement="Gateway_RiskLevel_W" isMarkerVisible="true">
        <dc:Bounds x="1010" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1005" y="372" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PromoteSOP_W_di" bpmnElement="Task_PromoteSOP_W">
        <dc:Bounds x="1130" y="100" width="140" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DMNPolicy_W_di" bpmnElement="Task_DMNPolicy_W">
        <dc:Bounds x="1130" y="300" width="140" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PauseRollout_W_di" bpmnElement="Task_PauseRollout_W">
        <dc:Bounds x="1130" y="490" width="140" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Web4_di" bpmnElement="EndEvent_Web4">
        <dc:Bounds x="1382" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1356" y="365" width="88" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <!-- Flows -->
      <bpmndi:BPMNEdge id="Flow_W_StartToParallel_di" bpmnElement="Flow_W_StartToParallel">
        <di:waypoint x="278" y="170" /><di:waypoint x="335" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W_ToContract_di" bpmnElement="Flow_W_ToContract">
        <di:waypoint x="360" y="145" /><di:waypoint x="360" y="140" /><di:waypoint x="460" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W_ToModel_di" bpmnElement="Flow_W_ToModel">
        <di:waypoint x="360" y="195" /><di:waypoint x="360" y="330" /><di:waypoint x="460" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W_ToInference_di" bpmnElement="Flow_W_ToInference">
        <di:waypoint x="360" y="195" /><di:waypoint x="360" y="530" /><di:waypoint x="460" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W_ContractToJoin_di" bpmnElement="Flow_W_ContractToJoin">
        <di:waypoint x="600" y="140" /><di:waypoint x="700" y="140" /><di:waypoint x="700" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W_ModelToJoin_di" bpmnElement="Flow_W_ModelToJoin">
        <di:waypoint x="600" y="330" /><di:waypoint x="700" y="330" /><di:waypoint x="700" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W_InferenceToJoin_di" bpmnElement="Flow_W_InferenceToJoin">
        <di:waypoint x="600" y="530" /><di:waypoint x="700" y="530" /><di:waypoint x="700" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W_JoinToTokens_di" bpmnElement="Flow_W_JoinToTokens">
        <di:waypoint x="700" y="195" /><di:waypoint x="700" y="330" /><di:waypoint x="800" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W_TokensToRisk_di" bpmnElement="Flow_W_TokensToRisk">
        <di:waypoint x="940" y="340" /><di:waypoint x="1010" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W_ToPromoteSOP_di" bpmnElement="Flow_W_ToPromoteSOP">
        <di:waypoint x="1035" y="315" /><di:waypoint x="1035" y="140" /><di:waypoint x="1130" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W_ToDMNPolicy_di" bpmnElement="Flow_W_ToDMNPolicy">
        <di:waypoint x="1060" y="340" /><di:waypoint x="1130" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W_ToPauseRollout_di" bpmnElement="Flow_W_ToPauseRollout">
        <di:waypoint x="1035" y="365" /><di:waypoint x="1035" y="530" /><di:waypoint x="1130" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W_SOPToEnd_di" bpmnElement="Flow_W_SOPToEnd">
        <di:waypoint x="1270" y="140" /><di:waypoint x="1400" y="140" /><di:waypoint x="1400" y="322" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W_DMNToEnd_di" bpmnElement="Flow_W_DMNToEnd">
        <di:waypoint x="1270" y="340" /><di:waypoint x="1382" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W_PauseToEnd_di" bpmnElement="Flow_W_PauseToEnd">
        <di:waypoint x="1270" y="530" /><di:waypoint x="1400" y="530" /><di:waypoint x="1400" y="358" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
