<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_News"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.17.0"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.2.0">

  <bpmn:collaboration id="Collaboration_News">
    <bpmn:participant id="Pool_News" name="News Content Platform (r5wvpkot)" processRef="Process_News" />
  </bpmn:collaboration>

  <bpmn:process id="Process_News" name="News Business Management Process" isExecutable="true">

    <bpmn:laneSet id="LaneSet_News">
      <bpmn:lane id="Lane_Ingestion" name="Ingestion">
        <bpmn:flowNodeRef>StartEvent_News</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelOpen_N</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RSSCollector</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelClose_N</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ContentGeneration" name="Content Generation">
        <bpmn:flowNodeRef>Task_WriterPipeline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContentFreshness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskLevel_N</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NewsDistribution" name="Distribution">
        <bpmn:flowNodeRef>Task_CategoryCoverage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PromoteSOP_N</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DMNPolicy_N</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PauseRollout_N</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_News</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start -->
    <bpmn:startEvent id="StartEvent_News" name="Business evaluation&#10;triggered">
      <bpmn:outgoing>Flow_N_StartToParallel</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel checks -->
    <bpmn:parallelGateway id="Gateway_ParallelOpen_N" name="Parallel checks start">
      <bpmn:incoming>Flow_N_StartToParallel</bpmn:incoming>
      <bpmn:outgoing>Flow_N_ToRSS</bpmn:outgoing>
      <bpmn:outgoing>Flow_N_ToWriter</bpmn:outgoing>
      <bpmn:outgoing>Flow_N_ToCategory</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="Task_RSSCollector" name="RSS Collector Health&#10;(rss_sources, feed_count)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.news.check_rss_collector_health" />
        <zeebe:taskHeaders>
          <zeebe:header key="nanoid" value="r5wvpkot" />
          <zeebe:header key="kpi" value="rss_coverage" />
          <zeebe:header key="component" value="rss-collector-component" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_N_ToRSS</bpmn:incoming>
      <bpmn:outgoing>Flow_N_RSSToJoin</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_WriterPipeline" name="Writer Pipeline Status&#10;(anime, game, trend, AI lead)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.news.check_writer_pipeline" />
        <zeebe:taskHeaders>
          <zeebe:header key="nanoid" value="r5wvpkot" />
          <zeebe:header key="kpi" value="writer_pipeline" />
          <zeebe:header key="components" value="writer-anime-editor-component,writer-game-insider-component,writer-trend-analyzer-component,writer-ai-lead-component" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_N_ToWriter</bpmn:incoming>
      <bpmn:outgoing>Flow_N_WriterToJoin</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_CategoryCoverage" name="Category Coverage Check&#10;(anime, games, industry)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.news.check_category_coverage" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="category_health" />
          <zeebe:header key="categories" value="anime,games,industry,jobs" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_N_ToCategory</bpmn:incoming>
      <bpmn:outgoing>Flow_N_CategoryToJoin</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:parallelGateway id="Gateway_ParallelClose_N" name="Checks complete">
      <bpmn:incoming>Flow_N_RSSToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_N_WriterToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_N_CategoryToJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_N_JoinToFreshness</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Content freshness -->
    <bpmn:serviceTask id="Task_ContentFreshness" name="Assess Content Freshness&#10;(article_count, publish_rate)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.news.assess_content_freshness" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="content_freshness" />
          <zeebe:header key="scoreThresholdHigh" value="85" />
          <zeebe:header key="scoreThresholdMedium" value="65" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_N_JoinToFreshness</bpmn:incoming>
      <bpmn:outgoing>Flow_N_FreshnessToRisk</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Risk classification -->
    <bpmn:exclusiveGateway id="Gateway_RiskLevel_N" name="Risk level?">
      <bpmn:incoming>Flow_N_FreshnessToRisk</bpmn:incoming>
      <bpmn:outgoing>Flow_N_ToPromoteSOP</bpmn:outgoing>
      <bpmn:outgoing>Flow_N_ToDMNPolicy</bpmn:outgoing>
      <bpmn:outgoing>Flow_N_ToPauseRollout</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Actions -->
    <bpmn:serviceTask id="Task_PromoteSOP_N" name="Promote to SOP&#10;&amp; extend editorial schedule">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.news.promote_sop" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="promote_to_sop" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_N_ToPromoteSOP</bpmn:incoming>
      <bpmn:outgoing>Flow_N_SOPToEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_DMNPolicy_N" name="Run DMN Policy Evaluation&#10;&amp; validate writer fallback path">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.news.dmn_policy_evaluation" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="dmn_policy_evaluation" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_N_ToDMNPolicy</bpmn:incoming>
      <bpmn:outgoing>Flow_N_DMNToEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_PauseRollout_N" name="Pause rollout&#10;&amp; trigger editorial review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bm.news.pause_rollout" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="pause_and_manual_review" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_N_ToPauseRollout</bpmn:incoming>
      <bpmn:outgoing>Flow_N_PauseToEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_News" name="Evaluation report&#10;generated">
      <bpmn:incoming>Flow_N_SOPToEnd</bpmn:incoming>
      <bpmn:incoming>Flow_N_DMNToEnd</bpmn:incoming>
      <bpmn:incoming>Flow_N_PauseToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_N_StartToParallel" sourceRef="StartEvent_News" targetRef="Gateway_ParallelOpen_N" />
    <bpmn:sequenceFlow id="Flow_N_ToRSS" sourceRef="Gateway_ParallelOpen_N" targetRef="Task_RSSCollector" />
    <bpmn:sequenceFlow id="Flow_N_ToWriter" sourceRef="Gateway_ParallelOpen_N" targetRef="Task_WriterPipeline" />
    <bpmn:sequenceFlow id="Flow_N_ToCategory" sourceRef="Gateway_ParallelOpen_N" targetRef="Task_CategoryCoverage" />
    <bpmn:sequenceFlow id="Flow_N_RSSToJoin" sourceRef="Task_RSSCollector" targetRef="Gateway_ParallelClose_N" />
    <bpmn:sequenceFlow id="Flow_N_WriterToJoin" sourceRef="Task_WriterPipeline" targetRef="Gateway_ParallelClose_N" />
    <bpmn:sequenceFlow id="Flow_N_CategoryToJoin" sourceRef="Task_CategoryCoverage" targetRef="Gateway_ParallelClose_N" />
    <bpmn:sequenceFlow id="Flow_N_JoinToFreshness" sourceRef="Gateway_ParallelClose_N" targetRef="Task_ContentFreshness" />
    <bpmn:sequenceFlow id="Flow_N_FreshnessToRisk" sourceRef="Task_ContentFreshness" targetRef="Gateway_RiskLevel_N" />
    <bpmn:sequenceFlow id="Flow_N_ToPromoteSOP" name="low risk (score ≥ 85)" sourceRef="Gateway_RiskLevel_N" targetRef="Task_PromoteSOP_N">
      <bpmn:conditionExpression>=riskLevel = "low"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_N_ToDMNPolicy" name="medium risk (65–84)" sourceRef="Gateway_RiskLevel_N" targetRef="Task_DMNPolicy_N">
      <bpmn:conditionExpression>=riskLevel = "medium"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_N_ToPauseRollout" name="high risk (score &lt; 65)" sourceRef="Gateway_RiskLevel_N" targetRef="Task_PauseRollout_N">
      <bpmn:conditionExpression>=riskLevel = "high"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_N_SOPToEnd" sourceRef="Task_PromoteSOP_N" targetRef="EndEvent_News" />
    <bpmn:sequenceFlow id="Flow_N_DMNToEnd" sourceRef="Task_DMNPolicy_N" targetRef="EndEvent_News" />
    <bpmn:sequenceFlow id="Flow_N_PauseToEnd" sourceRef="Task_PauseRollout_N" targetRef="EndEvent_News" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_News">
    <bpmndi:BPMNPlane id="BPMNPlane_News" bpmnElement="Collaboration_News">
      <bpmndi:BPMNShape id="Pool_News_di" bpmnElement="Pool_News" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1440" height="540" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Ingestion_di" bpmnElement="Lane_Ingestion" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1410" height="180" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ContentGeneration_di" bpmnElement="Lane_ContentGeneration" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="1410" height="180" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_NewsDistribution_di" bpmnElement="Lane_NewsDistribution" isHorizontal="true">
        <dc:Bounds x="190" y="440" width="1410" height="180" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_News_di" bpmnElement="StartEvent_News">
        <dc:Bounds x="242" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="218" y="195" width="84" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ParallelOpen_N_di" bpmnElement="Gateway_ParallelOpen_N">
        <dc:Bounds x="335" y="145" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="310" y="202" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RSSCollector_di" bpmnElement="Task_RSSCollector">
        <dc:Bounds x="460" y="100" width="140" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_WriterPipeline_di" bpmnElement="Task_WriterPipeline">
        <dc:Bounds x="460" y="290" width="140" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CategoryCoverage_di" bpmnElement="Task_CategoryCoverage">
        <dc:Bounds x="460" y="490" width="140" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ParallelClose_N_di" bpmnElement="Gateway_ParallelClose_N">
        <dc:Bounds x="675" y="145" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="660" y="202" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ContentFreshness_di" bpmnElement="Task_ContentFreshness">
        <dc:Bounds x="800" y="290" width="140" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RiskLevel_N_di" bpmnElement="Gateway_RiskLevel_N" isMarkerVisible="true">
        <dc:Bounds x="1010" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1005" y="372" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PromoteSOP_N_di" bpmnElement="Task_PromoteSOP_N">
        <dc:Bounds x="1130" y="100" width="140" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DMNPolicy_N_di" bpmnElement="Task_DMNPolicy_N">
        <dc:Bounds x="1130" y="300" width="140" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PauseRollout_N_di" bpmnElement="Task_PauseRollout_N">
        <dc:Bounds x="1130" y="490" width="140" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_News_di" bpmnElement="EndEvent_News">
        <dc:Bounds x="1382" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1356" y="365" width="88" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <!-- Flows -->
      <bpmndi:BPMNEdge id="Flow_N_StartToParallel_di" bpmnElement="Flow_N_StartToParallel">
        <di:waypoint x="278" y="170" /><di:waypoint x="335" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_N_ToRSS_di" bpmnElement="Flow_N_ToRSS">
        <di:waypoint x="360" y="145" /><di:waypoint x="360" y="140" /><di:waypoint x="460" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_N_ToWriter_di" bpmnElement="Flow_N_ToWriter">
        <di:waypoint x="360" y="195" /><di:waypoint x="360" y="330" /><di:waypoint x="460" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_N_ToCategory_di" bpmnElement="Flow_N_ToCategory">
        <di:waypoint x="360" y="195" /><di:waypoint x="360" y="530" /><di:waypoint x="460" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_N_RSSToJoin_di" bpmnElement="Flow_N_RSSToJoin">
        <di:waypoint x="600" y="140" /><di:waypoint x="700" y="140" /><di:waypoint x="700" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_N_WriterToJoin_di" bpmnElement="Flow_N_WriterToJoin">
        <di:waypoint x="600" y="330" /><di:waypoint x="700" y="330" /><di:waypoint x="700" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_N_CategoryToJoin_di" bpmnElement="Flow_N_CategoryToJoin">
        <di:waypoint x="600" y="530" /><di:waypoint x="700" y="530" /><di:waypoint x="700" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_N_JoinToFreshness_di" bpmnElement="Flow_N_JoinToFreshness">
        <di:waypoint x="700" y="195" /><di:waypoint x="700" y="330" /><di:waypoint x="800" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_N_FreshnessToRisk_di" bpmnElement="Flow_N_FreshnessToRisk">
        <di:waypoint x="940" y="340" /><di:waypoint x="1010" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_N_ToPromoteSOP_di" bpmnElement="Flow_N_ToPromoteSOP">
        <di:waypoint x="1035" y="315" /><di:waypoint x="1035" y="140" /><di:waypoint x="1130" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_N_ToDMNPolicy_di" bpmnElement="Flow_N_ToDMNPolicy">
        <di:waypoint x="1060" y="340" /><di:waypoint x="1130" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_N_ToPauseRollout_di" bpmnElement="Flow_N_ToPauseRollout">
        <di:waypoint x="1035" y="365" /><di:waypoint x="1035" y="530" /><di:waypoint x="1130" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_N_SOPToEnd_di" bpmnElement="Flow_N_SOPToEnd">
        <di:waypoint x="1270" y="140" /><di:waypoint x="1400" y="140" /><di:waypoint x="1400" y="322" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_N_DMNToEnd_di" bpmnElement="Flow_N_DMNToEnd">
        <di:waypoint x="1270" y="340" /><di:waypoint x="1382" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_N_PauseToEnd_di" bpmnElement="Flow_N_PauseToEnd">
        <di:waypoint x="1270" y="530" /><di:waypoint x="1400" y="530" /><di:waypoint x="1400" y="358" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
