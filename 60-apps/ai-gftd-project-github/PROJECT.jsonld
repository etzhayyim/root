{
  "@context": "https://schema.org/",
  "@type": "SoftwareApplication",
  "@id": "urn:gftd:project:ai-gftd-project-github",
  "name": "ai-gftd-project-github",
  "description": "GitHub integration service — git-backed state store, GitHub App auth, PR proposals, issue creation, webhook handler, and scheduled git operations via legacy runtime",
  "applicationCategory": "ai-gftd-project-platform",
  "operatingSystem": "Kubernetes",
  "softwareRequirements": [
    "legacy runtime",
    "KEDA",
    "GitHub App (gftd-gitops-builder)"
  ],
  "author": {
    "@type": "Organization",
    "name": "GFTD",
    "url": "https://etzhayyim.com"
  },
  "codeRepository": "https://github.com/etzhayyim/etzhayyim-root",
  "programmingLanguage": "Go",
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "scheduler.jsonld",
        "content": {
          "@context": [
            "https://schema.org/",
            {
              "gftd": "https://etzhayyim.com/schemas/",
              "capabilities": "gftd:capabilities",
              "survivalIndicators": "gftd:survivalIndicators",
              "scheduler": "gftd:scheduler",
              "milestones": "gftd:milestones",
              "blockers": "gftd:blockers",
              "dependsOn": {
                "@id": "gftd:dependsOn",
                "@type": "@id"
              },
              "ingestKey": "gftd:ingestKey",
              "window": "gftd:window",
              "valueUpdatedAt": "gftd:valueUpdatedAt"
            }
          ],
          "@type": "CreativeWork",
          "name": "ai-gftd-project-github Scheduler",
          "identifier": "ai-gftd-project-github/scheduler",
          "description": "Project schedule (milestones) and blockers.",
          "dateCreated": "2026-02-15T04:25:26+00:00",
          "milestones": [],
          "blockers": []
        }
      }
    ]
  }
}
