{;; bb runner for the clj-native ports of the organism-viz pure-logic core:
 ;;   - pruning.cljc      (盆栽 剪定 candidate detector)
 ;;   - aliveness.cljc    (A(t) 5-tuple: motion/diversity/coupling/pruning/generational)
 ;;   - ideal_state.cljc  (homeostatic ranges — §1.15 bands, not targets)
 ;; The Python side stays the deployed FastAPI app (server.py/ecosystem.py/etc);
 ;; this covers the verified .cljc twins. tests/test_aliveness.py is mirrored by
 ;; aliveness_test.cljc. `bb test` and `bb run_tests.clj` are equivalent (repo rule:
 ;; ship a .clj runner, not a .sh).
 :paths ["src" "test"]
 :tasks
 {test
  {:doc "Run the organism-viz cljc test suite (pure fns + tmp-dir FS fixtures)."
   :requires ([clojure.test :as t]
              [etzhayyim-organism-viz.pruning-test]
              [etzhayyim-organism-viz.aliveness-test]
              [etzhayyim-organism-viz.ideal-state-test])
   :task (let [{:keys [fail error]}
               (t/run-tests 'etzhayyim-organism-viz.pruning-test
                            'etzhayyim-organism-viz.aliveness-test
                            'etzhayyim-organism-viz.ideal-state-test)]
           (System/exit (if (pos? (+ fail error)) 1 0)))}}}
