{;; Scoped babashka project for the lg-open-isic clj port (ADR-2606280030:
 ;; langgraph-python → langgraph-clj). This is the APP-LOCAL bb.edn — it does
 ;; NOT touch the repo-root bb.edn. Source root is `clj/` (the .cljc twins of
 ;; the former `lg_open_isic/**.py`). The Python was DELETED (ADR-2606280030,
 ;; DEV-stage twin-removal) now that each twin is verified — the clj twin is the
 ;; canonical code; this `clj/` tree is the sole runtime.
 ;;
 ;; HTTP/JSON/server host capabilities (babashka.http-client, cheshire.core,
 ;; org.httpkit.server) are all bundled in babashka — no extra deps. The
 ;; langgraph-clj/langchain-clj git shas are pinned to match the repo-root bb.edn.
 :paths ["clj"]
 :deps {com-junkawasaki/langchain-clj
        {:git/url "https://github.com/com-junkawasaki/langchain-clj"
         :git/sha "2b03859c3ee722b64f3eddd0b615a54019b17c81"}
        com-junkawasaki/langgraph-clj
        {:git/url "https://github.com/com-junkawasaki/langgraph-clj"
         :git/sha "c7daa07d4e50f55d7e2a02e4b89dbeb2b200961d"}}
 :tasks
 {test   {:doc  "Run the lg-open-isic clj test suites (clojure.test under bb)."
          :task (load-file "run_tests.clj")}
  server {:doc  "Boot the lg-open-isic httpkit server (port of server.py FastAPI)."
          :requires ([lg-open-isic.server :as server])
          :task (apply server/-main *command-line-args*)}}}
