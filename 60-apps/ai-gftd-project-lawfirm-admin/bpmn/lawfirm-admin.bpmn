<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- createCase -->
  <bpmn:process id="lawfirm-admin-create-case" name="Law Firm Admin Create Case" isExecutable="true">
    <bpmn:startEvent id="start-create-case"/>
    <bpmn:sequenceFlow id="sf-cc-1" sourceRef="start-create-case" targetRef="task-create-case"/>
    <bpmn:serviceTask id="task-create-case" name="Create Case">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.lawfirmAdmin.createCase"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-cc-2" sourceRef="task-create-case" targetRef="end-create-case"/>
    <bpmn:endEvent id="end-create-case"/>
  </bpmn:process>

  <!-- updateCase -->
  <bpmn:process id="lawfirm-admin-update-case" name="Law Firm Admin Update Case" isExecutable="true">
    <bpmn:startEvent id="start-update-case"/>
    <bpmn:sequenceFlow id="sf-uc-1" sourceRef="start-update-case" targetRef="task-update-case"/>
    <bpmn:serviceTask id="task-update-case" name="Update Case">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.lawfirmAdmin.updateCase"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-uc-2" sourceRef="task-update-case" targetRef="end-update-case"/>
    <bpmn:endEvent id="end-update-case"/>
  </bpmn:process>

  <!-- listCases -->
  <bpmn:process id="lawfirm-admin-list-cases" name="Law Firm Admin List Cases" isExecutable="true">
    <bpmn:startEvent id="start-list-cases"/>
    <bpmn:sequenceFlow id="sf-lc-1" sourceRef="start-list-cases" targetRef="task-list-cases"/>
    <bpmn:serviceTask id="task-list-cases" name="List Cases">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.lawfirmAdmin.listCases"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lc-2" sourceRef="task-list-cases" targetRef="end-list-cases"/>
    <bpmn:endEvent id="end-list-cases"/>
  </bpmn:process>

  <!-- getCase -->
  <bpmn:process id="lawfirm-admin-get-case" name="Law Firm Admin Get Case" isExecutable="true">
    <bpmn:startEvent id="start-get-case"/>
    <bpmn:sequenceFlow id="sf-gc-1" sourceRef="start-get-case" targetRef="task-get-case"/>
    <bpmn:serviceTask id="task-get-case" name="Get Case">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.lawfirmAdmin.getCase"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gc-2" sourceRef="task-get-case" targetRef="end-get-case"/>
    <bpmn:endEvent id="end-get-case"/>
  </bpmn:process>

  <!-- createClient -->
  <bpmn:process id="lawfirm-admin-create-client" name="Law Firm Admin Create Client" isExecutable="true">
    <bpmn:startEvent id="start-create-client"/>
    <bpmn:sequenceFlow id="sf-ccl-1" sourceRef="start-create-client" targetRef="task-create-client"/>
    <bpmn:serviceTask id="task-create-client" name="Create Client">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.lawfirmAdmin.createClient"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-ccl-2" sourceRef="task-create-client" targetRef="end-create-client"/>
    <bpmn:endEvent id="end-create-client"/>
  </bpmn:process>

  <!-- updateClient -->
  <bpmn:process id="lawfirm-admin-update-client" name="Law Firm Admin Update Client" isExecutable="true">
    <bpmn:startEvent id="start-update-client"/>
    <bpmn:sequenceFlow id="sf-ucl-1" sourceRef="start-update-client" targetRef="task-update-client"/>
    <bpmn:serviceTask id="task-update-client" name="Update Client">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.lawfirmAdmin.updateClient"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-ucl-2" sourceRef="task-update-client" targetRef="end-update-client"/>
    <bpmn:endEvent id="end-update-client"/>
  </bpmn:process>

  <!-- listClients -->
  <bpmn:process id="lawfirm-admin-list-clients" name="Law Firm Admin List Clients" isExecutable="true">
    <bpmn:startEvent id="start-list-clients"/>
    <bpmn:sequenceFlow id="sf-lcl-1" sourceRef="start-list-clients" targetRef="task-list-clients"/>
    <bpmn:serviceTask id="task-list-clients" name="List Clients">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.lawfirmAdmin.listClients"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lcl-2" sourceRef="task-list-clients" targetRef="end-list-clients"/>
    <bpmn:endEvent id="end-list-clients"/>
  </bpmn:process>

  <!-- getClient -->
  <bpmn:process id="lawfirm-admin-get-client" name="Law Firm Admin Get Client" isExecutable="true">
    <bpmn:startEvent id="start-get-client"/>
    <bpmn:sequenceFlow id="sf-gcl-1" sourceRef="start-get-client" targetRef="task-get-client"/>
    <bpmn:serviceTask id="task-get-client" name="Get Client">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.lawfirmAdmin.getClient"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gcl-2" sourceRef="task-get-client" targetRef="end-get-client"/>
    <bpmn:endEvent id="end-get-client"/>
  </bpmn:process>

</bpmn:definitions>
