      "name": "wellness-mcp-component",
      "description": "SpinApp MCP component for wellness monitoring (12 tools)",
      "applicationCategory": "Backend",
      "programmingLanguage": "TinyGo",
      "runtimePlatform": "SpinApp"
    }
  ],
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "scheduler.jsonld",
        "content": {
          "@context": [
            "https://schema.org/",
            {
              "etzhayyim": "https://etzhayyim.com/schemas/",
              "capabilities": "etzhayyim:capabilities",
              "survivalIndicators": "etzhayyim:survivalIndicators",
              "scheduler": "etzhayyim:scheduler",
              "milestones": "etzhayyim:milestones",
              "blockers": "etzhayyim:blockers",
              "goals": "etzhayyim:goals",
              "kpis": "etzhayyim:kpis",
              "members": "etzhayyim:members",
              "methods": "etzhayyim:methods",
              "responsibilities": "etzhayyim:responsibilities",
              "authority": "etzhayyim:authority",
              "resourceScope": "etzhayyim:resourceScope",
              "agents": "etzhayyim:agents",
              "dependsOn": {
                "@id": "etzhayyim:dependsOn",
                "@type": "@id"
              },
              "ingestKey": "etzhayyim:ingestKey",
              "window": "etzhayyim:window",
              "valueUpdatedAt": "etzhayyim:valueUpdatedAt"
            }
          ],
          "@type": "CreativeWork",
          "name": "etzhayyim-project-well-becoming Scheduler",
          "identifier": "etzhayyim-project-well-becoming/scheduler",
          "description": "Scheduler for the well-becoming program (いい感じの社会をつくる / well-becoming), coordinating resources, blockers, and cross-project execution.",
          "dateCreated": "2026-02-15T16:02:27Z",
          "dateModified": "2026-02-15T16:02:27Z",
          "goals": [
            {
              "@type": "CreativeWork",
              "name": "Build a well-becoming society",
              "description": "いい感じの社会をつくる (well-becoming)."
            }
          ],
          "kpis": [
            {
              "@type": "CreativeWork",
              "name": "Global social capital and capital productivity",
              "description": "世界全体における社会資本ならびに資本生産力"
            },
            {
              "@type": "CreativeWork",
              "name": "Well-becoming of core etzhayyim members",
              "description": "etzhayyim members となる etzhayyim の主たる構成員の well-becoming (wellness 指標)"
            },
            {
              "@type": "CreativeWork",
              "name": "Children's wellbeing",
              "description": "子供の幸福度"
            },
            {
              "@type": "CreativeWork",
              "name": "Blocker reduction",
              "description": "KPI = blocker の削減"
            }
          ],
          "members": [
            {
              "@type": "Audience",
              "name": "etzhayyim members",
              "description": "Users with *@etzhayyim.com plus j.kawasaki@etzhayyim.com",
              "audienceType": "email-domain",
              "identifier": "*@etzhayyim.com"
            },
            {
              "@type": "Person",
              "name": "j.kawasaki",
              "email": "j.kawasaki@etzhayyim.com"
            }
          ],
          "methods": [
            {
              "@type": "CreativeWork",
              "name": "Trust and social capital building",
              "description": "メール, SMS などによる member との信頼、社会資本の構築"
            },
            {
              "@type": "CreativeWork",
              "name": "Emotion signal analysis",
              "description": "顔認識、音声認識による感情値の分析"
            }
          ],
          "responsibilities": [
            {
              "@type": "CreativeWork",
              "name": "Define wellness indicators",
              "description": "あなたの責任: wellness の指標と、member との関係性"
            }
          ],
          "authority": [
            {
              "@type": "CreativeWork",
              "name": "Cross-project execution authority",
              "description": "This project has execution, plan change, resource manager, dependency, coding, and deploy authority for all projects under projects/* ."
            }
          ],
          "resourceScope": [
            "projects/*"
          ],
          "agents": [
            "apqc",
            "isic",
            "cofog",
            "unispsc",
            "cpc",
            "community"
          ],
          "milestones": [
            {
              "@type": "CreativeWork",
              "name": "Define wellness indicator framework",
              "description": "Establish member wellness indicators and measurement cadence aligned to the well-becoming goal.",
              "dueDate": "2026-02-20",
              "status": "Planned",
              "exitCriteria": [
                "Core wellness metrics defined",
                "Measurement frequency documented",
                "Consent/privacy guardrails mapped"
              ]
            },
            {
              "@type": "CreativeWork",
              "name": "Member relationship map",
              "description": "Document member relationship matrix, trust-building touchpoints, and ownership for member communications.",
              "dueDate": "2026-02-22",
              "status": "Planned",
              "dependsOn": [
                "Define wellness indicator framework"
              ],
              "exitCriteria": [
                "Member roster validated",
                "Communication owners assigned",
                "Engagement cadence drafted"
              ]
            },
            {
              "@type": "CreativeWork",
              "name": "Messaging channels readiness",
              "description": "Enable email/SMS workflows for member trust-building and feedback loops.",
              "dueDate": "2026-02-25",
              "status": "Planned",
              "dependsOn": [
                "Member relationship map"
              ],
              "exitCriteria": [
                "Email delivery path verified",
                "SMS provider configured",
                "Opt-in/opt-out workflow defined"
              ]
            },
            {
              "@type": "CreativeWork",
              "name": "Emotion signal analysis pipeline",
              "description": "Plan face/voice emotion signal analysis workflow with consent, storage, and quality checks.",
              "dueDate": "2026-03-01",
              "status": "Planned",
              "dependsOn": [
                "Define wellness indicator framework"
              ],
              "exitCriteria": [
                "Consent requirements documented",
                "Signal processing pipeline defined",
                "Risk/ethics review recorded"
              ]
            },
            {
              "@type": "CreativeWork",
              "name": "Cross-project resource allocation",
              "description": "Coordinate scheduler.jsonld and project.jsonld across projects to allocate resources and identify blockers.",
              "dueDate": "2026-03-05",
              "status": "Planned",
              "exitCriteria": [
                "Resource allocation matrix drafted",
                "Top blockers logged",
                "Dependencies assigned to owners"
              ]
            }
          ],
          "blockers": [
            {
              "@type": "CreativeWork",
              "name": "Consent and privacy guardrails",
              "description": "Member consent, privacy, and data handling requirements for emotion analysis and messaging must be defined.",
              "status": "Open"
            },
            {
              "@type": "CreativeWork",
              "name": "Member contact readiness",
              "description": "Email/SMS infrastructure and opt-in status are not yet verified.",
              "status": "Open"
            },
            {
              "@type": "CreativeWork",
              "name": "Cross-project dependency inventory",
              "description": "Need to reconcile scheduler.jsonld and project.jsonld dependencies before resource allocation.",
              "status": "Open"
            }
          ]
        }
      }
    ]
  }
