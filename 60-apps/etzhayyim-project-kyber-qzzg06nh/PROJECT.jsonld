    "documents": [
      {
        "fileName": "ACTIVITIES-KYBER-SETTLEMENT.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "dct": "http://purl.org/dc/terms/",
            "etzhayyim": "https://etzhayyim.com/schemas/",
            "id": "@id",
            "type": "@type"
          },
          "id": "https://etzhayyim.com/projects/etzhayyim-root/activities/kyber-settlement",
          "type": "dodaf:OperationalActivity",
          "dct:title": "Autonomous ERP Settlement Activities (O2C & P2P)",
          "dct:description": "Fully automated settlement and payment cycles for the 1 Trillion JPY Autonomous ERP system.",
          "etzhayyim:cycles": [
            {
              "name": "Order-to-Cash (O2C) Autonomous Flow",
              "steps": [
                {
                  "activity": "Project Milestone Completion Detection",
                  "performer": "svc-apqc-12-6-2-project-governance-v2",
                  "action": "Trigger TriggerBilling RPC"
                },
                {
                  "activity": "Invoice Generation & Dispatch",
                  "performer": "svc-apqc-10-2-invoice-manager",
                  "action": "Generate PDF and send via SMTP/Outlook Integration"
                },
                {
                  "activity": "Bank Receipt Reconciliation",
                  "performer": "svc-apqc-9-4-1-bank-paypay",
                  "action": "Sync transaction data and match with Invoice ID"
                },
                {
                  "activity": "Journal Entry Posting",
                  "performer": "svc-apqc-9-4-1-financial-core",
                  "action": "Post Debit: Cash / Credit: Accounts Receivable"
                }
              ]
            },
            {
              "name": "Procure-to-Pay (P2P) Autonomous Flow",
              "steps": [
                {
                  "activity": "Purchase Request & Approval",
                  "performer": "svc-apqc-11-0-global-compliance",
                  "action": "Verify budget and policy alignment via LLM"
                },
                {
                  "activity": "Payment Execution",
                  "performer": "svc-apqc-9-4-1-payment-gateway-stripe",
                  "action": "Trigger bank transfer or card payment"
                },
                {
                  "activity": "Automated Bookkeeping",
                  "performer": "svc-apqc-9-4-1-intel-bookkeeping",
                  "action": "Infer account codes and post journal entries"
                }
              ]
            }
          ]
        }
      },
      {
        "fileName": "STRATEGY-KYBER-SETTLEMENT.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "dct": "http://purl.org/dc/terms/",
            "etzhayyim": "https://etzhayyim.com/schemas/",
            "id": "@id",
            "type": "@type"
          },
          "id": "https://etzhayyim.com/projects/etzhayyim-root/strategy/kyber-settlement",
          "type": "dodaf:Strategy",
          "dct:title": "Project Kyber: Autonomous Settlement & Payment Plan",
          "dct:description": "Strategic plan to automate 100% of financial settlement, invoicing, and payments globally to achieve 1 Trillion JPY revenue with zero backoffice.",
          "etzhayyim:phases": [
            {
              "name": "Phase 1: Zero-Touch Invoicing & Collection (Current)",
              "focus": "Automate invoice generation and delivery via project milestone triggers.",
              "keyActors": [
                "etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-svc-apqc-10-2-invoice-manager",
                "etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-svc-apqc-12-3-1-mailer-cgwe3vz4"
              ]
            },
            {
              "name": "Phase 2: Global Payment Orchestration",
              "focus": "Integrate Stripe/PayPal actors for multi-currency automated collection and dynamic dunning.",
              "keyActors": [
                "etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-svc-apqc-9-4-1-payment-gateway-stripe",
                "etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-svc-apqc-1-3-2-reconcile-business-w9k2p4m8"
              ]
            },
            {
              "name": "Phase 3: Autonomous Economy via Negotiation Service",
              "focus": "Enable agents to negotiate, contract, and settle transactions through the negotiation service without human intervention.",
              "keyActors": [
                "etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-svc-apqc-1-1-intent-intelligence-v2-3rs79cvd",
                "act:negotiation-service"
              ]
            }
          ],
          "etzhayyim:principles": [
            "Evidence-based Settlement: Payments only trigger on verified Activity completion.",
            "Zero-Trust Finance: All transactions verified by cryptographic proof and IAM policy.",
            "Global Safety: Automatic tax compliance and AML/KYC filtering via specialized actors."
          ]
        }
      },
