{
  "name": "kotodama-inb0x4k2",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "APP_CAPABILITIES": "[\"inbox-triage\",\"dept-routing\",\"document-indexing\"]",
    "APP_DESCRIPTION": "Kyber Inbox — aggregates Outlook/OneDrive/Gmail signals, routes to ERP departments",
    "APP_DISPLAY_NAME": "Kyber Inbox",
    "APP_EMBED_URL": "https://inb0x4k2.etzhayyim.com/?embed=1",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "inb0x4k2",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "appview",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "inb0x4k2.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ]
}
