{
  "@context": "https://gftd.ai/ns/magatama/v1",
  "@id": "did:web:yadoya.gftd.ai",
  "component": {
    "path": "component.wasm"
  },
  "convoSystemPrompt": "You are yadoya agent. . Respond helpfully in the user's language.",
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": [
      "yadoya-policy"
    ]
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "yadoya",
  "nanoid": "b7r4n2xq",
  "performerType": "service",
  "pool": {},
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "domain-query",
      "data-management"
    ],
    "description": "Yadoya — AI Agent for accommodation intelligence",
    "displayName": "Yadoya",
    "isBot": true,
    "operator": "gftd.co.jp"
  },
  "project": "yadoya",
  "runtimeType": "worker",
  "triggers": {
    "http": {
      "listen": "0.0.0.0:8080",
      "routes": [
        "/api/...",
        "/health",
        "/healthz",
        "/readyz",
        "/..."
      ],
      "spa": true,
      "staticDir": "/wasm/svelte/dist"
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.like",
        "app.bsky.feed.post",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow",
        "ai.gftd.apps.yadoya.yadoyaEntity",
        "ai.gftd.apps.yadoya.yadoyaEvent",
        "ai.gftd.apps.yadoya.yadoyaReport"
      ]
    }
  },
  "uiType": "appview",
  "yata": {
    "dataDir": "/data/yata",
    "graphUri": "/data/graph"
  }
}
