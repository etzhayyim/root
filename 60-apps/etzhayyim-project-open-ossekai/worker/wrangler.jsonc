{
  "name": "kotodama-oss3k41x",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"intel-brief-l1\",\"arbitrage-l2\",\"consent-gate-l3\",\"jocho-scoring\",\"wellbecoming-plan\",\"kyu-dan-coaching\",\"ossekai-status\",\"bpmn-actor\"]",
    "APP_DESCRIPTION": "L1/L2/L3 intelligence + Well-Becoming kyu/dan coaching actor. OSINT briefs, arbitrage proposals, and consent-gated jocho scoring.",
    "APP_DISPLAY_NAME": "Open Ossekai",
    "APP_EMBED_URL": "https://oss3k41x.etzhayyim.com/?embed=1",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "oss3k41x",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "appview",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "oss3k41x.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "open-ossekai.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
