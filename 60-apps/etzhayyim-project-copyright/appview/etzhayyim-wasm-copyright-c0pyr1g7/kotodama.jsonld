{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:copyright.etzhayyim.com",
  "convoSystemPrompt": "You are Copyright Registry agent — global copyright intelligence platform. You actively collect and index works from Crossref (academic DOI, ~150M works) and DataCite (research data DOI) via daily REST API ingest into vertex_work. Data model: work (kind: literary/musical/visual/audiovisual/software/dataset), registry (crossref/datacite/us-copyright/jasrac/cisac/isbn/orcid/ascap/prs), license (CC 7 variants + SPDX + CMO blanket + public domain), identifiers (DOI/ISBN-13/ISRC/ISWC). Berne Convention aware: automatic copyright vs voluntary registration. You can: resolve a work by DOI/ISBN/ISRC/ISWC, list works by kind/registry/license, inspect license details, detect orphan works (author unknown + 70yr), show registry coverage breakdown. When asked about data freshness, mention Crossref + DataCite are ingested daily. Respond in the user's language.",
  "duties": ["勤労の義務"],
  "entities": [
    { "category": "regulatory", "did": "did:web:copyright.etzhayyim.com:source:us-copyright", "name": "US Copyright Office", "sourceId": "src-uscopyright", "url": "https://www.copyright.gov/" },
    { "category": "collective-rights", "did": "did:web:copyright.etzhayyim.com:source:jasrac", "name": "JASRAC", "sourceId": "src-jasrac", "url": "https://www.jasrac.or.jp/" },
    { "category": "international", "did": "did:web:copyright.etzhayyim.com:source:cisac", "name": "CISAC IPI", "sourceId": "src-cisac", "url": "https://www.cisac.org/" },
    { "category": "identifier", "did": "did:web:copyright.etzhayyim.com:source:crossref", "name": "Crossref DOI", "sourceId": "src-crossref", "url": "https://www.crossref.org/" },
    { "category": "identifier", "did": "did:web:copyright.etzhayyim.com:source:datacite", "name": "DataCite DOI", "sourceId": "src-datacite", "url": "https://datacite.org/" },
    { "category": "identifier", "did": "did:web:copyright.etzhayyim.com:source:isbn", "name": "ISBN Agency", "sourceId": "src-isbn", "url": "https://www.isbn-international.org/" },
    { "category": "identifier", "did": "did:web:copyright.etzhayyim.com:source:orcid", "name": "ORCID", "sourceId": "src-orcid", "url": "https://orcid.org/" }
  ],
  "governance": { "classification": "internal", "complianceFrameworks": ["Berne-Convention", "WIPO-Copyright-Treaty", "DMCA"], "raci": "responsible" },
  "kpi": ["credits の獲得"],
  "name": "Copyright Registry",
  "nanoid": "c0pyr1g7",
  "performerType": "service",
  "profile": {
    "avatar": "©",
    "capabilities": ["copyright-lookup", "doi-resolve", "isbn-resolve", "license-inspect", "orphan-work-detection"],
    "category": "intellectual-property",
    "description": "Global copyright registry — US Copyright Office / JASRAC / CISAC / Crossref / DataCite / ISBN / ORCID integration, license taxonomy (CC/SPDX/CMO), cross-linked to NaturalPerson(ORCID) / LegalEntity(LEI).",
    "displayName": "Copyright Registry"
  },
  "runtimeType": "worker",
  "space": {
    "name": "Copyright Registry",
    "description": "著作権 coverage hub",
    "joinRule": "public",
    "historyVisibility": "world-readable",
    "convos": [{ "name": "copyright-feed", "kind": "public", "description": "新規登録・DOI・ISBN feed", "default": true }]
  },
  "triggers": {
    "http": {
      "listen": "0.0.0.0:8080",
      "routes": ["/api/...", "/health", "/.well-known/did.json", "/.well-known/atproto-did", "/..."],
      "spa": true,
      "staticDir": "/wasm/svelte/dist"
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow",
        "com.etzhayyim.apps.copyright.work",
        "com.etzhayyim.apps.copyright.rightsHolder",
        "com.etzhayyim.apps.copyright.registration",
        "com.etzhayyim.apps.copyright.license",
        "com.etzhayyim.apps.copyright.doi",
        "com.etzhayyim.apps.copyright.isbn",
        "com.etzhayyim.apps.copyright.isrc",
        "com.etzhayyim.apps.copyright.iswc",
        "com.etzhayyim.apps.copyright.coverageReport"
      ]
    }
  },
  "ui": { "accent": "#dc2626", "icon": "©" },
  "uiType": "yoro",
  "runtime": "k8s-langserver",
  "edge": "sveltekit-proxy",
  "legacyExecutionTier": "T1",
  "version": "1.0.0"
}
