{
  "name": "kotodama-k1n0k001",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"ponf-consensus\",\"block-formation\",\"flow-threshold-check\"]",
    "APP_DESCRIPTION": "kinoko (きのこ) — fruiting body / PoNF consensus layer. Checks nutrient flow thresholds and forms new PoNF blocks when Shannon η-gated flow accumulates.",
    "APP_DISPLAY_NAME": "Kinoko PoNF Consensus",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "k1n0k001",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "k1n0k001.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "kinoko.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
