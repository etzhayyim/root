{
  "@context": {
    "etzhayyim": "https://resources.etzhayyim.com/etzhayyim-project-resources/id/",
    "schema": "https://schema.org/",
    "dodaf": "https://resources.etzhayyim.com/etzhayyim-project-resources/id/DM2/"
  },
  "@type": "etzhayyim:Project",
  "@id": "https://resources.etzhayyim.com/etzhayyim-project-facebook/id/Project/etzhayyim-project-facebook",
  "schema:name": "etzhayyim-project-facebook",
  "schema:description": "Facebook page automation: automated posting, messaging, and commenting via Facebook Graph API with LLM-powered content generation",
  "dodaf:capability": [
    {
      "@type": "dodaf:Capability",
      "schema:name": "Facebook Feed Post Automation",
      "schema:description": "Publish posts to Facebook page feed on behalf of the page owner"
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Facebook Messenger Automation",
      "schema:description": "Send messages via Facebook Messenger conversations"
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Facebook Comment Automation",
      "schema:description": "Post comments on Facebook posts"
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "LLM Content Generation",
      "schema:description": "Generate contextual content for posts, messages, and comments using LLM"
    }
  ],
  "dodaf:performer": [
    {
      "@type": "dodaf:Performer",
      "schema:name": "facebook-automation-component",
      "schema:description": "SpinApp MCP component for Facebook Graph API automation with LLM"
    }
  ]
}
