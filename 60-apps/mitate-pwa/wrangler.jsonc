{
  "name": "mitate-pwa",
  "main": "src/app.ts",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": ["nodejs_compat", "nodejs_als"],
  "vars": {
    "APP_NANOID": "m1t4tp01",
    "APP_DISPLAY_NAME": "見立て (mitate) 鼻詰まり advisory",
    "APP_DESCRIPTION": "Religious-corp self-care advisory for chronic nasal congestion 5-condition triage. Advisory tier only.",
    "APP_FRAMEWORK": "worker-edge-thin-dispatcher",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "ameno",
    "MITATE_R1_PHASE_GATE": "locked",
    "MURAKUMO_LITELLM_GATEWAY_URL": "http://127.0.0.1:4000"
  },
  "routes": [
    {
      "pattern": "mitate.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "m1t4tp01.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
