{
  "name": "kotodama-h4kk0001",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"fermentation-pipeline\",\"knowledge-transformation\",\"audit-co2-trail\"]",
    "APP_DESCRIPTION": "hakkou (発酵) — fermentation pipeline layer. Accepts raw input, transforms it into structured knowledge (ethanol) via LLM, and emits an immutable audit trail (CO2).",
    "APP_DISPLAY_NAME": "Hakkou Fermentation Pipeline",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "h4kk0001",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "h4kk0001.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "hakkou.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
