{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://etzhayyim.com/tia/activities#",
    "id": "@id",
    "type": "@type",
    "dct": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "name": "dct:title",
    "description": "dct:description",
    "consumer": {
      "@id": "tia:consumer",
      "@type": "@id"
    },
    "producer": {
      "@id": "tia:producer",
      "@type": "@id"
    },
    "measure": {
      "@id": "tia:measure",
      "@container": "@set"
    },
    "rule": {
      "@id": "tia:rule",
      "@container": "@set"
    },
    "condition": {
      "@id": "tia:condition",
      "@container": "@set"
    },
    "realizes": {
      "@id": "prov:wasInfluencedBy",
      "@type": "@id"
    },
    "project": {
      "@id": "tia:project",
      "@type": "@id"
    },
    "uses": {
      "@id": "prov:used",
      "@type": "@id",
      "@container": "@set"
    }
  },
  "id": "https://etzhayyim.com/tia/activities/similarity-detection",
  "type": "tia:Activity",
  "name": "Similarity Detection",
  "description": "保存ページからの類似性評価活動。プラットフォーム毎の情報抽出（画像・プロフィール）を行い、Gemini 2.5 Flashによる類似性評価を実行",
  "consumer": "https://etzhayyim.com/tia/performers/systems/detector",
  "producer": "https://etzhayyim.com/tia/performers/systems/detector",
  "realizes": "https://etzhayyim.com/tia/capabilities/threat-detection",
  "project": "https://etzhayyim.com/tia/resources/schemas/projects",
  "uses": [
    "https://etzhayyim.com/tia/resources/detection-result",
    "https://etzhayyim.com/tia/resources/similarity-score",
    "https://etzhayyim.com/tia/ports/services/graphql"
  ],
  "measure": [
    {
      "id": "measure_detection_accuracy",
      "name": "Detection Accuracy",
      "description": "検知精度",
      "target": "> 95% (False Positive < 5%)"
    },
    {
      "id": "measure_detection_time",
      "name": "Detection Time",
      "description": "類似性評価にかかる時間",
      "target": "< 5秒/アカウント"
    },
    {
      "id": "measure_score_range",
      "name": "Score Range",
      "description": "類似性スコアは0-1の範囲で定量的に表現",
      "target": "0.0 <= score <= 1.0"
    }
  ],
  "rule": [
    {
      "id": "rule_platform_specific",
      "name": "Platform-Specific Analysis",
      "description": "検知はプラットフォーム毎の特徴（画像・プロフィール）を考慮する",
      "severity": "error"
    },
    {
      "id": "rule_score_calculation",
      "name": "Score Calculation",
      "description": "類似性評価は0-1のスコアで定量的に表現",
      "severity": "error"
    },
    {
      "id": "rule_threshold_evaluation",
      "name": "Threshold Evaluation",
      "description": "評価スコアに対して閾値判定を行う",
      "severity": "info"
    }
  ],
  "condition": [
    {
      "id": "condition_recorded_page_available",
      "name": "Recorded Page Available",
      "description": "記録されたページ（MHTML）が存在する必要がある",
      "type": "prerequisite"
    },
    {
      "id": "condition_gemini_api_available",
      "name": "Gemini API Available",
      "description": "Gemini 2.5 Flash APIが利用可能である必要がある",
      "type": "prerequisite"
    }
  ]
}
