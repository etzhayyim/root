{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://etzhayyim.com/tia/activities#",
    "id": "@id",
    "type": "@type",
    "dct": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "name": "dct:title",
    "description": "dct:description",
    "consumer": {
      "@id": "tia:consumer",
      "@type": "@id"
    },
    "producer": {
      "@id": "tia:producer",
      "@type": "@id"
    },
    "measure": {
      "@id": "tia:measure",
      "@container": "@set"
    },
    "rule": {
      "@id": "tia:rule",
      "@container": "@set"
    },
    "condition": {
      "@id": "tia:condition",
      "@container": "@set"
    },
    "realizes": {
      "@id": "prov:wasInfluencedBy",
      "@type": "@id"
    },
    "project": {
      "@id": "tia:project",
      "@type": "@id"
    },
    "uses": {
      "@id": "prov:used",
      "@type": "@id",
      "@container": "@set"
    }
  },
  "id": "https://etzhayyim.com/tia/activities/account-monitoring",
  "type": "tia:Activity",
  "name": "Account Monitoring",
  "description": "Seekerによる協働的なアカウント監視活動。保護対象アカウント一覧を取得し、プラットフォーム検索ページで監視を行う",
  "consumer": "https://etzhayyim.com/tia/performers/actors/seeker",
  "producer": "https://etzhayyim.com/tia/performers/systems/recorder",
  "realizes": "https://etzhayyim.com/tia/capabilities/monitoring",
  "project": "https://etzhayyim.com/tia/resources/schemas/projects",
  "uses": [
    "https://etzhayyim.com/tia/resources/internet-account",
    "https://etzhayyim.com/tia/ports/services/graphql"
  ],
  "measure": [
    {
      "id": "measure_monitoring_coverage",
      "name": "Monitoring Coverage",
      "description": "監視対象アカウントのカバレッジ",
      "target": "> 80%"
    },
    {
      "id": "measure_monitoring_frequency",
      "name": "Monitoring Frequency",
      "description": "アカウントあたりの監視頻度",
      "target": "1回/日以上"
    }
  ],
  "rule": [
    {
      "id": "rule_manual_collection",
      "name": "Manual Collection Only",
      "description": "自動スクレイピング禁止プラットフォーム（Facebook, X, LinkedIn, Instagram）では手動収集のみ",
      "severity": "error"
    },
    {
      "id": "rule_mhtml_capture",
      "name": "MHTML Capture",
      "description": "ページはMHTML形式で自動記録される",
      "severity": "info"
    }
  ],
  "condition": [
    {
      "id": "condition_seeker_authenticated",
      "name": "Seeker Authentication",
      "description": "Seekerは認証済みである必要がある",
      "type": "prerequisite"
    },
    {
      "id": "condition_accounts_available",
      "name": "Accounts Available",
      "description": "保護対象アカウントが存在する必要がある",
      "type": "prerequisite"
    }
  ]
}
