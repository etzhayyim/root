{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://etzhayyim.com/tia/activities#",
    "id": "@id",
    "type": "@type",
    "dct": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "name": "dct:title",
    "description": "dct:description",
    "consumer": {
      "@id": "tia:consumer",
      "@type": "@id"
    },
    "producer": {
      "@id": "tia:producer",
      "@type": "@id"
    },
    "measure": {
      "@id": "tia:measure",
      "@container": "@set"
    },
    "rule": {
      "@id": "tia:rule",
      "@container": "@set"
    },
    "condition": {
      "@id": "tia:condition",
      "@container": "@set"
    },
    "realizes": {
      "@id": "prov:wasInfluencedBy",
      "@type": "@id"
    },
    "project": {
      "@id": "tia:project",
      "@type": "@id"
    },
    "uses": {
      "@id": "prov:used",
      "@type": "@id",
      "@container": "@set"
    }
  },
  "id": "https://etzhayyim.com/tia/activities/account-registration",
  "type": "tia:Activity",
  "name": "Account Registration",
  "description": "インターネットアカウントを保護対象として登録する活動。アカウント所有者が自らのアカウントのみ登録可能",
  "consumer": "https://etzhayyim.com/tia/performers/actors/internet-account-owner",
  "producer": "https://etzhayyim.com/tia/performers/systems/authenticator",
  "realizes": "https://etzhayyim.com/tia/capabilities/account-protection",
  "project": "https://etzhayyim.com/tia/resources/schemas/projects",
  "uses": [
    "https://etzhayyim.com/tia/resources/internet-account",
    "https://etzhayyim.com/tia/ports/services/graphql"
  ],
  "measure": [
    {
      "id": "measure_registration_success_rate",
      "name": "Registration Success Rate",
      "description": "アカウント登録の成功率",
      "target": "> 95%"
    },
    {
      "id": "measure_registration_time",
      "name": "Registration Time",
      "description": "アカウント登録にかかる時間",
      "target": "< 30秒"
    }
  ],
  "rule": [
    {
      "id": "rule_owner_only",
      "name": "Owner Only Registration",
      "description": "アカウント所有者は自らのアカウントのみ保護対象として登録可能",
      "severity": "error"
    },
    {
      "id": "rule_required_fields",
      "name": "Required Fields",
      "description": "platformType, accountName, userIdは必須",
      "severity": "error"
    },
    {
      "id": "rule_url_validation",
      "name": "URL Validation",
      "description": "accountUrlが提供される場合、有効なHTTP/HTTPS URLである必要がある",
      "severity": "warning"
    }
  ],
  "condition": [
    {
      "id": "condition_authenticated",
      "name": "User Authentication",
      "description": "ユーザーは認証済みである必要がある",
      "type": "prerequisite"
    },
    {
      "id": "condition_authorized",
      "name": "Owner Authorization",
      "description": "ユーザーは登録しようとするアカウントの所有者である必要がある",
      "type": "authorization"
    }
  ]
}
