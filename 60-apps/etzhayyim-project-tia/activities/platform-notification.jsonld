{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://etzhayyim.com/tia/activities#",
    "id": "@id",
    "type": "@type",
    "dct": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "name": "dct:title",
    "description": "dct:description",
    "consumer": {
      "@id": "tia:consumer",
      "@type": "@id"
    },
    "producer": {
      "@id": "tia:producer",
      "@type": "@id"
    },
    "measure": {
      "@id": "tia:measure",
      "@container": "@set"
    },
    "rule": {
      "@id": "tia:rule",
      "@container": "@set"
    },
    "condition": {
      "@id": "tia:condition",
      "@container": "@set"
    },
    "realizes": {
      "@id": "prov:wasInfluencedBy",
      "@type": "@id"
    },
    "project": {
      "@id": "tia:project",
      "@type": "@id"
    },
    "uses": {
      "@id": "prov:used",
      "@type": "@id",
      "@container": "@set"
    }
  },
  "id": "https://etzhayyim.com/tia/activities/platform-notification",
  "type": "tia:Activity",
  "name": "Platform Notification",
  "description": "各プラットフォーム（Facebook, LinkedIn, X, LINE, Instagram）への公式連絡活動。検知結果に基づくプラットフォームへの自動連絡を管理",
  "consumer": "https://etzhayyim.com/tia/performers/systems/platformer",
  "producer": "https://etzhayyim.com/tia/performers/systems/platformer",
  "realizes": "https://etzhayyim.com/tia/capabilities/platform-integration",
  "project": "https://etzhayyim.com/tia/resources/schemas/projects",
  "uses": [
    "https://etzhayyim.com/tia/resources/detection-result",
    "https://etzhayyim.com/tia/ports/services/graphql"
  ],
  "measure": [
    {
      "id": "measure_platform_response_time",
      "name": "Platform Response Time",
      "description": "プラットフォームへの連絡から応答までの時間",
      "target": "< 48時間"
    },
    {
      "id": "measure_notification_success_rate",
      "name": "Notification Success Rate",
      "description": "プラットフォームへの通知成功率",
      "target": "> 90%"
    }
  ],
  "rule": [
    {
      "id": "rule_official_channels_only",
      "name": "Official Channels Only",
      "description": "プラットフォーム毎の公式連絡API/手順を使用する",
      "severity": "error"
    },
    {
      "id": "rule_platform_customization",
      "name": "Platform Customization",
      "description": "プラットフォーム毎の連絡API/手順の管理を行う",
      "severity": "info"
    }
  ],
  "condition": [
    {
      "id": "condition_detection_confirmed",
      "name": "Detection Confirmed",
      "description": "検知結果が確認済みである必要がある",
      "type": "prerequisite"
    },
    {
      "id": "condition_owner_approval",
      "name": "Owner Approval",
      "description": "アカウント所有者の承認が必要な場合がある",
      "type": "authorization"
    }
  ]
}
