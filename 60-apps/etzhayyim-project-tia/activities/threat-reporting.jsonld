{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://etzhayyim.com/tia/activities#",
    "id": "@id",
    "type": "@type",
    "dct": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "name": "dct:title",
    "description": "dct:description",
    "consumer": {
      "@id": "tia:consumer",
      "@type": "@id"
    },
    "producer": {
      "@id": "tia:producer",
      "@type": "@id"
    },
    "measure": {
      "@id": "tia:measure",
      "@container": "@set"
    },
    "rule": {
      "@id": "tia:rule",
      "@container": "@set"
    },
    "condition": {
      "@id": "tia:condition",
      "@container": "@set"
    },
    "realizes": {
      "@id": "prov:wasInfluencedBy",
      "@type": "@id"
    },
    "project": {
      "@id": "tia:project",
      "@type": "@id"
    },
    "uses": {
      "@id": "prov:used",
      "@type": "@id",
      "@container": "@set"
    }
  },
  "id": "https://etzhayyim.com/tia/activities/threat-reporting",
  "type": "tia:Activity",
  "description": "検知結果をアカウント所有者に報告する活動。detectorの評価結果をInternetAccountOwnerに通知し、評価スコアと証拠データを提示",
  "consumer": "https://etzhayyim.com/tia/performers/systems/reporter",
  "producer": "https://etzhayyim.com/tia/performers/systems/reporter",
  "realizes": "https://etzhayyim.com/tia/capabilities/reporting",
  "project": "https://etzhayyim.com/tia/resources/schemas/projects",
  "uses": [
    "https://etzhayyim.com/tia/resources/detection-result",
    "https://etzhayyim.com/tia/performers/actors/internet-account-owner",
    "https://etzhayyim.com/tia/ports/services/graphql"
  ],
  "measure": [
    {
      "id": "measure_reporting_timeliness",
      "name": "Reporting Timeliness",
      "description": "検知から報告までの時間",
      "target": "< 30分"
    },
    {
      "id": "measure_report_accuracy",
      "name": "Report Accuracy",
      "description": "報告の正確性",
      "target": "100%"
    },
    {
      "id": "measure_notification_delivery",
      "name": "Notification Delivery",
      "description": "通知の配信成功率",
      "target": "> 99%"
    }
  ],
  "rule": [
    {
      "id": "rule_immediate_reporting",
      "name": "Immediate Reporting",
      "description": "報告は即時性と正確性を両立する",
      "severity": "error"
    },
    {
      "id": "rule_evidence_presentation",
      "name": "Evidence Presentation",
      "description": "評価スコアと証拠データを提示する",
      "severity": "error"
    },
    {
      "id": "rule_channel_management",
      "name": "Channel Management",
      "description": "通知チャネル管理（メール・アプリ内通知）を行う",
      "severity": "info"
    }
  ],
  "condition": [
    {
      "id": "condition_detection_result_available",
      "name": "Detection Result Available",
      "description": "検知結果が存在する必要がある",
      "type": "prerequisite"
    },
    {
      "id": "condition_owner_notification_enabled",
      "name": "Owner Notification Enabled",
      "description": "アカウント所有者の通知が有効である必要がある",
      "type": "prerequisite"
    }
  ]
}
