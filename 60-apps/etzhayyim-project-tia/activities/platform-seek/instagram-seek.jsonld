{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://etzhayyim.com/tia/activities#",
    "id": "@id",
    "type": "@type",
    "dct": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "name": "dct:title",
    "description": "dct:description",
    "consumer": {
      "@id": "tia:consumer",
      "@type": "@id"
    },
    "producer": {
      "@id": "tia:producer",
      "@type": "@id"
    },
    "measure": {
      "@id": "tia:measure",
      "@container": "@set"
    },
    "rule": {
      "@id": "tia:rule",
      "@container": "@set"
    },
    "condition": {
      "@id": "tia:condition",
      "@container": "@set"
    },
    "realizes": {
      "@id": "prov:wasInfluencedBy",
      "@type": "@id"
    },
    "project": {
      "@id": "tia:project",
      "@type": "@id"
    },
    "uses": {
      "@id": "prov:used",
      "@type": "@id",
      "@container": "@set"
    },
    "extends": {
      "@id": "rdfs:subClassOf",
      "@type": "@id"
    },
    "searchUrl": "tia:searchUrl",
    "platform": "tia:platform"
  },
  "id": "https://etzhayyim.com/tia/activities/platform-seek/instagram-seek",
  "type": "tia:Activity",
  "name": "Instagram Account Seek",
  "description": "Instagramプラットフォームでの保護対象アカウント探索活動",
  "extends": "https://etzhayyim.com/tia/activities/account-seek",
  "consumer": "https://etzhayyim.com/tia/performers/actors/seeker",
  "producer": "https://etzhayyim.com/tia/performers/systems/recorder",
  "realizes": "https://etzhayyim.com/tia/capabilities/monitoring",
  "project": "https://etzhayyim.com/tia/resources/schemas/projects",
  "platform": "instagram",
  "searchUrl": "https://www.instagram.com/{accountName}/",
  "uses": [
    "https://etzhayyim.com/tia/resources/internet-account",
    "https://etzhayyim.com/tia/ports/services/graphql",
    "https://etzhayyim.com/tia/performers/systems/recorder#chrome-extension"
  ],
  "measure": [
    {
      "id": "measure_instagram_seek_coverage",
      "name": "Instagram Seek Coverage",
      "description": "Instagramでの探索対象アカウントのカバレッジ",
      "target": "> 80%"
    },
    {
      "id": "measure_instagram_screenshot_quality",
      "name": "Instagram Screenshot Quality",
      "description": "Instagramプロフィールページのスクリーンショット品質",
      "target": "> 90%"
    }
  ],
  "rule": [
    {
      "id": "rule_instagram_manual_only",
      "name": "Instagram Manual Collection Only",
      "description": "Instagramは自動スクレイピング禁止のため手動収集のみ",
      "severity": "error"
    },
    {
      "id": "rule_instagram_profile_url_format",
      "name": "Instagram Profile URL Format",
      "description": "プロフィールURLは https://www.instagram.com/{accountName}/ 形式である必要がある",
      "severity": "warning"
    }
  ],
  "condition": [
    {
      "id": "condition_instagram_account_name",
      "name": "Instagram Account Name",
      "description": "探索対象のInstagramアカウント名が必要",
      "type": "prerequisite"
    }
  ]
}
