{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://etzhayyim.com/tia/activities#",
    "id": "@id",
    "type": "@type",
    "dct": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "name": "dct:title",
    "description": "dct:description",
    "consumer": {
      "@id": "tia:consumer",
      "@type": "@id"
    },
    "producer": {
      "@id": "tia:producer",
      "@type": "@id"
    },
    "measure": {
      "@id": "tia:measure",
      "@container": "@set"
    },
    "rule": {
      "@id": "tia:rule",
      "@container": "@set"
    },
    "condition": {
      "@id": "tia:condition",
      "@container": "@set"
    },
    "realizes": {
      "@id": "prov:wasInfluencedBy",
      "@type": "@id"
    },
    "project": {
      "@id": "tia:project",
      "@type": "@id"
    },
    "uses": {
      "@id": "prov:used",
      "@type": "@id",
      "@container": "@set"
    }
  },
  "id": "https://etzhayyim.com/tia/activities/account-seek",
  "type": "tia:Activity",
  "name": "Account Seek",
  "description": "Seekerによる保護対象アカウントの探索活動。保護対象アカウントの名称でプラットフォーム検索ページを開き、Chrome extension (recorder) でスクリーンショットを保存し、結果を確認する",
  "consumer": "https://etzhayyim.com/tia/performers/actors/seeker",
  "producer": "https://etzhayyim.com/tia/performers/systems/recorder",
  "realizes": "https://etzhayyim.com/tia/capabilities/monitoring",
  "project": "https://etzhayyim.com/tia/resources/schemas/projects",
  "uses": [
    "https://etzhayyim.com/tia/resources/internet-account",
    "https://etzhayyim.com/tia/ports/services/graphql",
    "https://etzhayyim.com/tia/performers/systems/recorder#chrome-extension"
  ],
  "measure": [
    {
      "id": "measure_seek_coverage",
      "name": "Seek Coverage",
      "description": "探索対象アカウントのカバレッジ",
      "target": "> 80%"
    },
    {
      "id": "measure_seek_frequency",
      "name": "Seek Frequency",
      "description": "アカウントあたりの探索頻度",
      "target": "1回/日以上"
    },
    {
      "id": "measure_screenshot_capture_rate",
      "name": "Screenshot Capture Rate",
      "description": "探索セッションあたりのスクリーンショット取得率",
      "target": "> 90%"
    },
    {
      "id": "measure_result_review_time",
      "name": "Result Review Time",
      "description": "結果確認にかかる時間",
      "target": "< 5分/セッション"
    }
  ],
  "rule": [
    {
      "id": "rule_manual_collection",
      "name": "Manual Collection Only",
      "description": "自動スクレイピング禁止プラットフォーム（Facebook, X, LinkedIn, Instagram）では手動収集のみ",
      "severity": "error"
    },
    {
      "id": "rule_extension_required",
      "name": "Extension Required",
      "description": "Chrome extension (@recorder-extension) がインストールされている必要がある",
      "severity": "error"
    },
    {
      "id": "rule_screenshot_validation",
      "name": "Screenshot Validation",
      "description": "スクリーンショットにはURL、タイムスタンプ、テキストコンテンツが含まれる必要がある",
      "severity": "warning"
    },
    {
      "id": "rule_project_context",
      "name": "Project Context Required",
      "description": "全ての seek 活動は project コンテキスト内で実行される必要がある",
      "severity": "error"
    }
  ],
  "condition": [
    {
      "id": "condition_seeker_authenticated",
      "name": "Seeker Authentication",
      "description": "Seekerは認証済みである必要がある",
      "type": "prerequisite"
    },
    {
      "id": "condition_project_exists",
      "name": "Project Exists",
      "description": "保護対象を表す project が存在する必要がある",
      "type": "prerequisite"
    },
    {
      "id": "condition_accounts_available",
      "name": "Accounts Available",
      "description": "保護対象アカウントが存在する必要がある",
      "type": "prerequisite"
    },
    {
      "id": "condition_extension_installed",
      "name": "Extension Installed",
      "description": "Chrome extension (@recorder-extension) がインストールされている必要がある",
      "type": "prerequisite"
    }
  ]
}
