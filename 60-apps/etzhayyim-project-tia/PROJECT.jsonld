  "id": "https://etzhayyim.com/tia/project",
  "type": "tia:Project",
  "name": "ETZHAYYIM TIA - Internet Account Protection System",
  "description": "インターネットアカウント保護システムは、Facebook, LinkedIn, X(Twitter), LINE, Instagram などのソーシャルメディアプラットフォームにおけるアカウント乗っ取りやなりすましを検知・防止する分散型監視システム",
  "version": "1.0.0",
  "createdAt": "2024-01-01T00:00:00Z",
  "updatedAt": "2025-11-12T12:00:00Z",
  "realizes": "https://etzhayyim.com/tia/goal",
  "topology": {
    "id": "https://etzhayyim.com/tia/topology/v2",
