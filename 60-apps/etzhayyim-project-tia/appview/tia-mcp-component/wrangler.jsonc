{
  "name": "kotodama-t1aag3nt",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"analyzeIntent\",\"classifySignal\",\"extractEntities\",\"scoreRisk\",\"generateSummary\",\"lookupProfile\",\"submitFeedback\",\"getInsights\"]",
    "APP_DESCRIPTION": "tia — Threat Intelligence & Analytics Platform. Analyze signals, classify threats, extract entities, and generate risk insights.",
    "APP_DISPLAY_NAME": "Threat Intelligence & Analytics",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "t1aag3nt",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "t1aag3nt.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "tia.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
