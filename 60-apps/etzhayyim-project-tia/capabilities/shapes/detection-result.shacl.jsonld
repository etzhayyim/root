{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://etzhayyim.com/tia/capabilities#",
    "id": "@id",
    "type": "@type",
    "sh": "http://www.w3.org/ns/shacl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "targetClass": {
      "@id": "sh:targetClass",
      "@type": "@id"
    },
    "property": {
      "@id": "sh:property",
      "@container": "@set"
    },
    "path": {
      "@id": "sh:path",
      "@type": "@id"
    },
    "datatype": {
      "@id": "sh:datatype",
      "@type": "@id"
    },
    "minInclusive": "sh:minInclusive",
    "maxInclusive": "sh:maxInclusive",
    "minCount": "sh:minCount",
    "maxCount": "sh:maxCount",
    "message": "sh:message",
    "severity": {
      "@id": "sh:severity",
      "@type": "@id"
    }
  },
  "@graph": [
    {
      "id": "https://etzhayyim.com/tia/capabilities/shapes/detection-result",
      "type": "sh:NodeShape",
      "targetClass": "https://etzhayyim.com/tia/resources/detection-result",
      "property": [
        {
          "path": "https://etzhayyim.com/tia/resources/detection-result#similarityScore",
          "datatype": "xsd:double",
          "minCount": 1,
          "maxCount": 1,
          "minInclusive": 0,
          "maxInclusive": 1,
          "message": "similarityScore is required and must be between 0.0 and 1.0",
          "severity": "sh:Violation"
        },
        {
          "path": "https://etzhayyim.com/tia/resources/detection-result#internetAccountId",
          "datatype": "xsd:string",
          "minCount": 1,
          "maxCount": 1,
          "message": "internetAccountId is required",
          "severity": "sh:Violation"
        },
        {
          "path": "https://etzhayyim.com/tia/resources/detection-result#detectedAt",
          "datatype": "xsd:dateTime",
          "minCount": 1,
          "maxCount": 1,
          "message": "detectedAt is required",
          "severity": "sh:Violation"
        }
      ]
    }
  ]
}
