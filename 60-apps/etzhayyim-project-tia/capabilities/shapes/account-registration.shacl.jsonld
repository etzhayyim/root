{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://etzhayyim.com/tia/capabilities#",
    "id": "@id",
    "type": "@type",
    "sh": "http://www.w3.org/ns/shacl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dct": "http://purl.org/dc/terms/",
    "targetClass": {
      "@id": "sh:targetClass",
      "@type": "@id"
    },
    "property": {
      "@id": "sh:property",
      "@container": "@set"
    },
    "path": {
      "@id": "sh:path",
      "@type": "@id"
    },
    "datatype": {
      "@id": "sh:datatype",
      "@type": "@id"
    },
    "minCount": "sh:minCount",
    "maxCount": "sh:maxCount",
    "minLength": "sh:minLength",
    "maxLength": "sh:maxLength",
    "pattern": "sh:pattern",
    "message": "sh:message",
    "severity": {
      "@id": "sh:severity",
      "@type": "@id"
    }
  },
  "@graph": [
    {
      "id": "https://etzhayyim.com/tia/capabilities/shapes/account-registration",
      "type": "sh:NodeShape",
      "targetClass": "https://etzhayyim.com/tia/resources/internet-account",
      "property": [
        {
          "path": "https://etzhayyim.com/tia/resources/internet-account#platformType",
          "datatype": "xsd:string",
          "minCount": 1,
          "maxCount": 1,
          "message": "platformType is required",
          "severity": "sh:Violation"
        },
        {
          "path": "https://etzhayyim.com/tia/resources/internet-account#accountName",
          "datatype": "xsd:string",
          "minCount": 1,
          "maxCount": 1,
          "minLength": 1,
          "message": "accountName is required and must not be empty",
          "severity": "sh:Violation"
        },
        {
          "path": "https://etzhayyim.com/tia/resources/internet-account#accountUrl",
          "datatype": "xsd:anyURI",
          "minCount": 0,
          "maxCount": 1,
          "pattern": "^https?://",
          "message": "accountUrl must be a valid HTTP/HTTPS URL if provided",
          "severity": "sh:Warning"
        },
        {
          "path": "https://etzhayyim.com/tia/resources/internet-account#userId",
          "datatype": "xsd:string",
          "minCount": 1,
          "maxCount": 1,
          "message": "userId is required",
          "severity": "sh:Violation"
        }
      ]
    }
  ]
}
