  "@graph": [
    {
      "id": "https://etzhayyim.com/tia/capabilities/account-protection",
      "type": "owl:Class",
      "label": "Account Protection Capability",
      "comment": "インターネットアカウント保護能力。アカウント所有者が自らのアカウントを保護対象として登録し、なりすまし検知を受ける能力",
      "subClassOf": "https://etzhayyim.com/tia/capabilities/base-capability"
    },
    {
      "id": "https://etzhayyim.com/tia/capabilities/account-protection#registerAccount",
      "type": "owl:ObjectProperty",
      "label": "RegisterAccount",
      "comment": "アカウントを保護対象として登録する",
      "domain": "https://etzhayyim.com/tia/performers/actors/internet-account-owner",
      "range": "https://etzhayyim.com/tia/resources/internet-account"
    },
    {
      "id": "https://etzhayyim.com/tia/capabilities/account-protection#manageAccount",
      "type": "owl:ObjectProperty",
      "label": "ManageAccount",
      "comment": "登録済みアカウントの管理（更新・削除・状態変更）",
      "domain": "https://etzhayyim.com/tia/performers/actors/internet-account-owner",
      "range": "https://etzhayyim.com/tia/resources/internet-account"
    },
    {
      "id": "https://etzhayyim.com/tia/capabilities/account-protection#receiveDetectionReport",
      "type": "owl:ObjectProperty",
      "label": "ReceiveDetectionReport",
      "comment": "検知結果の報告を受信する",
      "domain": "https://etzhayyim.com/tia/performers/actors/internet-account-owner",
      "range": "https://etzhayyim.com/tia/resources/detection-result"
    }
  ]
