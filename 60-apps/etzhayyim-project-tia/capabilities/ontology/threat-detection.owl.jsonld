{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://etzhayyim.com/tia/capabilities#",
    "id": "@id",
    "type": "@type",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dct": "http://purl.org/dc/terms/",
    "name": "dct:title",
    "description": "dct:description",
    "label": "rdfs:label",
    "comment": "rdfs:comment",
    "subClassOf": {
      "@id": "rdfs:subClassOf",
      "@type": "@id"
    },
    "domain": {
      "@id": "rdfs:domain",
      "@type": "@id"
    },
    "range": {
      "@id": "rdfs:range",
      "@type": "@id"
    }
  },
  "@graph": [
    {
      "id": "https://etzhayyim.com/tia/capabilities/threat-detection",
      "type": "owl:Class",
      "label": "Threat Detection Capability",
      "comment": "脅威検知能力。プラットフォーム毎の特徴（画像・プロフィール）を考慮した類似性評価により、なりすましアカウントを検知する",
      "subClassOf": "https://etzhayyim.com/tia/capabilities/base-capability"
    },
    {
      "id": "https://etzhayyim.com/tia/capabilities/threat-detection#analyzeSimilarity",
      "type": "owl:ObjectProperty",
      "label": "AnalyzeSimilarity",
      "comment": "画像・プロフィールの類似性を分析する（Gemini 2.5 Flashを使用）",
      "domain": "https://etzhayyim.com/tia/performers/systems/detector",
      "range": "https://etzhayyim.com/tia/resources/similarity-score"
    },
    {
      "id": "https://etzhayyim.com/tia/capabilities/threat-detection#calculateScore",
      "type": "owl:DatatypeProperty",
      "label": "CalculateScore",
      "comment": "類似性スコアを計算する（0-1の範囲）",
      "domain": "https://etzhayyim.com/tia/performers/systems/detector",
      "range": "xsd:double"
    },
    {
      "id": "https://etzhayyim.com/tia/capabilities/threat-detection#evaluateThreshold",
      "type": "owl:DatatypeProperty",
      "label": "EvaluateThreshold",
      "comment": "評価スコアに対して閾値判定を行う",
      "domain": "https://etzhayyim.com/tia/performers/systems/detector",
      "range": "xsd:boolean"
    }
  ]
}
