  "@graph": [
    {
      "id": "https://etzhayyim.com/tia/capabilities/root",
      "type": "skos:ConceptScheme",
      "prefLabel": "Internet Account Protection Capabilities",
      "definition": "インターネットアカウント保護システムの能力分類体系"
    },
    {
      "id": "https://etzhayyim.com/tia/capabilities/account-protection",
      "type": "skos:Concept",
      "prefLabel": "Account Protection",
      "altLabel": [
        "アカウント保護",
        "Account Management"
      ],
      "definition": "アカウント所有者が自らのアカウントを保護対象として登録し、なりすまし検知を受ける能力",
      "broader": "https://etzhayyim.com/tia/capabilities/root",
      "narrower": [
        "https://etzhayyim.com/tia/capabilities/account-protection#registration",
        "https://etzhayyim.com/tia/capabilities/account-protection#management"
      ]
    },
    {
      "id": "https://etzhayyim.com/tia/capabilities/threat-detection",
      "type": "skos:Concept",
      "prefLabel": "Threat Detection",
      "altLabel": [
        "脅威検知",
        "Threat Analysis"
      ],
      "definition": "プラットフォーム毎の特徴を考慮した類似性評価により、なりすましアカウントを検知する能力",
      "broader": "https://etzhayyim.com/tia/capabilities/root",
      "narrower": [
        "https://etzhayyim.com/tia/capabilities/threat-detection#similarity-analysis",
        "https://etzhayyim.com/tia/capabilities/threat-detection#score-calculation"
      ]
    },
    {
      "id": "https://etzhayyim.com/tia/capabilities/monitoring",
      "type": "skos:Concept",
      "prefLabel": "Monitoring",
      "altLabel": [
        "監視",
        "Account Monitoring"
      ],
      "definition": "Seeker による協働的なアカウント監視ネットワークを実現する能力",
      "broader": "https://etzhayyim.com/tia/capabilities/root",
      "related": [
        "https://etzhayyim.com/tia/capabilities/threat-detection"
      ]
    },
    {
      "id": "https://etzhayyim.com/tia/capabilities/reporting",
      "type": "skos:Concept",
      "prefLabel": "Reporting",
      "altLabel": [
        "報告",
        "Notification"
      ],
      "definition": "検知結果をアカウント所有者に報告する能力",
      "broader": "https://etzhayyim.com/tia/capabilities/root",
      "related": [
        "https://etzhayyim.com/tia/capabilities/threat-detection"
      ]
    },
    {
      "id": "https://etzhayyim.com/tia/capabilities/platform-integration",
      "type": "skos:Concept",
      "prefLabel": "Platform Integration",
      "altLabel": [
        "プラットフォーム統合",
        "Platform Communication"
      ],
      "definition": "各プラットフォーム（Facebook, LinkedIn, X, LINE, Instagram）への公式連絡を管理する能力",
      "broader": "https://etzhayyim.com/tia/capabilities/root"
    }
