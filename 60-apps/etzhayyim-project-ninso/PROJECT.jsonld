{
  "@context": [
    "https://schema.org/",
    {
      "etzhayyim": "https://etzhayyim.com/schemas/",
      "capabilities": "etzhayyim:capabilities"
    }
  ],
  "@type": "Project",
  "identifier": "etzhayyim-project-ninso",
  "name": "Ninso Physiognomy Analysis (ninso.etzhayyim.com)",
  "status": "In Progress",
  "description": "Face and clothing analysis for personality (Big Five), age, profile, and fashion style classification. Statistics-first cohort assignment via Murakumo VL (qwen3-vl-8b). No raw biometrics stored.",
  "capabilities": {
    "@type": "DefinedTermSet",
    "name": "Capabilities",
    "terms": [
      {
        "@type": "DefinedTerm",
        "name": "Face Analysis",
        "description": "Apparent age, gender, facial structure, skin condition, expression classification via Murakumo VL"
      },
      {
        "@type": "DefinedTerm",
        "name": "Personality Inference",
        "description": "Big Five personality traits (O/C/E/A/N) inferred from facial features and clothing style"
      },
      {
        "@type": "DefinedTerm",
        "name": "Fashion Classification",
        "description": "Clothing style, color palette, silhouette, era/trend, formality classification"
      },
      {
        "@type": "DefinedTerm",
        "name": "Profile Cohort",
        "description": "Combined face + personality + style → unified profile cohort with DJB2 hash DID assignment"
      },
      {
        "@type": "DefinedTerm",
        "name": "Cross-App Linkage",
        "description": "natural-person.etzhayyim.com cohort mapping, joucho emotional scoring, society6 Kyu/Dan integration"
      }
    ]
  }
}
