{
  "name": "kotodama-sg65kxvf",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"submitQuestion\",\"listQuestions\",\"getQuestion\",\"submitAnswer\",\"listAnswers\",\"voteAnswer\",\"listTopics\",\"getExpert\"]",
    "APP_DESCRIPTION": "oshiete — Q&A Knowledge Platform. Expert-driven question and answer system with topic discovery and voting.",
    "APP_DISPLAY_NAME": "Oshiete Q&A",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "sg65kxvf",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "sg65kxvf.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "oshiete.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
