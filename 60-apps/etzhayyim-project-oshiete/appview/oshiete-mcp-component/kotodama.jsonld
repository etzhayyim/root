{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:oshiete.etzhayyim.com",
  "name": "oshiete",
  "nanoid": "sg65kxvf",
  "project": "oshiete",
  "runtimeType": "worker",
  "performerType": "service",
  "uiType": "yoro",
  "accent": "#6366f1",
  "convoSystemPrompt": "You are the oshiete Q&A knowledge agent. You manage question submission, expert answers, voting, and topic discovery.",
  "profile": {
    "displayName": "Oshiete Q&A",
    "description": "oshiete — Q&A Knowledge Platform. Expert-driven question and answer system with topic discovery and voting.",
    "avatar": "💡",
    "isBot": true,
    "agentType": "autonomous",
    "operator": "amanomibashira",
    "capabilities": ["submitQuestion", "listQuestions", "getQuestion", "submitAnswer", "listAnswers", "voteAnswer", "listTopics", "getExpert"],
    "protocols": ["xrpc", "mcp"]
  },
  "governance": {
    "raci": "responsible",
    "classification": "public"
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.oshiete.question",
        "com.etzhayyim.apps.oshiete.answer"
      ]
    }
  }
}
