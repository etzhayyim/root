<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- submitQuestion -->
  <bpmn:process id="oshiete-submit-question" name="Oshiete Submit Question" isExecutable="true">
    <bpmn:startEvent id="start-submit-question"/>
    <bpmn:sequenceFlow id="sf-sq-1" sourceRef="start-submit-question" targetRef="task-submit-question"/>
    <bpmn:serviceTask id="task-submit-question" name="Submit Question">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.oshiete.submit.question"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-sq-2" sourceRef="task-submit-question" targetRef="end-submit-question"/>
    <bpmn:endEvent id="end-submit-question"/>
  </bpmn:process>

  <!-- listQuestions -->
  <bpmn:process id="oshiete-list-questions" name="Oshiete List Questions" isExecutable="true">
    <bpmn:startEvent id="start-list-questions"/>
    <bpmn:sequenceFlow id="sf-lq-1" sourceRef="start-list-questions" targetRef="task-list-questions"/>
    <bpmn:serviceTask id="task-list-questions" name="List Questions">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.oshiete.list.questions"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lq-2" sourceRef="task-list-questions" targetRef="end-list-questions"/>
    <bpmn:endEvent id="end-list-questions"/>
  </bpmn:process>

  <!-- getQuestion -->
  <bpmn:process id="oshiete-get-question" name="Oshiete Get Question" isExecutable="true">
    <bpmn:startEvent id="start-get-question"/>
    <bpmn:sequenceFlow id="sf-gq-1" sourceRef="start-get-question" targetRef="task-get-question"/>
    <bpmn:serviceTask id="task-get-question" name="Get Question">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.oshiete.get.question"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gq-2" sourceRef="task-get-question" targetRef="end-get-question"/>
    <bpmn:endEvent id="end-get-question"/>
  </bpmn:process>

  <!-- submitAnswer -->
  <bpmn:process id="oshiete-submit-answer" name="Oshiete Submit Answer" isExecutable="true">
    <bpmn:startEvent id="start-submit-answer"/>
    <bpmn:sequenceFlow id="sf-sa-1" sourceRef="start-submit-answer" targetRef="task-submit-answer"/>
    <bpmn:serviceTask id="task-submit-answer" name="Submit Answer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.oshiete.submit.answer"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-sa-2" sourceRef="task-submit-answer" targetRef="end-submit-answer"/>
    <bpmn:endEvent id="end-submit-answer"/>
  </bpmn:process>

  <!-- listAnswers -->
  <bpmn:process id="oshiete-list-answers" name="Oshiete List Answers" isExecutable="true">
    <bpmn:startEvent id="start-list-answers"/>
    <bpmn:sequenceFlow id="sf-la-1" sourceRef="start-list-answers" targetRef="task-list-answers"/>
    <bpmn:serviceTask id="task-list-answers" name="List Answers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.oshiete.list.answers"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-la-2" sourceRef="task-list-answers" targetRef="end-list-answers"/>
    <bpmn:endEvent id="end-list-answers"/>
  </bpmn:process>

  <!-- voteAnswer -->
  <bpmn:process id="oshiete-vote-answer" name="Oshiete Vote Answer" isExecutable="true">
    <bpmn:startEvent id="start-vote-answer"/>
    <bpmn:sequenceFlow id="sf-va-1" sourceRef="start-vote-answer" targetRef="task-vote-answer"/>
    <bpmn:serviceTask id="task-vote-answer" name="Vote Answer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.oshiete.vote.answer"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-va-2" sourceRef="task-vote-answer" targetRef="end-vote-answer"/>
    <bpmn:endEvent id="end-vote-answer"/>
  </bpmn:process>

  <!-- listTopics -->
  <bpmn:process id="oshiete-list-topics" name="Oshiete List Topics" isExecutable="true">
    <bpmn:startEvent id="start-list-topics"/>
    <bpmn:sequenceFlow id="sf-lt-1" sourceRef="start-list-topics" targetRef="task-list-topics"/>
    <bpmn:serviceTask id="task-list-topics" name="List Topics">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.oshiete.list.topics"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lt-2" sourceRef="task-list-topics" targetRef="end-list-topics"/>
    <bpmn:endEvent id="end-list-topics"/>
  </bpmn:process>

  <!-- getExpert -->
  <bpmn:process id="oshiete-get-expert" name="Oshiete Get Expert" isExecutable="true">
    <bpmn:startEvent id="start-get-expert"/>
    <bpmn:sequenceFlow id="sf-ge-1" sourceRef="start-get-expert" targetRef="task-get-expert"/>
    <bpmn:serviceTask id="task-get-expert" name="Get Expert">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.oshiete.get.expert"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-ge-2" sourceRef="task-get-expert" targetRef="end-get-expert"/>
    <bpmn:endEvent id="end-get-expert"/>
  </bpmn:process>

</bpmn:definitions>
