{
  "@context": "https://schema.org/",
  "@type": "Project",
  "name": "Manga Drama Platform (etzhayyim-project-drama)",
  "status": "In Progress",
  "identifier": "etzhayyim-project-drama",
  "description": "ReelShort型の縦型ショートドラマ配信プラットフォーム。AI生成による漫画ドラマ(マンガドラマ)をエピソード単位で配信し、コイン課金・サブスクリプションで収益化する。Production AGIが脚本・絵コンテ・動画合成を自律的に量産する。",
  "url": "https://drama.etzhayyim.com",
  "hasPart": [
    {
      "@type": "CreativeWork",
      "name": "Strategy",
      "url": "STRATEGY.jsonld"
    },
    {
      "@type": "CreativeWork",
      "name": "Capabilities",
      "url": "capabilities.jsonld"
    },
    {
      "@type": "CreativeWork",
      "name": "Activities",
      "url": "activities.jsonld"
    },
    {
      "@type": "CreativeWork",
      "name": "Architecture",
      "url": "ARCHITECTURE.jsonld"
    },
    {
      "@type": "CreativeWork",
      "name": "Measures",
      "url": "measures.jsonld"
    },
    {
      "@type": "CreativeWork",
      "name": "Scheduler",
      "url": "scheduler.jsonld"
    }
  ],
  "tasks": [
    {
      "status": "completed",
      "task": "ReelShortモデル分析とビジネスプロセス設計"
    },
    {
      "status": "completed",
      "task": "DoDAF v2 Capability / Activity / Performer 定義"
    },
    {
      "status": "pending",
      "task": "drama.proto (MCP gRPC) の定義"
    },
    {
      "status": "pending",
      "task": "drama-mcp SpinApp component の実装"
    },
    {
      "status": "pending",
      "task": "drama-ui SvelteKit SSG の実装 (縦型プレイヤー)"
    },
    {
      "status": "pending",
      "task": "コイン課金 Billing 連携 (Stripe)"
    },
    {
      "status": "pending",
      "task": "HLS/DASH 動画配信パイプラインの構築"
    },
    {
      "status": "pending",
      "task": "AGI自律量産パイプライン (Narou連携)"
    }
  ],
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "ARCHITECTURE.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "dct": "http://purl.org/dc/terms/",
            "etzhayyim": "https://etzhayyim.com/schemas/"
          },
          "id": "https://etzhayyim.com/projects/etzhayyim-project-drama/architecture",
          "type": "dodaf:SystemView",
          "dct:title": "Manga Drama Platform System Architecture (SV-1)",
          "etzhayyim:components": [
            {
              "name": "Drama UI (SvelteKit SSG)",
              "technology": "Svelte 5 / SvelteKit 2 / Tailwind / HLS.js / Clerk",
              "description": "縦型フルスクリーン動画プレイヤーを中心としたモバイルファースト UI。シリーズ一覧、エピソード選択、コインショップ、ウォッチリストを提供。",
              "host": "drama.etzhayyim.com",
              "deployment": "Linode Object Storage (CDN direct)"
            },
            {
              "name": "Drama MCP Component (SpinApp)",
              "technology": "TinyGo / SpinApp / wasi:http / JSON-RPC 2.0",
              "description": "ドラマコンテンツ管理・エピソード配信制御・課金処理・視聴アナリティクスを担う MCP サーバー。",
              "endpoint": "https://{nanoid}.etzhayyim.com/api/grpc",
              "tools": [
                "drama.list_series",
                "drama.get_series",
                "drama.list_episodes",
                "drama.get_episode",
                "drama.unlock_episode",
                "drama.get_streaming_url",
                "drama.track_viewing",
                "drama.create_series",
                "drama.publish_episode",
                "drama.set_pricing"
              ]
            },
            {
              "name": "Video Processing Pipeline",
              "technology": "FFmpeg / HLS / Linode Object Storage",
              "description": "AI生成パネルからモーション合成→音声合成→HLSエンコード→S3アップロードのパイプライン。"
            },
            {
              "name": "Billing Integration (Shared)",
              "technology": "Stripe / ConnectRPC / PostgreSQL",
              "description": "etzhayyim-project-manga の Billing Actor を共有利用。コイン残高・トランザクション管理。"
            }
          ],
          "etzhayyim:data_model": [
            {
              "entity": "DramaSeries",
              "properties": [
                "id",
                "title",
                "description",
                "genre",
                "tags",
                "thumbnail_url",
                "season_count",
                "status",
                "languages",
                "created_at"
              ]
            },
            {
              "entity": "DramaSeason",
              "properties": [
                "id",
                "series_id",
                "season_number",
                "episode_count",
                "status"
              ]
            },
            {
              "entity": "DramaEpisode",
              "properties": [
                "id",
                "series_id",
                "season_id",
                "episode_number",
                "title",
                "duration_seconds",
                "hls_url",
                "thumbnail_url",
                "price_coins",
                "is_free",
                "paid_start",
                "release_date",
                "subtitles",
                "audio_tracks"
              ]
            },
            {
              "entity": "ViewingRecord",
              "properties": [
                "user_id",
                "episode_id",
                "progress_seconds",
                "completed",
                "last_viewed_at"
              ]
            },
            {
              "entity": "EpisodeAccess",
              "properties": [
                "user_id",
                "episode_id",
                "grant_type",
                "granted_at",
                "expires_at"
              ]
            },
            {
              "entity": "Subscription",
              "properties": [
                "user_id",
                "plan",
                "status",
                "started_at",
                "expires_at",
                "stripe_subscription_id"
              ]
            }
          ],
          "etzhayyim:integration_points": [
            {
              "name": "Narou Pipeline (upstream)",
              "protocol": "MCP gRPC",
              "description": "etzhayyim-project-narou の生成パイプラインが脚本・パネルを生成し、Drama がモーション合成・配信を担当。"
            },
            {
              "name": "Manga Billing (shared)",
              "protocol": "MCP gRPC",
              "description": "etzhayyim-project-manga のコイン課金システムを共有利用。"
            },
            {
              "name": "Linode Object Storage (downstream)",
              "protocol": "S3 API",
              "description": "HLSセグメント・サムネイル・字幕ファイルの格納先。Envoy Gateway 経由で配信。"
            }
          ]
        }
      },
      {
        "fileName": "STRATEGY.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "dct": "http://purl.org/dc/terms/"
          },
          "id": "https://etzhayyim.com/projects/etzhayyim-project-drama/strategy",
          "type": "dodaf:StrategicView",
          "dct:title": "Manga Drama Platform 戦略ビジョン",
          "dct:description": "ReelShort型ショートドラマ × AI漫画生成で、スマホネイティブな縦型マンガドラマを大量生産・配信する。Narouプロジェクトの生成パイプラインを下流消費し、drama.etzhayyim.comで直接課金配信する。",
          "goals": [
            "1話2-3分の縦型マンガドラマをエピソード単位で配信し、フリーミアム＋コイン課金で収益化",
            "AGI Director/Artist/Animator によるドラマコンテンツの自律量産 (目標: 月間100シリーズ新規)",
            "Narou (etzhayyim-project-narou) の小説→漫画→アニメ変換パイプラインをドラマ配信フォーマットに最適化",
            "多言語展開 (ja/zh-TW/en/ko) でグローバルなショートドラマ市場を獲得",
            "HLS配信 + Linode Object Storage によるCDN直結の低コスト動画配信"
          ],
          "competitors": [
            {
              "name": "ReelShort",
              "model": "縦型実写ショートドラマ、コイン課金、1話2-3分"
            },
            {
              "name": "Piccoma",
              "model": "待てば無料の漫画配信、コイン＋サブスク"
            },
            {
              "name": "WEBTOON",
              "model": "縦型スクロール漫画、広告＋課金"
            }
          ],
          "differentiator": "実写ではなくAI生成マンガドラマに特化。制作コストを1/100に圧縮し、ニッチジャンル大量展開で市場のロングテールを獲得。"
        }
      },
      {
        "fileName": "activities.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "dct": "http://purl.org/dc/terms/",
            "etzhayyim": "https://etzhayyim.com/schemas/"
          },
          "id": "https://etzhayyim.com/projects/etzhayyim-project-drama/activities",
          "type": "dodaf:OperationalActivity",
          "dct:title": "Manga Drama Platform Operational Process (OV-5b)",
          "dct:description": "マンガドラマの制作・配信・課金に関するビジネスプロセス定義。ReelShortモデルをベースにAGI量産を統合。",
          "etzhayyim:processes": [
            {
              "name": "Drama Content Production Flow (AGI Autonomous)",
              "description": "Narouの生成パイプラインを消費し、マンガドラマ形式に変換・量産する。",
              "steps": [
                {
                  "activity": "Script Generation",
                  "performer": "narou-mcp-component (etzhayyim-project-narou)",
                  "action": "LLMがジャンル・トロープ指定に基づいてエピソード脚本を自動生成。1シリーズ50-100話構成。",
                  "input": "Genre Template / Trope Config / Series Outline",
                  "output": "Episode Scripts (JSON-LD)"
                },
                {
                  "activity": "Storyboard & Panel Generation",
                  "performer": "narou-mcp-component (etzhayyim-project-narou)",
                  "action": "脚本からシーン分割し、各シーンの絵コンテ・パネルレイアウトをAIが自動生成。",
                  "input": "Episode Scripts",
                  "output": "Storyboard Panels (PNG sequence)"
                },
                {
                  "activity": "Motion & Animation Synthesis",
                  "performer": "drama-mcp-component",
                  "action": "静止パネルにカメラワーク・パン・ズーム・パーティクルエフェクトを適用し、2-3分の動画クリップを合成。",
                  "input": "Storyboard Panels",
                  "output": "Raw Video Clip (MP4)"
                },
                {
                  "activity": "Voice & Sound Synthesis",
                  "performer": "drama-mcp-component",
                  "action": "台詞をAIボイスで生成、BGM・効果音をシーンタイミングに合わせてミキシング。多言語吹替も同時生成。",
                  "input": "Episode Scripts / Raw Video Clip",
                  "output": "Audio Master Track (multi-language)"
                },
                {
                  "activity": "Video Encoding & Packaging",
                  "performer": "drama-mcp-component",
                  "action": "動画＋音声を合成し、HLS (.m3u8) 形式にエンコード。複数解像度 (360p/720p/1080p) でアダプティブ配信用にパッケージング。",
                  "input": "Raw Video Clip / Audio Master Track",
                  "output": "HLS Segments (Linode Object Storage)"
                }
              ]
            },
            {
              "name": "Content Publishing & Scheduling Flow",
              "description": "制作済みエピソードのリリース管理。バッチアップロード→スケジュール公開。",
              "steps": [
                {
                  "activity": "Metadata Registration",
                  "performer": "drama-mcp-component",
                  "action": "シリーズ・シーズン・エピソードのメタデータ (タイトル、サムネイル、ジャンル、言語、レーティング) を登録。",
                  "input": "Content Package / Metadata Sheet",
                  "output": "Registered Series (statestore)"
                },
                {
                  "activity": "Pricing & Access Control Setup",
                  "performer": "drama-mcp-component",
                  "action": "無料公開話数 (paid_start)、エピソード単価 (coins)、VIP無料フラグを設定。",
                  "input": "Monetization Config",
                  "output": "Pricing Rules"
                },
                {
                  "activity": "Scheduled Release",
                  "performer": "drama-mcp-component",
                  "action": "リリース日時を指定してエピソードを予約公開。曜日別更新スケジュールにも対応。",
                  "input": "Release Schedule",
                  "output": "Published Episodes"
                },
                {
                  "activity": "CDN Deployment",
                  "performer": "Pulumi (infra)",
                  "action": "HLSセグメントをLinode Object Storageにsync、Envoy Gateway HTTPRouteで drama.etzhayyim.com に配信。",
                  "input": "HLS Segments",
                  "output": "Live Streaming URL"
                }
              ]
            },
            {
              "name": "User Viewing & Monetization Flow",
              "description": "ユーザーのドラマ視聴と課金フロー。ReelShortのコイン課金モデルを踏襲。",
              "steps": [
                {
                  "activity": "Free Episode Viewing",
                  "performer": "drama-ui (cdn)",
                  "action": "シリーズ最初の数話 (paid_start まで) を無料視聴。縦型フルスクリーンプレイヤーで再生。",
                  "input": "Series ID",
                  "output": "Video Playback (HLS)"
                },
                {
                  "activity": "Coin Top-up",
                  "performer": "billing-actor (manga billing shared)",
                  "action": "Stripe Checkout でコインを購入。初回特典・ボーナスコイン付与。",
                  "input": "User ID / Payment Amount",
                  "output": "Coin Balance Updated"
                },
                {
                  "activity": "Episode Unlock (Coin)",
                  "performer": "drama-mcp-component",
                  "action": "コインを消費して有料エピソードをアンロック。購入済みエピソードは永続アクセス。",
                  "input": "User ID / Episode ID / Coin Amount",
                  "output": "Access Grant"
                },
                {
                  "activity": "VIP Subscription Access",
                  "performer": "drama-mcp-component",
                  "action": "VIPサブスクリプション会員は全エピソードを追加課金なしで視聴可能。",
                  "input": "User ID / Subscription Status",
                  "output": "Unlimited Access Grant"
                },
                {
                  "activity": "Engagement Tracking",
                  "performer": "drama-mcp-component",
                  "action": "視聴完了率、離脱ポイント、ウォッチリスト追加、シェア行動をトラッキング。",
                  "input": "User Events",
                  "output": "Analytics Data"
                }
              ]
            },
            {
              "name": "Localization & Global Distribution Flow",
              "description": "多言語展開のプロセス。AI翻訳＋AI吹替で低コストにローカライズ。",
              "steps": [
                {
                  "activity": "Subtitle Generation",
                  "performer": "narou-mcp-component (etzhayyim-project-narou)",
                  "action": "元言語の脚本からターゲット言語 (ja/zh-TW/en/ko) の字幕を自動生成。",
                  "input": "Episode Scripts / Target Languages",
                  "output": "Subtitle Files (VTT)"
                },
                {
                  "activity": "AI Dubbing",
                  "performer": "drama-mcp-component",
                  "action": "各言語用のAIボイスで吹替音声を生成。リップシンクは不要 (マンガドラマのため)。",
                  "input": "Translated Scripts / Voice Profiles",
                  "output": "Dubbed Audio Tracks"
                },
                {
                  "activity": "Regional Release",
                  "performer": "drama-mcp-component",
                  "action": "地域別のレーティング・価格設定を適用してリリース。",
                  "input": "Localized Content / Regional Config",
                  "output": "Region-specific Published Content"
                }
              ]
            }
          ]
        }
      },
      {
        "fileName": "capabilities.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "dct": "http://purl.org/dc/terms/"
          },
          "id": "https://etzhayyim.com/projects/etzhayyim-project-drama/capabilities",
          "type": "dodaf:Capability",
          "dct:title": "Manga Drama Platform Capability Catalog (CV-2)",
          "capabilities": [
            {
              "name": "Episodic Drama Distribution (C1)",
              "description": "シリーズ→シーズン→エピソード構造の縦型マンガドラマをHLS/DASH配信する。1話2-3分のショートフォームに最適化。"
            },
            {
              "name": "Freemium Monetization Engine (C2)",
              "description": "最初の数話を無料公開し、以降はコイン課金でアンロック。週額・月額・年額VIPサブスクリプションで見放題プランも提供。"
            },
            {
              "name": "AGI Drama Production Pipeline (C3)",
              "description": "脚本生成→絵コンテ→パネル描画→モーション合成→音声合成→動画エンコードを自律実行する量産パイプライン。Narouの生成パイプラインを消費。"
            },
            {
              "name": "Multi-Language Localization (C4)",
              "description": "字幕・吹替・UI多言語化 (ja/zh-TW/en/ko) によるグローバル配信。AI翻訳・AI吹替で低コスト展開。"
            },
            {
              "name": "Viewer Engagement & Retention (C5)",
              "description": "続きが気になるクリフハンガー演出、パーソナライズレコメンド、視聴履歴・ウォッチリストによるリテンション強化。"
            },
            {
              "name": "Content Scheduling & Release Management (C6)",
              "description": "バッチアップロード＋スケジュールリリース。曜日別更新、シーズン一括公開、期間限定無料キャンペーンの管理。"
            }
          ]
        }
      },
      {
        "fileName": "measures.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "dct": "http://purl.org/dc/terms/",
            "etzhayyim": "https://etzhayyim.com/schemas/"
          },
          "id": "https://etzhayyim.com/projects/etzhayyim-project-drama/measures",
          "type": "dodaf:ProjectView",
          "dct:title": "Manga Drama Platform Measures & KPIs (PV-2)",
          "dct:description": "ドラマ配信ビジネスのKPI。ReelShort型ショートドラマの業界水準をベンチマークとする。",
          "etzhayyim:measures": [
            {
              "category": "Growth",
              "metrics": [
                {
                  "name": "MAU",
                  "description": "Monthly Active Users",
                  "target": "500,000 in Year 1"
                },
                {
                  "name": "DAU/MAU Ratio",
                  "description": "Stickiness (Daily/Monthly ratio)",
                  "target": ">25%"
                },
                {
                  "name": "Episode Views/Day",
                  "description": "Daily total episode views",
                  "target": "1,000,000"
                }
              ]
            },
            {
              "category": "Monetization",
              "metrics": [
                {
                  "name": "ARPU",
                  "description": "Average Revenue Per User (monthly)",
                  "target": "¥800"
                },
                {
                  "name": "Coin Conversion Rate",
                  "description": "Free to Paid user conversion",
                  "target": ">8%"
                },
                {
                  "name": "VIP Subscription Rate",
                  "description": "Paid users with VIP plan",
                  "target": ">15%"
                }
              ]
            },
            {
              "category": "Content",
              "metrics": [
                {
                  "name": "Active Series",
                  "description": "Number of series with ongoing episodes",
                  "target": "500 titles"
                },
                {
                  "name": "AGI Production Rate",
                  "description": "New episodes generated per day",
                  "target": "200 episodes/day"
                },
                {
                  "name": "Completion Rate",
                  "description": "Users who finish an episode",
                  "target": ">70%"
                }
              ]
            },
            {
              "category": "Retention",
              "metrics": [
                {
                  "name": "D1 Retention",
                  "description": "Day 1 return rate",
                  "target": ">50%"
                },
                {
                  "name": "D7 Retention",
                  "description": "Day 7 return rate",
                  "target": ">30%"
                },
                {
                  "name": "D30 Retention",
                  "description": "Day 30 return rate",
                  "target": ">15%"
                }
              ]
            }
          ]
        }
      },
      {
        "fileName": "scheduler.jsonld",
        "content": {
          "@context": [
            "https://schema.org/",
            {
              "etzhayyim": "https://etzhayyim.com/schemas/",
              "milestones": "etzhayyim:milestones",
              "blockers": "etzhayyim:blockers"
            }
          ],
          "@type": "CreativeWork",
          "name": "Manga Drama Platform (etzhayyim-project-drama) Scheduler",
          "identifier": "etzhayyim-project-drama/scheduler",
          "description": "Project schedule (milestones) and blockers.",
          "dateCreated": "2026-02-18T00:00:00+00:00",
          "milestones": [
            {
              "@type": "CreativeWork",
              "name": "drama.proto MCP gRPC 定義と drama-mcp SpinApp component の実装",
              "status": "Planned",
              "dueDate": "2026-03-01"
            },
            {
              "@type": "CreativeWork",
              "name": "drama-ui SvelteKit SSG (縦型プレイヤー・エピソード一覧) の実装",
              "status": "Planned",
              "dueDate": "2026-03-08"
            },
            {
              "@type": "CreativeWork",
              "name": "HLS動画配信パイプライン (FFmpeg→S3→Envoy) の構築",
              "status": "Planned",
              "dueDate": "2026-03-15"
            },
            {
              "@type": "CreativeWork",
              "name": "コイン課金連携 (Manga Billing共有) とVIPサブスクリプション実装",
              "status": "Planned",
              "dueDate": "2026-03-22"
            },
            {
