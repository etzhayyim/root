<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- createProfile -->
  <bpmn:process id="performers-create-profile" name="Performers Create Profile" isExecutable="true">
    <bpmn:startEvent id="start-create-profile"/>
    <bpmn:sequenceFlow id="sf-cp-1" sourceRef="start-create-profile" targetRef="task-create-profile"/>
    <bpmn:serviceTask id="task-create-profile" name="Create Profile">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.performers.create.profile"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-cp-2" sourceRef="task-create-profile" targetRef="end-create-profile"/>
    <bpmn:endEvent id="end-create-profile"/>
  </bpmn:process>

  <!-- listProfiles -->
  <bpmn:process id="performers-list-profiles" name="Performers List Profiles" isExecutable="true">
    <bpmn:startEvent id="start-list-profiles"/>
    <bpmn:sequenceFlow id="sf-lp-1" sourceRef="start-list-profiles" targetRef="task-list-profiles"/>
    <bpmn:serviceTask id="task-list-profiles" name="List Profiles">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.performers.list.profiles"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lp-2" sourceRef="task-list-profiles" targetRef="end-list-profiles"/>
    <bpmn:endEvent id="end-list-profiles"/>
  </bpmn:process>

  <!-- getProfile -->
  <bpmn:process id="performers-get-profile" name="Performers Get Profile" isExecutable="true">
    <bpmn:startEvent id="start-get-profile"/>
    <bpmn:sequenceFlow id="sf-gp-1" sourceRef="start-get-profile" targetRef="task-get-profile"/>
    <bpmn:serviceTask id="task-get-profile" name="Get Profile">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.performers.get.profile"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gp-2" sourceRef="task-get-profile" targetRef="end-get-profile"/>
    <bpmn:endEvent id="end-get-profile"/>
  </bpmn:process>

  <!-- createBooking -->
  <bpmn:process id="performers-create-booking" name="Performers Create Booking" isExecutable="true">
    <bpmn:startEvent id="start-create-booking"/>
    <bpmn:sequenceFlow id="sf-cb-1" sourceRef="start-create-booking" targetRef="task-create-booking"/>
    <bpmn:serviceTask id="task-create-booking" name="Create Booking">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.performers.create.booking"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-cb-2" sourceRef="task-create-booking" targetRef="end-create-booking"/>
    <bpmn:endEvent id="end-create-booking"/>
  </bpmn:process>

  <!-- listBookings -->
  <bpmn:process id="performers-list-bookings" name="Performers List Bookings" isExecutable="true">
    <bpmn:startEvent id="start-list-bookings"/>
    <bpmn:sequenceFlow id="sf-lb-1" sourceRef="start-list-bookings" targetRef="task-list-bookings"/>
    <bpmn:serviceTask id="task-list-bookings" name="List Bookings">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.performers.list.bookings"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lb-2" sourceRef="task-list-bookings" targetRef="end-list-bookings"/>
    <bpmn:endEvent id="end-list-bookings"/>
  </bpmn:process>

  <!-- recordPerformance -->
  <bpmn:process id="performers-record-performance" name="Performers Record Performance" isExecutable="true">
    <bpmn:startEvent id="start-record-performance"/>
    <bpmn:sequenceFlow id="sf-rp-1" sourceRef="start-record-performance" targetRef="task-record-performance"/>
    <bpmn:serviceTask id="task-record-performance" name="Record Performance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.performers.record.performance"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-rp-2" sourceRef="task-record-performance" targetRef="end-record-performance"/>
    <bpmn:endEvent id="end-record-performance"/>
  </bpmn:process>

  <!-- listPerformances -->
  <bpmn:process id="performers-list-performances" name="Performers List Performances" isExecutable="true">
    <bpmn:startEvent id="start-list-performances"/>
    <bpmn:sequenceFlow id="sf-lpf-1" sourceRef="start-list-performances" targetRef="task-list-performances"/>
    <bpmn:serviceTask id="task-list-performances" name="List Performances">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.performers.list.performances"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lpf-2" sourceRef="task-list-performances" targetRef="end-list-performances"/>
    <bpmn:endEvent id="end-list-performances"/>
  </bpmn:process>

  <!-- submitReview -->
  <bpmn:process id="performers-submit-review" name="Performers Submit Review" isExecutable="true">
    <bpmn:startEvent id="start-submit-review"/>
    <bpmn:sequenceFlow id="sf-sr-1" sourceRef="start-submit-review" targetRef="task-submit-review"/>
    <bpmn:serviceTask id="task-submit-review" name="Submit Review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.performers.submit.review"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-sr-2" sourceRef="task-submit-review" targetRef="end-submit-review"/>
    <bpmn:endEvent id="end-submit-review"/>
  </bpmn:process>

</bpmn:definitions>
