{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://scap.gftd.ai/ontology#",
    "id": "@id",
    "type": "@type",
    "sh": "http://www.w3.org/ns/shacl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "prov": "http://www.w3.org/ns/prov#",
    "dct": "http://purl.org/dc/terms/",
    "targetClass": {
      "@id": "sh:targetClass",
      "@type": "@id"
    },
    "property": {
      "@id": "sh:property",
      "@container": "@set"
    },
    "path": {
      "@id": "sh:path",
      "@type": "@id"
    },
    "datatype": {
      "@id": "sh:datatype",
      "@type": "@id"
    },
    "minCount": "sh:minCount",
    "maxCount": "sh:maxCount",
    "pattern": "sh:pattern",
    "minLength": "sh:minLength",
    "maxLength": "sh:maxLength",
    "in": {
      "@id": "sh:in",
      "@container": "@set"
    },
    "nodeKind": {
      "@id": "sh:nodeKind",
      "@type": "@id"
    },
    "node": {
      "@id": "sh:node",
      "@type": "@id"
    },
    "name": "sh:name",
    "description": "sh:description",
    "severity": {
      "@id": "sh:severity",
      "@type": "@id"
    },
    "wasDerivedFrom": {
      "@id": "prov:wasDerivedFrom",
      "@type": "@id",
      "@container": "@set"
    }
  },
  "@id": "https://scap.gftd.ai/capabilities/shape",
  "@type": "sh:Shape",
  "name": "SCAP Platform Data Validation Shapes",
  "description": "SHACL shapes defining validation constraints for SCAP platform data",
  "@graph": [
    {
      "@id": "https://scap.gftd.ai/shapes/SCAPContentShape",
      "@type": "sh:NodeShape",
      "targetClass": {
        "@id": "https://scap.gftd.ai/ontology#SCAPContent"
      },
      "name": "SCAP Content Shape",
      "description": "Validation constraints for SCAP Content entities",
      "property": [
        {
          "path": {
            "@id": "https://scap.gftd.ai/ontology#id"
          },
          "datatype": {
            "@id": "xsd:string"
          },
          "minCount": 1,
          "maxCount": 1,
          "minLength": 1,
          "name": "id"
        },
        {
          "path": {
            "@id": "https://scap.gftd.ai/ontology#title"
          },
          "datatype": {
            "@id": "xsd:string"
          },
          "minCount": 1,
          "maxCount": 1,
          "minLength": 1,
          "name": "title"
        },
        {
          "path": {
            "@id": "https://scap.gftd.ai/ontology#type"
          },
          "datatype": {
            "@id": "xsd:string"
          },
          "minCount": 1,
          "maxCount": 1,
          "in": [
            {
              "@value": "cve"
            },
            {
              "@value": "oval"
            },
            {
              "@value": "xccdf"
            },
            {
              "@value": "cce"
            },
            {
              "@value": "cpe"
            },
            {
              "@value": "scap-benchmark"
            },
            {
              "@value": "stig"
            }
          ],
          "name": "type"
        },
        {
          "path": {
            "@id": "https://scap.gftd.ai/ontology#status"
          },
          "datatype": {
            "@id": "xsd:string"
          },
          "minCount": 1,
          "maxCount": 1,
          "in": [
            {
              "@value": "active"
            },
            {
              "@value": "inactive"
            },
            {
              "@value": "deprecated"
            }
          ],
          "name": "status"
        }
      ]
    },
    {
      "@id": "https://scap.gftd.ai/shapes/CVEDataShape",
      "@type": "sh:NodeShape",
      "targetClass": {
        "@id": "https://scap.gftd.ai/ontology#CVEData"
      },
      "name": "CVE Data Shape",
      "description": "Validation constraints for CVE Data entities",
      "property": [
        {
          "path": {
            "@id": "https://scap.gftd.ai/ontology#cveId"
          },
          "datatype": {
            "@id": "xsd:string"
          },
          "minCount": 1,
          "maxCount": 1,
          "pattern": "^CVE-\\d{4}-\\d{4,}$",
          "name": "cveId"
        },
        {
          "path": {
            "@id": "https://scap.gftd.ai/ontology#severity"
          },
          "datatype": {
            "@id": "xsd:string"
          },
          "minCount": 1,
          "maxCount": 1,
          "in": [
            {
              "@value": "low"
            },
            {
              "@value": "medium"
            },
            {
              "@value": "high"
            },
            {
              "@value": "critical"
            }
          ],
          "name": "severity"
        },
        {
          "path": {
            "@id": "https://scap.gftd.ai/ontology#cvssScore"
          },
          "datatype": {
            "@id": "xsd:double"
          },
          "minCount": 0,
          "maxCount": 1,
          "node": {
            "@id": "https://scap.gftd.ai/shapes/CVSSCoreRange"
          },
          "name": "cvssScore"
        }
      ]
    },
    {
      "@id": "https://scap.gftd.ai/shapes/CVSSCoreRange",
      "@type": "sh:NodeShape",
      "name": "CVSS Score Range",
      "description": "CVSS score must be between 0.0 and 10.0",
      "nodeKind": {
        "@id": "sh:Literal"
      }
    },
    {
      "@id": "https://scap.gftd.ai/shapes/SCAPScanResultShape",
      "@type": "sh:NodeShape",
      "targetClass": {
        "@id": "https://scap.gftd.ai/ontology#SCAPScanResult"
      },
      "name": "SCAP Scan Result Shape",
      "description": "Validation constraints for SCAP Scan Result entities",
      "property": [
        {
          "path": {
            "@id": "https://scap.gftd.ai/ontology#status"
          },
          "datatype": {
            "@id": "xsd:string"
          },
          "minCount": 1,
          "maxCount": 1,
          "in": [
            {
              "@value": "pending"
            },
            {
              "@value": "running"
            },
            {
              "@value": "completed"
            },
            {
              "@value": "failed"
            }
          ],
          "name": "status"
        },
        {
          "path": {
            "@id": "https://scap.gftd.ai/ontology#compliancePercentage"
          },
          "datatype": {
            "@id": "xsd:double"
          },
          "minCount": 1,
          "maxCount": 1,
          "node": {
            "@id": "https://scap.gftd.ai/shapes/PercentageRange"
          },
          "name": "compliancePercentage"
        }
      ]
    },
    {
      "@id": "https://scap.gftd.ai/shapes/PercentageRange",
      "@type": "sh:NodeShape",
      "name": "Percentage Range",
      "description": "Percentage value must be between 0.0 and 100.0",
      "nodeKind": {
        "@id": "sh:Literal"
      }
    },
    {
      "@id": "https://scap.gftd.ai/shapes/SCAPDataSourceShape",
      "@type": "sh:NodeShape",
      "targetClass": {
        "@id": "https://scap.gftd.ai/ontology#SCAPDataSource"
      },
      "name": "SCAP Data Source Shape",
      "description": "Validation constraints for SCAP Data Source entities",
      "property": [
        {
          "path": {
            "@id": "https://scap.gftd.ai/ontology#url"
          },
          "datatype": {
            "@id": "xsd:anyURI"
          },
          "minCount": 1,
          "maxCount": 1,
          "name": "url"
        },
        {
          "path": {
            "@id": "https://scap.gftd.ai/ontology#updateFrequency"
          },
          "datatype": {
            "@id": "xsd:string"
          },
          "minCount": 1,
          "maxCount": 1,
          "in": [
            {
              "@value": "hourly"
            },
            {
              "@value": "daily"
            },
            {
              "@value": "weekly"
            },
            {
              "@value": "monthly"
            }
          ],
          "name": "updateFrequency"
        },
        {
          "path": {
            "@id": "https://scap.gftd.ai/ontology#status"
          },
          "datatype": {
            "@id": "xsd:string"
          },
          "minCount": 1,
          "maxCount": 1,
          "in": [
            {
              "@value": "active"
            },
            {
              "@value": "inactive"
            }
          ],
          "name": "status"
        }
      ]
    },
    {
      "@id": "https://scap.gftd.ai/shapes/IntegrationShape",
      "@type": "sh:NodeShape",
      "targetClass": {
        "@id": "https://scap.gftd.ai/ontology#Integration"
      },
      "name": "Integration Shape",
      "description": "Validation constraints for Integration entities",
      "property": [
        {
          "path": {
            "@id": "https://scap.gftd.ai/ontology#type"
          },
          "datatype": {
            "@id": "xsd:string"
          },
          "minCount": 1,
          "maxCount": 1,
          "in": [
            {
              "@value": "aws"
            },
            {
              "@value": "gcp"
            },
            {
              "@value": "azure"
            },
            {
              "@value": "github"
            },
            {
              "@value": "gitlab"
            }
          ],
          "name": "type"
        },
        {
          "path": {
            "@id": "https://scap.gftd.ai/ontology#status"
          },
          "datatype": {
            "@id": "xsd:string"
          },
          "minCount": 1,
          "maxCount": 1,
          "in": [
            {
              "@value": "active"
            },
            {
              "@value": "inactive"
            }
          ],
          "name": "status"
        }
      ]
    }
  ],
  "wasDerivedFrom": [
    "https://github.com/gftdcojp/ai-gftd-scap/blob/main/performers/services/graphql/src/schema.rs",
    "https://github.com/gftdcojp/ai-gftd-scap/blob/main/src/internal/zod/index.ts"
  ]
}
