  "@id": "https://scap.gftd.ai/activities/scap-data-search",
  "@type": [
    "dodaf:Activity",
    "prov:Activity"
  ],
  "name": "SCAP Data Search",
  "description": "Activity for searching and querying SCAP data with filtering by type, source, severity, and other criteria",
  "createdAt": "2024-01-01T00:00:00Z",
  "updatedAt": "2024-01-01T00:00:00Z",
  "performedBy": [
    {
      "@id": "https://scap.gftd.ai/performers/services/graphql"
    }
  ],
  "produces": [
    {
      "@id": "https://scap.gftd.ai/resources/search-results",
      "name": "Search Results",
      "description": "Filtered and paginated SCAP data search results"
    }
  ],
  "consumes": [
    {
      "@id": "https://scap.gftd.ai/resources/schemas/scapContents"
    },
    {
      "@id": "https://scap.gftd.ai/resources/schemas/cveData"
    },
    {
      "@id": "https://scap.gftd.ai/resources/schemas/ovalDefinitions"
    }
  ],
  "requires": [
    {
      "@id": "https://scap.gftd.ai/capabilities/data-integration"
    }
  ],
  "enables": [
    {
      "@id": "https://scap.gftd.ai/effect/unified-scap-platform"
    }
  ],
  "realizes": [
    {
      "@id": "https://scap.gftd.ai/goal/search-scap-data"
    }
  ],
  "step": [
    {
      "@id": "https://scap.gftd.ai/activities/scap-data-search/parse-query",
      "name": "Parse Query",
      "description": "Parse search query parameters and filters",
      "wasDerivedFrom": "https://github.com/gftdcojp/ai-gftd-scap/blob/main/performers/services/graphql/src/queries.rs"
    },
    {
      "@id": "https://scap.gftd.ai/activities/scap-data-search/query-database",
      "name": "Query Database",
      "description": "Query PostgreSQL database using Diesel ORM via Rust GraphQL service with filters",
      "wasDerivedFrom": "https://github.com/gftdcojp/ai-gftd-scap/blob/main/performers/services/graphql/src/queries.rs"
    },
    {
      "@id": "https://scap.gftd.ai/activities/scap-data-search/format-results",
      "name": "Format Results",
      "description": "Format search results with statistics and pagination",
      "wasDerivedFrom": "https://github.com/gftdcojp/ai-gftd-scap/blob/main/performers/services/graphql/src/queries.rs"
