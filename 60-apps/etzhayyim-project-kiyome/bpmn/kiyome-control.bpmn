<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- submitClearance -->
  <bpmn:process id="kiyome-submit-clearance" name="Kiyome Submit Clearance" isExecutable="true">
    <bpmn:startEvent id="start-submit-clearance"/>
    <bpmn:sequenceFlow id="sf-sc-1" sourceRef="start-submit-clearance" targetRef="task-submit-clearance"/>
    <bpmn:serviceTask id="task-submit-clearance" name="Submit Clearance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.kiyome.submitClearance"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-sc-2" sourceRef="task-submit-clearance" targetRef="end-submit-clearance"/>
    <bpmn:endEvent id="end-submit-clearance"/>
  </bpmn:process>

  <!-- listClearances -->
  <bpmn:process id="kiyome-list-clearances" name="Kiyome List Clearances" isExecutable="true">
    <bpmn:startEvent id="start-list-clearances"/>
    <bpmn:sequenceFlow id="sf-lc-1" sourceRef="start-list-clearances" targetRef="task-list-clearances"/>
    <bpmn:serviceTask id="task-list-clearances" name="List Clearances">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.kiyome.listClearances"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lc-2" sourceRef="task-list-clearances" targetRef="end-list-clearances"/>
    <bpmn:endEvent id="end-list-clearances"/>
  </bpmn:process>

  <!-- approveClearance -->
  <bpmn:process id="kiyome-approve-clearance" name="Kiyome Approve Clearance" isExecutable="true">
    <bpmn:startEvent id="start-approve-clearance"/>
    <bpmn:sequenceFlow id="sf-ac-1" sourceRef="start-approve-clearance" targetRef="task-approve-clearance"/>
    <bpmn:serviceTask id="task-approve-clearance" name="Approve Clearance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.kiyome.approveClearance"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-ac-2" sourceRef="task-approve-clearance" targetRef="end-approve-clearance"/>
    <bpmn:endEvent id="end-approve-clearance"/>
  </bpmn:process>

  <!-- rejectClearance -->
  <bpmn:process id="kiyome-reject-clearance" name="Kiyome Reject Clearance" isExecutable="true">
    <bpmn:startEvent id="start-reject-clearance"/>
    <bpmn:sequenceFlow id="sf-rc-1" sourceRef="start-reject-clearance" targetRef="task-reject-clearance"/>
    <bpmn:serviceTask id="task-reject-clearance" name="Reject Clearance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.kiyome.rejectClearance"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-rc-2" sourceRef="task-reject-clearance" targetRef="end-reject-clearance"/>
    <bpmn:endEvent id="end-reject-clearance"/>
  </bpmn:process>

  <!-- createAuditLog -->
  <bpmn:process id="kiyome-create-audit-log" name="Kiyome Create Audit Log" isExecutable="true">
    <bpmn:startEvent id="start-create-audit-log"/>
    <bpmn:sequenceFlow id="sf-cal-1" sourceRef="start-create-audit-log" targetRef="task-create-audit-log"/>
    <bpmn:serviceTask id="task-create-audit-log" name="Create Audit Log">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.kiyome.createAuditLog"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-cal-2" sourceRef="task-create-audit-log" targetRef="end-create-audit-log"/>
    <bpmn:endEvent id="end-create-audit-log"/>
  </bpmn:process>

  <!-- listAuditLogs -->
  <bpmn:process id="kiyome-list-audit-logs" name="Kiyome List Audit Logs" isExecutable="true">
    <bpmn:startEvent id="start-list-audit-logs"/>
    <bpmn:sequenceFlow id="sf-lal-1" sourceRef="start-list-audit-logs" targetRef="task-list-audit-logs"/>
    <bpmn:serviceTask id="task-list-audit-logs" name="List Audit Logs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.kiyome.listAuditLogs"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lal-2" sourceRef="task-list-audit-logs" targetRef="end-list-audit-logs"/>
    <bpmn:endEvent id="end-list-audit-logs"/>
  </bpmn:process>

  <!-- getComplianceStatus -->
  <bpmn:process id="kiyome-get-compliance-status" name="Kiyome Get Compliance Status" isExecutable="true">
    <bpmn:startEvent id="start-get-compliance-status"/>
    <bpmn:sequenceFlow id="sf-gcs-1" sourceRef="start-get-compliance-status" targetRef="task-get-compliance-status"/>
    <bpmn:serviceTask id="task-get-compliance-status" name="Get Compliance Status">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.kiyome.getComplianceStatus"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gcs-2" sourceRef="task-get-compliance-status" targetRef="end-get-compliance-status"/>
    <bpmn:endEvent id="end-get-compliance-status"/>
  </bpmn:process>

  <!-- runPurification -->
  <bpmn:process id="kiyome-run-purification" name="Kiyome Run Purification" isExecutable="true">
    <bpmn:startEvent id="start-run-purification"/>
    <bpmn:sequenceFlow id="sf-rp-1" sourceRef="start-run-purification" targetRef="task-run-purification"/>
    <bpmn:serviceTask id="task-run-purification" name="Run Purification">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.kiyome.runPurification"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-rp-2" sourceRef="task-run-purification" targetRef="end-run-purification"/>
    <bpmn:endEvent id="end-run-purification"/>
  </bpmn:process>

</bpmn:definitions>
