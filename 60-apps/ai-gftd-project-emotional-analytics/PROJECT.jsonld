{
  "@context": {
    "gftd": "https://resources.gftd.ai/ai-gftd-project-resources/id/",
    "schema": "https://schema.org/",
    "dodaf": "https://resources.gftd.ai/ai-gftd-project-resources/id/DM2/"
  },
  "@type": "gftd:Project",
  "@id": "https://resources.gftd.ai/ai-gftd-project-emotional-analytics/id/Project/ai-gftd-project-emotional-analytics",
  "schema:name": "ai-gftd-project-emotional-analytics",
  "schema:description": "Emotion signal extraction and trend analytics for conversational text. Designed as a reusable service for communicator, support, and escalation workflows.",
  "schema:url": "https://emotional-analytics.gftd.ai",
  "dodaf:capability": [
    {
      "@type": "dodaf:Capability",
      "schema:name": "Message-level Emotion Analysis",
      "schema:description": "Estimate valence/arousal/dominance and emotion labels from text content."
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Thread Trend Detection",
      "schema:description": "Compute escalation/de-escalation trends over conversation timelines."
    },
    {
      "@type": "dodaf:Capability",
      "schema:name": "Response Style Recommendation",
      "schema:description": "Suggest response tone and urgency hints for downstream communication agents."
    }
  ],
  "dodaf:performer": [
    {
      "@type": "dodaf:Performer",
      "schema:name": "emotional-analytics-component",
      "schema:description": "Text emotion scoring service exposed over gRPC/wRPC."
    }
  ]
}
