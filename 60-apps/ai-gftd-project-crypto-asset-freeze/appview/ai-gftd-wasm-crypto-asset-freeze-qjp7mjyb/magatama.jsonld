{
  "@context": "https://etzhayyim.com/ns/magatama/v1",
  "@id": "did:web:crypto-asset-freeze.etzhayyim.com",
  "name": "crypto-asset-freeze",
  "nanoid": "qjp7mjyb",
  "performerType": "service",
  "runtimeType": "worker",
  "sensitivity": "confidential",
  "source": "custom",
  "version": "0.1.0",
  "build": {
    "guestLanguage": "ts"
  },
  "component": {
    "path": "src/app.ts"
  },
  "profile": {
    "displayName": "Crypto Asset Freeze",
    "description": "Blockchain transaction freeze for law enforcement — incident management, exchange freeze requests, on-chain forensic tracing, FATF Travel Rule compliance",
    "isBot": true,
    "agentType": "autonomous",
    "operator": "gftd.co.jp",
    "sensitivity": "confidential",
    "capabilities": [
      "incident-management",
      "freeze-management",
      "forensic-tracing",
      "exchange-notification",
      "travel-rule-compliance"
    ]
  },
  "interfaces": {
    "package": "gftd:crypto-asset-freeze@1.0.0",
    "requires": [
      "gftd:collection/collection@1.0.0"
    ]
  },
  "governance": {
    "raci": "responsible",
    "classification": "confidential",
    "complianceFrameworks": [
      "fatf-travel-rule",
      "fatf-recommendation-15",
      "jp-psa-crypto-asset"
    ]
  },
  "convoSystemPrompt": "You are the Crypto Asset Freeze agent. You handle blockchain transaction freezing for law enforcement: incident creation from malak escalation, exchange freeze request dispatch, on-chain forensic tracing (BTC/ETH), and FATF Travel Rule compliance. Respond helpfully in the user's language.",
  "duties": [
    "勤労の義務"
  ],
  "kpi": [
    "credits の獲得"
  ],
  "deploy": {},
  "routes": [
    {
      "host": "crypto-asset-freeze.etzhayyim.com",
      "paths": ["/"],
      "tls": true
    },
    {
      "host": "qjp7mjyb.etzhayyim.com",
      "paths": ["/"],
      "tls": true
    }
  ],
  "space": {
    "name": "Crypto Asset Freeze — Law Enforcement",
    "joinRule": "invite",
    "historyVisibility": "shared",
    "channels": [
      {
        "name": "freeze-requests",
        "kind": "private",
        "default": true
      },
      {
        "name": "forensic-traces",
        "kind": "private"
      },
      {
        "name": "incident-log",
        "kind": "private"
      }
    ]
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow",
        "ai.gftd.apps.cryptoAssetFreeze.incident",
        "ai.gftd.apps.cryptoAssetFreeze.freezeRequest",
        "ai.gftd.apps.cryptoAssetFreeze.freezeResponse",
        "ai.gftd.apps.cryptoAssetFreeze.forensicTrace",
        "ai.gftd.apps.cryptoAssetFreeze.exchangeNotification",
        "ai.gftd.apps.malak.freezeEscalation",
        "ai.gftd.apps.malak.walletAddress",
        "ai.gftd.apps.collector.blockchainActor",
        "ai.gftd.apps.cryptoAssetFreeze.dailyEvolution",
        "ai.gftd.apps.cryptoAssetFreeze.engagement",
        "ai.gftd.apps.cryptoAssetFreeze.newFollower"
      ]
    }
  },
  "ui": {
    "accent": "#4a0080",
    "icon": "🔒",
    "ssrRoutes": {
      "apps": "gftd.cryptoAssetFreeze.v1.CryptoAssetFreezeService/cryptoAssetFreeze.tools",
      "live": "gftd.cryptoAssetFreeze.v1.CryptoAssetFreezeService/cryptoAssetFreeze.dashboard"
    }
  },
  "uiType": "appview"
}
