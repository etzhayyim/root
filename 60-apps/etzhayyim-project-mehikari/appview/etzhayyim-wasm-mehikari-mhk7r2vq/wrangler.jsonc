{
  "name": "kotodama-mhk7r2vq",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": ["nodejs_compat", "nodejs_als"],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "APP_CAPABILITIES": "[\"scene-search\",\"person-reidentification-warrant-gated\",\"evidence-export\",\"b2g-sales-outreach-opt-in\"]",
    "APP_DESCRIPTION": "Open-vocabulary scene search + warrant-gated person re-identification for Japanese police, with opt-in B2G sales pipeline.",
    "APP_DISPLAY_NAME": "眼光り (mehikari)",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "mhk7r2vq",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "appview",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message",
    "OPERATING_ENTITY": "amanomibashira",
    "VENDOR": "etzhayyim Japan株式会社",
    "AUDIT_RETENTION_YEARS": "7",
    "RAW_CLIP_RETENTION_DAYS": "90",
    "OUTREACH_BUSINESS_HOURS_JST": "09:00-17:00",
    "OUTREACH_BUSINESS_DAYS": "Mon,Tue,Wed,Thu,Fri",
    "REPLY_INBOX_DOMAIN": "reply.mehikari.etzhayyim.com"
  },
  "routes": [
    { "pattern": "mhk7r2vq.etzhayyim.com/*", "zone_name": "etzhayyim.com" },
    { "pattern": "mehikari.etzhayyim.com/*", "zone_name": "etzhayyim.com" }
  ]
}
