'maps.methods.test-maps3d-persist 'maps.methods.test-maps3d-tasks 'maps.methods.test-e2e-http 'maps.methods.test-maps3d-net-http 'maps.methods.test-search 'maps.methods.test-transit)] (when (pos? (+ (:fail r) (:error r))) (System/exit 1))))"}, :kotoba:roster-report {:kind :unknown, :doc "Ingest every discovered actor seed into the kotoba engine and print a maturity matrix", :form "(do (require 'etzhayyim.kotoba.roster) ((resolve 'etzhayyim.kotoba.roster/-main)))"}, :test:yobel {:kind :complex, :doc "yobel ヨベル Clojure test suite (langgraph-clj cells + orchestrator E2E)", :form "(do (require 'clojure.test 'yobel.cells.rite-declaration.tests.test-cell 'yobel.cells.creditor-enrollment.tests.test-cell 'yobel.cells.debtor-enrollment.tests.test-cell 'yobel.cells.release-settlement.tests.test-cell 'yobel.cells.audit-witness.tests.test-cell 'yobel.tests.test-orchestrator) (let [r (clojure.test/run-tests 'yobel.cells.rite-declaration.tests.test-cell 'yobel.cells.creditor-enrollment.tests.test-cell 'yobel.cells.debtor-enrollment.tests.test-cell 'yobel.cells.release-settlement.tests.test-cell 'yobel.cells.audit-witness.tests.test-cell 'yobel.tests.test-orchestrator)] (when (pos? (+ (:fail r) (:error r))) (System/exit 1))))"}, :sukashi:crawl {:kind :unknown, :doc "透かし sukashi — worldwide ad-supply-chain crawler (ads.txt/app-ads.txt/sellers.json/RDAP). DRY-RUN unless SUKASHI_OPERATOR_GATE=1 + Council (G7); files → data/live (gitignored)", :form "(apply shell {:dir \"orgs/etzhayyim/com-etzhayyim-sukashi\"} \"python3\" \"methods/crawl.py\" *command-line-args*)"}, :actor:rid {:kind :unknown, :doc "Print the kotoba-rad rad: URI (genesis-block CIDv1 RID) for an actor, derived from its actor-manifest.jsonld. Read-only. Args: <name>", :form "(do (require 'etzhayyim.actor-publish 'etzhayyim.kotoba-rad) (let [a (first *command-line-args*) m ((resolve 'etzhayyim.actor-publish/read-manifest) a) g ((resolve 'etzhayyim.actor-publish/manifest->genesis) a m)] (println ((resolve 'etzhayyim.kotoba-rad/rad-uri) g))))"}, :tadori:ofac {:kind :unknown, :doc "tadori 辿 OFAC SDN digital-currency-address ingest — parse a STAGED public sdn.xml (operator downloads it; G4 public SoR, G7) → attributed :sanctions risk labels (asserter ofac-sdn, non-adjudicating). Args: <staged-sdn.xml> [as-of].", :form "(do (require 'tadori.methods.ofac) (let [args *command-line-args* xml (slurp (first args)) as-of (if (second args) (parse-long (second args)) 0) r ((resolve 'tadori.methods.ofac/ofac-datoms) xml {:as-of as-of})] (println (format \"tadori.ofac: %d sanctioned-address labels (+%d skipped) from %s\" (:count r) (:skipped r) (first args)))))"}, :test:ibuki:integration {:kind :complex, :doc "ibuki integration suite (nine 60-beat lives — ~10 min under SCI)", :form "(do (require 'clojure.test 'ibuki.methods.test-integration) (let [r (clojure.test/run-tests 'ibuki.methods.test-integration)] (when (pos? (+ (:fail r) (:error r))) (System/exit 1))))"}, :adr:index-check {:kind :unknown, :doc "Drift gate: regenerate the ADR index in-memory and FAIL if 90-docs/adr/adr-index.edn is stale or hand-edited (then run `bb adr:index` and commit). Catches the prose-as-map-literal corruption class. Wired into lefthook pre-commit (adr-index-freshness).", :form "(do (require 'etzhayyim.tools.adr-mdedn) (apply (resolve 'etzhayyim.tools.adr-mdedn/-main) \"index-check\" *command-line-args*))"}}
