{;; babashka project file — the Clojure-side runner for actor code ported off
 ;; Python/TS onto the kotoba Datom-log + langgraph-clj/langchain-clj stack.
 ;; (`deps.edn` at this root is the platform registry SSoT, NOT a tools.deps file.)
 ;;
 ;; Source roots:
 ;;   20-actors                            — actor namespaces (mimamori.*, yobel.*, …)
 ;;   20-actors/kotodama/src               — kotoba.datom (Datom-log commit-DAG binding)
 ;;   50-infra/etzhayyim-moyai-credit/src  — moyai.ledger (reciprocity-credit primitive)
 :paths ["20-actors"
         "20-actors/kotodama/src"
         "50-infra/etzhayyim-moyai-credit/src"
         "70-tools/src"
         "70-tools"]
 :deps {com-junkawasaki/langchain-clj
        {:git/url "https://github.com/com-junkawasaki/langchain-clj"
         :git/sha "2b03859c3ee722b64f3eddd0b615a54019b17c81"}
        com-junkawasaki/langgraph-clj
        {:git/url "https://github.com/com-junkawasaki/langgraph-clj"
         :git/sha "c7daa07d4e50f55d7e2a02e4b89dbeb2b200961d"}}
 :tasks
 {lint:kotoba-boundary
  {:doc "Enforce the root↔subrepo data boundary: NO religious-corp data artifacts (*.kotoba.edn / *-datoms / *-graph) inside the kotoba subrepo (ADR-2605262130; data lives in root 00-contracts/80-data)"
   :task (do (require 'etzhayyim.kotoba.boundary)
             (apply (resolve 'etzhayyim.kotoba.boundary/-main) *command-line-args*))}

  kotoba:ingest
  {:doc "Ingest an actor seed into the kotoba Datom log (validated, snapshotted). Args: <schema> <seed> [out] [--validate]"
   :task (do (require 'etzhayyim.kotoba.ingest)
             (apply (resolve 'etzhayyim.kotoba.ingest/-main) *command-line-args*))}

  kotoba:roster-report
  {:doc "Ingest every discovered actor seed into the kotoba engine and print a maturity matrix (entities/datoms/conformance/CID)"
   :task (do (require 'etzhayyim.kotoba.roster)
             ((resolve 'etzhayyim.kotoba.roster/-main)))}

  vitals:report
  {:doc "Per-actor LIFE-ACTIVITY vitals — scores each manifest-bearing cell on 3 axes (clj 内部代謝 / actor 細胞間シグナル / atproto 外界代謝), RUNS its run_tests.sh reflex, classifies 生/休眠/死, and transacts the vitals into the kotoba Datom log (as-of trajectory). Flags: --no-tests --limit N --actors a,b --timeout-ms N"
   :task (do (require 'etzhayyim.vitals)
             (apply (resolve 'etzhayyim.vitals/-main) *command-line-args*))}

  vitals:trajectory
  {:doc "Read the kotoba Datom log of past vitals runs and show the organism's EVOLUTION (生命進化): per-run 生/休眠/死 cohort distribution + Σscore Δ over time, plus per-actor class/score transitions (休眠→生 等) between the last two runs."
   :task (do (require 'etzhayyim.vitals)
             ((resolve 'etzhayyim.vitals/-trajectory)))}

  vitals:pulse
  {:doc "Emit pulse.json — the organism's LIVE activity feed the /organism page polls for realtime animation: per-actor git commit production (生産), working-tree edits in flight (息遣い), Datom-log head (呼吸). Cheap (no test runs); run on a short loop. Args: [hours=48]"
   :task (do (require 'etzhayyim.vitals)
             (apply (resolve 'etzhayyim.vitals/-pulse) *command-line-args*))}

  vitals:joucho
  {:doc "Emit joucho.json — the organism's 情緒 (mood) + Wellbecoming TRAJECTORY (ADR-2606171500): replays ibuki's representative life (incl. the charter-clean :event/dialogue-reciprocated reward) into a 5-axis mood trajectory + Wellbecoming movement (improving/declining/steady, never a score) for the /organism 情緒 layer. Args: [of=ibuki] [beats=24]"
   :task (do (require 'etzhayyim.vitals)
             (apply (resolve 'etzhayyim.vitals/-joucho) *command-line-args*))}

