{;; babashka project file — the Clojure-side runner for actor code ported off
 ;; Python/TS onto the kotoba Datom-log + langgraph-clj/langchain-clj stack.
 ;; (`deps.edn` at this root is the platform registry SSoT, NOT a tools.deps file.)
 ;;
 ;; Source roots:
 ;;   20-actors                            — actor namespaces (mimamori.*, yobel.*, …)
 ;;   20-actors/kotodama/src               — kotoba.datom (Datom-log commit-DAG binding)
 ;;   50-infra/etzhayyim-moyai-credit/src  — moyai.ledger (reciprocity-credit primitive)
 :paths ["20-actors"
         "20-actors/kotodama/src"
         "50-infra/etzhayyim-moyai-credit/src"
         "70-tools/src"
         "70-tools"]
 :deps {com-junkawasaki/langchain-clj
        {:git/url "https://github.com/com-junkawasaki/langchain-clj"
         :git/sha "2b03859c3ee722b64f3eddd0b615a54019b17c81"}
        com-junkawasaki/langgraph-clj
        {:git/url "https://github.com/com-junkawasaki/langgraph-clj"
         :git/sha "c7daa07d4e50f55d7e2a02e4b89dbeb2b200961d"}
        com-junkawasaki/ed25519-clj
        {:git/url "https://github.com/com-junkawasaki/ed25519-clj"
         :git/sha "ec077bca1f90027bc718557f1e8bb6fbc004fe5a"}
        com-junkawasaki/multiformats-clj
        {:git/url "https://github.com/com-junkawasaki/multiformats-clj"
         :git/sha "e3a75a6376441cbf7aaefefce463b404b4254404"}
        com-junkawasaki/dag-cbor-clj
        {:git/url "https://github.com/com-junkawasaki/dag-cbor-clj"
         :git/sha "52b008d96820660196ee8dd15e7d213c9022a6b5"}
        com-junkawasaki/cacao-clj
        {:git/url "https://github.com/com-junkawasaki/cacao-clj"
         :git/sha "32fe0b63a815afc0827729394435deee627ea582"}}
 :tasks
 {e7m
  {:doc "etzhayyim CLI (babashka port; capstone of the etzhayyim-py→bb migration, ADR-2606222000). `bb e7m list` shows every ported command module; `bb e7m <cmd> [args]` dispatches commands that expose a -main (murakumo, vitals); other commands are ported as libraries (ns etzhayyim.<cmd>) pending argv-wiring."
   :task (do (require 'etzhayyim.cli)
             (apply (resolve 'etzhayyim.cli/-main) *command-line-args*))}

  issue-cacao
  {:doc "MEMBER-side CACAO leash issuer (clj port of 20-actors/ibuki/tools/issue_delegation.py, repo-rule clj/bb). Mints a scoped/expiring/revocable CAIP-122 SIWE CACAO (capability=datom:transact, aud=node operator DID, resources=[kotoba://can/datom:transact, kotoba://graph/<cid>]) Ed25519-signed with the member's OWN key → cacao_b64 sidecar the autonomous actor (ibuki/kaname/tsubasa) PRESENTS (present-only, never signs; no-server-key). Args: --node-did <did> --exp <ISO-8601> --out <path> [--graph <name>] [--nonce <s>] [--iat <ISO>] (--gen-key | --member-priv-b64 <b64> --member-pub-hex <hex>)"
   :task (do (require 'etzhayyim.issue-cacao)
             (apply (resolve 'etzhayyim.issue-cacao/-main) *command-line-args*))}

  kotobase:pin
  {:doc "Register a CID with kotobase.net's IPFS Pinning Service via a self-sovereign kotobase:pin CACAO (clj; replaces the throwaway node script, ADR-2606111330). Reads the tenant seed from env KOTOBA_SEED_HEX (your own vault), mints the CACAO in-process (no-server-key), POSTs /pins. Args: <cid> [name] [--endpoint <url>]"
   :task (do (require 'etzhayyim.kotobase-pin)
             (apply (resolve 'etzhayyim.kotobase-pin/-main) *command-line-args*))}

  gen:tier-b-actors
  {:doc "Regenerate 50-infra/etzhayyim-did-web/src/registry/tier-b-actors.gen.ts from each 20-actors/<a>/manifest.{jsonld,edn} (Tier-B, non-hand-authored). clj/bb port of the legacy gen-tier-b-actors.mjs; manifest.jsonld preferred, manifest.edn (Gen-3 kotoba-native) fallback. ADR-2606042330."
   :task (do (require 'etzhayyim.gen-tier-b-actors)
             (apply (resolve 'etzhayyim.gen-tier-b-actors/-main) *command-line-args*))}

  actor:publish
  {:doc "ADR-2606231200 — publish a 20-actors/<name> actor as a sovereign unit: josh/subtree split → gh repo com-etzhayyim-<name> → did:web did.json → kotoba-rad RID/did:key (sovereign identity on the kotoba Datom log) → aozora(yoro) PDS profile-write plan. DRY-RUN by default; --apply executes side effects; --pubkey=<hex> pins the Ed25519 key. no-server-key (signing/PDS-write are member/operator legs). Args: <name> [<name>...] [--apply] [--pubkey=hex]"
   :task (do (require 'etzhayyim.actor-publish)
             (apply (resolve 'etzhayyim.actor-publish/-main) *command-line-args*))}

  actor:rid
  {:doc "Print the kotoba-rad rad: URI (genesis-block CIDv1 RID) for an actor, derived from its actor-manifest.jsonld. Read-only. Args: <name>"
   :task (do (require 'etzhayyim.actor-publish 'etzhayyim.kotoba-rad)
             (let [a (first *command-line-args*)
                   m ((resolve 'etzhayyim.actor-publish/read-manifest) a)
                   g ((resolve 'etzhayyim.actor-publish/manifest->genesis) a m)]
               (println ((resolve 'etzhayyim.kotoba-rad/rad-uri) g))))}

  actor:keygen
  {:doc "Generate an Ed25519 member key for an actor (kotoba-rad sovereign signing). Prints pub-hex + did:key. DRY-RUN prints the priv (not stored); --apply stores it in macOS Keychain (service etzhayyim.kotoba-rad). no-server-key: this is the MEMBER key. Args: <name> [--apply]"
   :task (do (require 'etzhayyim.kotoba-rad-sign)
             (apply (resolve 'etzhayyim.kotoba-rad-sign/-keygen) *command-line-args*))}

  actor:mesh
  {:doc "ADR-2606230001 — kotoba mesh pipeline: discover cljc cells, static-analyse for compile blockers, generate kotoba.app.edn. Args: <actor-name> [--trigger on-http|on-kse|on-tick] [--dry-run] | --survey"
   :task (do (require 'etzhayyim.actor-mesh)
             (apply (resolve 'etzhayyim.actor-mesh/-main) *command-line-args*))}

  actor:evolve
  {:doc "ADR-2606241500/2606242400 — evolve an actor's CODE (20-actors/<name>) AND DATA (80-data/<name> + its kotoba-rad identity journal) through git: encrypt-secrets (sops+age) → branch → record signed :rad/evolution → [--pages: publish the identity log as a CID-queryable CARv1 tier at 20-actors/<name>/data/] → commit → push → PR → merge. DRY-RUN by default; --apply mutates locally; --push/--pr/--merge gate the outward legs (member gh+git creds, no-server-key). Args: <name> [--message=<m>] [--apply] [--pages] [--push] [--pr] [--merge] [--pubkey=<hex>]"
   :task (do (require 'etzhayyim.actor-evolve)
             (apply (resolve 'etzhayyim.actor-evolve/-main) *command-line-args*))}

  pages:publish
  {:doc "ADR-2606242400 — pack a kotoba Datom journal into a STATIC GitHub-Pages CAR tier: <dir>/<graph>.car + .car.idx.edn + head.json + .nojekyll. Commit the dir → GitHub Pages serves it; clients query by root CID over HTTPS Range (no IPFS daemon). Args: <graph> <journal.edn> [out-dir]"
   :task (do (require 'etzhayyim.kotoba.pages-store)
             (apply (resolve 'etzhayyim.kotoba.pages-store/-publish) *command-line-args*))}

  pages:query
  {:doc "ADR-2606242400 — reconstruct + CID-verify a published graph by its root CID. Default reads a local published dir; --http treats the arg as a base URL (…/<graph>) and uses HTTP Range against GitHub Pages. Args: <dir-or-base> [--http]"
   :task (do (require 'etzhayyim.kotoba.pages-store)
             (apply (resolve 'etzhayyim.kotoba.pages-store/-query) *command-line-args*))}

  pages:deploy
  {:doc "ADR-2606242400 — deploy a published Pages dir to a REAL GitHub repo + enable Pages (creates repo, pushes, enables Pages from gh-pages root; member gh creds, no-server-key). --verify polls the live URL and reconstructs the graph over HTTPS Range. Args: <dir> <owner/repo> <graph> [--verify]"
   :task (do (require 'etzhayyim.kotoba.pages-store)
             (apply (resolve 'etzhayyim.kotoba.pages-store/-deploy) *command-line-args*))}

  test:pages-store
  {:doc "ADR-2606242400 CARv1 + prolly-tree + GitHubPagesBlockStore invariants: varint, CID framing, CAR roots/index slices, tamper detection, flat publish→Range→verify→reassemble round-trip, prolly multi-level/determinism/seek-locality/path-copy. Hermetic (no network)."
   :task (do (require 'etzhayyim.kotoba.test-pages-store)
             (apply (resolve 'etzhayyim.kotoba.test-pages-store/-main) *command-line-args*))}

  sops:keygen
  {:doc "ADR-2606241500 — generate an age identity for an actor (or __org__ for the org-wide recovery key), print the recipient. DRY-RUN prints the secret; --apply stores it in macOS Keychain (service etzhayyim.sops-age, MEMBER key, no-server-key). Args: <actor|__org__> [--apply]"
   :task (do (require 'etzhayyim.sops-age)
             (apply (resolve 'etzhayyim.sops-age/-keygen) *command-line-args*))}

  sops:yaml
  {:doc "Regenerate .sops.yaml from the per-actor :rad/age-recipient on each kotoba-rad identity journal (the SoT). Read-only over Keychain (recipients are public). No args."
   :task (do (require 'etzhayyim.sops-age)
             (apply (resolve 'etzhayyim.sops-age/-yaml) *command-line-args*))}

  sops:encrypt
  {:doc "sops-encrypt a plaintext secret to its .enc.* sibling for an actor's recipients (actor key + org recovery). Args: <actor> <in> [out]"
   :task (do (require 'etzhayyim.sops-age)
             (apply (resolve 'etzhayyim.sops-age/-encrypt) *command-line-args*))}

  sops:decrypt
  {:doc "sops-decrypt a .enc.* file using the actor's Keychain age key; prints plaintext to stdout. Args: <actor> <file.enc.*>"
   :task (do (require 'etzhayyim.sops-age)
             (apply (resolve 'etzhayyim.sops-age/-decrypt) *command-line-args*))}

  test:sops-age
  {:doc "ADR-2606241500 secrets-layer invariants: age recipient derivation, enc-path mapping, :rad/age-recipient bound to the RID (idempotent), .sops.yaml render, and the sops encrypt→redaction→decrypt round-trip (wrong key refused). Hermetic (no Keychain)."
   :task (do (require 'etzhayyim.test-sops-age)
             (apply (resolve 'etzhayyim.test-sops-age/-main) *command-line-args*))}

  actor:delegate-add
  {:doc "ADR-2606251200 A-2 — register a member did:key as a :rad/delegate of an EXISTING actor identity, RID-stable (append-only, genesis untouched). Operationalizes sovereign git push for the delegate-less pilot journals. --keygen mints a fresh member key (--apply stores priv in Keychain) or --pubkey=<hex> adds a held one; DRY-RUN by default. no-server-key (member-signed sigref via Keychain). Args: <name> (--keygen | --pubkey=hex) [--apply]"
   :task (do (require 'etzhayyim.kotoba-rad-sign)
             (apply (resolve 'etzhayyim.kotoba-rad-sign/-delegate-add) *command-line-args*))}

  test:kotoba-rad
  {:doc "kotoba-rad sovereign-identity invariants (ADR-2606231200): did:key convention, RID content-addressing, did.json 3-identity cross-link, append-only/idempotent publish, Ed25519 sign/verify + CID base32 parity."
   :task (do (require 'etzhayyim.test-kotoba-rad)
             (apply (resolve 'etzhayyim.test-kotoba-rad/-main) *command-line-args*))}

  test:helpers
  {:doc "Aggregate of all 70-tools pure-helper test namespaces (/loop coverage 成熟度向上 — 40 modules): authz · agent-token · bonsai · code-quality · deps · bunseki · cohort · apps · authn · auth · database · agent-runtime · complex-stubs · actor-mesh · agent-cmd · actors-helpers · dodaf · coverage · identifier-audit · haisen · hinshitsu · dns-sync · deploy · metrics · shannon · shannon-scores · systemofsystem · vertex · source-graph · xrpc · mokuteki · projector · actor-publish · yoroshiku · mitama · training · murakumo-cmd · monitor · nono · workspace."
   :requires ([clojure.test :as t]
              [etzhayyim.test-authz] [etzhayyim.test-agent-token] [etzhayyim.test-bonsai]
              [etzhayyim.test-code-quality] [etzhayyim.test-deps] [etzhayyim.test-bunseki]
              [etzhayyim.test-cohort] [etzhayyim.test-apps] [etzhayyim.test-authn]
              [etzhayyim.test-auth] [etzhayyim.test-database] [etzhayyim.test-agent-runtime]
              [etzhayyim.test-complex-stubs] [etzhayyim.test-actor-mesh] [etzhayyim.test-agent-cmd]
              [etzhayyim.test-actors-helpers] [etzhayyim.test-dodaf] [etzhayyim.test-coverage]
              [etzhayyim.test-identifier-audit] [etzhayyim.test-haisen] [etzhayyim.test-hinshitsu]
              [etzhayyim.test-dns-sync] [etzhayyim.test-deploy] [etzhayyim.test-metrics]
              [etzhayyim.test-shannon] [etzhayyim.test-shannon-scores]
              [etzhayyim.test-systemofsystem] [etzhayyim.test-vertex]
              [etzhayyim.test-source-graph] [etzhayyim.test-xrpc] [etzhayyim.test-mokuteki] [etzhayyim.test-projector] [etzhayyim.test-actor-publish] [etzhayyim.test-yoroshiku] [etzhayyim.test-mitama] [etzhayyim.test-training] [etzhayyim.test-murakumo-cmd] [etzhayyim.test-monitor] [etzhayyim.test-nono] [etzhayyim.test-workspace] [etzhayyim.test-tithe] [etzhayyim.lint.test-no-new-ts] [etzhayyim.app-sdk.test-record] [etzhayyim.app-sdk.test-xrpc] [etzhayyim.app-sdk.test-ids])
   :task (let [{:keys [fail error]}
               (apply t/run-tests
                      '[etzhayyim.test-authz etzhayyim.test-agent-token etzhayyim.test-bonsai
                        etzhayyim.test-code-quality etzhayyim.test-deps etzhayyim.test-bunseki
                        etzhayyim.test-cohort etzhayyim.test-apps etzhayyim.test-authn
                        etzhayyim.test-auth etzhayyim.test-database etzhayyim.test-agent-runtime
                        etzhayyim.test-complex-stubs etzhayyim.test-actor-mesh etzhayyim.test-agent-cmd
                        etzhayyim.test-actors-helpers etzhayyim.test-dodaf etzhayyim.test-coverage
                        etzhayyim.test-identifier-audit etzhayyim.test-haisen etzhayyim.test-hinshitsu
                        etzhayyim.test-dns-sync etzhayyim.test-deploy etzhayyim.test-metrics
                        etzhayyim.test-shannon etzhayyim.test-shannon-scores
                        etzhayyim.test-systemofsystem etzhayyim.test-vertex
                        etzhayyim.test-source-graph etzhayyim.test-xrpc etzhayyim.test-mokuteki etzhayyim.test-projector etzhayyim.test-actor-publish etzhayyim.test-yoroshiku etzhayyim.test-mitama etzhayyim.test-training etzhayyim.test-murakumo-cmd etzhayyim.test-monitor etzhayyim.test-nono etzhayyim.test-workspace etzhayyim.test-tithe etzhayyim.lint.test-no-new-ts etzhayyim.app-sdk.test-record etzhayyim.app-sdk.test-xrpc etzhayyim.app-sdk.test-ids])]
           (System/exit (if (pos? (+ fail error)) 1 0)))}

  vitals:report
  {:doc "Per-actor LIFE-ACTIVITY vitals — scores each manifest-bearing cell on 3 axes (clj 内部代謝 / actor 細胞間シグナル / atproto 外界代謝), RUNS its run_tests.sh reflex, classifies 生/休眠/死, and transacts the vitals into the kotoba Datom log (as-of trajectory). Flags: --no-tests --limit N --actors a,b --timeout-ms N"
   :task (do (require 'etzhayyim.vitals)
             (apply (resolve 'etzhayyim.vitals/-main) *command-line-args*))}

  vitals:trajectory
  {:doc "Read the kotoba Datom log of past vitals runs and show the organism's EVOLUTION (生命進化): per-run 生/休眠/死 cohort distribution + Σscore Δ over time, plus per-actor class/score transitions (休眠→生 等) between the last two runs."
   :task (do (require 'etzhayyim.vitals)
             ((resolve 'etzhayyim.vitals/-trajectory)))}

  vitals:pulse
  {:doc "Emit pulse.json — the organism's LIVE activity feed the /organism page polls for realtime animation: per-actor git commit production (生産), working-tree edits in flight (息遣い), Datom-log head (呼吸). Cheap (no test runs); run on a short loop. Args: [hours=48]"
   :task (do (require 'etzhayyim.vitals)
             (apply (resolve 'etzhayyim.vitals/-pulse) *command-line-args*))}

  vitals:joucho
  {:doc "Emit joucho.json — the organism's 情緒 (mood) + Wellbecoming TRAJECTORY (ADR-2606171500): replays ibuki's representative life (incl. the charter-clean :event/dialogue-reciprocated reward) into a 5-axis mood trajectory + Wellbecoming movement (improving/declining/steady, never a score) for the /organism 情緒 layer. Args: [of=ibuki] [beats=24]"
   :task (do (require 'etzhayyim.vitals)
             (apply (resolve 'etzhayyim.vitals/-joucho) *command-line-args*))}

  organism:narrate
  {:doc "One 情緒 narration beat — a living first-person line the organism SPEAKS about how it feels now, via REAL inference on the Murakumo Mac-mini fleet (gemma4:e4b-it-qat) over Tailscale (Murakumo = default-preferred per Rider v3.3 §2(i) / ADR-2606172359; think:false; no-server-key). APPENDED as :narration/* Datoms (as-of evolution) + snapshot narration.kotoba.edn + narration.json projection. Fail-open template if the fleet is unreachable. Args: [of=ibuki]"
   :task (do (require 'etzhayyim.organism)
             (apply (resolve 'etzhayyim.organism/-narrate) *command-line-args*))}

  organism:heartbeat
  {:doc "The RESIDENT organism loop (clj/bb, replaces the removed heartbeat.sh): 脈 pulse 6s · 情緒 joucho+narrate 60s · vitals report 600s, each a fold on its own append-only kotoba journal, crash-isolated per layer. Made reboot-resident by the launchd LaunchAgent in 50-infra/launchd/. Flags: --once (one beat of every layer, then exit)"
   :task (do (require 'etzhayyim.organism)
             (apply (resolve 'etzhayyim.organism/-heartbeat) *command-line-args*))}

  organism:watchdog
  {:doc "EXTERNAL supervisor (immune kaizen): one supervision pass — reads health.json freshness from OUTSIDE the loop and force-restarts the organism (launchctl kickstart -k) if the loop has wedged (process alive but silent >120s, which launchd KeepAlive cannot see), and probes the substrate (kotoba :8077 / IPFS / served page) into watchdog.json. Run every 60s by the launchd agent com.etzhayyim.organism.watchdog."
   :task (do (require 'etzhayyim.watchdog)
             (apply (resolve 'etzhayyim.watchdog/-check) *command-line-args*))}

  fleet:probe
  {:doc "RESIDENCE PROBE (ADR-2606271400) — does the murakumo heartbeat fleet ACTUALLY run, or is it only DEFINED in cells.edn? Reads cells.edn/fleet.edn, maps tailscale online state, and (over `ssh <node>`) checks each node's launchctl + pgrep + loopback healthz (the healthz server binds 127.0.0.1 only, so residence is observable only ON the node). Classifies every cron/lan-api heartbeat :alive / :defined-only-silent / :node-unreachable, probes the evo-x2 inference backend + issachar kotoba :8077, writes out/fleet-probe.edn + a human summary. Shells out to ssh/tailscale/curl (system binaries); logic is clj. Flags: --nodes a,b | --no-ssh"
   :task (do (require 'etzhayyim.fleet-probe)
             (apply (resolve 'etzhayyim.fleet-probe/-main) *command-line-args*))}

  fleet:deploy
  {:doc "Render + install the resident LaunchAgents that make the self-evolution loop ACTUALLY run (ADR-2606271400 D4/D5). Renders the post-drain agent (`bb drain` on an interval, presenting a member leash so ibuki's prepared posts flow to the etzhayyim PDS attributed to the consenting member — leashed-autonomous posting, no held key). `--render` (default, pure) prints the plist; `--install-local`/`--uninstall-local` act on ~/Library/LaunchAgents on THIS machine via launchctl. The leash is read from the member-provided env at run time (PDS_DRAIN_LEASH), never embedded."
   :task (do (require 'etzhayyim.fleet-deploy)
             (apply (resolve 'etzhayyim.fleet-deploy/-main) *command-line-args*))}

  ieflow:report
  {:doc "Emit ieflow.json — the organism's information-energy FLOW layer (ADR-2606211200): folds the committed flow ledger (80-data/ie-flow/<source>/flow.kotoba.edn) through etzhayyim.ie-flow.{ledger,metrics} into net-gain / order-index (負エントロピー輸出) / agent-efficiency / throughput + the Sankey edges & stations the /organism page renders. Pure read, no network I/O, no held key. Args: [flow-log-path]"
   :task (do (require 'etzhayyim.ie-flow.organism)
             (apply (resolve 'etzhayyim.ie-flow.organism/-report) *command-line-args*))}

  ieflow:sos
  {:doc "Emit sos.json — the actor SYSTEM-OF-SYSTEMS graph (ADR-2606211200): from 80-data/ie-flow/registry.edn + per-actor flow measurement, builds the node-link graph of the shared unforkable substrate (kotoba ledger / react-loop / co-scientist), the measured sources feeding it, the adopters embedding it, and kaname synthesizing across the multiplex. The /organism page renders it as a radial graph. Pure read, no held key."
   :task (do (require 'etzhayyim.ie-flow.organism)
             (apply (resolve 'etzhayyim.ie-flow.organism/-sos) *command-line-args*))}

  ieflow:lab
  {:doc "Emit lab.kotoba.edn — a flat [e a v tx op] Datom snapshot the /organism lab queries client-side (ADR-2606211200/2606212200): per-actor bounded systems (boundary + indices + REWARD 報酬系 + system-dynamics) + colony ABM. Params are datomic-queryable; the page re-simulates live as sliders move them. Pure read, no held key. Args: [flow-log-path]"
   :task (do (require 'etzhayyim.ie-flow.organism)
             (apply (resolve 'etzhayyim.ie-flow.organism/-lab) *command-line-args*))}

  ieflow:coverage
  {:doc "ENFORCE the rule (ADR-2606212200): every actor must hold a system-of-systems reward spec. Validates each per-actor spec in 80-data/ie-flow/system-of-systems.edn against the non-negotiable gate invariants (reward/validate-spec) + reports coverage over the 20-actors roster + a worklist. Exits non-zero on any INVALID (weakened-gate) spec."
   :task (do (require 'etzhayyim.ie-flow.organism)
             (apply (resolve 'etzhayyim.ie-flow.organism/-coverage) *command-line-args*))}

  ieflow:maturity
  {:doc "Regenerate 80-data/ie-flow/MATURITY.md — the SoS-reward maturity scorecard (ADR-2606212200): components present, coverage over the roster, per-actor reward + co-scientist score-react Δ + winning mechanism. Deterministic, pure read."
   :task (do (require 'etzhayyim.ie-flow.organism)
             (apply (resolve 'etzhayyim.ie-flow.organism/-maturity) *command-line-args*))}

  ieflow:maxwell
  {:doc "Write 80-data/ie-flow/maxwell-signals.edn — the reward-weighted PREFERENCE signals for Maxwell's learning loop (ADR-2606212200 + 2606061000): per bounded actor, a co-scientist score-react packaged as an aligned-only preference (higher reward ⇒ stronger preference). Emits the SIGNAL only; the trainer is a separate G7-gated step. Deterministic, no held key."
   :task (do (require 'etzhayyim.ie-flow.organism)
