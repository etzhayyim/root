[submodule "90-docs/baien/datasets"]
	# DataLad superdataset (ADR-2605241500). Local-only; per-machine
	# operators run `datalad clone` against an annex-bearing remote (TBD —
	# Phase 2 will publish a public read-only sibling). The gitlink in
	# the parent records the superdataset's HEAD commit for reproducibility.
	#
	# `ignore = dirty` suppresses noisy git-annex symlink-loop warnings
	# during `git status` traversal of nested DataLad subdatasets (their
	# .git/annex/objects/ trees contain symlinks that exceed MAXSYMLINKS
	# during walks but resolve fine at access time). The submodule's
	# HEAD-commit pointer is still tracked normally; only working-tree
	# dirtiness reports are skipped.
	path = 90-docs/baien/datasets
	url = ./90-docs/baien/datasets
	ignore = dirty
[submodule "60-apps/spirit-in-physics"]
	# Spirit-in-Physics measurement instrument + research SSoT (ADR-2606011500).
	# Private upstream (com-junkawasaki/spirit-in-physics), same author. Vendored
	# as the 霊性 measurement model; canonical religious-corp home is the kotoba
	# Datom log (00-contracts/schemas/spirit-ontology.kotoba.edn), NOT its D1.
	# NO git-lfs: clone pointer-only (GIT_LFS_SKIP_SMUDGE=1); upstream LFS blobs are
	# never fetched here. Large/binary spirit assets (paper PDFs, assay corpora) live
	# in the DataLad dataset 80-data/spirit-in-physics (git-annex → IPFS, ADR-2605241500),
	# NOT in LFS. `ignore = dirty` suppresses LFS-smudge status noise on traversal.
	path = 60-apps/spirit-in-physics
	url = https://github.com/com-junkawasaki/spirit-in-physics.git
	branch = main
	ignore = dirty
[submodule "80-data/spirit-in-physics"]
	# DataLad (git-annex → IPFS) home for Spirit-in-Physics large/binary assets.
	# Replaces git-lfs per founder direction 2026-06-01 + ADR-2605241500/2606011500.
	# Local-only (per-machine) like 90-docs/baien/datasets; pointer records HEAD for
	# reproducibility; `ignore = dirty` suppresses git-annex symlink-walk warnings.
	path = 80-data/spirit-in-physics
	url = ./80-data/spirit-in-physics
	ignore = dirty
[submodule "50-infra/etzhayyim-paymaster/lib/forge-std"]
	path = 50-infra/etzhayyim-paymaster/lib/forge-std
