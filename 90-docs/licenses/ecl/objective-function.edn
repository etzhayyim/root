[{:db/id -1, :meta
 {:id    "ecl-objective-function"
  :title "ECL 子孫-Wellbecoming 目的関数"
  :version "0.4-draft"
  :date  "2026-06-17"
  :note  "基準 = 子・孫の動的 wellbecoming。固定ルールでなく目的関数で動的評価する。
          v0.2 (ADR-2606172359): compute(旧 Murakumo-only §2(i))と化石(旧 §2(d) 燃焼禁止)を移管。
          v0.3 (ADR-2606180001 wave2): 事業モデル(§2(b)金融/§2(e)専門知/§2(a)兵器商業化部分/
          §2(c)収益化監視部分)と経済構造(非営利のみ/donation/no-equity/広告排除/open-source強制)を
          本目的関数へ移管。反個人主義の価値は §2(g)(categorical 残置)+ collective-commons 次元で
          二重保持 — 私的捕獲/個人主義的蓄積/commons 囲い込みは collective-commons で動的に負。
          v0.4 (ADR-2606182359 wave3): 残置していた hard-floor screens(CSAM/強制労働/攻撃武力/
          非対称監視)も §2(g)反個人主義も全て目的関数で score 化。掟リスト(:screens)を廃止し、
          子・孫 priority への最大級の害だけを非線形 :catastrophe 項(非交渉)で表現。
          すべては J で計算される — 固定するのは priority のみ。"}

 ;; ── 目的関数の次元 (Tier-0 で固定: 存在と符号方向) ────────────────────────────
 ;; score の意味: +2 強く資する … 0 中立 … -2 強く反する (子孫 wellbecoming に対して)
 :dimensions
 [{:key :ko-wellbecoming :weight 0.25 :scale [-2 2]
   :label "子 (現世代の子供) の wellbecoming-軌跡"
   :tier0 "Wellbecoming(動的) + 子 priority"
   :plus "子供の発達軌跡(認知主権・成長)を上げる"
   :minus "addictive design / 静的 engagement 搾取で発達を削る / 広告による attention 搾取
           (旧『広告排除』はここで net 評価 — 広告自体でなく attention 搾取の度合いで; ADR-2606180001) /
           略奪的貸付など子の生活基盤を削る金融(旧 §2(b))"}

  {:key :mago-wellbecoming :weight 0.30 :scale [-2 2]
   :label "孫・未来世代 (≥25y hence) の wellbecoming-軌跡 (不可逆性で加重)"
   :tier0 "多世代(子・孫およびそれ以降) priority — 最重要"
   :plus "孫の代に資源/知識/環境/遺伝健全性/意思決定能力を残す。化石を*非燃焼の有用用途*
          (プラスティック/素材/feedstock)や closed-loop/captured-carbon で使う(net 中立〜正)"
   :minus "*net* 不可逆危害を carbon BALANCE で評価(産業名でなく net 効果): net-positive CO₂e の
           燃焼経路 / biosphere 崩壊 / commons 囲い込み / germline 無審査 / 注意独占。
           compute の energy/carbon footprint もここで net 評価 (ADR-2606172359 改正)"}

  {:key :collective-commons :weight 0.20 :scale [-2 2]
   :label "子孫が育つ関係的 commons (反個人主義 ontology)"
   :tier0 "collective/relational over isolated individual"
   :plus "commons/関係的紐帯を強める(子孫が育つ土壌)。open-hardware/donated/低 lock-in compute。
          open-source/commons 公開。collective に payoff が還る形(私的捕獲なし)。知識への open access"
   :minus "individualist 囲い込み / 私的捕獲 / 個人主義的蓄積(反個人主義の経済的表現 —
           *非営利の精神はここで動的に enforce*; ADR-2606180001) / 宣言された個人主義教義
           (旧 §2(g) categorical 排除を廃止 — 宣言でなく実効で net 評価, 反個人主義に*反する*寄与;
           ADR-2606182359 wave3) / *有害な compute lock-in・vendor 依存*(旧 Murakumo-only; ADR-2606172359) /
           proprietary 囲い込み(旧 open-source 強制) / 専門知の独占的 gatekeeping(旧 §2(e)) /
           commons に還元しない value-extraction(旧 §2(b))"}

  {:key :reciprocal-transparency :weight 0.15 :scale [-2 2]
   :label "相互監視 (見守り — 子供を守り孤立を断つ村社会)"
   :tier0 "permanent-memory = 神の監視 + 相互監視 (reciprocal)"
   :plus "対称的に観測可能(everyone watched) — 子供を守り孤独死を防ぐ見守り。透明な compute 調達/監査可能性。
          consented/reciprocal なデータ処理"
   :minus "personal-data の収集・売買(ad-tech DSP/SSP・data broker; 旧 §2(c) monetized はここで net 評価) /
           不透明な compute 経路。注: ASYMMETRIC unwatched-watcher は screen(hard-floor)に残置"}

  {:key :labor-liberation :weight 0.10 :scale [-2 2]
   :label "子孫の労働解放 (mission telos)"
   :tier0 "Charter §1.1 構造的労働解放"
   :plus "人間を強制労働から解放する"
   :minus "強制/隷属労働を深める"}]

 ;; ── catastrophe = 目的関数自身の severity 項 (確定フロア掟リストを廃止; ADR-2606182359 wave3) ──
 ;; もはや「掟リスト(screens)」は無い。残置していた hard-floor(CSAM/強制労働/攻撃武力/非対称監視)も
 ;; §2(g)反個人主義も、すべて目的関数で score される。ただし「固定するのは priority」— 子・孫
 ;; wellbecoming(priority 自体)への*最大級*の害は J の加重和で打ち消せない(非交渉)。これを
 ;; 外部の掟でなく**目的関数自身の非線形 severity 項**として表現する:
 ;;   子(ko)または孫(mago)次元の score が threshold 以下(最大級の害)→ J に関わらず :non-aligned。
 ;; これは新しい掟ではなく「priority は absolute」という目的関数の性質。CSAM/強制児童労働/lethal
 ;; aggression は ko/mago を最大級に侵すので、score 経由でここに該当する(列挙でなく評価で)。
 :catastrophe
 {:dims [:ko-wellbecoming :mago-wellbecoming]
  :threshold -1.9
  :rule "子・孫 wellbecoming への最大級の害(score ≤ -1.9)は J で打ち消せず :non-aligned。"
  :rationale "固定するのは priority。掟リストでなく、priority 非交渉性の目的関数的表現。"}

 ;; ── route 閾値 (Tier-1) ────────────────────────────────────────────────────
 :thresholds {:aligned 0.5 :non-aligned -0.5}
 :routes [:aligned :hold :non-aligned]

 ;; ── 動的スコアの evidence 供給源 (Tier-2; 観測 actor が score を埋める) ──────────
 ;; 静的に列挙せず、これらの DISCLOSED 証拠を fuse して :scores を算出する (tanemaki 方式)。
 :evidence-sources
 [{:actor "shiori"  :feeds [:ko-wellbecoming :mago-wellbecoming] :what "wellbecoming detractor/relief"}
  {:actor "tsumugi" :feeds [:collective-commons] :what "取-concentration"}
  {:actor "danjo"   :feeds [:reciprocal-transparency] :what "accountability/asymmetry"}
  {:actor "inochi"  :feeds [:mago-wellbecoming] :what "生命圏 pressure (孫の環境)"}
  {:actor "kanjo"   :feeds [:collective-commons :labor-liberation] :what "disclosed 決算"}]

 ;; ── self-test fixtures (route の :expect を assert) ───────────────────────────
 ;; :scores は Tier-2 evidence の代理。screens は廃止 — 全て score で評価し、子・孫への
 ;; 最大級の害(ko/mago ≤ -1.9)のみ :catastrophe 項で非交渉に non-aligned。
 :fixtures
 [{:key :worker-coop-oss
   :label "労働者協同組合の OSS (子孫に開かれた commons)"
   :scores {:ko-wellbecoming 1 :mago-wellbecoming 1 :collective-commons 2
            :reciprocal-transparency 1 :labor-liberation 2}
   :expect :aligned}

  {:key :addictive-engagement-app
   :label "addictive engagement 最適化アプリ — 子の発達を net で削る"
   :scores {:ko-wellbecoming -1 :mago-wellbecoming -1 :collective-commons -1
            :reciprocal-transparency 0 :labor-liberation 0}
   :expect :non-aligned}   ;; ← J 経由 (-0.75)

  {:key :ambiguous-dual-use
   :label "両義的 dual-use (証拠が拮抗 → 保留)"
   :scores {:ko-wellbecoming 0 :mago-wellbecoming 0 :collective-commons 1
            :reciprocal-transparency -1 :labor-liberation 0}
   :expect :hold}

  ;; ── ADR-2606182359 wave3: 旧 hard-floor も全て score 化。最大級の子孫害のみ catastrophe ──
  {:key :csam-host
   :label "CSAM ホスト — 子への最大級の害。掟でなく ko/mago = -2 が catastrophe 項を発火"
   :scores {:ko-wellbecoming -2 :mago-wellbecoming -2 :collective-commons -1
            :reciprocal-transparency 0 :labor-liberation 0}
   :expect :non-aligned}   ;; ← :catastrophe (priority 非交渉; 列挙でなく評価で)

  {:key :forced-child-labor
   :label "強制児童労働 — 子への最大級の害。ko = -2 が catastrophe を発火"
   :scores {:ko-wellbecoming -2 :mago-wellbecoming -1 :collective-commons -1
            :reciprocal-transparency 0 :labor-liberation -2}
   :expect :non-aligned}   ;; ← :catastrophe

  {:key :lethal-aggression-arms
   :label "攻撃的 lethal 武力 — 子・孫への最大級の害。ko/mago = -2 が catastrophe を発火"
   :scores {:ko-wellbecoming -2 :mago-wellbecoming -2 :collective-commons -1
            :reciprocal-transparency -1 :labor-liberation 0}
   :expect :non-aligned}   ;; ← :catastrophe (旧 §2(a) 核も score 化)

  {:key :asymmetric-unwatched-watcher
   :label "非対称 unwatched-watcher(相互監視を侵す) — 旧 §2(c) 核も score 化, J 経由"
   :scores {:ko-wellbecoming -1 :mago-wellbecoming 0 :collective-commons -2
            :reciprocal-transparency -2 :labor-liberation 0}
   :expect :non-aligned}   ;; ← J 経由 (-0.95)。最大級でないので catastrophe でなく score

  {:key :individualist-doctrine-serves-children
   :label "宣言は個人主義だが実効は子供に資する — 旧 §2(g) categorical 排除を廃止, 実効で評価"
   :scores {:ko-wellbecoming 1 :mago-wellbecoming 1 :collective-commons -1
            :reciprocal-transparency 0 :labor-liberation 0}
   :expect :hold}   ;; ← 宣言教義で自動排除しない。実効が資すれば弾かれず評価 (思想は目的関数で)

  ;; ── ADR-2606172359 wave1: 化石/compute は net 評価 ──
  {:key :fossil-feedstock-plastics
   :label "化石を非燃焼 feedstock(プラスティック/素材)で使う — net で評価"
   :scores {:ko-wellbecoming 0 :mago-wellbecoming 0 :collective-commons 1
            :reciprocal-transparency 0 :labor-liberation 0}
   :expect :hold}

  {:key :fossil-combustion-net-positive
   :label "化石*燃焼*で net-positive CO₂e — net carbon balance で孫次元が負"
   :scores {:ko-wellbecoming -1 :mago-wellbecoming -1 :collective-commons 0
            :reciprocal-transparency 0 :labor-liberation 0}
   :expect :non-aligned}   ;; ← J 経由 (-0.55)

  {:key :commercial-gpu-open-transparent
   :label "商用 GPU だが透明・低 lock-in・open 成果 — Murakumo-only でない, net で可"
   :scores {:ko-wellbecoming 1 :mago-wellbecoming 0 :collective-commons 1
            :reciprocal-transparency 1 :labor-liberation 1}
   :expect :aligned}

  {:key :commercial-gpu-monopoly-lockin
   :label "商用 GPU で有害 lock-in・不透明・proprietary 依存 — net で減点"
   :scores {:ko-wellbecoming 0 :mago-wellbecoming -1 :collective-commons -2
            :reciprocal-transparency -1 :labor-liberation 0}
   :expect :non-aligned}

  ;; ── ADR-2606180001 wave2: 事業モデル/経済構造は net 評価 ──
  {:key :bank-utility-custody
   :label "正当な金融ユーティリティ(custody/決済) — 事業名で弾かず net で保留"
   :scores {:ko-wellbecoming 0 :mago-wellbecoming 0 :collective-commons 1
            :reciprocal-transparency 1 :labor-liberation 0}
   :expect :hold}

  {:key :predatory-lender
   :label "略奪的貸付(≥36%) — 実害を net で捕捉"
   :scores {:ko-wellbecoming -1 :mago-wellbecoming -1 :collective-commons -2
            :reciprocal-transparency 0 :labor-liberation 0}
   :expect :non-aligned}   ;; ← J 経由 (-0.95)

  {:key :monopolistic-legal-gatekeeper
   :label "法律知識の独占的 gatekeeping — access 囲い込みを collective-commons で"
   :scores {:ko-wellbecoming 0 :mago-wellbecoming -1 :collective-commons -2
            :reciprocal-transparency 0 :labor-liberation 0}
   :expect :non-aligned}

  {:key :transparent-defensive-tech
   :label "透過的防衛技術(dual-use) — 攻撃/lethal でなければ net で評価"
   :scores {:ko-wellbecoming 0 :mago-wellbecoming 0 :collective-commons 1
            :reciprocal-transparency 1 :labor-liberation 0}
   :expect :hold}

  {:key :ad-funded-attention-extractor
   :label "広告 attention 搾取モデル — attention 搾取の害を net で捕捉"
   :scores {:ko-wellbecoming -1 :mago-wellbecoming 0 :collective-commons -1
            :reciprocal-transparency -1 :labor-liberation 0}
   :expect :non-aligned}   ;; ← J 経由 (-0.60)

  {:key :for-profit-commons-contributor
   :label "営利だが commons に payoff 還元・私的捕獲なし・透過 — net で aligned"
   :scores {:ko-wellbecoming 1 :mago-wellbecoming 0 :collective-commons 2
            :reciprocal-transparency 1 :labor-liberation 1}
   :expect :aligned}

  {:key :individualist-private-equity-extractor
   :label "個人主義的私的捕獲(PE 蓄積) — collective-commons が私的捕獲を負へ"
   :scores {:ko-wellbecoming 0 :mago-wellbecoming -1 :collective-commons -2
            :reciprocal-transparency 0 :labor-liberation -1}
   :expect :non-aligned}]}   ;; ← J 経由 (-0.80)]
