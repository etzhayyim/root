;; ECL objective function — SSoT data for evaluate.bb
;;
;; ECL は「固定ルール(掟)で制御」せず「目的関数で動的に評価」する (ADR-2606062100:
;; 固定するのは掟ではなく priority)。本ファイルがその目的関数 J の機械可読定義。
;;
;; 基準 (この目的関数の telos):
;;   ★ 子 (this-generation children) と 孫 (≥25y hence descendants) の
;;     **Wellbecoming = 静的 wellbeing ではなく動的軌跡** を最大化する。
;;   他の次元 (commons / 相互監視 / 労働解放) は、子孫の wellbecoming を支える
;;     enabling condition として、その telos に従属して重みづけられる。
;;
;; 3-Tier (ADR-2606062100):
;;   Tier-0 (fork-only)      : どの次元が存在し、その符号方向 (何が wellbecoming に資する/反する)
;;   Tier-1 (Council Lv7+)   : :weight / :thresholds / :screens のリスト
;;   Tier-2 (governance att.) : 個別ケースの :scores (evidence から算出)
;;
;; J = Σ_dim (weight · score), score ∈ [-2,+2], Σweight = 1.0  → J ∈ [-2,+2]
;; route: screens が1つでも発火 → :non-aligned (確定フロア, scoring 不要)
;;        else J ≥ +0.5 → :aligned / -0.5<J<+0.5 → :hold / J ≤ -0.5 → :non-aligned

{:meta
 {:id    "ecl-objective-function"
  :title "ECL 子孫-Wellbecoming 目的関数"
  :version "0.3-draft"
  :date  "2026-06-17"
  :note  "基準 = 子・孫の動的 wellbecoming。固定ルールでなく目的関数で動的評価する。
          v0.2 (ADR-2606172359): compute(旧 Murakumo-only §2(i))と化石(旧 §2(d) 燃焼禁止)を移管。
          v0.3 (ADR-2606180001 wave2): 事業モデル(§2(b)金融/§2(e)専門知/§2(a)兵器商業化部分/
          §2(c)収益化監視部分)と経済構造(非営利のみ/donation/no-equity/広告排除/open-source強制)を
          本目的関数へ移管。反個人主義の価値は §2(g)(categorical 残置)+ collective-commons 次元で
          二重保持 — 私的捕獲/個人主義的蓄積/commons 囲い込みは collective-commons で動的に負。
          残る hard-floor screen は子孫実害 categorical(CSAM/強制労働)+ Tier-0 直撃
          (aggression-lethal-covert / asymmetric-unwatched surveillance)のみ。"}

 ;; ── 目的関数の次元 (Tier-0 で固定: 存在と符号方向) ────────────────────────────
 ;; score の意味: +2 強く資する … 0 中立 … -2 強く反する (子孫 wellbecoming に対して)
 :dimensions
 [{:key :ko-wellbecoming :weight 0.25 :scale [-2 2]
   :label "子 (現世代の子供) の wellbecoming-軌跡"
   :tier0 "Wellbecoming(動的) + 子 priority"
   :plus "子供の発達軌跡(認知主権・成長)を上げる"
   :minus "addictive design / 静的 engagement 搾取で発達を削る / 広告による attention 搾取
           (旧『広告排除』はここで net 評価 — 広告自体でなく attention 搾取の度合いで; ADR-2606180001) /
           略奪的貸付など子の生活基盤を削る金融(旧 §2(b))"}

  {:key :mago-wellbecoming :weight 0.30 :scale [-2 2]
   :label "孫・未来世代 (≥25y hence) の wellbecoming-軌跡 (不可逆性で加重)"
   :tier0 "多世代(子・孫およびそれ以降) priority — 最重要"
   :plus "孫の代に資源/知識/環境/遺伝健全性/意思決定能力を残す。化石を*非燃焼の有用用途*
          (プラスティック/素材/feedstock)や closed-loop/captured-carbon で使う(net 中立〜正)"
   :minus "*net* 不可逆危害を carbon BALANCE で評価(産業名でなく net 効果): net-positive CO₂e の
           燃焼経路 / biosphere 崩壊 / commons 囲い込み / germline 無審査 / 注意独占。
           compute の energy/carbon footprint もここで net 評価 (ADR-2606172359 改正)"}

  {:key :collective-commons :weight 0.20 :scale [-2 2]
   :label "子孫が育つ関係的 commons (反個人主義 ontology)"
   :tier0 "collective/relational over isolated individual"
   :plus "commons/関係的紐帯を強める(子孫が育つ土壌)。open-hardware/donated/低 lock-in compute。
          open-source/commons 公開。collective に payoff が還る形(私的捕獲なし)。知識への open access"
   :minus "individualist 囲い込み / 私的捕獲 / 個人主義的蓄積(反個人主義 §2(g) の経済的表現 —
           *非営利の精神はここで動的に enforce*; ADR-2606180001) / *有害な compute lock-in・vendor 依存*
           (旧 Murakumo-only; ADR-2606172359) / proprietary 囲い込み(旧 open-source 強制) /
           専門知の独占的 gatekeeping(旧 §2(e)) / commons に還元しない value-extraction(旧 §2(b))"}

  {:key :reciprocal-transparency :weight 0.15 :scale [-2 2]
   :label "相互監視 (見守り — 子供を守り孤立を断つ村社会)"
   :tier0 "permanent-memory = 神の監視 + 相互監視 (reciprocal)"
   :plus "対称的に観測可能(everyone watched) — 子供を守り孤独死を防ぐ見守り。透明な compute 調達/監査可能性。
          consented/reciprocal なデータ処理"
   :minus "personal-data の収集・売買(ad-tech DSP/SSP・data broker; 旧 §2(c) monetized はここで net 評価) /
           不透明な compute 経路。注: ASYMMETRIC unwatched-watcher は screen(hard-floor)に残置"}

  {:key :labor-liberation :weight 0.10 :scale [-2 2]
   :label "子孫の労働解放 (mission telos)"
   :tier0 "Charter §1.1 構造的労働解放"
   :plus "人間を強制労働から解放する"
   :minus "強制/隷属労働を深める"}]

 ;; ── 確定フロア screens (Tier-1; 子孫 wellbecoming を破滅的に侵すもの) ─────────────
 ;; これらは「scoring すべきでない」かつ「司法で執行可能な bright-line」である必要が
 ;; あるため、目的関数の外に列挙された確定ルールとして残す (二層設計の legal backstop)。
 ;; 1つでも発火 → J を計算せず即 :non-aligned。
 ;; 注 (ADR-2606172359 + 2606180001): 環境/化石・compute・事業モデル(金融/専門知/兵器商業化/
 ;; 収益化監視)・経済構造(非営利/広告/equity/open-source)は確定フロアから外し目的関数で net 評価。
 ;; 確定フロアに残すのは「net に関わらず categorically 子孫を侵すもの(虐待/強制労働)」と
 ;; 「Tier-0 を直撃する核(aggression-lethal-covert / asymmetric-unwatched surveillance)」のみ。
 ;; §2(a)/§2(c) は*部分*改正 — 事業モデル枠は目的関数へ、下記の核だけ screen に残す。
 :screens
 [{:key :csam :label "児童性的虐待 / 非合意性的コンテンツ" :anchor "Rider §2(k); 子 priority 直接侵害"}
  {:key :forced-labor :label "強制労働 / 人身取引 / 搾取的児童労働" :anchor "Rider §2(j); mission 直接反"}
  {:key :aggression-lethal-covert :label "aggression / autonomous lethal / covert(非透過)force(兵器*商業化*でなく攻撃性・lethality・秘匿性)" :anchor "Rider §2(a) 核 (透過防衛 force は可; 商業化は目的関数へ)"}
  {:key :asymmetric-unwatched-surveillance :label "ASYMMETRIC unwatched-watcher(相互監視=Tier-0 を侵す。収益化監視自体は目的関数へ)" :anchor "Rider §2(c) 核 (相互監視は可; monetized は目的関数へ)"}]

 ;; ── route 閾値 (Tier-1) ────────────────────────────────────────────────────
 :thresholds {:aligned 0.5 :non-aligned -0.5}
 :routes [:aligned :hold :non-aligned]

 ;; ── 動的スコアの evidence 供給源 (Tier-2; 観測 actor が score を埋める) ──────────
 ;; 静的に列挙せず、これらの DISCLOSED 証拠を fuse して :scores を算出する (tanemaki 方式)。
 :evidence-sources
 [{:actor "shiori"  :feeds [:ko-wellbecoming :mago-wellbecoming] :what "wellbecoming detractor/relief"}
  {:actor "tsumugi" :feeds [:collective-commons] :what "取-concentration"}
  {:actor "danjo"   :feeds [:reciprocal-transparency] :what "accountability/asymmetry"}
  {:actor "inochi"  :feeds [:mago-wellbecoming] :what "生命圏 pressure (孫の環境)"}
  {:actor "kanjo"   :feeds [:collective-commons :labor-liberation] :what "disclosed 決算"}]

 ;; ── self-test fixtures (route の :expect を assert) ───────────────────────────
 ;; :scores は Tier-2 evidence の代理。:screens は発火した確定フロア。
 :fixtures
 [{:key :worker-coop-oss
   :label "労働者協同組合の OSS (子孫に開かれた commons)"
   :screens []
   :scores {:ko-wellbecoming 1 :mago-wellbecoming 1 :collective-commons 2
            :reciprocal-transparency 1 :labor-liberation 2}
   :expect :aligned}

  {:key :addictive-engagement-app
   :label "addictive engagement 最適化アプリ (確定フロアには載らないが子の発達を削る)"
   :screens []
   :scores {:ko-wellbecoming -2 :mago-wellbecoming -1 :collective-commons -1
            :reciprocal-transparency 0 :labor-liberation 0}
   :expect :non-aligned}   ;; ← 目的関数が動的に捕捉 (固定リストにない害)

  {:key :ambiguous-dual-use
   :label "両義的 dual-use (証拠が拮抗 → 保留)"
   :screens []
   :scores {:ko-wellbecoming 0 :mago-wellbecoming 0 :collective-commons 1
            :reciprocal-transparency -1 :labor-liberation 0}
   :expect :hold}

  {:key :monetized-ad-broker
   :label "personal-data ブローカー(収益化監視) — v3.4 で screen から目的関数へ。harm は net で捕捉"
   :screens []
   :scores {:ko-wellbecoming -1 :mago-wellbecoming -1 :collective-commons -1
            :reciprocal-transparency -2 :labor-liberation 0}
   :expect :non-aligned}   ;; ← 旧 §2(c) screen。今は reciprocal-transparency 等で net 非aligned

  {:key :asymmetric-unwatched-watcher
   :label "非対称 unwatched-watcher(相互監視=Tier-0 を侵す) — 核は screen に残置"
   :screens [:asymmetric-unwatched-surveillance]
   :scores {}
   :expect :non-aligned}

  {:key :csam-host
   :label "CSAM ホスト (確定フロア発火, scoring 不要)"
   :screens [:csam]
   :scores {}
   :expect :non-aligned}

  ;; ── ADR-2606172359 改正の実証: 化石/compute は categorical でなく net で評価 ──
  {:key :fossil-feedstock-plastics
   :label "化石を非燃焼 feedstock(プラスティック/素材)で使う — 確定フロア無し, net で評価"
   :screens []
   :scores {:ko-wellbecoming 0 :mago-wellbecoming 0 :collective-commons 1
            :reciprocal-transparency 0 :labor-liberation 0}
   :expect :hold}   ;; ← 旧 hard-floor なら即拒否。今は「有用な化石利用」を拒否せず評価→保留

  {:key :fossil-combustion-net-positive
   :label "化石*燃焼*で net-positive CO₂e — 目的関数が孫次元で動的に捕捉"
   :screens []
   :scores {:ko-wellbecoming -1 :mago-wellbecoming -2 :collective-commons 0
            :reciprocal-transparency 0 :labor-liberation 0}
   :expect :non-aligned}   ;; ← 害は依然捕捉。ただし screen でなく net carbon balance スコアで

  {:key :commercial-gpu-open-transparent
   :label "商用 GPU だが透明・低 lock-in・open 成果 — 旧 Murakumo-only なら即拒否, 今は可"
   :screens []
   :scores {:ko-wellbecoming 1 :mago-wellbecoming 0 :collective-commons 1
            :reciprocal-transparency 1 :labor-liberation 1}
   :expect :aligned}   ;; ← vendor 名で禁じない。透明・低 lock-in なら aligned

  {:key :commercial-gpu-monopoly-lockin
   :label "商用 GPU で有害 lock-in・不透明・proprietary 依存 — 懸念を net でスコア"
   :screens []
   :scores {:ko-wellbecoming 0 :mago-wellbecoming -1 :collective-commons -2
            :reciprocal-transparency -1 :labor-liberation 0}
   :expect :non-aligned}   ;; ← vendor でなく lock-in の度合いが減点される

  ;; ── ADR-2606180001 wave2 の実証: 事業モデル/経済構造は categorical でなく net ──
  {:key :bank-utility-custody
   :label "正当な金融ユーティリティ(custody/決済) — 旧 §2(b) 投機禁止で巻き込まれず net 評価"
   :screens []
   :scores {:ko-wellbecoming 0 :mago-wellbecoming 0 :collective-commons 1
            :reciprocal-transparency 1 :labor-liberation 0}
   :expect :hold}   ;; ← 金融を事業名で弾かない。正当業務は評価→保留/可

  {:key :predatory-lender
   :label "略奪的貸付(≥36%) — §2(b) の*実害*は net で依然捕捉"
   :screens []
   :scores {:ko-wellbecoming -2 :mago-wellbecoming -1 :collective-commons -1
            :reciprocal-transparency 0 :labor-liberation 0}
   :expect :non-aligned}

  {:key :monopolistic-legal-gatekeeper
   :label "法律知識の独占的 gatekeeping — §2(e) の*実害*(access 囲い込み)を collective-commons で"
   :screens []
   :scores {:ko-wellbecoming 0 :mago-wellbecoming -1 :collective-commons -2
            :reciprocal-transparency 0 :labor-liberation 0}
   :expect :non-aligned}

  {:key :transparent-defensive-tech
   :label "透過的防衛技術(dual-use) — §2(a) 商業化枠は目的関数へ。攻撃/lethal でなければ net 評価"
   :screens []
   :scores {:ko-wellbecoming 0 :mago-wellbecoming 0 :collective-commons 1
            :reciprocal-transparency 1 :labor-liberation 0}
   :expect :hold}   ;; ← 兵器*商業化*でなく攻撃性で判定。透過防衛は弾かれず評価

  {:key :ad-funded-attention-extractor
   :label "広告 attention 搾取モデル — 旧『広告排除』は net へ。attention 搾取の害を捕捉"
   :screens []
   :scores {:ko-wellbecoming -2 :mago-wellbecoming 0 :collective-commons -1
            :reciprocal-transparency -1 :labor-liberation 0}
   :expect :non-aligned}

  {:key :for-profit-commons-contributor
   :label "営利だが commons に payoff 還元・私的捕獲なし・透過 — 旧『非営利のみ』は net へ"
   :screens []
   :scores {:ko-wellbecoming 1 :mago-wellbecoming 0 :collective-commons 2
            :reciprocal-transparency 1 :labor-liberation 1}
   :expect :aligned}   ;; ← 営利を事業名で弾かない。私的捕獲を生まず commons に資すれば aligned

  {:key :individualist-private-equity-extractor
   :label "個人主義的私的捕獲(PE 蓄積) — 非営利の精神は collective-commons + §2(g) で動的に enforce"
   :screens []
   :scores {:ko-wellbecoming 0 :mago-wellbecoming -1 :collective-commons -2
            :reciprocal-transparency 0 :labor-liberation -1}
   :expect :non-aligned}]}   ;; ← 反個人主義の価値が collective-commons 経由で私的捕獲を負へ
