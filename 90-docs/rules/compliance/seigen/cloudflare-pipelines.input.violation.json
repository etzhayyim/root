{
  "provider": "cloudflare",
  "product": "pipelines",
  "usage": {
    "streams": 21,
    "sinks": 25,
    "pipelines": 30,
    "payloadBytes": 6000000,
    "ingestRateBps": 9000000
  },
  "pipeline": {
    "sqlMutable": true
  },
  "sinks": [
    {
      "name": "sink-catalog",
      "type": "r2-data-catalog",
      "mutable": true,
      "crossJurisdictionWrite": true
    }
  ],
  "streams": [
    {
      "name": "stream-structured",
      "mode": "structured",
      "schemaMutable": true,
      "expectNoDropOnSchemaMismatch": true
    }
  ]
}
