{
  "provider": "cloudflare",
  "product": "pipelines",
  "usage": {
    "streams": 5,
    "sinks": 3,
    "pipelines": 4,
    "payloadBytes": 2000000,
    "ingestRateBps": 1000000
  },
  "pipeline": {
    "sqlMutable": false
  },
  "sinks": [
    {
      "name": "sink-r2",
      "type": "r2",
      "mutable": false
    },
    {
      "name": "sink-catalog",
      "type": "r2-data-catalog",
      "mutable": false,
      "crossJurisdictionWrite": false
    }
  ],
  "streams": [
    {
      "name": "stream-structured",
      "mode": "structured",
      "schemaMutable": false,
      "expectNoDropOnSchemaMismatch": false
    },
    {
      "name": "stream-unstructured",
      "mode": "unstructured"
    }
  ]
}
