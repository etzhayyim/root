[{:db/id -1, :doc/id "260403-governance-and-compliance-consolidated", :doc/title "Governance and Compliance (Consolidated)", :doc/status "active", :doc/doc_type "explanation", :doc/source-format "edn", :doc/body "\n# Governance and Compliance (Consolidated)\n\n## Decision\n\n- consent, visibility, jurisdiction, content policy を同一ガバナンス層で扱う。\n- authority chain を policy evaluation の参照系として維持する。\n- access control は RBAC/RACI + sensitivity/clearance の併用で評価する。\n\n## Scope\n\n- consent-gated sharing\n- actor visibility governance\n- authority-chain compliance\n- compliance-based content access\n\n## Notes\n\nこの統合文書が上記 4 文書の正本。\n", :doc/path "90-docs/platform/260403-governance-and-compliance-consolidated.edn", :doc/source-repo "root", :doc/topic "governance-and-compliance", :doc/last_verified "2026-04-03", :doc/date "2026-04-03", :doc/authoritative true, :doc/related [], :doc/authoritative_for ["governance policy baseline across visibility and consent" "authority chain and content access compliance baseline"], :doc/supersedes ["yoro-superapp-oembed-design" "260323-yoro-human-credit-economy-design" "260323-yoro-human-credit-economy-design" "260323-yoro-human-credit-economy-design"]}]
