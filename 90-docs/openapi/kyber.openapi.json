{
  "openapi": "3.0.3",
  "info": {
    "title": "kyber XRPC API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://kyber.etzhayyim.com"
    }
  ],
  "paths": {
    "/xrpc/com.etzhayyim.kyber.projector.emitApqcEvent": {
      "post": {
        "summary": "Emit an OCEL 2.0 event linked to an APQC code + BPMN task + case objects. Writes com.etzhayyim.apps.apqc.apqcEvent (federable). Intended for handler use and external orchestrators.",
        "operationId": "com.etzhayyim.kyber.projector.emitApqcEvent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "apqcCode": {
                    "type": "string"
                  },
                  "taskId": {
                    "type": "string"
                  },
                  "eventType": {
                    "type": "string",
                    "description": "OCEL event type (e.g. journal.posted)"
                  },
                  "caseId": {
                    "type": "string"
                  },
                  "objects": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "type"
                      ]
                    }
                  },
                  "attributes": {
                    "type": "object"
                  },
                  "actorDid": {
                    "type": "string"
                  }
                },
                "required": [
                  "apqcCode",
                  "eventType"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "ocelEventId": {
                      "type": "string"
                    },
                    "apqcCode": {
                      "type": "string"
                    },
                    "eventType": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "ocelEventId",
                    "eventType"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error"
          }
        }
      }
    },
