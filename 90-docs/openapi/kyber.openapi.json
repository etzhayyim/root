    "/xrpc/com.etzhayyim.kyber.projector.getApqcCoverage": {
      "get": {
        "summary": "APQC coverage summary: registered L1 actors (/13), bound BPMN tasks, observed OCEL events per L1 in the period.",
        "operationId": "com.etzhayyim.kyber.projector.getApqcCoverage",
        "parameters": [
          {
            "name": "period",
            "in": "query",
            "required": false,
            "description": "ISO date range e.g. 2026-04-01/2026-04-30",
            "schema": {
              "type": "string",
              "description": "ISO date range e.g. 2026-04-01/2026-04-30"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "registeredL1": {
                      "type": "integer"
                    },
                    "totalL1": {
                      "type": "integer"
                    },
                    "registeredSubProcesses": {
                      "type": "integer"
                    },
                    "totalSubProcesses": {
                      "type": "integer"
                    },
                    "boundBpmnTasks": {
                      "type": "integer"
                    },
                    "byL1": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "apqcCode": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "registered": {
                            "type": "boolean"
                          },
                          "subProcesses": {
                            "type": "integer"
                          },
                          "bpmnTasks": {
                            "type": "integer"
                          },
                          "ocelEvents": {
                            "type": "integer"
                          }
                        },
                        "required": [
                          "apqcCode",
                          "name",
                          "registered"
                        ]
                      }
                    }
                  },
                  "required": [
                    "ok",
                    "registeredL1",
                    "totalL1",
                    "byL1"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error"
          }
        }
      }
    },
