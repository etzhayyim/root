          "judgeAgreement": {
            "type": "boolean"
          },
          "tier": {
            "type": "string"
          },
          "observedAt": {
            "type": "string"
          }
        },
        "required": [
          "cohortDid",
          "evidenceHash",
          "signalKind",
          "tier",
          "observedAt"
        ]
      },
      "ai_etzhayyim_cohort_fissionLineage": {
