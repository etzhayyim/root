          },
          "demographicVector": {
            "type": "string"
          },
          "kAnonymity": {
            "type": "integer",
            "minimum": 50
          },
          "policyRef": {
            "type": "string"
          },
          "fissionEnabled": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string"
          },
          "kReevaluatedAt": {
            "type": "string"
          }
        },
