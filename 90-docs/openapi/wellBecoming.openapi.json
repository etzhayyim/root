{
  "openapi": "3.0.3",
  "info": {
    "title": "wellBecoming XRPC API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://wellBecoming.etzhayyim.com"
    }
  ],
  "paths": {},
  "components": {
    "schemas": {
      "ai_etzhayyim_wellBecoming_skillClaim": {
        "type": "object",
        "properties": {
          "$type": {
            "type": "string"
          },
          "domain": {
            "type": "string",
            "description": "Skill domain (e.g. 'kendo', 'piano', 'kintsugi', 'shinto-norito')",
            "maxLength": 128,
            "minLength": 1
          },
          "rankSystem": {
            "type": "string",
            "x-knownValues": [
              "kyu-dan",
              "level-numeric"
            ]
          },
          "rankValue": {
            "type": "integer",
            "description": "For kyu-dan: negative = kyū (-10..-1), positive = dan (1..10). For level-numeric: 1..N."
          },
          "claimedAt": {
            "type": "string",
            "format": "datetime"
          },
          "note": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "required": [
          "$type",
          "domain",
          "rankSystem",
          "rankValue",
          "claimedAt"
        ]
      }
    }
  }
}