{
  "openapi": "3.0.3",
  "info": {
    "title": "auth XRPC API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://auth.etzhayyim.com"
    }
  ],
  "paths": {
    "/xrpc/com.etzhayyim.auth.authenticate": {
      "post": {
        "summary": "Authenticate a request. Returns auth level, account DID, active DID, and token scopes. Used by PDS service binding to delegate authentication.",
        "operationId": "com.etzhayyim.auth.authenticate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "authorization": {
                    "type": "string",
                    "description": "Bearer token or raw JWT"
                  },
                  "xMagatamaVerified": {
                    "type": "boolean",
                    "description": "Internal service binding flag"
                  },
                  "xetzhayyimOrgId": {
                    "type": "string",
                    "description": "Org ID for internal requests"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "level": {
                      "type": "string",
                      "description": "Auth level: public | session | internal"
                    },
                    "did": {
                      "type": "string",
                      "description": "Authenticated active DID or null"
                    },
                    "accountDid": {
                      "type": "string",
                      "description": "Root account = actor = org DID"
                    },
                    "activeDid": {
                      "type": "string",
                      "description": "Current active sub-actor DID"
                    },
                    "orgId": {
                      "type": "string"
                    },
                    "clearance": {
                      "type": "string"
                    },
                    "sub": {
                      "type": "string"
                    },
                    "tokenScopes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "level",
                    "clearance",
                    "tokenScopes"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error"
          }
        }
      }
    },
    "/xrpc/com.etzhayyim.auth.createAgentSession": {
      "post": {
        "summary": "Create an agent DID with P-256 keypair and AT Protocol session in one call. Used by etzhayyim deploy for automatic agent credential provisioning.",
        "operationId": "com.etzhayyim.auth.createAgentSession",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "appNanoid": {
                    "type": "string",
                    "description": "Application nanoid identifier"
                  },
                  "subPath": {
                    "type": "string",
                    "description": "Optional sub-path for path-based DID"
                  },
                  "performerType": {
                    "type": "string",
                    "description": "DID performer type: service | system | person | organization",
                    "default": "service"
                  }
                },
                "required": [
                  "appNanoid"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "did": {
                      "type": "string"
                    },
                    "didDocument": {
                      "type": "object"
                    },
                    "didDocumentJsonld": {
                      "type": "object"
                    },
                    "privateKeyB64url": {
                      "type": "string"
                    },
                    "ownerHash": {
                      "type": "string"
                    },
                    "sessionTokens": {
                      "type": "object"
                    },
                    "keyId": {
                      "type": "string"
                    },
                    "keyCustodyTier": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "did",
                    "didDocument",
                    "privateKeyB64url",
                    "sessionTokens",
                    "keyId",
                    "keyCustodyTier"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error"
          }
        }
      }
    },
    "/xrpc/com.etzhayyim.auth.createGuestAccount": {
      "post": {
        "summary": "Create a guest account with username/password. Issues AT Protocol session with guest tier.",
        "operationId": "com.etzhayyim.auth.createGuestAccount",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "description": "3-30 chars, lowercase alphanumeric with _ and -",
                    "maxLength": 30,
                    "minLength": 3
                  },
                  "password": {
                    "type": "string",
                    "description": "Minimum 8 characters",
                    "minLength": 8
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "did": {
                      "type": "string"
                    },
                    "handle": {
                      "type": "string"
                    },
                    "accessJwt": {
                      "type": "string"
                    },
                    "refreshJwt": {
                      "type": "string"
                    },
                    "tier": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "did",
                    "handle",
                    "accessJwt",
                    "refreshJwt",
                    "tier"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error"
          }
        }
      }
    },
    "/xrpc/com.etzhayyim.auth.createPlcAlias": {
      "post": {
        "summary": "Create a did:plc alias for a did:web identity. Used for AT Protocol federation bridge.",
        "operationId": "com.etzhayyim.auth.createPlcAlias",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "webDid": {
                    "type": "string",
                    "description": "Source did:web identity"
                  },
                  "handle": {
                    "type": "string",
                    "description": "AT Protocol handle"
                  }
                },
                "required": [
                  "webDid",
                  "handle"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "webDid": {
                      "type": "string"
                    },
                    "plcDid": {
                      "type": "string",
                      "description": "Generated did:plc alias"
                    },
                    "handle": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "datetime"
                    }
                  },
                  "required": [
                    "webDid",
                    "plcDid",
                    "handle",
                    "createdAt"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error"
          }
        }
      }
    },
