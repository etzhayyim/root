                    },
                    "qrCodeData": {
                      "type": "string",
                      "description": "QR code data string for eSIM activation"
                    },
                    "did": {
                      "type": "string"
                    },
                    "sessionTokens": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "iccid",
                    "msisdn",
                    "activationCode",
                    "qrCodeData",
                    "did",
                    "sessionTokens"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error"
          }
        }
      }
    },
    "/xrpc/com.etzhayyim.auth.listAgentKeys": {
      "post": {
        "summary": "List agent signing keys for a DID.",
        "operationId": "com.etzhayyim.auth.listAgentKeys",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "did": {
                    "type": "string"
                  }
                },
                "required": [
                  "did"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "did": {
                      "type": "string"
                    },
                    "keys": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/_AgentKey"
                      }
                    }
                  },
                  "required": [
                    "did",
                    "keys"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error"
          }
        }
      }
    },
    "/xrpc/com.etzhayyim.auth.mintChildDid": {
      "post": {
        "summary": "Mint a child did:etzhayyim under a parent DID. ADR-0029 (revised 2026-04-19) defines two input shapes: (A) semantic path form — `{parentDid, segmentKind, segmentValue}`; (B) legacy hex Merkle form — `{parentDid, materialKind, material}`. New callers should use form (A). `pubkey` kind generates an independent P-256 keypair; other kinds are keyless and sign via the nearest ancestor key. Caller must control parent (session accountDid equal to parent or a prefix ancestor).",
        "operationId": "com.etzhayyim.auth.mintChildDid",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "parentDid": {
                    "type": "string",
                    "description": "Parent did:etzhayyim. Either legacy flat hex form (did:etzhayyim:{24-hex}) or semantic path form (did:etzhayyim:{sub}:{id}:{lexicon}). Recursive form accepted up to depth 6."
                  },
                  "segmentKind": {
                    "type": "string",
                    "description": "ADR-0029 revised (semantic path) form. `sub`: owning cluster label. `id`: local identifier (TID / slug / rkey). `lexicon`: governing NSID. `role`: capability sub-identity. `pubkey`: generate new P-256 key. `grant`: consent / delegate. Mutually exclusive with `materialKind`.",
                    "enum": [
                      "sub",
                      "id",
                      "lexicon",
                      "role",
                      "pubkey",
                      "grant"
                    ]
                  },
                  "segmentValue": {
                    "type": "string",
                    "description": "Semantic segment value (NSID-compatible). Regex: [a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*. Required when segmentKind is set.",
                    "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$",
                    "maxLength": 63
                  },
                  "materialKind": {
                    "type": "string",
                    "description": "ADR-0029 草案 (hex Merkle) form — legacy Phase 1 grandfather path. Kept for existing adopters until they migrate to segmentKind/segmentValue. `pubkey`: generate new P-256 key. `role`: capability DID (requires roleName + holderDid). `matter`: domain entity (requires matterTid). `doc`: content-addressed document (requires docCid). `grant`: consent/delegate (requires granteeDid + grantExpiresAt + grantNonceHex). `session`: one-shot scoped capability (requires parentSessionJti + sessionNonceHex).",
                    "enum": [
                      "pubkey",
                      "role",
                      "matter",
                      "doc",
                      "grant",
                      "session"
                    ]
                  },
                  "material": {
                    "type": "object",
                    "description": "Kind-specific material for legacy materialKind form. Required keys depend on materialKind.",
                    "properties": {
                      "roleName": {
                        "type": "string"
                      },
                      "holderDid": {
                        "type": "string"
                      },
                      "matterTid": {
                        "type": "string"
                      },
                      "docCid": {
                        "type": "string"
                      },
                      "granteeDid": {
                        "type": "string"
                      },
                      "grantExpiresAt": {
                        "type": "string",
                        "format": "datetime"
                      },
                      "grantNonceHex": {
                        "type": "string",
                        "pattern": "^[0-9a-f]+$"
                      },
                      "parentSessionJti": {
                        "type": "string"
                      },
                      "sessionNonceHex": {
                        "type": "string",
                        "pattern": "^[0-9a-f]+$"
                      }
                    }
                  },
                  "handle": {
                    "type": "string",
                    "description": "Optional handle to attach (typically only for pubkey kind)."
                  },
                  "performerType": {
                    "type": "string",
                    "enum": [
                      "service",
                      "system",
                      "person",
                      "organization"
                    ],
                    "default": "service"
                  }
                },
                "required": [
                  "parentDid"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "did": {
                      "type": "string",
                      "description": "Newly minted child did:etzhayyim (full recursive form)."
                    },
                    "parentDid": {
                      "type": "string"
                    },
                    "depth": {
                      "type": "integer",
                      "minimum": 2,
                      "maximum": 6
                    },
                    "segmentKind": {
                      "type": "string",
                      "description": "Echo of input segmentKind (semantic form only)."
                    },
                    "segmentValue": {
                      "type": "string",
                      "description": "Echo of input segmentValue (semantic form only)."
                    },
                    "materialKind": {
                      "type": "string",
                      "description": "Echo of input materialKind (legacy hex form only)."
                    },
                    "materialHashProof": {
                      "type": "string",
                      "description": "Hex-encoded materialBytes (legacy hex form only). Verifiers recompute the child hash from this."
                    },
                    "publicKeyMultibase": {
                      "type": "string",
                      "description": "Present only when kind='pubkey'."
                    }
                  },
                  "required": [
                    "did",
                    "parentDid",
                    "depth"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error"
          }
        }
      }
    },
    "/xrpc/com.etzhayyim.auth.passkeyBeginAuth": {
      "post": {
        "summary": "Begin WebAuthn/FIDO2 passkey authentication. Returns challenge and credential request options for navigator.credentials.get().",
        "operationId": "com.etzhayyim.auth.passkeyBeginAuth",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "challenge": {
                      "type": "string",
                      "description": "Base64url-encoded challenge"
                    },
                    "rpId": {
                      "type": "string",
                      "description": "Relying party ID (etzhayyim.com)"
                    },
                    "allowCredentials": {
                      "type": "array"
                    },
                    "userVerification": {
                      "type": "string"
                    },
                    "timeout": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "challenge",
                    "rpId"
