                  "did"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "did": {
                      "type": "string"
                    },
                    "didDocument": {
                      "type": "object",
                      "description": "Resolved DID Document"
                    },
                    "source": {
                      "type": "string",
                      "description": "Resolution source: plcDirectory | wellKnown"
                    }
                  },
                  "required": [
                    "did",
                    "didDocument",
                    "source"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error"
          }
        }
