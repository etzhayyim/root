    "/xrpc/com.etzhayyim.auth.passkeyVerifyAuth": {
      "post": {
        "summary": "Verify WebAuthn authentication assertion. Validates signature against stored credential and issues AT Protocol session.",
        "operationId": "com.etzhayyim.auth.passkeyVerifyAuth",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "challenge": {
                    "type": "string",
                    "description": "Original challenge from passkeyBeginAuth"
                  },
                  "credentialId": {
                    "type": "string",
                    "description": "Base64url-encoded credential ID"
                  },
                  "clientDataJson": {
                    "type": "string",
                    "description": "Base64url-encoded clientDataJSON"
                  },
                  "authenticatorData": {
                    "type": "string",
                    "description": "Base64url-encoded authenticatorData"
                  },
                  "signature": {
                    "type": "string",
                    "description": "Base64url-encoded signature"
                  }
                },
                "required": [
                  "challenge",
                  "credentialId",
                  "clientDataJson",
                  "authenticatorData",
                  "signature"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "did": {
                      "type": "string"
                    },
                    "sessionTokens": {
                      "type": "object"
                    },
                    "credentialId": {
                      "type": "string"
                    },
                    "newSignCount": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "did",
                    "sessionTokens",
                    "credentialId",
                    "newSignCount"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error"
          }
        }
      }
    },
