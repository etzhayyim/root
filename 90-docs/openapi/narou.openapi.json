    "/xrpc/ai.gftd.narou.createChapter": {
      "post": {
        "summary": "Create a chapter draft under a novel",
        "operationId": "ai.gftd.narou.createChapter",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "novel_id": {
                    "type": "string"
                  },
                  "chapter_num": {
                    "type": "integer"
                  },
                  "title": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "user_id": {
                    "type": "string"
                  },
                  "org_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "novel_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error"
          }
        }
      }
    },
