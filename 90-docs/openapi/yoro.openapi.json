    "/xrpc/com.etzhayyim.yoro.ingestProductCategory": {
      "post": {
        "summary": "Generic product/price ingest from public retailers (Amazon JP, Rakuten, IKEA, FlexiSpot, Yodobashi, Kagu365). Triggers LangGraph yoro_product_ingest.",
        "operationId": "com.etzhayyim.yoro.ingestProductCategory",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "Search keyword, e.g. 'スタンディングデスク'"
                  },
                  "category": {
                    "type": "string",
                    "description": "Optional category tag, e.g. 'office.desk.standing'"
                  },
                  "retailers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "maxItemsPerRetailer": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "actorPath": {
                    "type": "string",
                    "description": "yoro path-DID suffix, default 'research:product'"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jobId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "researchVertexId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "jobId",
                    "status"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error"
          }
        }
      }
    },
