    "/xrpc/com.etzhayyim.yoro.feed.getRankedFeed": {
      "get": {
        "summary": "5-theory ranked feed (Shannon + Bayes + Graph PPR + TDA + Joucho emotion). Well-becoming guardrails (PII Tier 3, cohort k>=50, stress/doom-scroll) are enforced on the hot path. Falls back to com.etzhayyim.yoro.feed.getDiscoverFeed on MV unavailability. See /root/.claude/plans/yoro-etzhayyim-ai-facebook-zazzy-teapot.md.",
        "operationId": "com.etzhayyim.yoro.feed.getRankedFeed",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "ISO timestamp cursor for pagination.",
            "schema": {
              "type": "string",
              "description": "ISO timestamp cursor for pagination."
            }
          },
          {
            "name": "debug",
            "in": "query",
            "required": false,
            "description": "Include per-post score breakdown in response (viewer-only).",
            "schema": {
              "type": "boolean",
              "description": "Include per-post score breakdown in response (viewer-only).",
              "default": false
            }
          },
          {
            "name": "echoPersistence",
            "in": "query",
            "required": false,
            "description": "Client-computed H1 echo-chamber persistence in [0,1]. Aggregate scalar only — raw topic history never leaves the browser.",
            "schema": {
              "type": "number",
              "description": "Client-computed H1 echo-chamber persistence in [0,1]. Aggregate scalar only — raw topic history never leaves the browser.",
              "minimum": 0,
              "maximum": 1
            }
          },
          {
            "name": "sessionDwellMs",
            "in": "query",
            "required": false,
            "description": "Session dwell in ms. Used for doom-scroll guardrail.",
            "schema": {
              "type": "integer",
              "description": "Session dwell in ms. Used for doom-scroll guardrail.",
              "minimum": 0,
              "maximum": 86400000
            }
          },
          {
            "name": "sessionDistinctTopics",
            "in": "query",
            "required": false,
            "description": "Distinct topic buckets observed in session (b0 analogue).",
            "schema": {
              "type": "integer",
              "description": "Distinct topic buckets observed in session (b0 analogue).",
              "minimum": 0,
              "maximum": 10000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "feed": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ai_etzhayyim_yoro_getTimeline_defs_feedViewPost"
                      }
                    },
                    "cursor": {
                      "type": "string"
                    },
                    "debug": {
                      "type": "object",
                      "description": "Present only when `debug=true`.",
                      "properties": {
                        "eta": {
                          "type": "number",
                          "description": "Shannon efficiency H_shown/H_max, in [0,1]."
                        },
                        "candidateCount": {
                          "type": "integer"
                        },
                        "hardGateDropped": {
                          "type": "integer"
                        },
                        "personalizeOff": {
                          "type": "boolean"
                        },
                        "nightMode": {
                          "type": "boolean"
                        },
                        "botSuspect": {
                          "type": "boolean"
                        }
                      }
                    }
                  },
                  "required": [
                    "feed"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error"
          }
        }
      }
    },
