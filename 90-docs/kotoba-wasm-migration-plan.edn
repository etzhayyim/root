 ;; ----------------------------------------------------------------------------
 ;; TARGET SHAPE — every migrated module must conform (per ADR-2605310200 prompt)
 ;; ----------------------------------------------------------------------------
 :target-contract
 {:imports     ["wit_world"
                "from kotoba_langgraph import StateGraph, KotobaCheckpointer, START, END, handle_invoke"]
  :global      "compiled = _g.compile(checkpointer=KotobaCheckpointer())"
  :entrypoint  "class WitWorld(wit_world.WitWorld): def run(self, ctx_cbor: bytes) -> bytes: return handle_invoke(ctx_cbor, compiled)"
  :rules       #{:module-level-graph-builder    ; builder NOT inside WitWorld
                 :no-relative-imports            ; mock `from .state_machine import ...`
                 :replace-__end__-with-END
                 :standalone-compilable}
  :build       "40-engine/kotoba/scripts/build-pywasm.sh agent.py -o agent.wasm  (componentize-py >=0.23, ~18MB component)"
  :deploy      "POST :8077/mcp  tool=kotoba_wasm_run  {program_cid, program_type \"wasm-node\", agent_did, wasm_b64, ctx_cbor_b64}"
  :verify      "invoke -> expect gas_used>0, output byte-identical to host-Python reference"}

